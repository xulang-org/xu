@crypto/tls

#errors
#net
#context
#crypto/aes
#crypto/x509
#io

// Go `crypto/tls` Client subset. Handshake is a software TLS 1.2/1.3
// record layer: RSA, ECDHE-RSA, and ECDHE-ECDSA AES-128-GCM for TLS 1.2, plus
// TLS_AES_128_GCM_SHA256 with P-256 key shares for TLS 1.3 (supporting RSA,
// ECDSA P-256/P-384/P-521, and Ed25519 certificates). No platform TLS.
// RootCAs defaults to the system pool when empty. Config.insecure_skip_verify
// explicitly disables certificate chain, time, and DNS verification.
// server() is for in-process tests (pipe or tcp).
// XU-CT-CLASS: variable-time
// ECDH, RSA, AES and GHASH are variable-time on current XU backends.

pub const VERSION_TLS12 = 771
pub const VERSION_TLS13 = 772
pub const TLS_AES_128_GCM_SHA256 = 4865
pub const TLS_RSA_WITH_AES_128_GCM_SHA256 = 156
pub const TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 = 49195
pub const TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 = 49199

pub struct Config {
    pub server_name string
    pub insecure_skip_verify bool
    pub root_cas x509.CertPool
    pub cert_pem string
    pub key_pem string
    next_protos []string
}

pub struct Dialer {
    pub timeout_ns int
    pub config Config
}

pub struct Conn {
    kind int
    nc net.Conn
    pc net.PipeConn
    pub server_name string
    pub handshake_complete bool
    pub cipher_suite int
    pub version int
    pub read_deadline_ns int
    pub write_deadline_ns int
    wcip aes.Cipher
    rcip aes.Cipher
    wiv string
    riv string
    wseq int
    rseq int
    leftover string
    hs_leftover string
}

pub struct ConnectionState {
    pub server_name string
    pub handshake_complete bool
    pub cipher_suite int
    pub version int
}

pub fn new_config(server_name string) Config {
    << Config{server_name: server_name, insecure_skip_verify: false, root_cas: x509.new_cert_pool(), cert_pem: "", key_pem: "", next_protos: ["h2", "http/1.1"]}
}

// Set the ordered ALPN protocols offered by this client. Empty omits ALPN;
// each nonempty name must contain at most 255 bytes, checked at handshake.
pub fn (c $&Config) set_next_protos(protocols []string) {
    c.next_protos = protocols
}

pub fn new_dialer() Dialer {
    << Dialer{timeout_ns: 0, config: new_config("")}
}

fn host_of(addr string) string {
    $last := -1
    $i := 0
    while i < addr.len {
        if (addr[i] & 255) == 58 {
            last = i
        }
        i = i + 1
    }
    if last <= 0 {
        << addr
    }
    << addr[0:last]
}

fn server_name_for(config &Config, addr string) string {
    if config.server_name.len > 0 {
        << config.server_name
    }
    << host_of(addr)
}

fn dummy_cipher() aes.Cipher {
    z := zeros16()
    << aes.new_cipher(&z) or >>
}

fn empty_conn() Conn {
    d0 := dummy_cipher()
    d1 := dummy_cipher()
    << Conn{
        kind: 0,
        nc: net.closed_conn(),
        pc: net.PipeConn{w: chan string{cap: 1}, r: chan string{cap: 1}, closed: 1},
        server_name: "",
        handshake_complete: false,
        cipher_suite: 0,
        version: 0,
        read_deadline_ns: 0,
        write_deadline_ns: 0,
        wcip: d0,
        rcip: d1,
        wiv: "",
        riv: "",
        wseq: 0,
        rseq: 0,
        leftover: "",
        hs_leftover: ""
    }
}

// Inert transport placeholder for owners that do not currently use TLS.
// It owns no descriptor and cannot perform a handshake without a transport.
pub fn closed_conn() Conn {
    << Conn{kind: 0, nc: net.closed_conn(),
        pc: net.PipeConn{w: chan string{cap: 1}, r: chan string{cap: 1}, closed: 1},
        server_name: "", handshake_complete: false, cipher_suite: 0,
        version: 0, read_deadline_ns: 0, write_deadline_ns: 0,
        wcip: aes.Cipher{nr: 0, rk: []int{}, sbox: []int{}, inv: []int{}, te: []int{}, td: []int{}, erk: []int{}, drk: []int{}, hw_accel: false, rk_bytes: "", drk_bytes: ""},
        rcip: aes.Cipher{nr: 0, rk: []int{}, sbox: []int{}, inv: []int{}, te: []int{}, td: []int{}, erk: []int{}, drk: []int{}, hw_accel: false, rk_bytes: "", drk_bytes: ""}, wiv: "", riv: "",
        wseq: 0, rseq: 0, leftover: "", hs_leftover: ""}
}

fn deadline_ok(t_ns int) int {
    if t_ns > 0 {
        if now_ns() >= t_ns {
            >> errors.new("i/o timeout")
        }
    }
    << 0
}

pub fn client(c net.Conn, config &Config) Conn {
    $sn := config.server_name
    if sn.len == 0 {
        sn = host_of(c.raddr)
    }
    $t := empty_conn() or >>
    t.kind = 0
    t.nc = c
    t.server_name = sn
    handshake_client($&t, config) or >>
    << t
}

pub fn client_pipe(c net.PipeConn, config &Config) Conn {
    $sn := config.server_name
    $t := empty_conn() or >>
    t.kind = 1
    t.pc = c
    t.server_name = sn
    handshake_client($&t, config) or >>
    << t
}

pub fn server(c net.Conn, config &Config) Conn {
    $t := empty_conn() or >>
    t.kind = 0
    t.nc = c
    t.server_name = config.server_name
    handshake_server($&t, config) or >>
    << t
}

pub fn server_pipe(c net.PipeConn, config &Config) Conn {
    $t := empty_conn() or >>
    t.kind = 1
    t.pc = c
    t.server_name = config.server_name
    handshake_server($&t, config) or >>
    << t
}

pub fn client_fd(fd int, server_name string) Conn {
    nc := net.file_conn(fd) or >>
    cfg := new_config(server_name)
    << client(nc, &cfg)
}

pub fn dial(network string, addr string, config &Config) Conn {
    a := addr
    nc := net.dial_to(network, a) or >>
    << client(nc, config)
}

pub fn dial_context(ctx &context.Context, network string, addr string, config &Config) Conn {
    a := addr
    nc := net.dial_context(ctx, network, a) or >>
    << client(nc, config)
}

pub fn (d Dialer) dial(network string, addr string) Conn {
    a := addr
    $nd := net.new_dialer()
    nd.timeout_ns = d.timeout_ns
    nc := nd.dial(network, a) or >>
    $raw := nc
    if d.timeout_ns > 0 {
        deadline := now_ns() + d.timeout_ns
        raw.set_deadline(deadline) or >>
    }
    $out := client(raw, &d.config) or >>
    if d.timeout_ns > 0 { out.set_deadline(0) or >> }
    << out
}

pub fn (d Dialer) dial_context(ctx &context.Context, network string, addr string) Conn {
    a := addr
    $nd := net.new_dialer()
    nd.timeout_ns = d.timeout_ns
    nc := nd.dial_context(ctx, network, a) or >>
    << client(nc, &d.config)
}

pub fn (c &Conn) handshake() int {
    if c.handshake_complete {
        << 0
    }
    >> errors.new("tls: handshake not started")
    << 0
}

pub fn (c Conn) connection_state() ConnectionState {
    << ConnectionState{server_name: c.server_name, handshake_complete: c.handshake_complete, cipher_suite: c.cipher_suite, version: c.version}
}

pub fn (c $&Conn) set_deadline(t_ns int) int {
    c.read_deadline_ns = t_ns
    c.write_deadline_ns = t_ns
    if c.kind == 0 {
        nc := $&c.nc
        nc.set_deadline(t_ns) or >>
    }
    << 0
}

pub fn (c $&Conn) set_read_deadline(t_ns int) int {
    c.read_deadline_ns = t_ns
    if c.kind == 0 {
        nc := $&c.nc
        nc.set_read_deadline(t_ns) or >>
    }
    << 0
}

pub fn (c $&Conn) set_write_deadline(t_ns int) int {
    c.write_deadline_ns = t_ns
    if c.kind == 0 {
        nc := $&c.nc
        nc.set_write_deadline(t_ns) or >>
    }
    << 0
}

pub fn (c $&Conn) read(max int) string {
    deadline_ok(c.read_deadline_ns) or >>
    if c.leftover.len > 0 {
        s := c.leftover
        if max <= 0 || max >= s.len {
            c.leftover = ""
            << s
        }
        c.leftover = s[max:s.len]
        << s[0:max]
    }
    $rec := rec_read_enc(c) or >>
    while c.version == VERSION_TLS13 && rec.typ == REC_HS {
        // TLS 1.3 peers commonly send post-handshake NewSessionTicket before
        // the first application record. Resumption is not implemented yet,
        // so consume well-formed tickets and continue.
        if rec.frag.len < 4 || (rec.frag[0] & 255) != 4 {
            >> errors.new("tls: unexpected post-handshake message")
        }
        rec = rec_read_enc(c) or >>
    }
    if rec.typ == REC_ALERT {
        if rec.frag.len >= 2 && (rec.frag[1] & 255) == 0 { << "" }
        >> errors.new("tls: alert")
    }
    if rec.typ != REC_APP {
        >> errors.new("tls: unexpected record")
    }
    s := rec.frag
    if max > 0 && s.len > max {
        c.leftover = s[max:s.len]
        << s[0:max]
    }
    << s
}

pub fn (c $&Conn) write(data &string) int {
    deadline_ok(c.write_deadline_ns) or >>
    if data.len == 0 {
        << 0
    }
    rec_write_enc(c, REC_APP, data) or >>
    << data.len
}

pub fn (c $&Conn) close() int {
    if c.kind == 1 {
        << 0
    }
    nc_ref := &c.nc
    if !nc_ref.is_closed() {
        if c.handshake_complete {
            // warning(1), close_notify(0). TLS 1.2 requires an orderly alert
            // before transport EOF; OpenSSL 3 treats a bare close as an
            // unexpected EOF even after all application data was delivered.
            $alert := io.buffer()
            alert_level := string_from_byte(1)
            alert_desc := string_from_byte(0)
            alert.write(&alert_level)
            alert.write(&alert_desc)
            alert_s := alert.bytes()
            rec_write_enc(c, REC_ALERT, &alert_s) or (err) {
                nc := $&c.nc
                nc.close() or (close_err) { >> err }
                >> err
            }
        }
        nc := $&c.nc
        nc.close() or >>
    }
    << 0
}
