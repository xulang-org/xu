@crypto/tls

#errors
#net
#crypto/aes
#crypto/cipher
#crypto/rand
#io

const rec_ccs = 20
const rec_alert = 21
const rec_hs = 22
const rec_app = 23

// RFC 5246 §6.2.1 / RFC 8446 §5.1 record layer limits.
const max_plaintext_len = 16384
const max_ciphertext_len = 18432
const max_seq_num = 9223372036854775806

fn check_seq_limit(seq int) int {
    if seq < 0 || seq >= max_seq_num {
        >> errors.new("tls: sequence number overflow")
    }
    << 0
}

fn push_s(b &mut []int, s &string) {
    mut i := 0
    while i < s.len {
        b.push(s[i] & 255)
        i = i + 1
    }
}

fn be16(n int) string {
    mut b := []int{}
    b.push((n >> 8) & 255)
    b.push(n & 255)
    << string_from_bytes(b)
}

fn be24(n int) string {
    mut b := []int{}
    b.push((n >> 16) & 255)
    b.push((n >> 8) & 255)
    b.push(n & 255)
    << string_from_bytes(b)
}

fn be64(n int) string {
    mut b := []int{}
    mut i := 7
    while i >= 0 {
        b.push((n >> (8 * i)) & 255)
        i = i - 1
    }
    << string_from_bytes(b)
}

fn u16_at(s &string, off int) int {
    if off + 1 >= s.len {
        >> errors.new("tls: truncated")
    }
    << ((s[off] & 255) << 8) | (s[off + 1] & 255)
}

fn u24_at(s &string, off int) int {
    if off + 2 >= s.len {
        >> errors.new("tls: truncated")
    }
    << ((s[off] & 255) << 16) | ((s[off + 1] & 255) << 8) | (s[off + 2] & 255)
}

fn slice_copy(s &string, a int, b int) string {
    raw := s
    if a < 0 || b < a || b > raw.len {
        >> errors.new("tls: truncated")
    }
    // Copy byte-by-byte instead of returning a dynamic slice view. This keeps
    // record fragments owning and avoids backend-specific bounds handling for
    // computed offsets on bootstrap targets.
    mut out := []int{}
    mut i := a
    while i < b {
        out.push(raw[i] & 255)
        i = i + 1
    }
    << string_from_bytes(out)
}

fn hs_wrap(typ int, body &string) string {
    n := body.len
    mut b := []int{}
    b.push(typ & 255)
    ln := be24(n)
    push_s(mut &b, &ln)
    push_s(mut &b, body)
    << string_from_bytes(b)
}

fn rec_wrap(typ int, frag &string) string {
    n := frag.len
    mut b := []int{}
    b.push(typ & 255)
    b.push(3)
    b.push(3)
    b.push((n >> 8) & 255)
    b.push(n & 255)
    push_s(mut &b, frag)
    << string_from_bytes(b)
}

struct Rec {
    typ int
    ver int
    frag string
}

fn parse_rec(raw0 &string) Rec {
    raw := raw0 + ""
    if raw.len < 5 {
        >> errors.new("tls: short record")
    }
    n := u16_at(&raw, 3) or >>
    if n > max_ciphertext_len {
        >> errors.new("tls: record overflow")
    }
    if raw.len != 5 + n {
        >> errors.new("tls: record length")
    }
    ver := u16_at(&raw, 1) or >>
    frag := slice_copy(&raw, 5, raw.len) or >>
    << Rec{typ: raw[0] & 255, ver: ver, frag: frag}
}

fn io_write(c &mut Conn, data string) int {
    if c.kind == 1 {
        p := mut &c.pc
        << p.write(data) or >>
    }
    n := mut &c.nc
    << n.write(&data) or >>
}

fn io_read_n(c &mut Conn, n int) string {
    if n <= 0 {
        << ""
    }
    if c.kind == 1 {
        << c.pc.read()
    }
    mut out := io.buffer()
    mut got := 0
    while got < n {
        nc := mut &c.nc
        chunk := nc.read(n - got) or >>
        if chunk.len == 0 {
            >> errors.new("tls: eof")
        }
        out.write(&chunk)
        got = got + chunk.len
    }
    << out.bytes()
}

fn rec_write(c &mut Conn, typ int, frag &string) int {
    if frag.len > max_ciphertext_len {
        >> errors.new("tls: record overflow")
    }
    rec := rec_wrap(typ, frag)
    << io_write(c, rec) or >>
}

fn rec_read(c &mut Conn) Rec {
    if c.kind == 1 {
        raw := c.pc.read() or >>
        << parse_rec(&raw)
    }
    hdr := io_read_n(c, 5) or >>
    n := u16_at(&hdr, 3) or >>
    if n > max_ciphertext_len {
        >> errors.new("tls: record overflow")
    }
    body := io_read_n(c, n) or >>
    mut raw := io.buffer()
    raw.write(&hdr)
    raw.write(&body)
    raw_s := raw.bytes()
    << parse_rec(&raw_s)
}

fn gcm_aad(seq int, typ int, n int) string {
    mut b := []int{}
    seqb := be64(seq)
    push_s(mut &b, &seqb)
    b.push(typ & 255)
    b.push(3)
    b.push(3)
    b.push((n >> 8) & 255)
    b.push(n & 255)
    << string_from_bytes(b)
}

fn gcm_nonce(iv &string, seq int) string {
    mut out := io.buffer()
    out.write(iv)
    seqb := be64(seq)
    out.write(&seqb)
    << out.bytes()
}

fn tls13_nonce(iv &string, seq int) string {
    if iv.len != 12 {
        >> errors.new("tls: invalid TLS 1.3 iv")
    }
    mut out := []int{}
    mut i := 0
    while i < 12 {
        out.push(iv[i] & 255)
        i = i + 1
    }
    seqb := be64(seq)
    i = 0
    while i < 8 {
        out[4 + i] = (out[4 + i] ^ (seqb[i] & 255)) & 255
        i = i + 1
    }
    << string_from_bytes(out)
}

fn tls13_aad(n int) string {
    mut b := []int{}
    b.push(rec_app)
    b.push(3)
    b.push(3)
    b.push((n >> 8) & 255)
    b.push(n & 255)
    << string_from_bytes(b)
}

fn rec_write_enc13_one(c &mut Conn, typ int, plain &string) int {
    if plain.len > max_plaintext_len {
        >> errors.new("tls: record overflow")
    }
    mut inner := io.buffer()
    inner.write(plain)
    inner_type := string_from_byte(typ)
    inner.write(&inner_type)
    inner_s := inner.bytes()
    seq := c.wseq
    check_seq_limit(seq) or >>
    nonce := tls13_nonce(&c.wiv, seq) or >>
    aad := tls13_aad(inner_s.len + 16)
    sealed := cipher.seal_gcm(&c.wcip, &nonce, &inner_s, &aad) or >>
    c.wseq = seq + 1
    << rec_write(c, rec_app, &sealed) or >>
}

fn rec_write_enc13(c &mut Conn, typ int, plain &string) int {
    if plain.len <= max_plaintext_len {
        << rec_write_enc13_one(c, typ, plain) or >>
    }
    mut off := 0
    mut written := 0
    while off < plain.len {
        mut end := off + max_plaintext_len
        if end > plain.len {
            end = plain.len
        }
        chunk := slice_copy(plain, off, end) or >>
        n := rec_write_enc13_one(c, typ, &chunk) or >>
        written = written + n
        off = end
    }
    << written
}

fn rec_open13(c &mut Conn, rec &Rec) Rec {
    if rec.typ == rec_alert {
        >> errors.new("tls: alert")
    }
    if rec.typ != rec_app || rec.frag.len < 17 || rec.frag.len > max_ciphertext_len {
        >> errors.new("tls: invalid TLS 1.3 record")
    }
    seq := c.rseq
    check_seq_limit(seq) or >>
    nonce := tls13_nonce(&c.riv, seq) or >>
    aad := tls13_aad(rec.frag.len)
    plain := cipher.open_gcm(&c.rcip, &nonce, &rec.frag, &aad) or >>
    c.rseq = seq + 1
    mut end := plain.len - 1
    while end >= 0 && (plain[end] & 255) == 0 {
        end = end - 1
    }
    if end < 0 {
        >> errors.new("tls: empty TLS 1.3 inner plaintext")
    }
    if end > max_plaintext_len {
        >> errors.new("tls: record overflow")
    }
    typ := plain[end] & 255
    frag := slice_copy(&plain, 0, end) or >>
    << Rec{typ: typ, ver: version_tls13, frag: frag}
}

fn rec_read_enc13(c &mut Conn) Rec {
    while true {
        rec := rec_read(c) or >>
        // Middlebox-compatibility CCS is outside TLS 1.3 encryption.
        if rec.typ == rec_ccs && rec.frag.len == 1 && (rec.frag[0] & 255) == 1 {
            ->
        }
        << rec_open13(c, &rec)
    }
    >> errors.new("tls: unreachable")
}

fn rec_write_enc12_one(c &mut Conn, typ int, plain &string) int {
    if plain.len > max_plaintext_len {
        >> errors.new("tls: record overflow")
    }
    seq := c.wseq
    check_seq_limit(seq) or >>
    nonce := gcm_nonce(&c.wiv, seq)
    aad := gcm_aad(seq, typ, plain.len)
    expl := be64(seq)
    sealed := cipher.seal_gcm(&c.wcip, &nonce, plain, &aad) or >>
    mut frag := io.buffer()
    frag.write(&expl)
    frag.write(&sealed)
    c.wseq = seq + 1
    frag_s := frag.bytes()
    << rec_write(c, typ, &frag_s) or >>
}

fn rec_write_enc(c &mut Conn, typ int, plain &string) int {
    if c.version == version_tls13 {
        << rec_write_enc13(c, typ, plain) or >>
    }
    if plain.len <= max_plaintext_len {
        << rec_write_enc12_one(c, typ, plain) or >>
    }
    mut off := 0
    mut written := 0
    while off < plain.len {
        mut end := off + max_plaintext_len
        if end > plain.len {
            end = plain.len
        }
        chunk := slice_copy(plain, off, end) or >>
        n := rec_write_enc12_one(c, typ, &chunk) or >>
        written = written + n
        off = end
    }
    << written
}

fn rec_read_enc(c &mut Conn) Rec {
    if c.version == version_tls13 {
        << rec_read_enc13(c) or >>
    }
    rec := rec_read(c) or >>
    if rec.typ == rec_alert {
        >> errors.new("tls: alert")
    }
    frag := rec.frag
    if frag.len < 24 || frag.len > max_ciphertext_len {
        >> errors.new("tls: short gcm")
    }
    expl := slice_copy(&frag, 0, 8)
    sealed := slice_copy(&frag, 8, frag.len)
    mut nonce := io.buffer()
    nonce.write(&c.riv)
    nonce.write(&expl)
    nonce_s := nonce.bytes()
    seq := c.rseq
    check_seq_limit(seq) or >>
    pt_len := sealed.len - 16
    if pt_len < 0 || pt_len > max_plaintext_len {
        >> errors.new("tls: short gcm")
    }
    aad := gcm_aad(seq, rec.typ, pt_len)
    plain := cipher.open_gcm(&c.rcip, &nonce_s, &sealed, &aad) or >>
    c.rseq = seq + 1
    << Rec{typ: rec.typ, ver: rec.ver, frag: plain}
}
