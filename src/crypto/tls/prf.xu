@crypto/tls

#crypto/hmac
#crypto/sha256
#io

fn hmac_sha256_raw(key &string, data &string) string {
    $d := hmac.new256(key)
    d.write(data)
    << d.sum_bytes()
}

fn p_hash(secret &string, seed &string, n int) string {
    $out := []int{}
    $a := hmac_sha256_raw(secret, seed)
    while out.len < n {
        $cat := io.buffer()
        cat.write(&a)
        cat.write(seed)
        cat_s := cat.bytes()
        blk := hmac_sha256_raw(secret, &cat_s)
        $i := 0
        while i < blk.len {
            if out.len < n {
                out.push(blk[i] & 255)
            }
            i = i + 1
        }
        nxt := hmac_sha256_raw(secret, &a)
        a = nxt
    }
    << string_from_bytes(out)
}

fn tls12_prf(secret &string, label &string, seed &string, n int) string {
    $s := io.buffer()
    s.write(label)
    s.write(seed)
    s_s := s.bytes()
    << p_hash(secret, &s_s, n)
}

fn master_secret(pms &string, cr &string, sr &string) string {
    $seed := io.buffer()
    seed.write(cr)
    seed.write(sr)
    seed_s := seed.bytes()
    lab := "master secret"
    << tls12_prf(pms, &lab, &seed_s, 48)
}

fn key_block40(ms &string, cr &string, sr &string) string {
    $seed := io.buffer()
    seed.write(sr)
    seed.write(cr)
    seed_s := seed.bytes()
    lab := "key expansion"
    << tls12_prf(ms, &lab, &seed_s, 40)
}

fn finished_vd(ms &string, label &string, hs_hash &string) string {
    << tls12_prf(ms, label, hs_hash, 12)
}
