@crypto/tls

#errors
#crypto/aes
#encoding/pem
#encoding/asn1
#crypto/rand
#crypto/rsa
#crypto/rsa/oaep
#crypto/ecdsa
#crypto/ed25519
#crypto/sha256
#crypto/sha512
#crypto/x509
#math/big
#time
#io

const HS_CH = 1
const HS_SH = 2
const HS_CERT = 11
const HS_SKE = 12
const HS_SHD = 14
const HS_CKE = 16
const HS_FIN = 20

fn make_random() string {
    << rand.read(32)
}

fn zeros16() string {
    $b := []int{}
    $i := 0
    while i < 16 {
        b.push(0)
        i = i + 1
    }
    << string_from_bytes(b)
}

fn parse_hs_one(frag0 &string) int {
    frag := frag0 + ""
    if frag.len < 4 {
        >> errors.new("tls: short handshake")
    }
    ln := u24_at(frag0, 1) or >>
    if frag.len != 4 + ln {
        >> errors.new("tls: handshake length")
    }
    << frag[0] & 255
}

fn hs_body(frag0 &string) string {
    frag := frag0 + ""
    << slice_copy(&frag, 4, frag.len) or >>
}

fn ecdhe_public_size(group int) int {
    if group == 23 { << ecdsa.PUBLIC_KEY_SIZE_P256 }
    if group == 24 { << ecdsa.PUBLIC_KEY_SIZE_P384 }
    if group == 25 { << ecdsa.PUBLIC_KEY_SIZE_P521 }
    >> errors.new("tls: unsupported ECDHE group")
}

fn ecdhe_curve_for_size(size int) int {
    if size == ecdsa.PUBLIC_KEY_SIZE_P256 { << ecdsa.P256 }
    if size == ecdsa.PUBLIC_KEY_SIZE_P384 { << ecdsa.P384 }
    if size == ecdsa.PUBLIC_KEY_SIZE_P521 { << ecdsa.P521 }
    >> errors.new("tls: invalid ECDHE point")
}

fn make_client_hello(random &string, name &string, key_shares &[]string, protocols &[]string) string {
    $b := []int{}
    b.push(3)
    b.push(3)
    push_s($&b, random)
    // A non-empty legacy session id enables TLS 1.3 middlebox compatibility.
    b.push(32)
    $si := 0
    while si < 32 {
        b.push(random[si] & 255)
        si = si + 1
    }
    b.push(0)
    b.push(10)
    b.push((TLS_AES_128_GCM_SHA256 >> 8) & 255)
    b.push(TLS_AES_128_GCM_SHA256 & 255)
    b.push((TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 >> 8) & 255)
    b.push(TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 & 255)
    b.push((TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 >> 8) & 255)
    b.push(TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 & 255)
    b.push((TLS_RSA_WITH_AES_128_GCM_SHA256 >> 8) & 255)
    b.push(TLS_RSA_WITH_AES_128_GCM_SHA256 & 255)
    // TLS_EMPTY_RENEGOTIATION_INFO_SCSV (RFC 5746).
    b.push(0)
    b.push(255)
    b.push(1)
    b.push(0)
    $ext := []int{}
    if name.len > 0 {
        nlen := name.len
        list_len := 3 + nlen
        ext_data := 2 + list_len
        ext.push(0)
        ext.push(0)
        ext.push((ext_data >> 8) & 255)
        ext.push(ext_data & 255)
        ext.push((list_len >> 8) & 255)
        ext.push(list_len & 255)
        ext.push(0)
        ext.push((nlen >> 8) & 255)
        ext.push(nlen & 255)
        $ni := 0
        while ni < name.len {
            ext.push(name[ni] & 255)
            ni = ni + 1
        }
    }
    if protocols.len > 0 {
        $list := []int{}
        for i in 0:protocols.len {
            proto := &protocols[i]
            if proto.len == 0 || proto.len > 255 || list.len > 65533 - proto.len - 1 {
                >> errors.new("tls: invalid ALPN protocol list")
            }
            list.push(proto.len)
            push_s($&list, proto)
        }
        ext.push(0)
        ext.push(16)
        ext_len := be16(list.len + 2)
        list_len := be16(list.len)
        push_s($&ext, &ext_len)
        push_s($&ext, &list_len)
        for i in 0:list.len { ext.push(list[i]) }
    }
    // TLS 1.2 also uses supported_groups to select ECDSA certificates.
    // Offer every supported NIST curve, with matching TLS 1.3 key shares.
    ext.push(0)
    ext.push(10)
    ext.push(0)
    ext.push(8)
    ext.push(0)
    ext.push(6)
    for group in [23, 24, 25] {
        ext.push(0)
        ext.push(group)
    }
    // ec_point_formats: uncompressed.
    ext.push(0)
    ext.push(11)
    ext.push(0)
    ext.push(2)
    ext.push(1)
    ext.push(0)
    // signature_algorithms: rsa_pss_rsae_sha256, rsa_pkcs1_sha256,
    // ecdsa_secp256r1_sha256, ecdsa_secp384r1_sha384, ecdsa_secp521r1_sha512, ed25519.
    ext.push(0)
    ext.push(13)
    ext.push(0)
    ext.push(14)
    ext.push(0)
    ext.push(12)
    ext.push(8)
    ext.push(4)
    ext.push(4)
    ext.push(1)
    ext.push(4)
    ext.push(3)
    ext.push(5)
    ext.push(3)
    ext.push(6)
    ext.push(3)
    ext.push(8)
    ext.push(7)
    // supported_versions: TLS 1.3 then TLS 1.2.
    ext.push(0)
    ext.push(43)
    ext.push(0)
    ext.push(5)
    ext.push(4)
    ext.push(3)
    ext.push(4)
    ext.push(3)
    ext.push(3)
    // Supply a share for each advertised group, so a peer can select any
    // of them without requiring an unsupported HelloRetryRequest path.
    if key_shares.len != 3 {
        >> errors.new("tls: invalid TLS 1.3 key share")
    }
    $shares := []int{}
    for i in 0:3 {
        group := 23 + i
        key_share := &key_shares[i]
        size := ecdhe_public_size(group) or >>
        if key_share.len != size {
            >> errors.new("tls: invalid TLS 1.3 key share")
        }
        shares.push(0)
        shares.push(group)
        shares.push((size >> 8) & 255)
        shares.push(size & 255)
        push_s($&shares, key_share)
    }
    share_bytes := string_from_bytes(shares)
    share_len := be16(share_bytes.len)
    ext_len := be16(share_bytes.len + 2)
    ext.push(0)
    ext.push(51)
    push_s($&ext, &ext_len)
    push_s($&ext, &share_len)
    push_s($&ext, &share_bytes)
    b.push((ext.len >> 8) & 255)
    b.push(ext.len & 255)
    $ei := 0
    while ei < ext.len {
        b.push(ext[ei])
        ei = ei + 1
    }
    body := string_from_bytes(b)
    << hs_wrap(HS_CH, &body)
}

fn make_server_hello(random &string, suite int, session_id &string, key_share &string) string {
    $b := []int{}
    b.push(3)
    b.push(3)
    push_s($&b, random)
    b.push(session_id.len)
    push_s($&b, session_id)
    b.push((suite >> 8) & 255)
    b.push(suite & 255)
    b.push(0)
    if suite == TLS_AES_128_GCM_SHA256 {
        if key_share.len != ecdsa.PUBLIC_KEY_SIZE_P256 {
            >> errors.new("tls: invalid TLS 1.3 key share")
        }
        // supported_versions + server_share(secp256r1).
        b.push(0)
        b.push(79)
        b.push(0)
        b.push(43)
        b.push(0)
        b.push(2)
        b.push(3)
        b.push(4)
        b.push(0)
        b.push(51)
        b.push(0)
        b.push(69)
        b.push(0)
        b.push(23)
        b.push(0)
        b.push(65)
        push_s($&b, key_share)
    } else {
        // renegotiation_info with an empty renegotiated_connection. This
        // subset still does not implement renegotiation itself.
        b.push(0)
        b.push(5)
        b.push(255)
        b.push(1)
        b.push(0)
        b.push(1)
        b.push(0)
    }
    body := string_from_bytes(b)
    << hs_wrap(HS_SH, &body)
}

fn make_certificates(cert_pem &string) string {
    $certs := x509.new_cert_pool()
    ncert := x509.append_certificates($&certs, cert_pem)
    if ncert == 0 {
        >> errors.new("tls: no certificates")
    }
    $inner := 0
    $i := 0
    while i < certs.certs.len {
        inner = inner + 3 + certs.certs[i].raw.len
        i = i + 1
    }
    $b := []int{}
    inn := be24(inner)
    push_s($&b, &inn)
    i = 0
    while i < certs.certs.len {
        der := certs.certs[i].raw
        ln := be24(der.len)
        push_s($&b, &ln)
        push_s($&b, &der)
        i = i + 1
    }
    body := string_from_bytes(b)
    << hs_wrap(HS_CERT, &body)
}

fn make_shd() string {
    empty := ""
    << hs_wrap(HS_SHD, &empty)
}

fn make_cke(enc &string) string {
    n := enc.len
    $b := []int{}
    b.push((n >> 8) & 255)
    b.push(n & 255)
    push_s($&b, enc)
    body := string_from_bytes(b)
    << hs_wrap(HS_CKE, &body)
}

fn make_cke_point(point &string) string {
    ecdhe_curve_for_size(point.len) or >>
    $b := []int{}
    b.push(point.len)
    push_s($&b, point)
    body := string_from_bytes(b)
    << hs_wrap(HS_CKE, &body)
}

fn make_ske(cr &string, sr &string, point &string, key &rsa.PrivateKey) string {
    if point.len != ecdsa.PUBLIC_KEY_SIZE_P256 {
        >> errors.new("tls: invalid ECDHE point")
    }
    $p := []int{}
    p.push(3) // named_curve
    p.push(0)
    p.push(23) // secp256r1
    p.push(point.len)
    push_s($&p, point)
    params := string_from_bytes(p)
    $signed := io.buffer()
    signed.write(cr)
    signed.write(sr)
    signed.write(&params)
    signed_s := signed.bytes()
    digest := sha256.sum256_bytes(signed_s)
    sig := rsa.sign_pkcs1v15(key, rsa.SHA256, &digest) or >>
    $b := []int{}
    push_s($&b, &params)
    b.push(4) // sha256
    b.push(1) // rsa_pkcs1
    b.push((sig.len >> 8) & 255)
    b.push(sig.len & 255)
    push_s($&b, &sig)
    body := string_from_bytes(b)
    << hs_wrap(HS_SKE, &body)
}

fn make_finished(vd &string) string {
    << hs_wrap(HS_FIN, vd)
}

fn parse_sh_random(body0 &string) string {
    body := body0 + ""
    if body.len < 35 {
        >> errors.new("tls: short server hello")
    }
    << slice_copy(&body, 2, 34)
}

fn parse_sh_suite(body0 &string) int {
    body := body0 + ""
    if body.len < 35 {
        >> errors.new("tls: short server hello")
    }
    $i := 34
    sid := body[i] & 255
    i = i + 1 + sid
    if i + 1 >= body.len {
        >> errors.new("tls: short server hello")
    }
    << u16_at(&body, i)
}

fn certificate_chain(body0 &string) []string {
    body := body0 + ""
    if body.len < 3 {
        >> errors.new("tls: short certificate")
    }
    total := u24_at(&body, 0) or >>
    if body.len < 3 + total {
        >> errors.new("tls: short certificate")
    }
    if total < 3 {
        >> errors.new("tls: empty certificate")
    }
    $out := []string{}
    $off := 3
    end := 3 + total
    while off < end {
        if off + 3 > end {
            >> errors.new("tls: short certificate")
        }
        n := u24_at(&body, off) or >>
        off = off + 3
        if n <= 0 || off + n > end {
            >> errors.new("tls: short certificate")
        }
        out.push(slice_copy(&body, off, off + n) or >>)
        off = off + n
    }
    << out
}

fn parse_cke_enc(body0 &string) string {
    body := body0 + ""
    if body.len < 2 {
        >> errors.new("tls: short ke")
    }
    n := u16_at(&body, 0) or >>
    << slice_copy(&body, 2, 2 + n)
}

fn parse_cke_point(body0 &string) string {
    body := body0 + ""
    if body.len < 1 {
        >> errors.new("tls: short ECDHE key exchange")
    }
    n := body[0] & 255
    if n != ecdsa.PUBLIC_KEY_SIZE_P256 || body.len != 1 + n {
        >> errors.new("tls: invalid ECDHE point")
    }
    << slice_copy(&body, 1, body.len)
}

fn verify_ske_cert(body0 &string, cr &string, sr &string, cert &x509.Certificate) string {
    body := body0 + ""
    if body.len < 4 || (body[0] & 255) != 3 {
        >> errors.new("tls: unsupported ECDHE parameters")
    }
    group := u16_at(&body, 1) or >>
    size := ecdhe_public_size(group) or >>
    n := body[3] & 255
    params_end := 4 + n
    if n != size || params_end + 4 > body.len {
        >> errors.new("tls: invalid ECDHE parameters")
    }
    sig_alg := u16_at(&body, params_end) or >>
    sig_len := u16_at(&body, params_end + 2) or >>
    if sig_len <= 0 || params_end + 4 + sig_len != body.len {
        >> errors.new("tls: invalid ECDHE signature")
    }
    point := slice_copy(&body, 4, params_end) or >>
    params := slice_copy(&body, 0, params_end) or >>
    sig := slice_copy(&body, params_end + 4, body.len) or >>
    $signed := io.buffer()
    signed.write(cr)
    signed.write(sr)
    signed.write(&params)
    signed_s := signed.bytes()

    if cert.public_key_algorithm == x509.RSA {
        if sig_alg != 0x0401 && sig_alg != 0x0804 {
            >> errors.new("tls: unsupported ECDHE RSA signature")
        }
        key := x509_rsa_pub(cert) or >>
        digest := sha256.sum256_bytes(signed_s)
        if sig_alg == 0x0401 {
            rsa.verify_pkcs1v15(&key, rsa.SHA256, &digest, &sig) or >>
        } else {
            oaep.verify_pss(&key, rsa.SHA256, &digest, &sig) or >>
        }
        << point
    }
    if cert.public_key_algorithm == x509.ECDSA {
        pub_key := cert.public_key + ""
        $digest := ""
        // TLS 1.2 negotiates hash/signature pairs without binding the hash
        // to the certificate curve (RFC 8446 section 4.2.3 compatibility).
        // TLS 1.3 keeps its curve-specific rules in tls13.xu.
        if sig_alg == 0x0403 {
            digest = sha256.sum256_bytes(signed_s)
        } else if sig_alg == 0x0503 {
            digest = sha512.sum384(signed_s)
        } else if sig_alg == 0x0603 {
            digest = sha512.sum512(signed_s)
        } else {
            >> errors.new("tls: unsupported ECDHE ECDSA signature")
        }
        if !ecdsa.verify_asn1(&pub_key, &digest, &sig) {
            >> errors.new("tls: invalid ECDHE ECDSA signature")
        }
        << point
    }
    if cert.public_key_algorithm == x509.ED25519 {
        pub_key := cert.public_key + ""
        if sig_alg != 0x0807 || pub_key.len != ed25519.PUBLIC_KEY_SIZE || sig.len != ed25519.SIGNATURE_SIZE {
            >> errors.new("tls: unsupported ECDHE Ed25519 signature")
        }
        if !ed25519.verify(&pub_key, &signed_s, &sig) {
            >> errors.new("tls: invalid ECDHE Ed25519 signature")
        }
        << point
    }
    >> errors.new("tls: unsupported certificate public key")
    << ""
}

fn client_offers_suite(body0 &string, suite int) bool {
    body := body0 + ""
    if body.len < 37 {
        << false
    }
    $off := 34
    sid_len := body[off] & 255
    off = off + 1 + sid_len
    if off + 2 > body.len {
        << false
    }
    n := u16_at(&body, off) or (err) { << false }
    off = off + 2
    if n <= 0 || (n & 1) != 0 || off + n > body.len {
        << false
    }
    end := off + n
    while off < end {
        got := u16_at(&body, off) or (err) { << false }
        if got == suite {
            << true
        }
        off = off + 2
    }
    << false
}

fn pem_der(text string, want string) string {
    blk := pem.decode(&text)
    if blk.typ != want {
        >> errors.new("tls: pem type")
    }
    if blk.bytes.len == 0 {
        >> errors.new("tls: pem empty")
    }
    << blk.bytes
}

fn int_be(b &string) int {
    $x := 0
    $i := 0
    while i < b.len {
        x = (x * 256) + (b[i] & 255)
        i = i + 1
    }
    << x
}

fn parse_pkcs8_rsa(der string) rsa.PrivateKey {
    top := asn1.unmarshal(&der) or >>
    if top.tag != asn1.TAG_SEQUENCE {
        >> errors.new("tls: pkcs8")
    }
    $d := asn1.new_decoder(&top.bytes)
    ver := d.next() or >>
    alg := d.next() or >>
    // Version and algorithm identifiers are validated by the surrounding
    // PKCS#8 structure; the RSA payload below is the value we need.
    oct := d.next() or >>
    if oct.tag != asn1.TAG_OCTET_STRING {
        >> errors.new("tls: pkcs8")
    }
    inner := oct.bytes
    seq := asn1.unmarshal(&inner) or >>
    if seq.tag != asn1.TAG_SEQUENCE {
        >> errors.new("tls: rsa key")
    }
    $d2 := asn1.new_decoder(&seq.bytes)
    ver2 := d2.next() or >>
    nv := d2.next() or >>
    ev := d2.next() or >>
    dv := d2.next() or >>
    pv := d2.next() or >>
    qv := d2.next() or >>
    if nv.tag != asn1.TAG_INTEGER || ev.tag != asn1.TAG_INTEGER || dv.tag != asn1.TAG_INTEGER {
        >> errors.new("tls: rsa key")
    }
    $n := big.new_int(0)
    n.set_bytes(nv.bytes)
    e := int_be(&ev.bytes)
    $dd := big.new_int(0)
    dd.set_bytes(dv.bytes)
    $p := big.new_int(0)
    $q := big.new_int(0)
    if pv.tag == asn1.TAG_INTEGER {
        p.set_bytes(pv.bytes)
    }
    if qv.tag == asn1.TAG_INTEGER {
        q.set_bytes(qv.bytes)
    }
    << rsa.PrivateKey{public: rsa.PublicKey{n: n, e: e}, d: dd, p: p, q: q}
}

fn apply_keys(c $&Conn, ms &string, cr &string, sr &string, is_client int) int {
    kb := key_block40(ms, cr, sr)
    if kb.len < 40 {
        >> errors.new("tls: keys")
    }
    ck := slice_copy(&kb, 0, 16) or >>
    sk := slice_copy(&kb, 16, 32) or >>
    civ := slice_copy(&kb, 32, 36) or >>
    siv := slice_copy(&kb, 36, 40) or >>
    if is_client != 0 {
        c.wcip = aes.new_cipher(&ck) or >>
        c.rcip = aes.new_cipher(&sk) or >>
        c.wiv = civ
        c.riv = siv
    } else {
        c.wcip = aes.new_cipher(&sk) or >>
        c.rcip = aes.new_cipher(&ck) or >>
        c.wiv = siv
        c.riv = civ
    }
    c.wseq = 0
    c.rseq = 0
    << 0
}

fn read_ccs(c $&Conn) int {
    rec := rec_read(c) or >>
    if rec.typ != REC_CCS {
        >> errors.new("tls: expected change_cipher_spec")
    }
    << 0
}

fn expect_hs(c $&Conn, want int) string {
    rec := rec_read(c) or >>
    if rec.typ == REC_ALERT {
        >> errors.new("tls: alert")
    }
    if rec.typ != REC_HS {
        >> errors.new("tls: expected handshake")
    }
    frag := rec.frag
    t := parse_hs_one(&frag) or >>
    if t != want {
        >> errors.new("tls: handshake type")
    }
    << frag
}

fn handshake_client(c $&Conn, cfg &Config) int {
    cr := make_random()
    sn := cfg.server_name
    // Each advertised group has its own ephemeral scalar and TLS 1.3 share.
    // TLS 1.2 generates a fresh scalar after the signed ServerKeyExchange.
    $hello_privates := []string{}
    $hello_shares := []string{}
    for curve in [ecdsa.P256, ecdsa.P384, ecdsa.P521] {
        private_key := ecdsa.generate_key(curve) or >>
        public_key := ecdsa.public(&private_key) or >>
        hello_privates.push(private_key)
        hello_shares.push(public_key)
    }
    ch := make_client_hello(&cr, &sn, &hello_shares, &cfg.next_protos) or >>
    $log := io.buffer()
    log.write(&ch)
    rec_write(c, REC_HS, &ch) or >>
    shf := expect_hs(c, HS_SH) or >>
    log.write(&shf)
    shb := hs_body(&shf)
    sr := parse_sh_random(&shb) or >>
    suite := parse_sh_suite(&shb) or >>
    if suite == TLS_AES_128_GCM_SHA256 {
        log_s0 := log.bytes()
        << handshake_client13(c, cfg, &cr, &sr, &log_s0, &hello_privates, &shb)
    }
    if suite != TLS_RSA_WITH_AES_128_GCM_SHA256 && suite != TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 && suite != TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 {
        >> errors.new("tls: cipher suite")
    }
    c.cipher_suite = suite
    c.version = VERSION_TLS12
    cf := expect_hs(c, HS_CERT) or >>
    log.write(&cf)
    certb := hs_body(&cf)
    chain := certificate_chain(&certb) or >>
    cert := verify_server_chain(cfg, sn, &chain) or >>
    is_ecdhe := suite == TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 || suite == TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
    $peer_point := ""
    if is_ecdhe {
        skef := expect_hs(c, HS_SKE) or >>
        log.write(&skef)
        skeb := hs_body(&skef)
        peer_point = verify_ske_cert(&skeb, &cr, &sr, &cert) or >>
    }
    sdf := expect_hs(c, HS_SHD) or >>
    log.write(&sdf)
    $pms := ""
    $cke := ""
    if is_ecdhe {
        curve := ecdhe_curve_for_size(peer_point.len) or >>
        eph_priv := ecdsa.generate_key(curve) or >>
        eph_pub := ecdsa.public(&eph_priv) or >>
        pms = ecdsa.ecdh(&eph_priv, &peer_point) or >>
        cke = make_cke_point(&eph_pub) or >>
    } else {
        if cert.public_key_algorithm != x509.RSA {
            >> errors.new("tls: not rsa")
        }
        pk := x509_rsa_pub(&cert) or >>
        pms = make_pms()
        enc := rsa.encrypt_pkcs1v15(&pk, &pms) or >>
        cke = make_cke(&enc)
    }
    log.write(&cke)
    rec_write(c, REC_HS, &cke) or >>
    ccs := string_from_byte(1)
    rec_write(c, REC_CCS, &ccs) or >>
    ms := master_secret(&pms, &cr, &sr)
    apply_keys(c, &ms, &cr, &sr, 1) or >>
    h := sha256.sum256_bytes(log.bytes())
    lab := "client finished"
    vd := finished_vd(&ms, &lab, &h)
    fin := make_finished(&vd)
    rec_write_enc(c, REC_HS, &fin) or >>
    read_ccs(c) or >>
    frec := rec_read_enc(c) or >>
    if frec.typ != REC_HS {
        >> errors.new("tls: expected finished")
    }
    ft := parse_hs_one(&frec.frag) or >>
    if ft != HS_FIN {
        >> errors.new("tls: expected finished")
    }
    c.handshake_complete = true
    << 0
}

fn make_pms() string {
    r := rand.read(46)
    $b := []int{}
    b.push(3)
    b.push(3)
    push_s($&b, &r)
    << string_from_bytes(b)
}

fn x509_rsa_pub(c &x509.Certificate) rsa.PublicKey {
    seq := asn1.unmarshal(&c.public_key) or >>
    if seq.tag != asn1.TAG_SEQUENCE {
        >> errors.new("tls: rsa public")
    }
    $d := asn1.new_decoder(&seq.bytes)
    nv := d.next() or >>
    ev := d.next() or >>
    $n := big.new_int(0)
    n.set_bytes(nv.bytes)
    e := int_be(&ev.bytes)
    << rsa.PublicKey{n: n, e: e}
}

fn verify_server_chain(cfg &Config, name string, chain &[]string) x509.Certificate {
    if chain.len == 0 {
        >> errors.new("tls: empty certificate")
    }
    cert := x509.parse_certificate(chain[0]) or >>
    if !cfg.insecure_skip_verify {
        $intermediates := x509.new_cert_pool()
        $ci := 1
        while ci < chain.len {
            intermediate := x509.parse_certificate(chain[ci]) or >>
            intermediates.add(intermediate)
            ci = ci + 1
        }
        now := time.now_time()
        if cfg.root_cas.certs.len > 0 {
            cert.verify_with_pools(name, now, &cfg.root_cas, &intermediates) or >>
        } else {
            roots := x509.system_cert_pool()
            cert.verify_with_pools(name, now, &roots, &intermediates) or >>
        }
    }
    << cert
}

fn handshake_server(c $&Conn, cfg &Config) int {
    keyder := pem_der(cfg.key_pem, "PRIVATE KEY") or >>
    sk := parse_pkcs8_rsa(keyder) or >>
    rec := rec_read(c) or >>
    if rec.typ != REC_HS {
        >> errors.new("tls: expected handshake")
    }
    $log := io.buffer()
    log.write(&rec.frag)
    t := parse_hs_one(&rec.frag) or >>
    if t != HS_CH {
        >> errors.new("tls: expected client hello")
    }
    chb := hs_body(&rec.frag)
    if chb.len < 34 {
        >> errors.new("tls: short client hello")
    }
    cr := slice_copy(&chb, 2, 34)
    $suite := 0
    if client_supports_tls13(&chb) && client_offers_suite(&chb, TLS_AES_128_GCM_SHA256) {
        suite = TLS_AES_128_GCM_SHA256
    } else if client_offers_suite(&chb, TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256) {
        suite = TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
    } else if client_offers_suite(&chb, TLS_RSA_WITH_AES_128_GCM_SHA256) {
        suite = TLS_RSA_WITH_AES_128_GCM_SHA256
    } else {
        >> errors.new("tls: no shared cipher suite")
    }
    c.cipher_suite = suite
    sr := make_random()
    $session_id := ""
    $server_share := ""
    $shared := ""
    if suite == TLS_AES_128_GCM_SHA256 {
        session_id = client_session_id(&chb) or >>
        peer_share := client_key_share_p256(&chb) or >>
        server_private := ecdsa.generate_key(ecdsa.P256) or >>
        server_share = ecdsa.public(&server_private) or >>
        shared = ecdsa.ecdh(&server_private, &peer_share) or >>
    }
    sh := make_server_hello(&sr, suite, &session_id, &server_share) or >>
    log.write(&sh)
    rec_write(c, REC_HS, &sh) or >>
    if suite == TLS_AES_128_GCM_SHA256 {
        log_s1 := log.bytes()
        << handshake_server13(c, cfg, &sk, &log_s1, &shared)
    }
    c.version = VERSION_TLS12
    cm := make_certificates(&cfg.cert_pem) or >>
    log.write(&cm)
    rec_write(c, REC_HS, &cm) or >>
    $eph_priv := ""
    if suite == TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 {
        eph_priv = ecdsa.generate_key(ecdsa.P256) or >>
        eph_pub := ecdsa.public(&eph_priv) or >>
        ske := make_ske(&cr, &sr, &eph_pub, &sk) or >>
        log.write(&ske)
        rec_write(c, REC_HS, &ske) or >>
    }
    sd := make_shd()
    log.write(&sd)
    rec_write(c, REC_HS, &sd) or >>
    ckf := expect_hs(c, HS_CKE) or >>
    log.write(&ckf)
    ckeb := hs_body(&ckf)
    $pms := ""
    if suite == TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 {
        peer_point := parse_cke_point(&ckeb) or >>
        pms = ecdsa.ecdh(&eph_priv, &peer_point) or >>
    } else {
        enc := parse_cke_enc(&ckeb) or >>
        pms = rsa.decrypt_pkcs1v15(&sk, &enc) or >>
        if pms.len != 48 {
            >> errors.new("tls: pms")
        }
    }
    read_ccs(c) or >>
    ms := master_secret(&pms, &cr, &sr)
    apply_keys(c, &ms, &cr, &sr, 0) or >>
    frec := rec_read_enc(c) or >>
    if frec.typ != REC_HS {
        >> errors.new("tls: expected finished")
    }
    ft := parse_hs_one(&frec.frag) or >>
    if ft != HS_FIN {
        >> errors.new("tls: expected finished")
    }
    log.write(&frec.frag)
    ccs := string_from_byte(1)
    rec_write(c, REC_CCS, &ccs) or >>
    h := sha256.sum256_bytes(log.bytes())
    lab := "server finished"
    vd := finished_vd(&ms, &lab, &h)
    fin := make_finished(&vd)
    rec_write_enc(c, REC_HS, &fin) or >>
    c.handshake_complete = true
    << 0
}
