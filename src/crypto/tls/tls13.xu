@crypto/tls

// XU-CT-USE: fixed-shape-only
// Finished equality is narrow; the TLS stack remains explicitly variable-time.

#errors
#crypto/aes
#crypto/ecdsa
#crypto/ed25519
#crypto/hmac
#crypto/rsa
#crypto/rsa/oaep
#crypto/sha256
#crypto/sha512
#crypto/subtle
#crypto/x509
#io

const hs13_encrypted_extensions = 8
const hs13_certificate_verify = 15

// RFC 8446 §4.2.3 SignatureScheme values
const sig_rsa_pkcs1_sha256 = 0x0401
const sig_ecdsa_secp256r1_sha256 = 0x0403
const sig_ecdsa_secp384r1_sha384 = 0x0503
const sig_ecdsa_secp521r1_sha512 = 0x0603
const sig_rsa_pss_rsae_sha256 = 0x0804
const sig_ed25519 = 0x0807

struct Tls13Ext {
    found bool
    data string
}

struct Tls13HandshakeSecrets {
    client string
    server string
    master string
}

struct Tls13ApplicationSecrets {
    client string
    server string
}

fn zeros_n(n int) string {
    mut b := []int{}
    mut i := 0
    while i < n {
        b.push(0)
        i = i + 1
    }
    << string_from_bytes(b)
}

fn hkdf_extract_sha256(salt &string, ikm &string) string {
    << hmac_sha256_raw(salt, ikm)
}

fn hkdf_expand_sha256(secret &string, info &string, n int) string {
    if n < 0 || n > 255 * 32 {
        >> errors.new("tls: invalid HKDF length")
    }
    mut out := io.buffer()
    mut out_len := 0
    mut prev := ""
    mut counter := 1
    while out_len < n {
        mut input := io.buffer()
        input.write(&prev)
        input.write(info)
        counter_s := string_from_byte(counter)
        input.write(&counter_s)
        input_s := input.bytes()
        prev = hmac_sha256_raw(secret, &input_s)
        out.write(&prev)
        out_len = out_len + prev.len
        counter = counter + 1
    }
    out_s := out.bytes()
    << slice_copy(&out_s, 0, n)
}

fn hkdf_expand_label(secret &string, label string, context &string, n int) string {
    mut full_b := io.buffer()
    prefix := "tls13 "
    full_b.write(&prefix)
    full_b.write(&label)
    full := full_b.bytes()
    if full.len > 255 || context.len > 255 || n > 65535 {
        >> errors.new("tls: invalid HKDF label")
    }
    mut b := []int{}
    b.push((n >> 8) & 255)
    b.push(n & 255)
    b.push(full.len)
    push_s(mut &b, &full)
    b.push(context.len)
    push_s(mut &b, context)
    info := string_from_bytes(b)
    << hkdf_expand_sha256(secret, &info, n)
}

fn tls13_derive_secret(secret &string, label string, transcript &string) string {
    transcript_s := transcript + ""
    context := sha256.sum256_bytes(transcript_s)
    << hkdf_expand_label(secret, label, &context, 32) or >>
}

fn tls13_handshake_secrets(shared &string, transcript &string) Tls13HandshakeSecrets {
    zeros := zeros_n(32)
    empty := ""
    early := hkdf_extract_sha256(&zeros, &zeros)
    derived_label := "derived"
    client_label := "c hs traffic"
    server_label := "s hs traffic"
    derived := tls13_derive_secret(&early, derived_label + "", &empty) or >>
    handshake := hkdf_extract_sha256(&derived, shared)
    client := tls13_derive_secret(&handshake, client_label + "", transcript) or >>
    server := tls13_derive_secret(&handshake, server_label + "", transcript) or >>
    derived2 := tls13_derive_secret(&handshake, derived_label + "", &empty) or >>
    master := hkdf_extract_sha256(&derived2, &zeros)
    << Tls13HandshakeSecrets{client: client, server: server, master: master}
}

fn tls13_application_secrets(master &string, transcript &string) Tls13ApplicationSecrets {
    client_label := "c ap traffic"
    server_label := "s ap traffic"
    client := tls13_derive_secret(master, client_label + "", transcript) or >>
    server := tls13_derive_secret(master, server_label + "", transcript) or >>
    << Tls13ApplicationSecrets{client: client, server: server}
}

fn tls13_finished_data(secret &string, transcript &string) string {
    empty := ""
    finished_label := "finished"
    finished_key := hkdf_expand_label(secret, finished_label + "", &empty, 32) or >>
    transcript_s := transcript + ""
    th := sha256.sum256_bytes(transcript_s)
    << hmac_sha256_raw(&finished_key, &th)
}

fn apply_tls13_traffic(c &mut Conn, client_secret &string, server_secret &string, is_client int) int {
    empty := ""
    key_label := "key"
    iv_label := "iv"
    ck := hkdf_expand_label(client_secret, key_label + "", &empty, 16) or >>
    sk := hkdf_expand_label(server_secret, key_label + "", &empty, 16) or >>
    civ := hkdf_expand_label(client_secret, iv_label + "", &empty, 12) or >>
    siv := hkdf_expand_label(server_secret, iv_label + "", &empty, 12) or >>
    if is_client != 0 {
        c.wcip = aes.new_cipher(&ck) or >>
        c.rcip = aes.new_cipher(&sk) or >>
        c.wiv = civ
        c.riv = siv
    } else {
        c.wcip = aes.new_cipher(&sk) or >>
        c.rcip = aes.new_cipher(&ck) or >>
        c.wiv = siv
        c.riv = civ
    }
    c.wseq = 0
    c.rseq = 0
    << 0
}

fn client_ext_start(body &string) int {
    if body.len < 39 {
        >> errors.new("tls: short client hello")
    }
    mut off := 34
    sid := body[off] & 255
    off = off + 1 + sid
    if off + 2 > body.len {
        >> errors.new("tls: short client hello")
    }
    suites := u16_at(body, off) or >>
    off = off + 2 + suites
    if off >= body.len {
        >> errors.new("tls: short client hello")
    }
    compression := body[off] & 255
    off = off + 1 + compression
    if off + 2 > body.len {
        >> errors.new("tls: missing client extensions")
    }
    << off
}

fn server_ext_start(body &string) int {
    if body.len < 40 {
        >> errors.new("tls: short server hello")
    }
    mut off := 34
    sid := body[off] & 255
    off = off + 1 + sid
    if off + 5 > body.len {
        >> errors.new("tls: short server hello")
    }
    off = off + 3 // suite + compression
    << off
}

fn find_hello_ext(body &string, ext_off int, want int) Tls13Ext {
    total := u16_at(body, ext_off) or >>
    mut off := ext_off + 2
    end := off + total
    if end != body.len {
        >> errors.new("tls: malformed hello extensions")
    }
    while off < end {
        if off + 4 > end {
            >> errors.new("tls: malformed hello extension")
        }
        typ := u16_at(body, off) or >>
        n := u16_at(body, off + 2) or >>
        off = off + 4
        if off + n > end {
            >> errors.new("tls: malformed hello extension")
        }
        if typ == want {
            data := slice_copy(body, off, off + n) or >>
            << Tls13Ext{found: true, data: data}
        }
        off = off + n
    }
    << Tls13Ext{found: false, data: ""}
}

fn client_session_id(body &string) string {
    if body.len < 35 {
        >> errors.new("tls: short client hello")
    }
    n := body[34] & 255
    << slice_copy(body, 35, 35 + n)
}

fn client_supports_tls13(body &string) bool {
    off := client_ext_start(body) or (err) { << false }
    ext := find_hello_ext(body, off, 43) or (err) { << false }
    if !ext.found || ext.data.len < 3 {
        << false
    }
    n := ext.data[0] & 255
    if n + 1 != ext.data.len || (n & 1) != 0 {
        << false
    }
    mut i := 1
    while i + 1 < ext.data.len {
        if (ext.data[i] & 255) == 3 && (ext.data[i + 1] & 255) == 4 {
            << true
        }
        i = i + 2
    }
    << false
}

fn client_key_share_p256(body &string) string {
    off := client_ext_start(body) or >>
    ext := find_hello_ext(body, off, 51) or >>
    if !ext.found || ext.data.len < 2 {
        >> errors.new("tls: missing key share")
    }
    total := u16_at(&ext.data, 0) or >>
    mut i := 2
    if total + 2 != ext.data.len {
        >> errors.new("tls: malformed key share")
    }
    while i < ext.data.len {
        if i + 4 > ext.data.len {
            >> errors.new("tls: malformed key share")
        }
        group := u16_at(&ext.data, i) or >>
        n := u16_at(&ext.data, i + 2) or >>
        i = i + 4
        if i + n > ext.data.len {
            >> errors.new("tls: malformed key share")
        }
        if group == 23 && n == ecdsa.public_key_size_p256 {
            << slice_copy(&ext.data, i, i + n)
        }
        i = i + n
    }
    >> errors.new("tls: no P-256 key share")
}

fn server_key_share_p256(body &string) string {
    off := server_ext_start(body) or >>
    version := find_hello_ext(body, off, 43) or >>
    if !version.found || version.data.len != 2 || (version.data[0] & 255) != 3 || (version.data[1] & 255) != 4 {
        >> errors.new("tls: server did not select TLS 1.3")
    }
    share := find_hello_ext(body, off, 51) or >>
    share_data := share.data + ""
    if !share.found || share_data.len < 4 || u16_at(&share_data, 0) != 23 {
        >> errors.new("tls: invalid server key share")
    }
    n := u16_at(&share_data, 2) or >>
    if n != ecdsa.public_key_size_p256 || share_data.len != 4 + n {
        >> errors.new("tls: invalid server key share")
    }
    << slice_copy(&share_data, 4, share_data.len)
}

fn expect_hs13(c &mut Conn, want int) string {
    mut buf := io.buffer()
    mut buf_len := 0
    if c.hs_leftover.len > 0 {
        buf.write(&c.hs_leftover)
        buf_len = c.hs_leftover.len
    }
    while buf_len < 4 {
        rec := rec_read_enc13(c) or >>
        if rec.typ != rec_hs {
            >> errors.new("tls: expected encrypted handshake")
        }
        buf.write(&rec.frag)
        buf_len = buf_len + rec.frag.len
    }
    mut buf_s := buf.bytes()
    n := u24_at(&buf_s, 1) or >>
    while buf_len < 4 + n {
        rec := rec_read_enc13(c) or >>
        if rec.typ != rec_hs {
            >> errors.new("tls: expected encrypted handshake")
        }
        buf.write(&rec.frag)
        buf_len = buf_len + rec.frag.len
    }
    buf_s = buf.bytes()
    msg := slice_copy(&buf_s, 0, 4 + n) or >>
    c.hs_leftover = slice_copy(&buf_s, 4 + n, buf_s.len) or >>
    if (msg[0] & 255) != want {
        >> errors.new("tls: TLS 1.3 handshake type")
    }
    << msg
}

fn make_encrypted_extensions13() string {
    body := string_from_byte(0) + string_from_byte(0)
    << hs_wrap(hs13_encrypted_extensions, &body)
}

fn check_encrypted_extensions13(msg &string) int {
    body := hs_body(msg)
    if body.len < 2 || u16_at(&body, 0) != body.len - 2 {
        >> errors.new("tls: malformed encrypted extensions")
    }
    << 0
}

fn make_certificates13(cert_pem &string) string {
    mut certs := x509.new_cert_pool()
    ncert := x509.append_certificates(mut &certs, cert_pem)
    if ncert == 0 {
        >> errors.new("tls: no certificates")
    }
    mut total := 0
    mut i := 0
    while i < certs.certs.len {
        total = total + 3 + certs.certs[i].raw.len + 2
        i = i + 1
    }
    mut b := []int{}
    b.push(0) // certificate_request_context
    list_len := be24(total)
    push_s(mut &b, &list_len)
    i = 0
    while i < certs.certs.len {
        der := certs.certs[i].raw
        n := be24(der.len)
        push_s(mut &b, &n)
        push_s(mut &b, &der)
        b.push(0)
        b.push(0) // per-certificate extensions
        i = i + 1
    }
    body := string_from_bytes(b)
    << hs_wrap(hs_cert, &body)
}

fn certificate_chain13(msg &string) []string {
    body := hs_body(msg)
    if body.len < 4 {
        >> errors.new("tls: short TLS 1.3 certificate")
    }
    context_len := body[0] & 255
    mut off := 1 + context_len
    if off + 3 > body.len {
        >> errors.new("tls: short TLS 1.3 certificate")
    }
    total := u24_at(&body, off) or >>
    off = off + 3
    end := off + total
    if end != body.len {
        >> errors.new("tls: malformed TLS 1.3 certificate")
    }
    mut out := []string{}
    while off < end {
        if off + 3 > end {
            >> errors.new("tls: short TLS 1.3 certificate")
        }
        n := u24_at(&body, off) or >>
        off = off + 3
        if n <= 0 || off + n + 2 > end {
            >> errors.new("tls: malformed TLS 1.3 certificate")
        }
        out.push(slice_copy(&body, off, off + n) or >>)
        off = off + n
        ext_n := u16_at(&body, off) or >>
        off = off + 2 + ext_n
        if off > end {
            >> errors.new("tls: malformed TLS 1.3 certificate extensions")
        }
    }
    << out
}

fn certificate_verify_input(server bool, transcript &string) string {
    spaces := "                                                                "
    mut context := "TLS 1.3, server CertificateVerify"
    if !server {
        context = "TLS 1.3, client CertificateVerify"
    }
    transcript_s := transcript + ""
    th := sha256.sum256_bytes(transcript_s)
    mut out := io.buffer()
    out.write(&spaces)
    out.write(&context)
    separator := string_from_byte(0)
    out.write(&separator)
    out.write(&th)
    << out.bytes()
}

fn make_certificate_verify13(key &rsa.PrivateKey, transcript &string) string {
    input := certificate_verify_input(true, transcript)
    digest := sha256.sum256_bytes(input)
    sig := oaep.sign_pss(key, rsa.sha256, &digest) or >>
    mut b := []int{}
    b.push(8)
    b.push(4) // rsa_pss_rsae_sha256
    b.push((sig.len >> 8) & 255)
    b.push(sig.len & 255)
    push_s(mut &b, &sig)
    body := string_from_bytes(b)
    << hs_wrap(hs13_certificate_verify, &body)
}

fn verify_certificate_verify13_cert(msg &string, cert &x509.Certificate, transcript &string) int {
    body := hs_body(msg)
    if body.len < 4 {
        >> errors.new("tls: malformed TLS 1.3 certificate signature")
    }
    scheme := u16_at(&body, 0) or >>
    n := u16_at(&body, 2) or >>
    if n <= 0 || body.len != 4 + n {
        >> errors.new("tls: malformed TLS 1.3 certificate signature")
    }
    sig := slice_copy(&body, 4, body.len) or >>
    input := certificate_verify_input(true, transcript)

    if cert.public_key_algorithm == x509.rsa {
        if scheme != sig_rsa_pss_rsae_sha256 {
            >> errors.new("tls: unsupported TLS 1.3 certificate signature")
        }
        pk := x509_rsa_pub(cert) or >>
        digest := sha256.sum256_bytes(input)
        << oaep.verify_pss(&pk, rsa.sha256, &digest, &sig) or >>
    }
    if cert.public_key_algorithm == x509.ecdsa {
        pub_key := cert.public_key + ""
        mut digest := ""
        if scheme == sig_ecdsa_secp256r1_sha256 && pub_key.len == ecdsa.public_key_size_p256 {
            digest = sha256.sum256_bytes(input)
        } else if scheme == sig_ecdsa_secp384r1_sha384 && pub_key.len == ecdsa.public_key_size_p384 {
            digest = sha512.sum384(input)
        } else if scheme == sig_ecdsa_secp521r1_sha512 && pub_key.len == ecdsa.public_key_size_p521 {
            digest = sha512.sum512(input)
        } else {
            >> errors.new("tls: unsupported TLS 1.3 ECDSA signature")
        }
        if !ecdsa.verify_asn1(&pub_key, &digest, &sig) {
            >> errors.new("tls: invalid TLS 1.3 ECDSA signature")
        }
        << 0
    }
    if cert.public_key_algorithm == x509.ed25519 {
        pub_key := cert.public_key + ""
        if scheme != sig_ed25519 || pub_key.len != ed25519.public_key_size || sig.len != ed25519.signature_size {
            >> errors.new("tls: unsupported TLS 1.3 Ed25519 signature")
        }
        if !ed25519.verify(&pub_key, &input, &sig) {
            >> errors.new("tls: invalid TLS 1.3 Ed25519 signature")
        }
        << 0
    }
    >> errors.new("tls: unsupported TLS 1.3 certificate public key")
    << 0
}

fn make_finished13(secret &string, transcript &string) string {
    vd := tls13_finished_data(secret, transcript) or >>
    << hs_wrap(hs_fin, &vd)
}

fn verify_finished13(msg &string, secret &string, transcript &string) int {
    body := hs_body(msg)
    want := tls13_finished_data(secret, transcript) or >>
    if subtle.constant_time_compare(&body, &want) != 1 {
        >> errors.new("tls: invalid TLS 1.3 finished")
    }
    << 0
}

fn handshake_client13(c &mut Conn, cfg &Config, cr &string, sr &string, log0 &string, private_key &string, sh_body &string) int {
    peer := server_key_share_p256(sh_body) or >>
    shared := ecdsa.ecdh(private_key, &peer) or >>
    mut log := io.buffer()
    log.write(log0)
    log_s := log.bytes()
    secrets := tls13_handshake_secrets(&shared, &log_s) or >>
    client_hs := secrets.client
    server_hs := secrets.server
    master_secret13 := secrets.master
    c.version = version_tls13
    c.cipher_suite = tls_aes_128_gcm_sha256
    apply_tls13_traffic(c, &client_hs, &server_hs, 1) or >>

    ee := expect_hs13(c, hs13_encrypted_extensions) or >>
    check_encrypted_extensions13(&ee) or >>
    log.write(&ee)
    cert_msg := expect_hs13(c, hs_cert) or >>
    chain := certificate_chain13(&cert_msg) or >>
    server_name := c.server_name + ""
    cert := verify_server_chain(cfg, server_name, &chain) or >>
    log.write(&cert_msg)
    cv := expect_hs13(c, hs13_certificate_verify) or >>
    log_s0 := log.bytes()
    verify_certificate_verify13_cert(&cv, &cert, &log_s0) or >>
    log.write(&cv)
    fin := expect_hs13(c, hs_fin) or >>
    log_s1 := log.bytes()
    verify_finished13(&fin, &server_hs, &log_s1) or >>
    log.write(&fin)
    log_s2 := log.bytes()
    app := tls13_application_secrets(&master_secret13, &log_s2) or >>
    client_app := app.client
    server_app := app.server

    log_s3 := log.bytes()
    client_fin := make_finished13(&client_hs, &log_s3) or >>
    rec_write_enc13(c, rec_hs, &client_fin) or >>
    apply_tls13_traffic(c, &client_app, &server_app, 1) or >>
    c.handshake_complete = true
    << 0
}

fn handshake_server13(c &mut Conn, cfg &Config, key &rsa.PrivateKey, log0 &string, shared &string) int {
    mut log := io.buffer()
    log.write(log0)
    log_s := log.bytes()
    secrets := tls13_handshake_secrets(shared, &log_s) or >>
    client_hs := secrets.client
    server_hs := secrets.server
    master_secret13 := secrets.master
    c.version = version_tls13
    c.cipher_suite = tls_aes_128_gcm_sha256
    apply_tls13_traffic(c, &client_hs, &server_hs, 0) or >>

    ee := make_encrypted_extensions13()
    rec_write_enc13(c, rec_hs, &ee) or >>
    log.write(&ee)
    cert := make_certificates13(&cfg.cert_pem) or >>
    rec_write_enc13(c, rec_hs, &cert) or >>
    log.write(&cert)
    log_s4 := log.bytes()
    cv := make_certificate_verify13(key, &log_s4) or >>
    rec_write_enc13(c, rec_hs, &cv) or >>
    log.write(&cv)
    log_s5 := log.bytes()
    fin := make_finished13(&server_hs, &log_s5) or >>
    rec_write_enc13(c, rec_hs, &fin) or >>
    log.write(&fin)
    log_s6 := log.bytes()
    app := tls13_application_secrets(&master_secret13, &log_s6) or >>
    client_app := app.client
    server_app := app.server

    client_fin := expect_hs13(c, hs_fin) or >>
    log_s7 := log.bytes()
    verify_finished13(&client_fin, &client_hs, &log_s7) or >>
    apply_tls13_traffic(c, &client_app, &server_app, 0) or >>
    c.handshake_complete = true
    << 0
}
