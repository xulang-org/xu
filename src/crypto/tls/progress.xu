@crypto/tls

#io
#errors

pub fn (c $&Conn) read_result(n int) io.ReadResult {
    if n < 0 { << io.ReadResult.Failed("", errors.new("io: invalid count")) }
    if n == 0 { << io.ReadResult.Data("") }
    data := c.read(n) or (err) { << io.ReadResult.Failed("", err) }
    if data.len == 0 { << io.ReadResult.End("") }
    << io.ReadResult.Data(data)
}

pub fn (c $&Conn) write_result(data string) io.WriteResult {
    if data.len == 0 { << io.WriteResult.Written(0) }
    // TLS may have emitted earlier records before a later record fails.
    n := c.write(&data) or (err) { << io.WriteResult.Unknown(err) }
    << io.WriteResult.Written(n)
}
