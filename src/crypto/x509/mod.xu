@crypto/x509

#errors
#encoding/asn1
#encoding/hex
#encoding/pem
#math/big
#net
#os
#strings
#time
#crypto/ed25519
ecdsapkg #crypto/ecdsa
#crypto/sm2
rsapkg #crypto/rsa
#crypto/sha256
#crypto/sha512
#crypto/x509/pkix

// Go `crypto/x509` subset: ParseCertificate, CheckSignatureFrom,
// Certificate.Verify with a CertPool. Signature check is Ed25519 (D4),
// RSA PKCS1v15 SHA-256 (D4 rsa), ECDSA P-256/P-384/P-521 with the matching
// SHA-2 digest, and SM2-with-SM3 (G5, Xu additional).
//
// This is not a complete RFC 5280 implementation. Current path building is
// a bounded (≤8) candidate backtrack with BasicConstraints/pathLen, CA
// KeyUsage, AKI/SKI, EKU, DNS/IP NameConstraints, a partial policy set, and
// CRL-if-present. Missing: other NameConstraints types, a full policy tree,
// delta CRL/OCSP, and certificate/key issuance APIs. Do not treat Verify
// passing as "full RFC 5280".

pub const UNKNOWN_SIGNATURE_ALGORITHM = 0
pub const MD5_WITH_RSA = 2
pub const SHA1_WITH_RSA = 3
pub const SHA256_WITH_RSA = 4
pub const SHA384_WITH_RSA = 5
pub const SHA512_WITH_RSA = 6
pub const ECDSA_WITH_SHA256 = 10
pub const ECDSA_WITH_SHA384 = 11
pub const ECDSA_WITH_SHA512 = 12
pub const PURE_ED25519 = 16
pub const SM2_WITH_SM3 = 20

pub const UNKNOWN_PUBLIC_KEY_ALGORITHM = 0
pub const RSA = 1
pub const DSA = 2
pub const ECDSA = 3
pub const ED25519 = 4
pub const SM2 = 5

// RFC 5280 KeyUsage bit positions, aligned with Go crypto/x509.
pub const KEY_USAGE_DIGITAL_SIGNATURE = 1
pub const KEY_USAGE_CONTENT_COMMITMENT = 2
pub const KEY_USAGE_KEY_ENCIPHERMENT = 4
pub const KEY_USAGE_DATA_ENCIPHERMENT = 8
pub const KEY_USAGE_KEY_AGREEMENT = 16
pub const KEY_USAGE_CERT_SIGN = 32
pub const KEY_USAGE_CRL_SIGN = 64
pub const KEY_USAGE_ENCIPHER_ONLY = 128
pub const KEY_USAGE_DECIPHER_ONLY = 256

pub struct Certificate {
    pub raw string
    pub raw_tbs_certificate string
    pub raw_subject_public_key_info string
    pub raw_subject string
    pub raw_issuer string
    pub signature string
    pub signature_algorithm int
    pub public_key_algorithm int
    pub public_key string
    pub version int
    pub serial_number big.Int
    // Canonical unsigned DER serial bytes (leading sign padding removed).
    // Revocation checks use this representation to avoid integer-width drift.
    pub serial_bytes string
    pub issuer pkix.Name
    pub subject pkix.Name
    pub not_before time.Time
    pub not_after time.Time
    pub is_ca bool
    pub basic_constraints_valid bool
    // -1 means absent/unlimited. max_path_len_zero distinguishes an explicit
    // pathLenConstraint=0 from the absent default, matching Go's shape.
    pub max_path_len int
    pub max_path_len_zero bool
    pub key_usage int
    pub key_usage_present bool
    pub subject_key_id string
    pub authority_key_id string
    pub ext_key_usage []int
    pub ext_key_usage_present bool
    pub has_unknown_ext_key_usage bool
    pub permitted_dns_domains []string
    pub excluded_dns_domains []string
    // Raw RFC 5280 iPAddress constraints: address || mask (8 or 32 bytes).
    pub permitted_ip_ranges []string
    pub excluded_ip_ranges []string
    pub name_constraints_present bool
    pub name_constraints_unsupported bool
    pub certificate_policies []string
    pub certificate_policies_present bool
    pub policy_mapping_issuers []string
    pub policy_mapping_subjects []string
    pub policy_mappings_present bool
    pub require_explicit_policy int
    pub inhibit_policy_mapping int
    pub policy_constraints_present bool
    pub inhibit_any_policy int
    pub inhibit_any_policy_present bool
    // Safe fail-closed marker for critical extensions this subset does not
    // yet process. Path validation rejects such certificates.
    pub has_unhandled_critical_extension bool
    pub dns_names []string
    // Raw network-order addresses from subjectAltName iPAddress entries.
    // IPv4 values contain 4 bytes and IPv6 values contain 16 bytes, matching
    // the representation used by package net.
    pub ip_addresses []string
}

pub struct CertPool {
    pub certs []Certificate
}

pub struct VerifyOptions {
    pub dns_name string
    pub current_time time.Time
    pub roots CertPool
    pub intermediates CertPool
    // Empty defaults to ServerAuth, matching Go crypto/x509 VerifyOptions.
    pub key_usages []int
    // Empty is the RFC 5280 anyPolicy initial-policy-set.
    pub certificate_policies []string
    // DER-encoded CRLs supplied by the caller. Revocation is disabled by
    // default; parsing inside each candidate edge avoids owning-struct moves.
    pub revocation_lists []string
    pub revocation_mode int
}

pub fn new_cert_pool() CertPool {
    << CertPool{certs: []Certificate{}}
}

pub fn (p $&CertPool) add(c Certificate) {
    p.certs.push(c)
}

fn pem_bytes_at(data &string, pos int, marker &string) bool {
    if pos < 0 || pos + marker.len > data.len {
        << false
    }
    $i := 0
    while i < marker.len {
        if (data[pos + i] & 255) != (marker[i] & 255) {
            << false
        }
        i = i + 1
    }
    << true
}

// PEM boundary lines may end in LF or CRLF and may carry trailing horizontal
// whitespace. This is the same boundary accepted by encoding/pem.decode.
fn pem_marker_line(data &string, pos int, marker &string) bool {
    if pos > 0 && (data[pos - 1] & 255) != 10 {
        << false
    }
    if !pem_bytes_at(data, pos, marker) {
        << false
    }
    $i := pos + marker.len
    while i < data.len {
        c := data[i] & 255
        if c == 10 {
            << true
        }
        if c != 13 && c != 32 && c != 9 {
            << false
        }
        i = i + 1
    }
    << true
}

fn find_pem_marker_line(data &string, marker &string, start int) int {
    $i := start
    if i < 0 {
        i = 0
    }
    while i + marker.len <= data.len {
        if pem_marker_line(data, i, marker) {
            << i
        }
        i = i + 1
    }
    << -1
}

fn after_pem_line(data &string, start int) int {
    $i := start
    while i < data.len {
        if (data[i] & 255) == 10 {
            << i + 1
        }
        i = i + 1
    }
    << data.len
}

// append_certificates adds every CERTIFICATE PEM block that can be parsed.
// Unknown or malformed blocks are skipped, matching the useful part of Go's
// AppendCertsFromPEM contract while keeping the subset's explicit count for
// diagnostics. The scanner keeps an offset into the original bundle and only
// copies one PEM block at a time. In particular, it does not repeatedly copy
// encoding/pem.Block.rest, which would make large system bundles quadratic.
pub fn append_certificates(p $&CertPool, pem_data &string) int {
    src := pem_data + ""
    begin_marker := "-----BEGIN CERTIFICATE-----"
    end_marker := "-----END CERTIFICATE-----"
    $added := 0
    $scan := 0
    while scan < src.len {
        begin := find_pem_marker_line(&src, &begin_marker, scan)
        if begin < 0 {
            << added
        }
        body := after_pem_line(&src, begin)
        end := find_pem_marker_line(&src, &end_marker, body)
        if end < 0 {
            // The unmatched BEGIN must not hide a later well-formed block.
            scan = begin + 1
            ->
        }
        nested := find_pem_marker_line(&src, &begin_marker, body)
        if nested >= 0 && nested < end {
            // Prefer the inner complete block over a malformed outer block.
            scan = nested
            ->
        }
        after := after_pem_line(&src, end)
        if after <= begin {
            << added
        }
        one := src[begin:after] + ""
        scan = after
        block := pem.decode(&one)
        if block.typ != "CERTIFICATE" {
            ->
        }
        c := parse_certificate(block.bytes) or (err) {
            ->
        }
        p.add(c)
        added = added + 1
    }
    << added
}

fn append_certificate_file(p $&CertPool, path string) int {
    data := os.read(path) or (err) {
        << 0
    }
    << append_certificates(p, &data)
}

// system_cert_pool probes the environment override first, then the native
// platform trust source, then conventional Unix PEM bundles. The native
// adapter only supplies opaque DER records; parsing and trust policy remain in
// this package. An empty pool is returned when no source is readable, so TLS
// callers fail closed instead of silently disabling verification.
pub fn system_cert_pool() CertPool {
    $pool := new_cert_pool()
    env_file := os.getenv("SSL_CERT_FILE")
    if env_file.len > 0 {
        append_certificate_file($&pool, env_file + "")
        if pool.certs.len > 0 {
            << pool
        }
    }
    append_platform_certificates($&pool)
    if pool.certs.len > 0 {
        << pool
    }
    $paths := []string{}
    paths.push("/etc/ssl/cert.pem")
    paths.push("/etc/ssl/certs/ca-certificates.crt")
    paths.push("/etc/pki/tls/certs/ca-bundle.crt")
    for i in 0:paths.len {
        path := paths[i] + ""
        append_certificate_file($&pool, path)
        if pool.certs.len > 0 {
            << pool
        }
    }
    << pool
}

fn empty_name() pkix.Name {
    << pkix.Name{country: []string{}, organization: []string{}, organizational_unit: []string{}, locality: []string{}, province: []string{}, street_address: []string{}, postal_code: []string{}, serial_number: "", common_name: ""}
}

fn oid_eq4(a &[]int, a0 int, a1 int, a2 int, a3 int) bool {
    if a.len != 4 {
        << false
    }
    << a[0] == a0 && a[1] == a1 && a[2] == a2 && a[3] == a3
}

fn oid_eq5(a &[]int, a0 int, a1 int, a2 int, a3 int, a4 int) bool {
    if a.len != 5 {
        << false
    }
    << a[0] == a0 && a[1] == a1 && a[2] == a2 && a[3] == a3 && a[4] == a4
}

fn oid_eq6(a &[]int, a0 int, a1 int, a2 int, a3 int, a4 int, a5 int) bool {
    if a.len != 6 {
        << false
    }
    << a[0] == a0 && a[1] == a1 && a[2] == a2 && a[3] == a3 && a[4] == a4 && a[5] == a5
}

fn oid_eq7(a &[]int, a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int) bool {
    if a.len != 7 {
        << false
    }
    << a[0] == a0 && a[1] == a1 && a[2] == a2 && a[3] == a3 && a[4] == a4 && a[5] == a5 && a[6] == a6
}

fn sig_algo_from_oid(a &[]int) int {
    if oid_eq4(a, 1, 3, 101, 112) {
        << PURE_ED25519
    }
    if oid_eq7(a, 1, 2, 840, 113549, 1, 1, 11) {
        << SHA256_WITH_RSA
    }
    if oid_eq7(a, 1, 2, 840, 113549, 1, 1, 12) {
        << SHA384_WITH_RSA
    }
    if oid_eq7(a, 1, 2, 840, 113549, 1, 1, 13) {
        << SHA512_WITH_RSA
    }
    if oid_eq7(a, 1, 2, 840, 113549, 1, 1, 5) {
        << SHA1_WITH_RSA
    }
    if oid_eq7(a, 1, 2, 840, 113549, 1, 1, 4) {
        << MD5_WITH_RSA
    }
    if oid_eq7(a, 1, 2, 840, 10045, 4, 3, 2) {
        << ECDSA_WITH_SHA256
    }
    if oid_eq7(a, 1, 2, 840, 10045, 4, 3, 3) {
        << ECDSA_WITH_SHA384
    }
    if oid_eq7(a, 1, 2, 840, 10045, 4, 3, 4) {
        << ECDSA_WITH_SHA512
    }
    if oid_eq6(a, 1, 2, 156, 10197, 1, 501) {
        << SM2_WITH_SM3
    }
    << UNKNOWN_SIGNATURE_ALGORITHM
}

fn pub_algo_from_oid(a &[]int) int {
    if oid_eq4(a, 1, 3, 101, 112) {
        << ED25519
    }
    if oid_eq7(a, 1, 2, 840, 113549, 1, 1, 1) {
        << RSA
    }
    if oid_eq6(a, 1, 2, 156, 10197, 1, 301) {
        << SM2
    }
    << UNKNOWN_PUBLIC_KEY_ALGORITHM
}

fn is_leap(y int) bool {
    if y % 400 == 0 {
        << true
    }
    if y % 100 == 0 {
        << false
    }
    << y % 4 == 0
}

fn month_days(m int, y int) int {
    if m == 2 {
        if is_leap(y) {
            << 29
        }
        << 28
    }
    if m == 4 || m == 6 || m == 9 || m == 11 {
        << 30
    }
    << 31
}

fn two_digits(s &string, i int) int {
    if i + 1 >= s.len {
        >> errors.new("x509: invalid time")
    }
    a := s[i] & 255
    b := s[i + 1] & 255
    if a < 48 || a > 57 || b < 48 || b > 57 {
        >> errors.new("x509: invalid time")
    }
    << (a - 48) * 10 + (b - 48)
}

fn unix_civil(y int, mo int, d int, h int, mi int, s int) time.Time {
    $days := 0
    $yy := 1970
    while yy < y {
        days = days + 365
        if is_leap(yy) {
            days = days + 1
        }
        yy = yy + 1
    }
    $m := 1
    while m < mo {
        days = days + month_days(m, y)
        m = m + 1
    }
    days = days + d - 1
    sec := days * 86400 + h * 3600 + mi * 60 + s
    << time.unix(sec, 0)
}

fn parse_utc(s string) time.Time {
    if s.len < 13 {
        >> errors.new("x509: invalid UTCTime")
    }
    yy := two_digits(&s, 0) or >>
    $year := 2000 + yy
    if yy >= 50 {
        year = 1900 + yy
    }
    mo := two_digits(&s, 2) or >>
    d := two_digits(&s, 4) or >>
    h := two_digits(&s, 6) or >>
    mi := two_digits(&s, 8) or >>
    sec := two_digits(&s, 10) or >>
    << unix_civil(year, mo, d, h, mi, sec)
}

fn parse_gen(s string) time.Time {
    if s.len < 15 {
        >> errors.new("x509: invalid GeneralizedTime")
    }
    hi := two_digits(&s, 0) or >>
    lo := two_digits(&s, 2) or >>
    year := hi * 100 + lo
    mo := two_digits(&s, 4) or >>
    d := two_digits(&s, 6) or >>
    h := two_digits(&s, 8) or >>
    mi := two_digits(&s, 10) or >>
    sec := two_digits(&s, 12) or >>
    << unix_civil(year, mo, d, h, mi, sec)
}

fn parse_time(v &asn1.Value) time.Time {
    if v.tag == asn1.TAG_UTC_TIME {
        << parse_utc(v.bytes + "") or >>
    }
    if v.tag == asn1.TAG_GENERALIZED_TIME {
        << parse_gen(v.bytes + "") or >>
    }
    >> errors.new("x509: invalid time")
    << time.unix(0, 0)
}

fn parse_algo_oid(v asn1.Value) []int {
    $d := asn1.new_decoder(&v.bytes)
    oidv := d.next() or >>
    << oidv.as_oid() or >>
}

fn parse_serial(v asn1.Value) big.Int {
    if v.tag != asn1.TAG_INTEGER || v.bytes.len == 0 {
        >> errors.new("x509: invalid serial number")
    }
    $z := big.new_int(0)
    z.set_bytes(v.bytes + "")
    << z
}

fn parse_name(v asn1.Value) pkix.Name {
    $n := empty_name()
    if v.tag != asn1.TAG_SEQUENCE {
        >> errors.new("x509: invalid RDN sequence")
    }
    $d := asn1.new_decoder(&v.bytes)
    while !d.done() {
        rdn := d.next() or >>
        $sd := asn1.new_decoder(&rdn.bytes)
        while !sd.done() {
            atv := sd.next() or >>
            $ad := asn1.new_decoder(&atv.bytes)
            oidv := ad.next() or >>
            valv := ad.next() or >>
            arcs := oidv.as_oid() or >>
            val := valv.bytes + ""
            if oid_eq4(&arcs, 2, 5, 4, 3) {
                n.common_name = val + ""
            } else if oid_eq4(&arcs, 2, 5, 4, 6) {
                n.country.push(val)
            } else if oid_eq4(&arcs, 2, 5, 4, 10) {
                n.organization.push(val)
            } else if oid_eq4(&arcs, 2, 5, 4, 11) {
                n.organizational_unit.push(val)
            } else if oid_eq4(&arcs, 2, 5, 4, 7) {
                n.locality.push(val)
            } else if oid_eq4(&arcs, 2, 5, 4, 8) {
                n.province.push(val)
            } else if oid_eq4(&arcs, 2, 5, 4, 5) {
                n.serial_number = val + ""
            } else if oid_eq4(&arcs, 2, 5, 4, 9) {
                n.street_address.push(val)
            } else if oid_eq4(&arcs, 2, 5, 4, 17) {
                n.postal_code.push(val)
            }
        }
    }
    << n
}

fn parse_validity(v asn1.Value) []time.Time {
    $d := asn1.new_decoder(&v.bytes)
    a := d.next() or >>
    b := d.next() or >>
    nb := parse_time(&a) or >>
    na := parse_time(&b) or >>
    $out := []time.Time{}
    out.push(nb)
    out.push(na)
    << out
}

struct Spki {
    algo int
    key string
}

fn parse_spki_algo(alg &asn1.Value) int {
    ab := alg.bytes + ""
    $d := asn1.new_decoder(&ab)
    oidv := d.next() or >>
    arcs := oidv.as_oid() or >>
    palgo := pub_algo_from_oid(&arcs)
    if palgo != UNKNOWN_PUBLIC_KEY_ALGORITHM {
        << palgo
    }
    if oid_eq6(&arcs, 1, 2, 840, 10045, 2, 1) {
        if d.done() {
            << UNKNOWN_PUBLIC_KEY_ALGORITHM
        }
        pv := d.next() or >>
        if pv.tag != asn1.TAG_OID {
            << UNKNOWN_PUBLIC_KEY_ALGORITHM
        }
        parcs := pv.as_oid() or >>
        if oid_eq7(&parcs, 1, 2, 840, 10045, 3, 1, 7) {
            << ECDSA
        }
        if oid_eq5(&parcs, 1, 3, 132, 0, 34) || oid_eq5(&parcs, 1, 3, 132, 0, 35) {
            << ECDSA
        }
        if oid_eq6(&parcs, 1, 2, 156, 10197, 1, 301) {
            << SM2
        }
    }
    << UNKNOWN_PUBLIC_KEY_ALGORITHM
}

fn parse_ec_public_key_size(alg &asn1.Value) int {
    ab := alg.bytes + ""
    $d := asn1.new_decoder(&ab)
    oidv := d.next() or >>
    arcs := oidv.as_oid() or >>
    if !oid_eq6(&arcs, 1, 2, 840, 10045, 2, 1) || d.done() {
        << 0
    }
    pv := d.next() or >>
    if pv.tag != asn1.TAG_OID {
        << 0
    }
    parcs := pv.as_oid() or >>
    if oid_eq7(&parcs, 1, 2, 840, 10045, 3, 1, 7) {
        << ecdsapkg.PUBLIC_KEY_SIZE_P256
    }
    if oid_eq5(&parcs, 1, 3, 132, 0, 34) {
        << ecdsapkg.PUBLIC_KEY_SIZE_P384
    }
    if oid_eq5(&parcs, 1, 3, 132, 0, 35) {
        << ecdsapkg.PUBLIC_KEY_SIZE_P521
    }
    << 0
}

fn parse_spki(v asn1.Value) Spki {
    $d := asn1.new_decoder(&v.bytes)
    alg := d.next() or >>
    keyv := d.next() or >>
    palgo := parse_spki_algo(&alg) or >>
    bits := keyv.as_bit_string() or >>
    if palgo == ECDSA {
        expected := parse_ec_public_key_size(&alg) or >>
        if expected == 0 || bits.len != expected || (bits[0] & 255) != 4 {
            >> errors.new("x509: ECDSA public key does not match named curve")
        }
    }
    << Spki{algo: palgo, key: bits}
}

fn parse_san(payload string, names $&[]string, ips $&[]string) int {
    seq := asn1.unmarshal(&payload) or >>
    $d := asn1.new_decoder(&seq.bytes)
    while !d.done() {
        gn := d.next() or >>
        if gn.class == asn1.CLASS_CONTEXT && gn.tag == 2 {
            names.push(gn.bytes + "")
        } else if gn.class == asn1.CLASS_CONTEXT && gn.tag == 7 {
            // RFC 5280 requires exactly four or sixteen network-order bytes.
            // Ignore malformed entries instead of treating arbitrary bytes as
            // a host name or accepting a truncated address.
            if gn.bytes.len == 4 || gn.bytes.len == 16 {
                ips.push(gn.bytes + "")
            }
        }
    }
    << 0
}

struct BasicConstraints {
    is_ca bool
    max_path_len int
    max_path_len_zero bool
}

fn parse_basic_constraints(payload string) BasicConstraints {
    seq := asn1.unmarshal(&payload) or >>
    if seq.tag != asn1.TAG_SEQUENCE || seq.constructed == 0 || seq.rest.len != 0 {
        >> errors.new("x509: invalid basic constraints")
    }
    $d := asn1.new_decoder(&seq.bytes)
    $is_ca := false
    $max_path_len := -1
    $max_path_len_zero := false
    if d.done() {
        << BasicConstraints{is_ca: false, max_path_len: -1, max_path_len_zero: false}
    }
    $x := d.next() or >>
    if x.tag == asn1.TAG_BOOLEAN {
        is_ca = x.as_bool() or >>
        if !d.done() {
            x = d.next() or >>
        } else {
            << BasicConstraints{is_ca: is_ca, max_path_len: -1, max_path_len_zero: false}
        }
    }
    if x.tag == asn1.TAG_INTEGER {
        max_path_len = x.as_int() or >>
        if max_path_len < 0 || !is_ca {
            >> errors.new("x509: invalid basic constraints")
        }
        max_path_len_zero = max_path_len == 0
    } else {
        >> errors.new("x509: invalid basic constraints")
    }
    if !d.done() {
        >> errors.new("x509: invalid basic constraints")
    }
    << BasicConstraints{is_ca: is_ca, max_path_len: max_path_len, max_path_len_zero: max_path_len_zero}
}

fn parse_key_usage(payload string) int {
    bits := asn1.unmarshal(&payload) or >>
    if bits.tag != asn1.TAG_BIT_STRING || bits.constructed != 0 || bits.rest.len != 0 || bits.bytes.len == 0 {
        >> errors.new("x509: invalid key usage")
    }
    unused := bits.bytes[0] & 255
    if unused > 7 {
        >> errors.new("x509: invalid key usage")
    }
    $usage := 0
    $bit := 0
    while bit < 9 {
        byte_index := 1 + bit / 8
        if byte_index < bits.bytes.len {
            mask := 1 << (7 - bit % 8)
            if ((bits.bytes[byte_index] & 255) & mask) != 0 {
                usage = usage | (1 << bit)
            }
        }
        bit = bit + 1
    }
    << usage
}

fn parse_subject_key_id(payload string) string {
    v := asn1.unmarshal(&payload) or >>
    if v.tag != asn1.TAG_OCTET_STRING || v.constructed != 0 || v.rest.len != 0 {
        >> errors.new("x509: invalid subject key identifier")
    }
    << v.bytes + ""
}

fn parse_authority_key_id(payload string) string {
    seq := asn1.unmarshal(&payload) or >>
    if seq.tag != asn1.TAG_SEQUENCE || seq.constructed == 0 || seq.rest.len != 0 {
        >> errors.new("x509: invalid authority key identifier")
    }
    $d := asn1.new_decoder(&seq.bytes)
    while !d.done() {
        v := d.next() or >>
        if v.class == asn1.CLASS_CONTEXT && v.tag == 0 {
            << v.bytes + ""
        }
    }
    << ""
}

fn parse_extensions(v &asn1.Value, c $&Certificate) int {
    cons := v.constructed
    ib0 := v.bytes + ""
    $content := ib0 + ""
    if cons != 0 {
        $wrap := asn1.new_decoder(&ib0)
        inner := wrap.next() or >>
        content = inner.bytes + ""
    }
    $d := asn1.new_decoder(&content)
    while !d.done() {
        ext := d.next() or >>
        if ext.tag != asn1.TAG_SEQUENCE || ext.constructed == 0 {
            >> errors.new("x509: invalid extension")
        }
        $ed := asn1.new_decoder(&ext.bytes)
        oidv := ed.next() or >>
        nxt := ed.next() or >>
        ntag := nxt.tag
        $critical := false
        $payload := nxt
        if ntag == asn1.TAG_BOOLEAN {
            critical = payload.as_bool() or >>
            p2 := ed.next() or >>
            payload = p2
        }
        if payload.tag != asn1.TAG_OCTET_STRING || !ed.done() {
            >> errors.new("x509: invalid extension")
        }
        arcs := oidv.as_oid() or >>
        body := payload.bytes + ""
        $handled := false
        if oid_eq4(&arcs, 2, 5, 29, 17) {
            $names := []string{}
            $ips := []string{}
            parse_san(body, $&names, $&ips) or >>
            c.dns_names = names
            c.ip_addresses = ips
            handled = true
        }
        if oid_eq4(&arcs, 2, 5, 29, 19) {
            bc := parse_basic_constraints(body) or >>
            c.is_ca = bc.is_ca
            c.basic_constraints_valid = true
            c.max_path_len = bc.max_path_len
            c.max_path_len_zero = bc.max_path_len_zero
            handled = true
        }
        if oid_eq4(&arcs, 2, 5, 29, 15) {
            c.key_usage = parse_key_usage(body) or >>
            c.key_usage_present = true
            handled = true
        }
        if oid_eq4(&arcs, 2, 5, 29, 14) {
            c.subject_key_id = parse_subject_key_id(body) or >>
            handled = true
        }
        if oid_eq4(&arcs, 2, 5, 29, 35) {
            c.authority_key_id = parse_authority_key_id(body) or >>
            handled = true
        }
        if oid_eq4(&arcs, 2, 5, 29, 37) {
            if c.ext_key_usage_present {
                >> errors.new("x509: duplicate extended key usage")
            }
            eku := parse_ext_key_usage(body) or >>
            c.ext_key_usage = int_array_clone(&eku.usages)
            c.ext_key_usage_present = true
            c.has_unknown_ext_key_usage = eku.has_unknown
            handled = true
        }
        if oid_eq4(&arcs, 2, 5, 29, 30) {
            if c.name_constraints_present {
                >> errors.new("x509: duplicate name constraints")
            }
            nc := parse_name_constraints(body) or >>
            c.permitted_dns_domains = string_array_clone(&nc.permitted_dns)
            c.excluded_dns_domains = string_array_clone(&nc.excluded_dns)
            c.permitted_ip_ranges = string_array_clone(&nc.permitted_ip)
            c.excluded_ip_ranges = string_array_clone(&nc.excluded_ip)
            c.name_constraints_present = true
            c.name_constraints_unsupported = nc.unsupported
            if critical && nc.unsupported {
                c.has_unhandled_critical_extension = true
            }
            handled = true
        }
        if oid_eq4(&arcs, 2, 5, 29, 32) {
            if c.certificate_policies_present {
                >> errors.new("x509: duplicate certificate policies")
            }
            policies := parse_certificate_policies(body) or >>
            c.certificate_policies = string_array_clone(&policies.identifiers)
            c.certificate_policies_present = true
            handled = true
        }
        if oid_eq4(&arcs, 2, 5, 29, 33) {
            if c.policy_mappings_present {
                >> errors.new("x509: duplicate policy mappings")
            }
            mappings := parse_policy_mappings(body) or >>
            c.policy_mapping_issuers = string_array_clone(&mappings.issuers)
            c.policy_mapping_subjects = string_array_clone(&mappings.subjects)
            c.policy_mappings_present = true
            handled = true
        }
        if oid_eq4(&arcs, 2, 5, 29, 36) {
            if c.policy_constraints_present {
                >> errors.new("x509: duplicate policy constraints")
            }
            constraints := parse_policy_constraints(body) or >>
            if constraints.require_explicit >= 0 {
                c.require_explicit_policy = constraints.require_explicit
            }
            if constraints.inhibit_mapping >= 0 {
                c.inhibit_policy_mapping = constraints.inhibit_mapping
            }
            c.policy_constraints_present = true
            handled = true
        }
        if oid_eq4(&arcs, 2, 5, 29, 54) {
            if c.inhibit_any_policy_present {
                >> errors.new("x509: duplicate inhibit anyPolicy")
            }
            c.inhibit_any_policy = parse_inhibit_any_policy(body) or >>
            if c.inhibit_any_policy < 0 {
                >> errors.new("x509: invalid inhibit anyPolicy")
            }
            c.inhibit_any_policy_present = true
            handled = true
        }
        if critical && !handled {
            c.has_unhandled_critical_extension = true
        }
    }
    << 0
}

pub fn parse_certificate(der string) Certificate {
    raw := der + ""
    top := asn1.unmarshal(&raw) or >>
    if top.tag != asn1.TAG_SEQUENCE || top.constructed == 0 {
        >> errors.new("x509: malformed certificate")
    }
    body := top.bytes + ""
    tbs := asn1.parse_at(&body, 0) or >>
    tbs_end := body.len - tbs.rest.len
    raw_tbs := body[0:tbs_end]
    alg := asn1.parse_at(&body, tbs_end) or >>
    alg_end := body.len - alg.rest.len
    sigv := asn1.parse_at(&body, alg_end) or >>
    sig_arcs := parse_algo_oid(alg) or >>
    sig_algo := sig_algo_from_oid(&sig_arcs)
    sig := sigv.as_bit_string() or >>

    tbs_body := tbs.bytes + ""
    $off := 0
    $el := asn1.parse_at(&tbs_body, off) or >>
    $version := 1
    if el.class == asn1.CLASS_CONTEXT && el.tag == 0 {
        inner := asn1.unmarshal(&el.bytes) or >>
        vi := inner.as_int() or >>
        version = vi + 1
        off = tbs_body.len - el.rest.len
        el = asn1.parse_at(&tbs_body, off) or >>
    }
    off = tbs_body.len - el.rest.len
    serial_bytes := normalize_serial_bytes(&el.bytes)
    serial := parse_serial(el) or >>

    sig2 := asn1.parse_at(&tbs_body, off) or >>
    off = tbs_body.len - sig2.rest.len

    iss_start := off
    issuer_v := asn1.parse_at(&tbs_body, off) or >>
    off = tbs_body.len - issuer_v.rest.len
    raw_issuer := tbs_body[iss_start:off]
    issuer := parse_name(issuer_v) or >>

    val_v := asn1.parse_at(&tbs_body, off) or >>
    off = tbs_body.len - val_v.rest.len
    val := parse_validity(val_v) or >>

    sub_start := off
    subject_v := asn1.parse_at(&tbs_body, off) or >>
    off = tbs_body.len - subject_v.rest.len
    raw_subject := tbs_body[sub_start:off]
    subject := parse_name(subject_v) or >>

    spki_start := off
    spki_v := asn1.parse_at(&tbs_body, off) or >>
    off = tbs_body.len - spki_v.rest.len
    raw_spki := tbs_body[spki_start:off]
    sk := parse_spki(spki_v) or >>
    palgo := sk.algo
    pkey := sk.key + ""
    nb := val[0]
    na := val[1]
    $dns := []string{}
    $ips := []string{}

    $c := Certificate{
        raw: raw,
        raw_tbs_certificate: raw_tbs,
        raw_subject_public_key_info: raw_spki,
        raw_subject: raw_subject,
        raw_issuer: raw_issuer,
        signature: sig,
        signature_algorithm: sig_algo,
        public_key_algorithm: palgo,
        public_key: pkey,
        version: version,
        serial_number: serial,
        serial_bytes: serial_bytes,
        issuer: issuer,
        subject: subject,
        not_before: nb,
        not_after: na,
        is_ca: false,
        basic_constraints_valid: false,
        max_path_len: -1,
        max_path_len_zero: false,
        key_usage: 0,
        key_usage_present: false,
        subject_key_id: "",
        authority_key_id: "",
        ext_key_usage: []int{},
        ext_key_usage_present: false,
        has_unknown_ext_key_usage: false,
        permitted_dns_domains: []string{},
        excluded_dns_domains: []string{},
        permitted_ip_ranges: []string{},
        excluded_ip_ranges: []string{},
        name_constraints_present: false,
        name_constraints_unsupported: false,
        certificate_policies: []string{},
        certificate_policies_present: false,
        policy_mapping_issuers: []string{},
        policy_mapping_subjects: []string{},
        policy_mappings_present: false,
        require_explicit_policy: -1,
        inhibit_policy_mapping: -1,
        policy_constraints_present: false,
        inhibit_any_policy: -1,
        inhibit_any_policy_present: false,
        has_unhandled_critical_extension: false,
        dns_names: dns,
        ip_addresses: ips
    }

    while off < tbs_body.len {
        ext_v := asn1.parse_at(&tbs_body, off) or >>
        ext_class := ext_v.class
        ext_tag := ext_v.tag
        off = tbs_body.len - ext_v.rest.len
        if ext_class == asn1.CLASS_CONTEXT && ext_tag == 3 {
            parse_extensions(&ext_v, $&c) or >>
        }
    }
    << c
}

fn parse_rsa_public(der string) rsapkg.PublicKey {
    seq := asn1.unmarshal(&der) or >>
    if seq.tag != asn1.TAG_SEQUENCE {
        >> errors.new("x509: invalid RSA public key")
    }
    $d := asn1.new_decoder(&seq.bytes)
    nv := d.next() or >>
    ev := d.next() or >>
    if nv.tag != asn1.TAG_INTEGER || ev.tag != asn1.TAG_INTEGER {
        >> errors.new("x509: invalid RSA public key")
    }
    $n := big.new_int(0)
    n.set_bytes(nv.bytes + "")
    e := ev.as_int() or >>
    if e <= 0 {
        >> errors.new("x509: invalid RSA public exponent")
    }
    << rsapkg.PublicKey{n: n, e: e}
}

fn parse_sm2_public(der string) string {
    raw := der + ""
    if raw.len == 65 && (raw[0] & 255) == 4 {
        << raw + ""
    }
    >> errors.new("x509: invalid SM2 public key")
}

fn parse_sm2_sig(der string) string {
    raw := der + ""
    parsed := sm2.parse_sig(&raw) or (err) {
        >> errors.new("x509: invalid SM2 signature")
    }
    << parsed
}

fn verify_sig(pub_algo int, pub_key string, sig_algo int, signed string, signature string) int {
    if pub_algo == ED25519 && sig_algo == PURE_ED25519 {
        if pub_key.len != ed25519.PUBLIC_KEY_SIZE {
            >> errors.new("x509: invalid public key")
        }
        if signature.len != ed25519.SIGNATURE_SIZE {
            >> errors.new("x509: invalid signature")
        }
        ok := ed25519.verify(&pub_key, &signed, &signature)
        if !ok {
            >> errors.new("x509: invalid signature")
        }
        << 0
    }
    if pub_algo == RSA && sig_algo == SHA256_WITH_RSA {
        pk := parse_rsa_public(pub_key) or >>
        hx := sha256.sum256(signed)
        hashed := hex.decode_string(hx) or >>
        rsapkg.verify_pkcs1v15(&pk, rsapkg.SHA256, &hashed, &signature) or >>
        << 0
    }
    if pub_algo == ECDSA && (sig_algo == ECDSA_WITH_SHA256 || sig_algo == ECDSA_WITH_SHA384 || sig_algo == ECDSA_WITH_SHA512) {
        if pub_key.len != ecdsapkg.PUBLIC_KEY_SIZE_P256 && pub_key.len != ecdsapkg.PUBLIC_KEY_SIZE_P384 && pub_key.len != ecdsapkg.PUBLIC_KEY_SIZE_P521 {
            >> errors.new("x509: invalid ECDSA public key")
        }
        $hashed := ""
        if sig_algo == ECDSA_WITH_SHA256 {
            hx := sha256.sum256(signed)
            hashed = hex.decode_string(hx) or >>
        } else if sig_algo == ECDSA_WITH_SHA384 {
            hashed = sha512.sum384(signed)
        } else {
            hashed = sha512.sum512(signed)
        }
        if !ecdsapkg.verify_asn1(&pub_key, &hashed, &signature) {
            >> errors.new("x509: invalid ECDSA signature")
        }
        << 0
    }
    if pub_algo == SM2 && sig_algo == SM2_WITH_SM3 {
        pk := parse_sm2_public(pub_key) or >>
        rawsig := parse_sm2_sig(signature) or >>
        msg := signed + ""
        $ok := sm2.verify(&pk, &msg, &rawsig)
        if !ok {
            empty := ""
            ok = sm2.verify_id(&pk, &empty, &msg, &rawsig)
        }
        if !ok {
            >> errors.new("x509: invalid signature")
        }
        << 0
    }
    >> errors.new("x509: cannot verify signature: algorithm unimplemented")
    << 0
}

pub fn (c &Certificate) check_signature(algo int, signed &string, signature &string) int {
    pkey := c.public_key + ""
    palgo := c.public_key_algorithm
    << verify_sig(palgo, pkey, algo, signed + "", signature + "") or >>
}

pub fn (c &Certificate) check_signature_from(parent &Certificate) int {
    tbs := c.raw_tbs_certificate + ""
    sig := c.signature + ""
    algo := c.signature_algorithm
    pkey := parent.public_key + ""
    palgo := parent.public_key_algorithm
    << verify_sig(palgo, pkey, algo, tbs, sig) or >>
}

fn trim_dns_dot(s string) string {
    if s.len > 0 && (s[s.len - 1] & 255) == 46 {
        << s[0:s.len - 1] + ""
    }
    << s
}

fn first_dns_dot(s &string) int {
    $i := 0
    while i < s.len {
        if (s[i] & 255) == 46 {
            << i
        }
        i = i + 1
    }
    << -1
}

// dns_name_match follows the useful TLS hostname subset: ASCII comparison is
// case-insensitive, one terminal root dot is ignored, and a wildcard is only
// valid as the complete left-most label. It therefore matches exactly one
// label and never crosses a dot.
fn dns_name_match(pattern string, host string) bool {
    p0 := strings.to_lower(&pattern)
    h0 := strings.to_lower(&host)
    p := trim_dns_dot(p0)
    h := trim_dns_dot(h0)
    if p == h {
        << true
    }
    if p.len < 3 || (p[0] & 255) != 42 || (p[1] & 255) != 46 {
        << false
    }
    $i := 1
    while i < p.len {
        if (p[i] & 255) == 42 {
            << false
        }
        i = i + 1
    }
    i = 0
    while i < h.len {
        if (h[i] & 255) == 42 {
            << false
        }
        i = i + 1
    }
    dot := first_dns_dot(&h)
    if dot <= 0 {
        << false
    }
    psuffix := p[1:p.len]
    hsuffix := h[dot:h.len]
    << psuffix == hsuffix
}

fn name_ok(c &Certificate, host string) bool {
    $candidate := host + ""
    if candidate.len >= 2 && (candidate[0] & 255) == 91 && (candidate[candidate.len - 1] & 255) == 93 {
        candidate = candidate[1:candidate.len - 1] + ""
    }
    ip := net.parse_ip(&candidate)
    if ip.len > 0 {
        $ii := 0
        while ii < c.ip_addresses.len {
            // Keep the indexed field out of the cross-package borrow. The
            // owning local also makes the raw SAN lifetime explicit.
            san_ip := c.ip_addresses[ii] + ""
            if net.ip_equal(&ip, &san_ip) {
                << true
            }
            ii = ii + 1
        }
        << false
    }

    $i := 0
    while i < c.dns_names.len {
        if dns_name_match(c.dns_names[i] + "", candidate + "") {
            << true
        }
        i = i + 1
    }
    // Retain compatibility with certificates that have no SAN extension at
    // all, but never let Common Name override a present DNS or IP SAN.
    if c.dns_names.len == 0 && c.ip_addresses.len == 0 && c.subject.common_name.len > 0 {
        if dns_name_match(c.subject.common_name + "", candidate + "") {
            << true
        }
    }
    << false
}

fn cert_time_ok_values(not_before time.Time, not_after time.Time, now time.Time) bool {
    << !now.before(not_before) && !now.after(not_after)
}

fn subject_was_seen(seen &[]string, subject &string) bool {
    $i := 0
    while i < seen.len {
        if seen[i] == (subject + "") {
            << true
        }
        i = i + 1
    }
    << false
}

struct ChainCert {
    serial_bytes string
    raw_issuer string
    raw_subject string
    raw_tbs string
    signature string
    signature_algorithm int
    public_key string
    public_key_algorithm int
    not_before time.Time
    not_after time.Time
    is_ca bool
    basic_constraints_valid bool
    max_path_len int
    max_path_len_zero bool
    key_usage int
    key_usage_present bool
    subject_key_id string
    authority_key_id string
    ext_key_usage []int
    ext_key_usage_present bool
    has_unknown_ext_key_usage bool
    dns_names []string
    ip_addresses []string
    permitted_dns_domains []string
    excluded_dns_domains []string
    permitted_ip_ranges []string
    excluded_ip_ranges []string
    name_constraints_present bool
    name_constraints_unsupported bool
    certificate_policies []string
    certificate_policies_present bool
    policy_mapping_issuers []string
    policy_mapping_subjects []string
    policy_mappings_present bool
    require_explicit_policy int
    inhibit_policy_mapping int
    policy_constraints_present bool
    inhibit_any_policy int
    inhibit_any_policy_present bool
    has_unhandled_critical_extension bool
}

fn chain_entries(pool &CertPool) []ChainCert {
    $out := []ChainCert{}
    $i := 0
    while i < pool.certs.len {
        $ext_key_usage := []int{}
        $j := 0
        while j < pool.certs[i].ext_key_usage.len {
            ext_key_usage.push(pool.certs[i].ext_key_usage[j])
            j = j + 1
        }
        $dns_names := []string{}
        j = 0
        while j < pool.certs[i].dns_names.len {
            dns_names.push(pool.certs[i].dns_names[j] + "")
            j = j + 1
        }
        $ip_addresses := []string{}
        j = 0
        while j < pool.certs[i].ip_addresses.len {
            ip_addresses.push(pool.certs[i].ip_addresses[j] + "")
            j = j + 1
        }
        $permitted_dns_domains := []string{}
        j = 0
        while j < pool.certs[i].permitted_dns_domains.len {
            permitted_dns_domains.push(pool.certs[i].permitted_dns_domains[j] + "")
            j = j + 1
        }
        $excluded_dns_domains := []string{}
        j = 0
        while j < pool.certs[i].excluded_dns_domains.len {
            excluded_dns_domains.push(pool.certs[i].excluded_dns_domains[j] + "")
            j = j + 1
        }
        $permitted_ip_ranges := []string{}
        j = 0
        while j < pool.certs[i].permitted_ip_ranges.len {
            permitted_ip_ranges.push(pool.certs[i].permitted_ip_ranges[j] + "")
            j = j + 1
        }
        $excluded_ip_ranges := []string{}
        j = 0
        while j < pool.certs[i].excluded_ip_ranges.len {
            excluded_ip_ranges.push(pool.certs[i].excluded_ip_ranges[j] + "")
            j = j + 1
        }
        $certificate_policies := []string{}
        j = 0
        while j < pool.certs[i].certificate_policies.len {
            certificate_policies.push(pool.certs[i].certificate_policies[j] + "")
            j = j + 1
        }
        $policy_mapping_issuers := []string{}
        j = 0
        while j < pool.certs[i].policy_mapping_issuers.len {
            policy_mapping_issuers.push(pool.certs[i].policy_mapping_issuers[j] + "")
            j = j + 1
        }
        $policy_mapping_subjects := []string{}
        j = 0
        while j < pool.certs[i].policy_mapping_subjects.len {
            policy_mapping_subjects.push(pool.certs[i].policy_mapping_subjects[j] + "")
            j = j + 1
        }
        out.push(ChainCert{
            serial_bytes: pool.certs[i].serial_bytes + "",
            raw_issuer: pool.certs[i].raw_issuer + "",
            raw_subject: pool.certs[i].raw_subject + "",
            raw_tbs: pool.certs[i].raw_tbs_certificate + "",
            signature: pool.certs[i].signature + "",
            signature_algorithm: pool.certs[i].signature_algorithm,
            public_key: pool.certs[i].public_key + "",
            public_key_algorithm: pool.certs[i].public_key_algorithm,
            not_before: pool.certs[i].not_before,
            not_after: pool.certs[i].not_after,
            is_ca: pool.certs[i].is_ca,
            basic_constraints_valid: pool.certs[i].basic_constraints_valid,
            max_path_len: pool.certs[i].max_path_len,
            max_path_len_zero: pool.certs[i].max_path_len_zero,
            key_usage: pool.certs[i].key_usage,
            key_usage_present: pool.certs[i].key_usage_present,
            subject_key_id: pool.certs[i].subject_key_id + "",
            authority_key_id: pool.certs[i].authority_key_id + "",
            ext_key_usage: ext_key_usage,
            ext_key_usage_present: pool.certs[i].ext_key_usage_present,
            has_unknown_ext_key_usage: pool.certs[i].has_unknown_ext_key_usage,
            dns_names: dns_names,
            ip_addresses: ip_addresses,
            permitted_dns_domains: permitted_dns_domains,
            excluded_dns_domains: excluded_dns_domains,
            permitted_ip_ranges: permitted_ip_ranges,
            excluded_ip_ranges: excluded_ip_ranges,
            name_constraints_present: pool.certs[i].name_constraints_present,
            name_constraints_unsupported: pool.certs[i].name_constraints_unsupported,
            certificate_policies: certificate_policies,
            certificate_policies_present: pool.certs[i].certificate_policies_present,
            policy_mapping_issuers: policy_mapping_issuers,
            policy_mapping_subjects: policy_mapping_subjects,
            policy_mappings_present: pool.certs[i].policy_mappings_present,
            require_explicit_policy: pool.certs[i].require_explicit_policy,
            inhibit_policy_mapping: pool.certs[i].inhibit_policy_mapping,
            policy_constraints_present: pool.certs[i].policy_constraints_present,
            inhibit_any_policy: pool.certs[i].inhibit_any_policy,
            inhibit_any_policy_present: pool.certs[i].inhibit_any_policy_present,
            has_unhandled_critical_extension: pool.certs[i].has_unhandled_critical_extension
        })
        i = i + 1
    }
    << out
}

fn chain_used(used &[]int, index int) bool {
    $i := 0
    while i < used.len {
        if used[i] == index {
            << true
        }
        i = i + 1
    }
    << false
}

fn chain_entry_clone(entries &[]ChainCert, i int) ChainCert {
    $ext_key_usage := []int{}
    $j := 0
    while j < entries[i].ext_key_usage.len {
        ext_key_usage.push(entries[i].ext_key_usage[j])
        j = j + 1
    }
    $dns_names := []string{}
    j = 0
    while j < entries[i].dns_names.len {
        dns_names.push(entries[i].dns_names[j] + "")
        j = j + 1
    }
    $ip_addresses := []string{}
    j = 0
    while j < entries[i].ip_addresses.len {
        ip_addresses.push(entries[i].ip_addresses[j] + "")
        j = j + 1
    }
    $permitted_dns_domains := []string{}
    j = 0
    while j < entries[i].permitted_dns_domains.len {
        permitted_dns_domains.push(entries[i].permitted_dns_domains[j] + "")
        j = j + 1
    }
    $excluded_dns_domains := []string{}
    j = 0
    while j < entries[i].excluded_dns_domains.len {
        excluded_dns_domains.push(entries[i].excluded_dns_domains[j] + "")
        j = j + 1
    }
    $permitted_ip_ranges := []string{}
    j = 0
    while j < entries[i].permitted_ip_ranges.len {
        permitted_ip_ranges.push(entries[i].permitted_ip_ranges[j] + "")
        j = j + 1
    }
    $excluded_ip_ranges := []string{}
    j = 0
    while j < entries[i].excluded_ip_ranges.len {
        excluded_ip_ranges.push(entries[i].excluded_ip_ranges[j] + "")
        j = j + 1
    }
    $certificate_policies := []string{}
    j = 0
    while j < entries[i].certificate_policies.len {
        certificate_policies.push(entries[i].certificate_policies[j] + "")
        j = j + 1
    }
    $policy_mapping_issuers := []string{}
    j = 0
    while j < entries[i].policy_mapping_issuers.len {
        policy_mapping_issuers.push(entries[i].policy_mapping_issuers[j] + "")
        j = j + 1
    }
    $policy_mapping_subjects := []string{}
    j = 0
    while j < entries[i].policy_mapping_subjects.len {
        policy_mapping_subjects.push(entries[i].policy_mapping_subjects[j] + "")
        j = j + 1
    }
    << ChainCert{
        serial_bytes: entries[i].serial_bytes + "",
        raw_issuer: entries[i].raw_issuer + "",
        raw_subject: entries[i].raw_subject + "",
        raw_tbs: entries[i].raw_tbs + "",
        signature: entries[i].signature + "",
        signature_algorithm: entries[i].signature_algorithm,
        public_key: entries[i].public_key + "",
        public_key_algorithm: entries[i].public_key_algorithm,
        not_before: entries[i].not_before,
        not_after: entries[i].not_after,
        is_ca: entries[i].is_ca,
        basic_constraints_valid: entries[i].basic_constraints_valid,
        max_path_len: entries[i].max_path_len,
        max_path_len_zero: entries[i].max_path_len_zero,
        key_usage: entries[i].key_usage,
        key_usage_present: entries[i].key_usage_present,
        subject_key_id: entries[i].subject_key_id + "",
        authority_key_id: entries[i].authority_key_id + "",
        ext_key_usage: ext_key_usage,
        ext_key_usage_present: entries[i].ext_key_usage_present,
        has_unknown_ext_key_usage: entries[i].has_unknown_ext_key_usage,
        dns_names: dns_names,
        ip_addresses: ip_addresses,
        permitted_dns_domains: permitted_dns_domains,
        excluded_dns_domains: excluded_dns_domains,
        permitted_ip_ranges: permitted_ip_ranges,
        excluded_ip_ranges: excluded_ip_ranges,
        name_constraints_present: entries[i].name_constraints_present,
        name_constraints_unsupported: entries[i].name_constraints_unsupported,
        certificate_policies: certificate_policies,
        certificate_policies_present: entries[i].certificate_policies_present,
        policy_mapping_issuers: policy_mapping_issuers,
        policy_mapping_subjects: policy_mapping_subjects,
        policy_mappings_present: entries[i].policy_mappings_present,
        require_explicit_policy: entries[i].require_explicit_policy,
        inhibit_policy_mapping: entries[i].inhibit_policy_mapping,
        policy_constraints_present: entries[i].policy_constraints_present,
        inhibit_any_policy: entries[i].inhibit_any_policy,
        inhibit_any_policy_present: entries[i].inhibit_any_policy_present,
        has_unhandled_critical_extension: entries[i].has_unhandled_critical_extension
    }
}

fn chain_key_id_ok(child_authority_key_id &string, parent_key_id &string) bool {
    if child_authority_key_id.len > 0 && parent_key_id.len > 0 {
        << (child_authority_key_id + "") == (parent_key_id + "")
    }
    << true
}

fn chain_parent_ok(child_authority_key_id &string, child_tbs &string, child_sig &string, child_algo int, parent &ChainCert, now time.Time, ca_below int) bool {
    if parent.has_unhandled_critical_extension || !parent.is_ca || !parent.basic_constraints_valid {
        << false
    }
    if parent.key_usage_present && (parent.key_usage & KEY_USAGE_CERT_SIGN) == 0 {
        << false
    }
    if parent.max_path_len >= 0 && ca_below > parent.max_path_len {
        << false
    }
    if !cert_time_ok_values(parent.not_before, parent.not_after, now) {
        << false
    }
    if !chain_key_id_ok(child_authority_key_id, &parent.subject_key_id) {
        << false
    }
    verify_sig(parent.public_key_algorithm, parent.public_key + "", child_algo, child_tbs + "", child_sig + "") or (err) {
        << false
    }
    << true
}

fn chain_leaf_entry(c &Certificate) ChainCert {
    $ext_key_usage := []int{}
    $i := 0
    while i < c.ext_key_usage.len {
        ext_key_usage.push(c.ext_key_usage[i])
        i = i + 1
    }
    $dns_names := []string{}
    i = 0
    while i < c.dns_names.len {
        dns_names.push(c.dns_names[i] + "")
        i = i + 1
    }
    $ip_addresses := []string{}
    i = 0
    while i < c.ip_addresses.len {
        ip_addresses.push(c.ip_addresses[i] + "")
        i = i + 1
    }
    $permitted_dns_domains := []string{}
    i = 0
    while i < c.permitted_dns_domains.len {
        permitted_dns_domains.push(c.permitted_dns_domains[i] + "")
        i = i + 1
    }
    $excluded_dns_domains := []string{}
    i = 0
    while i < c.excluded_dns_domains.len {
        excluded_dns_domains.push(c.excluded_dns_domains[i] + "")
        i = i + 1
    }
    $permitted_ip_ranges := []string{}
    i = 0
    while i < c.permitted_ip_ranges.len {
        permitted_ip_ranges.push(c.permitted_ip_ranges[i] + "")
        i = i + 1
    }
    $excluded_ip_ranges := []string{}
    i = 0
    while i < c.excluded_ip_ranges.len {
        excluded_ip_ranges.push(c.excluded_ip_ranges[i] + "")
        i = i + 1
    }
    $certificate_policies := []string{}
    i = 0
    while i < c.certificate_policies.len {
        certificate_policies.push(c.certificate_policies[i] + "")
        i = i + 1
    }
    $policy_mapping_issuers := []string{}
    i = 0
    while i < c.policy_mapping_issuers.len {
        policy_mapping_issuers.push(c.policy_mapping_issuers[i] + "")
        i = i + 1
    }
    $policy_mapping_subjects := []string{}
    i = 0
    while i < c.policy_mapping_subjects.len {
        policy_mapping_subjects.push(c.policy_mapping_subjects[i] + "")
        i = i + 1
    }
    << ChainCert{
        serial_bytes: c.serial_bytes + "",
        raw_issuer: c.raw_issuer + "",
        raw_subject: c.raw_subject + "",
        raw_tbs: c.raw_tbs_certificate + "",
        signature: c.signature + "",
        signature_algorithm: c.signature_algorithm,
        public_key: c.public_key + "",
        public_key_algorithm: c.public_key_algorithm,
        not_before: c.not_before,
        not_after: c.not_after,
        is_ca: c.is_ca,
        basic_constraints_valid: c.basic_constraints_valid,
        max_path_len: c.max_path_len,
        max_path_len_zero: c.max_path_len_zero,
        key_usage: c.key_usage,
        key_usage_present: c.key_usage_present,
        subject_key_id: c.subject_key_id + "",
        authority_key_id: c.authority_key_id + "",
        ext_key_usage: ext_key_usage,
        ext_key_usage_present: c.ext_key_usage_present,
        has_unknown_ext_key_usage: c.has_unknown_ext_key_usage,
        dns_names: dns_names,
        ip_addresses: ip_addresses,
        permitted_dns_domains: permitted_dns_domains,
        excluded_dns_domains: excluded_dns_domains,
        permitted_ip_ranges: permitted_ip_ranges,
        excluded_ip_ranges: excluded_ip_ranges,
        name_constraints_present: c.name_constraints_present,
        name_constraints_unsupported: c.name_constraints_unsupported,
        certificate_policies: certificate_policies,
        certificate_policies_present: c.certificate_policies_present,
        policy_mapping_issuers: policy_mapping_issuers,
        policy_mapping_subjects: policy_mapping_subjects,
        policy_mappings_present: c.policy_mappings_present,
        require_explicit_policy: c.require_explicit_policy,
        inhibit_policy_mapping: c.inhibit_policy_mapping,
        policy_constraints_present: c.policy_constraints_present,
        inhibit_any_policy: c.inhibit_any_policy,
        inhibit_any_policy_present: c.inhibit_any_policy_present,
        has_unhandled_critical_extension: c.has_unhandled_critical_extension
    }
}

fn chain_path_clone(path &[]ChainCert) []ChainCert {
    $out := []ChainCert{}
    $i := 0
    while i < path.len {
        out.push(chain_entry_clone(path, i))
        i = i + 1
    }
    << out
}

// Search all candidate issuers instead of committing to the first subject
// match. This handles cross-signing and duplicate-subject pools: a candidate
// is accepted only if the entire suffix reaches a trusted root. The depth and
// visited-index bounds make malformed cycles finite and deterministic.
fn verify_chain_step(cur &ChainCert, now time.Time, roots &[]ChainCert, intermediates &[]ChainCert, used &[]int, path &[]ChainCert, names_below &ChainNames, key_usages &[]int, requested_policies &[]string, revocation_lists &[]string, revocation_mode int, ca_below int, depth int) bool {
    if depth > 8 || cur.has_unhandled_critical_extension || cur.name_constraints_unsupported || (revocation_mode != REVOCATION_OFF && revocation_mode != REVOCATION_IF_PRESENT && revocation_mode != REVOCATION_REQUIRE) {
        << false
    }
    if cur.name_constraints_present {
        if !cur.is_ca || !chain_names_allowed(cur, names_below) {
            << false
        }
    }
    next_key_usages := chain_filter_key_usages(cur, key_usages)
    if next_key_usages.len == 0 {
        << false
    }
    // RFC 5280 does not apply name constraints to a self-issued intermediate,
    // but the final certificate is always checked even if self-issued.
    add_current_names := depth == 0 || cur.raw_subject != cur.raw_issuer
    names_for_parent := chain_names_add(names_below, cur, add_current_names)
    $i := 0
    while i < roots.len {
        root_subject := roots[i].raw_subject + ""
        root_ski := roots[i].subject_key_id + ""
        if root_subject == cur.raw_issuer && cert_time_ok_values(roots[i].not_before, roots[i].not_after, now) {
            if cur.authority_key_id.len == 0 || root_ski.len == 0 || cur.authority_key_id == root_ski {
                // Materialize an owning local before borrowing across the
                // revocation helper. Borrowing an indexed owning field
                // directly can alias the pool element's descriptor during
                // the wide argument call.
                cur_serial := cur.serial_bytes + ""
                cur_issuer := cur.raw_issuer + ""
                root_public_key := roots[i].public_key + ""
                if !revocation_edge_ok(&cur_serial, &cur_issuer, roots[i].public_key_algorithm, &root_public_key, roots[i].key_usage_present, roots[i].key_usage, &root_ski, revocation_lists, revocation_mode, now) {
                    i = i + 1
                    ->
                }
                verify_sig(roots[i].public_key_algorithm, roots[i].public_key + "", cur.signature_algorithm, cur.raw_tbs + "", cur.signature + "") or (err) {
                    i = i + 1
                    ->
                }
                if policy_path_ok(path, requested_policies) {
                    << true
                }
            }
        }
        i = i + 1
    }
    if depth == 8 {
        << false
    }
    i = 0
    while i < intermediates.len {
        if !chain_used(used, i) {
            parent := chain_entry_clone(intermediates, i)
            child_issuer := cur.raw_issuer + ""
            child_aki := cur.authority_key_id + ""
            child_tbs := cur.raw_tbs + ""
            child_sig := cur.signature + ""
            cur_serial := cur.serial_bytes + ""
            cur_issuer := cur.raw_issuer + ""
            parent_public_key := parent.public_key + ""
            parent_subject_key_id := parent.subject_key_id + ""
            if parent.raw_subject == child_issuer && revocation_edge_ok(&cur_serial, &cur_issuer, parent.public_key_algorithm, &parent_public_key, parent.key_usage_present, parent.key_usage, &parent_subject_key_id, revocation_lists, revocation_mode, now) && chain_parent_ok(&child_aki, &child_tbs, &child_sig, cur.signature_algorithm, &parent, now, ca_below) {
                $next_used := []int{}
                $j := 0
                while j < used.len {
                    next_used.push(used[j])
                    j = j + 1
                }
                next_used.push(i)
                $next_ca_below := ca_below
                if parent.raw_subject != parent.raw_issuer {
                    next_ca_below = next_ca_below + 1
                }
                $next_path := chain_path_clone(path)
                next_path.push(chain_entry_clone(intermediates, i))
                if verify_chain_step(&parent, now, roots, intermediates, &next_used, &next_path, &names_for_parent, &next_key_usages, requested_policies, revocation_lists, revocation_mode, next_ca_below, depth + 1) {
                    << true
                }
            }
        }
        i = i + 1
    }
    << false
}

fn verify_chain(c &Certificate, now time.Time, roots &[]ChainCert, intermediates &[]ChainCert, requested_usages &[]int, requested_policies &[]string, revocation_lists &[]string, revocation_mode int) int {
    leaf := chain_leaf_entry(c)
    used := []int{}
    $path := []ChainCert{}
    path.push(chain_leaf_entry(c))
    names := ChainNames{dns: []string{}, ips: []string{}}
    usages := normalize_requested_usages(requested_usages)
    if !verify_chain_step(&leaf, now, roots, intermediates, &used, &path, &names, &usages, requested_policies, revocation_lists, revocation_mode, 0, 0) {
        >> errors.new("x509: certificate signed by unknown authority")
    }
    << 0
}

pub fn (c &Certificate) verify_with_pools(dns_name string, current_time time.Time, roots &CertPool, intermediates &CertPool) int {
    $now := current_time
    if now.sec == 0 && now.nsec == 0 {
        now = time.now_time()
    }
    if now.before(c.not_before) || now.after(c.not_after) {
        >> errors.new("x509: certificate has expired or is not yet valid")
    }
    if dns_name.len > 0 {
        if !name_ok(c, dns_name + "") {
            >> errors.new("x509: certificate is not valid for any names")
        }
    }
    if roots.certs.len == 0 {
        >> errors.new("x509: certificate signed by unknown authority")
    }
    root_entries := chain_entries(roots)
    entries := chain_entries(intermediates)
    default_usages := []int{}
    default_policies := []string{}
    default_revocation_lists := []string{}
    << verify_chain(c, now, &root_entries, &entries, &default_usages, &default_policies, &default_revocation_lists, REVOCATION_OFF)
}

// verify_options borrows reusable verification inputs. This is the preferred
// form for callers that validate repeatedly against one pool or CRL set.
pub fn (c &Certificate) verify_options(opts &VerifyOptions) int {
    $now := opts.current_time
    if now.sec == 0 && now.nsec == 0 {
        now = time.now_time()
    }
    if now.before(c.not_before) || now.after(c.not_after) {
        >> errors.new("x509: certificate has expired or is not yet valid")
    }
    if opts.dns_name.len > 0 {
        if !name_ok(c, opts.dns_name + "") {
            >> errors.new("x509: certificate is not valid for any names")
        }
    }
    nroot := opts.roots.certs.len
    if nroot == 0 {
        iss := c.raw_issuer + ""
        sub := c.raw_subject + ""
        if iss != sub {
            >> errors.new("x509: certificate signed by unknown authority")
        }
        tbs := c.raw_tbs_certificate + ""
        sig := c.signature + ""
        algo := c.signature_algorithm
        pkey := c.public_key + ""
        palgo := c.public_key_algorithm
        self := chain_leaf_entry(c)
        requested := normalize_requested_usages(&opts.key_usages)
        filtered := chain_filter_key_usages(&self, &requested)
        if filtered.len == 0 {
            >> errors.new("x509: certificate specifies an incompatible key usage")
        }
        $self_path := []ChainCert{}
        self_path.push(chain_leaf_entry(c))
        if !policy_path_ok(&self_path, &opts.certificate_policies) {
            >> errors.new("x509: certificate policies are incompatible")
        }
        << verify_sig(palgo, pkey, algo, tbs, sig)
    }
    root_entries := chain_entries(&opts.roots)
    entries := chain_entries(&opts.intermediates)
    $requested_usages := []int{}
    $i := 0
    while i < opts.key_usages.len {
        requested_usages.push(opts.key_usages[i])
        i = i + 1
    }
    $requested_policies := []string{}
    i = 0
    while i < opts.certificate_policies.len {
        requested_policies.push(opts.certificate_policies[i] + "")
        i = i + 1
    }
    $revocation_lists := []string{}
    i = 0
    while i < opts.revocation_lists.len {
        revocation_lists.push(opts.revocation_lists[i] + "")
        i = i + 1
    }
    mode := opts.revocation_mode
    << verify_chain(c, now, &root_entries, &entries, &requested_usages, &requested_policies, &revocation_lists, mode)
}

// verify retains the original consuming API for source compatibility.
pub fn (c &Certificate) verify(opts VerifyOptions) int {
    << c.verify_options(&opts)
}
