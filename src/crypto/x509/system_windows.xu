@crypto/x509
$windows

// Windows' platform adapter returns opaque entries framed as
// uint32-little-endian length + DER. CryptoAPI structures, handles and calls
// remain behind that ABI; all DER parsing and trust-pool policy stay here.
fn append_platform_certificates(p &mut CertPool) int {
    blob := sys_security_store("ROOT") or (err) {
        << 0
    }
    mut off := 0
    mut added := 0
    while off + 4 <= blob.len {
        n := (blob[off] & 255) | ((blob[off + 1] & 255) << 8) | ((blob[off + 2] & 255) << 16) | ((blob[off + 3] & 255) << 24)
        off = off + 4
        if n <= 0 || n > blob.len - off {
            << added
        }
        der := blob[off:off + n] + ""
        off = off + n
        c := parse_certificate(der) or (err) {
            ->
        }
        p.add(c)
        added = added + 1
    }
    << added
}
