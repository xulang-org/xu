@crypto/x509/pkix

// Go `crypto/x509/pkix.Name`. Slices are the Go []string RDN values;
// common_name is also stored (Go CommonName). text() prints RFC 4514-ish
// most-specific-first RDNs; ExtraNames and multi-value '+' are out of scope.

pub struct Name {
    pub country []string
    pub organization []string
    pub organizational_unit []string
    pub locality []string
    pub province []string
    pub street_address []string
    pub postal_code []string
    pub serial_number string
    pub common_name string
}

fn join_attr(out string, label string, value string) string {
    if value.len == 0 {
        << out
    }
    mut s := out + ""
    if s.len > 0 {
        s = s + ","
    }
    << s + (label + "") + "=" + (value + "")
}

fn join_attrs(out string, label string, vals &[]string) string {
    mut s := out + ""
    for i in 0:vals.len {
        s = join_attr(s, label, vals[i] + "")
    }
    << s
}

// RFC 4514-ish most-specific-first: CN, SERIALNUMBER, OU, O, L, ST,
// STREET, POSTALCODE, C. ExtraNames / multi-value '+' are out of scope.
pub fn (n &Name) text() string {
    mut out := ""
    out = join_attr(out, "CN", n.common_name + "")
    out = join_attr(out, "SERIALNUMBER", n.serial_number + "")
    out = join_attrs(out, "OU", &n.organizational_unit)
    out = join_attrs(out, "O", &n.organization)
    out = join_attrs(out, "L", &n.locality)
    out = join_attrs(out, "ST", &n.province)
    out = join_attrs(out, "STREET", &n.street_address)
    out = join_attrs(out, "POSTALCODE", &n.postal_code)
    out = join_attrs(out, "C", &n.country)
    << out
}
