@crypto/x509

#encoding/asn1
#errors

struct ParsedCertificatePolicies {
    identifiers []string
}

struct ParsedPolicyMappings {
    issuers []string
    subjects []string
}

struct ParsedPolicyConstraints {
    require_explicit int
    inhibit_mapping int
}

fn oid_string(arcs &[]int) string {
    if arcs.len < 2 {
        << ""
    }
    $out := str(arcs[0]) + "." + str(arcs[1])
    $i := 2
    while i < arcs.len {
        out = out + "." + str(arcs[i])
        i = i + 1
    }
    << out
}

fn any_policy_oid() string {
    << "2.5.29.32.0"
}

fn string_array_has(values &[]string, want &string) bool {
    $i := 0
    while i < values.len {
        if values[i] == (want + "") {
            << true
        }
        i = i + 1
    }
    << false
}

fn string_array_push_unique(values $&[]string, value string) {
    $i := 0
    while i < values.len {
        if values[i] == (value + "") {
            <<
        }
        i = i + 1
    }
    values.push(value)
}

fn parse_certificate_policies(payload string) ParsedCertificatePolicies {
    seq := asn1.unmarshal(&payload) or >>
    if seq.tag != asn1.TAG_SEQUENCE || seq.constructed == 0 || seq.rest.len != 0 {
        >> errors.new("x509: invalid certificate policies")
    }
    $d := asn1.new_decoder(&seq.bytes)
    if d.done() {
        >> errors.new("x509: invalid certificate policies")
    }
    $ids := []string{}
    while !d.done() {
        info := d.next() or >>
        if info.tag != asn1.TAG_SEQUENCE || info.constructed == 0 {
            >> errors.new("x509: invalid certificate policies")
        }
        $id := asn1.new_decoder(&info.bytes)
        oidv := id.next() or >>
        if oidv.tag != asn1.TAG_OID || oidv.class != asn1.CLASS_UNIVERSAL {
            >> errors.new("x509: invalid certificate policies")
        }
        arcs := oidv.as_oid() or >>
        text := oid_string(&arcs)
        if text.len == 0 || string_array_has(&ids, &text) {
            >> errors.new("x509: invalid certificate policies")
        }
        ids.push(text)
        if !id.done() {
            qualifiers := id.next() or >>
            if qualifiers.tag != asn1.TAG_SEQUENCE || qualifiers.constructed == 0 || !id.done() {
                >> errors.new("x509: invalid certificate policy qualifiers")
            }
            // Qualifier semantics do not change path acceptance, but DER shape
            // is checked instead of silently accepting arbitrary trailing data.
            $qd := asn1.new_decoder(&qualifiers.bytes)
            if qd.done() {
                >> errors.new("x509: invalid certificate policy qualifiers")
            }
            while !qd.done() {
                qualifier := qd.next() or >>
                if qualifier.tag != asn1.TAG_SEQUENCE || qualifier.constructed == 0 {
                    >> errors.new("x509: invalid certificate policy qualifier")
                }
                $one := asn1.new_decoder(&qualifier.bytes)
                qoid := one.next() or >>
                qvalue := one.next() or >>
                if qoid.tag != asn1.TAG_OID || !one.done() {
                    >> errors.new("x509: invalid certificate policy qualifier")
                }
            }
        }
    }
    << ParsedCertificatePolicies{identifiers: ids}
}

fn parse_policy_mappings(payload string) ParsedPolicyMappings {
    seq := asn1.unmarshal(&payload) or >>
    if seq.tag != asn1.TAG_SEQUENCE || seq.constructed == 0 || seq.rest.len != 0 {
        >> errors.new("x509: invalid policy mappings")
    }
    $d := asn1.new_decoder(&seq.bytes)
    if d.done() {
        >> errors.new("x509: invalid policy mappings")
    }
    $issuers := []string{}
    $subjects := []string{}
    any_oid := any_policy_oid()
    while !d.done() {
        mapping := d.next() or >>
        if mapping.tag != asn1.TAG_SEQUENCE || mapping.constructed == 0 {
            >> errors.new("x509: invalid policy mappings")
        }
        $md := asn1.new_decoder(&mapping.bytes)
        issuer_v := md.next() or >>
        subject_v := md.next() or >>
        if issuer_v.tag != asn1.TAG_OID || subject_v.tag != asn1.TAG_OID || !md.done() {
            >> errors.new("x509: invalid policy mappings")
        }
        issuer_arcs := issuer_v.as_oid() or >>
        subject_arcs := subject_v.as_oid() or >>
        issuer := oid_string(&issuer_arcs)
        subject := oid_string(&subject_arcs)
        if issuer.len == 0 || subject.len == 0 || issuer == any_oid || subject == any_oid {
            >> errors.new("x509: invalid policy mappings")
        }
        issuers.push(issuer)
        subjects.push(subject)
    }
    << ParsedPolicyMappings{issuers: issuers, subjects: subjects}
}

fn parse_implicit_nonnegative_int(v &asn1.Value) int {
    if v.class != asn1.CLASS_CONTEXT || v.constructed != 0 || v.bytes.len == 0 || (v.bytes[0] & 128) != 0 {
        >> errors.new("x509: invalid policy constraint")
    }
    if v.bytes.len > 1 && (v.bytes[0] & 255) == 0 && (v.bytes[1] & 128) == 0 {
        >> errors.new("x509: non-minimal policy constraint")
    }
    $out := 0
    $i := 0
    while i < v.bytes.len {
        if out > 36028797018963967 {
            >> errors.new("x509: policy constraint overflow")
        }
        out = out * 256 + (v.bytes[i] & 255)
        i = i + 1
    }
    << out
}

fn parse_policy_constraints(payload string) ParsedPolicyConstraints {
    seq := asn1.unmarshal(&payload) or >>
    if seq.tag != asn1.TAG_SEQUENCE || seq.constructed == 0 || seq.rest.len != 0 {
        >> errors.new("x509: invalid policy constraints")
    }
    $d := asn1.new_decoder(&seq.bytes)
    if d.done() {
        >> errors.new("x509: invalid policy constraints")
    }
    $require_explicit := -1
    $inhibit_mapping := -1
    while !d.done() {
        v := d.next() or >>
        if v.tag == 0 {
            if require_explicit >= 0 {
                >> errors.new("x509: duplicate requireExplicitPolicy")
            }
            require_explicit = parse_implicit_nonnegative_int(&v) or >>
        } else if v.tag == 1 {
            if inhibit_mapping >= 0 {
                >> errors.new("x509: duplicate inhibitPolicyMapping")
            }
            inhibit_mapping = parse_implicit_nonnegative_int(&v) or >>
        } else {
            >> errors.new("x509: invalid policy constraints")
        }
    }
    << ParsedPolicyConstraints{require_explicit: require_explicit, inhibit_mapping: inhibit_mapping}
}

fn parse_inhibit_any_policy(payload string) int {
    value := asn1.unmarshal(&payload) or >>
    if value.tag != asn1.TAG_INTEGER || value.class != asn1.CLASS_UNIVERSAL || value.constructed != 0 || value.rest.len != 0 {
        >> errors.new("x509: invalid inhibit anyPolicy")
    }
    << value.as_int() or >>
}

fn min_policy_counter(current int, candidate int) int {
    if candidate >= 0 && candidate < current {
        << candidate
    }
    << current
}

fn policy_filter(expected &[]string, cert &ChainCert, inhibit_any int) []string {
    $out := []string{}
    if !cert.certificate_policies_present {
        << out
    }
    any_oid := any_policy_oid()
    has_any := string_array_has(&cert.certificate_policies, &any_oid) && inhibit_any > 0
    $i := 0
    while i < expected.len {
        wanted := expected[i] + ""
        if wanted == any_oid {
            $j := 0
            while j < cert.certificate_policies.len {
                candidate := cert.certificate_policies[j] + ""
                if candidate != any_oid {
                    string_array_push_unique($&out, candidate)
                }
                j = j + 1
            }
            if has_any && out.len == 0 {
                out.push(any_oid + "")
            }
        } else if string_array_has(&cert.certificate_policies, &wanted) || has_any {
            string_array_push_unique($&out, wanted)
        }
        i = i + 1
    }
    << out
}

fn policy_apply_mappings(valid &[]string, cert &ChainCert, inhibit_mapping int) []string {
    $out := string_array_clone(valid)
    if inhibit_mapping == 0 {
        << out
    }
    $i := 0
    while i < cert.policy_mapping_issuers.len && i < cert.policy_mapping_subjects.len {
        issuer := cert.policy_mapping_issuers[i] + ""
        if string_array_has(valid, &issuer) {
            subject := cert.policy_mapping_subjects[i] + ""
            string_array_push_unique($&out, subject)
        }
        i = i + 1
    }
    << out
}

fn policy_path_ok(path &[]ChainCert, requested &[]string) bool {
    $expected := []string{}
    if requested.len == 0 {
        expected.push(any_policy_oid())
    } else {
        expected = string_array_clone(requested)
    }
    initial_any := expected.len == 1 && expected[0] == any_policy_oid()
    $explicit_policy := path.len + 1
    $inhibit_mapping := path.len + 1
    $inhibit_any := path.len + 1
    $processed := 0
    $pos := path.len
    while pos > 0 {
        pos = pos - 1
        cert := chain_entry_clone(path, pos)
        is_final := pos == 0
        self_issued := cert.raw_subject == cert.raw_issuer
        if !self_issued || is_final {
            if explicit_policy > 0 { explicit_policy = explicit_policy - 1 }
            if inhibit_mapping > 0 { inhibit_mapping = inhibit_mapping - 1 }
            if inhibit_any > 0 { inhibit_any = inhibit_any - 1 }
        }
        explicit_policy = min_policy_counter(explicit_policy, cert.require_explicit_policy)
        inhibit_mapping = min_policy_counter(inhibit_mapping, cert.inhibit_policy_mapping)
        inhibit_any = min_policy_counter(inhibit_any, cert.inhibit_any_policy)

        valid := policy_filter(&expected, &cert, inhibit_any)
        if valid.len == 0 {
            if explicit_policy == 0 || !initial_any {
                << false
            }
            // With the default anyPolicy initial set, a null tree is allowed
            // until an explicit-policy constraint takes effect.
            expected = []string{}
        } else {
            expected = policy_apply_mappings(&valid, &cert, inhibit_mapping)
        }
        processed = processed + 1
    }
    if !initial_any && expected.len == 0 {
        << false
    }
    << processed == path.len
}
