@crypto/x509

#encoding/asn1
#errors
#strings

// ExtendedKeyUsage values match Go crypto/x509 where the API overlaps.
pub const EXT_KEY_USAGE_ANY = 0
pub const EXT_KEY_USAGE_SERVER_AUTH = 1
pub const EXT_KEY_USAGE_CLIENT_AUTH = 2
pub const EXT_KEY_USAGE_CODE_SIGNING = 3
pub const EXT_KEY_USAGE_EMAIL_PROTECTION = 4
pub const EXT_KEY_USAGE_IPSEC_END_SYSTEM = 5
pub const EXT_KEY_USAGE_IPSEC_TUNNEL = 6
pub const EXT_KEY_USAGE_IPSEC_USER = 7
pub const EXT_KEY_USAGE_TIME_STAMPING = 8
pub const EXT_KEY_USAGE_OCSP_SIGNING = 9

struct ParsedExtKeyUsage {
    usages []int
    has_unknown bool
}

struct ParsedNameConstraints {
    permitted_dns []string
    excluded_dns []string
    permitted_ip []string
    excluded_ip []string
    unsupported bool
}

struct ChainNames {
    dns []string
    ips []string
}

fn eku_from_oid(arcs &[]int) int {
    // id-kp: 1.3.6.1.5.5.7.3.N
    if arcs.len == 9 && arcs[0] == 1 && arcs[1] == 3 && arcs[2] == 6 && arcs[3] == 1 && arcs[4] == 5 && arcs[5] == 5 && arcs[6] == 7 && arcs[7] == 3 {
        last := arcs[8]
        if last >= 1 && last <= 9 {
            << last
        }
    }
    // anyExtendedKeyUsage: 2.5.29.37.0
    if oid_eq5(arcs, 2, 5, 29, 37, 0) {
        << EXT_KEY_USAGE_ANY
    }
    << -1
}

fn int_array_has(values &[]int, want int) bool {
    mut i := 0
    while i < values.len {
        if values[i] == want {
            << true
        }
        i = i + 1
    }
    << false
}

fn int_array_clone(values &[]int) []int {
    mut out := []int{}
    mut i := 0
    while i < values.len {
        out.push(values[i])
        i = i + 1
    }
    << out
}

fn string_array_clone(values &[]string) []string {
    mut out := []string{}
    mut i := 0
    while i < values.len {
        out.push(values[i] + "")
        i = i + 1
    }
    << out
}

fn parse_ext_key_usage(payload string) ParsedExtKeyUsage {
    seq := asn1.unmarshal(&payload) or >>
    if seq.tag != asn1.TAG_SEQUENCE || seq.constructed == 0 || seq.rest.len != 0 {
        >> errors.new("x509: invalid extended key usage")
    }
    mut d := asn1.new_decoder(&seq.bytes)
    mut usages := []int{}
    mut unknown := false
    if d.done() {
        >> errors.new("x509: invalid extended key usage")
    }
    while !d.done() {
        oidv := d.next() or >>
        if oidv.tag != asn1.TAG_OID || oidv.class != asn1.CLASS_UNIVERSAL {
            >> errors.new("x509: invalid extended key usage")
        }
        arcs := oidv.as_oid() or >>
        usage := eku_from_oid(&arcs)
        if usage < 0 {
            unknown = true
        } else if !int_array_has(&usages, usage) {
            usages.push(usage)
        }
    }
    << ParsedExtKeyUsage{usages: usages, has_unknown: unknown}
}

fn dns_constraint_valid(value &string) bool {
    if value.len == 0 {
        << false
    }
    mut start := 0
    if (value[0] & 255) == 46 {
        start = 1
        if value.len == 1 {
            << false
        }
    }
    mut label_len := 0
    mut i := start
    while i < value.len {
        c := value[i] & 255
        if c == 46 {
            if label_len == 0 {
                << false
            }
            label_len = 0
        } else {
            if c == 42 || c == 0 || c > 127 {
                << false
            }
            label_len = label_len + 1
        }
        i = i + 1
    }
    << label_len > 0
}

fn ip_constraint_valid(value &string) bool {
    if value.len != 8 && value.len != 32 {
        << false
    }
    half := value.len / 2
    mut saw_zero := false
    mut i := half
    while i < value.len {
        mask := value[i] & 255
        mut bit := 7
        while bit >= 0 {
            one := (mask & (1 << bit)) != 0
            if saw_zero && one {
                << false
            }
            if !one {
                saw_zero = true
            }
            bit = bit - 1
        }
        i = i + 1
    }
    << true
}

fn implicit_nonnegative_int_zero(v &asn1.Value) bool {
    if v.class != asn1.CLASS_CONTEXT || v.tag != 0 || v.constructed != 0 || v.bytes.len != 1 {
        << false
    }
    << (v.bytes[0] & 255) == 0
}

fn parse_general_subtrees(data &string, permitted bool, out &mut ParsedNameConstraints) int {
    mut d := asn1.new_decoder(data)
    if d.done() {
        >> errors.new("x509: invalid name constraints")
    }
    while !d.done() {
        subtree := d.next() or >>
        if subtree.tag != asn1.TAG_SEQUENCE || subtree.class != asn1.CLASS_UNIVERSAL || subtree.constructed == 0 {
            >> errors.new("x509: invalid name constraints")
        }
        mut sd := asn1.new_decoder(&subtree.bytes)
        if sd.done() {
            >> errors.new("x509: invalid name constraints")
        }
        base := sd.next() or >>
        // RFC 5280 requires minimum=0 and maximum absent. Accept an explicit
        // zero minimum, but fail closed on every other distance form.
        while !sd.done() {
            distance := sd.next() or >>
            if !implicit_nonnegative_int_zero(&distance) {
                out.unsupported = true
            }
        }
        if base.class != asn1.CLASS_CONTEXT || base.constructed != 0 {
            out.unsupported = true
            ->
        }
        if base.tag == 2 {
            value := base.bytes + ""
            if !dns_constraint_valid(&value) {
                >> errors.new("x509: invalid DNS name constraint")
            }
            if permitted {
                out.permitted_dns.push(value)
            } else {
                out.excluded_dns.push(value)
            }
        } else if base.tag == 7 {
            value := base.bytes + ""
            if !ip_constraint_valid(&value) {
                >> errors.new("x509: invalid IP name constraint")
            }
            if permitted {
                out.permitted_ip.push(value)
            } else {
                out.excluded_ip.push(value)
            }
        } else {
            // rfc822Name, directoryName, URI and registeredID are not yet
            // representable by Certificate's current SAN shape. Never ignore
            // them: the path builder rejects this certificate fail-closed.
            out.unsupported = true
        }
    }
    << 0
}

fn parse_name_constraints(payload string) ParsedNameConstraints {
    seq := asn1.unmarshal(&payload) or >>
    if seq.tag != asn1.TAG_SEQUENCE || seq.constructed == 0 || seq.rest.len != 0 {
        >> errors.new("x509: invalid name constraints")
    }
    mut out := ParsedNameConstraints{permitted_dns: []string{}, excluded_dns: []string{}, permitted_ip: []string{}, excluded_ip: []string{}, unsupported: false}
    mut d := asn1.new_decoder(&seq.bytes)
    if d.done() {
        >> errors.new("x509: invalid name constraints")
    }
    mut saw_permitted := false
    mut saw_excluded := false
    while !d.done() {
        part := d.next() or >>
        if part.class != asn1.CLASS_CONTEXT || part.constructed == 0 {
            >> errors.new("x509: invalid name constraints")
        }
        if part.tag == 0 {
            if saw_permitted {
                >> errors.new("x509: duplicate permitted name constraints")
            }
            saw_permitted = true
            parse_general_subtrees(&part.bytes, true, mut &out) or >>
        } else if part.tag == 1 {
            if saw_excluded {
                >> errors.new("x509: duplicate excluded name constraints")
            }
            saw_excluded = true
            parse_general_subtrees(&part.bytes, false, mut &out) or >>
        } else {
            >> errors.new("x509: invalid name constraints")
        }
    }
    << out
}

fn trim_constraint_dot(value string) string {
    if value.len > 0 && (value[value.len - 1] & 255) == 46 {
        << value[0:value.len - 1] + ""
    }
    << value
}

fn string_suffix(value &string, suffix &string) bool {
    if suffix.len > value.len {
        << false
    }
    start := value.len - suffix.len
    mut i := 0
    while i < suffix.len {
        if (value[start + i] & 255) != (suffix[i] & 255) {
            << false
        }
        i = i + 1
    }
    << true
}

fn dns_within_constraint(name string, constraint string) bool {
    lower_name := strings.to_lower(&name)
    lower_constraint := strings.to_lower(&constraint)
    n := trim_constraint_dot(lower_name)
    c := trim_constraint_dot(lower_constraint)
    if !dns_constraint_valid(&c) {
        << false
    }
    if (c[0] & 255) == 46 {
        << n.len > c.len && string_suffix(&n, &c)
    }
    if n == c {
        << true
    }
    dot_c := "." + c
    << n.len > dot_c.len && string_suffix(&n, &dot_c)
}

fn ip_within_constraint(ip &string, constraint &string) bool {
    if constraint.len != ip.len * 2 {
        << false
    }
    mut i := 0
    while i < ip.len {
        addr := constraint[i] & 255
        mask := constraint[ip.len + i] & 255
        if ((ip[i] & 255) & mask) != (addr & mask) {
            << false
        }
        i = i + 1
    }
    << true
}

fn dns_matches_any(name &string, constraints &[]string) bool {
    mut i := 0
    while i < constraints.len {
        if dns_within_constraint(name + "", constraints[i] + "") {
            << true
        }
        i = i + 1
    }
    << false
}

fn ip_matches_any(ip &string, constraints &[]string) bool {
    mut i := 0
    while i < constraints.len {
        constraint := constraints[i] + ""
        if ip_within_constraint(ip, &constraint) {
            << true
        }
        i = i + 1
    }
    << false
}

fn chain_names_allowed(parent &ChainCert, names &ChainNames) bool {
    if parent.name_constraints_unsupported {
        << false
    }
    mut i := 0
    while i < names.dns.len {
        name := names.dns[i] + ""
        if dns_matches_any(&name, &parent.excluded_dns_domains) {
            << false
        }
        if parent.permitted_dns_domains.len > 0 && !dns_matches_any(&name, &parent.permitted_dns_domains) {
            << false
        }
        i = i + 1
    }
    i = 0
    while i < names.ips.len {
        ip := names.ips[i] + ""
        if ip_matches_any(&ip, &parent.excluded_ip_ranges) {
            << false
        }
        if parent.permitted_ip_ranges.len > 0 && !ip_matches_any(&ip, &parent.permitted_ip_ranges) {
            << false
        }
        i = i + 1
    }
    << true
}

fn chain_names_add(names &ChainNames, c &ChainCert, add_current bool) ChainNames {
    mut dns := []string{}
    mut ips := []string{}
    mut i := 0
    while i < names.dns.len {
        dns.push(names.dns[i] + "")
        i = i + 1
    }
    i = 0
    while i < names.ips.len {
        ips.push(names.ips[i] + "")
        i = i + 1
    }
    if add_current {
        i = 0
        while i < c.dns_names.len {
            dns.push(c.dns_names[i] + "")
            i = i + 1
        }
        i = 0
        while i < c.ip_addresses.len {
            ips.push(c.ip_addresses[i] + "")
            i = i + 1
        }
    }
    << ChainNames{dns: dns, ips: ips}
}

fn normalize_requested_usages(requested &[]int) []int {
    if requested.len == 0 {
        mut defaults := []int{}
        defaults.push(EXT_KEY_USAGE_SERVER_AUTH)
        << defaults
    }
    << int_array_clone(requested)
}

fn chain_filter_key_usages(c &ChainCert, requested &[]int) []int {
    if requested.len == 0 {
        << []int{}
    }
    if int_array_has(requested, EXT_KEY_USAGE_ANY) || !c.ext_key_usage_present || int_array_has(&c.ext_key_usage, EXT_KEY_USAGE_ANY) {
        << int_array_clone(requested)
    }
    mut out := []int{}
    mut i := 0
    while i < requested.len {
        if int_array_has(&c.ext_key_usage, requested[i]) {
            out.push(requested[i])
        }
        i = i + 1
    }
    << out
}
