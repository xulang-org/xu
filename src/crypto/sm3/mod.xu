@crypto/sm3

#encoding/hex

// SM3 (GM/T 0004-2012). Xu addition — Go has no crypto/sm3.
// Pure i64 lanes masked to 32 bits after each step (same policy as
// crypto/sha256). No C, not a commercial-crypto certification.
// sum returns 64-char lowercase hex; sum_bytes returns 32 raw bytes.
// Digest compresses 64-byte windows in place (write does not concat
// the whole message; sum copies state then pads).

const m32 = 4294967295
const t0 = 0x79cc4519
const t1 = 0x7a879d8a

struct State {
    h0 int
    h1 int
    h2 int
    h3 int
    h4 int
    h5 int
    h6 int
    h7 int
}

fn iv() State {
    << State{h0: 0x7380166f, h1: 0x4914b2b9, h2: 0x172442d7, h3: 0xda8a0600, h4: 0xa96f30bc, h5: 0x163138aa, h6: 0xe38dee4d, h7: 0xb0fb0e4e}
}

fn zeros68() []int {
    mut w := []int{}
    for i in 0:68 {
        w.push(0)
    }
    << w
}

fn rotl(x0 int, n0 int) int {
    x := x0 & m32
    n := n0 & 31
    if n == 0 {
        << x
    }
    << ((x << n) | ((x >> (32 - n)) & m32)) & m32
}

fn p0(x int) int {
    << (x ^ rotl(x, 9) ^ rotl(x, 17)) & m32
}

fn p1(x int) int {
    << (x ^ rotl(x, 15) ^ rotl(x, 23)) & m32
}

fn ff(x int, y int, z int, j int) int {
    if j < 16 {
        << (x ^ y ^ z) & m32
    }
    << ((x & y) | (x & z) | (y & z)) & m32
}

fn gg(x int, y int, z int, j int) int {
    if j < 16 {
        << (x ^ y ^ z) & m32
    }
    << ((x & y) | ((x ^ m32) & z)) & m32
}

fn pad_tail(s &string, start int, total int) string {
    rem := s.len - start
    mut b := []int{}
    for i in 0:rem {
        b.push(s[start + i] & 255)
    }
    b.push(128)
    mut going := 1
    while going == 1 {
        if b.len % 64 == 56 {
            going = 0
        } else {
            b.push(0)
        }
    }
    bits := total * 8
    for j in 0:8 {
        b.push((bits >> (56 - 8 * j)) & 255)
    }
    << string_from_bytes(b)
}

fn raw_state(st &State) string {
    hh := [st.h0, st.h1, st.h2, st.h3, st.h4, st.h5, st.h6, st.h7]
    mut db := []int{}
    for j in 0:8 {
        v := hh[j]
        db.push((v >> 24) & 255)
        db.push((v >> 16) & 255)
        db.push((v >> 8) & 255)
        db.push(v & 255)
    }
    << string_from_bytes(db)
}

// Gen1 poisons computed indices (`w[j - 16]`, `w[j + 4]`) inside
// compress_block — leftover schedule lanes from a previous block then
// become out-of-range. Index via tiny helpers (same class as png / bzip2).
fn at_w(w &[]int, i int) int {
    << w[i]
}

fn set_w(w &mut []int, i int, v int) {
    w[i] = v
}

pub struct Digest {
    st State
    w []int
    buf string
    n int
}

pub fn new() Digest {
    << Digest{st: iv(), w: zeros68(), buf: "", n: 0}
}

fn (d &mut Digest) compress_block(s &string, off int) {
    for i in 0:16 {
        o := off + 4 * i
        set_w(mut &d.w, i, (((s[o] & 255) << 24) | ((s[o + 1] & 255) << 16) | ((s[o + 2] & 255) << 8) | (s[o + 3] & 255)) & m32)
    }
    mut j := 16
    while j < 68 {
        w0 := at_w(&d.w, j - 16)
        w1 := at_w(&d.w, j - 9)
        w2 := at_w(&d.w, j - 3)
        w3 := at_w(&d.w, j - 13)
        w4 := at_w(&d.w, j - 6)
        wv := (p1(w0 ^ w1 ^ rotl(w2, 15)) ^ rotl(w3, 7) ^ w4) & m32
        set_w(mut &d.w, j, wv)
        j = j + 1
    }
    mut a := d.st.h0
    mut b2 := d.st.h1
    mut c2 := d.st.h2
    mut d2 := d.st.h3
    mut e := d.st.h4
    mut f := d.st.h5
    mut g := d.st.h6
    mut h := d.st.h7
    j = 0
    while j < 64 {
        mut t := t0
        if j >= 16 {
            t = t1
        }
        ss1 := rotl((rotl(a, 12) + e + rotl(t, j)) & m32, 7)
        ss2 := ss1 ^ rotl(a, 12)
        wj := at_w(&d.w, j)
        wj4 := at_w(&d.w, j + 4)
        wp := (wj ^ wj4) & m32
        tt1 := (ff(a, b2, c2, j) + d2 + ss2 + wp) & m32
        tt2 := (gg(e, f, g, j) + h + ss1 + wj) & m32
        d2 = c2
        c2 = rotl(b2, 9)
        b2 = a
        a = tt1
        h = g
        g = rotl(f, 19)
        f = e
        e = p0(tt2)
        j = j + 1
    }
    d.st.h0 = (d.st.h0 ^ a) & m32
    d.st.h1 = (d.st.h1 ^ b2) & m32
    d.st.h2 = (d.st.h2 ^ c2) & m32
    d.st.h3 = (d.st.h3 ^ d2) & m32
    d.st.h4 = (d.st.h4 ^ e) & m32
    d.st.h5 = (d.st.h5 ^ f) & m32
    d.st.h6 = (d.st.h6 ^ g) & m32
    d.st.h7 = (d.st.h7 ^ h) & m32
}

fn hash_sm3(s &string) string {
    mut d := new()
    n := s.len
    mut off := 0
    while off + 64 <= n {
        d.compress_block(s, off)
        off += 64
    }
    tail := pad_tail(s, off, n)
    mut po := 0
    while po + 64 <= tail.len {
        d.compress_block(&tail, po)
        po += 64
    }
    << raw_state(&d.st)
}

pub fn sum_bytes(s string) string {
    << hash_sm3(&s)
}

pub fn sum(s string) string {
    << hex.encode_to_string(hash_sm3(&s))
}

pub fn (d &mut Digest) write(p &string) int {
    n := p.len
    if n == 0 {
        << 0
    }
    mut i := 0
    if d.buf.len > 0 {
        need := 64 - d.buf.len
        mut take := n
        if take > need {
            take = need
        }
        mut piece := []int{}
        mut bi := 0
        while bi < d.buf.len {
            piece.push(d.buf[bi] & 255)
            bi = bi + 1
        }
        mut k := 0
        while k < take {
            piece.push(p[k] & 255)
            k = k + 1
        }
        i = take
        if piece.len == 64 {
            block := string_from_bytes(piece)
            d.compress_block(&block, 0)
            d.buf = ""
        } else {
            d.buf = string_from_bytes(piece)
        }
    }
    while i + 64 <= n {
        d.compress_block(p, i)
        i += 64
    }
    if i < n {
        mut rest := []int{}
        mut k := i
        while k < n {
            rest.push(p[k] & 255)
            k = k + 1
        }
        extra := string_from_bytes(rest)
        r := mut &d.buf
        r.push_str(extra)
    }
    d.n = d.n + n
    << n
}

pub fn (d &mut Digest) reset() {
    d.st = iv()
    d.buf = ""
    d.n = 0
}

pub fn (d Digest) size() int {
    << 32
}

pub fn (d Digest) blocksize() int {
    << 64
}

pub fn (d &Digest) sum_bytes() string {
    mut tmp := new()
    tmp.st = State{h0: d.st.h0, h1: d.st.h1, h2: d.st.h2, h3: d.st.h3, h4: d.st.h4, h5: d.st.h5, h6: d.st.h6, h7: d.st.h7}
    buf := d.buf + ""
    tail := pad_tail(&buf, 0, d.n)
    mut po := 0
    while po + 64 <= tail.len {
        tmp.compress_block(&tail, po)
        po += 64
    }
    << raw_state(&tmp.st)
}

pub fn (d &Digest) sum() string {
    << hex.encode_to_string(d.sum_bytes())
}
