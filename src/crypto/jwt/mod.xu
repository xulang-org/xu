@crypto/jwt

#crypto/ecdsa
#crypto/sha256
#encoding/base64
#errors
#strconv

// Compact JWS (JWT) signing — ES256 only (APNs / provider tokens).
//
//     token := jwt.sign_es256(&p8_priv, &team_id, &key_id, iat)
//
// Header is `{"alg":"ES256","typ":"JWT","kid":"<key_id>"}`.
// Claims: `{"iss":"<team_id>","iat":<unix sec>}`.
// Signature is raw R||S (64 bytes) base64url, per RFC 7515 ES256.

fn b64url(s &string) string {
    tmp := s + ""
    << base64.encode_raw_url(tmp)
}

// sign_es256 builds a provider JWT. private_key is the 32-byte P-256 scalar.
pub fn sign_es256(private_key &string, team_id string, key_id string, iat_sec int) string {
    if private_key.len != ecdsa.private_key_size_p256 {
        >> errors.new("jwt: need P-256 private key")
    }
    if team_id.len == 0 || key_id.len == 0 {
        >> errors.new("jwt: iss and kid required")
    }
    // JSON strings: reject chars that would break the compact JSON we emit.
    if !json_safe(&team_id) || !json_safe(&key_id) {
        >> errors.new("jwt: iss/kid must be JSON-safe ASCII")
    }
    hdr := "{\"alg\":\"ES256\",\"typ\":\"JWT\",\"kid\":\"" + key_id + "\"}"
    iss := strconv.itoa(iat_sec)
    claims := "{\"iss\":\"" + team_id + "\",\"iat\":" + iss + "}"
    h64 := b64url(&hdr)
    p64 := b64url(&claims)
    signing := h64 + "." + p64
    dig := sha256.sum256_bytes(signing + "")
    sig := ecdsa.sign_raw_p256(private_key, &dig) or >>
    s64 := b64url(&sig)
    << signing + "." + s64
}

fn json_safe(s &string) bool {
    for i in 0:s.len {
        c := s[i] & 255
        if c < 32 || c > 126 {
            << false
        }
        if c == 34 || c == 92 {
            << false
        }
    }
    << true
}
