@crypto/jwt

// XU-CT-USE: fixed-shape-only
// HS256 tag equality uses crypto/subtle; asymmetric JWS algorithms remain variable-time.

#crypto/ecdsa
#crypto/ed25519
#crypto/hmac
#crypto/rsa
#crypto/sha256
#crypto/subtle
#encoding/base64
#errors
#strconv
#strings

// Compact JWS (JWT, RFC 7515 / RFC 7519) signing and verification:
//   - HS256 (HMAC-SHA256)
//   - ES256 (ECDSA P-256 SHA-256, raw 64-byte R||S)
//   - RS256 (RSA PKCS#1 v1.5 SHA-256)
//   - EdDSA (Ed25519)
// Explicit algorithm verification prevents `alg: "none"` or algorithm confusion.

fn b64url(s &string) string {
    tmp := s + ""
    << base64.encode_raw_url(tmp)
}

fn b64url_dec(s string) string {
    << base64.decode_raw_url(s) or >>
}

fn json_safe(s &string) bool {
    for i in 0:s.len {
        c := s[i] & 255
        if c < 32 || c > 126 {
            << false
        }
        if c == 34 || c == 92 {
            << false
        }
    }
    << true
}

fn make_header(alg string, key_id string) string {
    if !json_safe(&alg) || !json_safe(&key_id) {
        >> errors.new("jwt: header fields must be JSON-safe ASCII")
    }
    if key_id.len == 0 {
        << "{\"alg\":\"" + alg + "\",\"typ\":\"JWT\"}"
    }
    << "{\"alg\":\"" + alg + "\",\"typ\":\"JWT\",\"kid\":\"" + key_id + "\"}"
}

struct JwtParts {
    header_json string
    claims_json string
    signing_input string
    signature string
}

fn split_jwt(token string) JwtParts {
    mut d1 := -1
    mut d2 := -1
    mut i := 0
    while i < token.len {
        if (token[i] & 255) == 46 {
            if d1 < 0 {
                d1 = i
            } else if d2 < 0 {
                d2 = i
            } else {
                >> errors.new("jwt: malformed compact token")
            }
        }
        i = i + 1
    }
    if d1 <= 0 || d2 <= d1 + 1 || d2 + 1 >= token.len {
        >> errors.new("jwt: malformed compact token")
    }
    h64 := token[0:d1] + ""
    p64 := token[(d1 + 1):d2] + ""
    s64 := token[(d2 + 1):token.len] + ""
    hdr := b64url_dec(h64) or >>
    claims := b64url_dec(p64) or >>
    sig := b64url_dec(s64) or >>
    signing := token[0:d2] + ""
    << JwtParts{header_json: hdr, claims_json: claims, signing_input: signing, signature: sig}
}

fn check_header_alg(header_json &string, want_alg string) int {
    if strings.contains(header_json, "\"alg\":\"none\"") || strings.contains(header_json, "\"alg\": \"none\"") {
        >> errors.new("jwt: unsecured alg none rejected")
    }
    want1 := "\"alg\":\"" + want_alg + "\""
    want2 := "\"alg\": \"" + want_alg + "\""
    if !strings.contains(header_json, want1) && !strings.contains(header_json, want2) {
        >> errors.new("jwt: unexpected algorithm in header")
    }
    << 0
}

// sign_es256 builds an APNs provider JWT. private_key is the 32-byte P-256 scalar.
pub fn sign_es256(private_key &string, team_id string, key_id string, iat_sec int) string {
    if private_key.len != ecdsa.private_key_size_p256 {
        >> errors.new("jwt: need P-256 private key")
    }
    if team_id.len == 0 || key_id.len == 0 {
        >> errors.new("jwt: iss and kid required")
    }
    if !json_safe(&team_id) || !json_safe(&key_id) {
        >> errors.new("jwt: iss/kid must be JSON-safe ASCII")
    }
    iss := strconv.itoa(iat_sec)
    claims := "{\"iss\":\"" + team_id + "\",\"iat\":" + iss + "}"
    << sign_es256_claims(private_key, key_id, claims)
}

pub fn sign_es256_claims(private_key &string, key_id string, claims_json string) string {
    if private_key.len != ecdsa.private_key_size_p256 {
        >> errors.new("jwt: need P-256 private key")
    }
    hdr := make_header("ES256", key_id) or >>
    h64 := b64url(&hdr)
    p64 := b64url(&claims_json)
    signing := h64 + "." + p64
    dig := sha256.sum256_bytes(signing + "")
    sig := ecdsa.sign_raw_p256(private_key, &dig) or >>
    s64 := b64url(&sig)
    << signing + "." + s64
}

pub fn verify_es256(token string, public_key &string) string {
    if public_key.len != ecdsa.public_key_size_p256 {
        >> errors.new("jwt: need P-256 public key")
    }
    parts := split_jwt(token) or >>
    check_header_alg(&parts.header_json, "ES256") or >>
    dig := sha256.sum256_bytes(parts.signing_input + "")
    if !ecdsa.verify_raw_p256(public_key, &dig, &parts.signature) {
        >> errors.new("jwt: invalid ES256 signature")
    }
    << parts.claims_json
}

pub fn sign_hs256(secret &string, claims_json string) string {
    if secret.len == 0 {
        >> errors.new("jwt: empty HMAC secret")
    }
    hdr := make_header("HS256", "") or >>
    h64 := b64url(&hdr)
    p64 := b64url(&claims_json)
    signing := h64 + "." + p64
    mac := hmac.sum256_bytes(secret, &signing)
    s64 := b64url(&mac)
    << signing + "." + s64
}

pub fn verify_hs256(token string, secret &string) string {
    if secret.len == 0 {
        >> errors.new("jwt: empty HMAC secret")
    }
    parts := split_jwt(token) or >>
    check_header_alg(&parts.header_json, "HS256") or >>
    want := hmac.sum256_bytes(secret, &parts.signing_input)
    if subtle.constant_time_compare(&parts.signature, &want) != 1 {
        >> errors.new("jwt: invalid HS256 signature")
    }
    << parts.claims_json
}

pub fn sign_rs256(private_key &rsa.PrivateKey, key_id string, claims_json string) string {
    hdr := make_header("RS256", key_id) or >>
    h64 := b64url(&hdr)
    p64 := b64url(&claims_json)
    signing := h64 + "." + p64
    dig := sha256.sum256_bytes(signing + "")
    sig := rsa.sign_pkcs1v15(private_key, rsa.sha256, &dig) or >>
    s64 := b64url(&sig)
    << signing + "." + s64
}

pub fn verify_rs256(token string, public_key &rsa.PublicKey) string {
    parts := split_jwt(token) or >>
    check_header_alg(&parts.header_json, "RS256") or >>
    dig := sha256.sum256_bytes(parts.signing_input + "")
    rsa.verify_pkcs1v15(public_key, rsa.sha256, &dig, &parts.signature) or >>
    << parts.claims_json
}

pub fn sign_eddsa(private_key &string, key_id string, claims_json string) string {
    if private_key.len != ed25519.private_key_size {
        >> errors.new("jwt: need Ed25519 private key")
    }
    hdr := make_header("EdDSA", key_id) or >>
    h64 := b64url(&hdr)
    p64 := b64url(&claims_json)
    signing := h64 + "." + p64
    sig := ed25519.sign(private_key, &signing) or >>
    s64 := b64url(&sig)
    << signing + "." + s64
}

pub fn verify_eddsa(token string, public_key &string) string {
    if public_key.len != ed25519.public_key_size {
        >> errors.new("jwt: need Ed25519 public key")
    }
    parts := split_jwt(token) or >>
    check_header_alg(&parts.header_json, "EdDSA") or >>
    if !ed25519.verify(public_key, &parts.signing_input, &parts.signature) {
        >> errors.new("jwt: invalid EdDSA signature")
    }
    << parts.claims_json
}
