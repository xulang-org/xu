@crypto/aes


#errors
// AES (FIPS-197) aligned with Go `crypto/aes` NewCipher + Block.
// Optimized 32-bit Te/Td lookup tables with scalar state registers and in-place buffer APIs.
// Pure i64 with masked words/bytes. Not constant-time.
// XU-CT-CLASS: variable-time

// block_size is the AES block size in bytes (16 bytes, 128 bits).
pub const BLOCK_SIZE = 16
const M32 = 4294967295

// Cipher represents an instantiated AES cipher with expanded key schedule.
// Supports AES-128 (10 rounds), AES-192 (12 rounds), and AES-256 (14 rounds).
// Hardware acceleration (AES-NI / ARMv8 Crypto) is indicated by hw_accel.
pub struct Cipher {
    pub nr int
    pub rk []int
    pub sbox []int
    pub inv []int
    pub te []int
    pub td []int
    pub erk []int
    pub drk []int
    pub hw_accel bool
    pub rk_bytes string
    pub drk_bytes string
}

fn aes_hw_supported() bool {
    << false
}

fn aes_hw_block_enc(out &string, src &string, rk &string, nr int) {
}

fn aes_hw_block_dec(out &string, src &string, drk &string, nr int) {
}

fn aes_hw_drk(drk &string, rk &string, nr int) bool {
    << false
}

fn make_sbox() []int {
    // Compact byte encoding avoids a 256-word literal in bare-metal SRAM.
    encoded := ""
    $sbox := make_ints(256)
    for i in 0:256 {
        $high := encoded[i * 2] - 48
        $low := encoded[i * 2 + 1] - 48
        if high > 9 { high -= 39 }
        if low > 9 { low -= 39 }
        sbox[i] = (high << 4) | low
    }
    << sbox
}

fn make_inv() []int {
    sbox := make_sbox()
    $inverse := make_ints(256)
    for i in 0:256 { inverse[sbox[i]] = i }
    << inverse
}

fn xtime(a int) int {
    x := a & 255
    $r := (x << 1) & 255
    if (x & 128) != 0 {
        r = r ^ 27
    }
    << r
}

fn rotl8(x int, n int) int {
    << (((x << n) | (x >> (8 - n))) & 255)
}

fn rcon(n int) int {
    if n == 1 { << 1 }
    if n == 2 { << 2 }
    if n == 3 { << 4 }
    if n == 4 { << 8 }
    if n == 5 { << 16 }
    if n == 6 { << 32 }
    if n == 7 { << 64 }
    if n == 8 { << 128 }
    if n == 9 { << 27 }
    if n == 10 { << 54 }
    << 0
}

fn expand_key(key &string, sbox &[]int) []int {
    nk := key.len / 4
    if nk <= 0 {
        << []int{}
    }
    $nr := 10
    if nk == 6 {
        nr = 12
    }
    if nk == 8 {
        nr = 14
    }
    total_ints := (nr + 1) * 16
    $w := make_ints(total_ints)
    for i in 0:key.len {
        w[i] = key[i] & 255
    }
    $i := nk
    total := 4 * (nr + 1)
    while i < total {
        prev := (i - 1) * 4
        $t0 := w[prev]
        $t1 := w[prev + 1]
        $t2 := w[prev + 2]
        $t3 := w[prev + 3]
        $rot := false
        $sub := false
        $rc := 0
        if nk == 4 {
            if (i & 3) == 0 {
                rot = true
                rc = i >> 2
            }
        } else if nk == 6 {
            if i % 6 == 0 {
                rot = true
                rc = i / 6
            }
        } else {
            if (i & 7) == 0 {
                rot = true
                rc = i >> 3
            } else if (i & 7) == 4 {
                sub = true
            }
        }
        if rot {
            tmp := t0
            t0 = (sbox[t1] ^ rcon(rc)) & 255
            t1 = sbox[t2] & 255
            t2 = sbox[t3] & 255
            t3 = sbox[tmp] & 255
        } else {
            if sub {
                t0 = sbox[t0] & 255
                t1 = sbox[t1] & 255
                t2 = sbox[t2] & 255
                t3 = sbox[t3] & 255
            }
        }
        base := (i - nk) * 4
        b0 := w[base]
        b1 := w[base + 1]
        b2 := w[base + 2]
        b3 := w[base + 3]
        cur := i * 4
        w[cur] = (b0 ^ t0) & 255
        w[cur + 1] = (b1 ^ t1) & 255
        w[cur + 2] = (b2 ^ t2) & 255
        w[cur + 3] = (b3 ^ t3) & 255
        i = i + 1
    }
    << w
}

fn shift_rows(s $&[]int) {
    t := s[1]
    s[1] = s[5]
    s[5] = s[9]
    s[9] = s[13]
    s[13] = t
    t0 := s[2]
    t1 := s[6]
    s[2] = s[10]
    s[6] = s[14]
    s[10] = t0
    s[14] = t1
    t3 := s[15]
    s[15] = s[11]
    s[11] = s[7]
    s[7] = s[3]
    s[3] = t3
}

fn inv_shift_rows(s $&[]int) {
    t := s[13]
    s[13] = s[9]
    s[9] = s[5]
    s[5] = s[1]
    s[1] = t
    t0 := s[2]
    t1 := s[6]
    s[2] = s[10]
    s[6] = s[14]
    s[10] = t0
    s[14] = t1
    t3 := s[3]
    s[3] = s[7]
    s[7] = s[11]
    s[11] = s[15]
    s[15] = t3
}

fn load16(src &string) []int {
    $s := []int{}
    for i in 0:16 {
        s.push(src[i] & 255)
    }
    << s
}

fn inv_mc_word(w int) int {
    s0 := (w >> 24) & 255
    s1 := (w >> 16) & 255
    s2 := (w >> 8) & 255
    s3 := w & 255
    a2 := xtime(s0)
    a4 := xtime(a2)
    a8 := xtime(a4)
    b2 := xtime(s1)
    b4 := xtime(b2)
    b8 := xtime(b4)
    z2 := xtime(s2)
    z4 := xtime(z2)
    z8 := xtime(z4)
    d2 := xtime(s3)
    d4 := xtime(d2)
    d8 := xtime(d4)
    c0 := (a8 ^ a4 ^ a2 ^ b8 ^ b2 ^ s1 ^ z8 ^ z4 ^ s2 ^ d8 ^ s3) & 255
    c1 := (a8 ^ s0 ^ b8 ^ b4 ^ b2 ^ z8 ^ z2 ^ s2 ^ d8 ^ d4 ^ s3) & 255
    c2 := (a8 ^ a4 ^ s0 ^ b8 ^ s1 ^ z8 ^ z4 ^ z2 ^ d8 ^ d2 ^ s3) & 255
    c3 := (a8 ^ a2 ^ s0 ^ b8 ^ b4 ^ s1 ^ z8 ^ s2 ^ d8 ^ d4 ^ d2) & 255
    << (((c0 << 24) | (c1 << 16) | (c2 << 8) | c3)) & M32
}

fn build_te() []int {
    // Derive the four rotated encryption banks at runtime. Keeping their
    // 1024 words out of literal data leaves SRAM available on bare metal.
    sbox := make_sbox()
    $te := make_ints(1024)
    for i in 0:256 {
        s := sbox[i]
        s2 := xtime(s)
        s3 := s2 ^ s
        te[i] = ((s2 << 24) | (s << 16) | (s << 8) | s3) & M32
        te[256 + i] = ((s3 << 24) | (s2 << 16) | (s << 8) | s) & M32
        te[512 + i] = ((s << 24) | (s3 << 16) | (s2 << 8) | s) & M32
        te[768 + i] = ((s << 24) | (s << 16) | (s3 << 8) | s2) & M32
    }
    << te
}

fn build_td() []int {
    // Inverse MixColumns coefficients 14, 9, 13, 11 with inverse S-box,
    // followed by the same byte rotations as the encryption table banks.
    inv := make_inv()
    $td := make_ints(1024)
    for i in 0:256 {
        s := inv[i]
        s2 := xtime(s)
        s4 := xtime(s2)
        s8 := xtime(s4)
        s9 := s8 ^ s
        s11 := s8 ^ s2 ^ s
        s13 := s8 ^ s4 ^ s
        s14 := s8 ^ s4 ^ s2
        td[i] = ((s14 << 24) | (s9 << 16) | (s13 << 8) | s11) & M32
        td[256 + i] = ((s11 << 24) | (s14 << 16) | (s9 << 8) | s13) & M32
        td[512 + i] = ((s13 << 24) | (s11 << 16) | (s14 << 8) | s9) & M32
        td[768 + i] = ((s9 << 24) | (s13 << 16) | (s11 << 8) | s14) & M32
    }
    << td
}

fn build_erk(rk &[]int) []int {
    $erk := []int{}
    $i := 0
    while i < rk.len {
        w := (((rk[i] & 255) << 24) | ((rk[i + 1] & 255) << 16) | ((rk[i + 2] & 255) << 8) | (rk[i + 3] & 255)) & M32
        erk.push(w)
        i = i + 4
    }
    << erk
}

fn build_drk(nr int, erk &[]int) []int {
    $drk := []int{}
    for j in 0:erk.len {
        drk.push(0)
    }
    drk[0] = erk[nr * 4 + 0]
    drk[1] = erk[nr * 4 + 1]
    drk[2] = erk[nr * 4 + 2]
    drk[3] = erk[nr * 4 + 3]
    $r := 1
    while r < nr {
        $j := 0
        while j < 4 {
            w := erk[(nr - r) * 4 + j]
            drk[r * 4 + j] = inv_mc_word(w)
            j = j + 1
        }
        r = r + 1
    }
    drk[nr * 4 + 0] = erk[0]
    drk[nr * 4 + 1] = erk[1]
    drk[nr * 4 + 2] = erk[2]
    drk[nr * 4 + 3] = erk[3]
    << drk
}

// new_cipher creates and returns a new Cipher instance from the given key.
// The key argument must be 16 bytes (AES-128), 24 bytes (AES-192), or 32 bytes (AES-256).
// Throws an error if the key length is not 16, 24, or 32 bytes.
pub fn new_cipher(key &string) Cipher {
    n := key.len
    if n != 16 && n != 24 && n != 32 {
        >> errors.new("crypto/aes: invalid key size")
    }
    sbox := make_sbox()
    $nr := 10
    if n == 24 {
        nr = 12
    }
    if n == 32 {
        nr = 14
    }
    rk := expand_key(key, &sbox)
    // The compiler lowers this capability probe to the target-specific AES
    // feature check. Keep that decision so AES-NI/ARMv8 Crypto can be used;
    // the portable tables are still initialized because they are part of the
    // public Cipher shape and remain available for fallback operations.
    hw := aes_hw_supported()
    $inv := []int{}
    $rk_bytes := ""
    $drk_bytes := ""
    $te := []int{}
    $td := []int{}
    $erk := []int{}
    $drk := []int{}
    if hw {
        inv = make_inv()
        $rb := make_string((nr + 1) * 16)
        for i in 0:((nr + 1) * 16) {
            rb[i] = rk[i] & 255
        }
        rk_bytes = rb

        $db := make_string((nr + 1) * 16)
        if !aes_hw_drk(&db, &rk_bytes, nr) {
            for k in 0:16 {
                db[k] = rk[nr * 16 + k] & 255
            }
            for r in 1:nr {
                for j in 0:4 {
                    base := (nr - r) * 16 + j * 4
                    w := (((rk[base] & 255) << 24) | ((rk[base + 1] & 255) << 16) | ((rk[base + 2] & 255) << 8) | (rk[base + 3] & 255)) & M32
                    w_inv := inv_mc_word(w)
                    idx := r * 16 + j * 4
                    db[idx + 0] = (w_inv >> 24) & 255
                    db[idx + 1] = (w_inv >> 16) & 255
                    db[idx + 2] = (w_inv >> 8) & 255
                    db[idx + 3] = w_inv & 255
                }
            }
            for k in 0:16 {
                db[nr * 16 + k] = rk[k] & 255
            }
        }
        drk_bytes = db
    } else {
        inv = make_inv()
        te = build_te()
        td = build_td()
        erk = build_erk(&rk)
        drk = build_drk(nr, &erk)
    }
    << Cipher{nr: nr, rk: rk, sbox: sbox, inv: inv, te: te, td: td, erk: erk, drk: drk, hw_accel: hw, rk_bytes: rk_bytes, drk_bytes: drk_bytes}
}

// block_size returns the cipher's block size in bytes (always 16).
pub fn (c &Cipher) block_size() int {
    << BLOCK_SIZE
}

// encrypt encrypts a single 16-byte block from src and returns the 16-byte ciphertext string.
// Throws an error if src.len != 16. For multi-block or streaming encryption, use crypto/cipher.
pub fn (c &Cipher) encrypt(src &string) string {
    if src.len != 16 {
        >> errors.new("crypto/aes: invalid block size")
    }
    if c.hw_accel {
        $out := make_string(16)
        aes_hw_block_enc(&out, src, &c.rk_bytes, c.nr)
        << out
    }
    w0 := (((src[0] & 255) << 24) | ((src[1] & 255) << 16) | ((src[2] & 255) << 8) | (src[3] & 255)) & M32
    w1 := (((src[4] & 255) << 24) | ((src[5] & 255) << 16) | ((src[6] & 255) << 8) | (src[7] & 255)) & M32
    w2 := (((src[8] & 255) << 24) | ((src[9] & 255) << 16) | ((src[10] & 255) << 8) | (src[11] & 255)) & M32
    w3 := (((src[12] & 255) << 24) | ((src[13] & 255) << 16) | ((src[14] & 255) << 8) | (src[15] & 255)) & M32

    $s0 := w0 ^ c.erk[0]
    $s1 := w1 ^ c.erk[1]
    $s2 := w2 ^ c.erk[2]
    $s3 := w3 ^ c.erk[3]

    $r := 1
    while r < c.nr {
        off := r * 4
        t0 := c.te[(s0 >> 24) & 255] ^ c.te[256 + ((s1 >> 16) & 255)] ^ c.te[512 + ((s2 >> 8) & 255)] ^ c.te[768 + (s3 & 255)] ^ c.erk[off]
        t1 := c.te[(s1 >> 24) & 255] ^ c.te[256 + ((s2 >> 16) & 255)] ^ c.te[512 + ((s3 >> 8) & 255)] ^ c.te[768 + (s0 & 255)] ^ c.erk[off + 1]
        t2 := c.te[(s2 >> 24) & 255] ^ c.te[256 + ((s3 >> 16) & 255)] ^ c.te[512 + ((s0 >> 8) & 255)] ^ c.te[768 + (s1 & 255)] ^ c.erk[off + 2]
        t3 := c.te[(s3 >> 24) & 255] ^ c.te[256 + ((s0 >> 16) & 255)] ^ c.te[512 + ((s1 >> 8) & 255)] ^ c.te[768 + (s2 & 255)] ^ c.erk[off + 3]
        s0 = t0
        s1 = t1
        s2 = t2
        s3 = t3
        r = r + 1
    }

    last := c.nr * 16
    $out := make_string(16)
    out[0] = (c.sbox[(s0 >> 24) & 255] ^ c.rk[last + 0]) & 255
    out[1] = (c.sbox[(s1 >> 16) & 255] ^ c.rk[last + 1]) & 255
    out[2] = (c.sbox[(s2 >> 8) & 255] ^ c.rk[last + 2]) & 255
    out[3] = (c.sbox[s3 & 255] ^ c.rk[last + 3]) & 255

    out[4] = (c.sbox[(s1 >> 24) & 255] ^ c.rk[last + 4]) & 255
    out[5] = (c.sbox[(s2 >> 16) & 255] ^ c.rk[last + 5]) & 255
    out[6] = (c.sbox[(s3 >> 8) & 255] ^ c.rk[last + 6]) & 255
    out[7] = (c.sbox[s0 & 255] ^ c.rk[last + 7]) & 255

    out[8] = (c.sbox[(s2 >> 24) & 255] ^ c.rk[last + 8]) & 255
    out[9] = (c.sbox[(s3 >> 16) & 255] ^ c.rk[last + 9]) & 255
    out[10] = (c.sbox[(s0 >> 8) & 255] ^ c.rk[last + 10]) & 255
    out[11] = (c.sbox[s1 & 255] ^ c.rk[last + 11]) & 255

    out[12] = (c.sbox[(s3 >> 24) & 255] ^ c.rk[last + 12]) & 255
    out[13] = (c.sbox[(s0 >> 16) & 255] ^ c.rk[last + 13]) & 255
    out[14] = (c.sbox[(s1 >> 8) & 255] ^ c.rk[last + 14]) & 255
    out[15] = (c.sbox[s2 & 255] ^ c.rk[last + 15]) & 255

    << out
}

// encrypt_block encrypts a single 16-byte block from src into dst in place.
// Throws an error if src.len != 16 or dst.len != 16.
pub fn (c &Cipher) encrypt_block(dst $&[]int, src &[]int) bool {
    if src.len != 16 || dst.len != 16 {
        >> errors.new("crypto/aes: invalid block size")
    }
    if c.hw_accel {
        $in_s := make_string(16)
        for i in 0:16 {
            in_s[i] = src[i] & 255
        }
        $out := make_string(16)
        aes_hw_block_enc(&out, &in_s, &c.rk_bytes, c.nr)
        for i in 0:16 {
            dst[i] = out[i] & 255
        }
        << true
    }
    w0 := (((src[0] & 255) << 24) | ((src[1] & 255) << 16) | ((src[2] & 255) << 8) | (src[3] & 255)) & M32
    w1 := (((src[4] & 255) << 24) | ((src[5] & 255) << 16) | ((src[6] & 255) << 8) | (src[7] & 255)) & M32
    w2 := (((src[8] & 255) << 24) | ((src[9] & 255) << 16) | ((src[10] & 255) << 8) | (src[11] & 255)) & M32
    w3 := (((src[12] & 255) << 24) | ((src[13] & 255) << 16) | ((src[14] & 255) << 8) | (src[15] & 255)) & M32

    $s0 := w0 ^ c.erk[0]
    $s1 := w1 ^ c.erk[1]
    $s2 := w2 ^ c.erk[2]
    $s3 := w3 ^ c.erk[3]

    $r := 1
    while r < c.nr {
        off := r * 4
        t0 := c.te[(s0 >> 24) & 255] ^ c.te[256 + ((s1 >> 16) & 255)] ^ c.te[512 + ((s2 >> 8) & 255)] ^ c.te[768 + (s3 & 255)] ^ c.erk[off]
        t1 := c.te[(s1 >> 24) & 255] ^ c.te[256 + ((s2 >> 16) & 255)] ^ c.te[512 + ((s3 >> 8) & 255)] ^ c.te[768 + (s0 & 255)] ^ c.erk[off + 1]
        t2 := c.te[(s2 >> 24) & 255] ^ c.te[256 + ((s3 >> 16) & 255)] ^ c.te[512 + ((s0 >> 8) & 255)] ^ c.te[768 + (s1 & 255)] ^ c.erk[off + 2]
        t3 := c.te[(s3 >> 24) & 255] ^ c.te[256 + ((s0 >> 16) & 255)] ^ c.te[512 + ((s1 >> 8) & 255)] ^ c.te[768 + (s2 & 255)] ^ c.erk[off + 3]
        s0 = t0
        s1 = t1
        s2 = t2
        s3 = t3
        r = r + 1
    }

    last := c.nr * 16
    dst[0] = (c.sbox[(s0 >> 24) & 255] ^ c.rk[last + 0]) & 255
    dst[1] = (c.sbox[(s1 >> 16) & 255] ^ c.rk[last + 1]) & 255
    dst[2] = (c.sbox[(s2 >> 8) & 255] ^ c.rk[last + 2]) & 255
    dst[3] = (c.sbox[s3 & 255] ^ c.rk[last + 3]) & 255

    dst[4] = (c.sbox[(s1 >> 24) & 255] ^ c.rk[last + 4]) & 255
    dst[5] = (c.sbox[(s2 >> 16) & 255] ^ c.rk[last + 5]) & 255
    dst[6] = (c.sbox[(s3 >> 8) & 255] ^ c.rk[last + 6]) & 255
    dst[7] = (c.sbox[s0 & 255] ^ c.rk[last + 7]) & 255

    dst[8] = (c.sbox[(s2 >> 24) & 255] ^ c.rk[last + 8]) & 255
    dst[9] = (c.sbox[(s3 >> 16) & 255] ^ c.rk[last + 9]) & 255
    dst[10] = (c.sbox[(s0 >> 8) & 255] ^ c.rk[last + 10]) & 255
    dst[11] = (c.sbox[s1 & 255] ^ c.rk[last + 11]) & 255

    dst[12] = (c.sbox[(s3 >> 24) & 255] ^ c.rk[last + 12]) & 255
    dst[13] = (c.sbox[(s0 >> 16) & 255] ^ c.rk[last + 13]) & 255
    dst[14] = (c.sbox[(s1 >> 8) & 255] ^ c.rk[last + 14]) & 255
    dst[15] = (c.sbox[s2 & 255] ^ c.rk[last + 15]) & 255
    << true
}

// decrypt decrypts a single 16-byte block from src and returns the 16-byte plaintext string.
// Throws an error if src.len != 16. For multi-block or streaming decryption, use crypto/cipher.
pub fn (c &Cipher) decrypt(src &string) string {
    if src.len != 16 {
        >> errors.new("crypto/aes: invalid block size")
    }
    if c.hw_accel {
        $out := make_string(16)
        aes_hw_block_dec(&out, src, &c.drk_bytes, c.nr)
        << out
    }
    w0 := (((src[0] & 255) << 24) | ((src[1] & 255) << 16) | ((src[2] & 255) << 8) | (src[3] & 255)) & M32
    w1 := (((src[4] & 255) << 24) | ((src[5] & 255) << 16) | ((src[6] & 255) << 8) | (src[7] & 255)) & M32
    w2 := (((src[8] & 255) << 24) | ((src[9] & 255) << 16) | ((src[10] & 255) << 8) | (src[11] & 255)) & M32
    w3 := (((src[12] & 255) << 24) | ((src[13] & 255) << 16) | ((src[14] & 255) << 8) | (src[15] & 255)) & M32

    $s0 := w0 ^ c.drk[0]
    $s1 := w1 ^ c.drk[1]
    $s2 := w2 ^ c.drk[2]
    $s3 := w3 ^ c.drk[3]

    $r := 1
    while r < c.nr {
        off := r * 4
        t0 := c.td[(s0 >> 24) & 255] ^ c.td[256 + ((s3 >> 16) & 255)] ^ c.td[512 + ((s2 >> 8) & 255)] ^ c.td[768 + (s1 & 255)] ^ c.drk[off]
        t1 := c.td[(s1 >> 24) & 255] ^ c.td[256 + ((s0 >> 16) & 255)] ^ c.td[512 + ((s3 >> 8) & 255)] ^ c.td[768 + (s2 & 255)] ^ c.drk[off + 1]
        t2 := c.td[(s2 >> 24) & 255] ^ c.td[256 + ((s1 >> 16) & 255)] ^ c.td[512 + ((s0 >> 8) & 255)] ^ c.td[768 + (s3 & 255)] ^ c.drk[off + 2]
        t3 := c.td[(s3 >> 24) & 255] ^ c.td[256 + ((s2 >> 16) & 255)] ^ c.td[512 + ((s1 >> 8) & 255)] ^ c.td[768 + (s0 & 255)] ^ c.drk[off + 3]
        s0 = t0
        s1 = t1
        s2 = t2
        s3 = t3
        r = r + 1
    }

    $out := make_string(16)
    out[0] = (c.inv[(s0 >> 24) & 255] ^ c.rk[0]) & 255
    out[1] = (c.inv[(s3 >> 16) & 255] ^ c.rk[1]) & 255
    out[2] = (c.inv[(s2 >> 8) & 255] ^ c.rk[2]) & 255
    out[3] = (c.inv[s1 & 255] ^ c.rk[3]) & 255

    out[4] = (c.inv[(s1 >> 24) & 255] ^ c.rk[4]) & 255
    out[5] = (c.inv[(s0 >> 16) & 255] ^ c.rk[5]) & 255
    out[6] = (c.inv[(s3 >> 8) & 255] ^ c.rk[6]) & 255
    out[7] = (c.inv[s2 & 255] ^ c.rk[7]) & 255

    out[8] = (c.inv[(s2 >> 24) & 255] ^ c.rk[8]) & 255
    out[9] = (c.inv[(s1 >> 16) & 255] ^ c.rk[9]) & 255
    out[10] = (c.inv[(s0 >> 8) & 255] ^ c.rk[10]) & 255
    out[11] = (c.inv[s3 & 255] ^ c.rk[11]) & 255

    out[12] = (c.inv[(s3 >> 24) & 255] ^ c.rk[12]) & 255
    out[13] = (c.inv[(s2 >> 16) & 255] ^ c.rk[13]) & 255
    out[14] = (c.inv[(s1 >> 8) & 255] ^ c.rk[14]) & 255
    out[15] = (c.inv[s0 & 255] ^ c.rk[15]) & 255

    << out
}

// decrypt_block decrypts a single 16-byte block from src into dst in place.
// Throws an error if src.len != 16 or dst.len != 16.
pub fn (c &Cipher) decrypt_block(dst $&[]int, src &[]int) bool {
    if src.len != 16 || dst.len != 16 {
        >> errors.new("crypto/aes: invalid block size")
    }
    if c.hw_accel {
        $in_s := make_string(16)
        for i in 0:16 {
            in_s[i] = src[i] & 255
        }
        $out := make_string(16)
        aes_hw_block_dec(&out, &in_s, &c.drk_bytes, c.nr)
        for i in 0:16 {
            dst[i] = out[i] & 255
        }
        << true
    }
    w0 := (((src[0] & 255) << 24) | ((src[1] & 255) << 16) | ((src[2] & 255) << 8) | (src[3] & 255)) & M32
    w1 := (((src[4] & 255) << 24) | ((src[5] & 255) << 16) | ((src[6] & 255) << 8) | (src[7] & 255)) & M32
    w2 := (((src[8] & 255) << 24) | ((src[9] & 255) << 16) | ((src[10] & 255) << 8) | (src[11] & 255)) & M32
    w3 := (((src[12] & 255) << 24) | ((src[13] & 255) << 16) | ((src[14] & 255) << 8) | (src[15] & 255)) & M32

    $s0 := w0 ^ c.drk[0]
    $s1 := w1 ^ c.drk[1]
    $s2 := w2 ^ c.drk[2]
    $s3 := w3 ^ c.drk[3]

    $r := 1
    while r < c.nr {
        off := r * 4
        t0 := c.td[(s0 >> 24) & 255] ^ c.td[256 + ((s3 >> 16) & 255)] ^ c.td[512 + ((s2 >> 8) & 255)] ^ c.td[768 + (s1 & 255)] ^ c.drk[off]
        t1 := c.td[(s1 >> 24) & 255] ^ c.td[256 + ((s0 >> 16) & 255)] ^ c.td[512 + ((s3 >> 8) & 255)] ^ c.td[768 + (s2 & 255)] ^ c.drk[off + 1]
        t2 := c.td[(s2 >> 24) & 255] ^ c.td[256 + ((s1 >> 16) & 255)] ^ c.td[512 + ((s0 >> 8) & 255)] ^ c.td[768 + (s3 & 255)] ^ c.drk[off + 2]
        t3 := c.td[(s3 >> 24) & 255] ^ c.td[256 + ((s2 >> 16) & 255)] ^ c.td[512 + ((s1 >> 8) & 255)] ^ c.td[768 + (s0 & 255)] ^ c.drk[off + 3]
        s0 = t0
        s1 = t1
        s2 = t2
        s3 = t3
        r = r + 1
    }

    dst[0] = (c.inv[(s0 >> 24) & 255] ^ c.rk[0]) & 255
    dst[1] = (c.inv[(s3 >> 16) & 255] ^ c.rk[1]) & 255
    dst[2] = (c.inv[(s2 >> 8) & 255] ^ c.rk[2]) & 255
    dst[3] = (c.inv[s1 & 255] ^ c.rk[3]) & 255

    dst[4] = (c.inv[(s1 >> 24) & 255] ^ c.rk[4]) & 255
    dst[5] = (c.inv[(s0 >> 16) & 255] ^ c.rk[5]) & 255
    dst[6] = (c.inv[(s3 >> 8) & 255] ^ c.rk[6]) & 255
    dst[7] = (c.inv[s2 & 255] ^ c.rk[7]) & 255

    dst[8] = (c.inv[(s2 >> 24) & 255] ^ c.rk[8]) & 255
    dst[9] = (c.inv[(s1 >> 16) & 255] ^ c.rk[9]) & 255
    dst[10] = (c.inv[(s0 >> 8) & 255] ^ c.rk[10]) & 255
    dst[11] = (c.inv[s3 & 255] ^ c.rk[11]) & 255

    dst[12] = (c.inv[(s3 >> 24) & 255] ^ c.rk[12]) & 255
    dst[13] = (c.inv[(s2 >> 16) & 255] ^ c.rk[13]) & 255
    dst[14] = (c.inv[(s1 >> 8) & 255] ^ c.rk[14]) & 255
    dst[15] = (c.inv[s0 & 255] ^ c.rk[15]) & 255
    << true
}
