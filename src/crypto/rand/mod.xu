@crypto/rand

#errors
#os

// Go `crypto/rand` 最小面。
// Unix 用 os.open("/dev/urandom")；Windows 仍走 sys_random_fill（BCrypt）。
// sys_random_fill 的 Unix 路径在本产品上抛 "system random source unavailable"。

fn read_sys(n int) string {
    << sys_random_fill(n) or >>
}

pub fn read(n int) string {
    if n <= 0 {
        << ""
    }
    if xu_target_os() == 2 {
        << read_sys(n) or >>
    }
    mut g := os.open("/dev/urandom") or (err) {
        << read_sys(n) or >>
    }
    s := g.read(n) or (err) {
        << read_sys(n) or >>
    }
    g.close() or (err) {
        << s
    }
    << s
}
