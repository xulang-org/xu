@crypto/rand

#errors
#os

// Go `crypto/rand` 最小面。
// 优先使用运行时 sys_random_fill（Unix 下复用缓存的 /dev/urandom fd 并循环读满，
// Windows 下调用 BCryptGenRandom）；若回退到 os.open("/dev/urandom")，同样循环读满
// n 字节，防止单次 read 短读导致返回截断随机数。

fn read_sys(n int) string {
    << sys_random_fill(n) or >>
}

fn read_urandom_full(n int) string {
    mut g := os.open("/dev/urandom") or (err) {
        >> errors.new("system random source unavailable")
    }
    mut out := ""
    while out.len < n {
        chunk := g.read(n - out.len) or (err) {
            g.close() or (cerr) { << "" }
            >> err
        }
        if chunk.len <= 0 {
            g.close() or (cerr) { << "" }
            >> errors.new("crypto/rand: short read from /dev/urandom")
        }
        out = out + chunk
    }
    g.close() or (err) {
        << out
    }
    << out
}

pub fn read(n int) string {
    if n <= 0 {
        << ""
    }
    if xu_target_os() == 2 {
        << read_sys(n) or >>
    }
    s := read_sys(n) or (err) {
        << read_urandom_full(n) or >>
    }
    << s
}
