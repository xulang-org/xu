@crypto/hkdf

#crypto/hmac
#crypto/sha256
#errors

// HKDF (RFC 5869): HMAC-based Extract-and-Expand Key Derivation Function
// using SHA-256. Aligned with Go `golang.org/x/crypto/hkdf`.
//
// Key derivation proceeds in two steps:
// 1. Extract: PRK = HMAC-Hash(salt, IKM) to extract a pseudorandom key.
// 2. Expand: OKM = HKDF-Expand(PRK, info, L) to expand to desired length.

const HASH_LEN = 32

fn zero_salt() string {
    $b := []int{}
    for i in 0:HASH_LEN {
        b.push(0)
    }
    << string_from_bytes(b)
}

// extract extracts a pseudorandom key PRK of 32 bytes from input key material.
// If salt is empty, a string of 32 zero bytes is used per RFC 5869 §2.2.
pub fn extract(secret &string, salt &string) string {
    $s := salt + ""
    if s.len == 0 {
        s = zero_salt()
    }
    sec := secret + ""
    << hmac.sum256_bytes(&s, &sec)
}

// expand expands a pseudorandom key (PRK) with optional context info to length bytes.
// Maximum length is 255 * 32 = 8160 bytes per RFC 5869 §2.3.
pub fn expand(prk &string, info &string, length int) string {
    if length <= 0 {
        << ""
    }
    if length > 255 * HASH_LEN {
        >> errors.new("crypto/hkdf: requested key length too large")
    }
    $out := ""
    $t := ""
    $counter := 1
    while out.len < length {
        $data := t + info + string_from_byte(counter)
        prk_str := prk + ""
        t = hmac.sum256_bytes(&prk_str, &data)
        need := length - out.len
        if need >= HASH_LEN {
            out = out + t
        } else {
            out = out + t[0:need]
        }
        counter += 1
    }
    << out
}

// key derives length bytes from secret, salt, and info in a single call.
pub fn key(secret &string, salt &string, info &string, length int) string {
    prk := extract(secret, salt)
    inf := info + ""
    << expand(&prk, &inf, length) or >>
}
