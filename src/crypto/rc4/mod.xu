@crypto/rc4


#errors
// RC4 stream cipher aligned with Go `crypto/rc4` NewCipher + XORKeyStream.
// Key 1..256 bytes. State is a 256-byte S-box plus i/j. XOR produces a
// new owning string (Go writes in place). Not constant-time; RC4 is
// cryptographically broken — this is for protocol interop only.

pub struct Cipher {
    pub s []int
    pub i int
    pub j int
}

pub fn new_cipher(key &string) Cipher {
    if key.len < 1 || key.len > 256 {
        >> errors.new("crypto/rc4: invalid key size")
    }
    raw := key + ""
    mut s := []int{}
    for i in 0:256 {
        s.push(i)
    }
    mut j := 0
    mut ki := 0
    for i in 0:256 {
        j = (j + s[i] + (raw[ki] & 255)) & 255
        t := s[i]
        s[i] = s[j]
        s[j] = t
        ki = ki + 1
        if ki == raw.len {
            ki = 0
        }
    }
    << Cipher{s: s, i: 0, j: 0}
}

pub fn (c &mut Cipher) xor_key_stream(src &string) string {
    data := src + ""
    mut out := []int{}
    mut i := c.i
    mut j := c.j
    for k in 0:data.len {
        i = (i + 1) & 255
        j = (j + c.s[i]) & 255
        t := c.s[i]
        c.s[i] = c.s[j]
        c.s[j] = t
        si := c.s[i]
        sj := c.s[j]
        out.push((data[k] & 255) ^ (c.s[(si + sj) & 255] & 255))
    }
    c.i = i
    c.j = j
    << string_from_bytes(out)
}
