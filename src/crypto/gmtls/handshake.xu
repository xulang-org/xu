@crypto/gmtls

#errors
#net
#encoding/pem
#crypto/rand
#crypto/sm2
#crypto/x509

const hs_ch = 1
const hs_sh = 2
const hs_cert = 11
const hs_ske = 12
const hs_certreq = 13
const hs_shd = 14
const hs_cv = 15
const hs_cke = 16
const hs_fin = 20

const named_curve = 3
const curve_sm2 = 41

fn decode_sm2_key(raw0 &string) string {
    raw := raw0 + ""
    if raw.len == 32 {
        << raw
    }
    if raw.len > 11 && (raw[0] & 255) == 45 {
        << sm2.parse_private_pem(&raw) or >>
    }
    << sm2.parse_private_key(&raw) or >>
}

fn decode_sm2_cert(raw0 &string) string {
    raw := raw0 + ""
    if raw.len == 0 {
        << ""
    }
    if raw.len > 11 && (raw[0] & 255) == 45 {
        blk := pem.decode(&raw)
        typ := blk.typ + ""
        der := blk.bytes + ""
        if typ != "CERTIFICATE" && typ != "X509 CERTIFICATE" {
            >> errors.new("crypto/gmtls: certificate PEM")
        }
        if der.len == 0 {
            >> errors.new("crypto/gmtls: certificate PEM")
        }
        << der
    }
    << raw
}

fn parse_hs(frag0 &string) int {
    frag := frag0 + ""
    if frag.len < 4 {
        >> errors.new("crypto/gmtls: short handshake")
    }
    ln := u24_at(&frag, 1) or >>
    if frag.len != 4 + ln {
        >> errors.new("crypto/gmtls: handshake length")
    }
    << frag[0] & 255
}

fn hs_body(frag0 &string) string {
    frag := frag0 + ""
    << slice_copy(&frag, 4, frag.len) or (err) {
        << ""
    }
}

fn make_random() string {
    << rand.read(32) or (err) {
        << ""
    }
}

fn make_client_hello(ver int, random &string, suite int, name &string) string {
    mut b := []int{}
    b.push((ver >> 8) & 255)
    b.push(ver & 255)
    push_s(mut &b, random)
    b.push(0)
    b.push(0)
    b.push(2)
    b.push((suite >> 8) & 255)
    b.push(suite & 255)
    b.push(1)
    b.push(0)
    host := name + ""
    if host.len > 0 {
        ext := sni_extension(&host)
        n := ext.len
        b.push((n >> 8) & 255)
        b.push(n & 255)
        push_s(mut &b, &ext)
    }
    body := string_from_bytes(b)
    << hs_wrap(hs_ch, &body)
}

fn sni_extension(host &string) string {
    h := host + ""
    n := h.len
    inner := 1 + 2 + n
    data := 2 + inner
    mut b := []int{}
    b.push(0)
    b.push(0)
    b.push((data >> 8) & 255)
    b.push(data & 255)
    b.push((inner >> 8) & 255)
    b.push(inner & 255)
    b.push(0)
    b.push((n >> 8) & 255)
    b.push(n & 255)
    push_s(mut &b, &h)
    << string_from_bytes(b)
}

fn parse_sni_list(p0 &string) string {
    p := p0 + ""
    if p.len < 5 {
        >> errors.new("crypto/gmtls: bad sni")
    }
    n := u16_at(&p, 0) or >>
    if 2 + n != p.len {
        >> errors.new("crypto/gmtls: bad sni")
    }
    if (p[2] & 255) != 0 {
        >> errors.new("crypto/gmtls: bad sni")
    }
    hn := u16_at(&p, 3) or >>
    if 5 + hn != p.len {
        >> errors.new("crypto/gmtls: bad sni")
    }
    << slice_copy(&p, 5, 5 + hn) or (err) {
        << ""
    }
}

fn parse_sni_from_exts(body0 &string, off0 int) string {
    body := body0 + ""
    mut off := off0
    if off + 2 > body.len {
        >> errors.new("crypto/gmtls: bad client hello")
    }
    elen := u16_at(&body, off) or >>
    off = off + 2
    end := off + elen
    if end > body.len {
        >> errors.new("crypto/gmtls: bad client hello")
    }
    mut sni := ""
    while off + 4 <= end {
        typ := u16_at(&body, off) or >>
        off = off + 2
        ln := u16_at(&body, off) or >>
        off = off + 2
        if off + ln > end {
            >> errors.new("crypto/gmtls: bad client hello")
        }
        payload := slice_copy(&body, off, off + ln) or >>
        off = off + ln
        if typ == 0 {
            sni = parse_sni_list(&payload) or >>
        }
    }
    << sni
}

fn parse_client_hello(body0 string, want_suite int) []string {
    body := body0 + ""
    if body.len < 2 + 32 + 1 + 2 + 1 {
        >> errors.new("crypto/gmtls: bad client hello")
    }
    cr := slice_copy(&body, 2, 34) or >>
    mut off := 34
    sid_len := body[off] & 255
    off = off + 1 + sid_len
    if off + 1 >= body.len {
        >> errors.new("crypto/gmtls: bad client hello")
    }
    cs_len := u16_at(&body, off) or >>
    off = off + 2
    end := off + cs_len
    if end > body.len {
        >> errors.new("crypto/gmtls: bad client hello")
    }
    mut found := 0
    mut i := off
    while i + 1 < end {
        id := u16_at(&body, i) or >>
        if id == want_suite {
            found = 1
        }
        i = i + 2
    }
    if found == 0 {
        >> errors.new("crypto/gmtls: cipher suite")
    }
    off = end
    if off >= body.len {
        >> errors.new("crypto/gmtls: bad client hello")
    }
    cm_len := body[off] & 255
    off = off + 1 + cm_len
    if off > body.len {
        >> errors.new("crypto/gmtls: bad client hello")
    }
    mut sni := ""
    if off < body.len {
        sni = parse_sni_from_exts(&body, off) or >>
    }
    mut out := []string{}
    out.push(cr)
    empty := ""
    if sni.len == 0 {
        out.push(empty + "")
    } else {
        out.push(sni)
    }
    << out
}

fn make_server_hello(ver int, random &string, suite int) string {
    mut b := []int{}
    b.push((ver >> 8) & 255)
    b.push(ver & 255)
    push_s(mut &b, random)
    b.push(0)
    b.push((suite >> 8) & 255)
    b.push(suite & 255)
    b.push(0)
    body := string_from_bytes(b)
    << hs_wrap(hs_sh, &body)
}

fn parse_server_hello(body0 string, want_suite int) string {
    body := body0 + ""
    if body.len < 2 + 32 + 1 + 2 + 1 {
        >> errors.new("crypto/gmtls: bad server hello")
    }
    sr := slice_copy(&body, 2, 34) or >>
    mut off := 34
    sid_len := body[off] & 255
    off = off + 1 + sid_len
    if off + 2 >= body.len {
        >> errors.new("crypto/gmtls: bad server hello")
    }
    suite := u16_at(&body, off) or >>
    if suite != want_suite {
        >> errors.new("crypto/gmtls: cipher suite")
    }
    << sr
}

fn make_certificate(sign_der &string, enc_der &string) string {
    n1 := sign_der.len
    n2 := enc_der.len
    inner := n1 + 3 + n2 + 3
    t0 := be24(inner)
    t1 := be24(n1)
    t2 := be24(n2)
    mut b := []int{}
    push_s(mut &b, &t0)
    push_s(mut &b, &t1)
    push_s(mut &b, sign_der)
    push_s(mut &b, &t2)
    push_s(mut &b, enc_der)
    body := string_from_bytes(b)
    << hs_wrap(hs_cert, &body)
}

fn parse_two_certs(body0 string) []string {
    body := body0 + ""
    if body.len < 3 {
        >> errors.new("crypto/gmtls: bad certificate")
    }
    total := u24_at(&body, 0) or >>
    if 3 + total != body.len {
        >> errors.new("crypto/gmtls: bad certificate")
    }
    mut off := 3
    mut out := []string{}
    while off < body.len {
        n := u24_at(&body, off) or >>
        off = off + 3
        c := slice_copy(&body, off, off + n) or >>
        out.push(c)
        off = off + n
    }
    if out.len < 2 {
        >> errors.new("crypto/gmtls: need two certificates")
    }
    << out
}

fn ske_tbs(cr &string, sr &string, enc_der &string) string {
    mut b := []int{}
    push_s(mut &b, cr)
    push_s(mut &b, sr)
    t := be24(enc_der.len)
    push_s(mut &b, &t)
    push_s(mut &b, enc_der)
    << string_from_bytes(b)
}

fn verify_ske_sig(pubk &string, tbs &string, sig &string) bool {
    mut ok := false
    if sig.len == 64 {
        ok = sm2.verify(pubk, tbs, sig)
        if !ok {
            empty := ""
            ok = sm2.verify_id(pubk, &empty, tbs, sig)
        }
        << ok
    }
    ok = sm2.verify_asn1(pubk, tbs, sig)
    if !ok {
        empty := ""
        ok = sm2.verify_id_asn1(pubk, &empty, tbs, sig)
    }
    << ok
}

fn make_ske(cr &string, sr &string, enc_der &string, sign_key &string) string {
    tbs := ske_tbs(cr, sr, enc_der)
    sig := sm2.sign_asn1(sign_key, &tbs) or >>
    n := sig.len
    mut b := []int{}
    b.push((n >> 8) & 255)
    b.push(n & 255)
    push_s(mut &b, &sig)
    body := string_from_bytes(b)
    << hs_wrap(hs_ske, &body)
}

fn parse_ske(body0 string, cr &string, sr &string, enc_der &string, sign_pub &string) int {
    body := body0 + ""
    if body.len < 2 {
        >> errors.new("crypto/gmtls: bad server key exchange")
    }
    n := u16_at(&body, 0) or >>
    sig := slice_copy(&body, 2, 2 + n) or >>
    tbs := ske_tbs(cr, sr, enc_der)
    if !verify_ske_sig(sign_pub, &tbs, &sig) {
        >> errors.new("crypto/gmtls: server key exchange verify")
    }
    << 0
}

fn make_shd() string {
    empty := ""
    << hs_wrap(hs_shd, &empty)
}

fn decrypt_cke(key &string, ct &string) string {
    if ct.len > 0 && (ct[0] & 255) == 4 {
        << sm2.decrypt(key, ct) or >>
    }
    << sm2.decrypt_asn1(key, ct)
}

fn make_cke(enc_pub &string, pms &string) string {
    ct := sm2.encrypt_asn1(enc_pub, pms) or >>
    n := ct.len
    mut b := []int{}
    b.push((n >> 8) & 255)
    b.push(n & 255)
    push_s(mut &b, &ct)
    body := string_from_bytes(b)
    << hs_wrap(hs_cke, &body)
}

fn parse_cke(body0 string, enc_key &string) string {
    body := body0 + ""
    if body.len < 2 {
        >> errors.new("crypto/gmtls: bad client key exchange")
    }
    n := u16_at(&body, 0) or >>
    ct := slice_copy(&body, 2, 2 + n) or >>
    << decrypt_cke(enc_key, &ct)
}

fn make_finished(ms &string, label &string, thash &string) string {
    vd := finished_vd(ms, label, thash)
    << hs_wrap(hs_fin, &vd)
}

fn parse_finished(body0 string, ms &string, label &string, thash &string) int {
    body := body0 + ""
    want := finished_vd(ms, label, thash)
    if body.len != want.len {
        >> errors.new("crypto/gmtls: finished")
    }
    mut x := 0
    mut i := 0
    while i < body.len {
        x = x | ((body[i] & 255) ^ (want[i] & 255))
        i = i + 1
    }
    if x != 0 {
        >> errors.new("crypto/gmtls: finished")
    }
    << 0
}

fn cert_pub(der &string) string {
    c := x509.parse_certificate(der + "") or >>
    if c.public_key_algorithm != x509.sm2 {
        >> errors.new("crypto/gmtls: certificate not SM2")
    }
    << c.public_key + ""
}

fn maybe_verify_cert(der &string, skip bool) int {
    if skip {
        << 0
    }
    mut c := x509.parse_certificate(der + "") or >>
    c.check_signature_from(&c) or >>
    << 0
}

fn host_matches(c &x509.Certificate, host &string) bool {
    h := host + ""
    mut i := 0
    while i < c.dns_names.len {
        if c.dns_names[i] == h {
            << true
        }
        i = i + 1
    }
    if c.subject.common_name.len > 0 {
        if c.subject.common_name == h {
            << true
        }
    }
    << false
}

fn verify_server_name(der &string, host0 &string, skip bool) int {
    if skip {
        << 0
    }
    host := host0 + ""
    if host.len == 0 {
        << 0
    }
    c := x509.parse_certificate(der + "") or >>
    if !host_matches(&c, &host) {
        >> errors.new("crypto/gmtls: server name")
    }
    << 0
}

fn verify_client_name(der &string, host0 &string, skip bool) int {
    if skip {
        << 0
    }
    host := host0 + ""
    if host.len == 0 {
        << 0
    }
    c := x509.parse_certificate(der + "") or >>
    if !host_matches(&c, &host) {
        >> errors.new("crypto/gmtls: client name")
    }
    << 0
}

fn make_pms(ver int) string {
    r := rand.read(46) or >>
    mut b := []int{}
    b.push((ver >> 8) & 255)
    b.push(ver & 255)
    push_s(mut &b, &r)
    << string_from_bytes(b)
}

fn sm2_ke_id() string {
    << "1234567812345678"
}

fn ecdhe_params(pt &string) string {
    n := pt.len
    mut b := []int{}
    b.push(named_curve)
    b.push((curve_sm2 >> 8) & 255)
    b.push(curve_sm2 & 255)
    b.push(n & 255)
    push_s(mut &b, pt)
    << string_from_bytes(b)
}

fn take_ecdhe_point(body0 string) []string {
    body := body0 + ""
    if body.len < 4 {
        >> errors.new("crypto/gmtls: bad ecdhe params")
    }
    if (body[0] & 255) != named_curve {
        >> errors.new("crypto/gmtls: curve type")
    }
    cid := u16_at(&body, 1) or >>
    if cid != curve_sm2 {
        >> errors.new("crypto/gmtls: curve")
    }
    n := body[3] & 255
    pt := slice_copy(&body, 4, 4 + n) or >>
    rest := slice_copy(&body, 4 + n, body.len) or >>
    mut out := []string{}
    out.push(pt)
    out.push(rest)
    << out
}

fn ske_tbs_ecdhe(cr &string, sr &string, params &string) string {
    mut b := []int{}
    push_s(mut &b, cr)
    push_s(mut &b, sr)
    push_s(mut &b, params)
    << string_from_bytes(b)
}

fn make_ske_ecdhe(cr &string, sr &string, pt &string, sign_key &string) string {
    params := ecdhe_params(pt)
    tbs := ske_tbs_ecdhe(cr, sr, &params)
    sig := sm2.sign_asn1(sign_key, &tbs) or >>
    n := sig.len
    mut b := []int{}
    push_s(mut &b, &params)
    b.push((n >> 8) & 255)
    b.push(n & 255)
    push_s(mut &b, &sig)
    body := string_from_bytes(b)
    << hs_wrap(hs_ske, &body)
}

fn parse_ske_ecdhe(body0 string, cr &string, sr &string, sign_pub &string) string {
    parts := take_ecdhe_point(body0) or >>
    pt := parts[0] + ""
    rest := parts[1] + ""
    if rest.len < 2 {
        >> errors.new("crypto/gmtls: bad server key exchange")
    }
    n := u16_at(&rest, 0) or >>
    sig := slice_copy(&rest, 2, 2 + n) or >>
    params := ecdhe_params(&pt)
    tbs := ske_tbs_ecdhe(cr, sr, &params)
    if !verify_ske_sig(sign_pub, &tbs, &sig) {
        >> errors.new("crypto/gmtls: server key exchange verify")
    }
    << pt
}

fn make_cke_ecdhe(pt &string) string {
    body := ecdhe_params(pt)
    << hs_wrap(hs_cke, &body)
}

fn parse_cke_ecdhe(body0 string) string {
    parts := take_ecdhe_point(body0) or >>
    pt := parts[0] + ""
    rest := parts[1] + ""
    if rest.len != 0 {
        >> errors.new("crypto/gmtls: bad client key exchange")
    }
    << pt
}

fn make_cert_req() string {
    mut b := []int{}
    b.push(1)
    b.push(64)
    b.push(0)
    b.push(0)
    body := string_from_bytes(b)
    << hs_wrap(hs_certreq, &body)
}

fn make_cert_verify(key &string, tbs &string) string {
    sig := sm2.sign_asn1(key, tbs) or >>
    n := sig.len
    mut b := []int{}
    b.push((n >> 8) & 255)
    b.push(n & 255)
    push_s(mut &b, &sig)
    body := string_from_bytes(b)
    << hs_wrap(hs_cv, &body)
}

fn parse_cert_verify(body0 string, pubk &string, tbs &string) int {
    body := body0 + ""
    if body.len < 2 {
        >> errors.new("crypto/gmtls: bad certificate verify")
    }
    n := u16_at(&body, 0) or >>
    sig := slice_copy(&body, 2, 2 + n) or >>
    if !verify_ske_sig(pubk, tbs, &sig) {
        >> errors.new("crypto/gmtls: certificate verify")
    }
    << 0
}

fn pms_initiator(enc_d &string, peer_enc_pub &string, ra_priv &string, rb_pub &string) string {
    ida := sm2_ke_id()
    idb := sm2_ke_id()
    mut ex := sm2.exch_new(enc_d, peer_enc_pub, &ida, &idb, 48, false) or >>
    _ := ex.init_r(ra_priv) or >>
    empty := ""
    cap := ex.confirm_responder(rb_pub, &empty) or >>
    << cap.key + ""
}

fn pms_responder(enc_d &string, peer_enc_pub &string, rb_priv &string, ra_pub &string) []string {
    ida := sm2_ke_id()
    idb := sm2_ke_id()
    mut ex := sm2.exch_new(enc_d, peer_enc_pub, &ida, &idb, 48, false) or >>
    cap := ex.respond_r(rb_priv, ra_pub) or >>
    pt := cap.point + ""
    empty := ""
    key := ex.confirm_initiator(&empty) or >>
    mut out := []string{}
    out.push(pt)
    out.push(key)
    << out
}

fn ccs_rec(ver int) string {
    one := string_from_byte(1)
    << rec_wrap(rec_ccs, ver, &one)
}

fn read_hs_frag(p net.PipeConn) string {
    raw := pipe_read(p) or >>
    typ := parse_rec(&raw) or >>
    if typ == rec_alert {
        >> errors.new("crypto/gmtls: alert")
    }
    if typ != rec_hs {
        >> errors.new("crypto/gmtls: expected handshake")
    }
    << rec_frag(&raw)
}

fn expect_ccs(raw0 string) int {
    raw := raw0 + ""
    typ := parse_rec(&raw) or >>
    if typ == rec_alert {
        >> errors.new("crypto/gmtls: alert")
    }
    if typ != rec_ccs {
        >> errors.new("crypto/gmtls: expected change cipher spec")
    }
    << 0
}
