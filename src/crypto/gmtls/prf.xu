@crypto/gmtls

#crypto/sm3

// TLS 1.2 P_hash with SM3 (GB/T 38636 key calculation). HMAC-SM3
// returns raw 32 bytes (crypto/hmac.sum_sm3 returns hex).

const HMAC_BLOCK = 64
const HMAC_IPAD = 54
const HMAC_OPAD = 92

fn hmac_pad(key &string, pad int) string {
    mut b := []int{}
    for i in 0:HMAC_BLOCK {
        mut k := 0
        if i < key.len {
            k = key[i] & 255
        }
        b.push(k ^ pad)
    }
    << string_from_bytes(b)
}

fn hmac_sm3_raw(key &string, data &string) string {
    mut k := key + ""
    if k.len > HMAC_BLOCK {
        k = sm3.sum_bytes(k + "")
    }
    ip := hmac_pad(&k, HMAC_IPAD)
    op := hmac_pad(&k, HMAC_OPAD)
    mut inner := sm3.new()
    inner.write(&ip)
    inner.write(data)
    raw := inner.sum_bytes()
    mut outer := sm3.new()
    outer.write(&op)
    outer.write(&raw)
    << outer.sum_bytes()
}

// data.len is public; n is the secret logical message length. Both hashing
// and memory reads have a shape determined by data.len, including bad padding.
fn hmac_sm3_prefix(key &string, data &string, n int) string {
    mut k := key + ""
    if k.len > HMAC_BLOCK {
        k = sm3.sum_bytes(k + "")
    }
    ip := hmac_pad(&k, HMAC_IPAD)
    op := hmac_pad(&k, HMAC_OPAD)
    input := ip + (data + "")
    raw := sm3.sum_prefix_bytes(&input, HMAC_BLOCK + n) or >>
    << sm3.sum_bytes(op + raw)
}

fn p_hash(secret &string, seed &string, n int) string {
    mut out := []int{}
    mut a := hmac_sm3_raw(secret, seed)
    while out.len < n {
        cat := a + (seed + "")
        blk := hmac_sm3_raw(secret, &cat)
        mut i := 0
        while i < blk.len {
            if out.len < n {
                out.push(blk[i] & 255)
            }
            i = i + 1
        }
        nxt := hmac_sm3_raw(secret, &a)
        a = nxt
    }
    << string_from_bytes(out)
}

fn prf(secret &string, label &string, seed &string, n int) string {
    s := (label + "") + (seed + "")
    << p_hash(secret, &s, n)
}

fn master_secret(pms &string, cr &string, sr &string) string {
    seed := (cr + "") + (sr + "")
    lab := "master secret"
    << prf(pms, &lab, &seed, 48)
}

fn key_block_n(ms &string, cr &string, sr &string, n int) string {
    seed := (sr + "") + (cr + "")
    lab := "key expansion"
    << prf(ms, &lab, &seed, n)
}

fn key_block(ms &string, cr &string, sr &string) string {
    << key_block_n(ms, cr, sr, 40)
}

fn finished_vd(ms &string, label &string, transcript_hash &string) string {
    << prf(ms, label, transcript_hash, 12)
}
