@crypto/gmtls

#errors
#net
#crypto/rand
#crypto/sm4

const rec_ccs = 20
const rec_alert = 21
const rec_hs = 22
const rec_app = 23

fn push_s(b &mut []int, s &string) {
    mut i := 0
    while i < s.len {
        b.push(s[i] & 255)
        i = i + 1
    }
}

fn be16(n int) string {
    mut b := []int{}
    b.push((n >> 8) & 255)
    b.push(n & 255)
    << string_from_bytes(b)
}

fn be24(n int) string {
    mut b := []int{}
    b.push((n >> 16) & 255)
    b.push((n >> 8) & 255)
    b.push(n & 255)
    << string_from_bytes(b)
}

fn be64(n int) string {
    mut b := []int{}
    mut i := 7
    while i >= 0 {
        b.push((n >> (8 * i)) & 255)
        i = i - 1
    }
    << string_from_bytes(b)
}

fn u16_at(s &string, off int) int {
    if off + 1 >= s.len {
        >> errors.new("crypto/gmtls: truncated")
    }
    << ((s[off] & 255) << 8) | (s[off + 1] & 255)
}

fn u24_at(s &string, off int) int {
    if off + 2 >= s.len {
        >> errors.new("crypto/gmtls: truncated")
    }
    << ((s[off] & 255) << 16) | ((s[off + 1] & 255) << 8) | (s[off + 2] & 255)
}

fn slice_copy(s &string, a int, b int) string {
    raw := s + ""
    if a < 0 || b < a || b > raw.len {
        >> errors.new("crypto/gmtls: truncated")
    }
    << raw[a:b] + ""
}

fn hs_wrap(typ int, body &string) string {
    n := body.len
    mut b := []int{}
    b.push(typ & 255)
    b.push((n >> 16) & 255)
    b.push((n >> 8) & 255)
    b.push(n & 255)
    push_s(mut &b, body)
    << string_from_bytes(b)
}

fn rec_wrap(typ int, ver int, frag &string) string {
    n := frag.len
    mut b := []int{}
    b.push(typ & 255)
    b.push((ver >> 8) & 255)
    b.push(ver & 255)
    b.push((n >> 8) & 255)
    b.push(n & 255)
    push_s(mut &b, frag)
    << string_from_bytes(b)
}

fn pipe_write(p net.PipeConn, rec string) int {
    << p.write(rec)
}

fn pipe_read(p net.PipeConn) string {
    << p.read()
}

fn parse_rec(raw0 &string) int {
    raw := raw0 + ""
    if raw.len < 5 {
        >> errors.new("crypto/gmtls: short record")
    }
    typ := raw[0] & 255
    ln := u16_at(&raw, 3) or >>
    if raw.len != 5 + ln {
        >> errors.new("crypto/gmtls: record length")
    }
    << typ
}

fn close_notify_body() string {
    mut b := []int{}
    b.push(1)
    b.push(0)
    << string_from_bytes(b)
}

fn alert_is_close(pt0 &string) bool {
    pt := pt0 + ""
    if pt.len != 2 {
        << false
    }
    << (pt[1] & 255) == 0
}

fn rec_frag(raw0 &string) string {
    raw := raw0 + ""
    << slice_copy(&raw, 5, raw.len) or (err) {
        << ""
    }
}

fn rec_ver(raw0 &string) int {
    raw := raw0 + ""
    << u16_at(&raw, 1) or (err) {
        << 0
    }
}

fn gcm_nonce(iv &string, seq int) string {
    e := be64(seq)
    << (iv + "") + e
}

fn gcm_aad(seq int, typ int, ver int, pt_len int) string {
    mut b := []int{}
    s := be64(seq)
    push_s(mut &b, &s)
    b.push(typ & 255)
    b.push((ver >> 8) & 255)
    b.push(ver & 255)
    b.push((pt_len >> 8) & 255)
    b.push(pt_len & 255)
    << string_from_bytes(b)
}

fn gcm_seal_rec(key &string, iv &string, seq int, typ int, ver int, pt &string) string {
    c := sm4.new_cipher(key) or >>
    nn := gcm_nonce(iv, seq)
    expl := be64(seq)
    aad := gcm_aad(seq, typ, ver, pt.len)
    sealed := sm4.seal_gcm(&c, &nn, pt, &aad) or >>
    frag := expl + sealed
    << rec_wrap(typ, ver, &frag)
}

fn gcm_open_rec(key &string, iv &string, seq int, raw0 string) string {
    raw := raw0 + ""
    typ := raw[0] & 255
    ver := rec_ver(&raw) or >>
    frag := rec_frag(&raw) or >>
    if frag.len < 8 + 16 {
        >> errors.new("crypto/gmtls: short gcm record")
    }
    expl := slice_copy(&frag, 0, 8) or >>
    sealed := slice_copy(&frag, 8, frag.len) or >>
    nn := (iv + "") + expl
    pt_len := sealed.len - 16
    aad := gcm_aad(seq, typ, ver, pt_len)
    c := sm4.new_cipher(key) or >>
    << sm4.open_gcm(&c, &nn, &sealed, &aad)
}

fn rec_mac(mac_key &string, seq int, typ int, ver int, content &string) string {
    mut b := []int{}
    s := be64(seq)
    push_s(mut &b, &s)
    b.push(typ & 255)
    b.push((ver >> 8) & 255)
    b.push(ver & 255)
    n := content.len
    b.push((n >> 8) & 255)
    b.push(n & 255)
    push_s(mut &b, content)
    data := string_from_bytes(b)
    << hmac_sm3_raw(mac_key, &data)
}

fn tls_pad(raw0 &string) string {
    n := raw0.len
    rem := (n + 1) % 16
    mut padn := 0
    if rem != 0 {
        padn = 16 - rem
    }
    mut b := []int{}
    push_s(mut &b, raw0)
    mut i := 0
    while i < padn {
        b.push(padn)
        i = i + 1
    }
    b.push(padn)
    << string_from_bytes(b)
}

fn tls_unpad(inner0 &string) string {
    raw := inner0 + ""
    if raw.len < 1 || (raw.len % 16) != 0 {
        >> errors.new("crypto/gmtls: bad cbc padding")
    }
    padn := raw[raw.len - 1] & 255
    if padn + 1 > raw.len {
        >> errors.new("crypto/gmtls: bad cbc padding")
    }
    start := raw.len - 1 - padn
    mut i := start
    while i < raw.len {
        if (raw[i] & 255) != padn {
            >> errors.new("crypto/gmtls: bad cbc padding")
        }
        i = i + 1
    }
    << slice_copy(&raw, 0, start) or (err) {
        << ""
    }
}

fn cbc_seal_rec(key &string, mac_key &string, seq int, typ int, ver int, pt &string) string {
    mac := rec_mac(mac_key, seq, typ, ver, pt)
    mut inner := []int{}
    push_s(mut &inner, pt)
    push_s(mut &inner, &mac)
    body := string_from_bytes(inner)
    padded := tls_pad(&body)
    iv := rand.read(16) or >>
    c := sm4.new_cipher(key) or >>
    ct := sm4.encrypt_cbc(&c, &iv, &padded) or >>
    frag := iv + ct
    << rec_wrap(typ, ver, &frag)
}

fn cbc_open_rec(key &string, mac_key &string, seq int, raw0 string) string {
    raw := raw0 + ""
    typ := raw[0] & 255
    ver := rec_ver(&raw) or >>
    frag := rec_frag(&raw) or >>
    if frag.len < 32 || (frag.len % 16) != 0 {
        >> errors.new("crypto/gmtls: short cbc record")
    }
    iv := slice_copy(&frag, 0, 16) or >>
    ct := slice_copy(&frag, 16, frag.len) or >>
    c := sm4.new_cipher(key) or >>
    dec := sm4.decrypt_cbc(&c, &iv, &ct) or >>
    body := tls_unpad(&dec) or >>
    if body.len < 32 {
        >> errors.new("crypto/gmtls: short cbc mac")
    }
    pt := slice_copy(&body, 0, body.len - 32) or >>
    got := slice_copy(&body, body.len - 32, body.len) or >>
    want := rec_mac(mac_key, seq, typ, ver, &pt)
    mut x := 0
    mut i := 0
    while i < 32 {
        x = x | ((got[i] & 255) ^ (want[i] & 255))
        i = i + 1
    }
    if x != 0 {
        >> errors.new("crypto/gmtls: cbc mac")
    }
    << pt
}

fn rec_seal(suite int, key &string, iv &string, mac &string, seq int, typ int, ver int, pt &string) string {
    if is_cbc(suite) {
        << cbc_seal_rec(key, mac, seq, typ, ver, pt)
    }
    << gcm_seal_rec(key, iv, seq, typ, ver, pt)
}

fn rec_open(suite int, key &string, iv &string, mac &string, seq int, raw0 string) string {
    if is_cbc(suite) {
        << cbc_open_rec(key, mac, seq, raw0)
    }
    << gcm_open_rec(key, iv, seq, raw0)
}
