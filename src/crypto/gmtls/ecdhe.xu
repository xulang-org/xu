@crypto/gmtls

#errors
#net
#crypto/sm2
#crypto/sm3

fn client_ecdhe(c net.PipeConn, cfg &Config, suite int) Conn {
    ver := VERSION_GMTLS11
    skip := cfg.insecure_skip_verify
    name := cfg.server_name + ""
    sign_der := decode_sm2_cert(&cfg.sign_cert) or >>
    enc_der := decode_sm2_cert(&cfg.enc_cert) or >>
    sign_key := decode_sm2_key(&cfg.sign_key) or >>
    enc_key := decode_sm2_key(&cfg.enc_key) or >>
    if sign_der.len == 0 || enc_der.len == 0 || sign_key.len != 32 || enc_key.len != 32 {
        >> errors.new("crypto/gmtls: ECDHE needs client dual SM2 certificates and keys")
    }

    cr := make_random() or >>
    ch := make_client_hello(ver, &cr, suite, &name)
    pipe_write(c, rec_wrap(REC_HS, ver, &ch) or >>) or >>
    mut hs := sm3.new()
    mut log := ""
    hs.write(&ch)
    log = log + (ch + "")

    shf := read_hs_frag(c) or >>
    sht := parse_hs(&shf) or >>
    if sht != HS_SH {
        >> errors.new("crypto/gmtls: expected server hello")
    }
    shb := hs_body(&shf) or >>
    sr := parse_server_hello(shb, suite) or >>
    hs.write(&shf)
    log = log + (shf + "")

    cf := read_hs_frag(c) or >>
    ct := parse_hs(&cf) or >>
    if ct != HS_CERT {
        >> errors.new("crypto/gmtls: expected certificate")
    }
    cb := hs_body(&cf) or >>
    certs := parse_two_certs(cb) or >>
    hs.write(&cf)
    log = log + (cf + "")
    srv_sign_der := certs[0] + ""
    srv_enc_der := certs[1] + ""
    maybe_verify_cert(&srv_sign_der, skip) or >>
    maybe_verify_cert(&srv_enc_der, skip) or >>
    verify_server_name(&srv_sign_der, &name, skip) or >>
    sign_pub := cert_pub(&srv_sign_der) or >>
    enc_pub := cert_pub(&srv_enc_der) or >>

    kf := read_hs_frag(c) or >>
    kt := parse_hs(&kf) or >>
    if kt != HS_SKE {
        >> errors.new("crypto/gmtls: expected server key exchange")
    }
    kbod := hs_body(&kf) or >>
    ra := parse_ske_ecdhe(kbod, &cr, &sr, &sign_pub) or >>
    hs.write(&kf)
    log = log + (kf + "")

    rf := read_hs_frag(c) or >>
    rt := parse_hs(&rf) or >>
    if rt != HS_CERTREQ {
        >> errors.new("crypto/gmtls: expected certificate request")
    }
    hs.write(&rf)
    log = log + (rf + "")

    df := read_hs_frag(c) or >>
    dt := parse_hs(&df) or >>
    if dt != HS_SHD {
        >> errors.new("crypto/gmtls: expected server hello done")
    }
    hs.write(&df)
    log = log + (df + "")

    cc := make_certificate(&sign_der, &enc_der)
    pipe_write(c, rec_wrap(REC_HS, ver, &cc) or >>) or >>
    hs.write(&cc)
    log = log + (cc + "")

    rb_priv := sm2.generate_key() or >>
    pair := pms_responder(&enc_key, &enc_pub, &rb_priv, &ra) or >>
    rb_pt := pair[0] + ""
    pms := pair[1] + ""
    cke := make_cke_ecdhe(&rb_pt)
    pipe_write(c, rec_wrap(REC_HS, ver, &cke) or >>) or >>
    hs.write(&cke)
    log = log + (cke + "")

    tbs := log + ""
    cv := make_cert_verify(&sign_key, &tbs) or >>
    pipe_write(c, rec_wrap(REC_HS, ver, &cv) or >>) or >>
    hs.write(&cv)

    ms := master_secret(&pms, &cr, &sr)
    keys := derive_keys(suite, &ms, &cr, &sr, true)
    wkey := keys[0] + ""
    rkey := keys[1] + ""
    wiv := keys[2] + ""
    riv := keys[3] + ""
    wmac := keys[4] + ""
    rmac := keys[5] + ""

    ccs := ccs_rec(ver)
    pipe_write(c, ccs) or >>

    th := hs.sum_bytes()
    clab := "client finished"
    fin := make_finished(&ms, &clab, &th)
    erec := rec_seal(suite, &wkey, &wiv, &wmac, 0, REC_HS, ver, &fin) or >>
    pipe_write(c, erec) or >>
    hs.write(&fin)

    sraw := pipe_read(c) or >>
    expect_ccs(sraw) or >>

    fraw := pipe_read(c) or >>
    fpt := rec_open(suite, &rkey, &riv, &rmac, 0, fraw) or >>
    ft := parse_hs(&fpt) or >>
    if ft != HS_FIN {
        >> errors.new("crypto/gmtls: expected finished")
    }
    fb := hs_body(&fpt) or >>
    th2 := hs.sum_bytes()
    slab := "server finished"
    parse_finished(fb, &ms, &slab, &th2) or >>

    << Conn{
        pipe: c,
        handshake_complete: true,
        cipher_suite: suite,
        server_name: name,
        peer_sign_cert: srv_sign_der,
        peer_enc_cert: srv_enc_der,
        ver: ver,
        wkey: wkey,
        rkey: rkey,
        wiv: wiv,
        riv: riv,
        wmac: wmac,
        rmac: rmac,
        wseq: 1,
        rseq: 1,
        sent_close: 0
    }
}

fn server_ecdhe(c net.PipeConn, cfg &Config, suite int) Conn {
    ver := VERSION_GMTLS11
    skip := cfg.insecure_skip_verify
    sign_der := decode_sm2_cert(&cfg.sign_cert) or >>
    enc_der := decode_sm2_cert(&cfg.enc_cert) or >>
    sign_key := decode_sm2_key(&cfg.sign_key) or >>
    enc_key := decode_sm2_key(&cfg.enc_key) or >>
    if sign_der.len == 0 || enc_der.len == 0 || sign_key.len != 32 || enc_key.len != 32 {
        >> errors.new("crypto/gmtls: server needs dual SM2 certificates and keys")
    }

    chf := read_hs_frag(c) or >>
    cht := parse_hs(&chf) or >>
    if cht != HS_CH {
        >> errors.new("crypto/gmtls: expected client hello")
    }
    chb := hs_body(&chf) or >>
    hello := parse_client_hello(chb, suite) or >>
    cr := hello[0] + ""
    sni := hello[1] + ""
    mut hs := sm3.new()
    mut log := ""
    hs.write(&chf)
    log = log + (chf + "")

    sr := make_random() or >>
    sh := make_server_hello(ver, &sr, suite)
    pipe_write(c, rec_wrap(REC_HS, ver, &sh) or >>) or >>
    hs.write(&sh)
    log = log + (sh + "")

    cert := make_certificate(&sign_der, &enc_der)
    pipe_write(c, rec_wrap(REC_HS, ver, &cert) or >>) or >>
    hs.write(&cert)
    log = log + (cert + "")

    ra_priv := sm2.generate_key() or >>
    ra_pt := sm2.public(&ra_priv) or >>
    ske := make_ske_ecdhe(&cr, &sr, &ra_pt, &sign_key) or >>
    pipe_write(c, rec_wrap(REC_HS, ver, &ske) or >>) or >>
    hs.write(&ske)
    log = log + (ske + "")

    req := make_cert_req()
    pipe_write(c, rec_wrap(REC_HS, ver, &req) or >>) or >>
    hs.write(&req)
    log = log + (req + "")

    shd := make_shd()
    pipe_write(c, rec_wrap(REC_HS, ver, &shd) or >>) or >>
    hs.write(&shd)
    log = log + (shd + "")

    cf := read_hs_frag(c) or >>
    ct := parse_hs(&cf) or >>
    if ct != HS_CERT {
        >> errors.new("crypto/gmtls: expected certificate")
    }
    cb := hs_body(&cf) or >>
    certs := parse_two_certs(cb) or >>
    hs.write(&cf)
    log = log + (cf + "")
    cli_sign_der := certs[0] + ""
    cli_enc_der := certs[1] + ""
    maybe_verify_cert(&cli_sign_der, skip) or >>
    maybe_verify_cert(&cli_enc_der, skip) or >>
    cname := cfg.client_name + ""
    verify_client_name(&cli_sign_der, &cname, skip) or >>
    cli_sign_pub := cert_pub(&cli_sign_der) or >>
    cli_enc_pub := cert_pub(&cli_enc_der) or >>

    ckf := read_hs_frag(c) or >>
    ckt := parse_hs(&ckf) or >>
    if ckt != HS_CKE {
        >> errors.new("crypto/gmtls: expected client key exchange")
    }
    ckb := hs_body(&ckf) or >>
    rb_pt := parse_cke_ecdhe(ckb) or >>
    hs.write(&ckf)
    log = log + (ckf + "")

    vf := read_hs_frag(c) or >>
    vt := parse_hs(&vf) or >>
    if vt != HS_CV {
        >> errors.new("crypto/gmtls: expected certificate verify")
    }
    vb := hs_body(&vf) or >>
    tbs := log + ""
    parse_cert_verify(vb, &cli_sign_pub, &tbs) or >>
    hs.write(&vf)

    pms := pms_initiator(&enc_key, &cli_enc_pub, &ra_priv, &rb_pt) or >>

    ms := master_secret(&pms, &cr, &sr)
    keys := derive_keys(suite, &ms, &cr, &sr, false)
    wkey := keys[0] + ""
    rkey := keys[1] + ""
    wiv := keys[2] + ""
    riv := keys[3] + ""
    wmac := keys[4] + ""
    rmac := keys[5] + ""

    craw := pipe_read(c) or >>
    expect_ccs(craw) or >>

    fraw := pipe_read(c) or >>
    fpt := rec_open(suite, &rkey, &riv, &rmac, 0, fraw) or >>
    ft := parse_hs(&fpt) or >>
    if ft != HS_FIN {
        >> errors.new("crypto/gmtls: expected finished")
    }
    fb := hs_body(&fpt) or >>
    th := hs.sum_bytes()
    clab := "client finished"
    parse_finished(fb, &ms, &clab, &th) or >>
    hs.write(&fpt)

    ccs := ccs_rec(ver)
    pipe_write(c, ccs) or >>
    th2 := hs.sum_bytes()
    slab := "server finished"
    fin := make_finished(&ms, &slab, &th2)
    erec := rec_seal(suite, &wkey, &wiv, &wmac, 0, REC_HS, ver, &fin) or >>
    pipe_write(c, erec) or >>

    << Conn{
        pipe: c,
        handshake_complete: true,
        cipher_suite: suite,
        server_name: sni,
        peer_sign_cert: cli_sign_der,
        peer_enc_cert: cli_enc_der,
        ver: ver,
        wkey: wkey,
        rkey: rkey,
        wiv: wiv,
        riv: riv,
        wmac: wmac,
        rmac: rmac,
        wseq: 1,
        rseq: 1,
        sent_close: 0
    }
}
