@crypto/sm9

#errors
#math/big

// BN256 tower Fp ⊂ Fp2 ⊂ Fp4 ⊂ Fp12 (GM/T 0044.5).
// Fp2 = Fp[u]/(u²+2), value x*u + y. Fp4 = Fp2[v]/(v²−u).
// Fp12 = Fp4[w]/(w³−v), value x w² + y w + z.

struct Fp2 {
    x big.Int
    y big.Int
}

struct Fp4 {
    x Fp2
    y Fp2
}

struct Fp12 {
    x Fp4
    y Fp4
    z Fp4
}

fn int_clone(x &big.Int) big.Int {
    mut z := big.new_int(0)
    z.set(x)
    << z
}

fn field_p() big.Int {
    mut z := big.new_int(0)
    z.set_string("b640000002a3a6f1d603ab4ff58ec74521f2934b1a7aeedbe56f9b27e351457d", 16) or >>
    << z
}

fn field_n() big.Int {
    mut z := big.new_int(0)
    z.set_string("b640000002a3a6f1d603ab4ff58ec74449f2934b18ea8beee56ee19cd69ecf25", 16) or >>
    << z
}

fn fe_mod(x &big.Int, p &big.Int) big.Int {
    mut z := big.new_int(0)
    z.mod(x, p) or >>
    << z
}

fn fe_add(a &big.Int, b &big.Int, p &big.Int) big.Int {
    mut z := big.new_int(0)
    z.add(a, b)
    << fe_mod(&z, p) or (err) {
        << big.new_int(0)
    }
}

fn fe_sub(a &big.Int, b &big.Int, p &big.Int) big.Int {
    mut z := big.new_int(0)
    z.sub(a, b)
    << fe_mod(&z, p) or (err) {
        << big.new_int(0)
    }
}

fn fe_mul(a &big.Int, b &big.Int, p &big.Int) big.Int {
    mut z := big.new_int(0)
    z.mul(a, b)
    << fe_mod(&z, p) or (err) { << big.new_int(0) }
}

fn fe_sq(a &big.Int, p &big.Int) big.Int {
    mut z := big.new_int(0)
    z.mul(a, a)
    << fe_mod(&z, p) or (err) { << big.new_int(0) }
}

fn fe_inv(a &big.Int, p &big.Int) big.Int {
    if p.abs.len == 0 {
        >> errors.new("crypto/sm9: empty modulus")
    }
    mut two := big.new_int(2)
    mut e := big.new_int(0)
    e.sub(p, &two)
    mut z := big.new_int(0)
    z.exp(a, &e, p) or >>
    << z
}

fn fe_neg(a &big.Int, p &big.Int) big.Int {
    mut z := big.new_int(0)
    z.sub(p, a)
    << fe_mod(&z, p) or (err) { << big.new_int(0) }
}

fn fe_k(a &big.Int, k int, p &big.Int) big.Int {
    mut kk := big.new_int(k)
    << fe_mul(a, &kk, p) or >>
}

fn hex_fp(s string) big.Int {
    mut z := big.new_int(0)
    z.set_string(s, 16) or >>
    << z
}

fn fp2_zero() Fp2 {
    << Fp2{x: big.new_int(0), y: big.new_int(0)}
}

fn fp2_one() Fp2 {
    << Fp2{x: big.new_int(0), y: big.new_int(1)}
}

fn fp2_clone(a &Fp2) Fp2 {
    mut x := int_clone(&a.x)
    mut y := int_clone(&a.y)
    << Fp2{x: x, y: y}
}

fn fp2_is0(a &Fp2) bool {
    mut x := int_clone(&a.x)
    mut y := int_clone(&a.y)
    sx := x.sign()
    sy := y.sign()
    << sx == 0 && sy == 0
}

fn fp2_is1(a &Fp2) bool {
    mut one := big.new_int(1)
    mut x := int_clone(&a.x)
    mut y := int_clone(&a.y)
    sx := x.sign()
    cy := y.cmp(&one)
    << sx == 0 && cy == 0
}

fn fp2_add(a &Fp2, b &Fp2) Fp2 {
    p := field_p() or >>
    ax := int_clone(&a.x)
    ay := int_clone(&a.y)
    bx := int_clone(&b.x)
    by := int_clone(&b.y)
    xn := fe_add(&ax, &bx, &p) or >>
    yn := fe_add(&ay, &by, &p) or >>
    << Fp2{x: xn, y: yn}
}

fn fp2_sub(a &Fp2, b &Fp2) Fp2 {
    p := field_p() or >>
    ax := int_clone(&a.x)
    ay := int_clone(&a.y)
    bx := int_clone(&b.x)
    by := int_clone(&b.y)
    xn := fe_sub(&ax, &bx, &p) or >>
    yn := fe_sub(&ay, &by, &p) or >>
    << Fp2{x: xn, y: yn}
}

fn fp2_neg(a &Fp2) Fp2 {
    p := field_p() or >>
    ax := int_clone(&a.x)
    ay := int_clone(&a.y)
    xn := fe_neg(&ax, &p) or >>
    yn := fe_neg(&ay, &p) or >>
    << Fp2{x: xn, y: yn}
}

fn fp2_dbl(a &Fp2) Fp2 {
    p := field_p() or >>
    ax := int_clone(&a.x)
    ay := int_clone(&a.y)
    xn := fe_add(&ax, &ax, &p) or >>
    yn := fe_add(&ay, &ay, &p) or >>
    << Fp2{x: xn, y: yn}
}

fn fp2_trp(a &Fp2) Fp2 {
    d := fp2_dbl(a) or >>
    << fp2_add(&d, a) or >>
}

fn fp2_mul(a &Fp2, b &Fp2) Fp2 {
    p := field_p() or >>
    ax := int_clone(&a.x)
    ay := int_clone(&a.y)
    bx := int_clone(&b.x)
    by := int_clone(&b.y)
    v0 := fe_mul(&ay, &by, &p) or >>
    v1 := fe_mul(&ax, &bx, &p) or >>
    t0 := fe_mul(&ax, &by, &p) or >>
    t1 := fe_mul(&ay, &bx, &p) or >>
    cx := fe_add(&t0, &t1, &p) or >>
    two_v1 := fe_add(&v1, &v1, &p) or >>
    cy := fe_sub(&v0, &two_v1, &p) or >>
    << Fp2{x: cx, y: cy}
}

fn fp2_mul_fp(a &Fp2, k &big.Int) Fp2 {
    p := field_p() or >>
    ax := int_clone(&a.x)
    ay := int_clone(&a.y)
    xn := fe_mul(&ax, k, &p) or >>
    yn := fe_mul(&ay, k, &p) or >>
    << Fp2{x: xn, y: yn}
}

fn fp2_sqr(a &Fp2) Fp2 {
    p := field_p() or >>
    ax := int_clone(&a.x)
    ay := int_clone(&a.y)
    xx := fe_sq(&ax, &p) or >>
    yy := fe_sq(&ay, &p) or >>
    two_xx := fe_add(&xx, &xx, &p) or >>
    cy := fe_sub(&yy, &two_xx, &p) or >>
    xy := fe_mul(&ax, &ay, &p) or >>
    cx := fe_add(&xy, &xy, &p) or >>
    << Fp2{x: cx, y: cy}
}

fn fp2_mul_u1(a &Fp2) Fp2 {
    p := field_p() or >>
    ax := int_clone(&a.x)
    ay := int_clone(&a.y)
    two_ax := fe_add(&ax, &ax, &p) or >>
    yn := fe_neg(&two_ax, &p) or >>
    << Fp2{x: ay, y: yn}
}

fn fp2_mul_u(a &Fp2, b &Fp2) Fp2 {
    ab := fp2_mul(a, b) or >>
    cx := int_clone(&ab.x)
    cy := int_clone(&ab.y)
    p := field_p() or >>
    two_cx := fe_add(&cx, &cx, &p) or >>
    yn := fe_neg(&two_cx, &p) or >>
    << Fp2{x: cy, y: yn}
}

fn fp2_sqr_u(a &Fp2) Fp2 {
    s := fp2_sqr(a) or >>
    cx := int_clone(&s.x)
    cy := int_clone(&s.y)
    p := field_p() or >>
    two_cx := fe_add(&cx, &cx, &p) or >>
    yn := fe_neg(&two_cx, &p) or >>
    << Fp2{x: cy, y: yn}
}

fn fp2_inv(a &Fp2) Fp2 {
    p := field_p() or >>
    ax := int_clone(&a.x)
    ay := int_clone(&a.y)
    xx := fe_sq(&ax, &p) or >>
    yy := fe_sq(&ay, &p) or >>
    two_xx := fe_add(&xx, &xx, &p) or >>
    t3 := fe_add(&two_xx, &yy, &p) or >>
    inv := fe_inv(&t3, &p) or >>
    nx := fe_neg(&ax, &p) or >>
    xn := fe_mul(&nx, &inv, &p) or >>
    yn := fe_mul(&ay, &inv, &p) or >>
    << Fp2{x: xn, y: yn}
}

fn fp2_conj(a &Fp2) Fp2 {
    p := field_p() or >>
    ax := int_clone(&a.x)
    ay := int_clone(&a.y)
    xn := fe_neg(&ax, &p) or >>
    << Fp2{x: xn, y: ay}
}

fn fp4_zero() Fp4 {
    << Fp4{x: fp2_zero(), y: fp2_zero()}
}

fn fp4_one() Fp4 {
    << Fp4{x: fp2_zero(), y: fp2_one()}
}

fn fp4_clone(a &Fp4) Fp4 {
    mut x := fp2_clone(&a.x)
    mut y := fp2_clone(&a.y)
    << Fp4{x: x, y: y}
}

fn fp4_add(a &Fp4, b &Fp4) Fp4 {
    ax := fp2_clone(&a.x)
    ay := fp2_clone(&a.y)
    bx := fp2_clone(&b.x)
    by := fp2_clone(&b.y)
    xn := fp2_add(&ax, &bx) or >>
    yn := fp2_add(&ay, &by) or >>
    << Fp4{x: xn, y: yn}
}

fn fp4_sub(a &Fp4, b &Fp4) Fp4 {
    ax := fp2_clone(&a.x)
    ay := fp2_clone(&a.y)
    bx := fp2_clone(&b.x)
    by := fp2_clone(&b.y)
    xn := fp2_sub(&ax, &bx) or >>
    yn := fp2_sub(&ay, &by) or >>
    << Fp4{x: xn, y: yn}
}

fn fp4_neg(a &Fp4) Fp4 {
    ax := fp2_clone(&a.x)
    ay := fp2_clone(&a.y)
    xn := fp2_neg(&ax) or >>
    yn := fp2_neg(&ay) or >>
    << Fp4{x: xn, y: yn}
}

fn fp4_dbl(a &Fp4) Fp4 {
    ax := fp2_clone(&a.x)
    ay := fp2_clone(&a.y)
    xn := fp2_dbl(&ax) or >>
    yn := fp2_dbl(&ay) or >>
    << Fp4{x: xn, y: yn}
}

fn fp4_trp(a &Fp4) Fp4 {
    d := fp4_dbl(a) or >>
    << fp4_add(&d, a) or >>
}

fn fp4_mul(a &Fp4, b &Fp4) Fp4 {
    ax := fp2_clone(&a.x)
    ay := fp2_clone(&a.y)
    bx := fp2_clone(&b.x)
    by := fp2_clone(&b.y)
    v0 := fp2_mul(&ay, &by) or >>
    v1 := fp2_mul(&ax, &bx) or >>
    axy := fp2_add(&ax, &ay) or >>
    bxy := fp2_add(&bx, &by) or >>
    t := fp2_mul(&axy, &bxy) or >>
    t2 := fp2_sub(&t, &v0) or >>
    tx := fp2_sub(&t2, &v1) or >>
    u1 := fp2_mul_u1(&v1) or >>
    ty := fp2_add(&u1, &v0) or >>
    << Fp4{x: tx, y: ty}
}

fn fp4_mul2(a &Fp4, xv &Fp2, yv &Fp2) Fp4 {
    ax := fp2_clone(&a.x)
    ay := fp2_clone(&a.y)
    v0 := fp2_mul(&ay, yv) or >>
    v1 := fp2_mul(&ax, xv) or >>
    axy := fp2_add(&ax, &ay) or >>
    bxy := fp2_add(xv, yv) or >>
    t := fp2_mul(&axy, &bxy) or >>
    t2 := fp2_sub(&t, &v0) or >>
    tx := fp2_sub(&t2, &v1) or >>
    u1 := fp2_mul_u1(&v1) or >>
    ty := fp2_add(&u1, &v0) or >>
    << Fp4{x: tx, y: ty}
}

fn fp4_mul_fp2(a &Fp4, b &Fp2) Fp4 {
    ax := fp2_clone(&a.x)
    ay := fp2_clone(&a.y)
    xn := fp2_mul(&ax, b) or >>
    yn := fp2_mul(&ay, b) or >>
    << Fp4{x: xn, y: yn}
}

fn fp4_mul_fp(a &Fp4, k &big.Int) Fp4 {
    ax := fp2_clone(&a.x)
    ay := fp2_clone(&a.y)
    xn := fp2_mul_fp(&ax, k) or >>
    yn := fp2_mul_fp(&ay, k) or >>
    << Fp4{x: xn, y: yn}
}

fn fp4_mul_v1(a &Fp4) Fp4 {
    ax := fp2_clone(&a.x)
    ay := fp2_clone(&a.y)
    yu := fp2_mul_u1(&ax) or >>
    << Fp4{x: ay, y: yu}
}

fn fp4_mul_v(a &Fp4, b &Fp4) Fp4 {
    ax := fp2_clone(&a.x)
    ay := fp2_clone(&a.y)
    bx := fp2_clone(&b.x)
    by := fp2_clone(&b.y)
    v0 := fp2_mul(&ay, &by) or >>
    v1 := fp2_mul(&ax, &bx) or >>
    axy := fp2_add(&ax, &ay) or >>
    bxy := fp2_add(&bx, &by) or >>
    t := fp2_mul(&axy, &bxy) or >>
    t2 := fp2_sub(&t, &v0) or >>
    t3 := fp2_sub(&t2, &v1) or >>
    ty := fp2_mul_u1(&t3) or >>
    u1 := fp2_mul_u1(&v1) or >>
    tx := fp2_add(&u1, &v0) or >>
    << Fp4{x: tx, y: ty}
}

fn fp4_sqr(a &Fp4) Fp4 {
    ax := fp2_clone(&a.x)
    ay := fp2_clone(&a.y)
    su := fp2_sqr_u(&ax) or >>
    sy := fp2_sqr(&ay) or >>
    ty := fp2_add(&su, &sy) or >>
    xy := fp2_mul(&ax, &ay) or >>
    tx := fp2_dbl(&xy) or >>
    << Fp4{x: tx, y: ty}
}

fn fp4_sqr_v(a &Fp4) Fp4 {
    ax := fp2_clone(&a.x)
    ay := fp2_clone(&a.y)
    su := fp2_sqr_u(&ax) or >>
    sy := fp2_sqr(&ay) or >>
    tx := fp2_add(&su, &sy) or >>
    mu := fp2_mul_u(&ax, &ay) or >>
    ty := fp2_dbl(&mu) or >>
    << Fp4{x: tx, y: ty}
}

fn fp4_inv(a &Fp4) Fp4 {
    ax := fp2_clone(&a.x)
    ay := fp2_clone(&a.y)
    su := fp2_sqr_u(&ax) or >>
    sy := fp2_sqr(&ay) or >>
    t3 := fp2_sub(&su, &sy) or >>
    t3i := fp2_inv(&t3) or >>
    t2 := fp2_mul(&ax, &t3i) or >>
    t1m := fp2_mul(&ay, &t3i) or >>
    t1 := fp2_neg(&t1m) or >>
    << Fp4{x: t2, y: t1}
}

fn fp4_conj(a &Fp4) Fp4 {
    ax := fp2_clone(&a.x)
    ay := fp2_clone(&a.y)
    xn := fp2_neg(&ax) or >>
    << Fp4{x: xn, y: ay}
}

fn fp12_one() Fp12 {
    << Fp12{x: fp4_zero(), y: fp4_zero(), z: fp4_one()}
}

fn fp12_clone(a &Fp12) Fp12 {
    mut x := fp4_clone(&a.x)
    mut y := fp4_clone(&a.y)
    mut z := fp4_clone(&a.z)
    << Fp12{x: x, y: y, z: z}
}

fn fp12_mul(a &Fp12, b &Fp12) Fp12 {
    ax := fp4_clone(&a.x)
    ay := fp4_clone(&a.y)
    az := fp4_clone(&a.z)
    bx := fp4_clone(&b.x)
    by := fp4_clone(&b.y)
    bz := fp4_clone(&b.z)
    v0 := fp4_mul(&az, &bz) or >>
    v1 := fp4_mul(&ay, &by) or >>
    v2 := fp4_mul(&ax, &bx) or >>
    ayx := fp4_add(&ay, &ax) or >>
    byx := fp4_add(&by, &bx) or >>
    t := fp4_mul(&ayx, &byx) or >>
    t2 := fp4_sub(&t, &v1) or >>
    t3 := fp4_sub(&t2, &v2) or >>
    tv := fp4_mul_v1(&t3) or >>
    tz := fp4_add(&tv, &v0) or >>
    azy := fp4_add(&az, &ay) or >>
    bzy := fp4_add(&bz, &by) or >>
    ty0 := fp4_mul(&azy, &bzy) or >>
    ty1 := fp4_sub(&ty0, &v0) or >>
    ty2 := fp4_sub(&ty1, &v1) or >>
    v2v := fp4_mul_v1(&v2) or >>
    ty := fp4_add(&ty2, &v2v) or >>
    azx := fp4_add(&az, &ax) or >>
    bzx := fp4_add(&bz, &bx) or >>
    tx0 := fp4_mul(&azx, &bzx) or >>
    tx1 := fp4_sub(&tx0, &v0) or >>
    tx2 := fp4_add(&tx1, &v1) or >>
    tx := fp4_sub(&tx2, &v2) or >>
    << Fp12{x: tx, y: ty, z: tz}
}

fn fp12_sqr(a &Fp12) Fp12 {
    ax := fp4_clone(&a.x)
    ay := fp4_clone(&a.y)
    az := fp4_clone(&a.z)
    v0 := fp4_sqr(&az) or >>
    v1 := fp4_sqr(&ay) or >>
    v2 := fp4_sqr(&ax) or >>
    ayx := fp4_add(&ay, &ax) or >>
    tz0 := fp4_sqr(&ayx) or >>
    tz1 := fp4_sub(&tz0, &v1) or >>
    tz2 := fp4_sub(&tz1, &v2) or >>
    tzv := fp4_mul_v1(&tz2) or >>
    tz := fp4_add(&tzv, &v0) or >>
    azy := fp4_add(&az, &ay) or >>
    ty0 := fp4_sqr(&azy) or >>
    ty1 := fp4_sub(&ty0, &v0) or >>
    ty2 := fp4_sub(&ty1, &v1) or >>
    v2v := fp4_mul_v1(&v2) or >>
    ty := fp4_add(&ty2, &v2v) or >>
    azx := fp4_add(&az, &ax) or >>
    tx0 := fp4_sqr(&azx) or >>
    tx1 := fp4_sub(&tx0, &v0) or >>
    tx2 := fp4_add(&tx1, &v1) or >>
    tx := fp4_sub(&tx2, &v2) or >>
    << Fp12{x: tx, y: ty, z: tz}
}

fn fp12_mul_line(ret &Fp12, a &Fp2, b &Fp2, c &Fp2) Fp12 {
    rx := fp4_clone(&ret.x)
    ry := fp4_clone(&ret.y)
    rz := fp4_clone(&ret.z)
    tz := fp4_mul2(&rz, c, a) or >>
    ryb := fp4_mul_fp2(&ry, b) or >>
    t := fp4_mul_v1(&ryb) or >>
    tz2 := fp4_add(&tz, &t) or >>
    t2 := fp4_mul2(&ry, c, a) or >>
    rxb := fp4_mul_fp2(&rx, b) or >>
    ny0 := fp4_mul_v1(&rxb) or >>
    ny := fp4_add(&ny0, &t2) or >>
    t3 := fp4_mul2(&rx, c, a) or >>
    rzb := fp4_mul_fp2(&rz, b) or >>
    nx := fp4_add(&rzb, &t3) or >>
    << Fp12{x: nx, y: ny, z: tz2}
}

fn cyclo6_sqr(a &Fp12) Fp12 {
    ax := fp4_clone(&a.x)
    ay := fp4_clone(&a.y)
    az := fp4_clone(&a.z)
    v0 := fp4_sqr_v(&ax) or >>
    v1 := fp4_sqr(&ay) or >>
    v2 := fp4_sqr(&az) or >>
    tx := fp4_trp(&v0) or >>
    ty := fp4_trp(&v1) or >>
    tz := fp4_trp(&v2) or >>
    f12 := fp4_dbl(&ax) or >>
    f12y := fp2_clone(&f12.y)
    f12yn := fp2_neg(&f12y) or >>
    f12x := fp2_clone(&f12.x)
    f12n := Fp4{x: f12x, y: f12yn}
    f02 := fp4_dbl(&ay) or >>
    f02x := fp2_clone(&f02.x)
    f02xn := fp2_neg(&f02x) or >>
    f02y := fp2_clone(&f02.y)
    f02n := Fp4{x: f02xn, y: f02y}
    f11 := fp4_dbl(&az) or >>
    f11y := fp2_clone(&f11.y)
    f11yn := fp2_neg(&f11y) or >>
    f11x := fp2_clone(&f11.x)
    f11n := Fp4{x: f11x, y: f11yn}
    nx := fp4_add(&ty, &f12n) or >>
    ny := fp4_add(&tx, &f02n) or >>
    nz := fp4_add(&tz, &f11n) or >>
    << Fp12{x: nx, y: ny, z: nz}
}

fn fp12_inv(a &Fp12) Fp12 {
    ax := fp4_clone(&a.x)
    ay := fp4_clone(&a.y)
    az := fp4_clone(&a.z)
    t1 := fp4_mul_v(&ax, &ay) or >>
    asz := fp4_sqr(&az) or >>
    aa := fp4_sub(&asz, &t1) or >>
    axv := fp4_sqr_v(&ax) or >>
    yz := fp4_mul(&ay, &az) or >>
    bb := fp4_sub(&axv, &yz) or >>
    ays := fp4_sqr(&ay) or >>
    xz := fp4_mul(&ax, &az) or >>
    cc := fp4_sub(&ays, &xz) or >>
    f0 := fp4_mul_v(&cc, &ay) or >>
    f1 := fp4_mul(&aa, &az) or >>
    f2 := fp4_add(&f0, &f1) or >>
    bx := fp4_mul_v(&bb, &ax) or >>
    ff := fp4_add(&f2, &bx) or >>
    fi := fp4_inv(&ff) or >>
    nx := fp4_mul(&cc, &fi) or >>
    ny := fp4_mul(&bb, &fi) or >>
    nz := fp4_mul(&aa, &fi) or >>
    << Fp12{x: nx, y: ny, z: nz}
}

fn fp12_frob_p2(a &Fp12) Fp12 {
    ax := fp4_clone(&a.x)
    ay := fp4_clone(&a.y)
    az := fp4_clone(&a.z)
    wp2 := hex_fp("0000000000000000f300000002a3a6f2780272354f8b78f4d5fc11967be65334") or >>
    w2p2 := hex_fp("0000000000000000f300000002a3a6f2780272354f8b78f4d5fc11967be65333") or >>
    nz := fp4_conj(&az) or >>
    nyc := fp4_conj(&ay) or >>
    ny := fp4_mul_fp(&nyc, &wp2) or >>
    nxc := fp4_conj(&ax) or >>
    nx := fp4_mul_fp(&nxc, &w2p2) or >>
    << Fp12{x: nx, y: ny, z: nz}
}

fn fp12_frob_p6(a &Fp12) Fp12 {
    ax := fp4_clone(&a.x)
    ay := fp4_clone(&a.y)
    az := fp4_clone(&a.z)
    nx := fp4_conj(&ax) or >>
    nyc := fp4_conj(&ay) or >>
    ny := fp4_neg(&nyc) or >>
    nz := fp4_conj(&az) or >>
    << Fp12{x: nx, y: ny, z: nz}
}

fn final_easy(inp &Fp12) Fp12 {
    f6 := fp12_frob_p6(inp) or >>
    inv := fp12_inv(inp) or >>
    t1 := fp12_mul(&f6, &inv) or >>
    t2 := fp12_frob_p2(&t1) or >>
    << fp12_mul(&t1, &t2)
}

fn hard_exp() big.Int {
    p := field_p() or >>
    n := field_n() or >>
    mut p2 := big.new_int(0)
    p2.mul(&p, &p)
    mut p4 := big.new_int(0)
    p4.mul(&p2, &p2)
    mut num := big.new_int(0)
    num.sub(&p4, &p2)
    mut one := big.new_int(1)
    num.add(&num, &one)
    mut z := big.new_int(0)
    z.quo(&num, &n) or >>
    << z
}

// (p^12-1)/n = (p^6-1)(p^2+1) · (p^4-p^2+1)/n.
// Easy part then cyclotomic binary exp of the 767-bit hard exponent.
fn final_exp(inp &Fp12) Fp12 {
    t1b := final_easy(inp) or >>
    k := hard_exp() or >>
    << gt_exp(&t1b, &k)
}

fn gt_exp(g &Fp12, k &big.Int) Fp12 {
    if k.sign() == 0 {
        << fp12_one()
    }
    mut r := fp12_one()
    mut started := false
    mut i := k.bit_len() - 1
    while i >= 0 {
        if started {
            nxt := cyclo6_sqr(&r) or >>
            r = nxt
        } else {
            started = true
        }
        if k.bit(i) == 1 {
            nxt2 := fp12_mul(&r, g) or >>
            r = nxt2
        }
        i = i - 1
    }
    << r
}

fn fp12_to_bytes(f &Fp12) string {
    x := fp4_clone(&f.x)
    y := fp4_clone(&f.y)
    z := fp4_clone(&f.z)
    xx := fp2_clone(&x.x)
    xy := fp2_clone(&x.y)
    yx := fp2_clone(&y.x)
    yy := fp2_clone(&y.y)
    zx := fp2_clone(&z.x)
    zy := fp2_clone(&z.y)
    x0 := int_clone(&xx.x)
    x1 := int_clone(&xx.y)
    y0 := int_clone(&xy.x)
    y1 := int_clone(&xy.y)
    u0 := int_clone(&yx.x)
    u1 := int_clone(&yx.y)
    v0 := int_clone(&yy.x)
    v1 := int_clone(&yy.y)
    w0 := int_clone(&zx.x)
    w1 := int_clone(&zx.y)
    t0 := int_clone(&zy.x)
    t1 := int_clone(&zy.y)
    mut b := []int{}
    append_fp(mut &b, &x0)
    append_fp(mut &b, &x1)
    append_fp(mut &b, &y0)
    append_fp(mut &b, &y1)
    append_fp(mut &b, &u0)
    append_fp(mut &b, &u1)
    append_fp(mut &b, &v0)
    append_fp(mut &b, &v1)
    append_fp(mut &b, &w0)
    append_fp(mut &b, &w1)
    append_fp(mut &b, &t0)
    append_fp(mut &b, &t1)
    << string_from_bytes(b)
}

fn append_fp(b &mut []int, x &big.Int) {
    s := pad32(x)
    mut i := 0
    while i < 32 {
        b.push(s[i] & 255)
        i = i + 1
    }
}

fn pad32(x &big.Int) string {
    raw := x.bytes()
    mut out := []int{}
    for i in 0:32 {
        out.push(0)
    }
    if raw.len >= 32 {
        mut i := 0
        while i < 32 {
            out[i] = raw[raw.len - 32 + i] & 255
            i = i + 1
        }
    } else {
        off := 32 - raw.len
        mut i := 0
        while i < raw.len {
            out[off + i] = raw[i] & 255
            i = i + 1
        }
    }
    << string_from_bytes(out)
}
