@crypto/sm9

#errors
#math/big

fn g2j_clone(p &G2j) G2j {
    $x := fp2_clone(&p.x)
    $y := fp2_clone(&p.y)
    $z := fp2_clone(&p.z)
    $t := fp2_clone(&p.t)
    << G2j{x: x, y: y, z: z, t: t}
}

fn g2j_from_aff(p &G2) G2j {
    $x := fp2_clone(&p.x)
    $y := fp2_clone(&p.y)
    << G2j{x: x, y: y, z: fp2_one(), t: fp2_one()}
}

fn naf_digits() []int {
    $a := []int{}
    a.push(0)
    a.push(0 - 1)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(1)
    a.push(0)
    a.push(1)
    a.push(0)
    a.push(0)
    a.push(0 - 1)
    a.push(0)
    a.push(0 - 1)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0 - 1)
    a.push(0)
    a.push(0 - 1)
    a.push(0)
    a.push(1)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(1)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
    a.push(0)
