    a.push(0)
    a.push(0)
    a.push(1)
    << a
}

fn line_double(r &G2j, qx &big.Int, qy &big.Int) Line {
    rx := fp2_clone(&r.x)
    ry := fp2_clone(&r.y)
    rz := fp2_clone(&r.z)
    rt := fp2_clone(&r.t)
    a := fp2_sqr(&rx) or >>
    b := fp2_sqr(&ry) or >>
    c := fp2_sqr(&b) or >>
    xb := fp2_add(&rx, &b) or >>
    t0 := fp2_sqr(&xb) or >>
    t1 := fp2_sub(&t0, &a) or >>
    t2 := fp2_sub(&t1, &c) or >>
    d := fp2_dbl(&t2) or >>
    e := fp2_trp(&a) or >>
    g := fp2_sqr(&e) or >>
    ox0 := fp2_sub(&g, &d) or >>
    ox := fp2_sub(&ox0, &d) or >>
    yz := fp2_add(&ry, &rz) or >>
    oz0 := fp2_sqr(&yz) or >>
    oz1 := fp2_sub(&oz0, &b) or >>
    oz := fp2_sub(&oz1, &rt) or >>
    $eight := big.new_int(8)
    t8 := fp2_mul_fp(&c, &eight) or >>
    dy := fp2_sub(&d, &ox) or >>
    oy0 := fp2_mul(&dy, &e) or >>
    oy := fp2_sub(&oy0, &t8) or >>
    ot := fp2_sqr(&oz) or >>
    et := fp2_mul(&e, &rt) or >>
    t3 := fp2_dbl(&et) or >>
    tn := fp2_neg(&t3) or >>
    bb := fp2_mul_fp(&tn, qx) or >>
    xe := fp2_add(&rx, &e) or >>
    aa0 := fp2_sqr(&xe) or >>
    aa1 := fp2_sub(&aa0, &a) or >>
    aa2 := fp2_sub(&aa1, &g) or >>
    $four := big.new_int(4)
    b4 := fp2_mul_fp(&b, &four) or >>
    aa := fp2_sub(&aa2, &b4) or >>
    ozrt := fp2_mul(&oz, &rt) or >>
    $two := big.new_int(2)
    pmod := field_p() or >>
    two_qy := fe_mul(qy, &two, &pmod) or >>
    cc := fp2_mul_fp(&ozrt, &two_qy) or >>
    nr := G2j{x: ox, y: oy, z: oz, t: ot}
    << Line{r: nr, a: aa, b: bb, c: cc}
}

fn line_add(r &G2j, px &Fp2, py &Fp2, qx &big.Int, qy &big.Int, r2 &Fp2) Line {
    rx := fp2_clone(&r.x)
    ry := fp2_clone(&r.y)
    rz := fp2_clone(&r.z)
    rt := fp2_clone(&r.t)
    bb0 := fp2_mul(px, &rt) or >>
    yz := fp2_add(py, &rz) or >>
    d0 := fp2_sqr(&yz) or >>
    d1 := fp2_sub(&d0, r2) or >>
    d2 := fp2_sub(&d1, &rt) or >>
    d := fp2_mul(&d2, &rt) or >>
    h := fp2_sub(&bb0, &rx) or >>
    i := fp2_sqr(&h) or >>
    e0 := fp2_dbl(&i) or >>
    e := fp2_dbl(&e0) or >>
    j := fp2_mul(&h, &e) or >>
    l10 := fp2_sub(&d, &ry) or >>
    l1 := fp2_sub(&l10, &ry) or >>
    v := fp2_mul(&rx, &e) or >>
    ox0 := fp2_sqr(&l1) or >>
    ox1 := fp2_sub(&ox0, &j) or >>
    ox2 := fp2_sub(&ox1, &v) or >>
    ox := fp2_sub(&ox2, &v) or >>
    zh := fp2_add(&rz, &h) or >>
    oz0 := fp2_sqr(&zh) or >>
    oz1 := fp2_sub(&oz0, &rt) or >>
    oz := fp2_sub(&oz1, &i) or >>
    t0 := fp2_sub(&v, &ox) or >>
    t := fp2_mul(&t0, &l1) or >>
    t2a := fp2_mul(&ry, &j) or >>
    t2 := fp2_dbl(&t2a) or >>
    oy := fp2_sub(&t, &t2) or >>
    ot := fp2_sqr(&oz) or >>
    yoz := fp2_add(py, &oz) or >>
    t3a := fp2_sqr(&yoz) or >>
    t3b := fp2_sub(&t3a, r2) or >>
    t3 := fp2_sub(&t3b, &ot) or >>
    t4a := fp2_mul(&l1, px) or >>
    t4 := fp2_dbl(&t4a) or >>
    aa := fp2_sub(&t4, &t3) or >>
    $two := big.new_int(2)
    pmod := field_p() or >>
    two_qy := fe_mul(qy, &two, &pmod) or >>
    cc := fp2_mul_fp(&oz, &two_qy) or >>
    ln := fp2_neg(&l1) or >>
    bb1 := fp2_mul_fp(&ln, qx) or >>
    bb := fp2_dbl(&bb1) or >>
    nr := G2j{x: ox, y: oy, z: oz, t: ot}
    << Line{r: nr, a: aa, b: bb, c: cc}
}

struct MillerStep {
    r   G2j
    ret Fp12
}

fn miller_step(r &G2j, ret &Fp12, px &big.Int, py &big.Int, qx &Fp2, qy &Fp2, minus &G2j, r2 &Fp2, d int, is_first bool) MillerStep {
    ld := line_double(r, px, py) or >>
    $cur_r := g2j_clone(&ld.r)
    $cur_ret := fp12_clone(ret)
    if !is_first {
        sq := fp12_sqr(&cur_ret) or >>
        cur_ret = sq
    }
    nxt := fp12_mul_line(&cur_ret, &ld.a, &ld.b, &ld.c) or >>
    cur_ret = nxt
    if d != 0 {
        $srcx := fp2_clone(qx)
        $srcy := fp2_clone(qy)
        if d < 0 {
            srcx = fp2_clone(&minus.x)
            srcy = fp2_clone(&minus.y)
        }
        ad := line_add(&cur_r, &srcx, &srcy, px, py, r2) or >>
        cur_r = g2j_clone(&ad.r)
        nxt2 := fp12_mul_line(&cur_ret, &ad.a, &ad.b, &ad.c) or >>
        cur_ret = nxt2
    }
    << MillerStep{r: cur_r, ret: cur_ret}
}

fn miller_post(r &G2j, ret &Fp12, qx &Fp2, qy &Fp2, px &big.Int, py &big.Int) Fp12 {
    b13 := hex_fp("b640000002a3a6f0e303ab4ff2eb2052a9f02115caef75e70f738991676af24a") or >>
    b12 := hex_fp("49db721a269967c4e0a8debc0783182f82555233139e9d63efbd7b54092c756c") or >>
    b23 := hex_fp("b640000002a3a6f0e303ab4ff2eb2052a9f02115caef75e70f738991676af249") or >>
    b22 := hex_fp("b640000002a3a6f1d603ab4ff58ec74521f2934b1a7aeedbe56f9b27e351457c") or >>
    q1xc := fp2_conj(qx) or >>
    q1x := fp2_mul_fp(&q1xc, &b13) or >>
    q1yc := fp2_conj(qy) or >>
    q1y := fp2_mul_fp(&q1yc, &b12) or >>
    r2b := fp2_sqr(&q1y) or >>
    q1 := G2j{x: q1x, y: q1y, z: fp2_one(), t: fp2_one()}
    mq2x := fp2_mul_fp(qx, &b23) or >>
    qyn2 := fp2_neg(qy) or >>
    mq2y := fp2_mul_fp(&qyn2, &b22) or >>
    r2c := fp2_sqr(&mq2y) or >>
    mq2 := G2j{x: mq2x, y: mq2y, z: fp2_one(), t: fp2_one()}
    q1x2 := fp2_clone(&q1.x)
    q1y2 := fp2_clone(&q1.y)
    ad1 := line_add(r, &q1x2, &q1y2, px, py, &r2b) or >>
    $cur_r := g2j_clone(&ad1.r)
    retn := fp12_mul_line(ret, &ad1.a, &ad1.b, &ad1.c) or >>
    m2x := fp2_clone(&mq2.x)
    m2y := fp2_clone(&mq2.y)
    ad2 := line_add(&cur_r, &m2x, &m2y, px, py, &r2c) or >>
    << fp12_mul_line(&retn, &ad2.a, &ad2.b, &ad2.c)
}

fn miller(q &G2, p &G1) Fp12 {
    qa := g2_aff(q) or >>
    pa := g1_aff(p) or >>
    qx := fp2_clone(&qa.x)
    qy := fp2_clone(&qa.y)
    px := int_clone(&pa.x)
    py := int_clone(&pa.y)
    a_aff := g2j_from_aff(&qa)
    qyn := fp2_neg(&qy) or >>
    $mx := fp2_clone(&qx)
    minus := G2j{x: mx, y: qyn, z: fp2_one(), t: fp2_one()}
    r2 := fp2_sqr(&qy) or >>
    $r := g2j_clone(&a_aff)
    $ret := fp12_one()
    naf := naf_digits()
    nlen := naf.len
    $i := nlen - 1
    while i > 0 {
        st := miller_step(&r, &ret, &px, &py, &qx, &qy, &minus, &r2, naf[i - 1], i == nlen - 1) or >>
        r = g2j_clone(&st.r)
        ret = fp12_clone(&st.ret)
        i = i - 1
    }
    << miller_post(&r, &ret, &qx, &qy, &px, &py)
}

fn pairing(p &G1, q &G2) Fp12 {
    e := miller(q, p) or >>
    << final_exp(&e)
}
