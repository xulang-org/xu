@crypto/sm9

#errors
#math/big
#crypto/sm3
#crypto/rand
#crypto/subtle

// SM9 (GM/T 0044). Xu addition — Go has no crypto/sm9.
// Identifier signature hid=0x01 and KDF stream encryption hid=0x03.
// G1 points 04||x||y (65). G2 04||x.u||x.y||y.u||y.y (129).
// Signature h||S (32+65). Ciphertext 04||C1||C3||C2 (C3=SM3).
// Key exchange hid=0x02 (GM/T 0044.4). H1/H2 take 40-byte Ha then
// (a mod (n-1))+1. Zero C, not a commercial-crypto certification.
// No ASN.1, not wired into GMTLS.
// XU-CT-CLASS: variable-time
// XU-CT-USE: fixed-shape-only
// math/big pairing/scalar arithmetic is variable-time; crypto/subtle covers
// only final fixed-shape integrity/equality checks.

pub const G1_SIZE = 65
pub const G2_SIZE = 129
pub const SIGNATURE_SIZE = 97
pub const HID_SIGN = 1
pub const HID_ENC = 3
pub const HID_EXCH = 2

fn append_s(b $&[]int, s &string) {
    $i := 0
    while i < s.len {
        b.push(s[i] & 255)
        i = i + 1
    }
}

fn be32(n int) string {
    $b := []int{}
    b.push((n >> 24) & 255)
    b.push((n >> 16) & 255)
    b.push((n >> 8) & 255)
    b.push(n & 255)
    << string_from_bytes(b)
}

fn from_be32(s &string, off int) big.Int {
    $b := []int{}
    $i := 0
    while i < 32 {
        b.push(s[off + i] & 255)
        i = i + 1
    }
    $z := big.new_int(0)
    z.set_bytes(string_from_bytes(b))
    << z
}

fn parse_scalar(s &string) big.Int {
    if s.len == 0 || s.len > 32 {
        >> errors.new("crypto/sm9: bad scalar")
    }
    $z := big.new_int(0)
    z.set_bytes(s + "")
    n := field_n() or >>
    if z.sign() == 0 || z.cmp(&n) >= 0 {
        >> errors.new("crypto/sm9: bad scalar")
    }
    << z
}

fn hash_hn(z &string, prefix int) big.Int {
    $b1 := []int{}
    b1.push(prefix & 255)
    append_s($&b1, z)
    t1 := be32(1)
    append_s($&b1, &t1)
    h1 := sm3.sum_bytes(string_from_bytes(b1))
    $b2 := []int{}
    b2.push(prefix & 255)
    append_s($&b2, z)
    t2 := be32(2)
    append_s($&b2, &t2)
    h2 := sm3.sum_bytes(string_from_bytes(b2))
    $ha := []int{}
    $i := 0
    while i < 32 {
        ha.push(h1[i] & 255)
        i = i + 1
    }
    i = 0
    while i < 8 {
        ha.push(h2[i] & 255)
        i = i + 1
    }
    $a := big.new_int(0)
    a.set_bytes(string_from_bytes(ha))
    n := field_n() or >>
    $one := big.new_int(1)
    $nm1 := big.new_int(0)
    nm1.sub(&n, &one)
    a.mod(&a, &nm1) or >>
    a.add(&a, &one)
    << a
}

fn id_hid(id &string, hid int) string {
    $b := []int{}
    append_s($&b, id)
    b.push(hid & 255)
    << string_from_bytes(b)
}

fn kdf(z &string, klen int) string {
    if klen <= 0 {
        << ""
    }
    $out := []int{}
    $ct := 1
    while out.len < klen {
        $blk := []int{}
        append_s($&blk, z)
        t := be32(ct)
        append_s($&blk, &t)
        h := sm3.sum_bytes(string_from_bytes(blk))
        $i := 0
        while i < h.len {
            if out.len < klen {
                out.push(h[i] & 255)
            }
            i = i + 1
        }
        ct = ct + 1
        if ct > 1000000 {
            >> errors.new("crypto/sm9: kdf overflow")
        }
    }
    << string_from_bytes(out)
}

fn all_zero(s &string) bool {
    if s.len == 0 {
        << false
    }
    $x := 0
    $i := 0
    while i < s.len {
        x = x | (s[i] & 255)
        i = i + 1
    }
    << x == 0
}

fn marshal_g1(p &G1) string {
    a := g1_aff(p) or >>
    ax := int_clone(&a.x)
    ay := int_clone(&a.y)
    xs := pad32(&ax)
    ys := pad32(&ay)
    $b := []int{}
    b.push(4)
    append_s($&b, &xs)
    append_s($&b, &ys)
    << string_from_bytes(b)
}

fn marshal_g1_raw(p &G1) string {
    a := g1_aff(p) or >>
    ax := int_clone(&a.x)
    ay := int_clone(&a.y)
    xs := pad32(&ax)
    ys := pad32(&ay)
    $b := []int{}
    append_s($&b, &xs)
    append_s($&b, &ys)
    << string_from_bytes(b)
}

fn marshal_g2(p &G2) string {
    a := g2_aff(p) or >>
    xx := fp2_clone(&a.x)
    yy := fp2_clone(&a.y)
    x0 := int_clone(&xx.x)
    x1 := int_clone(&xx.y)
    y0 := int_clone(&yy.x)
    y1 := int_clone(&yy.y)
    s0 := pad32(&x0)
    s1 := pad32(&x1)
    s2 := pad32(&y0)
    s3 := pad32(&y1)
    $b := []int{}
    b.push(4)
    append_s($&b, &s0)
    append_s($&b, &s1)
    append_s($&b, &s2)
    append_s($&b, &s3)
    << string_from_bytes(b)
}

fn parse_g1(s &string) G1 {
    if s.len != G1_SIZE || (s[0] & 255) != 4 {
        >> errors.new("crypto/sm9: bad G1 point")
    }
    x := from_be32(s, 1)
    y := from_be32(s, 33)
    pmod := field_p() or >>
    if x.sign() < 0 || y.sign() < 0 || x.cmp(&pmod) >= 0 || y.cmp(&pmod) >= 0 {
        >> errors.new("crypto/sm9: bad G1 point")
    }
    if !g1_on(&x, &y) {
        >> errors.new("crypto/sm9: G1 not on curve")
    }
    << G1{x: x, y: y, z: big.new_int(1)}
}

fn parse_g2(s &string) G2 {
    if s.len != G2_SIZE || (s[0] & 255) != 4 {
        >> errors.new("crypto/sm9: bad G2 point")
    }
    xx := from_be32(s, 1)
    xy := from_be32(s, 33)
    yx := from_be32(s, 65)
    yy := from_be32(s, 97)
    pmod := field_p() or >>
    if xx.cmp(&pmod) >= 0 || xy.cmp(&pmod) >= 0 || yx.cmp(&pmod) >= 0 || yy.cmp(&pmod) >= 0 {
        >> errors.new("crypto/sm9: bad G2 point")
    }
    xp := Fp2{x: xx, y: xy}
    yp := Fp2{x: yx, y: yy}
    if !g2_on(&xp, &yp) {
        >> errors.new("crypto/sm9: G2 not on curve")
    }
    << G2{x: xp, y: yp, z: fp2_one()}
}

fn rand_scalar() big.Int {
    n := field_n() or >>
    $k := 0
    while k < 64 {
        b := rand.read(32) or >>
        $z := big.new_int(0)
        z.set_bytes(b + "")
        z.mod(&z, &n) or >>
        if z.sign() != 0 {
            << z
        }
        k = k + 1
    }
    >> errors.new("crypto/sm9: rand scalar")
}

pub fn sign_master_public(ks &string) string {
    d := parse_scalar(ks) or >>
    p2 := p2_point() or >>
    p := g2_mul(&d, &p2) or >>
    << marshal_g2(&p)
}

pub fn sign_user_key(ks &string, id &string) string {
    d := parse_scalar(ks) or >>
    z := id_hid(id, HID_SIGN)
    h1 := hash_hn(&z, 1) or >>
    n := field_n() or >>
    $t1 := big.new_int(0)
    t1.add(&h1, &d)
    t1.mod(&t1, &n) or >>
    if t1.sign() == 0 {
        >> errors.new("crypto/sm9: t1 is 0")
    }
    $t2 := big.new_int(0)
    t2.mod_inverse(&t1, &n) or >>
    $t2b := big.new_int(0)
    t2b.mul(&t2, &d)
    t2b.mod(&t2b, &n) or >>
    p1 := p1_point() or >>
    ds := g1_mul(&t2b, &p1) or >>
    << marshal_g1(&ds)
}

pub fn enc_master_public(ke &string) string {
    d := parse_scalar(ke) or >>
    p1 := p1_point() or >>
    p := g1_mul(&d, &p1) or >>
    << marshal_g1(&p)
}

fn derive_enc_user(ke &string, id &string, hid int) string {
    d := parse_scalar(ke) or >>
    z := id_hid(id, hid)
    h1 := hash_hn(&z, 1) or >>
    n := field_n() or >>
    $t1 := big.new_int(0)
    t1.add(&h1, &d)
    t1.mod(&t1, &n) or >>
    if t1.sign() == 0 {
        >> errors.new("crypto/sm9: t1 is 0")
    }
    $t2 := big.new_int(0)
    t2.mod_inverse(&t1, &n) or >>
    $t2b := big.new_int(0)
    t2b.mul(&t2, &d)
    t2b.mod(&t2b, &n) or >>
    p2 := p2_point() or >>
    ds := g2_mul(&t2b, &p2) or >>
    << marshal_g2(&ds)
}

pub fn enc_user_key(ke &string, id &string) string {
    << derive_enc_user(ke, id, HID_ENC)
}

pub fn exch_user_key(ke &string, id &string) string {
    << derive_enc_user(ke, id, HID_EXCH)
}

pub fn sign_r(dsa &string, mpk &string, msg &string, r &string) string {
    ds := parse_g1(dsa) or >>
    pk := parse_g2(mpk) or >>
    rv := parse_scalar(r) or >>
    p1 := p1_point() or >>
    g := pairing(&p1, &pk) or >>
    w := gt_exp(&g, &rv) or >>
    wb := fp12_to_bytes(&w)
    $z := []int{}
    append_s($&z, msg)
    append_s($&z, &wb)
    zs := string_from_bytes(z)
    h := hash_hn(&zs, 2) or >>
    n := field_n() or >>
    $ell := big.new_int(0)
    ell.sub(&rv, &h)
    ell.mod(&ell, &n) or >>
    if ell.sign() == 0 {
        >> errors.new("crypto/sm9: r equals h")
    }
    s := g1_mul(&ell, &ds) or >>
    hs := pad32(&h)
    ss := marshal_g1(&s) or >>
    $out := []int{}
    append_s($&out, &hs)
    append_s($&out, &ss)
    << string_from_bytes(out)
}

pub fn sign(dsa &string, mpk &string, msg &string) string {
    $k := 0
    while k < 64 {
        rv := rand_scalar() or >>
        rs := pad32(&rv)
        sig := sign_r(dsa, mpk, msg, &rs) or (err) {
            k = k + 1
            ->
        }
        << sig
    }
    >> errors.new("crypto/sm9: sign retry")
}

pub fn verify(mpk &string, id &string, msg &string, sig &string) bool {
    if sig.len != SIGNATURE_SIZE {
        << false
    }
    pk := parse_g2(mpk) or (err) { << false }
    h := from_be32(sig, 0)
    n := field_n() or (err) { << false }
    $one := big.new_int(1)
    if h.cmp(&one) < 0 || h.cmp(&n) >= 0 {
        << false
    }
    $sb := []int{}
    $i := 32
    while i < SIGNATURE_SIZE {
        sb.push(sig[i] & 255)
        i = i + 1
    }
    ss := string_from_bytes(sb)
    s := parse_g1(&ss) or (err) { << false }
    sa := g1_aff(&s) or (err) { << false }
    sax := int_clone(&sa.x)
    say := int_clone(&sa.y)
    on := g1_on(&sax, &say) or (err) { << false }
    if !on {
        << false
    }
    p1 := p1_point() or (err) { << false }
    g := pairing(&p1, &pk) or (err) { << false }
    t := gt_exp(&g, &h) or (err) { << false }
    zid := id_hid(id, HID_SIGN)
    h1 := hash_hn(&zid, 1) or (err) { << false }
    p2 := p2_point() or (err) { << false }
    h1p := g2_mul(&h1, &p2) or (err) { << false }
    p := g2_add(&h1p, &pk) or (err) { << false }
    u := pairing(&sa, &p) or (err) { << false }
    wp := fp12_mul(&u, &t) or (err) { << false }
    wb := fp12_to_bytes(&wp)
    $zb := []int{}
    append_s($&zb, msg)
    append_s($&zb, &wb)
    zs := string_from_bytes(zb)
    h2 := hash_hn(&zs, 2) or (err) { << false }
    << h2.cmp(&h) == 0
}

pub fn encrypt_r(mpk &string, id &string, msg &string, r &string) string {
    pk := parse_g1(mpk) or >>
    rv := parse_scalar(r) or >>
    zid := id_hid(id, HID_ENC)
    h1 := hash_hn(&zid, 1) or >>
    p1 := p1_point() or >>
    h1p := g1_mul(&h1, &p1) or >>
    qb := g1_add(&h1p, &pk) or >>
    c1 := g1_mul(&rv, &qb) or >>
    p2 := p2_point() or >>
    g := pairing(&pk, &p2) or >>
    w := gt_exp(&g, &rv) or >>
    wb := fp12_to_bytes(&w)
    c1r := marshal_g1_raw(&c1) or >>
    $kd := []int{}
    append_s($&kd, &c1r)
    append_s($&kd, &wb)
    append_s($&kd, id)
    kds := string_from_bytes(kd)
    key := kdf(&kds, msg.len + 32) or >>
    if all_zero(&key) {
        >> errors.new("crypto/sm9: kdf zero")
    }
    $kb := []int{}
    $i := 0
    while i < key.len {
        kb.push(key[i] & 255)
        i = i + 1
    }
    i = 0
    while i < msg.len {
        kb[i] = (kb[i] & 255) ^ (msg[i] & 255)
        i = i + 1
    }
    ks := string_from_bytes(kb)
    c3 := sm3.sum_bytes(ks + "")
    $c2 := []int{}
    i = 0
    while i < msg.len {
        c2.push(kb[i] & 255)
        i = i + 1
    }
    c1s := marshal_g1(&c1) or >>
    $out := []int{}
    append_s($&out, &c1s)
    append_s($&out, &c3)
    i = 0
    while i < c2.len {
        out.push(c2[i] & 255)
        i = i + 1
    }
    << string_from_bytes(out)
}

pub fn encrypt(mpk &string, id &string, msg &string) string {
    $k := 0
    while k < 64 {
        rv := rand_scalar() or >>
        rs := pad32(&rv)
        ct := encrypt_r(mpk, id, msg, &rs) or (err) {
            k = k + 1
            ->
        }
        << ct
    }
    >> errors.new("crypto/sm9: encrypt retry")
}

pub fn decrypt(d &string, id &string, ct &string) string {
    if ct.len < G1_SIZE + 32 {
        >> errors.new("crypto/sm9: ciphertext")
    }
    db := parse_g2(d) or >>
    $c1b := []int{}
    $i := 0
    while i < G1_SIZE {
        c1b.push(ct[i] & 255)
        i = i + 1
    }
    c1s := string_from_bytes(c1b)
    c1 := parse_g1(&c1s) or >>
    $c3b := []int{}
    i = G1_SIZE
    while i < 97 {
        c3b.push(ct[i] & 255)
        i = i + 1
    }
    c3 := string_from_bytes(c3b)
    $c2b := []int{}
    i = 97
    while i < ct.len {
        c2b.push(ct[i] & 255)
        i = i + 1
    }
    c2 := string_from_bytes(c2b)
    da := g2_aff(&db) or >>
    ca := g1_aff(&c1) or >>
    w := pairing(&ca, &da) or >>
    wb := fp12_to_bytes(&w)
    c1r := marshal_g1_raw(&c1) or >>
    $kd := []int{}
    append_s($&kd, &c1r)
    append_s($&kd, &wb)
    append_s($&kd, id)
    kds := string_from_bytes(kd)
    key := kdf(&kds, c2.len + 32) or >>
    $kb := []int{}
    i = 0
    while i < key.len {
        kb.push(key[i] & 255)
        i = i + 1
    }
    i = 0
    while i < c2.len {
        kb[i] = (kb[i] & 255) ^ (c2[i] & 255)
        i = i + 1
    }
    $macin := []int{}
    i = 0
    while i < c2.len {
        macin.push(c2[i] & 255)
        i = i + 1
    }
    i = c2.len
    while i < kb.len {
        macin.push(kb[i] & 255)
        i = i + 1
    }
    got := sm3.sum_bytes(string_from_bytes(macin))
    if subtle.constant_time_compare(&got, &c3) != 1 {
        >> errors.new("crypto/sm9: decrypt")
    }
    $pt := []int{}
    i = 0
    while i < c2.len {
        pt.push(kb[i] & 255)
        i = i + 1
    }
    << string_from_bytes(pt)
}
