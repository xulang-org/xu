@crypto/sm9

// XU-CT-USE: fixed-shape-only
// Confirmation equality is narrow; the parent SM9 backend is variable-time.

#errors
#math/big
#crypto/sm3
#crypto/subtle

// GM/T 0044.4 identifier key exchange. hid=0x02.
// Initiator: exch_new → init_r → confirm_responder.
// Responder: exch_new → respond_r → confirm_initiator.
// Optional SM3 MACs use prefixes 0x82 / 0x83. No ASN.1.

pub struct ExchCap {
    pub point string
    pub mac string
    pub key string
}

pub struct Exch {
    gen_sig bool
    klen int
    uid string
    peer string
    de G2
    mpk G1
    r big.Int
    secret G1
    peer_sec G1
    g1 Fp12
    g2 Fp12
    g3 Fp12
    ready int
}

fn enc_peer_pub(mpk &G1, id &string, hid int) G1 {
    z := id_hid(id, hid)
    h1 := hash_hn(&z, 1) or >>
    p1 := p1_point() or >>
    h1p := g1_mul(&h1, &p1) or >>
    << g1_add(&h1p, mpk)
}

fn skip_prefix(s &string) string {
    if s.len <= 1 {
        << ""
    }
    mut b := []int{}
    mut i := 1
    while i < s.len {
        b.push(s[i] & 255)
        i = i + 1
    }
    << string_from_bytes(b)
}

fn exch_mac(e &mut Exch, is_resp bool, prefix int) string {
    g2b := fp12_to_bytes(&e.g2)
    g3b := fp12_to_bytes(&e.g3)
    sa := marshal_g1(&e.secret) or >>
    sp := marshal_g1(&e.peer_sec) or >>
    ra := skip_prefix(&sa)
    rb := skip_prefix(&sp)
    mut inner := []int{}
    append_s(mut &inner, &g2b)
    append_s(mut &inner, &g3b)
    if is_resp {
        append_s(mut &inner, &e.peer)
        append_s(mut &inner, &e.uid)
        append_s(mut &inner, &rb)
        append_s(mut &inner, &ra)
    } else {
        append_s(mut &inner, &e.uid)
        append_s(mut &inner, &e.peer)
        append_s(mut &inner, &ra)
        append_s(mut &inner, &rb)
    }
    h := sm3.sum_bytes(string_from_bytes(inner))
    g1b := fp12_to_bytes(&e.g1)
    mut outer := []int{}
    outer.push(prefix & 255)
    append_s(mut &outer, &g1b)
    append_s(mut &outer, &h)
    << sm3.sum_bytes(string_from_bytes(outer))
}

fn exch_key(e &mut Exch, is_resp bool) string {
    sa := marshal_g1(&e.secret) or >>
    sp := marshal_g1(&e.peer_sec) or >>
    ra := skip_prefix(&sa)
    rb := skip_prefix(&sp)
    g1b := fp12_to_bytes(&e.g1)
    g2b := fp12_to_bytes(&e.g2)
    g3b := fp12_to_bytes(&e.g3)
    mut z := []int{}
    if is_resp {
        append_s(mut &z, &e.peer)
        append_s(mut &z, &e.uid)
        append_s(mut &z, &rb)
        append_s(mut &z, &ra)
    } else {
        append_s(mut &z, &e.uid)
        append_s(mut &z, &e.peer)
        append_s(mut &z, &ra)
        append_s(mut &z, &rb)
    }
    append_s(mut &z, &g1b)
    append_s(mut &z, &g2b)
    append_s(mut &z, &g3b)
    zs := string_from_bytes(z)
    << kdf(&zs, e.klen)
}

fn pair_mpk(mpk &G1) Fp12 {
    p2 := p2_point() or >>
    << pairing(mpk, &p2)
}

pub fn exch_new(duk &string, mpk &string, uid &string, peer &string, klen int, gen_sig bool) Exch {
    if klen <= 0 {
        >> errors.new("crypto/sm9: bad key length")
    }
    de := parse_g2(duk) or >>
    pk := parse_g1(mpk) or >>
    << Exch{
        gen_sig: gen_sig,
        klen: klen,
        uid: uid + "",
        peer: peer + "",
        de: de,
        mpk: pk,
        r: big.new_int(0),
        secret: g1_inf(),
        peer_sec: g1_inf(),
        g1: fp12_one(),
        g2: fp12_one(),
        g3: fp12_one(),
        ready: 0
    }
}

pub fn (e &mut Exch) init_r(r &string) string {
    rv := parse_scalar(r) or >>
    e.r = int_clone(&rv)
    pk := g1_copy(&e.mpk)
    id := e.peer + ""
    qb := enc_peer_pub(&pk, &id, hid_exch) or >>
    rv2 := int_clone(&e.r)
    ra := g1_mul(&rv2, &qb) or >>
    e.secret = g1_copy(&ra)
    e.ready = 1
    << marshal_g1(&e.secret)
}

pub fn (e &mut Exch) init() string {
    rv := rand_scalar() or >>
    rs := pad32(&rv)
    << e.init_r(&rs)
}

pub fn (e &mut Exch) respond_r(r &string, ra &string) ExchCap {
    p := parse_g1(ra) or >>
    if g1_is_inf(&p) {
        >> errors.new("crypto/sm9: bad RA")
    }
    e.peer_sec = g1_copy(&p)
    rv := parse_scalar(r) or >>
    e.r = int_clone(&rv)
    pk := g1_copy(&e.mpk)
    id := e.peer + ""
    qa := enc_peer_pub(&pk, &id, hid_exch) or >>
    rv2 := int_clone(&e.r)
    rb := g1_mul(&rv2, &qa) or >>
    e.secret = g1_copy(&rb)
    ps := g1_copy(&e.peer_sec)
    de := g2_copy(&e.de)
    g1p := pairing(&ps, &de) or >>
    e.g1 = fp12_clone(&g1p)
    g1c := fp12_clone(&e.g1)
    rvc := int_clone(&e.r)
    g3p := gt_exp(&g1c, &rvc) or >>
    e.g3 = fp12_clone(&g3p)
    base := pair_mpk(&pk) or >>
    rvd := int_clone(&e.r)
    g2p := gt_exp(&base, &rvd) or >>
    e.g2 = fp12_clone(&g2p)
    e.ready = 2
    pt := marshal_g1(&e.secret) or >>
    mut mac := ""
    if e.gen_sig {
        mac = exch_mac(e, true, 130) or >>
    }
    << ExchCap{point: pt, mac: mac, key: ""}
}

pub fn (e &mut Exch) respond(ra &string) ExchCap {
    rv := rand_scalar() or >>
    rs := pad32(&rv)
    << e.respond_r(&rs, ra)
}

pub fn (e &mut Exch) confirm_responder(rb &string, sb &string) ExchCap {
    if e.ready < 1 {
        >> errors.new("crypto/sm9: exch not inited")
    }
    p := parse_g1(rb) or >>
    if g1_is_inf(&p) {
        >> errors.new("crypto/sm9: bad RB")
    }
    e.peer_sec = g1_copy(&p)
    pk := g1_copy(&e.mpk)
    base := pair_mpk(&pk) or >>
    rvc := int_clone(&e.r)
    g1p := gt_exp(&base, &rvc) or >>
    e.g1 = fp12_clone(&g1p)
    ps := g1_copy(&e.peer_sec)
    de := g2_copy(&e.de)
    g2p := pairing(&ps, &de) or >>
    e.g2 = fp12_clone(&g2p)
    g2c := fp12_clone(&e.g2)
    rvd := int_clone(&e.r)
    g3p := gt_exp(&g2c, &rvd) or >>
    e.g3 = fp12_clone(&g3p)
    e.ready = 2
    if e.gen_sig {
        if sb.len != 32 {
            >> errors.new("crypto/sm9: bad SB")
        }
        want := exch_mac(e, false, 130) or >>
        if subtle.constant_time_compare(&want, sb) != 1 {
            >> errors.new("crypto/sm9: bad SB")
        }
    }
    key := exch_key(e, false) or >>
    mut mac := ""
    if e.gen_sig {
        mac = exch_mac(e, false, 131) or >>
    }
    << ExchCap{point: "", mac: mac, key: key}
}

pub fn (e &mut Exch) confirm_initiator(sa &string) string {
    if e.ready < 2 {
        >> errors.new("crypto/sm9: exch not ready")
    }
    if e.gen_sig {
        if sa.len != 32 {
            >> errors.new("crypto/sm9: bad SA")
        }
        want := exch_mac(e, true, 131) or >>
        if subtle.constant_time_compare(&want, sa) != 1 {
            >> errors.new("crypto/sm9: bad SA")
        }
    }
    << exch_key(e, true)
}
