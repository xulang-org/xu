@crypto/sm9

#errors
#math/big

// G1: y² = x³+5 over Fp. G2: y² = x³+5u over Fp2. Jacobian, a = 0.

struct G1 {
    x big.Int
    y big.Int
    z big.Int
}

struct G2 {
    x Fp2
    y Fp2
    z Fp2
}

struct G2j {
    x Fp2
    y Fp2
    z Fp2
    t Fp2
}

struct Line {
    r G2j
    a Fp2
    b Fp2
    c Fp2
}

fn g1_copy(p &G1) G1 {
    $x := int_clone(&p.x)
    $y := int_clone(&p.y)
    $z := int_clone(&p.z)
    << G1{x: x, y: y, z: z}
}

fn g2_copy(p &G2) G2 {
    $x := fp2_clone(&p.x)
    $y := fp2_clone(&p.y)
    $z := fp2_clone(&p.z)
    << G2{x: x, y: y, z: z}
}

fn g1_inf() G1 {
    << G1{x: big.new_int(0), y: big.new_int(1), z: big.new_int(0)}
}

fn g1_is_inf(p &G1) bool {
    z := &p.z
    << z.sign() == 0
}

fn p1_point() G1 {
    x := hex_fp("93de051d62bf718ff5ed0704487d01d6e1e4086909dc3280e8c4e4817c66dddd") or >>
    y := hex_fp("21fe8dda4f21e607631065125c395bbc1c1c00cbfa6024350c464cd70a3ea616") or >>
    << G1{x: x, y: y, z: big.new_int(1)}
}

fn p2_point() G2 {
    xx := hex_fp("85aef3d078640c98597b6027b441a01ff1dd2c190f5e93c454806c11d8806141") or >>
    xy := hex_fp("3722755292130b08d2aab97fd34ec120ee265948d19c17abf9b7213baf82d65b") or >>
    yx := hex_fp("17509b092e845c1266ba0d262cbee6ed0736a96fa347c8bd856dc76b84ebeb96") or >>
    yy := hex_fp("a7cf28d519be3da65f3170153d278ff247efba98a71a08116215bba5c999a7c7") or >>
    << G2{x: Fp2{x: xx, y: xy}, y: Fp2{x: yx, y: yy}, z: fp2_one()}
}

fn g1_aff(p &G1) G1 {
    if g1_is_inf(p) {
        << g1_inf()
    }
    pmod := field_p() or >>
    z := int_clone(&p.z)
    zi := fe_inv(&z, &pmod) or >>
    z2 := fe_sq(&zi, &pmod) or >>
    z3 := fe_mul(&z2, &zi, &pmod) or >>
    x := int_clone(&p.x)
    y := int_clone(&p.y)
    xn := fe_mul(&x, &z2, &pmod) or >>
    yn := fe_mul(&y, &z3, &pmod) or >>
    << G1{x: xn, y: yn, z: big.new_int(1)}
}

fn g1_dbl(p &G1) G1 {
    if g1_is_inf(p) {
        << g1_inf()
    }
    pmod := field_p() or >>
    x1 := int_clone(&p.x)
    y1 := int_clone(&p.y)
    z1 := int_clone(&p.z)
    a := fe_sq(&x1, &pmod) or >>
    b := fe_sq(&y1, &pmod) or >>
    c := fe_sq(&b, &pmod) or >>
    xb := fe_add(&x1, &b, &pmod) or >>
    t0 := fe_sq(&xb, &pmod) or >>
    t1 := fe_sub(&t0, &a, &pmod) or >>
    t2 := fe_sub(&t1, &c, &pmod) or >>
    d := fe_add(&t2, &t2, &pmod) or >>
    e0 := fe_add(&a, &a, &pmod) or >>
    e := fe_add(&e0, &a, &pmod) or >>
    f := fe_sq(&e, &pmod) or >>
    d2 := fe_add(&d, &d, &pmod) or >>
    x3 := fe_sub(&f, &d2, &pmod) or >>
    dx := fe_sub(&d, &x3, &pmod) or >>
    y0 := fe_mul(&e, &dx, &pmod) or >>
    c2 := fe_add(&c, &c, &pmod) or >>
    c4 := fe_add(&c2, &c2, &pmod) or >>
    c8 := fe_add(&c4, &c4, &pmod) or >>
    y3 := fe_sub(&y0, &c8, &pmod) or >>
    yz := fe_mul(&y1, &z1, &pmod) or >>
    z3 := fe_add(&yz, &yz, &pmod) or >>
    << G1{x: x3, y: y3, z: z3}
}

fn g1_add(p &G1, q &G1) G1 {
    if g1_is_inf(p) {
        << g1_copy(q)
    }
    if g1_is_inf(q) {
        << g1_copy(p)
    }
    pmod := field_p() or >>
    x1 := int_clone(&p.x)
    y1 := int_clone(&p.y)
    z1 := int_clone(&p.z)
    x2 := int_clone(&q.x)
    y2 := int_clone(&q.y)
    z2 := int_clone(&q.z)
    z12 := fe_sq(&z1, &pmod) or >>
    z22 := fe_sq(&z2, &pmod) or >>
    u1 := fe_mul(&x1, &z22, &pmod) or >>
    u2 := fe_mul(&x2, &z12, &pmod) or >>
    z2_3 := fe_mul(&z2, &z22, &pmod) or >>
    z1_3 := fe_mul(&z1, &z12, &pmod) or >>
    s1 := fe_mul(&y1, &z2_3, &pmod) or >>
    s2 := fe_mul(&y2, &z1_3, &pmod) or >>
    h := fe_sub(&u2, &u1, &pmod) or >>
    r := fe_sub(&s2, &s1, &pmod) or >>
    if h.sign() == 0 {
        if r.sign() == 0 {
            << g1_dbl(p)
        }
        << g1_inf()
    }
    hh := fe_sq(&h, &pmod) or >>
    hhh := fe_mul(&h, &hh, &pmod) or >>
    v := fe_mul(&u1, &hh, &pmod) or >>
    r2 := fe_sq(&r, &pmod) or >>
    v2 := fe_add(&v, &v, &pmod) or >>
    x3a := fe_sub(&r2, &hhh, &pmod) or >>
    x3 := fe_sub(&x3a, &v2, &pmod) or >>
    vx := fe_sub(&v, &x3, &pmod) or >>
    y3a := fe_mul(&r, &vx, &pmod) or >>
    s1h := fe_mul(&s1, &hhh, &pmod) or >>
    y3 := fe_sub(&y3a, &s1h, &pmod) or >>
    z12m := fe_mul(&z1, &z2, &pmod) or >>
    z3 := fe_mul(&z12m, &h, &pmod) or >>
    << G1{x: x3, y: y3, z: z3}
}

fn g1_mul(k &big.Int, p &G1) G1 {
    $r := g1_inf()
    $i := k.bit_len() - 1
    while i >= 0 {
        nxt := g1_dbl(&r) or >>
        r = nxt
        if k.bit(i) == 1 {
            nxt2 := g1_add(&r, p) or >>
            r = nxt2
        }
        i = i - 1
    }
    << r
}

fn g1_on(x &big.Int, y &big.Int) bool {
    pmod := field_p() or >>
    y2 := fe_sq(y, &pmod) or >>
    x2 := fe_sq(x, &pmod) or >>
    x3 := fe_mul(&x2, x, &pmod) or >>
    $five := big.new_int(5)
    rhs := fe_add(&x3, &five, &pmod) or >>
    << y2.cmp(&rhs) == 0
}

fn g2_inf() G2 {
    << G2{x: fp2_zero(), y: fp2_one(), z: fp2_zero()}
}

fn g2_is_inf(p &G2) bool {
    z := fp2_clone(&p.z)
    << fp2_is0(&z)
}

fn g2_dbl(p &G2) G2 {
    if g2_is_inf(p) {
        << g2_inf()
    }
    x1 := fp2_clone(&p.x)
    y1 := fp2_clone(&p.y)
    z1 := fp2_clone(&p.z)
    a := fp2_sqr(&x1) or >>
    b := fp2_sqr(&y1) or >>
    c := fp2_sqr(&b) or >>
    xb := fp2_add(&x1, &b) or >>
    t0 := fp2_sqr(&xb) or >>
    t1 := fp2_sub(&t0, &a) or >>
    t2 := fp2_sub(&t1, &c) or >>
    d := fp2_dbl(&t2) or >>
    e := fp2_trp(&a) or >>
    f := fp2_sqr(&e) or >>
    d2 := fp2_dbl(&d) or >>
    x3 := fp2_sub(&f, &d2) or >>
    dx := fp2_sub(&d, &x3) or >>
    y0 := fp2_mul(&e, &dx) or >>
    $eight := big.new_int(8)
    c8 := fp2_mul_fp(&c, &eight) or >>
    y3 := fp2_sub(&y0, &c8) or >>
    yz := fp2_mul(&y1, &z1) or >>
    z3 := fp2_dbl(&yz) or >>
    << G2{x: x3, y: y3, z: z3}
}

fn g2_add(p &G2, q &G2) G2 {
    if g2_is_inf(p) {
        << g2_copy(q)
    }
    if g2_is_inf(q) {
        << g2_copy(p)
    }
    x1 := fp2_clone(&p.x)
    y1 := fp2_clone(&p.y)
    z1 := fp2_clone(&p.z)
    x2 := fp2_clone(&q.x)
    y2 := fp2_clone(&q.y)
    z2 := fp2_clone(&q.z)
    z12 := fp2_sqr(&z1) or >>
    z22 := fp2_sqr(&z2) or >>
    u1 := fp2_mul(&x1, &z22) or >>
    u2 := fp2_mul(&x2, &z12) or >>
    z2_3 := fp2_mul(&z2, &z22) or >>
    z1_3 := fp2_mul(&z1, &z12) or >>
    s1 := fp2_mul(&y1, &z2_3) or >>
    s2 := fp2_mul(&y2, &z1_3) or >>
    h := fp2_sub(&u2, &u1) or >>
    r := fp2_sub(&s2, &s1) or >>
    if fp2_is0(&h) {
        if fp2_is0(&r) {
            << g2_dbl(p)
        }
        << g2_inf()
    }
    hh := fp2_sqr(&h) or >>
    hhh := fp2_mul(&h, &hh) or >>
    v := fp2_mul(&u1, &hh) or >>
    r2 := fp2_sqr(&r) or >>
    v2 := fp2_dbl(&v) or >>
    x3a := fp2_sub(&r2, &hhh) or >>
    x3 := fp2_sub(&x3a, &v2) or >>
    vx := fp2_sub(&v, &x3) or >>
    y3a := fp2_mul(&r, &vx) or >>
    s1h := fp2_mul(&s1, &hhh) or >>
    y3 := fp2_sub(&y3a, &s1h) or >>
    z12m := fp2_mul(&z1, &z2) or >>
    z3 := fp2_mul(&z12m, &h) or >>
    << G2{x: x3, y: y3, z: z3}
}

fn g2_mul(k &big.Int, p &G2) G2 {
    $r := g2_inf()
    $i := k.bit_len() - 1
    while i >= 0 {
        nxt := g2_dbl(&r) or >>
        r = nxt
        if k.bit(i) == 1 {
            nxt2 := g2_add(&r, p) or >>
            r = nxt2
        }
        i = i - 1
    }
    << r
}

fn g2_aff(p &G2) G2 {
    if g2_is_inf(p) {
        << g2_inf()
    }
    z := fp2_clone(&p.z)
    zi := fp2_inv(&z) or >>
    z2 := fp2_sqr(&zi) or >>
    z3 := fp2_mul(&z2, &zi) or >>
    x := fp2_clone(&p.x)
    y := fp2_clone(&p.y)
    xn := fp2_mul(&x, &z2) or >>
    yn := fp2_mul(&y, &z3) or >>
    << G2{x: xn, y: yn, z: fp2_one()}
}

fn g2_on(x &Fp2, y &Fp2) bool {
    ys := fp2_sqr(y) or >>
    xs := fp2_sqr(x) or >>
    x3 := fp2_mul(&xs, x) or >>
    $five := big.new_int(5)
    bu := Fp2{x: five, y: big.new_int(0)}
    rhs := fp2_add(&x3, &bu) or >>
    rx := int_clone(&ys.x)
    ry := int_clone(&ys.y)
    sx := int_clone(&rhs.x)
    sy := int_clone(&rhs.y)
    << rx.cmp(&sx) == 0 && ry.cmp(&sy) == 0
}
