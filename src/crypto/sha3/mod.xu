@crypto/sha3

#encoding/hex

// SHA-3 / SHAKE aligned with Go `crypto/sha3` (FIPS 202).
// sum256 returns 64-char lowercase hex (same shape as crypto.sha256).
// shake_sum128 returns n raw bytes. Keccak-f[1600] lanes are i64
// carrying u64 bits; rotations use the sha512 mask idiom.
// Clang -O3 always-inlines rotl; Xu M180 will not, so the θ/ρ steps
// write the rotate inline. Digest holds ρ/rc and the θ workspace from
// new256 so write() does not rebuild tables per call.

fn rho_tab() []int {
    $t := []int{}
    t.push(0)
    t.push(1)
    t.push(62)
    t.push(28)
    t.push(27)
    t.push(36)
    t.push(44)
    t.push(6)
    t.push(55)
    t.push(20)
    t.push(3)
    t.push(10)
    t.push(43)
    t.push(25)
    t.push(39)
    t.push(41)
    t.push(45)
    t.push(15)
    t.push(21)
    t.push(8)
    t.push(18)
    t.push(2)
    t.push(61)
    t.push(56)
    t.push(14)
    << t
}

fn rc_tab() []int {
    $t := []int{}
    t.push(1)
    t.push(32898)
    t.push(0 - 9223372036854742902)
    t.push(0 - 9223372034707259392)
    t.push(32907)
    t.push(2147483649)
    t.push(0 - 9223372034707259263)
    t.push(0 - 9223372036854743031)
    t.push(138)
    t.push(136)
    t.push(2147516425)
    t.push(2147483658)
    t.push(2147516555)
    t.push(0 - 9223372036854775669)
    t.push(0 - 9223372036854742903)
    t.push(0 - 9223372036854743037)
    t.push(0 - 9223372036854743038)
    t.push(0 - 9223372036854775680)
    t.push(32778)
    t.push(0 - 9223372034707292150)
    t.push(0 - 9223372034707259263)
    t.push(0 - 9223372036854742912)
    t.push(2147483649)
    t.push(0 - 9223372034707259384)
    << t
}

fn keccakf(a $&[]int, rho &[]int, rc &[]int, c $&[]int, d $&[]int, b $&[]int) {
    for round in 0:24 {
        c[0] = a[0] ^ a[5] ^ a[10] ^ a[15] ^ a[20]
        c[1] = a[1] ^ a[6] ^ a[11] ^ a[16] ^ a[21]
        c[2] = a[2] ^ a[7] ^ a[12] ^ a[17] ^ a[22]
        c[3] = a[3] ^ a[8] ^ a[13] ^ a[18] ^ a[23]
        c[4] = a[4] ^ a[9] ^ a[14] ^ a[19] ^ a[24]
        t0 := c[1]
        d[0] = c[4] ^ (((t0 & 9223372036854775807) << 1) | ((t0 >> 63) & 1))
        t1 := c[2]
        d[1] = c[0] ^ (((t1 & 9223372036854775807) << 1) | ((t1 >> 63) & 1))
        t2 := c[3]
        d[2] = c[1] ^ (((t2 & 9223372036854775807) << 1) | ((t2 >> 63) & 1))
        t3 := c[4]
        d[3] = c[2] ^ (((t3 & 9223372036854775807) << 1) | ((t3 >> 63) & 1))
        t4 := c[0]
        d[4] = c[3] ^ (((t4 & 9223372036854775807) << 1) | ((t4 >> 63) & 1))
        a[0] = a[0] ^ d[0]
        a[5] = a[5] ^ d[0]
        a[10] = a[10] ^ d[0]
        a[15] = a[15] ^ d[0]
        a[20] = a[20] ^ d[0]
        a[1] = a[1] ^ d[1]
        a[6] = a[6] ^ d[1]
        a[11] = a[11] ^ d[1]
        a[16] = a[16] ^ d[1]
        a[21] = a[21] ^ d[1]
        a[2] = a[2] ^ d[2]
        a[7] = a[7] ^ d[2]
        a[12] = a[12] ^ d[2]
        a[17] = a[17] ^ d[2]
        a[22] = a[22] ^ d[2]
        a[3] = a[3] ^ d[3]
        a[8] = a[8] ^ d[3]
        a[13] = a[13] ^ d[3]
        a[18] = a[18] ^ d[3]
        a[23] = a[23] ^ d[3]
        a[4] = a[4] ^ d[4]
        a[9] = a[9] ^ d[4]
        a[14] = a[14] ^ d[4]
        a[19] = a[19] ^ d[4]
        a[24] = a[24] ^ d[4]
        for x in 0:5 {
            for y in 0:5 {
                src := x + 5 * y
                dest := y + 5 * ((2 * x + 3 * y) % 5)
                n := rho[src]
                v := a[src]
                if n == 0 {
                    b[dest] = v
                } else {
                    m := 64 - n
                    b[dest] = ((v & ((1 << m) - 1)) << n) | ((v >> m) & ((1 << n) - 1))
                }
            }
        }
        for x in 0:5 {
            for y in 0:5 {
                x1 := (x + 1) % 5
                x2 := (x + 2) % 5
                i := x + 5 * y
                a[i] = b[i] ^ ((b[x1 + 5 * y] ^ (0 - 1)) & b[x2 + 5 * y])
            }
        }
        a[0] = a[0] ^ rc[round]
    }
}

fn xor_rate(a $&[]int, s &string, off int, rate int) {
    for i in 0:rate {
        sh := 8 * (i % 8)
        lane := i / 8
        a[lane] = a[lane] ^ ((s[off + i] & 255) << sh)
    }
}

fn zeros5() []int {
    $t := []int{}
    t.push(0)
    t.push(0)
    t.push(0)
    t.push(0)
    t.push(0)
    << t
}

fn zeros25() []int {
    $t := []int{}
    for i in 0:25 {
        t.push(0)
    }
    << t
}

fn xor_pad_keccak(a $&[]int, buf &string, rate int, suffix int) {
    $pad := []int{}
    for i in 0:rate {
        pad.push(0)
    }
    rem := buf.len
    for i in 0:rem {
        pad[i] = buf[i] & 255
    }
    pad[rem] = pad[rem] ^ suffix
    pad[rate - 1] = pad[rate - 1] ^ 128
    for i in 0:rate {
        sh := 8 * (i % 8)
        lane := i / 8
        a[lane] = a[lane] ^ ((pad[i] & 255) << sh)
    }
}

fn squeeze(a $&[]int, rho &[]int, rc &[]int, c $&[]int, th $&[]int, b $&[]int, rate int, outlen int) string {
    $out := []int{}
    while out.len < outlen {
        $i := 0
        while i < rate {
            if out.len >= outlen {
                <-
            }
            sh := 8 * (i % 8)
            lane := i / 8
            out.push((a[lane] >> sh) & 255)
            i = i + 1
        }
        if out.len < outlen {
            keccakf(a, rho, rc, c, th, b)
        }
    }
    << string_from_bytes(out)
}

fn keccak(msg &string, rate int, suffix int, outlen int) string {
    rho := rho_tab()
    rc := rc_tab()
    $a := zeros25()
    $c := zeros5()
    $th := zeros5()
    $b := zeros25()
    n := msg.len
    $off := 0
    while off + rate <= n {
        xor_rate($&a, msg, off, rate)
        keccakf($&a, &rho, &rc, $&c, $&th, $&b)
        off += rate
    }
    rem := n - off
    $padb := []int{}
    for i in 0:rem {
        padb.push(msg[off + i] & 255)
    }
    buf := string_from_bytes(padb)
    xor_pad_keccak($&a, &buf, rate, suffix)
    keccakf($&a, &rho, &rc, $&c, $&th, $&b)
    << squeeze($&a, &rho, &rc, $&c, $&th, $&b, rate, outlen)
}

pub fn sum256(s string) string {
    raw := keccak(&s, 136, 6, 32)
    << hex.encode_to_string(raw)
}

pub fn shake_sum128(data &string, n int) string {
    if n < 0 {
        << ""
    }
    << keccak(data, 168, 31, n)
}

pub struct Digest {
    a   []int
    rho []int
    rc  []int
    c   []int
    th  []int
    b   []int
    buf string
    n   int
}

fn (d $&Digest) permute() {
    for round in 0:24 {
        d.c[0] = d.a[0] ^ d.a[5] ^ d.a[10] ^ d.a[15] ^ d.a[20]
        d.c[1] = d.a[1] ^ d.a[6] ^ d.a[11] ^ d.a[16] ^ d.a[21]
        d.c[2] = d.a[2] ^ d.a[7] ^ d.a[12] ^ d.a[17] ^ d.a[22]
        d.c[3] = d.a[3] ^ d.a[8] ^ d.a[13] ^ d.a[18] ^ d.a[23]
        d.c[4] = d.a[4] ^ d.a[9] ^ d.a[14] ^ d.a[19] ^ d.a[24]
        t0 := d.c[1]
        d.th[0] = d.c[4] ^ (((t0 & 9223372036854775807) << 1) | ((t0 >> 63) & 1))
        t1 := d.c[2]
        d.th[1] = d.c[0] ^ (((t1 & 9223372036854775807) << 1) | ((t1 >> 63) & 1))
        t2 := d.c[3]
        d.th[2] = d.c[1] ^ (((t2 & 9223372036854775807) << 1) | ((t2 >> 63) & 1))
        t3 := d.c[4]
        d.th[3] = d.c[2] ^ (((t3 & 9223372036854775807) << 1) | ((t3 >> 63) & 1))
        t4 := d.c[0]
        d.th[4] = d.c[3] ^ (((t4 & 9223372036854775807) << 1) | ((t4 >> 63) & 1))
        d.a[0] = d.a[0] ^ d.th[0]
        d.a[5] = d.a[5] ^ d.th[0]
        d.a[10] = d.a[10] ^ d.th[0]
        d.a[15] = d.a[15] ^ d.th[0]
        d.a[20] = d.a[20] ^ d.th[0]
        d.a[1] = d.a[1] ^ d.th[1]
        d.a[6] = d.a[6] ^ d.th[1]
        d.a[11] = d.a[11] ^ d.th[1]
        d.a[16] = d.a[16] ^ d.th[1]
        d.a[21] = d.a[21] ^ d.th[1]
        d.a[2] = d.a[2] ^ d.th[2]
        d.a[7] = d.a[7] ^ d.th[2]
        d.a[12] = d.a[12] ^ d.th[2]
        d.a[17] = d.a[17] ^ d.th[2]
        d.a[22] = d.a[22] ^ d.th[2]
        d.a[3] = d.a[3] ^ d.th[3]
        d.a[8] = d.a[8] ^ d.th[3]
        d.a[13] = d.a[13] ^ d.th[3]
        d.a[18] = d.a[18] ^ d.th[3]
        d.a[23] = d.a[23] ^ d.th[3]
        d.a[4] = d.a[4] ^ d.th[4]
        d.a[9] = d.a[9] ^ d.th[4]
        d.a[14] = d.a[14] ^ d.th[4]
        d.a[19] = d.a[19] ^ d.th[4]
        d.a[24] = d.a[24] ^ d.th[4]
        for x in 0:5 {
            for y in 0:5 {
                src := x + 5 * y
                dest := y + 5 * ((2 * x + 3 * y) % 5)
                n := d.rho[src]
                v := d.a[src]
                if n == 0 {
                    d.b[dest] = v
                } else {
                    m := 64 - n
                    d.b[dest] = ((v & ((1 << m) - 1)) << n) | ((v >> m) & ((1 << n) - 1))
                }
            }
        }
        for x in 0:5 {
            for y in 0:5 {
                x1 := (x + 1) % 5
                x2 := (x + 2) % 5
                i := x + 5 * y
                d.a[i] = d.b[i] ^ ((d.b[x1 + 5 * y] ^ (0 - 1)) & d.b[x2 + 5 * y])
            }
        }
        d.a[0] = d.a[0] ^ d.rc[round]
    }
}

pub fn new256() Digest {
    << Digest{a: zeros25(), rho: rho_tab(), rc: rc_tab(), c: zeros5(), th: zeros5(), b: zeros25(), buf: "", n: 0}
}

pub fn (d $&Digest) write(p &string) int {
    n := p.len
    if n == 0 {
        << 0
    }
    rate := 136
    $i := 0
    if d.buf.len > 0 {
        need := rate - d.buf.len
        $take := n
        if take > need {
            take = need
        }
        $piece := []int{}
        $bi := 0
        while bi < d.buf.len {
            piece.push(d.buf[bi] & 255)
            bi = bi + 1
        }
        $j := 0
        while j < take {
            piece.push(p[j] & 255)
            j = j + 1
        }
        i = take
        if piece.len == rate {
            block := string_from_bytes(piece)
            xor_rate($&d.a, &block, 0, rate)
            d.permute()
            d.buf = ""
        } else {
            d.buf = string_from_bytes(piece)
        }
    }
    while i + rate <= n {
        xor_rate($&d.a, p, i, rate)
        d.permute()
        i += rate
    }
    if i < n {
        $rest := []int{}
        $j := i
        while j < n {
            rest.push(p[j] & 255)
            j = j + 1
        }
        extra := string_from_bytes(rest)
        r := $&d.buf
        r.push_str(extra)
    }
    d.n = d.n + n
    << n
}

pub fn (d $&Digest) reset() {
    $i := 0
    while i < d.a.len {
        d.a[i] = 0
        i = i + 1
    }
    i = 0
    while i < d.c.len {
        d.c[i] = 0
        i = i + 1
    }
    i = 0
    while i < d.th.len {
        d.th[i] = 0
        i = i + 1
    }
    i = 0
    while i < d.b.len {
        d.b[i] = 0
        i = i + 1
    }
    d.buf = ""
    d.n = 0
}

pub fn (d Digest) size() int {
    << 32
}

pub fn (d Digest) blocksize() int {
    << 136
}

pub fn (d &Digest) sum() string {
    $a := []int{}
    $i := 0
    while i < 25 {
        if i < d.a.len {
            a.push(d.a[i])
        } else {
            a.push(0)
        }
        i = i + 1
    }
    rho := rho_tab()
    rc := rc_tab()
    $c := zeros5()
    $th := zeros5()
    $b := zeros25()
    buf := d.buf + ""
    xor_pad_keccak($&a, &buf, 136, 6)
    keccakf($&a, &rho, &rc, $&c, $&th, $&b)
    raw := squeeze($&a, &rho, &rc, $&c, $&th, $&b, 136, 32)
    << hex.encode_to_string(raw)
}
