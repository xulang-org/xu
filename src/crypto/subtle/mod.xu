@crypto/subtle

#errors

// Helpers aligned with Go `crypto/subtle`.
//
// XU-CT-CONTRACT v1: constant_time_compare, constant_time_byte_eq,
// constant_time_eq and constant_time_select have a fixed iteration count and
// branchless result selection for caller-provided public shapes. A compare
// length mismatch is public-shape validation and may return early. xor_bytes
// is not in the contracted set. This contract does not make AES, big.Int, RSA,
// ECDSA/ECDH or other consumers constant-time.
// XU-CT-CLASS: constant-time-contracted

pub fn constant_time_compare(x &string, y &string) int {
    if x.len != y.len {
        << 0
    }
    $v := 0
    for i in 0:x.len {
        v = v | ((x[i] & 255) ^ (y[i] & 255))
    }
    nz := ((v | (0 - v)) >> 63) & 1
    << 1 - nz
}

pub fn constant_time_byte_eq(x int, y int) int {
    z := ((x & 255) ^ (y & 255))
    nz := ((z | (0 - z)) >> 63) & 1
    << 1 - nz
}

pub fn constant_time_eq(x int, y int) int {
    z := x ^ y
    nz := ((z | (0 - z)) >> 63) & 1
    << 1 - nz
}

pub fn constant_time_select(v int, x int, y int) int {
    mask := 0 - (v & 1)
    << (mask & x) | ((mask ^ (0 - 1)) & y)
}

pub fn xor_bytes(x &string, y &string) string {
    if x.len != y.len {
        >> errors.new("crypto/subtle: xor_bytes length mismatch")
    }
    xa := x + ""
    ya := y + ""
    $out := []int{}
    for i in 0:x.len {
        out.push((xa[i] & 255) ^ (ya[i] & 255))
    }
    << string_from_bytes(out)
}
