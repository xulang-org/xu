@crypto/sha256

#encoding/hex

// SHA-256 aligned with Go `crypto/sha256` (Sum256 + a Digest with
// Write/Reset/Size/BlockSize/Sum). Pure i64 integer arithmetic: sources
// of 32-bit rotations and round results are explicitly masked. Sums and
// left shifts can exceed 32 bits but stay inside i64; final masks keep
// identical bit patterns on every backend. sum256 returns the 64-char lowercase hex digest — Go
// returns [32]byte, Xu strings carry raw bytes, hex is the ergonomic
// shape. Compresses 64-byte windows in place (no full-message copy).
// Digest 按 64 字节窗口就地压缩（write 不整份拼接；sum 拷贝状态再 pad）。
// hmac 等跨包调用走 sum256_bytes（32 原始字节），sum256 仍返回 hex。
//
// Round structure matches the clang -O3 software path in
// xu-bench/tests/bench/cross/sha256_chain.c (K in a table, 16-word circular W[],
// 64 rounds of Sigma/Ch/Maj). Hosted isel turns Sigma xor-trees into
// `ror` + `eor … ror/lsr` and Ch into `bic`; keep the (>>)|(<<) and
// `^ m32` spelling so that matching still fires.

const m32 = 4294967295

struct State {
    h0 int
    h1 int
    h2 int
    h3 int
    h4 int
    h5 int
    h6 int
    h7 int
}

fn iv() State {
    << State{h0: 0x6a09e667, h1: 0xbb67ae85, h2: 0x3c6ef372, h3: 0xa54ff53a, h4: 0x510e527f, h5: 0x9b05688c, h6: 0x1f83d9ab, h7: 0x5be0cd19}
}

fn k256() []int {
    mut k := []int{}
    k.push(0x428a2f98)
    k.push(0x71374491)
    k.push(0xb5c0fbcf)
    k.push(0xe9b5dba5)
    k.push(0x3956c25b)
    k.push(0x59f111f1)
    k.push(0x923f82a4)
    k.push(0xab1c5ed5)
    k.push(0xd807aa98)
    k.push(0x12835b01)
    k.push(0x243185be)
    k.push(0x550c7dc3)
    k.push(0x72be5d74)
    k.push(0x80deb1fe)
    k.push(0x9bdc06a7)
    k.push(0xc19bf174)
    k.push(0xe49b69c1)
    k.push(0xefbe4786)
    k.push(0x0fc19dc6)
    k.push(0x240ca1cc)
    k.push(0x2de92c6f)
    k.push(0x4a7484aa)
    k.push(0x5cb0a9dc)
    k.push(0x76f988da)
    k.push(0x983e5152)
    k.push(0xa831c66d)
    k.push(0xb00327c8)
    k.push(0xbf597fc7)
    k.push(0xc6e00bf3)
    k.push(0xd5a79147)
    k.push(0x06ca6351)
    k.push(0x14292967)
    k.push(0x27b70a85)
    k.push(0x2e1b2138)
    k.push(0x4d2c6dfc)
    k.push(0x53380d13)
    k.push(0x650a7354)
    k.push(0x766a0abb)
    k.push(0x81c2c92e)
    k.push(0x92722c85)
    k.push(0xa2bfe8a1)
    k.push(0xa81a664b)
    k.push(0xc24b8b70)
    k.push(0xc76c51a3)
    k.push(0xd192e819)
    k.push(0xd6990624)
    k.push(0xf40e3585)
    k.push(0x106aa070)
    k.push(0x19a4c116)
    k.push(0x1e376c08)
    k.push(0x2748774c)
    k.push(0x34b0bcb5)
    k.push(0x391c0cb3)
    k.push(0x4ed8aa4a)
    k.push(0x5b9cca4f)
    k.push(0x682e6ff3)
    k.push(0x748f82ee)
    k.push(0x78a5636f)
    k.push(0x84c87814)
    k.push(0x8cc70208)
    k.push(0x90befffa)
    k.push(0xa4506ceb)
    k.push(0xbef9a3f7)
    k.push(0xc67178f2)
    << k
}

fn zeros16() []int {
    mut w := []int{}
    for i in 0:16 {
        w.push(0)
    }
    << w
}

fn pad_tail(s &string, start int, total int) string {
    rem := s.len - start
    mut b := []int{}
    for i in 0:rem {
        b.push(s[start + i])
    }
    b.push(128)
    mut going := 1
    while going == 1 {
        if b.len % 64 == 56 {
            going = 0
        } else {
            b.push(0)
        }
    }
    bits := total * 8
    for j in 0:8 {
        b.push((bits >> (56 - 8 * j)) & 255)
    }
    << string_from_bytes(b)
}

fn raw_state(st &State) string {
    hh := [st.h0, st.h1, st.h2, st.h3, st.h4, st.h5, st.h6, st.h7]
    mut db := []int{}
    for j in 0:8 {
        v := hh[j]
        db.push((v >> 24) & 255)
        db.push((v >> 16) & 255)
        db.push((v >> 8) & 255)
        db.push(v & 255)
    }
    << string_from_bytes(db)
}

fn hash256(s &string) string {
    mut d := new()
    n := s.len
    mut off := 0
    while off + 64 <= n {
        d.compress_block(s, off)
        off += 64
    }
    tail := pad_tail(s, off, n)
    mut po := 0
    while po + 64 <= tail.len {
        d.compress_block(&tail, po)
        po += 64
    }
    << raw_state(&d.st)
}

pub fn sum256_bytes(s string) string {
    << hash256(&s)
}

pub fn sum256(s string) string {
    << hex.encode_to_string(hash256(&s))
}

pub struct Digest {
    st  State
    k   []int
    w   []int
    buf string
    n   int
}

pub fn new() Digest {
    << Digest{st: iv(), k: k256(), w: zeros16(), buf: "", n: 0}
}

fn sha256_hw_supported() int {
    << 0
}

fn sha256_hw_compress_block(st &State, data &string, off int) {
}

fn (d &mut Digest) compress_block(s &string, off int) {
    if sha256_hw_supported() == 1 {
        sha256_hw_compress_block(&d.st, s, off)
        <<
    }
    // 16-word circular W[] (clang -O3 software SHA also keeps a 16-slot
    // schedule). Indices stay in 0..15 so array checks fold; the 64-round
    // kernel is still (>>)|(<<) xor-trees that hosted isel maps to ror/eor.
    mut a := d.st.h0 & m32
    mut b2 := d.st.h1
    mut c2 := d.st.h2
    mut d2 := d.st.h3
    mut e := d.st.h4 & m32
    mut f := d.st.h5
    mut g := d.st.h6
    mut h := d.st.h7
    for i in 0:16 {
        o := off + 4 * i
        d.w[i] = ((s[o] << 24) | (s[o + 1] << 16) | (s[o + 2] << 8) | s[o + 3]) & m32
    }
    for i in 0:64 {
        wi := i & 15
        if i >= 16 {
            x15 := d.w[(i + 1) & 15] & m32
            x2 := d.w[(i + 14) & 15] & m32
            s0 := (((x15 >> 7) | (x15 << 25)) ^ ((x15 >> 18) | (x15 << 14)) ^ ((x15 >> 3) & m32)) & m32
            s1 := (((x2 >> 17) | (x2 << 15)) ^ ((x2 >> 19) | (x2 << 13)) ^ ((x2 >> 10) & m32)) & m32
            d.w[wi] = (d.w[wi] + s0 + d.w[(i + 9) & 15] + s1) & m32
        }
        wv := d.w[wi]
        s1e := (((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7))) & m32
        ch := (e & f) ^ ((e ^ m32) & g)
        t1 := (h + s1e + ch + d.k[i] + wv) & m32
        s0a := (((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19)) ^ ((a >> 22) | (a << 10))) & m32
        maj := (a & b2) ^ (a & c2) ^ (b2 & c2)
        t2 := (s0a + maj) & m32
        h = g
        g = f
        f = e
        e = (d2 + t1) & m32
        d2 = c2
        c2 = b2
        b2 = a
        a = (t1 + t2) & m32
    }
    d.st.h0 = (d.st.h0 + a) & m32
    d.st.h1 = (d.st.h1 + b2) & m32
    d.st.h2 = (d.st.h2 + c2) & m32
    d.st.h3 = (d.st.h3 + d2) & m32
    d.st.h4 = (d.st.h4 + e) & m32
    d.st.h5 = (d.st.h5 + f) & m32
    d.st.h6 = (d.st.h6 + g) & m32
    d.st.h7 = (d.st.h7 + h) & m32
}

pub fn (d &mut Digest) write(p &string) int {
    n := p.len
    if n == 0 {
        << 0
    }
    mut i := 0
    if d.buf.len > 0 {
        need := 64 - d.buf.len
        mut take := n
        if take > need {
            take = need
        }
        mut piece := []int{}
        mut bi := 0
        while bi < d.buf.len {
            piece.push(d.buf[bi] & 255)
            bi = bi + 1
        }
        mut j := 0
        while j < take {
            piece.push(p[j] & 255)
            j = j + 1
        }
        i = take
        if piece.len == 64 {
            block := string_from_bytes(piece)
            d.compress_block(&block, 0)
            d.buf = ""
        } else {
            d.buf = string_from_bytes(piece)
        }
    }
    while i + 64 <= n {
        d.compress_block(p, i)
        i += 64
    }
    if i < n {
        mut rest := []int{}
        mut j := i
        while j < n {
            rest.push(p[j] & 255)
            j = j + 1
        }
        extra := string_from_bytes(rest)
        r := mut &d.buf
        r.push_str(extra)
    }
    d.n = d.n + n
    << n
}

pub fn (d &mut Digest) reset() {
    d.st = iv()
    d.buf = ""
    d.n = 0
}

pub fn (d Digest) size() int {
    << 32
}

pub fn (d Digest) blocksize() int {
    << 64
}

pub fn (d &Digest) sum_bytes() string {
    mut tmp := new()
    tmp.st = State{h0: d.st.h0, h1: d.st.h1, h2: d.st.h2, h3: d.st.h3, h4: d.st.h4, h5: d.st.h5, h6: d.st.h6, h7: d.st.h7}
    buf := d.buf + ""
    tail := pad_tail(&buf, 0, d.n)
    mut po := 0
    while po + 64 <= tail.len {
        tmp.compress_block(&tail, po)
        po += 64
    }
    << raw_state(&tmp.st)
}

pub fn (d &Digest) sum() string {
    << hex.encode_to_string(d.sum_bytes())
}
