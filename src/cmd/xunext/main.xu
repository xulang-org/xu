@main
// Clean modular Xu compiler CLI entry point.
//
// Layer 6 module: pure, ultra-thin entry point that parses environment args
// and delegates execution to the modular driver pipeline.

#xunext/driver
#os

fn main() int {
    argv := os.argv()
    rc := driver.run_cli(&argv) or (err) {
        println("xu: uncaught error")
        <<< 1
    }
    << rc
}
