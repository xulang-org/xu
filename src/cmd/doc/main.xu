@main
// xu-doc — render Xu declarations as stable Markdown (product tool).
// User: `xu-doc [path...] [-o file]` or via `xu doc`.

#os
#net
#html
#path/filepath
#sort
#strings
#xu/scanner
#xu/parser
#xu/ast

struct Comments {
    lines []int
    ends []int
    texts []string
    trailing []int
}

fn str_clone(s &string) string {
    << s + ""
}

fn is_xu_name(name &string) bool {
    n := name.len
    if n < 4 {
        << false
    }
    if name[0] == 46 {
        << false
    }
    << name[n - 3] == 46 && name[n - 2] == 120 && name[n - 1] == 117
}

fn skip_dir_name(name &string) bool {
    if name.len == 0 {
        << true
    }
    << name[0] == 46
}

fn join_child(dir &string, name &string) string {
    d := str_clone(dir)
    n := str_clone(name)
    if d == "." {
        << n
    }
    last := d[d.len - 1] & 255
    if last == 47 || last == 92 {
        << d + n
    }
    << d + "/" + n
}

fn norm_path(p &string) string {
    s := filepath.to_slash(p)
    if s.len >= 2 && s[0] == 46 && s[1] == 47 {
        << s[2:s.len]
    }
    << s
}

fn import_path(mod string) string {
    << mod
}

fn import_text(p &parser.Parser, i int) string {
    path := import_path(p.imports[i] + "")
    mut out := "#" + path
    if i < p.imp_alias.len {
        alias := p.imp_alias[i] + ""
        if alias.len > 0 { out = out + " as " + alias }
    }
    << out
}

fn has_path(files &mut []string, p &string) bool {
    want := str_clone(p)
    for i in 0:files.len {
        if files[i] == want {
            << true
        }
    }
    << false
}

fn add_file(files &mut []string, p string) {
    n := norm_path(&p)
    if n.len == 0 || has_path(files, &n) {
        <<
    }
    files.push(n)
}

fn collect_dir(prog &string, root string, files &mut []string) {
    mut dirs := []string{}
    dirs.push(str_clone(&root))
    mut cursor := 0
    while cursor < dirs.len {
        cur := dirs[cursor] + ""
        cursor += 1
        ents := os.entries(cur + "") or (err) {
            eprintln(prog + ": cannot read " + cur)
            <<< 1
        }
        for i in 0:ents.len {
            nm := ents[i].name + ""
            if nm.len == 0 {
                ->
            }
            child := join_child(&cur, &nm)
            if ents[i].is_dir {
                if !skip_dir_name(&nm) {
                    dirs.push(child)
                }
            } else {
                if is_xu_name(&nm) {
                    add_file(files, child)
                }
            }
        }
    }
}

fn collect_root(prog &string, root string, files &mut []string) {
    r := str_clone(&root)
    info := os.stat(r + "") or (err) {
        eprintln(prog + ": cannot stat " + r)
        <<< 1
    }
    if info.is_dir {
        collect_dir(prog, r, files)
        <<
    }
    base := filepath.base(&r)
    if !is_xu_name(&base) {
        eprintln(prog + ": not a .xu file: " + r)
        <<< 1
    }
    add_file(files, r)
}

fn count_newlines(s &string) int {
    mut n := 0
    for i in 0:s.len {
        if (s[i] & 255) == 10 {
            n += 1
        }
    }
    << n
}

fn scan_comments(src string) Comments {
    mut toks := []ast.Token{}
    scanner.lex_full(src, mut &toks)
    mut out := Comments{lines: []int{}, ends: []int{}, texts: []string{}, trailing: []int{}}
    mut prev_line := 0
    mut prev_code := 0
    for i in 0:toks.len {
        k := toks[i].kind
        if k == ast.tok_eof {
            <-
        }
        if k == ast.tok_newline {
            ->
        }
        if k == ast.tok_comment {
            mut trail := 0
            if prev_code == 1 && prev_line == toks[i].line {
                trail = 1
            }
            text := toks[i].sval + ""
            out.lines.push(toks[i].line)
            out.ends.push(toks[i].line + count_newlines(&text))
            out.texts.push(text)
            out.trailing.push(trail)
            ->
        }
        prev_line = toks[i].line
        prev_code = 1
    }
    << out
}

fn comment_for_decl(c &Comments, line int) string {
    mut hit := -1
    for i in 0:c.lines.len {
        if c.trailing[i] == 0 && c.ends[i] == line - 1 {
            hit = i
        }
    }
    if hit < 0 {
        << ""
    }
    mut first := hit
    while first > 0 {
        prev := first - 1
        if c.trailing[prev] == 0 && c.ends[prev] + 1 == c.lines[first] {
            first = prev
        } else {
            <-
        }
    }
    mut out := ""
    for i in first:hit + 1 {
        if out.len > 0 {
            out = out + "\n"
        }
        out = out + c.texts[i]
    }
    << out
}

fn node_at(p &parser.Parser, i int) ast.Node {
    mut n := ast.mknode(0, 0, 0)
    n.kind = p.nodes[i].kind
    n.line = p.nodes[i].line
    n.col = p.nodes[i].col
    n.ival = p.nodes[i].ival
    n.sval = p.nodes[i].sval
    n.sval2 = p.nodes[i].sval2
    n.a = p.nodes[i].a
    n.b = p.nodes[i].b
    n.c = p.nodes[i].c
    n.d = p.nodes[i].d
    n.e = p.nodes[i].e
    n.next = p.nodes[i].next
    << n
}

fn memo_at(memo &[]string, i int) string {
    if i < 0 || i >= memo.len {
        << ""
    }
    << memo[i] + ""
}

fn type_list_memo(p &parser.Parser, head int, memo &[]string) string {
    mut out := ""
    mut i := head
    mut first := 1
    mut guard := 0
    while i >= 0 && guard < p.nodes.len {
        guard += 1
        if first == 0 { out = out + ", " }
        first = 0
        out = out + memo_at(memo, i)
        i = p.nodes[i].next
    }
    << out
}

fn type_text_at(p &parser.Parser, i int, memo &[]string) string {
    n := node_at(p, i)
    if n.kind == ast.nt_int {
        if n.ival == 1 { << "i32" }
        if n.ival == 2 { << "u32" }
        if n.ival == 3 { << "u8" }
        << "int"
    }
    if n.kind == ast.nt_bool { << "bool" }
    if n.kind == ast.nt_str { << "string" }
    if n.kind == ast.nt_f64 { << "f64" }
    if n.kind == ast.nt_self { << "Self" }
    if n.kind == ast.nt_temp { << "temp" }
    if n.kind == ast.nt_any { << "any" }
    if n.kind == ast.nt_named {
        mut out := n.sval + ""
        if n.a >= 0 { out = out + "#" + type_list_memo(p, n.a, memo) }
        << out
    }
    if n.kind == ast.nt_ref {
        mut out := "&"
        if n.ival == 1 { out = out + "mut " }
        life := n.sval + ""
        if life.len > 0 { out = out + life + " " }
        << out + memo_at(memo, n.a)
    }
    if n.kind == ast.nt_array {
        if n.ival > 0 { << "[" + str(n.ival) + "]" + memo_at(memo, n.a) }
        << "[]" + memo_at(memo, n.a)
    }
    if n.kind == ast.nt_chan { << "chan " + memo_at(memo, n.a) }
    if n.kind == ast.nt_map {
        << "map[" + memo_at(memo, n.a) + "]" + memo_at(memo, n.b)
    }
    if n.kind == ast.nt_fn {
        mut out := "fn(" + type_list_memo(p, n.a, memo) + ")"
        if n.b >= 0 { out = out + " " + memo_at(memo, n.b) }
        << out
    }
    << ast.node_name(n.kind)
}

fn type_text(p &parser.Parser, root int) string {
    if root < 0 || root >= p.nodes.len { << "" }
    nmax := p.nodes.len
    mut order := []int{}
    mut stk := []int{}
    stk.push(root)
    mut guard := 0
    while stk.len > 0 && guard < nmax * 4 {
        guard += 1
        top := stk.len - 1
        i := stk[top]
        if top == 0 { stk = []int{} } else { stk = stk[0:top] }
        if i < 0 || i >= nmax { -> }
        order.push(i)
        n := node_at(p, i)
        if (n.kind == ast.nt_named || n.kind == ast.nt_fn) && n.a >= 0 {
            // Named type arguments are a linked list; each argument's
            // `next` edge is enough for the reverse-order memo walk.
            mut ai := n.a
            mut ac := 0
            while ai >= 0 && ac < nmax {
                stk.push(ai)
                ac += 1
                ai = p.nodes[ai].next
            }
        } else {
            if n.a >= 0 { stk.push(n.a) }
            if n.b >= 0 { stk.push(n.b) }
        }
    }
    mut memo := []string{}
    for _ in 0:nmax { memo.push("") }
    mut k := order.len
    while k > 0 {
        k -= 1
        i := order[k]
        memo[i] = type_text_at(p, i, &memo)
    }
    << memo_at(&memo, root)
}

fn type_list(p &parser.Parser, head int) string {
    mut out := ""
    mut i := head
    mut first := 1
    mut guard := 0
    while i >= 0 && guard < p.nodes.len {
        guard += 1
        if first == 0 { out = out + ", " }
        first = 0
        out = out + type_text(p, i)
        i = p.nodes[i].next
    }
    << out
}

fn type_params(p &parser.Parser, head int, skip_temp bool) string {
    mut out := ""
    mut i := head
    mut guard := 0
    mut first := 1
    while i >= 0 && guard < p.nodes.len {
        guard += 1
        n := node_at(p, i)
        if !(skip_temp && n.sval == "__temp") {
            name := n.sval + ""
            constraint := n.sval2 + ""
            if first == 1 {
                out = out + "#"
                first = 0
            } else {
                out = out + ", "
            }
            out = out + name
            if constraint.len > 0 {
                out = out + ": " + constraint
            }
        }
        i = n.next
    }
    << out
}

fn temp_constraint(p &parser.Parser, head int) string {
    mut i := head
    mut guard := 0
    while i >= 0 && guard < p.nodes.len {
        guard += 1
        n := node_at(p, i)
        if n.sval == "__temp" {
            << n.sval2 + ""
        }
        i = n.next
    }
    << ""
}

fn fn_params(p &parser.Parser, head int, type_param_head int) string {
    mut out := ""
    mut i := head
    mut first := 1
    mut guard := 0
    while i >= 0 && guard < p.nodes.len {
        guard += 1
        n := node_at(p, i)
        param_name := n.sval + ""
        param_mark := n.sval2 + ""
        param_type := n.a
        variadic := n.ival
        next := n.next
        if first == 0 { out = out + ", " }
        first = 0
        mut name := param_name
        mut ty := type_text(p, param_type)
        if ty == "__temp" {
            name = name + "#"
            con := temp_constraint(p, type_param_head)
            if con.len > 0 { name = name + " " + con }
            ty = ""
        } else if param_mark == "@" {
            name = name + "@"
        }
        out = out + name
        if variadic == 1 { out = out + " <->" }
        if ty.len > 0 { out = out + " " + ty }
        i = next
    }
    << out
}

fn fn_signature(p &parser.Parser, d int) string {
    pub_flag := p.nodes[d].ival
    recv_idx := p.nodes[d].d
    name := p.nodes[d].sval + ""
    type_param_head := p.nodes[d].e
    param_head := p.nodes[d].a
    ret_idx := p.nodes[d].b
    mut ret := ""
    if ret_idx >= 0 {
        ret = " " + type_text(p, ret_idx)
    }
    mut out := ""
    if pub_flag == 1 { out = "pub " }
    out = out + "fn "
    if recv_idx >= 0 {
        recv_name := p.nodes[recv_idx].sval + ""
        recv_type := p.nodes[recv_idx].a
        out = out + "(" + recv_name + " " + type_text(p, recv_type) + ") "
    }
    out = out + name
    out = out + type_params(p, type_param_head, true)
    out = out + "(" + fn_params(p, param_head, type_param_head) + ")"
    << out + ret
}

fn emit_comment(out &mut string, c &string) {
    if c.len > 0 {
        out.push_str(c + "\n\n")
    }
}

fn emit_struct(p &parser.Parser, d int, c &string, out &mut string, public_only bool) {
    n := node_at(p, d)
    emit_comment(out, c)
    mut title := ""
    if n.ival == 1 { title = "pub " }
    title = title + "struct " + n.sval + type_params(p, n.e, false)
    out.push_str("### " + title + "\n\n")
    out.push_str("```xu\n" + title + " {\n")
    mut i := n.a
    mut guard := 0
    while i >= 0 && guard < p.nodes.len {
        guard += 1
        f := node_at(p, i)
        if f.ival == 1 {
            out.push_str("    pub ")
            out.push_str(f.sval + " " + type_text(p, f.a) + "\n")
        } else if !public_only {
            out.push_str("    ")
            out.push_str(f.sval + " " + type_text(p, f.a) + "\n")
        }
        i = f.next
    }
    out.push_str("}\n```\n\n")
}

fn emit_interface(p &parser.Parser, d int, c &string, out &mut string) {
    n := node_at(p, d)
    emit_comment(out, c)
    mut title := ""
    if n.ival == 1 { title = "pub " }
    title = title + "struct@ " + n.sval + type_params(p, n.e, false)
    out.push_str("### " + title + "\n\n")
    out.push_str("```xu\n" + title + " {\n")
    mut i := n.a
    mut guard := 0
    while i >= 0 && guard < p.nodes.len {
        guard += 1
        m := node_at(p, i)
        out.push_str("    fn " + m.sval + "(" + type_list(p, m.a) + ")")
        if m.b >= 0 { out.push_str(" " + type_text(p, m.b)) }
        out.push_str("\n")
        i = m.next
    }
    out.push_str("}\n```\n\n")
}

fn emit_enum(p &parser.Parser, d int, c &string, out &mut string) {
    n := node_at(p, d)
    emit_comment(out, c)
    mut title := ""
    if n.ival == 1 { title = "pub " }
    title = title + "enum " + n.sval + type_params(p, n.e, false)
    out.push_str("### " + title + "\n\n")
    out.push_str("```xu\n" + title + " {\n")
    mut i := n.a
    mut guard := 0
    while i >= 0 && guard < p.nodes.len {
        guard += 1
        v := node_at(p, i)
        out.push_str("    " + v.sval)
        if v.a >= 0 { out.push_str("(" + type_list(p, v.a) + ")") }
        out.push_str("\n")
        i = v.next
    }
    out.push_str("}\n```\n\n")
}

fn literal_text(p &parser.Parser, i int) string {
    n := node_at(p, i)
    if n.kind == ast.nk_int { << str(n.ival) }
    if n.kind == ast.nk_bool {
        if n.ival == 1 { << "true" }
        << "false"
    }
    if n.kind == ast.nk_str { << quote_string(n.sval + "") }
    << ast.node_name(n.kind)
}

fn quote_string(s string) string {
    mut out := "\""
    for i in 0:s.len {
        c := s[i] & 255
        if c == 10 { out = out + "\\n" }
        else if c == 13 { out = out + "\\r" }
        else if c == 9 { out = out + "\\t" }
        else if c == 92 { out = out + "\\\\" }
        else if c == 34 { out = out + "\\\"" }
        else { out = out + string_from_byte(c) }
    }
    << out + "\""
}

fn emit_const(p &parser.Parser, d int, c &string, out &mut string) {
    n := node_at(p, d)
    emit_comment(out, c)
    mut head := ""
    if n.ival == 1 { head = "pub " }
    out.push_str("### " + head + "const " + n.sval + "\n")
    out.push_str("```xu\n" + head + "const " + n.sval + " = " + literal_text(p, n.a) + "\n```\n\n")
}

fn emit_fn(p &parser.Parser, d int, c &string, out &mut string) {
    emit_comment(out, c)
    out.push_str("### " + fn_signature(p, d) + "\n\n")
}

fn emit_decl(p &parser.Parser, d int, c &string, out &mut string, public_only bool) {
    k := p.nodes[d].kind
    if public_only && p.nodes[d].ival != 1 && k != ast.nk_interface {
        <<
    }
    if k == ast.nk_fn { emit_fn(p, d, c, out) }
    if k == ast.nk_struct { emit_struct(p, d, c, out, public_only) }
    if k == ast.nk_interface { emit_interface(p, d, c, out) }
    if k == ast.nk_enum { emit_enum(p, d, c, out) }
    if k == ast.nk_const { emit_const(p, d, c, out) }
}

fn normalize_output(s string) string {
    mut out := s + ""
    while out.len > 0 && out[out.len - 1] == 10 {
        out = out[0:out.len - 1]
    }
    << out + "\n"
}

fn emit_file(prog &string, path string, out &mut string, public_only bool) {
    body := read_file(path) or (err) {
        eprintln(prog + ": cannot read " + path)
        <<< 1
    }
    comments := scan_comments(body + "")
    mut toks := []ast.Token{}
    scanner.lex(body, mut &toks, path + "")
    mut p := parser.new_parser(toks)
    p.file_name = path + ""
    p.parse_module()
    out.push_str("## " + p.module_id + "\n\n")
    out.push_str("Source: `" + path + "`\n\n")
    if p.imports.len > 0 {
        out.push_str("### Imports\n\n")
        for i in 0:p.imports.len {
            out.push_str("- `" + import_text(&p, i) + "`\n")
        }
        out.push_str("\n")
    }
    for i in 0:p.decls.len {
        d := p.decls[i]
        line := p.nodes[d].line
        c := comment_for_decl(&comments, line)
        emit_decl(&p, d, &c, out, public_only)
    }
}

fn inline_html(s &string) string {
    mut out := ""
    mut segment := ""
    mut in_code := false
    for i in 0:s.len {
        c := s[i] & 255
        if c == 96 {
            if segment.len > 0 {
                out = out + html.escape_string(&segment)
                segment = ""
            }
            if in_code {
                out = out + "</code>"
            } else {
                out = out + "<code>"
            }
            in_code = !in_code
        } else {
            segment = segment + string_from_byte(c)
        }
    }
    if segment.len > 0 {
        out = out + html.escape_string(&segment)
    }
    if in_code {
        out = out + "</code>"
    }
    << out
}

fn markdown_html(markdown &string) string {
    lines := strings.split(markdown, "\n")
    mut out := ""
    mut in_code := false
    mut in_list := false
    for i in 0:lines.len {
        line := lines[i] + ""
        if line == "```xu" || line == "```" {
            if in_code {
                out = out + "</code></pre></div>\n"
                in_code = false
            } else {
                if in_list {
                    out = out + "</ul>\n"
                    in_list = false
                }
                out = out + "<div class=\"code-block-wrapper\"><pre><code>"
                in_code = true
            }
            ->
        }
        if in_code {
            out = out + html.escape_string(&line) + "\n"
            ->
        }
        if line.len == 0 {
            if in_list {
                out = out + "</ul>\n"
                in_list = false
            }
            ->
        }
        if strings.has_prefix(&line, "### ") {
            if in_list {
                out = out + "</ul>\n"
                in_list = false
            }
            title := line[4:line.len]
            out = out + "<h3>" + inline_html(&title) + "</h3>\n"
            ->
        }
        if strings.has_prefix(&line, "## ") {
            if in_list {
                out = out + "</ul>\n"
                in_list = false
            }
            title := line[3:line.len]
            out = out + "<h2>" + inline_html(&title) + "</h2>\n"
            ->
        }
        if strings.has_prefix(&line, "# ") {
            if in_list {
                out = out + "</ul>\n"
                in_list = false
            }
            title := line[2:line.len]
            out = out + "<h1>" + inline_html(&title) + "</h1>\n"
            ->
        }
        if strings.has_prefix(&line, "- ") {
            if !in_list {
                out = out + "<ul>\n"
                in_list = true
            }
            item := line[2:line.len]
            out = out + "<li>" + inline_html(&item) + "</li>\n"
            ->
        }
        if in_list {
            out = out + "</ul>\n"
            in_list = false
        }
        out = out + "<p>" + inline_html(&line) + "</p>\n"
    }
    if in_code {
        out = out + "</code></pre></div>\n"
    }
    if in_list {
        out = out + "</ul>\n"
    }
    << out
}

fn doc_page(markdown &string) string {
    body := markdown_html(markdown)
    mut out := "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">"
    out = out + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
    out = out + "<meta name=\"generator\" content=\"xu-doc\"><title>XUDOCS</title>"
    out = out + "<style>"
    out = out + ":root{color-scheme:dark;--brand:#FF385C;--bg:#050508;--surface:#121118;--text:#F8FAFC;--muted:#94A3B8;--code:#0F0E13;--border:rgba(255,255,255,.12)}"
    out = out + "*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 20% 0%,rgba(225,29,72,.12),transparent 45%),var(--bg);color:var(--text);font:16px/1.7 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}"
    out = out + ".top{position:sticky;top:0;padding:16px 24px;background:rgba(18,17,24,.9);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);color:var(--brand);font-weight:700;letter-spacing:.08em}"
    out = out + "main{max-width:960px;margin:0 auto;padding:40px 24px 72px}h1{font-size:2rem;line-height:1.2;margin:0 0 28px;color:var(--brand)}h2{font-size:1.45rem;margin:40px 0 8px;border-bottom:1px solid var(--border);padding-bottom:8px}h3{font-size:1.05rem;margin:28px 0 8px;color:var(--brand)}p{color:var(--muted);margin:8px 0 16px}ul{color:var(--muted);padding-left:28px}code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;color:#FBBF24}"
    out = out + ".code-block-wrapper{margin:12px 0 24px;border:1px solid var(--border);border-radius:10px;overflow:auto;background:var(--code);box-shadow:0 8px 24px rgba(0,0,0,.35)}pre{margin:0;padding:18px 20px;min-width:max-content;color:#E2E8F0;font:14px/1.65 ui-monospace,SFMono-Regular,Menlo,monospace}"
    out = out + "a{color:var(--brand)}@media(max-width:640px){main{padding:28px 16px 56px}.top{padding:14px 16px}h1{font-size:1.65rem}}"
    out = out + "</style></head><body><header class=\"top\">XUDOCS · XU declarations</header><main>"
    out = out + body
    out = out + "</main></body></html>\n"
    << out
}

fn request_path(raw &string) string {
    for i in 0:raw.len {
        if (raw[i] & 255) == 63 {
            << text_range(raw, 0, i)
        }
    }
    << raw + ""
}

fn text_range(s &string, start0 int, end0 int) string {
    mut start := start0
    mut end := end0
    if start < 0 { start = 0 }
    if end > s.len { end = s.len }
    if end <= start { << "" }
    mut out := ""
    for i in start:end {
        out = out + string_from_byte(s[i] & 255)
    }
    << out
}

fn request_word(raw &string, which int) string {
    mut first := -1
    mut second := -1
    for i in 0:raw.len {
        if (raw[i] & 255) == 32 {
            if first < 0 {
                first = i
            } else {
                second = i
                <-
            }
        }
    }
    if first < 0 || second < 0 {
        << ""
    }
    if which == 0 {
        << text_range(raw, 0, first)
    }
    << text_range(raw, first + 1, second)
}

fn http_reason(status int) string {
    if status == 200 { << "OK" }
    if status == 400 { << "Bad Request" }
    if status == 404 { << "Not Found" }
    if status == 405 { << "Method Not Allowed" }
    << "Internal Server Error"
}

fn serve_write(fd int, status int, ctype string, body &string) int {
    mut response := "HTTP/1.1 " + str(status) + " " + http_reason(status) + "\r\n"
    response = response + "Content-Type: " + ctype + "\r\n"
    response = response + "Content-Length: " + str(body.len) + "\r\n"
    response = response + "Connection: close\r\n\r\n" + body
    << net.conn_write(fd, &response) or >>
}

fn serve_docs(addr string, markdown string) int {
    page := doc_page(&markdown)
    shown_addr := addr + ""
    listen_addr := addr + ""
    lfd := net.listen(listen_addr) or (err) {
        eprintln("xu-doc: cannot listen on " + shown_addr + ": " + err.msg())
        << 1
    }
    println("XUDOCS listening on http://" + shown_addr + "/")
    mut running := true
    while running {
        fd := net.accept(lfd) or (err) {
            eprintln("xu-doc: accept failed: " + err.msg())
            << 1
        }
        raw := net.conn_read(fd, 65536) or (err) {
            msg := err.msg()
            serve_write(fd, 400, "text/plain; charset=utf-8", &msg) or (e2) { -> }
            net.conn_close(fd) or (e3) { -> }
            ->
        }
        method := request_word(&raw, 0)
        path_raw := request_word(&raw, 1)
        path := request_path(&path_raw)
        mut status := 404
        mut ctype := "text/plain; charset=utf-8"
        mut body := "not found\n"
        if method != "GET" {
            status = 405
            body = "method not allowed\n"
        } else if path == "/" || path == "/index.html" {
            status = 200
            ctype = "text/html; charset=utf-8"
            body = page + ""
        } else if path == "/docs.md" {
            status = 200
            ctype = "text/markdown; charset=utf-8"
            body = markdown + ""
        } else if path == "/health" {
            status = 200
            body = "ok\n"
        }
        serve_write(fd, status, ctype, &body) or (err) { -> }
        net.conn_close(fd) or (err) { -> }
    }
    << 0
}

fn print_usage(prog &string) {
    println("usage: " + prog + " [options] [path...]")
    println("")
    println("Render Xu declarations as Markdown or serve interactive documentation.")
    println("")
    println("Arguments:")
    println("  [path...]           source files or directories to document (default: .)")
    println("")
    println("Options:")
    println("  -o, --output FILE   write document to file instead of stdout")
    println("  --public            include only public declarations and fields")
    println("  --serve             serve documentation on local HTTP server")
    println("  --addr ADDRESS      listen address for --serve (default: 127.0.0.1:6060)")
    println("  -h, --help          show this help message")
}

fn main() int {
    argv := args()
    mut prog := "xu-doc"
    if argv.len > 0 {
        prog = argv[0]
        mut cut := 0 - 1
        for i in 0:prog.len {
            if prog[i] == 47 { cut = i }
        }
        if cut >= 0 { prog = prog[cut + 1:prog.len] }
    }
    mut roots := []string{}
    mut out_path := ""
    mut public_only := false
    mut serve := false
    mut addr := "127.0.0.1:6060"
    mut addr_set := false
    mut skip := 0
    mut i := 1
    while i < argv.len {
        if skip == 1 {
            skip = 0
        } else {
            a := argv[i] + ""
            if a == "-h" || a == "--help" {
                print_usage(&prog)
                << 0
            }
            if a == "-o" || a == "--output" {
                if i + 1 >= argv.len {
                    eprintln(prog + ": -o requires a path")
                    << 1
                }
                out_path = argv[i + 1] + ""
                skip = 1
            } else if a == "--public" {
                public_only = true
            } else if a == "--serve" {
                serve = true
            } else if a == "--addr" {
                if i + 1 >= argv.len {
                    eprintln(prog + ": --addr requires an address")
                    << 1
                }
                addr = argv[i + 1] + ""
                addr_set = true
                skip = 1
            } else if a.len > 0 && a[0] == 45 {
                eprintln(prog + ": unknown flag '" + a + "'")
                << 1
            } else {
                roots.push(a)
            }
        }
        i += 1
    }
    if roots.len == 0 { roots.push(".") }
    if addr_set && !serve {
        eprintln(prog + ": --addr requires --serve")
        << 1
    }
    mut files := []string{}
    for i in 0:roots.len {
        collect_root(&prog, roots[i] + "", mut &files)
    }
    if files.len == 0 {
        eprintln(prog + ": no .xu files")
        << 1
    }
    sort.strings(mut &files)
    mut out := "# Xu documentation\n\n"
    for i in 0:files.len {
        emit_file(&prog, files[i] + "", mut &out, public_only)
    }
    out = normalize_output(out)
    if out_path.len > 0 {
        write_file(out_path, out) or (err) {
            eprintln(prog + ": cannot write " + out_path)
            << 1
        }
        << 0
    }
    if serve {
        << serve_docs(addr, out)
    }
    println(out[0:out.len - 1])
    << 0
}
