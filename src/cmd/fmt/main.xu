@main
// xu-fmt — format Xu sources (product tool; NOT bootstrap).
// User: `xu-fmt file.xu... [-w]` or via `xu fmt`.

#xu/format
#errors

fn main() int {
    argv := args()
    mut prog := "xu-fmt"
    if argv.len > 0 {
        prog = argv[0]
        mut cut := 0 - 1
        for i in 0:prog.len {
            if prog[i] == 47 {
                cut = i
            }
        }
        if cut >= 0 {
            prog = prog[cut + 1:prog.len]
        }
    }
    mut write := 0
    mut paths := []string{}
    mut i := 1
    while i < argv.len {
        if argv[i] == "-w" {
            write = 1
        } else {
            if argv[i] == "-h" || argv[i] == "--help" {
                println("usage: " + prog + " [options] <file.xu...>")
                println("")
                println("Format Xu source files to standard layout.")
                println("")
                println("Arguments:")
                println("  <file.xu...>  Xu source files to format")
                println("")
                println("Options:")
                println("  -w            rewrite files in place instead of writing to stdout")
                println("  -h, --help    show this help message")
                << 0
            } else {
                paths.push(argv[i])
            }
        }
        i = i + 1
    }
    if paths.len == 0 {
        eprintln(prog + ": no input files")
        << 1
    }
    for j in 0:paths.len {
        src := read_file(paths[j]) or (err) {
            eprintln(prog + ": cannot read " + paths[j])
            << 1
        }
        got := format.source(src)
        if write == 1 {
            write_file(paths[j], got) or (err) {
                eprintln(prog + ": cannot write " + paths[j])
                << 1
            }
        } else {
            if got.len > 0 && got[got.len - 1] == 10 {
                println(got[0:got.len - 1])
            } else {
                println(got)
            }
        }
    }
    << 0
}
