@main
#os
#os/exec
struct SetupNotice { percent int
    status string
    finished bool
    code int }
struct SetupReporter { notices chan SetupNotice
    enabled bool }
fn (r &SetupReporter) send(percent int, status string) {
    if !r.enabled { << }
    r.notices <- SetupNotice{percent: percent,status: status,finished: false,code: 0}
}
fn setup_install_worker(target string, self_exe string, version string, notices chan SetupNotice, all_users bool) {
    if xu_target_os() == 2 && all_users && os.getenv("XU_UI_PACK") == "1" && os.getenv("XU_SETUP_ELEVATED") != "1" {
        notices <- SetupNotice{percent: 10,status: "等待管理员授权…",finished: false,code: 0}
        command := exec.command(self_exe, "--all-users", "--gui", "--start", "--elevate-ui", "--prefix", target, "--version", version)
        command.run() or (err) {
            notices <- SetupNotice{percent: 0,status: "未能获得管理员授权，可以重试或选择仅当前用户。",finished: true,code: 1}
            <<
        }
        notices <- SetupNotice{percent: 0,status: "已打开管理员安装窗口。",finished: true,code: 2}
        <<
    }
    reporter := SetupReporter{notices: notices,enabled: true}
    $percent := 0
    $status := "正在准备安装文件…"
    code := execute_install_reported(target, self_exe, version, reporter, $&percent, $&status, all_users, true)
    notices <- SetupNotice{percent: percent,status: status,finished: true,code: code}
}
