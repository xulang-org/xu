@main

#ui
#ui/draw
#ui/layout
#ui/widgets
#time
#math
#os
#path/filepath
#strings
#errors

const SETUP_READY = 0
const SETUP_INSTALLING = 1
const SETUP_FAILED = 2
const SETUP_COMPLETE = 3

struct SetupLaunch {
    target string
    self_exe string
    version string
    all_users bool
    auto_start bool
}

struct SetupView {
    current_user widgets.Radio
    every_user widgets.Radio
    current_label widgets.StyledLabel
    every_label widgets.StyledLabel
    current_id int
    every_id int
    all_users bool
    primary widgets.Button
    secondary widgets.Button
    path widgets.Editor
    details widgets.Editor
    progress widgets.Progress
    primary_label widgets.StyledLabel
    secondary_label widgets.StyledLabel
    title_label widgets.StyledLabel
    path_heading widgets.StyledLabel
    status_label widgets.StyledLabel
    percent_label widgets.StyledLabel
    version_label widgets.StyledLabel
    label_ids []int
    logo_id int
    status_id int
    identity ui.CanvasEvent
    primary_id int
    secondary_id int
    path_id int
    details_id int
    progress_id int
    state int
    target string
    self_exe string
    version string
    reduced bool
    notices chan SetupNotice
}

fn setup_styles() widgets.Styles {
    $styles := widgets.dark_styles()
    styles.background = draw.rgb(23,25,29)
    styles.font.size = 14.0
    styles.font.weight = 400
    styles.button.min_height = 44.0
    styles.checkbox.min_height = 44.0
    styles.button.radius = 7.0
    styles.button.palette.accent = draw.rgb(204,57,61)
    styles.button.palette.focus = draw.rgb(244,138,137)
    styles.button.palette.foreground = draw.rgb(237,237,231)
    styles.button.palette.muted = draw.rgb(158,164,171)
    styles.input.min_height = 48.0
    styles.input.palette.focus = styles.button.palette.focus
    styles.input.palette.border = draw.rgb(73,77,84)
    styles.input.palette.normal = draw.rgb(30,33,38)
    styles.input.palette.foreground = styles.button.palette.foreground
    styles.text_area.palette = styles.input.palette
    styles.text_area.palette.read_only = styles.background
    empty_padding := layout.insets(0.0) >>>
    styles.text_area.padding = empty_padding
    styles.text_area.border_width = 0.0
    styles.text_area.min_height = 72.0
    styles.text_area.font.size = 13.0
    styles.text_area.inherit_font = false
    styles.progress.radius = 4.0
    styles.progress.min_height = 10.0
    styles.progress.palette.accent = styles.button.palette.accent
    << styles
}

fn setup_column(view $&widgets.View, parent int, gap f64) int {
    $style := layout.box_style(layout.BOX_COLUMN)
    style.gap = gap
    style.cross_alignment = layout.CROSS_STRETCH
    << view.add(parent, &style, &layout.Size{width: 0.0,height: 0.0}) >>>
}

fn setup_leaf(view $&widgets.View, parent int, width f64, height f64) int {
    style := layout.box_style(layout.BOX_LEAF)
    id := view.add(parent, &style, &layout.Size{width: width,height: height}) >>>
    << id
}

fn setup_label(context &draw.Context, text string, size f64, muted bool, accent bool) widgets.StyledLabel {
    $label := widgets.styled_label(context, &text)
    styles := setup_styles() >>>
    $style := styles.button.clone()
    style.font.size = size
    style.font.weight = 400
    if size >= 24.0 { style.font.weight = 600 }
    style.inherit_font = false
    style.padding = layout.insets(0.0) >>>
    style.min_width = 0.0
    style.min_height = 0.0
    style.align_x = 0.0
    if muted { style.palette.foreground = styles.button.palette.muted }
    if accent { style.palette.foreground = draw.rgb(237,104,105) }
    label.set_style(&style) >>>
    << label
}

fn setup_label_node(view $&widgets.View, parent int, height f64) int {
    id := setup_leaf(view, parent, 0.0, height) >>>
    view.set_style_measure(id, true) >>>
    << id
}

fn (m $&SetupView) measure_styled(id int, styles &widgets.Styles) layout.Size {
    if id == m.current_id { control := m.current_user.clone()
        label := $&m.current_label
        << control.measure_styled(label, styles) >>> }
    if id == m.every_id { control := m.every_user.clone()
        label := $&m.every_label
        << control.measure_styled(label, styles) >>> }
    if id == m.logo_id { << layout.Size{width: 64.0,height: 64.0} }
    if id == m.primary_id { item := m.primary.clone()
        label := $&m.primary_label
        << item.measure_styled(label, styles) >>> }
    if id == m.secondary_id { item := m.secondary.clone()
        label := $&m.secondary_label
        << item.measure_styled(label, styles) >>> }
    if id == m.path_id { << layout.Size{width: 300.0,height: 28.0} }
    if id == m.details_id { << layout.Size{width: 320.0,height: 52.0} }
    if id == m.progress_id { << layout.Size{width: 320.0,height: 8.0} }
    if id == m.label_ids[1] { label := $&m.title_label
        << label.measure_styled(styles, &styles.button) >>> }
    if id == m.label_ids[3] { label := $&m.path_heading
        << label.measure_styled(styles, &styles.button) >>> }
    if id == m.label_ids[5] { label := $&m.status_label
        << label.measure_styled(styles, &styles.button) >>> }
    if id == m.label_ids[6] { label := $&m.percent_label
        << label.measure_styled(styles, &styles.button) >>> }
    if id == m.label_ids[7] { label := $&m.version_label
        << label.measure_styled(styles, &styles.button) >>> }
    << layout.Size{width: 0.0,height: 0.0}
}

fn (m $&SetupView) draw_node(id int, bounds &layout.Rect, styles &widgets.Styles, frame $&draw.Frame) int {
    if id == m.current_id { control := $&m.current_user
        control.set_bounds(bounds) >>>
        item := m.current_user.clone()
        label := $&m.current_label
        item.paint_styled(frame, label, styles) >>> }
    else if id == m.every_id { control := $&m.every_user
        control.set_bounds(bounds) >>>
        item := m.every_user.clone()
        label := $&m.every_label
        item.paint_styled(frame, label, styles) >>> }
    else if id == m.logo_id { setup_logo(frame, bounds) >>> }
    else if id == m.primary_id {
        item := $&m.primary
        item.set_bounds(bounds) >>>
        control := m.primary.clone()
        label := $&m.primary_label
        control.paint_styled(frame, label, styles) >>>
    } else if id == m.secondary_id {
        item := $&m.secondary
        item.set_bounds(bounds) >>>
        control := m.secondary.clone()
        label := $&m.secondary_label
        control.paint_styled(frame, label, styles) >>>
    } else if id == m.path_id {
        item := $&m.path
        item.paint_styled(frame, styles) >>>
    } else if id == m.details_id {
        item := $&m.details
        item.paint_styled(frame, styles) >>>
    } else if id == m.progress_id {
        item := $&m.progress
        item.set_bounds(bounds) >>>
        item.paint_styled(frame, styles) >>>
    } else {
        if id == m.label_ids[1] { label := $&m.title_label
            label.paint_text_styled(frame, bounds, styles, &styles.button, 0) >>> }
        if id == m.label_ids[3] { label := $&m.path_heading
            label.paint_text_styled(frame, bounds, styles, &styles.button, 0) >>> }
        if id == m.label_ids[5] { label := $&m.status_label
            label.paint_text_styled(frame, bounds, styles, &styles.button, 0) >>> }
        if id == m.label_ids[6] { label := $&m.percent_label
            label.paint_text_styled(frame, bounds, styles, &styles.button, 0) >>> }
        if id == m.label_ids[7] { label := $&m.version_label
            label.paint_text_styled(frame, bounds, styles, &styles.button, 0) >>> }
    }
    << 0
}

fn (m $&SetupView) paint_styled(id int, bounds &layout.Rect, styles &widgets.Styles, frame $&draw.Frame) bool {
    m.draw_node(id, bounds, styles, frame) >>> (err) { eprintln("xu-setup: " + err.msg())
        << false }
    << true
}
fn (m $&SetupView) overlay_styled(id int, bounds &layout.Rect, styles &widgets.Styles, frame $&draw.Frame) bool { << true }

fn (m $&SetupView) input(id int, kind int, input &ui.InputEvent) widgets.Action {
    if id == m.current_id { control := $&m.current_user
        << control.route(kind, input) >>> }
    if id == m.every_id { control := $&m.every_user
        << control.route(kind, input) >>> }
    if id == m.primary_id { item := $&m.primary
        << item.route(kind, input) >>> }
    if id == m.secondary_id { item := $&m.secondary
        << item.route(kind, input) >>> }
    if id == m.path_id { item := $&m.path
        << item.route(kind, input) >>> }
    if id == m.details_id { item := $&m.details
        << item.route(kind, input) >>> }
    << widgets.Action{kind: widgets.ACTION_NONE,id: id,needs_paint: false,request_focus: false,consumed: false,value: 0.0}
}

fn (m $&SetupView) acknowledge() {
    current := $&m.current_user
    current.painted()
    every := $&m.every_user
    every.painted()
    primary := $&m.primary
    primary.painted()
    secondary := $&m.secondary
    secondary.painted()
    path := $&m.path
    path.painted()
    details := $&m.details
    details.painted()
    progress := $&m.progress
    progress.painted()
}
fn (m $&SetupView) native_event(view $&widgets.View, event &ui.Event) int {
    path := $&m.path
    action := path.event(event) >>>
    if action.needs_paint { view.mark_paint(m.path_id) >>> }
    details := $&m.details
    detail_action := details.event(event) >>>
    if detail_action.needs_paint { view.mark_paint(m.details_id) >>> }
    << 0
}

fn (m $&SetupView) set_label(view $&widgets.View, index int, text string) int {
    if index == 1 { label := $&m.title_label
        label.set_text(&text) }
    if index == 3 { label := $&m.path_heading
        label.set_text(&text) }
    if index == 5 { label := $&m.status_label
        label.set_text(&text) }
    if index == 6 { label := $&m.percent_label
        label.set_text(&text) }
    if index == 7 { label := $&m.version_label
        label.set_text(&text) }
    view.mark_measure(m.label_ids[index]) >>>
    << 0
}

fn (m $&SetupView) notice(view $&widgets.View, notice &SetupNotice) int {
    progress := $&m.progress
    progress.set_value(f64(notice.percent) / 100.0) >>>
    details := $&m.details
    details.set_value(&notice.status) >>>
    m.set_label(view, 6, str(notice.percent) + "%") >>>
    if notice.finished {
        $title := "Installation complete"
        $action := "Done"
        m.state = SETUP_COMPLETE
        if notice.code != 0 { m.state = SETUP_FAILED
            title = "Installation failed"
            action = "Retry" }
        m.set_label(view, 5, title) >>>
        primary := $&m.primary
        primary.set_enabled(true)
        secondary := $&m.secondary
        secondary.set_enabled(true)
        complete := m.state == SETUP_COMPLETE
        failed := m.state == SETUP_FAILED
        path := $&m.path
        path.set_read_only(true) >>>
        current := $&m.current_user
        current.set_enabled(!complete)
        every := $&m.every_user
        every.set_enabled(!complete)
        label := $&m.primary_label
        label.set_text(&action)
        if complete { secondary_label := $&m.secondary_label
            secondary_label.set_text(&"Close") }
        progress := $&m.progress
        progress.set_invalid(failed)
        details := $&m.details
        details.set_invalid(false)
    }
    for id in [m.current_id,m.every_id,m.primary_id,m.secondary_id,m.path_id,m.progress_id,m.details_id] { view.mark_paint(id) >>> }
    << 0
}

fn (m &SetupView) show_status(view $&widgets.View, show_progress bool) int {
    $style := layout.box_style(layout.BOX_COLUMN)
    style.gap = 10.0
    style.cross_alignment = layout.CROSS_STRETCH
    view.set_style(m.status_id, &style) >>>
    $bar := layout.box_style(layout.BOX_LEAF)
    bar.hidden = !show_progress
    view.set_style(m.progress_id, &bar) >>>
    view.set_style(m.label_ids[6], &bar) >>>
    bounds := view.node_bounds(view.root()) >>>
    window := ui.Window{id: m.identity.window_id,generation: m.identity.generation,title: "",width: 0,height: 0,content_kind: ui.CONTENT_DRAW,content_backend_id: m.identity.canvas_id,closed: 0}
    $expanded := 460
    if xu_target_os() == 2 { expanded = 520 }
    window.command("minsize\t600\t" + str(expanded)) >>>
    if bounds.height < f64(expanded - 40) { window.command("size\t" + str(int(bounds.width)) + "\t" + str(expanded)) >>> }
    << 0
}

fn (m $&SetupView) scope(view $&widgets.View, all_users bool) int {
    if m.state == SETUP_INSTALLING || m.state == SETUP_COMPLETE { << 0 }
    target := setup_scope_root(all_users) >>>
    m.all_users = all_users
    m.target = target + ""
    current := $&m.current_user
    current.set_value(!all_users)
    every := $&m.every_user
    every.set_value(all_users)
    path := $&m.path
    path.set_value(&target) >>>
    $title := "Install Xu"
    $action := "Install"
    if setup_has_sdk(&target) { title = "Update Xu"
        action = "Update" }
    m.set_label(view, 1, title) >>>
    label := $&m.primary_label
    label.set_text(&action)
    for id in [m.current_id,m.every_id,m.path_id,m.primary_id] { view.mark_paint(id) >>> }
    << 0
}

fn (m $&SetupView) start(view $&widgets.View) int {
    if m.state == SETUP_INSTALLING || m.state == SETUP_COMPLETE { << 0 }
    target := m.target + ""
    if target.len == 0 {
        m.show_status(view, false) >>>
        m.set_label(view, 5, "Missing installation directory") >>>
        path := $&m.path
        path.set_invalid(true)
        details := $&m.details
        message := "Choose an installation directory."
        details.set_value(&message) >>>
        details.set_invalid(false)
        view.mark_paint(m.details_id) >>>
        << 0
    }
    m.target = filepath.abs(&target) >>>
    m.state = SETUP_INSTALLING
    m.show_status(view, true) >>>
    widgets.cancel_input(view, m) >>>
    primary := $&m.primary
    primary.set_enabled(false)
    secondary := $&m.secondary
    secondary.set_enabled(false)
    current := $&m.current_user
    current.set_enabled(false)
    every := $&m.every_user
    every.set_enabled(false)
    view.mark_paint(m.current_id) >>>
    view.mark_paint(m.every_id) >>>
    path := $&m.path
    path.set_invalid(false)
    path.set_read_only(true) >>>
    progress := $&m.progress
    progress.set_invalid(false)
    details := $&m.details
    details.set_invalid(false)
    label := $&m.primary_label
    label.set_text(&"Installing...")
    m.set_label(view, 5, "Installing") >>>
    preparing := SetupNotice{percent: 10,status: "Preparing SDK files...",finished: false,code: 0}
    m.notice(view, &preparing) >>>
    xu setup_install_worker(m.target + "", m.self_exe + "", m.version + "", m.notices, m.all_users)
    << 0
}

struct SetupTree {
    logo_id int
    title_id int
    current_id int
    every_id int
    path_label_id int
    path_id int
    status_id int
    status_label_id int
    percent_id int
    progress_id int
    details_id int
    version_id int
    secondary_id int
    primary_id int
}

fn setup_build_tree(view $&widgets.View) SetupTree {
    top := setup_column(view, view.root(), 24.0) >>>
    $header_style := layout.box_style(layout.BOX_ROW)
    header_style.gap = 16.0
    header_style.cross_alignment = layout.CROSS_CENTER
    header := view.add(top, &header_style, &layout.Size{width: 0.0,height: 64.0}) >>>
    logo_id := setup_leaf(view, header, 64.0, 64.0) >>>
    title_id := setup_label_node(view, header, 40.0) >>>
    $scope_style := layout.box_style(layout.BOX_ROW)
    scope_style.gap = 24.0
    scope_style.cross_alignment = layout.CROSS_CENTER
    scope_style.hidden = xu_target_os() != 2
    scope_row := view.add(top, &scope_style, &layout.Size{width: 0.0,height: 44.0}) >>>
    current_id := setup_leaf(view, scope_row, 160.0, 44.0) >>>
    every_id := setup_leaf(view, scope_row, 260.0, 44.0) >>>
    destination := setup_column(view, top, 10.0) >>>
    path_label_id := setup_label_node(view, destination, 20.0) >>>
    path_id := setup_leaf(view, destination, 300.0, 28.0) >>>
    $status_style := layout.box_style(layout.BOX_COLUMN)
    status_style.gap = 10.0
    status_style.cross_alignment = layout.CROSS_STRETCH
    status_style.hidden = true
    status := view.add(top, &status_style, &layout.Size{width: 0.0,height: 0.0}) >>>
    $heading_style := layout.box_style(layout.BOX_ROW)
    heading_style.main_alignment = layout.MAIN_SPACE_BETWEEN
    heading_style.cross_alignment = layout.CROSS_CENTER
    heading := view.add(status, &heading_style, &layout.Size{width: 0.0,height: 24.0}) >>>
    status_label_id := setup_label_node(view, heading, 21.0) >>>
    percent_id := setup_label_node(view, heading, 18.0) >>>
    progress_id := setup_leaf(view, status, 300.0, 8.0) >>>
    details_id := setup_leaf(view, status, 300.0, 52.0) >>>
    $footer_style := layout.box_style(layout.BOX_ROW)
    footer_style.main_alignment = layout.MAIN_SPACE_BETWEEN
    footer_style.cross_alignment = layout.CROSS_CENTER
    footer_style.gap = 16.0
    footer := view.add(view.root(), &footer_style, &layout.Size{width: 0.0,height: 44.0}) >>>
    version_id := setup_label_node(view, footer, 18.0) >>>
    $buttons_style := layout.box_style(layout.BOX_ROW)
    buttons_style.gap = 12.0
    buttons_style.cross_alignment = layout.CROSS_CENTER
    buttons := view.add(footer, &buttons_style, &layout.Size{width: 0.0,height: 44.0}) >>>
    secondary_id := setup_leaf(view, buttons, 88.0, 44.0) >>>
    primary_id := setup_leaf(view, buttons, 120.0, 44.0) >>>
    for id in [current_id,every_id,path_id,details_id,primary_id,secondary_id] { view.set_input(id, true, true) >>> }
    for id in [current_id,every_id,path_id,details_id,primary_id,secondary_id,progress_id] { view.set_style_measure(id, true) >>> }
    for id in [current_id,every_id,primary_id,secondary_id] { view.set_cursor(id, ui.CURSOR_HAND) >>> }
    for id in [path_id,details_id] { view.set_cursor(id, ui.CURSOR_TEXT) >>> }
    << SetupTree{logo_id: logo_id,title_id: title_id,current_id: current_id,every_id: every_id,
        path_label_id: path_label_id,path_id: path_id,status_id: status,status_label_id: status_label_id,
        percent_id: percent_id,progress_id: progress_id,details_id: details_id,version_id: version_id,
        secondary_id: secondary_id,primary_id: primary_id}
}

fn setup_make_path_editor(context &draw.Context, identity &ui.CanvasEvent, path_id int, target &string, empty &layout.Rect) widgets.Editor {
    styles := setup_styles() >>>
    $path := widgets.input(context, identity, path_id, empty, target) >>>
    path.apply_styles(&styles) >>>
    path.set_read_only(true) >>>
    $path_style := styles.input.clone()
    path_style.border_width = 0.0
    path_style.padding = layout.insets(0.0) >>>
    path_style.min_height = 28.0
    path_style.palette.read_only = styles.background
    path_style.palette.foreground = styles.button.palette.muted
    path_style.font.size = 13.0
    path_style.inherit_font = false
    path.set_style(&path_style) >>>
    << path
}

fn setup_make_details_editor(context &draw.Context, identity &ui.CanvasEvent, details_id int, empty &layout.Rect) widgets.Editor {
    styles := setup_styles() >>>
    $details := widgets.text_area(context, identity, details_id, empty, &"The SDK will be installed in the directory above.") >>>
    details.apply_styles(&styles) >>>
    details.set_read_only(true) >>>
    << details
}

fn setup_make_primary_button(identity &ui.CanvasEvent, primary_id int, empty &layout.Rect) widgets.Button {
    styles := setup_styles() >>>
    $primary := widgets.button(identity, primary_id, empty) >>>
    $primary_style := styles.button.clone()
    primary_style.palette.normal = draw.rgb(190,48,53)
    primary_style.palette.hovered = draw.rgb(211,63,66)
    primary_style.palette.pressed = draw.rgb(163,38,43)
    primary_style.palette.foreground = draw.rgb(255,244,237)
    primary_style.min_width = 120.0
    primary.set_style(&primary_style) >>>
    << primary
}

fn setup_populate_controls(m $&SetupView, identity &ui.CanvasEvent, tree &SetupTree, empty &layout.Rect, all_users bool) int {
    cu := widgets.radio(identity, tree.current_id, empty, 0, !all_users) >>>
    m.current_user = cu
    eu := widgets.radio(identity, tree.every_id, empty, 1, all_users) >>>
    m.every_user = eu
    sec := widgets.button(identity, tree.secondary_id, empty) >>>
    m.secondary = sec
    prog := widgets.progress(empty, 0.0) >>>
    m.progress = prog
    << 0
}

fn setup_populate_editors(m $&SetupView, context &draw.Context, identity &ui.CanvasEvent, tree &SetupTree, target &string, empty &layout.Rect) int {
    path := setup_make_path_editor(context, identity, tree.path_id, target, empty) >>>
    m.path = path
    details := setup_make_details_editor(context, identity, tree.details_id, empty) >>>
    m.details = details
    primary := setup_make_primary_button(identity, tree.primary_id, empty) >>>
    m.primary = primary
    << 0
}

fn setup_populate_labels(m $&SetupView, context &draw.Context, title string, action string, version string) int {
    tl := setup_label(context, title, 26.0, false, false) >>>
    m.title_label = tl
    ph := setup_label(context, "Installation directory", 13.0, false, false) >>>
    m.path_heading = ph
    sl := setup_label(context, "Ready", 14.0, false, false) >>>
    m.status_label = sl
    pl := setup_label(context, "0%", 13.0, true, false) >>>
    m.percent_label = pl
    vl := setup_label(context, "v" + version + "  -  " + detect_host_platform(), 12.0, true, false) >>>
    m.version_label = vl
    m.current_label = widgets.styled_label(context, &"Current user")
    m.every_label = widgets.styled_label(context, &"All users (requires admin)")
    m.primary_label = widgets.styled_label(context, &action)
    m.secondary_label = widgets.styled_label(context, &"Cancel")
    << 0
}

fn new_setup_view(view $&widgets.View, context &draw.Context, identity &ui.CanvasEvent, target string, self_exe string, version string, all_users bool) SetupView {
    styles := setup_styles() >>>
    view.set_styles(&styles) >>>
    tree := setup_build_tree(view) >>>
    ids := [0,tree.title_id,0,tree.path_label_id,0,tree.status_label_id,tree.percent_id,tree.version_id]
    empty := layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0}
    notices := chan SetupNotice{cap: 64}
    installed := setup_has_sdk(&target)
    $title := "Install Xu"
    $action := "Install"
    if installed { title = "Update Xu"
        action = "Update" }
    tgt := target + ""
    ver := version + ""
    $m := SetupView{current_user: widgets.radio(identity, tree.current_id, &empty, 0, !all_users) >>>,
        every_user: widgets.radio(identity, tree.every_id, &empty, 1, all_users) >>>,
        current_label: widgets.styled_label(context, &""),every_label: widgets.styled_label(context, &""),
        current_id: tree.current_id,every_id: tree.every_id,all_users: all_users,identity: ui.CanvasEvent{window_id: identity.window_id,canvas_id: identity.canvas_id,generation: identity.generation},
        primary: widgets.button(identity, tree.primary_id, &empty) >>>,secondary: widgets.button(identity, tree.secondary_id, &empty) >>>,
        path: widgets.input(context, identity, tree.path_id, &empty, &"") >>>,details: widgets.text_area(context, identity, tree.details_id, &empty, &"") >>>,
        progress: widgets.progress(&empty, 0.0) >>>,primary_label: widgets.styled_label(context, &""),secondary_label: widgets.styled_label(context, &""),
        title_label: widgets.styled_label(context, &""),
        path_heading: widgets.styled_label(context, &""),
        status_label: widgets.styled_label(context, &""),
        percent_label: widgets.styled_label(context, &""),
        version_label: widgets.styled_label(context, &""),
        label_ids: ids,logo_id: tree.logo_id,status_id: tree.status_id,primary_id: tree.primary_id,secondary_id: tree.secondary_id,path_id: tree.path_id,details_id: tree.details_id,progress_id: tree.progress_id,
        state: SETUP_READY,target: target,self_exe: self_exe,version: version,reduced: false,notices: notices}
    setup_populate_controls($&m, identity, &tree, &empty, all_users) >>>
    setup_populate_editors($&m, context, identity, &tree, &tgt, &empty) >>>
    setup_populate_labels($&m, context, title, action, ver) >>>
    << m
}

fn setup_scene(events chan ui.Event, launch &SetupLaunch) int {
    $ready := ui.Event{kind: ui.EV_NONE,window_id: 0,menu_id: "",width: 0,height: 0}
    while ready.kind != ui.EV_CANVAS_READY {
        ready = <-events
        if ready.kind == ui.EV_EXIT || ready.kind == ui.EV_CLOSED || ready.kind == ui.EV_WINDOW_FAILED { << 0 }
    }
    identity := ui.canvas_of(&ready) >>>
    context := draw.context_of(&ready) >>>
    $root := layout.box_style(layout.BOX_COLUMN)
    root.padding = layout.insets(24.0) >>>
    root.gap = 20.0
    root.main_alignment = layout.MAIN_SPACE_BETWEEN
    root.cross_alignment = layout.CROSS_STRETCH
    host := widgets.Host{context: context,identity: identity}
    $view := host.view(&root, draw.rgb(23,25,29)) >>>
    $model := new_setup_view($&view, &context, &identity, launch.target + "", launch.self_exe + "", launch.version + "", launch.all_users) >>> (err) { >>> errors.new("controls: " + err.msg()) }
    ui.request_canvas_preferences(&identity) >>> (err) { >>> errors.new("canvas preferences: " + err.msg()) }
    $width := 640.0
    $height := 300.0
    if xu_target_os() == 2 { height = 380.0 }
    $closing := false
    $window := ui.Window{id: identity.window_id,generation: identity.generation,title: "",width: 640,height: 300,
        content_kind: ui.CONTENT_DRAW,content_backend_id: identity.canvas_id,closed: 0}
    window.content_command("input_enabled\t1") >>>
    window.content_command("pan_enabled\t0") >>>
    $auto_start := launch.auto_start
    while true {
        select {
            notice := <-model.notices {
                if notice.finished && notice.code == 2 { closing = true }
                else { model.notice($&view, &notice) >>> }
            }
            else {}
        }
        constraints := layout.tight(width, height) >>>
        _ := widgets.layout_styled($&view, &constraints, $&model) >>> (err) { >>> errors.new("layout: " + err.msg()) }
        path := $&model.path
        widgets.place_editor($&view, path) >>>
        details := $&model.details
        widgets.place_editor($&view, details) >>>
        now := time.instant()
        reduced := model.reduced
        path := $&model.path
        if path.tick(now, reduced) >>> { view.mark_paint(model.path_id) >>> }
        painted := widgets.present_styled($&view, &constraints, $&model) >>> (err) { >>> errors.new("paint: " + err.msg()) }
        if painted { model.acknowledge() }
        if auto_start { auto_start = false
            model.start($&view) >>> }
        event := ui.poll_chan(events)
        if event.kind == ui.EV_EXIT || event.kind == ui.EV_CLOSED || event.kind == ui.EV_CANVAS_CLOSED { <- }
        if event.kind == ui.EV_CANVAS_METRICS {
            metrics := ui.metrics_of(&event) >>>
            if metrics.width > 0.0 && metrics.height > 0.0 { width = metrics.width
                height = metrics.height
            }
        }
        if event.kind == ui.EV_CANVAS_PREFERENCES {
            preferences := ui.canvas_preferences_of(&event) >>>
            model.reduced = preferences.reduced_motion
        }
        if event.kind != ui.EV_NONE {
            actions := widgets.dispatch_event($&view, &event, $&model) >>>
            model.native_event($&view, &event) >>>
            for action in actions {
                if action.kind == widgets.ACTION_CHANGE && (action.id == model.current_id || action.id == model.every_id) {
                    model.scope($&view, action.id == model.every_id) >>>
                }
                if action.kind == widgets.ACTION_ACTIVATE {
                    if action.id == model.secondary_id && model.state != SETUP_INSTALLING { closing = true }
                    if action.id == model.primary_id {
                        if model.state == SETUP_COMPLETE { closing = true }
                        else { model.start($&view) >>> }
                    }
                }
            }
        }
        if closing { window.request_close() >>>
            <- }
        sleep_ns(12000000)
    }
    path := $&model.path
    path.dispose()
    details := $&model.details
    details.dispose()
    title_label := $&model.title_label
    title_label.dispose()
    path_heading := $&model.path_heading
    path_heading.dispose()
    status_label := $&model.status_label
    status_label.dispose()
    percent_label := $&model.percent_label
    percent_label.dispose()
    version_label := $&model.version_label
    version_label.dispose()
    current_label := $&model.current_label
    current_label.dispose()
    every_label := $&model.every_label
    every_label.dispose()
    primary_label := $&model.primary_label
    primary_label.dispose()
    secondary_label := $&model.secondary_label
    secondary_label.dispose()
    view.dispose()
    << 0
}

fn setup_scene_worker(events chan ui.Event, launch SetupLaunch, results chan int) {
    setup_scene(events, &launch) >>> (err) {
        eprintln("xu-setup: " + err.msg())
        results <- 1
        ui.native_accept_close() >>> (exit_error) { << }
        <<
    }
    results <- 0
}

fn launch_gui_installer(target_dir string, platform string, self_exe string, req_version string, all_users bool, auto_start bool) int {
    << setup_launch_widgets(SetupLaunch{target: target_dir,self_exe: self_exe,version: req_version,all_users: all_users,auto_start: auto_start}) >>> (err) {
        eprintln("xu-setup: Could not open the setup wizard: " + err.msg())
        << 1
    }
}

fn setup_launch_widgets(launch SetupLaunch) int {
    $app := ui.new_app()
    $height := 300
    if xu_target_os() == 2 { height = 380 }
    $window := app.open_content_window(ui.WindowOpts{title: "Xu Setup Wizard",width: 640,height: height}, ui.CONTENT_DRAW) >>>
    window.command("minsize\t600\t" + str(height)) >>>
    results := chan int{cap: 1}
    xu setup_scene_worker(app.event_ch, launch, results)
    code := app.run() >>>
    if code != 0 { << code }
    << <-results
}
