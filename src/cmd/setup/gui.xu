@main

#ui
#ui/draw
#ui/layout
#ui/widgets
#time
#math
#os
#path/filepath
#strings
#errors

const SETUP_READY = 0
const SETUP_INSTALLING = 1
const SETUP_FAILED = 2
const SETUP_COMPLETE = 3

struct SetupLaunch {
    target string
    self_exe string
    version string
    all_users bool
    auto_start bool
}

struct SetupView {
    current_user widgets.Radio
    every_user widgets.Radio
    current_label widgets.StyledLabel
    every_label widgets.StyledLabel
    current_id int
    every_id int
    all_users bool
    primary widgets.Button
    secondary widgets.Button
    path widgets.Editor
    details widgets.Editor
    progress widgets.Progress
    primary_label widgets.StyledLabel
    secondary_label widgets.StyledLabel
    title_label widgets.StyledLabel
    path_heading widgets.StyledLabel
    status_label widgets.StyledLabel
    percent_label widgets.StyledLabel
    version_label widgets.StyledLabel
    label_ids []int
    logo_id int
    status_id int
    identity ui.CanvasEvent
    primary_id int
    secondary_id int
    path_id int
    details_id int
    progress_id int
    state int
    target string
    self_exe string
    version string
    reduced bool
    notices chan SetupNotice
}

fn setup_styles() widgets.Styles {
    mut styles := widgets.dark_styles()
    styles.background = draw.rgb(23,25,29)
    styles.font.size = 14.0
    styles.font.weight = 400
    styles.button.min_height = 44.0
    styles.checkbox.min_height = 44.0
    styles.button.radius = 7.0
    styles.button.palette.accent = draw.rgb(204,57,61)
    styles.button.palette.focus = draw.rgb(244,138,137)
    styles.button.palette.foreground = draw.rgb(237,237,231)
    styles.button.palette.muted = draw.rgb(158,164,171)
    styles.input.min_height = 48.0
    styles.input.palette.focus = styles.button.palette.focus
    styles.input.palette.border = draw.rgb(73,77,84)
    styles.input.palette.normal = draw.rgb(30,33,38)
    styles.input.palette.foreground = styles.button.palette.foreground
    styles.text_area.palette = styles.input.palette
    styles.text_area.palette.read_only = styles.background
    empty_padding := layout.insets(0.0) or >>
    styles.text_area.padding = empty_padding
    styles.text_area.border_width = 0.0
    styles.text_area.min_height = 72.0
    styles.text_area.font.size = 13.0
    styles.text_area.inherit_font = false
    styles.progress.radius = 4.0
    styles.progress.min_height = 10.0
    styles.progress.palette.accent = styles.button.palette.accent
    << styles
}

fn setup_column(view &mut widgets.View, parent int, gap f64) int {
    mut style := layout.box_style(layout.BOX_COLUMN)
    style.gap = gap
    style.cross_alignment = layout.CROSS_STRETCH
    << view.add(parent, &style, &layout.Size{width: 0.0,height: 0.0}) or >>
}

fn setup_leaf(view &mut widgets.View, parent int, width f64, height f64) int {
    style := layout.box_style(layout.BOX_LEAF)
    id := view.add(parent, &style, &layout.Size{width: width,height: height}) or >>
    << id
}

fn setup_label(context &draw.Context, text string, size f64, muted bool, accent bool) widgets.StyledLabel {
    mut label := widgets.styled_label(context, &text)
    styles := setup_styles() or >>
    mut style := styles.button.clone()
    style.font.size = size
    style.font.weight = 400
    if size >= 24.0 { style.font.weight = 600 }
    style.inherit_font = false
    style.padding = layout.insets(0.0) or >>
    style.min_width = 0.0
    style.min_height = 0.0
    style.align_x = 0.0
    if muted { style.palette.foreground = styles.button.palette.muted }
    if accent { style.palette.foreground = draw.rgb(237,104,105) }
    label.set_style(&style) or >>
    << label
}

fn setup_label_node(view &mut widgets.View, parent int, height f64) int {
    id := setup_leaf(view, parent, 0.0, height) or >>
    view.set_style_measure(id, true) or >>
    << id
}

fn (m &mut SetupView) measure_styled(id int, styles &widgets.Styles) layout.Size {
    if id == m.current_id { control := m.current_user.clone()
        label := mut &m.current_label
        << control.measure_styled(label, styles) or >> }
    if id == m.every_id { control := m.every_user.clone()
        label := mut &m.every_label
        << control.measure_styled(label, styles) or >> }
    if id == m.logo_id { << layout.Size{width: 64.0,height: 64.0} }
    if id == m.primary_id { item := m.primary.clone()
        label := mut &m.primary_label
        << item.measure_styled(label, styles) or >> }
    if id == m.secondary_id { item := m.secondary.clone()
        label := mut &m.secondary_label
        << item.measure_styled(label, styles) or >> }
    if id == m.path_id { << layout.Size{width: 300.0,height: 28.0} }
    if id == m.details_id { << layout.Size{width: 320.0,height: 52.0} }
    if id == m.progress_id { << layout.Size{width: 320.0,height: 8.0} }
    if id == m.label_ids[1] { label := mut &m.title_label
        << label.measure_styled(styles, &styles.button) or >> }
    if id == m.label_ids[3] { label := mut &m.path_heading
        << label.measure_styled(styles, &styles.button) or >> }
    if id == m.label_ids[5] { label := mut &m.status_label
        << label.measure_styled(styles, &styles.button) or >> }
    if id == m.label_ids[6] { label := mut &m.percent_label
        << label.measure_styled(styles, &styles.button) or >> }
    if id == m.label_ids[7] { label := mut &m.version_label
        << label.measure_styled(styles, &styles.button) or >> }
    << layout.Size{width: 0.0,height: 0.0}
}

fn (m &mut SetupView) draw_node(id int, bounds &layout.Rect, styles &widgets.Styles, frame &mut draw.Frame) int {
    if id == m.current_id { control := mut &m.current_user
        control.set_bounds(bounds) or >>
        item := m.current_user.clone()
        label := mut &m.current_label
        item.paint_styled(frame, label, styles) or >> }
    else if id == m.every_id { control := mut &m.every_user
        control.set_bounds(bounds) or >>
        item := m.every_user.clone()
        label := mut &m.every_label
        item.paint_styled(frame, label, styles) or >> }
    else if id == m.logo_id { setup_logo(frame, bounds) or >> }
    else if id == m.primary_id {
        item := mut &m.primary
        item.set_bounds(bounds) or >>
        control := m.primary.clone()
        label := mut &m.primary_label
        control.paint_styled(frame, label, styles) or >>
    } else if id == m.secondary_id {
        item := mut &m.secondary
        item.set_bounds(bounds) or >>
        control := m.secondary.clone()
        label := mut &m.secondary_label
        control.paint_styled(frame, label, styles) or >>
    } else if id == m.path_id {
        item := mut &m.path
        item.paint_styled(frame, styles) or >>
    } else if id == m.details_id {
        item := mut &m.details
        item.paint_styled(frame, styles) or >>
    } else if id == m.progress_id {
        item := mut &m.progress
        item.set_bounds(bounds) or >>
        item.paint_styled(frame, styles) or >>
    } else {
        if id == m.label_ids[1] { label := mut &m.title_label
            label.paint_text_styled(frame, bounds, styles, &styles.button, 0) or >> }
        if id == m.label_ids[3] { label := mut &m.path_heading
            label.paint_text_styled(frame, bounds, styles, &styles.button, 0) or >> }
        if id == m.label_ids[5] { label := mut &m.status_label
            label.paint_text_styled(frame, bounds, styles, &styles.button, 0) or >> }
        if id == m.label_ids[6] { label := mut &m.percent_label
            label.paint_text_styled(frame, bounds, styles, &styles.button, 0) or >> }
        if id == m.label_ids[7] { label := mut &m.version_label
            label.paint_text_styled(frame, bounds, styles, &styles.button, 0) or >> }
    }
    << 0
}

fn (m &mut SetupView) paint_styled(id int, bounds &layout.Rect, styles &widgets.Styles, frame &mut draw.Frame) bool {
    m.draw_node(id, bounds, styles, frame) or (err) { eprintln("xu-setup: " + err.msg())
        << false }
    << true
}
fn (m &mut SetupView) overlay_styled(id int, bounds &layout.Rect, styles &widgets.Styles, frame &mut draw.Frame) bool { << true }

fn (m &mut SetupView) input(id int, kind int, input &ui.InputEvent) widgets.Action {
    if id == m.current_id { control := mut &m.current_user
        << control.route(kind, input) or >> }
    if id == m.every_id { control := mut &m.every_user
        << control.route(kind, input) or >> }
    if id == m.primary_id { item := mut &m.primary
        << item.route(kind, input) or >> }
    if id == m.secondary_id { item := mut &m.secondary
        << item.route(kind, input) or >> }
    if id == m.path_id { item := mut &m.path
        << item.route(kind, input) or >> }
    if id == m.details_id { item := mut &m.details
        << item.route(kind, input) or >> }
    << widgets.Action{kind: widgets.ACTION_NONE,id: id,needs_paint: false,request_focus: false,consumed: false,value: 0.0}
}

fn (m &mut SetupView) acknowledge() {
    current := mut &m.current_user
    current.painted()
    every := mut &m.every_user
    every.painted()
    primary := mut &m.primary
    primary.painted()
    secondary := mut &m.secondary
    secondary.painted()
    path := mut &m.path
    path.painted()
    details := mut &m.details
    details.painted()
    progress := mut &m.progress
    progress.painted()
}
fn (m &mut SetupView) native_event(view &mut widgets.View, event &ui.Event) int {
    path := mut &m.path
    action := path.event(event) or >>
    if action.needs_paint { view.mark_paint(m.path_id) or >> }
    details := mut &m.details
    detail_action := details.event(event) or >>
    if detail_action.needs_paint { view.mark_paint(m.details_id) or >> }
    << 0
}

fn (m &mut SetupView) set_label(view &mut widgets.View, index int, text string) int {
    if index == 1 { label := mut &m.title_label
        label.set_text(&text) }
    if index == 3 { label := mut &m.path_heading
        label.set_text(&text) }
    if index == 5 { label := mut &m.status_label
        label.set_text(&text) }
    if index == 6 { label := mut &m.percent_label
        label.set_text(&text) }
    if index == 7 { label := mut &m.version_label
        label.set_text(&text) }
    view.mark_measure(m.label_ids[index]) or >>
    << 0
}

fn (m &mut SetupView) notice(view &mut widgets.View, notice &SetupNotice) int {
    progress := mut &m.progress
    progress.set_value(f64(notice.percent) / 100.0) or >>
    details := mut &m.details
    details.set_value(&notice.status) or >>
    m.set_label(view, 6, str(notice.percent) + "%") or >>
    if notice.finished {
        mut title := "安装完成"
        mut action := "完成"
        m.state = SETUP_COMPLETE
        if notice.code != 0 { m.state = SETUP_FAILED
            title = "安装未完成"
            action = "重试安装" }
        m.set_label(view, 5, title) or >>
        primary := mut &m.primary
        primary.set_enabled(true)
        secondary := mut &m.secondary
        secondary.set_enabled(true)
        complete := m.state == SETUP_COMPLETE
        failed := m.state == SETUP_FAILED
        path := mut &m.path
        path.set_read_only(true) or >>
        current := mut &m.current_user
        current.set_enabled(!complete)
        every := mut &m.every_user
        every.set_enabled(!complete)
        label := mut &m.primary_label
        label.set_text(&action)
        if complete { secondary_label := mut &m.secondary_label
            secondary_label.set_text(&"关闭") }
        progress := mut &m.progress
        progress.set_invalid(failed)
        details := mut &m.details
        details.set_invalid(false)
    }
    for id in [m.current_id,m.every_id,m.primary_id,m.secondary_id,m.path_id,m.progress_id,m.details_id] { view.mark_paint(id) or >> }
    << 0
}

fn (m &SetupView) show_status(view &mut widgets.View, show_progress bool) int {
    mut style := layout.box_style(layout.BOX_COLUMN)
    style.gap = 10.0
    style.cross_alignment = layout.CROSS_STRETCH
    view.set_style(m.status_id, &style) or >>
    mut bar := layout.box_style(layout.BOX_LEAF)
    bar.hidden = !show_progress
    view.set_style(m.progress_id, &bar) or >>
    view.set_style(m.label_ids[6], &bar) or >>
    bounds := view.node_bounds(view.root()) or >>
    window := ui.Window{id: m.identity.window_id,generation: m.identity.generation,title: "",width: 0,height: 0,content_kind: ui.CONTENT_DRAW,content_backend_id: m.identity.canvas_id,closed: 0}
    mut expanded := 460
    if xu_target_os() == 2 { expanded = 520 }
    window.command("minsize\t600\t" + str(expanded)) or >>
    if bounds.height < f64(expanded - 40) { window.command("size\t" + str(int(bounds.width)) + "\t" + str(expanded)) or >> }
    << 0
}

fn (m &mut SetupView) scope(view &mut widgets.View, all_users bool) int {
    if m.state == SETUP_INSTALLING || m.state == SETUP_COMPLETE { << 0 }
    target := setup_scope_root(all_users) or >>
    m.all_users = all_users
    m.target = target + ""
    current := mut &m.current_user
    current.set_value(!all_users)
    every := mut &m.every_user
    every.set_value(all_users)
    path := mut &m.path
    path.set_value(&target) or >>
    mut title := "安装 XU"
    mut action := "安装"
    if setup_has_sdk(&target) { title = "更新 XU"
        action = "更新" }
    m.set_label(view, 1, title) or >>
    label := mut &m.primary_label
    label.set_text(&action)
    for id in [m.current_id,m.every_id,m.path_id,m.primary_id] { view.mark_paint(id) or >> }
    << 0
}

fn (m &mut SetupView) start(view &mut widgets.View) int {
    if m.state == SETUP_INSTALLING || m.state == SETUP_COMPLETE { << 0 }
    target := m.target + ""
    if target.len == 0 {
        m.show_status(view, false) or >>
        m.set_label(view, 5, "无法确定安装位置") or >>
        path := mut &m.path
        path.set_invalid(true)
        details := mut &m.details
        message := "无法确定安装位置。"
        details.set_value(&message) or >>
        details.set_invalid(false)
        view.mark_paint(m.details_id) or >>
        << 0
    }
    m.target = filepath.abs(&target) or >>
    m.state = SETUP_INSTALLING
    m.show_status(view, true) or >>
    widgets.cancel_input(view, m) or >>
    primary := mut &m.primary
    primary.set_enabled(false)
    secondary := mut &m.secondary
    secondary.set_enabled(false)
    current := mut &m.current_user
    current.set_enabled(false)
    every := mut &m.every_user
    every.set_enabled(false)
    view.mark_paint(m.current_id) or >>
    view.mark_paint(m.every_id) or >>
    path := mut &m.path
    path.set_invalid(false)
    path.set_read_only(true) or >>
    progress := mut &m.progress
    progress.set_invalid(false)
    details := mut &m.details
    details.set_invalid(false)
    label := mut &m.primary_label
    label.set_text(&"正在安装…")
    m.set_label(view, 5, "正在安装") or >>
    preparing := SetupNotice{percent: 10,status: "正在准备 SDK 文件…",finished: false,code: 0}
    m.notice(view, &preparing) or >>
    xu setup_install_worker(m.target + "", m.self_exe + "", m.version + "", m.notices, m.all_users)
    << 0
}

fn new_setup_view(view &mut widgets.View, context &draw.Context, identity &ui.CanvasEvent, target string, self_exe string, version string, all_users bool) SetupView {
    styles := setup_styles() or >>
    view.set_styles(&styles) or >>
    top := setup_column(view, view.root(), 24.0) or >>
    mut header_style := layout.box_style(layout.BOX_ROW)
    header_style.gap = 16.0
    header_style.cross_alignment = layout.CROSS_CENTER
    header := view.add(top, &header_style, &layout.Size{width: 0.0,height: 64.0}) or >>
    logo_id := setup_leaf(view, header, 64.0, 64.0) or >>
    title_id := setup_label_node(view, header, 40.0) or >>
    mut scope_style := layout.box_style(layout.BOX_ROW)
    scope_style.gap = 24.0
    scope_style.cross_alignment = layout.CROSS_CENTER
    scope_style.hidden = xu_target_os() != 2
    scope_row := view.add(top, &scope_style, &layout.Size{width: 0.0,height: 44.0}) or >>
    current_id := setup_leaf(view, scope_row, 160.0, 44.0) or >>
    every_id := setup_leaf(view, scope_row, 260.0, 44.0) or >>
    destination := setup_column(view, top, 10.0) or >>
    path_label_id := setup_label_node(view, destination, 20.0) or >>
    path_id := setup_leaf(view, destination, 300.0, 28.0) or >>
    mut status_style := layout.box_style(layout.BOX_COLUMN)
    status_style.gap = 10.0
    status_style.cross_alignment = layout.CROSS_STRETCH
    status_style.hidden = true
    status := view.add(top, &status_style, &layout.Size{width: 0.0,height: 0.0}) or >>
    mut heading_style := layout.box_style(layout.BOX_ROW)
    heading_style.main_alignment = layout.MAIN_SPACE_BETWEEN
    heading_style.cross_alignment = layout.CROSS_CENTER
    heading := view.add(status, &heading_style, &layout.Size{width: 0.0,height: 24.0}) or >>
    status_label_id := setup_label_node(view, heading, 21.0) or >>
    percent_id := setup_label_node(view, heading, 18.0) or >>
    progress_id := setup_leaf(view, status, 300.0, 8.0) or >>
    details_id := setup_leaf(view, status, 300.0, 52.0) or >>
    mut footer_style := layout.box_style(layout.BOX_ROW)
    footer_style.main_alignment = layout.MAIN_SPACE_BETWEEN
    footer_style.cross_alignment = layout.CROSS_CENTER
    footer_style.gap = 16.0
    footer := view.add(view.root(), &footer_style, &layout.Size{width: 0.0,height: 44.0}) or >>
    version_id := setup_label_node(view, footer, 18.0) or >>
    mut buttons_style := layout.box_style(layout.BOX_ROW)
    buttons_style.gap = 12.0
    buttons_style.cross_alignment = layout.CROSS_CENTER
    buttons := view.add(footer, &buttons_style, &layout.Size{width: 0.0,height: 44.0}) or >>
    secondary_id := setup_leaf(view, buttons, 88.0, 44.0) or >>
    primary_id := setup_leaf(view, buttons, 120.0, 44.0) or >>
    ids := [0,title_id,0,path_label_id,0,status_label_id,percent_id,version_id]
    empty := layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0}
    mut path := widgets.input(context, identity, path_id, &empty, &target) or >>
    path.apply_styles(&styles) or >>
    path.set_read_only(true) or >>
    mut path_style := styles.input.clone()
    path_style.border_width = 0.0
    path_style.padding = layout.insets(0.0) or >>
    path_style.min_height = 28.0
    path_style.palette.read_only = styles.background
    path_style.palette.foreground = styles.button.palette.muted
    path_style.font.size = 13.0
    path_style.inherit_font = false
    path.set_style(&path_style) or >>
    mut details := widgets.text_area(context, identity, details_id, &empty, &"点击开始安装，工具链会安装到上面的目录。") or >>
    details.apply_styles(&styles) or >>
    details.set_read_only(true) or >>
    mut primary := widgets.button(identity, primary_id, &empty) or >>
    mut primary_style := styles.button.clone()
    primary_style.palette.normal = draw.rgb(190,48,53)
    primary_style.palette.hovered = draw.rgb(211,63,66)
    primary_style.palette.pressed = draw.rgb(163,38,43)
    primary_style.palette.foreground = draw.rgb(255,244,237)
    primary_style.min_width = 120.0
    primary.set_style(&primary_style) or >>
    for id in [current_id,every_id,path_id,details_id,primary_id,secondary_id] { view.set_input(id, true, true) or >> }
    for id in [current_id,every_id,path_id,details_id,primary_id,secondary_id,progress_id] { view.set_style_measure(id, true) or >> }
    for id in [current_id,every_id,primary_id,secondary_id] { view.set_cursor(id, ui.CURSOR_HAND) or >> }
    for id in [path_id,details_id] { view.set_cursor(id, ui.CURSOR_TEXT) or >> }
    notices := chan SetupNotice{cap: 64}
    installed := setup_has_sdk(&target)
    mut title := "安装 XU"
    mut action := "安装"
    if installed { title = "更新 XU"
        action = "更新" }
    << SetupView{current_user: widgets.radio(identity, current_id, &empty, 0, !all_users) or >>,
        every_user: widgets.radio(identity, every_id, &empty, 1, all_users) or >>,
        current_label: widgets.styled_label(context, &"仅当前用户"),every_label: widgets.styled_label(context, &"所有用户（需要管理员权限）"),
        current_id: current_id,every_id: every_id,all_users: all_users,identity: ui.CanvasEvent{window_id: identity.window_id,canvas_id: identity.canvas_id,generation: identity.generation},primary: primary,secondary: widgets.button(identity, secondary_id, &empty) or >>,path: path,details: details,
        progress: widgets.progress(&empty, 0.0) or >>,primary_label: widgets.styled_label(context, &action),secondary_label: widgets.styled_label(context, &"取消"),
        title_label: setup_label(context, title, 26.0, false, false) or >>,
        path_heading: setup_label(context, "安装位置", 13.0, false, false) or >>,
        status_label: setup_label(context, "准备就绪", 14.0, false, false) or >>,
        percent_label: setup_label(context, "0%", 13.0, true, false) or >>,
        version_label: setup_label(context, "v" + version + "  ·  " + detect_host_platform(), 12.0, true, false) or >>,
        label_ids: ids,logo_id: logo_id,status_id: status,primary_id: primary_id,secondary_id: secondary_id,path_id: path_id,details_id: details_id,progress_id: progress_id,
        state: SETUP_READY,target: target,self_exe: self_exe,version: version,reduced: false,notices: notices}
}

fn setup_scene(events chan ui.Event, launch &SetupLaunch) int {
    mut ready := ui.Event{kind: ui.EV_NONE,window_id: 0,menu_id: "",width: 0,height: 0}
    while ready.kind != ui.EV_CANVAS_READY {
        ready = <-events
        if ready.kind == ui.EV_EXIT || ready.kind == ui.EV_CLOSED || ready.kind == ui.EV_WINDOW_FAILED { << 0 }
    }
    identity := ui.canvas_of(&ready) or >>
    context := draw.context_of(&ready) or >>
    mut root := layout.box_style(layout.BOX_COLUMN)
    root.padding = layout.insets(24.0) or >>
    root.gap = 20.0
    root.main_alignment = layout.MAIN_SPACE_BETWEEN
    root.cross_alignment = layout.CROSS_STRETCH
    host := widgets.Host{context: context,identity: identity}
    mut view := host.view(&root, draw.rgb(23,25,29)) or >>
    mut model := new_setup_view(mut &view, &context, &identity, launch.target + "", launch.self_exe + "", launch.version + "", launch.all_users) or (err) { >> errors.new("controls: " + err.msg()) }
    ui.request_canvas_preferences(&identity) or (err) { >> errors.new("canvas preferences: " + err.msg()) }
    mut width := 640.0
    mut height := 300.0
    if xu_target_os() == 2 { height = 380.0 }
    mut closing := false
    mut window := ui.Window{id: identity.window_id,generation: identity.generation,title: "",width: 640,height: 300,
        content_kind: ui.CONTENT_DRAW,content_backend_id: identity.canvas_id,closed: 0}
    window.content_command("input_enabled\t1") or >>
    window.content_command("pan_enabled\t0") or >>
    mut auto_start := launch.auto_start
    while true {
        select {
            notice := <-model.notices {
                if notice.finished && notice.code == 2 { closing = true }
                else { model.notice(mut &view, &notice) or >> }
            }
            else {}
        }
        constraints := layout.tight(width, height) or >>
        _ := widgets.layout_styled(mut &view, &constraints, mut &model) or (err) { >> errors.new("layout: " + err.msg()) }
        path := mut &model.path
        widgets.place_editor(mut &view, path) or >>
        details := mut &model.details
        widgets.place_editor(mut &view, details) or >>
        now := time.instant()
        reduced := model.reduced
        path := mut &model.path
        if path.tick(now, reduced) or >> { view.mark_paint(model.path_id) or >> }
        painted := widgets.present_styled(mut &view, &constraints, mut &model) or (err) { >> errors.new("paint: " + err.msg()) }
        if painted { model.acknowledge() }
        if auto_start { auto_start = false
            model.start(mut &view) or >> }
        event := ui.poll_chan(events)
        if event.kind == ui.EV_EXIT || event.kind == ui.EV_CLOSED || event.kind == ui.EV_CANVAS_CLOSED { <- }
        if event.kind == ui.EV_CANVAS_METRICS {
            metrics := ui.metrics_of(&event) or >>
            if metrics.width > 0.0 && metrics.height > 0.0 { width = metrics.width
                height = metrics.height
            }
        }
        if event.kind == ui.EV_CANVAS_PREFERENCES {
            preferences := ui.canvas_preferences_of(&event) or >>
            model.reduced = preferences.reduced_motion
        }
        if event.kind != ui.EV_NONE {
            actions := widgets.dispatch_event(mut &view, &event, mut &model) or >>
            model.native_event(mut &view, &event) or >>
            for action in actions {
                if action.kind == widgets.ACTION_CHANGE && (action.id == model.current_id || action.id == model.every_id) {
                    model.scope(mut &view, action.id == model.every_id) or >>
                }
                if action.kind == widgets.ACTION_ACTIVATE {
                    if action.id == model.secondary_id && model.state != SETUP_INSTALLING { closing = true }
                    if action.id == model.primary_id {
                        if model.state == SETUP_COMPLETE { closing = true }
                        else { model.start(mut &view) or >> }
                    }
                }
            }
        }
        if closing { window.request_close() or >>
            <- }
        sleep_ns(12000000)
    }
    path := mut &model.path
    path.dispose()
    details := mut &model.details
    details.dispose()
    title_label := mut &model.title_label
    title_label.dispose()
    path_heading := mut &model.path_heading
    path_heading.dispose()
    status_label := mut &model.status_label
    status_label.dispose()
    percent_label := mut &model.percent_label
    percent_label.dispose()
    version_label := mut &model.version_label
    version_label.dispose()
    current_label := mut &model.current_label
    current_label.dispose()
    every_label := mut &model.every_label
    every_label.dispose()
    primary_label := mut &model.primary_label
    primary_label.dispose()
    secondary_label := mut &model.secondary_label
    secondary_label.dispose()
    view.dispose()
    << 0
}

fn setup_scene_worker(events chan ui.Event, launch SetupLaunch, results chan int) {
    setup_scene(events, &launch) or (err) {
        eprintln("xu-setup: " + err.msg())
        results <- 1
        ui.native_accept_close() or (exit_error) { << }
        <<
    }
    results <- 0
}

fn launch_gui_installer(target_dir string, platform string, self_exe string, req_version string, all_users bool, auto_start bool) int {
    << setup_launch_widgets(SetupLaunch{target: target_dir,self_exe: self_exe,version: req_version,all_users: all_users,auto_start: auto_start}) or (err) {
        eprintln("xu-setup: 无法启动图形界面: " + err.msg())
        << 1
    }
}

fn setup_launch_widgets(launch SetupLaunch) int {
    mut app := ui.new_app()
    mut height := 300
    if xu_target_os() == 2 { height = 380 }
    mut window := app.open_content_window(ui.WindowOpts{title: "XU 安装向导",width: 640,height: height}, ui.CONTENT_DRAW) or >>
    window.command("minsize\t600\t" + str(height)) or >>
    results := chan int{cap: 1}
    xu setup_scene_worker(app.event_ch, launch, results)
    code := app.run() or >>
    if code != 0 { << code }
    << <-results
}
