@main

#os
#os/exec
#path/filepath
#errors
#strings
#archive/zip
#ui
#ui/draw

fn str_clone(s &string) string {
    << s + ""
}

fn path_exists(p &string) bool {
    os_stat(p + "") or (err) {
        << false
    }
    << true
}

fn is_dir(p &string) bool {
    info := os_stat(p + "") or (err) {
        << false
    }
    << info.is_dir
}

fn setup_mkdir(dir &string) bool {
    os.mkdir_all(dir + "") or (err) { << false }
    << true
}

fn setup_chmod(path &string, mode int) {
    os.chmod(path + "", mode) or (err) { << }
}

fn setup_remove_all(dir &string) {
    os.remove_all(dir + "") or (err) { << }
}

fn setup_remove_file(path &string) {
    os.remove(path + "") or (err) { << }
}

fn setup_write_file(path &string, content &string) bool {
    write_file(path + "", content + "") or (err) { << false }
    << true
}

fn setup_cmd_output(cmd &exec.Cmd) string {
    << cmd.output() or (err) { << "" }
}

fn setup_split_lines(s string) []string {
    mut lines := []string{}
    mut start := 0
    for i in 0:s.len {
        if s[i] == 10 {
            mut end := i
            if end > start && s[end - 1] == 13 {
                end = end - 1
            }
            lines.push(s[start:end])
            start = i + 1
        }
    }
    if start < s.len {
        lines.push(s[start:s.len])
    }
    << lines
}

fn setup_trim(s string) string {
    mut start := 0
    while start < s.len {
        b := s[start]
        if b == 32 || b == 9 || b == 10 || b == 13 { start = start + 1 }
        else { <- }
    }
    mut end := s.len
    while end > start {
        b := s[end - 1]
        if b == 32 || b == 9 || b == 10 || b == 13 { end = end - 1 }
        else { <- }
    }
    << s[start:end]
}

fn val_has_prefix(s &string, p string) bool {
    if s.len < p.len { << false }
    << s[0:p.len] == p
}

fn setup_read_file(path &string) string {
    << read_file(path + "") or (err) { << "" }
}

fn val_contains(s &string, sub &string) bool {
    if sub.len == 0 { << true }
    if s.len < sub.len { << false }
    sub_val := sub + ""
    for i in 0:s.len - sub.len + 1 {
        if s[i:i + sub.len] == sub_val {
            << true
        }
    }
    << false
}

fn str_contains_lit(s &string, sub string) bool {
    s2 := sub + ""
    << val_contains(s, &s2)
}

fn copy_file(src &string, dst &string, is_executable bool) bool {
    data := read_file(src + "") or (err) {
        << false
    }
    write_file(dst + "", data) or (err) {
        << false
    }
    if is_executable && xu_target_os() != 2 {
        setup_chmod(dst, 493) // 0755
    }
    << true
}

fn copy_tree(src &string, dst &string) bool {
    if !setup_mkdir(dst) { << false }
    listing := os.listdir(src + "") or (err) { << false }
    names := setup_split_lines(listing)
    for i in 0:names.len {
        nm := names[i]
        if nm.len == 0 || nm == "." || nm == ".." || nm == ".DS_Store" { -> }
        c_src := src + "/" + nm
        c_dst := dst + "/" + nm
        if is_dir(&c_src) {
            if !copy_tree(&c_src, &c_dst) { << false }
        } else {
            mut is_exe := false
            if str_contains_lit(&c_src, "/bin/") { is_exe = true }
            if !copy_file(&c_src, &c_dst, is_exe) { << false }
        }
    }
    << true
}

fn detect_host_platform() string {
    os_code := xu_target_os()
    mut os_name := "unknown"
    if os_code == 0 { os_name = "macos" }
    else if os_code == 1 { os_name = "linux" }
    else if os_code == 2 { os_name = "windows" }

    mut arch_name := "x64"
    mut cmd := exec.command("uname", "-m")
    out := setup_cmd_output(&cmd)
    trimmed := setup_trim(out)
    if trimmed == "arm64" || trimmed == "aarch64" {
        arch_name = "arm64"
    } else if trimmed == "loongarch64" {
        arch_name = "loongarch64"
    } else if trimmed == "riscv64" {
        arch_name = "riscv64"
    }
    if os_code == 2 {
        pa := os.getenv("PROCESSOR_ARCHITECTURE")
        if pa == "ARM64" { arch_name = "arm64" }
        else { arch_name = "x64" }
    }
    << os_name + "-" + arch_name
}

fn print_banner() {
    println("  __  __                                                    ")
    println("  \\ \\/ /   _   _   Xu 编程语言原生安装程序 (Xu Installer)     ")
    println("   \\  /   | | | |  零 GC · 高性能 · 极速编译系统编程语言      ")
    println("   /  \\   | |_| |  https://xulang.org                       ")
    println("  /_/\\_\\   \\__,_|                                           ")
    println("============================================================")
}

fn run_cmd_quiet(cmd &exec.Cmd) bool {
    rc := cmd.run() or (err) {
        eprintln("xu-setup: " + cmd.path + ": " + err.msg())
        << false
    }
    << rc == 0
}

fn download_release(url &string, dest &string) bool {
    u := url + ""
    d1 := dest + ""
    mut curl_cmd := exec.command("curl", "-fSL", "--connect-timeout", "15", "--retry", "2", "-o", d1, "--", u)
    if run_cmd_quiet(&curl_cmd) { << true }

    u2 := url + ""
    d2 := dest + ""
    mut wget_cmd := exec.command("wget", "-q", "-O", d2, u2)
    if run_cmd_quiet(&wget_cmd) { << true }

    if xu_target_os() == 2 {
        u3 := url + ""
        d3 := dest + ""
        mut ps_cmd := exec.command("powershell", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command", "[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; (New-Object Net.WebClient).DownloadFile('" + u3 + "', '" + d3 + "')")
        if run_cmd_quiet(&ps_cmd) { << true }
    }
    << false
}

fn extract_archive(archive &string, dest_dir &string, is_windows bool) bool {
    a1 := archive + ""
    d1 := dest_dir + ""
    if !is_windows {
        mut cmd := exec.command("tar", "-xzf", a1, "-C", d1)
        << run_cmd_quiet(&cmd)
    }
    // Windows SDKs use ordinary ZIP/deflate: extract with Xu itself, without
    // PowerShell, tar, WebView or a separately installed runtime.
    data := read_file(a1) or (err) { << false }
    mut reader := zip.new_reader(&data)
    mut count := 0
    while true {
        file := reader.next() or (err) {
            << err.msg() == "EOF" && count > 0
        }
        name := filepath.to_slash(&file.name)
        if name.len == 0 || filepath.is_abs(&name) || str_contains_lit(&name, ":") { << false }
        clean := filepath.clean(&name)
        if clean == ".." || val_has_prefix(&clean, "../") { << false }
        dest := d1 + "/" + clean
        if name[name.len - 1] == 47 {
            if !setup_mkdir(&dest) { << false }
        } else {
            parent := filepath.dir(&dest)
            if !setup_mkdir(&parent) { << false }
            write_file(dest, file.body + "") or (err) { << false }
        }
        count = count + 1
    }
    << false
}

fn configure_windows_env(prefix &string) bool {
    bin_dir := prefix + "\\bin"
    println("[3/4] 正在配置 Windows 用户环境变量 (PATH / XU_ROOT)...")

    // 1. Set XU_ROOT
    mut cmd_root := exec.command("reg", "add", "HKCU\\Environment", "/v", "XU_ROOT", "/t", "REG_SZ", "/d", prefix + "", "/f")
    if !run_cmd_quiet(&cmd_root) { << false }

    // 2. Set XU_STDLIB_ROOT
    std_dir := prefix + "\\src"
    mut cmd_std := exec.command("reg", "add", "HKCU\\Environment", "/v", "XU_STDLIB_ROOT", "/t", "REG_SZ", "/d", std_dir + "", "/f")
    if !run_cmd_quiet(&cmd_std) { << false }

    // 3. Update User Path
    mut cmd_query := exec.command("reg", "query", "HKCU\\Environment", "/v", "Path")
    out := setup_cmd_output(&cmd_query)
    mut current_path := ""
    lines := setup_split_lines(out)
    for i in 0:lines.len {
        line := setup_trim(lines[i])
        if val_has_prefix(&line, "Path") {
            mut cut := 0 - 1
            for j in 4:line.len - 3 {
                if line[j:j + 3] == "REG" {
                    cut = j
                    <-
                }
            }
            if cut >= 0 {
                mut val_start := cut
                while val_start < line.len && line[val_start] != 32 && line[val_start] != 9 {
                    val_start = val_start + 1
                }
                while val_start < line.len && (line[val_start] == 32 || line[val_start] == 9) {
                    val_start = val_start + 1
                }
                if val_start < line.len {
                    current_path = line[val_start:line.len]
                }
            }
        }
    }

    if !val_contains(&current_path, &bin_dir) {
        mut new_path := bin_dir + ""
        if current_path.len > 0 {
            new_path = bin_dir + ";" + current_path
        }
        mut cmd_add_path := exec.command("reg", "add", "HKCU\\Environment", "/v", "Path", "/t", "REG_EXPAND_SZ", "/d", new_path, "/f")
        if !run_cmd_quiet(&cmd_add_path) { << false }
    }

    // 4. Create env.cmd for easy CMD activation
    cmd_helper := "@echo off\r\nset \"XU_ROOT=" + prefix + "\"\r\nset \"XU_STDLIB_ROOT=" + prefix + "\\src\"\r\nset \"PATH=" + bin_dir + ";%PATH%\"\r\necho Xu development environment activated.\r\n"
    cmd_path := prefix + "/env.cmd"
    if !setup_write_file(&cmd_path, &cmd_helper) { << false }

    << true
}

fn configure_unix_env(prefix &string) bool {
    println("[3/4] 正在配置系统环境变量 (PATH / XU_ROOT)...")
    home := os.home_dir()
    if home.len == 0 { << false }

    dlr := string_from_byte(36)
    dlr_path := dlr + "PATH"
    snippet_start := "# >>> xu development environment >>>"
    snippet_end := "# <<< xu development environment <<<"
    block := "\n" + snippet_start + "\nexport XU_ROOT=\"" + prefix + "\"\nexport XU_STDLIB_ROOT=\"" + prefix + "/src\"\ncase \":" + dlr_path + ":\" in\n    *\":" + prefix + "/bin:\"*) ;;\n    *) export PATH=\"" + prefix + "/bin:" + dlr_path + "\" ;;\nesac\n" + snippet_end + "\n"

    mut rc_files := []string{}
    rc_files.push(home + "/.zshrc")
    rc_files.push(home + "/.bashrc")
    rc_files.push(home + "/.profile")

    for i in 0:rc_files.len {
        rc := rc_files[i]
        content := setup_read_file(&rc)
        if !str_contains_lit(&content, snippet_start) {
            new_content := content + block
            setup_write_file(&rc, &new_content)
        }
    }

    fish_cfg := home + "/.config/fish/config.fish"
    if path_exists(&fish_cfg) {
        fcontent := setup_read_file(&fish_cfg)
        if !str_contains_lit(&fcontent, snippet_start) {
            fblock := "\n" + snippet_start + "\nset -gx XU_ROOT \"" + prefix + "\"\nset -gx XU_STDLIB_ROOT \"" + prefix + "/src\"\nfish_add_path \"" + prefix + "/bin\"\n" + snippet_end + "\n"
            f_new := fcontent + fblock
            setup_write_file(&fish_cfg, &f_new)
        }
    }

    << true
}

fn locate_sdk_root(self_exe &string) string {
    exe_dir := filepath.dir(self_exe)

    b1 := exe_dir + "/bin"
    s1 := exe_dir + "/src"
    if is_dir(&b1) && is_dir(&s1) { << exe_dir }

    par := filepath.dir(&exe_dir)
    b2 := par + "/bin"
    s2 := par + "/src"
    if is_dir(&b2) && is_dir(&s2) { << par }

    mut cur := os.getwd()
    b3 := cur + "/bin"
    s3 := cur + "/src"
    if is_dir(&b3) && is_dir(&s3) { << cur }

    << ""
}

fn setup_path_within(parent string, candidate string) bool {
    mut p := filepath.clean(&parent)
    mut c := filepath.clean(&candidate)
    if xu_target_os() == 2 {
        p = strings.to_lower(&p)
        c = strings.to_lower(&c)
    }
    if c == p { << true }
    if c.len <= p.len || !val_has_prefix(&c, p + "") { << false }
    << os.is_path_separator(c[p.len])
}

fn setup_close_fd(fd int) {
    os_fd_close(fd) or (err) { << }
}

// 0 = no embedded archive; 1 = extracted; -1 = corrupt or unreadable payload.
fn extract_embedded_payload(self_exe string, temp_stage string) int {
    info := os_stat(self_exe + "") or (err) { << 0 - 1 }
    file_sz := info.size
    if file_sz <= 24 { << 0 }

    fd := os_open(self_exe + "", os.o_rdonly) or (err) { << 0 - 1 }

    os_fd_seek(fd, file_sz - 24, 0) or (err) {
        setup_close_fd(fd)
        << 0 - 1
    }
    tail := os_fd_read(fd, 24) or (err) {
        setup_close_fd(fd)
        << 0 - 1
    }
    if tail.len < 24 {
        setup_close_fd(fd)
        << 0 - 1
    }

    magic := tail[16:24]
    if magic != "XUPACK01" {
        setup_close_fd(fd)
        << 0
    }

    len_str := setup_trim(tail[0:16])
    mut zip_len := 0
    for i in 0:len_str.len {
        b := len_str[i]
        if b >= 48 && b <= 57 {
            zip_len = zip_len * 10 + (b - 48)
        } else {
            setup_close_fd(fd)
            << 0 - 1
        }
    }
    if zip_len <= 0 || zip_len > file_sz - 24 {
        setup_close_fd(fd)
        << 0 - 1
    }

    zip_start := file_sz - 24 - zip_len
    os_fd_seek(fd, zip_start, 0) or (err) {
        setup_close_fd(fd)
        << 0 - 1
    }

    if !setup_mkdir(&temp_stage) {
        setup_close_fd(fd)
        << 0 - 1
    }
    mut out_archive := temp_stage + "/embedded_payload.tar.gz"
    if xu_target_os() == 2 {
        out_archive = temp_stage + "\\embedded_payload.zip"
    }

    out_fd := os_open(out_archive + "", os.o_create) or (err) {
        setup_close_fd(fd)
        << 0 - 1
    }

    mut remaining := zip_len
    chunk_size := 65536
    while remaining > 0 {
        mut to_read := chunk_size
        if remaining < chunk_size {
            to_read = remaining
        }
        chunk := os_fd_read(fd, to_read) or (err) {
            <-
        }
        if chunk.len == 0 {
            <-
        }
        mut written := 0
        while written < chunk.len {
            n := os_fd_write(out_fd, chunk[written:chunk.len]) or (err) { <- }
            if n <= 0 { <- }
            written = written + n
        }
        if written != chunk.len { <- }
        remaining = remaining - chunk.len
    }
    setup_close_fd(out_fd)
    setup_close_fd(fd)

    if remaining != 0 {
        setup_remove_file(&out_archive)
        << 0 - 1
    }

    is_win := xu_target_os() == 2
    extract_ok := extract_archive(&out_archive, &temp_stage, is_win)
    setup_remove_file(&out_archive)
    if !extract_ok { << 0 - 1 }
    << 1
}







// -------------------------------------------------------------
// 官方甲骨文朱砂金石 LOGO 纯矢量自绘
// -------------------------------------------------------------
fn draw_xu_logo(ox int, oy int, size int, color string) {
    mut lw := size * 26 / 500
    if lw < 2 {
        lw = 2
    }

    c := color + ""

    // 1. 外部甲骨扁平 U 型器皿外框
    x1 := ox + 105 * size / 500
    y1 := oy + 140 * size / 500
    x2 := ox + 90 * size / 500
    y2 := oy + 295 * size / 500
    x3 := ox + 250 * size / 500
    y3 := oy + 370 * size / 500
    x4 := ox + 410 * size / 500
    y4 := oy + 295 * size / 500
    x5 := ox + 395 * size / 500
    y5 := oy + 140 * size / 500

    draw.line(x1, y1, x2, y2, c + "", lw)
    draw.line(x2, y2, x3, y3, c + "", lw)
    draw.line(x3, y3, x4, y4, c + "", lw)
    draw.line(x4, y4, x5, y5, c + "", lw)

    // 2. 内部左折笔 (>)
    lx1 := ox + 165 * size / 500
    ly1 := oy + 155 * size / 500
    lx2 := ox + 230 * size / 500
    ly2 := oy + 218 * size / 500
    lx3 := ox + 165 * size / 500
    ly3 := oy + 280 * size / 500
    draw.line(lx1, ly1, lx2, ly2, c + "", lw)
    draw.line(lx2, ly2, lx3, ly3, c + "", lw)

    // 3. 内部右折笔 (<)
    rx1 := ox + 335 * size / 500
    ry1 := oy + 155 * size / 500
    rx2 := ox + 270 * size / 500
    ry2 := oy + 218 * size / 500
    rx3 := ox + 335 * size / 500
    ry3 := oy + 280 * size / 500
    draw.line(rx1, ry1, rx2, ry2, c + "", lw)
    draw.line(rx2, ry2, rx3, ry3, c, lw)
}

fn point_in_rect(px int, py int, rx int, ry int, rw int, rh int) bool {
    if px >= rx && px <= rx + rw && py >= ry && py <= ry + rh {
        << true
    }
    << false
}

// -------------------------------------------------------------
// 自绘图形安装向导界面
// -------------------------------------------------------------
fn paint_gui(host_target string, target_dir string, progress int, status string, done int) {
    draw.begin()
    draw.set_bg("#0B1020")

    // 顶部 Header 装饰卡片
    draw.round_rect(20, 16, 520, 84, 10, "#111A2E", "#1E293B", 1)

    // 官方朱砂红甲骨文矢量 LOGO
    draw_xu_logo(28, 20, 68, "#E11D48")

    // 标题与副标题
    draw.text(108, 30, 17, "#F8FAFC", "Xu 语言开发环境安装向导")
    draw.text(108, 54, 12, "#94A3B8", "零 GC · 高性能 · 极速编译系统级编程语言")
    draw.text(108, 74, 11, "#38BDF8", "系统架构: " + host_target + " · 全局环境开箱即用")

    // 主体卡片
    draw.round_rect(20, 112, 520, 150, 10, "#111A2E", "#1E293B", 1)

    // 安装目录展示
    draw.text(36, 126, 12, "#CBD5E1", "安装目标路径:")
    draw.round_rect(36, 144, 488, 34, 6, "#0B1020", "#334155", 1)
    draw.text(48, 154, 12, "#38BDF8", target_dir)

    // 安装状态与进度
    draw.text(36, 192, 12, "#CBD5E1", "安装进度:")
    mut stat_color := "#94A3B8"
    if done == 1 {
        stat_color = "#4ADE80"
    } else if progress > 0 {
        stat_color = "#F59E0B"
    }
    draw.text(102, 192, 12, stat_color, status)

    // 进度条底槽与填充
    draw.round_rect(36, 212, 488, 16, 8, "#0B1020", "#1E293B", 1)
    if progress > 0 {
        mut bar_w := progress * 488 / 100
        if bar_w > 488 {
            bar_w = 488
        }
        mut fill_col := "#38BDF8"
        if done == 1 {
            fill_col = "#22C55E"
        }
        draw.round_rect(36, 212, bar_w, 16, 8, fill_col + "", fill_col + "", 0)
    }


    // 底部操作区
    if done == 1 {
        // 完成按钮 (绿色)
        draw.round_rect(374, 278, 150, 42, 8, "#16A34A", "#4ADE80", 1)
        draw.text(410, 291, 14, "#FFFFFF", "完成并退出")
    } else if progress > 0 {
        // 正在安装中 (灰色等待)
        draw.round_rect(374, 278, 150, 42, 8, "#334155", "#475569", 1)
        draw.text(418, 291, 14, "#94A3B8", "正在安装...")
    } else {
        // 初始一键安装按钮 (朱砂红主操作)
        draw.round_rect(374, 278, 150, 42, 8, "#E11D48", "#FB7185", 1)
        draw.text(418, 291, 14, "#FFFFFF", "一键安装")

        // 退出按钮
        draw.round_rect(280, 278, 80, 42, 8, "#1E293B", "#334155", 1)
        draw.text(304, 291, 13, "#94A3B8", "退出")
    }

    draw.present()
}

// -------------------------------------------------------------
// 执行安装核心逻辑（CLI 与 GUI 共享）
// -------------------------------------------------------------
fn execute_install_step(target_dir string, self_exe string, req_version string, gui bool, progress &mut int, status &mut string) int {
    is_windows := xu_target_os() == 2
    platform := detect_host_platform()

    mut tmp_dir := os.temp_dir()
    if tmp_dir.len == 0 {
        if is_windows { tmp_dir = "C:\\Temp" }
        else { tmp_dir = "/tmp" }
    }
    mut temp_stage := tmp_dir + "/xu_install_" + str(os.getpid())

    *progress = 20
    *status = "正在解压离线 SDK 文件..."
    if gui { paint_gui(platform + "", target_dir + "", 20, status + "", 0) }

    embedded := extract_embedded_payload(self_exe + "", temp_stage + "")
    if embedded < 0 {
        *status = "内嵌离线安装包读取或解压失败。"
        setup_remove_all(&temp_stage)
        << 1
    }
    has_embedded := embedded == 1
    if has_embedded {
        *status = "检测到内嵌离线完整 SDK，正在提取核心组件..."
    }

    source_sdk := locate_sdk_root(&self_exe)

    if has_embedded {
        // 内嵌离线包解压完成
    } else if source_sdk.len > 0 {
        *status = "检测到本地发布包，正在提取核心组件..."
    } else {
        *status = "正在从 GitHub 下载官方 SDK..."
        if gui { paint_gui(platform + "", target_dir + "", 20, status + "", 0) }
        mut tag := req_version + ""
        if tag.len > 0 && tag[0] != 118 { tag = "v" + tag }
        mut ext := ".tar.gz"
        if is_windows { ext = ".zip" }
        archive_name := "xu-" + tag + "-" + platform + ext
        url := "https://github.com/xulang-org/xu/releases/download/" + tag + "/" + archive_name

        setup_mkdir(&temp_stage)
        archive_dest := temp_stage + "/" + archive_name

        if !download_release(&url, &archive_dest) {
            *status = "下载官方发布包失败，请检查网络连接。"
            << 1
        }
        *status = "正在解压安装包..."
        if gui { paint_gui(platform + "", target_dir + "", 30, status + "", 0) }
        if !extract_archive(&archive_dest, &temp_stage, is_windows) {
            *status = "解压安装包失败。"
            << 1
        }
    }

    *progress = 50
    *status = "正在部署编译器与标准库核心文件..."
    if gui { paint_gui(platform + "", target_dir + "", 50, status + "", 0) }
    mut deploy_src := ""
    if has_embedded {
        deploy_src = temp_stage + "/xu-v" + req_version
        if !is_dir(&deploy_src) {
            deploy_src = temp_stage + "/xu"
            if !is_dir(&deploy_src) { deploy_src = temp_stage + "" }
        }
    } else if source_sdk.len > 0 {
        deploy_src = source_sdk + ""
    } else {
        deploy_src = temp_stage + "/xu-v" + req_version
        if !is_dir(&deploy_src) {
            deploy_src = temp_stage + "/xu"
            if !is_dir(&deploy_src) { deploy_src = temp_stage + "" }
        }
    }


    mut exe_suffix := ""
    if is_windows { exe_suffix = ".exe" }
    mut bin_src := deploy_src + "/bin"
    platform_bin := bin_src + "/platform/" + platform
    if is_dir(&platform_bin) { bin_src = platform_bin + "" }
    compiler_src := bin_src + "/xu" + exe_suffix
    stdlib_src := deploy_src + "/src"
    if !path_exists(&compiler_src) || !is_dir(&stdlib_src) {
        *status = "安装包缺少当前平台的编译器或标准库。"
        setup_remove_all(&temp_stage)
        << 1
    }
    bundle_target_path := deploy_src + "/TARGET"
    bundle_target := setup_trim(setup_read_file(&bundle_target_path))
    if bundle_target.len > 0 && bundle_target != platform && bundle_target != "devkit-all" {
        *status = "安装包平台不匹配: " + bundle_target + " / " + platform
        setup_remove_all(&temp_stage)
        << 1
    }
    if setup_path_within(deploy_src + "", target_dir + "") || setup_path_within(target_dir + "", deploy_src + "") {
        *status = "安装目标目录不能与安装包源目录重叠。"
        setup_remove_all(&temp_stage)
        << 1
    }
    if !setup_mkdir(&target_dir) {
        *status = "无法创建安装目录: " + target_dir
        setup_remove_all(&temp_stage)
        << 1
    }

    bin_dst := target_dir + "/bin"
    if !copy_tree(&bin_src, &bin_dst) {
        *status = "复制编译器失败: " + bin_dst
        setup_remove_all(&temp_stage)
        << 1
    }

    src_src := deploy_src + "/src"
    src_dst := target_dir + "/src"
    if !copy_tree(&src_src, &src_dst) {
        *status = "复制标准库失败: " + src_dst
        setup_remove_all(&temp_stage)
        << 1
    }

    pkg_src := deploy_src + "/packages"
    pkg_dst := target_dir + "/packages"
    if is_dir(&pkg_src) && !copy_tree(&pkg_src, &pkg_dst) {
        *status = "复制驱动模块失败。"
        setup_remove_all(&temp_stage)
        << 1
    }

    inc_src := deploy_src + "/include"
    inc_dst := target_dir + "/include"
    if is_dir(&inc_src) && !copy_tree(&inc_src, &inc_dst) {
        *status = "复制原生头文件失败。"
        setup_remove_all(&temp_stage)
        << 1
    }

    ex_src := deploy_src + "/examples"
    ex_dst := target_dir + "/examples"
    if is_dir(&ex_src) && !copy_tree(&ex_src, &ex_dst) {
        *status = "复制示例失败。"
        setup_remove_all(&temp_stage)
        << 1
    }

    editor_src := deploy_src + "/editors"
    editor_dst := target_dir + "/editors"
    if is_dir(&editor_src) && !copy_tree(&editor_src, &editor_dst) {
        *status = "复制编辑器扩展失败。"
        setup_remove_all(&temp_stage)
        << 1
    }

    mut meta_files := []string{}
    meta_files.push("VERSION")
    meta_files.push("README.md")
    meta_files.push("LICENSE")
    meta_files.push("TARGET")
    meta_files.push("bundle.json")
    meta_files.push("env.ps1")
    meta_files.push("uninstall.ps1")
    meta_files.push("env.sh")
    meta_files.push("uninstall.sh")
    for mi in 0:meta_files.len {
        mf := meta_files[mi]
        m_s := deploy_src + "/" + mf
        m_d := target_dir + "/" + mf
        if path_exists(&m_s) {
            if !copy_file(&m_s, &m_d, false) {
                *status = "复制安装元数据失败: " + mf
                setup_remove_all(&temp_stage)
                << 1
            }
        }
    }

    *progress = 75
    *status = "正在自动配置操作系统全局环境变量..."
    if gui { paint_gui(platform + "", target_dir + "", 75, status + "", 0) }
    if is_windows {
        if !configure_windows_env(&target_dir) {
            *status = "Windows 用户环境变量配置失败。"
            setup_remove_all(&temp_stage)
            << 1
        }
    } else {
        configure_unix_env(&target_dir)
    }

    if temp_stage.len > 0 {
        setup_remove_all(&temp_stage)
    }

    *progress = 90
    *status = "正在进行工具链完整性自检..."
    if gui { paint_gui(platform + "", target_dir + "", 90, status + "", 0) }
    mut exe_name := target_dir + "/bin/xu"
    if is_windows { exe_name = target_dir + "\\bin\\xu.exe" }
    mut check_cmd := exec.command(exe_name, "--version")
    ver_out := setup_cmd_output(&check_cmd)
    if ver_out.len == 0 {
        *status = "已安装的编译器无法运行，工具链自检失败。"
        << 1
    }

    *progress = 100
    *status = "安装完成，请重新打开终端使用 Xu。"
    << 0
}

fn run_gui_event_loop(ech chan ui.Event, target_dir string, platform string, self_exe string, req_version string) {
    mut progress := 0
    mut status := "准备就绪，点击开始安装"
    mut done := 0
    mut installing := 0

    paint_gui(platform + "", target_dir + "", progress, status + "", done)


    while true {
        sleep_ns(40000000) // 25 fps
        c := draw.poll_click(ech)
        if c.ok == 1 {
            if done == 1 {
                // 点击了完成按钮 (374, 278, 150, 42)
                if point_in_rect(c.x, c.y, 374, 278, 150, 42) {
                    <<< 0
                }
            } else if installing == 0 {
                // 检查是否点击了“退出” (280, 278, 80, 42)
                if point_in_rect(c.x, c.y, 280, 278, 80, 42) {
                    <<< 0
                }
                // 检查是否点击了“一键安装” (374, 278, 150, 42)
                if point_in_rect(c.x, c.y, 374, 278, 150, 42) {
                    installing = 1
                    status = "正在准备 SDK 文件..."
                    progress = 10
                    paint_gui(platform + "", target_dir + "", progress, status + "", done)

                    rc := execute_install_step(target_dir + "", self_exe + "", req_version + "", true, mut &progress, mut &status)
                    if rc == 0 {
                        done = 1
                    } else {
                        installing = 0
                        progress = 0
                    }
                    paint_gui(platform + "", target_dir + "", progress, status + "", done)
                }
            }
        }
    }
}


fn launch_gui_installer(target_dir string, platform string, self_exe string, req_version string) int {
    mut app := ui.new_app()
    mut win := app.new_window(ui.WindowOpts{title: "Xu 语言安装向导", width: 560, height: 340})
    r := mut &win
    _ := draw.attach(r)
    if ui.target_os() == ui.os_windows {
        ui.native_set_menu_visible(0) or (err) { << 1 }
        _ := draw.set_pan_enabled(0)
    }
    ui.native_set_resizable(0) or (err) { << 1 }
    xu run_gui_event_loop(app.event_ch, target_dir, platform, self_exe, req_version)
    app.run() or (err) {
        eprintln("xu-setup: 无法启动原生安装界面。")
        << 1
    }
    << 0
}

fn main() int {
    argv := os.argv()
    mut is_silent := false
    mut custom_prefix := ""
    mut req_version := "0.8.11-dev.7"
    mut force_cli := false

    mut i := 1
    while i < argv.len {
        arg := argv[i]
        if arg == "-h" || arg == "--help" || arg == "/?" {
            println("Xu 语言原生安装程序 (Xu Language Setup & Installer)")
            println("")
            println("用法 (Usage):")
            println("  xu-setup [options]")
            println("  xu-setup.exe [options] (Windows)")
            println("")
            println("选项 (Options):")
            println("  --prefix DIR, -p DIR   指定安装目标目录 (默认: Unix ~/.xu, Windows %USERPROFILE%\\.xu)")
            println("  --yes, -y, --silent    静默一键安装 (无需确认，自动写入系统全局环境变量)")
            println("  --cli                  强制控制台命令行交互模式 (Windows 下跳过自绘图形向导)")
            println("  --version VER          指定下载版本 (仅在线模式有效；离线包默认安装内嵌版本)")
            println("  -h, --help, /?         查看帮助信息")
            println("")
            println("说明:")
            println("  - 独立离线安装包已内嵌完整 SDK（编译器、配套工具、标准库源码与上手示例）。")
            println("  - Windows 下双击直接拉起自绘图形安装向导，自动配置 Path 与 XU_ROOT。")
            println("  - 纯原生执行，零外部依赖，无需预装 Python、PowerShell 脚本策略或解压工具。")
            << 0
        }
        if arg == "-y" || arg == "--yes" || arg == "--silent" || arg == "/S" {
            is_silent = true
            i = i + 1
            ->
        }
        if arg == "--cli" {
            force_cli = true
            i = i + 1
            ->
        }
        if arg == "-p" || arg == "--prefix" {
            if i + 1 >= argv.len {
                eprintln("xu-setup: --prefix 需要指定目录路径")
                << 1
            }
            custom_prefix = argv[i + 1] + ""
            i = i + 2
            ->
        }
        if arg == "--version" {
            if i + 1 >= argv.len {
                eprintln("xu-setup: --version 需要版本号参数")
                << 1
            }
            req_version = argv[i + 1] + ""
            i = i + 2
            ->
        }
        i = i + 1
    }

    is_windows := xu_target_os() == 2
    platform := detect_host_platform()

    mut target_dir := custom_prefix + ""
    if target_dir.len == 0 {
        home := os.home_dir()
        if home.len == 0 {
            eprintln("xu-setup: 无法获取用户主目录，请通过 --prefix <DIR> 指定安装目录")
            << 1
        }
        if is_windows {
            target_dir = home + "\\.xu"
        } else {
            target_dir = home + "/.xu"
        }
    }

    mut self_exe := argv[0] + ""
    self_exe = filepath.abs(&self_exe) or (err) { << 1 }
    target_dir = filepath.abs(&target_dir) or (err) { << 1 }

    // 双击无参启动，且未显式指定命令行模式时，优先拉起自绘图形向导
    if argv.len <= 1 && !force_cli && !is_silent {
        gui_rc := launch_gui_installer(target_dir + "", platform + "", self_exe + "", req_version + "")
        if gui_rc == 0 {
            << 0
        }
        // 若当前环境无法启动 GUI (如无图形界面的终端/服务器)，平滑降级到命令行交互
    }


    print_banner()
    println("[INFO] 检测到操作系统环境: " + platform)
    println("[INFO] 目标安装路径: " + target_dir)

    mut cli_progress := 0
    mut cli_status := ""
    rc := execute_install_step(target_dir + "", self_exe + "", req_version + "", false, mut &cli_progress, mut &cli_status)

    if rc != 0 {
        eprintln("xu-setup: " + cli_status)
        << rc
    }

    println("")
    println("============================================================")
    println("  🎉 Xu 语言开发环境已成功安装！")
    println("  安装目录: " + target_dir)
    println("============================================================")
    println("")
    println("使用方法：")
    println("  1. 重新打开一个终端窗口 (CMD / PowerShell / Terminal / VS Code)")
    println("  2. 查看编译器版本:")
    println("       xu --version")
    println("  3. 查看全局开发环境:")
    println("       xu env")
    println("  4. 检查系统环境健康状态:")
    println("       xu doctor")
    println("  5. 快速运行官方示例:")
    if is_windows {
        println("       xu run \"" + target_dir + "\\examples\\01_hello\\main.xu\"")
    } else {
        println("       xu run \"" + target_dir + "/examples/01_hello/main.xu\"")
    }
    println("")

    if is_windows && !is_silent {
        println("按回车键完成安装并退出...")
        mut pause_cmd := exec.command("cmd", "/c", "pause >nul")
        run_cmd_quiet(&pause_cmd)
    }

    << 0
}
