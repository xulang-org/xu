@main

#os
#os/exec
#path/filepath
#errors
#strings
#internal/sdk

fn str_clone(s &string) string {
    << s + ""
}

fn path_exists(p &string) bool {
    os_stat(p + "") or (err) {
        << false
    }
    << true
}

fn is_dir(p &string) bool {
    info := os_stat(p + "") or (err) {
        << false
    }
    << info.is_dir
}

fn setup_mkdir(dir &string) bool {
    os.mkdir_all(dir + "") or (err) { << false }
    << true
}

fn setup_chmod(path &string, mode int) {
    os.chmod(path + "", mode) or (err) { << }
}

fn setup_remove_all(dir &string) {
    os.remove_all(dir + "") or (err) { << }
}

fn setup_remove_file(path &string) {
    os.remove(path + "") or (err) { << }
}

fn setup_write_file(path &string, content &string) bool {
    write_file(path + "", content + "") or (err) { << false }
    << true
}

fn setup_cmd_output(cmd &exec.Cmd) string {
    << cmd.output() or (err) { << "" }
}

fn setup_split_lines(s string) []string {
    $lines := []string{}
    $start := 0
    for i in 0:s.len {
        if s[i] == 10 {
            $end := i
            if end > start && s[end - 1] == 13 {
                end = end - 1
            }
            lines.push(s[start:end])
            start = i + 1
        }
    }
    if start < s.len {
        lines.push(s[start:s.len])
    }
    << lines
}

fn setup_trim(s string) string {
    $start := 0
    while start < s.len {
        b := s[start]
        if b == 32 || b == 9 || b == 10 || b == 13 { start = start + 1 }
        else { <- }
    }
    $end := s.len
    while end > start {
        b := s[end - 1]
        if b == 32 || b == 9 || b == 10 || b == 13 { end = end - 1 }
        else { <- }
    }
    << s[start:end]
}

fn val_has_prefix(s &string, p string) bool {
    if s.len < p.len { << false }
    << s[0:p.len] == p
}

fn setup_read_file(path &string) string {
    << read_file(path + "") or (err) { << "" }
}

fn val_contains(s &string, sub &string) bool {
    if sub.len == 0 { << true }
    if s.len < sub.len { << false }
    sub_val := sub + ""
    for i in 0:s.len - sub.len + 1 {
        if s[i:i + sub.len] == sub_val {
            << true
        }
    }
    << false
}

fn str_contains_lit(s &string, sub string) bool {
    s2 := sub + ""
    << val_contains(s, &s2)
}

fn detect_host_platform() string {
    os_code := xu_target_os()
    $os_name := "unknown"
    if os_code == 0 { os_name = "macos" }
    else if os_code == 1 { os_name = "linux" }
    else if os_code == 2 { os_name = "windows" }

    arch_name := setup_arch()
    << os_name + "-" + arch_name
}

fn print_banner() {
    println("  __  __                                                    ")
    println("  \\ \\/ /   _   _   Xu 编程语言原生安装程序 (Xu Installer)     ")
    println("   \\  /   | | | |  零 GC · 高性能 · 极速编译系统编程语言      ")
    println("   /  \\   | |_| |  https://xulang.org                       ")
    println("  /_/\\_\\   \\__,_|                                           ")
    println("============================================================")
}

fn run_cmd_quiet(cmd &exec.Cmd) bool {
    rc := cmd.run() or (err) {
        eprintln("xu-setup: " + cmd.path + ": " + err.msg())
        << false
    }
    << rc == 0
}

fn download_release(url &string, dest &string) bool {
    << setup_download(url, dest) or (err) {
        eprintln("xu-setup: download failed: " + err.msg())
        << false
    }
}

fn extract_archive(archive &string, dest_dir &string, is_windows bool) bool {
    data := os.read(archive + "") or (err) {
        eprintln("xu-setup: cannot read archive: " + err.msg())
        << false
    }
    sdk.extract(&data, dest_dir, is_windows) or (err) {
        eprintln("xu-setup: extract failed: " + err.msg())
        << false
    }
    << true
}

fn configure_windows_env(prefix &string, all_users bool) bool {
    $key := "HKCU\\Environment"
    if all_users { key = "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment" }
    bin_dir := prefix + "\\bin"
    if all_users { println("[3/4] 正在配置 Windows 系统环境变量 (PATH / XU_ROOT)...") }
    else { println("[3/4] 正在配置 Windows 用户环境变量 (PATH / XU_ROOT)...") }

    // 1. Set XU_ROOT
    $cmd_root := exec.command("reg", "add", key + "", "/v", "XU_ROOT", "/t", "REG_SZ", "/d", prefix + "", "/f")
    if !run_cmd_quiet(&cmd_root) { << false }

    // 2. Set XU_STDLIB_ROOT
    std_dir := prefix + "\\src"
    $cmd_std := exec.command("reg", "add", key + "", "/v", "XU_STDLIB_ROOT", "/t", "REG_SZ", "/d", std_dir + "", "/f")
    if !run_cmd_quiet(&cmd_std) { << false }

    // 3. Update User Path
    $cmd_query := exec.command("reg", "query", key + "", "/v", "Path")
    out := setup_cmd_output(&cmd_query)
    $current_path := ""
    lines := setup_split_lines(out)
    for i in 0:lines.len {
        line := setup_trim(lines[i])
        lower := strings.to_lower(&line)
        if val_has_prefix(&lower, "path") {
            $cut := 0 - 1
            for j in 4:line.len - 3 {
                if line[j:j + 3] == "REG" {
                    cut = j
                    <-
                }
            }
            if cut >= 0 {
                $val_start := cut
                while val_start < line.len && line[val_start] != 32 && line[val_start] != 9 {
                    val_start = val_start + 1
                }
                while val_start < line.len && (line[val_start] == 32 || line[val_start] == 9) {
                    val_start = val_start + 1
                }
                if val_start < line.len {
                    current_path = line[val_start:line.len]
                }
            }
        }
    }

    if !val_contains(&current_path, &bin_dir) {
        $new_path := bin_dir + ""
        if current_path.len > 0 {
            new_path = bin_dir + ";" + current_path
        }
        $cmd_add_path := exec.command("reg", "add", key + "", "/v", "Path", "/t", "REG_EXPAND_SZ", "/d", new_path, "/f")
        if !run_cmd_quiet(&cmd_add_path) { << false }
    }

    // 4. Create env.cmd for easy CMD activation
    cmd_helper := "@echo off\r\nset \"XU_ROOT=" + prefix + "\"\r\nset \"XU_STDLIB_ROOT=" + prefix + "\\src\"\r\nset \"PATH=" + bin_dir + ";%PATH%\"\r\necho Xu development environment activated.\r\n"
    cmd_path := prefix + "/env.cmd"
    if !setup_write_file(&cmd_path, &cmd_helper) { << false }

    << true
}

fn configure_unix_env(prefix &string) bool {
    println("[3/4] 正在配置系统环境变量 (PATH / XU_ROOT)...")
    home := os.home_dir()
    if home.len == 0 { << false }

    dlr := string_from_byte(36)
    dlr_path := dlr + "PATH"
    snippet_start := "# >>> xu development environment >>>"
    snippet_end := "# <<< xu development environment <<<"
    block := "\n" + snippet_start + "\nexport XU_ROOT=\"" + prefix + "\"\nexport XU_STDLIB_ROOT=\"" + prefix + "/src\"\ncase \":" + dlr_path + ":\" in\n    *\":" + prefix + "/bin:\"*) ;;\n    *) export PATH=\"" + prefix + "/bin:" + dlr_path + "\" ;;\nesac\n" + snippet_end + "\n"

    $rc_files := []string{}
    rc_files.push(home + "/.zshrc")
    rc_files.push(home + "/.bashrc")
    rc_files.push(home + "/.profile")

    for i in 0:rc_files.len {
        rc := rc_files[i]
        content := setup_read_file(&rc)
        if !str_contains_lit(&content, snippet_start) {
            new_content := content + block
            setup_write_file(&rc, &new_content)
        }
    }

    fish_cfg := home + "/.config/fish/config.fish"
    if path_exists(&fish_cfg) {
        fcontent := setup_read_file(&fish_cfg)
        if !str_contains_lit(&fcontent, snippet_start) {
            fblock := "\n" + snippet_start + "\nset -gx XU_ROOT \"" + prefix + "\"\nset -gx XU_STDLIB_ROOT \"" + prefix + "/src\"\nfish_add_path \"" + prefix + "/bin\"\n" + snippet_end + "\n"
            f_new := fcontent + fblock
            setup_write_file(&fish_cfg, &f_new)
        }
    }

    << true
}

fn locate_sdk_root(self_exe &string) string {
    $current := filepath.dir(self_exe)
    for depth in 0:6 {
        source := current + "/src"
        metadata := current + "/bundle.json"
        if is_dir(&source) && path_exists(&metadata) { << current }
        parent := filepath.dir(&current)
        if parent == current { <- }
        current = parent
    }
    << ""
}

fn setup_path_within(parent string, candidate string) bool {
    $p := filepath.clean(&parent)
    $c := filepath.clean(&candidate)
    if xu_target_os() == 2 {
        p = strings.to_lower(&p)
        c = strings.to_lower(&c)
    }
    if c == p { << true }
    if c.len <= p.len || !val_has_prefix(&c, p + "") { << false }
    << os.is_path_separator(c[p.len])
}

fn setup_close_fd(fd int) {
    os_fd_close(fd) or (err) { << }
}

// 0 = no embedded archive; 1 = extracted; -1 = corrupt or unreadable payload.
fn extract_embedded_payload(self_exe string, temp_stage string) int {
    info := os_stat(self_exe + "") or (err) { << 0 - 1 }
    file_sz := info.size
    if file_sz <= 24 { << 0 }

    fd := os_open(self_exe + "", os.O_RDONLY) or (err) { << 0 - 1 }

    os_fd_seek(fd, file_sz - 24, 0) or (err) {
        setup_close_fd(fd)
        << 0 - 1
    }
    tail := os_fd_read(fd, 24) or (err) {
        setup_close_fd(fd)
        << 0 - 1
    }
    if tail.len < 24 {
        setup_close_fd(fd)
        << 0 - 1
    }

    magic := tail[16:24]
    if magic != "XUPACK01" {
        setup_close_fd(fd)
        << 0
    }

    len_str := setup_trim(tail[0:16])
    $zip_len := 0
    for i in 0:len_str.len {
        b := len_str[i]
        if b >= 48 && b <= 57 {
            zip_len = zip_len * 10 + (b - 48)
        } else {
            setup_close_fd(fd)
            << 0 - 1
        }
    }
    if zip_len <= 0 || zip_len > file_sz - 24 {
        setup_close_fd(fd)
        << 0 - 1
    }

    zip_start := file_sz - 24 - zip_len
    os_fd_seek(fd, zip_start, 0) or (err) {
        setup_close_fd(fd)
        << 0 - 1
    }

    if !setup_mkdir(&temp_stage) {
        setup_close_fd(fd)
        << 0 - 1
    }
    $out_archive := temp_stage + "/embedded_payload.tar.gz"
    if xu_target_os() == 2 {
        out_archive = temp_stage + "\\embedded_payload.zip"
    }

    out_fd := os_open(out_archive + "", os.O_CREATE) or (err) {
        setup_close_fd(fd)
        << 0 - 1
    }

    $remaining := zip_len
    chunk_size := 65536
    while remaining > 0 {
        $to_read := chunk_size
        if remaining < chunk_size {
            to_read = remaining
        }
        chunk := os_fd_read(fd, to_read) or (err) {
            <-
        }
        if chunk.len == 0 {
            <-
        }
        $written := 0
        while written < chunk.len {
            n := os_fd_write(out_fd, chunk[written:chunk.len]) or (err) { <- }
            if n <= 0 { <- }
            written = written + n
        }
        if written != chunk.len { <- }
        remaining = remaining - chunk.len
    }
    setup_close_fd(out_fd)
    setup_close_fd(fd)

    if remaining != 0 {
        setup_remove_file(&out_archive)
        << 0 - 1
    }

    is_win := xu_target_os() == 2
    extract_ok := extract_archive(&out_archive, &temp_stage, is_win)
    setup_remove_file(&out_archive)
    if !extract_ok { << 0 - 1 }
    << 1
}







// Prefer the SDK that PATH already selects. A loose compiler outside an SDK
// layout does not make its parent a safe installation destination.
fn setup_install_root(prefix &string) string {
    if prefix.len > 0 { << filepath.abs(prefix) or >> }
    selected := exec.look_path("xu") or (err) { << setup_default_root() or >> }
    actual := sdk.real_path(&selected) or (err) { << setup_default_root() or >> }
    bin := filepath.dir(&actual)
    name := filepath.base(&bin)
    if strings.to_lower(&name) == "bin" {
        root := filepath.dir(&bin)
        source := root + "/src"
        git := root + "/.git"
        if is_dir(&source) && !path_exists(&git) { << root }
    }
    << setup_default_root() or >>
}

fn setup_default_root() string {
    home := os.home_dir()
    if home.len == 0 { >> errors.new("无法获取用户主目录，请通过 --prefix 指定安装目录") }
    << filepath.join([home, ".xu"])
}

fn setup_has_sdk(root &string) bool {
    $compiler := root + "/bin/xu"
    if xu_target_os() == 2 { compiler = compiler + ".exe" }
    source := root + "/src"
    << path_exists(&compiler) && is_dir(&source)
}

fn setup_system_root() string {
    $programs := os.getenv("ProgramW6432")
    if programs.len == 0 { programs = os.getenv("ProgramFiles") }
    if programs.len == 0 { programs = "C:\\Program Files" }
    << filepath.join([programs, "XU"])
}

fn setup_system_install(root &string) bool {
    standard := setup_system_root()
    parent := filepath.dir(&standard)
    << setup_path_within(parent, root + "")
}

fn setup_scope_root(all_users bool) string {
    empty := ""
    selected := setup_install_root(&empty) or >>
    if setup_system_install(&selected) == all_users { << selected }
    if all_users { << setup_system_root() }
    << setup_default_root() or >>
}

// CLI and GUI share the same installer; only GUI publishes status notices.

fn execute_install_step(target_dir string, self_exe string, req_version string, progress $&int, status $&string) int {
    << execute_install_reported(target_dir, self_exe, req_version, SetupReporter{notices: chan SetupNotice{cap: 1},enabled: false}, progress, status, false, true)
}

fn execute_install_reported(target_dir string, self_exe string, req_version string, report SetupReporter, progress $&int, status $&string, all_users bool, modify_env bool) int {
    is_windows := xu_target_os() == 2
    platform := detect_host_platform()
    git := target_dir + "/.git"
    if path_exists(&git) {
        *status = "目标目录是源码仓库，拒绝覆盖。"
        << 1
    }

    $tmp_dir := os.temp_dir()
    if tmp_dir.len == 0 {
        if is_windows { tmp_dir = "C:\\Temp" }
        else { tmp_dir = "/tmp" }
    }
    temp_stage := os.mkdir_temp(tmp_dir, "xu-install-") or (err) {
        *status = "无法创建安装临时目录: " + err.msg()
        << 1
    }

    *progress = 20
    *status = "正在解压离线 SDK 文件..."
    report.send(20, status + "")

    embedded := extract_embedded_payload(self_exe + "", temp_stage + "")
    if embedded < 0 {
        *status = "内嵌离线安装包读取或解压失败。"
        setup_remove_all(&temp_stage)
        << 1
    }
    has_embedded := embedded == 1
    if has_embedded {
        *status = "检测到内嵌离线完整 SDK，正在提取核心组件..."
    }

    $source_sdk := locate_sdk_root(&self_exe)
    source_manifest := source_sdk + "/bundle.json"
    if source_sdk.len > 0 && !path_exists(&source_manifest) { source_sdk = "" }
    // Reinstalling from an installed tool must fetch a clean payload rather
    // than using the installation being replaced as its own source.
    if source_sdk.len > 0 {
        source_actual := sdk.real_path(&source_sdk) or (err) {
            *status = err.msg()
            setup_remove_all(&temp_stage)
            << 1
        }
        target_actual := sdk.real_path(&target_dir) or (err) {
            *status = err.msg()
            setup_remove_all(&temp_stage)
            << 1
        }
        if setup_path_within(source_actual + "", target_actual + "") || setup_path_within(target_actual, source_actual) {
            source_sdk = ""
        }
    }

    if has_embedded {
        // 内嵌离线包解压完成
    } else if source_sdk.len > 0 {
        *status = "检测到本地发布包，正在提取核心组件..."
    } else {
        *status = "正在从 GitHub 下载官方 SDK..."
        report.send(20, status + "")
        $tag := req_version + ""
        if tag.len > 0 && tag[0] != 118 { tag = "v" + tag }
        $ext := ".tar.gz"
        if is_windows { ext = ".zip" }
        archive_name := "xu-" + tag + "-" + platform + ext
        url := "https://github.com/xulang-org/xu/releases/download/" + tag + "/" + archive_name

        setup_mkdir(&temp_stage)
        archive_dest := temp_stage + "/" + archive_name

        if !download_release_reported(&url, &archive_dest, report) {
            *status = "下载官方发布包失败，请检查网络连接。"
            setup_remove_all(&temp_stage)
            << 1
        }
        *progress = 45
        *status = "正在解压安装包..."
        report.send(45, status + "")
        if !extract_archive(&archive_dest, &temp_stage, is_windows) {
            *status = "解压安装包失败。"
            setup_remove_all(&temp_stage)
            << 1
        }
    }

    *progress = 50
    *status = "正在部署编译器与标准库核心文件..."
    report.send(50, status + "")
    $deploy_src := ""
    if has_embedded {
        deploy_src = temp_stage + "/xu-v" + req_version
        if !is_dir(&deploy_src) {
            deploy_src = temp_stage + "/xu"
            if !is_dir(&deploy_src) { deploy_src = temp_stage + "" }
        }
    } else if source_sdk.len > 0 {
        deploy_src = source_sdk + ""
    } else {
        deploy_src = temp_stage + "/xu-v" + req_version
        if !is_dir(&deploy_src) {
            deploy_src = temp_stage + "/xu"
            if !is_dir(&deploy_src) { deploy_src = temp_stage + "" }
        }
    }


    $exe_suffix := ""
    if is_windows { exe_suffix = ".exe" }
    bin_src := deploy_src + "/bin"
    platform_bin := bin_src + "/platform/" + platform
    $compiler_src := bin_src + "/xu" + exe_suffix
    if is_dir(&platform_bin) { compiler_src = platform_bin + "/xu" + exe_suffix }
    stdlib_src := deploy_src + "/src"
    if !path_exists(&compiler_src) || !is_dir(&stdlib_src) {
        *status = "安装包缺少当前平台的编译器或标准库。"
        setup_remove_all(&temp_stage)
        << 1
    }
    bundle_target_path := deploy_src + "/TARGET"
    bundle_target := setup_trim(setup_read_file(&bundle_target_path))
    if bundle_target.len > 0 && bundle_target != platform && bundle_target != "devkit-all" {
        *status = "安装包平台不匹配: " + bundle_target + " / " + platform
        setup_remove_all(&temp_stage)
        << 1
    }
    if setup_path_within(deploy_src + "", target_dir + "") || setup_path_within(target_dir + "", deploy_src + "") {
        *status = "安装目标目录不能与安装包源目录重叠。"
        setup_remove_all(&temp_stage)
        << 1
    }
    backup := sdk.install_sdk(&deploy_src, &target_dir, &req_version, &platform) or (err) {
        *status = "SDK 安装失败，原安装已保留: " + err.msg()
        setup_remove_all(&temp_stage)
        << 1
    }
    if backup.len > 0 { println("[INFO] 原 SDK 备份: " + backup) }

    *progress = 75
    *status = "正在配置环境变量..."
    report.send(75, status + "")
    if modify_env && is_windows {
        if !configure_windows_env(&target_dir, all_users) {
            *status = "Windows 环境变量配置失败。"
            setup_remove_all(&temp_stage)
            << 1
        }
    } else if modify_env {
        configure_unix_env(&target_dir)
    }

    if temp_stage.len > 0 {
        setup_remove_all(&temp_stage)
    }

    *progress = 90
    *status = "正在进行工具链完整性自检..."
    report.send(90, status + "")
    sdk.verify_install(&target_dir, &req_version, &platform) or (err) {
        *status = "已安装 SDK 校验失败: " + err.msg()
        << 1
    }

    *progress = 100
    *status = "安装完成，请重新打开终端使用 XU。"
    << 0
}

fn main() int {
    argv := os.argv()
    $is_silent := false
    $custom_prefix := ""
    $req_version := "0.11.1"
    $modify_env := true
    $force_cli := false
    $force_gui := false
    $all_users := false
    $scope_explicit := false
    $auto_start := false

    $i := 1
    while i < argv.len {
        arg := argv[i]
        if arg == "-h" || arg == "--help" || arg == "/?" {
            println("Xu 语言原生安装程序 (Xu Language Setup & Installer)")
            println("")
            println("用法 (Usage):")
            println("  xu-setup [options]")
            println("  xu-setup.exe [options] (Windows)")
            println("")
            println("选项 (Options):")
            println("  --prefix DIR, -p DIR   指定安装目标目录 (默认沿用 PATH 中的 Xu，否则 ~/.xu)")
            println("  --current-user         Windows: 仅当前用户 (默认)")
            println("  --all-users            Windows: 所有用户 (需要管理员权限)")
            println("  --yes, -y, --silent    静默一键安装 (自动配置环境变量)")
            println("  --no-modify-path       不修改用户环境配置")
            println("  --gui                  显示原生安装向导 (可配合 --prefix 使用)")
            println("  --cli                  强制控制台命令行交互模式 (Windows 下跳过图形安装向导)")
            println("  --version VER          指定下载版本 (仅在线模式有效；离线包默认安装内嵌版本)")
            println("  -h, --help, /?         查看帮助信息")
            println("")
            println("说明:")
            println("  - 独立离线安装包已内嵌完整 SDK（编译器、配套工具、标准库源码与上手示例）。")
            println("  - Windows 下双击直接拉起原生组件安装向导，自动配置 Path 与 XU_ROOT。")
            println("  - 纯原生执行，零外部依赖，无需预装 Python、PowerShell 脚本策略或解压工具。")
            << 0
        }
        if arg == "-y" || arg == "--yes" || arg == "--silent" || arg == "/S" {
            is_silent = true
            i = i + 1
            ->
        }
        if arg == "--no-modify-path" {
            modify_env = false
            force_cli = true
            i = i + 1
            ->
        }
        if arg == "--all-users" || arg == "--current-user" {
            all_users = arg == "--all-users"
            scope_explicit = true
            i = i + 1
            ->
        }
        if arg == "--start" { auto_start = true
            i = i + 1
            -> }
        if arg == "--elevate-ui" { i = i + 1
            -> }
        if arg == "--gui" {
            force_gui = true
            i = i + 1
            ->
        }
        if arg == "--cli" {
            force_cli = true
            i = i + 1
            ->
        }
        if arg == "-p" || arg == "--prefix" {
            if i + 1 >= argv.len {
                eprintln("xu-setup: --prefix 需要指定目录路径")
                << 1
            }
            custom_prefix = argv[i + 1] + ""
            i = i + 2
            ->
        }
        if arg == "--version" {
            if i + 1 >= argv.len {
                eprintln("xu-setup: --version 需要版本号参数")
                << 1
            }
            req_version = argv[i + 1] + ""
            i = i + 2
            ->
        }
        i = i + 1
    }

    req_version = sdk.release_version(&req_version) or (err) {
        eprintln("xu-setup: " + err.msg())
        << 1
    }
    is_windows := xu_target_os() == 2
    platform := detect_host_platform()

    $target_dir := setup_install_root(&custom_prefix) or (err) {
        eprintln("xu-setup: " + err.msg())
        << 1
    }

    if !is_windows && scope_explicit {
        eprintln("xu-setup: --all-users 和 --current-user 仅适用于 Windows")
        << 1
    }
    if is_windows && scope_explicit && custom_prefix.len == 0 {
        target_dir = setup_scope_root(all_users) or (err) { eprintln(err.msg())
            << 1 }
    }
    if is_windows && !scope_explicit { all_users = setup_system_install(&target_dir) }

    $self_exe := argv[0] + ""
    self_exe = filepath.abs(&self_exe) or (err) { << 1 }
    target_dir = filepath.abs(&target_dir) or (err) { << 1 }

    // 无参启动或显式选择 GUI 时，使用标准布局和原生组件安装向导。
    if (force_gui || argv.len <= 1) && !force_cli && !is_silent {
        gui_rc := launch_gui_installer(target_dir + "", platform + "", self_exe + "", req_version + "", all_users, auto_start)
        if gui_rc == 0 {
            << 0
        }
        if force_gui { << gui_rc }
        // 若当前环境无法启动 GUI (如无图形界面的终端/服务器)，平滑降级到命令行交互
    }


    print_banner()
    println("[INFO] 检测到操作系统环境: " + platform)
    println("[INFO] 目标安装路径: " + target_dir)

    $cli_progress := 0
    $cli_status := ""
    rc := execute_install_reported(target_dir + "", self_exe + "", req_version + "", SetupReporter{notices: chan SetupNotice{cap: 1},enabled: false}, $&cli_progress, $&cli_status, all_users, modify_env)

    if rc != 0 {
        eprintln("xu-setup: " + cli_status)
        << rc
    }

    println("")
    println("============================================================")
    println("  🎉 Xu 语言开发环境已成功安装！")
    println("  安装目录: " + target_dir)
    println("============================================================")
    println("")
    println("使用方法：")
    println("  1. 重新打开一个终端窗口 (CMD / PowerShell / Terminal / VS Code)")
    println("  2. 查看编译器版本:")
    println("       xu --version")
    println("  3. 查看全局开发环境:")
    println("       xu env")
    println("  4. 检查系统环境健康状态:")
    println("       xu doctor")
    println("  5. 快速运行官方示例:")
    if is_windows {
        println("       xu run \"" + target_dir + "\\examples\\01_hello\\main.xu\"")
    } else {
        println("       xu run \"" + target_dir + "/examples/01_hello/main.xu\"")
    }
    println("")

    << 0
}
