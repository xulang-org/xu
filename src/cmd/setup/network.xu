@main
#internal/sdk
#os
fn setup_progress_text(received int, total int) string {
    mut text := sdk.format_size(received)
    if total > 0 { text = text + " / " + sdk.format_size(total) + " (" + str(received * 100 / total) + "%)" }
    << text
}
fn setup_download_progress(received int, total int) { sdk.term_progress(&"xu-setup", received, total) }
fn setup_download_with_progress(url &string, dest &string, report fn(int, int)) bool {
    data := sdk.download(url + "", 300000000000, report) or >>
    os.write(dest + "", data) or >>
    << true
}
fn setup_download(url &string, dest &string) bool {
    data := setup_download_with_progress(url, dest, setup_download_progress) or (err) {
        sdk.term_progress_end()
        >> err
    }
    sdk.term_progress_end()
    << data
}
fn (r &SetupReporter) bytes(received int, total int) {
    // GUI 模式有自己的进度条控件，终端进度只服务命令行模式。
    if !r.enabled { setup_download_progress(received, total) }
    mut percent := 20
    if total > 0 { percent += received * 25 / total }
    r.send(percent, "正在下载 " + setup_progress_text(received, total))
}
fn download_release_reported(url &string, dest &string, report SetupReporter) bool {
    ok := setup_download_with_progress(url, dest, report.bytes) or (err) {
        // 失败也要结束进度行，错误信息才不会拼在进度条后面。
        if !report.enabled { sdk.term_progress_end() }
        eprintln("xu-setup: download failed: " + err.msg())
        << false
    }
    if !report.enabled { sdk.term_progress_end() }
    << ok
}
