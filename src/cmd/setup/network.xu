@main
#internal/sdk
#os
fn setup_progress_text(received int, total int) string {
    mut text := sdk.format_size(received)
    if total > 0 { text = text + " / " + sdk.format_size(total) + " (" + str(received * 100 / total) + "%)" }
    << text
}
fn setup_download_progress(received int, total int) { println("xu-setup: downloaded " + setup_progress_text(received, total)) }
fn setup_download_with_progress(url &string, dest &string, report fn(int, int)) bool {
    data := sdk.download(url + "", 300000000000, report) or >>
    os.write(dest + "", data) or >>
    << true
}
fn setup_download(url &string, dest &string) bool { << setup_download_with_progress(url, dest, setup_download_progress) or >> }
fn (r &SetupReporter) bytes(received int, total int) {
    setup_download_progress(received, total)
    mut percent := 20
    if total > 0 { percent += received * 25 / total }
    r.send(percent, "正在下载 " + setup_progress_text(received, total))
}
fn download_release_reported(url &string, dest &string, report SetupReporter) bool {
    << setup_download_with_progress(url, dest, report.bytes) or (err) { eprintln("xu-setup: download failed: " + err.msg())
        << false }
}
