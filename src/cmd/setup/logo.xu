@main
#ui/draw
#ui/layout
#math

// Canonical XU oracle mark: the same paths as brand/xu_classic.svg.
// Vector geometry keeps the mark crisp at every native display scale.
fn setup_logo(frame $&draw.Frame, bounds &layout.Rect) int {
    scale := math.min(bounds.width / 370.0, bounds.height / 300.0)
    ox := bounds.x + bounds.width * 0.5 - 250.0 * scale
    oy := bounds.y + bounds.height * 0.5 - 255.0 * scale
    $path := draw.new_path(1024) or >>
    path.move_to(ox + 105.0 * scale, oy + 140.0 * scale) or >>
    path.line_to(ox + 90.0 * scale, oy + 295.0 * scale) or >>
    path.line_to(ox + 250.0 * scale, oy + 370.0 * scale) or >>
    path.line_to(ox + 410.0 * scale, oy + 295.0 * scale) or >>
    path.line_to(ox + 395.0 * scale, oy + 140.0 * scale) or >>
    path.move_to(ox + 165.0 * scale, oy + 155.0 * scale) or >>
    path.line_to(ox + 230.0 * scale, oy + 218.0 * scale) or >>
    path.line_to(ox + 165.0 * scale, oy + 280.0 * scale) or >>
    path.move_to(ox + 335.0 * scale, oy + 155.0 * scale) or >>
    path.line_to(ox + 270.0 * scale, oy + 218.0 * scale) or >>
    path.line_to(ox + 335.0 * scale, oy + 280.0 * scale) or >>
    $stroke := draw.stroke_options(26.0 * scale)
    stroke.cap = draw.CAP_ROUND
    stroke.join = draw.JOIN_ROUND
    frame.stroke_path(&path, draw.rgb(225,57,72), &stroke) or >>
    << 0
}
