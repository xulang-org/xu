@main

#errors
#os
#os/exec
#strings

fn phone_native_flags(target &string) int {
    if *target == "ios-arm64" { << 1 }
    if *target == "ios-simulator-arm64" { << 2 }
    if *target == "android-arm64" { << 3 }
    << 0
}

fn phone_c_flags(target &string, compiler $&string, archiver $&string) []string {
    $flags := []string{}
    if *target == "ios-arm64" || *target == "ios-simulator-arm64" {
        $sdk := "iphoneos"
        if *target == "ios-simulator-arm64" { sdk = "iphonesimulator" }
        command := exec.command("xcrun", "--sdk", sdk, "--show-sdk-path")
        output := command.output() or >>
        root := strings.trim_space(&output)
        if root.len == 0 { >> errors.new("xcrun returned an empty iOS SDK path") }
        flags.push("-isysroot" + root)
        flags.push("-DXU_PHONE_GAME_LINK=1")
    }
    if *target == "android-arm64" {
        $ndk := os.getenv("ANDROID_NDK_HOME")
        if ndk.len == 0 {
            sdk := os.getenv("ANDROID_HOME")
            if sdk.len > 0 { ndk = sdk + "/ndk/27.2.12479018" }
        }
        if ndk.len == 0 { >> errors.new("android-arm64 requires ANDROID_NDK_HOME or ANDROID_HOME") }
        $host := "linux-x86_64"
        if xu_target_os() == 0 { host = "darwin-x86_64" }
        if xu_target_os() == 2 { host = "windows-x86_64" }
        toolchain := ndk + "/toolchains/llvm/prebuilt/" + host
        if !os.is_dir(toolchain + "/sysroot") { >> errors.new("Android NDK sysroot is unavailable") }
        if compiler.len == 0 { *compiler = toolchain + "/bin/clang" }
        if archiver.len == 0 { *archiver = toolchain + "/bin/llvm-ar" }
        flags.push("--sysroot=" + toolchain + "/sysroot")
        flags.push("-fPIC")
        flags.push("-DXU_PHONE_GAME_LINK=1")
    }
    << flags
}
