@main
// Iterative flowchart walk, split so emit_list stays under the W3 frame bar.

#xu/parser
#xu/ast

fn flow_cont() int { << 0 - 2 }

fn emit_st_empty() EmitSt {
    << EmitSt{k: []int{}, i: []int{}, pred: []int{}, lab: []string{}, ni: []int{}, did: []int{}, br: []int{}, eoff: []int{}, saw: []int{}}
}

struct ExitBag {
    v []int
}

fn (b &mut ExitBag) take_from(eoff int) []int {
    mut part := []int{}
    for j in eoff:b.v.len {
        part.push(b.v[j])
    }
    if eoff <= 0 {
        b.v = []int{}
    } else {
        b.v = b.v[0:eoff]
    }
    << part
}

fn (st &mut EmitSt) after_pop(out int) int {
    st.pop()
    if st.k.len == 0 {
        << 1
    }
    st.pred[st.k.len - 1] = out
    << 0
}

fn (g &mut MapG) emit_flow_stmt(p &parser.Parser, path &string, st &mut EmitSt, bag &mut ExitBag) int {
    top := st.k.len - 1
    i := st.i[top]
    if i < 0 {
        out := st.pred[top]
        st.pop()
        if st.k.len == 0 {
            << out
        }
        pt := st.k.len - 1
        pk := st.k[pt]
        if pk == 1 || pk == 2 || pk == 6 {
            if out >= 0 {
                bag.v.push(out)
            }
        } else {
            if pk == 3 || pk == 4 || pk == 5 || pk == 7 {
                st.pred[pt] = out
                st.saw[pt] = 1
            }
        }
        << flow_cont()
    }
    n := node_at(p, i)
    nxt := n.next
    opened := g.emit_open_ctrl(p, path, st, i, nxt, bag.v.len)
    if opened == 1 {
        << flow_cont()
    }
    id := g.emit_simple(p, path, i, st.pred[top], st.lab[top])
    st.pred[top] = id
    st.lab[top] = ""
    if id < 0 {
        st.i[top] = -1
    } else {
        st.i[top] = nxt
    }
    << flow_cont()
}

fn (g &mut MapG) emit_flow_if(p &parser.Parser, path &string, st &mut EmitSt, bag &mut ExitBag) int {
    top := st.k.len - 1
    br := st.br[top]
    if br < 0 {
        if st.saw[top] == 0 {
            skip := g.node(str_clone(path) + ":N" + str(st.ni[top]) + ":else", "else", 0)
            g.link(st.did[top], skip, "else")
            bag.v.push(skip)
        }
        part := bag.take_from(st.eoff[top])
        out := g.fold_exits(path, part)
        if st.after_pop(out) == 1 {
            << out
        }
        << flow_cont()
    }
    b := node_at(p, br)
    nxt := b.next
    mut lab := "else"
    if b.a >= 0 {
        lab = expr_text(p, b.a)
    } else {
        st.saw[top] = 1
    }
    st.br[top] = nxt
    st.push_list(b.b, st.did[top], lab)
    << flow_cont()
}

fn (g &mut MapG) emit_flow_match(p &parser.Parser, path &string, st &mut EmitSt, bag &mut ExitBag) int {
    top := st.k.len - 1
    br := st.br[top]
    if br < 0 {
        part := bag.take_from(st.eoff[top])
        out := g.fold_exits(path, part)
        if st.after_pop(out) == 1 {
            << out
        }
        << flow_cont()
    }
    a := node_at(p, br)
    nxt := a.next
    lab := arm_label(p, br)
    st.br[top] = nxt
    st.push_list(a.c, st.did[top], lab)
    << flow_cont()
}

fn (g &mut MapG) emit_flow_while(p &parser.Parser, path &string, st &mut EmitSt) int {
    top := st.k.len - 1
    if st.saw[top] == 0 {
        st.saw[top] = 1
        bn := node_at(p, st.ni[top])
        st.push_list(bn.c, st.did[top], "true")
        << flow_cont()
    }
    body_ex := st.pred[top]
    if body_ex >= 0 {
        g.link(body_ex, st.did[top], "loop")
    }
    skip := g.node(str_clone(path) + ":N" + str(st.ni[top]) + ":done", "false", 0)
    g.link(st.did[top], skip, "false")
    if st.after_pop(skip) == 1 {
        << skip
    }
    << flow_cont()
}

fn (g &mut MapG) emit_flow_for(p &parser.Parser, path &string, st &mut EmitSt) int {
    top := st.k.len - 1
    if st.saw[top] == 0 {
        st.saw[top] = 1
        bn := node_at(p, st.ni[top])
        st.push_list(bn.c, st.did[top], bn.sval + "")
        << flow_cont()
    }
    body_ex := st.pred[top]
    if body_ex >= 0 {
        g.link(body_ex, st.did[top], "next")
    }
    skip := g.node(str_clone(path) + ":N" + str(st.ni[top]) + ":done", "done", 0)
    g.link(st.did[top], skip, "done")
    if st.after_pop(skip) == 1 {
        << skip
    }
    << flow_cont()
}

fn (g &mut MapG) emit_flow_each(p &parser.Parser, path &string, st &mut EmitSt) int {
    top := st.k.len - 1
    if st.saw[top] == 0 {
        st.saw[top] = 1
        bn := node_at(p, st.ni[top])
        mut vs := bn.sval + ""
        if bn.sval2.len > 0 {
            vs = vs + ", " + bn.sval2
        }
        st.push_list(bn.c, st.did[top], vs)
        << flow_cont()
    }
    body_ex := st.pred[top]
    if body_ex >= 0 {
        g.link(body_ex, st.did[top], "next")
    }
    skip := g.node(str_clone(path) + ":N" + str(st.ni[top]) + ":done", "done", 0)
    g.link(st.did[top], skip, "done")
    if st.after_pop(skip) == 1 {
        << skip
    }
    << flow_cont()
}

fn (g &mut MapG) emit_flow_select(p &parser.Parser, path &string, st &mut EmitSt, bag &mut ExitBag) int {
    top := st.k.len - 1
    br := st.br[top]
    if br < 0 {
        if st.saw[top] == 0 {
            st.saw[top] = 1
            bn := node_at(p, st.ni[top])
            if bn.c >= 0 {
                st.push_list(bn.c, st.did[top], "else")
                << flow_cont()
            }
        }
        part := bag.take_from(st.eoff[top])
        out := g.fold_exits(path, part)
        if st.after_pop(out) == 1 {
            << out
        }
        << flow_cont()
    }
    a := node_at(p, br)
    nxt := a.next
    mut lab := "case"
    if a.kind == ast.NK_SEL_RECV {
        lab = a.sval + " := <- " + expr_text(p, a.a)
    } else {
        if a.kind == ast.NK_SEL_SEND {
            lab = expr_text(p, a.a) + " <- " + expr_text(p, a.b)
        }
    }
    st.br[top] = nxt
    st.push_list(a.c, st.did[top], lab)
    << flow_cont()
}

fn (g &mut MapG) emit_flow_or(p &parser.Parser, path &string, st &mut EmitSt) int {
    top := st.k.len - 1
    if st.saw[top] == 0 {
        st.saw[top] = 1
        bind_n := node_at(p, or_index(p, st.ni[top]))
        bind := bind_n.sval + ""
        st.push_list(st.br[top], st.did[top], "or (" + bind + ")")
        << flow_cont()
    }
    catch_ex := st.pred[top]
    mut part := []int{}
    part.push(st.did[top])
    if catch_ex >= 0 {
        part.push(catch_ex)
    }
    out := g.fold_exits(path, part)
    if st.after_pop(out) == 1 {
        << out
    }
    << flow_cont()
}

fn (g &mut MapG) emit_list(p &parser.Parser, path &string, head int, pred int, in_lab string) int {
    if head < 0 {
        if in_lab.len == 0 {
            << pred
        }
        eid := g.node(str_clone(path) + ":E" + str(g.keys.len), "(empty)", 0)
        g.edge(pred, eid, in_lab)
        << eid
    }
    mut st := emit_st_empty()
    st.push_list(head, pred, in_lab)
    mut bag := ExitBag{v: []int{}}
    mut out := pred
    mut guard := 0
    nmax := p.nodes.len
    mut lim := nmax * 16
    if lim < 64 {
        lim = 64
    }
    go := flow_cont()
    while st.k.len > 0 && guard < lim {
        guard = guard + 1
        top := st.k.len - 1
        kind := st.k[top]
        mut r := go
        if kind == 0 {
            r = g.emit_flow_stmt(p, path, mut &st, mut &bag)
        }
        if kind == 1 {
            r = g.emit_flow_if(p, path, mut &st, mut &bag)
        }
        if kind == 2 {
            r = g.emit_flow_match(p, path, mut &st, mut &bag)
        }
        if kind == 3 {
            r = g.emit_flow_while(p, path, mut &st)
        }
        if kind == 4 {
            r = g.emit_flow_for(p, path, mut &st)
        }
        if kind == 5 {
            r = g.emit_flow_each(p, path, mut &st)
        }
        if kind == 6 {
            r = g.emit_flow_select(p, path, mut &st, mut &bag)
        }
        if kind == 7 {
            r = g.emit_flow_or(p, path, mut &st)
        }
        if r != go {
            << r
        }
    }
    << out
}
