@main
// xu-map — source flowchart (product tool; NOT bootstrap).
// User: `xu-map [path...] [-o file]` or via `xu map`.
// Mermaid flowchart TD: .xu files, @package, #imports, functions,
// and control-flow branches (if / match / loops / or).
// Directory trees are walked to find files, not drawn as flow nodes.
// --graph is CFG + call edges (functions, branches, fn-to-fn calls) for canvas apps.

#os
#path/filepath
#strings
#sort
#xu/scanner
#xu/parser
#xu/ast
#errors

struct MapG {
    pub keys []string
    pub labels []string
    pub shapes []int
    pub nlines []int
    pub nnotes []string
    pub ek []string
    pub froms []int
    pub tos []int
    pub elabs []string
    pub fnames []string
    pub fids []int
    pub cfrom []int
    pub cname []string
}

fn str_clone(s &string) string {
    << s + ""
}

fn is_xu_name(name &string) bool {
    n := name.len
    if n < 4 {
        << false
    }
    if name[0] == 46 {
        << false
    }
    << name[n - 3] == 46 && name[n - 2] == 120 && name[n - 1] == 117
}

fn skip_dir_name(name &string) bool {
    if name.len == 0 {
        << true
    }
    << name[0] == 46
}

fn join_child(dir &string, name &string) string {
    d := str_clone(dir)
    n := str_clone(name)
    if d == "." {
        << n
    }
    last := d[d.len - 1] & 255
    if last == 47 || last == 92 {
        << d + n
    }
    << d + "/" + n
}

fn norm_path(p &string) string {
    s := filepath.to_slash(p)
    if s.len >= 2 {
        if s[0] == 46 && s[1] == 47 {
            << s[2:s.len]
        }
    }
    << s
}

fn has_path(files &mut []string, p &string) bool {
    want := str_clone(p)
    for i in 0:files.len {
        got := files[i] + ""
        if got == want {
            << true
        }
    }
    << false
}

fn add_file(files &mut []string, p string) {
    n := norm_path(&p)
    if n.len == 0 {
        <<
    }
    if has_path(files, &n) {
        <<
    }
    files.push(n)
}

fn collect_dir(prog &string, root string, files &mut []string) {
    mut stack := []string{}
    stack.push(root + "")
    while stack.len > 0 {
        top := stack.len - 1
        cur := stack[top] + ""
        mut nstack := []string{}
        for i in 0:top {
            nstack.push(stack[i] + "")
        }
        stack = nstack
        ents := os.entries(cur + "") or (err) {
            eprintln(prog + ": cannot read " + cur)
            <<< 1
        }
        for i in 0:ents.len {
            nm := ents[i].name + ""
            if nm.len > 0 {
                child := join_child(&cur, &nm)
                if ents[i].is_dir {
                    if !skip_dir_name(&nm) {
                        stack.push(child)
                    }
                } else {
                    if is_xu_name(&nm) {
                        add_file(files, child)
                    }
                }
            }
        }
    }
}

fn collect_root(prog &string, root string, files &mut []string) {
    r := str_clone(&root)
    info := os.stat(r + "") or (err) {
        eprintln(prog + ": cannot stat " + r)
        <<< 1
    }
    if info.is_dir {
        collect_dir(prog, r, files)
    } else {
        base := filepath.base(&r)
        if is_xu_name(&base) {
            add_file(files, r)
        } else {
            eprintln(prog + ": not a .xu file: " + r)
            <<< 1
        }
    }
}

fn path_slash(mod string) string {
    << mod
}

fn import_line(path string, alias string) string {
    slash := path_slash(path)
    if alias.len > 0 {
        << "#" + slash + " as " + alias
    }
    << "#" + slash
}

fn alias_at(p &parser.Parser, i int) string {
    if i >= p.imp_alias.len {
        << ""
    }
    << p.imp_alias[i] + ""
}

fn node_at(p &parser.Parser, i int) ast.Node {
    mut n := ast.mknode(0, 0, 0)
    n.kind = p.nodes[i].kind
    n.line = p.nodes[i].line
    n.col = p.nodes[i].col
    n.ival = p.nodes[i].ival
    n.sval = p.nodes[i].sval
    n.sval2 = p.nodes[i].sval2
    n.a = p.nodes[i].a
    n.b = p.nodes[i].b
    n.c = p.nodes[i].c
    n.d = p.nodes[i].d
    n.e = p.nodes[i].e
    n.next = p.nodes[i].next
    << n
}

fn file_label(name string, mid string) string {
    if mid.len == 0 {
        << name
    }
    << name + "  @" + mid
}

fn mermaid_text(s string) string {
    mut out := ""
    for i in 0:s.len {
        c := s[i]
        if c == 34 || c == 10 || c == 13 {
            out = out + "'"
        } else {
            out = out + string_from_byte(c)
        }
    }
    << out
}

fn mermaid_edge(s string) string {
    mut out := ""
    mut i := 0
    while i < s.len {
        c := s[i]
        if c == 34 || c == 10 || c == 13 {
            out = out + "'"
            i = i + 1
        } else {
            if c == 124 {
                if i + 1 < s.len {
                    if s[i + 1] == 124 {
                        out = out + " or "
                        i = i + 2
                    } else {
                        out = out + "/"
                        i = i + 1
                    }
                } else {
                    out = out + "/"
                    i = i + 1
                }
            } else {
                out = out + string_from_byte(c)
                i = i + 1
            }
        }
    }
    << out
}

fn node_name(id int) string {
    << "n" + str(id)
}

fn box_of(id int, lab string, shape int) string {
    if shape == 1 {
        << node_name(id) + "{\"" + lab + "\"}"
    }
    << node_name(id) + "[\"" + lab + "\"]"
}

fn clip(s string, n int) string {
    if s.len <= n {
        << s
    }
    << s[0:n] + ".."
}

fn (g &mut MapG) node(key string, label string, shape int) int {
    want := key + ""
    for i in 0:g.keys.len {
        got := g.keys[i] + ""
        if got == want {
            << i
        }
    }
    idx := g.keys.len
    g.keys.push(want)
    g.labels.push(label + "")
    g.shapes.push(shape)
    g.nlines.push(0)
    g.nnotes.push("")
    << idx
}

fn (g &mut MapG) touch_line(id int, line int) {
    if id < 0 || id >= g.nlines.len {
        <<
    }
    if line <= 0 {
        <<
    }
    if g.nlines[id] == 0 {
        g.nlines[id] = line
        <<
    }
    if line < g.nlines[id] {
        g.nlines[id] = line
    }
}

fn (g &mut MapG) ast_node(key string, label string, shape int, line int) int {
    id := g.node(key, label, shape)
    g.touch_line(id, line)
    << id
}

fn (g &mut MapG) add_note(id int, text string) {
    if id < 0 || id >= g.nnotes.len {
        <<
    }
    t := graph_text(text)
    if t.len == 0 {
        <<
    }
    cur := g.nnotes[id] + ""
    if cur.len == 0 {
        g.nnotes[id] = t
        <<
    }
    g.nnotes[id] = cur + " · " + t
}

fn comment_end_line(start int, text string) int {
    mut n := start
    for i in 0:text.len {
        if (text[i] & 255) == 10 {
            n = n + 1
        }
    }
    << n
}

fn (g &mut MapG) pick_at_line(line int, from int) int {
    mut best := 0 - 1
    mut fn_hit := 0 - 1
    mut br_hit := 0 - 1
    for i in 0:g.keys.len {
        if i < from {
            ->
        }
        if g.nlines[i] != line {
            ->
        }
        lab := g.labels[i] + ""
        if lab.len >= 3 {
            if lab[0] == 102 && lab[1] == 110 && lab[2] == 32 {
                fn_hit = i
            }
        }
        if g.shapes[i] == 1 {
            if br_hit < 0 {
                br_hit = i
            }
        }
        if best < 0 {
            best = i
        }
    }
    if fn_hit >= 0 {
        << fn_hit
    }
    if br_hit >= 0 {
        << br_hit
    }
    << best
}

fn (g &mut MapG) pick_after(after int, from int) int {
    mut best_line := 0
    mut seen := 0
    for i in from:g.keys.len {
        ln := g.nlines[i]
        if ln <= after {
            ->
        }
        if seen == 0 {
            best_line = ln
            seen = 1
        } else {
            if ln < best_line {
                best_line = ln
            }
        }
    }
    if seen == 0 {
        << 0 - 1
    }
    if best_line - after > 6 {
        << 0 - 1
    }
    << g.pick_at_line(best_line, from)
}

fn (g &mut MapG) attach_comments(src string, from int) {
    mut toks := []ast.Token{}
    scanner.lex_full(src, mut &toks)
    mut clines := []int{}
    mut ctexts := []string{}
    mut ckind := []int{}
    mut prev_code_line := 0
    mut prev_code := 0
    for i in 0:toks.len {
        k := toks[i].kind
        if k == ast.tok_eof {
            <-
        }
        if k == ast.tok_newline {
            ->
        }
        if k == ast.tok_comment {
            mut trail := 0
            if prev_code == 1 {
                if toks[i].line == prev_code_line {
                    trail = 1
                }
            }
            clines.push(toks[i].line)
            ctexts.push(toks[i].sval + "")
            ckind.push(trail)
            ->
        }
        prev_code_line = toks[i].line
        prev_code = 1
    }
    for i in 0:clines.len {
        if ckind[i] != 1 {
            ->
        }
        id := g.pick_at_line(clines[i], from)
        if id >= 0 {
            g.add_note(id, ctexts[i] + "")
        }
    }
    mut i := 0
    n := clines.len
    while i < n {
        if ckind[i] == 1 {
            i = i + 1
            ->
        }
        mut text := ctexts[i] + ""
        mut end := comment_end_line(clines[i], ctexts[i] + "")
        mut j := i + 1
        while j < n {
            if ckind[j] == 1 {
                <-
            }
            if clines[j] != end + 1 {
                <-
            }
            text = text + " " + ctexts[j]
            end = comment_end_line(clines[j], ctexts[j] + "")
            j = j + 1
        }
        id := g.pick_after(end, from)
        if id >= 0 {
            g.add_note(id, text)
        }
        i = j
    }
}

fn (g &mut MapG) link(a int, b int, lab string) {
    k := str(a) + ">" + str(b) + ">" + lab
    for i in 0:g.ek.len {
        got := g.ek[i] + ""
        if got == k {
            <<
        }
    }
    g.ek.push(k)
    g.froms.push(a)
    g.tos.push(b)
    g.elabs.push(lab + "")
}

fn (g &mut MapG) edge(pred int, b int, lab string) {
    if pred >= 0 {
        g.link(pred, b, lab)
    }
}

fn (g &mut MapG) fold_exits(path &string, ids []int) int {
    n := ids.len
    if n == 0 {
        << 0 - 1
    }
    if n == 1 {
        << ids[0]
    }
    j := g.node(str_clone(path) + ":J" + str(g.keys.len), "join", 0)
    for i in 0:n {
        g.link(ids[i], j, "")
    }
    << j
}

fn graph_text(s string) string {
    mut out := ""
    for i in 0:s.len {
        c := s[i] & 255
        if c == 9 || c == 10 || c == 13 {
            out = out + " "
        } else {
            out = out + string_from_byte(c)
        }
    }
    << out
}

fn (g &mut MapG) render() string {
    mut text := "flowchart TD\n"
    n := g.froms.len
    for e in 0:n {
        a := g.froms[e]
        b := g.tos[e]
        la := mermaid_text(g.labels[a] + "")
        lb := mermaid_text(g.labels[b] + "")
        el := g.elabs[e] + ""
        text.push_str("    ")
        text.push_str(box_of(a, la, g.shapes[a]))
        if el.len == 0 {
            text.push_str(" --> ")
        } else {
            text.push_str(" -->|\"")
            text.push_str(mermaid_edge(el))
            text.push_str("\"| ")
        }
        text.push_str(box_of(b, lb, g.shapes[b]))
        text.push_str("\n")
    }
    << text
}

fn (g &mut MapG) render_graph() string {
    mut text := ""
    nn := g.keys.len
    for i in 0:nn {
        text.push_str("N\t")
        text.push_str(str(i))
        text.push_str("\t")
        text.push_str(str(g.shapes[i]))
        text.push_str("\t")
        text.push_str(graph_text(g.labels[i] + ""))
        text.push_str("\n")
    }
    ne := g.froms.len
    for e in 0:ne {
        text.push_str("E\t")
        text.push_str(str(g.froms[e]))
        text.push_str("\t")
        text.push_str(str(g.tos[e]))
        text.push_str("\t")
        text.push_str(graph_text(g.elabs[e] + ""))
        text.push_str("\n")
    }
    for i in 0:nn {
        note := g.nnotes[i] + ""
        if note.len == 0 {
            ->
        }
        text.push_str("C\t")
        text.push_str(str(i))
        text.push_str("\t")
        text.push_str(graph_text(note))
        text.push_str("\n")
    }
    << text
}

fn memo_at(memo &[]string, i int) string {
    if i < 0 || i >= memo.len {
        << ""
    }
    << memo[i] + ""
}

fn type_text_at(p &parser.Parser, i int, memo &[]string) string {
    n := node_at(p, i)
    k := n.kind
    if k == ast.nt_int {
        << "int"
    }
    if k == ast.nt_bool {
        << "bool"
    }
    if k == ast.nt_str {
        << "string"
    }
    if k == ast.nt_f64 {
        << "f64"
    }
    if k == ast.nt_named {
        << n.sval + ""
    }
    if k == ast.nt_any {
        << "any"
    }
    if k == ast.nt_temp {
        << "temp"
    }
    if k == ast.nt_self {
        << "Self"
    }
    if k == ast.nt_ref {
        inner := memo_at(memo, n.a)
        if n.ival == 1 {
            << "&mut " + inner
        }
        << "&" + inner
    }
    if k == ast.nt_array {
        inner := memo_at(memo, n.a)
        if n.ival > 0 {
            << "[" + str(n.ival) + "]" + inner
        }
        << "[]" + inner
    }
    if k == ast.nt_chan {
        << "chan " + memo_at(memo, n.a)
    }
    if k == ast.nt_map {
        << "map[" + memo_at(memo, n.a) + "]" + memo_at(memo, n.b)
    }
    << ast.node_name(k)
}

fn type_text(p &parser.Parser, root int) string {
    if root < 0 {
        << ""
    }
    nmax := p.nodes.len
    mut order := []int{}
    mut stk := []int{}
    stk.push(root)
    mut g := 0
    while stk.len > 0 && g < nmax * 4 {
        g = g + 1
        top := stk.len - 1
        i := stk[top]
        if top == 0 {
            stk = []int{}
        } else {
            stk = stk[0:top]
        }
        if i < 0 {
            ->
        }
        order.push(i)
        n := node_at(p, i)
        if n.a >= 0 {
            stk.push(n.a)
        }
        if n.b >= 0 {
            stk.push(n.b)
        }
    }
    mut memo := []string{}
    for _ in 0:nmax {
        memo.push("")
    }
    mut k := order.len
    while k > 0 {
        k = k - 1
        i := order[k]
        if i < 0 || i >= nmax {
            ->
        }
        memo[i] = type_text_at(p, i, &memo)
    }
    << memo_at(&memo, root)
}

fn expr_join_memo(p &parser.Parser, head int, memo &[]string) string {
    mut s := ""
    mut first := 1
    mut i := head
    mut guard := 0
    nmax := p.nodes.len
    while i >= 0 && guard < nmax {
        guard = guard + 1
        if first == 0 {
            s = s + ", "
        }
        first = 0
        s = s + memo_at(memo, i)
        i = p.nodes[i].next
    }
    << s
}

fn expr_text_at(p &parser.Parser, i int, memo &[]string) string {
    n := node_at(p, i)
    k := n.kind
    if k == ast.nk_ident {
        << n.sval + ""
    }
    if k == ast.nk_int {
        << str(n.ival)
    }
    if k == ast.nk_bool {
        if n.ival == 1 {
            << "true"
        }
        << "false"
    }
    if k == ast.nk_str {
        << "'" + n.sval + "'"
    }
    if k == ast.nk_float {
        << "<f64>"
    }
    if k == ast.nk_bin_op {
        << memo_at(memo, n.a) + " " + ast.binop_name(n.ival) + " " + memo_at(memo, n.b)
    }
    if k == ast.nk_un_op {
        << ast.unop_name(n.ival) + memo_at(memo, n.a)
    }
    if k == ast.nk_call {
        << n.sval + "(" + expr_join_memo(p, n.a, memo) + ")"
    }
    if k == ast.nk_method_call {
        << memo_at(memo, n.a) + "." + n.sval + "(" + expr_join_memo(p, n.b, memo) + ")"
    }
    if k == ast.nk_field {
        << memo_at(memo, n.a) + "." + n.sval
    }
    if k == ast.nk_s_field {
        << memo_at(memo, n.a) + "." + n.sval
    }
    if k == ast.nk_index {
        << memo_at(memo, n.a) + "[" + memo_at(memo, n.b) + "]"
    }
    if k == ast.nk_slice {
        op := ast.range_op_str(n.ival)
        left := memo_at(memo, n.b)
        right := memo_at(memo, n.c)
        mut inner := left + " " + op + " " + right
        // Unified `:` hugs both endpoints (`xs[lo:hi]`, `xs[:hi]`, `xs[lo:]`).
        if op == ":" {
            inner = left + ":" + right
        }
        << memo_at(memo, n.a) + "[" + inner + "]"
    }
    if k == ast.nk_borrow {
        inner := memo_at(memo, n.a)
        if n.ival == 1 {
            << "&mut " + inner
        }
        << "&" + inner
    }
    if k == ast.nk_cast {
        << ast.node_name(k) + "(" + memo_at(memo, n.a) + ")"
    }
    if k == ast.nk_recv {
        << "<- " + memo_at(memo, n.a)
    }
    if k == ast.nk_type_is {
        << memo_at(memo, n.a) + " is " + type_text(p, n.b)
    }
    if k == ast.nk_type_as {
        << memo_at(memo, n.a) + " as " + type_text(p, n.b)
    }
    if k == ast.nk_or_catch {
        << memo_at(memo, n.a) + " or (" + n.sval + ")"
    }
    if k == ast.nk_array_lit {
        << "[" + expr_join_memo(p, n.a, memo) + "]"
    }
    if k == ast.nk_empty_array {
        << "[]"
    }
    if k == ast.nk_struct_init {
        << n.sval + "{..}"
    }
    << ast.node_name(k)
}

fn expr_push_kids(p &parser.Parser, i int, stk &mut []int) {
    n := node_at(p, i)
    k := n.kind
    if k == ast.nk_call || k == ast.nk_array_lit {
        mut a := n.a
        mut guard := 0
        nmax := p.nodes.len
        while a >= 0 && guard < nmax {
            guard = guard + 1
            stk.push(a)
            a = p.nodes[a].next
        }
        <<
    }
    if k == ast.nk_method_call {
        if n.a >= 0 {
            stk.push(n.a)
        }
        mut b := n.b
        mut guard := 0
        nmax := p.nodes.len
        while b >= 0 && guard < nmax {
            guard = guard + 1
            stk.push(b)
            b = p.nodes[b].next
        }
        <<
    }
    if n.a >= 0 {
        stk.push(n.a)
    }
    if n.b >= 0 {
        stk.push(n.b)
    }
    if n.c >= 0 {
        stk.push(n.c)
    }
}

fn expr_text(p &parser.Parser, root int) string {
    if root < 0 {
        << ""
    }
    nmax := p.nodes.len
    mut order := []int{}
    mut stk := []int{}
    stk.push(root)
    mut g := 0
    while stk.len > 0 && g < nmax * 8 {
        g = g + 1
        top := stk.len - 1
        i := stk[top]
        if top == 0 {
            stk = []int{}
        } else {
            stk = stk[0:top]
        }
        if i < 0 {
            ->
        }
        order.push(i)
        expr_push_kids(p, i, mut &stk)
    }
    mut memo := []string{}
    for _ in 0:nmax {
        memo.push("")
    }
    mut k := order.len
    while k > 0 {
        k = k - 1
        i := order[k]
        if i < 0 || i >= nmax {
            ->
        }
        memo[i] = expr_text_at(p, i, &memo)
    }
    << memo_at(&memo, root)
}

fn expr_list(p &parser.Parser, head int) string {
    mut s := ""
    mut first := 1
    mut i := head
    mut guard := 0
    nmax := p.nodes.len
    while i >= 0 && guard < nmax {
        guard = guard + 1
        if first == 0 {
            s = s + ", "
        }
        first = 0
        s = s + expr_text(p, i)
        i = p.nodes[i].next
    }
    << s
}

fn assign_sym(op int) string {
    if op == ast.as_add {
        << "+="
    }
    if op == ast.as_sub {
        << "-="
    }
    if op == ast.as_mul {
        << "*="
    }
    if op == ast.as_div {
        << "/="
    }
    if op == ast.as_mod {
        << "%="
    }
    << "="
}

fn stmt_text(p &parser.Parser, ni int) string {
    n := node_at(p,ni)
    k := n.kind
    if k == ast.nk_let {
        mut t := n.sval + " := "
        if n.ival == 1 {
            t = "mut " + t
        }
        if n.a >= 0 {
            t = t + expr_text(p, n.a)
        }
        << t
    }
    if k == ast.nk_assign {
        << expr_text(p, n.a) + " " + assign_sym(n.ival) + " " + expr_text(p, n.b)
    }
    if k == ast.nk_expr_stmt {
        << expr_text(p, n.a)
    }
    if k == ast.nk_return {
        if n.a < 0 {
            << "<<"
        }
        << "<< " + expr_text(p, n.a)
    }
    if k == ast.nk_throw {
        << ">> " + expr_text(p, n.a)
    }
    if k == ast.nk_exit {
        << "<<< " + expr_text(p, n.a)
    }
    if k == ast.nk_break {
        << "<-"
    }
    if k == ast.nk_continue {
        << "->"
    }
    if k == ast.nk_xu {
        << "xu " + expr_text(p, n.a)
    }
    if k == ast.nk_send {
        << expr_text(p, n.a) + " <- " + expr_text(p, n.b)
    }
    if k == ast.nk_const {
        << "const " + n.sval
    }
    << ast.node_name(k)
}

fn fn_label(p &parser.Parser, ni int) string {
    n := node_at(p,ni)
    name := n.sval + ""
    recv := n.d
    mut pi := n.a
    mut s := "fn "
    if recv >= 0 {
        r := node_at(p,recv)
        s = s + "(" + (r.sval + "") + ") "
    }
    s = s + name + "("
    mut first := 1
    mut guard := 0
    nmax := p.nodes.len
    while pi >= 0 && guard < nmax {
        guard = guard + 1
        prm := node_at(p,pi)
        if first == 0 {
            s = s + ", "
        }
        first = 0
        s = s + prm.sval
        pi = prm.next
    }
    s = s + ")"
    << s
}

fn arm_label(p &parser.Parser, ai int) string {
    n := node_at(p,ai)
    k := n.kind
    if k == ast.nk_arm_else {
        << "else"
    }
    if k == ast.nk_arm_int {
        << str(n.ival)
    }
    if k == ast.nk_arm_range {
        << str(n.ival) + " " + n.sval2 + " " + str(n.d)
    }
    if k == ast.nk_arm_str {
        << "'" + n.sval + "'"
    }
    if k == ast.nk_arm_enum {
        << n.sval + ""
    }
    << ast.node_name(k)
}

fn is_stop(k int) int {
    if k == ast.nk_return {
        << 1
    }
    if k == ast.nk_throw {
        << 1
    }
    if k == ast.nk_exit {
        << 1
    }
    if k == ast.nk_break {
        << 1
    }
    if k == ast.nk_continue {
        << 1
    }
    << 0
}

fn or_index(p &parser.Parser, ni int) int {
    n := node_at(p,ni)
    k := n.kind
    if k == ast.nk_or_catch {
        << ni
    }
    if k == ast.nk_let {
        if n.a >= 0 {
            if p.nodes[n.a].kind == ast.nk_or_catch {
                << n.a
            }
        }
    }
    if k == ast.nk_assign {
        if n.b >= 0 {
            if p.nodes[n.b].kind == ast.nk_or_catch {
                << n.b
            }
        }
    }
    if k == ast.nk_expr_stmt {
        if n.a >= 0 {
            if p.nodes[n.a].kind == ast.nk_or_catch {
                << n.a
            }
        }
    }
    << 0 - 1
}

struct EmitSt {
    k []int
    i []int
    pred []int
    lab []string
    ni []int
    did []int
    br []int
    eoff []int
    saw []int
}

fn (s &mut EmitSt) pop() {
    top := s.k.len - 1
    if top <= 0 {
        s.k = []int{}
        s.i = []int{}
        s.pred = []int{}
        s.lab = []string{}
        s.ni = []int{}
        s.did = []int{}
        s.br = []int{}
        s.eoff = []int{}
        s.saw = []int{}
        <<
    }
    s.k = s.k[0:top]
    s.i = s.i[0:top]
    s.pred = s.pred[0:top]
    s.lab = s.lab[0:top]
    s.ni = s.ni[0:top]
    s.did = s.did[0:top]
    s.br = s.br[0:top]
    s.eoff = s.eoff[0:top]
    s.saw = s.saw[0:top]
}

fn (s &mut EmitSt) push_list(i int, pred int, lab string) {
    s.k.push(0)
    s.i.push(i)
    s.pred.push(pred)
    s.lab.push(lab + "")
    s.ni.push(-1)
    s.did.push(-1)
    s.br.push(-1)
    s.eoff.push(0)
    s.saw.push(0)
}

fn (s &mut EmitSt) push_ctrl(kind int, ni int, did int, br int, eoff int) {
    s.k.push(kind)
    s.i.push(-1)
    s.pred.push(-1)
    s.lab.push("")
    s.ni.push(ni)
    s.did.push(did)
    s.br.push(br)
    s.eoff.push(eoff)
    s.saw.push(0)
}

fn (g &mut MapG) emit_open_ctrl(p &parser.Parser, path &string, st &mut EmitSt, i int, nxt int, elen int) int {
    top := st.k.len - 1
    n := node_at(p, i)
    k := n.kind
    elab := st.lab[top] + ""
    if k == ast.nk_if {
        st.i[top] = nxt
        st.lab[top] = ""
        did := g.ast_node(str_clone(path) + ":N" + str(i), "if", 1, n.line)
        g.edge(st.pred[top], did, elab)
        st.push_ctrl(1, i, did, n.a, elen)
        << 1
    }
    if k == ast.nk_match {
        st.i[top] = nxt
        st.lab[top] = ""
        title := "match " + expr_text(p, n.a)
        did := g.ast_node(str_clone(path) + ":N" + str(i), clip(title, 72), 1, n.line)
        g.edge(st.pred[top], did, elab)
        st.push_ctrl(2, i, did, n.b, elen)
        << 1
    }
    if k == ast.nk_while {
        st.i[top] = nxt
        st.lab[top] = ""
        title := "while " + expr_text(p, n.a)
        did := g.ast_node(str_clone(path) + ":N" + str(i), clip(title, 72), 1, n.line)
        g.edge(st.pred[top], did, elab)
        st.push_ctrl(3, i, did, -1, 0)
        << 1
    }
    if k == ast.nk_for {
        st.i[top] = nxt
        st.lab[top] = ""
        rop := ast.range_op_str(n.ival)
        mut ro := " " + rop + " "
        if rop == ":" {
            ro = ":"
        }
        title := "for " + n.sval + " in " + expr_text(p, n.a) + ro + expr_text(p, n.b)
        did := g.ast_node(str_clone(path) + ":N" + str(i), clip(title, 72), 1, n.line)
        g.edge(st.pred[top], did, elab)
        st.push_ctrl(4, i, did, -1, 0)
        << 1
    }
    if k == ast.nk_for_each {
        st.i[top] = nxt
        st.lab[top] = ""
        mut vs := n.sval + ""
        if n.sval2.len > 0 {
            vs = vs + ", " + n.sval2
        }
        title := "for " + vs + " in " + expr_text(p, n.a)
        did := g.ast_node(str_clone(path) + ":N" + str(i), clip(title, 72), 1, n.line)
        g.edge(st.pred[top], did, elab)
        st.push_ctrl(5, i, did, -1, 0)
        << 1
    }
    if k == ast.nk_select {
        st.i[top] = nxt
        st.lab[top] = ""
        did := g.ast_node(str_clone(path) + ":N" + str(i), "select", 1, n.line)
        g.edge(st.pred[top], did, elab)
        st.push_ctrl(6, i, did, n.a, elen)
        << 1
    }
    oc := or_index(p, i)
    if oc >= 0 {
        st.i[top] = nxt
        st.lab[top] = ""
        oc_n := node_at(p, oc)
        sn := node_at(p, i)
        id := g.ast_node(str_clone(path) + ":N" + str(i), clip(stmt_text(p, i), 72), 0, sn.line)
        g.edge(st.pred[top], id, elab)
        g.note_calls(p, i, id)
        st.push_ctrl(7, i, id, oc_n.c, 0)
        << 1
    }
    << 0
}

fn (g &mut MapG) emit_simple(p &parser.Parser, path &string, ni int, pred int, in_lab string) int {
    n := node_at(p, ni)
    id := g.ast_node(str_clone(path) + ":N" + str(ni), clip(stmt_text(p, ni), 72), 0, n.line)
    g.edge(pred, id, in_lab)
    g.note_calls(p, ni, id)
    if is_stop(n.kind) == 1 {
        << 0 - 1
    }
    << id
}

fn push_call_name(names &mut []string, s string) {
    want := s + ""
    if want.len == 0 {
        <<
    }
    for i in 0:names.len {
        got := names[i] + ""
        if got == want {
            <<
        }
    }
    names.push(want)
}

fn collect_calls(p &parser.Parser, root int, names &mut []string) {
    if root < 0 {
        <<
    }
    mut q := []int{}
    n0 := node_at(p, root)
    if n0.kind == ast.nk_call {
        push_call_name(names, n0.sval + "")
    }
    if n0.a >= 0 {
        q.push(n0.a)
    }
    if n0.b >= 0 {
        q.push(n0.b)
    }
    if n0.c >= 0 {
        q.push(n0.c)
    }
    if n0.d >= 0 {
        q.push(n0.d)
    }
    if n0.e >= 0 {
        q.push(n0.e)
    }
    mut qi := 0
    nmax := p.nodes.len
    while qi < q.len && qi < nmax * 2 {
        i := q[qi]
        qi = qi + 1
        if i < 0 {
            ->
        }
        n := node_at(p, i)
        if n.kind == ast.nk_call {
            push_call_name(names, n.sval + "")
        }
        if n.a >= 0 {
            q.push(n.a)
        }
        if n.b >= 0 {
            q.push(n.b)
        }
        if n.c >= 0 {
            q.push(n.c)
        }
        if n.d >= 0 {
            q.push(n.d)
        }
        if n.e >= 0 {
            q.push(n.e)
        }
        if n.next >= 0 {
            q.push(n.next)
        }
    }
}

fn (g &mut MapG) note_calls(p &parser.Parser, ni int, from int) {
    mut names := []string{}
    collect_calls(p, ni, mut &names)
    for i in 0:names.len {
        g.cfrom.push(from)
        g.cname.push(names[i] + "")
    }
}

fn (g &mut MapG) flush_calls() {
    for i in 0:g.cfrom.len {
        want := g.cname[i] + ""
        mut to := 0 - 1
        for j in 0:g.fnames.len {
            got := g.fnames[j] + ""
            if got == want {
                to = g.fids[j]
                <-
            }
        }
        if to >= 0 {
            g.link(g.cfrom[i], to, "call")
        }
    }
}

fn (g &mut MapG) emit_fns(p &parser.Parser, path &string, file_id int) {
    nd := p.decls.len
    for d in 0:nd {
        di := p.decls[d]
        n := node_at(p, di)
        if n.kind == ast.nk_fn {
            body := n.c
            lab := fn_label(p, di)
            name := n.sval + ""
            fid := g.ast_node(str_clone(path) + ":fn:" + str(di), lab, 0, n.line)
            g.fnames.push(name)
            g.fids.push(fid)
            g.edge(file_id, fid, "")
            g.emit_list(p, path, body, fid, "")
        }
    }
}

fn file_text(p string) string {
    << read_file(p) or (err) {
        << ""
    }
}

fn parse_file(prog &string, path string) parser.Parser {
    body := read_file(path) or (err) {
        eprintln(prog + ": cannot read " + path)
        <<< 1
    }
    mut toks := []ast.Token{}
    scanner.lex(body, mut &toks, path + "")
    mut p := parser.new_parser(toks)
    p.file_name = path + ""
    p.parse_module()
    << p
}

fn emit_map(prog &string, files &[]string, kind int) string {
    mut g := MapG{
        keys: []string{},
        labels: []string{},
        shapes: []int{},
        nlines: []int{},
        nnotes: []string{},
        ek: []string{},
        froms: []int{},
        tos: []int{},
        elabs: []string{},
        fnames: []string{},
        fids: []int{},
        cfrom: []int{},
        cname: []string{}
    }
    for i in 0:files.len {
        pth := files[i] + ""
        mut p := parse_file(prog, pth + "")
        mut parent := 0 - 1
        if kind == 0 {
            mid := p.module_id + ""
            base := filepath.base(&pth)
            lab := file_label(base + "", mid + "")
            parent = g.node(pth + "", lab, 0)
            for t in 0:p.imports.len {
                ip := p.imports[t] + ""
                ln := import_line(ip, alias_at(&p, t))
                if ln.len > 0 {
                    iid := g.node(pth + "\n" + ln, ln, 0)
                    g.edge(parent, iid, "")
                }
            }
        }
        from := g.keys.len
        g.emit_fns(&p, &pth, parent)
        src := file_text(pth + "")
        if src.len > 0 {
            g.attach_comments(src + "", from)
        }
    }
    g.flush_calls()
    if kind == 1 {
        << g.render_graph()
    }
    << g.render()
}

fn print_usage(prog &string) {
    println("usage: " + prog + " [options] [path...]")
    println("")
    println("Generate a source flowchart (Mermaid flowchart TD) or syntax graph.")
    println("")
    println("Arguments:")
    println("  [path...]          source files or directories to inspect (default: .)")
    println("")
    println("Options:")
    println("  -o, --output FILE  write the map output to file instead of stdout")
    println("  --graph            output machine-readable TSV lines instead of Mermaid")
    println("  -h, --help         show this help message")
}

fn main() int {
    argv := args()
    mut prog := "xu-map"
    if argv.len > 0 {
        prog = argv[0]
        mut cut := 0 - 1
        for i in 0:prog.len {
            if prog[i] == 47 {
                cut = i
            }
        }
        if cut >= 0 {
            prog = prog[cut + 1:prog.len]
        }
    }
    mut out_path := ""
    mut kind := 0
    mut roots := []string{}
    mut i := 1
    mut skip := 0
    while i < argv.len {
        if skip == 1 {
            skip = 0
        } else {
            a := argv[i] + ""
            if a == "-h" || a == "--help" {
                print_usage(&prog)
                << 0
            } else {
                if a == "-o" || a == "--output" || a == "--out" {
                    if i + 1 >= argv.len {
                        eprintln(prog + ": -o requires a path")
                        << 1
                    }
                    out_path = argv[i + 1] + ""
                    skip = 1
                } else {
                    if a == "--graph" || a == "-graph" {
                        kind = 1
                    } else {
                        if a.len > 0 && a[0] == 45 {
                            eprintln(prog + ": unknown flag '" + a + "'")
                            << 1
                        } else {
                            roots.push(a + "")
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    if roots.len == 0 {
        roots.push(".")
    }
    mut files := []string{}
    for r in 0:roots.len {
        collect_root(&prog, roots[r] + "", mut &files)
    }
    if files.len == 0 {
        eprintln(prog + ": no .xu files")
        << 1
    }
    sort.strings(mut &files)
    text := emit_map(&prog, &files, kind)
    if out_path.len > 0 {
        write_file(out_path, text) or (err) {
            eprintln(prog + ": cannot write " + out_path)
            << 1
        }
        << 0
    }
    if text.len > 0 && text[text.len - 1] == 10 {
        println(text[0:text.len - 1])
    } else {
        println(text)
    }
    << 0
}
