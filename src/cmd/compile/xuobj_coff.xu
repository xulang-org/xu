@main
// XUOBJ -> PE-COFF .o (windows-x64 / windows-arm64). Port of scripts/xuobj_to_coff_o.py.
// Host symbols xu_ui_mem_try_* / xu_ui_host_run stay undefined for pack link.

// PE-COFF constants (decimal; Xu has no hex literals).
// MACHINE_AMD64=34404 (0x8664) MACHINE_ARM64=43620 (0xAA64)
// SCN_CNT_CODE=32 SCN_CNT_INIT_DATA=64
// SCN_MEM_EXECUTE=536870912 SCN_MEM_READ=1073741824 SCN_MEM_WRITE=2147483648
// SCN_ALIGN_1=1048576 SCN_ALIGN_8=13631488
// C_EXT=2
// IMAGE_REL_AMD64_REL32=4
// IMAGE_REL_ARM64_BRANCH26=3 PAGEBASE_REL21=4 PAGEOFFSET_12A=6 BRANCH19=15
// FK_B/BL/CBZ/CBNZ/ADRP_ADD = 0..4 (arm64); FK_REL32=0 FK_RIP32=1 (x64)

fn coff_align(n int, a int) int {
    if a <= 1 { << n }
    if a <= 0 { << n }
    << ((n + a - 1) / a) * a
}

fn coff_put_u32(b &mut []int, v int) {
    b.push(v & 255)
    b.push((v >> 8) & 255)
    b.push((v >> 16) & 255)
    b.push((v >> 24) & 255)
}

fn coff_put_u16(b &mut []int, v int) {
    b.push(v & 255)
    b.push((v >> 8) & 255)
}

fn coff_set_u32_le(b &mut []int, off int, v int) {
    b[off] = v & 255
    b[off + 1] = (v >> 8) & 255
    b[off + 2] = (v >> 16) & 255
    b[off + 3] = (v >> 24) & 255
}

fn coff_append_bytes(dst &mut []int, src &[]int) {
    for i in 0:src.len {
        dst.push(src[i] & 255)
    }
}

fn coff_pad_buf_to(buf &mut []int, off int) {
    for _ in buf.len:off {
        buf.push(0)
    }
}

fn coff_write_str8(buf &mut []int, s string) {
    for i in 0:8 {
        if i < s.len {
            buf.push(s[i] & 255)
        } else {
            buf.push(0)
        }
    }
}

fn coff_is_host_sym(name &string) bool {
    if str_eq_lit(name, "xu_ui_host_run") { << true }
    if str_eq_lit(name, "xu_ui_mem_try_write") { << true }
    if str_eq_lit(name, "xu_ui_mem_try_read_len") { << true }
    if str_eq_lit(name, "xu_ui_mem_try_read_copy") { << true }
    << false
}

fn coff_host_syms_seed(list &mut []string) {
    undef_add(list, "xu_ui_host_run")
    undef_add(list, "xu_ui_mem_try_write")
    undef_add(list, "xu_ui_mem_try_read_len")
    undef_add(list, "xu_ui_mem_try_read_copy")
}

fn coff_iat_imp_name(lab string) string {
    << "__imp_" + lab[5:lab.len]
}

fn coff_realign_data(
    data &[]int,
    lname &[]string,
    loff &[]int,
    ldata &[]int,
    out_data &mut []int,
    out_loff &mut []int
) int {
    nlab := lname.len
    mut dorder := []int{}
    for i in 0:nlab {
        if ldata[i] != 0 {
            dorder.push(i)
        }
    }
    nd := dorder.len
    mut a := 0
    while a < nd {
        mut best := a
        mut b := a + 1
        while b < nd {
            ib := dorder[best]
            jb := dorder[b]
            if loff[jb] < loff[ib] {
                best = b
            }
            b = b + 1
        }
        if best != a {
            t := dorder[a]
            dorder[a] = dorder[best]
            dorder[best] = t
        }
        a = a + 1
    }
    if nd == 0 {
        for i in 0:data.len {
            out_data.push(data[i] & 255)
        }
        for i in 0:nlab {
            out_loff.push(loff[i])
        }
        << 0
    }
    mut new_loff := []int{}
    for i in 0:nlab {
        new_loff.push(loff[i])
    }
    mut cursor := 0
    for k in 0:nd {
        i := dorder[k]
        off := loff[i]
        if off < cursor {
            eprintln("xuobj_coff: overlapping data labels at " + str(off))
            << 1
        }
        for j in cursor:off {
            out_data.push(data[j] & 255)
        }
        while out_data.len % 8 != 0 {
            out_data.push(0)
        }
        new_loff[i] = out_data.len
        cursor = off
    }
    for j in cursor:data.len {
        out_data.push(data[j] & 255)
    }
    for i in 0:nlab {
        out_loff.push(new_loff[i])
    }
    << 0
}

fn coff_sym_index_of(sname &[]string, name &string) int {
    for i in 0:sname.len {
        si := sname[i]
        if str_eq(&si, name) {
            << i
        }
    }
    << 0 - 1
}

fn coff_build_undef(
    pending_lab &[]string,
    lname &[]string,
    undef &mut []string
) {
    coff_host_syms_seed(undef)
    for i in 0:pending_lab.len {
        lab := pending_lab[i]
        if coff_is_host_sym(&lab) {
            undef_add(undef, lab)
            ->
        }
        if starts_with(lab, "_iat_") {
            undef_add(undef, coff_iat_imp_name(lab))
            ->
        }
        li := lab_index(lname, &lab)
        if li < 0 {
            undef_add(undef, lab)
        }
    }
}

fn coff_apply_local_branch_arm64(code &mut []int, kind int, roff int, target_off int) {
    cur := roff
    delta := (target_off - cur) / 4
    if kind == 0 || kind == 1 {
        imm26 := delta & 67108863
        mut opcode := 335544320
        if kind == 1 {
            opcode = 2483027968
        }
        coff_set_u32_le(code, roff, opcode | imm26)
    } else {
        if kind == 2 || kind == 3 {
            imm19 := delta & 524287
            rt := code[roff] & 31
            mut opcode := 3019898880
            if kind == 3 {
                opcode = 3036676096
            }
            coff_set_u32_le(code, roff, opcode | (imm19 << 5) | rt)
        }
    }
}

fn coff_pack_text_relocs(
    is_arm64 int,
    pkind &[]int,
    proff &[]int,
    plab &[]string,
    sname &[]string,
    text_relocs &mut []int
) int {
    for i in 0:pkind.len {
        kind := pkind[i]
        ro := proff[i]
        lab := plab[i]
        mut sym_name := str_clone(&lab)
        if is_arm64 == 0 {
            if kind == 1 {
                if starts_with(lab, "_iat_") {
                    sym_name = coff_iat_imp_name(lab)
                }
            } else {
                if kind != 0 {
                    eprintln("xuobj_coff: unknown x64 reloc kind " + str(kind))
                    << 1
                }
            }
        } else {
            if kind == 1 || kind == 4 {
                if starts_with(lab, "_iat_") {
                    sym_name = coff_iat_imp_name(lab)
                }
            }
            if kind < 0 || kind > 4 {
                eprintln("xuobj_coff: unknown arm64 reloc kind " + str(kind))
                << 1
            }
        }
        sym := coff_sym_index_of(sname, &sym_name)
        if sym < 0 {
            eprintln("xuobj_coff: missing sym " + sym_name)
            << 1
        }
        if is_arm64 == 0 {
            coff_put_u32(text_relocs, ro)
            coff_put_u32(text_relocs, sym)
            coff_put_u16(text_relocs, 4)
        } else {
            if kind == 0 || kind == 1 {
                coff_put_u32(text_relocs, ro)
                coff_put_u32(text_relocs, sym)
                coff_put_u16(text_relocs, 3)
            } else {
                if kind == 2 || kind == 3 {
                    coff_put_u32(text_relocs, ro)
                    coff_put_u32(text_relocs, sym)
                    coff_put_u16(text_relocs, 15)
                } else {
                    // FK_ADRP_ADD → PAGEBASE_REL21 + PAGEOFFSET_12A
                    coff_put_u32(text_relocs, ro)
                    coff_put_u32(text_relocs, sym)
                    coff_put_u16(text_relocs, 4)
                    coff_put_u32(text_relocs, ro + 4)
                    coff_put_u32(text_relocs, sym)
                    coff_put_u16(text_relocs, 6)
                }
            }
        }
    }
    << 0
}

fn coff_strtab_find(strings2 &[]int, name string) int {
    mut i := 0
    while i < strings2.len {
        mut j := 0
        mut ok := 1
        while j < name.len {
            if i + j >= strings2.len {
                ok = 0
            }
            if ok == 1 && (strings2[i + j] & 255) != (name[j] & 255) {
                ok = 0
            }
            j = j + 1
        }
        if ok == 1 {
            if i + name.len < strings2.len && strings2[i + name.len] == 0 {
                << 4 + i
            }
        }
        while i < strings2.len && strings2[i] != 0 {
            i = i + 1
        }
        i = i + 1
    }
    << 0 - 1
}

fn coff_write_file(
    is_arm64 int,
    code &[]int,
    data &[]int,
    sname &[]string,
    sval &[]int,
    ssect &[]int,
    text_relocs &[]int,
    out_o string
) int {
    nsyms := sname.len
    nsections := 2
    file_hdr_sz := 20
    sec_hdr_sz := 40
    text_off := coff_align(file_hdr_sz + sec_hdr_sz * nsections, 16)
    data_off := coff_align(text_off + code.len, 16)
    nreloc := text_relocs.len / 10
    mut text_reloc_off := 0
    if nreloc > 0 {
        text_reloc_off = coff_align(data_off + data.len, 4)
    }
    reloc_bytes := 10 * nreloc
    mut symtab_base := data_off + data.len
    if text_reloc_off > 0 {
        symtab_base = text_reloc_off + reloc_bytes
    }
    symtab_off := coff_align(symtab_base, 4)

    text_chars := 32 | 536870912 | 1073741824 | 1048576
    data_chars := 64 | 1073741824 | 2147483648 | 13631488

    mut name_fields := []int{}
    mut strings2 := []int{}
    for i in 0:nsyms {
        n := sname[i]
        if n.len <= 8 {
            mut nf := []int{}
            coff_write_str8(mut &nf, n)
            for j in 0:8 {
                name_fields.push(nf[j])
            }
        } else {
            mut off := coff_strtab_find(&strings2, n)
            if off < 0 {
                off = 4 + strings2.len
                for j in 0:n.len {
                    strings2.push(n[j] & 255)
                }
                strings2.push(0)
            }
            coff_put_u32(mut &name_fields, 0)
            coff_put_u32(mut &name_fields, off)
        }
    }
    mut string_table := []int{}
    coff_put_u32(mut &string_table, 4 + strings2.len)
    coff_append_bytes(mut &string_table, &strings2)

    mut machine := COFF_MACHINE_AMD64
    mut arch_name := "x64"
    if is_arm64 == 1 {
        machine = COFF_MACHINE_ARM64
        arch_name = "arm64"
    }

    mut buf := []int{}
    coff_put_u16(mut &buf, machine)
    coff_put_u16(mut &buf, nsections)
    coff_put_u32(mut &buf, 0)
    coff_put_u32(mut &buf, symtab_off)
    coff_put_u32(mut &buf, nsyms)
    coff_put_u16(mut &buf, 0)
    coff_put_u16(mut &buf, 0)

    coff_write_str8(mut &buf, ".text")
    coff_put_u32(mut &buf, code.len)
    coff_put_u32(mut &buf, 0)
    coff_put_u32(mut &buf, code.len)
    coff_put_u32(mut &buf, text_off)
    coff_put_u32(mut &buf, text_reloc_off)
    coff_put_u32(mut &buf, 0)
    coff_put_u16(mut &buf, nreloc)
    coff_put_u16(mut &buf, 0)
    coff_put_u32(mut &buf, text_chars)

    coff_write_str8(mut &buf, ".data")
    coff_put_u32(mut &buf, data.len)
    coff_put_u32(mut &buf, 0)
    coff_put_u32(mut &buf, data.len)
    coff_put_u32(mut &buf, data_off)
    coff_put_u32(mut &buf, 0)
    coff_put_u32(mut &buf, 0)
    coff_put_u16(mut &buf, 0)
    coff_put_u16(mut &buf, 0)
    coff_put_u32(mut &buf, data_chars)

    coff_pad_buf_to(mut &buf, text_off)
    coff_append_bytes(mut &buf, code)
    coff_pad_buf_to(mut &buf, data_off)
    coff_append_bytes(mut &buf, data)
    if nreloc > 0 {
        coff_pad_buf_to(mut &buf, text_reloc_off)
        coff_append_bytes(mut &buf, text_relocs)
    }
    coff_pad_buf_to(mut &buf, symtab_off)
    for i in 0:nsyms {
        base := i * 8
        for j in 0:8 {
            buf.push(name_fields[base + j])
        }
        coff_put_u32(mut &buf, sval[i])
        coff_put_u16(mut &buf, ssect[i])
        coff_put_u16(mut &buf, 0)
        buf.push(2)
        buf.push(0)
    }
    coff_append_bytes(mut &buf, &string_table)

    write_file(out_o, string_from_bytes(buf)) or (err) {
        eprintln("xuobj_coff: cannot write " + out_o)
        << 1
    }
    println("wrote " + out_o + " arch=" + arch_name + " code=" + str(code.len) + " data=" + str(data.len) + " syms=" + str(nsyms) + " rel=" + str(nreloc))
    << 0
}

fn xuobj_coff_from_obj(obj &mut XuObject, out_o string) int {
    mut is_arm64 := 0
    if obj.arch == 1 {
        is_arm64 = 1
    } else {
        if obj.arch != 2 {
            eprintln("xuobj_coff: need arm64=1 or x64=2 (arch=" + str(obj.arch) + ")")
            << 1
        }
    }
    mut data_in := []int{}
    for i in 0:obj.data.len {
        data_in.push(obj.data[i] & 255)
    }
    mut lname_b := []string{}
    mut loff_b := []int{}
    mut ldata_b := []int{}
    for i in 0:obj.lname.len {
        nm := obj.lname[i]
        lname_b.push(str_clone(&nm))
        loff_b.push(obj.loff[i])
        ldata_b.push(obj.ldata[i])
    }
    mut data_out := []int{}
    mut loff_out := []int{}
    mut rc := coff_realign_data(&data_in, &lname_b, &loff_b, &ldata_b, mut &data_out, mut &loff_out)
    if rc != 0 {
        << rc
    }
    obj.data = data_out
    obj.loff = loff_out

    mut code_work := []int{}
    for i in 0:obj.code.len {
        code_work.push(obj.code[i] & 255)
    }
    mut lname_work := []string{}
    mut loff_work := []int{}
    mut ldata_work := []int{}
    for i in 0:obj.lname.len {
        nm := obj.lname[i]
        lname_work.push(str_clone(&nm))
        loff_work.push(obj.loff[i])
        ldata_work.push(obj.ldata[i])
    }

    mut pk := []int{}
    mut po := []int{}
    mut pl := []string{}
    for i in 0:obj.rkind.len {
        kind := obj.rkind[i]
        ro := obj.roff[i]
        lab := obj.rlab[i]
        if coff_is_host_sym(&lab) {
            pk.push(kind)
            po.push(ro)
            pl.push(str_clone(&lab))
            ->
        }
        li := lab_index(&lname_work, &lab)
        if is_arm64 == 0 {
            if kind == 0 && li >= 0 && ldata_work[li] == 0 {
                target := loff_work[li]
                coff_set_u32_le(mut &code_work, ro, target - (ro + 4))
                ->
            }
        } else {
            if li >= 0 && ldata_work[li] == 0 && (kind == 0 || kind == 1 || kind == 2 || kind == 3) {
                coff_apply_local_branch_arm64(mut &code_work, kind, ro, loff_work[li])
                ->
            }
        }
        pk.push(kind)
        po.push(ro)
        pl.push(str_clone(&lab))
    }

    nlab := lname_work.len
    mut order := []int{}
    xuobj_macho_sort_lab_order(nlab, &lname_work, &loff_work, &ldata_work, mut &order)

    mut dname := []string{}
    mut dsect := []int{}
    mut dval := []int{}
    for k in 0:nlab {
        i := order[k]
        name := lname_work[i]
        if coff_is_host_sym(&name) {
            ->
        }
        mut sect := 1
        if ldata_work[i] != 0 {
            sect = 2
        }
        dname.push(str_clone(&name))
        dsect.push(sect)
        dval.push(loff_work[i])
    }
    start_lab := "_start"
    si := lab_index(&lname_work, &start_lab)
    if si >= 0 {
        mut has := 0
        for i in 0:dname.len {
            if str_eq_lit(&dname[i], "xu_app_start") {
                has = 1
            }
        }
        if has == 0 {
            dname.push("xu_app_start")
            dsect.push(1)
            dval.push(loff_work[si])
        }
    }

    mut undef := []string{}
    coff_build_undef(&pl, &lname_work, mut &undef)
    mut undef_list := []string{}
    for i in 0:undef.len {
        if !str_in_list(&dname, undef[i]) {
            u := undef[i]
            undef_list.push(str_clone(&u))
        }
    }
    undef_list = sort_names(undef_list)

    mut sname := []string{}
    mut sval := []int{}
    mut ssect := []int{}
    for i in 0:dname.len {
        dn := dname[i]
        sname.push(str_clone(&dn))
        sval.push(dval[i])
        ssect.push(dsect[i])
    }
    for i in 0:undef_list.len {
        un := undef_list[i]
        sname.push(str_clone(&un))
        sval.push(0)
        ssect.push(0)
    }

    mut code_b := []int{}
    for i in 0:code_work.len {
        code_b.push(code_work[i] & 255)
    }
    mut tr := []int{}
    rc = coff_pack_text_relocs(is_arm64, &pk, &po, &pl, &sname, mut &tr)
    if rc != 0 {
        << rc
    }
    << coff_write_file(is_arm64, &code_b, &obj.data, &sname, &sval, &ssect, &tr, out_o)
}

fn xuobj_coff_read_raw(path string) []int {
    src := read_file(path) or (err) {
        eprintln("xuobj_coff: cannot read " + path)
        << []int{}
    }
    mut raw := []int{}
    for i in 0:src.len {
        raw.push(src[i] & 255)
    }
    << raw
}

fn xuobj_coff_convert(xuobj_path string, out_o string) int {
    raw := xuobj_coff_read_raw(xuobj_path)
    if raw.len == 0 {
        << 1
    }
    if raw.len < 12 {
        eprintln("xuobj_coff: truncated XUOBJ")
        << 1
    }
    mut obj := xuobj_decode_archive(raw)
    << xuobj_coff_from_obj(mut &obj, out_o)
}
