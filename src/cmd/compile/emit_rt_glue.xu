@main

#xu/types

struct RtUse {
    use_pi bool
    use_pb bool
    use_ps bool
    use_pf bool
    use_fr bool
    use_cc bool
    use_sc bool
    use_oob bool
    use_dz bool
    use_dov bool
    use_as bool
    use_taf bool
    use_uw bool
    use_uwe bool
    use_ps_str bool
    use_ap bool
    use_itoa bool
    use_sfb bool
    use_sbytes bool
    use_str_bytes bool
    use_str_runes bool
    use_slice bool
    use_aslice bool
    use_rf bool
    use_rd bool
    use_wf bool
    use_args bool
    use_str_eq bool
    use_string_storage bool
    use_parse bool
    use_sw bool
    use_now bool
    use_wall bool
    use_sleep bool
    use_pid bool
    use_ppid bool
    use_uid bool
    use_gid bool
    use_euid bool
    use_egid bool
    use_pagesize bool
    use_host_name bool
    use_cwd bool
    use_env_get bool
    use_env_list bool
    use_tmp_dir bool
    use_stat bool
    use_mkdir bool
    use_rename bool
    use_remove bool
    use_dial bool
    use_listen bool
    use_accept bool
    use_connclose bool
    use_connwrite bool
    use_connread bool
    use_socket bool
    use_bind4 bool
    use_connect4 bool
    use_bind6 bool
    use_connect6 bool
    use_bind_unix bool
    use_connect_unix bool
    use_listen_fd bool
    use_sendto bool
    use_recvfrom bool
    use_sock_timeo bool
    use_iface bool
    use_os_system bool
    use_os_exec bool
    use_ui_host bool
    use_fd bool
    use_chan bool
    use_xu bool
    use_test bool
    use_map bool
    use_fs2 bool
    use_random_fill bool
    use_security_store bool
    // Hosted executables always materialize the optional allocator report.
    // The helper itself checks XU_HEAP_STATS, so the default stderr contract
    // remains unchanged while Gen1 keeps parity with bootstrap's seven-field
    // heap-stats ABI.
    use_heap_stats bool
}

// Fill the caller's storage in place. Returning this large aggregate by value
// is not stable across the frozen Gen1 ABI: a test-only tail flag used to be
// lost or corrupt the copy, producing either SIGSEGV or a missing jmpbuf.
fn scan_rt_use(m &types.Mir, u &mut RtUse) {
    // Interface drop dispatch covers every registered map layout, including
    // maps in unused generic declarations. Those calls are emitted outside
    // MIR: an instruction-only scan would omit _rt_map_drop for old callers
    // that merely import a package containing an owning map field.
    if m.maps.len > 0 {
        u.use_map = true
        u.use_fr = true
        u.use_sc = true
        u.use_str_eq = true
    }
    for fi in 0:m.fns.len {
        if types.mir_fn_is_extern(m, fi) { -> }
        nins := types.mir_nins(m, fi)
        ntemps := types.mir_ntemps(m, fi)
        nlocals := types.mir_nlocals(m, fi)
        for ii in 0:nins {
            ik := types.mir_ikind(m, fi, ii)
            ib := types.mir_ib(m, fi, ii)
            ia := types.mir_ia(m, fi, ii)
            sval := types.mir_isval(m, fi, ii)
            if ik == 30 || ik == 31 || ik == 32 || ik == 34 || ik == 35 || ik == 36 { u.use_chan = true }
            if ik == 33 || ik == 37 { u.use_xu = true
                u.use_fr = true }
            if ik == 7 {
                if ib == 1 && (sval == "_xu_strings_storage_repeat" || sval == "_xu_strings_storage_reserve" || sval == "_xu_strings_storage_capacity") {
                    u.use_string_storage = true
                    u.use_fr = true
                }
                tb2 := ib
                if tb2 >= 151 && tb2 <= 155 {
                    u.use_xu = true
                    u.use_chan = true
                    if tb2 == 155 { u.use_now = true }
                    u.use_fr = true
                }
                if tb2 == 2 { u.use_pi = true }
                if tb2 == 3 { u.use_pb = true }
                if tb2 == 4 { u.use_ps = true }
                if tb2 == 7 { u.use_pi = true }
                if tb2 == 8 { u.use_pb = true }
                if tb2 == 9 { u.use_ps = true }
                if tb2 == 22 { u.use_pf = true }
                if tb2 == 23 { u.use_pf = true }
                if tb2 == 6 { u.use_itoa = true }
                if tb2 == 10 { u.use_sfb = true }
                if tb2 == 11 { u.use_sbytes = true }
                if tb2 == 81 { u.use_str_bytes = true }
                if tb2 == 82 { u.use_str_runes = true }
                if tb2 == 12 { u.use_rf = true }
                if tb2 == 27 { u.use_rd = true }
                if tb2 == 13 { u.use_wf = true }
                if tb2 == 14 { u.use_args = true }
                if tb2 == 24 { u.use_as = true }
                if tb2 == 20 { u.use_slice = true }
                if tb2 == 83 { u.use_aslice = true }
                if tb2 == 100 { u.use_ui_host = true }
                if tb2 == 25 { u.use_parse = true }
                if tb2 == 26 { u.use_sw = true }
                if tb2 == 28 { u.use_now = true }
                if tb2 == 136 { u.use_wall = true }
                if tb2 == 29 { u.use_sleep = true }
                if tb2 == 45 { u.use_pid = true }
                if tb2 == 46 { u.use_ppid = true }
                if tb2 == 47 { u.use_uid = true }
                if tb2 == 48 { u.use_gid = true }
                if tb2 == 49 { u.use_euid = true }
                if tb2 == 50 { u.use_egid = true }
                if tb2 == 51 { u.use_pagesize = true }
                if tb2 == 52 { u.use_host_name = true }
                if tb2 == 53 { u.use_cwd = true }
                if tb2 == 54 { u.use_env_get = true }
                if tb2 == 55 { u.use_env_list = true }
                if tb2 == 56 { u.use_tmp_dir = true }
                if tb2 == 57 { u.use_stat = true }
                if tb2 == 58 { u.use_mkdir = true }
                if tb2 == 59 { u.use_rename = true }
                if tb2 == 60 { u.use_remove = true }
                if tb2 == 65 { u.use_connect4 = true }
                if tb2 == 66 { u.use_listen = true }
                if tb2 == 67 { u.use_accept = true }
                if tb2 == 68 { u.use_connclose = true }
                if tb2 == 69 { u.use_connwrite = true }
                if tb2 == 70 { u.use_connread = true }
                if tb2 == 93 { u.use_socket = true }
                if tb2 == 94 { u.use_sendto = true }
                if tb2 == 96 { u.use_bind4 = true }
                if tb2 == 131 { u.use_bind6 = true }
                if tb2 == 132 { u.use_connect6 = true }
                if tb2 == 133 { u.use_bind_unix = true }
                if tb2 == 134 { u.use_connect_unix = true }
                if tb2 == 97 { u.use_listen_fd = true }
                if tb2 == 104 { u.use_recvfrom = true }
                if tb2 == 121 { u.use_sock_timeo = true }
                if tb2 == 135 {
                    u.use_iface = true
                    // Keep a mature RtUse field as the cross-wave marker too:
                    // older self-host hops may drop the newly-added tail field
                    // when returning this large aggregate by value.
                    u.use_socket = true
                }
                if tb2 == 71 { u.use_os_system = true }
                if tb2 == 129 { u.use_os_exec = true }
                if tb2 >= 72 && tb2 <= 75 { u.use_fd = true }
                if tb2 >= 123 && tb2 <= 128 { u.use_fs2 = true }
                if tb2 == 130 {
                    u.use_random_fill = true
                    u.use_fr = true
                }
                if tb2 == 137 {
                    u.use_security_store = true
                    u.use_fr = true
                }
                if tb2 == 30 || tb2 == 31 || tb2 == 32 || tb2 == 33 || (tb2 >= 116 && tb2 <= 120) { u.use_test = true }
                if (tb2 >= 84 && tb2 <= 92) || tb2 == 98 {
                    u.use_map = true
                    u.use_fr = true
                    u.use_sc = true
                    u.use_str_eq = true
                }
            }
            if ik == 7 && ib == 5 { u.use_ps_str = true }
            if ik == 7 && ib == 122 { u.use_ps_str = true }
            // G3: lowered Div/Mod zero guard calls rt_div_zero (b=1 call, sval).
            if ik == 7 && ib == 1 && sval == "_rt_div_zero" { u.use_dz = true }
            if ik == 7 && ib == 1 && sval == "_rt_div_overflow" { u.use_dov = true }
            if ik == 7 && sval == "_rt_interface_data" {
                u.use_iface = true
                u.use_socket = true
            }
            if ik == 9 { u.use_sc = true }
            if ik == 42 && sval == "keep" && types.mir_id(m, fi, ii) == 3 {
                u.use_sc = true
            }
            if ik == 10 { u.use_sc = true } // LoadField on string field -> StrClone not needed; ignore
            if ik == 11 { u.use_sc = true } // StoreField on string field; ignore
            // ArrayLit (12) has no bounds check; do not clear u.use_oob.
            if ik == 13 || ik == 46 {
                u.use_ap = true
                u.use_fr = true
            } // ArrPush / ArrPush4 -> alloc/free
            if ik == 14 || ik == 20 || ik == 23 || ik == 47 { u.use_oob = true }
            if ik == 20 { u.use_oob = true } // StoreIndex bounds check
            if ik == 23 { u.use_oob = true } // ElemAddr bounds check
            if ik == 19 { u.use_uw = true } // Result.unwrap()/expr! Err path
            if ik == 45 { u.use_uwe = true } // Result.unwrap_err Ok path (M157)
            if ik == 24 { u.use_fr = true } // DropBufField calls rt_free
            str_bin := ik == 4 && ib == 1 && ia >= 0 && ia < ntemps && types.mir_temp_ty(m, fi, ia) == 3
            if str_bin { u.use_cc = true }
            if ik == 4 && sval == "str_cmp" { u.use_str_eq = true }
            // Drop free (M7c): string / non-owning array buffer via emit_drop_value.
            if ik == 8 {
                u.use_fr = true
                lid := ia
                if lid >= 0 && lid < nlocals {
                    if types.is_map_type(types.mir_local_ty(m, fi, lid)) { u.use_map = true }
                }
            }
            if ik == 39 { u.use_fr = true } // MakeClosure → alloc (+ later Drop → free)
            if ik == 40 || ik == 44 { u.use_fr = true } // M147/M200 box
            if ik == 42 {
                u.use_taf = true
                if sval != "keep" {
                    u.use_fr = true
                }
            } // as: fail-loud; free only when consuming
            if ik == 43 { u.use_taf = true } // InterfaceMethod miss → fail-loud
            if ik == 20 && ia >= 0 && ia < ntemps {
                bty := types.mir_temp_ty(m, fi, ia)
                if types.is_array_type(bty) {
                    ety := m.arrays[bty - 200].elem_ty
                    if m.type_owning(ety) { u.use_fr = true }
                }
            }
        }
    }
    <<
}

// Wave C: print/alloc/str/assert helpers — split from emit_rt_core_helpers (W3).
fn emit_rt_core_str(a &mut Assembler, u &RtUse, mc int, use_write bool) {
    // `_rt_alloc` is present for every hosted program (collect_args and
    // string temporaries use it), therefore its ledger diagnostics must be
    // link-complete even when the user never asks for XU_HEAP_STATS.
    // Keep allocator diagnostics link-complete even while the optional
    // accounting capability is disabled; `_rt_free` uses the corruption
    // message on its fail-closed metadata path.
    if a.os != 3 { rt_emit_heap_data(a) }
    if u.use_pi || u.use_heap_stats { rt_emit_println_int(a) }
    if u.use_pb { rt_emit_println_bool(a) }
    if u.use_ps { rt_emit_println_str(a) }
    if u.use_pf { rt_emit_println_f64(a) }
    rt_emit_alloc(a, mc)
    rt_emit_make_ints(a)
    rt_emit_make_string(a)
    rt_emit_count_byte(a)
    rt_emit_find_byte(a)
    rt_emit_split_byte(a)
    rt_emit_join(a)
    if u.use_string_storage && (a.arch == 0 || a.arch == 1) {
        rt_emit_string_storage(a)
    }
    if u.use_fr {
        rt_emit_free(a, mc)
        rt_emit_str_release(a)
    }
    if u.use_cc { rt_emit_str_concat(a) }
    if u.use_ps_str || u.use_rd { rt_emit_push_str(a) }
    if u.use_sc { rt_emit_str_clone(a) }
    // Keep the historical injection anchor on its own line: bootstrap adds
    // the build-time `rt_emit_xu_mark` call immediately after this statement
    // while compiling Gen1 sources. The allocator's failure paths also use
    // the writer when no user-facing print helper was requested.
    if use_write { rt_emit_write(a) }
    // Alloc/free call these internal bookkeeping helpers on hosted targets.
    // Keep them out of freestanding images, whose bump allocator deliberately
    // has no reclaim/ledger ABI.
    if a.os != 3 && gen1_heap_ledger_on() {
        rt_emit_heap_record_alloc(a, mc)
        if u.use_fr { rt_emit_heap_record_free(a, mc) }
    }
    if u.use_heap_stats && gen1_heap_ledger_on() { rt_emit_heap_stats(a, mc) }
    if u.use_ap {
        rt_emit_arr_push(a)
        rt_emit_arr_grow(a)
        rt_emit_arr_push4(a)
    }
    if u.use_oob { rt_emit_oob(a) }
    if u.use_dz { rt_emit_div_zero(a) }
    if u.use_dov { rt_emit_div_overflow(a) }
    if u.use_as { rt_emit_assert_fail(a) }
    if u.use_taf { rt_emit_as_fail(a) }
    if u.use_uw { rt_emit_unwrap_fail(a) }
    if u.use_uwe { rt_emit_unwrap_err_fail(a) }
    if u.use_sfb { rt_emit_str_from_byte(a) }
    if u.use_sbytes { rt_emit_str_from_bytes(a) }
    if u.use_slice { rt_emit_str_slice(a) }
    if u.use_aslice {
        rt_emit_array_slice(a)
        rt_emit_array_slice_str(a)
    }
    if u.use_str_eq { rt_emit_str_eq(a) }
    if u.use_map { rt_emit_map(a) }
    <<
}

// Wave C: time/sysinfo/env — split from emit_rt_core_helpers (W3).
fn emit_rt_core_os(a &mut Assembler, u &RtUse, mc int) {
    if u.use_now { rt_emit_now_ns(a) }
    if u.use_wall { rt_emit_wall_time_ns(a) }
    if u.use_sleep {
        if mc != 1 { rt_emit_enter_syscall_stub(a) }
        rt_emit_sleep_ns(a)
    }
    if u.use_pid { rt_emit_getpid(a) }
    if u.use_ppid { rt_emit_getppid(a) }
    if u.use_uid { rt_emit_getuid(a) }
    if u.use_gid { rt_emit_getgid(a) }
    if u.use_euid { rt_emit_geteuid(a) }
    if u.use_egid { rt_emit_getegid(a) }
    if u.use_pagesize { rt_emit_pagesize(a) }
    if u.use_host_name { rt_emit_host_name(a) }
    if u.use_cwd { rt_emit_cwd(a) }
    if u.use_env_get { rt_emit_env_get(a) }
    if u.use_env_list { rt_emit_env_list(a) }
    if u.use_tmp_dir { rt_emit_tmp_dir(a) }
    <<
}

// Wave C: fs/net/files/test — split from emit_rt_core_helpers (W3).
fn emit_rt_core_io(a &mut Assembler, u &RtUse, use_files bool, use_cover bool, mc int) {
    mut use_net := u.use_dial || u.use_listen || u.use_accept || u.use_connclose || u.use_connwrite || u.use_connread || u.use_socket || u.use_bind4 || u.use_connect4 || u.use_bind6 || u.use_connect6 || u.use_bind_unix || u.use_connect_unix || u.use_listen_fd || u.use_sendto || u.use_recvfrom || u.use_sock_timeo || u.use_iface
    if u.use_stat || u.use_mkdir || u.use_rename || u.use_remove || use_net || u.use_fd || u.use_fs2 { rt_emit_errno_msg(a) }
    if u.use_stat { rt_emit_stat(a) }
    if u.use_mkdir { rt_emit_mkdir(a) }
    if u.use_rename { rt_emit_rename(a) }
    if u.use_remove { rt_emit_remove(a) }
    if use_net {
        if mc != 1 && !u.use_sleep { rt_emit_enter_syscall_stub(a) }
        rt_emit_net_win_data(a)
        if a.os == 2 { rt_emit_ws2_init(a) }
    }
    // `sys_interface_data` is often reached through an imported `os` wrapper;
    // Gen1's pre-emission use scan only sees the root MIR in that case.  Keep
    // the Darwin helper and its error data available for that cross-module
    // call even when no direct net call was observed in the root unit.
    if a.os == 0 && !use_net {
        rt_emit_net_win_data(a)
    }
    if u.use_dial { rt_emit_dial_tcp4(a) }
    if u.use_listen { rt_emit_listen_tcp4(a) }
    if u.use_socket { rt_emit_socket(a) }
    if u.use_bind4 { rt_emit_bind4(a) }
    if u.use_connect4 { rt_emit_connect4(a) }
    if u.use_bind6 { rt_emit_bind6(a) }
    if u.use_connect6 { rt_emit_connect6(a) }
    if u.use_bind_unix { rt_emit_bind_unix(a) }
    if u.use_connect_unix { rt_emit_connect_unix(a) }
    if u.use_listen_fd { rt_emit_listen_fd(a) }
    if u.use_sendto { rt_emit_udp_sendto(a) }
    if u.use_recvfrom { rt_emit_udp_recvfrom(a) }
    if u.use_sock_timeo { rt_emit_setsockopt_timeo(a) }
    if u.use_iface || u.use_socket || a.os == 0 || a.os == 1 { rt_emit_interface_data(a) }
    if u.use_accept { rt_emit_net_accept(a) }
    if u.use_connclose { rt_emit_conn_close(a) }
    if u.use_connwrite { rt_emit_conn_write(a) }
    if u.use_connread { rt_emit_conn_read(a) }
    if u.use_os_system { rt_emit_os_system(a) }
    if u.use_os_exec {
        if mc != 1 && !u.use_sleep && !use_net { rt_emit_enter_syscall_stub(a) }
        rt_emit_os_exec(a)
    }
    if u.use_random_fill { rt_emit_sys_random_fill(a) }
    if u.use_security_store { rt_emit_security_store(a) }
    if u.use_ui_host { rt_emit_ui_host_run(a) }
    if u.use_fd {
        rt_emit_os_open(a)
        rt_emit_os_fd_read(a)
        rt_emit_os_fd_write(a)
        rt_emit_os_fd_close(a)
    }
    if u.use_fs2 {
        rt_emit_os_fs2_data(a)
        rt_emit_os_chmod(a)
        rt_emit_os_chdir(a)
        rt_emit_os_symlink(a)
        rt_emit_os_readlink(a)
        rt_emit_os_fd_seek(a)
        rt_emit_os_pipe(a)
    }
    if u.use_rf || u.use_wf || u.use_rd || u.use_stat || u.use_mkdir || u.use_rename || u.use_remove || u.use_os_system || u.use_os_exec || u.use_ui_host || u.use_fd || u.use_fs2 || u.use_security_store { rt_emit_cstr(a) }
    if u.use_rf { rt_emit_read_file(a) }
    if u.use_rd { rt_emit_read_dir(a) }
    if u.use_wf { rt_emit_write_file(a) }
    if u.use_args { rt_emit_args_clone(a) }
    if use_files { rt_emit_file_str(a) }
    if use_cover { rt_emit_dump_cover(a) }
    if u.use_test {
        rt_emit_test_name(a)
        rt_emit_test_report(a)
        rt_emit_test_summary(a)
        rt_emit_test_setjmp(a)
        rt_emit_test_longjmp(a)
        rt_emit_test_soft_fail(a)
        rt_emit_test_skip(a)
        rt_emit_test_clear(a)
        rt_emit_test_flags(a)
        rt_emit_test_is_short(a)
    }
    <<
}

fn emit_rt_core_helpers(a &mut Assembler, u &RtUse, mc int, use_write bool, use_files bool, use_cover bool) {
    use_throw := u.use_rf || u.use_rd || u.use_wf || u.use_stat || u.use_mkdir || u.use_rename || u.use_remove || u.use_dial || u.use_listen || u.use_accept || u.use_connclose || u.use_connwrite || u.use_connread || u.use_socket || u.use_bind4 || u.use_connect4 || u.use_bind6 || u.use_connect6 || u.use_bind_unix || u.use_connect_unix || u.use_listen_fd || u.use_sendto || u.use_recvfrom || u.use_sock_timeo || u.use_iface || u.use_fd || u.use_fs2 || u.use_random_fill || u.use_security_store
    if use_throw { rt_emit_throw_strerr(a) }
    emit_rt_core_str(a, u, mc, use_write)
    emit_rt_core_os(a, u, mc)
    emit_rt_core_io(a, u, use_files, use_cover, mc)
    <<
}

fn emit_rt_conc_helpers(a &mut Assembler, m &types.Mir, u &RtUse, mc int) {
    if u.use_chan || u.use_xu {
        // Keep scheduler words and the M table naturally aligned. In
        // particular, _rt_xu_wake is updated with LDAXR/STLXR on arm64;
        // placing it after an odd-sized runtime string without this padding
        // makes the exclusive load fault with SIGBUS.
        a.align_data(8)
        if mc == 1 {
            a.data_label("_rt_xu_head")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_xu_tail")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_xu_len")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_xu_wake")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_xu_nwork")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_ms")
            rt_emit_zeros(a, 1280)
            rt_emit_g_jmpbuf(a)
            rt_emit_sched_mn(a)
            rt_emit_xu_pump_mc(a)
            rt_emit_xu_mc(a)
        } else {
            // Cooperative xu queue (non-macOS).
            a.data_label("_rt_xu_queue")
            rt_emit_zeros(a, rt_xu_queue_capacity * rt_xu_queue_entry_bytes)
            a.data_label("_rt_xu_head")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_xu_tail")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_xu_len")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_xu_pumping")
            rt_emit_zeros(a, 8)
            rt_emit_xu_pump(a)
            rt_emit_xu(a)
        }
    }
    if u.use_chan {
        if mc == 1 {
            a.align_data(8)
            a.data_label("_rt_wn_pool")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_wn_pool_n")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_select_lock")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_select_groups")
            rt_emit_zeros(a, 8)
            rt_emit_select_helpers(a, u.use_now)
            rt_emit_wn_pool_helpers(a)
            rt_emit_chan_new_mc(a)
            rt_emit_chan_send_mc(a)
            rt_emit_chan_recv_mc(a)
            rt_emit_chan_close_mc(a)
            rt_emit_chan_try_send_mc(a)
            rt_emit_chan_try_recv_mc(a)
        } else {
            rt_emit_chan_new(a)
            rt_emit_chan_send(a)
            rt_emit_chan_recv(a)
            rt_emit_chan_close(a)
            rt_emit_chan_try_send(a)
            rt_emit_chan_try_recv(a)
        }
    }
    // Per-type drop helpers (array element walks / struct in buffer layout).
    // Emit all owning structs and arrays-with-owning-elem so nested calls resolve.
    if u.use_fr {
        emit_iface_drop_helper(a, m, -1)
        emit_iface_drop_helper(a, m, 1)
        for si in 0:m.structs.len {
            if m.type_owning(types.struct_type(si)) {
                emit_struct_drop_helper(a, m, si)
            }
        }
        for ai in 0:m.arrays.len {
            if m.type_owning(m.arrays[ai].elem_ty) {
                emit_array_drop_helper(a, m, ai)
            }
        }
        for mi in 0:m.maps.len {
            if m.maps[mi].vkind == 2 && m.type_owning(m.maps[mi].val_ty) {
                emit_map_val_drop_helper(a, m, mi)
            }
        }
    }
    <<
}

fn emit_platform_glue(a &mut Assembler, m &types.Mir, u &RtUse, mc int, use_write bool) {
    if a.os == 3 {
        mut pump := 0
        if u.use_xu { pump = 1 }
        rt_emit_bare_metal_glue(a, m, pump)
    } else {
        rt_emit_collect_args(a)
        rt_emit_collect_env(a)
        rt_emit_pagesize_slot(a)
        rt_emit_init_auxv(a)
        rt_emit_win_sysinfo(a)
        if a.lib == 0 {
            mut need_env := 0
            if u.use_env_get || u.use_env_list || u.use_tmp_dir { need_env = 1 }
            mut need_args := 0
            if u.use_args { need_args = 1 }
            emit_start(a, m, need_env, need_args)
        }
        if a.os == 2 {
            mut use_alloc_i := 1
            mut use_write_i := 0
            if use_write { use_write_i = 1 }
            // The injected version mark and heap diagnostics can emit the
            // writer without a user print call. Its actual presence owns the
            // import dependency, including otherwise silent programs.
            write_label := "_rt_write"
            if a.label_index_ref(&write_label) >= 0 { use_write_i = 1 }
            if u.use_oob { use_write_i = 1 }
            mut use_file_i := 0
            // use_fd emits the complete open/read/write/close helper group.
            // Its imports must be present even for a write-only user call.
            if u.use_rf || u.use_wf || u.use_fd { use_file_i = 1 }
            if u.use_rd { use_file_i = 2 }
            mut use_extra := 0
            if u.use_now { use_extra = use_extra + 1 }
            if u.use_sleep { use_extra = use_extra + 2 }
            if u.use_pid { use_extra = use_extra + 8 }
            if u.use_host_name { use_extra = use_extra + 16 }
            if u.use_cwd { use_extra = use_extra + 32 }
            if u.use_tmp_dir { use_extra = use_extra + 64 }
            if u.use_stat { use_extra = use_extra + 128 }
            if u.use_mkdir { use_extra = use_extra + 256 }
            if u.use_rename { use_extra = use_extra + 512 }
            if u.use_remove { use_extra = use_extra + 1024 }
            if u.use_os_system || u.use_os_exec { use_extra = use_extra + 2048 }
            if u.use_ui_host { use_extra = use_extra + 4096 }
            if u.use_fs2 { use_extra = use_extra + 8192 }
            if u.use_wall { use_extra = use_extra + 16384 }
            // The platform random-fill ABI resolves the Windows provider via
            // the existing LoadLibraryA/GetProcAddress import pair.
            if u.use_random_fill && (use_extra & 4096) == 0 { use_extra = use_extra + 4096 }
            if u.use_security_store && (use_extra & 4096) == 0 { use_extra = use_extra + 4096 }
            mut use_net_i := u.use_dial || u.use_listen || u.use_accept || u.use_connclose || u.use_connwrite || u.use_connread || u.use_socket || u.use_bind4 || u.use_connect4 || u.use_bind6 || u.use_connect6 || u.use_listen_fd || u.use_sendto || u.use_recvfrom || u.use_sock_timeo || u.use_iface
            if use_net_i {
                if (use_extra & 4096) == 0 {
                    use_extra = use_extra + 4096
                }
            }
            emit_windows_iat(a, use_alloc_i, use_write_i, use_file_i, mc, use_extra)
        }
        if mc == 1 {
            if a.os == 0 {
                emit_macos_pthread_iat(a)
            }
        }
        if a.os == 0 {
            if u.use_now || u.use_wall || u.use_sleep {
                emit_macos_time_iat(a, u.use_now || u.use_wall, u.use_sleep)
            }
            emit_macos_sysinfo_iat(a, u.use_host_name, u.use_cwd, u.use_os_system, u.use_fs2, true)
            if u.use_os_exec { emit_macos_exec_iat(a) }
        }
        if (a.os == 0 || a.os == 1 || a.os == 2) && a.dylib_labs.len > 0 {
            a.align_data(8)
            for i in 0:a.dylib_labs.len {
                a.data_label(iat_from_xu_label(a.dylib_labs[i] + ""))
                rt_emit_zeros(a, 8)
            }
        }
    }
    <<
}

fn collect_fn_itabs(a &mut Assembler, m &types.Mir, fi int, itab_seen &mut []string) bool {
    mut has_iface := false
    if types.mir_fn_is_extern(m, fi) { << has_iface }
    nins := types.mir_nins(m, fi)
    for ii in 0:nins {
        ik := types.mir_ikind(m, fi, ii)
        if ik == 40 || ik == 41 || ik == 42 || ik == 44 {
            has_iface = true
            if ik == 40 || ik == 44 {
                // Materialise the MIR string before retaining it in the
                // unit-level seen set.  Hosted Gen1 may return a borrowed
                // descriptor for `sval`; pushing that alias lets the next
                // instruction overwrite the previous entry, causing the
                // second interface itable (e.g. `..._B`) to be skipped and
                // its later LEA fixup to resolve as an unknown hash.
                raw_lbl := types.mir_isval(m, fi, ii)
                mut lbl := asm_string_copy(&raw_lbl)
                if lbl == "" {
                    if ik == 40 {
                        sid := types.mir_ic(m, fi, ii)
                        lbl = "_xu_itab_errors_Error_" + m.structs[sid].name
                    } else {
                        lbl = types.any_itab_label(types.mir_ic(m, fi, ii))
                    }
                }
                mut seen := false
                for j in 0:itab_seen.len {
                    if itab_seen[j] == lbl {
                        seen = true
                    }
                }
                if !seen {
                    // `data_label` receives its string by value and may
                    // consume the descriptor under Gen1. Keep independent
                    // copies for the assembler and the seen-set; otherwise
                    // the just-added key becomes an empty/garbled alias and
                    // the next itable is skipped or hashes to a missing key.
                    stable_lbl := asm_string_copy(&lbl)
                    data_lbl := asm_string_copy(&stable_lbl)
                    a.data_label(data_lbl)
                    rt_emit_u64(a, types.mir_ic(m, fi, ii))
                    itab_seen.push(stable_lbl)
                }
            }
        }
    }
    << has_iface
}

fn emit_program(a &mut Assembler, m &types.Mir) {
    // Keep a numeric MIR-function → code-offset table for the hosted ARM64
    // emitter.  Delayed BL fixups normally carry a label hash, but interface
    // dispatch and a few direct-call peepholes can cross the large Gen1
    // string forwarding boundary; resolving by function index avoids a
    // dangling/partially-copied label without changing the public ABI.  The
    // table is populated by emit_function_entry before fixup_all.  A bounded
    // cap preserves the ordinary string-fixup fallback for hostile units.
    if a.lib == 0 && a.lib_exp_off.len == 0 && m.fns.len > 0 && m.fns.len <= 1048576 {
        for _ in 0:m.fns.len { a.lib_exp_off.push(-1) }
    }
    // The self-hosted emitter still has register-cache hazards in functions
    // with owning or aggregate values.  Keep the legacy conservative default
    // and opt in only for scalar math loops whose calls are leaf intrinsics
    // (plus the final scalar println used by product benchmarks).
    product_rc := a.rc_on
    a.rc_nfn = types.mir_nfn_live(m)
    a.rc_kern_labs = []string{}
    a.rc_preserve_labs = []string{}
    a.rc_preserve_mask = []int{}
    for kfi in 0:m.fns.len {
        if types.mir_fn_is_extern(m, kfi) {
            ->
        }
        if fn_is_small_indexed_kernel(m, kfi) {
            a.rc_kern_labs.push(types.mir_fn_label(m, kfi) + "")
        }
        pmask := callee_preserves_arg_mask_fi(m, kfi)
        if pmask != 0 {
            a.rc_preserve_labs.push(types.mir_fn_label(m, kfi) + "")
            a.rc_preserve_mask.push(pmask)
        }
    }
    a.rc_on = false
    // RV32 QEMU virt boots at the code segment start (0x80000000), where
    // the first emitted function lives — jump straight to `_reset` so the
    // runtime glue (SP / heap / UART init) always runs first (E7).
    if a.os == 3 && a.arch == 3 {
        a.r_j("_reset")
    }
    // String literals -> data segment.
    for i in 0:m.strings.len {
        mut _xus_off := a.data.len
        a.xus_off.push(_xus_off)
        a.data_label("_xus_" + str(i))
        emit_str_data(a, m.strings[i])
    }
    // M14: str(bool) statics (cap 0).
    a.data_label("_xu_str_true")
    emit_str_data(a, "true")
    a.data_label("_xu_str_false")
    emit_str_data(a, "false")
    // M147/M200/M201: struct@ + temp itables (concrete type id only).
    mut has_iface := false
    mut itab_seen := []string{}
    for fi in 0:m.fns.len {
        if collect_fn_itabs(a, m, fi, mut &itab_seen) {
            has_iface = true
        }
    }
    // Hosted may-throw RT helpers construct errors.StrErr directly.
    mut strerr_sid := -1
    for sid in 0:m.structs.len {
        if m.structs[sid].name == "StrErr" {
            strerr_sid = sid
        }
    }
    if strerr_sid >= 0 {
        lbl := "_xu_itab_errors_Error_StrErr"
        mut seen := false
        for j in 0:itab_seen.len {
            if itab_seen[j] == lbl {
                seen = true
            }
        }
        if !seen {
            stable_lbl := asm_string_copy(&lbl)
            a.data_label(asm_string_copy(&stable_lbl))
            rt_emit_u64(a, strerr_sid)
            itab_seen.push(stable_lbl)
        }
    } else {
        // Some Gen1 MIR scans conservatively pull in the throw helper even
        // when the source package does not materialize errors.StrErr. Keep
        // the referenced data label link-complete, but use an explicit
        // fail-closed type id; a real StrErr program takes the branch above
        // and emits its actual id.
        a.data_label("_xu_itab_errors_Error_StrErr")
        rt_emit_u64(a, 0)
    }
    if has_iface {
        a.data_label("_xu_iface_as_fail")
        emit_str_data(a, "interface as failed")
    }
    // Used-helper set (pure pre-scan; see header comment). Keep the large
    // aggregate rooted in this caller and mutate it in place.
    mut u := RtUse{use_pi: false, use_pb: false, use_ps: false, use_pf: false, use_fr: false, use_cc: false, use_sc: false, use_oob: false, use_dz: false, use_dov: false, use_as: false, use_taf: false, use_uw: false, use_uwe: false, use_ps_str: false, use_ap: false, use_itoa: false, use_sfb: false, use_sbytes: false, use_str_bytes: false, use_str_runes: false, use_slice: false, use_aslice: false, use_rf: false, use_rd: false, use_wf: false, use_args: false, use_str_eq: false, use_string_storage: false, use_parse: false, use_sw: false, use_now: false, use_wall: false, use_sleep: false, use_pid: false, use_ppid: false, use_uid: false, use_gid: false, use_euid: false, use_egid: false, use_pagesize: false, use_host_name: false, use_cwd: false, use_env_get: false, use_env_list: false, use_tmp_dir: false, use_stat: false, use_mkdir: false, use_rename: false, use_remove: false, use_dial: false, use_listen: false, use_accept: false, use_connclose: false, use_connwrite: false, use_connread: false, use_socket: false, use_bind4: false, use_connect4: false, use_bind6: false, use_connect6: false, use_bind_unix: false, use_connect_unix: false, use_listen_fd: false, use_sendto: false, use_recvfrom: false, use_sock_timeo: false, use_iface: false, use_os_system: false, use_os_exec: false, use_ui_host: false, use_fd: false, use_chan: false, use_xu: false, use_test: false, use_map: false, use_fs2: false, use_random_fill: false, use_security_store: false, use_heap_stats: false}
    scan_rt_use(m, mut &u)
    if u.use_map && gen1_map_stats_on() { u.use_pi = true }
    // The generated harness is emitted outside the user MIR, so its runtime
    // calls cannot be discovered by scan_rt_use.
    if a.test { u.use_test = true }
    // m32 coverage: allocate a slot per unique (file,line) before emission,
    // then emit the static tables the runtime dump walks.
    mut ct := CoverTable{files: []int{}, lines: []int{}}
    if a.cover {
        mut cov_map := types.new_strmap()
        for fi in 0:m.fns.len {
            if types.mir_fn_is_extern(m, fi) { -> }
            for bi in 0:types.mir_nblocks(m, fi) {
                ln := types.mir_bline(m, fi, bi)
                if ln != 0 {
                    fl := types.mir_fn_file(m, fi)
                    ck := str(fl) + "/" + str(ln)
                    if cov_map.lookup(&ck) < 0 {
                        cov_map.put(ck, ct.files.len)
                        ct.files.push(fl)
                        ct.lines.push(ln)
                    }
                }
            }
        }
    }
    // MIR is immutable throughout emission; build numeric call metadata once
    // and release it when the unit finishes, without extending the Mir ABI.
    calls := types.new_mir_call_index(m)
    order := emit_function_order(m)
    for oi in 0:order.len {
        fi := order[oi]
        // Select optimized functions from MIR facts, like an O3 pipeline: the
        // source/module/function name is deliberately not part of the test.
        // This lets the same scalar-memory kernels in sort, heap, slices and
        // user programs receive the cache on both hosted architectures.
        // x64 pin homes are V2–V5, which ALU / field / inlined push_str also
        // use as scratch. Enabling the cache there miscompiles search_ints
        // and Table.entries[i] (linux sse / crc32). ARM64 S-pool is the
        // only layout where pins and scratch are disjoint.
        // This predicate controls only the legacy opportunistic RegCache.
        // emit_function independently admits fixed scalar homes from
        // `a.ra_level`, including x64 and functions outside this safety tier.
        ok_rc := product_rc_mir_safe(m, fi)
        a.rc_on = product_rc && a.arch == 0 && !a.cover && !a.test && ok_rc
        emit_function(a, m, fi, &ct, &calls)
    }
    emit_program_rt(a, m, mut &u, &ct)
    <<
}

fn emit_program_rt(a &mut Assembler, m &types.Mir, u &mut RtUse, ct &CoverTable) {
    // Runtime glue and fn-value shims are deliberately emitted without the
    // per-function cache state selected above.
    a.rc_on = false
    // Keep the bootstrap seven-field heap-stats ABI available in every
    // hosted executable.  `_rt_heap_stats` is a cheap no-op unless the exact
    // XU_HEAP_STATS=1 environment entry is present, so this does not alter
    // normal stderr or library output.  Libraries have no `_start` hook and
    // therefore do not need the report helper.
    if a.lib == 0 && a.os != 3 && gen1_heap_ledger_on() {
        u.use_heap_stats = true
    }
    // Imported `os.interface_data` calls are lowered after the root-unit
    // helper scan. Hosted Gen1 images keep the helper available so those
    // cross-module calls never resolve to a null label.
    if a.os == 0 || a.os == 1 || a.os == 2 {
        u.use_iface = true
        u.use_socket = true
    }
    // M109: fnval shims (ignore A0=env, shift args, jmp body).
    for fi in 0:m.fns.len {
        if types.mir_fn_is_extern(m, fi) {
            ->
        }
        emit_fnval_shim(a, m, fi)
    }
    // Helpers, in the Rust emit_helpers order (M6b2-s3b subset: PrintlnInt,
    // PrintlnBool, PrintlnStr, Alloc, Free, StrConcat, StrClone, Write,
    // CollectArgs), with dependencies: Free -> Alloc; StrConcat -> Alloc;
    // StrClone -> Alloc; println_* -> Write; CollectArgs -> Alloc.
    // CollectArgs is always emitted (for start), so Alloc and its data
    // always are too. Drop helpers follow Free (they call rt_free).
    // Helpers that call rt_free must pull it in even when Drop is a no-op.
    // Filesystem/OS helpers materialize temporary C strings; their cleanup
    // paths require the free helper even when the MIR has no explicit Drop.
    if u.use_ps_str || u.use_cc || u.use_sc || u.use_ap || u.use_rd { u.use_fr = true }
    if u.use_rf || u.use_wf || u.use_stat || u.use_mkdir || u.use_rename || u.use_remove || u.use_os_system || u.use_os_exec || u.use_ui_host || u.use_fd || u.use_fs2 || u.use_security_store { u.use_fr = true }
    if u.use_connread { u.use_fr = true }
    if u.use_recvfrom { u.use_fr = true }
    if u.use_iface { u.use_fr = true }
    if u.use_fs2 { u.use_fr = true }
    // m32: cover/test helpers all write through rt_write; assert + cover dump
    // both read the file-name table through rt_file_str.
    mut use_cover := a.cover
    mut use_files := u.use_as || use_cover
    // Alloc is emitted for every program and its OOM paths call rt_write,
    // independently of the optional heap ledger. Keep the writer and its
    // platform imports under the same dependency decision.
    use_write := true
    if a.os == 3 {
        if u.use_pf {
            eprintln("E4: f64 println needs VFP")
            <<< 1
        }
    }
    // xu/chan: OS threads on hosted targets. Freestanding stays cooperative.
    mut mc := 0
    if u.use_chan { u.use_fr = true }
    if a.os != 3 {
        if u.use_chan || u.use_xu { mc = 1 }
    }

    // Align runtime data after string literals (futex/LDAXR need 8).
    rem := a.data.len % 8
    if rem != 0 {
        rt_emit_zeros(a, 8 - rem)
    }
    if use_cover {
        emit_cover_tables(a, ct)
    }
    if use_files {
        emit_file_table(a, m)
        rem2 := a.data.len % 8
        if rem2 != 0 {
            rt_emit_zeros(a, 8 - rem2)
        }
    }
    // Match the Rust emitter: testing.T is usable from an ordinary main, so
    // these tiny runtime data labels are always link-complete.
    a.data_label("_xu_jmpbuf")
    rt_emit_zeros(a, 128)
    a.data_label("_xu_test_soft")
    rt_emit_zeros(a, 8)
    a.data_label("_xu_test_short")
    if a.test_short {
        a.emit_data([1, 0, 0, 0, 0, 0, 0, 0])
    } else {
        rt_emit_zeros(a, 8)
    }
    if a.os == 3 {
        a.data_label("_rt_heap_cur")
        rt_emit_zeros(a, 8)
        a.data_label("_xu_heap_start")
        rt_emit_zeros(a, 16384)
        a.data_label("_xu_heap_end")
    } else {
        a.data_label("_rt_freelists")
        // One pointer per small allocation class.
        rt_emit_zeros(a, gen1_medium_first_class * 8)
        // Five bounded medium-buffer pools: 4/8/16/32/64 KiB payloads.
        // Heads point to user bytes; counts limit retained mappings.
        a.data_label("_rt_medium_heads")
        rt_emit_zeros(a, gen1_medium_class_count * 8)
        a.data_label("_rt_medium_counts")
        rt_emit_zeros(a, gen1_medium_class_count * 8)
        a.data_label("_rt_chunk_cursor")
        rt_emit_zeros(a, 8)
        a.data_label("_rt_chunk_end")
        rt_emit_zeros(a, 8)
        // Hosted allocator ledger/counters mirror bootstrap xurt.  The table
        // is fixed-size and allocation-free so diagnostics cannot recurse
        // through `_rt_alloc`; 16 bytes per slot = pointer + size+1/tombstone.
        if gen1_heap_ledger_on() {
            a.data_label("_rt_heap_live_bytes")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_heap_peak_bytes")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_heap_allocs")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_heap_frees")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_heap_unknown_frees")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_heap_double_frees")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_heap_ledger_overflows")
            rt_emit_zeros(a, 8)
            a.data_label("_rt_heap_ledger")
            // Each ledger slot stores a pointer and size/tombstone word.
            rt_emit_zeros(a, gen1_heap_ledger_slots << rt_heap_ledger_entry_shift)
        }
        // The scheduler/allocator mutex is required independently of the
        // optional ledger (M:N channel programs use it on every alloc/free).
        if mc == 1 {
            a.data_label("_rt_heap_mu")
            rt_emit_zeros(a, 64)
        }
    }
    emit_rt_core_helpers(a, &*u, mc, use_write, use_files, use_cover)
    emit_rt_conc_helpers(a, m, &*u, mc)
    emit_platform_glue(a, m, &*u, mc, use_write)
    rt_emit_crypto_hardware(a)
    <<
}

// Frame-backed fat values that must not reject scalar RC. Pin collection
// already skips ns!=1. Array/interface descriptors sit next to `s`/`i`
// in iface_sum; pinning the descriptors is illegal, rejecting the
// whole function leaves the scalars on the stack.
fn rc_fat_desc_ok(ty int, ns int) bool {
    if ns == 2 && types.is_fn_type(ty) { << true }
    if types.is_array_type(ty) { << true }
    if types.is_interface_type(ty) { << true }
    << false
}

// Product-compiler safety tier for the hosted register cache.  This is a
// structural MIR legality check, not a library-symbol allowlist.  It is the
// product-side equivalent of an O3 pass predicate: scalarize first, reject
// ownership/aggregate state, then optimize every legal ALU/memory kernel.
fn product_rc_mir_safe(m &types.Mir, fi int) bool {
    if types.mir_fn_is_extern(m, fi) {
        << false
    }
    // pin_safe gates the O2 S pool, not hosted RA itself. Bootstrap keeps
    // rc_on for index/ArrPush/Drop kernels and leaves pins in V2–V5.
    // Keep this tier on modest kernels.  Larger CFGs need global liveness
    // and interference data before uniform cross-block homes are legal.
    mut oversize_modest := false
    if types.mir_nblocks(m, fi) > 32 || types.mir_nlocals(m, fi) > 24 || types.mir_ntemps(m, fi) > 192 {
        // Inlined search_ints: one assign-diamond, no stores, a bit over the
        // modest-kernel cap. Keep RA so csel + pin homes survive the 4e6 loop.
        // StoreIndex/IndexRMW integer kernels (fannkuch reverse) are decided
        // after the op walk — Field/Ptr/ArrPush still reject this band.
        if types.mir_nblocks(m, fi) > 48 || types.mir_nlocals(m, fi) > 32 || types.mir_ntemps(m, fi) > 256 {
            << false
        }
        oversize_modest = true
    }
    if types.mir_ntemps(m, fi) > 40 && fn_has_natural_loop(m, fi) == 0 && fn_has_self_loop(m, fi) == 0 {
        << false
    }
    if types.mir_fn_ret_nslots(m, fi) > 1 {
        << false
    }
    mut has_f64 := false
    mut has_ref_slot := false
    mut has_f64_ref_slot := false
    for i in 0:types.mir_nlocals(m, fi) {
        ns := types.mir_local_nslots(m, fi, i)
        if ns < 1 || ns > 3 {
            << false
        }
        // The legacy block RegCache owns a word cache and pin metadata, not a
        // whole aggregate value.  Keep every aggregate-containing function
        // off this path; the independent fixed-home planner admits only its
        // separately proven mixed shapes.  This prevents descriptor words
        // from aliasing cache homes under the frozen hosted ABI.
        ty := types.mir_local_ty(m, fi, i)
        if ns != 1 {
            if !rc_fat_desc_ok(ty, ns) {
                << false
            }
        }
        if ty == 4 {
            has_f64 = true
        }
        // One-slot scalars may enter integer/f64 caches. two/three-word
        // descriptors stay frame-backed (pin collection already skips them).
        // A 1-slot struct (method_sum `Acc`) is also frame-backed and is
        // not pinned; rejecting the whole function disabled RA for `i`.
        // `&T` / `&[]T` stay unpinned. Whether they reject the whole
        // function is decided after the op walk (f64 kernel or read-only
        // LoadIndex). Integer self-loops with a ref receiver and stores
        // (compiler helpers) still stay out — skip-store miscompiles them.
        if ns == 1 {
            if types.is_ref_type(ty) {
                has_ref_slot = true
                // Only an ABI parameter with no surviving MIR reference can
                // avoid the f64 alias gate. Ref temps and non-parameter refs
                // keep the existing conservative admission rules.
                if i >= types.mir_fn_nparams(m, fi) || frame_local_is_referenced(m, fi, i) {
                    has_f64_ref_slot = true
                }
            } else if ty != 4 && !rc_pin_ty_ok(ty) && !types.is_struct_type(ty) {
                << false
            }
        }
    }
    for i in 0:types.mir_ntemps(m, fi) {
        ns := types.mir_temp_nslots(m, fi, i)
        if ns < 1 || ns > 3 {
            << false
        }
        // Keep aggregate temporaries frame-backed; only scalar-only functions
        // enter the legacy cache graph below. Fn-value fat temps (2 slots)
        // are the same exception as fn locals above.
        ty := types.mir_temp_ty(m, fi, i)
        if ns != 1 {
            if !rc_fat_desc_ok(ty, ns) {
                << false
            }
        }
        if ty == 4 {
            has_f64 = true
        }
        if ns == 1 {
            if types.is_ref_type(ty) {
                has_ref_slot = true
                has_f64_ref_slot = true
            } else if ty != 4 && !rc_pin_ty_ok(ty) && !types.is_struct_type(ty) {
                << false
            }
        }
    }
    if has_f64 && (fn_has_self_loop(m, fi) == 0 || (has_f64_ref_slot && !fn_is_f64_field_rmw_kernel(m, fi) && !fn_is_f64_index_acc_kernel(m, fi))) {
        << false
    }

    // Both direct self-loops and structured multi-block natural loops are
    // eligible.  The emitter gives every block in the latter a uniform pin
    // layout, so merge edges do not need ad-hoc per-algorithm handling.
    // a numerically backward CFG edge is not sufficient: block layout is not
    // dominance order.  Require a real strongly connected loop region.
    natural_loop := fn_has_natural_loop(m, fi) == 1
    self_loop := fn_has_self_loop(m, fi) == 1
    rec := fn_is_self_recursive(m, fi)
    // User units only: compiler self-host has thousands of tiny helpers.
    scalar_leaf := fn_is_scalar_leaf(m, fi) && types.mir_nfn_live(m) < 64
    if !self_loop && !natural_loop && !rec && !scalar_leaf {
        << false
    }

    mut useful := false
    mut has_index_read := false
    mut has_memory_write := false
    mut has_user_call := false
    // Clone: `types.mir_ikind(m, fi, ii)` misreads under Gen1 and can
    // reject a legal nbody/f64 self-loop (RA stays off, O1==O0).
    mut f := types.mir_cfg_clone_fn(m, fi, true)
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
        if ii < 0 { <- }
        ik := types.mfn_ikind(&f.instrs, ii)
        if ik == 14 { has_index_read = true }
        // ArrPush (13/46) mutates the descriptor in the prologue; parks
        // spill before it. Counting it as a loop store kept iface_sum off RC.
        if ik == 11 || ik == 18 || ik == 20 || ik == 25 || ik == 47 || ik == 48 { has_memory_write = true }
        if ik == 7 && types.mfn_ib(&f.instrs, ii) == 95 { has_memory_write = true }
        mut ok := false
        if ik >= 1 && ik <= 5 {
            ok = true
        }
        // Drop / ArrayLit / ArrPush keep descriptors in the frame; the
        // emitter spills parks before those ops. Scalar field/pointer/index
        // operations are legal because one-slot values were proved above.
        // LoadField is already legal. StoreField (11) is the matching
        // prologue write (`A{x:1}` before boxing). Pin collection skips
        // ns!=1 structs, so this does not put a payload pointer in an S home.
        if ik == 6 || ik == 8 || ik == 10 || ik == 11 || ik == 12 || ik == 13 || ik == 14 || ik == 16 || ik == 17 || ik == 18 || ik == 20 || ik == 23 || ik == 25 || ik == 26 || ik == 46 || ik == 47 || ik == 48 {
            ok = true
        }
        // Box + leaf InterfaceMethod: emit skips the call-spill when every
        // closed-world target is a value-receiver field leaf (no `bl`).
        if ik == 40 || ik == 43 || ik == 44 {
            ok = true
        }
        if ik == 7 {
            ck := types.mfn_ib(&f.instrs, ii)
            sval := types.mfn_isval(&f.instrs, ii)
            // Call-bearing CFGs need interprocedural liveness before they can
            // enter this tier generally. Scalar print/test helpers retain the
            // benchmark/main-loop case. Ordinary user calls stay out.
            // ck==95 is FieldRMW (method_sum Acc.add inline), not a real call.
            if ck == 2 || ck == 3 || ck == 4 || ck == 5 || ck == 22 || ck == 95 {
                ok = true
            } else if ck == 1 && sval == f.label {
                // Direct self-recursion (fib): pin homes in S0 survive `bl`.
                ok = true
            } else if ck == 1 && sval == "_xu_math_sqrt" {
                // Emitter lowers this to `fsqrt`; it is not a `bl` and must
                // not evict f64 FieldRMW kernels (nbody advance) from RC.
                ok = true
            } else if ck == 1 {
                // User call: emit spills parks. Decide after the op walk —
                // StoreIndex kernels may keep RA (no V-pins across `bl`).
                has_user_call = true
                ok = true
            } else if ck == 80 {
                // Named fn-value that peeps to `x ±/* k` has no ABI seam.
                // Unknown provenance still charges has_user_call (real blr).
                ok = true
                if !mir_fnval_call_is_binop_peep(m, fi, ii) {
                    has_user_call = true
                }
            } else {
                << false
            }
        }
        // StrClone stays out. LoadFnAddr is a frame store of (code*, env=0),
        // same shape as Addr — needed so inlined `f := bump; f(x)` still
        // gets scalar RA on the counted loop.
        if ik == 9 {
            << false
        }
        if ik == 38 {
            ok = true
        }
        if !ok && ik != 0 {
            << false
        }
        if ok { useful = true }
        ii = types.mfn_inext(&f.instrs, ii)
        }
    }
    mut index_stores_only := false
    if has_memory_write {
        mut saw_st := false
        mut other_st := false
        for ii2 in 0:f.instrs.len {
            ik2 := types.mfn_ikind(&f.instrs, ii2)
            // 20 StoreIndex / 47 IndexRMW: same array slot, one bounds check
            // on RMW. Pins stay; skip-store / V6 kernel stay off (1-slot ref).
            if ik2 == 20 || ik2 == 47 {
                saw_st = true
            } else if ik2 == 11 || ik2 == 13 || ik2 == 18 || ik2 == 25 || ik2 == 46 || ik2 == 48 {
                other_st = true
            } else if ik2 == 7 && types.mfn_ib(&f.instrs, ii2) == 95 {
                other_st = true
            }
        }
        if saw_st && !other_st {
            index_stores_only = true
        }
    }
    // Inlined fannkuch `run` (flips + generate) is StoreIndex-only but has
    // several self-loops sharing four S pins. `r` then aliases `i` in x19
    // and `count[r-1]` is OOB. flips_of alone stays modest and may pin.
    if index_stores_only && types.mir_nblocks(m, fi) > 16 {
        << false
    }
    // Mutable slice reverse/swap loops can carry two independent indices
    // into one descriptor. The legacy cache forwards only one descriptor /
    // index state, which makes the second bounds check observe stale length.
    // Fixed homes do not admit Index MIR yet, so keep these loops frame-backed
    // for both integer and floating-point element types.
    if has_ref_slot && index_stores_only && !fn_is_f64_index_acc_kernel(m, fi) {
        << false
    }
    if oversize_modest {
        if !index_stores_only {
            if has_memory_write || !fn_has_assign_diamond(m, fi) {
                << false
            }
        }
    }
    // 1-slot refs: nbody (f64 + FieldRMW) already passed via has_f64.
    // Inlined search_ints is Call-free LoadIndex, no stores — lo/hi/mid
    // need GPR homes. StoreIndex/IndexRMW integer kernels (fannkuch
    // reverse / count[r] -= 1) may pin; ArrPush/StorePtr/Field reject.
    if has_ref_slot && !has_f64 {
        // `_ht`/pin RA is an array-descriptor contract.  A one-slot struct
        // reference such as `&Ring` or `&List` can contain indexed fields,
        // but treating its receiver as `&[]T` makes the array data seed point
        // at the wrong frame word and causes rt_oob.  Keep ordinary struct
        // receivers on the frame-backed path; direct `&[]T` search/reverse
        // kernels still pass the stricter predicate.
        if !fn_has_one_slot_array_ref(m, fi) {
            << false
        }
        if !has_index_read {
            << false
        }
        if has_memory_write && !index_stores_only {
            << false
        }
    }
    // Ordinary user calls stay out except StoreIndex/IndexRMW kernels
    // (fannkuch `run` → `flips_of`; spectralnorm `times` → `eval_a`).
    // f64 + Call must not pin SIMD / skip-store: caller-saved d2–d7 die
    // across `bl` and `_ht` skip-reload zeroed SN to `0.000102034`.
    // Parks-only is decided in emit (wb/leaf off on user-Call blocks).
    // Compiler self-host (nfn≥64) still rejects Call+f64.
    if has_user_call && !index_stores_only {
        << false
    }
    if has_user_call && has_f64 && types.mir_nfn_live(m) >= 256 {
        << false
    }
    // Read-only indexed natural loops (e.g. inlined searches), plus any
    // self-loop whose live ops are in the allowlist above (ALU, println /
    // math-leaf, ArrPush, IndexRMW). Frame-backed descriptors + V-pin RA
    // is the O1 contract; S-pool stays behind pin_safe at O2.
    if self_loop && useful && (!has_f64 || !has_memory_write) {
        << useful
    }
    if (self_loop || natural_loop) && useful && fn_is_f64_field_rmw_kernel(m, fi) {
        << useful
    }
    if (self_loop || natural_loop) && useful && fn_is_f64_index_acc_kernel(m, fi) {
        << useful
    }
    // Read-only indexed natural loops (search_ints), or StoreIndex-only
    // reverse loops (fannkuch), in large units.
    if natural_loop && useful && !has_f64 && has_index_read && (!has_memory_write || index_stores_only) {
        << useful
    }
    if natural_loop && useful && !has_f64 && !has_memory_write && types.mir_nfn_live(m) < 256 {
        << useful
    }
    // Scalar self-recursive leaves (fib): no loop SCC, two `bl` of self.
    if rec && useful && !has_memory_write && types.mir_nblocks(m, fi) <= 16 && types.mir_nlocals(m, fi) <= 8 {
        << useful
    }
    // eval_a: parks only (2 blocks ⇒ not straight ⇒ no skip-store).
    if scalar_leaf && useful && !has_memory_write && !has_user_call && !has_f64 {
        << useful
    }
    << false
}

fn emit_macos_pthread_iat(a &mut Assembler) {
    a.align_data(8)
    a.data_label("_iat_pthread_create")
    rt_emit_zeros(a, 8)
    a.data_label("_iat_pthread_detach")
    rt_emit_zeros(a, 8)
    a.data_label("_iat_pthread_mutex_lock")
    rt_emit_zeros(a, 8)
    a.data_label("_iat_pthread_mutex_unlock")
    rt_emit_zeros(a, 8)
    a.data_label("_iat_pthread_cond_wait")
    rt_emit_zeros(a, 8)
    a.data_label("_iat_pthread_cond_signal")
    rt_emit_zeros(a, 8)
    a.data_label("_iat_pthread_cond_broadcast")
    rt_emit_zeros(a, 8)
    a.data_label("_iat_pthread_mutex_init")
    rt_emit_zeros(a, 8)
    a.data_label("_iat_pthread_cond_init")
    rt_emit_zeros(a, 8)
    <<
}
