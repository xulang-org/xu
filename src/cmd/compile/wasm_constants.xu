@main

// Fixed linear-memory layout. Each WASM page is 64 KiB. Keep the data pool
// below the initial downward-growing stack, and both inside memory_pages.
// The upper scratch region holds ignored call results; the lower one holds args.
const WASM_FRAME_SCRATCH_BYTES = 16384
const WASM_SCRATCH_RESULT_OFFSET = 8192
const WASM_DATA_BASE = 1048576
const WASM_CONSTANT_POOL_MAX_BYTES = 2097152
const WASM_MEMORY_PAGES = 1024
const WASM_INITIAL_STACK_POINTER = 8388600
