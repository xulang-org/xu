@main

#xu/types

// Call-point interval splitting is a post-coloring rescue, not a replacement
// for the normal callee-saved plan. Only otherwise spilled Arm64 scalars with
// a positive weighted memory saving may use caller homes across explicit ABI
// calls. The existing immutable graph still guards every home, including the
// call result and scratch exclusions. Hidden calls and selected machine
// streams remain conservative; no memory instruction is moved or removed.
fn vreg_split_gpr_scan(work &mut []int, points &mut []int, depth &[]int, m &types.Mir, fi int, reach &[]int, live &[]int, n int, nb int, arch int) bool {
    total := nb * n
    for bi in 0:nb {
        if reach[bi] == 0 { -> }
        mut weight := 1
        if depth[bi] > 0 { weight = vreg_block_spill_weight(depth[bi]) }
        mut active := []int{}
        for t in 0:n { active.push(live[total + bi * n + t]) }
        tk := types.mir_btkind(m, fi, bi)
        if tk == 2 || tk == 3 {
            u := types.mir_bta(m, fi, bi)
            if vreg_temp_eligible(m, fi, u) {
                active[u] = 1
                if work[n * 2 + u] != 0 { work[u] += weight }
            }
        }
        mut seq := []int{}
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            seq.push(ii)
            ii = types.mir_inext(m, fi, ii)
        }
        mut si := seq.len - 1
        while si >= 0 {
            xi := seq[si]
            d := vreg_instr_def(m, fi, xi)
            if types.mir_instr_call_live_m(m, fi, xi) && !vreg_sqrt_unop_ok(m, fi, xi, arch) {
                // The interference pass excluded hidden call ranges before
                // this walk. Retain that invariant at the action boundary.
                for t in 0:n {
                    if work[n * 2 + t] == 0 || t == d || active[t] == 0 { -> }
                    if types.mir_ikind(m, fi, xi) != types.MI_CALL { << false }
                    if points.len > VREG_MAX_FP_SPLIT_WORDS - 2 { << false }
                    points.push(xi)
                    points.push(t)
                    work[n + t] += weight
                }
            }
            if d >= 0 {
                if work[n * 2 + d] != 0 { work[d] += weight }
                active[d] = 0
            }
            for pos in 0:6 {
                u := vreg_instr_use(m, fi, xi, pos)
                if u < 0 { -> }
                active[u] = 1
                mut seen := false
                for prev in 0:pos { if vreg_instr_use(m, fi, xi, prev) == u { seen = true } }
                if !seen && work[n * 2 + u] != 0 { work[u] += weight }
            }
            si -= 1
        }
    }
    << true
}

fn vreg_split_gpr_calls(homes &mut []int, edge &[]int, refs &[]int, flags &[]int, depth &[]int, m &types.Mir, fi int, arch int, reach &[]int, live &[]int, n int, nb int) bool {
    if (arch != 0 && arch != 1 && arch != 2) || n <= 0 || n > 512 || nb <= 0 || nb > 128 || nb * n > 32768 { << true }
    ni := types.mir_nins(m, fi)
    if ni <= 0 || ni > 4096 || n * ni > 262144 { << true }
    // Cheap no-pressure exit keeps ordinary functions on their original plan.
    mut candidate := false
    for t in 0:n {
        if homes[t] == 0 && refs[t] != 0 && (flags[t] & 3) == 1 && (flags[t] & 16) == 0 { candidate = true }
    }
    if !candidate { << true }
    // [0,n): weighted defs/reads; [n,2n): exact live-call weights;
    // [2n,3n): candidate -> selected marker. Under the size/depth caps the
    // maximum cost is far below signed-int range (4096 * 512 * 10^9).
    mut work := []int{}
    for _ in 0:n * 2 { work.push(0) }
    for t in 0:n {
        mut mark := 0
        if homes[t] == 0 && refs[t] != 0 && (flags[t] & 3) == 1 && (flags[t] & 16) == 0 { mark = 1 }
        work.push(mark)
    }
    mut points := []int{}
    if !vreg_split_gpr_scan(mut &work, mut &points, depth, m, fi, reach, live, n, nb, arch) { << false }
    for _ in 0:n {
        mut best := -1
        mut saving := 0
        for t in 0:n {
            if work[n * 2 + t] != 1 || work[n + t] == 0 { -> }
            benefit := work[t] - work[n + t] * 2
            if benefit > saving { best = t
                saving = benefit }
        }
        if best < 0 { <- }
        work[n * 2 + best] = 0
        for h in td_gpr_caller_lo(arch):td_gpr_caller_hi(arch) {
            if !td_home_clobbered_by_call(arch, h) { -> }
            if regplan_home_reserved(flags[best], h) { -> }
            mut busy := false
            for u in 0:n {
                if homes[u] == h && vreg_edge_has(edge, n, best, u) { busy = true }
            }
            if !busy { homes[best] = h
                work[n * 2 + best] = 2
                <- }
        }
    }
    mut p := 0
    while p + 1 < points.len {
        t := points[p + 1]
        if work[n * 2 + t] == 2 {
            if homes.len > n + VREG_MAX_FP_SPLIT_WORDS - 2 { << false }
            homes.push(points[p])
            homes.push(t)
        }
        p += 2
    }
    << true
}
