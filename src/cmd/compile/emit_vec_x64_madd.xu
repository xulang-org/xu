@main

#xu/types

// Ordered scalar prefixes for c[row+j] += factor * b[row+j]. Retain one
// ordinary iteration for every MIR live-out, as the copy/norm prefixes do.
const X64_MADD_BAD = 2147483647

fn x64_madd_invariant(m &types.Mir, fi int, bi int, v int, ind int) int {
    if v <= 0 - 2 { << v }
    if v < 0 || v >= types.mir_ntemps(m, fi) || types.mir_temp_ty(m, fi, v) != 1 { << X64_MADD_BAD }
    d := x64_loop_def(m, fi, bi, v)
    if d < 0 { << v }
    if types.mir_ikind(m, fi, d) != types.MI_LOAD_LOCAL { << X64_MADD_BAD }
    loc := types.mir_ib(m, fi, d)
    if loc == ind || types.mir_local_ty(m, fi, loc) != 1 || vec_local_stored(m, fi, bi, loc) { << X64_MADD_BAD }
    << types.MIR_LOCAL_OPERAND_BASE + loc
}

fn x64_madd_offset(m &types.Mir, fi int, bi int, idx int, ind int) int {
    if vec_load_is_local(m, fi, bi, idx, ind) { << -1 }
    add := x64_loop_def(m, fi, bi, idx)
    if add < 0 || types.mir_ikind(m, fi, add) != types.MI_BIN || types.mir_ib(m, fi, add) != 1 { << X64_MADD_BAD }
    c := types.mir_ic(m, fi, add)
    d := types.mir_id(m, fi, add)
    mut off := X64_MADD_BAD
    if vec_load_is_local(m, fi, bi, c, ind) { off = d }
    else if vec_load_is_local(m, fi, bi, d, ind) { off = c }
    if off == X64_MADD_BAD { << off }
    invariant := x64_madd_invariant(m, fi, bi, off, ind)
    if invariant != X64_MADD_BAD { << invariant }
    mul := x64_loop_def(m, fi, bi, off)
    if mul < 0 || types.mir_ikind(m, fi, mul) != types.MI_BIN || types.mir_ib(m, fi, mul) != 3 { << X64_MADD_BAD }
    if x64_madd_invariant(m, fi, bi, types.mir_ic(m, fi, mul), ind) == X64_MADD_BAD { << X64_MADD_BAD }
    if x64_madd_invariant(m, fi, bi, types.mir_id(m, fi, mul), ind) == X64_MADD_BAD { << X64_MADD_BAD }
    << off
}

fn match_x64_madd(m &types.Mir, fi int, bi int) VecPat {
    if types.mir_btkind(m, fi, bi) != 2 || types.mir_btb(m, fi, bi) != bi { << vec_none() }
    mut ld := -1
    mut rmw := -1
    mut update := -1
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == types.MI_LOAD_INDEX {
            width := types.mir_id(m, fi, ii)
            if ld >= 0 || (width != 8 && width != 0 - 8) { << vec_none() }
            if types.mir_temp_ty(m, fi, types.mir_ia(m, fi, ii)) != 1 { << vec_none() }
            ld = ii
        } else if k == types.MI_INDEX_RMW {
            width := types.mir_id(m, fi, ii)
            if rmw >= 0 || ld < 0 || (width != 8 && width != 0 - 8) || types.mir_icol(m, fi, ii) != 1 { << vec_none() }
            rmw = ii
        } else if k == types.MI_STORE_LOCAL {
            if update >= 0 || rmw < 0 { << vec_none() }
            update = ii
        } else if k != types.MI_NOP && k != types.MI_LOAD_LOCAL && k != types.MI_BIN { << vec_none() }
        ii = types.mir_inext(m, fi, ii)
    }
    if ld < 0 || rmw < 0 || update < 0 { << vec_none() }
    ind := types.mir_ia(m, fi, update)
    if types.mir_local_ty(m, fi, ind) != 1 { << vec_none() }
    next := types.mir_ib(m, fi, update)
    if !vec_is_add1_of(m, fi, bi, next, types.MIR_LOCAL_OPERAND_BASE + ind) { << vec_none() }
    add := x64_loop_def(m, fi, bi, next)
    cmp := x64_loop_def(m, fi, bi, types.mir_bta(m, fi, bi))
    if cmp < 0 { << vec_none() }
    lhs := x64_loop_def(m, fi, bi, types.mir_ic(m, fi, cmp))
    if !x64_loop_after(m, fi, bi, update, lhs) { << vec_none() }
    mut p := x64_loop_limit(m, fi, bi, cmp, types.MIR_LOCAL_OPERAND_BASE + ind, next)
    if p.kind == 0 { << p }
    prod := x64_loop_def(m, fi, bi, types.mir_ic(m, fi, rmw))
    if prod < 0 || types.mir_ikind(m, fi, prod) != types.MI_BIN || types.mir_ib(m, fi, prod) != 3 { << vec_none() }
    value := types.mir_ia(m, fi, ld)
    mut factor := X64_MADD_BAD
    if types.mir_ic(m, fi, prod) == value { factor = types.mir_id(m, fi, prod) }
    else if types.mir_id(m, fi, prod) == value { factor = types.mir_ic(m, fi, prod) }
    factor = x64_madd_invariant(m, fi, bi, factor, ind)
    if factor == X64_MADD_BAD { << vec_none() }
    bidx := types.mir_ic(m, fi, ld)
    cidx := types.mir_ib(m, fi, rmw)
    boff := x64_madd_offset(m, fi, bi, bidx, ind)
    coff := x64_madd_offset(m, fi, bi, cidx, ind)
    if boff == X64_MADD_BAD || coff == X64_MADD_BAD { << vec_none() }
    bi0 := x64_loop_def(m, fi, bi, bidx)
    ci0 := x64_loop_def(m, fi, bi, cidx)
    bo0 := x64_loop_def(m, fi, bi, boff)
    co0 := x64_loop_def(m, fi, bi, coff)
    // Every arithmetic instruction must belong to the proved expression.
    // Extra counters, division, changed stores and other work stay scalar.
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == types.MI_BIN {
            if ii != add && ii != cmp && ii != prod && ii != bi0 && ii != ci0 && ii != bo0 && ii != co0 { << vec_none() }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    p.arr = x64_loop_desc(m, fi, types.mir_ib(m, fi, ld))
    p.fac = x64_loop_desc(m, fi, types.mir_ia(m, fi, rmw))
    if !x64_loop_array(m, fi, p.arr, 1) || !x64_loop_array(m, fi, p.fac, 1) { << vec_none() }
    p.kind = VP_X64_MADD
    p.ind = types.MIR_LOCAL_OPERAND_BASE + ind
    p.acc = factor
    p.mask = boff
    p.else_bb = coff
    << p
}

fn emit_x64_madd_offset(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, off int, ind int, dest int) {
    if off == -1 { a.vm_mov_imm64(dest, 0)
        << }
    mul := x64_loop_def(m, fi, bi, off)
    if mul >= 0 && types.mir_ikind(m, fi, mul) == types.MI_BIN {
        c := x64_madd_invariant(m, fi, bi, types.mir_ic(m, fi, mul), ind)
        d := x64_madd_invariant(m, fi, bi, types.mir_id(m, fi, mul), ind)
        x64_loop_load(a, m, fi, fr, c, dest)
        x64_loop_load(a, m, fi, fr, d, 0)
        a.mul(dest, dest, 0)
    } else { x64_loop_load(a, m, fi, fr, off, dest) }
}

fn emit_x64_madd_prefix(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int) {
    if !a.vp_on(VP_X64_MADD) { << }
    p := match_x64_madd(m, fi, bi)
    if p.kind == 0 { << }
    for t in 0:fr.temp_slot.len {
        if is_vreg_slot(fr.temp_slot[t]) {
            h := vreg_slot_home(fr.temp_slot[t])
            if (h < 2 || h > 5) && h != 9 { << }
        }
    }
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi) + "_x64_madd"
    a.vp_hit(VP_X64_MADD)
    done := pref + "_scalar"
    x64_loop_load(a, m, fi, fr, p.ind, 18)
    if p.limit_t >= 0 { x64_loop_load(a, m, fi, fr, p.limit_t, 19) }
    else { a.vm_mov_imm64(19, p.limit) }
    a.vm_cmp_imm(18, 0)
    a.jlt(done + "")
    a.cmp(18, 19)
    a.jge(done + "")
    a.vm_mov_imm64(0, 1152921504606846975)
    a.cmp(19, 0)
    a.jgt(done + "")
    emit_x64_madd_offset(a, m, fi, fr, bi, p.mask, p.ind - types.MIR_LOCAL_OPERAND_BASE, 12)
    emit_x64_madd_offset(a, m, fi, fr, bi, p.else_bb, p.ind - types.MIR_LOCAL_OPERAND_BASE, 13)
    a.vm_cmp_imm(12, 0)
    a.jlt(done + "")
    a.vm_cmp_imm(13, 0)
    a.jlt(done + "")
    emit_index_desc_addr(a, m, fi, fr, p.arr)
    a.load(20, 0, 0)
    a.load(0, 0, -8)
    a.cmp(12, 0)
    a.jgt(done + "")
    a.sub(0, 0, 12)
    a.cmp(19, 0)
    a.jgt(done + "")
    emit_index_desc_addr(a, m, fi, fr, p.fac)
    a.load(21, 0, 0)
    a.load(0, 0, -8)
    a.cmp(13, 0)
    a.jgt(done + "")
    a.sub(0, 0, 13)
    a.cmp(19, 0)
    a.jgt(done + "")
    a.add(0, 12, 18)
    a.shl_imm(0, 0, 3)
    a.add(20, 20, 0)
    a.add(0, 13, 18)
    a.shl_imm(0, 0, 3)
    a.add(21, 21, 0)
    a.cmp(20, 21)
    a.jeq(pref + "_safe")
    a.sub(0, 19, 18)
    a.shl_imm(0, 0, 3)
    a.add(1, 20, 0)
    a.cmp(1, 20)
    a.x64_jcc(2, done + "")
    a.cmp(21, 1)
    a.jae(pref + "_safe")
    a.add(1, 21, 0)
    a.cmp(1, 21)
    a.x64_jcc(2, done + "")
    a.cmp(20, 1)
    a.jae(pref + "_safe")
    a.jmp(done + "")
    a.label(pref + "_safe")
    // Ret/RAX is reserved scratch. Load the invariant factor after guards,
    // whose large immediate comparisons may also use RAX internally.
    x64_loop_load(a, m, fi, fr, p.acc, 14)
    a.vm_sub_imm(19, 19, 4)
    a.label(pref + "_four")
    a.cmp(18, 19)
    a.jge(pref + "_saved")
    for off in 0:4 {
        a.load(0, 20, off * 8)
        a.x64_imul(x64_map_reg(0), x64_map_reg(14))
        a.x64_add_mem_reg(x64_map_reg(21), off * 8, x64_map_reg(0))
    }
    a.vm_add_imm(20, 20, 32)
    a.vm_add_imm(21, 21, 32)
    a.vm_add_imm(18, 18, 4)
    a.jmp(pref + "_four")
    a.label(pref + "_saved")
    x64_loop_store_ind(a, m, fi, fr, p.ind)
    a.label(done)
}
