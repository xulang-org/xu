fn (a &mut Assembler) be_mul(dest int, x int, y int) {
    if a.arch == 1 {
        a.xbe_mul(dest, x, y)
    } else {
        if a.arch == 2 {
            a.tbe_mul(dest, x, y)
        } else if a.arch == 3 {
            a.rbe_mul(dest, x, y)
            } else if a.arch == 4 {
                a.lbe_mul(dest, x, y)
        } else if a.arch == 5 {
                a.vbe_mul(dest, x, y)
        } else {
            a.mul_reg(map_reg(dest), map_reg(x), map_reg(y))
        }
    }
}

// dest = addend + x * y  (arm64 MADD; else mul+add).
fn (a &mut Assembler) be_madd(dest int, x int, y int, addend int) {
    if a.arch == 0 {
        a.madd_reg(map_reg(dest), map_reg(x), map_reg(y), map_reg(addend))
        <<
    }
    a.be_mul(dest, x, y)
    a.be_add(dest, dest, addend)
    <<
}

// dest = base - idx * scale  (arm64 MSUB; else mul+sub).
fn (a &mut Assembler) be_msub(dest int, idx int, scale int, base int) {
    if a.arch == 0 {
        a.msub(map_reg(dest), map_reg(idx), map_reg(scale), map_reg(base))
        <<
    }
    a.be_mul(dest, idx, scale)
    a.be_sub(dest, base, dest)
}

fn (a &mut Assembler) be_ror_imm(dest int, src int, imm int) {
    if a.arch >= 2 { a.be_unsupported("ror_imm") }
    if a.arch == 0 {
        a.ror_imm(map_reg(dest), map_reg(src), imm)
    } else if a.arch == 1 {
        d := x64_map_reg(dest)
        s := x64_map_reg(src)
        if d != s { a.x64_mov_reg(d, s) }
        a.x64_ror_imm64(d, imm)
    }
}

fn (a &mut Assembler) be_div(dest int, x int, y int) {
    if a.arch == 1 {
        a.xbe_div(dest, x, y)
    } else {
        if a.arch == 2 {
            a.tbe_div(dest, x, y)
        } else if a.arch == 3 {
            a.rbe_div(dest, x, y)
            } else if a.arch == 4 {
                a.lbe_div(dest, x, y)
        } else if a.arch == 5 {
                a.vbe_div(dest, x, y)
        } else {
            a.sdiv(map_reg(dest), map_reg(x), map_reg(y))
        }
    }
}

fn (a &mut Assembler) be_mod(dest int, x int, y int) {
    if a.arch == 1 {
        a.xbe_mod(dest, x, y)
    } else {
        if a.arch == 2 {
            a.tbe_mod(dest, x, y)
        } else if a.arch == 3 {
            a.rbe_mod(dest, x, y)
            } else if a.arch == 4 {
                a.lbe_mod(dest, x, y)
        } else if a.arch == 5 {
                a.vbe_mod(dest, x, y)
        } else {
            a.sdiv(17, map_reg(x), map_reg(y))
            a.msub(map_reg(dest), 17, map_reg(y), map_reg(x))
        }
    }
}

fn (a &mut Assembler) be_neg(dest int, src int) {
    if a.arch == 1 {
        a.xbe_neg(dest, src)
    } else {
        if a.arch == 2 {
