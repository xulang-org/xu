fn (a &mut Assembler) be_and(dest int, x int, y int) {
    if a.arch == 1 {
        a.xbe_and(dest, x, y)
    } else {
        if a.arch == 2 {
            a.tbe_and(dest, x, y)
        } else if a.arch == 3 {
            a.rbe_and(dest, x, y)
            } else if a.arch == 4 {
                a.lbe_and(dest, x, y)
        } else if a.arch == 5 {
                a.vbe_and(dest, x, y)
        } else {
            a.and_reg(map_reg(dest), map_reg(x), map_reg(y))
        }
