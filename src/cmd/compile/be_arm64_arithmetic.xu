}

fn (a &mut Assembler) be_bic32(dest int, y int, x int) {
    if a.arch >= 2 { a.be_unsupported("bic32") }
    if a.arch == 1 {
        a.xbe_bic32(dest, y, x)
    } else {
        a.bic32(map_reg(dest), map_reg(y), map_reg(x))
    }
}

fn (a &mut Assembler) be_mvn32(dest int, src int) {
    if a.arch >= 2 { a.be_unsupported("mvn32") }
    if a.arch == 1 {
        a.xbe_mvn32(dest, src)
    } else {
        a.mvn32(map_reg(dest), map_reg(src))
    }
}

fn (a &mut Assembler) be_add32(dest int, x int, y int) {
    if a.arch == 1 {
        a.xbe_add32(dest, x, y)
    } else if a.arch == 0 {
        a.add_reg32(map_reg(dest), map_reg(x), map_reg(y))
    } else {
        a.be_add(dest, x, y)
        a.be_and_imm(dest, dest, 4294967295)
    }
}

