@main

fn (a &mut Assembler) be_add(dest int, x int, y int) {
    if a.arch == 1 {
        a.xbe_add(dest, x, y)
    } else {
        if a.arch == 2 {
            a.tbe_add(dest, x, y)
        } else if a.arch == 3 {
            a.rbe_add(dest, x, y)
            } else if a.arch == 4 {
                a.lbe_add(dest, x, y)
        } else if a.arch == 5 {
                a.vbe_add(dest, x, y)
        } else {
            a.add_reg(map_reg(dest), map_reg(x), map_reg(y))
        }
    }
}

fn (a &mut Assembler) be_add_imm(dest int, src int, imm int) {
    if a.arch == 1 {
        a.xbe_add_imm(dest, src, imm)
    } else {
        if a.arch == 2 {
            a.tbe_add_imm(dest, src, imm)
        } else if a.arch == 3 {
            a.rbe_add_imm(dest, src, imm)
            } else if a.arch == 4 {
                a.lbe_add_imm(dest, src, imm)
        } else if a.arch == 5 {
                a.vbe_add_imm(dest, src, imm)
        } else {
            a.add_imm(map_reg(dest), map_reg(src), imm)
        }
    }
}

