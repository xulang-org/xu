fn (a &mut Assembler) be_ror_imm32(dest int, src int, imm int) {
    if a.arch >= 2 { a.be_unsupported("ror_imm32") }
    if a.arch == 1 {
        a.xbe_ror_imm32(dest, src, imm)
    } else {
        a.ror_imm32(map_reg(dest), map_reg(src), imm)
    }
}

fn (a &mut Assembler) be_eor_ror32(dest int, acc int, src int, imm int) {
    if a.arch >= 2 { a.be_unsupported("eor_ror32") }
    if a.arch == 1 {
        a.xbe_eor_ror32(dest, acc, src, imm)
    } else {
        a.eor_ror32(map_reg(dest), map_reg(acc), map_reg(src), imm)
    }
}

fn (a &mut Assembler) be_eor_lsr32(dest int, acc int, src int, imm int) {
