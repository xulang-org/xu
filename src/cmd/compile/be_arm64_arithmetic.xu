}

fn (a &mut Assembler) be_and_imm(dest int, src int, imm int) {
    if a.arch == 0 {
        a.and_imm(map_reg(dest), map_reg(src), imm)
        <<
    }
    if a.arch == 1 {
        a.xbe_and_imm(dest, src, imm)
        <<
    }
    if a.arch == 3 {
        a.rbe_and_imm(dest, src, imm)
        <<
    }
    if a.arch == 4 {
        a.lbe_and_imm(dest, src, imm)
        <<
    }
    if a.arch == 5 {
        a.vbe_and_imm(dest, src, imm)
        <<
    }
    a.vm_mov_imm64(1, imm)
    a.be_and(dest, src, 1)
}

