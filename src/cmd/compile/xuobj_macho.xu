@main
// XUOBJ -> macOS MH_OBJECT (.o). Port of scripts/xuobj_to_macho_o.py.
// Host symbols xu_ui_host_run / xu_ui_mem_try_* stay undefined for pack link.

// Mach-O / reloc constants (decimal; Xu has no hex literals).
// MH_MAGIC_64=4277009103 MH_OBJECT=1
// CPU_TYPE_ARM64=16777228 CPU_TYPE_X86_64=16777223 subtype_x64=3
// LC_SEGMENT_64=25 LC_SYMTAB=2 LC_DYSYMTAB=11 LC_BUILD_VERSION=50
// N_UNDF=0 N_SECT=14 N_EXT=1
// S_ATTR_PURE|SOME_INSTRUCTIONS=2147484672
// FK_B/BL/CBZ/CBNZ/ADRP_ADD = 0..4; FK_REL32=0 FK_RIP32=1 (x64)

fn put_u64(b &mut []int, v int) {
    b.push(v & 255)
    b.push((v >> 8) & 255)
    b.push((v >> 16) & 255)
    b.push((v >> 24) & 255)
    b.push((v >> 32) & 255)
    b.push((v >> 40) & 255)
    b.push((v >> 48) & 255)
    b.push((v >> 56) & 255)
}

fn macho_align(n int, a int) int {
    if a <= 1 { << n }
    if a <= 0 { << n }
    << ((n + a - 1) / a) * a
}

fn set_u32_le(b &mut []int, off int, v int) {
    b[off] = v & 255
    b[off + 1] = (v >> 8) & 255
    b[off + 2] = (v >> 16) & 255
    b[off + 3] = (v >> 24) & 255
}

fn pack_reloc(addr int, symnum int, pcrel int, length int, is_extern int, rtype int) []int {
    mut b := []int{}
    put_u32(mut &b, addr)
    word := (symnum & 16777215) | ((pcrel & 1) << 24) | ((length & 3) << 25) | ((is_extern & 1) << 27) | ((rtype & 15) << 28)
    put_u32(mut &b, word)
    << b
}

fn append_bytes(dst &mut []int, src &[]int) {
    for i in 0:src.len {
        dst.push(src[i] & 255)
    }
}

fn pad_buf_to(buf &mut []int, off int) {
    for _ in buf.len:off {
        buf.push(0)
    }
}

fn is_host_sym(name &string) bool {
    if str_eq_lit(name, "xu_ui_host_run") { << true }
    if str_eq_lit(name, "_xu_ui_host_run") { << true }
    if str_eq_lit(name, "xu_ui_mem_try_write") { << true }
    if str_eq_lit(name, "xu_ui_mem_try_read_len") { << true }
    if str_eq_lit(name, "xu_ui_mem_try_read_copy") { << true }
    if str_eq_lit(name, "_xu_ui_mem_try_write") { << true }
    if str_eq_lit(name, "_xu_ui_mem_try_read_len") { << true }
    if str_eq_lit(name, "_xu_ui_mem_try_read_copy") { << true }
    << false
}

fn host_syms_seed(list &mut []string) {
    undef_add(list, "xu_ui_host_run")
    undef_add(list, "_xu_ui_host_run")
    undef_add(list, "xu_ui_mem_try_write")
    undef_add(list, "xu_ui_mem_try_read_len")
    undef_add(list, "xu_ui_mem_try_read_copy")
    undef_add(list, "_xu_ui_mem_try_write")
    undef_add(list, "_xu_ui_mem_try_read_len")
    undef_add(list, "_xu_ui_mem_try_read_copy")
}

fn iat_target(name string) string {
    if name == "_iat__NSGetEnviron" {
        << "__NSGetEnviron"
    }
    rest := name[5:name.len]
    if starts_with(rest, "_") {
        << rest
    }
    << "_" + rest
}

fn str_in_list(list &[]string, name string) bool {
    for i in 0:list.len {
        if list[i] == name {
            << true
        }
    }
    << false
}

fn undef_add(list &mut []string, name string) {
    for i in 0:list.len {
        if list[i] == name {
            <<
        }
    }
    list.push(name)
}

fn lab_index(lname &[]string, name &string) int {
    for i in 0:lname.len {
        li := lname[i]
        if str_eq(&li, name) {
            << i
        }
    }
    << 0 - 1
}

fn apply_local_branch_arm64(code &mut []int, kind int, roff int, target_off int) {
    cur := roff
    delta := (target_off - cur) / 4
    if kind == 0 || kind == 1 {
        imm26 := delta & 67108863
        mut opcode := 335544320
        if kind == 1 {
            opcode = 2483027968
        }
        w := opcode | imm26
        code[roff] = w & 255
        code[roff + 1] = (w >> 8) & 255
        code[roff + 2] = (w >> 16) & 255
        code[roff + 3] = (w >> 24) & 255
    } else {
        if kind == 2 || kind == 3 {
            imm19 := delta & 524287
            rt := code[roff] & 31
            mut opcode := 3019898880
            if kind == 3 {
                opcode = 3036676096
            }
            w := opcode | (imm19 << 5) | rt
            code[roff] = w & 255
            code[roff + 1] = (w >> 8) & 255
            code[roff + 2] = (w >> 16) & 255
            code[roff + 3] = (w >> 24) & 255
        }
    }
}

fn defined_less(d1 int, o1 int, n1 string, d2 int, o2 int, n2 string) bool {
    if d1 != d2 {
        << d1 < d2
    }
    if o1 != o2 {
        << o1 < o2
    }
    << str_less(n1, n2)
}

fn sym_index_of(sname &[]string, name &string) int {
    for i in 0:sname.len {
        si := sname[i]
        if str_eq(&si, name) {
            << i
        }
    }
    << 0 - 1
}

fn xuobj_macho_read_raw(path string) []int {
    src := read_file(path) or (err) {
        eprintln("xuobj_macho: cannot read " + path)
        << []int{}
    }
    mut raw := []int{}
    for i in 0:src.len {
        raw.push(src[i] & 255)
    }
    << raw
}

// IAT pointer slots must be 8-byte aligned; pad before the first iat_* only.
// Returns padded data (unchanged if no pad needed).
fn xuobj_macho_iat_pad_data(data &[]int, lname &[]string, loff &mut []int, ldata &[]int) []int {
    mut min_iat := 0 - 1
    for i in 0:lname.len {
        if ldata[i] != 0 && starts_with(lname[i], "_iat_") {
            if min_iat < 0 || loff[i] < min_iat {
                min_iat = loff[i]
            }
        }
    }
    if min_iat < 0 {
        mut same := []int{}
        for i in 0:data.len {
            same.push(data[i] & 255)
        }
        << same
    }
    pad := (8 - (min_iat % 8)) % 8
    if pad == 0 {
        mut same := []int{}
        for i in 0:data.len {
            same.push(data[i] & 255)
        }
        << same
    }
    mut nd := []int{}
    for i in 0:min_iat {
        nd.push(data[i] & 255)
    }
    for _ in 0:pad {
        nd.push(0)
    }
    for i in min_iat:data.len {
        nd.push(data[i] & 255)
    }
    for i in 0:lname.len {
        if ldata[i] != 0 && loff[i] >= min_iat {
            loff[i] = loff[i] + pad
        }
    }
    << nd
}

fn xuobj_macho_sort_lab_order(nlab int, lname &[]string, loff &[]int, ldata &[]int, order &mut []int) {
    for i in 0:nlab {
        order.push(i)
    }
    // Bottom-up merge sort keeps large native consumers O(n log n).
    mut work := []int{}
    for i in 0:nlab { work.push(i) }
    mut width := 1
    while width < nlab {
        mut start := 0
        while start < nlab {
            mut middle := start + width
            if middle > nlab { middle = nlab }
            mut end := middle + width
            if end > nlab { end = nlab }
            mut left := start
            mut right := middle
            for k in start:end {
                mut take_right := false
                if left >= middle { take_right = true }
                else if right < end {
                    li := order[left]
                    ri := order[right]
                    take_right = defined_less(ldata[ri], loff[ri], lname[ri], ldata[li], loff[li], lname[li])
                }
                if take_right { work[k] = order[right]
                    right += 1 }
                else { work[k] = order[left]
                    left += 1 }
            }
            start = end
        }
        for k in 0:nlab { order[k] = work[k] }
        width *= 2
    }
}

fn xuobj_macho_build_defined(
    lname &[]string,
    loff &[]int,
    ldata &[]int,
    order &[]int,
    nlab int,
    external_host bool,
    dname &mut []string,
    dsect &mut []int,
    dval &mut []int
) {
    mut has_app_start := 0
    for k in 0:nlab {
        i := order[k]
        name := lname[i]
        if external_host && is_host_sym(&name) {
            ->
        }
        mut sect := 1
        if ldata[i] != 0 {
            sect = 2
        }
        dname.push(str_clone(&name))
        dsect.push(sect)
        dval.push(loff[i])
        if name == "_xu_app_start" {
            has_app_start = 1
        }
    }
    start_lab := "_start"
    si := lab_index(lname, &start_lab)
    if si >= 0 && has_app_start == 0 {
        dname.push("_xu_app_start")
        dsect.push(1)
        dval.push(loff[si])
    }
}

fn xuobj_macho_pack_text_relocs(
    code &mut []int,
    is_x64 int,
    pkind &[]int,
    proff &[]int,
    plab &[]string,
    sname &[]string,
    text_relocs &mut []int
) int {
    for i in 0:pkind.len {
        kind := pkind[i]
        ro := proff[i]
        lab := plab[i]
        sym := sym_index_of(sname, &lab)
        if sym < 0 {
            eprintln("xuobj_macho: missing sym " + lab)
            << 1
        }
        if is_x64 == 1 {
            if kind == 0 {
                r := pack_reloc(ro, sym, 1, 2, 1, 2)
                append_bytes(text_relocs, &r)
                set_u32_le(code, ro, 0)
            } else {
                if kind == 1 {
                    r := pack_reloc(ro, sym, 1, 2, 1, 1)
                    append_bytes(text_relocs, &r)
                    set_u32_le(code, ro, 0)
                } else {
                    eprintln("xuobj_macho: unknown x64 reloc kind " + str(kind))
                    << 1
                }
            }
        } else {
            if kind == 0 || kind == 1 {
                r := pack_reloc(ro, sym, 1, 2, 1, 2)
                append_bytes(text_relocs, &r)
            } else {
                if kind == 2 || kind == 3 {
                    r := pack_reloc(ro, sym, 1, 2, 1, 15)
                    append_bytes(text_relocs, &r)
                } else {
                    if kind == 4 {
                        r1 := pack_reloc(ro, sym, 1, 2, 1, 3)
                        append_bytes(text_relocs, &r1)
                        r2 := pack_reloc(ro + 4, sym, 0, 2, 1, 4)
                        append_bytes(text_relocs, &r2)
                    } else {
                        eprintln("xuobj_macho: unknown arm64 reloc kind " + str(kind))
                        << 1
                    }
                }
            }
        }
    }
    << 0
}

fn xuobj_macho_pack_data_iat_relocs(
    lname &[]string,
    loff &[]int,
    ldata &[]int,
    sname &[]string,
    data_relocs &mut []int
) int {
    for i in 0:lname.len {
        if ldata[i] == 0 || !starts_with(lname[i], "_iat_") {
            ->
        }
        tgt := iat_target(lname[i])
        sym := sym_index_of(sname, &tgt)
        if sym < 0 {
            eprintln("xuobj_macho: missing iat sym " + tgt)
            << 1
        }
        rtype := 0
        r := pack_reloc(loff[i], sym, 0, 3, 1, rtype)
        append_bytes(data_relocs, &r)
    }
    << 0
}

fn xuobj_macho_write_file(
    code &[]int,
    data &[]int,
    is_x64 int,
    sname &[]string,
    stype &[]int,
    ssect &[]int,
    sdesc &[]int,
    sval &[]int,
    text_relocs &[]int,
    data_relocs &[]int,
    nextdef int,
    nundef int,
    out_o string
) int {
    mut strings := []int{}
    strings.push(0)
    mut strx := []int{}
    for i in 0:sname.len {
        strx.push(strings.len)
        for j in 0:sname[i].len {
            strings.push(sname[i][j] & 255)
        }
        strings.push(0)
    }

    nsects := 2
    seg_cmd := 72 + 80 * nsects
    sizeofcmds := seg_cmd + 24 + 24 + 80
    header := 32
    text_off := macho_align(header + sizeofcmds, 8)
    data_off := macho_align(text_off + code.len, 8)
    n_text_r := text_relocs.len / 8
    n_data_r := data_relocs.len / 8
    text_reloff := macho_align(data_off + data.len, 8)
    data_reloff := text_reloff + 8 * n_text_r
    symoff := macho_align(data_reloff + 8 * n_data_r, 8)
    stroff := symoff + 16 * sname.len

    seg_fileoff := text_off
    seg_filesize := (data_off - text_off) + data.len
    seg_vmsize := macho_align(seg_filesize, 8)

    mut cpu_type := 16777228
    mut cpu_subtype := 0
    if is_x64 == 1 {
        cpu_type = 16777223
        cpu_subtype = 3
    }

    mut buf := []int{}
    put_u32(mut &buf, 4277009103)
    put_u32(mut &buf, cpu_type)
    put_u32(mut &buf, cpu_subtype)
    put_u32(mut &buf, 1)
    put_u32(mut &buf, 4)
    put_u32(mut &buf, sizeofcmds)
    put_u32(mut &buf, 0)
    put_u32(mut &buf, 0)

    put_u32(mut &buf, 25)
    put_u32(mut &buf, seg_cmd)
    for _ in 0:16 {
        buf.push(0)
    }
    put_u64(mut &buf, 0)
    put_u64(mut &buf, seg_vmsize)
    put_u64(mut &buf, seg_fileoff)
    put_u64(mut &buf, seg_filesize)
    put_u32(mut &buf, 7)
    put_u32(mut &buf, 7)
    put_u32(mut &buf, nsects)
    put_u32(mut &buf, 0)

    write_str(mut &buf, "__text", 16)
    write_str(mut &buf, "__TEXT", 16)
    put_u64(mut &buf, 0)
    put_u64(mut &buf, code.len)
    put_u32(mut &buf, text_off)
    put_u32(mut &buf, 2)
    mut tr_off := 0
    if n_text_r > 0 {
        tr_off = text_reloff
    }
    put_u32(mut &buf, tr_off)
    put_u32(mut &buf, n_text_r)
    put_u32(mut &buf, 2147484672)
    put_u32(mut &buf, 0)
    put_u32(mut &buf, 0)
    put_u32(mut &buf, 0)

    write_str(mut &buf, "__data", 16)
    write_str(mut &buf, "__DATA", 16)
    put_u64(mut &buf, 0)
    put_u64(mut &buf, data.len)
    put_u32(mut &buf, data_off)
    put_u32(mut &buf, 3)
    mut dr_off := 0
    if n_data_r > 0 {
        dr_off = data_reloff
    }
    put_u32(mut &buf, dr_off)
    put_u32(mut &buf, n_data_r)
    put_u32(mut &buf, 0)
    put_u32(mut &buf, 0)
    put_u32(mut &buf, 0)
    put_u32(mut &buf, 0)

    put_u32(mut &buf, 50)
    put_u32(mut &buf, 24)
    put_u32(mut &buf, 1)
    put_u32(mut &buf, 720896)
    put_u32(mut &buf, 720896)
    put_u32(mut &buf, 0)

    put_u32(mut &buf, 2)
    put_u32(mut &buf, 24)
    put_u32(mut &buf, symoff)
    put_u32(mut &buf, sname.len)
    put_u32(mut &buf, stroff)
    put_u32(mut &buf, strings.len)

    put_u32(mut &buf, 11)
    put_u32(mut &buf, 80)
    put_u32(mut &buf, 0)
    put_u32(mut &buf, 0)
    put_u32(mut &buf, 0)
    put_u32(mut &buf, nextdef)
    put_u32(mut &buf, nextdef)
    put_u32(mut &buf, nundef)
    for _ in 0:12 {
        put_u32(mut &buf, 0)
    }

    if buf.len != header + sizeofcmds {
        eprintln("xuobj_macho: load command size mismatch")
        << 1
    }
    pad_buf_to(mut &buf, text_off)
    append_bytes(mut &buf, code)
    pad_buf_to(mut &buf, data_off)
    append_bytes(mut &buf, data)
    pad_buf_to(mut &buf, text_reloff)
    append_bytes(mut &buf, text_relocs)
    pad_buf_to(mut &buf, data_reloff)
    append_bytes(mut &buf, data_relocs)
    pad_buf_to(mut &buf, symoff)
    for i in 0:sname.len {
        put_u32(mut &buf, strx[i])
        buf.push(stype[i] & 255)
        buf.push(ssect[i] & 255)
        put_u16(mut &buf, sdesc[i])
        put_u64(mut &buf, sval[i])
    }
    pad_buf_to(mut &buf, stroff)
    append_bytes(mut &buf, &strings)

    write_file(out_o, string_from_bytes(buf)) or (err) {
        eprintln("xuobj_macho: cannot write " + out_o)
        << 1
    }
    mut arch_name := "arm64"
    if is_x64 == 1 {
        arch_name = "x64"
    }
    println("wrote " + out_o + " arch=" + arch_name + " code=" + str(code.len) + " data=" + str(data.len) + " syms=" + str(sname.len) + " tr=" + str(n_text_r) + " dr=" + str(n_data_r))
    << 0
}

fn xuobj_macho_from_obj(obj &mut XuObject, out_o string) int {
    << xuobj_macho_from_obj_mode(obj, out_o, true)
}

fn xuobj_macho_from_obj_mode(obj &mut XuObject, out_o string, external_host bool) int {
    arch := obj.arch
    if arch != 1 && arch != 2 {
        eprintln("xuobj_macho: unsupported arch=" + str(arch) + " (need arm64=1 or x64=2)")
        << 1
    }
    mut is_x64 := 0
    if arch == 2 {
        is_x64 = 1
    }
    << xuobj_macho_obj_reloc(obj, out_o, is_x64, external_host)
}

fn xuobj_macho_obj_reloc(obj &mut XuObject, out_o string, is_x64 int, external_host bool) int {
    mut data_in := []int{}
    for i in 0:obj.data.len {
        data_in.push(obj.data[i] & 255)
    }
    mut lname_work := []string{}
    for i in 0:obj.lname.len {
        ln := obj.lname[i]
        lname_work.push(str_clone(&ln))
    }
    mut loff_work := []int{}
    for i in 0:obj.loff.len {
        loff_work.push(obj.loff[i])
    }
    mut ldata_b := []int{}
    for i in 0:obj.ldata.len {
        ldata_b.push(obj.ldata[i])
    }
    padded := xuobj_macho_iat_pad_data(&data_in, &lname_work, mut &loff_work, &ldata_b)
    obj.data = padded
    obj.lname = lname_work
    obj.loff = loff_work
    obj.ldata = ldata_b

    obj.mx_pk = []int{}
    obj.mx_po = []int{}
    obj.mx_pl = []string{}
    for i in 0:obj.rkind.len {
        kind := obj.rkind[i]
        ro := obj.roff[i]
        lab := obj.rlab[i]
        if external_host && is_host_sym(&lab) {
            obj.mx_pk.push(kind)
            obj.mx_po.push(ro)
            obj.mx_pl.push(str_clone(&lab))
            ->
        }
        li := lab_index(&obj.lname, &lab)
        if is_x64 == 1 {
            if kind == 0 && li >= 0 && obj.ldata[li] == 0 {
                target := obj.loff[li]
                set_u32_le(mut &obj.code, ro, target - (ro + 4))
                ->
            }
            obj.mx_pk.push(kind)
            obj.mx_po.push(ro)
            obj.mx_pl.push(str_clone(&lab))
        } else {
            if li >= 0 && obj.ldata[li] == 0 && (kind == 0 || kind == 1 || kind == 2 || kind == 3) {
                branch_tgt := obj.loff[li]
                apply_local_branch_arm64(mut &obj.code, kind, ro, branch_tgt)
            } else {
                obj.mx_pk.push(kind)
                obj.mx_po.push(ro)
                obj.mx_pl.push(str_clone(&lab))
            }
        }
    }
    << xuobj_macho_obj_sym(obj, out_o, is_x64, external_host)
}

fn xuobj_macho_obj_sym(obj &mut XuObject, out_o string, is_x64 int, external_host bool) int {
    mut undef := []string{}
    if external_host { host_syms_seed(mut &undef) }
    for i in 0:obj.mx_pl.len {
        lab := obj.mx_pl[i]
        li := lab_index(&obj.lname, &lab)
        if li < 0 || (external_host && is_host_sym(&lab)) {
            undef_add(mut &undef, lab)
        }
    }
    for i in 0:obj.lname.len {
        if obj.ldata[i] != 0 && starts_with(obj.lname[i], "_iat_") {
            undef_add(mut &undef, iat_target(obj.lname[i]))
        }
    }

    nlab := obj.lname.len
    mut order := []int{}
    mut loff_b := []int{}
    for i in 0:obj.loff.len {
        loff_b.push(obj.loff[i])
    }
    mut lname_b := []string{}
    mut ldata_b := []int{}
    for i in 0:obj.lname.len {
        nm := obj.lname[i]
        lname_b.push(str_clone(&nm))
        ldata_b.push(obj.ldata[i])
    }
    xuobj_macho_sort_lab_order(nlab, &lname_b, &loff_b, &ldata_b, mut &order)

    mut dname := []string{}
    mut dsect := []int{}
    mut dval := []int{}
    xuobj_macho_build_defined(&lname_b, &loff_b, &ldata_b, &order, nlab, external_host, mut &dname, mut &dsect, mut &dval)

    mut undef_list := []string{}
    for i in 0:undef.len {
        if !str_in_list(&dname, undef[i]) {
            u := undef[i]
            undef_list.push(str_clone(&u))
        }
    }
    undef_list = sort_names(undef_list)

    obj.mx_sn = []string{}
    obj.mx_st = []int{}
    obj.mx_ss = []int{}
    obj.mx_sd = []int{}
    obj.mx_sv = []int{}
    for i in 0:dname.len {
        dn := dname[i]
        obj.mx_sn.push(str_clone(&dn))
        obj.mx_st.push(14 | 1)
        obj.mx_ss.push(dsect[i])
        obj.mx_sd.push(0)
        obj.mx_sv.push(dval[i])
    }
    for i in 0:undef_list.len {
        un := undef_list[i]
        obj.mx_sn.push(str_clone(&un))
        obj.mx_st.push(0 | 1)
        obj.mx_ss.push(0)
        obj.mx_sd.push(0)
        obj.mx_sv.push(0)
    }
    obj.mx_ndef = dname.len
    obj.mx_nund = undef_list.len
    << xuobj_macho_obj_write(obj, out_o, is_x64)
}

fn xuobj_macho_obj_write(obj &mut XuObject, out_o string, is_x64 int) int {
    mut pk := []int{}
    for i in 0:obj.mx_pk.len {
        pk.push(obj.mx_pk[i])
    }
    mut po := []int{}
    for i in 0:obj.mx_po.len {
        po.push(obj.mx_po[i])
    }
    mut pl := []string{}
    for i in 0:obj.mx_pl.len {
        lb := obj.mx_pl[i]
        pl.push(str_clone(&lb))
    }
    mut sn := []string{}
    for i in 0:obj.mx_sn.len {
        nm := obj.mx_sn[i]
        sn.push(str_clone(&nm))
    }
    mut tr := []int{}
    mut rc := xuobj_macho_pack_text_relocs(
        mut &obj.code,
        is_x64,
        &pk,
        &po,
        &pl,
        &sn,
        mut &tr
    )
    if rc != 0 {
        << rc
    }
    obj.mx_tr = tr
    obj.mx_sn = sn
    << xuobj_macho_obj_write_data(obj, out_o, is_x64)
}

fn xuobj_macho_obj_write_data(obj &mut XuObject, out_o string, is_x64 int) int {
    mut lname_b := []string{}
    mut loff_b := []int{}
    mut ldata_b := []int{}
    mut sn_b := []string{}
    for i in 0:obj.lname.len {
        nm := obj.lname[i]
        lname_b.push(str_clone(&nm))
        loff_b.push(obj.loff[i])
        ldata_b.push(obj.ldata[i])
    }
    for i in 0:obj.mx_sn.len {
        nm := obj.mx_sn[i]
        sn_b.push(str_clone(&nm))
    }
    mut dr := []int{}
    mut rc := xuobj_macho_pack_data_iat_relocs(
        &lname_b,
        &loff_b,
        &ldata_b,
        &sn_b,
        mut &dr
    )
    if rc != 0 {
        << rc
    }
    // Snapshot remaining fields before consuming `dr` into obj.
    mut code_b := []int{}
    for i in 0:obj.code.len {
        code_b.push(obj.code[i])
    }
    mut data_b := []int{}
    for i in 0:obj.data.len {
        data_b.push(obj.data[i])
    }
    mut sn2 := []string{}
    for i in 0:obj.mx_sn.len {
        nm := obj.mx_sn[i]
        sn2.push(str_clone(&nm))
    }
    mut st_b := []int{}
    mut ss_b := []int{}
    mut sd_b := []int{}
    mut sv_b := []int{}
    for i in 0:obj.mx_st.len {
        st_b.push(obj.mx_st[i])
        ss_b.push(obj.mx_ss[i])
        sd_b.push(obj.mx_sd[i])
        sv_b.push(obj.mx_sv[i])
    }
    mut tr_b := []int{}
    for i in 0:obj.mx_tr.len {
        tr_b.push(obj.mx_tr[i])
    }
    ndef := obj.mx_ndef
    nund := obj.mx_nund
    mut dr_b := []int{}
    for i in 0:dr.len {
        dr_b.push(dr[i])
    }
    obj.mx_dr = dr
    << xuobj_macho_write_file(
        &code_b,
        &data_b,
        is_x64,
        &sn2,
        &st_b,
        &ss_b,
        &sd_b,
        &sv_b,
        &tr_b,
        &dr_b,
        ndef,
        nund,
        out_o
    )
}

fn xuobj_macho_from_raw(raw []int, out_o string) int {
    if raw.len < 12 {
        eprintln("xuobj_macho: truncated XUOBJ")
        << 1
    }
    mut obj := xuobj_decode_archive(raw)
    << xuobj_macho_from_obj(mut &obj, out_o)
}

fn xuobj_write_macho_o(xuobj_path string, out_o string) int {
    raw := xuobj_macho_read_raw(xuobj_path)
    if raw.len == 0 {
        << 1
    }
    << xuobj_macho_from_raw(raw, out_o)
}

// Ordinary native executables retain standalone UI-memory fallback stubs.
// The pack/object export entry above still leaves host overrides undefined.
fn xuobj_write_macho_o_native(xuobj_path string, out_o string) int {
    raw := xuobj_macho_read_raw(xuobj_path)
    if raw.len == 0 { << 1 }
    mut obj := xuobj_decode_archive(raw)
    << xuobj_macho_from_obj_mode(mut &obj, out_o, false)
}
