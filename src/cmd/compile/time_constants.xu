@main

// Nanosecond conversion factors shared by emitted clocks, waits and compiler
// timings. FILETIME uses 100 ns ticks counted from the Windows epoch.
const TIME_NS_PER_MICROSECOND = 1000
const TIME_NS_PER_MILLISECOND = 1000000
const TIME_NS_PER_SECOND = 1000000000
const TIME_NS_PER_FILETIME_TICK = 100
const TIME_FILETIME_UNIX_EPOCH_TICKS = 116444736000000000
