@main

#xu/types

fn rt_emit_init_auxv(a &mut Assembler) {
    if a.os != 1 {
        <<
    }
    if a.arch == 0 {
        a.align_data(8)
        a.data_label("_rt_cpu_arm64_hwcap")
        rt_emit_zeros(a, 8)
    }
    a.label("_rt_init_auxv")
    a.prologue(16)
    ps := ptr_bytes(a.arch)
    a.vm_add_imm(0, 18, 1)
    a.shl_imm(0, 0, ptr_shift(a.arch))
    a.add(0, 0, 19)
    a.label("_rt_ax_env")
    a.load(1, 0, 0)
    a.vm_cbz(1, "_rt_ax_aux")
    a.vm_add_imm(0, 0, ps)
    a.jmp("_rt_ax_env")
    a.label("_rt_ax_aux")
    a.vm_add_imm(0, 0, ps)
    a.label("_rt_ax_loop")
    a.load(1, 0, 0)
    a.vm_cbz(1, "_rt_ax_done")
    if a.arch == 0 {
        a.vm_cmp_imm(1, 16) // AT_HWCAP
        a.jeq("_rt_ax_hwcap")
    }
    a.vm_cmp_imm(1, 6)
    a.jne("_rt_ax_next")
    a.load(2, 0, ps)
    a.lea(3, "_rt_pagesize_slot")
    a.store(3, 0, 2)
    a.jmp("_rt_ax_next")
    // Keep scanning after AT_PAGESZ: AT_HWCAP can occur in either order.
    if a.arch == 0 {
        a.label("_rt_ax_hwcap")
        a.load(2, 0, ps)
        a.lea(3, "_rt_cpu_arm64_hwcap")
        a.store(3, 0, 2)
        a.jmp("_rt_ax_next")
    }
    a.label("_rt_ax_next")
    a.vm_add_imm(0, 0, ps + ps)
    a.jmp("_rt_ax_loop")
    a.label("_rt_ax_done")
    a.epilogue()
    <<
}

// Windows only: GetSystemInfo -> dwPageSize into the slot.
fn rt_emit_win_sysinfo(a &mut Assembler) {
    if a.os != 2 {
        <<
    }
    a.label("_rt_win_sysinfo")
    a.prologue(64)
    a.mov(18, 15)
    a.vm_sub_imm(18, 18, 48)
    a.vm_call_iat("_iat_GetSystemInfo")
    a.load(1, 15, -44) // dwPageSize at buf+4
    a.lea(0, "_rt_pagesize_slot")
    a.store(0, 0, 1)
    a.epilogue()
    <<
}

// Builds the global env array (ptr, len, cap) of owning "KEY=VALUE"
// strings. macOS: _NSGetEnviron (dyld); linux: envp = argv + (argc+1)*8;
// windows: GetEnvironmentStringsA block (leaked until exit, OS reclaims).
fn rt_emit_collect_env(a &mut Assembler) {
    a.align_data(8)
    a.data_label("_rt_env_arr")
    rt_emit_zeros(a, 24)
    if a.os == 3 {
        <<
    }
    if a.os == 2 {
        rt_emit_collect_env_win(a)
        <<
    }
    if a.os == 1 {
        a.label("_rt_collect_envp")
        a.prologue(64)
        a.mov(0, 18)
        a.vm_cbnz(0, "_rt_ce_have_env")
        // libc clearenv() may leave environ == NULL.
        a.lea(0, "_rt_env_arr")
        a.vm_mov_imm(1, 0)
        a.store(0, 0, 1)
        a.store(0, 8, 1)
        a.store(0, 16, 1)
        a.epilogue()
    }
    a.label("_rt_collect_env")
    a.prologue(64)
    if a.os == 0 {
        a.vm_call_iat("_iat__NSGetEnviron")
        a.load(0, 14, 0)
    } else {
        a.vm_add_imm(0, 18, 1)
        a.shl_imm(0, 0, ptr_shift(a.arch))
        a.add(0, 0, 19)
    }
    if a.os == 1 { a.label("_rt_ce_have_env") }
    a.store(15, -16, 0) // envp
    a.vm_mov_imm(1, 0)
    a.label("_rt_ce_cnt")
    a.load(2, 0, 0)
    a.vm_cbz(2, "_rt_ce_cnt_done")
    a.vm_add_imm(1, 1, 1)
    a.vm_add_imm(0, 0, ptr_bytes(a.arch))
    a.jmp("_rt_ce_cnt")
    a.label("_rt_ce_cnt_done")
    a.store(15, -24, 1) // n
    a.vm_mov_imm(3, 24)
    a.mul(4, 1, 3)
    a.div(5, 4, 3)
    a.cmp(5, 1)
    a.jeq("_rt_ce_bytes_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ce_bytes_ok")
    a.mov(18, 4)
    a.call("_rt_alloc")
    a.store(15, -32, 14) // buf
    a.vm_mov_imm(4, 0)
    a.store(15, -8, 4) // i (frame: alloc clobbers scratch)
    a.label("_rt_ce_loop")
    a.load(4, 15, -8)
    a.load(0, 15, -24)
    a.cmp(4, 0)
    a.jge("_rt_ce_done")
    a.load(2, 15, -16)
    a.mov(0, 4)
    a.shl_imm(0, 0, ptr_shift(a.arch))
    a.add(2, 2, 0)
    a.load(2, 2, 0)
    a.store(15, -40, 2) // p
    a.vm_mov_imm(5, 0)
    a.label("_rt_ce_strlen")
    a.load(2, 15, -40)
    a.add(2, 2, 5)
    a.load_byte(1, 2, 0)
    a.vm_cbnz(1, "_rt_ce_strlen_next")
    a.jmp("_rt_ce_strlen_done")
    a.label("_rt_ce_strlen_next")
    a.vm_add_imm(5, 5, 1)
    a.jmp("_rt_ce_strlen")
    a.label("_rt_ce_strlen_done")
    a.store(15, -48, 5) // len
    a.mov(18, 5)
    a.call("_rt_alloc")
    a.store(15, -56, 14) // s
    a.vm_mov_imm(5, 0)
    a.label("_rt_ce_copy")
    a.load(1, 15, -48)
    a.cmp(5, 1)
    a.jge("_rt_ce_cdone")
    a.load(2, 15, -40)
    a.add(2, 2, 5)
    a.load_byte(3, 2, 0)
    a.load(1, 15, -56)
    a.add(1, 1, 5)
    a.store_byte(1, 0, 3)
    a.vm_add_imm(5, 5, 1)
    a.jmp("_rt_ce_copy")
    a.label("_rt_ce_cdone")
    a.load(2, 15, -32)
    a.load(4, 15, -8)
    a.mov(3, 4)
    a.vm_mov_imm(0, 24)
    a.mul(3, 3, 0)
    a.add(2, 2, 3)
    a.load(1, 15, -56)
    a.store(2, 0, 1)
    a.load(1, 15, -48)
    a.store(2, 8, 1)
    a.store(2, 16, 1)
    a.load(0, 15, -8)
    a.vm_add_imm(0, 0, 1)
    a.store(15, -8, 0)
    a.jmp("_rt_ce_loop")
    a.label("_rt_ce_done")
    a.lea(0, "_rt_env_arr")
    a.load(1, 15, -32)
    a.store(0, 0, 1)
    a.load(1, 15, -24)
    a.store(0, 8, 1)
    a.store(0, 16, 1)
    a.epilogue()
    <<
}

fn rt_emit_collect_env_win(a &mut Assembler) {
    a.label("_rt_collect_env")
    a.prologue(64)
    a.vm_call_iat("_iat_GetEnvironmentStringsA")
    a.vm_cbnz(14, "_rt_cew_got")
    a.lea(0, "_rt_env_arr")
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, 8, 1)
    a.store(0, 16, 1)
    a.epilogue()
    a.label("_rt_cew_got")
    a.store(15, -8, 14) // block
    a.store(15, -16, 14) // p
    a.vm_mov_imm(1, 0)
    a.label("_rt_cew_cnt")
    a.load(0, 15, -16)
    a.load_byte(2, 0, 0)
    a.vm_cbz(2, "_rt_cew_cnt_done")
    a.vm_add_imm(1, 1, 1)
    a.label("_rt_cew_skip")
    a.load(0, 15, -16)
    a.load_byte(3, 0, 0)
    a.vm_cbz(3, "_rt_cew_skip_nul")
    a.vm_add_imm(0, 0, 1)
    a.store(15, -16, 0)
    a.jmp("_rt_cew_skip")
    // End of one KEY=VAL: advance past the NUL, then look for next / block end.
    a.label("_rt_cew_skip_nul")
    a.vm_add_imm(0, 0, 1)
    a.store(15, -16, 0)
    a.jmp("_rt_cew_cnt")
    a.label("_rt_cew_cnt_done")
    a.store(15, -24, 1) // n
    a.vm_mov_imm(3, 24)
    a.mul(4, 1, 3)
    a.div(5, 4, 3)
    a.cmp(5, 1)
    a.jeq("_rt_cew_bytes_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_cew_bytes_ok")
    a.mov(18, 4)
    a.call("_rt_alloc")
    a.store(15, -32, 14) // buf
    a.vm_mov_imm(4, 0)
    a.store(15, -40, 4) // i (frame)
    a.load(0, 15, -8)
    a.store(15, -16, 0) // p reset
    a.label("_rt_cew_loop")
    a.load(4, 15, -40)
    a.load(1, 15, -24)
    a.cmp(4, 1)
    a.jge("_rt_cew_done")
    a.vm_mov_imm(5, 0)
    a.label("_rt_cew_strlen")
    a.load(2, 15, -16)
    a.add(2, 2, 5)
    a.load_byte(3, 2, 0)
    a.vm_cbz(3, "_rt_cew_strlen_done")
    a.vm_add_imm(5, 5, 1)
    a.jmp("_rt_cew_strlen")
    a.label("_rt_cew_strlen_done")
    a.store(15, -48, 5) // len
    a.mov(18, 5)
    a.call("_rt_alloc")
    a.store(15, -56, 14) // s
    a.vm_mov_imm(5, 0)
    a.label("_rt_cew_copy")
    a.load(1, 15, -48)
    a.cmp(5, 1)
    a.jge("_rt_cew_cdone")
    a.load(2, 15, -16)
    a.add(2, 2, 5)
    a.load_byte(3, 2, 0)
    a.load(1, 15, -56)
    a.add(1, 1, 5)
    a.store_byte(1, 0, 3)
    a.vm_add_imm(5, 5, 1)
    a.jmp("_rt_cew_copy")
    a.label("_rt_cew_cdone")
    a.load(2, 15, -32)
    a.load(4, 15, -40)
    a.mov(3, 4)
    a.vm_mov_imm(0, 24)
    a.mul(3, 3, 0)
    a.add(2, 2, 3)
    a.load(1, 15, -56)
    a.store(2, 0, 1)
    a.load(1, 15, -48)
    a.store(2, 8, 1)
    a.store(2, 16, 1)
    a.load(0, 15, -16)
    a.load(1, 15, -48)
    a.add(0, 0, 1)
    a.vm_add_imm(0, 0, 1)
    a.store(15, -16, 0)
    a.load(0, 15, -40)
    a.vm_add_imm(0, 0, 1)
    a.store(15, -40, 0)
    a.jmp("_rt_cew_loop")
    a.label("_rt_cew_done")
    a.lea(0, "_rt_env_arr")
    a.load(1, 15, -32)
    a.store(0, 0, 1)
    a.load(1, 15, -24)
    a.store(0, 8, 1)
    a.store(0, 16, 1)
    a.epilogue()
    <<
}

// sret string (V0=X8): ptr@0, len@-8, cap@-16. Empty result uses a valid
// address (ENV slot) with len 0.
fn rt_emit_env_get(a &mut Assembler) {
    a.label("_rt_env_get")
    a.prologue(64)
    a.store(15, -8, 0) // sret
    a.store(15, -16, 18) // name ptr
    a.store(15, -24, 19) // name len
    a.vm_mov_imm(0, 0)
    a.store(15, -32, 0) // i
    a.label("_rt_eg_loop")
    a.lea(1, "_rt_env_arr")
    a.load(2, 1, 8)
    a.load(3, 15, -32)
    a.cmp(3, 2)
    a.jge("_rt_eg_notfound")
    a.lea(1, "_rt_env_arr")
    a.load(1, 1, 0)
    a.vm_mov_imm(2, 24)
    a.mul(3, 3, 2)
    a.add(1, 1, 3)
    a.store(15, -40, 1) // e
    a.load(1, 1, 8)
    a.store(15, -48, 1) // elen
    a.load(0, 15, -48)
    a.load(1, 15, -24)
    a.cmp(0, 1)
    a.jle("_rt_eg_next")
    a.vm_mov_imm(4, 0)
    a.label("_rt_eg_cmp")
    a.load(0, 15, -24)
    a.cmp(4, 0)
    a.jge("_rt_eg_match")
    a.load(1, 15, -16)
    a.add(1, 1, 4)
    a.load_byte(2, 1, 0)
    a.load(3, 15, -40)
    a.load(3, 3, 0)
    a.add(3, 3, 4)
    a.load_byte(5, 3, 0)
    if a.os == 2 {
        // Windows environment names are case-insensitive (notably Path/PATH).
        a.vm_cmp_imm(2, 65)
        a.jlt("_rt_eg_name_folded")
        a.vm_cmp_imm(2, 90)
        a.jgt("_rt_eg_name_folded")
        a.vm_add_imm(2, 2, 32)
        a.label("_rt_eg_name_folded")
        a.vm_cmp_imm(5, 65)
        a.jlt("_rt_eg_entry_folded")
        a.vm_cmp_imm(5, 90)
        a.jgt("_rt_eg_entry_folded")
        a.vm_add_imm(5, 5, 32)
        a.label("_rt_eg_entry_folded")
    }
    a.cmp(2, 5)
    a.jne("_rt_eg_next")
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_eg_cmp")
    a.label("_rt_eg_match")
    a.load(0, 15, -24)
    a.load(1, 15, -40)
    a.load(1, 1, 0)
    a.add(1, 1, 0)
    a.load_byte(2, 1, 0)
    a.vm_cmp_imm(2, 61) // '='
    a.jne("_rt_eg_next")
    a.load(0, 15, -24)
    a.load(1, 15, -40)
    a.load(1, 1, 0)
    a.add(1, 1, 0)
    a.vm_add_imm(1, 1, 1)
    a.store(15, -56, 1) // vptr
    a.load(2, 15, -48)
    a.load(0, 15, -24)
    a.sub(2, 2, 0)
    a.vm_sub_imm(2, 2, 1)
    a.store(15, -64, 2) // vlen
    a.mov(18, 2)
    a.call("_rt_alloc")
    a.vm_mov_imm(4, 0)
    a.label("_rt_eg_copy")
    a.load(1, 15, -64)
    a.cmp(4, 1)
    a.jge("_rt_eg_cdone")
    a.load(2, 15, -56)
    a.add(2, 2, 4)
    a.load_byte(3, 2, 0)
    a.add(2, 14, 4)
    a.store_byte(2, 0, 3)
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_eg_copy")
    a.label("_rt_eg_cdone")
    a.load(0, 15, -8)
    a.store(0, 0, 14)
    a.load(1, 15, -64)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_eg_next")
    a.load(0, 15, -32)
    a.vm_add_imm(0, 0, 1)
    a.store(15, -32, 0)
    a.jmp("_rt_eg_loop")
    a.label("_rt_eg_notfound")
    a.load(0, 15, -8)
    a.lea(1, "_rt_env_arr")
    a.store(0, 0, 1)
    a.vm_mov_imm(1, 0)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    <<
}

// environ() returns an owning snapshot; keep the global source alive.
fn rt_emit_env_list(a &mut Assembler) {
    rt_emit_string_array_clone(a, "_rt_env_list", "_rt_env_arr", "_rt_ec_")
}

// uname (linux, nodename at utsname+65) / gethostname IAT (macOS) /
// GetComputerNameA (windows). sret string.
fn rt_emit_host_name(a &mut Assembler) {
    a.label("_rt_host_name")
    a.prologue(816)
    a.store(15, -8, 0) // sret
    if a.os == 2 {
        a.vm_mov_imm(1, 256)
        a.store(15, -16, 1)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, 816)
        a.mov(18, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, 16)
        a.mov(19, 0)
        a.vm_call_iat("_iat_GetComputerNameA")
    } else if a.os == 0 {
        a.mov(18, 15)
        a.vm_sub_imm(18, 18, 816)
        a.vm_mov_imm(19, 256)
        a.vm_call_iat("_iat_gethostname")
    } else {
        a.mov(18, 15)
        a.vm_sub_imm(18, 18, 816)
        a.vm_syscall(syscall_number(a.os, a.arch, 18))
        a.vm_cmp_imm(14, 0)
        a.jne("_rt_hn_empty")
    }
    a.label("_rt_hn_copy")
    a.mov(1, 15)
    a.vm_sub_imm(1, 1, 816)
    if a.os == 1 {
        a.vm_add_imm(1, 1, 65)
    }
    a.store(15, -24, 1) // src
    a.vm_mov_imm(2, 0)
    a.label("_rt_hn_strlen")
    a.load(3, 15, -24)
    a.add(3, 3, 2)
    a.load_byte(4, 3, 0)
    a.vm_cbz(4, "_rt_hn_strlen_done")
    a.vm_add_imm(2, 2, 1)
    a.jmp("_rt_hn_strlen")
    a.label("_rt_hn_strlen_done")
    a.store(15, -32, 2) // len
    a.mov(18, 2)
    a.call("_rt_alloc")
    a.vm_mov_imm(2, 0)
    a.label("_rt_hn_copy2")
    a.load(1, 15, -32)
    a.cmp(2, 1)
    a.jge("_rt_hn_cdone")
    a.load(3, 15, -24)
    a.add(3, 3, 2)
    a.load_byte(4, 3, 0)
    a.add(3, 14, 2)
    a.store_byte(3, 0, 4)
    a.vm_add_imm(2, 2, 1)
    a.jmp("_rt_hn_copy2")
    a.label("_rt_hn_cdone")
    a.load(0, 15, -8)
    a.store(0, 0, 14)
    a.load(1, 15, -32)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_hn_empty")
    a.load(0, 15, -8)
    a.lea(1, "_rt_env_arr")
    a.store(0, 0, 1)
    a.vm_mov_imm(1, 0)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    <<
}

// getcwd syscall (linux) / getcwd IAT (macOS) / GetCurrentDirectoryA
// (windows). sret string.
fn rt_emit_cwd(a &mut Assembler) {
    a.label("_rt_cwd")
    // Buffer occupies [fp - rt_cwd_buffer_bytes, fp); metadata follows below.
    a.prologue(RT_CWD_BUFFER_BYTES + 32)
    a.store(15, -(RT_CWD_BUFFER_BYTES + 8), 0) // sret
    if a.os == 2 {
        a.vm_mov_imm(18, RT_CWD_BUFFER_BYTES)
        a.mov(19, 15)
        a.vm_sub_imm(19, 19, RT_CWD_BUFFER_BYTES)
        a.vm_call_iat("_iat_GetCurrentDirectoryA")
        a.vm_cbz(14, "_rt_cwd_empty")
    } else if a.os == 0 {
        a.mov(18, 15)
        a.vm_sub_imm(18, 18, RT_CWD_BUFFER_BYTES)
        a.vm_mov_imm(19, RT_CWD_BUFFER_BYTES)
        a.vm_call_iat("_iat_getcwd")
        a.vm_cbz(14, "_rt_cwd_empty")
    } else {
        a.mov(18, 15)
        a.vm_sub_imm(18, 18, RT_CWD_BUFFER_BYTES)
        a.vm_mov_imm(19, RT_CWD_BUFFER_BYTES)
        a.vm_syscall(syscall_number(a.os, a.arch, 19))
        a.vm_cbz(14, "_rt_cwd_empty")
    }
    a.label("_rt_cwd_copy")
    a.vm_mov_imm(2, 0)
    a.label("_rt_cwd_strlen")
    a.mov(3, 15)
    a.vm_sub_imm(3, 3, RT_CWD_BUFFER_BYTES)
    a.add(3, 3, 2)
    a.load_byte(4, 3, 0)
    a.vm_cbz(4, "_rt_cwd_strlen_done")
    a.vm_add_imm(2, 2, 1)
    a.jmp("_rt_cwd_strlen")
    a.label("_rt_cwd_strlen_done")
    a.store(15, -(RT_CWD_BUFFER_BYTES + 24), 2) // len
    a.mov(18, 2)
    a.call("_rt_alloc")
    a.vm_mov_imm(2, 0)
    a.label("_rt_cwd_copy2")
    a.load(1, 15, -(RT_CWD_BUFFER_BYTES + 24))
    a.cmp(2, 1)
    a.jge("_rt_cwd_cdone")
    a.mov(3, 15)
    a.vm_sub_imm(3, 3, RT_CWD_BUFFER_BYTES)
    a.add(3, 3, 2)
    a.load_byte(4, 3, 0)
    a.add(3, 14, 2)
    a.store_byte(3, 0, 4)
    a.vm_add_imm(2, 2, 1)
    a.jmp("_rt_cwd_copy2")
    a.label("_rt_cwd_cdone")
    a.load(0, 15, -(RT_CWD_BUFFER_BYTES + 8))
    a.store(0, 0, 14)
    a.load(1, 15, -(RT_CWD_BUFFER_BYTES + 24))
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_cwd_empty")
    a.load(0, 15, -(RT_CWD_BUFFER_BYTES + 8))
    a.lea(1, "_rt_env_arr")
    a.store(0, 0, 1)
    a.vm_mov_imm(1, 0)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    <<
}

// TMPDIR env (fallback /tmp) / GetTempPathA (windows). sret string.
fn rt_emit_tmp_dir(a &mut Assembler) {
    a.data_label("_rt_tmpdir_var")
    a.emit_data([84, 77, 80, 68, 73, 82]) // "TMPDIR"
    a.data_label("_rt_tmp_fallback")
    a.emit_data([47, 116, 109, 112]) // "/tmp"
    a.label("_rt_tmp_dir")
    a.prologue(1040)
    if a.os == 2 {
        a.store(15, -1032, 0) // sret
        a.vm_mov_imm(18, 1024)
        a.mov(19, 15)
        a.vm_sub_imm(19, 19, 1024)
        a.vm_call_iat("_iat_GetTempPathA")
        a.store(15, -1040, 14) // len
        a.vm_cbz(14, "_rt_td_empty")
        a.mov(18, 14)
        a.call("_rt_alloc")
        a.vm_mov_imm(2, 0)
        a.label("_rt_td_copy")
        a.load(1, 15, -1040)
        a.cmp(2, 1)
        a.jge("_rt_td_cdone")
        a.mov(3, 15)
        a.vm_sub_imm(3, 3, 1024)
        a.add(3, 3, 2)
        a.load_byte(4, 3, 0)
        a.add(3, 14, 2)
        a.store_byte(3, 0, 4)
        a.vm_add_imm(2, 2, 1)
        a.jmp("_rt_td_copy")
        a.label("_rt_td_cdone")
        a.load(0, 15, -1032)
        a.store(0, 0, 14)
        a.load(1, 15, -1040)
        a.store(0, -8, 1)
        a.store(0, -16, 1)
        a.epilogue()
        a.label("_rt_td_empty")
        a.load(0, 15, -1032)
        a.lea(1, "_rt_tmp_fallback")
        a.store(0, 0, 1)
        a.vm_mov_imm(1, 4)
        a.store(0, -8, 1)
        a.store(0, -16, 1)
        a.epilogue()
        <<
    }
    a.store(15, -8, 0) // sret
    a.lea(18, "_rt_tmpdir_var")
    a.vm_mov_imm(19, 6)
    a.mov(0, 15)
    a.vm_sub_imm(0, 0, 16)
    a.call("_rt_env_get")
    a.load(1, 15, -24)
    a.vm_cbnz(1, "_rt_td_alias")
    a.load(0, 15, -8)
    a.lea(1, "_rt_tmp_fallback")
    a.store(0, 0, 1)
    a.vm_mov_imm(1, 4)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_td_alias")
    a.load(0, 15, -8)
    a.load(1, 15, -16)
    a.store(0, 0, 1)
    a.load(1, 15, -24)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    <<
}

// ===== rt_collect_args: A0 = argc, A1 = argv (unix) or cmdline (windows) =====
fn rt_emit_collect_args(a &mut Assembler) {
    a.data_label("_rt_argv_arr")
    rt_emit_zeros(a, 24)
    a.data_label("_rt_empty_cstr")
    a.emit_data([0])

    if a.os == 2 {
        rt_emit_collect_args_win(a)
    } else {
        rt_emit_collect_args_unix(a)
    }
    <<
}

fn rt_emit_collect_args_unix(a &mut Assembler) {
    // Frame slots: argc -8, argv -16, i -24, buf -32, p -40, len -48, s -56
    a.label("_rt_collect_args")
    a.prologue(64)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    // buf = alloc(argc * 24)
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 24)
    a.mul(0, 0, 1)
    a.div(2, 0, 1)
    a.load(3, 15, -8)
    a.cmp(2, 3)
    a.jeq("_rt_ca_bytes_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ca_bytes_ok")
    a.mov(18, 0)
    a.call("_rt_alloc")
    a.store(15, -32, 14)
    a.vm_mov_imm(0, 0)
    a.store(15, -24, 0) // i

    a.label("_rt_ca_loop")
    a.load(0, 15, -24)
    a.load(1, 15, -8)
    a.cmp(0, 1)
    a.jge("_rt_ca_done")
    // p = argv[i]
    a.load(2, 15, -16)
    a.load(3, 15, -24)
    a.shl_imm(3, 3, 3)
    a.add(2, 2, 3)
    a.load(2, 2, 0)
    a.store(15, -40, 2) // p
    // len = strlen(p)
    a.vm_mov_imm(4, 0)
    a.label("_rt_ca_strlen")
    a.load(2, 15, -40)
    a.add(2, 2, 4)
    a.load_byte(5, 2, 0)
    a.vm_cbnz(5, "_rt_ca_strlen_next")
    a.jmp("_rt_ca_strlen_done")
    a.label("_rt_ca_strlen_next")
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_ca_strlen")
    a.label("_rt_ca_strlen_done")
    a.store(15, -48, 4) // len
    // s = alloc(len); copy
    a.mov(18, 4)
    a.call("_rt_alloc")
    a.store(15, -56, 14) // s
    a.vm_mov_imm(4, 0)
    a.label("_rt_ca_copy")
    a.load(1, 15, -48)
    a.cmp(4, 1)
    a.jge("_rt_ca_cdone")
    a.load(2, 15, -40)
    a.add(2, 2, 4)
    a.load_byte(5, 2, 0)
    a.load(3, 15, -56)
    a.add(3, 3, 4)
    a.store_byte(3, 0, 5)
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_ca_copy")
    a.label("_rt_ca_cdone")
    // buf[i] = (s, len, len) — ascending triple
    a.load(2, 15, -32)
    a.load(3, 15, -24)
    a.vm_mov_imm(0, 24)
    a.mul(3, 3, 0)
    a.add(2, 2, 3) // &buf[i]
    a.load(1, 15, -56)
    a.store(2, 0, 1)
    a.load(1, 15, -48)
    a.store(2, 8, 1)
    a.store(2, 16, 1)
    // i++
    a.load(0, 15, -24)
    a.vm_add_imm(0, 0, 1)
    a.store(15, -24, 0)
    a.jmp("_rt_ca_loop")

    a.label("_rt_ca_done")
    // global = (buf, argc, argc) ascending
    a.lea(0, "_rt_argv_arr")
    a.load(1, 15, -32)
    a.store(0, 0, 1)
    a.load(1, 15, -8)
    a.store(0, 8, 1)
    a.store(0, 16, 1)
    a.epilogue()
    <<
}

// `_rt_xacp_preflight` handles the one startup command that must be available
// before user code runs.  It intentionally does not consume arguments after
// `--`; those belong to the application.  The command is emitted only for
// binaries built with `xu build/run --xacp`.
fn rt_emit_xacp_preflight(a &mut Assembler) {
    if a.os == 3 {
        <<
    }
    mut tcp_help := "tcp: disabled (port 0)\n"
    if a.xacp_port > 0 {
        tcp_help = "tcp: enabled\nbind: 127.0.0.1:" + str(a.xacp_port) + "\n"
    }
    help := "XACP (Xu Agent Control Protocol)\n" +
        "help_flag: --xacp-help\n" +
        "build: xu build --xacp [--xacp-port PORT] <input.xu>\n" +
        "runtime: <app> --xacp-help\n" +
        "transport: stdio; TCP via --xacp-tcp when enabled\n" +
        "capabilities: stdio\nops: xacp.hello proc.status proc.output ui.tree ui.screenshot ui.input ui.act ui.record\n" +
        "permissions: negotiated after validated xacp.hello (INFO default; host token enables development)\n" +
        "attach: library xacp.attach_stdio() / attach_tcp(port); business main runs; control in xu coroutine\n" +
        "ui: requires register_screen and UI-owner poll; unregistered returns not_implemented\n" +
        "request_timeout: XU_XACP_REQUEST_TIMEOUT_MS (default 5000 ms; ASCII decimal 1..600000; invalid uses default)\n" +
        "memory_safety: src/xacp schema and frame limits\n" +
        "default_port: " + str(a.xacp_port) + "\n" +
        "frame: XACP/1 length prefix: XACP/1\\n<bytes>\\n<XUN body>\n" +
        "control: --xacp-stdio (exclusive stdio; business main is not run)\n" +
        "control_tcp: --xacp-tcp (exclusive; first control flag wins; business main is not run)\n" + tcp_help
    a.align_data(8)
    a.data_label("_rt_xacp_help")
    rt_emit_bytes(a, help + "")
    a.data_label("_rt_xacp_help_arg")
    rt_emit_bytes(a, "--xacp-help")
    a.emit_data([0])
    a.label("_rt_xacp_preflight")
    a.prologue(80)
    a.lea(0, "_rt_entry_argc")
    a.load(0, 0, 0) // argc
    a.store(15, -8, 0)
    a.lea(0, "_rt_entry_argv")
    a.load(0, 0, 0) // argv
    a.store(15, -16, 0)
    a.vm_mov_imm(0, 1) // i; argv[0] is the executable name
    a.store(15, -24, 0)
    a.label("_rt_xacp_arg_loop")
    a.load(0, 15, -24)
    a.load(1, 15, -8)
    a.cmp(0, 1)
    a.jge("_rt_xacp_done")
    a.load(2, 15, -16)
    a.load(3, 15, -24)
    a.shl_imm(3, 3, ptr_shift(a.arch))
    a.add(2, 2, 3)
    a.load(2, 2, 0) // arg pointer
    a.store(15, -32, 2)
    // `--` terminates runtime-option scanning.
    a.load_byte(0, 2, 0)
    a.vm_cmp_imm(0, 45)
    a.jne("_rt_xacp_check_help")
    a.load_byte(0, 2, 1)
    a.vm_cmp_imm(0, 45)
    a.jne("_rt_xacp_check_help")
    a.load_byte(0, 2, 2)
    a.vm_cbz(0, "_rt_xacp_done")
    a.label("_rt_xacp_check_help")
    a.lea(4, "_rt_xacp_help_arg")
    a.store(15, -40, 4)
    a.vm_mov_imm(3, 0) // j
    a.label("_rt_xacp_help_cmp")
    a.vm_cmp_imm(3, 11) // strlen("--xacp-help")
    a.jge("_rt_xacp_help_end")
    a.load(2, 15, -32)
    a.add(5, 2, 3)
    a.load_byte(0, 5, 0)
    a.load(4, 15, -40)
    a.add(5, 4, 3)
    a.load_byte(1, 5, 0)
    a.cmp(0, 1)
    a.jne("_rt_xacp_next_arg")
    a.vm_add_imm(3, 3, 1)
    a.jmp("_rt_xacp_help_cmp")
    a.label("_rt_xacp_help_end")
    // Exact match: the next byte must be the C-string terminator.
    a.vm_mov_imm(3, 11)
    a.load(2, 15, -32)
    a.add(5, 2, 3)
    a.load_byte(0, 5, 0)
    a.vm_cbz(0, "_rt_xacp_print_help")
    a.label("_rt_xacp_next_arg")
    // A mismatch advances argv[i], not the help-string comparison index.
    // Keeping i in the frame is required for non-XACP business arguments;
    // incrementing j here would rescan the same argument forever.
    a.load(0, 15, -24)
    a.vm_add_imm(0, 0, 1)
    a.store(15, -24, 0)
    a.jmp("_rt_xacp_arg_loop")
    a.label("_rt_xacp_print_help")
    a.lea(18, "_rt_xacp_help")
    a.vm_mov_imm(19, help.len)
    a.vm_mov_imm(20, 1)
    a.call("_rt_write")
    a.vm_mov_imm(18, 0)
    a.vm_exit()
    a.label("_rt_xacp_done")
    a.epilogue()
    <<
}

// Windows argv: GetCommandLineA after prologue. If the bytes look like
// UTF-16LE (ASCII unit: second byte 0), narrow then split; else split as ANSI.
// Do not import GetCommandLineW: a zero/wrong IAT slot crashes before main
// (so `up` and `--help` both print nothing).
fn rt_emit_collect_args_win(a &mut Assembler) {
    // Frame: cmdline -8, count -16, i -24, buf -32, arg_start -40,
    // reserved -48/-64, quoted -56, argc -72, source -80, nchars -88,
    // output position -96, backslash count -104
    a.label("_rt_collect_args")
    a.prologue(112)
    a.vm_call_iat("_iat_GetCommandLineA")
    a.vm_cbnz(14, "_rt_cw_have")
    a.lea(14, "_rt_empty_cstr")
    a.store(15, -8, 14)
    a.jmp("_rt_cw_parse")
    a.label("_rt_cw_have")
    a.store(15, -80, 14)
    a.load_byte(5, 14, 0)
    a.load_byte(1, 14, 1)
    a.vm_cbz(5, "_rt_cw_ansi")
    a.vm_cbnz(1, "_rt_cw_ansi")
    a.vm_mov_imm(4, 0)
    a.label("_rt_cw_wlen")
    a.load(2, 15, -80)
    a.shl_imm(3, 4, 1)
    a.add(2, 2, 3)
    a.load_byte(5, 2, 0)
    a.load_byte(1, 2, 1)
    a.ior(5, 5, 1)
    a.vm_cbz(5, "_rt_cw_wlen_done")
    a.vm_add_imm(4, 4, 1)
    a.vm_cmp_imm(4, 32768)
    a.jgt("_rt_cw_wlen_done")
    a.jmp("_rt_cw_wlen")
    a.label("_rt_cw_wlen_done")
    a.store(15, -88, 4)
    a.vm_add_imm(18, 4, 1)
    a.call("_rt_alloc")
    a.store(15, -8, 14)
    a.vm_mov_imm(4, 0)
    a.label("_rt_cw_wcopy")
    a.load(1, 15, -88)
    a.cmp(4, 1)
    a.jge("_rt_cw_wcopy_done")
    a.load(2, 15, -80)
    a.shl_imm(3, 4, 1)
    a.add(2, 2, 3)
    a.load_byte(5, 2, 0)
    a.load(3, 15, -8)
    a.add(3, 3, 4)
    a.store_byte(3, 0, 5)
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_cw_wcopy")
    a.label("_rt_cw_wcopy_done")
    a.load(3, 15, -8)
    a.load(4, 15, -88)
    a.add(3, 3, 4)
    a.vm_mov_imm(5, 0)
    a.store_byte(3, 0, 5)
    a.jmp("_rt_cw_parse")
    a.label("_rt_cw_ansi")
    a.load(14, 15, -80)
    a.store(15, -8, 14)
    a.label("_rt_cw_parse")
    // Copy once, then decode in-place. Argument strings borrow this process-
    // lifetime buffer; no allocation inside the parser can clobber its state.
    a.vm_mov_imm(4, 0)
    a.label("_rt_cw2_len")
    a.load(2, 15, -8)
    a.add(2, 2, 4)
    a.load_byte(5, 2, 0)
    a.vm_cbz(5, "_rt_cw2_len_done")
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_cw2_len")
    a.label("_rt_cw2_len_done")
    a.store(15, -88, 4)
    a.load(0, 15, -8)
    a.store(15, -80, 0)
    a.vm_add_imm(18, 4, 1)
    a.call("_rt_alloc")
    a.store(15, -8, 14)
    a.vm_mov_imm(4, 0)
    a.label("_rt_cw2_copy")
    a.load(2, 15, -80)
    a.add(2, 2, 4)
    a.load_byte(5, 2, 0)
    a.load(3, 15, -8)
    a.add(3, 3, 4)
    a.store_byte(3, 0, 5)
    a.vm_cbz(5, "_rt_cw2_copied")
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_cw2_copy")
    a.label("_rt_cw2_copied")
    // At most one argument per input byte. This bounded command-line buffer
    // upper bound includes empty quoted arguments without a second parser.
    a.load(18, 15, -88)
    a.vm_add_imm(18, 18, 1)
    a.vm_mov_imm(1, 24)
    a.mul(18, 18, 1)
    a.call("_rt_alloc")
    a.store(15, -32, 14)
    a.vm_mov_imm(0, 0)
    a.store(15, -24, 0) // input position
    a.store(15, -96, 0) // output position
    a.store(15, -72, 0) // argc
    a.label("_rt_cw2_outer")
    a.load(2, 15, -8)
    a.load(3, 15, -24)
    a.add(2, 2, 3)
    a.load_byte(5, 2, 0)
    a.vm_cbz(5, "_rt_cw2_done")
    a.vm_cmp_imm(5, 32)
    a.jeq("_rt_cw2_skip")
    a.vm_cmp_imm(5, 9)
    a.jeq("_rt_cw2_skip")
    a.load(0, 15, -96)
    a.store(15, -40, 0)
    a.vm_mov_imm(0, 0)
    a.store(15, -56, 0)
    a.jmp("_rt_cw2_arg")
    a.label("_rt_cw2_skip")
    a.vm_add_imm(3, 3, 1)
    a.store(15, -24, 3)
    a.jmp("_rt_cw2_outer")
    a.label("_rt_cw2_arg")
    a.load(2, 15, -8)
    a.load(3, 15, -24)
    a.add(2, 2, 3)
    a.load_byte(5, 2, 0)
    a.vm_cbz(5, "_rt_cw2_flush")
    a.vm_cmp_imm(5, 92)
    a.jne("_rt_cw2_parse_char")
    // argv[0] is a pathname: its backslashes stay literal.
    a.load(0, 15, -72)
    a.vm_cbz(0, "_rt_cw2_char")
    a.vm_mov_imm(0, 0)
    a.label("_rt_cw2_slashes")
    a.vm_add_imm(0, 0, 1)
    a.vm_add_imm(3, 3, 1)
    a.load(2, 15, -8)
    a.add(2, 2, 3)
    a.load_byte(5, 2, 0)
    a.vm_cmp_imm(5, 92)
    a.jeq("_rt_cw2_slashes")
    a.store(15, -24, 3)
    a.store(15, -104, 0)
    a.vm_cmp_imm(5, 34)
    a.jne("_rt_cw2_slashes_write")
    a.shr_imm(0, 0, 1)
    a.label("_rt_cw2_slashes_write")
    a.vm_cbz(0, "_rt_cw2_slashes_done")
    a.load(2, 15, -8)
    a.load(3, 15, -96)
    a.add(2, 2, 3)
    a.vm_mov_imm(1, 92)
    a.store_byte(2, 0, 1)
    a.vm_add_imm(3, 3, 1)
    a.store(15, -96, 3)
    a.vm_sub_imm(0, 0, 1)
    a.jmp("_rt_cw2_slashes_write")
    a.label("_rt_cw2_slashes_done")
    a.vm_cmp_imm(5, 34)
    a.jne("_rt_cw2_parse_char")
    a.load(0, 15, -104)
    a.vm_mov_imm(1, 1)
    a.iand(0, 0, 1)
    a.vm_cbnz(0, "_rt_cw2_char") // odd backslashes escape the quote
    a.label("_rt_cw2_parse_char")
    a.vm_cbz(5, "_rt_cw2_flush")
    a.vm_cmp_imm(5, 34)
    a.jeq("_rt_cw2_quote")
    a.load(0, 15, -56)
    a.vm_cbnz(0, "_rt_cw2_char")
    a.vm_cmp_imm(5, 32)
    a.jeq("_rt_cw2_flush")
    a.vm_cmp_imm(5, 9)
    a.jeq("_rt_cw2_flush")
    a.jmp("_rt_cw2_char")
    a.label("_rt_cw2_quote")
    a.load(0, 15, -56)
    a.vm_cbz(0, "_rt_cw2_quote_toggle")
    a.load(1, 15, -72)
    a.vm_cbz(1, "_rt_cw2_quote_toggle")
    a.load(2, 15, -8)
    a.load(3, 15, -24)
    a.add(2, 2, 3)
    a.load_byte(1, 2, 1)
    a.vm_cmp_imm(1, 34)
    a.jne("_rt_cw2_quote_toggle")
    // Two quotes inside a quoted argument represent a literal quote.
    a.vm_add_imm(3, 3, 1)
    a.store(15, -24, 3)
    a.jmp("_rt_cw2_char")
    a.label("_rt_cw2_quote_toggle")
    a.vm_mov_imm(1, 1)
    a.sub(0, 1, 0)
    a.store(15, -56, 0)
    a.jmp("_rt_cw2_next")
    a.label("_rt_cw2_char")
    a.load(2, 15, -8)
    a.load(3, 15, -96)
    a.add(2, 2, 3)
    a.store_byte(2, 0, 5)
    a.vm_add_imm(3, 3, 1)
    a.store(15, -96, 3)
    a.label("_rt_cw2_next")
    a.load(3, 15, -24)
    a.vm_add_imm(3, 3, 1)
    a.store(15, -24, 3)
    a.jmp("_rt_cw2_arg")
    a.label("_rt_cw2_flush")
    a.load(2, 15, -32)
    a.load(3, 15, -72)
    a.vm_mov_imm(0, 24)
    a.mul(3, 3, 0)
    a.add(2, 2, 3)
    a.load(1, 15, -8)
    a.load(4, 15, -40)
    a.add(1, 1, 4)
    a.store(2, 0, 1)
    a.load(1, 15, -96)
    a.sub(1, 1, 4)
    a.store(2, 8, 1)
    a.vm_mov_imm(1, 0)
    a.store(2, 16, 1)
    a.load(0, 15, -72)
    a.vm_add_imm(0, 0, 1)
    a.store(15, -72, 0)
    a.load(2, 15, -8)
    a.load(3, 15, -24)
    a.add(2, 2, 3)
    a.load_byte(5, 2, 0)
    a.vm_cbnz(5, "_rt_cw2_skip")
    a.label("_rt_cw2_done")
    a.lea(0, "_rt_argv_arr")
    a.load(1, 15, -32)
    a.store(0, 0, 1)
    a.load(1, 15, -72)
    a.store(0, 8, 1)
    a.store(0, 16, 1)
    a.epilogue()
    <<
}

