@main

#xu/types

// Bare-metal / Freestanding runtime glue (E1, E7, E8).
// Decouples chip-specific startup, clock setup, UART output, and interrupt handling
// from the hosted runtime.
//
// Supported boards / SoC profiles:
//   - ESP32 (Xtensa LX6, UART0 0x3FF40000, stack 0x3FFE0000)
//   - STM32F4 (ARM Cortex-M4, USART1/2, RCC clock setup, stack 0x20020000)
//   - MPS2 AN386 (ARM Cortex-M3/M4 QEMU, UART 0x40004000, stack 0x20008000)
//   - RISC-V Virt (QEMU virt, NS16550 UART 0x10000000, stack 0x87000000)

fn irq_slot(name string) int {
    if name.len < 5 { << -1 }
    if name[0] != 105 || name[1] != 114 || name[2] != 113 || name[3] != 95 { << -1 }
    $n := 0
    for i in 4:name.len {
        ch := name[i]
        if ch < 48 || ch > 57 { << -1 }
        n = n * 10 + (ch - 48)
    }
    if n >= 32 { << -1 }
    << n
}

// ===== Chip Profile: ESP32 (Xtensa LX6) =====

fn rt_bare_metal_boot_esp32(a $&Assembler) {
    // ESP32 stack top in DRAM: 0x3FFE0000
    a.vm_mov_imm(0, 1073610752)
}

fn rt_bare_metal_putc_esp32(a $&Assembler) {
    // ESP32 UART0: data at 0x3FF40000, status at 0x3FF4001C.
    // Poll TX FIFO count (bits 23:16) until < 100 before writing.
    a.label("_xu_putc_wait_tx")
    a.vm_mov_imm(0, 1072955420) // 0x3FF4001C (UART_STATUS_REG)
    a.load(1, 0, 0)
    a.shr_imm(1, 1, 16)
    a.vm_and_imm(1, 1, 255)
    a.vm_mov_imm(2, 100)
    a.cmp(1, 2)
    a.jge("_xu_putc_wait_tx")
    a.vm_mov_imm(0, 1072955392) // 0x3FF40000 (UART_FIFO_REG)
    a.store_byte(0, 0, 18)      // vreg 18 = A0 (character byte)
    a.vm_ret()
}

// ===== Chip Profile: STM32F4 (Cortex-M4) =====

fn rt_bare_metal_boot_stm32f4(a $&Assembler) {
    a.vm_mov_imm(0, 537001984) // 0x20020000 (128 KB SRAM top)
    a.mov(16, 0)
    a.lea(0, "_xu_heap_start")
    a.lea(1, "_rt_heap_cur")
    a.store(1, 0, 0)

    // STM32F4: enable GPIOA in RCC_AHB1ENR (0x40023830), USART2 in RCC_APB1ENR (0x40023840), USART1 in RCC_APB2ENR (0x40023844)
    a.vm_mov_imm(0, 1073887232) // 0x40023800 (RCC)
    a.vm_mov_imm(1, 1)          // GPIOAEN
    a.store(0, 48, 1)           // RCC_AHB1ENR (+0x30)
    a.vm_mov_imm(1, 131072)     // USART2EN (1 << 17)
    a.store(0, 64, 1)           // RCC_APB1ENR (+0x40)
    a.vm_mov_imm(1, 16)         // USART1EN (1 << 4)
    a.store(0, 68, 1)           // RCC_APB2ENR (+0x44)

    // USART1 (0x40011000): set BRR and CR1 (UE | TE)
    a.vm_mov_imm(0, 1073811456) // 0x40011000 (USART1)
    a.vm_mov_imm(1, 728)        // BRR (115200 @ 84MHz)
    a.store(0, 8, 1)            // USART_BRR (+0x08)
    a.vm_mov_imm(1, 8200)       // CR1: UE (bit 13) | TE (bit 3) = 0x2008
    a.store(0, 12, 1)           // USART_CR1 (+0x0C)

    // USART2 (0x40004400): set BRR and CR1 (UE | TE)
    a.vm_mov_imm(0, 1073759232) // 0x40004400 (USART2)
    a.vm_mov_imm(1, 364)        // BRR (115200 @ 42MHz)
    a.store(0, 8, 1)            // USART_BRR (+0x08)
    a.vm_mov_imm(1, 8200)       // CR1: UE (bit 13) | TE (bit 3) = 0x2008
    a.store(0, 12, 1)           // USART_CR1 (+0x0C)
}

fn rt_bare_metal_putc_stm32f4(a $&Assembler) {
    // STM32F4 USART1 at 0x40011000 (QEMU default serial_hd(0))
    a.vm_mov_imm(0, 1073811456)
    a.label("_xu_putc_wait_f4_u1")
    a.load(1, 0, 0)
    a.vm_mov_imm(2, 128)
    a.iand(1, 1, 2)
    a.vm_cbz(1, "_xu_putc_wait_f4_u1")
    a.store_byte(0, 4, 18)

    // STM32F4 USART2 at 0x40004400 (ST-LINK VCP / serial_hd(1))
    a.vm_mov_imm(0, 1073759232)
    a.label("_xu_putc_wait_f4_u2")
    a.load(1, 0, 0)
    a.vm_mov_imm(2, 128)
    a.iand(1, 1, 2)
    a.vm_cbz(1, "_xu_putc_wait_f4_u2")
    a.store_byte(0, 4, 18)
    a.vm_ret()
}

// ===== Chip Profile: MPS2 AN386 (Cortex-M) =====

fn rt_bare_metal_boot_mps2(a $&Assembler) {
    a.vm_mov_imm(0, 536903680) // 0x20008000 (MPS2 stack top)
    a.mov(16, 0)
    a.lea(0, "_xu_heap_start")
    a.lea(1, "_rt_heap_cur")
    a.store(1, 0, 0)

    // MPS2 UART0 init (0x40004000)
    a.vm_mov_imm(0, 1073758208)
    a.vm_mov_imm(1, 16)
    a.store(0, 16, 1)
    a.vm_mov_imm(1, 1)
    a.store(0, 8, 1)
}

fn rt_bare_metal_putc_mps2(a $&Assembler) {
    a.vm_mov_imm(0, 1073758208)
    a.label("_xu_putc_wait")
    a.load(1, 0, 4)
    a.vm_mov_imm(2, 2)
    a.iand(1, 1, 2)
    a.vm_cbnz(1, "_xu_putc_wait")
    a.store_byte(0, 0, 18)
    a.vm_ret()
}

// ===== Chip Profile: RISC-V Virt =====

fn rt_bare_metal_boot_riscv_virt(a $&Assembler) {
    a.vm_mov_imm(0, 2264924160) // 0x87000000 stack top
    a.mov(16, 0)
    a.lea(0, "_xu_heap_start")
    a.lea(1, "_rt_heap_cur")
    a.store(1, 0, 0)
}

fn rt_bare_metal_putc_riscv_virt(a $&Assembler) {
    // NS16550 at 0x10000000 (QEMU virt)
    a.vm_mov_imm(0, 268435456)
    a.store_byte(0, 0, 18)
    a.vm_ret()
}

// ===== Bare-Metal Glue Entry Point =====

fn rt_emit_bare_metal_glue(a $&Assembler, m &types.Mir, pump_idle int) {
    if a.arch == 7 { a.align_code(4) }
    a.label("_reset")

    // Dispatch boot / stack setup per SoC profile
    if a.arch == 7 {
        rt_bare_metal_boot_esp32(a)
        a.mov(16, 0)
        // The call0 Xu stack must also supply the windowed ABI's base and
        // extra save areas before calling mask ROM. See IDF SET_STACK.
        a.xt_addi(1, 1, -48)
        a.xt_addi(9, 1, -12)
        a.xt_s32i(8, 9, 0)
        // Discard bootloader register windows; keep only this window live.
        a.xt_rsr(8, 230) // PS
        a.xt_mov_imm32(9, 0xFFF8F0FF) // ~(WOE | OWB | CALLINC)
        a.xt_and(8, 8, 9)
        a.xt_wsr(8, 230)
        a.xt_rsync()
        a.xt_rsr(9, 72) // WINDOWBASE
        a.xt_ssl(9)
        a.xt_movi(8, 1)
        a.xt_sll(8, 8)
        a.xt_wsr(8, 73) // WINDOWSTART
        a.xt_mov_imm32(8, 0x40000000)
        a.xt_wsr(8, 231) // VECBASE: mask-ROM overflow/underflow vectors
        a.xt_rsync()
        a.xt_rsr(8, 230)
        a.xt_mov_imm32(9, 0x40000)
        a.xt_or(8, 8, 9)
        a.xt_wsr(8, 230)
        a.xt_rsync()
        if !a.reloc_obj {
            a.lea(0, "_xu_heap_start")
            a.lea(1, "_rt_heap_cur")
            a.store(1, 0, 0)
        }
    } else if a.arch == 3 {
        rt_bare_metal_boot_riscv_virt(a)
    } else {
        if a.board == "stm32f4" {
            rt_bare_metal_boot_stm32f4(a)
        } else {
            rt_bare_metal_boot_mps2(a)
        }
    }

    // Register user IRQ handlers
    for fi in 0:m.fns.len {
        if types.mir_fn_is_extern(m, fi) { -> }
        nm := m.fns[fi].name
        slot := irq_slot(nm)
        if slot >= 0 {
            a.lea(0, types.mir_fn_label(m, fi))
            a.lea(1, "_xu_irq_tab")
            a.store(1, slot * 4, 0)
        }
    }

    // Call user main
    if a.arch == 7 {
        // Startup is emitted after the runtime. A complete BLE host can
        // place main beyond CALL0's +/-512 KiB displacement from here.
        // Resolve this one entry call absolutely without changing normal
        // Xu calls or the call0 stack/window contract.
        a.xt_lea_abs(11, "_xu_main")
        a.xt_callx0(11)
    } else {
        a.call("_xu_main")
    }

    if a.arch == 7 { a.align_code(4) }
    a.label("_rt_exit")
    if pump_idle == 1 {
        a.call("_rt_xu_pump")
    }
    a.halt()
    a.jmp("_rt_exit")

    // Console output dispatch per SoC profile
    if a.arch == 7 { a.align_code(4) }
    a.label("_xu_putc")
    if a.arch == 7 {
        rt_bare_metal_putc_esp32(a)
    } else if a.arch == 3 {
        rt_bare_metal_putc_riscv_virt(a)
    } else {
        if a.board == "stm32f4" {
            rt_bare_metal_putc_stm32f4(a)
        } else {
            rt_bare_metal_putc_mps2(a)
        }
    }

    // Generic Interrupt Vector Table and ISR Dispatcher
    a.align_data(4)
    a.data_label("_xu_irq_tab")
    rt_emit_zeros(a, 128)
    if a.arch == 7 { a.align_code(4) }
    a.label("_xu_raise_irq")
    a.vm_cmp_imm(18, 0)
    a.jlt("_xu_irq_skip")
    a.vm_cmp_imm(18, 32)
    a.jge("_xu_irq_skip")
    a.lea(0, "_xu_irq_tab")
    a.shl_imm(1, 18, 2)
    a.add(0, 0, 1)
    a.load(0, 0, 0)
    a.vm_cbz(0, "_xu_irq_skip")
    a.call_reg(0)
    a.label("_xu_irq_skip")
    a.vm_ret()

    if a.arch == 7 { a.align_code(4) }
    a.label("_xu_isr")
    a.read_ipsr(18)
    a.call("_xu_raise_irq")
    a.vm_ret()

    if a.arch == 7 { rt_emit_xtensa_rom_window_spill(a) }

    // Relocatable objects are entered from a host C runtime (ESP-IDF), which
    // never runs _reset. Windowed `void xu_rt_init(void *heap)` takes a
    // 64 KiB, 8-aligned heap that must stay valid for the object's lifetime.
    if a.arch == 7 && a.reloc_obj {
        a.align_code(4)
        a.label("xu_rt_init")
        a.xt_emit24(0x004136) // entry a1,32
        a.xt_lea_abs(9, "_xu_heap_base")
        a.xt_s32i(2, 9, 0)
        a.xt_lea_abs(9, "_rt_heap_cur")
        a.xt_s32i(2, 9, 0)
        a.xt_emit16(0xF01D) // retw.n
    }
}
