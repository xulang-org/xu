// `_rt_setsockopt_timeo`: A0=fd, A1=relative ns; SO_SNDTIMEO+SO_RCVTIMEO.
// ns<=0 clears (timeval 0). Minimum positive is 1 usec.
fn rt_emit_setsockopt_timeo(a &mut Assembler) {
    a.label("_rt_setsockopt_timeo")
    // sret -8, fd -16, ns -24, timeval [fp-48, fp-32).
    a.prologue(64)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    if a.os == 2 {
        a.call("_rt_ws2_init")
        a.vm_cmp_imm(14, 0)
        a.jne("_rt_sto_wfail")
        a.vm_mov_imm(1, 0)
        a.load(2, 15, -24)
        a.vm_cmp_imm(2, 0)
        a.jle("_rt_sto_wset")
        a.vm_mov_imm(3, time_ns_per_millisecond)
        a.div(1, 2, 3)
        a.vm_cmp_imm(1, 0)
        a.jne("_rt_sto_wset")
        a.vm_mov_imm(1, 1)
        a.label("_rt_sto_wset")
        a.store(15, -48, 1)
        a.load(18, 15, -16)
        a.vm_mov_imm(19, 65535)
        a.vm_mov_imm(20, 4101)
        a.mov(21, 15)
        a.vm_sub_imm(21, 21, 48)
        a.vm_mov_imm(22, 4)
        rt_ws2_call(a, 88)
        a.load(18, 15, -16)
        a.vm_mov_imm(19, 65535)
        a.vm_mov_imm(20, 4102)
        a.mov(21, 15)
        a.vm_sub_imm(21, 21, 48)
        a.vm_mov_imm(22, 4)
        rt_ws2_call(a, 88)
        a.vm_mov_imm(14, 0)
        rt_net_win_ok_fd(a)
        a.label("_rt_sto_wfail")
        rt_net_win_throw(a)
        <<
    }
    a.vm_mov_imm(1, 0)
    a.store(15, -48, 1)
    a.store(15, -40, 1)
    a.load(1, 15, -24)
    a.vm_cmp_imm(1, 0)
    a.jle("_rt_sto_set")
    a.vm_mov_imm(2, time_ns_per_second)
    a.div(3, 1, 2)
    a.imod(4, 1, 2)
    a.vm_mov_imm(2, time_ns_per_microsecond)
    a.div(4, 4, 2)
    a.vm_cmp_imm(3, 0)
    a.jne("_rt_sto_store")
    a.vm_cmp_imm(4, 0)
    a.jne("_rt_sto_store")
    a.vm_mov_imm(4, 1)
    a.label("_rt_sto_store")
    a.store(15, -48, 3)
    a.store(15, -40, 4)
    a.label("_rt_sto_set")
    a.load(18, 15, -16)
    if a.os == 0 {
        a.vm_mov_imm(19, 65535)
        a.vm_mov_imm(20, 4101)
    } else {
        a.vm_mov_imm(19, 1)
        a.vm_mov_imm(20, 21)
    }
    a.mov(21, 15)
    a.vm_sub_imm(21, 21, 48)
    a.vm_mov_imm(22, 16)
    a.vm_syscall(syscall_number(a.os, a.arch, 30))
    a.vm_normalize_syscall("_rt_sto_n0")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_sto_err")
    a.load(18, 15, -16)
    if a.os == 0 {
        a.vm_mov_imm(19, 65535)
        a.vm_mov_imm(20, 4102)
    } else {
        a.vm_mov_imm(19, 1)
        a.vm_mov_imm(20, 20)
    }
    a.mov(21, 15)
    a.vm_sub_imm(21, 21, 48)
    a.vm_mov_imm(22, 16)
    a.vm_syscall(syscall_number(a.os, a.arch, 30))
    a.vm_normalize_syscall("_rt_sto_n1")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_sto_err")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 1)
    a.epilogue()
    a.label("_rt_sto_err")
    a.neg(18, 14)
    a.call("_rt_errno_msg")
    rt_call_throw_strerr_args(a, -8)
    a.epilogue()
    <<
}

// `_rt_udp_sendto`: A0=fd, A1/A2=packed addr (ptr,len=6), A3/A4=data; sret throw.
fn rt_emit_udp_sendto(a &mut Assembler) {
    a.label("_rt_udp_sendto")
    // sret -8, fd -16, addr ptr/len -24/-32, data ptr/len -40/-48,
    // sockaddr [fp-80, fp-64).
    a.prologue(96)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.store(15, -32, 20)
    a.store(15, -40, 21)
    a.store(15, -48, 22)
    if a.os == 2 {
        a.call("_rt_ws2_init")
        a.vm_cmp_imm(14, 0)
        a.jne("_rt_us_wfail")
    }
    a.load(1, 15, -32)
    a.vm_cmp_imm(1, 6)
    a.jne("_rt_us_bad")
    a.mov(4, 15)
    a.vm_sub_imm(4, 4, 80)
    a.vm_mov_imm(1, 0)
    for i in 0:16 {
        a.store_byte(4, i, 1)
    }
    if a.os == 0 {
        a.vm_mov_imm(1, 16)
        a.store_byte(4, 0, 1) // sin_len
        a.vm_mov_imm(1, 2)
        a.store_byte(4, 1, 1) // AF_INET
    } else {
        a.vm_mov_imm(1, 2)
        a.store_byte(4, 0, 1)
        a.vm_mov_imm(1, 0)
        a.store_byte(4, 1, 1)
    }
    a.load(3, 15, -24) // packed addr ptr
    a.load_byte(1, 3, 0)
    a.store_byte(4, 4, 1)
    a.load_byte(1, 3, 1)
    a.store_byte(4, 5, 1)
    a.load_byte(1, 3, 2)
    a.store_byte(4, 6, 1)
    a.load_byte(1, 3, 3)
    a.store_byte(4, 7, 1)
    a.load_byte(1, 3, 4)
    a.store_byte(4, 2, 1) // port BE hi
    a.load_byte(1, 3, 5)
    a.store_byte(4, 3, 1) // port BE lo
    a.load(18, 15, -16)
    a.load(19, 15, -40)
    a.load(20, 15, -48)
    a.vm_mov_imm(21, 0) // flags
    a.mov(22, 4)        // &sa
    a.vm_mov_imm(23, 16)
    if a.os == 2 {
        rt_ws2_call6(a, 64)
        a.vm_cmp_imm(14, -1)
        a.jeq("_rt_us_wfail")
        rt_net_win_ok_fd(a)
        a.label("_rt_us_wfail")
        rt_net_win_throw(a)
        a.label("_rt_us_bad")
        rt_call_throw_strerr_static(a, -8, "_rt_net_bad_msg", 5)
        a.epilogue()
        <<
    }
    a.vm_syscall(syscall_number(a.os, a.arch, 31))
    a.vm_normalize_syscall("_rt_us_n")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_us_err")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 14) // Ok(n)
    a.epilogue()
    a.label("_rt_us_err")
    a.neg(18, 14)
    a.call("_rt_errno_msg")
    rt_call_throw_strerr_args(a, -8)
    a.epilogue()
    a.label("_rt_us_bad")
    rt_call_throw_strerr_static(a, -8, "_rt_net_bad_msg", 5)
    a.epilogue()
    <<
}

fn rt_emit_udp_recv_pack(a &mut Assembler) {
    a.store(15, -40, 14) // n
    a.load(3, 15, -32)
    a.mov(4, 15)
    a.vm_sub_imm(4, 4, 80)
    a.load_byte(1, 4, 4)
    a.store_byte(3, 0, 1)
    a.load_byte(1, 4, 5)
    a.store_byte(3, 1, 1)
    a.load_byte(1, 4, 6)
    a.store_byte(3, 2, 1)
    a.load_byte(1, 4, 7)
    a.store_byte(3, 3, 1)
    a.load_byte(1, 4, 2)
    a.store_byte(3, 4, 1)
    a.load_byte(1, 4, 3)
    a.store_byte(3, 5, 1)
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.load(1, 15, -32)
    a.store(0, -8, 1) // ptr
    a.load(1, 15, -40)
    a.vm_add_imm(1, 1, 6)
    a.store(0, -16, 1) // len = n + 6
    a.load(1, 15, -24)
    a.vm_add_imm(1, 1, 6)
    a.store(0, -24, 1) // cap = max + 6
    a.epilogue()
    <<
}

// `_rt_udp_recvfrom`: A0=fd, A1=max; Ok string = IP4 + BE port + payload.
fn rt_emit_udp_recvfrom(a &mut Assembler) {
    a.label("_rt_udp_recvfrom")
    // sret -8, fd -16, max -24, buf -32, n -40, addrlen -48,
    // sockaddr [fp-80, fp-64).
    a.prologue(96)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    if a.os == 2 {
        a.call("_rt_ws2_init")
        a.vm_cmp_imm(14, 0)
        a.jne("_rt_ur_winit")
    }
    if a.os != 2 {
        a.call("_rt_enter_syscall")
    }
    a.load(1, 15, -24)
    a.vm_cmp_imm(1, 0)
    a.jle("_rt_ur_bad")
    a.vm_add_imm(18, 1, 6) // alloc(max + 6)
    a.call("_rt_alloc")
    a.store(15, -32, 14)
    a.vm_mov_imm(1, 16)
    a.store(15, -48, 1) // addrlen = 16
    a.load(18, 15, -16)
    a.load(19, 15, -32)
    a.vm_add_imm(19, 19, 6) // payload starts after header
    a.load(20, 15, -24)
    a.vm_mov_imm(21, 0) // flags
    a.mov(22, 15)
    a.vm_sub_imm(22, 22, 80) // &sa
    a.mov(23, 15)
    a.vm_sub_imm(23, 23, 48) // &addrlen
    if a.os == 2 {
        rt_ws2_call6(a, 72)
        a.vm_cmp_imm(14, -1)
        a.jeq("_rt_ur_wfail")
        rt_emit_udp_recv_pack(a)
        a.label("_rt_ur_wfail")
        a.load(18, 15, -32)
        a.call("_rt_free")
        rt_net_win_throw(a)
        a.label("_rt_ur_winit")
        rt_net_win_throw(a)
        a.label("_rt_ur_bad")
        rt_call_throw_strerr_static(a, -8, "_rt_net_bad_msg", 5)
        a.epilogue()
        <<
    }
    a.vm_syscall(syscall_number(a.os, a.arch, 32))
    a.vm_normalize_syscall("_rt_ur_n")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_ur_fail")
    a.label("_rt_ur_pack")
    rt_emit_udp_recv_pack(a)

    a.label("_rt_ur_fail")
    a.store(15, -40, 14)
    a.load(18, 15, -32)
    a.call("_rt_free")
    a.load(14, 15, -40)
    a.neg(18, 14)
    a.call("_rt_errno_msg")
    rt_call_throw_strerr_args(a, -8)
    a.epilogue()

    a.label("_rt_ur_bad")
    rt_call_throw_strerr_static(a, -8, "_rt_net_bad_msg", 5)
    a.epilogue()
    <<
}

