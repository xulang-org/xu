    a.neg(18, 14)
    a.call("_rt_errno_msg")
    rt_call_throw_strerr_args(a, -8)
    a.epilogue()
    <<
}

// `_rt_conn_read`: A0 = fd, A1 = max; V0/X8 = sret throw slot.
fn rt_emit_conn_read(a &mut Assembler) {
    a.label("_rt_conn_read")
    // sret -8, fd -16, max -24, buf -32, n -40.
    a.prologue(48)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    if a.os == 2 {
        a.call("_rt_ws2_init")
        a.vm_cmp_imm(14, 0)
        a.jne("_rt_cr_wfail")
        a.load(1, 15, -24)
        a.vm_cmp_imm(1, 0)
        a.jle("_rt_cr_bad")
        a.mov(18, 1)
        a.call("_rt_alloc")
        a.store(15, -32, 14)
        a.load(18, 15, -16)
        a.load(19, 15, -32)
        a.load(20, 15, -24)
        a.vm_mov_imm(21, 0)
        rt_ws2_call(a, 56)
        a.vm_cmp_imm(14, -1)
        a.jeq("_rt_cr_wfailf")
        a.store(15, -40, 14)
        a.load(0, 15, -8)
        a.vm_mov_imm(1, 0)
        a.store(0, 0, 1)
        a.load(1, 15, -32)
        a.store(0, -8, 1)
        a.load(1, 15, -40)
        a.store(0, -16, 1)
        a.load(1, 15, -24)
        a.store(0, -24, 1)
        a.epilogue()
        a.label("_rt_cr_wfailf")
        a.load(18, 15, -32)
        a.call("_rt_free")
        a.label("_rt_cr_wfail")
        rt_net_win_throw(a)
        a.label("_rt_cr_bad")
        rt_call_throw_strerr_static(a, -8, "_rt_net_bad_msg", 5)
        a.epilogue()
        <<
    }
    a.call("_rt_enter_syscall")
    a.load(1, 15, -24)
    a.vm_cmp_imm(1, 0)
    a.jle("_rt_cr_bad")
    a.mov(18, 1)
    a.call("_rt_alloc")
    a.store(15, -32, 14)
    a.load(18, 15, -16)
    a.load(19, 15, -32)
    a.load(20, 15, -24)
    a.vm_syscall(syscall_number(a.os, a.arch, 5))
    a.vm_normalize_syscall("_rt_cr_n")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_cr_fail")
    // Ok(string): even n==0 (peer closed) is Ok("").
    a.store(15, -40, 14) // n
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.load(1, 15, -32)
    a.store(0, -8, 1) // ptr
    a.load(1, 15, -40)
    a.store(0, -16, 1) // len = n
    a.load(1, 15, -24)
    a.store(0, -24, 1) // cap = max
    a.epilogue()

    a.label("_rt_cr_fail")
    a.store(15, -40, 14)
    a.load(18, 15, -32)
    a.call("_rt_free")
    a.load(14, 15, -40)
    a.neg(18, 14)
    a.call("_rt_errno_msg")
    rt_call_throw_strerr_args(a, -8)
    a.epilogue()

    a.label("_rt_cr_bad")
    rt_call_throw_strerr_static(a, -8, "_rt_net_bad_msg", 5)
    a.epilogue()
    <<
}

fn rt_iocp_gpa(a &mut Assembler, dll_off int, name string, fp_off int, fail string) {
    a.load(18, 15, dll_off)
    a.lea(19, name)
    a.vm_call_iat("_iat_GetProcAddress")
    a.vm_cbz(14, fail)
    a.lea(0, "_rt_iocp_fp")
    a.store(0, fp_off, 14)
    <<
}

fn rt_iocp_call6(a &mut Assembler, fp_off int) {
    a.lea(1, "_rt_iocp_fp")
    a.load(1, 1, fp_off)
    a.vm_call_win_fp6(1)
    <<
}

fn rt_iocp_call7(a &mut Assembler, fp_off int, arg7 int) {
    a.lea(1, "_rt_iocp_fp")
    a.load(1, 1, fp_off)
    a.vm_call_win_fp7_arg(1, arg7)
    <<
}

// Resolve kernel32's IOCP entry points and create one process-wide port.
fn rt_emit_iocp_init(a &mut Assembler) {
    a.label("_rt_iocp_init")
    a.prologue(80)
    a.lea(0, "_rt_iocp_unsupported")
    a.load(1, 0, 0)
    a.vm_cbnz(1, "_rt_iocp_unsupported_fail")
    a.lea(0, "_rt_iocp_ready")
    a.load(1, 0, 0)
    a.vm_cbnz(1, "_rt_iocp_ok")
    // ProcessSocketNotifications is a Winsock API. Keep its availability
    // independent from the ordinary socket table so old Windows builds keep
    // working for sockets while readiness reports explicit unsupported.
    a.call("_rt_ws2_init")
    a.vm_cmp_imm(14, 0)
    a.jne("_rt_iocp_fail")
    a.lea(18, "_rt_ws2_dll")
    a.vm_call_iat("_iat_LoadLibraryA")
    a.vm_cbz(14, "_rt_iocp_fail")
    a.store(15, -16, 14)
    a.lea(18, "_rt_iocp_dll")
    a.vm_call_iat("_iat_LoadLibraryA")
    a.vm_cbz(14, "_rt_iocp_fail")
    a.store(15, -8, 14)
    rt_iocp_gpa(a, -8, "_rt_iocp_n_create", 0, "_rt_iocp_fail")
    rt_iocp_gpa(a, -8, "_rt_iocp_n_get", 8, "_rt_iocp_fail")
    rt_iocp_gpa(a, -8, "_rt_iocp_n_cancel", 16, "_rt_iocp_fail")
    rt_iocp_gpa(a, -16, "_rt_ws2_n_process_notifications", 24, "_rt_iocp_process_missing")
    // INVALID_HANDLE_VALUE, NULL existing port, NULL key, no thread limit.
    a.vm_mov_imm(18, -1)
    a.vm_mov_imm(19, 0)
    a.vm_mov_imm(20, 0)
    a.vm_mov_imm(21, 0)
    rt_iocp_call6(a, 0)
    a.vm_cmp_imm(14, 0)
    a.jeq("_rt_iocp_fail")
    a.lea(0, "_rt_iocp_port")
    a.store(0, 0, 14)
    a.lea(0, "_rt_iocp_ready")
    a.vm_mov_imm(1, 1)
    a.store(0, 0, 1)
    a.label("_rt_iocp_ok")
    a.lea(0, "_rt_iocp_port")
    a.load(14, 0, 0)
    a.epilogue()
    a.label("_rt_iocp_process_missing")
    a.lea(0, "_rt_iocp_unsupported")
    a.vm_mov_imm(1, 1)
    a.store(0, 0, 1)
    a.jmp("_rt_iocp_fail")
    a.label("_rt_iocp_unsupported_fail")
    a.vm_mov_imm(14, -2)
    a.epilogue()
    a.label("_rt_iocp_fail")
    a.vm_mov_imm(14, -1)
    a.epilogue()
    <<
}

// Register one socket-state notification, dequeue the matching IOCP packet,
// and remove the registration before the stack frame goes away. This uses
// the non-consuming Winsock readiness API rather than fake zero-byte I/O.
fn rt_emit_iocp_wait(a &mut Assembler) {
    a.label("_rt_iocp_wait")
    // fd -16, events -24, timeout_ms -32, port -40;
    // SOCK_NOTIFY_REGISTRATION -64..-88, OVERLAPPED_ENTRY -96..-128,
    // received count -136, returned event mask -144.
    a.prologue(176)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.store(15, -32, 20)
    a.call("_rt_iocp_init")
    a.vm_cmp_imm(14, -2)
    a.jeq("_rt_iocp_wait_unsupported")
    a.vm_cmp_imm(14, -1)
    a.jeq("_rt_iocp_wait_fail")
    a.store(15, -40, 14)

    // Zero registration and completion storage, then install a one-shot
    // level-triggered notification for the requested direction plus hangup.
    a.vm_mov_imm(1, 0)
    for i in 0:112 { a.store_byte(15, -64 - i, 1) }
    a.load(1, 15, -16)
    a.store(15, -64, 1) // socket
    a.store(15, -72, 1) // completionKey = socket
    a.load(1, 15, -24)
    a.vm_mov_imm(2, 4) // SOCK_NOTIFY_REGISTER_EVENT_HANGUP
    a.ior(1, 1, 2)
    a.store_byte(15, -48, 1) // eventFilter at registration +16
    a.vm_mov_imm(1, 1)
    a.store_byte(15, -46, 1) // operation ENABLE at +18
    a.vm_mov_imm(1, 5)
    a.store_byte(15, -45, 1) // ONESHOT | LEVEL at +19

    // ProcessSocketNotifications(port, 1, &registration, timeout, 1,
    // &entry, &receivedCount).
    a.load(18, 15, -40)
    a.vm_mov_imm(19, 1)
    a.mov(20, 15)
    a.vm_sub_imm(20, 20, 64)
    a.load(21, 15, -32)
    a.vm_mov_imm(22, 1)
    a.mov(23, 15)
    a.vm_sub_imm(23, 23, 96)
    a.mov(5, 15)
    a.vm_sub_imm(5, 5, 136)
    rt_iocp_call7(a, 24, 5)
    a.load(1, 15, -44) // registrationResult at +20
    a.vm_cmp_imm(1, 0)
    a.jne("_rt_iocp_wait_fail")
    a.vm_cmp_imm(14, 258) // WAIT_TIMEOUT
    a.jeq("_rt_iocp_wait_remove")
    a.vm_cmp_imm(14, 0)
    a.jne("_rt_iocp_wait_fail")
    a.load(1, 15, -136)
    a.vm_cmp_imm(1, 0)
    a.jeq("_rt_iocp_wait_remove")
    a.load(1, 15, -96)
    a.load(2, 15, -16)
    a.cmp(1, 2)
    a.jne("_rt_iocp_wait_remove")
    // OVERLAPPED_ENTRY.dwNumberOfBytesTransferred is at +24.
    a.load(2, 15, -72)
    a.store(15, -144, 2)
    a.jmp("_rt_iocp_wait_remove_result")

    a.label("_rt_iocp_wait_remove")
    a.vm_mov_imm(1, 4)
    a.store_byte(15, -46, 1) // operation REMOVE
    a.vm_mov_imm(1, 0)
    a.store_byte(15, -48, 1) // eventFilter = 0
    a.label("_rt_iocp_wait_remove_loop")
    a.load(18, 15, -40)
    a.vm_mov_imm(19, 1)
    a.mov(20, 15)
    a.vm_sub_imm(20, 20, 64)
    a.vm_mov_imm(21, -1) // INFINITE while waiting for REMOVE
    a.vm_mov_imm(22, 1)
    a.mov(23, 15)
    a.vm_sub_imm(23, 23, 96)
    a.mov(5, 15)
    a.vm_sub_imm(5, 5, 136)
    rt_iocp_call7(a, 24, 5)
    a.vm_cmp_imm(14, 0)
    a.jne("_rt_iocp_wait_fail")
    a.load(1, 15, -44) // registrationResult at +20
    a.vm_cmp_imm(1, 0)
    a.jne("_rt_iocp_wait_fail")
    a.load(1, 15, -136)
    a.vm_cmp_imm(1, 0)
    a.jeq("_rt_iocp_wait_remove_loop")
    a.load(1, 15, -72)
    a.vm_mov_imm(2, 128) // SOCK_NOTIFY_EVENT_REMOVE
    a.iand(3, 1, 2)
    a.vm_cbz(3, "_rt_iocp_wait_remove_loop")
    a.label("_rt_iocp_wait_remove_result")
    a.load(1, 15, -144)
    a.vm_cbz(1, "_rt_iocp_wait_timeout")
    a.vm_mov_imm(2, 1)
    a.iand(3, 1, 2)
    a.vm_cbz(3, "_rt_iocp_wait_no_read")
    a.vm_mov_imm(2, 1)
    a.store(15, -144, 2)
    a.label("_rt_iocp_wait_no_read")
    a.vm_mov_imm(2, 2)
    a.iand(3, 1, 2)
    a.vm_cbz(3, "_rt_iocp_wait_no_write")
    a.vm_mov_imm(2, 2)
    a.ior(1, 1, 2)
    a.label("_rt_iocp_wait_no_write")
    a.vm_mov_imm(2, 4)
    a.iand(3, 1, 2)
    a.vm_cbz(3, "_rt_iocp_wait_no_hangup")
    a.vm_mov_imm(2, 8)
    a.ior(1, 1, 2)
    a.label("_rt_iocp_wait_no_hangup")
    a.vm_mov_imm(2, 64)
    a.iand(3, 1, 2)
    a.vm_cbz(3, "_rt_iocp_wait_done_mask")
    a.vm_mov_imm(2, 4)
    a.ior(1, 1, 2)
    a.label("_rt_iocp_wait_done_mask")
    a.mov(14, 1)
    a.epilogue()
    a.label("_rt_iocp_wait_timeout")
    a.vm_mov_imm(14, 0)
    a.epilogue()
    a.label("_rt_iocp_wait_unsupported")
    a.vm_mov_imm(14, -2)
    a.epilogue()
    a.label("_rt_iocp_wait_fail")
    a.vm_mov_imm(14, -1)
    a.epilogue()
    <<
}

// Linux only: walk envp -> auxv for AT_PAGESZ (type 6). No-op elsewhere.

// `_rt_socket_wait`: one-shot descriptor readiness using the native kernel
// multiplexer. Linux uses epoll_ctl+epoll_wait; Darwin uses kqueue+kevent.
// A fresh kernel object is intentionally used for this low-level primitive so
// callers can safely use it without sharing hidden runtime state. Poller keeps
// the registration table and can issue one call per descriptor.
// A0=sret, A1=fd, A2=event mask (read=1, write=2), A3=timeout ns.
fn rt_emit_socket_wait(a &mut Assembler) {
    a.label("_rt_socket_wait")
    a.prologue(256)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.store(15, -32, 20)
    if a.os == 1 {
        // epoll_create1(0)
        a.call("_rt_enter_syscall")
        a.vm_mov_imm(18, 0)
        a.vm_syscall(syscall_number(a.os, a.arch, 48))
        a.vm_normalize_syscall("_rt_sw_ec")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_sw_err")
        a.store(15, -40, 14)

        // struct epoll_event is zeroed, then receives the requested flags and
        // fd in both possible data offsets (packed 32-bit and aligned 64-bit).
        a.mov(4, 15)
        a.vm_sub_imm(4, 4, 80)
        a.vm_mov_imm(1, 0)
        for i in 0:16 { a.store_byte(4, i, 1) }
        a.load(1, 15, -24)
        a.vm_mov_imm(2, 0)
        a.vm_mov_imm(3, 1)
        a.iand(4, 1, 3)
        a.vm_cbz(4, "_rt_sw_no_read")
        a.ior(2, 2, 3) // EPOLLIN
        a.label("_rt_sw_no_read")
        a.vm_mov_imm(3, 2)
        a.iand(4, 1, 3)
        a.vm_cbz(4, "_rt_sw_flags_done")
        a.vm_mov_imm(3, 4)
        a.ior(2, 2, 3) // EPOLLOUT
        a.label("_rt_sw_flags_done")
        a.mov(4, 15)
        a.vm_sub_imm(4, 4, 80)
        a.store(4, 0, 2)
        a.load(1, 15, -16)
        a.store(4, 4, 1)
        a.store(4, 8, 1)

        // epoll_ctl(epfd, EPOLL_CTL_ADD, fd, &event)
        a.load(18, 15, -40)
        a.vm_mov_imm(19, 1)
        a.load(20, 15, -16)
        a.mov(21, 4)
        a.vm_syscall(syscall_number(a.os, a.arch, 49))
        a.vm_normalize_syscall("_rt_sw_ctl")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_sw_close_err")

        // epoll_wait timeout is milliseconds; zero means an infinite wait in
        // this API, while positive values round up to preserve the deadline.
        a.load(1, 15, -32)
        a.vm_cmp_imm(1, 0)
        a.jlt("_rt_sw_ep_zero")
        a.jeq("_rt_sw_ep_inf")
        a.vm_mov_imm(2, time_ns_per_millisecond)
        a.div(3, 1, 2)
        a.imod(4, 1, 2)
        a.vm_cmp_imm(4, 0)
        a.jeq("_rt_sw_ep_ms")
        a.vm_add_imm(3, 3, 1)
        a.label("_rt_sw_ep_ms")
        a.store(15, -48, 3)
        a.jmp("_rt_sw_ep_wait")
        a.label("_rt_sw_ep_inf")
        a.vm_mov_imm(3, -1)
        a.store(15, -48, 3)
        a.jmp("_rt_sw_ep_wait")
        a.label("_rt_sw_ep_zero")
        a.vm_mov_imm(3, 0)
        a.store(15, -48, 3)
        a.label("_rt_sw_ep_wait")
        a.mov(4, 15)
        a.vm_sub_imm(4, 4, 112)
        a.vm_mov_imm(1, 0)
        for i in 0:16 { a.store_byte(4, i, 1) }
        a.load(18, 15, -40)
        a.mov(19, 4)
        a.vm_mov_imm(20, 1)
        a.load(21, 15, -48)
        // arm64/loong/riscv expose epoll_pwait at this slot; clear the
        // optional signal-mask arguments so it has epoll_wait semantics.
        if a.arch == 0 || a.arch == 4 || a.arch == 5 {
            a.vm_mov_imm(22, 0)
            a.vm_mov_imm(23, 0)
        }
        a.vm_syscall(syscall_number(a.os, a.arch, 50))
        a.vm_normalize_syscall("_rt_sw_wait")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_sw_close_err")
        a.store(15, -48, 14)
        // close(epfd)
        a.load(18, 15, -40)
        a.vm_syscall(syscall_number(a.os, a.arch, 6))
        a.load(1, 15, -48)
        a.vm_cmp_imm(1, 0)
        a.jeq("_rt_sw_linux_ok_zero")
        a.mov(4, 15)
        a.vm_sub_imm(4, 4, 112)
        a.load(1, 4, 0)
        a.vm_mov_imm(2, 0)
        a.vm_mov_imm(3, 1)
        a.iand(4, 1, 3)
        a.vm_cbz(4, "_rt_sw_ep_no_in")
        a.ior(2, 2, 3)
        a.label("_rt_sw_ep_no_in")
        a.vm_mov_imm(3, 2)
        a.iand(4, 1, 3)
        a.vm_cbz(4, "_rt_sw_ep_no_pri")
        a.ior(2, 2, 3)
        a.label("_rt_sw_ep_no_pri")
        a.vm_mov_imm(3, 4)
        a.iand(4, 1, 3)
        a.vm_cbz(4, "_rt_sw_ep_no_out")
        a.vm_mov_imm(3, 2)
        a.ior(2, 2, 3)
        a.label("_rt_sw_ep_no_out")
        a.vm_mov_imm(3, 8)
        a.iand(4, 1, 3)
        a.vm_cbz(4, "_rt_sw_ep_no_err")
        a.vm_mov_imm(3, 4)
        a.ior(2, 2, 3)
        a.label("_rt_sw_ep_no_err")
        a.vm_mov_imm(3, 16)
        a.iand(4, 1, 3)
        a.vm_cbz(4, "_rt_sw_ep_done")
        a.vm_mov_imm(3, 8)
        a.ior(2, 2, 3)
        a.label("_rt_sw_ep_done")
        a.mov(1, 2)
        a.jmp("_rt_sw_linux_ok")
        a.label("_rt_sw_linux_ok_zero")
        a.vm_mov_imm(1, 0)
        a.label("_rt_sw_linux_ok")
        a.load(0, 15, -8)
        a.vm_mov_imm(2, 0)
        a.store(0, 0, 2)
        a.store(0, -8, 1)
        a.epilogue()
        a.label("_rt_sw_close_err")
        a.load(18, 15, -40)
        a.vm_syscall(syscall_number(a.os, a.arch, 6))
        a.label("_rt_sw_err")
        a.neg(18, 14)
        a.call("_rt_errno_msg")
        rt_call_throw_strerr_args(a, -8)
        a.epilogue()
        <<
    }
    if a.os == 0 {
        // kqueue() and a single kevent registration. The kevent layout is
        // ident@0, filter@8, flags@10, fflags@12, data@16, udata@24.
        a.call("_rt_enter_syscall")
        a.vm_syscall(syscall_number(a.os, a.arch, 51))
        a.vm_normalize_syscall("_rt_sw_kq")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_sw_kq_err")
        a.store(15, -40, 14)
        a.mov(4, 15)
        a.vm_sub_imm(4, 4, 160)
        a.vm_mov_imm(1, 0)
        for i in 0:32 { a.store_byte(4, i, 1) }
        a.load(1, 15, -16)
        a.store(4, 0, 1)
        // Prefer read when both are requested; callers can issue a second
        // wait for write readiness.
        a.load(1, 15, -24)
        a.vm_mov_imm(2, 1)
        a.iand(3, 1, 2)
        a.vm_cbnz(3, "_rt_sw_kq_read")
        a.vm_mov_imm(2, 65534) // -2 in 16-bit filter field
        a.store_byte(4, 8, 254)
        a.store_byte(4, 9, 255)
        a.jmp("_rt_sw_kq_flags")
        a.label("_rt_sw_kq_read")
        a.store_byte(4, 8, 255)
        a.store_byte(4, 9, 255)
        a.label("_rt_sw_kq_flags")
        a.store_byte(4, 10, 5) // EV_ADD|EV_ENABLE
        a.mov(5, 15)
        a.vm_sub_imm(5, 5, 192)
        a.vm_mov_imm(1, 0)
        for i in 0:32 { a.store_byte(5, i, 1) }
        a.load(18, 15, -40)
        a.mov(19, 4)
        a.vm_mov_imm(20, 1)
        a.mov(21, 5)
        a.vm_mov_imm(22, 1)
        // timeout pointer is NULL for zero (infinite); otherwise timespec.
        a.load(1, 15, -32)
        a.vm_cmp_imm(1, 0)
        a.jlt("_rt_sw_kq_zero")
        a.jeq("_rt_sw_kq_inf")
        a.vm_mov_imm(2, time_ns_per_second)
        a.div(3, 1, 2)
        a.imod(4, 1, 2)
        a.mov(6, 15)
        a.vm_sub_imm(6, 6, 224)
        a.store(6, 0, 3)
        a.store(6, 8, 4)
        a.mov(23, 6)
        a.jmp("_rt_sw_kq_wait")
