@main

#xu/types

fn rt_emit_net_win_data(a &mut Assembler) {
    a.data_label("_rt_net_win_msg")
    rt_emit_bytes(a, "net: unsupported on windows")
    a.data_label("_rt_net_bad_msg")
    rt_emit_bytes(a, "error")
    a.data_label("_rt_net_unix_bad_msg")
    rt_emit_bytes(a, "net: invalid unix socket path")
    a.data_label("_rt_net_sock_msg")
    rt_emit_bytes(a, "net: socket error")
    a.data_label("_rt_net_iface_msg")
    rt_emit_bytes(a, "net: interface query failed")
    a.data_label("_rt_ws2_ready")
    rt_emit_zeros(a, 8)
    a.data_label("_rt_ws2_fp")
    rt_emit_zeros(a, 120)
    a.data_label("_rt_ws2_dll")
    rt_emit_bytes(a, "ws2_32.dll")
    a.emit_data([0])
    a.data_label("_rt_ws2_n_startup")
    rt_emit_bytes(a, "WSAStartup")
    a.emit_data([0])
    a.data_label("_rt_ws2_n_socket")
    rt_emit_bytes(a, "socket")
    a.emit_data([0])
    a.data_label("_rt_ws2_n_connect")
    rt_emit_bytes(a, "connect")
    a.emit_data([0])
    a.data_label("_rt_ws2_n_bind")
    rt_emit_bytes(a, "bind")
    a.emit_data([0])
    a.data_label("_rt_ws2_n_listen")
    rt_emit_bytes(a, "listen")
    a.emit_data([0])
    a.data_label("_rt_ws2_n_accept")
    rt_emit_bytes(a, "accept")
    a.emit_data([0])
    a.data_label("_rt_ws2_n_send")
    rt_emit_bytes(a, "send")
    a.emit_data([0])
    a.data_label("_rt_ws2_n_recv")
    rt_emit_bytes(a, "recv")
    a.emit_data([0])
    a.data_label("_rt_ws2_n_sendto")
    rt_emit_bytes(a, "sendto")
    a.emit_data([0])
    a.data_label("_rt_ws2_n_recvfrom")
    rt_emit_bytes(a, "recvfrom")
    a.emit_data([0])
    a.data_label("_rt_ws2_n_close")
    rt_emit_bytes(a, "closesocket")
    a.emit_data([0])
    a.data_label("_rt_ws2_n_poll")
    rt_emit_bytes(a, "WSAPoll")
    a.emit_data([0])
    a.data_label("_rt_ws2_n_setopt")
    rt_emit_bytes(a, "setsockopt")
    a.emit_data([0])
    a.data_label("_rt_ws2_n_recv_overlapped")
    rt_emit_bytes(a, "WSARecv")
    a.emit_data([0])
    a.data_label("_rt_ws2_n_send_overlapped")
    rt_emit_bytes(a, "WSASend")
    a.emit_data([0])
    a.data_label("_rt_ws2_n_process_notifications")
    rt_emit_bytes(a, "ProcessSocketNotifications")
    a.emit_data([0])
    a.data_label("_rt_iocp_ready")
    rt_emit_zeros(a, 8)
    a.data_label("_rt_iocp_fp")
    rt_emit_zeros(a, 32)
    a.data_label("_rt_iocp_port")
    rt_emit_zeros(a, 8)
    a.data_label("_rt_iocp_dll")
    rt_emit_bytes(a, "kernel32.dll")
    a.emit_data([0])
    a.data_label("_rt_iocp_n_create")
    rt_emit_bytes(a, "CreateIoCompletionPort")
    a.emit_data([0])
    a.data_label("_rt_iocp_n_get")
    rt_emit_bytes(a, "GetQueuedCompletionStatus")
    a.emit_data([0])
    a.data_label("_rt_iocp_n_cancel")
    rt_emit_bytes(a, "CancelIoEx")
    a.emit_data([0])
    a.data_label("_rt_iocp_unsupported")
    rt_emit_zeros(a, 8)
    a.data_label("_rt_if_win_ready")
    rt_emit_zeros(a, 8)
    a.data_label("_rt_if_win_fp")
    rt_emit_zeros(a, 8)
    a.data_label("_rt_if_win_dll")
    rt_emit_bytes(a, "iphlpapi.dll")
    a.emit_data([0])
    a.data_label("_rt_if_win_func")
    rt_emit_bytes(a, "GetAdaptersAddresses")
    a.emit_data([0])
    <<
}

fn rt_ws2_gpa(a &mut Assembler, dll_off int, name string, fp_off int, fail string) {
    a.load(18, 15, dll_off)
    a.lea(19, name)
    a.vm_call_iat("_iat_GetProcAddress")
    a.vm_cbz(14, fail)
    a.lea(0, "_rt_ws2_fp")
    a.store(0, fp_off, 14)
    <<
}

fn rt_ws2_call(a &mut Assembler, fp_off int) {
    a.lea(1, "_rt_ws2_fp")
    a.load(1, 1, fp_off)
    a.vm_call_win_fp(1)
    <<
}

fn rt_ws2_call6(a &mut Assembler, fp_off int) {
    a.lea(1, "_rt_ws2_fp")
    a.load(1, 1, fp_off)
    a.vm_call_win_fp6(1)
    <<
}

fn rt_ws2_call7(a &mut Assembler, fp_off int) {
    a.lea(1, "_rt_ws2_fp")
    a.load(1, 1, fp_off)
    a.vm_call_win_fp7(1)
    <<
}

fn rt_emit_ws2_init(a &mut Assembler) {
    a.label("_rt_ws2_init")
    a.prologue(528)
    a.lea(0, "_rt_ws2_ready")
    a.load(1, 0, 0)
    a.vm_cbnz(1, "_rt_ws2_ok")
    a.lea(18, "_rt_ws2_dll")
    a.vm_call_iat("_iat_LoadLibraryA")
    a.vm_cbz(14, "_rt_ws2_fail")
    a.store(15, -8, 14)
    rt_ws2_gpa(a, -8, "_rt_ws2_n_startup", 0, "_rt_ws2_fail")
    rt_ws2_gpa(a, -8, "_rt_ws2_n_socket", 8, "_rt_ws2_fail")
    rt_ws2_gpa(a, -8, "_rt_ws2_n_connect", 16, "_rt_ws2_fail")
    rt_ws2_gpa(a, -8, "_rt_ws2_n_bind", 24, "_rt_ws2_fail")
    rt_ws2_gpa(a, -8, "_rt_ws2_n_listen", 32, "_rt_ws2_fail")
    rt_ws2_gpa(a, -8, "_rt_ws2_n_accept", 40, "_rt_ws2_fail")
    rt_ws2_gpa(a, -8, "_rt_ws2_n_send", 48, "_rt_ws2_fail")
    rt_ws2_gpa(a, -8, "_rt_ws2_n_recv", 56, "_rt_ws2_fail")
    rt_ws2_gpa(a, -8, "_rt_ws2_n_sendto", 64, "_rt_ws2_fail")
    rt_ws2_gpa(a, -8, "_rt_ws2_n_recvfrom", 72, "_rt_ws2_fail")
    rt_ws2_gpa(a, -8, "_rt_ws2_n_close", 80, "_rt_ws2_fail")
    rt_ws2_gpa(a, -8, "_rt_ws2_n_setopt", 88, "_rt_ws2_fail")
    rt_ws2_gpa(a, -8, "_rt_ws2_n_poll", 96, "_rt_ws2_fail")
    rt_ws2_gpa(a, -8, "_rt_ws2_n_recv_overlapped", 104, "_rt_ws2_fail")
    rt_ws2_gpa(a, -8, "_rt_ws2_n_send_overlapped", 112, "_rt_ws2_fail")
    a.vm_mov_imm(18, 514)
    a.mov(19, 15)
    a.vm_sub_imm(19, 19, 528)
    rt_ws2_call(a, 0)
    a.vm_cmp_imm(14, 0)
    a.jne("_rt_ws2_fail")
    a.lea(0, "_rt_ws2_ready")
    a.vm_mov_imm(1, 1)
    a.store(0, 0, 1)
    a.label("_rt_ws2_ok")
    a.vm_mov_imm(14, 0)
    a.epilogue()
    a.label("_rt_ws2_fail")
    a.vm_mov_imm(14, -1)
    a.epilogue()
    <<
}

fn rt_net_win_throw(a &mut Assembler) {
    rt_call_throw_strerr_static(a, -8, "_rt_net_sock_msg", 17)
    a.epilogue()
    <<
}

fn rt_iface_store_u32(a &mut Assembler, off int, src int) {
    a.load(4, 15, -40)
    a.mov(2, src)
    for i in 0:4 {
        a.store_byte(4, off + i, 2)
        if i != 3 { a.shr_imm(2, 2, 8) }
    }
    <<
}

fn rt_iface_ok(a &mut Assembler, len_reg int, cap int) {
    a.load(0, 15, -8)
    a.vm_mov_imm(2, 0)
    a.store(0, 0, 2)
    a.load(2, 15, -40)
    a.store(0, -8, 2)
    a.store(0, -16, len_reg)
    a.vm_mov_imm(2, cap)
    a.store(0, -24, 2)
    a.epilogue()
    <<
}

fn rt_iface_flag(a &mut Assembler, mask int, public int, skip string) {
    // Gen1's arm64 logical-immediate encoder only handles low contiguous
    // masks; materialize arbitrary interface flag masks before ANDing.
    a.vm_mov_imm64(23, mask)
    a.iand(3, 1, 23)
    a.vm_cbz(3, skip + "")
    a.vm_add_imm(2, 2, public)
    a.label(skip)
    <<
}

// Darwin getifaddrs implementation.  struct ifaddrs uses the same 64-bit
// layout on arm64/x64: next/name/flags/addr/netmask/dstaddr/data at
// 0/8/16/24/32/40/48.
fn rt_emit_interface_data_macos(a &mut Assembler) {
    a.vm_mov_imm(1, 0)
    a.store(15, -32, 1)
    a.mov(18, 15)
    a.vm_sub_imm(18, 18, 32)
    a.vm_call_iat("_iat_getifaddrs")
    a.vm_cmp_imm(14, 0)
    a.jne("_rt_if_m_fail")
    a.load(0, 15, -24)
    a.vm_cmp_imm(0, 0)
    a.jeq("_rt_if_m_names")

    a.vm_mov_imm(18, 179)
    a.call("_rt_alloc")
    a.store(15, -40, 14)
    a.vm_mov_imm(1, 0)
    for i in 0:179 { a.store_byte(14, i, 1) }
    a.vm_mov_imm(1, 1)
    a.store_byte(14, 0, 1)
    a.vm_mov_imm(1, 35)
    a.store(15, -56, 1)
    a.load(0, 15, -32)
    a.store(15, -64, 0)
    a.label("_rt_if_m_loop")
    a.load(0, 15, -64)
    a.vm_cbz(0, "_rt_if_m_done")
    a.load(1, 0, 0)
    a.store(15, -72, 1)
    a.load(1, 0, 8)
    a.store(15, -80, 1)
    a.vm_cbz(1, "_rt_if_m_next")
    a.vm_mov_imm(2, 0)
    a.label("_rt_if_m_cmp")
    a.load(1, 15, -24)
    a.cmp(2, 1)
    a.jge("_rt_if_m_cmp_end")
    a.load(1, 15, -80)
    a.add(1, 1, 2)
    a.load_byte(3, 1, 0)
    a.load(1, 15, -16)
    a.add(1, 1, 2)
    a.load_byte(4, 1, 0)
    a.cmp(3, 4)
    a.jne("_rt_if_m_next")
    a.vm_cbz(3, "_rt_if_m_match")
    a.vm_add_imm(2, 2, 1)
    a.jmp("_rt_if_m_cmp")
    a.label("_rt_if_m_cmp_end")
    a.load(1, 15, -80)
    a.add(1, 1, 2)
    a.load_byte(3, 1, 0)
    a.vm_cbz(3, "_rt_if_m_match")
    a.jmp("_rt_if_m_next")

    a.label("_rt_if_m_match")
    a.load(0, 15, -64)
    a.load(1, 0, 16)
    a.vm_mov_imm(2, 0)
    rt_iface_flag(a, 1, 1, "_rt_if_m_flag_up")
    rt_iface_flag(a, 2, 2, "_rt_if_m_flag_broadcast")
    rt_iface_flag(a, 8, 4, "_rt_if_m_flag_loopback")
    rt_iface_flag(a, 16, 8, "_rt_if_m_flag_point")
    rt_iface_flag(a, rt_iface_multicast_flag, 16, "_rt_if_m_flag_multicast")
    rt_iface_flag(a, 64, 32, "_rt_if_m_flag_running")
    rt_iface_store_u32(a, 9, 2)
    a.load(1, 0, 48)
    a.vm_cbz(1, "_rt_if_m_addr")
    a.load(1, 1, 8)
    rt_iface_store_u32(a, 5, 1)

    a.label("_rt_if_m_addr")
    a.load(0, 15, -64)
    a.load(1, 0, 24)
    a.vm_cbz(1, "_rt_if_m_next")
    a.load_byte(2, 1, 1)
    a.vm_cmp_imm(2, 18)
    a.jeq("_rt_if_m_link")
    a.vm_cmp_imm(2, 2)
    a.jeq("_rt_if_m_ip4")
    a.vm_cmp_imm(2, 30)
    a.jeq("_rt_if_m_ip6")
    a.jmp("_rt_if_m_next")

    a.label("_rt_if_m_link")
    a.load(4, 15, -40)
    a.load_byte(2, 1, 2)
    a.load_byte(3, 1, 3)
    a.shl_imm(3, 3, 8)
    a.add(2, 2, 3)
    a.store_byte(4, 1, 2)
    a.shr_imm(2, 2, 8)
    a.store_byte(4, 2, 2)
    a.load_byte(2, 1, 6)
    a.vm_cmp_imm(2, 20)
    a.jgt("_rt_if_m_next")
    a.load_byte(3, 1, 5)
    a.vm_add_imm(3, 3, 8)
    a.add(3, 1, 3)
    a.vm_mov_imm(5, 0)
    a.label("_rt_if_m_hw")
    a.load_byte(1, 3, 0)
    a.load(4, 15, -40)
    a.add(4, 4, 5)
    a.store_byte(4, 14, 1)
    a.vm_add_imm(3, 3, 1)
    a.vm_add_imm(5, 5, 1)
    a.cmp(5, 2)
    a.jlt("_rt_if_m_hw")
    a.load(4, 15, -40)
    a.store_byte(4, 13, 2)
    a.jmp("_rt_if_m_next")

    a.label("_rt_if_m_ip4")
    a.vm_mov_imm(5, 4)
    a.vm_mov_imm(3, 4)
    a.jmp("_rt_if_m_ip")
    a.label("_rt_if_m_ip6")
    a.vm_mov_imm(5, 16)
    a.vm_mov_imm(3, 8)
    a.label("_rt_if_m_ip")
    a.load(4, 15, -40)
    a.load_byte(2, 4, 34)
    a.vm_cmp_imm(2, 8)
    a.jge("_rt_if_m_next")
    a.mov(1, 2)
    a.vm_mov_imm(2, 18)
    a.mul(1, 1, 2)
    a.vm_add_imm(1, 1, 35)
    a.add(1, 4, 1)
    a.store(15, -112, 1)
    a.store_byte(1, 0, 5)
    a.store(15, -88, 5)
    a.store(15, -96, 3)

    a.load(1, 15, -64)
    a.load(1, 1, 32)
    a.vm_mov_imm(2, 0)
    a.vm_cbz(1, "_rt_if_m_prefix_default")
    a.load(5, 15, -88)
    a.vm_mov_imm(4, 4)
    a.vm_cmp_imm(5, 4)
    a.jeq("_rt_if_m_prefix_mask_ready")
    a.vm_mov_imm(4, 8)
    a.label("_rt_if_m_prefix_mask_ready")
    a.add(1, 1, 4)
    a.vm_mov_imm(4, 0)
    a.label("_rt_if_m_prefix_loop")
    a.cmp(4, 5)
    a.jge("_rt_if_m_prefix_done")
    a.load_byte(0, 1, 0)
    for bit in 0:8 {
        skip := "_rt_if_m_prefix_bit_" + str(bit)
        a.vm_mov_imm64(23, 128)
        a.iand(3, 0, 23)
        a.vm_cbz(3, skip + "")
        a.vm_add_imm(2, 2, 1)
        a.shl_imm(0, 0, 1)
        a.label(skip)
    }
    a.vm_add_imm(1, 1, 1)
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_if_m_prefix_loop")
    a.label("_rt_if_m_prefix_default")
    a.load(5, 15, -88)
    a.vm_mov_imm(2, 32)
    a.vm_cmp_imm(5, 4)
    a.jeq("_rt_if_m_prefix_done")
    a.vm_mov_imm(2, 128)
    a.label("_rt_if_m_prefix_done")
    a.load(4, 15, -112)
    a.store_byte(4, 1, 2)

    a.load(5, 15, -88)
    a.load(3, 15, -96)
    a.load(0, 15, -64)
    a.load(0, 0, 24)
    a.add(0, 0, 3)
    a.load(1, 15, -112)
    a.vm_mov_imm(2, 0)
    a.label("_rt_if_m_ip_copy")
    a.cmp(2, 5)
    a.jge("_rt_if_m_ip_done")
    a.load_byte(3, 0, 0)
    a.store_byte(1, 2, 3)
    a.vm_add_imm(0, 0, 1)
    a.vm_add_imm(1, 1, 1)
    a.vm_add_imm(2, 2, 1)
    a.jmp("_rt_if_m_ip_copy")
    a.label("_rt_if_m_ip_done")
    a.load(1, 15, -40)
    a.load_byte(2, 1, 34)
    a.vm_add_imm(2, 2, 1)
    a.store_byte(1, 34, 2)

    a.label("_rt_if_m_next")
    a.load(0, 15, -72)
    a.store(15, -64, 0)
    a.jmp("_rt_if_m_loop")
    a.label("_rt_if_m_done")
    a.load(18, 15, -32)
    a.vm_call_iat("_iat_freeifaddrs")
    a.load(0, 15, -40)
    a.load_byte(1, 0, 34)
    a.vm_mov_imm(2, 18)
    a.mul(1, 1, 2)
    a.vm_add_imm(1, 1, 35)
    rt_iface_ok(a, 1, 179)

    a.label("_rt_if_m_names")
    a.vm_mov_imm(18, rt_iface_config_buffer_bytes)
    a.call("_rt_alloc")
    a.store(15, -40, 14)
    a.vm_mov_imm(1, 0)
    a.store(15, -48, 1)
    a.load(0, 15, -32)
    a.store(15, -64, 0)
    a.label("_rt_if_m_names_loop")
    a.load(0, 15, -64)
    a.vm_cbz(0, "_rt_if_m_names_done")
    a.load(1, 0, 8)
    a.store(15, -80, 1)
    a.vm_cbz(1, "_rt_if_m_names_next")
    a.vm_mov_imm(2, 0)
    a.label("_rt_if_m_names_len")
    a.load(1, 15, -80)
    a.add(1, 1, 2)
    a.load_byte(3, 1, 0)
    a.vm_cbz(3, "_rt_if_m_names_lend")
    a.vm_add_imm(2, 2, 1)
    a.jmp("_rt_if_m_names_len")
    a.label("_rt_if_m_names_lend")
    a.load(1, 15, -48)
    a.add(3, 1, 2)
    a.vm_cmp_imm(3, 4095)
    a.jgt("_rt_if_m_names_next")
    a.vm_mov_imm(3, 0)
    a.label("_rt_if_m_names_copy")
    a.cmp(3, 2)
    a.jge("_rt_if_m_names_copy_done")
    a.load(1, 15, -80)
    a.add(1, 1, 3)
    a.load_byte(4, 1, 0)
    a.load(1, 15, -40)
    a.load(5, 15, -48)
    a.add(1, 1, 5)
    a.add(1, 1, 3)
    a.store_byte(1, 0, 4)
    a.vm_add_imm(3, 3, 1)
    a.jmp("_rt_if_m_names_copy")
    a.label("_rt_if_m_names_copy_done")
    a.load(1, 15, -40)
    a.load(5, 15, -48)
    a.add(1, 1, 5)
    a.add(1, 1, 3)
    a.vm_mov_imm(2, 0)
    a.store_byte(1, 0, 2)
    a.add(5, 5, 3)
    a.vm_add_imm(5, 5, 1)
    a.store(15, -48, 5)
    a.label("_rt_if_m_names_next")
    a.load(0, 15, -64)
    a.load(0, 0, 0)
    a.store(15, -64, 0)
    a.jmp("_rt_if_m_names_loop")
    a.label("_rt_if_m_names_done")
    a.load(18, 15, -32)
    a.vm_call_iat("_iat_freeifaddrs")
    a.load(1, 15, -48)
    rt_iface_ok(a, 1, rt_iface_config_buffer_bytes)

    a.label("_rt_if_m_fail")
    rt_call_throw_strerr_static(a, -8, "_rt_net_iface_msg", 27)
    a.epilogue()
    <<
}

// Linux metadata via stable SIOCGIF* ioctls.  Interface names are discovered
// by the high-level package from /sys/class/net, so this helper handles one
// named interface at a time without exposing netlink layouts.
fn rt_emit_interface_data_linux(a &mut Assembler) {
    a.load(0, 15, -24)
    a.vm_cmp_imm(0, 1)
    a.jlt("_rt_if_l_fail")
    a.vm_cmp_imm(0, 15)
    a.jgt("_rt_if_l_fail")
    a.vm_mov_imm(18, 179)
    a.call("_rt_alloc")
    a.store(15, -40, 14)
    a.vm_mov_imm(1, 0)
    for i in 0:179 { a.store_byte(14, i, 1) }
    a.vm_mov_imm(1, 1)
    a.store_byte(14, 0, 1)
    a.vm_mov_imm(1, 35)
    a.store(15, -56, 1)

    // Linux 64-bit ifreq is 40 bytes; name occupies the first 16.
    a.mov(4, 15)
    a.vm_sub_imm(4, 4, 160)
    a.vm_mov_imm(1, 0)
    for i in 0:40 { a.store_byte(4, i, 1) }
    a.vm_mov_imm(5, 0)
    a.label("_rt_if_l_name")
    a.load(0, 15, -24)
    a.cmp(5, 0)
    a.jge("_rt_if_l_name_done")
    a.load(1, 15, -16)
    a.add(1, 1, 5)
    a.load_byte(2, 1, 0)
    a.add(1, 4, 5)
    a.store_byte(1, 0, 2)
    a.vm_add_imm(5, 5, 1)
    a.jmp("_rt_if_l_name")
    a.label("_rt_if_l_name_done")

    a.vm_mov_imm(18, 2)
    a.vm_mov_imm(19, 2)
    a.vm_mov_imm(20, 0)
    a.vm_syscall(syscall_number(a.os, a.arch, 25))
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_if_l_fail")
    a.store(15, -32, 14)

    // SIOCGIFINDEX.
    a.load(18, 15, -32)
    a.vm_mov_imm(19, 35123)
    a.mov(20, 15)
    a.vm_sub_imm(20, 20, 160)
    a.vm_syscall(syscall_number(a.os, a.arch, 46))
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_if_l_fail_close")
    a.mov(4, 15)
    a.vm_sub_imm(4, 4, 160)
    a.load(0, 4, 16)
    rt_iface_store_u32(a, 1, 0)

    // SIOCGIFMTU.
    a.load(18, 15, -32)
    a.vm_mov_imm(19, 35105)
    a.mov(20, 15)
    a.vm_sub_imm(20, 20, 160)
    a.vm_syscall(syscall_number(a.os, a.arch, 46))
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_if_l_fail_close")
    a.mov(4, 15)
    a.vm_sub_imm(4, 4, 160)
    a.load(0, 4, 16)
    rt_iface_store_u32(a, 5, 0)

    // SIOCGIFFLAGS -> public flag bits.
    a.load(18, 15, -32)
    a.vm_mov_imm(19, 35091)
    a.mov(20, 15)
    a.vm_sub_imm(20, 20, 160)
    a.vm_syscall(syscall_number(a.os, a.arch, 46))
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_if_l_fail_close")
    a.mov(4, 15)
    a.vm_sub_imm(4, 4, 160)
    a.load(1, 4, 16)
    a.vm_mov_imm(2, 0)
    rt_iface_flag(a, 1, 1, "_rt_if_l_flag_up")
    rt_iface_flag(a, 2, 2, "_rt_if_l_flag_broadcast")
    rt_iface_flag(a, 8, 4, "_rt_if_l_flag_loopback")
    rt_iface_flag(a, 16, 8, "_rt_if_l_flag_point")
    rt_iface_flag(a, rt_iface_multicast_flag, 16, "_rt_if_l_flag_multicast")
    rt_iface_flag(a, 64, 32, "_rt_if_l_flag_running")
    rt_iface_store_u32(a, 9, 2)

    // Optional SIOCGIFHWADDR.
    a.load(18, 15, -32)
    a.vm_mov_imm(19, 35111)
    a.mov(20, 15)
    a.vm_sub_imm(20, 20, 160)
    a.vm_syscall(syscall_number(a.os, a.arch, 46))
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_if_l_addr")
    a.mov(4, 15)
    a.vm_sub_imm(4, 4, 160)
    a.load(2, 15, -40)
    a.vm_mov_imm(3, 0)
    for i in 0:6 {
        a.load_byte(1, 4, 18 + i)
        a.store_byte(2, 14 + i, 1)
        a.add(3, 3, 1)
    }
    a.vm_cbz(3, "_rt_if_l_addr")
    a.vm_mov_imm(1, 6)
    a.store_byte(2, 13, 1)

    // Optional IPv4 address and mask.
    a.label("_rt_if_l_addr")
    a.load(18, 15, -32)
    a.vm_mov_imm(19, 35093)
    a.mov(20, 15)
    a.vm_sub_imm(20, 20, 160)
    a.vm_syscall(syscall_number(a.os, a.arch, 46))
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_if_l_done")
    a.mov(4, 15)
    a.vm_sub_imm(4, 4, 160)
    a.load(2, 15, -40)
    a.vm_mov_imm(1, 1)
    a.store_byte(2, 34, 1)
    a.vm_mov_imm(1, 4)
    a.store_byte(2, 35, 1)
    for i in 0:4 {
        a.load_byte(1, 4, 20 + i)
        a.store_byte(2, 37 + i, 1)
    }
    a.vm_mov_imm(1, 53)
    a.store(15, -56, 1)

    a.load(18, 15, -32)
    a.vm_mov_imm(19, 35099)
    a.mov(20, 15)
    a.vm_sub_imm(20, 20, 160)
    a.vm_syscall(syscall_number(a.os, a.arch, 46))
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_if_l_done")
    a.mov(4, 15)
    a.vm_sub_imm(4, 4, 140)
    a.vm_mov_imm(3, 0)
    for i in 0:4 {
        a.load_byte(1, 4, i)
        for bit in 0:8 {
            skip := "_rt_if_l_mask_" + str(i) + "_" + str(bit)
            a.vm_mov_imm64(23, 128)
            a.iand(2, 1, 23)
            a.vm_cbz(2, skip + "")
            a.vm_add_imm(3, 3, 1)
            a.shl_imm(1, 1, 1)
            a.label(skip)
        }
    }
    a.load(2, 15, -40)
    a.store_byte(2, 36, 3)

    a.label("_rt_if_l_done")
    a.load(18, 15, -32)
    a.vm_syscall(syscall_number(a.os, a.arch, 6))
    a.load(1, 15, -56)
    rt_iface_ok(a, 1, 179)
    a.label("_rt_if_l_fail_close")
    a.load(18, 15, -32)
    a.vm_syscall(syscall_number(a.os, a.arch, 6))
    a.label("_rt_if_l_fail")
    rt_call_throw_strerr_static(a, -8, "_rt_net_iface_msg", 27)
    a.epilogue()
    <<
}

fn rt_if_win_call(a &mut Assembler) {
    a.lea(1, "_rt_if_win_fp")
    a.load(1, 1, 0)
    a.vm_call_win_fp6(1)
    <<
}

fn rt_emit_interface_win_init(a &mut Assembler) {
    a.label("_rt_if_win_init")
    a.prologue(32)
    a.lea(0, "_rt_if_win_ready")
    a.load(1, 0, 0)
    a.vm_cbnz(1, "_rt_if_win_init_ok")
    a.lea(18, "_rt_if_win_dll")
    a.vm_call_iat("_iat_LoadLibraryA")
    a.vm_cbz(14, "_rt_if_win_init_fail")
    a.store(15, -8, 14)
    a.mov(18, 14)
    a.lea(19, "_rt_if_win_func")
    a.vm_call_iat("_iat_GetProcAddress")
    a.vm_cbz(14, "_rt_if_win_init_fail")
    a.lea(0, "_rt_if_win_fp")
    a.store(0, 0, 14)
    a.lea(0, "_rt_if_win_ready")
    a.vm_mov_imm(1, 1)
    a.store(0, 0, 1)
    a.label("_rt_if_win_init_ok")
    a.vm_mov_imm(14, 0)
    a.epilogue()
    a.label("_rt_if_win_init_fail")
    a.vm_mov_imm(14, -1)
    a.epilogue()
    <<
}

// Windows GetAdaptersAddresses.  The 64-bit offsets match both Win64 and
// WinARM64; AdapterName is an ANSI stable identifier, and unicast addresses
// carry their OnLinkPrefixLength in the documented +56 byte field.
fn rt_emit_interface_data_windows(a &mut Assembler) {
    a.call("_rt_if_win_init")
    a.vm_cmp_imm(14, 0)
    a.jne("_rt_if_w_fail")
    a.vm_mov_imm(1, 0)
    a.store(15, -136, 1)
    a.vm_mov_imm(18, 0)
    a.vm_mov_imm(19, 16)
    a.vm_mov_imm(20, 0)
    a.vm_mov_imm(21, 0)
    a.mov(22, 15)
    a.vm_sub_imm(22, 22, 136)
    a.vm_mov_imm(23, 0)
    rt_if_win_call(a)
    a.vm_cmp_imm(14, 111)
    a.jne("_rt_if_w_fail")
    a.load(18, 15, -136)
    a.vm_cmp_imm(18, 0)
    a.jle("_rt_if_w_fail")
    a.call("_rt_alloc")
    a.store(15, -144, 14)
    a.vm_mov_imm(18, 0)
    a.vm_mov_imm(19, 16)
    a.vm_mov_imm(20, 0)
    a.load(21, 15, -144)
    a.mov(22, 15)
    a.vm_sub_imm(22, 22, 136)
    a.vm_mov_imm(23, 0)
    rt_if_win_call(a)
    a.vm_cmp_imm(14, 0)
    a.jne("_rt_if_w_fail_free")
    a.load(0, 15, -24)
    a.vm_cmp_imm(0, 0)
    a.jeq("_rt_if_w_names")

    // Find the requested AdapterName.
    a.load(0, 15, -144)
    a.store(15, -168, 0)
    a.label("_rt_if_w_find")
    a.load(0, 15, -168)
    a.vm_cbz(0, "_rt_if_w_fail_free")
    a.load(1, 0, 8)
    a.store(15, -152, 1)
    a.load(1, 0, 16)
    a.store(15, -160, 1)
    a.vm_cbz(1, "_rt_if_w_find_next")
    a.vm_mov_imm(2, 0)
    a.label("_rt_if_w_cmp")
    a.load(1, 15, -24)
    a.cmp(2, 1)
    a.jge("_rt_if_w_cmp_end")
    a.load(1, 15, -160)
    a.add(1, 1, 2)
    a.load_byte(3, 1, 0)
    a.load(1, 15, -16)
    a.add(1, 1, 2)
    a.load_byte(4, 1, 0)
    a.cmp(3, 4)
    a.jne("_rt_if_w_find_next")
    a.vm_cbz(3, "_rt_if_w_match")
    a.vm_add_imm(2, 2, 1)
    a.jmp("_rt_if_w_cmp")
    a.label("_rt_if_w_cmp_end")
    a.load(1, 15, -160)
    a.add(1, 1, 2)
    a.load_byte(3, 1, 0)
    a.vm_cbz(3, "_rt_if_w_match")
    a.label("_rt_if_w_find_next")
    a.load(0, 15, -152)
    a.store(15, -168, 0)
    a.jmp("_rt_if_w_find")

    a.label("_rt_if_w_match")
    a.vm_mov_imm(18, 179)
    a.call("_rt_alloc")
    a.store(15, -40, 14)
    a.vm_mov_imm(1, 0)
    for i in 0:179 { a.store_byte(14, i, 1) }
    a.vm_mov_imm(1, 1)
    a.store_byte(14, 0, 1)
    a.load(4, 15, -168)
    a.vm_mov_imm(0, 0)
    for i in 0:4 {
        a.load_byte(1, 4, 4 + i)
        if i != 0 { a.shl_imm(1, 1, i * 8) }
        a.add(0, 0, 1)
    }
    a.vm_cbnz(0, "_rt_if_w_index_ready")
    for i in 0:4 {
        a.load_byte(1, 4, 108 + i)
        if i != 0 { a.shl_imm(1, 1, i * 8) }
        a.add(0, 0, 1)
    }
    a.label("_rt_if_w_index_ready")
    rt_iface_store_u32(a, 1, 0)
    a.load(4, 15, -168)
    a.load(0, 4, 96)
    rt_iface_store_u32(a, 5, 0)
    a.vm_mov_imm(2, 0)
    a.load_byte(1, 4, 104)
    a.vm_cmp_imm(1, 1)
    a.jne("_rt_if_w_not_up")
    a.vm_add_imm(2, 2, 33)
    a.label("_rt_if_w_not_up")
    a.load_byte(1, 4, 100)
    a.vm_cmp_imm(1, 24)
    a.jne("_rt_if_w_not_loop")
    a.vm_add_imm(2, 2, 4)
    a.jmp("_rt_if_w_no_broadcast")
    a.label("_rt_if_w_not_loop")
    a.vm_cmp_imm(1, 23)
    a.jeq("_rt_if_w_point")
    a.vm_cmp_imm(1, 131)
    a.jne("_rt_if_w_broadcast")
    a.label("_rt_if_w_point")
    a.vm_add_imm(2, 2, 8)
    a.jmp("_rt_if_w_no_broadcast")
    a.label("_rt_if_w_broadcast")
    a.vm_add_imm(2, 2, 2)
    a.label("_rt_if_w_no_broadcast")
    a.load(1, 4, 92)
    a.vm_mov_imm64(23, 16)
    a.iand(3, 1, 23)
    a.vm_cbnz(3, "_rt_if_w_no_multicast")
    a.vm_add_imm(2, 2, 16)
    a.label("_rt_if_w_no_multicast")
    rt_iface_store_u32(a, 9, 2)
    a.load_byte(5, 4, 88)
    a.vm_cmp_imm(5, 8)
    a.jgt("_rt_if_w_unicast_start")
    a.load(2, 15, -40)
    a.vm_mov_imm(3, 0)
    a.label("_rt_if_w_hw_copy")
    a.cmp(3, 5)
    a.jge("_rt_if_w_hw_done")
    a.add(1, 4, 3)
    a.load_byte(1, 1, 80)
    a.add(0, 2, 3)
    a.store_byte(0, 14, 1)
    a.vm_add_imm(3, 3, 1)
    a.jmp("_rt_if_w_hw_copy")
    a.label("_rt_if_w_hw_done")
    a.store_byte(2, 13, 5)

    a.label("_rt_if_w_unicast_start")
    a.load(4, 15, -168)
    a.load(0, 4, 24)
    a.store(15, -160, 0)
    a.label("_rt_if_w_unicast")
    a.load(0, 15, -160)
    a.vm_cbz(0, "_rt_if_w_record_done")
    a.load(1, 0, 8)
    a.store(15, -176, 1)
    a.load(1, 0, 16)
    a.vm_cbz(1, "_rt_if_w_unicast_next")
    a.load(4, 15, -40)
    a.load_byte(2, 4, 34)
    a.vm_cmp_imm(2, 8)
    a.jge("_rt_if_w_record_done")
    a.load_byte(3, 1, 0)
    a.vm_cmp_imm(3, 2)
    a.jeq("_rt_if_w_ip4")
    a.vm_cmp_imm(3, 23)
    a.jeq("_rt_if_w_ip6")
    a.jmp("_rt_if_w_unicast_next")
    a.label("_rt_if_w_ip4")
    a.vm_mov_imm(5, 4)
    a.vm_mov_imm(3, 4)
    a.jmp("_rt_if_w_ip")
    a.label("_rt_if_w_ip6")
    a.vm_mov_imm(5, 16)
    a.vm_mov_imm(3, 8)
    a.label("_rt_if_w_ip")
    a.mov(1, 2)
    a.vm_mov_imm(0, 18)
    a.mul(1, 1, 0)
    a.vm_add_imm(1, 1, 35)
    a.add(1, 4, 1)
    a.store(15, -184, 1)
    a.store_byte(1, 0, 5)
    a.load(0, 15, -160)
    a.load_byte(2, 0, 56)
    a.store_byte(1, 1, 2)
    a.load(0, 0, 16)
    a.add(0, 0, 3)
    a.vm_mov_imm(2, 0)
    a.label("_rt_if_w_ip_copy")
    a.cmp(2, 5)
    a.jge("_rt_if_w_ip_done")
    a.load_byte(3, 0, 0)
    a.load(1, 15, -184)
    a.add(1, 1, 2)
    a.store_byte(1, 2, 3)
    a.vm_add_imm(0, 0, 1)
    a.vm_add_imm(2, 2, 1)
    a.jmp("_rt_if_w_ip_copy")
    a.label("_rt_if_w_ip_done")
    a.load(1, 15, -40)
    a.load_byte(2, 1, 34)
    a.vm_add_imm(2, 2, 1)
    a.store_byte(1, 34, 2)
    a.label("_rt_if_w_unicast_next")
    a.load(0, 15, -176)
    a.store(15, -160, 0)
    a.jmp("_rt_if_w_unicast")
    a.label("_rt_if_w_record_done")
    a.load(18, 15, -144)
    a.call("_rt_free")
    a.load(0, 15, -40)
    a.load_byte(1, 0, 34)
    a.vm_mov_imm(2, 18)
    a.mul(1, 1, 2)
    a.vm_add_imm(1, 1, 35)
    rt_iface_ok(a, 1, 179)

    a.label("_rt_if_w_names")
    a.vm_mov_imm(18, rt_iface_config_buffer_bytes)
    a.call("_rt_alloc")
    a.store(15, -40, 14)
    a.vm_mov_imm(1, 0)
    a.store(15, -48, 1)
    a.load(0, 15, -144)
    a.store(15, -168, 0)
    a.label("_rt_if_w_names_loop")
    a.load(0, 15, -168)
    a.vm_cbz(0, "_rt_if_w_names_done")
    a.load(1, 0, 16)
    a.store(15, -160, 1)
    a.vm_cbz(1, "_rt_if_w_names_next")
    a.vm_mov_imm(2, 0)
    a.label("_rt_if_w_names_len")
    a.load(1, 15, -160)
    a.add(1, 1, 2)
    a.load_byte(3, 1, 0)
    a.vm_cbz(3, "_rt_if_w_names_lend")
    a.vm_add_imm(2, 2, 1)
    a.jmp("_rt_if_w_names_len")
    a.label("_rt_if_w_names_lend")
    a.load(1, 15, -48)
    a.add(3, 1, 2)
    a.vm_cmp_imm(3, 4095)
    a.jgt("_rt_if_w_names_next")
    a.vm_mov_imm(3, 0)
    a.label("_rt_if_w_names_copy")
    a.cmp(3, 2)
    a.jge("_rt_if_w_names_copy_done")
    a.load(1, 15, -160)
    a.add(1, 1, 3)
    a.load_byte(4, 1, 0)
    a.load(1, 15, -40)
    a.load(5, 15, -48)
    a.add(1, 1, 5)
    a.add(1, 1, 3)
    a.store_byte(1, 0, 4)
    a.vm_add_imm(3, 3, 1)
    a.jmp("_rt_if_w_names_copy")
    a.label("_rt_if_w_names_copy_done")
    a.load(1, 15, -40)
    a.load(5, 15, -48)
    a.add(1, 1, 5)
    a.add(1, 1, 3)
    a.vm_mov_imm(2, 0)
    a.store_byte(1, 0, 2)
    a.add(5, 5, 3)
    a.vm_add_imm(5, 5, 1)
    a.store(15, -48, 5)
    a.label("_rt_if_w_names_next")
    a.load(0, 15, -168)
    a.load(0, 0, 8)
    a.store(15, -168, 0)
    a.jmp("_rt_if_w_names_loop")
    a.label("_rt_if_w_names_done")
    a.load(18, 15, -144)
    a.call("_rt_free")
    a.load(1, 15, -48)
    rt_iface_ok(a, 1, rt_iface_config_buffer_bytes)
    a.label("_rt_if_w_fail_free")
    a.load(18, 15, -144)
    a.call("_rt_free")
    a.label("_rt_if_w_fail")
    rt_call_throw_strerr_static(a, -8, "_rt_net_iface_msg", 27)
    a.epilogue()
    <<
}

// `_rt_interface_data`: A0/A1 = interface name, V0 = tagged-string sret.
fn rt_emit_interface_data(a &mut Assembler) {
    a.label("_rt_interface_data")
    a.prologue(256)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    if a.os == 0 {
        rt_emit_interface_data_macos(a)
        <<
    }
    if a.os == 1 {
        rt_emit_interface_data_linux(a)
        <<
    }
    if a.os == 2 {
        rt_emit_interface_data_windows(a)
        rt_emit_interface_win_init(a)
        <<
    }
    rt_call_throw_strerr_static(a, -8, "_rt_net_iface_msg", 27)
    a.epilogue()
    <<
}

fn rt_net_win_ok_fd(a &mut Assembler) {
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 14)
    a.epilogue()
    <<
}

// Err("net: unsupported on windows"); caller must have already loaded the
// sret pointer into V0 (reg 0) before calling.
fn rt_emit_net_unsupported_win(a &mut Assembler) {
    a.mov(18, 0)
    a.lea(19, "_rt_net_win_msg")
    a.vm_mov_imm(20, 28)
    a.vm_mov_imm(21, 0)
    a.call("_rt_throw_strerr")
    a.epilogue()
    <<
}

// Fill a 16-byte sockaddr_in at [fp + offs[0]] from a/b/c/d/port frame slots
// offs[1..5] (all fp-relative). macOS: sin_len + AF_INET; Linux: AF_INET u16
// LE. Uses reg 4 (V4) as &sa scratch; regs 1/2 (V1/V2) as byte scratch.
// (Packed into one []int: a plain function call is capped at 6 argument
// registers, and a0 Assembler + 6 separate int offsets would need 7.)
fn rt_emit_fill_sockaddr_in4(a &mut Assembler, offs []int) {
    sa_off := offs[0]
    a_off := offs[1]
    b_off := offs[2]
    c_off := offs[3]
    d_off := offs[4]
    port_off := offs[5]
    a.mov(4, 15)
    a.vm_sub_imm(4, 4, -sa_off)
    a.vm_mov_imm(1, 0)
    for i in 0:16 {
        a.store_byte(4, i, 1)
    }
    if a.os == 0 {
        a.vm_mov_imm(1, 16)
        a.store_byte(4, 0, 1) // sin_len
        a.vm_mov_imm(1, 2)
        a.store_byte(4, 1, 1) // AF_INET
    } else {
        a.vm_mov_imm(1, 2)
        a.store_byte(4, 0, 1) // sin_family lo
        a.vm_mov_imm(1, 0)
        a.store_byte(4, 1, 1) // sin_family hi
    }
    // htons(port) at offset 2
    a.load(1, 15, port_off)
    a.shr_imm(2, 1, 8)
    a.store_byte(4, 2, 2)
    a.store_byte(4, 3, 1)
    a.load(1, 15, a_off)
    a.store_byte(4, 4, 1)
    a.load(1, 15, b_off)
    a.store_byte(4, 5, 1)
    a.load(1, 15, c_off)
    a.store_byte(4, 6, 1)
    a.load(1, 15, d_off)
    a.store_byte(4, 7, 1)
    <<
}

// Fill a sockaddr_in6 at [fp + sa_off] from an IPv6 raw-byte string pointer
// (fp + ip_off) and a port (fp + port_off). The string length is validated by
// the caller. Darwin prefixes sockaddr_in6 with sin6_len; Linux/Windows use
// the native little-endian AF_INET6 family word.
fn rt_emit_fill_sockaddr_in6(a &mut Assembler, sa_off int, ip_off int, port_off int) {
    a.mov(4, 15)
    a.vm_sub_imm(4, 4, -sa_off)
    a.vm_mov_imm(1, 0)
    for i in 0:28 {
        a.store_byte(4, i, 1)
    }
    if a.os == 0 {
        a.vm_mov_imm(1, 28)
        a.store_byte(4, 0, 1) // sin6_len
        a.vm_mov_imm(1, 30)
        a.store_byte(4, 1, 1) // AF_INET6
    } else {
        a.vm_mov_imm(1, 10)
        if a.os == 2 {
            a.vm_mov_imm(1, 23)
        }
        a.store_byte(4, 0, 1) // AF_INET6 family lo
        a.vm_mov_imm(1, 0)
        a.store_byte(4, 1, 1) // family hi
    }
    a.load(1, 15, port_off)
    a.shr_imm(2, 1, 8)
    a.store_byte(4, 2, 2)
    a.store_byte(4, 3, 1)
    a.load(3, 15, ip_off)
    for i in 0:16 {
        a.load_byte(1, 3, i)
        a.store_byte(4, 8 + i, 1)
    }
    <<
}

// Fill sockaddr_un at [fp + sa_off]. Pathname sockets use a trailing NUL;
// Darwin has sun_len/sun_family bytes, Linux has a little-endian family.
// The caller validates the target-specific maximum length. Embedded NUL is
// rejected so the public address cannot silently differ from the bound path.
fn rt_emit_fill_sockaddr_un(a &mut Assembler, sa_off int, path_off int, path_len_off int, bad string) {
    a.mov(4, 15)
    a.vm_sub_imm(4, 4, -sa_off)
    a.vm_mov_imm(1, 0)
    for i in 0:110 {
        a.store_byte(4, i, 1)
    }
    if a.os == 0 {
        a.load(1, 15, path_len_off)
        a.vm_add_imm(1, 1, 3)
        a.store_byte(4, 0, 1) // sun_len
        a.vm_mov_imm(1, 1)
        a.store_byte(4, 1, 1) // AF_UNIX
    } else {
        a.vm_mov_imm(1, 1)
        a.store_byte(4, 0, 1) // AF_UNIX lo
        a.vm_mov_imm(1, 0)
        a.store_byte(4, 1, 1) // family hi
    }
    loop := bad + "_copy"
    done := bad + "_copy_done"
    a.vm_mov_imm(5, 0)
    a.label(loop + "")
    a.load(1, 15, path_len_off)
    a.cmp(5, 1)
    a.jge(done + "")
    a.load(3, 15, path_off)
    a.add(3, 3, 5)
    a.load_byte(1, 3, 0)
    a.vm_cmp_imm(1, 0)
    a.jeq(bad)
    a.add(2, 4, 5)
    a.store_byte(2, 2, 1)
    a.vm_add_imm(5, 5, 1)
    a.jmp(loop + "")
    a.label(done + "")
    a.add(2, 4, 5)
    a.vm_mov_imm(1, 0)
    a.store_byte(2, 2, 1)
    <<
}

// `_rt_dial_tcp4`: A0..A4 = a,b,c,d,port; V0/X8 = sret throw slot.
fn rt_emit_dial_tcp4(a &mut Assembler) {
    a.label("_rt_dial_tcp4")
    // Frame (no overlap): sret -8, a -16, b -24, c -32, d -40, port -48,
    // fd -56, errno_tmp -64, sockaddr [fp-96, fp-80).
    a.prologue(112)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.store(15, -32, 20)
    a.store(15, -40, 21)
    a.store(15, -48, 22)
    if a.os == 2 {
        a.call("_rt_ws2_init")
        a.vm_cmp_imm(14, 0)
        a.jne("_rt_di_wfail")
        a.vm_mov_imm(18, 2)
        a.vm_mov_imm(19, 1)
        a.vm_mov_imm(20, 0)
        rt_ws2_call(a, 8)
        a.vm_cmp_imm(14, -1)
        a.jeq("_rt_di_wfail")
        a.store(15, -56, 14)
        rt_emit_fill_sockaddr_in4(a, [-96, -16, -24, -32, -40, -48])
        a.load(18, 15, -56)
        a.mov(19, 4)
        a.vm_mov_imm(20, 16)
        rt_ws2_call(a, 16)
        a.vm_cmp_imm(14, 0)
        a.jne("_rt_di_wfailc")
        a.load(14, 15, -56)
        rt_net_win_ok_fd(a)
        a.label("_rt_di_wfailc")
        a.load(18, 15, -56)
        rt_ws2_call(a, 80)
        a.label("_rt_di_wfail")
        rt_net_win_throw(a)
        <<
    }
    a.vm_mov_imm(18, 2) // AF_INET
    a.vm_mov_imm(19, 1) // SOCK_STREAM
    a.vm_mov_imm(20, 0)
    a.vm_syscall(syscall_number(a.os, a.arch, 25))
    a.vm_normalize_syscall("_rt_di_n0")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_di_err")
    a.store(15, -56, 14) // fd
    rt_emit_fill_sockaddr_in4(a, [-96, -16, -24, -32, -40, -48])
    a.load(18, 15, -56)
    a.mov(19, 4)
    a.vm_mov_imm(20, 16)
    a.vm_syscall(syscall_number(a.os, a.arch, 26))
    a.vm_normalize_syscall("_rt_di_n1")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_di_fail_close")
    a.load(14, 15, -56)
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 14)
    a.epilogue()

    a.label("_rt_di_fail_close")
    a.store(15, -64, 14)
    a.load(18, 15, -56)
    a.vm_syscall(syscall_number(a.os, a.arch, 6))
    a.load(14, 15, -64)
    a.label("_rt_di_err")
    a.neg(18, 14)
    a.call("_rt_errno_msg")
    rt_call_throw_strerr_args(a, -8)
    a.epilogue()
    <<
}

// `_rt_listen_tcp4`: A0..A4 = a,b,c,d,port; V0/X8 = sret throw slot.
fn rt_emit_listen_tcp4(a &mut Assembler) {
    a.label("_rt_listen_tcp4")
    // sret -8, a..port -16..-48, fd -56, on -64, errno_tmp -72,
    // sockaddr [fp-96, fp-80).
    a.prologue(112)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.store(15, -32, 20)
    a.store(15, -40, 21)
    a.store(15, -48, 22)
    if a.os == 2 {
        a.call("_rt_ws2_init")
        a.vm_cmp_imm(14, 0)
        a.jne("_rt_li_wfail")
        a.vm_mov_imm(18, 2)
        a.vm_mov_imm(19, 1)
        a.vm_mov_imm(20, 0)
        rt_ws2_call(a, 8)
        a.vm_cmp_imm(14, -1)
        a.jeq("_rt_li_wfail")
        a.store(15, -56, 14)
        a.vm_mov_imm(1, 1)
        a.store(15, -64, 1)
        a.load(18, 15, -56)
        a.vm_mov_imm(19, 65535)
        a.vm_mov_imm(20, 4)
        a.mov(21, 15)
        a.vm_sub_imm(21, 21, 64)
        a.vm_mov_imm(22, 4)
        rt_ws2_call(a, 88)
        rt_emit_fill_sockaddr_in4(a, [-96, -16, -24, -32, -40, -48])
        a.load(18, 15, -56)
        a.mov(19, 4)
        a.vm_mov_imm(20, 16)
        rt_ws2_call(a, 24)
        a.vm_cmp_imm(14, 0)
        a.jne("_rt_li_wfailc")
        a.load(18, 15, -56)
        a.vm_mov_imm(19, 128)
        rt_ws2_call(a, 32)
        a.vm_cmp_imm(14, 0)
        a.jne("_rt_li_wfailc")
        a.load(14, 15, -56)
        rt_net_win_ok_fd(a)
        a.label("_rt_li_wfailc")
        a.load(18, 15, -56)
        rt_ws2_call(a, 80)
        a.label("_rt_li_wfail")
        rt_net_win_throw(a)
        <<
    }
    a.vm_mov_imm(18, 2)
    a.vm_mov_imm(19, 1)
    a.vm_mov_imm(20, 0)
    a.vm_syscall(syscall_number(a.os, a.arch, 25))
    a.vm_normalize_syscall("_rt_li_n0")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_li_err")
    a.store(15, -56, 14) // fd
    a.vm_mov_imm(1, 1)
    a.store(15, -64, 1) // on = 1
    a.load(18, 15, -56)
    if a.os == 0 {
        a.vm_mov_imm(19, 65535) // SOL_SOCKET
        a.vm_mov_imm(20, 4)     // SO_REUSEADDR
    } else {
        a.vm_mov_imm(19, 1) // SOL_SOCKET
        a.vm_mov_imm(20, 2) // SO_REUSEADDR
    }
    a.mov(21, 15)
    a.vm_sub_imm(21, 21, 64) // &on
    a.vm_mov_imm(22, 4)
    a.vm_syscall(syscall_number(a.os, a.arch, 30))
    rt_emit_fill_sockaddr_in4(a, [-96, -16, -24, -32, -40, -48])
    a.load(18, 15, -56)
    a.mov(19, 4)
    a.vm_mov_imm(20, 16)
    a.vm_syscall(syscall_number(a.os, a.arch, 27))
    a.vm_normalize_syscall("_rt_li_n1")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_li_fail_close")
    a.load(18, 15, -56)
    a.vm_mov_imm(19, 128)
    a.vm_syscall(syscall_number(a.os, a.arch, 28))
    a.vm_normalize_syscall("_rt_li_n2")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_li_fail_close")
    a.load(14, 15, -56)
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 14)
    a.epilogue()

    a.label("_rt_li_fail_close")
    a.store(15, -72, 14)
    a.load(18, 15, -56)
    a.vm_syscall(syscall_number(a.os, a.arch, 6))
    a.load(14, 15, -72)
    a.label("_rt_li_err")
    a.neg(18, 14)
    a.call("_rt_errno_msg")
    rt_call_throw_strerr_args(a, -8)
    a.epilogue()
    <<
}

