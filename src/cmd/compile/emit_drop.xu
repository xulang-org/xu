@main

#xu/types

fn drop_struct_name(si int) string { << "_drop_s_" + str(si) }
fn drop_array_name(ai int) string { << "_drop_a_" + str(ai) }
fn drop_map_val_name(mi int) string { << "_drop_mv_" + str(mi) }
fn drop_iface_name(dir int) string {
    if dir < 0 {
        << "_drop_iface_n"
    }
    << "_drop_iface_p"
}

// Call while keeping S1 (&drop value) live. Callees that use S1 for their
// own drops otherwise clobber the caller's base (nested path_join crash).
fn emit_drop_call(a &mut Assembler, label string) {
    a.vm_sub_imm(16, 16, 16)
    a.store(16, 0, 9)
    a.call(label)
    a.load(9, 16, 0)
    a.vm_add_imm(16, 16, 16)
}

// Emit drop sequence for value at [S1 + base_off] (word 0). dir=-1 frame
// (word k at base-8k), dir=+1 buffer (word k at base+8k).
// M7d: string, struct fields, throw-slot payload, array elems+buffer.
fn emit_drop_value(a &mut Assembler, m &types.Mir, ty int, base_off int, dir int) {
    // M152/MS6: temp / struct@ fat pointer owns a heap box. Call a helper so
    // a struct that itself contains temp/struct@ does not recurse at emit time.
    if types.is_box_type_encoding(ty) {
        a.mov(18, 9)
        if base_off > 0 {
            a.vm_add_imm(18, 18, base_off)
        }
        if base_off < 0 {
            a.vm_sub_imm(18, 18, 0 - base_off)
        }
        emit_drop_call(a, drop_iface_name(dir))
        <<
    }
    if ty == 3 { // string: cap>0 owns a buffer; cap<0 is a shared view
        a.drop_seq = a.drop_seq + 1
        n := a.drop_seq
        a.load(0, 9, base_off + dir * 16) // cap
        a.vm_cbz(0, "_xudrop_" + str(n) + "_skip")
        a.vm_cmp_imm(0, 0)
        a.jlt("_xudrop_" + str(n) + "_rel")
        a.load(0, 9, base_off) // ptr
        a.vm_cmp_imm(0, RT_MIN_HEAP_POINTER)
        a.jlt("_xudrop_" + str(n) + "_skip")
        a.mov(18, 0)
        emit_drop_call(a, "_rt_free")
        a.jmp("_xudrop_" + str(n) + "_skip")
        a.label("_xudrop_" + str(n) + "_rel")
        a.load(0, 9, base_off + dir * 16)
        a.mov(18, 0)
        emit_drop_call(a, "_rt_str_release")
        a.label("_xudrop_" + str(n) + "_skip")
        <<
    }
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        if si >= 0 && si < m.structs.len {
            if m.structs[si].drop_label.len > 0 {
                emit_resource_drop(a, m, si, base_off, dir)
                <<
            }
            for i in 0:m.structs[si].fields.len {
                fty := m.structs[si].fields[i].ty
                if m.type_owning(fty) {
                    foff := m.structs[si].fields[i].slot
                    emit_drop_value(a, m, fty, base_off + dir * foff, dir)
                }
            }
        }
        <<
    }
    if types.is_throw_type(ty) {
        ri := types.throw_index(ty)
        if ri < 0 || ri >= m.throws.len { << }
        ok := m.throws[ri].ok_ty
        err := m.throws[ri].err_ty
        ok_owns := m.type_owning(ok)
        err_owns := m.type_owning(err)
        if !ok_owns && !err_owns { << }
        a.drop_seq = a.drop_seq + 1
        n := a.drop_seq
        a.load(0, 9, base_off) // tag: 0 = Ok
        a.vm_cbz(0, "_xudrop_" + str(n) + "_ok")
        if err_owns {
            emit_drop_value(a, m, err, base_off + dir * 8, dir)
        }
        a.jmp("_xudrop_" + str(n) + "_done")
        a.label("_xudrop_" + str(n) + "_ok")
        if ok_owns {
            emit_drop_value(a, m, ok, base_off + dir * 8, dir)
        }
        a.label("_xudrop_" + str(n) + "_done")
        <<
    }
    if types.is_enum_type(ty) {
        ei := types.enum_index(ty)
        if ei < 0 || ei >= m.enums.len { << }
        if !m.enums[ei].owns { << }
        a.drop_seq = a.drop_seq + 1
        base_n := a.drop_seq
        for vi in 0:m.enums[ei].variants.len {
            mut has_own := false
            for fi in 0:m.enums[ei].variants[vi].fields.len {
                if m.type_owning(m.enums[ei].variants[vi].fields[fi]) {
                    has_own = true
                }
            }
            if !has_own {
                ->
            }
            a.drop_seq = a.drop_seq + 1
            n := a.drop_seq
            a.load(0, 9, base_off) // tag
            a.vm_cmp_imm(0, vi)
            a.jeq("_xudrop_" + str(n) + "_en_hit")
            a.jmp("_xudrop_" + str(n) + "_en_miss")
            a.label("_xudrop_" + str(n) + "_en_hit")
            mut off := 1
            for fi in 0:m.enums[ei].variants[vi].fields.len {
                fty := m.enums[ei].variants[vi].fields[fi]
                if m.type_owning(fty) {
                    emit_drop_value(a, m, fty, base_off + dir * 8 * off, dir)
                }
                off += m.type_slots(fty)
            }
            a.jmp("_xudrop_" + str(base_n) + "_en_done")
            a.label("_xudrop_" + str(n) + "_en_miss")
        }
        a.label("_xudrop_" + str(base_n) + "_en_done")
        <<
    }
    if types.is_map_type(ty) {
        a.drop_seq = a.drop_seq + 1
        n := a.drop_seq
        a.load(0, 9, base_off) // handle
        a.vm_cbz(0, "_xudrop_" + str(n) + "_map_skip")
        a.mov(18, 0)
        emit_drop_call(a, "_rt_map_drop")
        a.label("_xudrop_" + str(n) + "_map_skip")
        <<
    }
    if types.is_array_type(ty) {
        ai := types.array_index(ty)
        if ai < 0 || ai >= m.arrays.len { << }
        fl := m.arrays[ai].fixed_len
        ety := m.arrays[ai].elem_ty
        if fl > 0 {
            // Inline `[N]T` element walk. ArrayLit still heap-allocates a
            // 3-slot descriptor; non-owning elems (`[4]int`) are covered by
            // a synthetic `[]T` hold in lower_expr_array. Owning fixed arrays
            // (`[2]string`) keep a known ledger leftover — do not free the
            // heap buffer from this walk (broke product compile/xtest).
            if m.type_owning(ety) {
                elem_bytes := m.arrays[ai].elem_bytes
                for i in 0:fl {
                    emit_drop_value(a, m, ety, base_off + dir * (i * elem_bytes), dir)
                }
            }
            <<
        }
        elem_owning := m.type_owning(ety)
        a.drop_seq = a.drop_seq + 1
        n := a.drop_seq
        a.load(0, 9, base_off + dir * 16) // cap
        a.vm_cbz(0, "_xudrop_" + str(n) + "_arr_skip")
        if elem_owning {
            a.load(0, 9, base_off) // ptr
            a.mov(18, 0)
            a.load(0, 9, base_off + dir * 8) // len
            a.mov(19, 0)
            emit_drop_call(a, drop_array_name(ai))
        }
        a.load(0, 9, base_off) // buffer ptr
        a.vm_cmp_imm(0, RT_MIN_HEAP_POINTER)
        a.jlt("_xudrop_" + str(n) + "_arr_skip")
        a.mov(18, 0)
        emit_drop_call(a, "_rt_free")
        a.label("_xudrop_" + str(n) + "_arr_skip")
        <<
    }
    if types.is_fn_type(ty) {
        // M109: env!=0 → drop Env fields (frame layout) then free alloc.
        si := types.fn_index(ty)
        a.drop_seq = a.drop_seq + 1
        n := a.drop_seq
        a.load(0, 9, base_off + dir * 8) // env
        a.vm_cbz(0, "_xudrop_" + str(n) + "_fn_skip")
        // Nested environment drops use S1 as their frame base.  Preserve the
        // caller's S1 on the stack so a Fn field/element cannot poison the
        // address used by a following sibling.  S2 is not suitable here:
        // Gen1 x64 maps it to a caller-saved scratch register.
        a.vm_sub_imm(16, 16, 16)
        a.store(16, 0, 9)
        // Keep the environment allocation itself on the stack too.  An
        // environment may contain another capturing Fn; using S0 here would
        // let that inner drop overwrite the outer pointer before `_rt_free`.
        a.vm_sub_imm(16, 16, 16)
        a.store(16, 0, 0)
        if si >= 0 && si < m.fn_sigs.len && m.fn_sigs[si].has_env == 1 {
            esi := m.fn_sigs[si].env_struct
            if esi >= 0 && esi < m.structs.len {
                nslots := m.structs[esi].nslots
                a.mov(9, 0) // S1 = env for nested drop (dir=-1)
                emit_drop_value(a, m, types.struct_type(esi), 0, -1)
                a.load(18, 16, 0) // A0 = env_ptr
                if nslots > 0 {
                    a.vm_sub_imm(18, 18, (nslots - 1) * 8)
                }
                emit_drop_call(a, "_rt_free")
            } else {
                a.load(18, 16, 0)
                emit_drop_call(a, "_rt_free")
            }
        } else {
            a.load(18, 16, 0)
            emit_drop_call(a, "_rt_free")
        }
        a.vm_add_imm(16, 16, 16)
        a.load(9, 16, 0)
        a.vm_add_imm(16, 16, 16)
        a.label("_xudrop_" + str(n) + "_fn_skip")
        <<
    }
    <<
}

// drop_mv_N: A0 = address of map value (buffer layout, dir=+1). Saves S1.
fn emit_map_val_drop_helper(a &mut Assembler, m &types.Mir, mi int) {
    a.label(drop_map_val_name(mi))
    a.prologue(32)
    a.store(15, -8, 9)
    a.mov(9, 18)
    emit_drop_value(a, m, m.maps[mi].val_ty, 0, 1)
    a.load(9, 15, -8)
    a.epilogue()
    <<
}

// drop_s_N: A0 = address of struct (buffer/element layout, dir=+1). Saves S1.
fn emit_struct_drop_helper(a &mut Assembler, m &types.Mir, si int) {
    a.label(drop_struct_name(si))
    a.prologue(32)
    a.store(15, -8, 9)
    a.mov(9, 18)
    emit_drop_value(a, m, types.struct_type(si), 0, 1)
    a.load(9, 15, -8)
    a.epilogue()
    <<
}

// drop_a_N: A0 = buffer ptr, A1 = len. Walks elements (buffer layout).
fn emit_array_drop_helper(a &mut Assembler, m &types.Mir, ai int) {
    ety := m.arrays[ai].elem_ty
    mut elem_size := m.type_size_bytes(ety)
    if elem_size < 1 { elem_size = 1 }
    a.label(drop_array_name(ai))
    a.prologue(48)
    a.store(15, -8, 18)  // ptr
    a.store(15, -16, 19) // len
    a.store(15, -32, 9)  // saved S1
    a.vm_mov_imm(0, 0)
    a.store(15, -24, 0)  // i
    a.label(drop_array_name(ai) + "_loop")
    a.load(0, 15, -24)
    a.load(1, 15, -16)
    a.cmp(0, 1)
    a.jge(drop_array_name(ai) + "_done")
    a.load(2, 15, -8)
    a.vm_mov_imm(3, elem_size)
    a.mul(4, 0, 3)
    a.add(2, 2, 4)
    a.mov(9, 2) // S1 = element address
    if ety == 3 {
        a.load(0, 9, 16)
        a.vm_cbz(0, drop_array_name(ai) + "_skip")
        a.vm_cmp_imm(0, 0)
        a.jlt(drop_array_name(ai) + "_rel")
        a.load(0, 9, 0)
        a.vm_cmp_imm(0, RT_MIN_HEAP_POINTER)
        a.jlt(drop_array_name(ai) + "_skip")
        a.mov(18, 0)
        a.call("_rt_free")
        a.jmp(drop_array_name(ai) + "_skip")
        a.label(drop_array_name(ai) + "_rel")
        a.load(18, 9, 16)
        a.call("_rt_str_release")
    } else if types.is_struct_type(ety) {
        a.mov(18, 9)
        a.call(drop_struct_name(types.struct_index(ety)))
    } else if types.is_array_type(ety) {
        nested := types.array_index(ety)
        if nested >= 0 && nested < m.arrays.len {
            // A nested fixed array is inline data, not a three-word slice
            // descriptor.  The old path unconditionally loaded ptr/len/cap
            // here, so `[][N]T` could interpret element bytes as a pointer
            // and free an arbitrary address.  Keep all array layouts on the
            // type-directed path: emit_drop_value handles fixed arrays
            // element-by-element and dynamic arrays as ptr/len/cap.
            nfixed := m.arrays[nested].fixed_len
            nbytes := m.arrays[nested].elem_bytes
            if nfixed >= 0 && nfixed <= types.MIR_MAX_LAYOUT_WORDS && nbytes >= 0 && nbytes <= types.MIR_MAX_LAYOUT_BYTES {
                emit_drop_value(a, m, ety, 0, 1)
            }
        }
    } else if types.is_throw_type(ety) {
        emit_drop_value(a, m, ety, 0, 1)
    } else if types.is_enum_type(ety) || types.is_map_type(ety) || types.is_fn_type(ety) {
        // Tagged payloads, map handles, and capturing function values all
        // have type-directed ownership logic in `emit_drop_value`; keep the
        // array helper in lockstep with ordinary field/local drops.
        emit_drop_value(a, m, ety, 0, 1)
    } else if types.is_box_type_encoding(ety) {
        a.mov(18, 9)
        a.call(drop_iface_name(1))
    }
    a.label(drop_array_name(ai) + "_skip")
    a.load(0, 15, -24)
    a.vm_add_imm(0, 0, 1)
    a.store(15, -24, 0)
    a.jmp(drop_array_name(ai) + "_loop")
    a.label(drop_array_name(ai) + "_done")
    a.load(9, 15, -32)
    a.epilogue()
    <<
}

// Payload is always frame layout; then free the box base.
fn emit_iface_box_drop(a &mut Assembler, m &types.Mir, ty int, dir int) {
    // S0 (vreg 8) aliases V2/RBX on Gen1 x64.  A nested type-directed drop
    // may use V2 as scratch (notably an array/Map/Fn payload), so retaining
    // data* only in S0 can make the final box free target the wrong address.
    // Keep the pointer in an explicit stack slot across the whole payload
    // drop; this is backend-neutral and mirrors the closure environment
    // save in emit_drop_value.
    a.vm_sub_imm(16, 16, 16)
    a.store(16, 0, 8) // saved data*
    a.load(9, 16, 0)
    emit_drop_value(a, m, ty, 0, -1)
    a.load(18, 16, 0)
    ns := m.type_slots(ty)
    if ns > 1 {
        a.vm_sub_imm(18, 18, (ns - 1) * 8)
    }
    a.call("_rt_free")
    a.vm_add_imm(16, 16, 16)
    a.jmp(drop_iface_name(dir) + "_done")
}

// `_drop_iface_{n,p}`: A0 = address of data* of a fat temp/struct@ pointer.
// n = frame layout (itable at -8); p = buffer layout (itable at +8).
fn emit_iface_drop_helper(a &mut Assembler, m &types.Mir, dir int) {
    a.label(drop_iface_name(dir))
    a.prologue(48)
    a.store(15, -8, 9) // saved S1
    a.mov(9, 18) // S1 = &data*
    a.load(0, 9, 0) // data*
    a.vm_cbz(0, drop_iface_name(dir) + "_skip")
    a.mov(8, 0) // save data*
    a.load(0, 9, dir * 8) // itable*
    a.load(1, 0, 0) // type_id
    for sid in 0:m.structs.len {
        a.vm_mov_imm64(0, types.box_struct_tag(sid))
        a.cmp(1, 0)
        a.vm_cset(0, 0)
        a.vm_cbnz(0, drop_iface_name(dir) + "_s" + str(sid))
    }
    // Boxed string/array are 3-slot frame layouts (ptr,len,cap). data* is
    // the last slot; rt_free(data*) would read len as a size-class.
    a.vm_mov_imm64(0, types.ANY_TAG_STRING)
    a.cmp(1, 0)
    a.vm_cset(0, 0)
    a.vm_cbnz(0, drop_iface_name(dir) + "_str")
    for aid in 0:m.arrays.len {
        a.vm_mov_imm64(0, types.ANY_TAG_ARRAY_BASE + aid)
        a.cmp(1, 0)
        a.vm_cset(0, 0)
        a.vm_cbnz(0, drop_iface_name(dir) + "_a" + str(aid))
    }
    for eid in 0:m.enums.len {
        a.vm_mov_imm64(0, types.ANY_TAG_ENUM_BASE + eid)
        a.cmp(1, 0)
        a.vm_cset(0, 0)
        a.vm_cbnz(0, drop_iface_name(dir) + "_e" + str(eid))
    }
    for tid in 0:m.throws.len {
        a.vm_mov_imm64(0, types.ANY_TAG_THROW_BASE + tid)
        a.cmp(1, 0)
        a.vm_cset(0, 0)
        a.vm_cbnz(0, drop_iface_name(dir) + "_th" + str(tid))
    }
    for mid in 0:m.maps.len {
        a.vm_mov_imm64(0, types.ANY_TAG_MAP_BASE + mid)
        a.cmp(1, 0)
        a.vm_cset(0, 0)
        a.vm_cbnz(0, drop_iface_name(dir) + "_m" + str(mid))
    }
    for fid in 0:m.fn_sigs.len {
        a.vm_mov_imm64(0, types.ANY_TAG_FN_BASE + fid)
        a.cmp(1, 0)
        a.vm_cset(0, 0)
        a.vm_cbnz(0, drop_iface_name(dir) + "_f" + str(fid))
    }
    a.jmp(drop_iface_name(dir) + "_free")
    for sid in 0:m.structs.len {
        a.label(drop_iface_name(dir) + "_s" + str(sid))
        emit_iface_box_drop(a, m, types.struct_type(sid), dir)
    }
    a.label(drop_iface_name(dir) + "_str")
    emit_iface_box_drop(a, m, 3, dir)
    for aid in 0:m.arrays.len {
        a.label(drop_iface_name(dir) + "_a" + str(aid))
        emit_iface_box_drop(a, m, types.array_type(aid), dir)
    }
    for eid in 0:m.enums.len {
        a.label(drop_iface_name(dir) + "_e" + str(eid))
        emit_iface_box_drop(a, m, types.enum_type(eid), dir)
    }
    for tid in 0:m.throws.len {
        a.label(drop_iface_name(dir) + "_th" + str(tid))
        emit_iface_box_drop(a, m, types.throw_type(tid), dir)
    }
    for mid in 0:m.maps.len {
        a.label(drop_iface_name(dir) + "_m" + str(mid))
        emit_iface_box_drop(a, m, types.map_type(mid), dir)
    }
    for fid in 0:m.fn_sigs.len {
        a.label(drop_iface_name(dir) + "_f" + str(fid))
        emit_iface_box_drop(a, m, types.fn_type(fid), dir)
    }
    a.label(drop_iface_name(dir) + "_free")
    a.mov(18, 8)
    a.call("_rt_free")
    a.label(drop_iface_name(dir) + "_done")
    a.label(drop_iface_name(dir) + "_skip")
    a.load(9, 15, -8)
    a.epilogue()
    <<
}

// `_start`: call main, exit with its << value.

// Compiler-managed hook then deep field cleanup. Buffer values are marshalled
// to the ordinary downward frame layout expected by a user &mut receiver.
// The value is dying: ownership moves to this scratch frame, never cloned.
fn emit_resource_drop(a &mut Assembler, m &types.Mir, si int, base_off int, dir int) {
    if dir < 0 {
        a.mov(18, 9)
        if base_off > 0 { a.vm_add_imm(18, 18, base_off) }
        if base_off < 0 { a.vm_sub_imm(18, 18, 0 - base_off) }
        emit_drop_call(a, m.structs[si].drop_label + "")
        for i in 0:m.structs[si].fields.len {
            fty := m.structs[si].fields[i].ty
            if m.type_owning(fty) {
                emit_drop_value(a, m, fty, base_off - m.structs[si].fields[i].slot, -1)
            }
        }
        <<
    }
    slots := m.structs[si].nslots
    bytes := ((slots * 8 + 31) / 16) * 16
    a.vm_sub_imm(16, 16, bytes)
    a.store(16, bytes - 8, 9)
    for i in 0:slots {
        a.load(0, 9, base_off + i * 8)
        a.store(16, bytes - 16 - i * 8, 0)
    }
    a.mov(9, 16)
    a.vm_add_imm(9, 9, bytes - 16)
    a.mov(18, 9)
    emit_drop_call(a, m.structs[si].drop_label + "")
    for i in 0:m.structs[si].fields.len {
        fty := m.structs[si].fields[i].ty
        if m.type_owning(fty) { emit_drop_value(a, m, fty, 0 - m.structs[si].fields[i].slot, -1) }
    }
    a.load(9, 16, bytes - 8)
    a.vm_add_imm(16, 16, bytes)
}
