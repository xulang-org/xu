@main

#xu/types

// Word-elem ArrPush (id==8): inline `_rt_ap_room8` when len < cap; otherwise
// fall through to `_rt_arr_push` for grow. Cuts the bl+96B prologue on the
// array_ops push loop (2e6 hits, ~log2 grows).
fn rt_pack_vr(a &Assembler) int {
    if a.arch == 0 { << 12 }
    << 9
}

fn chan_pack_align(n int) int {
    b := n * 8 + 15
    << b - (b % 16)
}

fn chan_pack_open(a &mut Assembler, n int, pack int) {
    a.vm_sub_imm(16, 16, chan_pack_align(n))
    a.mov(pack, 16)
    <<
}

fn chan_pack_close(a &mut Assembler, n int) {
    a.vm_add_imm(16, 16, chan_pack_align(n))
    <<
}

fn arr_push_desc_local(m &types.Mir, fi int, ia int) int {
    for ji in 0:types.mir_nins(m, fi) {
        ik := types.mir_ikind(m, fi, ji)
        if ik == types.mi_addr && types.mir_ic(m, fi, ji) == 0 {
            if types.mir_ia(m, fi, ji) == ia {
                << types.mir_ib(m, fi, ji)
            }
        }
        if ik == types.mi_load_local && types.mir_ia(m, fi, ji) == ia {
            << types.mir_ib(m, fi, ji)
        }
    }
    << -1
}

// kind-12 emit grows fp+slot as a 3-slot inline descriptor. A 1-slot
// `&mut []T` is a pointer to the live desc; peeping it leaves len=n
// with data=null (Gen2 SIGSEGV on `out.push` + `out[0]=true`).
fn arr_push_desc_inline(m &types.Mir, fi int, ia int) int {
    loc := arr_push_desc_local(m, fi, ia)
    if loc < 0 { << -1 }
    if loc >= types.mir_nlocals(m, fi) { << -1 }
    if types.mir_local_nslots(m, fi, loc) < 3 { << -1 }
    << loc
}

// V0 = &live descriptor. Prefer the frame local over a pointer temp:
// a 3-slot copy taken before grow leaves jmp_map[t] on a freed buffer
// (gen2 SIGSEGV in mir_contract_empty_jumps / parse_duration).
fn emit_arr_push_desc_ptr(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ia int, ic int) {
    loc := arr_push_desc_local(m, fi, ia)
    if loc >= 0 && loc < fr.local_slot.len {
        if loc < m.fns[fi].locals_nslots.len && types.mir_local_nslots(m, fi, loc) >= 3 {
            a.mov(0, 15)
            a.vm_sub_imm(0, 0, -slot_off(fr.local_slot[loc]))
            <<
        }
        a.load(0, 15, slot_off(fr.local_slot[loc]))
        <<
    }
    if ic == 1 {
        // A field address may have a fixed scalar home. Never interpret its
        // encoded register slot as an offset into the frame.
        emit_load_value(a, m, fi, fr, ia, 0)
        <<
    }
    a.mov(0, 15)
    a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
    <<
}

fn block_push8_ii(m &types.Mir, fi int, bi int) int {
    mut found := -1
    mut n := 0
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        ik := types.mir_ikind(m, fi, ii)
        // Call clobbers x9–x11; the push cursor lives there.
        if ik == types.mi_call || ik == types.mi_load_index || ik == types.mi_store_index || ik == types.mi_elem_addr || ik == types.mi_index_rmw {
            << -1
        }
        if ik == types.mi_arr_push && types.mir_id(m, fi, ii) == 8 {
            n = n + 1
            found = ii
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if n == 1 {
        << found
    }
    << -1
}

fn block_push8_local(m &types.Mir, fi int, bi int) int {
    mut found := -1
    mut n := 0
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        ik := types.mir_ikind(m, fi, ii)
        if ik == types.mi_call || ik == types.mi_load_index || ik == types.mi_store_index || ik == types.mi_elem_addr || ik == types.mi_index_rmw {
            << -1
        }
        if ik == types.mi_arr_push && types.mir_id(m, fi, ii) == 8 {
            n = n + 1
            loc := arr_push_desc_local(m, fi, types.mir_ia(m, fi, ii))
            if loc >= 0 {
                found = loc
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if n == 1 {
        << found
    }
    << -1
}

fn mir_temp_copied_const(m &types.Mir, fi int, t int) int {
    if t < 0 { << 0 }
    for ji in 0:types.mir_nins(m, fi) {
        if types.mir_ikind(m, fi, ji) == types.mi_copy && types.mir_ia(m, fi, ji) == t {
            src := types.mir_ib(m, fi, ji)
            if src < 0 {
                ci := -src - 2
                if ci >= 0 && ci < types.mir_nconsts(m, fi) {
                    << types.mir_const_at(m, fi, ci)
                }
            }
        }
    }
    << 0
}

fn push_loop_const_limit(m &types.Mir, fi int, bi int) int {
    if types.mir_btkind(m, fi, bi) != 2 { << 0 }
    if types.mir_btb(m, fi, bi) != bi { << 0 }
    mut lim := 0
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == types.mi_bin && types.mir_ib(m, fi, ii) == 8 {
            lc := types.mir_ic(m, fi, ii)
            ld := types.mir_id(m, fi, ii)
            mut c := 0
            if ld < 0 {
                ci := -ld - 2
                if ci >= 0 && ci < types.mir_nconsts(m, fi) {
                    c = types.mir_const_at(m, fi, ci)
                }
            } else {
                c = mir_temp_copied_const(m, fi, ld)
            }
            if c <= 16 && lc < 0 {
                ci := -lc - 2
                if ci >= 0 && ci < types.mir_nconsts(m, fi) {
                    c = types.mir_const_at(m, fi, ci)
                }
            } else if c <= 16 {
                c = mir_temp_copied_const(m, fi, lc)
            }
            if c > 16 { lim = c }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << lim
}

fn fn_has_push8_self_loop(m &types.Mir, fi int) int {
    for bi in 0:types.mir_nblocks(m, fi) {
        tkind := types.mir_btkind(m, fi, bi)
        mut sl := false
        if tkind == 1 && types.mir_bta(m, fi, bi) == bi {
            sl = true
        }
        if tkind == 2 && (types.mir_btb(m, fi, bi) == bi || types.mir_btc(m, fi, bi) == bi) {
            sl = true
        }
        if sl {
            if block_push8_local(m, fi, bi) >= 0 {
                << 1
            }
        }
    }
    << 0
}

fn emit_push_cursor_writeback(a &mut Assembler) {
    if a.rc_push_loc < 0 { << }
    a.store(15, a.rc_push_ptr_off, 11)
    a.store(15, a.rc_push_len_off, 9)
    a.store(15, a.rc_push_cap_off, 10)
    a.rc_push_dirty = 0
    <<
}

fn emit_push_cursor_clear(a &mut Assembler) {
    emit_push_cursor_writeback(a)
    a.rc_push_loc = -1
    <<
}

fn emit_push_cursor_reload(a &mut Assembler) {
    if a.rc_push_loc < 0 { << }
    a.load(9, 15, a.rc_push_len_off)
    a.load(10, 15, a.rc_push_cap_off)
    a.load(11, 15, a.rc_push_ptr_off)
    a.rc_push_dirty = 0
    <<
}

fn emit_seed_push_cursor(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, pins &[]int) int {
    if a.arch != 0 { << 0 }
    if !a.rc_on { << 0 }
    loc := block_push8_local(m, fi, bi)
    if loc < 0 { << 0 }
    if loc >= fr.local_slot.len { << 0 }
    if a.rc_s_pool {
        if a.rc_pin[1] >= 0 { << 0 }
        if a.rc_pin[2] >= 0 { << 0 }
        if a.rc_pin[3] >= 0 { << 0 }
    }
    base := fr.local_slot[loc]
    a.rc_push_loc = loc
    a.rc_push_ptr_off = slot_off(base)
    a.rc_push_len_off = slot_off(base) - 8
    a.rc_push_cap_off = slot_off(base) - 16
    a.rc_push_dirty = 0
    a.load(9, 15, a.rc_push_len_off)
    a.load(10, 15, a.rc_push_cap_off)
    a.load(11, 15, a.rc_push_ptr_off)
    a.rc_s_hold[1] = -2
    a.rc_s_hold[2] = -2
    a.rc_s_hold[3] = -2
    lim := push_loop_const_limit(m, fi, bi)
    if lim > 16 {
        skip := types.mir_fn_label(m, fi) + "_bb" + str(bi) + "_ag"
        a.vm_mov_imm64(0, lim)
        a.cmp(10, 0)
        a.jge(skip + "")
        emit_push_cursor_writeback(a)
        rc_spill_across_call(a)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, 0 - a.rc_push_ptr_off)
        a.mov(18, 0)
        a.vm_mov_imm64(19, lim)
        a.vm_mov_imm(20, 8)
        a.call("_rt_arr_grow")
        emit_push_cursor_reload(a)
        if a.rc_const_vr == 7 {
            a.vm_mov_imm64(7, a.rc_const_val)
        }
        a.label(skip + "")
    }
    pii := block_push8_ii(m, fi, bi)
    a.rc_push_ii = pii
    a.rc_push_val_loc = -1
    if pii >= 0 {
        a.rc_push_elem = types.mir_ib(m, fi, pii)
        a.rc_push_val_loc = arr_push_desc_local(m, fi, a.rc_push_elem)
        if a.rc_push_val_loc < 0 {
            a.rc_push_val_loc = a.rc_ind_local
        }
    }
    a.rc_push_stub = 0
    if pii >= 0 {
        a.rc_push_slow = "_ap8_slow_" + str(fi) + "_" + str(pii)
        a.rc_push_done = "_ap8_done_" + str(fi) + "_" + str(pii)
    }
    << 1
}

fn emit_push_grow_stub(a &mut Assembler, m &types.Mir, fi int, fr &Frame) {
    if a.rc_push_loc < 0 { << }
    if a.rc_push_slow.len == 0 { << }
    ii := a.rc_push_ii
    ib := a.rc_push_elem
    a.label(a.rc_push_slow + "")
    emit_push_cursor_writeback(a)
    mut ev := 8
    if a.rc_push_val_loc >= 0 && a.rc_push_val_loc < fr.local_slot.len {
        vs := fr.local_slot[a.rc_push_val_loc]
        p := rc_pin_index(&*a, vs)
        if p >= 0 {
            ev = rc_pin_vr(&*a, p)
        } else {
            a.load(0, 15, slot_off(vs))
            ev = 0
        }
    }
    if ib >= 0 {
        a.store(15, slot_off(fr.temp_slot[ib]), ev)
    }
    rc_spill_across_call(a)
    a.mov(0, 15)
    a.vm_sub_imm(0, 0, 0 - a.rc_push_ptr_off)
    a.mov(18, 0)
    a.mov(0, 15)
    if ib >= 0 {
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ib]))
    }
    a.mov(19, 0)
    a.vm_mov_imm(20, 8)
    a.call("_rt_arr_push")
    emit_push_cursor_reload(a)
    if a.rc_const_vr == 7 {
        a.vm_mov_imm64(7, a.rc_const_val)
    }
    a.jmp(a.rc_push_done + "")
    a.rc_push_stub = 1
    <<
}

fn emit_arr_push8_fast(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ia := types.mir_ia(m, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    slow := "_ap8_slow_" + str(fi) + "_" + str(ii)
    done := "_ap8_done_" + str(fi) + "_" + str(ii)
    if a.rc_push_loc >= 0 && a.arch == 0 {
        a.cmp(9, 10)
        a.jge(slow + "")
        mut val := 0
        if ib >= 0 {
            val = rc_load_reg(a, m, fi, fr, ib, 0)
        }
        if val == 9 || val == 10 || val == 11 {
            a.mov(0, val)
            val = 0
        }
        a.store_scaled(11, 9, val, 8)
        a.vm_add_imm(9, 9, 1)
        a.rc_push_dirty = 1
        if a.rc_push_stub == 1 {
            a.label(done + "")
            <<
        }
        a.jmp(done + "")
        a.label(slow + "")
        emit_push_cursor_writeback(a)
        mut ev := 0
        if ib >= 0 {
            ev = rc_load_reg(a, m, fi, fr, ib, 0)
        }
        a.store(15, slot_off(fr.temp_slot[ib]), ev)
        rc_spill_across_call(a)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, 0 - a.rc_push_ptr_off)
        a.mov(18, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ib]))
        a.mov(19, 0)
        a.vm_mov_imm(20, 8)
        a.call("_rt_arr_push")
        emit_push_cursor_reload(a)
        if a.rc_const_vr == 7 {
            a.vm_mov_imm64(7, a.rc_const_val)
        }
        a.label(done + "")
        <<
    }
    // V0=&desc, V1=len, Ret=cap then elem addr. V2–V7/S0–S5 are vreg
    // homes; touching them here SIGILL'd matmul_tiny when ArrPush was
    // admitted as call-live.
    emit_arr_push_desc_ptr(a, m, fi, fr, ia, ic)
    a.load(1, 0, -8)
    a.load(14, 0, -16)
    a.cmp(1, 14)
    a.jge(slow + "")
    a.load(14, 0, 0)
    a.shl_imm(0, 1, 3)
    a.add(14, 14, 0)
    if a.has_int64_pairs() {
        a.t_mov_reg(2, td_thumb_phys(14))
        if ib <= -2 {
            c := types.mir_const_at(m, fi, 0 - ib - 2)
            a.t_mov_imm64_pair(0, 1, c)
        } else if ib >= 0 && ib < fr.temp_slot.len {
            a.t_load64_offset(0, 1, 7, slot_off(fr.temp_slot[ib]))
        }
        a.t_store64_offset(0, 1, 2, 0)
    } else {
        if ib >= 0 {
            emit_load_value(a, m, fi, fr, ib, 0)
        } else {
            a.vm_mov_imm64(0, types.mir_const_at(m, fi, 0 - ib - 2))
        }
        a.store(14, 0, 0)
    }
    emit_arr_push_desc_ptr(a, m, fi, fr, ia, ic)
    a.vm_add_imm(1, 1, 1)
    a.store(0, -8, 1)
    loc := arr_push_desc_local(m, fi, ia)
    if loc >= 0 && loc < fr.local_slot.len {
        base := fr.local_slot[loc]
        rc_forget_slot(a, base)
        rc_forget_slot(a, base + 1)
        rc_forget_slot(a, base + 2)
    }
    a.jmp(done + "")
    a.label(slow + "")
    rc_spill_across_call(a)
    emit_arr_push_desc_ptr(a, m, fi, fr, ia, ic)
    a.mov(18, 0)
    mut spilled := 0
    if ib >= 0 && ib < fr.temp_slot.len && (is_vreg_slot(fr.temp_slot[ib]) || is_fp_vreg_slot(fr.temp_slot[ib])) {
        a.vm_sub_imm(16, 16, 16)
        spilled = 1
        if a.has_int64_pairs() {
            a.t_load64_offset(0, 1, 7, slot_off(fr.temp_slot[ib]))
            a.t_store64_offset(0, 1, 13, 0)
        } else {
            emit_load_value(a, m, fi, fr, ib, 0)
            a.store(16, 0, 0)
        }
        a.mov(19, 16)
    } else if ib >= 0 {
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ib]))
        a.mov(19, 0)
    } else {
        a.vm_sub_imm(16, 16, 16)
        spilled = 1
        if a.has_int64_pairs() {
            c := types.mir_const_at(m, fi, 0 - ib - 2)
            a.t_mov_imm64_pair(0, 1, c)
            a.t_store64_offset(0, 1, 13, 0)
        } else {
            a.vm_mov_imm64(0, types.mir_const_at(m, fi, 0 - ib - 2))
            a.store(16, 0, 0)
        }
        a.mov(19, 16)
    }
    a.vm_mov_imm(20, 8)
    a.call("_rt_arr_push")
    if spilled == 1 {
        a.vm_add_imm(16, 16, 16)
    }
    if a.rc_const_vr == 7 {
        a.vm_mov_imm64(7, a.rc_const_val)
    }
    a.label(done + "")
    <<
}

fn mir_val_const_fast(m &types.Mir, fi int, v int) int {
    if v <= -2 { << v }
    if v < 0 { << -1 }
    nins := types.mir_nins(m, fi)
    mut ji := nins - 1
    while ji >= 0 {
        if types.mir_ia(m, fi, ji) == v {
            if types.mir_ikind(m, fi, ji) == types.mi_copy {
                src := types.mir_ib(m, fi, ji)
                if src <= -2 { << src }
            }
            << -1
        }
        ji -= 1
    }
    << -1
}

fn emit_instr_own(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ik := types.mir_ikind(m, fi, ii)
    ia := types.mir_ia(m, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    id := types.mir_id(m, fi, ii)
    if ik == types.mi_throw_unwrap { // Result.unwrap()/expr!: tag 0 -> copy payload; Err -> rt_unwrap_fail
        a.load(0, 15, slot_off(fr.temp_slot[ib]))
        a.vm_cbz(0, "_unwrap_ok_" + str(fi) + "_" + str(ii))
        // M38: A0/A1 = Err string payload (ptr,len) when the error type is
        // string (ic==1); 0/0 otherwise (generic message). rt_unwrap_fail
        // prints `unwrap on Err[: <msg>]\n`, then exits 1 (or longjmps into
        // the --test harness); it never returns.
        if ic == 1 {
            a.load(0, 15, slot_off(fr.temp_slot[ib]) - 8)
            a.mov(18, 0)
            a.load(0, 15, slot_off(fr.temp_slot[ib]) - 16)
            a.mov(19, 0)
        } else {
            a.vm_mov_imm(18, 0)
            a.vm_mov_imm(19, 0)
        }
        a.call("_rt_unwrap_fail")
        a.label("_unwrap_ok_" + str(fi) + "_" + str(ii))
        for i in 0:id {
            a.load(0, 15, slot_off(fr.temp_slot[ib]) - (i + 1) * 8)
            a.store(15, slot_off(fr.temp_slot[ia]) - i * 8, 0)
        }
        <<
    }
    if ik == types.mi_throw_unwrap_err { // Result.unwrap_err (M157): tag 1 -> copy Err; Ok -> rt_unwrap_err_fail
        a.load(0, 15, slot_off(fr.temp_slot[ib]))
        a.vm_cbnz(0, "_unwrap_err_ok_" + str(fi) + "_" + str(ii))
        a.call("_rt_unwrap_err_fail")
        a.label("_unwrap_err_ok_" + str(fi) + "_" + str(ii))
        for i in 0:id {
            a.load(0, 15, slot_off(fr.temp_slot[ib]) - (i + 1) * 8)
            a.store(15, slot_off(fr.temp_slot[ia]) - i * 8, 0)
        }
        <<
    }
    if ik == types.mi_array_lit { // ArrayLit: alloc(cnt * elem_sz), store each elem, init desc
        // ib = count, ic = arg chain head, id = elem_size (in bytes).
        n_elems := ib
        bytes := n_elems * id

        mut all_const := false
        if n_elems >= 8 && id <= 8 {
            all_const = true
            mut ai_chk := ic
            for _ in 0:n_elems {
                if ai_chk < 0 {
                    all_const = false
                    <-
                }
                v := types.mir_marg_v(m, fi, ai_chk)
                cv := mir_val_const_fast(m, fi, v)
                if cv > -2 {
                    all_const = false
                    <-
                }
                ai_chk = types.mir_marg_next(m, fi, ai_chk)
            }
        }
        if all_const {
            lab := types.mir_fn_label(m, fi) + "_alit" + str(ii)
            a.align_data(8)
            a.data_label(lab + "")
            mut ai_data := ic
            while ai_data >= 0 {
                v := types.mir_marg_v(m, fi, ai_data)
                cv := mir_val_const_fast(m, fi, v)
                cval := types.mir_const_at(m, fi, 0 - cv - 2)
                if id == 8 {
                    rt_emit_u64(a, cval)
                } else if id == 4 {
                    for bidx in 0:4 {
                        a.emit_data([(cval >> (bidx * 8)) & 255])
                    }
                } else if id == 2 {
                    a.emit_data([cval & 255])
                    a.emit_data([(cval >> 8) & 255])
                } else if id == 1 {
                    a.emit_data([cval & 255])
                } else {
                    rt_emit_u64(a, cval)
                }
                ai_data = types.mir_marg_next(m, fi, ai_data)
            }
            rem := a.data.len % 8
            if rem != 0 {
                rt_emit_zeros(a, 8 - rem)
            }

            a.lea(1, lab + "")
            a.store(15, slot_off(fr.temp_slot[ia]), 1)
            if a.has_int64_pairs() {
                a.t_mov_imm64_pair(0, 2, n_elems)
                a.t_store64_offset(0, 2, 7, slot_off(fr.temp_slot[ia]) - 8)
                a.t_mov_imm64_pair(0, 2, 0)
                a.t_store64_offset(0, 2, 7, slot_off(fr.temp_slot[ia]) - 16)
            } else {
                a.vm_mov_imm(0, n_elems)
                a.store(15, slot_off(fr.temp_slot[ia]) - 8, 0)
                a.vm_mov_imm(0, 0)
                a.store(15, slot_off(fr.temp_slot[ia]) - 16, 0)
            }
            <<
        }
        // Fixed-array inline path is disabled: an earlier attempt SIGSEGV'd
        // nbody `[5]Body{...}` / `[4]int{...}` (acceptance). Keep the heap
        // 3-slot descriptor; ledger leftover for typed `[N]T` remains open.
        if n_elems == 0 {
            // `[]T{}` is the canonical zero descriptor.  Do not call
            // `_rt_alloc(0)`: capability-gated Gen1 drops intentionally skip
            // zero-cap buffers, so allocating one here would create an
            // unbalanced ledger entry and retain a bogus pointer.
            a.vm_mov_imm(1, 0)
        } else {
            // ArrayLit hides a runtime call inside a non-Call MIR instruction.
            // Spill/invalidate parks first so a live parameter or local used by
            // a following dynamic index is not mistaken for surviving
            // `_rt_alloc`.  This is the same call barrier used by explicit
            // Call emission.
            rc_spill_across_call(a)
            // ptr = alloc(bytes) — arg in A0, result in Ret (=x14).
            a.vm_mov_imm(18, bytes)
            a.call("_rt_alloc")
            // Save ptr into a scratch reg (V1 = x9) so subsequent loads don't clobber.
            a.mov(1, 14)
        }
        // For each elem, load from its temp and byte-store to ptr[i*elem_sz].
        mut ai := ic
        for i in 0:n_elems {
            if ai >= 0 {
                v := types.mir_marg_v(m, fi, ai)
                if id == 1 {
                    if v >= 0 { a.load(0, 15, slot_off(fr.temp_slot[v])) } else { emit_load_value(a, m, fi, fr, v, 0) }
                    a.store_byte(1, i * id, 0)
                } else if id == 4 {
                    if v >= 0 { a.load(0, 15, slot_off(fr.temp_slot[v])) } else { emit_load_value(a, m, fi, fr, v, 0) }
                    a.store_byte(1, i * id, 0)
                    a.shr_imm(2, 0, 8)
                    a.store_byte(1, i * id + 1, 2)
                    a.shr_imm(2, 0, 16)
                    a.store_byte(1, i * id + 2, 2)
                    a.shr_imm(2, 0, 24)
                    a.store_byte(1, i * id + 3, 2)
                } else if id == 8 && a.has_int64_pairs() {
                    if v >= 0 {
                        a.t_load64_offset(0, 2, 7, slot_off(fr.temp_slot[v]))
                    } else {
                        c := types.mir_const_at(m, fi, 0 - v - 2)
                        a.t_mov_imm64_pair(0, 2, c)
                    }
                    a.t_store64_offset(0, 2, td_thumb_phys(1), i * 8)
                } else {
                    n_chunks := id / 8
                    for j in 0:n_chunks {
                        if v >= 0 {
                            a.load(0, 15, slot_off(fr.temp_slot[v]) - j * 8)
                        } else {
                            emit_load_value(a, m, fi, fr, v, 0)
                        }
                        a.store(1, i * id + j * 8, 0)
                    }
                }
                ai = types.mir_marg_next(m, fi, ai)
            }
        }
        // Set dest descriptor: slot 0 = ptr, slot -8 = len, slot -16 = cap.
        a.store(15, slot_off(fr.temp_slot[ia]), 1)
        if a.has_int64_pairs() {
            a.t_mov_imm64_pair(0, 2, n_elems)
            a.t_store64_offset(0, 2, 7, slot_off(fr.temp_slot[ia]) - 8)
            a.t_store64_offset(0, 2, 7, slot_off(fr.temp_slot[ia]) - 16)
        } else {
            a.vm_mov_imm(0, n_elems)
            a.store(15, slot_off(fr.temp_slot[ia]) - 8, 0)
            a.vm_mov_imm(0, n_elems)
            a.store(15, slot_off(fr.temp_slot[ia]) - 16, 0)
        }
        <<
    }
    if ik == types.mi_arr_push { // ArrPush: arr (ia=base) <- append v (ib=value temp)
        // Runtime ABI: A0=&descriptor, A1=&element, A2=element bytes.
        // id==8 (word elem): inline the room-available path; grow still calls.
        if id == 8 {
            emit_arr_push8_fast(a, m, fi, fr, ii)
            <<
        }
        emit_arr_push_desc_ptr(a, m, fi, fr, ia, ic)
        a.mov(18, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ib]))
        a.mov(19, 0)
        a.vm_mov_imm(20, id)
        a.call("_rt_arr_push")
        loc := arr_push_desc_local(m, fi, ia)
        if loc >= 0 && loc < fr.local_slot.len {
            base := fr.local_slot[loc]
            rc_forget_slot(a, base)
            rc_forget_slot(a, base + 1)
            rc_forget_slot(a, base + 2)
        }
        <<
    }
    if ik == types.mi_arr_push4 { // ArrPush4: a=desc-addr, b=marg head of 4 int temps
        if ic == 1 {
            a.load(0, 15, slot_off(fr.temp_slot[ia]))
        } else {
            a.mov(0, 15)
            a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        }
        a.mov(18, 0)
        mut ai := ib
        mut slot := 0
        while ai >= 0 && slot < 4 {
            v := types.mir_marg_v(m, fi, ai)
            emit_load_value(a, m, fi, fr, v, arg_reg(slot + 1))
            ai = types.mir_marg_next(m, fi, ai)
            slot += 1
        }
        a.call("_rt_arr_push4")
        <<
    }
    if ik == types.mi_result_test { // ResultTest: dest = (is_ok or is_err) on Result ib
        // Load tag at slot 0 of the Result. 0 = Ok, 1 = Err (s3c convention).
        a.load(0, 15, slot_off(fr.temp_slot[ib]))
        if types.mir_isval(m, fi, ii) == "is_ok" {
            a.vm_cmp_imm(0, 0) // V0 == 0 ?
            a.vm_cset(0, 0)    // V0 = 1 if Ok else 0
        } else {
            a.vm_mov_imm(1, 1)
            a.cmp(0, 1)
            a.vm_cset(0, 0)    // V0 = 1 if Err else 0
        }
        a.store(15, slot_off(fr.temp_slot[ia]), 0)
        <<
    }
    if ik == types.mi_drop { // Drop owning local (deep drop via emit_drop_value).
        ty := types.mir_local_ty(m, fi, ia)
        a.vm_sub_imm(16, 16, 16)
        a.store(16, 0, 9)
        a.mov(9, 15)
        a.vm_sub_imm(9, 9, -slot_off(fr.local_slot[ia]))
        emit_drop_value(a, m, ty, 0, -1)
        a.load(9, 16, 0)
        a.vm_add_imm(16, 16, 16)
        // free clobbers V/a parks (base ptr may have lived in x10).
        rc_spill_across_call(a)
        <<
    }
    if ik == types.mi_drop_field { // DropField: base temp frame, field at byte offset b, type c
        a.vm_sub_imm(16, 16, 16)
        a.store(16, 0, 9)
        a.mov(9, 15)
        a.vm_sub_imm(9, 9, -frame_byte_off(fr.temp_slot[ia], ib))
        emit_drop_value(a, m, ic, 0, -1)
        a.load(9, 16, 0)
        a.vm_add_imm(16, 16, 16)
        rc_spill_across_call(a)
        <<
    }
    if ik == types.mi_drop_ptr_field { // DropPtrField: pointer temp a, field byte offset b, type c
        a.vm_sub_imm(16, 16, 16)
        a.store(16, 0, 9)
        a.load(9, 15, slot_off(fr.temp_slot[ia]))
        w := ib / 8
        r := ib % 8
        if w > 0 { a.vm_sub_imm(9, 9, w * 8) }
        if r > 0 { a.vm_add_imm(9, 9, r) }
        emit_drop_value(a, m, ic, 0, -1)
        a.load(9, 16, 0)
        a.vm_add_imm(16, 16, 16)
        rc_spill_across_call(a)
        <<
    }
    if ik == types.mi_drop_buf_field { // DropBufField: buffer pointer a, field byte offset b, type c
        a.vm_sub_imm(16, 16, 16)
        a.store(16, 0, 9)
        a.load(9, 15, slot_off(fr.temp_slot[ia]))
        if ib > 0 {
            a.vm_add_imm(9, 9, ib)
        }
        emit_drop_value(a, m, ic, 0, 1)
        a.load(9, 16, 0)
        a.vm_add_imm(16, 16, 16)
        rc_spill_across_call(a)
        <<
    }
    <<
}

// W3: StrConst / LoadFnAddr / MakeClosure — split from emit_instr_iface.
fn emit_instr_iface_lit(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ik := types.mir_ikind(m, fi, ii)
    ia := types.mir_ia(m, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    if ik == types.mi_str_const { // StrConst
        a.lea_str(0, ib)
        emit_store_temp(a, fr, ia, 0)
        slen := m.strings[ib].len
        a.vm_mov_imm(0, slen)
        a.store(15, slot_off(fr.temp_slot[ia]) - 8, 0)
        // Literals are static and read-only: cap = 0.
        a.vm_mov_imm(0, 0)
        a.store(15, slot_off(fr.temp_slot[ia]) - 16, 0)
        <<
    }
    if ik == types.mi_load_fn_addr { // LoadFnAddr a=dest sval=label (M103/M109 fat: code + env=0)
        // `sval` is the fn-value shim label.  Use the string label path on
        // every target: `lea` takes a VM dest (V0 → physical X8 on ARM64),
        // matching `emit_store_temp(..., 0)` below.  The old ARM64
        // `lea_hash(8, …)` passed a physical X8; rewriting that as `lea(8, …)`
        // mapped VM V8 → X19 and left V0 stale, so fat-pointer stores of
        // named fn values were garbage (apply(f, x) SIGBUS).
        a.lea(0, types.mir_isval(m, fi, ii))
        emit_store_temp(a, fr, ia, 0)
        a.vm_mov_imm(0, 0)
        a.store(15, slot_off(fr.temp_slot[ia]) - 8, 0)
        <<
    }
    // MakeClosure a=dest b=env c=struct_id sval=label
    // Heapify env in frame layout (word k at base-8k); env ptr =
    // alloc + (n-1)*8 so FieldBase::Ptr loads work.
    nslots := m.structs[ic].nslots
    bytes := nslots * 8
    rc_spill_across_call(a)
    a.vm_mov_imm(18, bytes)
    a.call("_rt_alloc")
    a.mov(1, 14) // V1 = alloc base
    if nslots > 0 {
        a.vm_add_imm(1, 1, (nslots - 1) * 8) // env_ptr
    }
    for i in 0:nslots {
        a.load(0, 15, slot_off(fr.temp_slot[ib]) - i * 8)
        a.store(1, -i * 8, 0)
    }
    a.lea(0, types.mir_isval(m, fi, ii))
    a.store(15, slot_off(fr.temp_slot[ia]), 0) // code
    a.store(15, slot_off(fr.temp_slot[ia]) - 8, 1) // env
    <<
}

// W3: BoxInterface / BoxTemp / InterfaceIs — split from emit_instr_iface.
fn emit_instr_iface_box(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ik := types.mir_ikind(m, fi, ii)
    ia := types.mir_ia(m, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    id := types.mir_id(m, fi, ii)
    if ik == types.mi_box_interface { // BoxInterface a=dest b=src c=concrete struct id sval=itable
        // Heapify the frame-layout concrete value and pair it with its itable.
        nslots := m.structs[ic].nslots
        rc_spill_across_call(a)
        a.vm_mov_imm(18, nslots * 8)
        a.call("_rt_alloc")
        a.mov(1, 14)
        if nslots > 0 {
            a.vm_add_imm(1, 1, (nslots - 1) * 8)
        }
        for i in 0:nslots {
            a.load(0, 15, slot_off(fr.temp_slot[ib]) - i * 8)
            a.store(1, -i * 8, 0)
        }
        a.store(15, slot_off(fr.temp_slot[ia]), 1)
        mut itab := types.mir_isval(m, fi, ii)
        if itab == "" {
            itab = "_xu_itab_errors_Error_" + m.structs[ic].name
        }
        a.lea(0, itab)
        a.store(15, slot_off(fr.temp_slot[ia]) - 8, 0)
        <<
    }
    if ik == types.mi_box_temp { // BoxTemp a=dest b=src c=value tag d=nslots sval=itable
        tag := ic
        mut nslots := id
        if nslots < 1 {
            nslots = types.any_value_nslots(tag)
        }
        rc_spill_across_call(a)
        a.vm_mov_imm(18, nslots * 8)
        a.call("_rt_alloc")
        a.mov(1, 14)
        if nslots > 0 {
            a.vm_add_imm(1, 1, (nslots - 1) * 8)
        }
        for i in 0:nslots {
            a.load(0, 15, slot_off(fr.temp_slot[ib]) - i * 8)
            a.store(1, -i * 8, 0)
        }
        a.store(15, slot_off(fr.temp_slot[ia]), 1)
        mut itab := types.mir_isval(m, fi, ii)
        if itab == "" {
            itab = types.any_itab_label(tag)
        }
        a.lea(0, itab)
        a.store(15, slot_off(fr.temp_slot[ia]) - 8, 0)
        <<
    }
    // InterfaceIs a=dest b=iface c=concrete struct id
    // Compare itable.type_id with expected concrete struct id.
    a.load(0, 15, slot_off(fr.temp_slot[ib]) - 8) // itable*
    a.load(0, 0, 0) // type_id
    // any tags and high family ids need 64-bit materialization.
    if ic >= types.any_tag_int || ic < 0 {
        a.vm_mov_imm64(1, ic)
    } else {
        a.vm_mov_imm(1, ic)
    }
    a.cmp(0, 1)
    a.vm_cset(0, 0) // Eq → bool
    a.store(15, slot_off(fr.temp_slot[ia]), 0)
    <<
}

// W3: InterfaceAs — split from emit_instr_iface.
fn emit_instr_iface_as(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ia := types.mir_ia(m, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    id := types.mir_id(m, fi, ii)
    // InterfaceAs a=dest T b=iface c=type_id d=concrete type tag
    concrete_ty := id
    // MIR lowering creates the destination temp with the checked concrete
    // layout width. Reuse that width here instead of recursively walking the
    // type table from the hosted emitter: this covers every multi-word
    // payload family and keeps the Gen1 large-Mir call graph small. The
    // emission verifier proves the bounds before this function is reached;
    // the defensive fallback keeps malformed legacy MIR fail-closed.
    mut nslots := 1
    if ia >= 0 && ia < types.mir_ntemps(m, fi) {
        nslots = types.mir_temp_nslots(m, fi, ia)
    }
    if nslots < 1 || nslots > types.mir_max_layout_words {
        nslots = 1
    }
    a.load(10, 15, slot_off(fr.temp_slot[ib])) // data*
    a.load(0, 15, slot_off(fr.temp_slot[ib]) - 8) // itable*
    a.load(0, 0, 0)
    if ic >= types.any_tag_int || ic < 0 {
        a.vm_mov_imm64(1, ic)
    } else {
        a.vm_mov_imm(1, ic)
    }
    a.cmp(0, 1)
    a.vm_cset(0, 0)
    a.vm_cbnz(0, "_iface_as_ok_" + str(fi) + "_" + str(ii))
    keep := types.mir_isval(m, fi, ii) == "keep"
    // Fail: consume drops+frees; keep only fail-loud (box stays for abort leak).
    if !keep {
        a.mov(9, 10)
        if concrete_ty > 0 {
            emit_drop_value(a, m, concrete_ty, 0, -1)
        }
        a.mov(18, 10)
        if nslots > 1 { a.vm_sub_imm(18, 18, (nslots - 1) * 8) }
        a.call("_rt_free")
    }
    a.call("_rt_as_fail")
    a.label("_iface_as_ok_" + str(fi) + "_" + str(ii))
    if keep && concrete_ty == 3 {
        // Clone string out of the box; leave heap box alive.
        // ABI: A0/A1/A2 = src (ptr,len,cap); V0 = sret (see emit_instr_ops).
        a.load(0, 10, 0)
        a.mov(18, 0)
        a.load(0, 10, -8)
        a.mov(19, 0)
        a.load(0, 10, -16)
        a.mov(20, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_str_clone")
        <<
    }
    for i in 0:nslots {
        a.load(0, 10, -i * 8)
        a.store(15, slot_off(fr.temp_slot[ia]) - i * 8, 0)
    }
    if !keep {
        a.mov(18, 10)
        if nslots > 1 { a.vm_sub_imm(18, 18, (nslots - 1) * 8) }
        a.call("_rt_free")
    }
    <<
}

// Closed-world itable switch: first function whose name matches the
// InterfaceMethod sval and whose receiver is struct `sid`.
fn iface_method_sid(m &types.Mir, j int, fi int, ii int) int {
    if types.mir_fn_is_extern(m, j) { << -1 }
    if m.fns[j].name != types.mir_isval(m, fi, ii) { << -1 }
    if !types.mir_fn_receiver(m, j) { << -1 }
    if types.mir_nlocals(m, j) <= 0 { << -1 }
    recv_ty := types.mir_local_ty(m, j, 0)
    if types.is_struct_type(recv_ty) {
        << types.struct_index(recv_ty)
    }
    << -1
}

fn iface_method_sid_first(m &types.Mir, j int, fi int, ii int) int {
    sid := iface_method_sid(m, j, fi, ii)
    if sid < 0 { << -1 }
    for k in 0:j {
        if iface_method_sid(m, k, fi, ii) == sid {
            << -1
        }
    }
    << sid
}

struct IfaceLeaf {
    ok  int
    op  int
    imm int
}

// Value-receiver `fn (a T) f() int { << a.field [op k] }`. Read-only.
fn iface_leaf_info(m &types.Mir, j int) IfaceLeaf {
    mut z := IfaceLeaf{ok: 0, op: 0, imm: 0}
    if !types.mir_fn_receiver(m, j) {
        << z
    }
    if types.mir_fn_nparams(m, j) != 1 || types.mir_fn_ret_nslots(m, j) != 1 {
        << z
    }
    if types.mir_nblocks(m, j) <= 0 {
        << z
    }
    if types.mir_btkind(m, j, 0) != 3 {
        << z
    }
    retv := types.mir_bta(m, j, 0)
    if retv < 0 {
        << z
    }
    mut recv := -1
    mut loaded := -1
    mut result := -1
    mut did_load := false
    mut op := 0
    mut imm := 0
    mut ii := types.mir_bhead(m, j, 0)
    nins := types.mir_nins(m, j)
    for _ in 0:8 {
        if ii < 0 || ii >= nins {
            <-
        }
        k := types.mir_ikind(m, j, ii)
        if k == types.mi_load_local {
            if types.mir_ib(m, j, ii) == 0 {
                recv = types.mir_ia(m, j, ii)
            } else {
                << z
            }
        } else if k == types.mi_addr {
            if types.mir_ic(m, j, ii) == 0 && types.mir_ib(m, j, ii) == 0 {
                recv = types.mir_ia(m, j, ii)
            } else {
                << z
            }
        } else if k == types.mi_load_ptr {
            if types.mir_ib(m, j, ii) != recv {
                << z
            }
            if types.mir_id(m, j, ii) != 1 {
                << z
            }
            off := types.mir_ic(m, j, ii)
            if off != 0 {
                << z
            }
            loaded = types.mir_ia(m, j, ii)
            did_load = true
            result = loaded
        } else if k == types.mi_bin {
            if !did_load {
                << z
            }
            op = types.mir_ib(m, j, ii)
            l := types.mir_ic(m, j, ii)
            r := types.mir_id(m, j, ii)
            if l != loaded && r != loaded {
                << z
            }
            if r <= -2 {
                imm = types.mir_const_at(m, j, 0 - r - 2)
            } else if l <= -2 {
                imm = types.mir_const_at(m, j, 0 - l - 2)
            } else {
                << z
            }
            if op != 1 && op != 2 && op != 3 {
                << z
            }
            result = types.mir_ia(m, j, ii)
            did_load = true
            loaded = result
        } else {
            << z
        }
        ii = types.mir_inext(m, j, ii)
    }
    if ii >= 0 {
        << z
    }
    if result != retv || !did_load {
        << z
    }
    z.ok = 1
    z.op = op
    z.imm = imm
    << z
}

fn iface_is_leaf_val(m &types.Mir, j int) bool {
    lf := iface_leaf_info(m, j)
    << lf.ok == 1
}

fn iface_method_all_leaf(m &types.Mir, fi int, ii int) bool {
    mut n := 0
    for j in 0:m.fns.len {
        if iface_method_sid_first(m, j, fi, ii) >= 0 {
            n += 1
            if !iface_is_leaf_val(m, j) {
                << false
            }
        }
    }
    << n > 0
}

// data* scratch: S4 (vreg 12). Must not be an O1 V-pin (V2–V5 = 2–5)
// or an O2 S-pool pin (S0–S3 = 8–11). vreg 10 is S2 — O2 parked `s`/`i`
// there and iface_sum wrote a heap pointer over the accumulator.
fn iface_data_vr() int {
    << 12
}

// Two closed-world leaf impls that share `ldr [data*]`: one returns the
// field, the other applies add/sub/mul imm. One load + csel, then a cold
// type_id check for miss. ARM64 only; not a function-name gate.
fn emit_iface_two_leaf_val(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) bool {
    if a.arch != 0 && a.arch != 1 { << false }
    if types.mir_id(m, fi, ii) >= 0 { << false }
    mut n := 0
    mut ja := -1
    mut jb := -1
    for j in 0:m.fns.len {
        if iface_method_sid_first(m, j, fi, ii) < 0 { -> }
        if !iface_is_leaf_val(m, j) { << false }
        if n == 0 { ja = j }
        if n == 1 { jb = j }
        n += 1
        if n > 2 { << false }
    }
    if n != 2 || ja < 0 || jb < 0 { << false }
    la := iface_leaf_info(m, ja)
    lb := iface_leaf_info(m, jb)
    if la.ok != 1 || lb.ok != 1 { << false }
    mut j_id := -1
    mut j_op := -1
    if la.op == 0 && lb.op != 0 {
        j_id = ja
        j_op = jb
    }
    if lb.op == 0 && la.op != 0 {
        j_id = jb
        j_op = ja
    }
    if j_id < 0 { << false }
    lop := iface_leaf_info(m, j_op)
    if lop.op != 1 && lop.op != 2 && lop.op != 3 { << false }
    sid_id := iface_method_sid_first(m, j_id, fi, ii)
    sid_op := iface_method_sid_first(m, j_op, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    ia := types.mir_ia(m, fi, ii)
    dvr := iface_data_vr()
    if (a.arch == 0 || a.arch == 1) && a.rc_elem_vr >= 0 && ib == a.rc_fp_inv_t {
        a.load(dvr, a.rc_elem_vr, 0)
        a.load(0, a.rc_elem_vr, 8)
    } else {
        a.load(dvr, 15, slot_off(fr.temp_slot[ib]))
        a.load(0, 15, slot_off(fr.temp_slot[ib]) - 8)
    }
    a.load(1, 0, 0)
    rc_clobber(a, 0)
    rc_clobber(a, 1)
    a.load(0, dvr, 0)
    // Compute op value into dvr (dvr is now free scratch)
    a.mov(dvr, 0)
    if lop.op == 1 {
        a.vm_add_imm(dvr, dvr, lop.imm)
    } else if lop.op == 2 {
        a.vm_sub_imm(dvr, dvr, lop.imm)
    } else if lop.imm == 2 {
        a.shl_imm(dvr, dvr, 1)
    } else if lop.imm == 4 {
        a.shl_imm(dvr, dvr, 2)
    } else if lop.imm == 8 {
        a.shl_imm(dvr, dvr, 3)
    } else {
        a.vm_cmp_imm(1, sid_op)
        a.vm_mov_imm(1, lop.imm)
        a.mul(dvr, dvr, 1)
        a.vm_csel(0, dvr, 0, 0)
        if ia >= 0 && types.mir_temp_nslots(m, fi, ia) == 1 {
            emit_store_temp(a, fr, ia, 0)
        }
        << true
    }
    a.vm_cmp_imm(1, sid_op)
    a.vm_csel(0, dvr, 0, 0)
    if ia >= 0 && types.mir_temp_nslots(m, fi, ia) == 1 {
        emit_store_temp(a, fr, ia, 0)
    }
    << true
}

// Value-receiver leaf with data* in S4. Result in V0. No call / spill.
fn emit_iface_leaf_val(a &mut Assembler, m &types.Mir, j int) bool {
    lf := iface_leaf_info(m, j)
    if lf.ok != 1 {
        << false
    }
    a.load(0, iface_data_vr(), 0)
    if lf.op == 1 {
        a.vm_add_imm(0, 0, lf.imm)
    } else if lf.op == 2 {
        a.vm_sub_imm(0, 0, lf.imm)
    } else if lf.op == 3 && lf.imm == 2 {
        a.shl_imm(0, 0, 1)
    } else if lf.op == 3 && lf.imm == 4 {
        a.shl_imm(0, 0, 2)
    } else if lf.op == 3 && lf.imm == 8 {
        a.shl_imm(0, 0, 3)
    } else if lf.op == 3 {
        a.vm_mov_imm(1, lf.imm)
        a.mul(0, 0, 1)
    }
    << true
}

// W3: InterfaceMethod — split from emit_instr_iface.
fn emit_instr_iface_method(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ia := types.mir_ia(m, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    id := types.mir_id(m, fi, ii)
    // InterfaceMethod a=dest b=iface c=slot d=extra-args sval=name
    // Marshal extras into A1–A5 before the type_id switch. type_id in V1
    // (not V5: O1 pins live in V2–V5). data* in S4 (vreg 12), never S2
    // (vreg 10) — O2 S-pool pins occupy S0–S3. V6/V7 unavailable on x64.
    mut n_extra := 0
    mut ai2 := id
    while ai2 >= 0 {
        n_extra += 1
        ai2 = types.mir_marg_next(m, fi, ai2)
    }
    if n_extra == 0 && emit_iface_two_leaf_val(a, m, fi, fr, ii) {
        <<
    }
    mut n_stack := 0
    if n_extra > 5 { n_stack = n_extra - 5 }
    spill := stack_spill_bytes(n_stack)
    if spill > 0 {
        a.vm_sub_imm(16, 16, spill)
        mut ai_s := id
        mut skip := 0
        while ai_s >= 0 && skip < 5 {
            ai_s = types.mir_marg_next(m, fi, ai_s)
            skip = skip + 1
        }
        mut jsp := 0
        while ai_s >= 0 {
            v := types.mir_marg_v(m, fi, ai_s)
            emit_load_value(a, m, fi, fr, v, 0)
            a.store(16, jsp * 8, 0)
            jsp += 1
            ai_s = types.mir_marg_next(m, fi, ai_s)
        }
    }
    mut ai0 := id
    mut i0 := 1
    while ai0 >= 0 && i0 < 6 {
        v := types.mir_marg_v(m, fi, ai0)
        emit_load_value(a, m, fi, fr, v, 0)
        a.mov(arg_reg(i0), 0)
        i0 += 1
        ai0 = types.mir_marg_next(m, fi, ai0)
    }
    dvr := iface_data_vr()
    a.load(dvr, 15, slot_off(fr.temp_slot[ib])) // data* (S4)
    mut target_count := 0
    mut single_target := -1
    for j in 0:m.fns.len {
        sid := iface_method_sid_first(m, j, fi, ii)
        if sid >= 0 {
            target_count += 1
            single_target = j
        }
    }
    if target_count == 1 {
        j := single_target
        if id < 0 && emit_iface_leaf_val(a, m, j) {
            if ia >= 0 && types.mir_temp_nslots(m, fi, ia) == 1 {
                emit_store_temp(a, fr, ia, 0)
            }
        } else {
            a.mov(18, dvr) // A0 = data* (S4)
            if ia >= 0 && types.mir_temp_nslots(m, fi, ia) > 1 {
                a.mov(0, 15)
                a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
            }
            if a.arch == 0 {
                a.call_fn_index(j)
            } else {
                a.call(types.mir_fn_label(m, j))
            }
            if ia >= 0 && types.mir_temp_nslots(m, fi, ia) == 1 {
                a.mov(0, 14)
                emit_store_temp(a, fr, ia, 0)
            }
        }
        if spill > 0 {
            a.vm_add_imm(16, 16, spill)
        }
        <<
    }
    a.load(0, 15, slot_off(fr.temp_slot[ib]) - 8) // itable*
    a.load(1, 0, 0) // type_id in V1
    rc_clobber(a, 0)
    rc_clobber(a, 1)
    for j in 0:m.fns.len {
        sid := iface_method_sid_first(m, j, fi, ii)
        if sid >= 0 {
            a.vm_mov_imm(0, sid)
            a.cmp(1, 0)
            a.jeq("_iface_m_" + str(fi) + "_" + str(ii) + "_s" + str(sid))
        }
    }
    a.jmp("_iface_m_" + str(fi) + "_" + str(ii) + "_miss")
    for j in 0:m.fns.len {
        sid := iface_method_sid_first(m, j, fi, ii)
        if sid >= 0 {
            a.label("_iface_m_" + str(fi) + "_" + str(ii) + "_s" + str(sid))
            if id < 0 && emit_iface_leaf_val(a, m, j) {
                if ia >= 0 && types.mir_temp_nslots(m, fi, ia) == 1 {
                    emit_store_temp(a, fr, ia, 0)
                }
            } else {
            a.mov(18, dvr) // A0 = data* (S4)
            if ia >= 0 && types.mir_temp_nslots(m, fi, ia) > 1 {
                a.mov(0, 15)
                a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
            }
            // ARM64 can resolve an in-unit function by its stable MIR index;
            // this avoids retaining a temporary label string through the
            // hosted Gen1 forwarding chain (which used to surface as an
            // "unknown label hash" for multiple struct@ implementations).
            // Other targets keep the legacy string relocation path.
            if a.arch == 0 {
                a.call_fn_index(j)
            } else {
                a.call(types.mir_fn_label(m, j))
            }
            if ia >= 0 && types.mir_temp_nslots(m, fi, ia) == 1 {
                a.mov(0, 14)
                emit_store_temp(a, fr, ia, 0)
            }
            }
            if spill > 0 {
                a.vm_add_imm(16, 16, spill)
            }
            a.jmp("_iface_m_" + str(fi) + "_" + str(ii) + "_done")
        }
    }
    a.label("_iface_m_" + str(fi) + "_" + str(ii) + "_miss")
    if spill > 0 {
        a.vm_add_imm(16, 16, spill)
    }
    a.call("_rt_as_fail")
    a.label("_iface_m_" + str(fi) + "_" + str(ii) + "_done")
    <<
}

fn emit_instr_iface(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ik := types.mir_ikind(m, fi, ii)
    if ik == types.mi_str_const || ik == types.mi_load_fn_addr || ik == types.mi_make_closure {
        emit_instr_iface_lit(a, m, fi, fr, ii)
        <<
    }
    if ik == types.mi_box_interface || ik == types.mi_box_temp || ik == types.mi_interface_is {
        emit_instr_iface_box(a, m, fi, fr, ii)
        <<
    }
    if ik == types.mi_interface_as {
        emit_instr_iface_as(a, m, fi, fr, ii)
        <<
    }
    if ik == types.mi_interface_method {
        emit_instr_iface_method(a, m, fi, fr, ii)
        <<
    }
    <<
}

fn emit_instr_chan(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ik := types.mir_ikind(m, fi, ii)
    ia := types.mir_ia(m, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    id := types.mir_id(m, fi, ii)
    pack := rt_pack_vr(&*a)
    if ik == types.mi_chan_new { // ChanNew a=dest b=elem_slots c=cap
        a.vm_mov_imm(18, ib)
        if ic >= 0 { a.load(0, 15, slot_off(fr.temp_slot[ic])) } else { a.vm_mov_imm(0, types.mir_const_at(m, fi, -ic - 2)) }
        a.mov(19, 0)
        rc_spill_across_call(a)
        a.call("_rt_chan_new")
        a.mov(0, 14)
        a.store(15, slot_off(fr.temp_slot[ia]), 0)
        <<
    }
    if ik == types.mi_chan_send { // ChanSend a=chan b=src temp c=elem_slots
        chan_pack_open(a, ic, pack)
        for j in 0:ic {
            emit_load_value_word(a, m, fi, fr, ib, j, 0)
            a.store(pack, j * 8, 0)
        }
        if ia >= 0 { a.load(0, 15, slot_off(fr.temp_slot[ia])) } else { a.vm_mov_imm(0, types.mir_const_at(m, fi, -ia - 2)) }
        a.mov(18, 0)
        a.mov(19, pack)
        a.vm_mov_imm(20, ic)
        rc_spill_across_call(a)
        a.call("_rt_chan_send")
        chan_pack_close(a, ic)
        <<
    }
    if ik == types.mi_chan_recv { // ChanRecv a=dest b=chan c=elem_slots d=status-or--1
        chan_pack_open(a, ic, pack)
        if ib >= 0 { a.load(0, 15, slot_off(fr.temp_slot[ib])) } else { a.vm_mov_imm(0, types.mir_const_at(m, fi, -ib - 2)) }
        a.mov(18, 0)
        a.mov(19, pack)
        a.vm_mov_imm(20, ic)
        rc_spill_across_call(a)
        a.call("_rt_chan_recv")
        if id >= 0 {
            a.mov(1, 14)
        }
        for j in 0:ic {
            a.load(0, pack, j * 8)
            a.store(15, slot_off(fr.temp_slot[ia]) - j * 8, 0)
        }
        if id >= 0 {
            a.store(15, slot_off(fr.temp_slot[id]), 1)
        }
        chan_pack_close(a, ic)
        <<
    }
    if ik == types.mi_chan_close { // ChanClose a=chan
        if ia >= 0 { a.load(0, 15, slot_off(fr.temp_slot[ia])) } else { a.vm_mov_imm(0, types.mir_const_at(m, fi, -ia - 2)) }
        a.mov(18, 0)
        rc_spill_across_call(a)
        a.call("_rt_chan_close")
        <<
    }
    if ik == types.mi_xu { // Xu sval=label c=args head
        mut ai0 := ic
        mut nargs := 0
        while ai0 >= 0 {
            nargs += 1
            ai0 = types.mir_marg_next(m, fi, ai0)
        }
        // Owned spawn record: fn@0, nargs@8, args@16. Copy every hidden
        // descriptor into this allocation: queued tasks cannot point into a
        // caller frame that has returned or reused the moved local.
        lab := types.mir_isval(m, fi, ii)
        mut cfi := -1
        for j in 0:m.fns.len {
            if types.mir_fn_is_extern(m, j) { -> }
            if types.mir_fn_label(m, j) == lab { cfi = j }
        }
        if cfi < 0 {
            eprintln("internal compiler error: spawn target missing")
            <<< 1
        }
        mut bytes := 16 + nargs * 8
        for j in 0:nargs {
            ty := types.mir_local_ty(m, cfi, j)
            if ty == 3 || types.is_struct_type(ty) || types.is_array_type(ty) || types.is_fn_type(ty) {
                bytes += types.mir_local_nslots(m, cfi, j) * 8
            }
        }
        a.vm_mov_imm(18, bytes)
        rc_spill_across_call(a)
        a.call("_rt_alloc")
        a.mov(pack, 14)
        a.lea(0, lab)
        a.store(pack, 0, 0)
        a.vm_mov_imm(0, nargs)
        a.store(pack, 8, 0)
        mut ai := ic
        mut i := 0
        mut payload := 16 + nargs * 8
        while ai >= 0 {
            v := types.mir_marg_v(m, fi, ai)
            emit_load_value(a, m, fi, fr, v, 0)
            ty := types.mir_local_ty(m, cfi, i)
            if ty == 3 || types.is_struct_type(ty) || types.is_array_type(ty) || types.is_fn_type(ty) {
                ns := types.mir_local_nslots(m, cfi, i)
                top := payload + (ns - 1) * 8
                for j in 0:ns {
                    a.load(1, 0, 0 - j * 8)
                    a.store(pack, top - j * 8, 1)
                }
                a.vm_add_imm(0, pack, top)
                payload += ns * 8
            }
            a.store(pack, 16 + i * 8, 0)
            if a.has_int64_pairs() {
                if ty == 1 {
                    a.store(pack, 16 + i * 8 + 4, 1)
                } else {
                    a.vm_mov_imm(1, 0)
                    a.store(pack, 16 + i * 8 + 4, 1)
                }
            }
            i += 1
            ai = types.mir_marg_next(m, fi, ai)
        }
        a.mov(18, pack)
        rc_spill_across_call(a)
        a.call("_rt_xu")
        <<
    }
    if ik == types.mi_chan_try_send { // ChanTrySend a=status b=chan c=src d=slots
        chan_pack_open(a, id, pack)
        for j in 0:id {
            emit_load_value_word(a, m, fi, fr, ic, j, 0)
            a.store(pack, j * 8, 0)
        }
        if ib >= 0 { a.load(0, 15, slot_off(fr.temp_slot[ib])) } else { a.vm_mov_imm(0, types.mir_const_at(m, fi, -ib - 2)) }
        a.mov(18, 0)
        a.mov(19, pack)
        a.vm_mov_imm(20, id)
        rc_spill_across_call(a)
        a.call("_rt_chan_try_send")
        a.mov(0, 14)
        a.store(15, slot_off(fr.temp_slot[ia]), 0)
        chan_pack_close(a, id)
        <<
    }
    if ik == types.mi_chan_try_recv { // ChanTryRecv a=status b=dest c=chan d=slots
        chan_pack_open(a, id, pack)
        if ic >= 0 { a.load(0, 15, slot_off(fr.temp_slot[ic])) } else { a.vm_mov_imm(0, types.mir_const_at(m, fi, -ic - 2)) }
        a.mov(18, 0)
        a.mov(19, pack)
        a.vm_mov_imm(20, id)
        rc_spill_across_call(a)
        a.call("_rt_chan_try_recv")
        a.mov(1, 14)
        for j in 0:id {
            a.load(0, pack, j * 8)
            a.store(15, slot_off(fr.temp_slot[ib]) - j * 8, 0)
        }
        a.store(15, slot_off(fr.temp_slot[ia]), 1)
        chan_pack_close(a, id)
        <<
    }
    if ik == types.mi_xu_pump { // XuPump
        rc_spill_across_call(a)
        a.call("_rt_xu_pump")
        <<
    }
    <<
}

// Wave C: Bin — split from emit_instr (W3).
