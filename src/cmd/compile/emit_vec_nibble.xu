@main

#xu/types

// Expand one input byte into two output bytes.
// The value is the branchless hex digit
// `48 + d + 39 * ((d + 6) >> 4)` of `byte >> 4` and `byte & 15`,
// stored at `2*i` and `2*i+1`. Any straight byte loop of that shape.
// Groups of 16 run only while `i + 15 < limit`, after the length proof.
// Partial overlap stays on the scalar tail. `i < 0` still traps.


struct X2Hit {
    ok int
    hi_even int
    src_loc int
    dst_loc int
}

fn x2_miss() X2Hit {
    << X2Hit{ok: 0, hi_even: 0, src_loc: -1, dst_loc: -1}
}

fn x2_stored_before(m &types.Mir, fi int, bi int, stop int, loc int) int {
    mut last := -1
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 || ii == stop { <- }
        if types.mir_ikind(m, fi, ii) == types.mi_store_local && types.mir_ia(m, fi, ii) == loc {
            last = types.mir_ib(m, fi, ii)
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << last
}

fn x2_is_k(m &types.Mir, fi int, t int, k int) bool {
    if t >= 0 { << false }
    if !vec_has_const(m, fi, t) { << false }
    << vec_const(m, fi, t) == k
}

fn x2_is_byte(m &types.Mir, fi int, bi int, t int, load int, depth int) bool {
    if depth > 8 || t < 0 { << false }
    if t == load { << true }
    ii := eq16_def_in(m, fi, bi, t)
    if ii < 0 { << false }
    k := types.mir_ikind(m, fi, ii)
    if k == types.mi_copy {
        << x2_is_byte(m, fi, bi, types.mir_ib(m, fi, ii), load, depth + 1)
    }
    if k == types.mi_load_local {
        v := x2_stored_before(m, fi, bi, ii, types.mir_ib(m, fi, ii))
        << x2_is_byte(m, fi, bi, v, load, depth + 1)
    }
    if k == types.mi_bin && types.mir_ib(m, fi, ii) == 14 {
        lc := types.mir_ic(m, fi, ii)
        ld := types.mir_id(m, fi, ii)
        if x2_is_k(m, fi, lc, 255) {
            << x2_is_byte(m, fi, bi, ld, load, depth + 1)
        }
        if x2_is_k(m, fi, ld, 255) {
            << x2_is_byte(m, fi, bi, lc, load, depth + 1)
        }
    }
    << false
}

// 1 = high nibble (`byte >> 4`), 2 = low nibble (`byte & 15`).
fn x2_nib_class(m &types.Mir, fi int, bi int, t int, load int, depth int) int {
    if depth > 8 || t < 0 { << 0 }
    ii := eq16_def_in(m, fi, bi, t)
    if ii < 0 { << 0 }
    k := types.mir_ikind(m, fi, ii)
    if k == types.mi_copy {
        << x2_nib_class(m, fi, bi, types.mir_ib(m, fi, ii), load, depth + 1)
    }
    if k == types.mi_load_local {
        v := x2_stored_before(m, fi, bi, ii, types.mir_ib(m, fi, ii))
        << x2_nib_class(m, fi, bi, v, load, depth + 1)
    }
    if k != types.mi_bin { << 0 }
    op := types.mir_ib(m, fi, ii)
    lc := types.mir_ic(m, fi, ii)
    ld := types.mir_id(m, fi, ii)
    if op == 18 && x2_is_k(m, fi, ld, 4) {
        if x2_is_byte(m, fi, bi, lc, load, 0) { << 1 }
    }
    if op == 14 {
        mut other := -1
        if x2_is_k(m, fi, lc, 15) { other = ld }
        if x2_is_k(m, fi, ld, 15) { other = lc }
        if other >= 0 && x2_is_byte(m, fi, bi, other, load, 0) { << 2 }
    }
    << 0
}

fn x2_plus48(m &types.Mir, fi int, bi int, t int, load int, depth int) int {
    if depth > 4 || t < 0 { << 0 }
    ii := eq16_def_in(m, fi, bi, t)
    if ii < 0 { << 0 }
    k := types.mir_ikind(m, fi, ii)
    if k == types.mi_copy {
        << x2_plus48(m, fi, bi, types.mir_ib(m, fi, ii), load, depth + 1)
    }
    if k != types.mi_bin || types.mir_ib(m, fi, ii) != 1 { << 0 }
    lc := types.mir_ic(m, fi, ii)
    ld := types.mir_id(m, fi, ii)
    if x2_is_k(m, fi, lc, 48) {
        << x2_nib_class(m, fi, bi, ld, load, 0)
    }
    if x2_is_k(m, fi, ld, 48) {
        << x2_nib_class(m, fi, bi, lc, load, 0)
    }
    << 0
}

fn x2_mul39(m &types.Mir, fi int, bi int, t int, load int, depth int) int {
    if depth > 4 || t < 0 { << 0 }
    ii := eq16_def_in(m, fi, bi, t)
    if ii < 0 { << 0 }
    k := types.mir_ikind(m, fi, ii)
    if k == types.mi_copy {
        << x2_mul39(m, fi, bi, types.mir_ib(m, fi, ii), load, depth + 1)
    }
    if k != types.mi_bin || types.mir_ib(m, fi, ii) != 3 { << 0 }
    lc := types.mir_ic(m, fi, ii)
    ld := types.mir_id(m, fi, ii)
    mut shift := -1
    if x2_is_k(m, fi, lc, 39) { shift = ld }
    if x2_is_k(m, fi, ld, 39) { shift = lc }
    if shift < 0 { << 0 }
    si := eq16_def_in(m, fi, bi, shift)
    if si < 0 { << 0 }
    if types.mir_ikind(m, fi, si) == types.mi_copy {
        << x2_mul39_shift(m, fi, bi, types.mir_ib(m, fi, si), load, depth + 1)
    }
    << x2_mul39_shift(m, fi, bi, shift, load, depth)
}

fn x2_mul39_shift(m &types.Mir, fi int, bi int, shift int, load int, depth int) int {
    if depth > 4 || shift < 0 { << 0 }
    si := eq16_def_in(m, fi, bi, shift)
    if si < 0 { << 0 }
    if types.mir_ikind(m, fi, si) == types.mi_copy {
        << x2_mul39_shift(m, fi, bi, types.mir_ib(m, fi, si), load, depth + 1)
    }
    if types.mir_ikind(m, fi, si) != types.mi_bin || types.mir_ib(m, fi, si) != 18 { << 0 }
    if !x2_is_k(m, fi, types.mir_id(m, fi, si), 4) { << 0 }
    mut inner := types.mir_ic(m, fi, si)
    mut ii := eq16_def_in(m, fi, bi, inner)
    if ii < 0 { << 0 }
    if types.mir_ikind(m, fi, ii) == types.mi_copy {
        inner = types.mir_ib(m, fi, ii)
        ii = eq16_def_in(m, fi, bi, inner)
        if ii < 0 { << 0 }
    }
    if types.mir_ikind(m, fi, ii) != types.mi_bin || types.mir_ib(m, fi, ii) != 1 { << 0 }
    lc := types.mir_ic(m, fi, ii)
    ld := types.mir_id(m, fi, ii)
    mut nib := -1
    if x2_is_k(m, fi, lc, 6) { nib = ld }
    if x2_is_k(m, fi, ld, 6) { nib = lc }
    if nib < 0 { << 0 }
    << x2_nib_class(m, fi, bi, nib, load, 0)
}

fn x2_hex_class(m &types.Mir, fi int, bi int, t int, load int, depth int) int {
    if depth > 4 || t < 0 { << 0 }
    ii := eq16_def_in(m, fi, bi, t)
    if ii < 0 { << 0 }
    k := types.mir_ikind(m, fi, ii)
    if k == types.mi_copy {
        << x2_hex_class(m, fi, bi, types.mir_ib(m, fi, ii), load, depth + 1)
    }
    if k != types.mi_bin || types.mir_ib(m, fi, ii) != 1 { << 0 }
    lc := types.mir_ic(m, fi, ii)
    ld := types.mir_id(m, fi, ii)
    mut hi := x2_plus48(m, fi, bi, lc, load, 0)
    mut lo := x2_mul39(m, fi, bi, ld, load, 0)
    if hi > 0 && hi == lo { << hi }
    hi = x2_plus48(m, fi, bi, ld, load, 0)
    lo = x2_mul39(m, fi, bi, lc, load, 0)
    if hi > 0 && hi == lo { << hi }
    << 0
}

fn x2_hit(m &types.Mir, fi int, bi int, ind int) X2Hit {
    mut nld := 0
    mut nst := 0
    mut load_t := -1
    mut src_loc := -1
    mut dst_loc := -1
    mut even_v := -1
    mut odd_v := -1
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == types.mi_load_index {
            mut w := types.mir_id(m, fi, ii)
            if w < 0 { w = 0 - w }
            if w != 1 { << x2_miss() }
            if vec_affine_index(m, fi, bi, types.mir_ic(m, fi, ii), ind) != 4 {
                << x2_miss()
            }
            base := types.mir_ib(m, fi, ii)
            src_loc = vec_base_local(m, fi, bi, base)
            if src_loc < 0 {
                src_loc = eq16_borrowed_ref(m, fi, base)
            }
            load_t = types.mir_ia(m, fi, ii)
            nld = nld + 1
        } else if k == types.mi_store_index {
            mut w := types.mir_id(m, fi, ii)
            if w < 0 { w = 0 - w }
            if w != 1 { << x2_miss() }
            aff := vec_affine_index(m, fi, bi, types.mir_ib(m, fi, ii), ind)
            if aff != 8 && aff != 9 { << x2_miss() }
            bl := vec_base_local(m, fi, bi, types.mir_ia(m, fi, ii))
            if bl < 0 || bl == ind { << x2_miss() }
            if dst_loc < 0 { dst_loc = bl }
            if bl != dst_loc { << x2_miss() }
            if aff == 8 { even_v = types.mir_ic(m, fi, ii) }
            if aff == 9 { odd_v = types.mir_ic(m, fi, ii) }
            nst = nst + 1
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if nld != 1 || nst != 2 || load_t < 0 || even_v < 0 || odd_v < 0 {
        << x2_miss()
    }
    if src_loc < 0 || src_loc == ind || dst_loc < 0 { << x2_miss() }
    ce := x2_hex_class(m, fi, bi, even_v, load_t, 0)
    co := x2_hex_class(m, fi, bi, odd_v, load_t, 0)
    if ce == 0 || co == 0 || ce == co { << x2_miss() }
    nloc := types.mir_nlocals(m, fi)
    mut st_at := []int{}
    mut ld_at := []int{}
    for _ in 0:nloc {
        st_at.push(-1)
        ld_at.push(-1)
    }
    mut ord := 0
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == types.mi_store_local {
            loc := types.mir_ia(m, fi, ii)
            if loc >= 0 && loc < nloc && loc != ind && st_at[loc] < 0 {
                st_at[loc] = ord
            }
        }
        if k == types.mi_load_local {
            loc := types.mir_ib(m, fi, ii)
            if loc >= 0 && loc < nloc && loc != ind && ld_at[loc] < 0 {
                ld_at[loc] = ord
            }
        }
        ord = ord + 1
        ii = types.mir_inext(m, fi, ii)
    }
    for loc in 0:nloc {
        if st_at[loc] >= 0 && ld_at[loc] >= 0 && ld_at[loc] < st_at[loc] {
            << x2_miss()
        }
    }
    nb := types.mir_nblocks(m, fi)
    for bj in 0:nb {
        if bj == bi { -> }
        mut jj := types.mir_bhead(m, fi, bj)
        for _ in 0:types.mir_nins(m, fi) {
            if jj < 0 { <- }
            if types.mir_ikind(m, fi, jj) == types.mi_load_local {
                loc := types.mir_ib(m, fi, jj)
                if loc >= 0 && loc < nloc && loc != ind && st_at[loc] >= 0 {
                    << x2_miss()
                }
            }
            jj = types.mir_inext(m, fi, jj)
        }
    }
    mut hi_even := 0
    if ce == 1 { hi_even = 1 }
    << X2Hit{ok: 1, hi_even: hi_even, src_loc: src_loc, dst_loc: dst_loc}
}

fn x2_hex_gpr(a &mut Assembler, nreg int, tmp int) {
    a.vm_add_imm(tmp, nreg, 6)
    a.shr_imm(tmp, tmp, 4)
    a.mul(tmp, tmp, 5)
    a.vm_add_imm(nreg, nreg, 48)
    a.add(nreg, nreg, tmp)
}

fn x2_hex_q(a &mut Assembler, vd int, tmp int) {
    a.be_neon_add_16b(tmp, vd, 6)
    a.be_neon_ushr_16b(tmp, tmp, 4)
    a.be_neon_mul_16b(tmp, tmp, 5)
    a.be_neon_add_16b(vd, vd, 4)
    a.be_neon_add_16b(vd, vd, tmp)
}

fn emit_byte_x2(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, p VecPat) int {
    if a.arch != 0 { << 0 }
    if p.ind < 0 || p.ind >= fr.local_slot.len { << 0 }
    h := x2_hit(m, fi, bi, p.ind)
    if h.ok == 0 { << 0 }
    if h.src_loc < 0 || h.src_loc >= fr.local_slot.len { << 0 }
    if h.dst_loc < 0 || h.dst_loc >= fr.local_slot.len { << 0 }
    if h.src_loc == p.ind || h.dst_loc == p.ind { << 0 }
    src_base := types.mir_local_operand_base + h.src_loc
    dst_base := types.mir_local_operand_base + h.dst_loc
    if emit_base_fixed_len(m, fi, src_base) > 0 { << 0 }
    if emit_base_fixed_len(m, fi, dst_base) > 0 { << 0 }
    mut lim_loc := -1
    if p.limit_t >= types.mir_local_operand_base {
        lim_loc = p.limit_t - types.mir_local_operand_base
        if lim_loc < 0 || lim_loc >= fr.local_slot.len { << 0 }
    } else if p.limit_t < 0 || p.limit_t >= fr.temp_slot.len {
        << 0
    }
    if p.else_bb < 0 { << 0 }
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi)
    vec_lbl := pref + "_x2"
    sc_lbl := pref + "_x2s"
    dn_lbl := pref + "_x2d"
    ok_lbl := pref + "_x2k"
    else_lbl := types.mir_fn_label(m, fi) + "_bb" + str(p.else_bb)
    a.load(6, 15, slot_off(fr.local_slot[p.ind]))
    if lim_loc >= 0 {
        a.load(1, 15, slot_off(fr.local_slot[lim_loc]))
    } else {
        emit_load_value(a, m, fi, fr, p.limit_t, 1)
    }
    a.vm_cmp_imm(6, 0)
    a.oob_need = 1
    a.jlt(a.oob_lbl + "")
    a.cmp(6, 1)
    a.jge(dn_lbl + "")
    emit_index_desc_addr(a, m, fi, fr, src_base)
    a.load(2, 0, -8)
    a.cmp(1, 2)
    a.jgt(a.oob_lbl + "")
    a.load(12, 0, 0)
    a.add(12, 12, 6)
    emit_index_desc_addr(a, m, fi, fr, dst_base)
    a.load(2, 0, -8)
    a.vm_cmp_imm(2, 0)
    a.jlt(a.oob_lbl + "")
    a.shr_imm(3, 2, 1)
    a.cmp(1, 3)
    a.jgt(a.oob_lbl + "")
    if emit_store_base_is_string(m, fi, dst_base) {
        a.load(2, 0, -16)
        a.vm_cmp_imm(2, 1)
        a.jlt(a.oob_lbl + "")
    }
    a.load(13, 0, 0)
    a.shl_imm(3, 6, 1)
    a.add(13, 13, 3)
    a.vm_mov_imm(5, 39)
    a.vm_mov_imm(4, 15)
    a.be_neon_dup_16b(3, 4)
    a.vm_mov_imm(4, 48)
    a.be_neon_dup_16b(4, 4)
    a.vm_mov_imm(4, 39)
    a.be_neon_dup_16b(5, 4)
    a.vm_mov_imm(4, 6)
    a.be_neon_dup_16b(6, 4)
    // Read range is `rem` bytes. Write range is `2*rem` bytes.
    // A wrapped or overlapping pair stays byte-by-byte.
    a.sub(2, 1, 6)
    a.vm_cmp_imm(2, 0)
    a.jle(sc_lbl + "")
    a.vm_mov_imm64(3, 4611686018427387904)
    a.cmp(2, 3)
    a.jge(sc_lbl + "")
    a.add(3, 12, 2)
    a.shl_imm(4, 2, 1)
    a.add(4, 13, 4)
    a.cmp(12, 4)
    a.jae(ok_lbl + "")
    a.cmp(13, 3)
    a.jae(ok_lbl + "")
    a.jmp(sc_lbl + "")
    a.label(ok_lbl + "")
    a.vm_sub_imm(7, 1, 15)
    a.cmp(6, 7)
    a.jge(sc_lbl + "")
    a.label(vec_lbl + "")
    a.be_neon_ldr_q_post16(0, 12)
    a.be_neon_ushr_16b(1, 0, 4)
    a.be_neon_and_16b(2, 0, 3)
    x2_hex_q(a, 1, 7)
    x2_hex_q(a, 2, 7)
    if h.hi_even == 1 {
        a.be_neon_zip1_16b(0, 1, 2)
        a.be_neon_zip2_16b(7, 1, 2)
    } else {
        a.be_neon_zip1_16b(0, 2, 1)
        a.be_neon_zip2_16b(7, 2, 1)
    }
    a.be_neon_str_q_post16(0, 13)
    a.be_neon_str_q_post16(7, 13)
    a.vm_add_imm(6, 6, 16)
    a.cmp(6, 7)
    a.jlt(vec_lbl + "")
    a.label(sc_lbl + "")
    a.cmp(6, 1)
    a.jge(dn_lbl + "")
    a.load_byte(3, 12, 0)
    a.vm_and_imm(3, 3, 255)
    a.shr_imm(2, 3, 4)
    a.vm_and_imm(4, 3, 15)
    if h.hi_even == 1 {
        x2_hex_gpr(a, 2, 3)
        x2_hex_gpr(a, 4, 3)
        a.store_byte(13, 0, 2)
        a.store_byte(13, 1, 4)
    } else {
        x2_hex_gpr(a, 2, 3)
        x2_hex_gpr(a, 4, 3)
        a.store_byte(13, 0, 4)
        a.store_byte(13, 1, 2)
    }
    a.vm_add_imm(12, 12, 1)
    a.vm_add_imm(13, 13, 2)
    a.vm_add_imm(6, 6, 1)
    a.jmp(sc_lbl + "")
    a.label(dn_lbl + "")
    a.store(15, slot_off(fr.local_slot[p.ind]), 6)
    a.jmp(else_lbl + "")
    << 1
}
