@main

#os
#os/exec

// The debugger front end keeps the product CLI small while still making the
// compiler's DWARF output useful from one command. It builds a debug binary
// through the running product compiler, then hands the terminal to LLDB (or
// GDB when LLDB is unavailable). The debugger remains interactive, so users
// can set additional breakpoints, inspect frames/locals, and step normally.

fn debug_self_path(argv &[]string) string {
    if argv.len == 0 { << "xu" }
    raw := cli_arg_owned(argv, 0)
    if path_exists(&raw) { << require_real_path(&raw) }
    resolved := exec.look_path(raw + "") or (err) { << raw + "" }
    << require_real_path(&resolved)
}

fn debug_remove(path string) {
    os.remove(str_clone(&path)) or (err) { << }
    <<
}

fn debug_find_backend(name string) string {
    << exec.look_path(name) or (err) { << "" }
}

fn debug_break_command(spec string) string {
    mut split := -1
    for i in 0:spec.len {
        if spec[i] == 58 { split = i }
    }
    if split > 0 && split + 1 < spec.len {
        line := parse_count(spec[split + 1:spec.len])
        if line > 0 {
            file := spec[0:split]
            << "breakpoint set --file " + tool_shell_quote(&file) + " --line " + str(line)
        }
    }
    << "breakpoint set --name " + tool_shell_quote(&spec)
}

fn debug_run_args_command(args &[]string) string {
    mut out := "settings set target.run-args"
    for i in 0:args.len {
        out = out + " " + tool_shell_quote(&args[i])
    }
    << out
}

fn debug_help(prog &string) {
    println("usage: " + prog + " debug [options] <input.xu...> [-- program-args...]")
    println("")
    println("Build a DWARF-enabled debug binary and start an interactive source debugger.")
    println("")
    println("Options:")
    println("  -b, --break SPEC     source location file.xu:LINE or function name")
    println("  -e, --eval COMMAND   execute a debugger command before the prompt (repeatable)")
    println("  --run                launch the program after applying debugger commands")
    println("  --batch              run in batch mode without interactive prompt")
    println("  --stop-at-entry      stop at the program entry point")
    println("  --backend PATH       use PATH instead of lldb (gdb is the fallback)")
    println("  --binary PATH        debug an existing executable; skip the build")
    println("  -o, --output PATH    keep the debug executable at PATH")
    println("  --target TARGET      host target to build (macos/linux/windows)")
    println("  -h, --help           show this message")
    println("")
    println("Examples:")
    println("  " + prog + " debug -b main.xu:8 main.xu")
    println("  " + prog + " debug -b main.xu:8 --run main.xu")
    println("  " + prog + " debug --binary ./app -e 'bt' -e 'frame variable'")
    <<
}

fn run_debug_cmd(argv &[]string) int {
    prog := cli_prog_from(argv)
    if argv_sub_has_help(argv) {
        debug_help(&prog)
        << 0
    }

    mut sources := []string{}
    mut break_specs := []string{}
    mut evals := []string{}
    mut program_args := []string{}
    mut output := ""
    mut output_set := false
    mut binary := ""
    mut backend := ""
    mut target_code := 0
    mut target_set := false
    mut launch := false
    mut batch := false
    mut stop_at_entry := false
    mut after_separator := false
    mut profile_args := []string{}
    mut skip := 0

    for i in 2:argv.len {
        if after_separator {
            program_args.push(cli_arg_owned(argv, i))
        } else if skip == 1 {
            skip = 0
        } else {
            arg := argv[i]
            if arg == "--" {
                after_separator = true
            } else if arg == "-b" || arg == "--break" {
                if i + 1 >= argv.len {
                    eprintln(prog + " debug: --break requires a location")
                    << 1
                }
                break_specs.push(cli_arg_owned(argv, i + 1))
                skip = 1
            } else if arg.len > 8 && arg[0:8] == "--break=" {
                break_specs.push(cli_arg_owned(argv, i)[8:arg.len])
            } else if arg == "-e" || arg == "--eval" {
                if i + 1 >= argv.len {
                    eprintln(prog + " debug: --eval requires a command")
                    << 1
                }
                evals.push(cli_arg_owned(argv, i + 1))
                skip = 1
            } else if arg.len > 7 && arg[0:7] == "--eval=" {
                evals.push(cli_arg_owned(argv, i)[7:arg.len])
            } else if arg == "--run" {
                launch = true
            } else if arg == "--batch" {
                batch = true
            } else if arg == "--stop-at-entry" {
                stop_at_entry = true
            } else if arg == "--backend" {
                if i + 1 >= argv.len {
                    eprintln(prog + " debug: --backend requires a path")
                    << 1
                }
                backend = cli_arg_owned(argv, i + 1)
                skip = 1
            } else if arg.len > 10 && arg[0:10] == "--backend=" {
                backend = cli_arg_owned(argv, i)[10:arg.len]
            } else if arg == "--binary" {
                if i + 1 >= argv.len {
                    eprintln(prog + " debug: --binary requires a path")
                    << 1
                }
                binary = cli_arg_owned(argv, i + 1)
                skip = 1
            } else if arg.len > 9 && arg[0:9] == "--binary=" {
                binary = cli_arg_owned(argv, i)[9:arg.len]
            } else if arg == "-o" || arg == "--output" {
                if i + 1 >= argv.len {
                    eprintln(prog + " debug: -o requires a path")
                    << 1
                }
                output = cli_arg_owned(argv, i + 1)
                output_set = true
                skip = 1
            } else if arg == "--target" {
                if i + 1 >= argv.len {
                    eprintln(prog + " debug: --target requires a name")
                    << 1
                }
                target_code = parse_target(argv[i + 1])
                if target_code < 0 {
                    eprintln(prog + " debug: unknown target")
                    << 1
                }
                target_set = true
                skip = 1
            } else if arg == "--debug-build" || arg == "--no-regcache" || arg == "--debug" || arg == "-O0" || arg == "-O1" || arg == "-O2" || arg == "-O3" || arg == "--ra=0" || arg == "--ra=1" || arg == "--ra=2" || arg == "--ra=3" {
                // Debug mode always adds --debug-build. Preserve the other
                // accepted compiler flags for the recursive build.
                if arg != "--debug-build" { profile_args.push(arg + "") }
            } else if arg.len > 0 && arg[0] == 45 {
                eprintln(prog + " debug: unknown flag " + arg)
                << 1
            } else {
                sources.push(cli_arg_owned(argv, i))
            }
        }
    }

    if binary.len == 0 && sources.len == 0 {
        eprintln(prog + " debug: no input source or --binary path")
        << 1
    }
    if binary.len > 0 && sources.len > 0 {
        eprintln(prog + " debug: --binary cannot be combined with source files")
        << 1
    }

    host := host_target_code()
    if binary.len == 0 {
        target_code = apply_env_target(target_set, target_code)
        if target_code != host {
            eprintln(prog + " debug: cross-target binaries cannot run under the host debugger")
            << 1
        }
        if target_os(target_code) == 3 {
            eprintln(prog + " debug: freestanding targets have no host debugger")
            << 1
        }
    }

    mut temp_binary := false
    if binary.len == 0 {
        if output_set {
            binary = ensure_bin_suffix(output, target_code)
        } else {
            binary = ensure_bin_suffix(os.temp_dir() + "/xu_debug_" + str(os.getpid()) + "_" + str(now_ns() & 2147483647), target_code)
            temp_binary = true
        }
        mut self_args := []string{}
        self_args.push("build")
        self_args.push("--debug-build")
        for i in 0:profile_args.len { self_args.push(profile_args[i] + "") }
        if target_set {
            self_args.push("--target")
            self_args.push(target_name(target_code))
        }
        self_args.push("-o")
        self_args.push(binary + "")
        for i in 0:sources.len { self_args.push(sources[i] + "") }
        rc := cli_exec(debug_self_path(argv), self_args)
        if rc != 0 {
            if temp_binary { debug_remove(binary) }
            << rc
        }
    }

    mut dbg := backend + ""
    if dbg.len == 0 {
        dbg = debug_find_backend("lldb")
        if dbg.len == 0 { dbg = debug_find_backend("gdb") }
    }
    if dbg.len == 0 {
        eprintln(prog + " debug: no lldb or gdb executable found; use --backend PATH")
        if temp_binary { debug_remove(binary) }
        << 127
    }

    mut dbg_args := []string{}
    if batch {
        dbg_args.push("--batch")
    }
    for i in 0:break_specs.len {
        dbg_args.push("-o")
        dbg_args.push(debug_break_command(break_specs[i]))
    }
    if program_args.len > 0 {
        dbg_args.push("-o")
        dbg_args.push(debug_run_args_command(&program_args))
    }
    if stop_at_entry {
        dbg_args.push("-o")
        dbg_args.push("process launch --stop-at-entry")
    } else if launch {
        dbg_args.push("-o")
        dbg_args.push("process launch")
    }
    for i in 0:evals.len {
        dbg_args.push("-o")
        dbg_args.push(evals[i] + "")
    }
    dbg_args.push(binary + "")
    rc := cli_exec(dbg, dbg_args)
    if temp_binary { debug_remove(binary) }
    << rc
}
