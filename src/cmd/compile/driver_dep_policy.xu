@main

#os
#path/filepath
#internal/modulepath

fn require_policy_flag(s &string) bool {
    << str_eq_lit(s, "--offline") || str_eq_lit(s, "--frozen")
}

// The dependency resolver runs before BuildOpts exists. Read only compiler
// options here; output/target values and arguments after -- remain data.
fn require_frozen() bool {
    << require_mode() == 2
}

fn require_offline() bool {
    << require_mode() > 0
}

fn require_mode() int {
    args := os.argv()
    if args.len < 2 { << 0 }
    command := args[1]
    if command != "build" && command != "check" && command != "test" && command != "run" && command != "install" && command != "get" && command != "_get-install" { << 0 }
    mut mode := 0
    mut skip := false
    for i in 2:args.len {
        if skip { skip = false
            -> }
        arg := args[i]
        if arg == "--" { <- }
        if arg == "-o" || arg == "--output" || arg == "--target" || arg == "--www" || arg == "-run" || arg == "-bench" || arg == "-count" {
            skip = true
            ->
        }
        if arg == "--frozen" { mode = 2 }
        if arg == "--offline" && mode == 0 { mode = 1 }
    }
    << mode
}

fn require_download_allowed(key &string) {
    if require_offline() {
        eprintln("require '" + key + "': offline dependency missing from vendor/cache; run xu install online first")
        <<< 1
    }
}

fn require_frozen_preflight(project &string, keys &[]string, vals &[]string) {
    if !require_frozen() { << }
    // Validate the entire declared closure before resolving any entry.
    lines := require_lock_lines(project)
    for i in 0:keys.len {
        key := keys[i]
        val := vals[i]
        entry := require_lock_entry(project, &key, &val)
        if entry.len == 0 {
            eprintln("require '" + key + "': frozen build requires an existing xu.lock entry; run xu install first")
            <<< 1
        }
        if val_has_prefix(&val, "file:") {
            vdir := project + "/vendor"
            if !vendor_has_pkg(&vdir, &key) {
                eprintln("require '" + key + "': frozen local dependency needs a locked vendor snapshot; run xu install first")
                <<< 1
            }
        }
    }
}

fn require_local_source(project &string, key &string, locator &string) string {
    tail := locator[5:locator.len]
    mut root := str_clone(&tail)
    if !filepath.is_abs(&tail) {
        base := require_project_base(project)
        root = path_join(&base, &tail)
    }
    if modulepath.is_external(key) {
        require_check_external_root(&root, key)
        << root
    }
    slash := mod_id_to_slash(key)
    dir := path_join(&root, &slash)
    if dir_readable(&dir) == 1 { << dir }
    name := slash + ".xu"
    file := path_join(&root, &name)
    if file_readable(&file) == 1 { << file }
    if dir_readable(&root) == 1 && require_has_source(&root) { << root }
    eprintln("require '" + key + "': local dependency not found: " + root)
    <<< 1
}
