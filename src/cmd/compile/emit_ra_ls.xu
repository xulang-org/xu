@main

#xu/types

// O3: slot-keyed linear scan → up to 4 hot 1-slot locals (Gen1).
// Clang/LLVM greedy analogue (O2/O3 share the allocator; weights use
// count/span/call-crossing). caller merges into self-loop
// pins only; chan/xu blocks stay unpinned so drop/park still read slots.
// Caps: ≤64 locals, ≤64 blocks; else empty (caller keeps O2 pins).

fn ls_hot_locals(m &types.Mir, fi int) []int {
    mut out := []int{}
    out.push(-1)
    out.push(-1)
    out.push(-1)
    out.push(-1)
    nloc := types.mir_nlocals(m, fi)
    nblk := types.mir_nblocks(m, fi)
    if nloc == 0 || nloc > 64 || nblk == 0 || nblk > 64 {
        << out
    }
    mut scalar := []int{}
    for i in 0:nloc {
        if types.mir_local_nslots(m, fi, i) == 1 && rc_pin_ty_ok(types.mir_local_ty(m, fi, i)) {
            scalar.push(1)
        } else {
            scalar.push(0)
        }
    }
    mut gen := []int{}
    mut kill := []int{}
    mut uses := []int{}
    mut block_call := []int{}
    mut block_refs := []int{}
    for _ in 0:nblk {
        gen.push(0)
        kill.push(0)
        block_call.push(0)
        block_refs.push(0)
    }
    for _ in 0:nloc {
        uses.push(0)
    }
    for bi in 0:nblk {
        mut defined := 0
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 {
                <-
            } else {
                ik := types.mir_ikind(m, fi, ii)
                leaf := ik == types.mi_bin || ik == types.mi_un || ik == types.mi_copy || ik == types.mi_load_local || ik == types.mi_store_local
                if !leaf {
                    block_call[bi] = 1
                }
                if ik == types.mi_load_local {
                    loc := types.mir_ib(m, fi, ii)
                    if loc >= 0 && loc < nloc && scalar[loc] == 1 {
                        bit := 1 << loc
                        uses[loc] = uses[loc] + 1
                        block_refs[bi] = block_refs[bi] | bit
                        if (defined & bit) == 0 {
                            gen[bi] = gen[bi] | bit
                        }
                    }
                }
                if ik == types.mi_store_local {
                    loc := types.mir_ia(m, fi, ii)
                    if loc >= 0 && loc < nloc && scalar[loc] == 1 {
                        bit := 1 << loc
                        uses[loc] = uses[loc] + 1
                        block_refs[bi] = block_refs[bi] | bit
                        kill[bi] = kill[bi] | bit
                        defined = defined | bit
                    }
                }
                ii = types.mir_inext(m, fi, ii)
            }
        }
    }
    mut live_in := []int{}
    mut live_out := []int{}
    for _ in 0:nblk {
        live_in.push(0)
        live_out.push(0)
    }
    mut rounds := nblk * 2
    if rounds < 8 {
        rounds = 8
    }
    for _ in 0:rounds {
        mut changed := 0
        mut bi := nblk - 1
        for _ in 0:nblk {
            mut outb := 0
            tkind := types.mir_btkind(m, fi, bi)
            if tkind == 1 {
                ta := types.mir_bta(m, fi, bi)
                if ta >= 0 && ta < nblk {
                    outb = outb | live_in[ta]
                }
            }
            if tkind == 2 {
                tb := types.mir_btb(m, fi, bi)
                tc := types.mir_btc(m, fi, bi)
                if tb >= 0 && tb < nblk {
                    outb = outb | live_in[tb]
                }
                if tc >= 0 && tc < nblk {
                    outb = outb | live_in[tc]
                }
            }
            inn := gen[bi] | (outb & (kill[bi] ^ (0 - 1)))
            if outb != live_out[bi] || inn != live_in[bi] {
                live_out[bi] = outb
                live_in[bi] = inn
                changed = 1
            }
            if bi == 0 {
                <-
            } else {
                bi = bi - 1
            }
        }
        if changed == 0 {
            <-
        }
    }
    mut weight := []int{}
    mut cross := []int{}
    for _ in 0:nloc {
        weight.push(0)
        cross.push(0)
    }
    for loc in 0:nloc {
        if scalar[loc] == 0 || uses[loc] == 0 {
            ->
        }
        bit := 1 << loc
        mut first := nblk
        mut last := 0
        mut live_blocks := 0
        for bi in 0:nblk {
            live := ((live_in[bi] | live_out[bi] | block_refs[bi]) & bit) != 0
            if !live {
                ->
            }
            live_blocks = live_blocks + 1
            if bi < first {
                first = bi
            }
            if bi > last {
                last = bi
            }
            if block_call[bi] == 1 {
                cross[loc] = 1
            }
        }
        if live_blocks == 0 {
            ->
        }
        span := last - first + 1
        mut w := uses[loc] * 4 + live_blocks * 2 + span
        if cross[loc] == 1 {
            w = w + 16
        }
        weight[loc] = w
    }
    // Pick top 4 by weight (then cross, then loc id).
    for slot in 0:4 {
        mut best := -1
        mut bw := -1
        for loc in 0:nloc {
            if weight[loc] <= 0 {
                ->
            }
            mut taken := false
            for p in 0:slot {
                if out[p] == loc {
                    taken = true
                }
            }
            if taken {
                ->
            }
            mut better := false
            if weight[loc] > bw {
                better = true
            } else {
                if weight[loc] == bw && best >= 0 {
                    if cross[loc] > cross[best] {
                        better = true
                    } else {
                        if cross[loc] == cross[best] && loc < best {
                            better = true
                        }
                    }
                }
                if weight[loc] == bw && best < 0 {
                    better = true
                }
            }
            if better {
                best = loc
                bw = weight[loc]
            }
        }
        if best >= 0 {
            out[slot] = best
            weight[best] = 0
        }
    }
    << out
}

fn mir_block_has_chan_xu(m &types.Mir, fi int, bi int) int {
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { << 0 }
        k := types.mir_ikind(m, fi, ii)
        if k >= 30 && k <= 37 { << 1 }
        ii = types.mir_inext(m, fi, ii)
    }
    << 0
}

fn ls_apply_pins(m &types.Mir, fi int, pins &mut []int, ls &[]int) {
    nblk := types.mir_nblocks(m, fi)
    if pins.len != nblk * 4 {
        <<
    }
    for bi in 0:nblk {
        tkind := types.mir_btkind(m, fi, bi)
        mut self_loop := false
        if tkind == 1 && types.mir_bta(m, fi, bi) == bi {
            self_loop = true
        }
        if tkind == 2 && (types.mir_btb(m, fi, bi) == bi || types.mir_btc(m, fi, bi) == bi) {
            self_loop = true
        }
        if !self_loop {
            ->
        }
        if mir_block_has_chan_xu(m, fi, bi) != 0 {
            ->
        }
        mut refs := []int{}
        for _ in 0:64 {
            refs.push(0)
        }
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 {
                <-
            } else {
                ik := types.mir_ikind(m, fi, ii)
                mut loc := -1
                if ik == types.mi_load_local {
                    loc = types.mir_ib(m, fi, ii)
                }
                if ik == types.mi_store_local {
                    loc = types.mir_ia(m, fi, ii)
                }
                if loc >= 0 && loc < 64 {
                    refs[loc] = 1
                }
                ii = types.mir_inext(m, fi, ii)
            }
        }
        mut merged := []int{}
        for _ in 0:4 {
            merged.push(-1)
        }
        mut n := 0
        for li in 0:ls.len {
            if n >= 4 {
                <-
            } else {
                loc := ls[li]
                if loc >= 0 && loc < 64 && refs[loc] == 1 {
                    merged[n] = loc
                    n = n + 1
                }
            }
        }
        for p in 0:4 {
            if n >= 4 {
                <-
            } else {
                prev := pins[bi * 4 + p]
                if prev >= 0 {
                    mut seen := false
                    for q in 0:n {
                        if merged[q] == prev {
                            seen = true
                        }
                    }
                    if !seen {
                        merged[n] = prev
                        n = n + 1
                    }
                }
            }
        }
        if n > 0 {
            for p in 0:4 {
                pins[bi * 4 + p] = merged[p]
            }
        }
    }
    <<
}

// Mark the non-trivial strongly connected regions induced by CFG backedges.
// This is deliberately structural: no source/function names and no algorithm
// patterns.  a block is hot when it lies both after a backedge header and on a
// path back to its latch.  Self-loops keep using the older, more specialized
// path; this helper handles Clang-style inlined multi-block loops.
fn natural_loop_hot_blocks(m &types.Mir, fi int) []int {
    // Keep the clone: nested live MFn block access has a frozen Gen1 ABI
    // hazard. Preserve the exact per-backedge membership/count contract.
    mut f := types.mir_cfg_clone_fn(m, fi, false)
    nblk := f.blocks.len
    mut hot := []int{}
    for _ in 0:nblk { hot.push(0) }
    if nblk < 2 { << hot }
    // Build reverse edges once. Each reachability query visits a vertex once
    // instead of repeatedly scanning the whole CFG until a fixed point.
    mut pred_head := []int{}
    mut pred_from := []int{}
    mut pred_next := []int{}
    for _ in 0:nblk { pred_head.push(-1) }
    for bi in 0:nblk {
        mut x := -1
        mut y := -1
        tk := f.blocks[bi].tkind
        if tk == 1 { x = f.blocks[bi].ta }
        if tk == 2 { x = f.blocks[bi].tb
            y = f.blocks[bi].tc }
        for which in 0:2 {
            mut target := x
            if which == 1 { target = y }
            if target < 0 || target >= nblk { -> }
            edge := pred_from.len
            pred_from.push(bi)
            pred_next.push(pred_head[target])
            pred_head[target] = edge
        }
    }
    for latch in 0:nblk {
        mut targets := []int{}
        tk := f.blocks[latch].tkind
        if tk == 1 { targets.push(f.blocks[latch].ta) }
        else if tk == 2 { targets.push(f.blocks[latch].tb)
            targets.push(f.blocks[latch].tc) }
        for ti in 0:targets.len {
            header := targets[ti]
            if header < 0 || header >= latch { -> }
            mut from_header := []int{}
            mut to_latch := []int{}
            for _ in 0:nblk { from_header.push(0)
                to_latch.push(0) }
            mut queue := []int{}
            from_header[header] = 1
            queue.push(header)
            mut pos := 0
            while pos < queue.len {
                bi := queue[pos]
                pos += 1
                mut x := -1
                mut y := -1
                bk := f.blocks[bi].tkind
                if bk == 1 { x = f.blocks[bi].ta }
                if bk == 2 { x = f.blocks[bi].tb
                    y = f.blocks[bi].tc }
                for which in 0:2 {
                    mut target := x
                    if which == 1 { target = y }
                    if target < 0 || target >= nblk { -> }
                    if from_header[target] == 0 {
                        from_header[target] = 1
                        queue.push(target)
                    }
                }
            }
            queue = []int{}
            to_latch[latch] = 1
            queue.push(latch)
            pos = 0
            while pos < queue.len {
                bi := queue[pos]
                pos += 1
                mut edge := pred_head[bi]
                while edge >= 0 {
                    source := pred_from[edge]
                    if to_latch[source] == 0 {
                        to_latch[source] = 1
                        queue.push(source)
                    }
                    edge = pred_next[edge]
                }
            }
            mut count := 0
            for bi in 0:nblk {
                if from_header[bi] == 1 && to_latch[bi] == 1 { count += 1 }
            }
            if count > 1 {
                for bi in 0:nblk {
                    if from_header[bi] == 1 && to_latch[bi] == 1 { hot[bi] += 1 }
                }
            }
        }
    }
    << hot
}

fn natural_loop_apply_pins(m &types.Mir, fi int, pins &mut []int, hot &[]int) {
    nblk := types.mir_nblocks(m, fi)
    nloc := types.mir_nlocals(m, fi)
    if pins.len != nblk * 4 || hot.len != nblk || nloc == 0 || nloc > 64 { << }
    mut score := []int{}
    for _ in 0:nloc { score.push(0) }
    for bi in 0:nblk {
        if hot[bi] == 0 { -> }
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            ik := types.mir_ikind(m, fi, ii)
            mut loc := -1
            if ik == types.mi_load_local { loc = types.mir_ib(m, fi, ii) }
            if ik == types.mi_store_local { loc = types.mir_ia(m, fi, ii) }
            if loc >= 0 && loc < nloc && types.mir_local_nslots(m, fi, loc) == 1 && rc_pin_ty_ok(types.mir_local_ty(m, fi, loc)) {
                depth := hot[bi]
                score[loc] += depth * depth
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    // Prefer the three scalars of an assign diamond (`x = y` / `x = y + 1`)
    // so if-conversion can csel. Nested-loop frequency otherwise keeps the
    // outer induction over inner lo/hi/mid (inlined search_ints).
    for bi in 0:nblk {
        if hot[bi] == 0 {
            ->
        }
        if types.mir_btkind(m, fi, bi) != 2 {
            ->
        }
        yes := mir_if_local_assign(m, fi, types.mir_btb(m, fi, bi))
        no := mir_if_local_assign(m, fi, types.mir_btc(m, fi, bi))
        if yes.ok == 1 && no.ok == 1 && yes.join == no.join && yes.dst != no.dst && yes.src == no.src {
            d := hot[bi] * hot[bi] * 8
            if yes.dst >= 0 && yes.dst < nloc {
                if types.mir_local_nslots(m, fi, yes.dst) == 1 && rc_pin_ty_ok(types.mir_local_ty(m, fi, yes.dst)) {
                    score[yes.dst] += d
                }
            }
            if no.dst >= 0 && no.dst < nloc {
                if types.mir_local_nslots(m, fi, no.dst) == 1 && rc_pin_ty_ok(types.mir_local_ty(m, fi, no.dst)) {
                    score[no.dst] += d
                }
            }
            if yes.src >= 0 && yes.src < nloc {
                if types.mir_local_nslots(m, fi, yes.src) == 1 && rc_pin_ty_ok(types.mir_local_ty(m, fi, yes.src)) {
                    score[yes.src] += d
                }
            }
        }
    }
    mut common := []int{}
    for _ in 0:4 { common.push(-1) }
    for p in 0:4 {
        mut best := -1
        mut best_score := 0
        for loc in 0:nloc {
            mut seen := false
            for q in 0:p { if common[q] == loc { seen = true } }
            if !seen && score[loc] > best_score {
                best = loc
                best_score = score[loc]
            }
        }
        common[p] = best
    }
    if common[0] < 0 { << }
    for bi in 0:nblk {
        if hot[bi] == 0 { -> }
        // Self-loop pin ranking (induction + body reloads, hoist-only last)
        // is the specialized path. Nest-wide frequency would keep outer
        // `k` over inner `aik` and undo that ranking.
        tk := types.mir_btkind(m, fi, bi)
        mut sl := false
        if tk == 1 && types.mir_bta(m, fi, bi) == bi { sl = true }
        if tk == 2 && (types.mir_btb(m, fi, bi) == bi || types.mir_btc(m, fi, bi) == bi) {
            sl = true
        }
        if sl && pins[bi * 4] >= 0 { -> }
        for p in 0:4 { pins[bi * 4 + p] = common[p] }
    }
    <<
}
