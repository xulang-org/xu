@main

#xu/types

// Loop-block replacements for hosted arm64. VecPat and the shared
// shape helpers live here. Each pattern family is an emit_vec_*.xu
// file in this package. emit_vec_block dispatches them.

struct VecPat {
    kind    int
    ind     int
    acc     int
    mask    int
    limit   int
    limit_t int
    else_bb int
    arr     int
    fac     int
}

fn vec_none() VecPat {
    << VecPat{kind: 0, ind: -1, acc: -1, mask: 0, limit: 0, limit_t: -1, else_bb: -1, arr: -1, fac: -1}
}

fn vec_is_const1(m &types.Mir, fi int, v int) bool {
    if v >= 0 { << false }
    i := -v - 2
    if i < 0 { << false }
    if i >= types.mir_nconsts(m, fi) { << false }
    << types.mir_const_at(m, fi, i) == 1
}

fn vec_has_const(m &types.Mir, fi int, v int) bool {
    if v >= 0 { << false }
    i := -v - 2
    if i < 0 { << false }
    if i >= types.mir_nconsts(m, fi) { << false }
    << true
}

fn vec_const(m &types.Mir, fi int, v int) int {
    << types.mir_const_at(m, fi, -v - 2)
}

fn vec_load_is_local(m &types.Mir, fi int, bi int, tid int, loc int) bool {
    if tid < 0 { << false }
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 2 {
            if types.mir_ia(m, fi, ii) == tid && types.mir_ib(m, fi, ii) == loc {
                << true
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << false
}

fn vec_temp_from_local(m &types.Mir, fi int, bi int, tid int, loc int) bool {
    if vec_load_is_local(m, fi, bi, tid, loc) { << true }
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 1 && types.mir_ia(m, fi, ii) == tid {
            src := types.mir_ib(m, fi, ii)
            if vec_load_is_local(m, fi, bi, src, loc) {
                << true
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << false
}

fn vec_kinds_ok(m &types.Mir, fi int, bi int, want_idx int) bool {
    mut nidx := 0
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == 14 {
            nidx = nidx + 1
            if want_idx == 0 { << false }
        } else if k == 16 || k == 17 {
            if want_idx == 0 { << false }
        } else if k != 1 && k != 2 && k != 3 && k != 4 {
            << false
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if want_idx == 1 {
        if nidx != 1 { << false }
    }
    << true
}

fn vec_find_ind(m &types.Mir, fi int, bi int) int {
    mut ind := -1
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 3 {
            loc := types.mir_ia(m, fi, ii)
            st := types.mir_ib(m, fi, ii)
            if st >= 0 {
                mut jj := types.mir_bhead(m, fi, bi)
                for _ in 0:types.mir_nins(m, fi) {
                    if jj < 0 { <- }
                    if types.mir_ikind(m, fi, jj) == 4 && types.mir_ia(m, fi, jj) == st && types.mir_ib(m, fi, jj) == 1 {
                        lc := types.mir_ic(m, fi, jj)
                        ld := types.mir_id(m, fi, jj)
                        mut other := -1
                        if vec_is_const1(m, fi, ld) {
                            other = lc
                        } else if vec_is_const1(m, fi, lc) {
                            other = ld
                        }
                        if other >= 0 {
                            if vec_temp_from_local(m, fi, bi, other, loc) {
                                ind = loc
                            }
                        }
                    }
                    jj = types.mir_inext(m, fi, jj)
                }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << ind
}

fn vec_local_of_temp(m &types.Mir, fi int, bi int, tid int) int {
    if tid < 0 { << -1 }
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 2 && types.mir_ia(m, fi, ii) == tid {
            << types.mir_ib(m, fi, ii)
        }
        ii = types.mir_inext(m, fi, ii)
    }
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 1 && types.mir_ia(m, fi, ii) == tid {
            src := types.mir_ib(m, fi, ii)
            mut jj := types.mir_bhead(m, fi, bi)
            for _ in 0:types.mir_nins(m, fi) {
                if jj < 0 { <- }
                if types.mir_ikind(m, fi, jj) == 2 && types.mir_ia(m, fi, jj) == src {
                    << types.mir_ib(m, fi, jj)
                }
                jj = types.mir_inext(m, fi, jj)
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << -1
}

fn vec_local_stored(m &types.Mir, fi int, bi int, loc int) bool {
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 3 && types.mir_ia(m, fi, ii) == loc {
            << true
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << false
}

fn vec_find_lt_const(m &types.Mir, fi int, bi int, ind int) int {
    mut limit := 0
    mut found := false
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 4 && types.mir_ib(m, fi, ii) == 8 {
            lc := types.mir_ic(m, fi, ii)
            ld := types.mir_id(m, fi, ii)
            mut cv := 0
            mut side := -1
            if vec_has_const(m, fi, ld) {
                cv = vec_const(m, fi, ld)
                side = lc
            } else if vec_has_const(m, fi, lc) {
                cv = vec_const(m, fi, lc)
                side = ld
            }
            if side >= 0 && cv > 16 {
                if vec_temp_from_local(m, fi, bi, side, ind) {
                    limit = cv
                    found = true
                }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if found { << limit }
    << 0
}

fn vec_find_lt_temp(m &types.Mir, fi int, bi int, ind int) int {
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { << -1 }
        if types.mir_ikind(m, fi, ii) == 4 && types.mir_ib(m, fi, ii) == 8 {
            lc := types.mir_ic(m, fi, ii)
            ld := types.mir_id(m, fi, ii)
            if lc >= 0 && ld >= 0 {
                if vec_temp_from_local(m, fi, bi, lc, ind) {
                    << ld
                }
                if vec_temp_from_local(m, fi, bi, ld, ind) {
                    << lc
                }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << -1
}

// True when any self-loop matches the proved iand-reduce SIMD shape
// (`s += i & mask` with a const trip count). Used by emit_function to keep
// the legacy RegCache instead of fixed-home temps: coloring ephemeral SSA
// temps while leaving loop-carried locals on the stack disables rc_on and
// drops this peep for no gain (loop_sum regression vs Clang).
fn fn_has_iand_reduce_self_loop(m &types.Mir, fi int) bool {
    for bi in 0:types.mir_nblocks(m, fi) {
        k := match_iand_reduce(m, fi, bi).kind
        if k == 1 {
            << true
        }
        if match_mul_iand_reduce(m, fi, bi).kind == 3 {
            << true
        }
    }
    << false
}

// Integer-only self-loop: Copy/LoadLocal/StoreLocal/Bin/Un, 1-slot int/bool.
// vreg colors ephemeral temps and leaves loop-carried locals on the stack
// (nested_loop / match_sum). Keep RegCache so pins attach. Index/Call/mem
// stay on vreg. Not a function-name gate.
fn fn_self_loop_int_alu_only(m &types.Mir, fi int) bool {
    if types.mir_nblocks(m, fi) > 3 || fn_has_self_loop(m, fi) == 0 {
        << false
    }
    for li in 0:types.mir_nlocals(m, fi) {
        if types.mir_local_nslots(m, fi, li) != 1 {
            << false
        }
        ty := types.mir_local_ty(m, fi, li)
        if ty != 1 && ty != 2 {
            << false
        }
    }
    for ti in 0:types.mir_ntemps(m, fi) {
        if types.mir_temp_nslots(m, fi, ti) != 1 {
            << false
        }
        ty := types.mir_temp_ty(m, fi, ti)
        if ty != 1 && ty != 2 {
            << false
        }
    }
    mut saw := false
    for bi in 0:types.mir_nblocks(m, fi) {
        tkind := types.mir_btkind(m, fi, bi)
        mut sl := false
        if tkind == 1 && types.mir_bta(m, fi, bi) == bi {
            sl = true
        }
        if tkind == 2 && (types.mir_btb(m, fi, bi) == bi || types.mir_btc(m, fi, bi) == bi) {
            sl = true
        }
        if !sl {
            ->
        }
        saw = true
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            k := types.mir_ikind(m, fi, ii)
            if k != 1 && k != 2 && k != 3 && k != 4 && k != 5 {
                << false
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << saw
}

// `s += f64(i & k)`: 1-slot int+f64, no index/fdiv. Distinct from the
// disabled f64 index-acc kernel (LoadIndex + fdiv clobbered the pin).
fn fn_self_loop_f64_acc_only(m &types.Mir, fi int) bool {
    if fn_has_self_loop(m, fi) == 0 {
        << false
    }
    mut has_f64 := false
    for li in 0:types.mir_nlocals(m, fi) {
        if types.mir_local_nslots(m, fi, li) != 1 {
            << false
        }
        ty := types.mir_local_ty(m, fi, li)
        if ty == 4 {
            has_f64 = true
        } else if ty != 1 && ty != 2 {
            << false
        }
    }
    if !has_f64 {
        << false
    }
    for ti in 0:types.mir_ntemps(m, fi) {
        if types.mir_temp_nslots(m, fi, ti) != 1 {
            << false
        }
        ty := types.mir_temp_ty(m, fi, ti)
        if ty != 1 && ty != 2 && ty != 4 {
            << false
        }
    }
    mut saw := false
    for bi in 0:types.mir_nblocks(m, fi) {
        tkind := types.mir_btkind(m, fi, bi)
        mut sl := false
        if tkind == 1 && types.mir_bta(m, fi, bi) == bi {
            sl = true
        }
        if tkind == 2 && (types.mir_btb(m, fi, bi) == bi || types.mir_btc(m, fi, bi) == bi) {
            sl = true
        }
        if !sl {
            ->
        }
        saw = true
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            k := types.mir_ikind(m, fi, ii)
            if k != 1 && k != 2 && k != 3 && k != 4 && k != 5 {
                << false
            }
            if k == 4 && types.mir_ib(m, fi, ii) == 4 {
                da := types.mir_ia(m, fi, ii)
                if da >= 0 && da < types.mir_ntemps(m, fi) {
                    if types.mir_temp_ty(m, fi, da) == 4 {
                        << false
                    }
                }
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << saw
}

fn fn_self_loop_iface_method(m &types.Mir, fi int) bool {
    if fn_has_self_loop(m, fi) == 0 {
        << false
    }
    mut f := types.mir_cfg_clone_fn(m, fi, false)
    mut saw := false
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := types.mfn_ikind(&f.instrs, ii)
            if k == 43 {
                saw = true
            }
            if k == 7 {
                ck := types.mfn_ib(&f.instrs, ii)
                if ck != 2 && ck != 3 && ck != 4 && ck != 5 {
                    << false
                }
            }
            ii = types.mfn_inext(&f.instrs, ii)
        }
    }
    << saw
}

// Prefer RegCache over fixed-home when the function has a proved SIMD
// iand-reduce loop, or a self-loop whose only fn-value calls peep to a
// binop (no `blr`). Fail-closed: any unknown indirect call keeps vregs.
fn fn_keeps_rc_over_vreg(m &types.Mir, fi int) bool {
    if fn_has_iand_reduce_self_loop(m, fi) {
        << true
    }
    if fn_self_loop_int_alu_only(m, fi) {
        << true
    }
    if fn_self_loop_f64_acc_only(m, fi) {
        << true
    }
    // nbody-style f64 FieldRMW: RC owns the SIMD pool and FMA peeps. vreg coloring
    // of integer i/j would set has_vreg and clear rc_on, leaving every
    // f64 binop on d0/d1 scratch.
    if fn_is_f64_field_rmw_kernel(m, fi) {
        << false
    }
    if fn_self_loop_iface_method(m, fi) {
        << true
    }
    if fn_has_self_loop(m, fi) == 0 && fn_has_natural_loop(m, fi) == 0 {
        << false
    }
    mut n_peep := 0
    mut n_bad := 0
    // Live CFG only. Dense 0..nins hits leftover Call 80 from CFG rewrites
    // (same Gen1 pool-kind issue as nbody `advance` / product_rc).
    for bi in 0:types.mir_nblocks(m, fi) {
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            if types.mir_ikind(m, fi, ii) == 7 {
                ck := types.mir_ib(m, fi, ii)
                if ck == 80 {
                    if mir_fnval_call_is_binop_peep(m, fi, ii) {
                        n_peep += 1
                    } else {
                        n_bad += 1
                    }
                } else if ck == 1 && bits_call_is_peep_label(m, fi, ii) {
                    n_peep += 1
                }
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << n_peep > 0 && n_bad == 0
}

fn vec_operand_is_one(m &types.Mir, fi int, bi int, v int) bool {
    if vec_is_const1(m, fi, v) { << true }
    if v < 0 { << false }
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 1 && types.mir_ia(m, fi, ii) == v {
            if vec_is_const1(m, fi, types.mir_ib(m, fi, ii)) { << true }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << false
}

fn vec_elem8(w int) bool {
    if w == 8 { << true }
    if w == 0 - 8 { << true }
    << false
}

fn vec_temp_eq(m &types.Mir, fi int, bi int, t int, src int) bool {
    if t == src { << true }
    if t < 0 || src < 0 { << false }
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 1 && types.mir_ia(m, fi, ii) == t {
            if types.mir_ib(m, fi, ii) == src { << true }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << false
}

// Follow Copy in `bi` to a LoadLocal (tagged) or a value defined elsewhere.
fn vec_trace(m &types.Mir, fi int, bi int, t int) int {
    mut cur := t
    for _ in 0:types.mir_nins(m, fi) {
        if cur < 0 { << cur }
        if cur >= types.mir_local_operand_base { << cur }
        mut found := false
        mut next := cur
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            k := types.mir_ikind(m, fi, ii)
            if k == 1 && types.mir_ia(m, fi, ii) == cur {
                next = types.mir_ib(m, fi, ii)
                found = true
                <-
            }
            if k == 2 && types.mir_ia(m, fi, ii) == cur {
                << types.mir_local_operand_base + types.mir_ib(m, fi, ii)
            }
            ii = types.mir_inext(m, fi, ii)
        }
        if !found { << cur }
        if next == cur { << cur }
        cur = next
    }
    << cur
}

fn vec_same_val(m &types.Mir, fi int, bi int, a int, b int) bool {
    if a == b { << true }
    ta := vec_trace(m, fi, bi, a)
    tb := vec_trace(m, fi, bi, b)
    << ta == tb
}

// Temp `t` (or a Copy of it) plus const 1 in this block.
fn vec_is_add1_of(m &types.Mir, fi int, bi int, dest int, t int) bool {
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 4 && types.mir_ib(m, fi, ii) == 1 && types.mir_ia(m, fi, ii) == dest {
            lc := types.mir_ic(m, fi, ii)
            ld := types.mir_id(m, fi, ii)
            if vec_operand_is_one(m, fi, bi, ld) && vec_same_val(m, fi, bi, lc, t) { << true }
            if vec_operand_is_one(m, fi, bi, lc) && vec_same_val(m, fi, bi, ld, t) { << true }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << false
}

fn vec_find_add1_dest(m &types.Mir, fi int, bi int, t int) int {
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 4 && types.mir_ib(m, fi, ii) == 1 {
            dest := types.mir_ia(m, fi, ii)
            lc := types.mir_ic(m, fi, ii)
            ld := types.mir_id(m, fi, ii)
            if vec_operand_is_one(m, fi, bi, ld) && vec_same_val(m, fi, bi, lc, t) { << dest }
            if vec_operand_is_one(m, fi, bi, lc) && vec_same_val(m, fi, bi, ld, t) { << dest }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << -1
}

fn vec_pick_induct(m &types.Mir, fi int, bi int, idx int) int {
    loc := vec_find_ind_copy(m, fi, bi)
    if loc >= 0 { << types.mir_local_operand_base + loc }
    tr := vec_trace(m, fi, bi, idx)
    if tr < 0 { << -1 }
    add1 := vec_find_add1_dest(m, fi, bi, tr)
    if add1 < 0 { << -1 }
    << tr
}

fn vec_elem24(w int) bool {
    if w == 24 { << true }
    if w == 0 - 24 { << true }
    << false
}

fn vec_defined_here(m &types.Mir, fi int, bi int, t int) bool {
    if t < 0 { << false }
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == 1 || k == 2 || k == 4 || k == 5 || k == 10 || k == 14 || k == 17 || k == 26 {
            if types.mir_ia(m, fi, ii) == t { << true }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << false
}

fn vec_resolve_desc(m &types.Mir, fi int, bi int, arr int) int {
    if arr >= types.mir_local_operand_base { << arr }
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 2 && types.mir_ia(m, fi, ii) == arr {
            << types.mir_local_operand_base + types.mir_ib(m, fi, ii)
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << arr
}

fn vec_copy_kind_ok(k int) bool {
    if k == 0 || k == 1 || k == 2 || k == 3 || k == 4 { << true }
    if k == 14 || k == 20 { << true }
    << false
}

// Follow empty Jump blocks (O1 leaves some jump chains unmerged).
fn vec_skip_empty(m &types.Mir, fi int, start int) int {
    mut bi := start
    n := types.mir_nblocks(m, fi)
    for _ in 0:n {
        if bi < 0 || bi >= n { << -1 }
        if types.mir_bhead(m, fi, bi) >= 0 { << bi }
        if types.mir_btkind(m, fi, bi) != 1 { << bi }
        to := types.mir_bta(m, fi, bi)
        if to == bi { << bi }
        bi = to
    }
    << -1
}

fn vec_dest_is(m &types.Mir, fi int, dest int, want int) bool {
    if dest == want { << true }
    << vec_skip_empty(m, fi, dest) == want
}

// True when `from` is a Jump (or empty-jump chain) back to `want`.
// The latch may contain Copies / LoadLocal; anything else is not a trampoline.
fn vec_back_jump(m &types.Mir, fi int, from int, want int) bool {
    d := vec_skip_empty(m, fi, from)
    if d < 0 { << false }
    if d == want { << true }
    if types.mir_btkind(m, fi, d) != 1 { << false }
    mut ii := types.mir_bhead(m, fi, d)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k != 0 && k != 1 && k != 2 { << false }
        ii = types.mir_inext(m, fi, ii)
    }
    << vec_dest_is(m, fi, types.mir_bta(m, fi, d), want)
}

fn vec_edge_to(m &types.Mir, fi int, dest int, want int) bool {
    if vec_dest_is(m, fi, dest, want) { << true }
    << vec_back_jump(m, fi, dest, want)
}

// Header of a `dst[i]=src[i]` loop whose copy ops live in `bi`.
// Self-loop: `bi`. 2-block: `bi` Jumps (through empty blocks) to a Branch
// whose one dest is `bi`.
fn vec_copy_header(m &types.Mir, fi int, bi int) int {
    n := types.mir_nblocks(m, fi)
    if bi < 0 || bi >= n { << -1 }
    tk := types.mir_btkind(m, fi, bi)
    mut tb := -1
    mut tc := -1
    if tk == 2 {
        tb = types.mir_btb(m, fi, bi)
        tc = types.mir_btc(m, fi, bi)
        if vec_edge_to(m, fi, tb, bi) || vec_edge_to(m, fi, tc, bi) { << bi }
        << -1
    }
    if tk != 1 { << -1 }
    h := vec_skip_empty(m, fi, types.mir_bta(m, fi, bi))
    if h < 0 || h == bi { << -1 }
    if types.mir_btkind(m, fi, h) != 2 { << -1 }
    tb = types.mir_btb(m, fi, h)
    tc = types.mir_btc(m, fi, h)
    if vec_edge_to(m, fi, tb, bi) || vec_edge_to(m, fi, tc, bi) { << h }
    << -1
}

fn vec_copy_else(m &types.Mir, fi int, header int, body int) int {
    tb := types.mir_btb(m, fi, header)
    tc := types.mir_btc(m, fi, header)
    tb_hit := vec_edge_to(m, fi, tb, body)
    tc_hit := vec_edge_to(m, fi, tc, body)
    if tb_hit && !tc_hit { << tc }
    if tc_hit && !tb_hit { << tb }
    << -1
}

// i < K (const >= 4) or i < n (local / LICM temp) in `bi`.
fn vec_copy_limit_in(m &types.Mir, fi int, bi int, ind int) VecPat {
    << vec_copy_limit_cmp(m, fi, bi, ind, 8)
}

// op 8 = Lt (`i < n`). op 9 = Le (`i <= n`) rewritten as trip count n+1.
fn vec_copy_limit_cmp(m &types.Mir, fi int, bi int, ind int, op int) VecPat {
    mut r := vec_none()
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 4 && types.mir_ib(m, fi, ii) == op {
            lc := types.mir_ic(m, fi, ii)
            ld := types.mir_id(m, fi, ii)
            mut cv := 0
            mut side := -1
            mut const_rhs := false
            if vec_has_const(m, fi, ld) {
                cv = vec_const(m, fi, ld)
                side = lc
                const_rhs = true
            } else if vec_has_const(m, fi, lc) {
                cv = vec_const(m, fi, lc)
                side = ld
            }
            mut i_side := false
            mut add1 := -1
            if side >= 0 && cv >= 4 {
                if op == 9 && !const_rhs {
                    i_side = false
                } else if ind >= types.mir_local_operand_base {
                    i_side = vec_temp_from_local(m, fi, bi, side, ind - types.mir_local_operand_base)
                } else {
                    i_side = vec_same_val(m, fi, bi, side, ind)
                    if !i_side {
                        add1 = vec_find_add1_dest(m, fi, bi, ind)
                        if add1 >= 0 { i_side = vec_same_val(m, fi, bi, side, add1) }
                    }
                }
                if i_side {
                    r.kind = 1
                    r.limit = cv
                    if op == 9 {
                        r.limit = cv + 1
                    }
                    r.limit_t = -1
                    << r
                }
            }
            if lc >= 0 && ld >= 0 {
                mut limt := -1
                mut lhs_i := false
                mut rhs_i := false
                if ind >= types.mir_local_operand_base {
                    lid := ind - types.mir_local_operand_base
                    lhs_i = vec_temp_from_local(m, fi, bi, lc, lid)
                    rhs_i = vec_temp_from_local(m, fi, bi, ld, lid)
                } else {
                    lhs_i = vec_same_val(m, fi, bi, lc, ind)
                    rhs_i = vec_same_val(m, fi, bi, ld, ind)
                    if !lhs_i && !rhs_i {
                        add1 = vec_find_add1_dest(m, fi, bi, ind)
                        if add1 >= 0 {
                            lhs_i = vec_same_val(m, fi, bi, lc, add1)
                            rhs_i = vec_same_val(m, fi, bi, ld, add1)
                        }
                    }
                }
                if op == 9 {
                    rhs_i = false
                }
                if lhs_i { limt = ld }
                if rhs_i { limt = lc }
                if limt >= 0 {
                    traced := vec_trace(m, fi, bi, limt)
                    r.kind = 1
                    r.limit = 0
                    if op == 9 {
                        r.limit = 1
                    }
                    r.limit_t = traced
                    << r
                }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << r
}

// The emitter and admission policy share the same ordered, non-mutating
// MIR match query. Fixed scalar homes must not suppress a proved whole-block
// replacement before that replacement has a compatible scratch contract.
fn match_vec_block(m &types.Mir, fi int, bi int) VecPat {
    p := match_iand_reduce(m, fi, bi)
    if p.kind == 1 { << p }
    p3 := match_mul_iand_reduce(m, fi, bi)
    if p3.kind == 3 { << p3 }
    p2 := match_scan_reduce(m, fi, bi)
    if p2.kind == 2 { << p2 }
    p4 := match_byte_add_reduce(m, fi, bi)
    if p4.kind == 4 { << p4 }
    p5 := match_index_copy(m, fi, bi)
    if p5.kind == 5 { << p5 }
    p6 := match_vec3_sqnorm(m, fi, bi)
    if p6.kind == 6 { << p6 }
    p7 := match_scan_carry(m, fi, bi)
    if p7.kind == 7 { << p7 }
    p9 := match_saxpy_rmw47(m, fi, bi)
    if p9.kind == 9 { << p9 }
    p8 := match_saxpy_rmw(m, fi, bi)
    if p8.kind == 8 { << p8 }
    p14 := match_crc_bit8(m, fi, bi)
    if p14.kind == 14 { << p14 }
    p12 := match_push_fill(m, fi, bi)
    if p12.kind == 12 { << p12 }
    p15 := match_stride_zero(m, fi, bi)
    if p15.kind == 15 { << p15 }
    p16 := match_pred_scan(m, fi, bi)
    if p16.kind == 16 { << p16 }
    p17 := match_bsearch(m, fi, bi)
    if p17.kind == 17 { << p17 }
    p18 := match_index_set(m, fi, bi)
    if p18.kind == 18 { << p18 }
    p19 := match_byte_pipe(m, fi, bi)
    if p19.kind == 19 { << p19 }
    << vec_none()
}

fn emit_vec_block(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, pins &[]int) int {
    // Whole-loop proofs require optimized MIR; O0 keeps the scalar reference.
    if m.opt_level == 0 { << 0 }
    // Pattern match is fail-closed on MIR shape. Do not require rc_on: the
    // fixed-home path clears rc_on even when loop-carried locals stay on the
    // frame, and this peep replaces the whole block with SIMD scratch.
    eq16 := try_eq16_jump(a, m, fi, fr, bi)
    if eq16 != 0 { << eq16 }
    if a.arch != 0 {
        // x64 norms use its complete prefix proof or the ordinary FP emitter.
        p := match_vec_block(m, fi, bi)
        if p.kind == 3 && p.mask >= 0 && p.mask <= 65535 && ((p.mask + 1) & p.mask) == 0 {
            << emit_vec_mul_iand(a, m, fi, fr, bi, pins, p)
        }
        if p.kind == 14 {
            << emit_crc_bit8(a, m, fi, fr, bi, pins, p)
        }
        if p.kind == 19 {
            << emit_byte_pipe(a, m, fi, fr, bi, p)
        }
        if p.kind == 7 {
            << emit_scan_carry(a, m, fi, fr, bi, pins, p)
        }
        << 0
    }
    p := match_vec_block(m, fi, bi)
    if p.kind == 1 { << emit_vec_iand(a, m, fi, fr, bi, pins, p) }
    if p.kind == 3 { << emit_vec_mul_iand(a, m, fi, fr, bi, pins, p) }
    if p.kind == 2 { << emit_vec_scan(a, m, fi, fr, bi, pins, p) }
    if p.kind == 4 { << emit_vec_byte_add(a, m, fi, fr, bi, pins, p) }
    if p.kind == 5 { << emit_vec_index_copy(a, m, fi, fr, bi, pins, p) }
    if p.kind == 6 { << emit_vec3_sqnorm(a, m, fi, fr, bi, pins, p) }
    if p.kind == 7 { << emit_scan_carry(a, m, fi, fr, bi, pins, p) }
    if p.kind == 9 { << emit_saxpy_rmw47(a, m, fi, fr, bi, pins, p) }
    if p.kind == 8 { << emit_saxpy_rmw(a, m, fi, fr, bi, pins, p) }
    if p.kind == 14 { << emit_crc_bit8(a, m, fi, fr, bi, pins, p) }
    if p.kind == 12 { << emit_vec_push_fill(a, m, fi, fr, bi, pins, p) }
    if p.kind == 15 { << emit_stride_zero(a, m, fi, fr, bi, pins, p) }
    if p.kind == 16 { << emit_pred_scan(a, m, fi, fr, bi, pins, p) }
    if p.kind == 17 { << emit_bsearch(a, m, fi, fr, bi, pins, p) }
    if p.kind == 18 { << emit_index_set(a, m, fi, fr, bi, p) }
    if p.kind == 19 { << emit_byte_pipe(a, m, fi, fr, bi, p) }
    << emit_push_fuse(a, m, fi, fr, bi, pins)
}
