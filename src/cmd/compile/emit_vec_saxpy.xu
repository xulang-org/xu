        }
    }
    if bb_mul >= 0 {
        mut ma := types.mir_ic(m, fi, bb_mul)
        mut mb := types.mir_id(m, fi, bb_mul)
        mut bo := 0
        for _ in 0:nb2 {
            mut r := vec_trace(m, fi, bo, ma)
            if r >= 1073741824 { ma = r }
            r = vec_trace(m, fi, bo, mb)
            if r >= 1073741824 { mb = r }
