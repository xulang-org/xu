    if ind_local >= 0 {
        a.load(20, 15, slot_off(fr.local_slot[ind_local]))
    } else {
        emit_load_value(a, m, fi, fr, ind_temp, 20)
    }
    if lim_local >= 0 {
        a.load(19, 15, slot_off(fr.local_slot[lim_local]))
    } else if p.limit_t >= 0 {
        emit_load_value(a, m, fi, fr, p.limit_t, 19)
    } else {
        a.vm_mov_imm64(19, p.limit)
    }
    if p.acc >= 1073741824 {
        al := p.acc - 1073741824
        if al < 0 || al >= fr.local_slot.len { << 0 }
        a.load(23, 15, slot_off(fr.local_slot[al]))
    } else {
        emit_load_value(a, m, fi, fr, p.acc, 23)
    }
    mut bc_mul := -1
    mut bb_mul := -1
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 4 && types.mir_ib(m, fi, ii) == 3 {
            dest := types.mir_ia(m, fi, ii)
            if vec_same_val(m, fi, bi, dest, base_c) { bc_mul = ii }
            if vec_same_val(m, fi, bi, dest, base_b) { bb_mul = ii }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    nb2 := types.mir_nblocks(m, fi)
    if bc_mul >= 0 {
        mut ma := types.mir_ic(m, fi, bc_mul)
        mut mb := types.mir_id(m, fi, bc_mul)
        mut bo := 0
        for _ in 0:nb2 {
            mut r := vec_trace(m, fi, bo, ma)
