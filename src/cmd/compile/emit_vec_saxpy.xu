    }
    a.vm_cmp_imm(20, 0)
    a.oob_need = 1
    a.jlt(a.oob_lbl + "")
    a.cmp(20, 19)
    a.jgt(a.oob_lbl + "")
    a.vm_cmp_imm(21, 0)
    a.jlt(a.oob_lbl + "")
    a.vm_cmp_imm(1, 0)
    a.jlt(a.oob_lbl + "")
    emit_index_desc_addr(a, m, fi, fr, arr_c)
    a.load(14, 0, -8)
    a.add(22, 21, 19)
    a.cmp(14, 22)
    a.jlt(a.oob_lbl + "")
    a.load(0, 0, 0)
    a.add(22, 21, 20)
    a.add_lsl_vr(21, 0, 22, 3)
    emit_index_desc_addr(a, m, fi, fr, arr_b)
