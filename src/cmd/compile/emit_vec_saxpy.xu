        }
        if mb >= 1073741824 {
            a.load(14, 15, slot_off(fr.local_slot[mb - 1073741824]))
        } else if mb < 0 {
            a.vm_mov_imm64(14, types.mir_const_at(m, fi, -mb - 2))
        } else {
            emit_load_value(a, m, fi, fr, mb, 14)
        }
        a.mul(0, 0, 14)
        a.mov(21, 0)
    } else {
        mut bc := vec_trace(m, fi, bi, base_c)
        mut bo := 0
        for _ in 0:nb2 {
            mut r := vec_trace(m, fi, bo, bc)
            if r >= 1073741824 { bc = r }
            mut d := vec_resolve_desc(m, fi, bo, bc)
            if d >= 1073741824 { bc = d }
            bo += 1
        }
        if bc >= 1073741824 {
            a.load(21, 15, slot_off(fr.local_slot[bc - 1073741824]))
