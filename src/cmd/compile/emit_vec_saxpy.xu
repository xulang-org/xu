@main

#xu/types

// Indexed saxpy updates.


// `c[base_c + j] += aik * b[base_b + j]` as LoadIndex + IndexRMW add.
// 2-wide ldp/madd/stp + scalar tail. OOB: j>=0, j<=n, base>=0, base+n <= len for both arrays.
fn match_saxpy_rmw47(m &types.Mir, fi int, bi int) VecPat {
    mut header := vec_copy_header(m, fi, bi)
    mut else_bb := -1
    if header >= 0 {
        else_bb = vec_copy_else(m, fi, header, bi)
    }
    mut nld := 0
    mut nst := 0
    mut nmul := 0
    mut nrmw := 0
    mut ld0 := -1
    mut rmw_ii := -1
    mut badk := -1
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == types.MI_LOAD_INDEX {
            if !vec_elem8(types.mir_id(m, fi, ii)) { << vec_none() }
            if nld == 0 { ld0 = ii }
            nld += 1
        } else if k == types.MI_STORE_INDEX {
            nst += 1
        } else if k == types.MI_INDEX_RMW {
            if !vec_elem8(types.mir_id(m, fi, ii)) { << vec_none() }
            if types.mir_icol(m, fi, ii) != 1 { << vec_none() }
            rmw_ii = ii
            nrmw += 1
        } else if k == types.MI_BIN && types.mir_ib(m, fi, ii) == 3 {
            nmul += 1
        } else if k != types.MI_NOP && k != types.MI_COPY && k != types.MI_LOAD_LOCAL && k != types.MI_STORE_LOCAL && k != types.MI_BIN {
            badk = k
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if nrmw >= 1 {
    }
    if header < 0 || else_bb < 0 { << vec_none() }
    if badk >= 0 { << vec_none() }
    if nld != 1 || nst != 0 || nrmw != 1 { << vec_none() }
    if nmul < 1 { << vec_none() }
    rmw_idx := types.mir_ib(m, fi, rmw_ii)
    mut ind := vec_pick_induct(m, fi, bi, rmw_idx)
    if ind < 0 {
        << vec_none()
    }
    if ind < types.MIR_LOCAL_OPERAND_BASE {
        nb := types.mir_nblocks(m, fi)
        mut b := 0
        for _ in 0:nb {
            r := vec_trace(m, fi, b, ind)
            if r >= types.MIR_LOCAL_OPERAND_BASE {
                ind = r
                <-
            }
            d := vec_resolve_desc(m, fi, b, ind)
            if d >= types.MIR_LOCAL_OPERAND_BASE {
                ind = d
                <-
            }
            b += 1
        }
    }
    b_val := types.mir_ia(m, fi, ld0)
    rmw_rhs := types.mir_ic(m, fi, rmw_ii)
    mut aik := -1
    mut mul_dest := -1
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == types.MI_BIN && types.mir_ib(m, fi, ii) == 3 {
            dest := types.mir_ia(m, fi, ii)
            lc := types.mir_ic(m, fi, ii)
            ld := types.mir_id(m, fi, ii)
            if vec_same_val(m, fi, bi, dest, rmw_rhs) {
                if vec_same_val(m, fi, bi, lc, b_val) && !vec_same_val(m, fi, bi, ld, b_val) {
                    aik = ld
                    mul_dest = dest
                } else if vec_same_val(m, fi, bi, ld, b_val) && !vec_same_val(m, fi, bi, lc, b_val) {
                    aik = lc
                    mul_dest = dest
                }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if aik < 0 || mul_dest < 0 {
        << vec_none()
    }
    if vec_same_val(m, fi, bi, aik, ind) {
        << vec_none()
    }
    mut base_c := -1
    mut base_b := -1
    bidx := types.mir_ic(m, fi, ld0)
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == types.MI_BIN && types.mir_ib(m, fi, ii) == 1 {
            dest := types.mir_ia(m, fi, ii)
            lc := types.mir_ic(m, fi, ii)
            ld := types.mir_id(m, fi, ii)
            if vec_same_val(m, fi, bi, dest, rmw_idx) {
                if vec_same_val(m, fi, bi, lc, ind) { base_c = ld }
                if vec_same_val(m, fi, bi, ld, ind) { base_c = lc }
            }
            if vec_same_val(m, fi, bi, dest, bidx) {
                if vec_same_val(m, fi, bi, lc, ind) { base_b = ld }
                if vec_same_val(m, fi, bi, ld, ind) { base_b = lc }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if base_c < 0 || base_b < 0 {
        << vec_none()
    }
    mut c_arr := vec_trace(m, fi, bi, types.mir_ia(m, fi, rmw_ii))
    mut b_arr := vec_trace(m, fi, bi, types.mir_ib(m, fi, ld0))
    if vec_same_val(m, fi, bi, c_arr, b_arr) {
        << vec_none()
    }
    n := types.mir_nblocks(m, fi)
    mut b := 0
    for _ in 0:n {
        r0 := vec_trace(m, fi, b, c_arr)
        r1 := vec_trace(m, fi, b, b_arr)
        r2 := vec_trace(m, fi, b, aik)
        if r0 >= types.MIR_LOCAL_OPERAND_BASE { c_arr = r0 }
        if r1 >= types.MIR_LOCAL_OPERAND_BASE { b_arr = r1 }
        if r2 >= types.MIR_LOCAL_OPERAND_BASE { aik = r2 }
        d0 := vec_resolve_desc(m, fi, b, c_arr)
        d1 := vec_resolve_desc(m, fi, b, b_arr)
        d2 := vec_resolve_desc(m, fi, b, aik)
        if d0 >= types.MIR_LOCAL_OPERAND_BASE { c_arr = d0 }
        if d1 >= types.MIR_LOCAL_OPERAND_BASE { b_arr = d1 }
        if d2 >= types.MIR_LOCAL_OPERAND_BASE { aik = d2 }
        b += 1
    }
    mut lim := vec_copy_limit_in(m, fi, header, ind)
    if lim.kind == 0 && header != bi {
        lim = vec_copy_limit_in(m, fi, bi, ind)
    }
    if lim.kind == 0 {
        << vec_none()
    }
    << VecPat{kind: VP_SAXPY_RMW47, ind: ind, acc: aik, mask: 0, limit: lim.limit, limit_t: lim.limit_t, else_bb: else_bb, arr: c_arr, fac: b_arr}
}

fn emit_saxpy_rmw47(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, p VecPat) int {
    if p.ind < 0 { << 0 }
    if p.else_bb < 0 { << 0 }
    if p.acc < 0 { << 0 }
    mut ind_local := -1
    mut ind_temp := -1
    if p.ind >= types.MIR_LOCAL_OPERAND_BASE {
        ind_local = p.ind - types.MIR_LOCAL_OPERAND_BASE
        if ind_local < 0 || ind_local >= fr.local_slot.len { << 0 }
    } else {
        ind_temp = p.ind
        if ind_temp >= fr.temp_slot.len { << 0 }
    }
    mut arr_c := vec_resolve_desc(m, fi, bi, p.arr)
    mut arr_b := vec_resolve_desc(m, fi, bi, p.fac)
    nb0 := types.mir_nblocks(m, fi)
    mut bo0 := 0
    for _ in 0:nb0 {
        d0 := vec_resolve_desc(m, fi, bo0, arr_c)
        d1 := vec_resolve_desc(m, fi, bo0, arr_b)
        if d0 >= types.MIR_LOCAL_OPERAND_BASE { arr_c = d0 }
        if d1 >= types.MIR_LOCAL_OPERAND_BASE { arr_b = d1 }
        bo0 += 1
    }
    if arr_c < types.MIR_LOCAL_OPERAND_BASE { << 0 }
    if arr_b < types.MIR_LOCAL_OPERAND_BASE { << 0 }
    mut lim_local := -1
    if p.limit_t >= types.MIR_LOCAL_OPERAND_BASE {
        lim_local = p.limit_t - types.MIR_LOCAL_OPERAND_BASE
        if lim_local < 0 || lim_local >= fr.local_slot.len { << 0 }
    } else if p.limit_t >= 0 {
        if p.limit_t >= fr.temp_slot.len { << 0 }
    } else if p.limit <= 0 {
        << 0
    }
    mut rmw_ii := -1
    mut ld_b := -1
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == types.MI_INDEX_RMW { rmw_ii = ii }
        if k == types.MI_LOAD_INDEX { ld_b = ii }
        ii = types.mir_inext(m, fi, ii)
    }
    if rmw_ii < 0 || ld_b < 0 { << 0 }
    rmw_idx := types.mir_ib(m, fi, rmw_ii)
    bidx := types.mir_ic(m, fi, ld_b)
    mut base_c := -1
    mut base_b := -1
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == types.MI_BIN && types.mir_ib(m, fi, ii) == 1 {
            dest := types.mir_ia(m, fi, ii)
            lc := types.mir_ic(m, fi, ii)
            ld := types.mir_id(m, fi, ii)
            if vec_same_val(m, fi, bi, dest, rmw_idx) {
                if vec_same_val(m, fi, bi, lc, p.ind) { base_c = ld }
                if vec_same_val(m, fi, bi, ld, p.ind) { base_c = lc }
            }
            if vec_same_val(m, fi, bi, dest, bidx) {
                if vec_same_val(m, fi, bi, lc, p.ind) { base_b = ld }
                if vec_same_val(m, fi, bi, ld, p.ind) { base_b = lc }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if base_c < 0 || base_b < 0 { << 0 }
    // A1=n A2=j A3=ptr_c A4=ptr_b A5=aik V0/V1/Ret scratch. No V2-V7/S0-S5.
    if ind_local >= 0 {
        a.load(20, 15, slot_off(fr.local_slot[ind_local]))
    } else {
        emit_load_value(a, m, fi, fr, ind_temp, 20)
    }
    if lim_local >= 0 {
        a.load(19, 15, slot_off(fr.local_slot[lim_local]))
    } else if p.limit_t >= 0 {
        emit_load_value(a, m, fi, fr, p.limit_t, 19)
    } else {
        a.vm_mov_imm64(19, p.limit)
    }
    if p.acc >= types.MIR_LOCAL_OPERAND_BASE {
        al := p.acc - types.MIR_LOCAL_OPERAND_BASE
        if al < 0 || al >= fr.local_slot.len { << 0 }
        a.load(23, 15, slot_off(fr.local_slot[al]))
    } else {
        emit_load_value(a, m, fi, fr, p.acc, 23)
    }
    mut bc_mul := -1
    mut bb_mul := -1
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == types.MI_BIN && types.mir_ib(m, fi, ii) == 3 {
            dest := types.mir_ia(m, fi, ii)
            if vec_same_val(m, fi, bi, dest, base_c) { bc_mul = ii }
            if vec_same_val(m, fi, bi, dest, base_b) { bb_mul = ii }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    nb2 := types.mir_nblocks(m, fi)
    if bc_mul >= 0 {
        mut ma := types.mir_ic(m, fi, bc_mul)
        mut mb := types.mir_id(m, fi, bc_mul)
        mut bo := 0
        for _ in 0:nb2 {
            mut r := vec_trace(m, fi, bo, ma)
            if r >= types.MIR_LOCAL_OPERAND_BASE { ma = r }
            r = vec_trace(m, fi, bo, mb)
            if r >= types.MIR_LOCAL_OPERAND_BASE { mb = r }
            mut d := vec_resolve_desc(m, fi, bo, ma)
            if d >= types.MIR_LOCAL_OPERAND_BASE { ma = d }
            d = vec_resolve_desc(m, fi, bo, mb)
            if d >= types.MIR_LOCAL_OPERAND_BASE { mb = d }
            bo += 1
        }
        if ma >= types.MIR_LOCAL_OPERAND_BASE {
            a.load(0, 15, slot_off(fr.local_slot[ma - types.MIR_LOCAL_OPERAND_BASE]))
        } else if ma < 0 {
            a.vm_mov_imm64(0, types.mir_const_at(m, fi, -ma - 2))
        } else {
            emit_load_value(a, m, fi, fr, ma, 0)
        }
        if mb >= types.MIR_LOCAL_OPERAND_BASE {
            a.load(14, 15, slot_off(fr.local_slot[mb - types.MIR_LOCAL_OPERAND_BASE]))
        } else if mb < 0 {
            a.vm_mov_imm64(14, types.mir_const_at(m, fi, -mb - 2))
        } else {
            emit_load_value(a, m, fi, fr, mb, 14)
        }
        a.mul(0, 0, 14)
        a.mov(21, 0)
    } else {
        mut bc := vec_trace(m, fi, bi, base_c)
        mut bo := 0
        for _ in 0:nb2 {
            mut r := vec_trace(m, fi, bo, bc)
            if r >= types.MIR_LOCAL_OPERAND_BASE { bc = r }
            mut d := vec_resolve_desc(m, fi, bo, bc)
            if d >= types.MIR_LOCAL_OPERAND_BASE { bc = d }
            bo += 1
        }
        if bc >= types.MIR_LOCAL_OPERAND_BASE {
            a.load(21, 15, slot_off(fr.local_slot[bc - types.MIR_LOCAL_OPERAND_BASE]))
        } else {
            << 0
        }
    }
    if bb_mul >= 0 {
        mut ma := types.mir_ic(m, fi, bb_mul)
        mut mb := types.mir_id(m, fi, bb_mul)
        mut bo := 0
        for _ in 0:nb2 {
            mut r := vec_trace(m, fi, bo, ma)
            if r >= types.MIR_LOCAL_OPERAND_BASE { ma = r }
            r = vec_trace(m, fi, bo, mb)
            if r >= types.MIR_LOCAL_OPERAND_BASE { mb = r }
            mut d := vec_resolve_desc(m, fi, bo, ma)
            if d >= types.MIR_LOCAL_OPERAND_BASE { ma = d }
            d = vec_resolve_desc(m, fi, bo, mb)
            if d >= types.MIR_LOCAL_OPERAND_BASE { mb = d }
            bo += 1
        }
        if ma >= types.MIR_LOCAL_OPERAND_BASE {
            a.load(0, 15, slot_off(fr.local_slot[ma - types.MIR_LOCAL_OPERAND_BASE]))
        } else if ma < 0 {
            a.vm_mov_imm64(0, types.mir_const_at(m, fi, -ma - 2))
        } else {
            emit_load_value(a, m, fi, fr, ma, 0)
        }
        if mb >= types.MIR_LOCAL_OPERAND_BASE {
            a.load(14, 15, slot_off(fr.local_slot[mb - types.MIR_LOCAL_OPERAND_BASE]))
        } else if mb < 0 {
            a.vm_mov_imm64(14, types.mir_const_at(m, fi, -mb - 2))
        } else {
            emit_load_value(a, m, fi, fr, mb, 14)
        }
        a.mul(1, 0, 14)
    } else {
        mut bb := vec_trace(m, fi, bi, base_b)
        mut bo := 0
        for _ in 0:nb2 {
            mut r := vec_trace(m, fi, bo, bb)
            if r >= types.MIR_LOCAL_OPERAND_BASE { bb = r }
            mut d := vec_resolve_desc(m, fi, bo, bb)
            if d >= types.MIR_LOCAL_OPERAND_BASE { bb = d }
            bo += 1
        }
        if bb >= types.MIR_LOCAL_OPERAND_BASE {
            a.load(1, 15, slot_off(fr.local_slot[bb - types.MIR_LOCAL_OPERAND_BASE]))
        } else {
            << 0
        }
    }
    emit_saxpy47_core(a, m, fi, fr, bi, arr_c, arr_b)
    else_lbl := types.mir_fn_label(m, fi) + "_bb" + str(p.else_bb)
    if lim_local >= 0 {
        a.load(20, 15, slot_off(fr.local_slot[lim_local]))
    } else if p.limit_t >= 0 {
        emit_load_value(a, m, fi, fr, p.limit_t, 20)
    } else {
        a.vm_mov_imm64(20, p.limit)
    }
    if ind_local >= 0 {
        a.store(15, slot_off(fr.local_slot[ind_local]), 20)
    } else if is_vreg_slot(fr.temp_slot[ind_temp]) {
        home := vreg_slot_home(fr.temp_slot[ind_temp])
        if home != 20 {
            a.mov(home, 20)
        }
    } else {
        a.store(15, slot_off(fr.temp_slot[ind_temp]), 20)
    }
    a.jmp(else_lbl + "")
    << 1
}

// A1=n A2=j A3=base_c A4=base_b A5=aik on entry; V0/V1/Ret scratch.
// Bounds-checks [base+j, base+n) for both arrays, then c[...] += aik * b[...].
fn emit_saxpy47_core(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, arr_c int, arr_b int) {
    a.vm_cmp_imm(20, 0)
    a.oob_need = 1
    a.jlt(a.oob_lbl + "")
    a.cmp(20, 19)
    a.jgt(a.oob_lbl + "")
    a.vm_cmp_imm(21, 0)
    a.jlt(a.oob_lbl + "")
    a.vm_cmp_imm(1, 0)
    a.jlt(a.oob_lbl + "")
    emit_index_desc_addr(a, m, fi, fr, arr_c)
    a.load(14, 0, -8)
    a.add(22, 21, 19)
    a.cmp(14, 22)
    a.jlt(a.oob_lbl + "")
    a.load(0, 0, 0)
    a.add(22, 21, 20)
    a.add_lsl_vr(21, 0, 22, 3)
    emit_index_desc_addr(a, m, fi, fr, arr_b)
    a.load(14, 0, -8)
    a.add(22, 1, 19)
    a.cmp(14, 22)
    a.jlt(a.oob_lbl + "")
    a.load(0, 0, 0)
    a.add(22, 1, 20)
    a.add_lsl_vr(22, 0, 22, 3)
    a.sub(20, 19, 20)
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi)
    lp := pref + "_s47"
    sc := pref + "_s47s"
    dn := pref + "_s47d"
    a.vm_cmp_imm(20, 2)
    a.jlt(sc + "")
    a.label(lp + "")
    a.ldp_post(map_reg(0), map_reg(1), map_reg(22), 16)
    a.load(14, 21, 0)
    a.load(19, 21, 8)
    a.madd(14, 0, 23, 14)
    a.madd(19, 1, 23, 19)
    a.stp_post(map_reg(14), map_reg(19), map_reg(21), 16)
    a.vm_sub_imm(20, 20, 2)
    a.vm_cmp_imm(20, 2)
    a.jge(lp + "")
    a.label(sc + "")
    a.vm_cmp_imm(20, 1)
    a.jlt(dn + "")
    a.load(0, 22, 0)
    a.load(14, 21, 0)
    a.madd(14, 0, 23, 14)
    a.store(21, 0, 14)
    a.label(dn + "")
}
