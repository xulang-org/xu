@main

// Private event-set ABI: op/create=0, add=1, modify=2, remove=3,
// wait=4, close=5, wake=6. Six scalar arguments in A0..A5, throwable string sret.
// create returns one little-endian handle; wait returns up to 64 pairs of
// (token, event mask), each encoded as two little-endian 64-bit words.
// The set owns its kernel descriptor, never the watched sockets.
fn rt_emit_event_set(a $&Assembler) {
    a.label("_rt_event_set")
    a.prologue(2400)
    a.store(15, -8, 0)
    a.vm_mov_imm(1, -1)
    a.store(15, -104, 1)
    for i in 0:6 { a.store(15, -16 - i * 8, 18 + i) }
    if (a.os != 0 && a.os != 1) || ptr_bytes(a.arch) != 8 {
        rt_call_throw_strerr_static(a, -8, "_rt_event_set_unsupported_msg", 29)
        a.epilogue()
        <<
    }
    a.vm_cmp_imm(18, 0)
    a.jeq("_rt_es_create")
    a.vm_cmp_imm(18, 4)
    a.jeq("_rt_es_wait")
    a.vm_cmp_imm(18, 5)
    a.jeq("_rt_es_close")
    a.vm_cmp_imm(18, 6)
    a.jeq("_rt_es_wake")
    a.vm_cmp_imm(18, 1)
    a.jlt("_rt_es_bad")
    a.vm_cmp_imm(18, 3)
    a.jgt("_rt_es_bad")
    rt_emit_event_set_update(a)

    a.label("_rt_es_create")
    if a.os == 1 {
        a.vm_mov_imm(18, 524288) // EPOLL_CLOEXEC
        a.vm_syscall(syscall_number(a.os, a.arch, 48))
    } else {
        a.vm_syscall(syscall_number(a.os, a.arch, 51))
    }
    a.vm_normalize_syscall("_rt_es_open")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_es_error")
    a.store(15, -88, 14)
    if a.os == 0 {
        a.mov(18, 14)
        a.vm_mov_imm(19, 2) // F_SETFD
        a.vm_mov_imm(20, 1) // FD_CLOEXEC
        a.vm_syscall(33554524)
        a.vm_normalize_syscall("_rt_es_cloexec")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_es_open_error")
        // EVFILT_USER is the kqueue equivalent of eventfd. EV_CLEAR makes
        // each delivered wake consume the pending trigger.
        a.vm_sub_imm(4, 15, 224)
        a.vm_mov_imm(1, 0)
        for i in 0:32 { a.store_byte(4, i, 1) }
        a.vm_mov_imm(1, -10) // EVFILT_USER
        a.store_byte(4, 8, 1)
        a.vm_mov_imm(1, 255)
        a.store_byte(4, 9, 1)
        a.vm_mov_imm(1, 33) // EV_ADD|EV_CLEAR
        a.store_byte(4, 10, 1)
        a.vm_mov_imm(1, -1)
        a.store(4, 24, 1) // reserved wake token
        a.load(18, 15, -88)
        a.mov(19, 4)
        a.vm_mov_imm(20, 1)
        a.vm_mov_imm(21, 0)
        a.vm_mov_imm(22, 0)
        a.vm_mov_imm(23, 0)
        a.vm_syscall(syscall_number(a.os, a.arch, 52))
        a.vm_normalize_syscall("_rt_es_wake_registered")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_es_open_error")
    } else {
        // eventfd counter is nonblocking and close-on-exec. Its descriptor
        // is stored in the upper 32 bits of the opaque handle.
        a.vm_mov_imm(18, 0)
        a.vm_mov_imm(19, 526336) // EFD_CLOEXEC|EFD_NONBLOCK
        a.vm_syscall(syscall_number(a.os, a.arch, 54))
        a.vm_normalize_syscall("_rt_es_eventfd")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_es_open_error")
        a.store(15, -104, 14)
        a.vm_sub_imm(4, 15, 224)
        a.vm_mov_imm(1, 0)
        for i in 0:16 { a.store_byte(4, i, 1) }
        a.vm_mov_imm(1, 1) // EPOLLIN
        a.store(4, 0, 1)
        a.vm_mov_imm(1, -1)
        if a.arch == 1 { a.store(4, 4, 1) }
        else { a.store(4, 8, 1) }
        a.load(18, 15, -88)
        a.vm_mov_imm(19, 1) // EPOLL_CTL_ADD
        a.load(20, 15, -104)
        a.mov(21, 4)
        a.vm_syscall(syscall_number(a.os, a.arch, 49))
        a.vm_normalize_syscall("_rt_es_eventfd_registered")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_es_open_error")
    }
    a.vm_mov_imm(18, 8)
    a.call("_rt_alloc")
    a.store(15, -80, 14)
    a.load(1, 15, -88)
    if a.os == 1 {
        a.load(2, 15, -104)
        a.shl_imm(2, 2, 32)
        a.ior(1, 1, 2)
    }
    a.store(14, 0, 1)
    a.vm_mov_imm(1, 8)
    a.store(15, -96, 1)
    a.jmp("_rt_es_result")

    a.label("_rt_es_wait")
    // Runtime enter/leave policy already handles blocking hosted syscalls;
    // the caller recomputes its absolute deadline after interrupted waits.
    a.call("_rt_enter_syscall")
    rt_emit_event_set_wait(a)
    a.vm_normalize_syscall("_rt_es_wait_result")
    a.vm_cmp_imm(14, -4) // EINTR: a permitted spurious wake, no event consumed.
    a.jeq("_rt_es_empty")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_es_error")
    a.vm_cmp_imm(14, 64)
    a.jgt("_rt_es_bad")
    a.vm_cbz(14, "_rt_es_empty")
    a.store(15, -72, 14)
    a.shl_imm(18, 14, 4)
    a.store(15, -96, 18)
    a.call("_rt_alloc")
    a.store(15, -80, 14)
    a.vm_mov_imm(1, 0)
    a.store(15, -64, 1)
    a.label("_rt_es_pack")
    a.load(1, 15, -64)
    a.load(2, 15, -72)
    a.cmp(1, 2)
    a.jge("_rt_es_result")
    a.vm_mov_imm(2, 32)
    if a.os == 1 {
        a.vm_mov_imm(2, 16)
        if a.arch == 1 { a.vm_mov_imm(2, 12) }
    }
    a.mul(2, 1, 2)
    a.vm_sub_imm(3, 15, 2304)
    a.add(3, 3, 2)
    rt_emit_event_set_pack(a)
    a.load(3, 15, -64)
    a.shl_imm(3, 3, 4)
    a.load(4, 15, -80)
    a.add(4, 4, 3)
    a.store(4, 0, 5) // stable token
    a.store(4, 8, 6) // normalized flags
    a.load(1, 15, -64)
    a.vm_add_imm(1, 1, 1)
    a.store(15, -64, 1)
    a.jmp("_rt_es_pack")

    a.label("_rt_es_close")
    if a.os == 1 {
        a.vm_mov_imm(1, 0)
        a.store(15, -112, 1)
        a.load(18, 15, -24)
        a.vm_mov_imm(1, 4294967295)
        a.iand(18, 18, 1)
        a.vm_syscall(syscall_number(a.os, a.arch, 6))
        a.vm_normalize_syscall("_rt_es_close_epoll")
        a.vm_cmp_imm(14, 0)
        a.jge("_rt_es_close_eventfd")
        a.store(15, -112, 14)
        a.label("_rt_es_close_eventfd")
        a.load(18, 15, -24)
        a.shr_imm(18, 18, 32)
        a.vm_syscall(syscall_number(a.os, a.arch, 6))
        a.vm_normalize_syscall("_rt_es_close_wakefd")
        a.vm_cmp_imm(14, 0)
        a.jge("_rt_es_close_status")
        a.load(1, 15, -112)
        a.vm_cbz(1, "_rt_es_save_close_error")
        a.jmp("_rt_es_close_status")
        a.label("_rt_es_save_close_error")
        a.store(15, -112, 14)
        a.label("_rt_es_close_status")
        a.load(14, 15, -112)
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_es_error")
    } else {
        a.load(18, 15, -24)
        a.vm_syscall(syscall_number(a.os, a.arch, 6))
        a.vm_normalize_syscall("_rt_es_closed")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_es_error")
    }
    a.jmp("_rt_es_empty")

    a.label("_rt_es_wake")
    if a.os == 1 {
        a.vm_sub_imm(4, 15, 112)
        a.vm_mov_imm(1, 1)
        a.store(4, 0, 1)
        a.vm_mov_imm(1, 0)
        a.store(4, 8, 1)
        a.load(18, 15, -24)
        a.shr_imm(18, 18, 32)
        a.mov(19, 4)
        a.vm_mov_imm(20, 8)
        a.label("_rt_es_wake_write")
        a.vm_syscall(syscall_number(a.os, a.arch, 1))
        a.vm_normalize_syscall("_rt_es_wake_written")
        a.vm_cmp_imm(14, -4)
        a.jeq("_rt_es_wake_write")
        a.vm_cmp_imm(14, -11) // eventfd is already readable
        a.jeq("_rt_es_empty")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_es_error")
    } else {
        a.vm_sub_imm(4, 15, 224)
        a.vm_mov_imm(1, 0)
        for i in 0:32 { a.store_byte(4, i, 1) }
        a.vm_mov_imm(1, -10) // EVFILT_USER
        a.store_byte(4, 8, 1)
        a.vm_mov_imm(1, 255)
        a.store_byte(4, 9, 1)
        a.vm_mov_imm(1, 16777216) // NOTE_TRIGGER
        a.store(4, 12, 1)
        a.vm_mov_imm(1, -1)
        a.store(4, 24, 1)
        a.load(18, 15, -24)
        a.mov(19, 4)
        a.vm_mov_imm(20, 1)
        a.vm_mov_imm(21, 0)
        a.vm_mov_imm(22, 0)
        a.vm_mov_imm(23, 0)
        a.vm_syscall(syscall_number(a.os, a.arch, 52))
        a.vm_normalize_syscall("_rt_es_user_wake")
        a.vm_cmp_imm(14, -4)
        a.jeq("_rt_es_wake")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_es_error")
    }
    a.jmp("_rt_es_empty")

    a.label("_rt_es_open_error")
    a.store(15, -72, 14)
    a.load(18, 15, -88)
    a.vm_syscall(syscall_number(a.os, a.arch, 6))
    if a.os == 1 {
        a.load(18, 15, -104)
        a.vm_cmp_imm(18, 0)
        a.jlt("_rt_es_open_error_restore")
        a.vm_syscall(syscall_number(a.os, a.arch, 6))
    }
    a.label("_rt_es_open_error_restore")
    a.load(14, 15, -72)
    a.jmp("_rt_es_error")
    a.label("_rt_es_empty")
    a.vm_mov_imm(1, 0)
    a.store(15, -80, 1)
    a.store(15, -96, 1)
    a.label("_rt_es_result")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.load(1, 15, -80)
    a.store(0, -8, 1)
    a.load(1, 15, -96)
    a.store(0, -16, 1)
    a.store(0, -24, 1)
    a.epilogue()
    a.label("_rt_es_error")
    a.neg(18, 14)
    a.call("_rt_errno_msg")
    rt_call_throw_strerr_args(a, -8)
    a.epilogue()
    a.label("_rt_es_bad")
    rt_call_throw_strerr_static(a, -8, "_rt_net_bad_msg", 5)
    a.epilogue()
}

fn rt_emit_event_set_update(a $&Assembler) {
    a.vm_sub_imm(4, 15, 224)
    a.vm_mov_imm(1, 0)
    for i in 0:64 { a.store_byte(4, i, 1) }
    if a.os == 1 {
        a.load(1, 15, -40)
        a.vm_mov_imm(2, 1)
        a.iand(2, 1, 2)
        a.vm_mov_imm(3, 2)
        a.iand(3, 1, 3)
        a.shl_imm(3, 3, 1) // WRITE=2 -> EPOLLOUT=4
        a.ior(2, 2, 3)
        a.store(4, 0, 2)
        a.load(1, 15, -48)
        if a.arch == 1 { a.store(4, 4, 1) }
        else { a.store(4, 8, 1) }
        a.load(18, 15, -24)
    if a.os == 1 {
        a.vm_mov_imm(1, 4294967295)
        a.iand(18, 18, 1)
    }
        a.load(19, 15, -16)
        // add=1, modify=3, delete=2 in epoll_ctl.
        a.vm_cmp_imm(19, 2)
        a.jne("_rt_es_ep_not_mod")
        a.vm_mov_imm(19, 3)
        a.jmp("_rt_es_ep_ctl")
        a.label("_rt_es_ep_not_mod")
        a.vm_cmp_imm(19, 3)
        a.jne("_rt_es_ep_ctl")
        a.vm_mov_imm(19, 2)
        a.label("_rt_es_ep_ctl")
        a.load(20, 15, -32)
        a.mov(21, 4)
        a.vm_syscall(syscall_number(a.os, a.arch, 49))
    } else {
        for i in 0:2 {
            a.vm_sub_imm(4, 15, 224 - i * 32)
            a.load(1, 15, -32)
            a.store(4, 0, 1)
            a.vm_mov_imm(1, 255 - i)
            a.store_byte(4, 8, 1)
            a.vm_mov_imm(1, 255)
            a.store_byte(4, 9, 1)
            a.load(1, 15, -48)
            a.store(4, 24, 1)
            a.load(1, 15, -16)
            a.vm_mov_imm(2, 2) // EV_DELETE
            a.vm_cmp_imm(1, 3)
            a.jeq("_rt_es_kq_flags_" + str(i))
            a.load(1, 15, -40)
            a.vm_mov_imm(2, 1 << i)
            a.iand(1, 1, 2)
            a.vm_mov_imm(2, 9) // EV_ADD|EV_DISABLE
            a.vm_cbz(1, "_rt_es_kq_flags_" + str(i))
            a.vm_mov_imm(2, 5) // EV_ADD|EV_ENABLE
            a.label("_rt_es_kq_flags_" + str(i))
            a.store_byte(4, 10, 2)
        }
        a.load(18, 15, -24)
        a.vm_sub_imm(19, 15, 224)
        a.vm_mov_imm(20, 2)
        a.vm_mov_imm(21, 0)
        a.vm_mov_imm(22, 0)
        a.vm_mov_imm(23, 0)
        a.vm_syscall(syscall_number(a.os, a.arch, 52))
    }
    a.vm_normalize_syscall("_rt_es_updated")
    // Closed sockets can already have been removed by the kernel.
    a.vm_cmp_imm(14, -2)
    a.jne("_rt_es_update_status")
    a.load(1, 15, -16)
    a.vm_cmp_imm(1, 3)
    a.jeq("_rt_es_empty")
    a.label("_rt_es_update_status")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_es_error")
    a.jmp("_rt_es_empty")
}

fn rt_emit_event_set_wait(a $&Assembler) {
    a.load(1, 15, -56)
    if a.os == 1 {
        a.vm_cmp_imm(1, 0)
        a.jlt("_rt_es_timeout_zero")
        a.jeq("_rt_es_timeout_infinite")
        a.vm_mov_imm(2, TIME_NS_PER_MILLISECOND)
        a.div(3, 1, 2)
        a.imod(4, 1, 2)
        a.vm_cbz(4, "_rt_es_timeout_ms")
        a.vm_add_imm(3, 3, 1)
        a.label("_rt_es_timeout_ms")
        a.vm_mov_imm(2, 2147483647)
        a.cmp(3, 2)
        a.jle("_rt_es_timeout_ready")
        a.mov(3, 2)
        a.jmp("_rt_es_timeout_ready")
        a.label("_rt_es_timeout_zero")
        a.vm_mov_imm(3, 0)
        a.jmp("_rt_es_timeout_ready")
        a.label("_rt_es_timeout_infinite")
        a.vm_mov_imm(3, -1)
        a.label("_rt_es_timeout_ready")
        a.load(18, 15, -24)
        a.vm_mov_imm(1, 4294967295)
        a.iand(18, 18, 1)
        a.vm_sub_imm(19, 15, 2304)
        a.vm_mov_imm(20, 64)
        a.mov(21, 3)
        a.vm_mov_imm(22, 0)
        a.vm_mov_imm(23, 0)
        a.vm_syscall(syscall_number(a.os, a.arch, 50))
    } else {
        a.vm_mov_imm(23, 0)
        a.vm_cbz(1, "_rt_es_kq_timeout_ready")
        a.vm_cmp_imm(1, 0)
        a.jge("_rt_es_kq_timeout_positive")
        a.vm_mov_imm(1, 0)
        a.label("_rt_es_kq_timeout_positive")
        a.vm_mov_imm(2, TIME_NS_PER_SECOND)
        a.div(3, 1, 2)
        a.imod(4, 1, 2)
        a.store(15, -128, 3)
        a.store(15, -120, 4)
        a.vm_sub_imm(23, 15, 128)
        a.label("_rt_es_kq_timeout_ready")
        a.load(18, 15, -24)
        a.vm_mov_imm(19, 0)
        a.vm_mov_imm(20, 0)
        a.vm_sub_imm(21, 15, 2304)
        a.vm_mov_imm(22, 64)
        a.vm_syscall(syscall_number(a.os, a.arch, 52))
    }
}

fn rt_emit_event_set_pack(a $&Assembler) {
    a.vm_mov_imm(6, 0)
    if a.os == 1 {
        if a.arch == 1 { a.load(5, 3, 4) }
        else { a.load(5, 3, 8) }
        a.load(1, 3, 0)
        a.vm_cmp_imm(5, -1)
        a.jne("_rt_es_pack_epoll_flags")
        // Drain the nonblocking eventfd so this internal wake does not make
        // every following epoll_wait return immediately.
        a.load(18, 15, -24)
        a.shr_imm(18, 18, 32)
        a.vm_sub_imm(19, 15, 112)
        a.vm_mov_imm(20, 8)
        a.label("_rt_es_pack_drain_wake")
        a.vm_syscall(syscall_number(a.os, a.arch, 5))
        a.vm_normalize_syscall("_rt_es_pack_wake_drained")
        a.vm_cmp_imm(14, -4)
        a.jeq("_rt_es_pack_drain_wake")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_es_error")
        a.vm_mov_imm(6, 0)
        a.jmp("_rt_es_pack_flags_done")
        a.label("_rt_es_pack_epoll_flags")
        for i in 0:4 {
            $kernel_bit := 1
            if i == 1 { kernel_bit = 4 }
            if i == 2 { kernel_bit = 8 }
            if i == 3 { kernel_bit = 16 }
            a.vm_mov_imm(2, kernel_bit)
            a.iand(2, 1, 2)
            a.vm_cbz(2, "_rt_es_ep_bit_" + str(i))
            a.vm_mov_imm(2, 1 << i)
            a.ior(6, 6, 2)
            a.label("_rt_es_ep_bit_" + str(i))
        }
        a.label("_rt_es_pack_flags_done")
    } else {
        a.load(5, 3, 24)
        a.load_byte(1, 3, 8)
        a.vm_mov_imm(6, 1)
        a.vm_cmp_imm(1, 255)
        a.jeq("_rt_es_kq_read_event")
        a.vm_mov_imm(6, 2)
        a.label("_rt_es_kq_read_event")
        a.load_byte(1, 3, 11)
        a.vm_mov_imm(2, 128)
        a.iand(2, 1, 2)
        a.vm_cbz(2, "_rt_es_kq_no_eof")
        a.vm_mov_imm(2, 8)
        a.ior(6, 6, 2)
        a.label("_rt_es_kq_no_eof")
        a.vm_mov_imm(2, 64)
        a.iand(2, 1, 2)
        a.vm_cbz(2, "_rt_es_kq_no_error")
        a.vm_mov_imm(2, 4)
        a.ior(6, 6, 2)
        a.label("_rt_es_kq_no_error")
    }
}
