@main

#xu/types

fn rt_emit_xu_pump(a &mut Assembler) {
    a.label("_rt_xu_pump")
    a.prologue(16)
    a.lea(0, "_rt_xu_pumping")
    a.load(1, 0, 0)
    a.vm_cbnz(1, "_rt_gp_ret")
    a.vm_mov_imm(1, 1)
    a.store(0, 0, 1)
    a.label("_rt_gp_loop")
    a.lea(0, "_rt_xu_len")
    a.load(1, 0, 0)
    a.vm_cbz(1, "_rt_gp_done")
    a.lea(2, "_rt_xu_head")
    a.load(3, 2, 0)
    a.vm_mov_imm(4, RT_XU_QUEUE_ENTRY_BYTES)
    a.mul(5, 3, 4)
    a.lea(4, "_rt_xu_queue")
    a.add(4, 4, 5)
    a.load(18, 4, 0)
    a.store(15, -8, 18)
    a.vm_add_imm(3, 3, 1)
    a.vm_cmp_imm(3, RT_XU_QUEUE_CAPACITY)
    a.jlt("_rt_gp_head_ok")
    a.vm_mov_imm(3, 0)
    a.label("_rt_gp_head_ok")
    a.store(2, 0, 3)
    a.vm_sub_imm(1, 1, 1)
    a.store(0, 0, 1)
    a.call("_rt_xu_call_args")
    a.load(18, 15, -8)
    a.call("_rt_free")
    a.jmp("_rt_gp_loop")
    a.label("_rt_gp_done")
    a.lea(0, "_rt_xu_pumping")
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.label("_rt_gp_ret")
    a.epilogue()
    rt_emit_xu_call_args(a)
    <<
}

fn rt_emit_xu(a &mut Assembler) {
    a.label("_rt_xu")
    a.prologue(16)
    a.store(15, -8, 18)
    a.label("_rt_xu_wait")
    a.lea(0, "_rt_xu_len")
    a.load(1, 0, 0)
    a.vm_cmp_imm(1, RT_XU_QUEUE_CAPACITY)
    a.jge("_rt_xu_wait")
    a.lea(2, "_rt_xu_tail")
    a.load(3, 2, 0)
    a.vm_mov_imm(4, RT_XU_QUEUE_ENTRY_BYTES)
    a.mul(5, 3, 4)
    a.lea(4, "_rt_xu_queue")
    a.add(4, 4, 5)
    a.load(5, 15, -8)
    a.store(4, 0, 5)
    a.vm_add_imm(3, 3, 1)
    a.vm_cmp_imm(3, RT_XU_QUEUE_CAPACITY)
    a.jlt("_rt_xu_tail_ok")
    a.vm_mov_imm(3, 0)
    a.label("_rt_xu_tail_ok")
    a.store(2, 0, 3)
    a.vm_add_imm(1, 1, 1)
    a.store(0, 0, 1)
    a.call("_rt_xu_pump")
    a.epilogue()
    <<
}

// ==================== M17c macOS multi-core (pthread) ====================
// Channel header 232 B: mutex 64, cv_send 48, cv_recv 48,
// elem@160 cap@168 len@176 head@184 tail@192 buf@200 closed@208
// wait_head@216 wait_tail@224.
// Waiter nodes: next@0 kind@8 done@16 buf@24 data@32;
// kind 1=SEND 2=RECV 3=SEND_DETACHED; done 0=WAITING 1=SERVED 2=CLOSED.
// Reclaimed by the parked owner after done != 0.

fn rt_copy_slot_fp56(a &mut Assembler, copy_l string, done_l string) {
    a.vm_mov_imm(1, 0)
    a.label(copy_l + "")
    a.vm_cmp_imm(1, 7)
    a.jge(done_l + "")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.add(3, 4, 2)
    a.load(3, 3, 0)
    a.vm_sub_imm(0, 15, 56)
    a.add(0, 0, 2)
    a.store(0, 0, 3)
    a.vm_add_imm(1, 1, 1)
    a.jmp(copy_l + "")
    a.label(done_l + "")
    <<
}

fn rt_run_pack_fp56(a &mut Assembler) {
    a.load(9, 15, -56)
    a.load(18, 15, -48)
    a.load(19, 15, -40)
    a.load(20, 15, -32)
    a.load(21, 15, -24)
    a.load(22, 15, -16)
    a.load(23, 15, -8)
    a.call_reg(9)
    <<
}

fn rt_emit_g_jmpbuf(a &mut Assembler) {
    a.label("_rt_g_save")
    if a.arch == 1 {
        a.mov(0, 16)
        a.vm_add_imm(0, 0, 8)
        a.store(18, 0, 0)
        a.load(1, 16, 0)
        a.store(18, 8, 1)
        a.mov(0, 8)
        a.store(18, 16, 0)
        a.mov(0, 9)
        a.store(18, 24, 0)
        a.mov(0, 3)
        a.store(18, 32, 0)
        a.mov(0, 4)
        a.store(18, 40, 0)
        a.mov(0, 5)
        a.store(18, 48, 0)
        a.mov(0, 15)
        a.store(18, 56, 0)
        a.vm_mov_imm(14, 0)
        a.vm_ret()
    } else if a.arch == 2 {
        a.mov(0, 16)
        a.store(18, 0, 0)
        a.mov(0, 17)
        a.store(18, 4, 0)
        a.mov(0, 8)
        a.store(18, 8, 0)
        a.mov(0, 9)
        a.store(18, 12, 0)
        a.mov(0, 3)
        a.store(18, 16, 0)
        a.mov(0, 4)
        a.store(18, 20, 0)
        a.mov(0, 5)
        a.store(18, 24, 0)
        a.mov(0, 15)
        a.store(18, 28, 0)
        a.vm_mov_imm(14, 0)
        a.vm_ret()
    } else {
        // ARM64 `bl` keeps the return address in LR and does not push it on
        // the stack.  The saved SP is therefore the entry SP itself; adding
        // eight bytes here (the x64 convention above) resumes every parked G
        // with a misaligned stack and can strand channel waiters after a
        // park/wake hand-off.
        a.mov(0, 16)
        a.store(18, 0, 0)
        a.mov(0, 17)
        a.store(18, 8, 0)
        a.mov(0, 8)
        a.store(18, 16, 0)
        a.mov(0, 9)
        a.store(18, 24, 0)
        a.mov(0, 10)
        a.store(18, 32, 0)
        a.mov(0, 11)
        a.store(18, 40, 0)
        a.mov(0, 12)
        a.store(18, 48, 0)
        a.mov(0, 13)
        a.store(18, 56, 0)
        a.mov(0, 15)
        a.store(18, 64, 0)
        a.vm_mov_imm(14, 0)
        a.vm_ret()
    }
    a.label("_rt_g_switch")
    if a.arch == 1 {
        a.load(0, 18, 16)
        a.mov(8, 0)
        a.load(0, 18, 24)
        a.mov(9, 0)
        a.load(0, 18, 32)
        a.mov(3, 0)
        a.load(0, 18, 40)
        a.mov(4, 0)
        a.load(0, 18, 48)
        a.mov(5, 0)
        a.load(0, 18, 56)
        a.mov(15, 0)
        // x64 RET pops [RSP]. Plant saved PC (M+8) there; the slot at
        // saved_SP-8 is reused by later CALLs (dequeue/g_start), so
        // `sub $8; ret` would resume at the wrong IP with RAX=A1 (=1).
        // ARM64 ret uses LR (also M+8), which is why macos-arm64 passed.
        a.load(0, 18, 0)
        a.vm_sub_imm(0, 0, 8)
        a.load(1, 18, 8)
        a.store(0, 0, 1)
        a.mov(16, 0)
        a.mov(14, 19)
        a.vm_ret()
    } else if a.arch == 2 {
        a.load(0, 18, 8)
        a.mov(8, 0)
        a.load(0, 18, 12)
        a.mov(9, 0)
        a.load(0, 18, 16)
        a.mov(3, 0)
        a.load(0, 18, 20)
        a.mov(4, 0)
        a.load(0, 18, 24)
        a.mov(5, 0)
        a.load(0, 18, 28)
        a.mov(15, 0)
        a.load(0, 18, 0)
        a.mov(16, 0)
        a.load(0, 18, 4)
        a.mov(17, 0)
        a.mov(14, 19)
        a.vm_ret()
    } else {
        a.load(0, 18, 16)
        a.mov(8, 0)
        a.load(0, 18, 24)
        a.mov(9, 0)
        a.load(0, 18, 32)
        a.mov(10, 0)
        a.load(0, 18, 40)
        a.mov(11, 0)
        a.load(0, 18, 48)
        a.mov(12, 0)
        a.load(0, 18, 56)
        a.mov(13, 0)
        a.load(0, 18, 64)
        a.mov(15, 0)
        a.load(0, 18, 0)
        a.mov(16, 0)
        a.load(0, 18, 8)
        a.mov(17, 0)
        a.mov(14, 19)
        a.vm_ret()
    }
    <<
}

fn rt_emit_sched_mn(a &mut Assembler) {
    rt_emit_g_self(a)
    rt_emit_g_alloc(a)
    rt_emit_ready(a)
    rt_emit_dequeue(a)
    rt_emit_reap_dead(a)
    rt_emit_release_handoff(a)
    rt_emit_enqueue_locked(a)
    rt_emit_xu_call_args(a)
    rt_emit_g_start(a)
    rt_emit_run_g(a)
    rt_emit_gogo(a)
    rt_emit_g_yield(a)
    rt_emit_park_until(a)
    rt_emit_sched_worker(a)
    rt_emit_ensure_worker(a)
    rt_emit_enter_syscall(a)
    <<
}

fn rt_emit_g_self(a &mut Assembler) {
    a.label("_rt_g_self")
    a.prologue(16)
    rt_heap_lock(a)
    // A process-global current-G pointer lets one worker overwrite another
    // worker's scheduling identity.  Each M instead owns a current-G slot at
    // M+128 (past both hosted jmpbuf layouts); scan the fixed five-M table and
    // validate the candidate against this thread's current SP.
    a.lea(0, "_rt_ms")
    a.vm_mov_imm(1, 0)
    a.label("_rt_gs_scan")
    a.vm_cmp_imm(1, RT_WORKER_LIMIT + 1)
    a.jge("_rt_gs_done")
    a.mov(2, 1)
    a.shl_imm(2, 2, RT_M_RECORD_SHIFT)
    a.add(2, 0, 2)
    a.load(14, 2, RT_M_CURRENT_G_OFFSET)
    a.vm_cbz(14, "_rt_gs_next")
    a.load(3, 14, RT_G_STACK_OFFSET)
    a.vm_cbz(3, "_rt_gs_next")
    a.mov(4, 16)
    a.cmp(4, 3)
    a.jlt("_rt_gs_next")
    a.vm_mov_imm64(5, rt_task_stack_bytes())
    a.add(3, 3, 5)
    a.cmp(4, 3)
    a.jge("_rt_gs_next")
    a.store(15, -8, 14)
    rt_heap_unlock(a)
    a.load(14, 15, -8)
    a.epilogue()
    a.label("_rt_gs_next")
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_gs_scan")
    a.label("_rt_gs_done")
    rt_heap_unlock(a)
    a.vm_mov_imm(14, 0)
    a.epilogue()
    <<
}

fn rt_switch_g_m(a &mut Assembler, g int, ms_lab string, go_lab string) {
    a.vm_cbz(g, ms_lab + "")
    a.load(18, g, RT_G_OWNER_M_OFFSET)
    a.vm_cbnz(18, go_lab + "")
    a.label(ms_lab + "")
    a.load(18, 15, -16)
    a.label(go_lab + "")
    a.vm_mov_imm(19, 1)
    a.call("_rt_g_switch")
    <<
}

fn rt_emit_g_alloc(a &mut Assembler) {
    a.label("_rt_g_alloc")
    a.prologue(32)
    a.store(15, -8, 18) // pack*
    a.vm_mov_imm(18, RT_G_STATE_BYTES)
    a.call("_rt_alloc")
    a.store(15, -16, 14) // G*
    a.vm_mov_imm(1, 0)
    a.vm_mov_imm(2, 0)
    a.label("_rt_ga_z")
    a.vm_cmp_imm(2, RT_G_STATE_BYTES)
    a.jge("_rt_ga_zd")
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.store(3, 0, 1)
    a.vm_add_imm(2, 2, 8)
    a.jmp("_rt_ga_z")
    a.label("_rt_ga_zd")
    a.vm_mov_imm64(18, rt_task_stack_bytes())
    a.call("_rt_alloc")
    a.vm_cmp_imm(14, RT_MIN_HEAP_POINTER)
    a.jlt("_rt_ga_fail")
    a.mov(1, 14)
    a.vm_mov_imm64(2, RT_G_STACK_COOKIE)
    a.store(1, 0, 2)
    a.load(3, 15, -16)
    a.store(1, 8, 3)
    a.vm_mov_imm(2, 0)
    a.store(1, 16, 2)
    a.store(3, RT_G_STACK_OFFSET, 1)
    // G+232 owns pack*: next@208, owner M@216, deferred wake@224.
    a.load(0, 15, -8)
    a.store(3, RT_G_PACK_OFFSET, 0)
    a.load(14, 15, -16)
    a.epilogue()
    a.label("_rt_ga_fail")
    rt_exit(a, 1)
    <<
}

fn rt_emit_ready(a &mut Assembler) {
    a.label("_rt_ready")
    a.prologue(16)
    a.store(15, -8, 18)
    a.vm_cbz(18, "_rt_rdy_main")
    rt_heap_lock(a)
    a.load(0, 15, -8)
    a.load(1, 0, RT_G_STATE_OFFSET)
    a.vm_cmp_imm(1, RT_G_RUNNABLE)
    a.jeq("_rt_rdy_held")
    a.vm_cmp_imm(1, RT_G_DEAD)
    a.jeq("_rt_rdy_held")
    a.vm_cmp_imm(1, RT_G_RUNNING)
    a.jeq("_rt_rdy_running")
    a.mov(18, 0)
    a.call("_rt_enqueue_locked")
    a.label("_rt_rdy_held")
    rt_heap_unlock(a)
    a.label("_rt_rdy_wake")
    a.lea(4, "_rt_xu_len")
    if a.os != 2 {
        rt_os_word_wake(a, 0)
    }
    a.epilogue()
    a.label("_rt_rdy_main")
    // A main-M waiter has no G to enqueue. Advance a dedicated wake epoch so
    // park_until cannot sleep forever while the run-queue length remains 0.
    a.lea(4, "_rt_xu_wake")
    a.vm_mov_imm(1, 1)
    a.vm_atomic_add(0, 4, 1)
    if a.os != 2 {
        rt_os_word_wake(a, 0)
    }
    a.epilogue()
    a.label("_rt_rdy_running")
    // A waiter may be served after publishing its node but before g_yield
    // commits ST_WAITING.  Mark a deferred wake instead of queueing a running
    // G (which could otherwise be resumed concurrently by another worker).
    a.vm_add_imm(2, 0, RT_G_WAKE_OFFSET)
    a.vm_mov_imm(1, 1)
    a.vm_atomic_store(2, 1)
    a.jmp("_rt_rdy_held")
    <<
}

// Release a scheduler-lock handoff published by _rt_g_yield.  Marker 1 is a
// parked G (no queue item); marker 2 is a syscall continuation already linked
// into the run queue and therefore needs a worker wake after unlock.  The
// helper is idempotent so normal M saves never unlock an unowned mutex.  The
// prologue/epilogue preserve Fp and callee-saved registers, but Ret is scratch
// across unlock/wake; callers needing g_save's discriminator spill it first.
// M+144 owns one completed G; called only on the restored M stack.
fn rt_emit_reap_dead(a &mut Assembler) {
    a.label("_rt_reap_dead")
    a.prologue(16)
    a.load(0, 18, RT_M_DEAD_G_OFFSET)
    a.vm_cbz(0, "_rt_reap_done")
    a.store(15, -8, 0)
    a.vm_mov_imm(1, 0)
    a.store(18, RT_M_DEAD_G_OFFSET, 1)
    a.load(18, 0, RT_G_STACK_OFFSET)
    a.call("_rt_free")
    a.load(0, 15, -8)
    a.load(18, 0, RT_G_PACK_OFFSET)
    a.call("_rt_free")
    a.load(18, 15, -8)
    a.call("_rt_free")
    a.label("_rt_reap_done")
    a.epilogue()
    <<
}

fn rt_emit_release_handoff(a &mut Assembler) {
    a.label("_rt_release_handoff")
    a.prologue(16)
    a.store(15, -8, 18) // A0 = owner M
    a.load(0, 15, -8)
    a.vm_add_imm(1, 0, RT_M_HANDOFF_OFFSET) // M_HANDOFF
    // Atomically consume the marker with acquire+release semantics.  The
    // yielding G publishes its state while holding the same mutex; exchange
    // also prevents a second continuation from consuming the same handoff.
    a.vm_mov_imm(3, 0)
    a.vm_atomic_xchg(2, 1, 3)
    a.vm_cbz(2, "_rt_rh_done")
    a.store(15, -16, 2)
    rt_heap_unlock(a)
    a.load(2, 15, -16)
    a.vm_cmp_imm(2, RT_M_HANDOFF_QUEUED)
    a.jne("_rt_rh_done")
    a.lea(4, "_rt_xu_len")
    rt_os_word_wake(a, 0)
    a.label("_rt_rh_done")
    a.load(18, 15, -8)
    a.call("_rt_reap_dead")
    a.epilogue()
    <<
}

// Enqueue A0 while the scheduler/heap mutex is already held.  Used by
// _rt_ready and _rt_enter_syscall so RUNNABLE publication and queue linking
// cannot be separated by a lock handoff.
fn rt_emit_enqueue_locked(a &mut Assembler) {
    a.label("_rt_enqueue_locked")
    a.prologue(16)
    a.store(15, -8, 18) // A0 = G
    a.load(0, 15, -8)
    a.vm_mov_imm(1, RT_G_RUNNABLE) // ST_RUNNABLE
    a.store(0, RT_G_STATE_OFFSET, 1)
    a.vm_mov_imm(1, 0)
    a.store(0, RT_G_NEXT_OFFSET, 1)
    a.lea(2, "_rt_xu_tail")
    a.load(3, 2, 0)
    a.vm_cbnz(3, "_rt_eq_append")
    a.lea(2, "_rt_xu_head")
    a.store(2, 0, 0)
    a.lea(2, "_rt_xu_tail")
    a.store(2, 0, 0)
    a.jmp("_rt_eq_count")
    a.label("_rt_eq_append")
    a.store(3, RT_G_NEXT_OFFSET, 0)
    a.store(2, 0, 0)
    a.label("_rt_eq_count")
    a.lea(1, "_rt_xu_len")
    a.load(2, 1, 0)
    a.vm_add_imm(2, 2, 1)
    a.store(1, 0, 2)
    a.epilogue()
    <<
}

fn rt_emit_dequeue(a &mut Assembler) {
    a.label("_rt_dequeue")
    a.prologue(16)
    rt_heap_lock(a)
    a.lea(0, "_rt_xu_head")
    a.load(1, 0, 0)
    a.vm_cbz(1, "_rt_dq_empty")
    a.load(2, 1, RT_G_NEXT_OFFSET)
    a.store(0, 0, 2)
    a.vm_cbnz(2, "_rt_dq_keep")
    a.lea(0, "_rt_xu_tail")
    a.vm_mov_imm(3, 0)
    a.store(0, 0, 3)
    a.label("_rt_dq_keep")
    a.lea(0, "_rt_xu_len")
    a.load(3, 0, 0)
    a.vm_sub_imm(3, 3, 1)
    a.store(0, 0, 3)
    a.vm_mov_imm(3, RT_G_RUNNING)
    a.store(1, RT_G_STATE_OFFSET, 3)
    a.vm_mov_imm(3, 0)
    a.store(1, RT_G_NEXT_OFFSET, 3)
    a.store(15, -8, 1)
    rt_heap_unlock(a)
    a.load(14, 15, -8)
    a.epilogue()
    a.label("_rt_dq_empty")
    rt_heap_unlock(a)
    a.vm_mov_imm(14, 0)
    a.epilogue()
    <<
}

// Xu spawn call: r18 = owned pack [fn, nargs, arg0..].
// Args 0–5 → R18–R23; args 6+ spilled at [SP] like emit_direct (16-aligned).
fn rt_emit_xu_call_args(a &mut Assembler) {
    a.label("_rt_xu_call_args")
    a.prologue(32)
    a.store(15, -8, 18)
    // On x64 S1/R15 carries the current G while hosted stack checks are
    // enabled. Keep the function pointer out of that register until the
    // final indirect call; otherwise the callee sees the pack pointer as G
    // and its entry cookie check dereferences an invalid stack address.
    if !(a.stack_check && a.arch == 1) {
        a.load(9, 18, 0)
    }
    if a.has_int64_pairs() {
        // The compiler generated a typed trampoline as pack.fn. It takes
        // pack* and builds all register/stack words for the real target.
        a.load(18, 15, -8)
        a.call_reg(9)
        a.epilogue()
        <<
    }
    a.load(1, 18, 8)
    a.store(15, -24, 1)
    a.load(1, 15, -24)
    a.vm_cmp_imm(1, 0)
    a.jle("_rt_xca_regs_done")
    a.load(0, 15, -8)
    a.load(18, 0, 16)
    a.load(0, 15, -8)
    a.load(1, 15, -24)
    a.vm_cmp_imm(1, 1)
    a.jle("_rt_xca_regs_done")
    a.load(0, 15, -8)
    a.load(19, 0, 24)
    a.load(1, 15, -24)
    a.vm_cmp_imm(1, 2)
    a.jle("_rt_xca_regs_done")
    a.load(0, 15, -8)
    a.load(20, 0, 32)
    a.load(1, 15, -24)
    a.vm_cmp_imm(1, 3)
    a.jle("_rt_xca_regs_done")
    a.load(0, 15, -8)
    a.load(21, 0, 40)
    a.load(1, 15, -24)
    a.vm_cmp_imm(1, 4)
    a.jle("_rt_xca_regs_done")
    a.load(0, 15, -8)
    a.load(22, 0, 48)
    a.load(1, 15, -24)
    a.vm_cmp_imm(1, 5)
    a.jle("_rt_xca_regs_done")
    a.load(0, 15, -8)
    a.load(23, 0, 56)
    a.label("_rt_xca_regs_done")
    a.load(1, 15, -24)
    a.vm_cmp_imm(1, 6)
    a.jle("_rt_xca_call")
    a.load(2, 15, -24)
    a.vm_sub_imm(2, 2, 6)
    a.mov(4, 2)
    a.shl_imm(4, 4, 3)
    // spill = ((raw+15)/16)*16
    a.vm_add_imm(4, 4, 15)
    a.vm_mov_imm(5, 16)
    // udiv not always available — use subtract loop for align up to 16
    // raw' already multiple of 8; round up to 16: if (raw&15)!=0 raw+=8
    a.load(4, 15, -24)
    a.vm_sub_imm(4, 4, 6)
    a.shl_imm(4, 4, 3)
    a.vm_mov_imm(5, 15)
    a.iand(6, 4, 5)
    a.vm_cbz(6, "_rt_xca_aligned")
    a.vm_add_imm(4, 4, 8)
    a.label("_rt_xca_aligned")
    // ARM64 shifted-register ADD/SUB interpret R31 as XZR, not SP.
    a.mov(7, 16)
    a.sub(7, 7, 4)
    a.mov(16, 7)
    a.load(0, 15, -8)
    a.load(2, 15, -24)
    a.vm_sub_imm(2, 2, 6)
    a.vm_mov_imm(3, 0)
    a.label("_rt_xca_sl")
    a.cmp(3, 2)
    a.jge("_rt_xca_call")
    a.mov(4, 3)
    a.shl_imm(4, 4, 3)
    a.add(5, 0, 4)
    a.load(6, 5, 64)
    a.mov(5, 16)
    a.add(5, 5, 4)
    a.store(5, 0, 6)
    a.vm_add_imm(3, 3, 1)
    a.jmp("_rt_xca_sl")
    a.label("_rt_xca_call")
    if a.stack_check && a.arch == 1 {
        // Load the target into V0/R10 and leave R15 untouched for the user
        // coroutine entry. The pack pointer is stable in the saved slot.
        a.load(0, 15, -8)
        a.load(0, 0, 0)
        a.call_reg(0)
    } else {
        a.call_reg(9)
    }
    a.epilogue()
    <<
}

fn rt_emit_g_start(a &mut Assembler) {
    a.label("_rt_g_start")
    a.prologue(32)
    a.store(15, -8, 18) // G*
    a.load(0, 18, RT_G_PACK_OFFSET)
    a.vm_cbz(0, "_rt_gs_legacy")
    a.mov(18, 0)
    a.call("_rt_xu_call_args")
    a.epilogue()
    a.label("_rt_gs_legacy")
    a.load(9, 18, RT_G_ENTRY_OFFSET)
    a.load(18, 18, RT_G_ARG0_OFFSET)
    a.load(0, 15, -8)
    a.load(19, 0, RT_G_ARG1_OFFSET)
    a.load(20, 0, RT_G_ARG2_OFFSET)
    a.load(21, 0, RT_G_ARG3_OFFSET)
    a.load(22, 0, RT_G_ARG4_OFFSET)
    a.load(23, 0, RT_G_ARG5_OFFSET)
    a.call_reg(9)
    a.epilogue()
    <<
}

fn rt_emit_run_g(a &mut Assembler) {
    a.label("_rt_run_g")
    // x64 V8 aliases V2/RBX, which completion uses as scratch. S1/R15
    // is distinct and is preserved by the target and runtime prologues.
    mut hold := 8
    if a.arch == 1 { hold = 9 }
    // Publish the G in its owning M before switching to a continuation.  The
    // current-G slot is per-M (M+128), so g_self cannot observe another worker.
    a.load(0, 18, RT_G_OWNER_M_OFFSET)
    a.vm_cbz(0, "_rt_rg_no_m")
    a.store(0, RT_M_CURRENT_G_OFFSET, 18)
    a.label("_rt_rg_no_m")
    // dequeue already stores ST_RUNNING at G+144. Word 0 of a new G is 0;
    // g_save writes SP/PC there. Nested xu used to g_switch to PC 0.
    a.load(1, 18, 0)
    a.vm_cbnz(1, "_rt_rg_res")
    a.vm_mov_imm(1, RT_G_RUNNING)
    a.store(18, RT_G_STATE_OFFSET, 1)
    a.load(0, 18, RT_G_STACK_OFFSET)
    a.vm_mov_imm64(2, rt_task_stack_bytes())
    a.add(0, 0, 2)
    a.vm_sub_imm(0, 0, 16)
    a.mov(16, 0)
    a.vm_mov_imm(15, 0)
    // x19 is callee-saved by g_start and the user function; retain G across
    // the fresh start so completion never re-reads process-global state.
    a.mov(hold, 18)
    a.call("_rt_g_start")
    rt_heap_lock(a)
    a.mov(1, hold)
    a.vm_mov_imm(2, RT_G_DEAD) // ST_DEAD: never enqueue again.
    a.store(1, RT_G_STATE_OFFSET, 2)
    a.vm_mov_imm(2, 0)
    a.load(0, 1, RT_G_OWNER_M_OFFSET)
    a.store(0, RT_M_CURRENT_G_OFFSET, 2)
    a.store(0, RT_M_DEAD_G_OFFSET, 1) // M_DEAD: owned by this saved M continuation.
    rt_heap_unlock(a)
    a.mov(1, hold)
    rt_switch_g_m(a, 1, "_rt_rg_ms", "_rt_rg_sw")
    a.label("_rt_rg_res")
    a.vm_mov_imm(1, RT_G_RUNNING)
    a.store(18, RT_G_STATE_OFFSET, 1)
    a.vm_mov_imm(19, 1)
    a.call("_rt_g_switch")
    <<
}

fn rt_emit_gogo(a &mut Assembler) {
    a.label("_rt_gogo")
    a.mov(18, 19)
    a.jmp("_rt_run_g")
    <<
}

fn rt_emit_g_yield(a &mut Assembler) {
    a.label("_rt_g_yield")
    a.prologue(16)
    a.call("_rt_g_self")
    a.vm_cbz(14, "_rt_gy_ret")
    a.store(15, -8, 14)
    a.load(1, 14, RT_G_OWNER_M_OFFSET)
    a.vm_cbz(1, "_rt_gy_m0")
    a.store(15, -16, 1)
    a.jmp("_rt_gy_m_saved")
    a.label("_rt_gy_m0")
    a.lea(1, "_rt_ms")
    a.store(15, -16, 1)
    a.label("_rt_gy_m_saved")
    a.mov(18, 14)
    a.call("_rt_g_save")
    a.vm_cbnz(14, "_rt_gy_ret")
    // Serialize the park commit with ready().  Both sides hold the run-queue
    // lock while observing ST_RUNNING/ST_WAITING and the deferred wake bit,
    // so a weakly ordered CPU cannot publish the wake after our consume.
    rt_heap_lock(a)
    a.load(0, 15, -8)
    a.vm_mov_imm(1, RT_G_WAITING)
    a.store(0, RT_G_STATE_OFFSET, 1)
    // Close the RUNNING→WAITING handshake.  ready() records a wake bit when
    // it races this transition; consume it atomically before switching away
    // so the G continues to observe its already-completed waiter.
    a.vm_add_imm(1, 0, RT_G_WAKE_OFFSET)
    a.vm_mov_imm(2, 0)
    a.vm_atomic_xchg(3, 1, 2)
    a.vm_cbnz(3, "_rt_gy_wake")
    // Keep the scheduler lock across the stack switch.  The target M releases
    // it at its first post-g_save instruction, after this worker has left the
    // G stack.  Load the owner before clearing M_G; no G-frame spill is read
    // after that point.
    a.load(1, 15, -16) // owner M
    a.vm_mov_imm(2, RT_M_HANDOFF_PARKED)
    a.vm_add_imm(3, 1, RT_M_HANDOFF_OFFSET)
    a.vm_atomic_store(3, 2) // M_HANDOFF = parked (release)
    a.vm_mov_imm(2, 0)
    a.store(1, RT_M_CURRENT_G_OFFSET, 2) // clear M_G
    a.mov(18, 1)
    a.vm_mov_imm(19, 1)
    a.call("_rt_g_switch")
    a.label("_rt_gy_wake")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, RT_G_RUNNING)
    a.store(0, RT_G_STATE_OFFSET, 1)
    rt_heap_unlock(a)
    a.label("_rt_gy_ret")
    a.epilogue()
    <<
}

fn rt_emit_park_until(a &mut Assembler) {
    a.label("_rt_park_until")
    a.prologue(16)
    a.store(15, -8, 18)
    a.label("_rt_pu_loop")
    // Snapshot the main-M wake epoch before checking the waiter.  A peer can
    // publish done and increment this epoch between the check and the wait;
    // comparing this snapshot after scheduling closes that lost-wake window.
    if a.os != 2 {
        a.lea(4, "_rt_xu_wake")
        a.vm_atomic_load(3, 4)
        a.store(15, -16, 3)
    }
    a.load(0, 15, -8)
    // `done` is published by another worker immediately before the wake
    // epoch update.  Use an acquire load here so ARM64 cannot observe the
    // old waiter state and then sleep on an already-consumed epoch.
    a.vm_add_imm(2, 0, RT_WN_DONE_OFFSET)
    a.vm_atomic_load(1, 2)
    a.vm_cbnz(1, "_rt_pu_out")
    a.call("_rt_g_self")
    a.vm_cbnz(14, "_rt_pu_y")
    a.lea(18, "_rt_ms")
    a.call("_rt_g_save")
    a.lea(18, "_rt_ms")
    a.call("_rt_release_handoff")
    a.load(0, 15, -8)
    a.vm_add_imm(2, 0, RT_WN_DONE_OFFSET)
    a.vm_atomic_load(1, 2)
    a.vm_cbnz(1, "_rt_pu_out")
    a.call("_rt_dequeue")
    a.vm_cbz(14, "_rt_pu_idle")
    // A G dequeued by the main M may have been owned by a worker previously;
    // make the hand-off explicit before running it on M0.
    a.lea(0, "_rt_ms")
    a.store(14, RT_G_OWNER_M_OFFSET, 0)
    a.mov(18, 14)
    a.call("_rt_run_g")
    a.jmp("_rt_pu_loop")
    a.label("_rt_pu_idle")
    if a.os == 2 {
        a.vm_mov_imm(18, 1)
        a.vm_call_iat("_iat_Sleep")
    } else {
        // Recheck done after the dequeue.  Then compare the current epoch
        // with the pre-check snapshot; if either changed, restart without
        // entering the kernel.  If a wake races the final load, futex/ulock
        // receives the old expected value and returns EAGAIN instead of
        // sleeping, so no wake can be lost in this window.
        a.load(0, 15, -8)
        a.vm_add_imm(2, 0, RT_WN_DONE_OFFSET)
        a.vm_atomic_load(1, 2)
        a.vm_cbnz(1, "_rt_pu_out")
        a.lea(4, "_rt_xu_wake")
        a.vm_atomic_load(3, 4)
        a.load(2, 15, -16)
        a.cmp(3, 2)
        a.jne("_rt_pu_loop")
        rt_os_word_wait(a)
    }
    a.jmp("_rt_pu_loop")
    a.label("_rt_pu_y")
    a.call("_rt_g_yield")
    a.jmp("_rt_pu_loop")
    a.label("_rt_pu_out")
    a.epilogue()
    <<
}

fn rt_emit_sched_worker(a &mut Assembler) {
    a.label("_rt_sched_worker")
    a.prologue(64)
    if a.os == 2 && a.arch == 1 {
        a.mov(18, 21)
    }
    a.store(15, -8, 18)
    a.label("_rt_sw_loop")
    a.load(18, 15, -8)
    a.call("_rt_g_save")
    a.load(18, 15, -8)
    a.call("_rt_release_handoff")
    a.call("_rt_dequeue")
    a.vm_cbz(14, "_rt_sw_idle")
    a.store(15, -16, 14)
    a.load(0, 15, -8)
    a.load(1, 15, -16)
    a.store(1, RT_G_OWNER_M_OFFSET, 0)
    a.load(18, 15, -8)
    a.load(19, 15, -16)
    a.call("_rt_gogo")
    a.jmp("_rt_sw_loop")
    a.label("_rt_sw_idle")
    a.lea(4, "_rt_xu_len")
    a.vm_mov_imm(3, 0)
    if a.os == 2 {
        a.vm_mov_imm(18, 1)
        a.vm_call_iat("_iat_Sleep")
    } else {
        rt_os_word_wait(a)
    }
    a.jmp("_rt_sw_loop")
    <<
}

fn rt_emit_xu_pump_mc(a &mut Assembler) {
    a.label("_rt_xu_pump")
    a.prologue(16)
    a.call("_rt_g_self")
    a.vm_cbnz(14, "_rt_mp_y")
    a.lea(18, "_rt_ms")
    a.call("_rt_g_save")
    a.lea(18, "_rt_ms")
    a.call("_rt_release_handoff")
    a.call("_rt_dequeue")
    a.vm_cbz(14, "_rt_mp_empty")
    a.store(15, -8, 14)
    a.lea(18, "_rt_ms")
    a.load(19, 15, -8)
    a.store(19, RT_G_OWNER_M_OFFSET, 18)
    a.call("_rt_gogo")
    a.label("_rt_mp_empty")
    a.epilogue()
    a.label("_rt_mp_y")
    a.call("_rt_g_yield")
    a.epilogue()
    <<
}

fn rt_emit_thread_entry(a &mut Assembler) {
    a.label("_rt_thread_entry")
    a.prologue(16)
    if a.os == 2 && a.arch == 1 {
        a.mov(18, 21) // Win64 RCX (A3) → A0
    }
    a.store(15, -8, 18)
    a.load(9, 18, 0)
    a.load(18, 18, 8)
    a.load(0, 15, -8)
    a.load(19, 0, 16)
    a.load(20, 0, 24)
    a.load(21, 0, 32)
    a.load(22, 0, 40)
    a.load(23, 0, 48)
    a.call_reg(9)
    if a.os == 1 {
        a.vm_mov_imm(18, 0)
        a.vm_syscall(linux_exit_thread(a.arch))
    } else {
        a.vm_mov_imm(14, 0)
        a.epilogue()
    }
    <<
}

fn rt_emit_xu_mc(a &mut Assembler) {
    a.label("_rt_xu")
    a.prologue(48)
    a.store(15, -8, 18)
    a.load(18, 15, -8)
    a.call("_rt_g_alloc")
    a.mov(18, 14)
    a.call("_rt_ready")
    a.call("_rt_g_self")
    a.vm_cbnz(14, "_rt_xu_workers")
    // A caller on M0 must keep running the accept/event loop. Starting the
    // new G inline serializes CPU handlers and can block admission in the
    // task's first hosted syscall. Workers own freshly spawned work; M0
    // still pumps runnable Gs when it waits on a channel.
    a.call("_rt_ensure_worker")
    a.jmp("_rt_xu_done")
    a.lea(18, "_rt_ms")
    a.call("_rt_g_save")
    // `_rt_release_handoff` may call the platform mutex unlock helper, which
    // is allowed to clobber the scratch/return register.  Preserve the
    // g_save discriminator (0 = first entry, 1 = resumed M) before releasing
    // the lock handoff so a resumed continuation cannot be mistaken for a
    // fresh scheduler entry.
    a.store(15, -24, 14)
    a.lea(18, "_rt_ms")
    a.call("_rt_release_handoff")
    a.load(14, 15, -24)
    a.vm_cbnz(14, "_rt_xu_workers")
    a.call("_rt_dequeue")
    a.vm_cbz(14, "_rt_xu_workers")
    a.store(15, -16, 14)
    a.lea(1, "_rt_ms")
    a.store(14, RT_G_OWNER_M_OFFSET, 1)
    // Use the same fresh-vs-saved discriminator as workers.  The old inline
    // path always called g_start, restarting a saved continuation (duplicate
    // start markers and, on return, shared-stack execution).
    a.load(19, 15, -16)
    a.store(1, RT_M_CURRENT_G_OFFSET, 19)
    a.call("_rt_gogo")
    a.label("_rt_xu_workers")
    a.lea(0, "_rt_xu_len")
    a.load(1, 0, 0)
    a.vm_cbz(1, "_rt_xu_done")
    a.call("_rt_ensure_worker")
    a.label("_rt_xu_done")
    a.epilogue()
    <<
}

fn rt_emit_ensure_worker(a &mut Assembler) {
    a.label("_rt_ensure_worker")
    a.prologue(48)
    rt_heap_lock(a)
    a.lea(0, "_rt_xu_nwork")
    a.load(1, 0, 0)
    a.vm_cmp_imm(1, RT_WORKER_LIMIT)
    a.jge("_rt_ew_nospawn")
    a.vm_add_imm(1, 1, 1)
    a.store(0, 0, 1)
    a.lea(0, "_rt_ms")
    a.shl_imm(2, 1, RT_M_RECORD_SHIFT)
    a.add(0, 0, 2)
    a.store(15, -24, 0)
    rt_heap_unlock(a)
    if a.os == 0 {
        a.mov(18, 15)
        a.vm_sub_imm(18, 18, 32)
        a.vm_mov_imm(19, 0)
        a.lea(20, "_rt_sched_worker")
        a.load(21, 15, -24)
        a.vm_call_iat("_iat_pthread_create")
        a.load(18, 15, -32)
        a.vm_call_iat("_iat_pthread_detach")
        a.jmp("_rt_ew_done")
    }
    if a.os == 1 && (a.arch == 0 || a.arch == 1) {
        a.lea(0, "_rt_host_worker_start")
        a.load(9, 0, 0)
        a.vm_cbz(9, "_rt_ew_raw_clone")
        a.lea(18, "_rt_sched_worker")
        a.load(19, 15, -24)
        a.call_reg(9)
        a.vm_mov_imm64(0, 4294967295)
        a.iand(14, 14, 0)
        a.vm_cmp_imm(14, 1)
        a.jne("_rt_xu_mc_fail")
        a.jmp("_rt_ew_done")
        a.label("_rt_ew_raw_clone")
    }
    if a.os == 2 {
        a.vm_mov_imm(18, 0)
        a.vm_mov_imm(19, 0)
        a.lea(20, "_rt_sched_worker")
        a.load(21, 15, -24)
        a.vm_mov_imm(22, 0)
        a.vm_mov_imm(23, 0)
        a.vm_call_iat7("_iat_CreateThread")
        a.mov(18, 14)
        a.vm_call_iat("_iat_CloseHandle")
        a.jmp("_rt_ew_done")
    }
    a.vm_mov_imm(0, RT_WORKER_STACK_BYTES)
    rt_emit_mmap(a, 0)
    a.vm_cmp_imm(14, RT_MIN_HEAP_POINTER)
    a.jlt("_rt_xu_mc_fail")
    a.vm_add_imm(1, 14, RT_WORKER_STACK_BYTES)
    a.vm_sub_imm(1, 1, 16)
    a.load(0, 15, -24)
    a.store(1, 0, 0)
    // x64 syscall pushes R10 (V0) then pops it. The clone child resumes
    // after SYSCALL with RSP = this stack, so that pop would eat M.
    // Keep M in V2 (RBX / x21), which clone preserves.
    a.mov(2, 0)
    a.vm_mov_imm(18, 331520)
    a.mov(19, 1)
    a.vm_mov_imm(20, 0)
    a.vm_mov_imm(21, 0)
    a.vm_mov_imm(22, 0)
    a.vm_mov_imm(23, 0)
    a.vm_syscall(syscall_number(a.os, a.arch, 7))
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_xu_mc_fail")
    a.jeq("_rt_xu_mc_child")
    a.jmp("_rt_ew_done")
    a.label("_rt_ew_nospawn")
    rt_heap_unlock(a)
    a.label("_rt_ew_done")
    a.epilogue()
    a.label("_rt_xu_mc_child")
    a.mov(18, 2)
    a.call("_rt_sched_worker")
    a.vm_mov_imm(18, 0)
    a.vm_syscall(linux_exit_thread(a.arch))
    a.label("_rt_xu_mc_fail")
    rt_exit(a, 1)
    <<
}

fn rt_emit_enter_syscall_stub(a &mut Assembler) {
    a.label("_rt_enter_syscall")
    a.vm_ret()
    <<
}

fn rt_emit_enter_syscall(a &mut Assembler) {
    a.label("_rt_enter_syscall")
    a.prologue(16)
    a.call("_rt_g_self")
    a.vm_cbnz(14, "_rt_es_g")
    a.label("_rt_es_workers")
    a.lea(0, "_rt_xu_len")
    a.load(1, 0, 0)
    a.vm_cbz(1, "_rt_es_out")
    a.call("_rt_ensure_worker")
    a.jmp("_rt_es_out")
    a.label("_rt_es_g")
    a.store(15, -8, 14)
    a.load(1, 14, RT_G_OWNER_M_OFFSET)
    a.vm_cbz(1, "_rt_es_m0")
    a.lea(2, "_rt_ms")
    a.cmp(1, 2)
    // A native loop may occupy M0 while this G runs an event pump. Before
    // blocking its worker, give already-runnable peers a worker of their own.
    a.jne("_rt_es_workers")
    // Keep the owner M local: another worker may rewrite G_M as soon as the
    // G is made runnable, so cleanup must never re-read it from G.
    a.store(15, -16, 1)
    a.jmp("_rt_es_hand")
    a.label("_rt_es_m0")
    a.lea(1, "_rt_ms")
    a.store(15, -16, 1)
    a.label("_rt_es_hand")
    a.load(18, 15, -8)
    a.call("_rt_g_save")
    a.vm_cbnz(14, "_rt_es_out")
    // Publish the syscall continuation while holding the scheduler lock, then
    // hand that lock to the owner M.  This closes the same G-stack window as
    // _rt_g_yield; marker 2 asks the M to wake an idle worker after unlock.
    rt_heap_lock(a)
    a.load(18, 15, -8)
    a.call("_rt_enqueue_locked")
    a.load(0, 15, -8)
    a.vm_add_imm(1, 0, RT_G_WAKE_OFFSET)
    a.vm_mov_imm(2, 0)
    a.store(1, 0, 2) // clear deferred wake
    a.load(1, 15, -16) // owner M
    a.vm_mov_imm(2, RT_M_HANDOFF_QUEUED)
    a.vm_add_imm(3, 1, RT_M_HANDOFF_OFFSET)
    a.vm_atomic_store(3, 2) // M_HANDOFF = queued (release)
    a.vm_mov_imm(2, 0)
    a.store(1, RT_M_CURRENT_G_OFFSET, 2) // clear M_G
    a.mov(18, 1)
    a.vm_mov_imm(19, 1)
    a.call("_rt_g_switch")
    a.label("_rt_es_out")
    a.epilogue()
    <<
}

fn rt_mc_lock(a &mut Assembler) {
    a.load(18, 15, -8)
    rt_os_mutex_lock(a)
    <<
}

fn rt_mc_unlock(a &mut Assembler) {
    a.load(18, 15, -8)
    rt_os_mutex_unlock(a)
    <<
}

fn rt_mc_select_notify(a &mut Assembler) {
    a.load(18, 15, -8)
    a.call("_rt_select_notify")
}

fn rt_mc_signal_if_waiters(a &mut Assembler, cv_off int) {
    rt_mc_select_notify(a)
    <<
}

// `_rt_wn_pool_alloc` (A0 = size → Ret = node) and `_rt_wn_pool_free`
// (A0 = node, A1 = elem_slots). Hosted MC only. Recv nodes are 32 B;
// send nodes 32+8*slots; requests ≤ 64 B reuse the heap-mutex free list.
fn rt_emit_wn_pool_helpers(a &mut Assembler) {
    a.label("_rt_wn_pool_alloc")
    a.prologue(16)
    a.store(15, -8, 18)
    a.vm_cmp_imm(18, RT_WN_POOL_NODE_BYTES)
    a.jgt("_rt_wn_pa_heap")
    rt_heap_lock(a)
    a.lea(2, "_rt_wn_pool")
    a.load(3, 2, 0)
    a.vm_cbz(3, "_rt_wn_pa_miss")
    a.load(0, 3, 0)
    a.store(2, 0, 0)
    a.lea(1, "_rt_wn_pool_n")
    a.load(0, 1, 0)
    a.vm_sub_imm(0, 0, 1)
    a.store(1, 0, 0)
    a.store(15, -8, 3)
    rt_heap_unlock(a)
    a.load(14, 15, -8)
    a.epilogue()
    a.label("_rt_wn_pa_miss")
    rt_heap_unlock(a)
    a.vm_mov_imm(18, RT_WN_POOL_NODE_BYTES)
    a.jmp("_rt_wn_pa_call")
    a.label("_rt_wn_pa_heap")
    a.load(18, 15, -8)
    a.label("_rt_wn_pa_call")
    a.call("_rt_alloc")
    a.epilogue()

    a.label("_rt_wn_pool_free")
    a.prologue(16)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.load(2, 18, RT_WN_KIND_OFFSET) // kind
    a.vm_cmp_imm(2, RT_WN_KIND_RECV) // RECV
    a.jeq("_rt_wn_pf_push")
    a.load(0, 15, -16)
    a.shl_imm(0, 0, 3)
    a.vm_add_imm(0, 0, RT_WN_MC_HEADER_BYTES)
    a.vm_cmp_imm(0, RT_WN_POOL_NODE_BYTES)
    a.jgt("_rt_wn_pf_heap")
    a.label("_rt_wn_pf_push")
    rt_heap_lock(a)
    a.lea(2, "_rt_wn_pool_n")
    a.load(3, 2, 0)
    a.vm_cmp_imm(3, RT_WN_POOL_CAPACITY)
    a.jge("_rt_wn_pf_full")
    a.vm_add_imm(3, 3, 1)
    a.store(2, 0, 3)
    a.lea(2, "_rt_wn_pool")
    a.load(3, 2, 0)
    a.load(1, 15, -8)
    a.store(1, 0, 3)
    a.store(2, 0, 1)
    rt_heap_unlock(a)
    a.epilogue()
    a.label("_rt_wn_pf_full")
    rt_heap_unlock(a)
    a.label("_rt_wn_pf_heap")
    a.load(18, 15, -8)
    a.call("_rt_free")
    a.epilogue()
    <<
}

fn rt_wn_alloc_mc(a &mut Assembler) {
    a.call("_rt_wn_pool_alloc")
    a.store(15, -40, 14)
    <<
}

fn rt_wn_free_mc(a &mut Assembler) {
    a.load(18, 15, -40)
    a.load(19, 15, -24)
    a.call("_rt_wn_pool_free")
    <<
}

fn rt_emit_chan_new_mc(a &mut Assembler) {
    a.label("_rt_chan_new")
    a.prologue(32)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.vm_cmp_imm(18, 0)
    a.jlt("_rt_cn_mc_bad")
    a.vm_cmp_imm(19, 0)
    a.jlt("_rt_cn_mc_bad")
    a.mul(0, 18, 19)
    a.vm_cbz(19, "_rt_cn_mc_bytes_ok")
    a.mov(1, 0)
    a.div(1, 0, 19)
    a.cmp(1, 18)
    a.jne("_rt_cn_mc_bad")
    a.mov(0, 1)
    a.mul(0, 18, 19)
    a.label("_rt_cn_mc_bytes_ok")
    a.mov(1, 0)
    a.shl_imm(0, 0, 3)
    a.cmp(0, 1)
    a.jae("_rt_cn_mc_size_ok")
    a.jmp("_rt_cn_mc_bad")
    a.label("_rt_cn_mc_size_ok")
    a.vm_add_imm(0, 0, RT_CHAN_MC_HEADER_BYTES)
    a.cmp(0, 1)
    a.jae("_rt_cn_mc_alloc_ok")
    a.jmp("_rt_cn_mc_bad")
    a.label("_rt_cn_mc_alloc_ok")
    a.mov(18, 0)
    a.call("_rt_alloc")
    a.store(15, -24, 14)
    a.load(0, 15, -24)
    a.vm_mov_imm(1, 0)
    a.vm_mov_imm(2, 0)
    a.label("_rt_cn_mc_zloop")
    a.vm_cmp_imm(2, RT_CHAN_MC_HEADER_BYTES)
    a.jge("_rt_cn_mc_zdone")
    a.add(3, 0, 2)
    a.store(3, 0, 1)
    a.vm_add_imm(2, 2, 8)
    a.jmp("_rt_cn_mc_zloop")
    a.label("_rt_cn_mc_zdone")
    a.load(1, 15, -8)
    a.store(0, RT_CHAN_MC_ELEM_SLOTS_OFFSET, 1)
    a.load(1, 15, -16)
    a.store(0, RT_CHAN_MC_CAPACITY_OFFSET, 1)
    a.vm_cmp_imm(1, 0)
    a.jeq("_rt_cn_mc_nobuf")
    a.vm_add_imm(1, 0, RT_CHAN_MC_HEADER_BYTES)
    a.store(0, RT_CHAN_MC_BUFFER_OFFSET, 1)
    a.jmp("_rt_cn_mc_done")
    a.label("_rt_cn_mc_nobuf")
    a.vm_mov_imm(1, 0)
    a.store(0, RT_CHAN_MC_BUFFER_OFFSET, 1)
    a.label("_rt_cn_mc_done")
    a.mov(14, 0)
    a.epilogue()
    a.label("_rt_cn_mc_bad")
    a.jmp("_rt_al_oom")
    <<
}

fn rt_emit_chan_send_mc(a &mut Assembler) {
    a.label("_rt_chan_send")
    a.prologue(48)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    rt_mc_lock(a)
    a.label("_rt_cs_mc_loop")
    a.load(0, 15, -8)
    a.load(1, 0, RT_CHAN_MC_CLOSED_OFFSET) // closed?
    a.vm_cbnz(1, "_rt_cs_mc_closed")
    // head is a parked recv → complete that rendezvous
    a.load(1, 0, RT_CHAN_MC_WAIT_HEAD_OFFSET)
    a.vm_cbz(1, "_rt_cs_mc_no_recv")
    a.load(2, 1, RT_WN_KIND_OFFSET) // kind
    a.vm_cmp_imm(2, RT_WN_KIND_RECV)
    a.jne("_rt_cs_mc_no_recv")
    a.load(2, 1, RT_WN_BUFFER_OFFSET) // node.buf = parked recv's dst
    a.store(15, -32, 2)
    a.vm_mov_imm(1, 0)
    a.label("_rt_cs_mc_rv_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_cs_mc_rv_done")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    if a.has_int64_pairs() { a.load(5, 3, 4) }
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    if a.has_int64_pairs() { a.store(3, 4, 5) }
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_cs_mc_rv_copy")
    a.label("_rt_cs_mc_rv_done")
    a.load(0, 15, -8)
    a.load(1, 0, RT_CHAN_MC_WAIT_HEAD_OFFSET)
    a.vm_mov_imm(2, RT_WN_SERVED)
    // Publish the payload/state before waking the parked owner.
    a.vm_add_imm(3, 1, RT_WN_DONE_OFFSET)
    a.vm_atomic_store(3, 2) // done = SERVED (release)
    a.load(2, 1, 0) // next
    a.store(0, RT_CHAN_MC_WAIT_HEAD_OFFSET, 2) // head = next
    a.vm_cbnz(2, "_rt_cs_mc_pop_keep")
    a.vm_mov_imm(2, 0)
    a.store(0, RT_CHAN_MC_WAIT_TAIL_OFFSET, 2) // tail = 0
    a.label("_rt_cs_mc_pop_keep")
    a.load(18, 1, RT_WN_G_OFFSET)
    a.call("_rt_ready")
    rt_mc_unlock(a)
    a.epilogue()
    a.label("_rt_cs_mc_no_recv")
    a.load(1, 0, RT_CHAN_MC_CAPACITY_OFFSET)
    a.vm_cmp_imm(1, 0)
    a.jeq("_rt_cs_mc_block")
    a.load(2, 0, RT_CHAN_MC_LENGTH_OFFSET)
    a.cmp(2, 1)
    a.jge("_rt_cs_mc_block")
    a.load(1, 0, RT_CHAN_MC_TAIL_OFFSET)
    a.load(2, 0, RT_CHAN_MC_ELEM_SLOTS_OFFSET)
    a.mul(3, 1, 2)
    a.shl_imm(3, 3, 3)
    a.load(4, 0, RT_CHAN_MC_BUFFER_OFFSET)
    a.add(3, 4, 3)
    a.store(15, -32, 3)
    a.vm_mov_imm(1, 0)
    a.label("_rt_cs_mc_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_cs_mc_copied")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    if a.has_int64_pairs() { a.load(5, 3, 4) }
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    if a.has_int64_pairs() { a.store(3, 4, 5) }
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_cs_mc_copy")
    a.label("_rt_cs_mc_copied")
    a.load(0, 15, -8)
    a.load(1, 0, RT_CHAN_MC_TAIL_OFFSET)
    a.vm_add_imm(1, 1, 1)
    a.load(2, 0, RT_CHAN_MC_CAPACITY_OFFSET)
    a.cmp(1, 2)
    a.jlt("_rt_cs_mc_tail_ok")
    a.vm_mov_imm(1, 0)
    a.label("_rt_cs_mc_tail_ok")
    a.store(0, RT_CHAN_MC_TAIL_OFFSET, 1)
    a.load(1, 0, RT_CHAN_MC_LENGTH_OFFSET)
    a.vm_add_imm(1, 1, 1)
    a.store(0, RT_CHAN_MC_LENGTH_OFFSET, 1)
    rt_mc_signal_if_waiters(a, RT_CHAN_MC_RECV_CV_OFFSET)
    rt_mc_unlock(a)
    a.epilogue()
    a.label("_rt_cs_mc_block")
    // Allocate waiter header plus slots*8 and copy the value INTO the node.
    a.load(1, 15, -24)
    a.shl_imm(1, 1, 3)
    a.vm_add_imm(1, 1, RT_WN_MC_HEADER_BYTES)
    a.mov(18, 1)
    rt_wn_alloc_mc(a)
    a.load(1, 15, -40)
    a.vm_mov_imm(2, 0)
    a.store(1, 0, 2) // next = 0
    a.vm_mov_imm(2, RT_WN_KIND_SEND)
    a.store(1, RT_WN_KIND_OFFSET, 2) // kind = SEND
    a.vm_mov_imm(2, RT_WN_WAITING)
    a.store(1, RT_WN_DONE_OFFSET, 2) // done = WAITING
    a.vm_add_imm(2, 1, RT_WN_MC_HEADER_BYTES)
    a.store(1, RT_WN_BUFFER_OFFSET, 2) // node.buf = node+40 (data area)
    a.store(15, -32, 2)
    a.call("_rt_g_self")
    a.load(1, 15, -40)
    a.store(1, RT_WN_G_OFFSET, 14) // node.g
    a.vm_mov_imm(1, 0)
    a.label("_rt_cs_mc_park_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_cs_mc_park_copied")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    if a.has_int64_pairs() { a.load(5, 3, 4) }
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    if a.has_int64_pairs() { a.store(3, 4, 5) }
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_cs_mc_park_copy")
    a.label("_rt_cs_mc_park_copied")
    // enqueue at tail (locked)
    a.load(0, 15, -8)
    a.load(2, 0, RT_CHAN_MC_WAIT_TAIL_OFFSET) // tail
    a.vm_cbnz(2, "_rt_cs_mc_q_append")
    a.load(1, 15, -40)
    a.store(0, RT_CHAN_MC_WAIT_HEAD_OFFSET, 1) // head = node
    a.store(0, RT_CHAN_MC_WAIT_TAIL_OFFSET, 1) // tail = node
    a.jmp("_rt_cs_mc_q_done")
    a.label("_rt_cs_mc_q_append")
    a.load(1, 15, -40)
    a.store(2, 0, 1) // tail->next = node
    a.store(0, RT_CHAN_MC_WAIT_TAIL_OFFSET, 1) // tail = node
    a.label("_rt_cs_mc_q_done")
    rt_mc_select_notify(a)
    rt_mc_unlock(a)
    a.label("_rt_cs_mc_wait")
    a.load(18, 15, -40)
    a.call("_rt_park_until")
    rt_mc_lock(a)
    a.load(1, 15, -40)
    // Acquire the terminal state after the peer's release publication.
    a.vm_add_imm(3, 1, RT_WN_DONE_OFFSET)
    a.vm_atomic_load(2, 3) // node.done
    a.drop_seq = a.drop_seq + 1
    cs_again := "_rt_cs_mc_again_" + str(a.drop_seq)
    a.vm_cbnz(2, cs_again + "")
    rt_mc_unlock(a)
    a.jmp("_rt_cs_mc_wait")
    a.label(cs_again + "")
    a.vm_cmp_imm(2, RT_WN_SERVED) // SERVED?
    a.jeq("_rt_cs_mc_woke")
    a.jmp("_rt_cs_mc_closed_node") // CLOSED → free then fail-loud
    a.label("_rt_cs_mc_woke")
    rt_wn_free_mc(a)
    rt_mc_unlock(a)
    a.epilogue()
    a.label("_rt_cs_mc_closed_node")
    rt_wn_free_mc(a)
    a.label("_rt_cs_mc_closed")
    rt_mc_unlock(a)
    rt_exit(a, 1)
    a.epilogue()
    <<
}

fn rt_emit_chan_recv_mc(a &mut Assembler) {
    a.label("_rt_chan_recv")
    a.prologue(48)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    rt_mc_lock(a)
    a.label("_rt_cr_mc_loop")
    a.load(0, 15, -8)
    // A buffered value is older than any sender parked behind the full
    // buffer.  Dequeue it first; the freed slot is filled from the head
    // sender below.  This is the same FIFO rule as a Go buffered channel and
    // avoids delivering a newer blocked send ahead of an older buffered one.
    a.load(1, 0, RT_CHAN_MC_LENGTH_OFFSET) // len
    a.vm_cbnz(1, "_rt_cr_mc_no_send")
    // With an empty buffer, a parked send is a direct rendezvous.
    a.load(1, 0, RT_CHAN_MC_WAIT_HEAD_OFFSET)
    a.vm_cbz(1, "_rt_cr_mc_no_send")
    a.load(2, 1, RT_WN_KIND_OFFSET) // kind
    a.vm_cmp_imm(2, RT_WN_KIND_RECV)
    a.jeq("_rt_cr_mc_no_send")
    a.load(2, 1, RT_WN_BUFFER_OFFSET) // node.buf = node+32 (data area)
    a.store(15, -32, 2)
    a.vm_mov_imm(1, 0)
    a.label("_rt_cr_mc_rv_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_cr_mc_rv_done")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    if a.has_int64_pairs() { a.load(5, 3, 4) }
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    if a.has_int64_pairs() { a.store(3, 4, 5) }
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_cr_mc_rv_copy")
    a.label("_rt_cr_mc_rv_done")
    a.load(0, 15, -8)
    a.load(1, 0, RT_CHAN_MC_WAIT_HEAD_OFFSET)
    a.vm_mov_imm(2, RT_WN_SERVED)
    a.vm_add_imm(3, 1, RT_WN_DONE_OFFSET)
    a.vm_atomic_store(3, 2) // done = SERVED (release)
    a.load(2, 1, 0) // next
    a.store(0, RT_CHAN_MC_WAIT_HEAD_OFFSET, 2) // head = next
    a.vm_cbnz(2, "_rt_cr_mc_pop_keep")
    a.vm_mov_imm(2, 0)
    a.store(0, RT_CHAN_MC_WAIT_TAIL_OFFSET, 2) // tail = 0
    a.label("_rt_cr_mc_pop_keep")
    a.load(18, 1, RT_WN_G_OFFSET)
    a.call("_rt_ready")
    rt_mc_unlock(a)
    a.vm_mov_imm(14, 1) // MS9e: data
    a.epilogue()
    a.label("_rt_cr_mc_no_send")
    a.load(1, 0, RT_CHAN_MC_LENGTH_OFFSET)
    a.vm_cmp_imm(1, 0)
    a.jeq("_rt_cr_mc_empty")
    a.load(1, 0, RT_CHAN_MC_HEAD_OFFSET)
    a.load(2, 0, RT_CHAN_MC_ELEM_SLOTS_OFFSET)
    a.mul(3, 1, 2)
    a.shl_imm(3, 3, 3)
    a.load(4, 0, RT_CHAN_MC_BUFFER_OFFSET)
    a.add(3, 4, 3)
    a.store(15, -32, 3)
    a.vm_mov_imm(1, 0)
    a.label("_rt_cr_mc_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_cr_mc_copied")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    if a.has_int64_pairs() { a.load(5, 3, 4) }
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    if a.has_int64_pairs() { a.store(3, 4, 5) }
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_cr_mc_copy")
    a.label("_rt_cr_mc_copied")
    a.load(0, 15, -8)
    a.load(1, 0, RT_CHAN_MC_HEAD_OFFSET)
    a.vm_add_imm(1, 1, 1)
    a.load(2, 0, RT_CHAN_MC_CAPACITY_OFFSET)
    a.cmp(1, 2)
    a.jlt("_rt_cr_mc_head_ok")
    a.vm_mov_imm(1, 0)
    a.label("_rt_cr_mc_head_ok")
    a.store(0, RT_CHAN_MC_HEAD_OFFSET, 1)
    a.load(1, 0, RT_CHAN_MC_LENGTH_OFFSET)
    a.vm_sub_imm(1, 1, 1)
    a.store(0, RT_CHAN_MC_LENGTH_OFFSET, 1)
    // Promote the oldest blocked sender into the slot just freed by this
    // receive.  Keep the channel locked while copying and waking the sender;
    // the parked owner reclaims its node after observing done=SERVED.
    a.load(1, 0, RT_CHAN_MC_WAIT_HEAD_OFFSET) // wait_head
    a.vm_cbz(1, "_rt_cr_mc_promote_skip")
    a.load(2, 1, RT_WN_KIND_OFFSET) // kind
    a.vm_cmp_imm(2, RT_WN_KIND_SEND) // SEND (MC never enqueues SEND_DETACHED)
    a.jne("_rt_cr_mc_promote_skip")
    a.store(15, -40, 1) // promoted node
    a.load(1, 0, RT_CHAN_MC_TAIL_OFFSET) // tail index
    a.load(2, 0, RT_CHAN_MC_ELEM_SLOTS_OFFSET) // elem_slots
    a.mul(3, 1, 2)
    a.shl_imm(3, 3, 3)
    a.load(4, 0, RT_CHAN_MC_BUFFER_OFFSET) // ring base
    a.add(3, 4, 3)
    a.store(15, -16, 3) // destination slot (receiver dst no longer needed)
    a.load(1, 15, -40)
    a.load(2, 1, RT_WN_BUFFER_OFFSET) // sender node data
    a.store(15, -32, 2)
    a.vm_mov_imm(1, 0)
    a.label("_rt_cr_mc_promote_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_cr_mc_promote_copied")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    if a.has_int64_pairs() { a.load(5, 3, 4) }
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    if a.has_int64_pairs() { a.store(3, 4, 5) }
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_cr_mc_promote_copy")
    a.label("_rt_cr_mc_promote_copied")
    a.load(0, 15, -8)
    a.load(1, 0, RT_CHAN_MC_TAIL_OFFSET)
    a.vm_add_imm(1, 1, 1)
    a.load(2, 0, RT_CHAN_MC_CAPACITY_OFFSET)
    a.cmp(1, 2)
    a.jlt("_rt_cr_mc_promote_tail_ok")
    a.vm_mov_imm(1, 0)
    a.label("_rt_cr_mc_promote_tail_ok")
    a.store(0, RT_CHAN_MC_TAIL_OFFSET, 1)
    a.load(1, 0, RT_CHAN_MC_LENGTH_OFFSET)
    a.vm_add_imm(1, 1, 1)
    a.store(0, RT_CHAN_MC_LENGTH_OFFSET, 1)
    // Serve/unlink the sender and make its G runnable.  The queue remains
    // FIFO; only the head sender is promoted.
    a.load(1, 15, -40)
    a.vm_mov_imm(2, RT_WN_SERVED)
    a.vm_add_imm(3, 1, RT_WN_DONE_OFFSET)
    a.vm_atomic_store(3, 2) // done = SERVED (release)
    a.load(2, 1, 0)
    a.store(0, RT_CHAN_MC_WAIT_HEAD_OFFSET, 2) // head = next
    a.vm_cbnz(2, "_rt_cr_mc_promote_pop_keep")
    a.vm_mov_imm(2, 0)
    a.store(0, RT_CHAN_MC_WAIT_TAIL_OFFSET, 2) // tail = 0
    a.label("_rt_cr_mc_promote_pop_keep")
    a.load(18, 1, RT_WN_G_OFFSET)
    a.call("_rt_ready")
    a.load(0, 15, -8)
    a.label("_rt_cr_mc_promote_skip")
    rt_mc_signal_if_waiters(a, RT_CHAN_MC_SEND_CV_OFFSET)
    rt_mc_unlock(a)
    a.vm_mov_imm(14, 1) // MS9e: data
    a.epilogue()
    a.label("_rt_cr_mc_empty")
    a.load(1, 0, RT_CHAN_MC_CLOSED_OFFSET) // closed?
    a.vm_cbnz(1, "_rt_cr_mc_zero")
    // park: RECV node whose buf is our destination
    a.vm_mov_imm(1, RT_WN_MC_HEADER_BYTES)
    a.mov(18, 1)
    rt_wn_alloc_mc(a)
    a.load(1, 15, -40)
    a.vm_mov_imm(2, 0)
    a.store(1, 0, 2) // next = 0
    a.vm_mov_imm(2, RT_WN_KIND_RECV)
    a.store(1, RT_WN_KIND_OFFSET, 2) // kind = RECV
    a.vm_mov_imm(2, RT_WN_WAITING)
    a.store(1, RT_WN_DONE_OFFSET, 2) // done = WAITING
    a.load(2, 15, -16)
    a.store(1, RT_WN_BUFFER_OFFSET, 2) // node.buf = dst
    a.call("_rt_g_self")
    a.load(1, 15, -40)
    a.store(1, RT_WN_G_OFFSET, 14) // node.g
    // enqueue at tail
    a.load(0, 15, -8)
    a.load(2, 0, RT_CHAN_MC_WAIT_TAIL_OFFSET) // tail
    a.vm_cbnz(2, "_rt_cr_mc_q_append")
    a.load(1, 15, -40)
    a.store(0, RT_CHAN_MC_WAIT_HEAD_OFFSET, 1) // head = node
    a.store(0, RT_CHAN_MC_WAIT_TAIL_OFFSET, 1) // tail = node
    a.jmp("_rt_cr_mc_q_done")
    a.label("_rt_cr_mc_q_append")
    a.load(1, 15, -40)
    a.store(2, 0, 1) // tail->next = node
    a.store(0, RT_CHAN_MC_WAIT_TAIL_OFFSET, 1) // tail = node
    a.label("_rt_cr_mc_q_done")
    rt_mc_select_notify(a)
    rt_mc_unlock(a)
    a.label("_rt_cr_mc_wait")
    a.load(18, 15, -40)
    a.call("_rt_park_until")
    rt_mc_lock(a)
    a.load(1, 15, -40)
    a.vm_add_imm(3, 1, RT_WN_DONE_OFFSET)
    a.vm_atomic_load(2, 3) // node.done
    a.drop_seq = a.drop_seq + 1
    cr_again := "_rt_cr_mc_again_" + str(a.drop_seq)
    a.vm_cbnz(2, cr_again + "")
    rt_mc_unlock(a)
    a.jmp("_rt_cr_mc_wait")
    a.label(cr_again + "")
    a.vm_cmp_imm(2, RT_WN_SERVED) // SERVED?
    a.jeq("_rt_cr_mc_woke")
    a.jmp("_rt_cr_mc_zero_node") // CLOSED: dst zeroed by close; re-zero harmless
    a.label("_rt_cr_mc_woke")
    rt_wn_free_mc(a)
    rt_mc_unlock(a)
    a.vm_mov_imm(14, 1) // MS9e: data
    a.epilogue()
    a.label("_rt_cr_mc_zero_node")
    rt_wn_free_mc(a)
    a.label("_rt_cr_mc_zero")
    a.vm_mov_imm(1, 0)
    a.label("_rt_cr_mc_zloop")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_cr_mc_zdone")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.vm_mov_imm(4, 0)
    a.store(3, 0, 4)
    if a.has_int64_pairs() { a.store(3, 4, 4) }
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_cr_mc_zloop")
    a.label("_rt_cr_mc_zdone")
    rt_mc_unlock(a)
    a.vm_mov_imm(14, 2) // MS9e: closed-empty
    a.epilogue()
    <<
}

fn rt_emit_chan_close_mc(a &mut Assembler) {
    a.label("_rt_chan_close")
    a.prologue(16)
    a.store(15, -8, 18)
    rt_mc_lock(a)
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 1)
    a.store(0, RT_CHAN_MC_CLOSED_OFFSET, 1) // closed
    // Drain the wait queue: zero parked recv destinations, mark all done=CLOSED
    // (parked senders wake to done==CLOSED and <<< 1 fail-loud).
    a.load(1, 0, RT_CHAN_MC_WAIT_HEAD_OFFSET)
    a.vm_cbz(1, "_rt_cc_mc_qdone")
    a.label("_rt_cc_mc_qloop")
    a.load(2, 1, RT_WN_KIND_OFFSET) // kind
    a.vm_cmp_imm(2, RT_WN_KIND_RECV) // RECV?
    a.jne("_rt_cc_mc_qmark")
    a.load(2, 1, RT_WN_BUFFER_OFFSET) // buf (dst)
    a.load(3, 0, RT_CHAN_MC_ELEM_SLOTS_OFFSET) // elem_slots
    a.vm_mov_imm(4, 0)
    // V4 is the loop index.  Keep the zero value in V0 (the channel pointer
    // is reloaded after the loop); resetting V4 here would make every
    // multi-slot receive spin forever while closing the channel.
    a.vm_mov_imm(0, 0)
    a.label("_rt_cc_mc_zloop")
    a.cmp(4, 3)
    a.jge("_rt_cc_mc_zdone")
    a.mov(5, 4)
    a.shl_imm(5, 5, 3)
    a.add(5, 2, 5)
    a.store(5, 0, 0)
    if a.has_int64_pairs() { a.store(5, 4, 0) }
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_cc_mc_zloop")
    a.label("_rt_cc_mc_zdone")
    a.load(0, 15, -8)
    a.load(1, 0, RT_CHAN_MC_WAIT_HEAD_OFFSET)
    a.label("_rt_cc_mc_qmark")
    a.vm_mov_imm(2, RT_WN_CLOSED)
    a.vm_add_imm(3, 1, RT_WN_DONE_OFFSET)
    a.vm_atomic_store(3, 2) // done = CLOSED (release)
    a.load(18, 1, RT_WN_G_OFFSET)
    a.store(15, -16, 1)
    a.call("_rt_ready")
    a.load(0, 15, -8)
    a.load(1, 15, -16)
    a.load(2, 1, 0) // next
    a.store(0, RT_CHAN_MC_WAIT_HEAD_OFFSET, 2)
    a.mov(1, 2)
    a.vm_cbnz(1, "_rt_cc_mc_qloop")
    a.label("_rt_cc_mc_qdone")
    a.vm_mov_imm(1, 0)
    a.store(0, RT_CHAN_MC_WAIT_HEAD_OFFSET, 1)
    a.store(0, RT_CHAN_MC_WAIT_TAIL_OFFSET, 1)
    a.label("_rt_cc_mc_bcast")
    rt_mc_select_notify(a)
    rt_mc_unlock(a)
    a.call("_rt_g_self")
    a.vm_cbnz(14, "_rt_cc_mc_out")
    a.lea(0, "_rt_xu_len")
    a.load(1, 0, 0)
    a.vm_cbz(1, "_rt_cc_mc_out")
    a.call("_rt_ensure_worker")
    a.label("_rt_cc_mc_out")
    a.epilogue()
    <<
}

fn rt_emit_chan_try_send_mc(a &mut Assembler) {
    a.label("_rt_chan_try_send")
    a.prologue(48)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    rt_mc_lock(a)
    a.load(0, 15, -8)
    a.load(1, 0, RT_CHAN_MC_CLOSED_OFFSET)
    a.vm_cbnz(1, "_rt_cts_mc_closed")
    a.load(1, 0, RT_CHAN_MC_WAIT_HEAD_OFFSET)
    a.vm_cbz(1, "_rt_cts_mc_no_recv")
    a.load(2, 1, RT_WN_KIND_OFFSET)
    a.vm_cmp_imm(2, RT_WN_KIND_RECV)
    a.jne("_rt_cts_mc_no_recv")
    a.load(2, 1, RT_WN_BUFFER_OFFSET)
    a.store(15, -32, 2)
    a.vm_mov_imm(1, 0)
    a.label("_rt_cts_mc_rv_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_cts_mc_rv_done")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    if a.has_int64_pairs() { a.load(5, 3, 4) }
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    if a.has_int64_pairs() { a.store(3, 4, 5) }
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_cts_mc_rv_copy")
    a.label("_rt_cts_mc_rv_done")
    a.load(0, 15, -8)
    a.load(1, 0, RT_CHAN_MC_WAIT_HEAD_OFFSET)
    a.vm_mov_imm(2, RT_WN_SERVED)
    a.vm_add_imm(3, 1, RT_WN_DONE_OFFSET)
    a.vm_atomic_store(3, 2) // done = SERVED (release)
    a.load(2, 1, 0) // next
    a.store(0, RT_CHAN_MC_WAIT_HEAD_OFFSET, 2) // head = next
    a.vm_cbnz(2, "_rt_cts_mc_pop_keep")
    a.vm_mov_imm(2, 0)
    a.store(0, RT_CHAN_MC_WAIT_TAIL_OFFSET, 2) // tail = 0
    a.label("_rt_cts_mc_pop_keep")
    a.load(18, 1, RT_WN_G_OFFSET)
    a.call("_rt_ready")
    rt_mc_unlock(a)
    a.vm_mov_imm(14, 1)
    a.epilogue()
    a.label("_rt_cts_mc_no_recv")
    a.load(1, 0, RT_CHAN_MC_CAPACITY_OFFSET)
    a.vm_cmp_imm(1, 0)
    a.jeq("_rt_cts_mc_block")
    a.load(2, 0, RT_CHAN_MC_LENGTH_OFFSET)
    a.cmp(2, 1)
    a.jge("_rt_cts_mc_block")
    a.load(1, 0, RT_CHAN_MC_TAIL_OFFSET)
    a.load(2, 0, RT_CHAN_MC_ELEM_SLOTS_OFFSET)
    a.mul(3, 1, 2)
    a.shl_imm(3, 3, 3)
    a.load(4, 0, RT_CHAN_MC_BUFFER_OFFSET)
    a.add(3, 4, 3)
    a.store(15, -32, 3)
    a.vm_mov_imm(1, 0)
    a.label("_rt_cts_mc_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_cts_mc_copied")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    if a.has_int64_pairs() { a.load(5, 3, 4) }
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    if a.has_int64_pairs() { a.store(3, 4, 5) }
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_cts_mc_copy")
    a.label("_rt_cts_mc_copied")
    a.load(0, 15, -8)
    a.load(1, 0, RT_CHAN_MC_TAIL_OFFSET)
    a.vm_add_imm(1, 1, 1)
    a.load(2, 0, RT_CHAN_MC_CAPACITY_OFFSET)
    a.cmp(1, 2)
    a.jlt("_rt_cts_mc_tail_ok")
    a.vm_mov_imm(1, 0)
    a.label("_rt_cts_mc_tail_ok")
    a.store(0, RT_CHAN_MC_TAIL_OFFSET, 1)
    a.load(1, 0, RT_CHAN_MC_LENGTH_OFFSET)
    a.vm_add_imm(1, 1, 1)
    a.store(0, RT_CHAN_MC_LENGTH_OFFSET, 1)
    rt_mc_signal_if_waiters(a, RT_CHAN_MC_RECV_CV_OFFSET)
    rt_mc_unlock(a)
    a.vm_mov_imm(14, 1)
    a.epilogue()
    a.label("_rt_cts_mc_block")
    rt_mc_unlock(a)
    a.vm_mov_imm(14, 0)
    a.epilogue()
    a.label("_rt_cts_mc_closed")
    rt_mc_unlock(a)
    rt_exit(a, 1)
    a.epilogue()
    <<
}

fn rt_emit_chan_try_recv_mc(a &mut Assembler) {
    a.label("_rt_chan_try_recv")
    a.prologue(48)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    rt_mc_lock(a)
    a.load(0, 15, -8)
    // Buffered values precede blocked senders.  Route non-empty channels to
    // the dequeue path so try-recv observes the same FIFO order as recv and
    // can promote the sender that owns the newly freed slot.
    a.load(1, 0, RT_CHAN_MC_LENGTH_OFFSET) // len
    a.vm_cbnz(1, "_rt_ctr_mc_no_send")
    // With an empty buffer, a parked send is a direct rendezvous.
    a.load(1, 0, RT_CHAN_MC_WAIT_HEAD_OFFSET)
    a.vm_cbz(1, "_rt_ctr_mc_no_send")
    a.load(2, 1, RT_WN_KIND_OFFSET)
    a.vm_cmp_imm(2, RT_WN_KIND_RECV)
    a.jeq("_rt_ctr_mc_no_send")
    a.load(2, 1, RT_WN_BUFFER_OFFSET)
    a.store(15, -32, 2)
    a.vm_mov_imm(1, 0)
    a.label("_rt_ctr_mc_rv_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_ctr_mc_rv_done")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    if a.has_int64_pairs() { a.load(5, 3, 4) }
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    if a.has_int64_pairs() { a.store(3, 4, 5) }
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_ctr_mc_rv_copy")
    a.label("_rt_ctr_mc_rv_done")
    a.load(0, 15, -8)
    a.load(1, 0, RT_CHAN_MC_WAIT_HEAD_OFFSET)
    a.vm_mov_imm(2, RT_WN_SERVED)
    a.vm_add_imm(3, 1, RT_WN_DONE_OFFSET)
    a.vm_atomic_store(3, 2) // done = SERVED (release)
    a.load(2, 1, 0) // next
    a.store(0, RT_CHAN_MC_WAIT_HEAD_OFFSET, 2) // head = next
    a.vm_cbnz(2, "_rt_ctr_mc_pop_keep")
    a.vm_mov_imm(2, 0)
    a.store(0, RT_CHAN_MC_WAIT_TAIL_OFFSET, 2) // tail = 0
    a.label("_rt_ctr_mc_pop_keep")
    a.load(18, 1, RT_WN_G_OFFSET)
    a.call("_rt_ready")
    rt_mc_unlock(a)
    a.vm_mov_imm(14, 1)
    a.epilogue()
    a.label("_rt_ctr_mc_no_send")
    a.load(1, 0, RT_CHAN_MC_LENGTH_OFFSET)
    a.vm_cmp_imm(1, 0)
    a.jeq("_rt_ctr_mc_empty")
    a.load(1, 0, RT_CHAN_MC_HEAD_OFFSET)
    a.load(2, 0, RT_CHAN_MC_ELEM_SLOTS_OFFSET)
    a.mul(3, 1, 2)
    a.shl_imm(3, 3, 3)
    a.load(4, 0, RT_CHAN_MC_BUFFER_OFFSET)
    a.add(3, 4, 3)
    a.store(15, -32, 3)
    a.vm_mov_imm(1, 0)
    a.label("_rt_ctr_mc_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_ctr_mc_copied")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    if a.has_int64_pairs() { a.load(5, 3, 4) }
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    if a.has_int64_pairs() { a.store(3, 4, 5) }
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_ctr_mc_copy")
    a.label("_rt_ctr_mc_copied")
    a.load(0, 15, -8)
    a.load(1, 0, RT_CHAN_MC_HEAD_OFFSET)
    a.vm_add_imm(1, 1, 1)
    a.load(2, 0, RT_CHAN_MC_CAPACITY_OFFSET)
    a.cmp(1, 2)
    a.jlt("_rt_ctr_mc_head_ok")
    a.vm_mov_imm(1, 0)
    a.label("_rt_ctr_mc_head_ok")
    a.store(0, RT_CHAN_MC_HEAD_OFFSET, 1)
    a.load(1, 0, RT_CHAN_MC_LENGTH_OFFSET)
    a.vm_sub_imm(1, 1, 1)
    a.store(0, RT_CHAN_MC_LENGTH_OFFSET, 1)
    // Fill the freed ring slot from the oldest blocked sender and wake it.
    a.load(1, 0, RT_CHAN_MC_WAIT_HEAD_OFFSET)
    a.vm_cbz(1, "_rt_ctr_mc_promote_skip")
    a.load(2, 1, RT_WN_KIND_OFFSET) // kind
    a.vm_cmp_imm(2, RT_WN_KIND_SEND) // SEND
    a.jne("_rt_ctr_mc_promote_skip")
    a.store(15, -40, 1)
    a.load(1, 0, RT_CHAN_MC_TAIL_OFFSET) // tail index
    a.load(2, 0, RT_CHAN_MC_ELEM_SLOTS_OFFSET) // elem_slots
    a.mul(3, 1, 2)
    a.shl_imm(3, 3, 3)
    a.load(4, 0, RT_CHAN_MC_BUFFER_OFFSET)
    a.add(3, 4, 3)
    a.store(15, -16, 3)
    a.load(1, 15, -40)
    a.load(2, 1, RT_WN_BUFFER_OFFSET)
    a.store(15, -32, 2)
    a.vm_mov_imm(1, 0)
    a.label("_rt_ctr_mc_promote_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_ctr_mc_promote_copied")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    if a.has_int64_pairs() { a.load(5, 3, 4) }
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    if a.has_int64_pairs() { a.store(3, 4, 5) }
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_ctr_mc_promote_copy")
    a.label("_rt_ctr_mc_promote_copied")
    a.load(0, 15, -8)
    a.load(1, 0, RT_CHAN_MC_TAIL_OFFSET)
    a.vm_add_imm(1, 1, 1)
    a.load(2, 0, RT_CHAN_MC_CAPACITY_OFFSET)
    a.cmp(1, 2)
    a.jlt("_rt_ctr_mc_promote_tail_ok")
    a.vm_mov_imm(1, 0)
    a.label("_rt_ctr_mc_promote_tail_ok")
    a.store(0, RT_CHAN_MC_TAIL_OFFSET, 1)
    a.load(1, 0, RT_CHAN_MC_LENGTH_OFFSET)
    a.vm_add_imm(1, 1, 1)
    a.store(0, RT_CHAN_MC_LENGTH_OFFSET, 1)
    a.load(1, 15, -40)
    a.vm_mov_imm(2, RT_WN_SERVED)
    a.vm_add_imm(3, 1, RT_WN_DONE_OFFSET)
    a.vm_atomic_store(3, 2) // done = SERVED (release)
    a.load(2, 1, 0)
    a.store(0, RT_CHAN_MC_WAIT_HEAD_OFFSET, 2)
    a.vm_cbnz(2, "_rt_ctr_mc_promote_pop_keep")
    a.vm_mov_imm(2, 0)
    a.store(0, RT_CHAN_MC_WAIT_TAIL_OFFSET, 2)
    a.label("_rt_ctr_mc_promote_pop_keep")
    a.load(18, 1, RT_WN_G_OFFSET)
    a.call("_rt_ready")
    a.load(0, 15, -8)
    a.label("_rt_ctr_mc_promote_skip")
    rt_mc_signal_if_waiters(a, RT_CHAN_MC_SEND_CV_OFFSET)
    rt_mc_unlock(a)
    a.vm_mov_imm(14, 1)
    a.epilogue()
    a.label("_rt_ctr_mc_empty")
    a.load(1, 0, RT_CHAN_MC_CLOSED_OFFSET)
    a.vm_cbnz(1, "_rt_ctr_mc_zero")
    rt_mc_unlock(a)
    a.vm_mov_imm(14, 0)
    a.epilogue()
    a.label("_rt_ctr_mc_zero")
    a.vm_mov_imm(1, 0)
    a.label("_rt_ctr_mc_zloop")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_ctr_mc_zdone")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.vm_mov_imm(4, 0)
    a.store(3, 0, 4)
    if a.has_int64_pairs() { a.store(3, 4, 4) }
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_ctr_mc_zloop")
    a.label("_rt_ctr_mc_zdone")
    rt_mc_unlock(a)
    a.vm_mov_imm(14, 2)
    a.epilogue()
    <<
}
