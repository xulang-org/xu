@main

// Runtime emission constants shared by helper code and its data reservations.
// Sizes are bytes unless the name says slots, classes or capacity. Keep
// independent policies separate even when their current values are equal.
// Xu const initializers are literals; derive dependent sizes at use sites.

// Tunable allocation/reuse policies. Ledger slots must be a power of two;
// its mask and emitted storage are derived from this one count.
const gen1_heap_ledger_slots = 262144
const rt_heap_chunk_bytes = 65536
const gen1_medium_first_class = 128 // number of small allocation classes
const gen1_medium_class_count = 5  // page-sized payloads, doubled per class
const gen1_medium_keep = 4         // retained mappings per medium class
const rt_array_min_capacity = 8

// Allocator layout: small payloads are 16-byte classes; dedicated mappings
// use 4 KiB rounding. Change the shifts together with the allocator ABI.
const rt_heap_small_class_shift = 4
const rt_heap_ledger_entry_shift = 4 // pointer + size/tombstone, 16 bytes
const rt_heap_page_shift = 12
const rt_heap_small_header_bytes = 8 // class word immediately before payload
const rt_heap_large_header_bytes = 16
const rt_heap_freed_class = 254
const rt_heap_large_class = 255
const rt_min_heap_pointer = 4096 // reject null/low sentinel pointers

// Scheduler policies. Queue storage and wrap checks share the capacity;
// stack allocation, membership checks and initial SP share the stack size.
const rt_xu_queue_capacity = 64
const rt_g_stack_bytes = 131072
const rt_worker_stack_bytes = 1048576
const rt_wn_pool_node_bytes = 64
const rt_wn_pool_capacity = 32

// Scheduler/channel ABI sizes. These include fixed field offsets in the
// corresponding helpers, so layout changes must update those offsets too.
const rt_xu_queue_entry_bytes = 56 // function pointer + six argument words
const rt_g_state_bytes = 256
const rt_chan_header_bytes = 80
const rt_chan_mc_header_bytes = 232
const rt_wn_header_bytes = 32
const rt_wn_mc_header_bytes = 40 // adds the owning coroutine pointer

// Independent IO buffer policies. CWD frame size and metadata slots are
// derived from the buffer size; keep that size a multiple of 16.
const rt_file_read_initial_bytes = 65536
const rt_dir_read_buffer_bytes = 4096
const rt_cwd_buffer_bytes = 4096

// Cooperative channel fields (byte offsets from the channel pointer).
const rt_chan_lock_offset = 0
const rt_chan_elem_slots_offset = 8
const rt_chan_capacity_offset = 16
const rt_chan_length_offset = 24
const rt_chan_head_offset = 32
const rt_chan_tail_offset = 40
const rt_chan_buffer_offset = 48
const rt_chan_closed_offset = 56
const rt_chan_wait_head_offset = 64
const rt_chan_wait_tail_offset = 72

// M:N channel fields. OS synchronization objects occupy the first 160 bytes.
const rt_chan_mc_send_cv_offset = 64
const rt_chan_mc_recv_cv_offset = 112
const rt_chan_mc_elem_slots_offset = 160
const rt_chan_mc_capacity_offset = 168
const rt_chan_mc_length_offset = 176
const rt_chan_mc_head_offset = 184
const rt_chan_mc_tail_offset = 192
const rt_chan_mc_buffer_offset = 200
const rt_chan_mc_closed_offset = 208
const rt_chan_mc_wait_head_offset = 216
const rt_chan_mc_wait_tail_offset = 224

// Shared waiter fields and their tagged states; MC adds G at byte 32.
const rt_wn_kind_offset = 8
const rt_wn_done_offset = 16
const rt_wn_buffer_offset = 24
const rt_wn_g_offset = 32
const rt_wn_kind_send = 1
const rt_wn_kind_recv = 2
const rt_wn_kind_send_detached = 3
const rt_wn_waiting = 0
const rt_wn_served = 1
const rt_wn_closed = 2

// One main M plus worker_limit workers; each M record is 1 << shift bytes.
const rt_worker_limit = 4
const rt_m_record_shift = 8

// Select registration and subscription layouts.
const rt_select_state_bytes = 48
const rt_select_watch_bytes = 16
const rt_select_next_offset = 8
const rt_select_done_offset = 16
const rt_select_reserved_offset = 24
const rt_select_g_offset = 32
const rt_select_cv_offset = 40
const rt_select_watch_channel_offset = 8

// Separate policies/OS flags: equal integers need not have equal meanings.
const rt_readlink_buffer_bytes = 4096
const rt_iface_config_buffer_bytes = 4096
const rt_iface_multicast_flag = 4096
const rt_win_generic_read = 2147483648
const rt_win_generic_write = 1073741824
