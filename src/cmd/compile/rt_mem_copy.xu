@main

// Inline, forward copy of exactly n bytes. Callers validate spans and choose
// four distinct virtual registers. Only src/dst/n/tmp and caller-saved q0/q1
// are clobbered; no call or stack slot is introduced. Zero skips every load.
// Sources and destinations may be unaligned on arm64/x64. Other targets use
// word loads only when both pointers are aligned, otherwise bounded bytes.
fn rt_emit_copy_bytes(a &mut Assembler, tag string, src int, dst int, n int, tmp int) {
    a.vm_cbz(n, "_rt_cp_done_" + tag)
    if a.arch == 0 {
        a.label("_rt_cp_q_" + tag)
        a.vm_cmp_imm(n, 32)
        a.jlt("_rt_cp_word_" + tag)
        a.be_neon_ldp_q_post32(0, 1, src)
        a.be_neon_stp_q_post32(0, 1, dst)
        a.vm_sub_imm(n, n, 32)
        a.jmp("_rt_cp_q_" + tag)
    }
    mut word := 8
    if a.arch == 2 || a.arch == 3 { word = 4 }
    if a.arch != 0 && a.arch != 1 {
        a.ior(tmp, src, dst)
        a.vm_and_imm(tmp, tmp, word - 1)
        a.vm_cbnz(tmp, "_rt_cp_byte_" + tag)
    }
    a.label("_rt_cp_word_" + tag)
    a.vm_cmp_imm(n, word)
    a.jlt("_rt_cp_byte_" + tag)
    a.load(tmp, src, 0)
    a.store(dst, 0, tmp)
    a.vm_add_imm(src, src, word)
    a.vm_add_imm(dst, dst, word)
    a.vm_sub_imm(n, n, word)
    a.jmp("_rt_cp_word_" + tag)
    a.label("_rt_cp_byte_" + tag)
    a.vm_cbz(n, "_rt_cp_done_" + tag)
    a.load_byte(tmp, src, 0)
    a.store_byte(dst, 0, tmp)
    a.vm_add_imm(src, src, 1)
    a.vm_add_imm(dst, dst, 1)
    a.vm_sub_imm(n, n, 1)
    a.jmp("_rt_cp_byte_" + tag)
    a.label("_rt_cp_done_" + tag)
}
