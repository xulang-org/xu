@main

// Inline, forward copy of exactly n bytes. Callers validate spans and choose
// four distinct virtual registers. Only src/dst/n/tmp and caller-saved q0/q1
// are clobbered; no call or stack slot is introduced. Zero skips every load.
// Sources and destinations may be unaligned on arm64/x64. Other targets use
// word loads only when both pointers are aligned, otherwise bounded bytes.
fn rt_emit_copy_bytes(a $&Assembler, tag string, src int, dst int, n int, tmp int) {
    if a.arch == 7 {
        // a10/a11 may themselves hold dst/n. Even cmp-immediate uses one
        // as an implicit scratch, so compare against the explicit tmp=0.
        // This bounded byte loop touches only the four declared operands,
        // requires no alignment, and remains interruptible throughout.
        a.vm_mov_imm(tmp, 0)
        a.cmp(n, tmp)
        a.jeq("_rt_cp_done_" + tag)
        a.label("_rt_cp_byte_" + tag)
        a.load_byte(tmp, src, 0)
        a.store_byte(dst, 0, tmp)
        a.vm_add_imm(src, src, 1)
        a.vm_add_imm(dst, dst, 1)
        a.vm_sub_imm(n, n, 1)
        a.vm_mov_imm(tmp, 0)
        a.cmp(n, tmp)
        a.jne("_rt_cp_byte_" + tag)
        a.label("_rt_cp_done_" + tag)
        <<
    }
    a.vm_cbz(n, "_rt_cp_done_" + tag)
    if a.arch == 0 {
        a.label("_rt_cp_q_" + tag)
        a.vm_cmp_imm(n, 32)
        a.jlt("_rt_cp_word_" + tag)
        a.be_neon_ldp_q_post32(0, 1, src)
        a.be_neon_stp_q_post32(0, 1, dst)
        a.vm_sub_imm(n, n, 32)
        a.jmp("_rt_cp_q_" + tag)
    }
    if a.arch == 1 {
        a.label("_rt_cp_x64_q_" + tag)
        a.vm_cmp_imm(n, 32)
        a.jlt("_rt_cp_word_" + tag)
        a.xbe_movdqu_load(0, src, 0)
        a.xbe_movdqu_load(1, src, 16)
        a.xbe_movdqu_store(dst, 0, 0)
        a.xbe_movdqu_store(dst, 16, 1)
        a.vm_add_imm(src, src, 32)
        a.vm_add_imm(dst, dst, 32)
        a.vm_sub_imm(n, n, 32)
        a.jmp("_rt_cp_x64_q_" + tag)
    }
    $word := 8
    if a.arch == 2 || a.arch == 3 || a.arch == 7 { word = 4 }
    if a.arch != 0 && a.arch != 1 {
        a.ior(tmp, src, dst)
        a.vm_and_imm(tmp, tmp, word - 1)
        a.vm_cbnz(tmp, "_rt_cp_byte_" + tag)
    }
    a.label("_rt_cp_word_" + tag)
    a.vm_cmp_imm(n, word)
    a.jlt("_rt_cp_byte_" + tag)
    a.load(tmp, src, 0)
    a.store(dst, 0, tmp)
    a.vm_add_imm(src, src, word)
    a.vm_add_imm(dst, dst, word)
    a.vm_sub_imm(n, n, word)
    a.jmp("_rt_cp_word_" + tag)
    a.label("_rt_cp_byte_" + tag)
    a.vm_cbz(n, "_rt_cp_done_" + tag)
    a.load_byte(tmp, src, 0)
    a.store_byte(dst, 0, tmp)
    a.vm_add_imm(src, src, 1)
    a.vm_add_imm(dst, dst, 1)
    a.vm_sub_imm(n, n, 1)
    a.jmp("_rt_cp_byte_" + tag)
    a.label("_rt_cp_done_" + tag)
}
