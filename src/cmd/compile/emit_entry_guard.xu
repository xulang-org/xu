@main

#xu/types

struct X64GuardValue {
    kind int
    value int
}

struct X64EntryGuard {
    body int
    param int
    bound int
    cond int
    result X64GuardValue
}

fn x64_entry_guard_none() X64EntryGuard {
    << X64EntryGuard{body: -1, param: -1, bound: 0, cond: 0, result: X64GuardValue{kind: -1, value: 0}}
}

fn x64_guard_constant(m &types.Mir, fi int, value int) X64GuardValue {
    fail := X64GuardValue{kind: -1, value: 0}
    if value > -2 { << fail }
    ci := 0 - (value + 2)
    if ci < 0 || ci >= types.mir_nconsts(m, fi) { << fail }
    << X64GuardValue{kind: 0, value: types.mir_const_at(m, fi, ci)}
}

// The early edge has no calls, stores, drops or allocations. Its result is
// either a constant or an incoming scalar parameter, before any frame exists.
fn x64_guard_return(m &types.Mir, fi int, bi int) X64GuardValue {
    fail := X64GuardValue{kind: -1, value: 0}
    if bi < 0 || bi >= types.mir_nblocks(m, fi) || types.mir_btkind(m, fi, bi) != 3 { << fail }
    result := types.mir_bta(m, fi, bi)
    ii := types.mir_bhead(m, fi, bi)
    if ii < 0 { << x64_guard_constant(m, fi, result) }
    if types.mir_inext(m, fi, ii) >= 0 || types.mir_ia(m, fi, ii) != result { << fail }
    if result < 0 || result >= types.mir_ntemps(m, fi) || types.mir_temp_ty(m, fi, result) != 1 || types.mir_temp_nslots(m, fi, result) != 1 { << fail }
    if types.mir_ikind(m, fi, ii) == 1 { << x64_guard_constant(m, fi, types.mir_ib(m, fi, ii)) }
    if types.mir_ikind(m, fi, ii) != 2 { << fail }
    param := types.mir_ib(m, fi, ii)
    if param < 0 || param >= types.mir_fn_nparams(m, fi) { << fail }
    << X64GuardValue{kind: 1, value: param}
}

// Skipping the entry block must not skip a value needed by the framed body.
// Use canonical operand roles, including argument chains, address uses and
// successor terminators. Fixed homes keep predecessor cache state out of it.
fn x64_guard_entry_values_dead(m &types.Mir, fi int, loaded int, condition int) bool {
    for bi in 1:types.mir_nblocks(m, fi) {
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            if types.mir_instr_uses_temp_m(m, fi, ii, loaded) || types.mir_instr_uses_temp_m(m, fi, ii, condition) { << false }
            ii = types.mir_inext(m, fi, ii)
        }
        tk := types.mir_btkind(m, fi, bi)
        if tk == 2 || tk == 3 {
            value := types.mir_bta(m, fi, bi)
            if value == loaded || value == condition { << false }
        }
    }
    << true
}

fn match_x64_entry_guard(a &Assembler, m &types.Mir, fi int, fixed bool) X64EntryGuard {
    fail := x64_entry_guard_none()
    if a.arch != 1 || a.ra_level < 1 || a.cover || a.lib != 0 || !fixed { << fail }
    if types.mir_fn_is_extern(m, fi) || types.mir_fn_ret(m, fi) != 1 || types.mir_fn_ret_nslots(m, fi) != 1 { << fail }
    np := types.mir_fn_nparams(m, fi)
    if np < 1 || np > 6 || types.mir_nblocks(m, fi) < 2 || types.mir_nblocks(m, fi) > 64 || types.mir_nins(m, fi) > 2048 { << fail }
    for p in 0:np {
        if types.mir_local_ty(m, fi, p) != 1 || types.mir_local_nslots(m, fi, p) != 1 { << fail }
    }
    if types.mir_btkind(m, fi, 0) != 2 { << fail }
    load := types.mir_bhead(m, fi, 0)
    if load < 0 || types.mir_ikind(m, fi, load) != 2 { << fail }
    param := types.mir_ib(m, fi, load)
    loaded := types.mir_ia(m, fi, load)
    if param < 0 || param >= np || loaded < 0 || loaded >= types.mir_ntemps(m, fi) { << fail }
    if types.mir_temp_ty(m, fi, loaded) != 1 || types.mir_temp_nslots(m, fi, loaded) != 1 { << fail }
    cmp := types.mir_inext(m, fi, load)
    if cmp < 0 || types.mir_ikind(m, fi, cmp) != 4 || types.mir_inext(m, fi, cmp) >= 0 { << fail }
    condition := types.mir_ia(m, fi, cmp)
    if condition != types.mir_bta(m, fi, 0) || condition < 0 || condition >= types.mir_ntemps(m, fi) { << fail }
    if types.mir_temp_ty(m, fi, condition) != 2 || types.mir_temp_nslots(m, fi, condition) != 1 { << fail }
    mut op := types.mir_ib(m, fi, cmp)
    if op < 6 || op > 11 { << fail }
    mut constant := types.mir_id(m, fi, cmp)
    if types.mir_ic(m, fi, cmp) != loaded {
        if constant != loaded { << fail }
        constant = types.mir_ic(m, fi, cmp)
        if op == 8 { op = 10 } else if op == 10 { op = 8 }
        else if op == 9 { op = 11 } else if op == 11 { op = 9 }
    }
    bound := x64_guard_constant(m, fi, constant)
    if bound.kind != 0 || bound.value < -2147483648 || bound.value > 2147483647 { << fail }
    if !x64_guard_entry_values_dead(m, fi, loaded, condition) { << fail }
    yes := types.mir_btb(m, fi, 0)
    no := types.mir_btc(m, fi, 0)
    mut result := x64_guard_return(m, fi, yes)
    mut body := no
    mut cond := bin_cond(op)
    if result.kind < 0 {
        result = x64_guard_return(m, fi, no)
        body = yes
        cond = invert_cc(cond)
    }
    if result.kind < 0 || body < 0 || body >= types.mir_nblocks(m, fi) { << fail }
    << X64EntryGuard{body: body, param: param, bound: bound.value, cond: cond, result: result}
}

fn emit_x64_entry_guard(a &mut Assembler, m &types.Mir, fi int, guard &X64EntryGuard) {
    if guard.body < 0 { << }
    // Keep Windows indirect-call targets CET compatible. The ordinary
    // prologue retains its existing marker for the framed path as well.
    if a.os == 2 { a.x64_endbr() }
    normal := types.mir_fn_label(m, fi) + ".guard_frame"
    a.vm_cmp_imm(arg_reg(guard.param), guard.bound)
    a.x64_jcc(x64_cc(invert_cc(guard.cond)), normal + "")
    if guard.result.kind == 1 {
        a.mov(14, arg_reg(guard.result.value))
    } else {
        a.vm_mov_imm64(14, guard.result.value)
    }
    a.vm_ret()
    a.label(normal + "")
}
