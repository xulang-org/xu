@main

#xu/types

// TargetDesc: read-only register-class and capability queries.
// Physical FP numbers are ISA D/XMM/F indices. Integer homes stay the
// existing VM V/S numbering (V2–V7, S0–S5).
//
// ARM64 caller-saved FP used as fixed homes:
//   home 32..37 -> d2..d7
//   home 38..53 -> d16..d31
// d0/d1 remain operand scratch. d8–d15 are callee-saved and are not
// allocated here (saving them on a hot callee was slower than spilling).
//
// x64 keeps xmm2..xmm5 (homes 32..35) so Win64 xmm6+ nonvolatiles stay
// untouched until an OS-specific mask exists.

fn td_has_vreg(arch int) bool {
    << arch == 0 || arch == 1
}

fn td_has_hw_fsqrt(arch int) bool {
    << arch == 0 || arch == 1 || arch == 4
}

fn td_gpr_caller_lo(arch int) int {
    << 2
}

fn td_gpr_caller_hi(arch int) int {
    if arch == 0 {
        << 8
    }
    if arch == 1 {
        << 6
    }
    << 2
}

fn td_gpr_callee_lo(arch int) int {
    if arch == 0 {
        << 8
    }
    << 2
}

fn td_gpr_callee_hi(arch int) int {
    if arch == 0 {
        << 14
    }
    if arch == 1 {
        << 6
    }
    << 2
}

fn td_fp_home_lo() int {
    << 32
}

fn td_fp_home_hi(arch int) int {
    if arch == 0 {
        << 54
    }
    if arch == 1 {
        << 38
    }
    << 32
}

fn td_fp_phys(home int) int {
    if home >= 32 && home <= 37 {
        << home - 30
    }
    if home >= 38 && home <= 53 {
        << home - 22
    }
    << -1
}

fn td_fp_home_in_range(arch int, home int) bool {
    << home >= td_fp_home_lo() && home < td_fp_home_hi(arch)
}

fn td_fp_slot_ok(slot int) bool {
    // fp_vreg_slot(home) = -200 - home; homes 32..53 → slots -232..-253.
    << slot <= -232 && slot >= -253
}

fn td_internal_gate() bool {
    if td_fp_phys(32) != 2 { << false }
    if td_fp_phys(37) != 7 { << false }
    if td_fp_phys(38) != 16 { << false }
    if td_fp_phys(53) != 31 { << false }
    if td_fp_phys(31) != -1 { << false }
    if td_fp_home_hi(0) != 54 { << false }
    if td_fp_home_hi(1) != 38 { << false }
    if !td_has_vreg(0) || !td_has_vreg(1) { << false }
    if td_has_vreg(4) { << false }
    if !regplan_internal_gate() { << false }
    << true
}
