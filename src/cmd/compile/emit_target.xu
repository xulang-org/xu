@main

#xu/types

// TargetDesc: read-only register-class and capability queries.
// Physical FP numbers are ISA D/XMM/F indices. Integer homes stay the
// existing VM V/S numbering (V2–V7, S0–S5).
//
// ARM64 caller-saved FP used as fixed homes:
//   home 32..37 -> d2..d7
//   home 38..53 -> d16..d31
// d0/d1 remain operand scratch. d8–d15 are callee-saved and are not
// allocated here (saving them on a hot callee was slower than spilling).
//
// x64 keeps xmm2..xmm5 (homes 32..35) so Win64 xmm6+ nonvolatiles stay
// untouched until an OS-specific mask exists.

fn td_has_vreg(arch int) bool {
    << arch == 0 || arch == 1 || arch == 2
}

fn td_has_hw_fsqrt(arch int) bool {
    << arch == 0 || arch == 1 || arch == 4
}

fn td_gpr_caller_lo(arch int) int {
    << 2
}

fn td_gpr_caller_hi(arch int) int {
    if arch == 0 || arch == 2 {
        << 8
    }
    if arch == 1 {
        << 6
    }
    << 2
}

fn td_gpr_callee_lo(arch int) int {
    if arch == 0 {
        << 8
    }
    if arch == 2 {
        << 3
    }
    << 2
}

fn td_gpr_callee_hi(arch int) int {
    if arch == 0 {
        << 14
    }
    if arch == 1 {
        << 6
    }
    if arch == 2 {
        << 8
    }
    << 2
}

// Physical Thumb-2 register mapping for VM virtual registers.
// V0=r12, V1=r3 (operand scratch); V2=r2 (caller-saved vreg);
// V3=r6, V4=r4, V5=r5, V6=r8, V7=r9 (callee-saved vregs, low r4-r6 first).
fn td_thumb_phys(v int) int {
    if v == 0 { << 12 } // V0 = r12
    if v == 1 { << 3 }  // V1 = r3
    if v == 2 { << 2 }  // V2 = r2
    if v == 3 { << 6 }  // V3 = r6
    if v == 4 { << 4 }  // V4 = r4
    if v == 5 { << 5 }  // V5 = r5
    if v == 6 { << 8 }  // V6 = r8
    if v == 7 { << 9 }  // V7 = r9
    if v == 8 { << 8 }  // S0 = r8
    if v == 9 { << 9 }  // S1 = r9
    if v == 10 { << 4 } // S2 = r4
    if v == 11 { << 5 } // S3 = r5
    if v == 12 { << 1 } // S4 = r1
    if v == 13 { << 8 } // S5 = r8
    if v == 14 { << 0 } // Ret = r0
    if v == 15 { << 7 } // Fp = r7
    if v == 16 { << 13 } // Sp
    if v == 17 { << 14 } // Lr
    if v == 18 { << 0 } // A0 = r0
    if v == 19 { << 1 } // A1 = r1
    if v == 20 { << 2 } // A2 = r2
    if v == 21 { << 3 } // A3 = r3
    if v == 22 { << 10 } // A4 = r10
    if v == 23 { << 11 } // A5 = r11
    eprintln("E1: unknown vreg")
    <<< 1
    << 0
}

fn thumb_cs_count(mask int) int {
    mut n := 0
    for r in 0:12 {
        if (mask & (1 << r)) != 0 { n += 1 }
    }
    << n
}

fn thumb_cs_normalize(mask int) int {
    mut m := mask & 0x0F70
    if (m & 0x0F00) != 0 && thumb_cs_count(m) < 2 {
        m = m | 0x0010
    }
    << m
}

fn thumb_cs_encode(mask int) int {
    << 65536 | thumb_cs_normalize(mask)
}

fn thumb_cs_effective(cs int) int {
    if (cs & 65536) == 0 {
        << 0x0170
    }
    << thumb_cs_normalize(cs & 0x0F70)
}

// Hosted coroutine entry checks carry the current G in one callee-saved
// register. Keep that physical home out of the fixed vreg coloring pool so a
// normal optimized function cannot overwrite it between calls.
fn td_stack_holder_home(arch int) int {
    if arch == 0 { << 8 }  // ARM64 S0 / x19
    if arch == 1 { << 9 }  // x64 R15 / S1
    << -1
}

fn td_fp_home_lo() int {
    << 32
}

fn td_fp_home_hi(arch int) int {
    if arch == 0 {
        << 54
    }
    if arch == 1 {
        << 38
    }
    << 32
}

fn td_fp_phys(home int) int {
    if home >= 32 && home <= 37 {
        << home - 30
    }
    if home >= 38 && home <= 53 {
        << home - 22
    }
    << -1
}

fn td_fp_home_in_range(arch int, home int) bool {
    << home >= td_fp_home_lo() && home < td_fp_home_hi(arch)
}

fn td_fp_slot_ok(slot int) bool {
    // fp_vreg_slot(home) = -200 - home; homes 32..53 → slots -232..-253.
    << slot <= -232 && slot >= -253
}

fn td_internal_gate() bool {
    if td_fp_phys(32) != 2 { << false }
    if td_fp_phys(37) != 7 { << false }
    if td_fp_phys(38) != 16 { << false }
    if td_fp_phys(53) != 31 { << false }
    if td_fp_phys(31) != -1 { << false }
    if td_fp_home_hi(0) != 54 { << false }
    if td_fp_home_hi(1) != 38 { << false }
    if !td_has_vreg(0) || !td_has_vreg(1) || !td_has_vreg(2) { << false }
    if td_has_vreg(4) { << false }
    if td_thumb_phys(3) != 6 || td_thumb_phys(4) != 4 || td_thumb_phys(5) != 5 { << false }
    if !regplan_internal_gate() { << false }
    << true
}
