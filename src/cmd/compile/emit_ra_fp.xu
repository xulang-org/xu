@main

#xu/types

// f64 / SIMD homes. Split from emit_frame.xu.
// ARM64: d2–d7 + d16–d31 (caller-saved, no extra prologue).
// x64: xmm2–xmm7 only (xmm16+ does not exist in baseline SSE).

fn rc_kill_fp_alias(a &mut Assembler, slot int) {
    if slot < 0 {
        <<
    }
    nh := rc_fp_homes()
    for p in 0:nh {
        // Temp aliases attached to a pinned loop-carried home survive local
        // dead-temp cleanup; scratch homes remain eligible for ordinary cleanup.
        if a.rc_fp_pin[p] < 0 {
            if a.rc_fp_alias[p] == slot {
                a.rc_fp_alias[p] = -1
            }
            if a.rc_fp_alias2[p] == slot {
                a.rc_fp_alias2[p] = -1
            }
        }
    }
    <<
}

// After an FP consumer, free SIMD homes held by temps with no further uses
// (nbody: xi/xj aliases block yi/yj LoadPtr until flushed).
fn rc_fp_kill_dead_temp(a &mut Assembler, m &types.Mir, fi int, fr &Frame, t int, from_ii int) {
    if t < 0 || from_ii < 0 {
        <<
    }
    if t >= fr.temp_slot.len || fr.temp_slot[t] < 0 {
        <<
    }
    if mir_temp_uses_from(m, fi, t, from_ii) == 0 {
        rc_kill_fp_alias(a, fr.temp_slot[t])
    }
    <<
}

fn rc_fp_on(a &Assembler) bool {
    << (a.rc_on || a.rc_fp_only) && (a.arch == 0 || a.arch == 1)
}

// Admit only a very narrow FP-only loop shape. This is deliberately MIR-based:
// one f64 local is both loaded and stored in a single-block self-loop, with no
// second carried f64 local or hot call. Multi-block loops need whole-CFG fixed
// homes: a hot-edge marker alone does not prove that every predecessor has
// written the frame copy before a block-entry reload.
fn f64_loop_fp_only_admit(m &types.Mir, fi int) bool {
    mut hot := natural_loop_hot_blocks(m, fi)
    f64_loop_fp_only_mark_self_hot(m, fi, mut &hot)
    mut hot_count := 0
    for bi in 0:hot.len {
        if hot[bi] <= 0 { -> }
        hot_count += 1
        tk := types.mir_btkind(m, fi, bi)
        mut self_edge := false
        if tk == 1 && types.mir_bta(m, fi, bi) == bi { self_edge = true }
        if tk == 2 && (types.mir_btb(m, fi, bi) == bi || types.mir_btc(m, fi, bi) == bi) { self_edge = true }
        if !self_edge { << false }
    }
    if hot_count != 1 {
        << false
    }
    mut cand := -1
    mut hot_pair := false
    mut loop_load := false
    mut loop_store := false
    mut seen_load := []int{}
    for _ in 0:types.mir_nlocals(m, fi) { seen_load.push(0) }
    for ii in 0:types.mir_nins(m, fi) {
        ik := types.mir_ikind(m, fi, ii)
        if ik == types.MI_CALL {
            // Calls outside the admitted natural loop do not invalidate the
            // loop-carried FP home. Only reject a call that is actually in a
            // hot block, where d2-d7 would need a call-safe spill boundary.
            mut call_hot := false
            for bi in 0:types.mir_nblocks(m, fi) {
                if bi >= hot.len || hot[bi] <= 0 { -> }
                mut xi := types.mir_bhead(m, fi, bi)
                for _ in 0:types.mir_nins(m, fi) {
                    if xi < 0 { <- }
                    if xi == ii { call_hot = true }
                    xi = types.mir_inext(m, fi, xi)
                }
            }
            if call_hot {
                << false
            }
        }
        if ik != types.MI_LOAD_LOCAL && ik != types.MI_STORE_LOCAL {
            ->
        }
        mut loc := types.mir_ib(m, fi, ii)
        if ik == types.MI_STORE_LOCAL {
            loc = types.mir_ia(m, fi, ii)
        }
        if loc < 0 || loc >= types.mir_nlocals(m, fi) || types.mir_local_ty(m, fi, loc) != 4 {
            ->
        }
        if ik == types.MI_LOAD_LOCAL {
            seen_load[loc] = 1
            ->
        }
        // A loop-carried local is distinguished from an ephemeral f64 temp:
        // the carried value is loaded before its next StoreLocal. Conversions
        // such as f64(i & 1023) have StoreLocal -> LoadLocal within one trip
        // and must not disqualify the real accumulator.
        if seen_load[loc] == 1 {
            if cand < 0 {
                cand = loc
            } else if cand != loc {
                << false
            }
        }
    }
    if cand < 0 {
        << false
    }
    // The residency is only admitted when the natural loop itself contains
    // both the load and store of the same f64 local.
    nblk := types.mir_nblocks(m, fi)
    for bi in 0:nblk {
        if bi >= hot.len || hot[bi] <= 0 { -> }
        mut ii := types.mir_bhead(m, fi, bi)
        mut blk_load := false
        mut blk_store := false
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            ik := types.mir_ikind(m, fi, ii)
            if ik == types.MI_LOAD_LOCAL && types.mir_ib(m, fi, ii) == cand { blk_load = true }
            if ik == types.MI_STORE_LOCAL && types.mir_ia(m, fi, ii) == cand { blk_store = true }
            ii = types.mir_inext(m, fi, ii)
        }
        if blk_load { loop_load = true }
        if blk_store { loop_store = true }
    }
    hot_pair = loop_load && loop_store
    << hot_pair
}

// The generic natural-loop analysis intentionally excludes single-block self-loops.
// FP-only admission may still prove one such loop safe, so expose only the matching
// self-loop block to the FP residency pass without changing GPR loop analysis.
fn f64_loop_fp_only_mark_self_hot(m &types.Mir, fi int, hot &mut []int) {
    nblk := types.mir_nblocks(m, fi)
    if hot.len < nblk {
        <<
    }
    for bi in 0:nblk {
        tk := types.mir_btkind(m, fi, bi)
        mut self_loop := false
        if tk == 1 && types.mir_bta(m, fi, bi) == bi {
            self_loop = true
        }
        if tk == 2 && (types.mir_btb(m, fi, bi) == bi || types.mir_btc(m, fi, bi) == bi) {
            self_loop = true
        }
        if !self_loop {
            ->
        }
        mut saw_load := false
        mut saw_store := false
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 {
                <-
            }
            ik := types.mir_ikind(m, fi, ii)
            mut loc := -1
            if ik == types.MI_LOAD_LOCAL {
                loc = types.mir_ib(m, fi, ii)
            } else if ik == types.MI_STORE_LOCAL {
                loc = types.mir_ia(m, fi, ii)
            }
            if loc >= 0 && loc < types.mir_nlocals(m, fi) && types.mir_local_ty(m, fi, loc) == 4 {
                if ik == types.MI_LOAD_LOCAL { saw_load = true }
                if ik == types.MI_STORE_LOCAL { saw_store = true }
            }
            ii = types.mir_inext(m, fi, ii)
        }
        if saw_load && saw_store {
            hot[bi] = 1
        }
    }
    <<
}

fn rc_fp_consume_skip(a &mut Assembler, ii int) bool {
    if a.rc_fp_skip != ii {
        << false
    }
    a.rc_fp_skip = a.rc_fp_skip2
    a.rc_fp_skip2 = a.rc_fp_skip3
    a.rc_fp_skip3 = a.rc_fp_skip4
    a.rc_fp_skip4 = -1
    << true
}

// Hosted f64 SIMD homes. Array length is the ARM64 pool (22).
// p=0..5 → d2–d7 / xmm2–xmm7; p=6..21 → d16–d31 (ARM64 only).
// d0/d1 stay operand scratch. d8–d15 stay callee-saved and are not claimed.
// No extra helper fns here: Gen1 intern hangs / miscompiles when this
// file grows a new nfn while compiling src/.
fn rc_fp_homes() int {
    // ARM64 RC adapter width: d2–d7 + d16–d31. Must stay equal to
    // `td_fp_home_hi(0) - td_fp_home_lo()`; do not call TargetDesc here
    // (hosted compile of this helper SIGSEGV'd).
    << 22
}

fn rc_fp_d(p int) int {
    if p < 6 {
        << 2 + p
    }
    << 10 + p
}

fn fixed_fp_temp_d(fr &Frame, t int) int {
    if t < 0 || t >= fr.temp_slot.len {
        << -1
    }
    slot := fr.temp_slot[t]
    if !is_fp_vreg_slot(slot) {
        << -1
    }
    << fp_vreg_slot_d(slot)
}

// Shared scalar call-point actions, captured before argument preparation and
// restored after committing the distinct call result. `fp_split` retains its
// historical field name so the Frame layout does not change across self-host.
fn emit_vreg_call_fp_splits(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int, reload bool) {
    n := types.mir_ntemps(m, fi)
    mut action := 0
    while action < n {
        t := frame_call_fp_split_temp_at(fr, n, ii, action)
        if t < 0 { <- }
        backup := fr.fp_split[t]
        slot := fr.temp_slot[t]
        if backup < 0 { eprintln("internal compiler error: invalid scalar call-split emission")
            <<< 1 }
        if is_fp_vreg_slot(slot) {
            fd := fixed_fp_temp_d(fr, t)
            if fd < 0 { eprintln("internal compiler error: invalid FP call-split emission")
                <<< 1 }
            if reload { a.be_fload(fd, 15, slot_off(backup)) }
            else { a.be_fstore(15, slot_off(backup), fd) }
        } else if is_vreg_slot(slot) {
            home := vreg_slot_home(slot)
            if (a.arch != 0 && a.arch != 1 && a.arch != 2) || !td_home_clobbered_by_call(a.arch, home) {
                eprintln("internal compiler error: invalid GPR call-split emission")
                <<< 1
            }
            if reload { a.load(home, 15, slot_off(backup)) }
            else { a.store(15, slot_off(backup), home) }
        } else { eprintln("internal compiler error: invalid scalar call-split home")
            <<< 1 }
        action += 1
    }
}

fn rc_fp_pick_scratch(a &Assembler) int {
    mut nh := rc_fp_homes()
    if a.arch != 0 {
        nh = 6
    }
    for p in 0:nh {
        if a.rc_fp_inv_ld != 0 && p > 14 && p < 21 {
            ->
        }
        if a.rc_fp_pin[p] < 0 && a.rc_fp_alias[p] < 0 {
            << p
        }
    }
    // Prefer already-synced aliases (cheap to reuse) over dirty ones.
    for p in 0:nh {
        if a.rc_fp_inv_ld != 0 && p > 14 && p < 21 {
            ->
        }
        if a.rc_fp_pin[p] < 0 && a.rc_fp_dirty[p] == 0 {
            << p
        }
    }
    for p in 0:nh {
        if a.rc_fp_inv_ld != 0 && p > 14 && p < 21 {
            ->
        }
        if a.rc_fp_pin[p] < 0 {
            << p
        }
    }
    << -1
}

fn rc_fp_local_has_load(m &types.Mir, fi int, loc int, start_ii int) bool {
    if loc < 0 || start_ii < 0 {
        << false
    }
    mut ii := start_ii
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 {
            <-
        }
        if types.mir_ikind(m, fi, ii) == types.MI_LOAD_LOCAL && types.mir_ib(m, fi, ii) == loc {
            << true
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << false
}

// True when scratch home p still carries a local that will be LoadLocal'd again.
fn rc_fp_home_has_hot_local(a &Assembler, m &types.Mir, fi int, fr &Frame, p int, from_ii int) bool {
    if p < 0 || p >= rc_fp_homes() {
        << false
    }
    for pass in 0:2 {
        mut slot := a.rc_fp_alias[p]
        if pass == 1 {
            slot = a.rc_fp_alias2[p]
        }
        if slot < 0 {
            ->
        }
        mut nloc := types.mir_nlocals(m, fi)
        nslot := fr.local_slot.len
        for loc in 0:nloc {
            if loc >= nslot {
                <-
            }
            if types.mir_local_ty(m, fi, loc) != 4 {
                ->
            }
            if fr.local_slot[loc] == slot {
                if rc_fp_local_has_load(m, fi, loc, from_ii) {
                    << true
                }
            }
        }
    }
    << false
}

// Prefer a scratch that does not hold a still-needed f64 local (nbody mj/mi).
fn rc_fp_pick_scratch_cold(a &Assembler, m &types.Mir, fi int, fr &Frame, from_ii int) int {
    mut nh := rc_fp_homes()
    if a.arch != 0 {
        nh = 6
    }
    for p in 0:nh {
        if a.rc_fp_inv_ld != 0 && p > 14 && p < 21 {
            ->
        }
        if a.rc_fp_pin[p] < 0 && a.rc_fp_alias[p] < 0 {
            << p
        }
    }
    for p in 0:nh {
        if a.rc_fp_inv_ld != 0 && p > 14 && p < 21 {
            ->
        }
        if a.rc_fp_pin[p] < 0 && a.rc_fp_dirty[p] == 0 {
            if !rc_fp_home_has_hot_local(a, m, fi, fr, p, from_ii) {
                << p
            }
        }
    }
    for p in 0:nh {
        if a.rc_fp_inv_ld != 0 && p > 14 && p < 21 {
            ->
        }
        if a.rc_fp_pin[p] < 0 {
            if !rc_fp_home_has_hot_local(a, m, fi, fr, p, from_ii) {
                << p
            }
        }
    }
    // Last resort: any free pin-slot home (caller may ephemeral instead).
    << rc_fp_pick_scratch(a)
}

fn rc_fp_index(a &Assembler, slot int) int {
    if slot < 0 {
        << -1
    }
    nh := rc_fp_homes()
    for p in 0:nh {
        if a.rc_fp_pin[p] == slot {
            << p
        }
    }
    << -1
}

fn rc_fp_index_alias(a &Assembler, slot int) int {
    p := rc_fp_index(a, slot)
    if p >= 0 {
        << p
    }
    nh := rc_fp_homes()
    for q in 0:nh {
        if a.rc_fp_alias[q] == slot && slot >= 0 {
            << q
        }
    }
    for q in 0:nh {
        if a.rc_fp_alias2[q] == slot && slot >= 0 {
            << q
        }
    }
    << -1
}

// After a GPR StoreLocal of an f64 local

fn rc_fp_temp_pinned_d(a &Assembler, m &types.Mir, fi int, fr &Frame, v int) int {
    if !a.rc_fp_only || v < 0 || v >= fr.temp_slot.len {
        << -1
    }
    // Recover the authoritative loop-carried local from MIR when an SSA temp
    // alias was consumed/cleared. This is read-only metadata recovery and does
    // not broaden FP admission.
    for ii in 0:types.mir_nins(m, fi) {
        if types.mir_ikind(m, fi, ii) != types.MI_LOAD_LOCAL || types.mir_ia(m, fi, ii) != v {
            ->
        }
        loc := types.mir_ib(m, fi, ii)
        if loc >= 0 && loc < fr.local_slot.len {
            p := rc_fp_index(a, fr.local_slot[loc])
            if p >= 0 {
                << 2 + p
            }
        }
    }
    << -1
}

// After a GPR StoreLocal of an f64 local, refresh any FP pin so LoadLocal
// pin reuse does not see stale SIMD bits (nbody advance corruption).
fn rc_fp_sync_pin_from_gpr(a &mut Assembler, lo int, src_r int) {
    if !rc_fp_on(&*a) || lo < 0 {
        <<
    }
    p := rc_fp_index(&*a, lo)
    if p < 0 {
        <<
    }
    a.be_fmov_d_from_gpr(rc_fp_d(p), src_r)
    a.rc_fp_dirty[p] = 1
    <<
}

fn rc_fp_set_alias(a &mut Assembler, p int, slot int) {
    a.rc_fp_alias2[p] = a.rc_fp_alias[p]
    a.rc_fp_alias[p] = slot
    <<
}

// Flush scratch home p to park (and stack if real frame slot); SIMD bits stay.
fn rc_fp_flush_scratch(a &mut Assembler, p int) {
    if p < 0 || p >= rc_fp_homes() {
        <<
    }
    // This helper is for scratch homes only. A pinned loop-carried local is
    // authoritative state and must never be evicted by a temporary FP chain.
    if a.rc_fp_pin[p] >= 0 {
        <<
    }
    mut al := a.rc_fp_alias[p]
    if al < 0 {
        al = a.rc_fp_alias2[p]
    }
    if al >= 0 {
        // Prefer SIMD→stack sync. GPR park steals integer homes that hold
        // live pointers (nbody element addresses in x10/x11).
        if is_frame_slot(al) {
            a.be_fstore(15, slot_off(al), rc_fp_d(p))
        } else if a.rc_on {
            a.be_fmov_gpr_from_d(0, rc_fp_d(p))
            // Synth temps (wb/leaf) live only in parks — must park on flush.
            rc_park(a, 0, al)
        }
    }
    a.rc_fp_alias[p] = -1
    a.rc_fp_alias2[p] = -1
    <<
}

// Claim scratch home for new_slot: flush previous live alias if different.
fn rc_fp_claim_scratch(a &mut Assembler, p int, new_slot int) {
    if p < 0 || p >= rc_fp_homes() {
        <<
    }
    al := a.rc_fp_alias[p]
    if al >= 0 && al != new_slot {
        rc_fp_flush_scratch(a, p)
    }
    a.rc_fp_alias2[p] = -1
    a.rc_fp_alias[p] = new_slot
    a.rc_fp_dirty[p] = 1
    <<
}

fn rc_writeback_dirty_fp(a &mut Assembler) {
    if !rc_fp_on(&*a) {
        <<
    }
    nh := rc_fp_homes()
    for p in 0:nh {
        if a.rc_fp_dirty[p] != 1 {
            ->
        }
        mut sl := a.rc_fp_pin[p]
        if sl < 0 {
            sl = a.rc_fp_alias[p]
        }
        if is_frame_slot(sl) {
            a.be_fstore(15, slot_off(sl), rc_fp_d(p))
        }
        a.rc_fp_dirty[p] = 0
    }
    <<
}

fn rc_spill_fp(a &mut Assembler) {
    rc_writeback_dirty_fp(a)
    <<
}

// FP-only collector for the admitted scalar case. Keep this independent from
// the legacy CFG clone/leaf whitelist: admission has already proved one
// loop-carried f64 and the self-loop marker identifies the block that carries it.
fn f64_loop_fp_only_collect_pin(a &mut Assembler, m &types.Mir, fi int) {
    if !a.rc_fp_only {
        <<
    }
    nh := rc_fp_homes()
    if a.rc_fp_blk.len < types.mir_nblocks(m, fi) * nh {
        <<
    }
    mut cand := -1
    mut seen_load := []int{}
    for _ in 0:types.mir_nlocals(m, fi) { seen_load.push(0) }
    for ii in 0:types.mir_nins(m, fi) {
        ik := types.mir_ikind(m, fi, ii)
        if ik == types.MI_LOAD_LOCAL {
            loc := types.mir_ib(m, fi, ii)
            if loc >= 0 && loc < types.mir_nlocals(m, fi) && types.mir_local_ty(m, fi, loc) == 4 {
                seen_load[loc] = 1
            }
        } else if ik == types.MI_STORE_LOCAL {
            loc := types.mir_ia(m, fi, ii)
            if loc >= 0 && loc < types.mir_nlocals(m, fi) && types.mir_local_ty(m, fi, loc) == 4 && seen_load[loc] == 1 {
                if cand < 0 {
                    cand = loc
                } else if cand != loc {
                    <<
                }
            }
        }
    }
    if cand < 0 {
        <<
    }
    for bi in 0:types.mir_nblocks(m, fi) {
        if bi >= a.rc_loop_hot.len || a.rc_loop_hot[bi] <= 0 {
            ->
        }
        a.rc_fp_blk[bi * nh] = cand
        // The other homes remain free for scalar operands/temporaries.
        for p in 1:nh {
            a.rc_fp_blk[bi * nh + p] = -1
        }
    }
    <<
}

fn collect_f64_loop_pins(a &mut Assembler, m &types.Mir, fi int, leaf &[]int, wb &[]int) {
    mut f := types.mir_cfg_clone_fn(m, fi, false)
    nblk := f.blocks.len
    if a.rc_fp_blk.len < nblk * rc_fp_homes() {
        <<
    }
    // Pin the hottest f64 locals; extra homes stay scratch for Field/LoadPtr
    // chains. Scaling max_pin with the full pool spent d16–d31 on once-used
    // StoreLocals and left only 2 scratch — same pressure as 6 homes.
    mut nh_live := rc_fp_homes()
    if a.arch != 0 {
        nh_live = 6
    }
    mut max_pin := 6
    if nh_live < 8 {
        max_pin = nh_live - 2
    }
    if max_pin < 1 {
        max_pin = 1
    }
    for bi in 0:nblk {
        // Hot self-loops are also eligible: FP state can remain live across the
        // backedge even when the older wb/leaf whitelist rejects a memory op.
        // The backedge path itself now preserves FP metadata; keep the f64
        // locals resident instead of forcing a stack round-trip every trip.
        mut hot := false
        if bi < a.rc_loop_hot.len { hot = a.rc_loop_hot[bi] > 0 }
        if leaf[bi] == 0 && wb[bi] == 0 && !hot {
            ->
        }
        // Score StoreLocal f64 locals by later LoadLocal count so nbody prefers
        // `mag`/`dx` over once-used `d2`/`dist` when pin slots are scarce.
        mut cand_loc := []int{}
        mut cand_score := []int{}
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 {
                <-
            }
            if types.mfn_ikind(&f.instrs, ii) == types.MI_STORE_LOCAL {
                loc := types.mfn_ia(&f.instrs, ii)
                if loc >= 0 && loc < f.locals.len {
                    if f.locals[loc] == 4 {
                        mut seen := false
                        for c in 0:cand_loc.len {
                            if cand_loc[c] == loc {
                                seen = true
                            }
                        }
                        if !seen {
                            cand_loc.push(loc)
                            cand_score.push(1)
                        }
                    }
                }
            }
            ii = types.mfn_inext(&f.instrs, ii)
        }
        ii = f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 {
                <-
            }
            if types.mfn_ikind(&f.instrs, ii) == types.MI_LOAD_LOCAL {
                loc := types.mfn_ib(&f.instrs, ii)
                for c in 0:cand_loc.len {
                    if cand_loc[c] == loc {
                        cand_score[c] = cand_score[c] + 1
                    }
                }
            }
            ii = types.mfn_inext(&f.instrs, ii)
        }
        // Insertion by score desc (stable for ties: earlier StoreLocal wins).
        ncand := cand_loc.len
        for c in 1:ncand {
            mut j := c
            while j > 0 {
                if cand_score[j] <= cand_score[j - 1] {
                    <-
                }
                tl := cand_loc[j]
                ts := cand_score[j]
                cand_loc[j] = cand_loc[j - 1]
                cand_score[j] = cand_score[j - 1]
                cand_loc[j - 1] = tl
                cand_score[j - 1] = ts
                j -= 1
            }
        }
        mut nfp := 0
        for c in 0:ncand {
            if nfp >= max_pin {
                <-
            }
            a.rc_fp_blk[bi * rc_fp_homes() + nfp] = cand_loc[c]
            nfp += 1
        }
        // Fill remaining with LoadLocal-only f64 (e.g. `dt`).
        ii = f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 {
                <-
            }
            if types.mfn_ikind(&f.instrs, ii) == types.MI_LOAD_LOCAL {
                loc := types.mfn_ib(&f.instrs, ii)
                if loc >= 0 && loc < f.locals.len {
                    if f.locals[loc] == 4 {
                        mut seen := false
                        for p in 0:nfp {
                            if a.rc_fp_blk[bi * rc_fp_homes() + p] == loc {
                                seen = true
                            }
                        }
                        if !seen && nfp < max_pin {
                            a.rc_fp_blk[bi * rc_fp_homes() + nfp] = loc
                            nfp += 1
                        }
                    }
                }
            }
            ii = types.mfn_inext(&f.instrs, ii)
        }
    }
    <<
}

// The fwd-hot cold-exit stub is emitted after a hot successor and uses the
// assembler's current FP pin metadata when it spills. Runtime may reach that
// stub without executing the hot-edge metadata shuffle, so all hot blocks
// must agree on the physical FP-home layout just like their GPR pins do.
fn fwd_hot_fp_layout_consistent(a &Assembler) bool {
    nblk := a.rc_loop_hot.len
    nh := rc_fp_homes()
    if a.rc_fp_blk.len < nblk * nh { << false }
    mut layout := -1
    for bi in 0:nblk {
        if a.rc_loop_hot[bi] <= 0 { -> }
        if layout < 0 {
            layout = bi
            ->
        }
        for p in 0:nh {
            if a.rc_fp_blk[bi * nh + p] != a.rc_fp_blk[layout * nh + p] { << false }
        }
    }
    << true
}

fn rc_emit_edge_fp(a &mut Assembler, m &types.Mir, fi int, fr &Frame, from int, to int) {
    if !rc_fp_on(&*a) || to < 0 || a.rc_fp_blk.len < (to + 1) * rc_fp_homes() {
        <<
    }
    nh := rc_fp_homes()
    for p in 0:nh {
        loc := a.rc_fp_blk[to * nh + p]
        if loc < 0 || loc >= fr.local_slot.len {
            ->
        }
        slot := fr.local_slot[loc]
        already := rc_fp_index(&*a, slot)
        if already == p {
            ->
        }
        a.rc_fp_pin[p] = slot
        a.rc_fp_dirty[p] = 0
        // nbody: dx/dy/dz/mag are pinned but redefined before any LoadLocal
        // in the pair body — entry reload is dead traffic.
        if rc_fp_def_before_use(m, fi, to, loc) {
            ->
        }
        a.be_fload(rc_fp_d(p), 15, slot_off(slot))
    }
    <<
}

// True when the first mention of `loc` in block `bi` is StoreLocal (def),
// not LoadLocal (use). Safe to skip edge/entry fload into the pin home.
fn rc_fp_def_before_use(m &types.Mir, fi int, bi int, loc int) bool {
    if bi < 0 || bi >= types.mir_nblocks(m, fi) {
        << false
    }
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 {
            << false
        }
        ik := types.mir_ikind(m, fi, ii)
        if ik == types.MI_STORE_LOCAL && types.mir_ia(m, fi, ii) == loc {
            << true
        }
        if ik == types.MI_LOAD_LOCAL && types.mir_ib(m, fi, ii) == loc {
            << false
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << false
}

fn rc_coalesce_f64_fd(a &Assembler, m &types.Mir, fi int, fr &Frame, dest_temp int, next_ii int) int {
    if next_ii < 0 {
        << -1
    }
    if types.mir_ikind(m, fi, next_ii) != types.MI_STORE_LOCAL {
        << -1
    }
    if types.mir_ib(m, fi, next_ii) != dest_temp {
        << -1
    }
    loc := types.mir_ia(m, fi, next_ii)
    if loc < 0 {
        << -1
    }
    if types.mir_local_ty(m, fi, loc) != 4 {
        << -1
    }
    p := rc_fp_index(a, fr.local_slot[loc])
    if p < 0 {
        << -1
    }
    << rc_fp_d(p)
}

fn rc_fp_operand_d(a &mut Assembler, m &types.Mir, fi int, fr &Frame, v int, scratch int) int {
    if v >= 0 {
        // An admitted loop-carried f64 must use its d2-d7 residency before
        // fixed vreg homes (which are commonly d0/d1). The latter are only
        // materialization homes and would otherwise defeat the pin.
        if a.rc_fp_only && v < fr.temp_slot.len {
            p0 := rc_fp_index_alias(&*a, fr.temp_slot[v])
            if p0 >= 0 {
                << 2 + p0
            }
            recovered := rc_fp_temp_pinned_d(&*a, m, fi, fr, v)
            if recovered >= 0 {
                << recovered
            }
            sl0 := fr.temp_slot[v]
            for q in 0:rc_fp_homes() {
                if a.rc_fp_pin[q] == sl0 {
                    << 2 + q
                }
            }
        }
        fixed := fixed_fp_temp_d(fr, v)
        if fixed >= 0 {
            << fixed
        }
        p := rc_fp_index_alias(&*a, fr.temp_slot[v])
        if p >= 0 {
            << rc_fp_d(p)
        }
        // Also match soft-aliased locals (StoreLocal retargeted alias to lo).
        // LoadLocal normally rewrites alias to the temp; this covers CSE of the
        // pre-store temp still named in MIR.
        if a.rc_fp_ephem == v {
            a.rc_fp_ephem = -1
            << 0
        }
        if a.rc_fp_rhs == v {
            a.rc_fp_rhs = -1
            << 1
        }
        // f64 temp on the frame and not parked in a GPR: load straight into
        // the SIMD scratch. If a GPR park holds the live bits, prefer that
        // (stack may be stale).
        if v < types.mir_ntemps(m, fi) && types.mir_temp_ty(m, fi, v) == 4 {
            if rc_find(&*a, fr.temp_slot[v]) < 0 {
                a.be_fload(scratch, 15, slot_off(fr.temp_slot[v]))
                << scratch
            }
        }
    }
    mut gpr := 0
    if scratch != 0 {
        gpr = 1
    }
    r := rc_load_reg(a, m, fi, fr, v, gpr)
    a.be_fmov_d_from_gpr(scratch, r)
    << scratch
}

// Result can live in d0/d1: next instr is the sole FP consumer
// (nbody `dx*mj*mag` chain). Strict use count — loose counts broke checksums.
fn f64_result_is_ephemeral(m &types.Mir, fi int, dest int, next_ii int) bool {
    if dest < 0 || next_ii < 0 {
        << false
    }
    if types.mir_temp_ty(m, fi, dest) != 4 {
        << false
    }
    uses := mir_temp_uses_from(m, fi, dest, next_ii)
    nk := types.mir_ikind(m, fi, next_ii)
    if nk == types.MI_BIN {
        nop := types.mir_ib(m, fi, next_ii)
        if nop < 1 || nop > 4 {
            << false
        }
        c0 := types.mir_ic(m, fi, next_ii)
        d0 := types.mir_id(m, fi, next_ii)
        if c0 != dest && d0 != dest {
            << false
        }
        if uses == 1 {
            << true
        }
        // `x*x` counts as two operand uses in one instr.
        if uses == 2 && c0 == dest && d0 == dest {
            << true
        }
        << false
    }
    if nk == types.MI_FIELD_RMW && types.mir_ic(m, fi, next_ii) == dest {
        << uses == 1
    }
    << false
}

// Count operand uses of temp t from start_ii along the instr chain (defs ignored).
fn f64_can_skip_materialize(m &types.Mir, fi int, dest int, next_ii int) bool {
    if dest < 0 || next_ii < 0 {
        << false
    }
    if types.mir_temp_ty(m, fi, dest) != 4 {
        << false
    }
    mut n := 0
    mut ii := next_ii
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 {
            <-
        }
        ik := types.mir_ikind(m, fi, ii)
        a0 := types.mir_ia(m, fi, ii)
        b0 := types.mir_ib(m, fi, ii)
        c0 := types.mir_ic(m, fi, ii)
        d0 := types.mir_id(m, fi, ii)
        // Def of dest ends the scan (Copy/Load*/Bin/Call/… writing a).
        mut is_def := false
        if ik == types.MI_COPY || ik == types.MI_LOAD_LOCAL || ik == types.MI_BIN || ik == types.MI_UN || ik == types.MI_STR_CONST || ik == types.MI_LOAD_INDEX || ik == types.MI_ADDR || ik == types.MI_LOAD_PTR || ik == types.MI_ELEM_ADDR || ik == types.MI_LOAD_BUF_PTR {
            if a0 == dest {
                is_def = true
            }
        }
        if ik == types.MI_CALL && a0 == dest {
            is_def = true
        }
        if is_def {
            <-
        }
        mut hit := false
        if ik == types.MI_BIN {
            op := b0
            if op >= 1 && op <= 4 {
                if c0 == dest || d0 == dest {
                    hit = true
                }
            } else if c0 == dest || d0 == dest {
                << false
            }
        } else if ik == types.MI_STORE_PTR || ik == types.MI_STORE_BUF_PTR {
            if a0 == dest {
                hit = true
            }
            if b0 == dest {
                << false
            }
        } else if ik == types.MI_FIELD_RMW {
            // FieldRMW: only rhs (c) is an FP value use. Do not treat a (ptr)
            // as a conflict — temp-index reuse would false-fail skip_mat.
            if c0 == dest {
                hit = true
            }
        } else if ik == types.MI_LOAD_LOCAL {
            // LoadLocal: defines a new temp; b is a local index, not a temp.
            // Falling through to the generic field check false-fails when a
            // local index collides with dest (nbody dt before d2*dist→div).
        } else if ik == types.MI_STORE_LOCAL {
            // StoreLocal of dest: allow SIMD-only when dest dies here and every
            // later use of the local is FP-aware (unpinned d2→sqrt in nbody).
            if b0 == dest {
                nxi := types.mir_inext(m, fi, ii)
                if mir_temp_uses_from(m, fi, dest, nxi) != 0 {
                    << false
                }
                if !f64_local_remaining_fp_ok(m, fi, a0, nxi) {
                    << false
                }
                hit = true
            }
        } else if ik == types.MI_LOAD_FIELD || ik == types.MI_LOAD_PTR || ik == types.MI_ELEM_ADDR || ik == types.MI_LOAD_BUF_PTR {
            // LoadField / LoadPtr / ElemAddr / LoadBufPtr: a is a new dest,
            // b is a pointer, c/d are byte-offset or size. Matching dest
            // against c (8, 16, …) false-failed skip_mat on every nbody
            // field load and dumped f64 through GPR+stack.
        } else if ik == types.MI_STORE_FIELD {
            // StoreField: a is the stored value; c is a byte offset.
            if a0 == dest {
                hit = true
            }
        } else if ik == types.MI_ADDR {
            if b0 == dest {
                << false
            }
        } else {
            if a0 == dest || b0 == dest || c0 == dest || d0 == dest {
                << false
            }
            if ik == types.MI_CALL {
                mut ai := c0
                while ai >= 0 {
                    if types.mir_marg_v(m, fi, ai) == dest {
                        << false
                    }
                    ai = types.mir_marg_next(m, fi, ai)
                }
            }
        }
        if hit {
            n += 1
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << n >= 1
}

// After `t := …; x = t`, later `LoadLocal x` uses must stay FP-aware.
fn f64_local_remaining_fp_ok(m &types.Mir, fi int, loc int, start_ii int) bool {
    if loc < 0 || start_ii < 0 {
        << false
    }
    mut ii := start_ii
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 {
            <-
        }
        ik := types.mir_ikind(m, fi, ii)
        a0 := types.mir_ia(m, fi, ii)
        b0 := types.mir_ib(m, fi, ii)
        c0 := types.mir_ic(m, fi, ii)
        // Locals and temps share numeric ids — only match opcodes that
        // actually name a local in a/b (never compare loc to a temp field).
        if ik == types.MI_LOAD_LOCAL && b0 == loc {
            // LoadLocal loc → temp a0; require that temp's uses are FP-only.
            nxi := types.mir_inext(m, fi, ii)
            if !f64_can_skip_materialize(m, fi, a0, nxi) {
                << false
            }
        } else if ik == types.MI_STORE_LOCAL && a0 == loc {
            // Re-store of same local OK (rare).
        } else if ik == types.MI_ADDR && c0 == 0 && b0 == loc {
            // AddrOf(local) needs frame bits.
            << false
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << true
}
