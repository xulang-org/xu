@main

#xu/types

fn rt_emit_str_clone(a &mut Assembler) {
    a.label("_rt_str_clone")
    a.prologue(48)
    a.store(15, -8, 18)    // ptr
    a.store(15, -16, 19)   // len
    a.store(15, -24, 20)   // cap
    a.store(15, -40, 0)    // sret (V0 is clobbered; save it)
    // Reject malformed negative lengths even for static descriptors.
    a.load(0, 15, -16)
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_al_oom")
    // Static path: cap == 0
    a.load(0, 15, -24)
    a.vm_cbnz(0, "_rt_sc_heap")
    a.load(0, 15, -40)
    a.load(1, 15, -8)
    a.store(0, 0, 1)
    a.load(1, 15, -16)
    a.store(0, -8, 1)
    a.vm_mov_imm(1, 0)
    a.store(0, -16, 1)
    a.epilogue()
    // Heap path: alloc + copy
    a.label("_rt_sc_heap")
    a.load(18, 15, -16)    // A0 = len
    a.vm_cmp_imm(18, 0)
    a.jlt("_rt_al_oom")
    // A heap-owned empty string has no bytes to clone; return the canonical
    // non-owning descriptor instead of leaking an alloc(0) block.
    a.vm_cbz(18, "_rt_sc_empty")
    a.load(1, 15, -8)
    a.vm_cbz(1, "_rt_al_oom")
    a.add(2, 1, 18)
    a.cmp(2, 1)
    a.jae("_rt_sc_span_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_sc_span_ok")
    a.call("_rt_alloc")
    a.store(15, -32, 14)   // data
    a.load(1, 15, -8)
    a.load(2, 15, -32)
    a.load(3, 15, -16)
    rt_emit_copy_bytes(a, "clone", 1, 2, 3, 4)
    a.load(0, 15, -40)     // sret
    a.load(1, 15, -32)     // data
    a.store(0, 0, 1)
    a.load(1, 15, -16)     // len
    a.store(0, -8, 1)
    a.store(0, -16, 1)     // cap = len
    a.epilogue()
    a.label("_rt_sc_empty")
    a.load(0, 15, -40)     // sret
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    <<
}

fn rt_emit_now_ns(a &mut Assembler) {
    a.label("_rt_now_ns")
    a.prologue(32)
    if a.os == 2 {
        a.mov(18, 15)
        a.vm_sub_imm(18, 18, 16)
        a.vm_call_iat("_iat_QueryPerformanceCounter")
        a.mov(18, 15)
        a.vm_sub_imm(18, 18, 8)
        a.vm_call_iat("_iat_QueryPerformanceFrequency")
        a.load(0, 15, -16)
        a.load(1, 15, -8)
        a.vm_cbz(1, "_rt_now_zero")
        a.div(2, 0, 1)
        a.imod(3, 0, 1)
        a.vm_mov_imm(4, TIME_NS_PER_SECOND)
        a.mul(2, 2, 4)
        a.mul(3, 3, 4)
        a.div(3, 3, 1)
        a.add(14, 2, 3)
        a.epilogue()
        a.label("_rt_now_zero")
        a.vm_mov_imm(14, 0)
        a.epilogue()
        <<
    }
    a.vm_mov_imm(0, 0)
    a.store(15, -16, 0)
    a.store(15, -8, 0)
    if a.os == 0 {
        a.vm_mov_imm(18, 6)
        a.mov(19, 15)
        a.vm_sub_imm(19, 19, 16)
        a.vm_call_iat("_iat_clock_gettime")
    } else {
        a.vm_mov_imm(18, 1)
        a.mov(19, 15)
        a.vm_sub_imm(19, 19, 16)
        a.vm_syscall(syscall_number(a.os, a.arch, 10))
    }
    a.load(0, 15, -16)
    a.load(1, 15, -8)
    a.vm_mov_imm(2, TIME_NS_PER_SECOND)
    a.mul(0, 0, 2)
    a.add(14, 0, 1)
    a.epilogue()
    <<
}


fn rt_emit_wall_time_ns(a &mut Assembler) {
    a.label("_rt_wall_time_ns")
    a.prologue(32)
    if a.os == 2 {
        a.mov(18, 15)
        a.vm_sub_imm(18, 18, 16)
        a.vm_call_iat("_iat_GetSystemTimeAsFileTime")
        a.load(0, 15, -16)
        a.vm_mov_imm(1, TIME_FILETIME_UNIX_EPOCH_TICKS)
        a.sub(0, 0, 1)
        a.vm_mov_imm(1, TIME_NS_PER_FILETIME_TICK)
        a.mul(14, 0, 1)
        a.epilogue()
        <<
    }
    a.vm_mov_imm(0, 0)
    a.store(15, -16, 0)
    a.store(15, -8, 0)
    a.vm_mov_imm(18, 0) // CLOCK_REALTIME
    a.mov(19, 15)
    a.vm_sub_imm(19, 19, 16)
    if a.os == 0 {
        a.vm_call_iat("_iat_clock_gettime")
    } else {
        a.vm_syscall(syscall_number(a.os, a.arch, 10))
    }
    a.load(0, 15, -16)
    a.load(1, 15, -8)
    a.vm_mov_imm(2, TIME_NS_PER_SECOND)
    a.mul(0, 0, 2)
    a.add(14, 0, 1)
    a.epilogue()
    <<
}

fn rt_emit_sleep_ns(a &mut Assembler) {
    a.label("_rt_sleep_ns")
    a.prologue(32)
    a.store(15, -24, 18)
    a.load(0, 15, -24)
    a.vm_cmp_imm(0, 0)
    a.jle("_rt_sleep_done")
    a.call("_rt_enter_syscall")
    a.load(0, 15, -24)
    if a.os == 2 {
        a.vm_mov_imm(1, TIME_NS_PER_MILLISECOND)
        a.div(2, 0, 1)
        a.imod(3, 0, 1)
        a.vm_cbz(3, "_rt_sleep_ms")
        a.vm_add_imm(2, 2, 1)
        a.label("_rt_sleep_ms")
        a.vm_cbnz(2, "_rt_sleep_win")
        a.vm_mov_imm(2, 1)
        a.label("_rt_sleep_win")
        a.mov(18, 2)
        a.vm_call_iat("_iat_Sleep")
    } else {
        a.vm_mov_imm(1, TIME_NS_PER_SECOND)
        a.div(2, 0, 1)
        a.imod(3, 0, 1)
        a.store(15, -16, 2)
        a.store(15, -8, 3)
        a.mov(18, 15)
        a.vm_sub_imm(18, 18, 16)
        a.vm_mov_imm(19, 0)
        if a.os == 0 {
            a.vm_call_iat("_iat_nanosleep")
        } else {
            a.vm_syscall(syscall_number(a.os, a.arch, 11))
        }
    }
    a.label("_rt_sleep_done")
    a.epilogue()
    <<
}

fn rt_emit_str_from_byte(a &mut Assembler) {
    a.label("_rt_str_from_byte")
    a.prologue(32)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.vm_mov_imm(18, 1)
    a.call("_rt_alloc")
    a.store(15, -24, 14)
    a.load(1, 15, -16)
    a.store_byte(14, 0, 1)
    a.load(0, 15, -8)
    a.load(1, 15, -24)
    a.store(0, 0, 1)
    a.vm_mov_imm(1, 1)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    <<
}

fn rt_emit_str_from_bytes(a &mut Assembler) {
    rt_emit_str_from_bytes_layout(a, false, false)
    rt_emit_str_from_bytes_layout(a, true, false)
    rt_emit_str_from_bytes_layout(a, false, true)
    rt_emit_str_from_bytes_layout(a, true, true)
}

fn rt_emit_str_from_bytes_layout(a &mut Assembler, fixed bool, ranged bool) {
    // sret -8, buf -16, len -24, data -32, i -40
    mut prefix := "_rt_sb_"
    if fixed { prefix = "_rt_sfb_" }
    mut entry := "_rt_str_from_bytes"
    if fixed { entry = "_rt_str_from_fixed_bytes" }
    if ranged {
        entry = entry + "_range"
        prefix = prefix + "range_"
        a.data_label(prefix + "msg")
        rt_emit_bytes(a, "slice out of bounds\n")
    }
    a.label(entry)
    a.prologue(48)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    if ranged {
        // A0=typed int buffer, A1=source length, A2=start, A3=end.
        // Check before scaling offsets or allocating the sole output owner.
        a.vm_cmp_imm(20, 0)
        a.jlt(prefix + "fail")
        a.cmp(20, 21)
        a.jgt(prefix + "fail")
        a.cmp(21, 19)
        a.jgt(prefix + "fail")
        a.vm_mov_imm(2, 1152921504606846975)
        a.cmp(19, 2)
        a.jgt(prefix + "fail")
        a.sub(19, 21, 20)
        a.store(15, -24, 19)
        a.shl_imm(2, 20, 3)
        if fixed { a.sub(18, 18, 2) } else { a.add(18, 18, 2) }
        a.store(15, -16, 18)
    }
    a.vm_cbnz(19, prefix + "allocate")
    // Canonical empty owner: no allocation and no lost zero-capacity record.
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label(prefix + "allocate")
    a.mov(18, 19)
    a.call("_rt_alloc")
    a.store(15, -32, 14)
    a.vm_mov_imm(4, 0)
    a.label(prefix + "loop")
    a.load(1, 15, -24)
    a.cmp(4, 1)
    a.jge(prefix + "done")
    a.load(2, 15, -16)
    a.mov(0, 4)
    a.shl_imm(0, 0, 3)
    if fixed { a.sub(2, 2, 0) } else { a.add(2, 2, 0) }
    a.load(5, 2, 0)
    a.load(3, 15, -32)
    a.add(3, 3, 4)
    a.store_byte(3, 0, 5)
    a.vm_add_imm(4, 4, 1)
    a.jmp(prefix + "loop")
    a.label(prefix + "done")
    a.load(0, 15, -8)
    a.load(1, 15, -32)
    a.store(0, 0, 1)
    a.load(1, 15, -24)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    if ranged {
        a.label(prefix + "fail")
        a.lea(18, prefix + "msg")
        a.vm_mov_imm(19, 20)
        a.vm_mov_imm(20, 2)
        a.call("_rt_write")
        rt_exit(a, 1)
        a.epilogue()
    }
    <<
}
fn rt_emit_str_slice(a &mut Assembler) {
    a.data_label("_rt_ss_msg")
    rt_emit_bytes(a, "slice out of bounds\n")
    // sret -8, ptr -16, len -24, start -32, end -40, data -48, n -56
    a.label("_rt_str_slice")
    a.prologue(64)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.store(15, -32, 20)
    a.store(15, -40, 21)
    // Reject start < 0, start > end, and end > len before computing or
    // allocating the copy. All invalid cases use the common loud-fail path.
    a.load(0, 15, -32)
    a.load(1, 15, -40)
    a.cmp(0, 1)
    a.jgt("_rt_ss_fail")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jgt("_rt_ss_fail")
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_ss_fail")
    a.sub(0, 21, 20)
    a.store(15, -56, 0)
    // A non-empty slice needs a non-null source and ptr+end must not wrap.
    // Empty slices use the canonical zero descriptor and skip alloc(0).
    a.vm_cbz(0, "_rt_ss_empty")
    a.load(2, 15, -16)    // ptr
    a.vm_cbz(2, "_rt_ss_fail")
    a.add(3, 2, 21)        // ptr + end
    a.cmp(3, 2)
    a.jae("_rt_ss_span_ok")
    a.jmp("_rt_ss_fail")
    a.label("_rt_ss_span_ok")
    a.mov(18, 0)
    a.call("_rt_alloc")
    a.store(15, -48, 14)
    a.load(1, 15, -16)
    a.load(4, 15, -32)
    a.add(1, 1, 4)
    a.load(2, 15, -48)
    a.load(3, 15, -56)
    rt_emit_copy_bytes(a, "slice", 1, 2, 3, 4)
    a.load(0, 15, -8)
    a.load(1, 15, -48)
    a.store(0, 0, 1)
    a.load(1, 15, -56)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    // Do not allocate a zero-capacity block: string drop treats cap==0 as
    // non-owning, so an alloc(0) result would leak on every empty slice.
    a.label("_rt_ss_empty")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_ss_fail")
    a.lea(18, "_rt_ss_msg")
    a.vm_mov_imm(19, 20)
    a.vm_mov_imm(20, 2)
    a.call("_rt_write")
    rt_exit(a, 1)
    a.epilogue()
    <<
}

// String equality: A0/A1=(lhs ptr,len), A2/A3=(rhs ptr,len), Ret=bool.
fn rt_emit_str_eq(a &mut Assembler) {
    a.label("_rt_str_eq")
    a.vm_cmp_imm(19, 0)
    a.jlt("_rt_se_no")
    a.vm_cmp_imm(21, 0)
    a.jlt("_rt_se_no")
    a.cmp(19, 21)
    a.jne("_rt_se_no")
    // Empty strings are canonical; non-empty values must have valid spans.
    a.vm_cbz(19, "_rt_se_yes")
    a.vm_cbz(18, "_rt_se_no")
    a.add(0, 18, 19)
    a.cmp(0, 18)
    a.jae("_rt_se_span1_ok")
    a.jmp("_rt_se_no")
    a.label("_rt_se_span1_ok")
    a.vm_cbz(20, "_rt_se_no")
    a.add(0, 20, 21)
    a.cmp(0, 20)
    a.jae("_rt_se_span2_ok")
    a.jmp("_rt_se_no")
    a.label("_rt_se_span2_ok")
    a.vm_mov_imm(4, 0)
    a.label("_rt_se_loop8")
    a.sub(0, 19, 4)
    a.vm_cmp_imm(0, 8)
    a.jlt("_rt_se_loop1")
    a.add(1, 18, 4)
    a.load(1, 1, 0)
    a.add(2, 20, 4)
    a.load(2, 2, 0)
    a.cmp(1, 2)
    a.jne("_rt_se_no")
    a.vm_add_imm(4, 4, 8)
    a.jmp("_rt_se_loop8")
    a.label("_rt_se_loop1")
    a.cmp(4, 19)
    a.jge("_rt_se_yes")
    a.add(0, 18, 4)
    a.load_byte(1, 0, 0)
    a.add(2, 20, 4)
    a.load_byte(3, 2, 0)
    a.cmp(1, 3)
    a.jne("_rt_se_no")
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_se_loop1")
    a.label("_rt_se_yes")
    a.vm_mov_imm(14, 1)
    a.vm_ret()
    a.label("_rt_se_no")
    a.vm_mov_imm(14, 0)
    a.vm_ret()
    <<
}

// 0x0101010101010101 and 0x8080808080808080. Rust's memchr builds the
// same pair so one word can see eight bytes.
fn rt_emit_swar_masks(a &mut Assembler) {
    a.vm_mov_imm(2, 1)
    a.shl_imm(0, 2, 8)
    a.ior(2, 2, 0)
    a.shl_imm(0, 2, 16)
    a.ior(2, 2, 0)
    a.shl_imm(0, 2, 32)
    a.ior(2, 2, 0)
    a.store(15, -48, 2)
    a.shl_imm(2, 2, 7)
    a.store(15, -56, 2)
}

// Branch to `hit` when any byte of `word` is zero. `word` stays intact.
fn rt_emit_contains_zero(a &mut Assembler, word int, hit string) {
    a.load(0, 15, -48)
    a.sub(0, word, 0)
    a.vm_mov_imm64(1, 0 - 1)
    a.ixor(1, word, 1)
    a.iand(0, 0, 1)
    a.load(1, 15, -56)
    a.iand(0, 0, 1)
    a.vm_cmp_imm(0, 0)
    a.jne(hit)
}

// ARM64 count kernel. Only caller-saved GPRs and V0/V1 are touched.
// Q loads require remaining>=16; D loads stay within the original input.
fn rt_emit_count_byte_neon(a &mut Assembler) {
    a.vm_mov_imm(6, 0)
    a.vm_cmp_imm(19, 0)
    a.jle("_rt_cb_neon_done")
    a.mov(3, 18)
    a.mov(4, 19)
    a.vm_and_imm(20, 20, 255)
    a.vm_cmp_imm(4, 8)
    a.jlt("_rt_cb_neon_scalar")
    a.be_neon_dup_16b(1, 20)
    a.label("_rt_cb_neon_loop")
    a.vm_cmp_imm(4, 16)
    a.jlt("_rt_cb_neon_tail")
    a.be_neon_ldr_q_post16(0, 3)
    a.be_neon_cmeq_16b(0, 0, 1)
    a.be_neon_ushr_16b(0, 0, 7)
    a.addv_16b(0, 0)
    a.fmov_w_from_s(map_reg(0), 0)
    a.add(6, 6, 0)
    a.vm_sub_imm(4, 4, 16)
    a.jmp("_rt_cb_neon_loop")
    a.label("_rt_cb_neon_tail")
    a.vm_cbz(4, "_rt_cb_neon_done")
    // Very short long-input tails cost less as scalar bytes than a masked
    // overlapping D load (notably the common 33-byte case).
    a.vm_cmp_imm(4, 4)
    a.jlt("_rt_cb_neon_scalar")
    a.vm_cmp_imm(4, 8)
    a.jlt("_rt_cb_neon_last8")
    a.ldr_d(0, map_reg(3), 0)
    a.be_neon_cmeq_16b(0, 0, 1)
    a.be_neon_ushr_16b(0, 0, 7)
    // Only the eight loaded lanes contribute, including when byte==0.
    a.addv_8b(0, 0)
    a.fmov_w_from_s(map_reg(0), 0)
    a.add(6, 6, 0)
    a.vm_add_imm(3, 3, 8)
    a.vm_sub_imm(4, 4, 8)
    a.vm_cbz(4, "_rt_cb_neon_done")
    a.label("_rt_cb_neon_last8")
    // Here 1<=remaining<=7 and the original input has at least eight bytes.
    // Reload the final eight bytes, then discard already counted lanes.
    a.add(0, 3, 4)
    a.vm_sub_imm(0, 0, 8)
    a.ldr_d(0, map_reg(0), 0)
    a.be_neon_cmeq_16b(0, 0, 1)
    a.be_neon_ushr_16b(0, 0, 7)
    a.fmov_x_from_d(map_reg(0), 0)
    a.vm_mov_imm(1, 8)
    a.sub(1, 1, 4)
    a.shl_imm(1, 1, 3)
    a.shr(0, 0, 1)
    a.fmov_d_from_x(0, map_reg(0))
    a.addv_8b(0, 0)
    a.fmov_w_from_s(map_reg(0), 0)
    a.add(6, 6, 0)
    a.jmp("_rt_cb_neon_done")
    a.label("_rt_cb_neon_scalar")
    a.load_byte(0, 3, 0)
    a.cmp(0, 20)
    a.be_cset(0, 0)
    a.add(6, 6, 0)
    a.vm_add_imm(3, 3, 1)
    a.vm_sub_imm(4, 4, 1)
    a.vm_cbnz(4, "_rt_cb_neon_scalar")
    a.label("_rt_cb_neon_done")
    a.mov(14, 6)
    a.vm_ret()
}

fn rt_emit_count_byte_sse(a &mut Assembler) {
    // Input: A0 (18) = ptr (RDI, 7), A1 (19) = len (RSI, 6), A2 (20) = byte (RDX, 2)
    // Output: Ret (14) = count (RAX, 0)
    // Scratch: R8 (8), RCX (1), XMM0, XMM1
    a.vm_mov_imm(14, 0)
    a.vm_cmp_imm(19, 0)
    a.jle("_rt_cb_sse_done")

    // R8 = count = 0
    a.x64_mov_imm32(8, 0)

    // Check if len < 16, if so go straight to scalar tail
    a.vm_cmp_imm(19, 16)
    a.jlt("_rt_cb_sse_tail")

    // Broadcast target byte (RDX, 2) to all 16 lanes of XMM1
    a.x64_mov_imm64(0, 0x0101010101010101)
    a.x64_mov_reg(1, 2)
    a.x64_and_imm(1, 255)
    a.x64_imul(1, 0)
    a.x64_movq_xmm_from_r(1, 1)
    a.x64_packed_reg(108, 1, 1)

    a.label("_rt_cb_sse_loop16")
    a.x64_movdqu_load(0, 7, 0)
    a.x64_packed_reg(116, 0, 1)
    a.x64_pmovmskb(0, 0)
    a.x64_popcnt(0, 0)
    a.x64_add_reg(8, 0)
    a.x64_add_imm(7, 16)
    a.x64_sub_imm(6, 16)
    a.x64_cmp_imm(6, 16)
    a.x64_jcc(3, "_rt_cb_sse_loop16")

    a.label("_rt_cb_sse_tail")
    a.x64_cmp_imm(6, 0)
    a.x64_jcc(14, "_rt_cb_sse_ret")
    a.x64_mov_reg(1, 2)
    a.x64_and_imm(1, 255)

    a.label("_rt_cb_sse_tail_loop")
    a.x64_load_byte_offset(0, 7, 0)
    a.x64_cmp_reg(0, 1)
    a.x64_setcc(0, 4)
    a.x64_and_imm(0, 255)
    a.x64_add_reg(8, 0)
    a.x64_add_imm(7, 1)
    a.x64_sub_imm(6, 1)
    a.x64_cmp_imm(6, 0)
    a.x64_jcc(15, "_rt_cb_sse_tail_loop")

    a.label("_rt_cb_sse_ret")
    a.x64_mov_reg(0, 8)
    a.label("_rt_cb_sse_done")
    a.x64_ret()
}

// A0=ptr, A1=len, A2=byte → Ret = number of matching bytes.
fn rt_emit_count_byte(a &mut Assembler) {
    mut scan_count := 6
    mut scan_offset := 7
    if a.arch == 1 { scan_count = 22
        scan_offset = 23 }
    a.label("_rt_count_byte")
    if a.arch == 0 {
        rt_emit_count_byte_neon(a)
        <<
    }
    if a.arch == 1 {
        rt_emit_count_byte_sse(a)
        <<
    }
    // Under 48 bytes the mask setup and callee-save frame cost more than the
    // scan. Arguments stay in A0–A2; only caller-saved registers are used.
    a.vm_cmp_imm(19, 48)
    a.jge("_rt_cb_long")
    a.vm_cmp_imm(19, 0)
    a.jle("_rt_cb_s0")
    a.vm_and_imm(20, 20, 255)
    a.vm_mov_imm(scan_count, 0)
    a.vm_mov_imm(scan_offset, 0)
    a.label("_rt_cb_sh")
    a.cmp(scan_offset, 19)
    a.jge("_rt_cb_shd")
    a.add(0, 18, scan_offset)
    a.load_byte(0, 0, 0)
    a.cmp(0, 20)
    a.jne("_rt_cb_shn")
    a.vm_add_imm(scan_count, scan_count, 1)
    a.label("_rt_cb_shn")
    a.vm_add_imm(scan_offset, scan_offset, 1)
    a.jmp("_rt_cb_sh")
    a.label("_rt_cb_shd")
    a.mov(14, scan_count)
    a.vm_ret()
    a.label("_rt_cb_s0")
    a.vm_mov_imm(14, 0)
    a.vm_ret()
    a.label("_rt_cb_long")
    a.prologue(96)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    a.load(0, 15, -16)
    a.vm_cmp_imm(0, 0)
    a.jle("_rt_cb_zero")
    a.load(5, 15, -24)
    a.vm_and_imm(5, 5, 255)
    rt_emit_swar_masks(a)
    a.load(2, 15, -48)
    a.mul(4, 5, 2)
    a.vm_mov_imm(scan_count, 0)
    a.vm_mov_imm(scan_offset, 0)
    a.label("_rt_cb_sw")
    a.load(0, 15, -16)
    a.sub(0, 0, scan_offset)
    a.vm_cmp_imm(0, 16)
    a.jlt("_rt_cb_tail")
    a.load(3, 15, -8)
    a.add(3, 3, scan_offset)
    a.store(15, -40, 3)
    a.load(2, 3, 0)
    a.ixor(2, 2, 4)
    rt_emit_contains_zero(a, 2, "_rt_cb_chunk")
    a.load(3, 15, -40)
    a.load(2, 3, 8)
    a.ixor(2, 2, 4)
    rt_emit_contains_zero(a, 2, "_rt_cb_chunk")
    a.vm_add_imm(scan_offset, scan_offset, 16)
    a.jmp("_rt_cb_sw")
    a.label("_rt_cb_chunk")
    a.load(3, 15, -40)
    a.vm_mov_imm(0, 0)
    a.label("_rt_cb_c16")
    a.vm_cmp_imm(0, 16)
    a.jge("_rt_cb_c16d")
    a.add(1, 3, 0)
    a.load_byte(1, 1, 0)
    a.cmp(1, 5)
    a.jne("_rt_cb_c16n")
    a.vm_add_imm(scan_count, scan_count, 1)
    a.label("_rt_cb_c16n")
    a.vm_add_imm(0, 0, 1)
    a.jmp("_rt_cb_c16")
    a.label("_rt_cb_c16d")
    a.vm_add_imm(scan_offset, scan_offset, 16)
    a.jmp("_rt_cb_sw")
    a.label("_rt_cb_tail")
    a.load(0, 15, -16)
    a.cmp(scan_offset, 0)
    a.jge("_rt_cb_done")
    a.load(1, 15, -8)
    a.add(1, 1, scan_offset)
    a.load_byte(1, 1, 0)
    a.cmp(1, 5)
    a.jne("_rt_cb_tn")
    a.vm_add_imm(scan_count, scan_count, 1)
    a.label("_rt_cb_tn")
    a.vm_add_imm(scan_offset, scan_offset, 1)
    a.jmp("_rt_cb_tail")
    a.label("_rt_cb_done")
    a.mov(14, scan_count)
    a.epilogue()
    a.label("_rt_cb_zero")
    a.vm_mov_imm(14, 0)
    a.epilogue()
    <<
}

fn rt_emit_find_byte_neon(a &mut Assembler) {
    a.cmp_imm(3, 0)
    a.blt("_rt_fb_neon_none")
    // This leaf uses physical X0..X7 throughout. The generic cmp() maps VM
    // register numbers and would compare unrelated caller registers here.
    a.cmp_reg(3, 1)
    a.bge("_rt_fb_neon_none")

    a.dup_16b_from_w(1, 2)

    a.label("_rt_fb_neon_loop16")
    a.sub_reg(4, 1, 3)
    a.cmp_imm(4, 16)
    a.blt("_rt_fb_neon_tail")

    a.add_reg(5, 0, 3)
    a.ldr_q_uoff(0, 5, 0)
    a.cmeq_16b(0, 0, 1)
    a.umaxv_16b(2, 0)
    a.fmov_w_from_s(6, 2)
    a.cbz(6, "_rt_fb_neon_next16")

    a.fmov_x_from_d(7, 0)
    a.cbz(7, "_rt_fb_neon_hit_hi")

    a.rbit_x(7, 7)
    a.clz_x(7, 7)
    a.lsr_imm(7, 7, 3)
    a.add_reg(0, 3, 7)
    a.ret()

    a.label("_rt_fb_neon_hit_hi")
    a.umov_64(7, 0, 1)
    a.rbit_x(7, 7)
    a.clz_x(7, 7)
    a.lsr_imm(7, 7, 3)
    a.add_imm(7, 7, 8)
    a.add_reg(0, 3, 7)
    a.ret()

    a.label("_rt_fb_neon_next16")
    a.add_imm(3, 3, 16)
    a.b("_rt_fb_neon_loop16")

    a.label("_rt_fb_neon_tail")
    a.cmp_reg(3, 1)
    a.bge("_rt_fb_neon_none")
    a.add_reg(5, 0, 3)
    a.load_byte_offset(6, 5, 0)
    a.and_imm(7, 2, 255)
    a.cmp_reg(6, 7)
    a.beq("_rt_fb_neon_hit_tail")
    a.add_imm(3, 3, 1)
    a.b("_rt_fb_neon_tail")

    a.label("_rt_fb_neon_hit_tail")
    a.mov_reg(0, 3)
    a.ret()

    a.label("_rt_fb_neon_none")
    a.mov_imm64(0, -1)
    a.ret()
}

// A0=ptr, A1=len, A2=byte, A3=from → Ret = index, or -1.
fn rt_emit_find_byte(a &mut Assembler) {
    mut scan_offset := 7
    if a.arch == 1 { scan_offset = 23 }
    a.label("_rt_find_byte")
    if a.arch == 0 {
        rt_emit_find_byte_neon(a)
        <<
    }
    a.prologue(96)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    a.store(15, -32, 21)
    a.load(0, 15, -16)
    a.vm_cmp_imm(0, 0)
    a.jle("_rt_fb_none")
    a.load(scan_offset, 15, -32)
    a.vm_cmp_imm(scan_offset, 0)
    a.jlt("_rt_fb_none")
    a.cmp(scan_offset, 0)
    a.jge("_rt_fb_none")
    a.load(5, 15, -24)
    a.vm_and_imm(5, 5, 255)
    rt_emit_swar_masks(a)
    a.load(2, 15, -48)
    a.mul(4, 5, 2)
    a.label("_rt_fb_sw")
    a.load(0, 15, -16)
    a.sub(0, 0, scan_offset)
    a.vm_cmp_imm(0, 16)
    a.jlt("_rt_fb_tail")
    a.load(3, 15, -8)
    a.add(3, 3, scan_offset)
    a.store(15, -40, 3)
    a.load(2, 3, 0)
    a.ixor(2, 2, 4)
    rt_emit_contains_zero(a, 2, "_rt_fb_chunk")
    a.load(3, 15, -40)
    a.load(2, 3, 8)
    a.ixor(2, 2, 4)
    rt_emit_contains_zero(a, 2, "_rt_fb_chunk")
    a.vm_add_imm(scan_offset, scan_offset, 16)
    a.jmp("_rt_fb_sw")
    a.label("_rt_fb_chunk")
    a.load(3, 15, -40)
    a.vm_mov_imm(0, 0)
    a.label("_rt_fb_c16")
    a.vm_cmp_imm(0, 16)
    a.jge("_rt_fb_c16d")
    a.add(1, 3, 0)
    a.load_byte(1, 1, 0)
    a.cmp(1, 5)
    a.jeq("_rt_fb_hit")
    a.vm_add_imm(0, 0, 1)
    a.jmp("_rt_fb_c16")
    a.label("_rt_fb_hit")
    a.add(14, scan_offset, 0)
    a.epilogue()
    a.label("_rt_fb_c16d")
    a.vm_add_imm(scan_offset, scan_offset, 16)
    a.jmp("_rt_fb_sw")
    a.label("_rt_fb_tail")
    a.load(0, 15, -16)
    a.cmp(scan_offset, 0)
    a.jge("_rt_fb_none")
    a.load(1, 15, -8)
    a.add(1, 1, scan_offset)
    a.load_byte(1, 1, 0)
    a.cmp(1, 5)
    a.jeq("_rt_fb_tail_hit")
    a.vm_add_imm(scan_offset, scan_offset, 1)
    a.jmp("_rt_fb_tail")
    a.label("_rt_fb_tail_hit")
    a.mov(14, scan_offset)
    a.epilogue()
    a.label("_rt_fb_none")
    a.vm_mov_imm(14, 0 - 1)
    a.epilogue()
    <<
}

// A0 = negative cap = -U. U holds the refcount; bytes live at U+8.
// Last release frees U. Underflow aborts instead of freeing twice.
fn rt_emit_str_release(a &mut Assembler) {
    a.label("_rt_str_release")
    a.prologue(32)
    a.neg(0, 18)
    a.load(1, 0, 0)
    a.vm_sub_imm(1, 1, 1)
    a.vm_cmp_imm(1, 0)
    a.jlt("_rt_al_oom")
    a.jeq("_rt_srel_free")
    a.store(0, 0, 1)
    a.epilogue()
    a.label("_rt_srel_free")
    a.mov(18, 0)
    a.call("_rt_free")
    a.epilogue()
    <<
}

// v0=end, v1=start, v2=part, v5=array, v6=refcount. Restores len (v3) and sep (v4).
fn rt_emit_split_one(a &mut Assembler, tag string) {
    mut scan_count := 6
    mut scan_offset := 7
    if a.arch == 1 { scan_count = 22
        scan_offset = 23 }
    a.sub(scan_offset, 0, 1)
    a.vm_cbz(scan_offset, "_rt_sb_e_" + tag)
    a.store(15, -72, 3)
    a.store(15, -80, 4)
    a.store(15, -96, scan_offset)
    a.load(3, 15, -64)
    a.vm_cbz(3, "_rt_al_oom")
    a.vm_mov_imm(4, 24)
    a.mul(scan_offset, 2, 4)
    a.add(4, 5, scan_offset)
    a.vm_add_imm(3, 3, 8)
    a.add(3, 3, 1)
    a.store(4, 0, 3)
    a.load(scan_offset, 15, -96)
    a.store(4, 8, scan_offset)
    a.load(3, 15, -64)
    a.neg(3, 3)
    a.store(4, 16, 3)
    a.vm_add_imm(scan_count, scan_count, 1)
    a.load(3, 15, -72)
    a.load(4, 15, -80)
    a.jmp("_rt_sb_ed_" + tag)
    a.label("_rt_sb_e_" + tag)
    a.store(15, -72, 3)
    a.store(15, -80, 4)
    a.vm_mov_imm(4, 24)
    a.mul(scan_offset, 2, 4)
    a.add(4, 5, scan_offset)
    a.vm_mov_imm(scan_offset, 0)
    a.store(4, 0, scan_offset)
    a.store(4, 8, scan_offset)
    a.store(4, 16, scan_offset)
    a.load(3, 15, -72)
    a.load(4, 15, -80)
    a.label("_rt_sb_ed_" + tag)
}

// ARM64 fill keeps the slab and the next descriptor in caller-saved registers.
// v0=end, v1=start, v3=len, v4=sep, v6=refs; A0=-U, A1=U+8, A3=dst.
fn rt_emit_split_one_arm64(a &mut Assembler, tag string) {
    a.sub(7, 0, 1)
    a.vm_cbz(7, "_rt_sb_ae_" + tag)
    a.vm_cbz(18, "_rt_al_oom")
    a.add(2, 19, 1)
    a.store(21, 0, 2)
    a.store(21, 8, 7)
    a.store(21, 16, 18)
    a.vm_add_imm(6, 6, 1)
    a.jmp("_rt_sb_ad_" + tag)
    a.label("_rt_sb_ae_" + tag)
    a.vm_mov_imm(7, 0)
    a.store(21, 0, 7)
    a.store(21, 8, 7)
    a.store(21, 16, 7)
    a.label("_rt_sb_ad_" + tag)
    a.vm_add_imm(21, 21, 24)
}

fn rt_emit_split_one_x64(a &mut Assembler, tag string) {
    a.sub(2, 0, 1)
    a.vm_cbz(2, "_rt_sb_xe_" + tag)
    a.vm_cbz(18, "_rt_al_oom")
    a.add(14, 19, 1)
    a.store(21, 0, 14)
    a.store(21, 8, 2)
    a.store(21, 16, 18)
    a.vm_add_imm(22, 22, 1)
    a.jmp("_rt_sb_xd_" + tag)
    a.label("_rt_sb_xe_" + tag)
    a.vm_mov_imm(14, 0)
    a.store(21, 0, 14)
    a.store(21, 8, 14)
    a.store(21, 16, 14)
    a.label("_rt_sb_xd_" + tag)
    a.vm_add_imm(21, 21, 24)
}

fn rt_emit_split_scan_x64(a &mut Assembler) {
    a.load(18, 15, -64)
    a.vm_add_imm(19, 18, 8)
    a.neg(18, 18)
    a.mov(21, 5)
    a.vm_mov_imm(22, 0)

    a.x64_mov_imm64(0, 0x0101010101010101)
    a.x64_mov_reg(2, 13)
    a.x64_and_imm(2, 255)
    a.x64_imul(2, 0)
    a.x64_movq_xmm_from_r(1, 2)
    a.x64_packed_reg(108, 1, 1)

    a.label("_rt_sb_xscan")
    a.sub(2, 3, 0)
    a.vm_cmp_imm(2, 16)
    a.jlt("_rt_sb_xtail")

    a.add(2, 9, 0)
    a.xbe_movdqu_load(0, 2, 0)
    a.x64_packed_reg(116, 0, 1)
    a.x64_pmovmskb(0, 0)
    a.x64_test_reg(0, 0)
    a.x64_jcc(4, "_rt_sb_xskip16")

    a.x64_tzcnt_compat(3, 0)
    a.add(0, 0, 2)
    rt_emit_split_one_x64(a, "mid")
    a.vm_add_imm(0, 0, 1)
    a.mov(1, 0)
    a.jmp("_rt_sb_xscan")

    a.label("_rt_sb_xskip16")
    a.vm_add_imm(0, 0, 16)
    a.jmp("_rt_sb_xscan")

    a.label("_rt_sb_xtail")
    a.sub(2, 3, 0)
    a.vm_cbz(2, "_rt_sb_xlast")
    a.add(2, 9, 0)
    a.load_byte(2, 2, 0)
    a.vm_and_imm(2, 2, 255)
    a.cmp(2, 4)
    a.jeq("_rt_sb_xhit_tail")
    a.vm_add_imm(0, 0, 1)
    a.jmp("_rt_sb_xtail")

    a.label("_rt_sb_xhit_tail")
    rt_emit_split_one_x64(a, "tail")
    a.vm_add_imm(0, 0, 1)
    a.mov(1, 0)
    a.jmp("_rt_sb_xtail")

    a.label("_rt_sb_xlast")
    a.mov(0, 3)
    rt_emit_split_one_x64(a, "last")
    a.load(2, 15, -48)
    a.vm_mov_imm(14, 24)
    a.mul(2, 2, 14)
    a.add(2, 5, 2)
    a.cmp(21, 2)
    a.jne("_rt_al_oom")
}

// Eight-byte zero detection is used only with remaining>=8. Subtraction can
// mark a byte following a match as well; only the least significant marked
// byte is consumed, which is the exact first match on little-endian ARM64.
fn rt_emit_split_scan_arm64(a &mut Assembler) {
    a.load(18, 15, -64)
    a.vm_add_imm(19, 18, 8)
    a.neg(18, 18)
    a.mov(21, 5)
    // Short inputs and dense separators avoid a word scan per tiny piece.
    // The count pass has already measured density; division cannot overflow.
    a.vm_cmp_imm(3, 16)
    a.jlt("_rt_sb_adense")
    a.shr_imm(7, 3, 2)
    a.load(2, 15, -40)
    a.cmp(2, 7)
    a.jge("_rt_sb_adense")
    a.vm_mov_imm64(22, 72340172838076673)
    a.shl_imm(23, 22, 7)
    a.mul(20, 4, 22)
    a.label("_rt_sb_ascan")
    a.sub(7, 3, 0)
    a.vm_cmp_imm(7, 8)
    a.jlt("_rt_sb_atail")
    a.add(7, 9, 0)
    a.load(7, 7, 0)
    a.ixor(7, 7, 20)
    a.sub(2, 7, 22)
    a.ixor(7, 7, 23)
    a.iand(2, 2, 7)
    a.iand(2, 2, 23)
    a.vm_cbnz(2, "_rt_sb_awhit")
    a.vm_add_imm(0, 0, 8)
    a.jmp("_rt_sb_ascan")
    a.label("_rt_sb_awhit")
    a.be_ctz(2, 2)
    a.shr_imm(2, 2, 3)
    a.add(0, 0, 2)
    a.jmp("_rt_sb_ahit")
    a.label("_rt_sb_atail")
    a.vm_cbz(7, "_rt_sb_alast")
    a.add(7, 9, 0)
    a.load_byte(7, 7, 0)
    a.cmp(7, 4)
    a.jeq("_rt_sb_ahit")
    a.vm_add_imm(0, 0, 1)
    a.jmp("_rt_sb_atail_next")
    a.label("_rt_sb_ahit")
    rt_emit_split_one_arm64(a, "mid")
    a.vm_add_imm(0, 0, 1)
    a.mov(1, 0)
    a.jmp("_rt_sb_ascan")
    a.label("_rt_sb_atail_next")
    a.sub(7, 3, 0)
    a.jmp("_rt_sb_atail")
    a.label("_rt_sb_adense")
    a.cmp(0, 3)
    a.jge("_rt_sb_alast")
    a.add(7, 9, 0)
    a.load_byte(7, 7, 0)
    a.cmp(7, 4)
    a.jne("_rt_sb_adnext")
    rt_emit_split_one_arm64(a, "dense")
    a.vm_add_imm(1, 0, 1)
    a.label("_rt_sb_adnext")
    a.vm_add_imm(0, 0, 1)
    a.jmp("_rt_sb_adense")
    a.label("_rt_sb_alast")
    rt_emit_split_one_arm64(a, "last")
    a.load(2, 15, -48)
    a.vm_mov_imm(7, 24)
    a.mul(2, 2, 7)
    a.add(2, 5, 2)
    a.cmp(21, 2)
    a.jne("_rt_al_oom")
}

// A0=ptr, A1=len, A2=sep → sret []string. One slab holds every non-empty
// piece: refcount at U, bytes at U+8, piece cap = -U. Empty pieces stay
// the canonical cap-0 descriptor and hold no reference.
fn rt_emit_split_byte(a &mut Assembler) {
    mut scan_count := 6
    mut scan_offset := 7
    if a.arch == 1 { scan_count = 22
        scan_offset = 23 }
    // The scan keeps the source pointer in S1. Save that pair for this leaf
    // even when the surrounding function did not.
    mut saved_pairs := a.cs_pairs
    if saved_pairs < 1 {
        a.cs_pairs = 1
    }
    a.label("_rt_split_byte")
    a.prologue(160)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.store(15, -32, 20)
    a.load(0, 15, -24)
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_al_oom")
    a.vm_cbz(0, "_rt_sb_empty_src")
    a.load(1, 15, -16)
    a.vm_cbz(1, "_rt_al_oom")
    a.add(2, 1, 0)
    a.cmp(2, 1)
    a.jae("_rt_sb_span_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_sb_span_ok")
    a.load(18, 15, -16)
    a.load(19, 15, -24)
    a.load(20, 15, -32)
    a.call("_rt_count_byte")
    a.store(15, -40, 14)
    a.vm_add_imm(0, 14, 1)
    a.cmp(0, 14)
    a.jle("_rt_al_oom")
    a.vm_mov_imm(1, 1)
    a.shl_imm(1, 1, 58)
    a.cmp(0, 1)
    a.jgt("_rt_al_oom")
    a.store(15, -48, 0)
    a.vm_mov_imm(1, 24)
    a.mul(2, 0, 1)
    a.mov(18, 2)
    a.call("_rt_alloc")
    a.store(15, -56, 14)
    a.vm_cmp_imm(14, RT_MIN_HEAP_POINTER)
    a.jlt("_rt_al_oom")
    a.load(0, 15, -40)
    a.load(1, 15, -24)
    a.cmp(0, 1)
    a.jeq("_rt_sb_no_slab")
    a.vm_add_imm(2, 1, 8)
    a.cmp(2, 1)
    a.jle("_rt_al_oom")
    a.mov(18, 2)
    a.call("_rt_alloc")
    a.store(15, -64, 14)
    a.vm_cmp_imm(14, RT_MIN_HEAP_POINTER)
    a.jlt("_rt_al_oom")
    a.load(1, 15, -16)
    a.load(2, 15, -64)
    a.vm_add_imm(2, 2, 8)
    a.load(3, 15, -24)
    rt_emit_copy_bytes(a, "split", 1, 2, 3, 4)
    a.jmp("_rt_sb_fill")
    a.label("_rt_sb_no_slab")
    a.vm_mov_imm(0, 0)
    a.store(15, -64, 0)
    a.label("_rt_sb_fill")
    a.load(3, 15, -24)
    a.load(4, 15, -32)
    a.vm_and_imm(4, 4, 255)
    a.load(5, 15, -56)
    a.load(9, 15, -16)
    a.vm_mov_imm(0, 0)
    a.vm_mov_imm(1, 0)
    a.vm_mov_imm(2, 0)
    a.vm_mov_imm(scan_count, 0)
    if a.arch == 0 {
        rt_emit_split_scan_arm64(a)
    } else if a.arch == 1 {
        rt_emit_split_scan_x64(a)
    } else {
        a.label("_rt_sb_scan")
        a.cmp(0, 3)
        a.jge("_rt_sb_last")
        a.add(scan_offset, 9, 0)
        a.load_byte(scan_offset, scan_offset, 0)
        a.vm_and_imm(scan_offset, scan_offset, 255)
        a.cmp(scan_offset, 4)
        a.jne("_rt_sb_inc")
        rt_emit_split_one(a, "mid")
        a.vm_add_imm(1, 0, 1)
        a.vm_add_imm(2, 2, 1)
        a.label("_rt_sb_inc")
        a.vm_add_imm(0, 0, 1)
        a.jmp("_rt_sb_scan")
        a.label("_rt_sb_last")
        a.mov(0, 3)
        rt_emit_split_one(a, "last")
        a.vm_add_imm(2, 2, 1)
        a.load(0, 15, -48)
        a.cmp(2, 0)
        a.jne("_rt_al_oom")
    }
    a.load(0, 15, -64)
    a.vm_cbz(0, "_rt_sb_sret")
    a.vm_cmp_imm(scan_count, 1)
    a.jlt("_rt_al_oom")
    a.store(0, 0, scan_count)
    a.label("_rt_sb_sret")
    a.load(0, 15, -8)
    a.load(1, 15, -56)
    a.store(0, 0, 1)
    a.load(1, 15, -48)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_sb_empty_src")
    a.vm_mov_imm(18, 24)
    a.call("_rt_alloc")
    a.vm_cmp_imm(14, RT_MIN_HEAP_POINTER)
    a.jlt("_rt_al_oom")
    a.vm_mov_imm(0, 0)
    a.store(14, 0, 0)
    a.store(14, 8, 0)
    a.store(14, 16, 0)
    a.load(0, 15, -8)
    a.store(0, 0, 14)
    a.vm_mov_imm(1, 1)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.cs_pairs = saved_pairs
    <<
}

// Copy v7 bytes from v3 to v5+v6 and advance v6. Preserves v0, v1, v5, v7, v9.
fn rt_emit_join_copy(a &mut Assembler, tag string) {
    mut scan_count := 6
    mut scan_offset := 7
    if a.arch == 1 { scan_count = 22
        scan_offset = 23 }
    mut copy_dst := 8
    if a.arch == 1 { copy_dst = 21 }
    a.add(copy_dst, 5, scan_count)
    a.mov(2, scan_offset)
    rt_emit_copy_bytes(a, "join_" + tag, 3, copy_dst, 2, 4)
    a.add(scan_count, scan_count, scan_offset)
}

// A0=array ptr, A1=nparts, A2=sep ptr, A3=sep len → sret string.
// Borrows every piece. The result is one owned buffer, or the canonical
// empty descriptor when the joined length is 0.
fn rt_emit_join(a &mut Assembler) {
    mut scan_count := 6
    mut scan_offset := 7
    if a.arch == 1 { scan_count = 22
        scan_offset = 23 }
    mut copy_dst := 8
    if a.arch == 1 { copy_dst = 21 }
    mut saved_pairs := a.cs_pairs
    if saved_pairs < 1 {
        a.cs_pairs = 1
    }
    a.label("_rt_join")
    a.prologue(96)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.store(15, -32, 20)
    a.store(15, -40, 21)
    a.load(0, 15, -24)
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_al_oom")
    a.vm_cbz(0, "_rt_jn_empty")
    a.load(1, 15, -16)
    a.vm_cbz(1, "_rt_al_oom")
    a.vm_mov_imm(2, 1)
    a.shl_imm(2, 2, 58)
    a.cmp(0, 2)
    a.jgt("_rt_al_oom")
    a.load(0, 15, -40)
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_al_oom")
    a.vm_cbz(0, "_rt_jn_sep_ok")
    a.load(1, 15, -32)
    a.vm_cbz(1, "_rt_al_oom")
    a.add(2, 1, 0)
    a.cmp(2, 1)
    a.jae("_rt_jn_sep_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_jn_sep_ok")
    a.vm_mov_imm(0, 0)
    a.vm_mov_imm(1, 0)
    a.store(15, -48, 1)
    a.label("_rt_jn_sum")
    a.load(2, 15, -24)
    a.cmp(0, 2)
    a.jge("_rt_jn_sumd")
    a.vm_mov_imm(4, 24)
    a.mul(3, 0, 4)
    a.load(4, 15, -16)
    a.add(4, 4, 3)
    a.load(3, 4, 8)
    a.vm_cmp_imm(3, 0)
    a.jlt("_rt_al_oom")
    a.vm_cbz(3, "_rt_jn_add")
    a.load(5, 4, 0)
    a.vm_cbz(5, "_rt_al_oom")
    a.add(scan_count, 5, 3)
    a.cmp(scan_count, 5)
    a.jae("_rt_jn_add")
    a.jmp("_rt_al_oom")
    a.label("_rt_jn_add")
    a.load(1, 15, -48)
    a.add(2, 1, 3)
    a.cmp(2, 1)
    a.jlt("_rt_al_oom")
    a.store(15, -48, 2)
    a.vm_add_imm(5, 0, 1)
    a.load(scan_count, 15, -24)
    a.cmp(5, scan_count)
    a.jge("_rt_jn_sumi")
    a.load(3, 15, -40)
    a.vm_cbz(3, "_rt_jn_sumi")
    a.add(2, 2, 3)
    a.cmp(2, 3)
    a.jlt("_rt_al_oom")
    a.store(15, -48, 2)
    a.label("_rt_jn_sumi")
    a.vm_add_imm(0, 0, 1)
    a.jmp("_rt_jn_sum")
    a.label("_rt_jn_sumd")
    a.load(0, 15, -48)
    a.vm_cbz(0, "_rt_jn_empty")
    a.mov(18, 0)
    a.call("_rt_alloc")
    a.store(15, -56, 14)
    a.vm_cmp_imm(14, RT_MIN_HEAP_POINTER)
    a.jlt("_rt_al_oom")
    a.vm_mov_imm(0, 0)
    a.load(1, 15, -24)
    a.load(5, 15, -56)
    a.vm_mov_imm(scan_count, 0)
    a.load(9, 15, -16)
    a.label("_rt_jn_loop")
    a.cmp(0, 1)
    a.jge("_rt_jn_done")
    a.vm_cmp_imm(0, 0)
    a.jeq("_rt_jn_nosep")
    a.load(scan_offset, 15, -40)
    a.vm_cbz(scan_offset, "_rt_jn_nosep")
    a.load(3, 15, -32)
    rt_emit_join_copy(a, "sep")
    a.label("_rt_jn_nosep")
    a.vm_mov_imm(4, 24)
    a.mul(scan_offset, 0, 4)
    a.add(copy_dst, 9, scan_offset)
    a.load(3, copy_dst, 0)
    a.load(scan_offset, copy_dst, 8)
    rt_emit_join_copy(a, "pc")
    a.vm_add_imm(0, 0, 1)
    a.jmp("_rt_jn_loop")
    a.label("_rt_jn_done")
    a.load(4, 15, -48)
    a.cmp(scan_count, 4)
    a.jne("_rt_al_oom")
    a.load(0, 15, -8)
    a.load(1, 15, -56)
    a.store(0, 0, 1)
    a.load(1, 15, -48)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_jn_empty")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.cs_pairs = saved_pairs
    <<
}

// NUL-terminated copy: A0/A1 string, result in Ret.
fn rt_emit_cstr(a &mut Assembler) {
    // ptr -8, len -16, buf -24, i -32
    a.label("_rt_cstr")
    a.prologue(32)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.vm_add_imm(18, 19, 1)
    a.cmp(18, 19)
    a.jae("_rt_cs_size_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_cs_size_ok")
    a.call("_rt_alloc")
    a.store(15, -24, 14)
    a.vm_mov_imm(4, 0)
    a.label("_rt_cs_loop")
    a.load(1, 15, -16)
    a.cmp(4, 1)
    a.jge("_rt_cs_done")
    a.load(2, 15, -8)
    a.add(2, 2, 4)
    a.load_byte(5, 2, 0)
    a.load(3, 15, -24)
    a.add(3, 3, 4)
    a.store_byte(3, 0, 5)
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_cs_loop")
    a.label("_rt_cs_done")
    a.load(3, 15, -24)
    a.load(1, 15, -16)
    a.add(3, 3, 1)
    a.vm_mov_imm(5, 0)
    a.store_byte(3, 0, 5)
    a.load(14, 15, -24)
    a.epilogue()
    <<
}

// rt_throw_strerr: A0 = throw-slot sret, A1/A2/A3 = message string.
// Writes Err(errors.Error) with a heap-boxed errors.StrErr payload.
fn rt_emit_throw_strerr(a &mut Assembler) {
    a.label("_rt_throw_strerr")
    a.prologue(48)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    a.store(15, -32, 21)
    a.vm_mov_imm(18, 24)
    a.call("_rt_alloc")
    a.mov(1, 14)
    a.vm_add_imm(1, 1, 16)
    a.load(2, 15, -16)
    a.store(1, 0, 2)
    a.load(2, 15, -24)
    a.store(1, -8, 2)
    a.load(2, 15, -32)
    a.store(1, -16, 2)
    a.load(0, 15, -8)
    a.vm_mov_imm(2, 1)
    a.store(0, 0, 2)
    a.store(0, -8, 1)
    a.lea(2, "_xu_itab_errors_Error_StrErr")
    a.store(0, -16, 2)
    a.epilogue()
    <<
}

fn rt_call_throw_strerr_static(a &mut Assembler, sret_off int, label string, len int) {
    a.load(18, 15, sret_off)
    a.lea(19, label)
    a.vm_mov_imm(20, len)
    a.vm_mov_imm(21, 0)
    a.call("_rt_throw_strerr")
    <<
}

fn rt_call_throw_strerr_frame(a &mut Assembler, sret_off int, msg_off int) {
    a.load(18, 15, sret_off)
    a.load(19, 15, msg_off)
    a.load(20, 15, msg_off - 8)
    a.load(21, 15, msg_off - 16)
    a.call("_rt_throw_strerr")
    <<
}

// Message ptr/len arrive in A0/A1 from rt_errno_msg.
fn rt_call_throw_strerr_args(a &mut Assembler, sret_off int) {
    a.mov(20, 19)
    a.mov(19, 18)
    a.load(18, 15, sret_off)
    a.vm_mov_imm(21, 0)
    a.call("_rt_throw_strerr")
    <<
}
