@main

#xu/types

// Native wait registration adapter, hosted M:N. State: watches@0,
// next_group@8, done@16, reserved@24, G@32, Win CV@40. Watch: next@0, chan@8.
// The select mutex protects lifetime and subscriptions. Lock ordering is
// channel -> select -> scheduler; drop never takes a channel mutex.
// A notification is only a reason to rescan; channel try operations still
// atomically choose/transfer the value. No speculative send is published.
fn rt_emit_select_helpers(a &mut Assembler, timed bool) {
    a.label("_rt_select_new")
    a.prologue(16)
    a.call("_rt_g_self")
    a.store(15, -16, 14)
    a.vm_mov_imm(18, rt_select_state_bytes)
    a.call("_rt_alloc")
    a.store(15, -8, 14)
    a.vm_mov_imm(1, 0)
    a.store(14, 0, 1)
    a.store(14, rt_select_done_offset, 1)
    a.store(14, rt_select_reserved_offset, 1)
    a.store(14, rt_select_cv_offset, 1)
    a.load(1, 15, -16)
    a.store(14, rt_select_g_offset, 1)
    a.lea(18, "_rt_select_lock")
    rt_os_mutex_lock(a)
    a.lea(0, "_rt_select_groups")
    a.load(1, 0, 0)
    a.load(2, 15, -8)
    a.store(2, rt_select_next_offset, 1)
    a.store(0, 0, 2)
    a.lea(18, "_rt_select_lock")
    rt_os_mutex_unlock(a)
    a.load(14, 15, -8)
    a.epilogue()

    a.label("_rt_select_watch")
    a.prologue(32)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.vm_mov_imm(18, rt_select_watch_bytes)
    a.call("_rt_alloc")
    a.store(15, -24, 14)
    a.lea(18, "_rt_select_lock")
    rt_os_mutex_lock(a)
    a.load(0, 15, -8)
    a.load(1, 0, 0)
    a.load(2, 15, -24)
    a.store(2, 0, 1)
    a.load(1, 15, -16)
    a.store(2, rt_select_watch_channel_offset, 1)
    a.store(0, 0, 2)
    a.lea(18, "_rt_select_lock")
    rt_os_mutex_unlock(a)
    a.epilogue()

    a.label("_rt_select_notify")
    a.prologue(48)
    a.store(15, -8, 18)
    a.lea(18, "_rt_select_lock")
    rt_os_mutex_lock(a)
    a.lea(0, "_rt_select_groups")
    a.load(0, 0, 0)
    a.label("_rt_sel_n_group")
    a.vm_cbz(0, "_rt_sel_n_done")
    a.store(15, -16, 0)
    a.vm_add_imm(2, 0, rt_select_done_offset)
    a.vm_atomic_load(1, 2)
    a.vm_cbnz(1, "_rt_sel_n_next")
    a.load(1, 0, 0)
    a.label("_rt_sel_n_watch")
    a.vm_cbz(1, "_rt_sel_n_next")
    a.load(2, 1, rt_select_watch_channel_offset)
    a.load(3, 15, -8)
    a.cmp(2, 3)
    a.jeq("_rt_sel_n_wake")
    a.load(1, 1, 0)
    a.jmp("_rt_sel_n_watch")
    a.label("_rt_sel_n_wake")
    a.load(0, 15, -16)
    a.vm_add_imm(2, 0, rt_select_done_offset)
    a.vm_mov_imm(1, 1)
    a.vm_atomic_store(2, 1)
    a.load(18, 0, rt_select_g_offset)
    // Keep the lifetime lock held through ready(): the owner cannot free
    // this group while a notifier is still using its G pointer.
    a.call("_rt_ready")
    a.load(0, 15, -16)
    if a.os == 2 {
        a.vm_add_imm(18, 0, rt_select_cv_offset)
        a.vm_call_iat("_iat_WakeAllConditionVariable")
    } else {
        a.vm_add_imm(4, 0, rt_select_done_offset)
        rt_os_word_wake(a, 1)
    }
    a.label("_rt_sel_n_next")
    a.load(0, 15, -16)
    a.load(0, 0, rt_select_next_offset)
    a.jmp("_rt_sel_n_group")
    a.label("_rt_sel_n_done")
    a.lea(18, "_rt_select_lock")
    rt_os_mutex_unlock(a)
    a.epilogue()

    a.label("_rt_select_drop")
    a.prologue(32)
    a.store(15, -8, 18)
    a.lea(18, "_rt_select_lock")
    rt_os_mutex_lock(a)
    a.lea(0, "_rt_select_groups")
    a.label("_rt_sel_d_find")
    a.load(1, 0, 0)
    a.vm_cbz(1, "_rt_sel_d_unlinked")
    a.load(2, 15, -8)
    a.cmp(1, 2)
    a.jeq("_rt_sel_d_found")
    a.vm_add_imm(0, 1, rt_select_next_offset)
    a.jmp("_rt_sel_d_find")
    a.label("_rt_sel_d_found")
    a.load(1, 1, rt_select_next_offset)
    a.store(0, 0, 1)
    a.label("_rt_sel_d_unlinked")
    a.lea(18, "_rt_select_lock")
    rt_os_mutex_unlock(a)
    a.load(0, 15, -8)
    a.load(0, 0, 0)
    a.label("_rt_sel_d_free")
    a.vm_cbz(0, "_rt_sel_d_state")
    a.load(1, 0, 0)
    a.store(15, -16, 1)
    a.mov(18, 0)
    a.call("_rt_free")
    a.load(0, 15, -16)
    a.jmp("_rt_sel_d_free")
    a.label("_rt_sel_d_state")
    a.load(18, 15, -8)
    a.call("_rt_free")
    a.epilogue()
    if timed { rt_emit_wait_cancel(a) }
}

// A0=chan int, A1=relative ns -> Ret=1 if readable/closed, 0 if expired.
// Readiness is observed without receiving a value. Only the existing worker
// blocks; stop/close wakes its kernel wait. A timer heap / syscall worker
// replacement is a separate scheduler capability, not claimed by this seam.
fn rt_emit_wait_cancel(a &mut Assembler) {
    a.label("_rt_wait_cancel")
    a.prologue(80)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.call("_rt_now_ns")
    a.load(1, 15, -16)
    a.vm_cmp_imm(1, 0)
    a.jle("_rt_wc_poll")
    a.vm_mov_imm64(2, 9223372036854775807)
    a.sub(3, 2, 14)
    a.cmp(1, 3)
    a.jgt("_rt_wc_saturate")
    a.add(2, 14, 1)
    a.label("_rt_wc_saturate")
    a.store(15, -16, 2) // absolute monotonic deadline
    a.label("_rt_wc_loop")
    a.call("_rt_select_new")
    a.store(15, -24, 14)
    a.mov(18, 14)
    a.load(19, 15, -8)
    a.call("_rt_select_watch")
    rt_mc_lock(a)
    rt_wait_cancel_readiness(a, "_rt_wc_observed")
    a.store(15, -32, 1)
    rt_mc_unlock(a)
    a.load(1, 15, -32)
    a.vm_cbnz(1, "_rt_wc_ready")
    a.call("_rt_now_ns")
    a.load(1, 15, -16)
    a.sub(1, 1, 14)
    a.vm_cmp_imm(1, 0)
    a.jle("_rt_wc_expired")
    a.store(15, -32, 1)
    a.call("_rt_enter_syscall")
    // Migration to an available worker can take time; recompute the budget
    // after it, instead of arming the kernel with a stale relative timeout.
    a.call("_rt_now_ns")
    a.load(1, 15, -16)
    a.sub(1, 1, 14)
    a.vm_cmp_imm(1, 0)
    a.jle("_rt_wc_expired")
    a.store(15, -32, 1)
    if a.os == 0 {
        // __ulock_wait uses uint32 microseconds; ceil and cap the adapter
        // interval. Kernel timeout/spurious wake always rechecks deadline.
        a.load(0, 15, -32)
        a.vm_mov_imm(1, time_ns_per_microsecond)
        a.div(2, 0, 1)
        a.imod(3, 0, 1)
        a.vm_cbz(3, "_rt_wc_us")
        a.vm_add_imm(2, 2, 1)
        a.label("_rt_wc_us")
        a.vm_mov_imm64(1, 4294967295)
        a.cmp(2, 1)
        a.jle("_rt_wc_us_cap")
        a.mov(2, 1)
        a.label("_rt_wc_us_cap")
        a.mov(21, 2)
        a.vm_mov_imm(18, 5)
        a.load(19, 15, -24)
        a.vm_add_imm(19, 19, rt_select_done_offset)
        a.vm_mov_imm(20, 0)
        a.vm_syscall(syscall_number(a.os, a.arch, 33))
    } else if a.os == 1 {
        a.load(0, 15, -32)
        a.vm_mov_imm(1, time_ns_per_second)
        a.div(2, 0, 1)
        a.imod(3, 0, 1)
        a.store(15, -48, 2)
        a.store(15, -40, 3)
        a.load(18, 15, -24)
        a.vm_add_imm(18, 18, rt_select_done_offset)
        a.vm_mov_imm(19, 128)
        a.vm_mov_imm(20, 0)
        a.mov(21, 15)
        a.vm_sub_imm(21, 21, 48)
        a.vm_mov_imm(22, 0)
        a.vm_mov_imm(23, 0)
        a.vm_syscall(syscall_number(a.os, a.arch, 8))
    } else {
        // The existing Win SRW/CV imports provide atomic unlock-and-wait.
        a.lea(18, "_rt_select_lock")
        rt_os_mutex_lock(a)
        a.load(0, 15, -24)
        a.vm_add_imm(2, 0, rt_select_done_offset)
        a.vm_atomic_load(1, 2)
        a.vm_cbnz(1, "_rt_wc_win_unlock")
        a.load(0, 15, -32)
        a.vm_mov_imm(1, time_ns_per_millisecond)
        a.div(2, 0, 1)
        a.imod(3, 0, 1)
        a.vm_cbz(3, "_rt_wc_ms")
        a.vm_add_imm(2, 2, 1)
        a.label("_rt_wc_ms")
        a.vm_mov_imm64(1, 4294967294) // 0xFFFFFFFF is INFINITE
        a.cmp(2, 1)
        a.jle("_rt_wc_ms_cap")
        a.mov(2, 1)
        a.label("_rt_wc_ms_cap")
        a.mov(20, 2)
        a.load(18, 15, -24)
        a.vm_add_imm(18, 18, rt_select_cv_offset)
        a.lea(19, "_rt_select_lock")
        a.vm_mov_imm(21, 0)
        a.vm_call_iat("_iat_SleepConditionVariableSRW")
        a.label("_rt_wc_win_unlock")
        a.lea(18, "_rt_select_lock")
        rt_os_mutex_unlock(a)
    }
    a.load(18, 15, -24)
    a.call("_rt_select_drop")
    a.jmp("_rt_wc_loop")
    a.label("_rt_wc_ready")
    a.load(18, 15, -24)
    a.call("_rt_select_drop")
    a.vm_mov_imm(14, 1)
    a.epilogue()
    a.label("_rt_wc_expired")
    a.load(18, 15, -24)
    a.call("_rt_select_drop")
    a.vm_mov_imm(14, 0)
    a.epilogue()
    a.label("_rt_wc_poll")
    rt_mc_lock(a)
    rt_wait_cancel_readiness(a, "_rt_wc_polled")
    a.store(15, -32, 1)
    rt_mc_unlock(a)
    a.load(14, 15, -32)
    a.vm_cbz(14, "_rt_wc_poll_out")
    a.vm_mov_imm(14, 1)
    a.label("_rt_wc_poll_out")
    a.epilogue()
}

// Under the channel mutex, observe buffered data, close, or a queued normal
// sender. The latter makes an unbuffered channel readable without consuming
// its payload. A queued receiver is not a cancellation event.
fn rt_wait_cancel_readiness(a &mut Assembler, ready string) {
    a.load(0, 15, -8)
    a.load(1, 0, rt_chan_mc_length_offset)
    a.load(2, 0, rt_chan_mc_closed_offset)
    a.add(1, 1, 2)
    a.vm_cbnz(1, ready + "")
    a.load(2, 0, rt_chan_mc_wait_head_offset)
    a.vm_cbz(2, ready + "")
    a.load(2, 2, rt_wn_kind_offset)
    a.vm_cmp_imm(2, rt_wn_kind_recv)
    a.jeq(ready + "")
    a.vm_mov_imm(1, 1)
    a.label(ready)
}
