@main

// XACP's runtime seam carries bytes only; schema, escaping and pagination
// envelopes belong to src/xacp. No hook is emitted in ordinary builds.
fn xacp_output_supported(a &Assembler) bool {
    << a.xacp && (a.os == 0 || a.os == 1) && ptr_bytes(a.arch) == 8
}

fn rt_emit_xacp_output(a $&Assembler) {
    if !xacp_output_supported(&*a) {
        a.label("_rt_xacp_output_init")
        a.prologue(0)
        a.vm_mov_imm(14, -1)
        a.epilogue()
        a.label("_rt_xacp_output_read")
        a.prologue(0)
        a.vm_mov_imm(1, 0)
        a.store(0, 0, 1)
        a.store(0, -8, 1)
        a.store(0, -16, 1)
        a.epilogue()
        <<
    }
    // mu, capacity, two adjacent rings, stdout total, stderr total, control fd.
    // Process lifetime storage, allocated only on adapter activation. All
    // accesses, including activation, use the same runtime mutex.
    a.align_data(8)
    a.data_label("_rt_xacp_output")
    rt_emit_zeros(a, 48)
    rt_emit_xacp_output_init(a)
    rt_emit_xacp_output_append(a)
    rt_emit_xacp_output_read(a)
}

fn rt_emit_xacp_output_init(a $&Assembler) {
    a.label("_rt_xacp_output_init")
    a.prologue(32)
    a.vm_cmp_imm(18, 4096)
    a.jlt("_rt_xoi_invalid")
    a.vm_cmp_imm(18, 16777216)
    a.jgt("_rt_xoi_invalid")
    a.store(15, -8, 18)
    a.lea(18, "_rt_xacp_output")
    rt_os_mutex_lock(a)
    a.lea(0, "_rt_xacp_output")
    a.load(1, 0, 8)
    a.vm_cbnz(1, "_rt_xoi_existing")
    a.lea(18, "_rt_xacp_output")
    rt_os_mutex_unlock(a)
    // Allocate outside the output lock: allocator diagnostics use _rt_write.
    a.load(18, 15, -8)
    a.shl_imm(18, 18, 1)
    a.call("_rt_alloc")
    a.store(15, -16, 14)
    a.lea(18, "_rt_xacp_output")
    rt_os_mutex_lock(a)
    a.lea(0, "_rt_xacp_output")
    a.load(1, 0, 8)
    a.vm_cbnz(1, "_rt_xoi_raced")
    // F_DUPFD_CLOEXEC gives stdio control its own fd, bypassing fd1/2 hooks.
    // Linux generic fcntl=25; x64=72. Darwin fcntl=92, command=67.
    a.vm_mov_imm(18, 1)
    a.vm_mov_imm(19, 1030)
    a.vm_mov_imm(20, 3)
    $fcntl_sys := 25
    if a.arch == 1 { fcntl_sys = 72 }
    if a.os == 0 { fcntl_sys = 33554524
        a.vm_mov_imm(19, 67) }
    a.vm_syscall(fcntl_sys)
    a.vm_normalize_syscall("_rt_xoi_dup")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_xoi_dup_failed")
    a.lea(0, "_rt_xacp_output")
    a.store(0, 40, 14)
    a.load(1, 15, -16)
    a.store(0, 16, 1)
    a.load(1, 15, -8)
    a.store(0, 8, 1)
    a.jmp("_rt_xoi_existing")
    a.label("_rt_xoi_dup_failed")
    a.vm_mov_imm(14, -1)
    a.store(15, -24, 14)
    a.jmp("_rt_xoi_free")
    a.label("_rt_xoi_raced")
    a.load(14, 0, 40)
    a.store(15, -24, 14)
    a.label("_rt_xoi_free")
    a.lea(18, "_rt_xacp_output")
    rt_os_mutex_unlock(a)
    a.load(18, 15, -16)
    a.call("_rt_free")
    a.load(14, 15, -24)
    a.epilogue()
    a.label("_rt_xoi_existing")
    a.load(1, 0, 40)
    a.store(15, -24, 1)
    a.lea(18, "_rt_xacp_output")
    rt_os_mutex_unlock(a)
    a.load(14, 15, -24)
    a.epilogue()
    a.label("_rt_xoi_invalid")
    a.vm_mov_imm(14, -1)
    a.epilogue()
}

// A0=fd, A1=ptr, A2=successfully written byte count. Never does I/O, allocates,
// or waits for space. Oversized writes copy only their newest capacity bytes.
fn rt_emit_xacp_output_append(a $&Assembler) {
    a.label("_rt_xacp_output_append")
    a.prologue(32)
    a.vm_cmp_imm(18, 1)
    a.jlt("_rt_xoa_done")
    a.vm_cmp_imm(18, 2)
    a.jgt("_rt_xoa_done")
    a.vm_cmp_imm(20, 0)
    a.jle("_rt_xoa_done")
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    a.lea(18, "_rt_xacp_output")
    rt_os_mutex_lock(a)
    a.lea(0, "_rt_xacp_output")
    a.load(1, 0, 8) // capacity
    a.vm_cbz(1, "_rt_xoa_unlock")
    a.load(2, 0, 16) // ring
    a.load(3, 15, -8)
    a.vm_cmp_imm(3, 2)
    a.jne("_rt_xoa_stdout")
    a.add(2, 2, 1)
    a.vm_add_imm(0, 0, 8) // select stderr total
    a.label("_rt_xoa_stdout")
    a.load(3, 0, 24) // old total
    a.load(4, 15, -24)
    a.add(5, 3, 4)
    a.store(0, 24, 5) // publish new total under lock
    a.load(19, 15, -16)
    a.cmp(4, 1)
    a.jle("_rt_xoa_copy_start")
    a.sub(21, 4, 1)
    a.add(19, 19, 21)
    a.add(3, 3, 21)
    a.mov(4, 1)
    a.label("_rt_xoa_copy_start")
    a.imod(3, 3, 1)
    a.label("_rt_xoa_copy")
    a.load_byte(5, 19, 0)
    a.add(21, 2, 3)
    a.store_byte(21, 0, 5)
    a.vm_add_imm(19, 19, 1)
    a.vm_add_imm(3, 3, 1)
    a.cmp(3, 1)
    a.jlt("_rt_xoa_nowrap")
    a.vm_mov_imm(3, 0)
    a.label("_rt_xoa_nowrap")
    a.vm_sub_imm(4, 4, 1)
    a.vm_cbnz(4, "_rt_xoa_copy")
    a.label("_rt_xoa_unlock")
    a.lea(18, "_rt_xacp_output")
    rt_os_mutex_unlock(a)
    a.label("_rt_xoa_done")
    a.epilogue()
}

// A0=fd (1/2), A1=requested absolute since, A2=max bytes, V0=sret string.
// Private wire ABI: LE64 base, LE64 total, followed by the copied window.
// Empty string means capture unavailable. The stdlib checks since>total.
fn rt_emit_xacp_output_read(a $&Assembler) {
    a.label("_rt_xacp_output_read")
    a.prologue(64)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.store(15, -32, 20)
    a.vm_cmp_imm(18, 1)
    a.jlt("_rt_xor_empty")
    a.vm_cmp_imm(18, 2)
    a.jgt("_rt_xor_empty")
    a.vm_cmp_imm(19, 0)
    a.jlt("_rt_xor_empty")
    a.vm_cmp_imm(20, 1)
    a.jlt("_rt_xor_empty")
    a.vm_cmp_imm(20, 1048576)
    a.jgt("_rt_xor_empty")
    // Allocate before taking the mutex; serialization also happens unlocked.
    a.vm_add_imm(18, 20, 16)
    a.call("_rt_alloc")
    a.store(15, -40, 14)
    a.lea(18, "_rt_xacp_output")
    rt_os_mutex_lock(a)
    a.lea(0, "_rt_xacp_output")
    a.load(1, 0, 8) // capacity
    a.vm_cbz(1, "_rt_xor_disabled")
    a.load(2, 0, 16) // ring
    a.load(3, 15, -16)
    a.vm_cmp_imm(3, 2)
    a.jne("_rt_xor_stdout")
    a.add(2, 2, 1)
    a.vm_add_imm(0, 0, 8)
    a.label("_rt_xor_stdout")
    a.load(3, 0, 24) // total
    a.vm_mov_imm(4, 0) // base
    a.cmp(3, 1)
    a.jle("_rt_xor_base")
    a.sub(4, 3, 1)
    a.label("_rt_xor_base")
    a.load(0, 15, -40)
    a.store(0, 0, 4)
    a.store(0, 8, 3)
    a.load(5, 15, -24) // actual since=max(requested,base)
    a.cmp(5, 4)
    a.jge("_rt_xor_since")
    a.mov(5, 4)
    a.label("_rt_xor_since")
    a.vm_mov_imm(22, 0) // count
    a.cmp(5, 3)
    a.jge("_rt_xor_count")
    a.sub(22, 3, 5)
    a.load(23, 15, -32)
    a.cmp(22, 23)
    a.jle("_rt_xor_count")
    a.mov(22, 23)
    a.label("_rt_xor_count")
    a.vm_add_imm(23, 22, 16)
    a.store(15, -48, 23) // snapshot length
    a.vm_cbz(22, "_rt_xor_unlock")
    a.imod(5, 5, 1)
    a.vm_add_imm(0, 0, 16)
    a.label("_rt_xor_copy")
    a.add(23, 2, 5)
    a.load_byte(4, 23, 0)
    a.store_byte(0, 0, 4)
    a.vm_add_imm(0, 0, 1)
    a.vm_add_imm(5, 5, 1)
    a.cmp(5, 1)
    a.jlt("_rt_xor_nowrap")
    a.vm_mov_imm(5, 0)
    a.label("_rt_xor_nowrap")
    a.vm_sub_imm(22, 22, 1)
    a.vm_cbnz(22, "_rt_xor_copy")
    a.label("_rt_xor_unlock")
    a.lea(18, "_rt_xacp_output")
    rt_os_mutex_unlock(a)
    a.load(0, 15, -8)
    a.load(1, 15, -40)
    a.store(0, 0, 1)
    a.load(1, 15, -48)
    a.store(0, -8, 1)
    a.load(1, 15, -32)
    a.vm_add_imm(1, 1, 16)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_xor_disabled")
    a.lea(18, "_rt_xacp_output")
    rt_os_mutex_unlock(a)
    a.load(18, 15, -40)
    a.call("_rt_free")
    a.label("_rt_xor_empty")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
}
