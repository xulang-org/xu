}

fn rt_emit_map_copy_out_val(a $&Assembler) {
    a.label("_rt_map_copy_out_val")
    a.prologue(80)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    a.store(15, -32, 21)
    a.load(0, 18, 56)
    a.vm_cbz(0, "_rt_cov_1")
    a.vm_cmp_imm(0, 1)
    a.jeq("_rt_cov_str")
    a.call("_rt_map_vstride")
    a.store(15, -40, 14)
    a.load(0, 15, -8)
