// ARM64 scalar int/int get (fastpath):
// A0 (18) = handle, A1 (19) = key
// Returns value in Ret (14 / X0)
// 100% stackless leaf using hardware scaled addressing.
fn rt_emit_map_get_scalar_ii(a $&Assembler) {
    a.label("_rt_map_get_scalar_ii")
    a.vm_cbz(18, "_rt_map_miss")

    // Check cap:
    a.load(0, 18, 16)               // X8 = cap
    a.vm_cbz(0, "_rt_map_miss")

    // Setup mask and table pointers:
    a.vm_sub_imm(7, 0, 1)           // X15 = mask = cap - 1
    a.load(4, 18, 24)               // X12 = ctrl_ptr
    a.load(5, 18, 32)               // X13 = keys_ptr
    a.load(6, 18, 40)               // X14 = vals_ptr
    a.load(1, 18, 0)                // X9  = seed

    // Hash computation:
    // dest=14 (X0), key=19 (X1), seed=1 (X9), scratch1=0 (X8), scratch2=2 (X10)
    rt_emit_map_hash_int_inline(a, 14, 19, 1, 0, 2)

    // Compute ctrl_byte (X4 = (hash >> 57) + 128):
    rt_map_ctrl_from_hash(a, 22, 0) // dest = 22 (X4)

    // Initial slot:
    a.iand(1, 14, 7)                // X9  = slot = hash & mask
    a.mov(2, 1)                     // X10 = orig_slot = slot

    a.label("_rt_gsi_loop")
    // Load ctrl_byte at slot:
    a.load_scaled(0, 4, 1, 1)       // X8 = ctrl_ptr[slot]
    a.vm_cbz(0, "_rt_map_miss")     // if empty (0), key not found

    a.cmp(0, 22)                    // ctrl == ctrl_byte?
    a.jne("_rt_gsi_next")

    // Match ctrl_byte: check keys_ptr[slot] == key:
    a.load_scaled(0, 5, 1, 8)       // X8 = keys_ptr[slot]
    a.cmp(0, 19)                    // keys_ptr[slot] == key?
    a.jne("_rt_gsi_next")

    // Key match! Load vals_ptr[slot] into Ret (14, X0):
    a.load_scaled(14, 6, 1, 8)      // X0 = vals_ptr[slot]
    a.ret()                         // Leaf return!

    a.label("_rt_gsi_next")
    a.vm_add_imm(1, 1, 1)
    a.iand(1, 1, 7)                 // slot = (slot + 1) & mask
    a.cmp(1, 2)                     // wrapped around to orig_slot?
    a.jne("_rt_gsi_loop")
    a.jmp("_rt_map_miss")
    <<
}

fn rt_emit_map_insert_ii(a $&Assembler) {
    a.label("_rt_map_insert_ii")
    a.prologue(0)
    a.mov(8, 18)
    a.load(9, 19, 0)
    a.mov(10, 20)
    a.label("_rt_iii_top")
    // Native storage guarantees 0 <= used <= cap and power-of-two cap.
    // Below 75% occupancy the ordinary policy always returns keep; avoid
    // unpacking three arguments and making that call on every insertion.
    // At/above the threshold retain the shared grow/compact policy exactly.
    a.load(0, 8, 16)
    a.shr_imm(1, 0, 2)
    a.sub(0, 0, 1)
    a.load(1, 8, 80)
    a.cmp(1, 0)
    a.jlt("_rt_iii_find")
    a.mov(18, 8)
    rt_map_call_insert_action(a)
    // ARM64 Ret aliases A0: retain the scalar action before restoring handle.
    a.mov(0, 14)
    a.mov(18, 8)
    a.vm_cmp_imm(0, 0)
    a.jeq("_rt_iii_find")
    a.vm_cmp_imm(0, 2)
    a.jeq("_rt_iii_compact")
    a.call("_rt_map_grow")
    a.jmp("_rt_iii_find")
    a.label("_rt_iii_compact")
    a.call("_rt_map_compact")
    a.label("_rt_iii_find")
    a.load(1, 8, 0)
    rt_emit_map_hash_int_inline(a, 14, 9, 1, 0, 2)
    rt_map_ctrl_from_hash(a, 5, 0)
    a.load(0, 8, 16)
    a.vm_sub_imm(11, 0, 1)
    a.load(12, 8, 24)
    a.load(13, 8, 32)
    a.load(6, 8, 40)
    a.vm_mov_imm(7, 0 - 1)
    a.iand(1, 14, 11)
    a.mov(2, 1)
    a.label("_rt_iii_loop")
    a.add(0, 12, 1)
    a.load_byte(0, 0, 0)
    a.vm_cbnz(0, "_rt_iii_live")
    a.vm_cmp_imm(7, 0 - 1)
    a.jeq("_rt_iii_place")
    a.mov(1, 7)
    a.jmp("_rt_iii_place")
    a.label("_rt_iii_live")
    a.vm_cmp_imm(0, 2)
    a.jne("_rt_iii_eq")
    a.vm_cmp_imm(7, 0 - 1)
    a.jne("_rt_iii_next")
    a.mov(7, 1)
    a.jmp("_rt_iii_next")
    a.label("_rt_iii_eq")
    a.cmp(0, 5)
    a.jne("_rt_iii_next")
    a.shl_imm(3, 1, 3)
    a.add(0, 13, 3)
    a.load(0, 0, 0)
    a.cmp(0, 9)
    a.jne("_rt_iii_next")
    a.jmp("_rt_iii_storev")
    a.label("_rt_iii_next")
    a.vm_add_imm(1, 1, 1)
    a.iand(1, 1, 11)
    a.cmp(1, 2)
    a.jne("_rt_iii_loop")
    a.vm_cmp_imm(7, 0 - 1)
    a.jeq("_rt_iii_full")
    a.mov(1, 7)
    a.jmp("_rt_iii_place")
    a.label("_rt_iii_full")
    a.mov(18, 8)
    a.call("_rt_map_grow")
    a.jmp("_rt_iii_top")
    a.label("_rt_iii_place")
    a.add(0, 12, 1)
    a.load_byte(0, 0, 0)
    a.vm_cbz(0, "_rt_iii_new_used")
    a.load(0, 8, 88)
    a.vm_sub_imm(0, 0, 1)
    a.store(8, 88, 0)
    a.jmp("_rt_iii_counted")
    a.label("_rt_iii_new_used")
    a.load(0, 8, 80)
    a.vm_add_imm(0, 0, 1)
    a.store(8, 80, 0)
    a.label("_rt_iii_counted")
    a.shl_imm(3, 1, 3)
    a.add(0, 13, 3)
    a.store(0, 0, 9)
    a.add(0, 12, 1)
    a.store_byte(0, 0, 5)
    a.load(0, 8, 8)
    a.vm_add_imm(0, 0, 1)
    a.store(8, 8, 0)
    a.label("_rt_iii_storev")
    a.shl_imm(3, 1, 3)
    a.add(0, 6, 3)
    a.load(4, 10, 0)
    a.store(0, 0, 4)
    a.epilogue()
    <<
}

// ARM64 scalar int/int insert (fastpath):
// A0 (18) = handle, A1 (19) = key, A2 (20) = val
// Uses ONLY caller-saved registers: 18..23 (X0..X5) and 0..7 (X8..X15).
// When used < threshold (75% load factor), inserts directly in registers
// with zero stack frames and zero stack memory traffic!
fn rt_emit_map_insert_scalar_ii(a $&Assembler) {
    a.label("_rt_map_insert_scalar_ii")

    // Move handle to caller-saved register 21 (X3) so 18/14 (X0) is free:
    a.mov(21, 18)

    // Fastpath check: occupancy < 75% and cap > 0
    a.load(0, 21, 16)               // X8 = cap
    a.vm_cbz(0, "_rt_msi_slow")     // if cap == 0 -> slow path
    a.shr_imm(1, 0, 2)              // X9 = cap >> 2
    a.sub(1, 0, 1)                  // X9 = threshold = cap - (cap >> 2)
    a.load(2, 21, 80)               // X10 = used
    a.cmp(2, 1)
    a.jge("_rt_msi_slow")           // if used >= threshold -> slow path

    // Fastpath: table has capacity; insert/overwrite completely in registers!
    // Setup mask and pointers:
    a.vm_sub_imm(7, 0, 1)           // X15 = mask = cap - 1
    a.load(4, 21, 24)               // X12 = ctrl_ptr
    a.load(5, 21, 32)               // X13 = keys_ptr
    a.load(6, 21, 40)               // X14 = vals_ptr
    a.load(1, 21, 0)                // X9  = seed

    // Hash computation:
    // dest=14 (X0), key=19 (X1), seed=1 (X9), scratch1=0 (X8), scratch2=2 (X10)
    rt_emit_map_hash_int_inline(a, 14, 19, 1, 0, 2)

    // Compute ctrl_byte (X4 = (hash >> 57) + 128):
    rt_map_ctrl_from_hash(a, 22, 0) // dest = 22 (X4)

    // Initial probe slot & tombstone state:
    a.iand(1, 14, 7)                // X9  = slot = hash & mask
    a.mov(2, 1)                     // X10 = orig_slot = slot
    a.vm_mov_imm(3, 0 - 1)          // X11 = first_tomb = -1

    a.label("_rt_msi_loop")
    // Probe control byte using load_scaled:
    a.load_scaled(0, 4, 1, 1)       // X8 = ctrl_ptr[slot]
    a.vm_cbnz(0, "_rt_msi_live")

    // Empty slot (ctrl == 0): insert here!
    a.vm_cmp_imm(3, 0 - 1)
    a.jeq("_rt_msi_place")
    a.mov(1, 3)                     // use first tombstone if available
    a.jmp("_rt_msi_place")

    a.label("_rt_msi_live")
    a.vm_cmp_imm(0, 2)              // tombstone (ctrl == 2)?
    a.jne("_rt_msi_chk_key")

    // Tombstone encountered: remember first tombstone:
    a.vm_cmp_imm(3, 0 - 1)
    a.jne("_rt_msi_next")
    a.mov(3, 1)                     // first_tomb = slot
    a.jmp("_rt_msi_next")

    // Live slot: check control byte match:
    a.label("_rt_msi_chk_key")
    a.cmp(0, 22)                    // ctrl == ctrl_byte?
    a.jne("_rt_msi_next")

    // Check key match using load_scaled:
    a.load_scaled(0, 5, 1, 8)       // X8 = keys_ptr[slot]
    a.cmp(0, 19)                    // keys_ptr[slot] == key?
    a.jne("_rt_msi_next")

    // Key match! Overwrite existing value in vals_ptr[slot]:
    a.store_scaled(6, 1, 20, 8)     // vals_ptr[slot] = val
    a.ret()                         // Leaf return!

    // Probe next slot:
    a.label("_rt_msi_next")
    a.vm_add_imm(1, 1, 1)
    a.iand(1, 1, 7)                 // slot = (slot + 1) & mask
    a.cmp(1, 2)                     // wrapped around to orig_slot?
    a.jne("_rt_msi_loop")

    // Clustered full: if tombstone found, use it; else slowpath to grow:
    a.vm_cmp_imm(3, 0 - 1)
    a.jne("_rt_msi_use_tomb")
    a.jmp("_rt_msi_slow")

    a.label("_rt_msi_use_tomb")
    a.mov(1, 3)

    // Place new key/value at slot (X9):
    a.label("_rt_msi_place")
    a.load_scaled(0, 4, 1, 1)       // X8 = ctrl_ptr[slot]
    a.vm_cbz(0, "_rt_msi_new_used")

    // Recycling a tombstone: decrement tombstones (handle[88] -= 1):
    a.load(0, 21, 88)
    a.vm_sub_imm(0, 0, 1)
    a.store(21, 88, 0)
    a.jmp("_rt_msi_store_kv")

    // Brand new slot: increment used (handle[80] += 1):
    a.label("_rt_msi_new_used")
    a.load(0, 21, 80)
    a.vm_add_imm(0, 0, 1)
    a.store(21, 80, 0)

    a.label("_rt_msi_store_kv")
    a.store_scaled(5, 1, 19, 8)     // keys_ptr[slot] = key
    a.store_scaled(6, 1, 20, 8)     // vals_ptr[slot] = val
    a.store_scaled(4, 1, 22, 1)     // ctrl_ptr[slot] = ctrl_byte

    // Increment len (handle[8] += 1):
    a.load(0, 21, 8)
    a.vm_add_imm(0, 0, 1)
    a.store(21, 8, 0)
    a.ret()                         // Leaf return!

    // Slowpath: framed call to general _rt_map_insert
    a.label("_rt_msi_slow")
    a.prologue(32)
    a.mov(18, 21)                   // A0 = handle
    a.store(15, -8, 19)             // save key on stack
    a.store(15, -16, 20)            // save val on stack
    a.vm_sub_imm(19, 15, 8)         // A1 = &key
    a.vm_sub_imm(20, 15, 16)        // A2 = &val
    a.call("_rt_map_insert")
    a.epilogue()
    <<
}

// ARM64 scalar search preserves the exact linear probe order, seed and hash.
// A0=handle, A1=key; Ret=live slot or -1. Stackless leaf function.
fn rt_emit_map_scalar_methods_ii(a $&Assembler) {
    a.label("_rt_map_find_scalar_ii")
    a.vm_cbz(18, "_rt_fsi_miss")
    a.mov(4, 18)
    a.mov(6, 19)
    a.load(1, 4, 0)
    rt_emit_map_hash_int_inline(a, 14, 6, 1, 0, 2)
    rt_map_ctrl_from_hash(a, 23, 0)
    a.load(0, 4, 16)
    a.vm_cbz(0, "_rt_fsi_miss")
    a.vm_sub_imm(7, 0, 1)
    a.load(20, 4, 24)
    a.load(21, 4, 32)
    a.iand(1, 14, 7)
    a.mov(2, 1)
    a.label("_rt_fsi_loop")
    a.load_scaled(0, 20, 1, 1)
    a.vm_cbz(0, "_rt_fsi_miss")
    a.cmp(0, 23)
    a.jne("_rt_fsi_next")
    a.load_scaled(0, 21, 1, 8)
    a.cmp(0, 6)
    a.jne("_rt_fsi_next")
    a.mov(14, 1)
    a.ret()
    a.label("_rt_fsi_next")
    a.vm_add_imm(1, 1, 1)
    a.iand(1, 1, 7)
    a.cmp(1, 2)
    a.jne("_rt_fsi_loop")
    a.label("_rt_fsi_miss")
    a.vm_mov_imm(14, 0 - 1)
    a.ret()

    a.label("_rt_map_has_scalar_ii")
    a.prologue(0)
    a.call("_rt_map_find_scalar_ii")
    a.vm_cmp_imm(14, 0)
    a.vm_cset(14, 10)
    a.epilogue()

    a.label("_rt_map_get_or_scalar_ii")
    a.prologue(16)
    a.store(15, -8, 18)
    a.store(15, -16, 20)
    a.call("_rt_map_find_scalar_ii")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_gosi_default")
    a.mov(1, 14)
    a.shl_imm(1, 1, 3)
    a.load(0, 15, -8)
    a.load(0, 0, 40)
    a.add(0, 0, 1)
    a.load(14, 0, 0)
    a.epilogue()
    a.label("_rt_gosi_default")
    a.load(14, 15, -16)
    a.epilogue()

    a.label("_rt_map_delete_scalar_ii")
    a.prologue(16)
    a.store(15, -8, 18)
    a.call("_rt_map_find_scalar_ii")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_dsi_done")
    a.mov(2, 14)
    a.load(0, 15, -8)
    a.load(1, 0, 24)
    a.add(1, 1, 2)
    a.vm_mov_imm(2, 2)
    a.store_byte(1, 0, 2)
    a.load(1, 0, 8)
    a.vm_sub_imm(1, 1, 1)
    a.store(0, 8, 1)
    a.load(1, 0, 88)
    a.vm_add_imm(1, 1, 1)
    a.store(0, 88, 1)
    a.label("_rt_dsi_done")
    a.epilogue()
}

fn rt_emit_map_x64_scalar_ii(a $&Assembler) {
    // _rt_map_get_scalar_ii (x64 fastpath):
    // A0 (7/RDI) = handle, A1 (6/RSI) = key
    // Returns value in RAX (0)
    a.label("_rt_map_get_scalar_ii")
    a.x64_mov_reg(8, 7)
    a.x64_load_offset(8, 8, 0) // R8 = seed

    a.x64_mov_reg(0, 6)
    a.x64_xor_reg(0, 8)

    // Mix 1:
    a.x64_mov_reg(1, 0)
    a.x64_shr_imm(1, 30)
    a.x64_xor_reg(0, 1)

    a.x64_mov_imm64(2, 0 - 4658895280553007687)
    a.x64_imul(0, 2)

    // Mix 2:
    a.x64_mov_reg(1, 0)
    a.x64_shr_imm(1, 27)
    a.x64_xor_reg(0, 1)

    a.x64_mov_imm64(2, 0 - 7723592293110705685)
    a.x64_imul(0, 2)

    // Mix 3:
    a.x64_mov_reg(1, 0)
    a.x64_shr_imm(1, 31)
    a.x64_xor_reg(0, 1)

    // Compute ctrl_byte (R8): (hash >> 57) + 128
    a.x64_mov_reg(8, 0)
    a.x64_shr_imm(8, 57)
    a.x64_add_imm(8, 128)

    // Load cap (handle[16]) -> R9
    a.x64_mov_reg(9, 7)
    a.x64_load_offset(9, 9, 16)
    a.x64_test_reg(9, 9)
    a.x64_jcc(4, "_rt_map_miss") // if cap == 0, miss (JE = 4)
    a.x64_sub_imm(9, 1) // R9 = mask = cap - 1

    // Load ctrl_ptr (handle[24]) -> R10
    a.x64_mov_reg(10, 7)
    a.x64_load_offset(10, 10, 24)

    // Load keys_ptr (handle[32]) -> R11
    a.x64_mov_reg(11, 7)
    a.x64_load_offset(11, 11, 32)

    // Load vals_ptr (handle[40]) -> RDI (7)
    a.x64_load_offset(7, 7, 40)

    // RAX (0) = slot = hash & mask
    a.x64_and_reg(0, 9)
    a.x64_mov_reg(2, 0) // RDX (2) = orig_slot

    a.label("_rt_mg_x64_loop")
    // RCX (1) = ctrl_ptr[slot]
    a.x64_load_byte_sib(1, 10, 0, 0, 0)
    a.x64_test_reg(1, 1)
    a.x64_jcc(4, "_rt_map_miss") // ctrl == 0: miss

    a.x64_cmp_reg(1, 8)
    a.x64_jcc(5, "_rt_mg_x64_next") // 5 = JNE

    // Match ctrl_byte: check keys_ptr[slot] == key (RSI, 6)
    a.x64_load_sib(1, 11, 0, 3, 0)
    a.x64_cmp_reg(1, 6)
    a.x64_jcc(5, "_rt_mg_x64_next")

    // Key match! Load vals_ptr[slot] into RAX (0)
    a.x64_load_sib(0, 7, 0, 3, 0)
    a.x64_ret()

    a.label("_rt_mg_x64_next")
    a.x64_add_imm(0, 1)
    a.x64_and_reg(0, 9)
    a.x64_cmp_reg(0, 2)
    a.x64_jcc(5, "_rt_mg_x64_loop")
    a.x64_jmp("_rt_map_miss")

    // _rt_map_insert_scalar_ii (x64 fastpath):
    // A0 (7/RDI) = handle, A1 (6/RSI) = key, A2 (2/RDX) = val
    a.label("_rt_map_insert_scalar_ii")
    // The generic probe remembers the first tombstone while continuing to
    // search for an existing key. This leaf probe only handles hole-free
    // clusters; stopping at a tombstone would insert a duplicate key.
    a.x64_load_offset(0, 7, 88)
    a.x64_test_reg(0, 0)
    a.x64_jcc(5, "_rt_mi_x64_slow")
    // Check occupancy: used (handle[80]) vs cap - (cap >> 2) (75%)
    a.x64_mov_reg(0, 7)
    a.x64_load_offset(0, 0, 16) // RAX = cap
    a.x64_mov_reg(1, 0)
    a.x64_shr_imm(1, 2)         // RCX = cap >> 2
    a.x64_sub_reg(0, 1)         // RAX = threshold = cap - (cap >> 2)
    a.x64_mov_reg(1, 7)
    a.x64_load_offset(1, 1, 80) // RCX = used (handle[80])
    a.x64_cmp_reg(1, 0)
    a.x64_jcc(12, "_rt_mi_x64_fast") // 12 = JL: if used < threshold, fast path!

    // Slow path: call _rt_map_insert
    a.label("_rt_mi_x64_slow")
    a.x64_push(7) // save handle
    a.x64_push(6) // save key
    a.x64_push(2) // save val
    a.x64_sub_imm(4, 32)
    a.x64_store_offset(4, 0, 6)
    a.x64_store_offset(4, 8, 2)
    a.x64_mov_reg(6, 4)
    a.x64_mov_reg(2, 4)
    a.x64_add_imm(2, 8)
    a.call("_rt_map_insert")
    a.x64_add_imm(4, 32)
    a.x64_pop(2)
    a.x64_pop(6)
    a.x64_pop(7)
    a.x64_ret()

    // Fast path:
    a.label("_rt_mi_x64_fast")
    a.x64_mov_reg(11, 2) // R11 = val

    // Load seed from handle[0] into R8
    a.x64_mov_reg(8, 7)
    a.x64_load_offset(8, 8, 0)

    // Hash computation: RAX = key ^ seed
    a.x64_mov_reg(0, 6)
    a.x64_xor_reg(0, 8)

    // Mix 1:
    a.x64_mov_reg(1, 0)
    a.x64_shr_imm(1, 30)
    a.x64_xor_reg(0, 1)

    a.x64_mov_imm64(2, 0 - 4658895280553007687)
    a.x64_imul(0, 2)

    // Mix 2:
    a.x64_mov_reg(1, 0)
    a.x64_shr_imm(1, 27)
    a.x64_xor_reg(0, 1)

    a.x64_mov_imm64(2, 0 - 7723592293110705685)
    a.x64_imul(0, 2)

    // Mix 3:
    a.x64_mov_reg(1, 0)
    a.x64_shr_imm(1, 31)
    a.x64_xor_reg(0, 1)

    // Compute ctrl_byte (R8): (hash >> 57) + 128
    a.x64_mov_reg(8, 0)
    a.x64_shr_imm(8, 57)
    a.x64_add_imm(8, 128)

    // Load cap (handle[16]) -> R9
    a.x64_mov_reg(9, 7)
    a.x64_load_offset(9, 9, 16)
    a.x64_sub_imm(9, 1) // R9 = mask = cap - 1

    // Load ctrl_ptr (handle[24]) -> R10
    a.x64_mov_reg(10, 7)
    a.x64_load_offset(10, 10, 24)

    // Save handle on stack (8 bytes) so RDI is free for keys/vals pointer
    a.x64_push(7)

    // RAX = slot = hash & mask
    a.x64_and_reg(0, 9)
    a.x64_mov_reg(2, 0) // RDX = orig_slot

    a.label("_rt_mi_x64_probe")
    // RCX (1) = ctrl_ptr[slot]
    a.x64_load_byte_sib(1, 10, 0, 0, 0)
    a.x64_test_reg(1, 1)
    a.x64_jcc(4, "_rt_mi_x64_insert_new") // ctrl == 0: insert here!

    a.x64_cmp_imm(1, 2) // ctrl == 2: deleted slot
    a.x64_jcc(4, "_rt_mi_x64_insert_new")

    a.x64_cmp_reg(1, 8)
    a.x64_jcc(5, "_rt_mi_x64_next")

    // Match ctrl_byte: check keys_ptr[slot] == key
    // Load keys_ptr from [RSP] (handle) -> RDI (7)
    a.x64_mov_reg(7, 4)
    a.x64_load_offset(7, 7, 0) // RDI = handle
    a.x64_load_offset(7, 7, 32) // RDI = keys_ptr
    a.x64_load_sib(1, 7, 0, 3, 0)
    a.x64_cmp_reg(1, 6)
    a.x64_jcc(5, "_rt_mi_x64_next")

    // Key already exists! Overwrite vals_ptr[slot] with val (R11)
    a.x64_mov_reg(7, 4)
    a.x64_load_offset(7, 7, 0) // RDI = handle
    a.x64_load_offset(7, 7, 40) // RDI = vals_ptr
    a.x64_store_sib(7, 0, 11, 3, 0) // vals_ptr[slot] = val
    a.x64_pop(7) // restore handle
    a.x64_ret()

    a.label("_rt_mi_x64_next")
    a.x64_add_imm(0, 1)
    a.x64_and_reg(0, 9)
    a.x64_cmp_reg(0, 2)
    a.x64_jcc(5, "_rt_mi_x64_probe")

    a.x64_pop(7)
    a.x64_ret()

    a.label("_rt_mi_x64_insert_new")
    // Store ctrl_byte into ctrl_ptr[slot]
    a.x64_store_byte_sib(10, 0, 8, 0, 0) // ctrl_ptr[slot] = ctrl_byte

    // Store key into keys_ptr[slot]
    a.x64_mov_reg(7, 4)
    a.x64_load_offset(7, 7, 0) // RDI = handle
    a.x64_load_offset(7, 7, 32) // RDI = keys_ptr
    a.x64_store_sib(7, 0, 6, 3, 0) // keys_ptr[slot] = key

    // Store val into vals_ptr[slot]
    a.x64_mov_reg(7, 4)
    a.x64_load_offset(7, 7, 0) // RDI = handle
    a.x64_load_offset(7, 7, 40) // RDI = vals_ptr
    a.x64_store_sib(7, 0, 11, 3, 0) // vals_ptr[slot] = val

    // Update handle.len (handle[8] += 1) and handle.used (handle[80] += 1)
    a.x64_pop(7) // restore handle into RDI (7)
    a.x64_mov_reg(0, 7)
    a.x64_load_offset(0, 0, 8)
    a.x64_add_imm(0, 1)
    a.x64_store_offset(7, 8, 0)

    a.x64_mov_reg(0, 7)
    a.x64_load_offset(0, 0, 80)
    a.x64_add_imm(0, 1)
    a.x64_store_offset(7, 80, 0)
    a.x64_ret()
}

// Value-argument compatibility adapters keep stats and non-ARM64 targets
// on their existing pointer ABI. A0=handle, A1=key, A2=value; get Ret=value.
fn rt_emit_map_scalar_adapters(a $&Assembler) {
    if a.arch == 0 && !gen1_map_stats_on() { << }
    // x64 specializes get/insert only; has/delete/get_or still need their
    // value-to-pointer adapters, even when map statistics are disabled.
    if a.arch != 1 || gen1_map_stats_on() {
        a.label("_rt_map_get_scalar_ii")
        a.prologue(32)
        a.store(15, -8, 19)
        a.vm_sub_imm(19, 15, 8)
        a.vm_sub_imm(0, 15, 16)
        a.call("_rt_map_get")
        a.load(14, 15, -16)
        a.epilogue()
        a.label("_rt_map_insert_scalar_ii")
        a.prologue(32)
        a.store(15, -8, 19)
        a.store(15, -16, 20)
        a.vm_sub_imm(19, 15, 8)
        a.vm_sub_imm(20, 15, 16)
        a.call("_rt_map_insert")
        a.epilogue()
    }
    a.label("_rt_map_has_scalar_ii")
    a.prologue(16)
    a.store(15, -8, 19)
    a.vm_sub_imm(19, 15, 8)
    a.call("_rt_map_has")
    a.epilogue()
    a.label("_rt_map_delete_scalar_ii")
    a.prologue(16)
    a.store(15, -8, 19)
    a.vm_sub_imm(19, 15, 8)
    a.call("_rt_map_delete")
    a.epilogue()
    a.label("_rt_map_get_or_scalar_ii")
    a.prologue(32)
    a.store(15, -8, 19)
    a.store(15, -16, 20)
    a.vm_sub_imm(19, 15, 8)
    a.vm_sub_imm(20, 15, 16)
    a.vm_sub_imm(0, 15, 24)
    a.call("_rt_map_get_or")
    a.load(14, 15, -24)
    a.epilogue()
}

fn rt_emit_map_get(a $&Assembler) {
    a.label("_rt_map_get")
    a.load(1, 18, 48)
    a.load(2, 18, 56)
    a.ior(1, 1, 2)
    // x64: get_ii uses V6/V7, both unmapped to RAX. Take the framed path.
    if a.arch == 0 && !gen1_map_stats_on() {
        a.vm_cbz(1, "_rt_map_get_ii")
    }
    a.prologue(48)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 0)
    a.call("_rt_map_find_live")
    a.store(15, -32, 14)
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_map_miss")
    a.load(18, 15, -8)
    a.load(19, 15, -32)
    a.load(20, 15, -24)
    a.vm_mov_imm(21, 1)
    a.call("_rt_map_copy_out_val")
    a.epilogue()
    <<
}

fn rt_emit_map_insert(a $&Assembler) {
    a.label("_rt_map_insert")
    a.load(1, 18, 48)
    a.load(2, 18, 56)
    a.ior(1, 1, 2)
    // x64: insert_ii keeps handle/key/val in S0/S2/S3/V6/V7. S0 aliases V2,
    // S2/S3/V6/V7 all map to RAX. Framed insert uses V0–V5 + stack only.
    if a.arch == 0 && !gen1_map_stats_on() {
        a.vm_cbz(1, "_rt_map_insert_ii")
    }
    a.prologue(64)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    rt_map_call_insert_action(a)
    a.mov(0, 14)
    a.load(18, 15, -8)
    a.vm_cmp_imm(0, 0)
    a.jeq("_rt_mi_find")
    a.vm_cmp_imm(0, 2)
    a.jeq("_rt_mi_compact")
    a.call("_rt_map_grow")
    a.jmp("_rt_mi_find")
    a.label("_rt_mi_compact")
    a.call("_rt_map_compact")
    a.label("_rt_mi_find")
    a.load(18, 15, -8)
    a.load(19, 15, -16)
    a.vm_sub_imm(20, 15, 40)
    a.call("_rt_map_find_ins")
    a.vm_cmp_imm(14, 0)
    a.jge("_rt_mi_got")
    a.load(18, 15, -8)
    a.call("_rt_map_grow")
    a.load(18, 15, -8)
    a.load(19, 15, -16)
    a.vm_sub_imm(20, 15, 40)
    a.call("_rt_map_find_ins")
    a.label("_rt_mi_got")
    a.store(15, -32, 14)
    a.load(0, 15, -8)
    a.load(1, 0, 24)
    a.load(2, 15, -32)
    a.add(1, 1, 2)
    a.load_byte(0, 1, 0)
    a.vm_cmp_imm(0, 128)
    a.jlt("_rt_mi_fresh")
    a.load(18, 15, -8)
    a.load(19, 15, -32)
    a.call("_rt_map_drop_val")
    a.label("_rt_mi_ow")
    a.load(18, 15, -8)
    a.load(19, 15, -24)
    a.load(20, 15, -32)
    a.call("_rt_map_copy_in_val")
    a.epilogue()
    a.label("_rt_mi_fresh")
    a.load(0, 15, -8)
    a.load(1, 0, 24)
    a.load(2, 15, -32)
    a.add(1, 1, 2)
    a.load_byte(1, 1, 0)
    a.vm_cbz(1, "_rt_mi_new_used")
    a.load(1, 0, 88)
    a.vm_sub_imm(1, 1, 1)
    a.store(0, 88, 1)
    a.jmp("_rt_mi_counted")
    a.label("_rt_mi_new_used")
    a.load(1, 0, 80)
    a.vm_add_imm(1, 1, 1)
    a.store(0, 80, 1)
    a.label("_rt_mi_counted")
    a.load(18, 15, -8)
    a.load(19, 15, -16)
    a.load(20, 15, -32)
    a.call("_rt_map_copy_in_key")
    a.load(18, 15, -8)
    a.load(19, 15, -24)
    a.load(20, 15, -32)
    a.call("_rt_map_copy_in_val")
    a.load(0, 15, -8)
    a.load(1, 0, 24)
    a.load(2, 15, -32)
    a.add(1, 1, 2)
    a.load(2, 15, -40)
    a.store_byte(1, 0, 2)
    a.load(1, 0, 8)
    a.vm_add_imm(1, 1, 1)
    a.store(0, 8, 1)
    a.epilogue()
    <<
}

fn rt_emit_map_delete(a $&Assembler) {
    a.label("_rt_map_delete")
    a.prologue(32)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.call("_rt_map_find_live")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_md_nop")
    a.store(15, -24, 14)
    a.load(18, 15, -8)
    a.load(19, 15, -24)
    a.call("_rt_map_drop_slot")
    a.load(0, 15, -8)
    a.load(1, 0, 24)
    a.load(2, 15, -24)
    a.add(1, 1, 2)
    a.vm_mov_imm(2, 2)
    a.store_byte(1, 0, 2)
    a.load(1, 0, 8)
    a.vm_sub_imm(1, 1, 1)
    a.store(0, 8, 1)
    a.load(1, 0, 88)
    a.vm_add_imm(1, 1, 1)
    a.store(0, 88, 1)
    a.label("_rt_md_nop")
    a.epilogue()
    <<
}

fn rt_emit_map_take(a $&Assembler) {
    a.label("_rt_map_take")
    a.prologue(48)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 0)
    a.call("_rt_map_find_live")
    a.store(15, -32, 14)
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_map_miss")
    a.load(18, 15, -8)
    a.load(19, 15, -32)
    a.load(20, 15, -24)
    a.vm_mov_imm(21, 0)
    a.call("_rt_map_copy_out_val")
    a.load(18, 15, -8)
    a.load(0, 18, 48)
    a.vm_cbz(0, "_rt_mt_tomb")
    a.load(1, 18, 32)
    a.load(2, 15, -32)
    a.vm_mov_imm(3, 24)
    a.mul(2, 2, 3)
    a.add(1, 1, 2)
    a.load(0, 1, 16)
    a.vm_cbz(0, "_rt_mt_tomb")
    a.load(18, 1, 0)
    a.vm_cmp_imm(18, RT_MIN_HEAP_POINTER)
    a.jlt("_rt_mt_tomb")
    a.call("_rt_free")
    a.label("_rt_mt_tomb")
    a.load(0, 15, -8)
    a.load(1, 0, 24)
    a.load(2, 15, -32)
    a.add(1, 1, 2)
    a.vm_mov_imm(2, 2)
    a.store_byte(1, 0, 2)
    a.load(1, 0, 8)
    a.vm_sub_imm(1, 1, 1)
    a.store(0, 8, 1)
    a.load(1, 0, 88)
    a.vm_add_imm(1, 1, 1)
    a.store(0, 88, 1)
    a.epilogue()
    <<
}

fn rt_emit_map_get_or(a $&Assembler) {
    a.label("_rt_map_get_or")
    a.prologue(64)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    a.store(15, -32, 0)
    a.call("_rt_map_find_live")
    a.store(15, -40, 14)
    a.vm_cmp_imm(14, 0)
    a.jge("_rt_go_hit")
    a.load(0, 15, -8)
    a.load(0, 0, 56)
    a.vm_cbz(0, "_rt_go_m1")
    a.vm_cmp_imm(0, 1)
    a.jeq("_rt_go_mstr")
    a.load(0, 15, -8)
    a.load(0, 0, 64)
    a.vm_cbnz(0, "_rt_go_mn")
    a.vm_mov_imm(0, 1)
    a.label("_rt_go_mn")
    a.store(15, -48, 0)
    a.vm_mov_imm(0, 0)
    a.label("_rt_go_mloop")
    a.load(1, 15, -48)
    a.cmp(0, 1)
    a.jge("_rt_go_mdone")
    a.shl_imm(2, 0, 3)
    a.load(3, 15, -24)
    a.sub(3, 3, 2)
    a.load(3, 3, 0)
    a.load(4, 15, -32)
    a.sub(4, 4, 2)
    a.store(4, 0, 3)
    a.vm_add_imm(0, 0, 1)
    a.jmp("_rt_go_mloop")
    a.label("_rt_go_mdone")
    a.epilogue()
    a.label("_rt_go_m1")
    a.load(1, 15, -24)
    a.load(0, 1, 0)
    a.load(1, 15, -32)
    a.store(1, 0, 0)
    a.epilogue()
    a.label("_rt_go_mstr")
    a.load(1, 15, -24)
    a.load(2, 15, -32)
    a.load(0, 1, 0)
    a.store(2, 0, 0)
    a.load(0, 1, -8)
    a.store(2, -8, 0)
    a.load(0, 1, -16)
    a.store(2, -16, 0)
    a.epilogue()
    a.label("_rt_go_hit")
    a.store(15, -40, 14)
    a.load(18, 15, -8)
    a.load(19, 15, -40)
    a.load(20, 15, -32)
    a.vm_mov_imm(21, 1)
    a.call("_rt_map_copy_out_val")
    a.load(0, 15, -8)
    a.load(0, 0, 56)
    a.vm_cmp_imm(0, 1)
    a.jne("_rt_go_done")
    a.load(1, 15, -24)
    a.load(0, 1, -16)
    a.vm_cbz(0, "_rt_go_done")
    a.load(18, 1, 0)
    a.vm_cmp_imm(18, RT_MIN_HEAP_POINTER)
    a.jlt("_rt_go_done")
    a.call("_rt_free")
    a.label("_rt_go_done")
    a.epilogue()
    <<
}

// A0=handle A1=&key → Ret=pointer to live value slot (fail-loud on miss).
fn rt_emit_map_val_ptr(a $&Assembler) {
    a.label("_rt_map_val_ptr")
    a.prologue(48)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.call("_rt_map_find_live")
    a.store(15, -24, 14)
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_map_miss")
    a.load(18, 15, -8)
    a.call("_rt_map_vstride")
    a.store(15, -32, 14)
    a.load(18, 15, -8)
    a.load(1, 18, 40)
    a.load(2, 15, -24)
    a.load(3, 15, -32)
    a.mul(2, 2, 3)
    a.add(14, 1, 2)
    a.epilogue()
    <<
}

fn rt_emit_map_drop(a $&Assembler) {
    a.label("_rt_map_drop")
    a.prologue(32)
    a.store(15, -8, 18)
    a.vm_cbnz(18, "_rt_mdp_go")
    a.epilogue()
    a.label("_rt_mdp_go")
    if gen1_map_stats_on() { a.call("_rt_map_stats") }
    a.vm_mov_imm(0, 0)
    a.store(15, -16, 0)
    a.label("_rt_mdp_loop")
    a.load(0, 15, -8)
    a.load(1, 0, 16)
    a.load(2, 15, -16)
    a.cmp(2, 1)
    a.jge("_rt_mdp_bufs")
    a.load(1, 0, 24)
    a.add(1, 1, 2)
    a.load_byte(1, 1, 0)
    a.vm_cmp_imm(1, 128)
    a.jlt("_rt_mdp_next")
    a.load(18, 15, -8)
    a.load(19, 15, -16)
    a.call("_rt_map_drop_slot")
    a.label("_rt_mdp_next")
    a.load(0, 15, -16)
    a.vm_add_imm(0, 0, 1)
    a.store(15, -16, 0)
    a.jmp("_rt_mdp_loop")
    a.label("_rt_mdp_bufs")
    a.load(0, 15, -8)
    a.load(18, 0, 24)
    a.call("_rt_free")
    a.load(18, 15, -8)
    a.call("_rt_free")
    a.epilogue()
    <<
}

fn rt_emit_map_copy_out_key(a $&Assembler) {
    a.label("_rt_map_copy_out_key")
    a.prologue(48)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    a.load(0, 18, 48)
    a.vm_cbnz(0, "_rt_cok_str")
    a.load(1, 18, 32)
    a.mov(2, 19)
    a.shl_imm(2, 2, 3)
    a.add(1, 1, 2)
    a.load(0, 1, 0)
    a.load(1, 15, -24)
    a.store(1, 0, 0)
    a.epilogue()
    a.label("_rt_cok_str")
    a.load(0, 15, -8)
    a.load(1, 0, 32)
    a.load(2, 15, -16)
    a.vm_mov_imm(3, 24)
    a.mul(2, 2, 3)
    a.add(1, 1, 2)
    a.load(18, 1, 0)
    a.load(19, 1, 8)
    a.load(20, 1, 16)
    a.load(0, 15, -24)
    a.call("_rt_str_clone")
    a.epilogue()
    <<
}

fn rt_emit_map_iter_next(a $&Assembler) {
    a.label("_rt_map_iter_next")
    a.prologue(64)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    a.store(15, -32, 21)
    a.vm_cbnz(18, "_rt_in_go")
    a.vm_mov_imm(14, 0 - 1)
    a.epilogue()
    a.label("_rt_in_go")
    a.load(0, 18, 16)
    a.store(15, -40, 0)
    a.label("_rt_in_loop")
    a.load(0, 15, -16)
    a.load(1, 15, -40)
    a.cmp(0, 1)
    a.jge("_rt_in_miss")
    a.load(1, 15, -8)
    a.load(1, 1, 24)
    a.add(1, 1, 0)
    a.load_byte(1, 1, 0)
    a.vm_cmp_imm(1, 128)
    a.jge("_rt_in_hit")
    a.vm_add_imm(0, 0, 1)
    a.store(15, -16, 0)
    a.jmp("_rt_in_loop")
    a.label("_rt_in_hit")
    a.store(15, -48, 0)
    a.load(18, 15, -8)
    a.load(19, 15, -48)
    a.load(20, 15, -24)
    a.call("_rt_map_copy_out_key")
    a.load(18, 15, -8)
    a.load(19, 15, -48)
    a.load(20, 15, -32)
    a.vm_mov_imm(21, 1)
    a.call("_rt_map_copy_out_val")
    a.load(14, 15, -48)
    a.epilogue()
    a.label("_rt_in_miss")
    a.vm_mov_imm(14, 0 - 1)
    a.epilogue()
    <<
}
