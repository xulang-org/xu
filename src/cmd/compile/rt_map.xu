    a.call("_rt_alloc")
    a.store(15, -24, 14)
    rt_map_zero_extension(a)
    a.vm_mov_imm64(0, 0 - 7046029254386353131)
    a.load(1, 15, -24)
    a.store(1, 0, 0)
    a.vm_mov_imm(0, 0)
    a.store(1, 8, 0)

    // Compute initial power-of-2 capacity in R0
    a.load(0, 15, -48)
    a.vm_cmp_imm(0, 16)
    a.jle("_rt_mn_default")
    // slots = N + (N + 2) / 3 (load factor <= 75%)
    a.vm_add_imm(1, 0, 2)
    a.vm_mov_imm(2, 3)
    a.div(1, 1, 2)
    a.add(0, 0, 1)
    // Round up to next power of two via bit-smearing
    a.vm_sub_imm(0, 0, 1)
    a.shr_imm(1, 0, 1)
    a.ior(0, 0, 1)
    a.shr_imm(1, 0, 2)
    a.ior(0, 0, 1)
    a.shr_imm(1, 0, 4)
    a.ior(0, 0, 1)
    a.shr_imm(1, 0, 8)
    a.ior(0, 0, 1)
    a.shr_imm(1, 0, 16)
    a.ior(0, 0, 1)
    a.shr_imm(1, 0, 32)
    a.ior(0, 0, 1)
    a.vm_add_imm(0, 0, 1)
    a.vm_cmp_imm(0, 16)
    a.jge("_rt_mn_set_cap")
    a.label("_rt_mn_default")
    a.vm_mov_imm(0, 16)
    a.label("_rt_mn_set_cap")
    a.store(15, -48, 0)

    a.load(1, 15, -24)
    a.store(1, 16, 0)
    a.load(0, 15, -8)
    a.store(1, 48, 0)
    a.load(0, 15, -16)
    a.store(1, 56, 0)
    a.load(0, 15, -32)
    a.store(1, 64, 0)
    a.load(0, 15, -40)
    a.store(1, 72, 0)
    a.load(18, 15, -24)
    a.load(19, 15, -48)
    a.call("_rt_map_alloc_storage")
    a.load(14, 15, -24)
    a.epilogue()
