    a.shl_imm(2, 0, 3)
    a.load(3, 15, -24)
    a.sub(3, 3, 2)
    a.load(3, 3, 0)
    a.load(4, 15, -32)
    a.sub(4, 4, 2)
    a.store(4, 0, 3)
    a.vm_add_imm(0, 0, 1)
    a.jmp("_rt_go_mloop")
    a.label("_rt_go_mdone")
