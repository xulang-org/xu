    a.store(2, 0, 0)
    a.load(0, 1, -8)
    a.store(2, -8, 0)
    a.load(0, 1, -16)
    a.store(2, -16, 0)
    a.epilogue()
    a.label("_rt_go_hit")
    a.store(15, -40, 14)
    a.load(18, 15, -8)
    a.load(19, 15, -40)
    a.load(20, 15, -32)
    a.vm_mov_imm(21, 1)
    a.call("_rt_map_copy_out_val")
    a.load(0, 15, -8)
