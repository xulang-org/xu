    a.vm_cbz(18, "_rt_fsi_miss")
    a.load(19, 18, 0)
    a.load(18, 15, -16)
    a.call("_xu_runtime_map_hash_int")
    rt_map_ctrl_from_hash(a, 23, 0)
    a.load(4, 15, -8)
    a.load(6, 15, -16)
    a.load(0, 4, 16)
    a.vm_cbz(0, "_rt_fsi_miss")
    a.vm_sub_imm(7, 0, 1)
    a.load(20, 4, 24)
    a.load(21, 4, 32)
    a.iand(1, 14, 7)
    a.mov(2, 1)
    a.label("_rt_fsi_loop")
    a.add(0, 20, 1)
    a.load_byte(0, 0, 0)
    a.vm_cbz(0, "_rt_fsi_miss")
    a.cmp(0, 23)
    a.jne("_rt_fsi_next")
    a.shl_imm(3, 1, 3)
    a.add(0, 21, 3)
    a.load(0, 0, 0)
    a.cmp(0, 6)
    a.jne("_rt_fsi_next")
    a.mov(14, 1)
    a.epilogue_leaf()
    a.label("_rt_fsi_next")
    a.vm_add_imm(1, 1, 1)
    a.iand(1, 1, 7)
    a.cmp(1, 2)
    a.jne("_rt_fsi_loop")
    a.label("_rt_fsi_miss")
    a.vm_mov_imm(14, 0 - 1)
    a.epilogue_leaf()

    a.label("_rt_map_has_scalar_ii")
    a.prologue(0)
    a.call("_rt_map_find_scalar_ii")
    a.vm_cmp_imm(14, 0)
    a.vm_cset(14, 10)
    a.epilogue()

    a.label("_rt_map_get_or_scalar_ii")
    a.prologue(16)
    a.store(15, -8, 18)
    a.store(15, -16, 20)
    a.call("_rt_map_find_scalar_ii")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_gosi_default")
    a.mov(1, 14)
    a.shl_imm(1, 1, 3)
    a.load(0, 15, -8)
    a.load(0, 0, 40)
    a.add(0, 0, 1)
    a.load(14, 0, 0)
    a.epilogue()
    a.label("_rt_gosi_default")
    a.load(14, 15, -16)
    a.epilogue()

    a.label("_rt_map_delete_scalar_ii")
    a.prologue(16)
    a.store(15, -8, 18)
    a.call("_rt_map_find_scalar_ii")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_dsi_done")
    a.mov(2, 14)
    a.load(0, 15, -8)
    a.load(1, 0, 24)
    a.add(1, 1, 2)
    a.vm_mov_imm(2, 2)
    a.store_byte(1, 0, 2)
    a.load(1, 0, 8)
    a.vm_sub_imm(1, 1, 1)
    a.store(0, 8, 1)
    a.load(1, 0, 88)
    a.vm_add_imm(1, 1, 1)
    a.store(0, 88, 1)
    a.label("_rt_dsi_done")
    a.epilogue()
}

// Value-argument compatibility adapters keep stats and non-ARM64 targets
// on their existing pointer ABI. A0=handle, A1=key, A2=value; get Ret=value.
fn rt_emit_map_scalar_adapters(a &mut Assembler) {
    if a.arch == 0 && !gen1_map_stats_on() { << }
    a.label("_rt_map_get_scalar_ii")
    a.prologue(32)
    a.store(15, -8, 19)
    a.vm_sub_imm(19, 15, 8)
    a.vm_sub_imm(0, 15, 16)
    a.call("_rt_map_get")
    a.load(14, 15, -16)
    a.epilogue()
    a.label("_rt_map_insert_scalar_ii")
    a.prologue(32)
    a.store(15, -8, 19)
    a.store(15, -16, 20)
    a.vm_sub_imm(19, 15, 8)
    a.vm_sub_imm(20, 15, 16)
    a.call("_rt_map_insert")
    a.epilogue()
    a.label("_rt_map_has_scalar_ii")
    a.prologue(16)
    a.store(15, -8, 19)
    a.vm_sub_imm(19, 15, 8)
    a.call("_rt_map_has")
    a.epilogue()
    a.label("_rt_map_delete_scalar_ii")
    a.prologue(16)
    a.store(15, -8, 19)
    a.vm_sub_imm(19, 15, 8)
    a.call("_rt_map_delete")
    a.epilogue()
    a.label("_rt_map_get_or_scalar_ii")
    a.prologue(32)
    a.store(15, -8, 19)
    a.store(15, -16, 20)
    a.vm_sub_imm(19, 15, 8)
    a.vm_sub_imm(20, 15, 16)
    a.vm_sub_imm(0, 15, 24)
    a.call("_rt_map_get_or")
    a.load(14, 15, -24)
    a.epilogue()
}

fn rt_emit_map_get(a &mut Assembler) {
    a.label("_rt_map_get")
    a.load(1, 18, 48)
    a.load(2, 18, 56)
    a.ior(1, 1, 2)
    // x64: get_ii uses V6/V7, both unmapped to RAX. Take the framed path.
    if a.arch == 0 && !gen1_map_stats_on() {
        a.vm_cbz(1, "_rt_map_get_ii")
    }
    a.prologue(48)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 0)
    a.call("_rt_map_find_live")
    a.store(15, -32, 14)
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_map_miss")
    a.load(18, 15, -8)
    a.load(19, 15, -32)
    a.load(20, 15, -24)
    a.vm_mov_imm(21, 1)
    a.call("_rt_map_copy_out_val")
    a.epilogue()
    <<
}

fn rt_emit_map_insert(a &mut Assembler) {
    a.label("_rt_map_insert")
    a.load(1, 18, 48)
    a.load(2, 18, 56)
    a.ior(1, 1, 2)
    // x64: insert_ii keeps handle/key/val in S0/S2/S3/V6/V7. S0 aliases V2,
    // S2/S3/V6/V7 all map to RAX. Framed insert uses V0–V5 + stack only.
    if a.arch == 0 && !gen1_map_stats_on() {
        a.vm_cbz(1, "_rt_map_insert_ii")
    }
    a.prologue(64)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    rt_map_call_insert_action(a)
    a.mov(0, 14)
    a.load(18, 15, -8)
    a.vm_cmp_imm(0, 0)
    a.jeq("_rt_mi_find")
    a.vm_cmp_imm(0, 2)
    a.jeq("_rt_mi_compact")
    a.call("_rt_map_grow")
    a.jmp("_rt_mi_find")
    a.label("_rt_mi_compact")
    a.call("_rt_map_compact")
    a.label("_rt_mi_find")
    a.load(18, 15, -8)
    a.load(19, 15, -16)
    a.vm_sub_imm(20, 15, 40)
    a.call("_rt_map_find_ins")
    a.vm_cmp_imm(14, 0)
    a.jge("_rt_mi_got")
    a.load(18, 15, -8)
    a.call("_rt_map_grow")
    a.load(18, 15, -8)
    a.load(19, 15, -16)
    a.vm_sub_imm(20, 15, 40)
    a.call("_rt_map_find_ins")
    a.label("_rt_mi_got")
    a.store(15, -32, 14)
    a.load(0, 15, -8)
    a.load(1, 0, 24)
    a.load(2, 15, -32)
    a.add(1, 1, 2)
    a.load_byte(0, 1, 0)
    a.vm_cmp_imm(0, 128)
    a.jlt("_rt_mi_fresh")
    a.load(18, 15, -8)
    a.load(19, 15, -32)
    a.call("_rt_map_drop_val")
    a.label("_rt_mi_ow")
    a.load(18, 15, -8)
    a.load(19, 15, -24)
    a.load(20, 15, -32)
    a.call("_rt_map_copy_in_val")
    a.epilogue()
    a.label("_rt_mi_fresh")
    a.load(0, 15, -8)
    a.load(1, 0, 24)
    a.load(2, 15, -32)
    a.add(1, 1, 2)
    a.load_byte(1, 1, 0)
    a.vm_cbz(1, "_rt_mi_new_used")
    a.load(1, 0, 88)
    a.vm_sub_imm(1, 1, 1)
    a.store(0, 88, 1)
    a.jmp("_rt_mi_counted")
    a.label("_rt_mi_new_used")
    a.load(1, 0, 80)
    a.vm_add_imm(1, 1, 1)
    a.store(0, 80, 1)
    a.label("_rt_mi_counted")
    a.load(18, 15, -8)
    a.load(19, 15, -16)
    a.load(20, 15, -32)
    a.call("_rt_map_copy_in_key")
    a.load(18, 15, -8)
    a.load(19, 15, -24)
    a.load(20, 15, -32)
    a.call("_rt_map_copy_in_val")
    a.load(0, 15, -8)
    a.load(1, 0, 24)
    a.load(2, 15, -32)
    a.add(1, 1, 2)
    a.load(2, 15, -40)
    a.store_byte(1, 0, 2)
    a.load(1, 0, 8)
    a.vm_add_imm(1, 1, 1)
    a.store(0, 8, 1)
    a.epilogue()
    <<
}

