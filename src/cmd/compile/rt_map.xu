fn rt_emit_map_new(a $&Assembler) {
    a.label("_rt_map_new")
    a.prologue(64)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -32, 20)
    a.store(15, -40, 21)
    a.store(15, -48, 22)
