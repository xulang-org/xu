    a.load(0, 0, 0)
    a.cmp(0, 6)
    a.jne(prefix + "next")
    a.add(0, 22, 3)
    a.load(0, 0, 0)
    if scalar { a.mov(14, 0) } else { a.store(5, 0, 0) }
