@main

#xu/types

// Map algorithm policy lives in ordinary runtime/map_algo.xu. This adapter
// only unpacks the opaque header into the ordinary scalar Xu argument ABI.
fn rt_map_call_insert_action(a $&Assembler) {
    a.mov(0, 18)
    a.load(19, 0, 80)
    a.load(20, 0, 16)
    a.load(18, 0, 8)
    if a.stack_check { a.call("_rt_map_policy_insert_action") }
    else { a.call("_xu_runtime_map_insert_action") }
}

// Native map frames use S homes for map storage. Ordinary Xu policy calls
// require the current coroutine in the holder home for their entry guard.
// Preserve the scalar arguments and the adapter's S homes while resolving G;
// the bridge epilogue restores the native adapter's original register state.
fn rt_emit_map_policy_bridge(a $&Assembler, name string, nargs int) {
    a.label("_rt_map_policy_" + name)
    a.prologue(32)
    for i in 0:nargs { a.store(15,0 - (i + 1) * 8,18 + i) }
    a.call("_rt_g_self")
    a.mov(td_stack_holder_home(a.arch),14)
    for i in 0:nargs { a.load(18 + i,15,0 - (i + 1) * 8) }
    a.call("_xu_runtime_map_" + name)
    a.epilogue()
}

// Opaque map controls occupy one byte per slot: 0=empty, 2=deleted,
// 128..255=live with the hash's high seven bits. Fingerprints only filter
// candidates; the complete integer/string key is still compared on a match.
// Key/value strides and owning payload movement remain unchanged.
fn rt_map_ctrl_from_hash(a $&Assembler, dest int, scratch int) {
    a.shr_imm(dest, 14, 57)
    a.vm_add_imm(dest, dest, 128)
}

fn rt_emit_map_hash_int_inline(a $&Assembler, dest int, key int, seed int, scratch1 int, scratch2 int) {
    a.ixor(dest, key, seed)
    a.shr_imm(scratch1, dest, 30)
    a.ixor(dest, dest, scratch1)
    a.vm_mov_imm64(scratch2, 0 - 4658895280553007687)
    a.mul(dest, dest, scratch2)
    a.shr_imm(scratch1, dest, 27)
    a.ixor(dest, dest, scratch1)
    a.vm_mov_imm64(scratch2, 0 - 7723592293110705685)
    a.mul(dest, dest, scratch2)
    a.shr_imm(scratch1, dest, 31)
    a.ixor(dest, dest, scratch1)
}

fn rt_emit_map(a $&Assembler) {
    if a.stack_check {
        rt_emit_map_policy_bridge(a,"insert_action",3)
        rt_emit_map_policy_bridge(a,"hash_string",2)
    }
    a.data_label("_rt_map_miss_msg")
    rt_emit_bytes(a, "map key not found\n")
    a.label("_rt_map_miss")
    a.prologue(16)
    a.lea(18, "_rt_map_miss_msg")
    a.vm_mov_imm(19, 18)
    a.vm_mov_imm(20, 2)
    a.call("_rt_write")
    rt_exit(a, 1)
    a.epilogue()

    rt_emit_map_stats(a)
    rt_emit_map_hash(a)
    rt_emit_map_keyeq(a)
    rt_emit_map_find_live(a)
    rt_emit_map_find_ins(a)
    rt_emit_map_drop_slot(a)
    rt_emit_map_vstride(a)
    rt_emit_map_drop_val(a)
    rt_emit_map_copy_in_key(a)
    rt_emit_map_copy_in_val(a)
    rt_emit_map_copy_out_val(a)
    rt_emit_map_copy_out_key(a)
    rt_emit_map_alloc_storage(a)
    rt_emit_map_grow(a)
    rt_emit_map_new(a)
    rt_emit_map_len(a)
    rt_emit_map_has(a)
    if a.arch == 0 {
        rt_emit_map_get_ii(a)
        rt_emit_map_insert_ii(a)
        if !gen1_map_stats_on() {
            rt_emit_map_get_scalar_ii(a)
            rt_emit_map_insert_scalar_ii(a)
            rt_emit_map_scalar_methods_ii(a)
        }
    }
    if a.arch == 1 {
        if !gen1_map_stats_on() {
            rt_emit_map_x64_scalar_ii(a)
        }
    }
    rt_emit_map_scalar_adapters(a)
    rt_emit_map_get(a)
    rt_emit_map_insert(a)
    rt_emit_map_delete(a)
    rt_emit_map_take(a)
    rt_emit_map_get_or(a)
    rt_emit_map_val_ptr(a)
    rt_emit_map_drop(a)
    rt_emit_map_iter_next(a)
    <<
}

// A0=handle, A1=&key(frame descriptor). Ret=hash. Algorithms and mixing
// use ordinary Xu ABI; the native frame keeps the caller's input pointers.
fn rt_emit_map_hash(a $&Assembler) {
    a.label("_rt_map_hash")
    a.prologue(32)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.load(0, 18, 48)
    a.vm_cbnz(0, "_rt_mh_str")
    a.load(1, 18, 0)
    a.load(2, 15, -16)
    a.load(2, 2, 0)
    rt_emit_map_hash_int_inline(a, 14, 2, 1, 0, 3)
    a.epilogue()
    a.label("_rt_mh_str")
    a.load(19, 18, 0)
    a.load(18, 15, -16)
    if a.stack_check { a.call("_rt_map_policy_hash_string") }
    else { a.call("_xu_runtime_map_hash_string") }
    a.epilogue()
}

fn rt_emit_map_keyeq(a $&Assembler) {
    a.label("_rt_map_keyeq")
    a.prologue(48)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    a.load(0, 18, 48)
    a.vm_cbnz(0, "_rt_ke_str")
    a.load(1, 18, 32)
    a.load(2, 15, -24)
    a.shl_imm(2, 2, 3)
    a.add(1, 1, 2)
    a.load(0, 1, 0)
    a.load(1, 15, -16)
    a.load(1, 1, 0)
    a.cmp(0, 1)
    a.vm_cset(14, 0)
    a.epilogue()
    a.label("_rt_ke_str")
    a.load(0, 15, -8)
    a.load(1, 0, 32)
    a.load(2, 15, -24)
    a.vm_mov_imm(3, 24)
    a.mul(2, 2, 3)
    a.add(1, 1, 2)
    a.load(18, 1, 0)
    a.load(19, 1, 8)
    a.load(2, 15, -16)
    a.load(20, 2, 0)
    a.load(21, 2, -8)
    a.cmp(19, 21)
    a.jne("_rt_ke_str_ne")
    a.call("_rt_str_eq")
    a.epilogue()
    a.label("_rt_ke_str_ne")
    a.vm_mov_imm(14, 0)
    a.epilogue()
    <<
}

// Bounded skip of eight live controls with no possible fingerprint
// match. Word reads stay inside controls and never cross the probe start.
// Candidates, empty slots and tombstones retain the original scalar path.
fn rt_emit_map_group_skip(a $&Assembler) {
    a.label("_rt_fl_group")
    a.load(0, 15, -8)
    a.load(0, 0, 48)
    a.vm_cmp_imm(0, 1)
    a.jne("_rt_fl_next")
    a.load(2, 15, -32)
    a.vm_mov_imm(3, 7)
    a.iand(3, 2, 3)
    a.vm_cbnz(3, "_rt_fl_next")
    a.load(3, 15, -40)
    a.cmp(2, 3)
    a.jge("_rt_fg_bound")
    a.sub(3, 3, 2)
    a.vm_cmp_imm(3, 8)
    a.jlt("_rt_fl_next")
    a.label("_rt_fg_bound")
    a.load(3, 15, -24)
    a.sub(3, 3, 2)
    a.vm_cmp_imm(3, 8)
    a.jlt("_rt_fl_next")
    a.load(0, 15, -8)
    a.load(0, 0, 24)
    a.add(0, 0, 2)
    a.load(4, 0, 0)
    a.vm_mov_imm(5, 0 - 9187201950435737472)
    a.iand(0, 4, 5)
    a.cmp(0, 5)
    a.jne("_rt_fl_next")
    a.load(1, 15, -64)
    a.vm_mov_imm(3, 72340172838076673)
    a.mul(1, 1, 3)
    a.ixor(1, 4, 1)
    a.sub(0, 1, 3)
    a.vm_mov_imm(4, 0 - 1)
    a.ixor(4, 1, 4)
    a.iand(0, 0, 4)
    a.iand(0, 0, 5)
    a.vm_cbnz(0, "_rt_fl_next")
    a.load(0, 15, -32)
    a.vm_add_imm(0, 0, 8)
    a.load(1, 15, -24)
    a.vm_sub_imm(1, 1, 1)
    a.iand(0, 0, 1)
    a.store(15, -32, 0)
    a.load(1, 15, -40)
    a.cmp(0, 1)
    a.jne("_rt_fl_loop")
    a.vm_mov_imm(14, 0 - 1)
    a.epilogue()
}

fn rt_emit_map_find_live(a $&Assembler) {
    a.label("_rt_map_find_live")
    a.prologue(64)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    rt_map_probe_start(a, -48)
    a.load(0, 18, 16)
    a.vm_cbnz(0, "_rt_fl_go")
    a.vm_mov_imm(14, 0 - 1)
    rt_map_probe_finish(a, -48, -56)
    a.epilogue()
    a.label("_rt_fl_go")
    a.store(15, -24, 0)
    a.load(18, 15, -8)
    a.load(19, 15, -16)
    a.call("_rt_map_hash")
    rt_map_ctrl_from_hash(a, 0, 1)
    a.store(15, -64, 0)
    a.load(1, 15, -24)
    a.vm_sub_imm(1, 1, 1)
    a.iand(0, 14, 1)
    a.store(15, -32, 0)
    a.store(15, -40, 0)
    a.label("_rt_fl_loop")
    rt_map_probe_step(a, -48)
    a.load(0, 15, -8)
    a.load(1, 0, 24)
    a.load(2, 15, -32)
    a.add(1, 1, 2)
    a.load_byte(0, 1, 0)
    a.vm_cbnz(0, "_rt_fl_chk")
    a.vm_mov_imm(14, 0 - 1)
    rt_map_probe_finish(a, -48, -56)
    a.epilogue()
    a.label("_rt_fl_chk")
    a.load(1, 15, -64)
    a.cmp(0, 1)
    if a.arch == 0 && !gen1_map_stats_on() { a.jne("_rt_fl_group") }
    else { a.jne("_rt_fl_next") }
    a.load(18, 15, -8)
    a.load(19, 15, -16)
    a.load(20, 15, -32)
    a.call("_rt_map_keyeq")
    a.vm_cmp_imm(14, 0)
    a.jeq("_rt_fl_next")
    a.load(14, 15, -32)
    rt_map_probe_finish(a, -48, -56)
    a.epilogue()
    if a.arch == 0 && !gen1_map_stats_on() { rt_emit_map_group_skip(a) }
    a.label("_rt_fl_next")
    a.load(0, 15, -32)
    a.vm_add_imm(0, 0, 1)
    a.load(1, 15, -24)
    a.vm_sub_imm(1, 1, 1)
    a.iand(0, 0, 1)
    a.store(15, -32, 0)
    a.load(1, 15, -40)
    a.cmp(0, 1)
    a.jne("_rt_fl_loop")
    a.vm_mov_imm(14, 0 - 1)
    rt_map_probe_finish(a, -48, -56)
    a.epilogue()
    <<
}

fn rt_emit_map_find_ins(a $&Assembler) {
    a.label("_rt_map_find_ins")
    a.prologue(80)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -72, 20)
    rt_map_probe_start(a, -56)
    a.vm_mov_imm(0, 0 - 1)
    a.store(15, -48, 0)
    a.load(0, 18, 16)
    a.vm_cbnz(0, "_rt_fi_go")
    a.vm_mov_imm(14, 0 - 1)
    rt_map_probe_finish(a, -56, -64)
    a.epilogue()
    a.label("_rt_fi_go")
    a.store(15, -24, 0)
    a.load(18, 15, -8)
    a.load(19, 15, -16)
    a.call("_rt_map_hash")
    rt_map_ctrl_from_hash(a, 0, 1)
    a.load(1, 15, -72)
    a.store(1, 0, 0)
    a.load(1, 15, -24)
    a.vm_sub_imm(1, 1, 1)
    a.iand(0, 14, 1)
    a.store(15, -32, 0)
    a.store(15, -40, 0)
    a.label("_rt_fi_loop")
    rt_map_probe_step(a, -56)
    a.load(0, 15, -8)
    a.load(1, 0, 24)
    a.load(2, 15, -32)
    a.add(1, 1, 2)
    a.load_byte(0, 1, 0)
    a.vm_cbnz(0, "_rt_fi_live")
    a.load(1, 15, -48)
    a.vm_cmp_imm(1, 0 - 1)
    a.jeq("_rt_fi_empty")
    a.mov(14, 1)
    rt_map_probe_finish(a, -56, -64)
    a.epilogue()
    a.label("_rt_fi_empty")
    a.load(14, 15, -32)
    rt_map_probe_finish(a, -56, -64)
    a.epilogue()
    a.label("_rt_fi_live")
    a.vm_cmp_imm(0, 2)
    a.jne("_rt_fi_eq")
    a.load(1, 15, -48)
    a.vm_cmp_imm(1, 0 - 1)
    a.jne("_rt_fi_next")
    a.load(1, 15, -32)
    a.store(15, -48, 1)
    a.jmp("_rt_fi_next")
    a.label("_rt_fi_eq")
    a.load(1, 15, -72)
    a.load(1, 1, 0)
    a.cmp(0, 1)
    a.jne("_rt_fi_next")
    a.load(18, 15, -8)
    a.load(19, 15, -16)
    a.load(20, 15, -32)
    a.call("_rt_map_keyeq")
    a.vm_cmp_imm(14, 0)
    a.jeq("_rt_fi_next")
    a.load(14, 15, -32)
    rt_map_probe_finish(a, -56, -64)
    a.epilogue()
    a.label("_rt_fi_next")
    a.load(0, 15, -32)
    a.vm_add_imm(0, 0, 1)
    a.load(1, 15, -24)
    a.vm_sub_imm(1, 1, 1)
    a.iand(0, 0, 1)
    a.store(15, -32, 0)
    a.load(1, 15, -40)
    a.cmp(0, 1)
    a.jne("_rt_fi_loop")
    a.load(14, 15, -48)
    rt_map_probe_finish(a, -56, -64)
    a.epilogue()
    <<
}

fn rt_emit_map_drop_slot(a $&Assembler) {
    a.label("_rt_map_drop_slot")
    a.prologue(48)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.load(0, 18, 48)
    a.vm_cbz(0, "_rt_ds_val")
    a.load(1, 18, 32)
    a.load(2, 15, -16)
    a.vm_mov_imm(3, 24)
    a.mul(2, 2, 3)
    a.add(1, 1, 2)
    a.load(0, 1, 16)
    a.vm_cbz(0, "_rt_ds_val")
    a.load(18, 1, 0)
    a.vm_cmp_imm(18, RT_MIN_HEAP_POINTER)
    a.jlt("_rt_ds_val")
    a.call("_rt_free")
    a.label("_rt_ds_val")
    a.load(18, 15, -8)
    a.load(19, 15, -16)
    a.call("_rt_map_drop_val")
    a.label("_rt_ds_done")
    a.epilogue()
    <<
}

