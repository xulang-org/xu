// Int/int get: A0=handle, A1=&key, V0=&dest.
// FP/LR frame. Save live inputs across ordinary hash; initialise probe
// registers after the call (caller-saved V0–V7 + A2–A4, no S0–S5).
fn rt_emit_map_get_ii(a $&Assembler) {
    a.label("_rt_map_get_ii")
    a.prologue_leaf(32)
    a.store(15, -8, 18)
    a.store(15, -16, 0)
    a.store(15, -24, 19)
    a.load(1, 18, 0)
    a.load(2, 19, 0)
    rt_emit_map_hash_int_inline(a, 14, 2, 1, 3, 4)
    rt_map_ctrl_from_hash(a, 23, 0)
    a.load(4, 15, -8)
    a.load(5, 15, -16)
    a.load(6, 15, -24)
    a.load(6, 6, 0)
    a.load(0, 4, 16)
    a.vm_cbnz(0, "_rt_gii_go")
    a.jmp("_rt_map_miss")
    a.label("_rt_gii_go")
    a.vm_sub_imm(7, 0, 1)
    a.load(20, 4, 24)
    a.load(21, 4, 32)
    a.load(22, 4, 40)
    a.iand(1, 14, 7)
    a.mov(2, 1)
    a.label("_rt_gii_loop")
    a.add(0, 20, 1)
    a.load_byte(0, 0, 0)
    a.vm_cbnz(0, "_rt_gii_chk")
    a.jmp("_rt_map_miss")
    a.label("_rt_gii_chk")
    a.cmp(0, 23)
    a.jne("_rt_gii_next")
    a.shl_imm(3, 1, 3)
    a.add(0, 21, 3)
    a.load(0, 0, 0)
    a.cmp(0, 6)
    a.jne("_rt_gii_next")
    a.add(0, 22, 3)
    a.load(0, 0, 0)
    a.store(5, 0, 0)
    a.epilogue_leaf()
    a.label("_rt_gii_next")
    a.vm_add_imm(1, 1, 1)
    a.iand(1, 1, 7)
    a.cmp(1, 2)
    a.jne("_rt_gii_loop")
