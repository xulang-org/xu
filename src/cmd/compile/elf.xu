@main
// ELF 64-bit static executable generator (Linux x86_64 and aarch64).
// Ported from bootstrap/crates/xubin/src/elf.rs (M12).
//
// Layout (base 0x400000, 4KB pages):
// - x64: first PT_LOAD covers ELF header + program headers + code from
//   file offset 0 (Rosetta ElfMapper rule); cover_headers = true.
// - arm64: code PT_LOAD starts at code offset; data memsz += 64KB.

struct Elf64 {
    base_addr       int
    machine         int
    cover_headers   int
    data_memsz_bump int
    so_id           string
    needed          []string
    so_exp_name     []string
    so_exp_off      []int
}

fn new_elf_x64() Elf64 {
    // EM_X86_64 = 62
    << Elf64{base_addr: elf_image_base, machine: elf_machine_x64, cover_headers: 1, data_memsz_bump: 0, so_id: "", needed: []string{}, so_exp_name: []string{}, so_exp_off: []int{}}
}

fn new_elf_arm64() Elf64 {
    // EM_AARCH64 = 183
    << Elf64{base_addr: elf_image_base, machine: elf_machine_arm64, cover_headers: 0, data_memsz_bump: elf_data_mem_padding_bytes, so_id: "", needed: []string{}, so_exp_name: []string{}, so_exp_off: []int{}}
}

fn new_elf_loong() Elf64 {
    // EM_LOONGARCH = 258; layout mirrors linux-arm64 (cover_headers=false).
    << Elf64{base_addr: elf_image_base, machine: elf_machine_loong, cover_headers: 0, data_memsz_bump: elf_data_mem_padding_bytes, so_id: "", needed: []string{}, so_exp_name: []string{}, so_exp_off: []int{}}
}

fn new_elf_riscv64() Elf64 {
    // EM_RISCV = 243; layout mirrors linux-arm64 (cover_headers=false) but the
    // load base is the RISC-V virt RAM base 0x80000000 (QEMU `-kernel` loads
    // PT_LOAD at its p_vaddr; low addresses are not RAM on riscv virt).
    << Elf64{base_addr: elf_riscv_virt_code_base, machine: elf_machine_riscv, cover_headers: 0, data_memsz_bump: elf_data_mem_padding_bytes, so_id: "", needed: []string{}, so_exp_name: []string{}, so_exp_off: []int{}}
}

fn (e Elf64) is_dynamic() bool {
    if e.so_id.len > 0 { << true }
    if e.needed.len > 0 { << true }
    << false
}

fn (e &mut Elf64) add_needed_from(a &Assembler) {
    for i in 0:a.dylib_paths.len {
        e.needed.push(a.dylib_paths[i] + "")
    }
}

fn (e Elf64) code_file_offset() int { << elf_load_page_bytes }

fn (e Elf64) code_vaddr() int { << e.base_addr + e.code_file_offset() }

fn (e Elf64) data_vaddr(code_size int) int {
    data_file_offset := e.code_file_offset() + ((code_size + (elf_load_page_bytes - 1)) / elf_load_page_bytes) * elf_load_page_bytes
    << e.base_addr + data_file_offset
}

fn (e Elf64) generate(a &Assembler, start_offset int, buf &mut []int) {
    if e.is_dynamic() {
        e.generate_dynamic(a, start_offset, buf)
        <<
    }
    mut out := []int{}

    code_file_offset := e.code_file_offset()
    code_vaddr := e.code_vaddr()
    data_file_offset := code_file_offset + ((a.code.len + (elf_load_page_bytes - 1)) / elf_load_page_bytes) * elf_load_page_bytes
    data_vaddr := e.base_addr + data_file_offset
    entry_point := code_vaddr + start_offset

    // ELF header (64 bytes)
    out.push(127)
    out.push(69)  // E
    out.push(76)  // L
    out.push(70)  // F
    out.push(2)   // ELFCLASS64
    out.push(1)   // ELFDATA2LSB
    out.push(1)   // EV_CURRENT
    out.push(0)   // ELFOSABI_SYSV
    for i in 0:8 {
        out.push(0)
    }
    write16(mut &out, 2) // ET_EXEC
    write16(mut &out, e.machine)
    write32(mut &out, 1) // e_version
    write64(mut &out, entry_point)
    write64(mut &out, 64) // e_phoff
    write64(mut &out, 0) // e_shoff
    write32(mut &out, 0) // e_flags
    write16(mut &out, 64) // e_ehsize
    write16(mut &out, 56) // e_phentsize
    write16(mut &out, 2) // e_phnum
    write16(mut &out, 64) // e_shentsize
    write16(mut &out, 0)
    write16(mut &out, 0)

    // Program header 1: code (RX)  PF_R|PF_X = 5
    write32(mut &out, 1) // PT_LOAD
    write32(mut &out, 5)
    if e.cover_headers == 1 {
        write64(mut &out, 0)
        write64(mut &out, e.base_addr)
        write64(mut &out, e.base_addr)
        write64(mut &out, code_file_offset + a.code.len)
        write64(mut &out, code_file_offset + a.code.len)
    } else {
        write64(mut &out, code_file_offset)
        write64(mut &out, code_vaddr)
        write64(mut &out, code_vaddr)
        write64(mut &out, a.code.len)
        write64(mut &out, a.code.len)
    }
    write64(mut &out, elf_load_page_bytes)

    // Program header 2: data (RW) PF_R|PF_W = 6
    write32(mut &out, 1)
    write32(mut &out, 6)
    write64(mut &out, data_file_offset)
    write64(mut &out, data_vaddr)
    write64(mut &out, data_vaddr)
    write64(mut &out, a.data.len)
    write64(mut &out, a.data.len + e.data_memsz_bump)
    write64(mut &out, elf_load_page_bytes)

    pad_to(mut &out, code_file_offset)
    for i in 0:a.code.len {
        out.push(a.code[i])
    }
    if a.data.len > 0 {
        pad_to(mut &out, data_file_offset)
        for i in 0:a.data.len {
            out.push(a.data[i])
        }
    }

    for i in 0:out.len {
        buf.push(out[i])
    }
}

// One 64-byte Elf64_Shdr (mirror xubin elf.rs write_shdr). Built in a local
// so write32/write64 can re-borrow it; returned by value for the caller to
// append (a &mut []int parameter cannot be re-borrowed in this subset).
struct Elf64Shdr {
    name      int
    typ       int
    flags     int
    addr      int
    off       int
    size      int
    addralign int
}

fn elf64_shdr(h Elf64Shdr) []int {
    mut b := []int{}
    write32(mut &b, h.name)
    write32(mut &b, h.typ)
    write64(mut &b, h.flags)
    write64(mut &b, h.addr)
    write64(mut &b, h.off)
    write64(mut &b, h.size)
    write32(mut &b, 0) // sh_link
    write32(mut &b, 0) // sh_info
    write64(mut &b, h.addralign)
    write64(mut &b, 0) // sh_entsize
    << b
}

// m33: produce the final executable bytes with `.debug_line`/`.debug_info`/
// `.debug_abbrev`/`.debug_str` + `.shstrtab` and an 8-entry section header
// table appended after the data segment (PT_LOAD layout untouched). Mirrors
// xubin elf.rs generate_with_debug with `debug = Some(..)`.
fn (e Elf64) generate_debug(a &Assembler, start_offset int, buf &mut []int, d &DebugSections) {
    if e.is_dynamic() {
        e.generate_dynamic(a, start_offset, buf)
        <<
    }
    mut out := []int{}

    code_file_offset := e.code_file_offset()
    code_vaddr := e.code_vaddr()
    data_file_offset := code_file_offset + ((a.code.len + (elf_load_page_bytes - 1)) / elf_load_page_bytes) * elf_load_page_bytes
    data_vaddr := e.base_addr + data_file_offset
    entry_point := code_vaddr + start_offset

    // .shstrtab content (name offsets derived from this fixed layout):
    //   \0.text\0.data\0.debug_line\0.debug_info\0.debug_abbrev\0.debug_str\0.shstrtab\0
    mut shstrtab := []int{}
    shstrtab.push(0)
    write_cstr(mut &shstrtab, ".text")
    write_cstr(mut &shstrtab, ".data")
    write_cstr(mut &shstrtab, ".debug_line")
    write_cstr(mut &shstrtab, ".debug_info")
    write_cstr(mut &shstrtab, ".debug_abbrev")
    write_cstr(mut &shstrtab, ".debug_str")
    write_cstr(mut &shstrtab, ".shstrtab")

    // Section file offsets are 8-byte aligned, placed after data.
    mut cur := align_up(data_file_offset + a.data.len, 8)
    line_off := cur
    cur = align_up(cur + d.line.len, 8)
    info_off := cur
    cur = align_up(cur + d.info.len, 8)
    abbrev_off := cur
    cur = align_up(cur + d.abbrev.len, 8)
    str_off := cur
    cur = align_up(cur + d.str.len, 8)
    shstr_off := cur
    cur = cur + shstrtab.len
    shoff := align_up(cur, 8)

    // ELF header (64 bytes)
    out.push(127)
    out.push(69)  // E
    out.push(76)  // L
    out.push(70)  // F
    out.push(2)   // ELFCLASS64
    out.push(1)   // ELFDATA2LSB
    out.push(1)   // EV_CURRENT
    out.push(0)   // ELFOSABI_SYSV
    for i in 0:8 {
        out.push(0)
    }
    write16(mut &out, 2) // ET_EXEC
    write16(mut &out, e.machine)
    write32(mut &out, 1) // e_version
    write64(mut &out, entry_point)
    write64(mut &out, 64) // e_phoff
    write64(mut &out, shoff) // e_shoff
    write32(mut &out, 0) // e_flags
    write16(mut &out, 64) // e_ehsize
    write16(mut &out, 56) // e_phentsize
    write16(mut &out, 2) // e_phnum
    write16(mut &out, 64) // e_shentsize
    write16(mut &out, 8) // e_shnum
    write16(mut &out, 7) // e_shstrndx

    // Program header 1: code (RX)  PF_R|PF_X = 5
    write32(mut &out, 1) // PT_LOAD
    write32(mut &out, 5)
    if e.cover_headers == 1 {
        write64(mut &out, 0)
        write64(mut &out, e.base_addr)
        write64(mut &out, e.base_addr)
        write64(mut &out, code_file_offset + a.code.len)
        write64(mut &out, code_file_offset + a.code.len)
    } else {
        write64(mut &out, code_file_offset)
        write64(mut &out, code_vaddr)
        write64(mut &out, code_vaddr)
        write64(mut &out, a.code.len)
        write64(mut &out, a.code.len)
    }
    write64(mut &out, elf_load_page_bytes)

    // Program header 2: data (RW) PF_R|PF_W = 6
    write32(mut &out, 1)
    write32(mut &out, 6)
    write64(mut &out, data_file_offset)
    write64(mut &out, data_vaddr)
    write64(mut &out, data_vaddr)
    write64(mut &out, a.data.len)
    write64(mut &out, a.data.len + e.data_memsz_bump)
    write64(mut &out, elf_load_page_bytes)

    // Code + data (data is always padded when debug is present).
    pad_to(mut &out, code_file_offset)
    for i in 0:a.code.len {
        out.push(a.code[i])
    }
    pad_to(mut &out, data_file_offset)
    for i in 0:a.data.len {
        out.push(a.data[i])
    }

    // Debug sections + .shstrtab (m33).
    pad_to(mut &out, line_off)
    for i in 0:d.line.len {
        out.push(d.line[i])
    }
    pad_to(mut &out, info_off)
    for i in 0:d.info.len {
        out.push(d.info[i])
    }
    pad_to(mut &out, abbrev_off)
    for i in 0:d.abbrev.len {
        out.push(d.abbrev[i])
    }
    pad_to(mut &out, str_off)
    for i in 0:d.str.len {
        out.push(d.str[i])
    }
    pad_to(mut &out, shstr_off)
    for i in 0:shstrtab.len {
        out.push(shstrtab[i])
    }

    // Section header table (8 entries; name offsets from build_shstrtab).
    pad_to(mut &out, shoff)
    sh0 := elf64_shdr(Elf64Shdr{name: 0, typ: 0, flags: 0, addr: 0, off: 0, size: 0, addralign: 0})
    for i in 0:sh0.len {
        out.push(sh0[i])
    }
    sh1 := elf64_shdr(Elf64Shdr{name: 1, typ: 1, flags: 6, addr: code_vaddr, off: code_file_offset, size: a.code.len, addralign: 16})
    for i in 0:sh1.len {
        out.push(sh1[i])
    }
    sh2 := elf64_shdr(Elf64Shdr{name: 7, typ: 1, flags: 3, addr: data_vaddr, off: data_file_offset, size: a.data.len, addralign: 16})
    for i in 0:sh2.len {
        out.push(sh2[i])
    }
    sh3 := elf64_shdr(Elf64Shdr{name: 13, typ: 1, flags: 0, addr: 0, off: line_off, size: d.line.len, addralign: 1})
    for i in 0:sh3.len {
        out.push(sh3[i])
    }
    sh4 := elf64_shdr(Elf64Shdr{name: 25, typ: 1, flags: 0, addr: 0, off: info_off, size: d.info.len, addralign: 1})
    for i in 0:sh4.len {
        out.push(sh4[i])
    }
    sh5 := elf64_shdr(Elf64Shdr{name: 37, typ: 1, flags: 0, addr: 0, off: abbrev_off, size: d.abbrev.len, addralign: 1})
    for i in 0:sh5.len {
        out.push(sh5[i])
    }
    sh6 := elf64_shdr(Elf64Shdr{name: 52, typ: 1, flags: 0, addr: 0, off: str_off, size: d.str.len, addralign: 1})
    for i in 0:sh6.len {
        out.push(sh6[i])
    }
    sh7 := elf64_shdr(Elf64Shdr{name: 63, typ: 3, flags: 0, addr: 0, off: shstr_off, size: shstrtab.len, addralign: 1})
    for i in 0:sh7.len {
        out.push(sh7[i])
    }

    for i in 0:out.len {
        buf.push(out[i])
    }
}
