@main

#xu/scanner
#xu/parser
#xu/ast
#xu/types
#xu/format
#errors
#internal/modulepath

fn path_is_sep(b int) bool {
    if b == 47 { << true }
    if b == 92 { << true }
    << false
}

// Path helpers take &string so callers keep their values (no move).
// Returned strings are always owned copies.

// Owned clone of a borrowed string. Sole `+ ""` in path/driver helpers.
fn str_clone(s &string) string {
    << s + ""
}

fn str_eq(a &string, b &string) bool {
    if a.len != b.len {
        << false
    }
    for i in 0:a.len {
        if a[i] != b[i] {
            << false
        }
    }
    << true
}

fn str_eq_lit(a &string, lit string) bool {
    << str_eq(a, &lit)
}

// Build owned substring by bytes — bootstrap cannot slice &string safely.
fn str_slice_owned(s &string, from int, to int) string {
    $out := ""
    for i in from:to {
        out = out + string_from_byte(s[i])
    }
    << out
}

fn path_dirname(path &string) string {
    $last := -1
    for i in 0:path.len {
        if path_is_sep(path[i]) {
            last = i
        }
    }
    if last < 0 {
        << "."
    }
    if last == 0 {
        << "/"
    }
    << str_slice_owned(path, 0, last)
}

fn path_basename(path &string) string {
    $last := -1
    for i in 0:path.len {
        if path_is_sep(path[i]) {
            last = i
        }
    }
    if last < 0 {
        << str_clone(path)
    }
    if last == path.len - 1 {
        << ""
    }
    << str_slice_owned(path, last + 1, path.len)
}

fn module_last(mid &string) string {
    $last := -1
    for i in 0:mid.len {
        if mid[i] == 47 {
            last = i
        }
    }
    if last < 0 {
        << str_clone(mid)
    }
    << str_slice_owned(mid, last + 1, mid.len)
}

fn file_stem(path &string) string {
    base := path_basename(path)
    $last := -1
    for i in 0:base.len {
        if base[i] == 46 {
            last = i
        }
    }
    if last <= 0 {
        << base
    }
    << base[0:last]
}

fn str_ends_with_ascii_ci(s &string, suf string) bool {
    if suf.len > s.len {
        << false
    }
    start := s.len - suf.len
    for i in 0:suf.len {
        $a := s[start + i] & 255
        $b := suf[i] & 255
        if a >= 65 && a <= 90 {
            a = a + 32
        }
        if b >= 65 && b <= 90 {
            b = b + 32
        }
        if a != b {
            << false
        }
    }
    << true
}

fn path_basename_has_dot(path &string) bool {
    base := path_basename(path)
    for i in 0:base.len {
        if base[i] == 46 {
            << true
        }
    }
    << false
}

// Bare output names gain .exe on Windows and .wasm on WebAssembly.
// Already-suffixed or dotted basenames are left alone.
fn ensure_bin_suffix(path string, target_code int) string {
    if str_ends_with_ascii_ci(&path, ".exe") {
        << path + ""
    }
    if path_basename_has_dot(&path) {
        << path + ""
    }
    if target_os(target_code) == 2 {
        << path + ".exe"
    }
    if target_code == 46 { << path + ".wasm" }
    << path + ""
}

fn path_looks_like_xu_file(path &string) bool {
    << str_ends_with_ascii_ci(path, ".xu")
}

fn default_output_stem(paths &[]string) string {
    if paths.len == 0 {
        << "a"
    }
    for i in 0:paths.len {
        p := paths[i]
        base := path_basename(&p)
        if str_eq_lit(&base, "main.xu") {
            << "main"
        }
    }
    raw := paths[0]
    $p := str_clone(&raw)
    $trimming := 1
    while trimming == 1 {
        if p.len <= 1 {
            trimming = 0
        } else {
            last := p[p.len - 1]
            if last == 47 || last == 92 {
                p = p[0:p.len - 1]
            } else {
                trimming = 0
            }
        }
    }
    if p.len == 0 || str_eq_lit(&p, ".") {
        << "a"
    }
    if path_looks_like_xu_file(&p) == false {
        b := path_basename(&p)
        if b.len == 0 || str_eq_lit(&b, ".") || str_eq_lit(&b, "..") {
            << "a"
        }
        << b
    }
    st := file_stem(&p)
    if st.len == 0 || str_eq_lit(&st, ".") || str_eq_lit(&st, "..") {
        << "a"
    }
    << st
}

fn default_output_path(paths &[]string, target_code int) string {
    stem := default_output_stem(paths)
    << ensure_bin_suffix(stem, target_code)
}

fn check_module_dir_name(path &string, mid &string, proj &string) {
    // A canonical module is bound to its manifest root, whose basename may
    // be a repository name, cache digest, or arbitrary local checkout name.
    if modulepath.is_external(mid) { << }
    last := module_last(mid)
    dir := path_dirname(path)
    dbase := path_basename(&dir)
    stem := file_stem(path)
    if str_eq_lit(mid, "main") {
        if str_eq(&dir, proj) {
            <<
        }
        if last == dbase {
            <<
        }
        eprintln(path + ": module '" + mid + "' does not match directory '" + dbase + "'")
        <<< 1
    }
    if last == dbase {
        <<
    }
    if last == stem {
        <<
    }
    eprintln(path + ": module '" + mid + "' does not match directory '" + dbase + "'")
    <<< 1
}

fn note_dir_module(path &string, mid &string, proj &string, dirs $&[]string, mids $&[]string, dir_map $&types.StrMap) {
    dir := path_dirname(path)
    idx := dir_map.lookup(&dir)
    if idx >= 0 {
        prev := mids[idx]
        if !str_eq(&prev, mid) {
            eprintln(path + ": module '" + mid + "' conflicts with module '" + prev + "' in the same directory")
            <<< 1
        }
        check_module_dir_name(path, mid, proj)
        <<
    }
    new_idx := dirs.len
    dir_map.put(str_clone(&dir), new_idx)
    dirs.push(dir)
    mids.push(str_clone(mid))
    check_module_dir_name(path, mid, proj)
}

fn path_join(dir &string, rel &string) string {
    if dir.len == 0 {
        << str_clone(rel)
    }
    if str_eq_lit(dir, ".") {
        << str_clone(rel)
    }
    last := dir[dir.len - 1]
    if last == 47 || last == 92 {
        << dir + rel
    }
    << dir + "/" + rel
}

fn str_ends_with(s &string, suf &string) bool {
    if suf.len > s.len {
        << false
    }
    start := s.len - suf.len
    for i in 0:suf.len {
        if s[start + i] != suf[i] {
            << false
        }
    }
    << true
}

fn hex16(n int) string {
    digits := "0123456789abcdef"
    $x := n
    if x < 0 {
        x = 0 - x
    }
    $out := ""
    for i in 0:16 {
        d := x % 16
        out = string_from_byte(digits[d]) + out
        x = x / 16
    }
    << out
}
