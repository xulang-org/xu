        } else {
            ds := map_reg(src)
            dd := map_reg(dest)
            a.scvtf_d_from_x(0, ds)
            a.fmov_x_from_d(dd, 0)
        }
    }
}

fn (a &mut Assembler) be_fcvtzs(dest int, src int) {
