fn (a &mut Assembler) be_fneg(dest int, src int) {
    if a.arch == 1 {
        a.xbe_fneg(dest, src)
    } else {
        if a.arch == 2 {
            e1_thumb_unimp("fneg (E4 VFP)")
        } else if a.arch == 4 {
            a.lbe_fneg(dest, src)
        } else if a.arch == 5 {
            a.vbe_fneg(dest, src)
        } else {
            ds := map_reg(src)
            dd := map_reg(dest)
            a.fmov_d_from_x(0, ds)
            a.fneg_d(0, 0)
            a.fmov_x_from_d(dd, 0)
        }
    }
}

// Hosted arm64/x64/loong64: ieee fsqrt on f64 bits in GPRs.
fn (a &mut Assembler) be_fsqrt(dest int, src int) {
    if a.arch == 1 {
        a.xbe_fsqrt(dest, src)
    } else if a.arch == 0 {
        ds := map_reg(src)
        dd := map_reg(dest)
        a.fmov_d_from_x(0, ds)
        a.fsqrt_d(0, 0)
        a.fmov_x_from_d(dd, 0)
    } else if a.arch == 4 {
        a.lbe_fsqrt(dest, src)
    } else {
        e1_thumb_unimp("fsqrt")
    }
}

fn (a &mut Assembler) be_clz(dest int, src int) {
    if a.arch == 0 {
        a.clz_x(map_reg(dest), map_reg(src))
    } else if a.arch == 1 {
        a.xbe_clz(dest, src)
    } else if a.arch == 4 {
        a.lbe_clz(dest, src)
    } else {
        e1_thumb_unimp("clz")
    }
}

fn (a &mut Assembler) be_ctz(dest int, src int) {
    if a.arch == 0 {
        dd := map_reg(dest)
        a.rbit_x(dd, map_reg(src))
        a.clz_x(dd, dd)
    } else if a.arch == 1 {
        a.xbe_ctz(dest, src)
    } else if a.arch == 4 {
        a.lbe_ctz(dest, src)
    } else {
        e1_thumb_unimp("ctz")
    }
}

fn (a &mut Assembler) be_rbit(dest int, src int) {
    if a.arch == 0 {
        a.rbit_x(map_reg(dest), map_reg(src))
    } else if a.arch == 4 {
        a.lbe_rbit(dest, src)
    } else {
        e1_thumb_unimp("rbit")
    }
}

fn (a &mut Assembler) be_rev64(dest int, src int) {
    if a.arch == 0 {
        a.rev64(map_reg(dest), map_reg(src))
    } else if a.arch == 1 {
        d := x64_map_reg(dest)
        s := x64_map_reg(src)
        if d != s { a.x64_mov_reg(d, s) }
        a.x64_bswap(d)
    }
}

fn (a &mut Assembler) be_popcount64(dest int, src int) {
    if a.arch == 0 {
        a.fmov_d_from_x(0, map_reg(src))
        a.cnt_8b(0, 0)
        a.addv_8b(0, 0)
        a.fmov_w_from_s(map_reg(dest), 0)
    }
}

fn (a &mut Assembler) be_fcmp(x int, y int) {
    if a.arch == 1 {
        a.xbe_fcmp(x, y)
    } else {
        if a.arch == 2 {
            e1_thumb_unimp("fcmp (E4 VFP)")
        } else if a.arch == 4 {
            a.lbe_fcmp(x, y)
        } else if a.arch == 5 {
            a.vbe_fcmp(x, y)
        } else {
            da := map_reg(x)
            db := map_reg(y)
            a.fmov_d_from_x(0, da)
            a.fmov_d_from_x(1, db)
            a.fcmp_d(0, 1)
        }
    }
}

fn (a &mut Assembler) be_fcmp_dd(dn int, dm int) {
    if a.arch == 0 {
        a.fcmp_d(dn, dm)
    } else if a.arch == 1 {
        if dn != 0 { a.be_fmov_dd(0, dn) }
        if dm != 1 { a.be_fmov_dd(1, dm) }
        a.x64_ucomisd(0, 1)
    } else {
        da := 0
        db := 1
        a.be_fmov_gpr_from_d(da, dn)
        a.be_fmov_gpr_from_d(db, dm)
        a.be_fcmp(da, db)
    }
}

fn (a &mut Assembler) be_scvtf(dest int, src int) {
    if a.arch == 1 {
        a.xbe_scvtf(dest, src)
