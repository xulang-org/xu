@main

fn (a &mut Assembler) be_fadd(dest int, x int, y int) {
    if a.arch == 1 {
        a.xbe_fadd(dest, x, y)
    } else {
        if a.arch == 2 {
            e1_thumb_unimp("fadd (E4 VFP)")
        } else if a.arch == 4 {
            a.lbe_fadd(dest, x, y)
        } else if a.arch == 5 {
            a.vbe_fadd(dest, x, y)
        } else {
            da := map_reg(x)
            db := map_reg(y)
            dd := map_reg(dest)
            a.fmov_d_from_x(0, da)
            a.fmov_d_from_x(1, db)
            a.fadd_d(0, 0, 1)
            a.fmov_x_from_d(dd, 0)
        }
    }
}

fn (a &mut Assembler) be_fsub(dest int, x int, y int) {
    if a.arch == 1 {
        a.xbe_fsub(dest, x, y)
