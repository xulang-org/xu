}

// Hosted arm64/x64: park f64 in SIMD/XMM (d2+/xmm2+).
// Large negative frame offsets (nbody temps) use one shifted SUB + LDUR/STUR
// residual instead of mov + multi-part sub + mem.
fn (a &mut Assembler) be_fload(fd int, base int, offset int) {
    if a.arch == 1 {
        a.x64_movsd_load(fd, x64_map_reg(base), offset)
        <<
    }
    b := map_reg(base)
    if offset >= -255 && offset <= 32760 {
        a.load_d_offset(fd, b, offset)
    } else if offset < 0 {
        abs_off := 0 - offset
        mut hi := 0
        mut lo := abs_off
        if abs_off > 4095 {
            hi = (abs_off >> 12) << 12
            lo = abs_off - hi
        }
        if hi == 0 {
            a.sub_imm(17, b, lo)
            a.ldur_d(fd, 17, 0)
        } else if lo <= 256 {
            hi12 := (hi >> 12) & 4095
            a.emit32(3506438144 | (1 << 22) | (hi12 << 10) | (b << 5) | 17)
            if lo == 0 {
                a.ldur_d(fd, 17, 0)
            } else {
                a.ldur_d(fd, 17, 0 - lo)
            }
        } else {
            a.sub_imm(17, b, abs_off)
            a.ldur_d(fd, 17, 0)
        }
    } else if offset > 4095 && (offset & 4095) <= 255 && (offset >> 12) <= 4095 {
        hi12 := (offset >> 12) & 4095
        lo12 := offset & 4095
        a.emit32(2432696320 | (1 << 22) | (hi12 << 10) | (b << 5) | 17)
        if lo12 == 0 {
            a.ldur_d(fd, 17, 0)
        } else {
            a.ldur_d(fd, 17, lo12)
        }
    } else {
        a.mov_reg(17, b)
        if offset >= 0 {
            a.add_imm(17, 17, offset)
        } else {
            a.sub_imm(17, 17, 0 - offset)
        }
        a.ldur_d(fd, 17, 0)
    }
}

fn (a &mut Assembler) be_fload_scaled(fd int, base int, index int) {
    if a.arch != 0 {
        <<
    }
    a.ldr_d_reg_lsl(fd, map_reg(base), map_reg(index))
}

fn (a &mut Assembler) be_fstore_scaled(base int, index int, fd int) {
    if a.arch != 0 {
        <<
    }
    a.str_d_reg_lsl(fd, map_reg(base), map_reg(index))
}

fn (a &mut Assembler) be_fstore(base int, offset int, fd int) {
    if a.arch == 1 {
        a.x64_movsd_store(x64_map_reg(base), offset, fd)
        <<
    }
    b := map_reg(base)
    if offset >= -255 && offset <= 32760 {
        a.store_d_offset(fd, b, offset)
    } else if offset < 0 {
        abs_off := 0 - offset
        mut hi := 0
        mut lo := abs_off
        if abs_off > 4095 {
            hi = (abs_off >> 12) << 12
            lo = abs_off - hi
        }
        if hi == 0 {
            a.sub_imm(17, b, lo)
            a.stur_d(fd, 17, 0)
        } else if lo <= 256 {
            hi12 := (hi >> 12) & 4095
            a.emit32(3506438144 | (1 << 22) | (hi12 << 10) | (b << 5) | 17)
            if lo == 0 {
                a.stur_d(fd, 17, 0)
            } else {
                a.stur_d(fd, 17, 0 - lo)
            }
        } else {
            a.sub_imm(17, b, abs_off)
            a.stur_d(fd, 17, 0)
        }
    } else if offset > 4095 && (offset & 4095) <= 255 && (offset >> 12) <= 4095 {
        hi12 := (offset >> 12) & 4095
        lo12 := offset & 4095
        a.emit32(2432696320 | (1 << 22) | (hi12 << 10) | (b << 5) | 17)
        if lo12 == 0 {
            a.stur_d(fd, 17, 0)
        } else {
            a.stur_d(fd, 17, lo12)
        }
    } else {
        a.mov_reg(17, b)
        if offset >= 0 {
            a.add_imm(17, 17, offset)
        } else {
            a.sub_imm(17, 17, 0 - offset)
        }
        a.stur_d(fd, 17, 0)
    }
}

fn (a &mut Assembler) be_fadd_dd(dd int, dn int, dm int) {
    if a.arch == 1 {
        a.xbe_sse_binop_d(dd, dn, dm, 1, 0)
    } else {
        a.fadd_d(dd, dn, dm)
    }
}

fn (a &mut Assembler) be_fsub_dd(dd int, dn int, dm int) {
    if a.arch == 1 {
        a.xbe_sse_binop_d(dd, dn, dm, 0, 1)
    } else {
        a.fsub_d(dd, dn, dm)
    }
}

fn (a &mut Assembler) be_fmul_dd(dd int, dn int, dm int) {
    if a.arch == 1 {
        a.xbe_sse_binop_d(dd, dn, dm, 1, 2)
    } else {
        a.fmul_d(dd, dn, dm)
    }
}

fn (a &mut Assembler) be_fmadd_dddd(dd int, dn int, dm int, da int) {
    if a.arch == 1 {
        // No SSE FMA in baseline path: mul into dd then add da.
        a.xbe_sse_binop_d(dd, dn, dm, 1, 2)
        a.xbe_sse_binop_d(dd, dd, da, 1, 0)
    } else {
        a.fmadd_d(dd, dn, dm, da)
    }
}

fn (a &mut Assembler) be_fmsub_dddd(dd int, dn int, dm int, da int) {
    if a.arch == 1 {
        // mul into scratch then sub from da.
        a.xbe_sse_binop_d(0, dn, dm, 1, 2)
        a.xbe_sse_binop_d(dd, da, 0, 0, 1)
    } else {
        a.fmsub_d(dd, dn, dm, da)
    }
}

fn (a &mut Assembler) be_fnmsub_dddd(dd int, dn int, dm int, da int) {
    if a.arch == 1 {
        // mul into scratch then sub from da.
        a.xbe_sse_binop_d(0, dn, dm, 1, 2)
        a.xbe_sse_binop_d(dd, da, 0, 0, 1)
    } else {
        a.fnmsub_d(dd, dn, dm, da)
    }
}

fn (a &mut Assembler) be_fdiv_dd(dd int, dn int, dm int) {
    if a.arch == 1 {
        a.xbe_sse_binop_d(dd, dn, dm, 0, 3)
    } else {
        a.fdiv_d(dd, dn, dm)
    }
}

fn (a &mut Assembler) be_fsqrt_dd(dd int, dn int) {
    if a.arch == 1 {
        a.x64_sqrtsd(dd, dn)
    } else {
        a.fsqrt_d(dd, dn)
    }
}

fn (a &mut Assembler) be_fmov_d_from_gpr(fd int, src int) {
    if a.arch == 1 {
        a.x64_movq_xmm_from_r(fd, x64_map_reg(src))
    } else {
        a.fmov_d_from_x(fd, map_reg(src))
