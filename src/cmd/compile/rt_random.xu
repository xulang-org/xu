@main

#xu/types

// Minimal hosted random-fill ABI. The core only obtains bytes from the
// platform provider; callers own API shape, policy and fallback selection.
// Windows resolves BCryptGenRandom dynamically to avoid a static bcrypt
// import and to keep the ABI available on both x64 and ARM64 targets.
fn rt_emit_sys_random_fill(a $&Assembler) {
    a.align_data(8)
    a.data_label("_rt_random_dll")
    rt_emit_bytes(a, "bcrypt.dll")
    a.emit_data([0])
    a.data_label("_rt_random_name")
    rt_emit_bytes(a, "BCryptGenRandom")
    a.emit_data([0])
    a.data_label("_rt_random_fp")
    rt_emit_zeros(a, 8)
    a.data_label("_rt_random_error")
    rt_emit_bytes(a, "system random source unavailable")
    a.data_label("_rt_random_urandom")
    rt_emit_bytes(a, "/dev/urandom")
    a.emit_data([0])
    a.data_label("_rt_random_urandom_fd")
    rt_emit_u64(a, -1)

    a.label("_rt_sys_random_fill")
    if a.os == 2 {
        // Windows: cache BCryptGenRandom pointer and call it for each request.
        a.prologue(64)
        a.store(15, -8, 0)
        a.store(15, -16, 18)
        a.load(1, 15, -16)
        a.vm_cmp_imm(1, 0)
        a.jle("_rt_random_empty")
        a.mov(18, 1)
        a.call("_rt_alloc")
        a.store(15, -24, 14)
        a.lea(18, "_rt_random_fp")
        a.load(19, 18, 0)
        a.vm_cbz(19, "_rt_random_load_fp")
        a.store(15, -40, 19)
        a.jmp("_rt_random_have_fp")

        a.label("_rt_random_load_fp")
        // HMODULE h = LoadLibraryA("bcrypt.dll").
        a.lea(18, "_rt_random_dll")
        a.vm_call_iat("_iat_LoadLibraryA")
        a.vm_cbz(14, "_rt_random_free_fail")
        a.store(15, -32, 14)

        // FARPROC p = GetProcAddress(h, "BCryptGenRandom").
        a.load(18, 15, -32)
        a.lea(19, "_rt_random_name")
        a.vm_call_iat("_iat_GetProcAddress")
        a.vm_cbz(14, "_rt_random_free_fail")
        a.mov(1, 14)
        a.lea(18, "_rt_random_fp")
        a.store(18, 0, 1)
        a.store(15, -40, 1)

        a.label("_rt_random_have_fp")
        // BCryptGenRandom(NULL, output, n, BCRYPT_USE_SYSTEM_PREFERRED_RNG).
        a.vm_mov_imm(18, 0)
        a.load(19, 15, -24)
        a.load(20, 15, -16)
        a.vm_mov_imm(21, 2)
        a.load(1, 15, -40)
        a.vm_call_win_fp(1)
        a.vm_cmp_imm(14, 0)
        a.jne("_rt_random_free_fail")
        a.jmp("_rt_random_ok")

        a.label("_rt_random_free_fail")
        a.load(18, 15, -24)
        a.call("_rt_free")
        a.label("_rt_random_fail")
        rt_call_throw_strerr_static(a, -8, "_rt_random_error", 32)
        a.epilogue()

        a.label("_rt_random_empty")
        a.load(0, 15, -8)
        a.vm_mov_imm(1, 0)
        a.store(0, 0, 1)
        a.store(0, -8, 1)
        a.store(0, -16, 1)
        a.store(0, -24, 1)
        a.epilogue()

        a.label("_rt_random_ok")
        a.load(0, 15, -8)
        a.vm_mov_imm(1, 0)
        a.store(0, 0, 1)
        a.load(1, 15, -24)
        a.store(0, -8, 1)
        a.load(1, 15, -16)
        a.store(0, -16, 1)
        a.store(0, -24, 1)
        a.epilogue()
    } else {
        // Unix fast-path: cache /dev/urandom fd and fill directly with read().
        a.prologue(64)
        a.store(15, -8, 0)
        a.store(15, -16, 18)
        a.vm_cmp_imm(18, 0)
        a.jle("_rt_random_empty")

        a.vm_mov_imm(0, 0)
        a.store(15, -24, 0)
        a.vm_mov_imm(0, 0)
        a.store(15, -32, 0)
        a.lea(18, "_rt_random_urandom_fd")
        a.load(19, 18, 0)
        // Signed compare against 0: cached fd is -1 until open succeeds.
        // `cmp_imm(19, -1)` is unreliable across imm encodings.
        a.vm_cmp_imm(19, 0)
        a.jlt("_rt_random_need_open")
        a.jmp("_rt_random_have_fd")
        a.label("_rt_random_need_open")

        if a.os == 1 && (a.arch == 0 || a.arch == 4 || a.arch == 5) {
            a.vm_mov_imm(18, -100) // AT_FDCWD
            a.lea(19, "_rt_random_urandom")
            a.vm_mov_imm(20, 0)
            a.vm_mov_imm(21, 420)
        } else {
            a.lea(18, "_rt_random_urandom")
            a.vm_mov_imm(19, 0)
            a.vm_mov_imm(20, 420)
        }
        a.vm_syscall(syscall_number(a.os, a.arch, 4))
        a.vm_normalize_syscall("_rt_random_n1")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_random_fail")
        a.mov(1, 14)
        a.lea(18, "_rt_random_urandom_fd")
        a.store(18, 0, 1)

        a.label("_rt_random_have_fd")
        a.lea(18, "_rt_random_urandom_fd")
        a.load(18, 18, 0)
        a.store(15, -40, 18)

        a.load(18, 15, -16)
        a.call("_rt_alloc")
        a.store(15, -24, 14)

        a.label("_rt_random_loop")
        a.load(0, 15, -16)
        a.load(1, 15, -32)
        a.sub(2, 0, 1)
        // SUB does not set ARM64 flags (nor the emulated comparison state
        // on flagless targets). Test the remaining count explicitly.
        a.vm_cmp_imm(2, 0)
        a.jle("_rt_random_ok")

        a.load(18, 15, -40)
        a.load(19, 15, -24)
        a.load(20, 15, -32)
        a.add(19, 19, 20)
        // Pass remaining byte count (n - got in Vreg 2), not total n, to avoid
        // overflowing the allocated heap buffer after a partial read.
        a.mov(20, 2)
        a.vm_syscall(syscall_number(a.os, a.arch, 5))
        a.vm_normalize_syscall("_rt_random_n2")
        a.vm_cmp_imm(14, 0)
        a.jle("_rt_random_fail")

        a.load(1, 15, -32)
        a.add(1, 1, 14)
        a.store(15, -32, 1)
        a.jmp("_rt_random_loop")

        a.label("_rt_random_fail")
        a.load(18, 15, -24)
        a.vm_cbz(18, "_rt_random_fail_throw")
        a.call("_rt_free")
        a.vm_mov_imm(0, 0)
        a.store(15, -24, 0)
        a.label("_rt_random_fail_throw")
        rt_call_throw_strerr_static(a, -8, "_rt_random_error", 32)
        a.epilogue()

        a.label("_rt_random_ok")
        a.load(0, 15, -8)
        a.vm_mov_imm(1, 0)
        a.store(0, 0, 1)
        a.load(1, 15, -24)
        a.store(0, -8, 1)
        a.load(1, 15, -16)
        a.store(0, -16, 1)
        a.store(0, -24, 1)
        a.epilogue()

        a.label("_rt_random_empty")
        a.load(0, 15, -8)
        a.vm_mov_imm(1, 0)
        a.store(0, 0, 1)
        a.store(0, -8, 1)
        a.store(0, -16, 1)
        a.store(0, -24, 1)
        a.epilogue()
    }
}
