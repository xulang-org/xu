@main

#xu/types

// SSE2 prefix for wrapping i64 `sum += i & constant; i += 1`.
// Prove the complete self-loop, then leave ordinary iterations to define
// every MIR live-out and retain the original branch/local-store behavior.
fn match_x64_iand(m &types.Mir, fi int, bi int) VecPat {
    if types.mir_btkind(m, fi, bi) != 2 || types.mir_btb(m, fi, bi) != bi { << vec_none() }
    mut first := -1
    mut second := -1
    mut count := 0
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == 3 {
            if first < 0 { first = ii }
            else if second < 0 { second = ii }
            else { << vec_none() }
        } else if k == 4 { count += 1 }
        else if k == 2 {
            l := types.mir_ib(m, fi, ii)
            t := types.mir_ia(m, fi, ii)
            if types.mir_local_ty(m, fi, l) != 1 || types.mir_local_nslots(m, fi, l) != 1 { << vec_none() }
            if types.mir_temp_ty(m, fi, t) != 1 || types.mir_temp_nslots(m, fi, t) != 1 { << vec_none() }
        } else if k != 0 { << vec_none() }
        ii = types.mir_inext(m, fi, ii)
    }
    if first < 0 || second < 0 || count != 4 { << vec_none() }
    acc := types.mir_ia(m, fi, first)
    ind := types.mir_ia(m, fi, second)
    if acc == ind || types.mir_local_ty(m, fi, acc) != 1 || types.mir_local_ty(m, fi, ind) != 1 { << vec_none() }
    if types.mir_local_nslots(m, fi, acc) != 1 || types.mir_local_nslots(m, fi, ind) != 1 { << vec_none() }
    next := types.mir_ib(m, fi, second)
    if !vec_is_add1_of(m, fi, bi, next, 1073741824 + ind) { << vec_none() }
    inc := x64_loop_def(m, fi, bi, next)
    if !x64_loop_after(m, fi, bi, first, inc) || !x64_loop_after(m, fi, bi, inc, second) { << vec_none() }
    cmp := x64_loop_def(m, fi, bi, types.mir_bta(m, fi, bi))
    if cmp < 0 { << vec_none() }
    lhs := x64_loop_def(m, fi, bi, types.mir_ic(m, fi, cmp))
    if !x64_loop_after(m, fi, bi, second, lhs) { << vec_none() }
    if !x64_loop_after(m, fi, bi, lhs, cmp) { << vec_none() }
    mut p := x64_loop_limit(m, fi, bi, cmp, 1073741824 + ind, next)
    if p.kind == 0 || p.limit_t == 1073741824 + acc { << vec_none() }
    add := x64_loop_def(m, fi, bi, types.mir_ib(m, fi, first))
    if add < 0 || types.mir_ikind(m, fi, add) != 4 || types.mir_ib(m, fi, add) != 1 { << vec_none() }
    c := types.mir_ic(m, fi, add)
    d := types.mir_id(m, fi, add)
    mut value := -1
    mut old := -1
    if vec_load_is_local(m, fi, bi, c, acc) { value = d
        old = c }
    else if vec_load_is_local(m, fi, bi, d, acc) { value = c
        old = d }
    if !x64_loop_after(m, fi, bi, x64_loop_def(m, fi, bi, old), add) || !x64_loop_after(m, fi, bi, add, first) { << vec_none() }
    mask := x64_loop_def(m, fi, bi, value)
    if mask < 0 || types.mir_ikind(m, fi, mask) != 4 || types.mir_ib(m, fi, mask) != 14 { << vec_none() }
    mc := types.mir_ic(m, fi, mask)
    md := types.mir_id(m, fi, mask)
    mut constant := -1
    if vec_load_is_local(m, fi, bi, mc, ind) && vec_has_const(m, fi, md) { constant = md }
    else if vec_load_is_local(m, fi, bi, md, ind) && vec_has_const(m, fi, mc) { constant = mc }
    if constant > 0 - 2 || !x64_loop_after(m, fi, bi, mask, second) { << vec_none() }
    if !x64_loop_after(m, fi, bi, mask, add) { << vec_none() }
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 4 && ii != inc && ii != cmp && ii != add && ii != mask { << vec_none() }
        ii = types.mir_inext(m, fi, ii)
    }
    p.kind = 21
    p.ind = 1073741824 + ind
    p.acc = 1073741824 + acc
    p.mask = vec_const(m, fi, constant)
    << p
}

fn emit_x64_iand_prefix(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int) {
    mut p := match_x64_iand(m, fi, bi)
    if p.kind == 0 { p = match_x64_ssa_iand(m, fi, bi) }
    if p.kind == 0 { << }
    for t in 0:fr.temp_slot.len {
        if is_fp_vreg_slot(fr.temp_slot[t]) { << }
        if is_vreg_slot(fr.temp_slot[t]) {
            h := vreg_slot_home(fr.temp_slot[t])
            if (h < 2 || h > 5) && h != 9 { << }
        }
    }
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi) + "_x64_iand"
    done := pref + "_scalar"
    x64_loop_load(a, m, fi, fr, p.ind, 18)
    if p.limit_t >= 0 { x64_loop_load(a, m, fi, fr, p.limit_t, 19) }
    else { a.vm_mov_imm64(19, p.limit) }
    a.vm_cmp_imm(18, 0)
    a.jlt(done + "")
    a.cmp(18, 19)
    a.jge(done + "")
    a.vm_sub_imm(19, 19, 8)
    a.cmp(18, 19)
    a.jge(done + "")
    // xmm1=[i,i+1], xmm2=[mask,mask], xmm3=[2,2].
    a.x64_movq_xmm_from_r(1, x64_map_reg(18))
    a.vm_add_imm(18, 18, 1)
    a.x64_movq_xmm_from_r(4, x64_map_reg(18))
    a.vm_sub_imm(18, 18, 1)
    a.x64_packed_reg(108, 1, 4) // punpcklqdq
    a.vm_mov_imm64(14, p.mask)
    a.x64_movq_xmm_from_r(2, x64_map_reg(14))
    a.x64_packed_reg(108, 2, 2)
    a.vm_mov_imm64(14, 2)
    a.x64_movq_xmm_from_r(3, x64_map_reg(14))
    a.x64_packed_reg(108, 3, 3)
    a.x64_pxor(0, 0)
    a.x64_pxor(5, 5)
    a.label(pref + "_eight")
    for pair in 0:4 {
        a.x64_packed_reg(111, 4, 1) // movdqa
        a.x64_packed_reg(219, 4, 2) // pand
        mut dst := 0
        if (pair & 1) != 0 { dst = 5 }
        a.x64_packed_reg(212, dst, 4) // paddq
        a.x64_packed_reg(212, 1, 3)
    }
    a.vm_add_imm(18, 18, 8)
    a.cmp(18, 19)
    a.jlt(pref + "_eight")
    // Integer wrapping addition is associative modulo 2^64. Fold both
    // accumulators and lanes, then restore the original scalar locals.
    a.x64_packed_reg(212, 0, 5)
    a.x64_packed_reg(111, 4, 0)
    a.x64_psrldq(4, 8)
    a.x64_packed_reg(212, 0, 4)
    a.x64_movq_r_from_xmm(x64_map_reg(14), 0)
    x64_loop_load(a, m, fi, fr, p.acc, 0)
    a.add(0, 0, 14)
    if p.acc >= 1073741824 { a.store(15, slot_off(fr.local_slot[p.acc - 1073741824]), 0) }
    else { emit_store_scalar_temp(a, m, fi, fr, p.acc, 0) }
    x64_loop_store_ind(a, m, fi, fr, p.ind)
    a.label(done)
}
