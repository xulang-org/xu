@main

#xu/scanner
#xu/parser
#xu/ast
#xu/types
#xu/format
#errors
#os
#internal/modulepath

fn empty_parser() parser.Parser {
    $empty := []ast.Token{}
    << parser.new_parser(empty)
}

fn check_dir_xu_xuns(dir_paths []string, dir_mids []string, proj string) {
    n_paths := dir_paths.len
    n_mids := dir_mids.len
    for di in 0:n_paths {
        if dir_paths[di] == proj {
            check_xu_xun(dir_paths[di], "")
        } else {
            if di >= n_mids {
                <<< 1
            }
            check_xu_xun(dir_paths[di], dir_mids[di])
        }
    }
}

fn load_unit_resolve_imports(p $&parser.Parser, target_code int, imps $&[]string, roots $&[]string, mod_map $&types.StrMap, loaded_map $&types.StrMap, dir_paths $&[]string, dir_mids $&[]string, dir_map $&types.StrMap, proj0 string, req_keys &[]string, native_seen $&types.StrMap, native_objs $&[]XuObject, native_temps $&[]string) {
    // Resolve imports: local copy of root/imp then & (not &arr[i]).
    $ii := 0
    while ii < imps.len {
        $rlim := roots.len
        imp_name := imps[ii]
        $known := imp_name.len == 0 || mod_map.lookup(&imp_name) >= 0
        if !known {
            $got := 0
            slash := mod_id_to_slash(&imp_name)
            $external_dir := ""
            if modulepath.is_external(&imp_name) {
                external_dir = require_external_package(&proj0, &imp_name)
                rlim = 1
            }
            for ri in 0:rlim {
                if got == 0 {
                    root_i := roots[ri]
                    $cand := path_join(&root_i, &slash)
                    if external_dir.len > 0 { cand = external_dir + "" }
                    if dir_readable(&cand) == 1 {
                        reject_unmapped_import(&imp_name, &cand, &proj0, req_keys)
                        rd_body := os.listdir(str_clone(&cand)) or (err) {
                            <<< 1
                        }
                        $names := split_lines(rd_body)
                        names = sort_names(names)
                        $prefix := str_clone(&cand)
                        if prefix.len == 0 {
                            prefix = "."
                        }
                        if prefix[prefix.len - 1] != 47 {
                            prefix = prefix + "/"
                        }
                        $found_one := 0
                        n_names := names.len
                        for ni in 0:n_names {
                            nm := names[ni]
                            if nm.len >= 4 {
                                if nm[0] != 46 {
                                    if nm[nm.len - 3] == 46 && nm[nm.len - 2] == 120 && nm[nm.len - 1] == 117 {
                                        fkey := prefix + nm
                                        reject_unmapped_import(&imp_name, &fkey, &proj0, req_keys)
                                        if loaded_map.lookup(&fkey) < 0 {
                                            body1 := read_file(str_clone(&fkey)) or (err) {
                                                eprintln(cli_prog() + ": cannot read " + fkey)
                                                <<< 1
                                            }
                                            loaded_map.put(str_clone(&fkey), 1)
                                            $t1 := []ast.Token{}
                                            scanner.lex(body1, $&t1, str_clone(&fkey))
                                            $f1 := parser.new_parser(t1)
                                            f1.file_name = str_clone(&fkey)
                                            f1.parse_module()
                                            $mid1 := ""
                                            mid1 = mid1 + f1.module_id
                                            note_dir_module(&fkey, &mid1, &proj0, dir_paths, dir_mids, dir_map)
                                            if f1.module_id.len == 0 {
                                                eprintln(cli_prog() + ": missing module declaration (expected " + imp_name + ")")
                                                <<< 1
                                            }
                                            if f1.module_id != imp_name {
                                                eprintln(cli_prog() + ": module '" + f1.module_id + "' does not match import '" + imp_name + "'")
                                                <<< 1
                                            }
                                            if parser.compile_tags_match(&f1.compile_tags, target_os_name(target_code), target_arch_name(target_code)) {
                                                mod_map.put(f1.module_id, 1)
                                                n_fi := f1.imports.len
                                                for j in 0:n_fi {
                                                    imps.push(f1.imports[j])
                                                }
                                                p.merge_from(&f1)
                                                p.file_names.push(str_clone(&fkey))
                                                found_one = 1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if found_one == 1 {
                            load_manifest_native_dir(cand + "", imp_name + "", proj0 + "", target_code, p, mod_map, native_seen, native_objs, native_temps)
                            add_root(roots, &cand)
                            got = 1
                        }
                    }
                }
                if got == 0 && !modulepath.is_external(&imp_name) {
                    slash_xu := slash + ".xu"
                    root_i2 := roots[ri]
                    fkey2 := path_join(&root_i2, &slash_xu)
                    if file_readable(&fkey2) == 1 {
                        reject_unmapped_import(&imp_name, &fkey2, &proj0, req_keys)
                        if loaded_map.lookup(&fkey2) < 0 {
                            body2 := read_file(str_clone(&fkey2)) or (err) {
                                <<< 1
                            }
                            $t2 := []ast.Token{}
                            scanner.lex(body2, $&t2, str_clone(&fkey2))
                            $f2 := parser.new_parser(t2)
                            f2.file_name = str_clone(&fkey2)
                            f2.parse_module()
                            $mid2 := ""
                            mid2 = mid2 + f2.module_id
                            note_dir_module(&fkey2, &mid2, &proj0, dir_paths, dir_mids, dir_map)
                            if parser.compile_tags_match(&f2.compile_tags, target_os_name(target_code), target_arch_name(target_code)) {
                                if f2.module_id.len > 0 {
                                    mod_map.put(f2.module_id, 1)
                                }
                                n_fi2 := f2.imports.len
                                for j in 0:n_fi2 {
                                    imps.push(f2.imports[j])
                                }
                                p.merge_from(&f2)
                                p.file_names.push(str_clone(&fkey2))
                                loaded_map.put(str_clone(&fkey2), 1)
                                filedir := path_dirname(&fkey2)
                                load_manifest_native_dir(filedir + "", imp_name + "", proj0 + "", target_code, p, mod_map, native_seen, native_objs, native_temps)
                                add_root(roots, &filedir)
                                got = 1
                            }
                        }
                    }
                }
                if got == 0 && !modulepath.is_external(&imp_name) {
                    if slash != imp_name {
                        name_xu := imp_name + ".xu"
                        root_i3 := roots[ri]
                        fkey3 := path_join(&root_i3, &name_xu)
                        if file_readable(&fkey3) == 1 {
                            reject_unmapped_import(&imp_name, &fkey3, &proj0, req_keys)
                            if loaded_map.lookup(&fkey3) < 0 {
                                body3 := read_file(str_clone(&fkey3)) or (err) {
                                    <<< 1
                                }
                                $t3 := []ast.Token{}
                                scanner.lex(body3, $&t3, str_clone(&fkey3))
                                $f3 := parser.new_parser(t3)
                                f3.file_name = str_clone(&fkey3)
                                f3.parse_module()
                                $mid3 := ""
                                mid3 = mid3 + f3.module_id
                                note_dir_module(&fkey3, &mid3, &proj0, dir_paths, dir_mids, dir_map)
                                if parser.compile_tags_match(&f3.compile_tags, target_os_name(target_code), target_arch_name(target_code)) {
                                    if f3.module_id.len > 0 {
                                        mod_map.put(f3.module_id, 1)
                                    }
                                    n_fi3 := f3.imports.len
                                    for j in 0:n_fi3 {
                                        imps.push(f3.imports[j])
                                    }
                                    p.merge_from(&f3)
                                    p.file_names.push(str_clone(&fkey3))
                                    loaded_map.put(str_clone(&fkey3), 1)
                                    flatdir := path_dirname(&fkey3)
                                    load_manifest_native_dir(flatdir + "", imp_name + "", proj0 + "", target_code, p, mod_map, native_seen, native_objs, native_temps)
                                    add_root(roots, &flatdir)
                                    got = 1
                                }
                            }
                        }
                    }
                }
            }
        }
        ii = ii + 1
    }
}

// Ordinary runtime algorithms are loaded for syntax aliases and map types.
// Those live in the `runtime` package and must be imported explicitly.
fn load_unit_needs_runtime_algo(p &parser.Parser) bool {
    for i in 0:p.nodes.len {
        k := p.nodes[i].kind
        if k == ast.NT_MAP || k == ast.NK_MAP_INIT { << true }
        if k != ast.NK_CALL && k != ast.NK_METHOD_CALL { -> }
        name := p.nodes[i].sval
        if types.runtime_abi_syntax_id(&name) != 0 {
            << true
        }
    }
    << false
}

fn load_unit_m18(cli_paths []string, p $&parser.Parser, target_code int, native_objs $&[]XuObject, native_temps $&[]string, xacp bool, xacp_port int) {
    // Directory package input: a directory argument compiles every *.xu
    // inside it (non-recursive, dot-files skipped, name-sorted) as one unit.
    $paths := []string{}
    for i in 0:cli_paths.len {
        // Local copy then & — bootstrap &arr[i] is unsafe.
        cli := cli_paths[i]
        if dir_readable(&cli) == 1 {
            require_dir_xu_xun(str_clone(&cli))
            rd := os.listdir(str_clone(&cli)) or (err) {
                eprintln(cli_prog() + ": cannot read " + cli)
                <<< 1
            }
            names := sort_names(split_lines(rd))
            $got := 0
            for j in 0:names.len {
                nm := names[j]
                if nm.len >= 4 && nm[0] != 46 && nm[nm.len - 3] == 46 && nm[nm.len - 2] == 120 && nm[nm.len - 1] == 117 {
                    paths.push(path_join(&cli, &nm))
                    got = 1
                }
            }
            if got == 0 {
                eprintln(cli_prog() + ": no .xu files in " + cli)
                <<< 1
            }
        } else {
            paths.push(cli)
        }
    }
    // The hosted seed bridge retargets its payload to this Phase C anchor.
    $mod_map := types.new_strmap() // seed payload anchor
    $native_seen := types.new_strmap()
    for ni in 0:native_objs.len {
        native_module := native_objs[ni].module
        if native_module.len > 0 {
            native_seen.put(native_module, ni)
        }
    }
    $loaded_map := types.new_strmap()
    $imps := []string{}
    $roots := []string{}
    for mi in 0:p.mod_ids.len {
        midp := p.mod_ids[mi]
        if midp.len > 0 {
            mod_map.put(midp, 1)
        }
    }
    $dir_paths := []string{}
    $dir_mids := []string{}
    $dir_map := types.new_strmap()
    $proj_hold := []string{}
    if paths.len > 0 {
        p0 := paths[0]
        proj_hold.push(path_dirname(&p0))
    } else {
        proj_hold.push(".")
    }
    // M169/M183: project-root vendor/ then `require:` file: / http(s): / git: locators.
    proj0 := proj_hold[0]
    $project_guard := require_project_guard(&proj0)
    $req_keys := []string{}
    $req_vals := []string{}
    req_roots := resolve_require_roots(&proj0)
    collect_require_entries(&proj0, $&req_keys, $&req_vals)
    for ri in 0:req_roots.len {
        rr := req_roots[ri]
        add_root($&roots, &rr)
    }
    for i in 0:paths.len {
        pi := paths[i]
        body := read_file(str_clone(&pi)) or (err) {
            eprintln(cli_prog() + ": cannot read " + pi)
            <<< 1
        }
        loaded_map.put(str_clone(&pi), 1)
        d0 := path_dirname(&pi)
        add_root($&roots, &d0)
        $toks := []ast.Token{}
        scanner.lex(body, $&toks, str_clone(&pi))
        $fp := parser.new_parser(toks)
        fp.file_name = str_clone(&pi)
        fp.parse_module()
        $mid0 := ""
        mid0 = mid0 + fp.module_id
        note_dir_module(&pi, &mid0, &proj0, $&dir_paths, $&dir_mids, $&dir_map)
        if parser.compile_tags_match(&fp.compile_tags, target_os_name(target_code), target_arch_name(target_code)) {
            if fp.module_id.len > 0 {
                mod_map.put(fp.module_id, 1)
            }
            for j in 0:fp.imports.len {
                imps.push(fp.imports[j])
            }
            p.merge_from(&fp)
            p.file_names.push(str_clone(&pi))
        }
    }
    if xacp {
        // Parse a normal library call so imports, ownership and reachability
        // follow the same path as application code. Preserve main's return type.
        $main_decl := -1
        $main_file := -1
        for i in 0:p.decls.len {
            d := p.decls[i]
            if p.nodes[d].kind == ast.NK_FN && p.nodes[d].sval == "main" && p.nodes[d].sval2 == "main" {
                main_decl = d
                main_file = p.decl_file[i]
            }
        }
        if main_decl >= 0 {
            $toks := []ast.Token{}
            scanner.lex("@main\nxacp_stdio_control #xacp\nfn xacp_startup_hook() { xacp_stdio_control.stdio_preflight(" + str(xacp_port) + ") }\n", $&toks, "<xacp-startup>")
            $hook := parser.new_parser(toks)
            hook.parse_module()
            off := p.nodes.len
            stmt := hook.nodes[hook.decls[0]].c + off
            // Merge only the statement nodes and import metadata, not a
            // second function sharing main's statement chain.
            hook.decls = []int{}
            hook.decl_file = []int{}
            hook.nfn = 0
            p.merge_from(&hook)
            p.file_names.push("<xacp-startup>")
            // The inserted statement runs in main's file scope, so register
            // its explicit import there as well as in the generated hook.
            p.imp_owner.push("main")
            p.imp_path.push("xacp")
            p.imp_alias.push("xacp_stdio_control")
            p.imp_file.push(main_file)
            p.nodes[stmt].next = p.nodes[main_decl].c
            p.nodes[main_decl].c = stmt
            imps.push("xacp")
        }
    }
    for di in 0:dir_paths.len {
        manifest_dir := dir_paths[di]
        $expected_owner := ""
        if manifest_dir != proj0 && di < dir_mids.len {
            expected_owner = dir_mids[di] + ""
        }
        load_manifest_native_dir(manifest_dir, expected_owner, proj0 + "", target_code, p, $&mod_map, $&native_seen, native_objs, native_temps)
    }
    // M18: XUPATH (colon-separated) is a search root between the loaded
    // file dirs and cwd. Keep the first line as the frozen primer's anchor;
    // the actual delimiter follows the host OS, independently of --target.
    xsep := os.path_list_separator()
    xup := env_get("XUPATH") + string_from_byte(xsep)
    $xstart := 0
    for xi in 0:xup.len {
        if xup[xi] == xsep {
            if xi > xstart {
                seg := xup[xstart:xi]
                add_root($&roots, &seg)
            }
            xstart = xi + 1
        }
    }
    dot := "."
    add_root($&roots, &dot)
    trusted_std := require_stdlib_root()
    if trusted_std.len > 0 {
        add_root($&roots, &trusted_std)
        std_parent := path_dirname(&trusted_std)
        pkg_cand := std_parent + "/packages"
        if dir_readable(&pkg_cand) == 1 {
            add_root($&roots, &pkg_cand)
        }
    }
    src_root := "src"
    if dir_readable(&src_root) == 1 {
        add_root($&roots, &src_root)
    }
    if load_unit_needs_runtime_algo(&*p) {
        $already := 0
        for j in 0:imps.len {
            if imps[j] == "runtime" { already = 1 }
        }
        if already == 0 { imps.push("runtime") }
    }
    load_unit_resolve_imports(p, target_code, $&imps, $&roots, $&mod_map, $&loaded_map, $&dir_paths, $&dir_mids, $&dir_map, proj0 + "", &req_keys, $&native_seen, native_objs, native_temps)
    if load_unit_needs_runtime_algo(&*p) {
        $already2 := 0
        for j in 0:imps.len {
            if imps[j] == "runtime" { already2 = 1 }
        }
        $in_mod := 0
        $rk := "runtime"
        if mod_map.lookup(&rk) >= 0 { in_mod = 1 }
        if already2 == 0 && in_mod == 0 {
            imps.push("runtime")
            load_unit_resolve_imports(p, target_code, $&imps, $&roots, $&mod_map, $&loaded_map, $&dir_paths, $&dir_mids, $&dir_map, proj0 + "", &req_keys, $&native_seen, native_objs, native_temps)
        }
    }
    check_dir_xu_xuns(dir_paths, dir_mids, proj0)
    project_guard.close() or (err) { eprintln(err.msg())
        <<< 1 }
    if p.file_names.len == 0 {
        eprintln("no source files match target " + target_name(target_code))
        <<< 1
    }
}

fn load_native_input_expected(path string, target_code int, expected_module string, objs $&[]XuObject, temps $&[]string) {
    src := read_file(str_clone(&path)) or (err) {
        eprintln(cli_prog() + ": cannot read native input " + path)
        <<< 1
    }
    $raw := []int{}
    for i in 0:src.len {
        raw.push(src[i] & 255)
    }
    $archive := []int{}
    $archive_path := path + ""
    $object_kind := 1
    if path_is_xulib(path + "") {
        tn := target_name(target_code)
        archive = xuobj_xulib_extract(&raw, &tn)
        if archive.len == 0 {
            eprintln(path + ": XULIB has no valid slice for target " + tn)
            <<< 1
        }
        $tmp := os.temp_dir()
        if tmp.len == 0 {
            tmp = "/tmp"
        }
        archive_path = tmp + "/xu_native_" + str(now_ns() & 2147483647) + "_" + str(objs.len) + ".a"
        object_kind = 2
    } else {
        for i in 0:raw.len {
            archive.push(raw[i] & 255)
        }
    }
    $decode_bytes := []int{}
    for i in 0:archive.len {
        decode_bytes.push(archive[i] & 255)
    }
    $obj := xuobj_decode_archive(decode_bytes)
    if obj.module.len == 0 || obj.exports.len == 0 {
        eprintln(path + ": native archive has no Xu export metadata")
        <<< 1
    }
    if expected_module.len > 0 && obj.module != expected_module {
        eprintln(path + ": native module '" + obj.module + "' does not match xu.xun key '" + expected_module + "'")
        <<< 1
    }
    os := target_os(target_code)
    arch := target_arch(target_code)
    if !obj.matches_target(os, arch) {
        eprintln(path + ": native archive os/arch does not match target " + target_name(target_code))
        <<< 1
    }
    if object_kind == 1 && obj.code.len > 0 {
        object_kind = 0 // ordinary Xu static archive; merge its XUOBJ code.
    }
    if object_kind == 2 {
        write_file(archive_path + "", string_from_bytes(archive)) or (err) {
            eprintln(path + ": cannot extract XULIB target slice")
            <<< 1
        }
        temps.push(archive_path + "")
    }
    obj.path = archive_path
    obj.kind = object_kind // 1=static .a, 2=temporary XULIB slice; neither is a dylib.
    objs.push(obj)
}

fn load_native_input(path string, target_code int, objs $&[]XuObject, temps $&[]string) {
    load_native_input_expected(path, target_code, "", &*objs, &*temps)
}

fn split_native_inputs(paths []string, target_code int, sources $&[]string, objs $&[]XuObject, temps $&[]string) {
    for i in 0:paths.len {
        p := paths[i]
        if path_is_ar(p + "") || path_is_xulib(p + "") {
            load_native_input(p + "", target_code, objs, temps)
        } else {
            sources.push(p + "")
        }
    }
    if sources.len == 0 {
        eprintln(cli_prog() + ": no Xu source files to compile")
        <<< 1
    }
}

fn merge_native_stub_at(p $&parser.Parser, objs &[]XuObject, i int) {
    body := lib_stub_source(i, objs)
    file_name := "<native:" + objs[i].module + ">"
    $toks := []ast.Token{}
    scanner.lex(body, $&toks, file_name + "")
    $fp := parser.new_parser(toks)
    fp.file_name = file_name + ""
    fp.parse_module()
    p.merge_from(&fp)
    p.file_names.push(file_name + "")
}

fn merge_native_stubs(p $&parser.Parser, objs &[]XuObject) {
    for i in 0:objs.len {
        merge_native_stub_at(p, objs, i)
    }
}

fn native_locator_path(manifest_dir &string, native_module &string, locator string) string {
    if !starts_with(locator + "", "file:") {
        eprintln("xu.xun native '" + native_module + "': locator must start with file:")
        <<< 1
    }
    rest := locator[5:locator.len]
    if rest.len == 0 {
        eprintln("xu.xun native '" + native_module + "': empty file locator")
        <<< 1
    }
    $absolute := rest[0] == 47 || rest[0] == 92
    if rest.len >= 3 && rest[1] == 58 && (rest[2] == 47 || rest[2] == 92) {
        absolute = true
    }
    $out := ""
    if absolute {
        out = rest + ""
    } else {
        out = path_join(manifest_dir, &rest)
    }
    if !path_is_ar(out + "") && !path_is_xulib(out + "") {
        eprintln("xu.xun native '" + native_module + "': file must end in .a or .xulib")
        <<< 1
    }
    << out
}

fn load_manifest_native_dir(manifest_dir string, expected_owner string, project string, target_code int, p $&parser.Parser, mod_map $&types.StrMap, native_seen $&types.StrMap, objs $&[]XuObject, temps $&[]string) {
    empty_native := ""
    require_native_boundary(&project, &expected_owner, &manifest_dir, &empty_native)
    check_xu_xun(manifest_dir + "", expected_owner + "")
    $keys := []string{}
    $vals := []string{}
    $native_dir := manifest_dir + ""
    $from_root := false
    collect_native_entries(&native_dir, $&keys, $&vals)
    manifest := manifest_dir + "/xu.xun"
    // A package inside a canonical root module has no separate manifest.
    // Bind only the root's native modules that this loaded package imports.
    if !path_exists(&manifest) && modulepath.is_external(&expected_owner) {
        $req_keys := []string{}
        $req_vals := []string{}
        collect_require_entries(&project, $&req_keys, $&req_vals)
        selected := require_external_provider(&project, &expected_owner, &req_keys, &req_vals)
        key := req_keys[selected]
        locator := req_vals[selected]
        native_dir = require_external_root(&project, &key, &locator)
        require_check_external_root(&native_dir, &key)
        collect_native_entries(&native_dir, $&keys, $&vals)
        from_root = true
    }
    for i in 0:keys.len {
        native_module := keys[i]
        if from_root {
            $used := false
            for pi in 0:p.imp_path.len {
                if p.imp_path[pi] == native_module && p.imp_owner[pi] == expected_owner { used = true }
            }
            if !used { -> }
        }
        if native_seen.lookup(&native_module) >= 0 {
            ->
        }
        locator := vals[i]
        native_path := native_locator_path(&native_dir, &native_module, locator)
        require_native_boundary(&project, &expected_owner, &native_dir, &native_path)
        obj_index := objs.len
        load_native_input_expected(native_path, target_code, native_module + "", &*objs, &*temps)
        native_seen.put(native_module + "", obj_index)
        mod_map.put(native_module + "", 1)
        merge_native_stub_at(p, &*objs, obj_index)
    }
}


// ===== build: full compiler chain =====

// m32 build options (grouped to stay under the 6-argument ABI limit).
struct BuildOpts {
    names   []string
    filter  string
    verbose bool
    cover   bool
    test    bool
    debug   bool
    timings bool
    no_regcache bool
    opt_level int
    ra_level int
    lib bool
    shared bool
    emit_obj bool
    objs []XuObject
    failfast bool
    count int
    list bool
    short bool
    bench string
    allow_int64_pairs bool
    board string
    xacp bool
    xacp_port int
}

fn print_timings_line(load int, parse int, check int, mir int, emit int, bin int, total int) {
    eprintln("timings: load=" + str(load) + "ms parse=" + str(parse) + "ms check=" + str(check) + "ms mir=" + str(mir) + "ms emit=" + str(emit) + "ms bin=" + str(bin) + "ms total=" + str(total) + "ms")
}

fn build_configure_assembler(a $&Assembler, opts &BuildOpts, os int, arch int) {
    a.allow_int64_pairs = opts.allow_int64_pairs
    a.board = opts.board
    a.cover = opts.cover
    a.test = opts.test
    a.test_short = opts.short
    a.xacp = opts.xacp
    a.xacp_port = opts.xacp_port
    if opts.no_regcache {
        a.rc_on = false
        a.rc_carry = false
        a.rc_s_pool = false
        a.rc_ls = false
        a.ra_level = 0
        <<
    }
    if opts.ra_level < 0 {
        <<
    }
    n := opts.ra_level
    $hosted := false
    if os != 3 {
        if arch == 0 {
            hosted = true
        }
        if arch == 1 {
            hosted = true
        }
    }
    a.ra_level = n
    a.rc_on = false
    a.rc_carry = false
    a.rc_s_pool = false
    a.rc_ls = false
    if hosted {
        if n >= 1 {
            a.rc_on = true
        }
        // Experimental RA1 carry isolation: keep the RA1 register layout and
        // S-pool unchanged, but allow strict single-predecessor cache carry.
        if n >= 1 {
            a.rc_carry = true
        }
        if n >= 2 {
            if arch == 0 {
                a.rc_s_pool = true
            }
        }
        if n >= 3 {
            a.rc_ls = true
        }
    }
}

fn build_link_static_objs(a $&Assembler, opts &BuildOpts) {
    for i in 0:opts.objs.len {
        $skip_dy := false
        for j in 0:opts.objs[i].ldata.len {
            if opts.objs[i].ldata[j] == 2 {
                skip_dy = true
            }
        }
        if !skip_dy {
            if opts.objs[i].code.len == 0 && opts.objs[i].exports.len > 0 {
                skip_dy = true
            }
        }
        if skip_dy {
            ->
        }
        code_off := a.code.len
        data_off := a.data.len
        for j in 0:opts.objs[i].code.len {
            a.code.push(opts.objs[i].code[j])
        }
        for j in 0:opts.objs[i].data.len {
            a.data.push(opts.objs[i].data[j])
        }
        for j in 0:opts.objs[i].lname.len {
            nm := opts.objs[i].lname[j]
            existing := a.label_index(str_clone(&nm))
            if existing < 0 || lab_off(&a.labels, existing) < 0 {
                off := opts.objs[i].loff[j]
                if opts.objs[i].ldata[j] != 0 {
                    ln2 := opts.objs[i].lname[j]
                    a.data_label_at(str_clone(&ln2), data_off + off)
                } else {
                    ln3 := opts.objs[i].lname[j]
                    a.label_at(str_clone(&ln3), code_off + off)
                }
            }
        }
        for j in 0:opts.objs[i].rkind.len {
            labj := opts.objs[i].rlab[j]
            a.push_fixup_at(opts.objs[i].rkind[j], code_off + opts.objs[i].roff[j], &labj, opts.objs[i].rrd[j])
        }
    }
}

fn build_write_native(a $&Assembler, m &types.Mir, opts &BuildOpts, os int, arch int, out_path string) int {
    $out := []int{}
    $start := 0
    if os == 3 {
        $e := new_elf32_mps2()
        if arch == 3 {
            e = new_elf32_riscv_virt()
        } else if arch == 2 {
            if opts.board == "stm32f4" {
                e = new_elf32_stm32f4()
            } else if opts.board != "" && opts.board != "mps2-an386" {
                eprintln("error: unsupported board '" + opts.board + "' for target 'thumbv7em-none' (supported: mps2-an386, stm32f4)")
                <<< 1
            }
        }
        $flash_limit := 4194304
        $sram_limit := 4194304
        $bname := "mps2-an386"
        if opts.board == "stm32f4" {
            flash_limit = 1048576
            sram_limit = 131072
            bname = "stm32f4"
        }
        if a.code.len + e.vector_size > flash_limit {
            eprintln("error: code size " + str(a.code.len + e.vector_size) + " exceeds " + bname + " Flash capacity " + str(flash_limit))
            <<< 1
        }
        if a.data.len > sram_limit {
            eprintln("error: data size " + str(a.data.len) + " exceeds " + bname + " SRAM capacity " + str(sram_limit))
            <<< 1
        }
        a.code_vaddr = e.code_vaddr()
        a.data_vaddr = e.data_vaddr(a.code.len)
        a.fixup_all()
        e.generate(&*a, $&out)
    } else {
    if os == 0 {
        // Mach-O
        if arch == 0 {
            $mo := new_macho()
            mo = macho_apply_dylibs(mo, &*a)
            if opts.debug {
                mo = mo.with_debug()
            }
            a.code_vaddr = mo.code_vaddr()
            a.data_vaddr = mo.data_vaddr(a.code.len)
            a.fixup_all()
            start = a.label_offset("_start")
            if opts.debug {
                di := collect_debug_info(&*a, m)
                sec := encode_dwarf(&di, a.code_vaddr, a.code.len)
                out = mo.generate_debug(&*a, start, &sec)
            } else {
                out = mo.generate(&*a, start)
            }
        } else {
            $mo := new_macho_x64()
            mo = macho_apply_dylibs(mo, &*a)
            if opts.debug {
                mo = mo.with_debug()
            }
            a.code_vaddr = mo.code_vaddr()
            a.data_vaddr = mo.data_vaddr(a.code.len)
            a.fixup_all()
            start = a.label_offset("_start")
            if opts.debug {
                di := collect_debug_info(&*a, m)
                sec := encode_dwarf(&di, a.code_vaddr, a.code.len)
                out = mo.generate_debug(&*a, start, &sec)
            } else {
                out = mo.generate(&*a, start)
            }
        }
    } else if os == 1 {
        // ELF
        if arch == 2 {
            e := new_elf32_linux_arm()
            a.code_vaddr = e.code_vaddr()
            a.data_vaddr = e.data_vaddr(a.code.len)
            a.fixup_all()
            start = a.label_offset("_start")
            e.generate_linux(&*a, start, $&out)
        } else if arch == 0 {
            e := new_elf_arm64()
            a.code_vaddr = e.code_vaddr()
            a.data_vaddr = e.data_vaddr(a.code.len)
            a.fixup_all()
            start = a.label_offset("_start")
            if opts.debug {
                di := collect_debug_info(&*a, m)
                sec := encode_dwarf(&di, a.code_vaddr, a.code.len)
                e.generate_debug(&*a, start, $&out, &sec)
            } else {
                e.generate(&*a, start, $&out)
            }
        } else {
            $e := new_elf_x64()
            if arch == 4 {
                e = new_elf_loong()
            }
            if arch == 5 {
                e = new_elf_riscv64()
            }
            a.code_vaddr = e.code_vaddr()
            a.data_vaddr = e.data_vaddr(a.code.len)
            a.fixup_all()
            start = a.label_offset("_start")
            if opts.debug {
                di := collect_debug_info(&*a, m)
                sec := encode_dwarf(&di, a.code_vaddr, a.code.len)
                e.generate_debug(&*a, start, $&out, &sec)
            } else {
                e.generate(&*a, start, $&out)
            }
        }
    } else {
        // PE (m33 non-target: no DWARF even with --debug).
        $pe := new_pe64()
        if arch == 0 {
            pe = new_pe64_arm64()
        }
        a.code_vaddr = pe.code_vaddr()
        a.data_vaddr = pe.data_vaddr(a.code.len)
        a.fixup_all()
        start = a.label_offset("_start")
        pe.generate(&*a, start, $&out)
    }
    }
    write_file(out_path, string_from_bytes(out)) or (err) {
        eprintln(cli_prog() + ": cannot write output file")
        << 1
    }
    // Apple Silicon AMFI: unsigned Mach-O is ~3ms slower to exec than
    // adhoc-signed. codesign needs the ≥32-byte pad after load commands.
    // Identifier must be stable (`xu`): default is the output basename, which
    // would make gen2.xin / gen3.xin differ and break the self-hosting cmp.
    // Matches bootstrap `codesign -s - -f -i xu`.
    if os == 0 {
        q := tool_shell_quote(&out_path)
        os_system("codesign -s - -f -i xu " + q + " >/dev/null 2>/dev/null")
    }
    << 0
}

fn build_write_lib(a $&Assembler, m &types.Mir, opts &BuildOpts, c_fns &[]types.CFn, os int, arch int, out_path string) int {
        $exports := []XuExport{}
        for i in 0:c_fns.len {
            if c_fns[i].is_pub && c_fns[i].recv < 0 && !c_fns[i].is_extern {
                $ps := []int{}
                for j in 0:c_fns[i].params.len {
                    ps.push(c_fns[i].params[j])
                }
                ret := c_fns[i].ret
                if !lib_export_ret_ok(ret) {
                    eprintln("library export types must be int, bool, string, f64, i32, u32, or u8")
                    << 1
                }
                $typs := []int{}
                for j in 0:ps.len {
                    t := ps[j]
                    if !lib_export_param_ok(t) {
                        eprintln("library export types must be int, bool, string, f64, i32, u32, or u8")
                        << 1
                    }
                    typs.push(t)
                }
                exports.push(XuExport{name: c_fns[i].name, label: c_fns[i].label, params: typs, ret: ret})
            }
        }
        $mid := ""
        for i in 0:c_fns.len {
            if c_fns[i].is_pub && c_fns[i].mod_id.len > 0 {
                mid0 := c_fns[i].mod_id
                mid = str_clone(&mid0)
            }
        }
        if opts.shared {
            if os != 0 || (arch != 0 && arch != 1) {
                eprintln(cli_prog() + ": --shared is only implemented for macos-arm64/macos-x64")
                << 1
            }
            $install := "libxu.dylib"
            if mid.len > 0 {
                install = "lib" + mid + ".dylib"
            }
            $expn := []string{}
            $expo := []int{}
            for i in 0:exports.len {
                nm := exports[i].label
                idx := a.label_index(str_clone(&nm))
                if idx >= 0 && idx < a.labels.len {
                    isd := a.labels[idx].is_data
                    off := a.labels[idx].offset
                    if isd == false {
                        expn.push(str_clone(&nm))
                        expo.push(off)
                    }
                }
            }
            for i in 0:expn.len {
                en := expn[i]
                a.lib_exp_name.push(str_clone(&en))
                a.lib_exp_off.push(expo[i])
            }
            if a.lib_exp_name.len == 0 {
                eprintln("shared library has no exported symbols in the object")
                << 1
            }
            $mo := new_macho()
            if arch == 1 {
                mo = new_macho_x64()
            }
            mo = macho_set_dylib(mo, &*a, install)
            if opts.debug {
                mo = mo.with_debug()
            }
            a.code_vaddr = mo.code_vaddr()
            a.data_vaddr = mo.data_vaddr(a.code.len)
            a.fixup_all()
            $outb := []int{}
            if opts.debug {
                di := collect_debug_info(&*a, m)
                sec := encode_dwarf(&di, a.code_vaddr, a.code.len)
                outb = mo.generate_debug(&*a, 0, &sec)
            } else {
                outb = mo.generate(&*a, 0)
            }
            meta := XuObject{os: xuobj_os_code(os), arch: xuobj_arch_code(arch), module: mid, path: "", kind: 0, exports: exports, code: []int{}, data: []int{}, lname: []string{}, loff: []int{}, ldata: []int{}, rkind: []int{}, roff: []int{}, rrd: []int{}, rlab: []string{}, mx_pk: []int{}, mx_po: []int{}, mx_pl: []string{}, mx_sn: []string{}, mx_st: []int{}, mx_ss: []int{}, mx_sd: []int{}, mx_sv: []int{}, mx_tr: []int{}, mx_dr: []int{}, mx_ndef: 0, mx_nund: 0}
            enc := xuobj_encode(&meta)
            for i in 0:enc.len {
                outb.push(enc[i])
            }
            write_file(out_path, string_from_bytes(outb)) or (err) {
                eprintln(cli_prog() + ": cannot write " + out_path)
                << 1
            }
            << 0
        }
        obj := a.snapshot_xuobj(mid, exports, os, arch)
        outb := xuobj_encode_archive(&obj)
        write_file(out_path, string_from_bytes(outb)) or (err) {
            eprintln(cli_prog() + ": cannot write " + out_path)
            << 1
        }
        << 0
}

struct DyLink {
    paths []string
    labs  []string
    ords  []int
}

fn build_collect_dylibs(opts &BuildOpts) DyLink {
    $dypaths := []string{}
    $dylabs := []string{}
    $dyords := []int{}
    $ndy := 0
    for i in 0:opts.objs.len {
        if opts.objs[i].kind == 1 || opts.objs[i].kind == 2 {
            ->
        }
        $is_dy := false
        $pth := ""
        for j in 0:opts.objs[i].ldata.len {
            if opts.objs[i].ldata[j] == 2 {
                is_dy = true
                ln := opts.objs[i].lname[j]
                pth = str_clone(&ln)
            }
        }
        if !is_dy {
            if opts.objs[i].code.len == 0 && opts.objs[i].exports.len > 0 {
                is_dy = true
                op := opts.objs[i].path
                pth = str_clone(&op)
            }
        }
        if is_dy {
            dypaths.push(pth)
            for k in 0:opts.objs[i].exports.len {
                el := opts.objs[i].exports[k].label
                dylabs.push(str_clone(&el))
                dyords.push(2 + ndy)
            }
            ndy += 1
        }
    }
    << DyLink{paths: dypaths, labs: dylabs, ords: dyords}
}

fn build_collect_externs(opts &BuildOpts, lib_ext $&[]string, extern_labs $&[]string) {
    for i in 0:opts.objs.len {
        $is_dy := opts.objs[i].kind == 1 || opts.objs[i].kind == 2
        for j in 0:opts.objs[i].ldata.len {
            if opts.objs[i].ldata[j] == 2 {
                is_dy = true
            }
        }
        if !is_dy {
            if opts.objs[i].code.len == 0 && opts.objs[i].exports.len > 0 {
                is_dy = true
            }
        }
        if is_dy {
            for k in 0:opts.objs[i].exports.len {
                el := opts.objs[i].exports[k].label
                lib_ext.push(str_clone(&el))
            }
        }
        for k in 0:opts.objs[i].exports.len {
            el := opts.objs[i].exports[k].label
            extern_labs.push(str_clone(&el))
        }
    }
}

fn build_apply_dylibs(a $&Assembler, dy &DyLink) {
    for i in 0:dy.paths.len {
        dp := dy.paths[i]
        a.dylib_paths.push(str_clone(&dp))
    }
    for i in 0:dy.labs.len {
        dl := dy.labs[i]
        a.dylib_labs.push(str_clone(&dl))
        if i < dy.ords.len {
            a.dylib_ords.push(dy.ords[i])
        } else {
            a.dylib_ords.push(2)
        }
    }
}

fn hold_run_checker(p &parser.Parser, target_code int, test_mode int, lib_mode int, lib_ext []string, extern_labs []string, m $&types.Mir, test_names []string, test_filter string, test_verbose bool, test_failfast bool, test_count int, test_list bool, out_fns $&[]types.CFn) int {
    $c := types.Checker{}
    c.set_mir_borrow_gate(env_get("XU_MIR_BORROW_GATE") == "1")
    c.set_mir_verify_passes(env_get("XU_VERIFY") == "1")
    c.set_mir_ssa_trace(env_get("XU_SSA_TRACE") == "1")
    types.run_checker($&c, p, target_code, test_mode, lib_mode, lib_ext, extern_labs, 1, m, test_names, test_filter, test_verbose, test_failfast, test_count, test_list, out_fns)
    << c.mir_time_ns()
}

fn build_parser(p $&parser.Parser, out_path string, target_code int, opts BuildOpts, front_ms int) int {
    if opts.xacp && (target_os(target_code) >= 3 || opts.lib || opts.shared || opts.test) {
        eprintln("xu: --xacp requires a hosted native executable")
        << 1
    }
    if target_code == 46 && (opts.lib || opts.shared || opts.emit_obj || opts.objs.len > 0 || opts.cover || opts.debug || opts.test) {
        eprintln("wasm32: native linking, object/library output, coverage, debug and native test harness are not supported")
        << 1
    }
    $t_all := now_ns()
    $t0 := now_ns()
    $check_ms := 0
    $mir_ms := 0
    $emit_ms := 0
    $bin_ms := 0
    dy := build_collect_dylibs(&opts)
    t0 = now_ns()
    nn := p.nodes.len
    if nn < 0 || nn > 10000000 {
        eprintln(cli_prog() + ": corrupt node count")
        << 1
    }
    $lib_mode := 0
    if opts.lib || opts.shared {
        lib_mode = 1
    }
    $lib_ext := []string{}
    $extern_labs := []string{}
    build_collect_externs(&opts, $&lib_ext, $&extern_labs)
    $test_mode := 0
    if opts.test {
        test_mode = 1
    } else {
        p.enforce_test_fn_placement()
    }
    $test_names := []string{}
    for i in 0:opts.names.len {
        test_names.push(opts.names[i])
    }
    $m := types.empty_mir()
    m.opt_level = opts.opt_level
    $c_fns := []types.CFn{}
    filt := opts.filter
    lower_ns := hold_run_checker(&*p, target_code, test_mode, lib_mode, lib_ext, extern_labs, $&m, test_names, str_clone(&filt), opts.verbose, opts.failfast, opts.count, opts.list, $&c_fns)
    p.release_after_check()
    types.mir_sweep_superseded($&m)
    dump_fn := env_get("XU_DUMP_MIR")
    if dump_fn != "" { types.mir_dump_named(&m, dump_fn) }
    check_ns := now_ns() - t0 - lower_ns
    check_ms = check_ns / TIME_NS_PER_MILLISECOND
    mir_ms = lower_ns / TIME_NS_PER_MILLISECOND
    t0 = now_ns()
    os := target_os(target_code)
    arch := target_arch(target_code)
    if os == 3 {
        if arch != 2 && arch != 3 && arch != 7 {
            eprintln("freestanding code generation is not implemented (E1)")
            << 1
        }
    }
    if arch == 7 {
        // E8 Xtensa: backend lands here once asm_xtensa/be_xtensa exist.
        eprintln("xtensa-esp32-none: backend not implemented yet (E8 in progress)")
        << 1
    }
    if arch == 2 || arch == 3 {
        // Linux ARM32 has a native 32-bit integer ABI; avoid the redundant
        // hosted closure proof on this target.
        if target_code != 12 && !(target_code == 32 && opts.allow_int64_pairs) {
            w32_warn := env_get("XU_WIDTH32") == "warn"
            if types.mir_width32_gate(&m, target_name(target_code), w32_warn) != 0 { << 1 }
        }
    }
    if target_code == 46 { << wasm_emit(&m, &c_fns, out_path) }
    $a := Assembler{
        code: []int{},
        data: []int{},
        labels: []Label{},
        label_keys: []string{},
        label_vals: []int{},
        label_used: []int{},
        label_n: 0,
        label_cap: 0,
        fixups: []Fixup{},
        code_vaddr: 0,
        data_vaddr: 0,
        drop_seq: 0,
        os: 0,
        arch: 0,
        cmp_fp: 0,
        cmp_a: 0,
        cmp_b: 0,
        cover: false,
        test: false,
        test_short: false,
        xacp: false,
        xacp_port: 0,
        rc_on: false,
        rc_ror32_facts: []int{},
        rc_fp_only: false,
        rc_fp_hold: false,
        rc_vreg_mask: 0,
        ra_level: 0,
        rc_carry: false,
        rc_s_pool: false,
        rc_ls: false,
        rc_nfn: 0,
        rc_kern_labs: []string{},
        rc_alu_fwd_fn: 0,
        rc_preserve_labs: []string{},
        rc_preserve_mask: []int{},
        cs_pairs: 0,
        rc_wb: false,
        rc_leaf: false,
        rc_nat_wb: false,
        rc_alu_eph: 0,
        rc_int_ephem_t: 0,
        rc_int_ephem_vr: 0,
        rc_int_ephem_ii: 0,
        rc_fused_cc: 0,
        rc_branch_cond: 0,
        rc_const_vr: 0,
        rc_const_val: 0,
        rc_hot_lbl: "",
        rc_slot: []int{},
        rc_used: []int{},
        rc_dirty: []int{},
        rc_alias: []int{},
        rc_tick: 0,
        rc_pin: []int{},
        rc_pin_dirty: []int{},
        rc_pin_alias: []int{},
        rc_s_hold: []int{},
        rc_blk_pin: []int{},
        rc_s_cache: []int{},
        rc_pred: []int{},
        rc_in_ok: []int{},
        rc_in_slot: []int{},
        rc_in_dirty: []int{},
        rc_in_alias: []int{},
        rc_in_used: []int{},
        rc_in_tick: []int{},
        rc_in_pin: []int{},
        oob_lbl: "",
        oob_need: 0,
        stack_check: false,
        rc_fp_pin: []int{},
        rc_fp_dirty: []int{},
        rc_fp_alias: []int{},
        rc_fp_alias2: []int{},
        rc_fp_rhs: 0,
        rc_fp_fma_dm: 0,
        rc_fp_ephem: 0,
        rc_fp_skip: 0,
        rc_fp_skip2: 0,
        rc_fp_skip3: 0,
        rc_fp_skip4: 0,
        rc_fp_skip_n: 0,
        pb_recv: -1,
        pb_local: -1,
        rc_cur_bi: 0,
        rc_next_bi: -1,
        rc_fp_blk: []int{},
        rc_loop_hot: []int{},
        rc_arg: []int{},
        rc_arg_alias: []int{},
        rc_addr_local: 0,
        rc_addr_vr: 0,
        rc_addr_alias: 0,
        rc_arr_t0: 0,
        rc_arr_t1: 0,
        rc_cur_arr: -1,
        rc_fp_inv_t: 0,
        rc_fp_inv_idx: 0,
        rc_fp_inv_ld: 0,
        rc_elem_vr: 0,
        rc_row_k0: 0,
        rc_row_k1: 0,
        rc_madd_k0: 0,
        rc_madd_k1: 0,
        rc_ind_local: 0,
        rc_kernel: 0,
        rc_fwd_ht: false,
        rc_ind_nocheck: 0,
        rc_ind_desc0: -1,
        rc_ind_desc1: -1,
        rc_and_nocheck: 0,
        rc_and_desc0: -1,
        rc_and_desc1: -1,
        rc_aik_loc: 0,
        rc_push_loc: 0,
        rc_push_ptr_off: 0,
        rc_push_len_off: 0,
        rc_push_cap_off: 0,
        rc_push_dirty: 0,
        rc_push_ii: 0,
        rc_push_elem: 0,
        rc_push_val_loc: 0,
        rc_push_stub: 0,
        rc_push_slow: "",
        rc_push_done: "",
        rc_fold_t0: 0,
        rc_fold_t1: 0,
        rc_fold_h0: 0,
        rc_fold_h1: 0,
        rc_fold_i0: 0,
        rc_fold_i1: 0,
        rc_fold_u0: 0,
        rc_fold_u1: 0,
        rc_pins: []int{},
        lib: 0,
        dylib_paths: []string{},
        dylib_labs: []string{},
        dylib_ords: []int{},
        lib_exp_name: []string{},
        lib_exp_off: []int{},
        ra_fn: 0,
        ra_try: 0,
        ra_vreg: 0,
        ra_rc: 0,
        ra_frame: 0,
        ra_keep_rc: 0,
        ra_empty: 0,
        ra_spill: 0,
        ra_report: opts.timings,
        vp_off: 0,
        vp_hits: []int{},
        xus_off: []int{},
        allow_int64_pairs: false,
        board: ""
    }
    init_assembler($&a, os, arch)
    build_configure_assembler($&a, &opts, os, arch)
    if !vp_configure($&a, env_get("XU_PATTERNS_OFF")) { << 1 }
    if opts.lib || opts.shared {
        a.lib = 1
    }
    build_apply_dylibs($&a, &dy)
    emit_program($&a, &m)
    build_link_static_objs($&a, &opts)
    emit_ms = (now_ns() - t0) / TIME_NS_PER_MILLISECOND
    if opts.emit_obj {
        $no_exp := []XuExport{}
        obj := a.snapshot_xuobj("main", no_exp, os, arch)
        outb := xuobj_encode(&obj)
        write_file(out_path, string_from_bytes(outb)) or (err) {
            eprintln(cli_prog() + ": cannot write " + out_path)
            << 1
        }
        << 0
    }
    if opts.lib || opts.shared {
        << build_write_lib($&a, &m, &opts, &c_fns, os, arch, out_path)
    }
    t0 = now_ns()
    wr := build_write_native($&a, &m, &opts, os, arch, out_path)
    if wr != 0 {
        << wr
    }
    bin_ms = (now_ns() - t0) / TIME_NS_PER_MILLISECOND
    if opts.timings {
        back_ms := (now_ns() - t_all) / TIME_NS_PER_MILLISECOND
        total_ms := front_ms + back_ms
        print_timings_line(front_ms, 0, check_ms, mir_ms, emit_ms, bin_ms, total_ms)
        types.mir_dump_opt_stats(&m)
        dump_ra_stats(&a)
        dump_pattern_stats(&a)
    }
    << 0
}

// ===== parse: front-end driver =====

fn parse_one(path string) {
    body := read_file(path) or (err) {
        eprintln(cli_prog() + ": cannot read " + path)
        <<< 1
    }
    $toks := []ast.Token{}
    scanner.lex(body, $&toks, str_clone(&path))
    ntok := toks.len
    $p := parser.new_parser(toks)
    p.file_name = str_clone(&path)
    p.parse_module()
    println(ast.stats_line(path, ntok, p.nodes.len, p.nfn, p.nstruct, p.niface))
}

// ===== hello: minimal emitter (M6b2-s1), macOS arm64 only =====
// Code/data live in local []int. Gen1-compiled Gen2 cannot grow slices
// that are fields of the large Assembler (`ncode=0` / SEGV on `&a.code`).

fn buf_emit32(code $&[]int, word int) {
    code.push(word & 255)
    code.push((word >> 8) & 255)
    code.push((word >> 16) & 255)
    code.push((word >> 24) & 255)
}

fn buf_patch32(code $&[]int, offset int, word int) {
    code[offset] = word & 255
    code[offset + 1] = (word >> 8) & 255
    code[offset + 2] = (word >> 16) & 255
    code[offset + 3] = (word >> 24) & 255
}

fn buf_mov_imm(code $&[]int, rd int, imm int) {
    buf_emit32(code, 3531603968 | ((imm & 65535) << 5) | rd)
    high16 := (imm >> 16) & 65535
    if high16 != 0 {
        buf_emit32(code, 4070572032 | (high16 << 5) | rd)
    }
    high32 := (imm >> 32) & 65535
    if high32 != 0 {
        buf_emit32(code, 4072669184 | (high32 << 5) | rd)
    }
    high48 := (imm >> 48) & 65535
    if high48 != 0 {
        buf_emit32(code, 4074766336 | (high48 << 5) | rd)
    }
}

fn hello_fill(code $&[]int, data $&[]int, m &MachO) {
    // ADRP x1, msg_page / ADD x1, x1, #off — patched below.
    buf_emit32(code, 2415919104 | 1)
    buf_emit32(code, 2432696320 | (1 << 5) | 1)
    buf_mov_imm(code, 2, 15)
    buf_mov_imm(code, 0, 1)
    buf_mov_imm(code, 16, 33554436)
    buf_emit32(code, 3556769793 | (128 << 5))
    buf_mov_imm(code, 0, 0)
    buf_mov_imm(code, 16, 33554433)
    buf_emit32(code, 3556769793 | (128 << 5))
    data.push(72)
    data.push(101)
    data.push(108)
    data.push(108)
    data.push(111)
    data.push(32)
    data.push(102)
    data.push(114)
    data.push(111)
    data.push(109)
    data.push(32)
    data.push(88)
    data.push(117)
    data.push(33)
    data.push(10)
    cv := m.code_vaddr()
    dv := m.data_vaddr(code.len)
    current_addr := cv
    target_addr := dv
    current_page := current_addr & -4096
    target_page := target_addr & -4096
    page_offset := (target_page - current_page) >> 12
    immlo := page_offset & 3
    immhi := (page_offset >> 2) & 524287
    buf_patch32(code, 0, 2415919104 | (immlo << 29) | (immhi << 5) | 1)
    off_in_page := target_addr & 4095
    buf_patch32(code, 4, 2432696320 | (off_in_page << 10) | (1 << 5) | 1)
}

fn emit_hello(out_path string) int {
    $code := []int{}
    $data := []int{}
    m := new_macho()
    hello_fill($&code, $&data, &m)
    out := m.generate_from(&code, &data, 0)

    write_file(out_path, string_from_bytes(out)) or (err) {
        eprintln(cli_prog() + ": cannot write output file")
        << 1
    }
    << 0
}
