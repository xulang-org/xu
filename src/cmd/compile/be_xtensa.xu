@main

// Xtensa LX6 (ESP32) backend for Xu (E8).
// Implements the Call0 ABI for bare-metal freestanding firmware.

fn xt_phys(v int) int {
    if v == 0 { << 8 }  // V0 = a8 (caller-saved)
    if v == 1 { << 9 }  // V1 = a9 (caller-saved)
    if v == 2 { << 10 } // V2 = a10 (caller-saved)
    if v == 3 { << 11 } // V3 = a11 (caller-saved)
    if v == 4 { << 6 }  // V4 = a6 (caller-saved / A4)
    if v == 5 { << 7 }  // V5 = a7 (caller-saved / A5)
    if v == 6 { << 10 } // V6 = a10
    if v == 7 { << 11 } // V7 = a11
    if v == 8 { << 12 } // S0 = a12 (callee-saved)
    if v == 9 { << 13 } // S1 = a13 (callee-saved)
    if v == 10 { << 14 } // S2 = a14 (callee-saved)
    if v == 11 { << 12 } // S3 = a12
    if v == 12 { << 13 } // S4 = a13
    if v == 13 { << 14 } // S5 = a14
    if v == 14 { << 2 }  // Ret = a2 (return value)
    if v == 15 { << 15 } // Fp = a15 (frame pointer)
    if v == 16 { << 1 }  // Sp = a1 (stack pointer)
    if v == 17 { << 0 }  // Lr = a0 (return address)
    if v >= 18 && v <= 23 { << v - 18 + 2 } // A0..A5 = a2..a7
    << 8
}

fn (a $&Assembler) xtbe_mov(dest int, src int) {
    a.xt_mov(xt_phys(dest), xt_phys(src))
}

fn (a $&Assembler) xtbe_mov_imm(dest int, imm int) {
    a.xt_mov_imm32(xt_phys(dest), imm)
}

fn (a $&Assembler) xtbe_mov_imm64(dest int, imm int) {
    a.xt_mov_imm32(xt_phys(dest), imm)
}

fn (a $&Assembler) xtbe_lea(dest int, label string) {
    a.xt_lea_abs(xt_phys(dest), label)
}

// A load may destroy its destination while computing the address. Use that
// fact for ordinary frame/field offsets instead of clobbering a10/a11 in
// addition to the requested result. ADDMI and ADDI each take signed bytes.
fn (a $&Assembler) xtbe_load_address(rd int, rb int, offset int) bool {
    $low := offset % 256
    if low > 127 { low -= 256 }
    if low < -128 { low += 256 }
    high := (offset - low) / 256
    if high < -128 || high > 127 { << false }
    if rd != rb { a.xt_mov(rd, rb) }
    if high != 0 { a.xt_addmi(rd, rd, high) }
    if low != 0 { a.xt_addi(rd, rd, low) }
    << true
}

fn (a $&Assembler) xtbe_load(dest int, base int, offset int) {
    rd := xt_phys(dest)
    rb := xt_phys(base)
    if offset >= 0 && offset <= 1020 && (offset % 4) == 0 {
        a.xt_l32i(rd, rb, offset)
    } else if a.xtbe_load_address(rd, rb, offset) {
        a.xt_l32i(rd, rd, 0)
    } else {
        $sc := 11
        if rd == 11 || rb == 11 { sc = 10 }
        a.xt_mov_imm32(sc, offset)
        a.xt_add(sc, rb, sc)
        a.xt_l32i(rd, sc, 0)
    }
}

fn (a $&Assembler) xtbe_store(base int, offset int, src int) {
    rb := xt_phys(base)
    rs := xt_phys(src)
    if offset >= 0 && offset <= 1020 && (offset % 4) == 0 {
        a.xt_s32i(rs, rb, offset)
    } else {
        $sc := 11
        if rb == 11 || rs == 11 { sc = 10 }
        a.xt_mov_imm32(sc, offset)
        a.xt_add(sc, rb, sc)
        a.xt_s32i(rs, sc, 0)
    }
}

fn (a $&Assembler) xtbe_load_byte(dest int, base int, offset int) {
    rd := xt_phys(dest)
    rb := xt_phys(base)
    if offset >= 0 && offset <= 255 {
        a.xt_l8ui(rd, rb, offset)
    } else if a.xtbe_load_address(rd, rb, offset) {
        a.xt_l8ui(rd, rd, 0)
    } else {
        $sc := 11
        if rd == 11 || rb == 11 { sc = 10 }
        a.xt_mov_imm32(sc, offset)
        a.xt_add(sc, rb, sc)
        a.xt_l8ui(rd, sc, 0)
    }
}

fn (a $&Assembler) xtbe_store_byte(base int, offset int, src int) {
    rb := xt_phys(base)
    rs := xt_phys(src)
    if offset >= 0 && offset <= 255 {
        a.xt_s8i(rs, rb, offset)
    } else {
        $sc := 11
        if rb == 11 || rs == 11 { sc = 10 }
        a.xt_mov_imm32(sc, offset)
        a.xt_add(sc, rb, sc)
        a.xt_s8i(rs, sc, 0)
    }
}

fn (a $&Assembler) xtbe_add(dest int, x int, y int) {
    a.xt_add(xt_phys(dest), xt_phys(x), xt_phys(y))
}

fn (a $&Assembler) xtbe_add_imm(dest int, src int, imm int) {
    rd := xt_phys(dest)
    rs := xt_phys(src)
    if dest == 16 && src == 16 && imm != 0 {
        // Outgoing stack arguments keep the fixed frame's extra-save area.
        // Copy its descriptor to the temporary SP; never put spill data on
        // top of outgoing args at [new_sp, old_sp). Only a11 is scratch.
        a.xt_rsil(11, 15)
        a.xt_s32i(11, 15, 20)
        a.xt_addi(11, 1, -12)
        a.xt_l32i(11, 11, 0)
        a.xt_s32i(11, 15, 24)
        if imm >= -128 && imm <= 127 {
            a.xt_addi(1, 1, imm)
        } else {
            a.xt_mov_imm32(11, imm)
            a.xt_add(1, 1, 11)
        }
        // Using SP briefly as the address avoids clobbering a live vreg.
        // INTLEVEL remains raised until the complete descriptor is valid.
        a.xt_addi(1, 1, -12)
        a.xt_l32i(11, 15, 24)
        a.xt_s32i(11, 1, 0)
        a.xt_addi(1, 1, 12)
        a.xt_l32i(11, 15, 20)
        a.xt_wsr(11, 230)
        a.xt_rsync()
        <<
    }
    if imm >= -128 && imm <= 127 {
        a.xt_addi(rd, rs, imm)
    } else {
        $sc := 11
        if rd == 11 || rs == 11 { sc = 10 }
        a.xt_mov_imm32(sc, imm)
        a.xt_add(rd, rs, sc)
    }
}

fn (a $&Assembler) xtbe_sub(dest int, x int, y int) {
    a.xt_sub(xt_phys(dest), xt_phys(x), xt_phys(y))
}

fn (a $&Assembler) xtbe_sub_imm(dest int, src int, imm int) {
    a.xtbe_add_imm(dest, src, 0 - imm)
}

fn (a $&Assembler) xtbe_mul(dest int, x int, y int) {
    a.xt_mull(xt_phys(dest), xt_phys(x), xt_phys(y))
}

fn (a $&Assembler) xtbe_div(dest int, x int, y int) {
    a.xt_quos(xt_phys(dest), xt_phys(x), xt_phys(y))
}

fn (a $&Assembler) xtbe_mod(dest int, x int, y int) {
    a.xt_rems(xt_phys(dest), xt_phys(x), xt_phys(y))
}

fn (a $&Assembler) xtbe_neg(dest int, src int) {
    a.xt_neg(xt_phys(dest), xt_phys(src))
}

fn (a $&Assembler) xtbe_and(dest int, x int, y int) {
    a.xt_and(xt_phys(dest), xt_phys(x), xt_phys(y))
}

fn (a $&Assembler) xtbe_and_imm(dest int, src int, imm int) {
    rd := xt_phys(dest)
    rs := xt_phys(src)
    $sc := 11
    if rd == 11 || rs == 11 { sc = 10 }
    a.xt_mov_imm32(sc, imm)
    a.xt_and(rd, rs, sc)
}

fn (a $&Assembler) xtbe_or(dest int, x int, y int) {
    a.xt_or(xt_phys(dest), xt_phys(x), xt_phys(y))
}

fn (a $&Assembler) xtbe_xor(dest int, x int, y int) {
    a.xt_xor(xt_phys(dest), xt_phys(x), xt_phys(y))
}

fn (a $&Assembler) xtbe_shl_imm(dest int, src int, imm int) {
    sh := imm & 31
    if sh == 0 {
        a.xtbe_mov(dest, src)
    } else {
        a.xt_slli(xt_phys(dest), xt_phys(src), sh)
    }
}

fn (a $&Assembler) xtbe_shr_imm(dest int, src int, imm int) {
    sh := imm & 31
    if sh == 0 {
        a.xtbe_mov(dest, src)
    } else {
        a.xt_srai(xt_phys(dest), xt_phys(src), sh)
    }
}

fn (a $&Assembler) xtbe_shl(dest int, src int, count int) {
    a.xt_ssl(xt_phys(count))
    a.xt_sll(xt_phys(dest), xt_phys(src))
}

fn (a $&Assembler) xtbe_shr(dest int, src int, count int) {
    a.xt_ssr(xt_phys(count))
    a.xt_sra(xt_phys(dest), xt_phys(src))
}

fn (a $&Assembler) xtbe_cmp(x int, y int) {
    a.cmp_fp = 0
    a.cmp_a = xt_phys(x)
    a.cmp_b = xt_phys(y)
}

fn (a $&Assembler) xtbe_cmp_imm(x int, imm int) {
    a.cmp_fp = 0
    ra := xt_phys(x)
    $sc := 11
    if ra == 11 { sc = 10 }
    a.xt_mov_imm32(sc, imm)
    a.cmp_a = ra
    a.cmp_b = sc
}

fn (a $&Assembler) xtbe_branch(inv_op int, s_reg int, at int, label string) {
    a.xt_emit_bcond(inv_op, s_reg, at, 2)
    a.xt_j(label)
}

fn (a $&Assembler) xtbe_jmp(label string) {
    // Process exit is a non-returning cross-function transfer. It can exceed
    // J's signed 18-bit byte range in full firmware; caller scratch a10/a11
    // is dead here, while the exit status in a2 must survive.
    if label == "_rt_exit" {
        a.xt_lea_abs(11, label)
        a.xt_jx(11)
        <<
    }
    a.xt_j(label)
}

fn (a $&Assembler) xtbe_jeq(label string) { a.xtbe_branch(9, a.cmp_a, a.cmp_b, label) }
fn (a $&Assembler) xtbe_jne(label string) { a.xtbe_branch(1, a.cmp_a, a.cmp_b, label) }
fn (a $&Assembler) xtbe_jlt(label string) { a.xtbe_branch(10, a.cmp_a, a.cmp_b, label) }
fn (a $&Assembler) xtbe_jge(label string) { a.xtbe_branch(2, a.cmp_a, a.cmp_b, label) }
fn (a $&Assembler) xtbe_jle(label string) { a.xtbe_branch(2, a.cmp_b, a.cmp_a, label) }
fn (a $&Assembler) xtbe_jgt(label string) { a.xtbe_branch(10, a.cmp_b, a.cmp_a, label) }
fn (a $&Assembler) xtbe_jae(label string) { a.xtbe_branch(3, a.cmp_a, a.cmp_b, label) }

fn (a $&Assembler) xtbe_cbz(reg int, label string) {
    a.xtbe_cmp_imm(reg, 0)
    a.xtbe_jeq(label)
}

fn (a $&Assembler) xtbe_cbnz(reg int, label string) {
    a.xtbe_cmp_imm(reg, 0)
    a.xtbe_jne(label)
}

fn (a $&Assembler) xtbe_cset(dest int, cond int) {
    rd := xt_phys(dest)
    ca := a.cmp_a
    cb := a.cmp_b
    $sc := rd
    if rd == ca || rd == cb {
        sc = 11
        if ca == 11 || cb == 11 {
            sc = 10
            if ca == 10 || cb == 10 {
                sc = 9
            }
        }
    }
    a.xt_movi(sc, 0)
    $inv := 9
    $s_reg := ca
    $at := cb
    if cond == 0 {
        inv = 9
    } else if cond == 1 {
        inv = 1
    } else if cond == 2 {
        inv = 3
    } else if cond == 3 {
        inv = 11
    } else if cond == 8 {
        inv = 11
        s_reg = cb
        at = ca
    } else if cond == 9 {
        inv = 3
        s_reg = cb
        at = ca
    } else if cond == 10 {
        inv = 2
    } else if cond == 11 {
        inv = 10
    } else if cond == 12 {
        inv = 10
        s_reg = cb
        at = ca
    } else {
        inv = 2
        s_reg = cb
        at = ca
    }
    a.xt_emit_bcond(inv, s_reg, at, 2)
    a.xt_movi(sc, 1)
    if sc != rd {
        a.xt_mov(rd, sc)
    }
}

fn (a $&Assembler) xtbe_prologue(frame_size int) {
    // A hardware IRQ may force this flat window to the ROM spill vectors.
    // Keep its current SP valid for overflow8/12, not only at rom_call6.
    // IRQs must not observe a partly installed spill descriptor.
    a.xt_rsil(11, 15)
    a.xt_addi(1, 1, -48)
    a.xt_s32i(15, 1, 0)
    a.xt_s32i(0, 1, 4)
    a.xt_s32i(12, 1, 8)
    a.xt_s32i(13, 1, 12)
    a.xt_s32i(14, 1, 16)
    // Keep the incoming SP's entire 16-byte windowed base-save area
    // untouched: register shadows there can still belong to a live parent.
    a.xt_s32i(11, 1, 20)
    a.xt_mov(15, 1)
    // The extra 48 bytes are physical spill storage, below every planned
    // local/temp slot; fr.size and FP-relative slot offsets stay unchanged.
    aligned := ((frame_size + 15) / 16) * 16 + 48
    if aligned <= 128 {
        a.xt_addi(1, 1, 0 - aligned)
    } else {
        a.xt_mov_imm32(11, aligned)
        a.xt_sub(1, 1, 11)
    }
    // Preserve a8: it carries the incoming aggregate-result pointer.
    a.xt_addi(1, 1, -12)
    a.xt_addi(11, 1, 60)
    a.xt_s32i(11, 1, 0)
    a.xt_addi(1, 1, 12)
    a.xt_l32i(11, 15, 20)
    a.xt_wsr(11, 230)
    a.xt_rsync()
}

fn (a $&Assembler) xtbe_epilogue() {
    a.xt_rsil(11, 15)
    a.xt_mov(1, 15)
    a.xt_l32i(15, 1, 0)
    a.xt_l32i(0, 1, 4)
    a.xt_l32i(12, 1, 8)
    a.xt_l32i(13, 1, 12)
    a.xt_l32i(14, 1, 16)
    a.xt_addi(1, 1, 48)
    // The caller's descriptor was outside this callee's local allocation.
    a.xt_wsr(11, 230)
    a.xt_rsync()
    a.xt_ret()
}

fn (a $&Assembler) xtbe_call(label string) { a.xt_call0(label) }

// A function-value shim may be emitted far from its body. J only reaches
// +/-128 KiB; an absolute tail jump preserves A0..A5, sret and the caller LR.
fn (a $&Assembler) xtbe_tail_call(label string) {
    a.xt_lea_abs(11, label)
    a.xt_jx(11)
}

fn (a $&Assembler) xtbe_call_reg(target int) { a.xt_callx0(xt_phys(target)) }

fn (a $&Assembler) xtbe_ret() { a.xt_ret() }
