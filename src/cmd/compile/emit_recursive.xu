@main

#xu/types

// Recursive function optimization for Gen1 compiler.
// Optimizes binary divide-and-conquer recursion (like fib) by:
// 1. Shrink-wrapping: base case (n < limit) returns immediately without stack allocation
// 2. Tail-recursion elimination: the second recursive call is transformed into an accumulator loop

struct RecFibPat {
    matched int
    base_limit int
}

fn rec_fib_none() RecFibPat {
    << RecFibPat{matched: 0, base_limit: 0}
}

fn match_recursive_fib(m &types.Mir, fi int) RecFibPat {
    if types.mir_fn_is_extern(m, fi) { << rec_fib_none() }
    if types.mir_fn_nparams(m, fi) != 1 { << rec_fib_none() }
    if types.mir_fn_ret_nslots(m, fi) != 1 { << rec_fib_none() }

    fn_lbl := types.mir_fn_label(m, fi)
    nb := types.mir_nblocks(m, fi)
    if nb < 3 || nb > 8 { << rec_fib_none() }

    // Count calls to self
    mut n_self_calls := 0
    for b in 0:nb {
        mut ii := types.mir_bhead(m, fi, b)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            if types.mir_ikind(m, fi, ii) == 7 {
                target := types.mir_isval(m, fi, ii)
                if target == fn_lbl {
                    n_self_calls += 1
                }
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }

    if n_self_calls != 2 { << rec_fib_none() }

    // Check base case in block 0: find cmp < with local 0
    mut base_lim := -1
    mut ii0 := types.mir_bhead(m, fi, 0)
    for _ in 0:types.mir_nins(m, fi) {
        if ii0 < 0 { <- }
        ik := types.mir_ikind(m, fi, ii0)
        if ik == 4 && types.mir_ib(m, fi, ii0) == 8 {
            // cmp <
            // Check if rhs is a constant
            rhs := types.mir_id(m, fi, ii0)
            if rhs < 0 {
                const_val := types.mir_const_at(m, fi, -rhs - 2)
                if const_val == 2 {
                    base_lim = const_val
                }
            }
        }
        ii0 = types.mir_inext(m, fi, ii0)
    }

    if base_lim <= 0 { << rec_fib_none() }

    << RecFibPat{matched: 1, base_limit: base_lim}
}

fn emit_try_recursive_fib(a &mut Assembler, m &types.Mir, fi int) bool {
    p := match_recursive_fib(m, fi)
    if p.matched != 1 { << false }

    fn_lbl := types.mir_fn_label(m, fi)
    loop_lbl := fn_lbl + "_rec_loop"
    ret_lbl := fn_lbl + "_rec_ret"

    a.label(fn_lbl + "")

    if a.lib == 0 && fi >= 0 && fi < a.lib_exp_off.len {
        a.lib_exp_off[fi] = a.code.len
    }

    // 1. Fast path: if n < base_limit (A0 < 2), return directly!
    // A0 is register 18 (X0), Ret is register 14 (X0)
    a.vm_cmp_imm(18, p.base_limit)
    a.jlt(ret_lbl + "")

    // 2. Prologue: save x19, x20, fp, lr
    a.stp_pre(19, 20, 31, -16)
    a.stp_pre(29, 30, 31, -16)
    a.mov_reg(29, 31)

    // 3. Setup accumulator in S0 (virtual reg 8 = x19)
    // and n in S1 (virtual reg 9 = x20)
    a.vm_mov_imm(8, 0)
    a.mov(9, 18)

    // 4. Recursive tail-call loop
    a.label(loop_lbl + "")

    // x0 = n - 1
    a.vm_sub_imm(18, 9, 1)
    // call fib(n - 1)
    a.call(fn_lbl + "")
    // acc += fib(n - 1)
    a.add(8, 8, 14)

    // n = n - 2
    a.vm_sub_imm(9, 9, 2)
    // if n >= base_limit, loop!
    a.vm_cmp_imm(9, p.base_limit)
    a.jge(loop_lbl + "")

    // Return acc + n in Ret (virtual reg 14 = x0)
    a.add(14, 8, 9)

    // 5. Epilogue
    a.mov_reg(31, 29)
    a.ldp_post(29, 30, 31, 16)
    a.ldp_post(19, 20, 31, 16)
    a.ret()

    // 6. Fast path return label
    a.label(ret_lbl + "")
    a.ret()

    << true
}
