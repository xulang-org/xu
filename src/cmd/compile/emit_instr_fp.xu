@main

#xu/types

fn emit_f64_binop_gpr(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ia int, op int, ic int, id int, ni int) {
    if a.rc_fp_ephem >= 0 {
        if ic == a.rc_fp_ephem || id == a.rc_fp_ephem {
            a.be_fmov_gpr_from_d(0, 0)
            emit_store_scalar_temp(a, m, fi, fr, a.rc_fp_ephem, 0)
        }
        a.rc_fp_ephem = -1
    }
    if a.rc_fp_rhs >= 0 {
        if ic == a.rc_fp_rhs || id == a.rc_fp_rhs {
            a.be_fmov_gpr_from_d(1, 1)
            emit_store_scalar_temp(a, m, fi, fr, a.rc_fp_rhs, 1)
        }
        a.rc_fp_rhs = -1
        a.rc_fp_fma_dm = -1
    }
    if op >= 6 && op <= 11 && a.arch == 0 && (frame_has_vregs(fr) || rc_fp_on(&*a)) {
        dn := rc_fp_operand_d(a, m, fi, fr, ic, 0)
        dm := rc_fp_operand_d(a, m, fi, fr, id, 1)
        if dn >= 0 && dm >= 0 {
            a.be_fcmp_dd(dn, dm)
            a.be_fcset(0, bin_cond(op))
            if ni < 0 && a.rc_branch_cond == ia {
                a.rc_fused_cc = arm64_float_cond(bin_cond(op))
            }
            emit_wrap_int(a, types.mir_temp_ty(m, fi, ia))
            emit_store_scalar_temp(a, m, fi, fr, ia, 0)
            <<
        }
    }
    emit_load_value(a, m, fi, fr, ic, 0)
    emit_load_value(a, m, fi, fr, id, 1)
    if op == 1 { a.be_fadd(0, 0, 1) }
    if op == 2 { a.be_fsub(0, 0, 1) }
    if op == 3 { a.be_fmul(0, 0, 1) }
    if op == 4 { a.be_fdiv(0, 0, 1) }
    if op >= 6 && op <= 11 {
        mut cond := 0
        if op == 6 { cond = 0 }
        if op == 7 { cond = 1 }
        if op == 8 { cond = 11 }
        if op == 9 { cond = 13 }
        if op == 10 { cond = 12 }
        if op == 11 { cond = 10 }
        a.be_fcmp(0, 1)
        a.be_fcset(0, cond)
    }
    emit_wrap_int(a, types.mir_temp_ty(m, fi, ia))
    emit_store_scalar_temp(a, m, fi, fr, ia, 0)
    <<
}

fn emit_f64_mulmul_frmw(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ia int, ic int, id int, ni int) bool {
    if types.mir_ikind(m, fi, ni) != 4 { << false }
    if types.mir_ib(m, fi, ni) != 3 { << false }
    t2 := types.mir_ia(m, fi, ni)
    nt := types.mir_ntemps(m, fi)
    if t2 < 0 || t2 >= nt { << false }
    if types.mir_temp_ty(m, fi, t2) != 4 { << false }
    nc := types.mir_ic(m, fi, ni)
    nd := types.mir_id(m, fi, ni)
    if nc != ia && nd != ia { << false }
    mut n2 := types.mir_inext(m, fi, ni)
    mut copy_d := -1
    mut copy_ii := -1
    if n2 >= 0 && types.mir_ikind(m, fi, n2) == 1 {
        cs := types.mir_ib(m, fi, n2)
        if cs == t2 || cs == ia {
            copy_d = types.mir_ia(m, fi, n2)
            copy_ii = n2
            n2 = types.mir_inext(m, fi, n2)
        }
    }
    if n2 >= 0 {
        k2 := types.mir_ikind(m, fi, n2)
        if k2 <= 3 {
            n2 = types.mir_inext(m, fi, n2)
        }
    }
    if n2 < 0 { << false }
    if types.mir_ikind(m, fi, n2) != 48 { << false }
    icr := types.mir_ic(m, fi, n2)
    if icr != t2 && icr != ia && icr != copy_d { << false }
    if mir_temp_uses_from(m, fi, ia, n2) > 2 { << false }
    if mir_temp_uses_from(m, fi, t2, n2) > 2 { << false }
    mut other := nc
    if nc == ia {
        other = nd
    }
    // Peek mag's SIMD home without loading into d0/d1. A failed peep
    // must not clobber scratches the fallback mul emit still needs.
    mut da := -1
    if other >= 0 {
        da = fixed_fp_temp_d(fr, other)
        if da < 0 {
            po := rc_fp_index_alias(&*a, fr.temp_slot[other])
            if po >= 0 {
                da = rc_fp_d(po)
            }
        }
    }
    if da < 2 { << false }
    dn := rc_fp_operand_d(a, m, fi, fr, ic, 0)
    dm := rc_fp_operand_d(a, m, fi, fr, id, 1)
    if dn < 0 || dm < 0 { << false }
    if dn == dm || da == dn || da == dm { << false }
    if dn == 1 {
        a.be_fmul_dd(1, 1, dm)
    } else if dm == 1 {
        a.be_fmul_dd(1, dn, 1)
    } else {
        a.be_fmul_dd(1, dn, dm)
    }
    a.rc_fp_rhs = t2
    a.rc_fp_fma_dm = da
    a.rc_fp_ephem = -1
    a.rc_fp_skip = ni
    a.rc_fp_skip2 = copy_ii
    rc_fp_kill_dead_temp(a, m, fi, fr, ic, n2)
    rc_fp_kill_dead_temp(a, m, fi, fr, id, n2)
    rc_fp_kill_dead_temp(a, m, fi, fr, ia, n2)
    << true
}

fn emit_f64_mul_frmw(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ia int, ic int, id int, ni int) bool {
    mut n2 := ni
    mut rhs := ia
    mut copy_ii := -1
    if types.mir_ikind(m, fi, n2) == 1 {
        if types.mir_ib(m, fi, n2) != ia { << false }
        rhs = types.mir_ia(m, fi, n2)
        copy_ii = n2
        n2 = types.mir_inext(m, fi, n2)
        if n2 < 0 { << false }
    }
    if types.mir_ikind(m, fi, n2) != 48 { << false }
    icr := types.mir_ic(m, fi, n2)
    if icr != ia && icr != rhs { << false }
    if mir_temp_uses_from(m, fi, ia, n2) != 1 { << false }
    nt := types.mir_ntemps(m, fi)
    if ia < 0 || ia >= nt { << false }
    if types.mir_temp_ty(m, fi, ia) != 4 { << false }
    dn := rc_fp_operand_d(a, m, fi, fr, ic, 0)
    dm := rc_fp_operand_d(a, m, fi, fr, id, 1)
    if dn < 0 || dm < 0 { << false }
    if dn == dm { << false }
    mut fma := -1
    if dm == 1 && dn >= 2 {
        fma = dn
    } else if dn == 1 && dm >= 2 {
        fma = dm
    } else if dn >= 2 && dm >= 2 {
        a.be_fmov_dd(1, dn)
        fma = dm
    }
    if fma < 2 { << false }
    a.rc_fp_fma_dm = fma
    a.rc_fp_rhs = ia
    a.rc_fp_ephem = -1
    a.rc_fp_skip = copy_ii
    rc_fp_kill_dead_temp(a, m, fi, fr, ic, n2)
    rc_fp_kill_dead_temp(a, m, fi, fr, id, n2)
    << true
}

fn rc_fp_p_from_d(fd int) int {
    if fd >= 2 && fd <= 7 {
        << fd - 2
    }
    if fd >= 16 && fd <= 31 {
        << fd - 10
    }
    << -1
}

fn rc_fp_dest_or_scratch(a &Assembler, fr &Frame, t int) int {
    p := rc_fp_p_from_d(fixed_fp_temp_d(fr, t))
    if p >= 0 {
        << p
    }
    << rc_fp_pick_scratch(a)
}

fn emit_temp_used_after_next_elemaddr(m &types.Mir, fi int, ii int, t int) bool {
    mut jj := types.mir_inext(m, fi, ii)
    mut past := false
    for _ in 0:types.mir_nins(m, fi) {
        if jj < 0 { << false }
        k := types.mir_ikind(m, fi, jj)
        if k == 23 {
            if jj != ii {
                past = true
            }
        }
        if past {
            if types.mir_ia(m, fi, jj) == t { << true }
            if types.mir_ib(m, fi, jj) == t { << true }
            if types.mir_ic(m, fi, jj) == t { << true }
            if types.mir_id(m, fi, jj) == t { << true }
        }
        jj = types.mir_inext(m, fi, jj)
    }
    << false
}

fn emit_f64_frmw_fma(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ia int, ic int, id int, ni int) bool {
    if emit_f64_mulmul_frmw(a, m, fi, fr, ia, ic, id, ni) { << true }
    if emit_f64_mul_frmw(a, m, fi, fr, ia, ic, id, ni) { << true }
    << false
}

fn emit_f64_sqsq_add3(a &mut Assembler, m &types.Mir, fi int, fr &Frame, dest int, fd int, nni int) int {
    if nni < 0 { << nni }
    // Copies need their own materialization. The bounded skip queue below
    // only replaces the adjacent third multiply and final addition.
    mid := nni
    if types.mir_ikind(m, fi, mid) != 4 { << nni }
    if types.mir_ib(m, fi, mid) != 3 { << nni }
    t3 := types.mir_ia(m, fi, mid)
    n3 := types.mir_inext(m, fi, mid)
    if n3 < 0 { << nni }
    if types.mir_ikind(m, fi, n3) != 4 { << nni }
    if types.mir_ib(m, fi, n3) != 1 { << nni }
    ac3 := types.mir_ic(m, fi, n3)
    ad3 := types.mir_id(m, fi, n3)
    if ac3 != dest && ad3 != dest { << nni }
    if ac3 != t3 && ad3 != t3 { << nni }
    if mir_temp_uses_from(m, fi, t3, n3) != 1 { << nni }
    if mir_temp_uses_from(m, fi, dest, nni) != 1 { << nni }
    final := types.mir_ia(m, fi, n3)
    if final < 0 || final >= fr.temp_slot.len || types.mir_temp_ty(m, fi, final) != 4 || types.mir_temp_nslots(m, fi, final) != 1 { << nni }
    if !is_fp_vreg_slot(fr.temp_slot[final]) && !is_frame_slot(fr.temp_slot[final]) { << nni }
    dzn := rc_fp_operand_d(a, m, fi, fr, types.mir_ic(m, fi, mid), 0)
    dzm := rc_fp_operand_d(a, m, fi, fr, types.mir_id(m, fi, mid), 1)
    a.be_fmadd_dddd(fd, dzn, dzm, fd)
    // The two additions can have different fixed homes. Replacing n3 must
    // define its destination as well as updating the intermediate accumulator.
    rc_kill_fp_alias(a, fr.temp_slot[final])
    emit_f64_from_home_to_temp(a, fr, final, fd)
    a.rc_fp_skip3 = mid
    a.rc_fp_skip4 = n3
    << types.mir_inext(m, fi, n3)
}

fn emit_f64_sqsq_add(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ia int, ic int, id int, ni int) bool {
    if types.mir_ikind(m, fi, ni) != 4 { << false }
    if types.mir_ib(m, fi, ni) != 3 { << false }
    t2 := types.mir_ia(m, fi, ni)
    nt := types.mir_ntemps(m, fi)
    if t2 < 0 || t2 >= nt { << false }
    if types.mir_temp_ty(m, fi, t2) != 4 { << false }
    nc := types.mir_ic(m, fi, ni)
    nd := types.mir_id(m, fi, ni)
    if nc == ia || nd == ia { << false }
    n2 := types.mir_inext(m, fi, ni)
    if n2 < 0 { << false }
    if types.mir_ikind(m, fi, n2) != 4 { << false }
    if types.mir_ib(m, fi, n2) != 1 { << false }
    dest := types.mir_ia(m, fi, n2)
    ac := types.mir_ic(m, fi, n2)
    add_d := types.mir_id(m, fi, n2)
    if !((ac == ia && add_d == t2) || (ac == t2 && add_d == ia)) { << false }
    if mir_temp_uses_from(m, fi, ia, n2) != 1 { << false }
    if mir_temp_uses_from(m, fi, t2, n2) != 1 { << false }
    mut nni := types.mir_inext(m, fi, n2)
    mut fd := rc_coalesce_f64_fd(&*a, m, fi, fr, dest, nni)
    if fd < 2 {
        fd = fixed_fp_temp_d(fr, dest)
    }
    if fd < 2 { << false }
    dn := rc_fp_operand_d(a, m, fi, fr, ic, 0)
    dm := rc_fp_operand_d(a, m, fi, fr, id, 1)
    da := rc_fp_operand_d(a, m, fi, fr, nc, 0)
    db := rc_fp_operand_d(a, m, fi, fr, nd, 1)
    if dn < 0 || dm < 0 || da < 0 || db < 0 { << false }
    a.be_fmul_dd(fd, dn, dm)
    a.be_fmadd_dddd(fd, da, db, fd)
    a.rc_fp_skip3 = -1
    a.rc_fp_skip4 = -1
    nni = emit_f64_sqsq_add3(a, m, fi, fr, dest, fd, nni)
    a.rc_fp_skip = ni
    a.rc_fp_skip2 = n2
    rc_fp_kill_dead_temp(a, m, fi, fr, ic, nni)
    rc_fp_kill_dead_temp(a, m, fi, fr, id, nni)
    rc_fp_kill_dead_temp(a, m, fi, fr, nc, nni)
    rc_fp_kill_dead_temp(a, m, fi, fr, nd, nni)
    rc_fp_kill_dead_temp(a, m, fi, fr, ia, nni)
    rc_fp_kill_dead_temp(a, m, fi, fr, t2, nni)
    << true
}

fn emit_f64_muladd(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ia int, ic int, id int, ni int) bool {
    if types.mir_ikind(m, fi, ni) != 4 { << false }
    if types.mir_ib(m, fi, ni) != 1 { << false }
    ad := types.mir_ia(m, fi, ni)
    ac := types.mir_ic(m, fi, ni)
    add_d := types.mir_id(m, fi, ni)
    if types.mir_temp_ty(m, fi, ad) != 4 { << false }
    if ac != ia && add_d != ia { << false }
    if mir_temp_uses_from(m, fi, ia, ni) != 1 { << false }
    mut other := ac
    if ac == ia {
        other = add_d
    }
    nni := types.mir_inext(m, fi, ni)
    mut fd := rc_coalesce_f64_fd(&*a, m, fi, fr, ad, nni)
    mut home_pin := fd >= 0
    if fd < 0 {
        p0 := rc_fp_pick_scratch(&*a)
        if p0 >= 0 {
            fd = rc_fp_d(p0)
        }
    }
    if fd < 0 { << false }
    if !rc_fp_on(&*a) {
        if !home_pin { << false }
        if fd < 2 { << false }
    }
    dn := rc_fp_operand_d(a, m, fi, fr, ic, 0)
    mut rhs_sc := 1
    if dn == 1 {
        rhs_sc = 0
    }
    dm := rc_fp_operand_d(a, m, fi, fr, id, rhs_sc)
    mut da_sc := 0
    if dn == 0 || dm == 0 {
        da_sc = 1
    }
    da := rc_fp_operand_d(a, m, fi, fr, other, da_sc)
    mut p := fd - 2
    if fd >= 16 {
        p = fd - 10
    }
    if !home_pin && p >= 0 && p < rc_fp_homes() {
        if a.rc_fp_alias[p] >= 0 && a.rc_fp_alias[p] != fr.temp_slot[ad] {
            rc_fp_flush_scratch(a, p)
        }
    }
    a.be_fmadd_dddd(fd, dn, dm, da)
    a.rc_fp_skip = ni
    mut skip_mat := home_pin
    if !skip_mat && p >= 0 && p < rc_fp_homes() {
        if f64_can_skip_materialize(m, fi, ad, nni) {
            skip_mat = true
        }
    }
    if !skip_mat {
        a.be_fmov_gpr_from_d(0, fd)
        emit_store_scalar_temp(a, m, fi, fr, ad, 0)
    }
    if p >= 0 && p < rc_fp_homes() {
        a.rc_fp_dirty[p] = 1
        if home_pin {
            rc_fp_set_alias(a, p, fr.temp_slot[ad])
        } else {
            a.rc_fp_alias2[p] = -1
            a.rc_fp_alias[p] = fr.temp_slot[ad]
        }
    }
    rc_fp_kill_dead_temp(a, m, fi, fr, ic, nni)
    rc_fp_kill_dead_temp(a, m, fi, fr, id, nni)
    rc_fp_kill_dead_temp(a, m, fi, fr, other, nni)
    rc_fp_kill_dead_temp(a, m, fi, fr, ia, nni)
    << true
}

fn emit_f64_chain(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ia int, ic int, id int, ni int) bool {
    if emit_f64_frmw_fma(a, m, fi, fr, ia, ic, id, ni) { << true }
    if emit_f64_sqsq_add(a, m, fi, fr, ia, ic, id, ni) { << true }
    if emit_f64_muladd(a, m, fi, fr, ia, ic, id, ni) { << true }
    << false
}

fn emit_f64_fmadd_peep(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) bool {
    ia := types.mir_ia(m, fi, ii)
    op := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    id := types.mir_id(m, fi, ii)
    ni := types.mir_inext(m, fi, ii)
    if op != 3 || ni < 0 || a.arch != 0 {
        << false
    }
    // Existing inner `kind==4 && op==1` body moved to emit_f64_muladd.
    // Drop rc_fp_on: nbody advance colors i/j in vregs and clears rc_on,
    // but the f64 temps still have SIMD homes via fixed_fp_temp_d.
    if ni >= 0 && a.arch == 0 {
        if emit_f64_chain(a, m, fi, fr, ia, ic, id, ni) {
            << true
        }
    }
    << false
}

fn emit_instr_bin_f64(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    if rc_fp_consume_skip(a, ii) {
        <<
    }
    if emit_f64_fmadd_peep(a, m, fi, fr, ii) {
        <<
    }
    ia := types.mir_ia(m, fi, ii)
    op := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    id := types.mir_id(m, fi, ii)
    ni := types.mir_inext(m, fi, ii)
    mut cmp := op >= 6 && op <= 11
    // mul * mul → FieldRMW and mul → FieldRMW must run before the
    // fixed-home early return. A pinned first mul used to emit `fmul dN`
    // and skip the FMA peep, leaving `fmul; fmul; fsub` in nbody.
    // mul * mul → FieldRMW: `dx * mj * mag` into d1 without claiming mass
    // scratches. Optional LoadLocal(mag) between the two muls.
    // Skip FieldRMW-fold DCE nops when matching the consumer chain.
    if !cmp && op == 3 && ni >= 0 && rc_fp_on(&*a) && a.arch == 0 {
        mut mid := ni
        mut skip_load := -1
        mut load_temp := -1
        mut guard := 0
        while mid >= 0 && guard < 6 && types.mir_ikind(m, fi, mid) == 0 {
            mid = types.mir_inext(m, fi, mid)
            guard += 1
        }
        if mid >= 0 && types.mir_ikind(m, fi, mid) == 2 {
            load_temp = types.mir_ia(m, fi, mid)
            if load_temp >= 0 && types.mir_temp_ty(m, fi, load_temp) == 4 {
                skip_load = mid
                mid = types.mir_inext(m, fi, mid)
                guard = 0
                while mid >= 0 && guard < 6 && types.mir_ikind(m, fi, mid) == 0 {
                    mid = types.mir_inext(m, fi, mid)
                    guard += 1
                }
            } else {
                load_temp = -1
            }
        }
        if mid >= 0 && types.mir_ikind(m, fi, mid) == 4 && types.mir_ib(m, fi, mid) == 3 {
            t2 := types.mir_ia(m, fi, mid)
            nc := types.mir_ic(m, fi, mid)
            nd := types.mir_id(m, fi, mid)
            if types.mir_temp_ty(m, fi, t2) == 4 && (nc == ia || nd == ia || nc == load_temp || nd == load_temp) {
                mut other := nc
                if nc == ia || nc == load_temp {
                    other = nd
                }
                if load_temp < 0 || other == load_temp {
                    if mir_temp_uses_from(m, fi, ia, ni) == 1 {
                        mut rhs := t2
                        mut nni := types.mir_inext(m, fi, mid)
                        guard = 0
                        while nni >= 0 && guard < 6 && types.mir_ikind(m, fi, nni) == 0 {
                            nni = types.mir_inext(m, fi, nni)
                            guard += 1
                        }
                        if nni >= 0 && types.mir_ikind(m, fi, nni) == 48 {
                            if types.mir_ic(m, fi, nni) == rhs || types.mir_ic(m, fi, nni) == t2 {
                                if mir_temp_uses_from(m, fi, t2, nni) <= 4 {
                                    dn := rc_fp_operand_d(a, m, fi, fr, ic, 0)
                                    mut dm := rc_fp_operand_d(a, m, fi, fr, id, 1)
                                    if dn >= 0 && dm >= 0 {
                                        if dn == dm {
                                            // Put one factor in d1 so lanes stay distinct.
                                            if dn != 1 {
                                                a.be_fmov_dd(1, dn)
                                                dm = 1
                                            }
                                        }
                                    mut da := -1
                                        if skip_load >= 0 {
                                            // Mag from pinned/soft local of the LoadLocal.
                                            loc := types.mir_ib(m, fi, skip_load)
                                            p1 := rc_fp_index(&*a, fr.local_slot[loc])
                                            if p1 >= 0 {
                                                da = rc_fp_d(p1)
                                            } else {
                                                p2 := rc_fp_index_alias(&*a, fr.local_slot[loc])
                                                if p2 >= 0 {
                                                    da = rc_fp_d(p2)
                                                }
                                            }
                                        } else {
                                            da = rc_fp_operand_d(a, m, fi, fr, other, 1)
                                        }
                                        // Fuse final *mag into FieldRMW via
                                        // fmadd/fmsub: leave (dx*mj) in d1.
                                        // Promote mag into a cold SIMD home if it is only in d0/d1.
                                        if da < 2 && other >= 0 {
                                            da = rc_fp_operand_d(a, m, fi, fr, other, 1)
                                        }
                                        if da < 2 {
                                            pda := rc_fp_pick_scratch_cold(&*a, m, fi, fr, nni)
                                            if pda >= 0 {
                                                if a.rc_fp_alias[pda] >= 0 {
                                                    rc_fp_flush_scratch(a, pda)
                                                }
                                                if da >= 0 {
                                                    a.be_fmov_dd(rc_fp_d(pda), da)
                                                } else if skip_load >= 0 {
                                                    loc2 := types.mir_ib(m, fi, skip_load)
                                                    if loc2 >= 0 && loc2 < fr.local_slot.len {
                                                        a.be_fload(rc_fp_d(pda), 15, slot_off(fr.local_slot[loc2]))
                                                    }
                                                }
                                                da = rc_fp_d(pda)
                                            }
                                        }
                                        if da >= 2 && da != dn && da != dm {
                                            if dn == 1 {
                                                a.be_fmul_dd(1, 1, dm)
                                            } else if dm == 1 {
                                                a.be_fmul_dd(1, dn, 1)
                                            } else {
                                                a.be_fmul_dd(1, dn, dm)
                                            }
                                            a.rc_fp_rhs = rhs
                                            a.rc_fp_fma_dm = da
                                            a.rc_fp_ephem = -1
                                            if skip_load >= 0 {
                                                a.rc_fp_skip = skip_load
                                                a.rc_fp_skip2 = mid
                                            } else {
                                                a.rc_fp_skip = mid
                                                a.rc_fp_skip2 = -1
                                            }
                                            rc_fp_kill_dead_temp(a, m, fi, fr, ic, nni)
                                            rc_fp_kill_dead_temp(a, m, fi, fr, id, nni)
                                            rc_fp_kill_dead_temp(a, m, fi, fr, ia, nni)
                                            <<
                                        }
                                        // Fallback: full product into d1.
                                        if da > 0 {
                                            a.be_fmul_dd(0, dn, dm)
                                            a.be_fmul_dd(1, 0, da)
                                            a.rc_fp_rhs = rhs
                                            a.rc_fp_ephem = -1
                                            if skip_load >= 0 {
                                                a.rc_fp_skip = skip_load
                                                a.rc_fp_skip2 = mid
                                            } else {
                                                a.rc_fp_skip = mid
                                                a.rc_fp_skip2 = -1
                                            }
                                            rc_fp_kill_dead_temp(a, m, fi, fr, ic, nni)
                                            rc_fp_kill_dead_temp(a, m, fi, fr, id, nni)
                                            rc_fp_kill_dead_temp(a, m, fi, fr, other, nni)
                                            rc_fp_kill_dead_temp(a, m, fi, fr, ia, nni)
                                            <<
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // mul → FieldRMW: `dx * sj` into d1 as rhs. Skip fold-nops before consumer.
    if !cmp && op == 3 && ni >= 0 && rc_fp_on(&*a) && a.arch == 0 {
        mut look := ni
        mut g2 := 0
        while look >= 0 && g2 < 6 && types.mir_ikind(m, fi, look) == 0 {
            look = types.mir_inext(m, fi, look)
            g2 += 1
        }
        if look >= 0 && types.mir_ikind(m, fi, look) == 48 && types.mir_ic(m, fi, look) == ia {
            if types.mir_temp_ty(m, fi, ia) == 4 && mir_temp_uses_from(m, fi, ia, look) == 1 {
                dn := rc_fp_operand_d(a, m, fi, fr, ic, 0)
                dm := rc_fp_operand_d(a, m, fi, fr, id, 1)
                if dm == 1 {
                    a.be_fmul_dd(1, dn, 1)
                } else if dn == 1 {
                    a.be_fmul_dd(1, 1, dm)
                } else {
                    a.be_fmul_dd(1, dn, dm)
                }
                a.rc_fp_rhs = ia
                a.rc_fp_ephem = -1
                rc_fp_kill_dead_temp(a, m, fi, fr, ic, look)
                rc_fp_kill_dead_temp(a, m, fi, fr, id, look)
                <<
            }
        }
    }
    // Fixed FP homes: emit here only when the dest is not a FieldRMW rhs
    // (those returned above). Direct d2–d7 / d16–d31, no GPR round-trip.
    if !cmp && op >= 1 && op <= 4 && ia >= 0 && ia < fr.temp_slot.len {
        fd_fixed := fixed_fp_temp_d(fr, ia)
        if fd_fixed >= 0 {
            dn_fixed := rc_fp_operand_d(a, m, fi, fr, ic, 0)
            dm_fixed := rc_fp_operand_d(a, m, fi, fr, id, 1)
            if op == 1 { a.be_fadd_dd(fd_fixed, dn_fixed, dm_fixed) }
            if op == 2 { a.be_fsub_dd(fd_fixed, dn_fixed, dm_fixed) }
            if op == 3 { a.be_fmul_dd(fd_fixed, dn_fixed, dm_fixed) }
            if op == 4 { a.be_fdiv_dd(fd_fixed, dn_fixed, dm_fixed) }
            <<
        }
    }
    mut fd := -1
    mut home_pin := false
    mut ephem := false
    if !cmp {
        fd = rc_coalesce_f64_fd(&*a, m, fi, fr, ia, ni)
        if fd >= 0 {
            home_pin = true
        }
    }
    // Ephemeral d0 (mul→mul) / d1 (mul→FieldRMW) when dest would clobber a
    // scratch that still holds mj/mi or a live operand.
    mut use_rhs := false
    if fd < 0 && !cmp && rc_fp_on(&*a) {
        p0 := rc_fp_pick_scratch_cold(&*a, m, fi, fr, ni)
        if p0 >= 0 {
            fd = rc_fp_d(p0)
        }
    }
    // Temp chains: prefer an empty SIMD home; flush before reuse.
    if fd < 0 && !cmp && rc_fp_on(&*a) {
        p0 := rc_fp_pick_scratch(&*a)
        if p0 >= 0 {
            fd = rc_fp_d(p0)
        }
    }
    if fd >= 2 && !cmp && rc_fp_on(&*a) {
        mut pin0 := fd - 2
        if fd >= 16 {
            pin0 = fd - 10
        }
        mut upgrade := rc_fp_home_has_hot_local(&*a, m, fi, fr, pin0, ni)
        if !upgrade {
            if ic >= 0 && rc_fp_index_alias(&*a, fr.temp_slot[ic]) == pin0 {
                upgrade = true
            }
            if id >= 0 && rc_fp_index_alias(&*a, fr.temp_slot[id]) == pin0 {
                upgrade = true
            }
        }
        if false && upgrade {
            // Only mul→mul into d0. mul→FieldRMW via d1 (use_rhs) still
            // corrupts nbody checksum — keep that on the normal scratch path.
            if f64_result_is_ephemeral(m, fi, ia, ni) {
                if types.mir_ikind(m, fi, ni) == 4 {
                    fd = 0
                    ephem = true
                }
            }
        }
    }
    if cmp || fd < 0 || !rc_fp_on(&*a) {
        emit_f64_binop_gpr(a, m, fi, fr, ia, op, ic, id, ni)
        <<
    }
    // Ephemeral dest is d0/d1: load operands into scratch lanes carefully.
    mut dn := 0
    mut dm := 1
    if ephem || use_rhs {
        dn = rc_fp_operand_d(a, m, fi, fr, ic, 0)
        dm = rc_fp_operand_d(a, m, fi, fr, id, 1)
    } else {
        dn = rc_fp_operand_d(a, m, fi, fr, ic, 0)
        mut rhs_sc := 1
        if dn == 1 {
            rhs_sc = 0
        }
        dm = rc_fp_operand_d(a, m, fi, fr, id, rhs_sc)
    }
    mut p := fd - 2
    if fd >= 16 {
        p = fd - 10
    }
    if !home_pin && !ephem && !use_rhs && p >= 0 && p < rc_fp_homes() {
        if a.rc_fp_alias[p] >= 0 && a.rc_fp_alias[p] != fr.temp_slot[ia] {
            rc_fp_flush_scratch(a, p)
        }
    }
    if op == 1 { a.be_fadd_dd(fd, dn, dm) }
    if op == 2 { a.be_fsub_dd(fd, dn, dm) }
    if op == 3 { a.be_fmul_dd(fd, dn, dm) }
    if op == 4 { a.be_fdiv_dd(fd, dn, dm) }
    if ephem {
        a.rc_fp_ephem = ia
        a.rc_fp_rhs = -1
        rc_fp_kill_dead_temp(a, m, fi, fr, ic, ni)
        rc_fp_kill_dead_temp(a, m, fi, fr, id, ni)
        <<
    }
    if use_rhs {
        a.rc_fp_rhs = ia
        a.rc_fp_ephem = -1
        rc_fp_kill_dead_temp(a, m, fi, fr, ic, ni)
        rc_fp_kill_dead_temp(a, m, fi, fr, id, ni)
        <<
    }
    // home_pin ⇒ next is StoreLocal of this temp into an FP-pinned local;
    // keep bits in the SIMD home (no GPR round-trip). Leaf is not required:
    // StoreLocal reads the alias / pin, not a stack temp.
    mut skip_mat := home_pin
    if !skip_mat && p >= 0 && p < rc_fp_homes() {
        if f64_can_skip_materialize(m, fi, ia, ni) {
            skip_mat = true
        }
    }
    // Fast path: next instr immediately consumes this temp in FP mul/add/…
    // or FieldRMW — keep SIMD even if the long-range scan was conservative.
    if !skip_mat && ni >= 0 && p >= 0 && p < rc_fp_homes() {
        nk := types.mir_ikind(m, fi, ni)
        if nk == 4 {
            nop := types.mir_ib(m, fi, ni)
            if nop >= 1 && nop <= 4 {
                if types.mir_ic(m, fi, ni) == ia || types.mir_id(m, fi, ni) == ia {
                    if mir_temp_uses_from(m, fi, ia, ni) == 1 {
                        skip_mat = true
                    } else if f64_can_skip_materialize(m, fi, ia, ni) {
                        skip_mat = true
                    }
                }
            }
        } else if nk == 48 && types.mir_ic(m, fi, ni) == ia {
            skip_mat = true
        }
    }
    if !skip_mat {
        a.be_fmov_gpr_from_d(0, fd)
        emit_store_scalar_temp(a, m, fi, fr, ia, 0)
    }
    if p >= 0 && p < rc_fp_homes() {
        a.rc_fp_dirty[p] = 1
        if home_pin {
            rc_fp_set_alias(a, p, fr.temp_slot[ia])
        } else {
            a.rc_fp_alias2[p] = -1
            a.rc_fp_alias[p] = fr.temp_slot[ia]
        }
    }
    // Operand temps often die here (dx := xi - xj); clear their scratch
    // aliases so the next field loads do not flush each other.
    rc_fp_kill_dead_temp(a, m, fi, fr, ic, ni)
    rc_fp_kill_dead_temp(a, m, fi, fr, id, ni)
    <<
}

fn emit_f64_scvtf_home(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) bool {
    if !rc_fp_on(&*a) {
        << false
    }
    if types.mir_ib(m, fi, ii) != 3 {
        << false
    }
    ia := types.mir_ia(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    ni := types.mir_inext(m, fi, ii)
    if ni < 0 {
        << false
    }
    if types.mir_ikind(m, fi, ni) != 4 {
        << false
    }
    nop := types.mir_ib(m, fi, ni)
    if nop < 1 || nop > 4 {
        << false
    }
    ndest := types.mir_ia(m, fi, ni)
    nlhs := types.mir_ic(m, fi, ni)
    nrhs := types.mir_id(m, fi, ni)
    if types.mir_temp_ty(m, fi, ndest) != 4 {
        << false
    }
    if nlhs != ia && nrhs != ia {
        << false
    }
    nni := types.mir_inext(m, fi, ni)
    mut ok_coal := rc_coalesce_f64_fd(&*a, m, fi, fr, ndest, nni) >= 0
    if !ok_coal {
        if nrhs == ia && a.rc_nat_wb {
            ok_coal = true
        }
    }
    if !ok_coal {
        << false
    }
    src_r := rc_load_reg(a, m, fi, fr, ic, 0)
    a.be_scvtf_d(1, src_r)
    a.rc_fp_rhs = ia
    // Next instr is a consuming f64 binop (precondition). Keep bits in d1;
    // a stack round-trip here is the f64_sum `fmov+stur` per iter.
    << true
}

fn emit_f64_loadlocal(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) bool {
    ia := types.mir_ia(m, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    if types.mir_temp_nslots(m, fi, ia) != 1 {
        << false
    }
    if types.mir_temp_ty(m, fi, ia) != 4 {
        << false
    }
    lo := fr.local_slot[ib]
    if emit_f64_mag_div_fuse(a, m, fi, fr, ii) {
        << true
    }
    if !rc_fp_on(&*a) {
        fixed := fixed_fp_temp_d(fr, ia)
        if fixed >= 0 {
            a.be_fload(fixed, 15, slot_off(lo))
            << true
        }
        << false
    }
    // Soft alias first, then the FP pin for this local. Skipping the pin
    // forced a stack fload every iter (`f64_sum` s) even when d2 held s.
    mut p := -1
    nh := rc_fp_homes()
    for q in 0:nh {
        if a.rc_fp_alias[q] == lo && lo >= 0 {
            p = q
            <-
        }
    }
    if p < 0 && lo >= 0 {
        for q in 0:nh {
            if a.rc_fp_pin[q] == lo {
                p = q
                <-
            }
        }
    }
    if p < 0 {
        fixed := fixed_fp_temp_d(fr, ia)
        if fixed >= 0 {
            a.be_fload(fixed, 15, slot_off(lo))
            << true
        }
        ni0 := types.mir_inext(m, fi, ii)
        p = rc_fp_pick_scratch_cold(&*a, m, fi, fr, ni0)
        if p < 0 {
            << false
        }
        if a.rc_fp_alias[p] >= 0 {
            rc_fp_flush_scratch(a, p)
        }
        a.be_fload(rc_fp_d(p), 15, slot_off(lo))
        a.rc_fp_dirty[p] = 0
        a.rc_fp_alias2[p] = -1
    }
    // Multiple SSA LoadLocals of the same pinned local may coexist before
    // their consumers. Keep the previous temp in alias2 instead of losing it.
    rc_fp_set_alias(a, p, fr.temp_slot[ia])
    // The MIR temp may still be consumed through its fixed d0/d1 home even
    // when alias metadata is later invalidated by unrelated FP cleanup. Seed
    // that materialization home from the authoritative pin, never from stack.
    fixed_pin := fixed_fp_temp_d(fr, ia)
    if fixed_pin >= 0 && fixed_pin != rc_fp_d(p) {
        a.be_fmov_dd(fixed_pin, rc_fp_d(p))
    }
    ni := types.mir_inext(m, fi, ii)
    // In the admitted FP-only loop the local itself is the loop-carried value.
    // Once its pin is known, never materialize the SSA temp to its frame slot:
    // all FP consumers resolve through the pin/alias, and the local is written
    // back only at the cold boundary. This removes the per-iteration stur/ldur
    // pair that otherwise survives even when the d-register is resident.
    if a.rc_fp_only && rc_fp_index(&*a, fr.local_slot[ib]) >= 0 {
        << true
    }
    if f64_can_skip_materialize(m, fi, ia, ni) {
        << true
    }
    if !is_synth_slot(fr.temp_slot[ia]) {
        a.be_fstore(15, slot_off(fr.temp_slot[ia]), rc_fp_d(p))
    }
    << true
}

// LoadLocal(dt) → [LoadLocal(d2)] → [LoadLocal(dist)] → mul → div → StoreLocal(mag).
// Emits `fmul d1; fload d0,dt; fdiv mag` without spilling dt over d2/dist.
fn emit_f64_mag_div_fuse(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) bool {
    if !rc_fp_on(&*a) || a.arch != 0 {
        << false
    }
    ia := types.mir_ia(m, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    lo := fr.local_slot[ib]
    // Only cold dt (no pin/soft home). Soft dt from `dt*vx` is handled by
    // not soft-aliasing dt on the mag path (fuse claims no dt home).
    if rc_fp_index(&*a, lo) >= 0 || rc_fp_index_alias(&*a, lo) >= 0 {
        << false
    }
    ni := types.mir_inext(m, fi, ii)
    if ni < 0 {
        << false
    }
    mut skip_d2_load := -1
    mut t_d2 := -1
    mut loc_d2 := -1
    mut skip_dist_load := -1
    mut t_dist_load := -1
    mut loc_dist := -1
    mut mid := ni
    if types.mir_ikind(m, fi, ni) == 2 {
        t_d2 = types.mir_ia(m, fi, ni)
        loc_d2 = types.mir_ib(m, fi, ni)
        if t_d2 < 0 || types.mir_temp_ty(m, fi, t_d2) != 4 {
            << false
        }
        if loc_d2 < 0 || loc_d2 >= types.mir_nlocals(m, fi) || types.mir_local_ty(m, fi, loc_d2) != 4 {
            << false
        }
        skip_d2_load = ni
        mid = types.mir_inext(m, fi, ni)
        if mid >= 0 && types.mir_ikind(m, fi, mid) == 2 {
            t_dist_load = types.mir_ia(m, fi, mid)
            loc_dist = types.mir_ib(m, fi, mid)
            if t_dist_load >= 0 && types.mir_temp_ty(m, fi, t_dist_load) == 4 {
                if loc_dist >= 0 && loc_dist < types.mir_nlocals(m, fi) && types.mir_local_ty(m, fi, loc_dist) == 4 {
                    skip_dist_load = mid
                    mid = types.mir_inext(m, fi, mid)
                } else {
                    t_dist_load = -1
                    loc_dist = -1
                }
            } else {
                t_dist_load = -1
                loc_dist = -1
            }
        }
    }
    if mid < 0 || types.mir_ikind(m, fi, mid) != 4 || types.mir_ib(m, fi, mid) != 3 {
        << false
    }
    t_den := types.mir_ia(m, fi, mid)
    mc := types.mir_ic(m, fi, mid)
    md := types.mir_id(m, fi, mid)
    if types.mir_temp_ty(m, fi, t_den) != 4 {
        << false
    }
    mut t_dist := -1
    if skip_d2_load >= 0 {
        // Mul must use the d2 LoadLocal temp.
        if mc != t_d2 && md != t_d2 {
            << false
        }
        t_dist = md
        if md == t_d2 {
            t_dist = mc
        }
    } else {
        // Direct mul after LoadLocal(dt): both factors already live in SIMD.
        t_d2 = mc
        t_dist = md
    }
    if t_dist < 0 || types.mir_temp_ty(m, fi, t_dist) != 4 {
        << false
    }
    if t_d2 < 0 || types.mir_temp_ty(m, fi, t_d2) != 4 {
        << false
    }
    if skip_dist_load >= 0 && t_dist != t_dist_load {
        << false
    }
    divi := types.mir_inext(m, fi, mid)
    if divi < 0 || types.mir_ikind(m, fi, divi) != 4 || types.mir_ib(m, fi, divi) != 4 {
        << false
    }
    t_mag := types.mir_ia(m, fi, divi)
    dc := types.mir_ic(m, fi, divi)
    dd := types.mir_id(m, fi, divi)
    // Strict: mag = dt / (d2*dist)
    if dc != ia || dd != t_den {
        << false
    }
    if types.mir_temp_ty(m, fi, t_mag) != 4 {
        << false
    }
    if mir_temp_uses_from(m, fi, ia, ni) != 1 {
        << false
    }
    if mir_temp_uses_from(m, fi, t_den, divi) != 1 {
        << false
    }
    // Resolve SIMD homes for d2 and dist.
    mut pd2 := -1
    if loc_d2 >= 0 {
        pd2 = rc_fp_index_alias(&*a, fr.local_slot[loc_d2])
    }
    if pd2 < 0 {
        pd2 = rc_fp_index_alias(&*a, fr.temp_slot[t_d2])
    }
    if pd2 < 0 {
        << false
    }
    mut pdist := -1
    if loc_dist >= 0 {
        pdist = rc_fp_index_alias(&*a, fr.local_slot[loc_dist])
    }
    if pdist < 0 {
        pdist = rc_fp_index_alias(&*a, fr.temp_slot[t_dist])
    }
    if pdist < 0 {
        nh0 := rc_fp_homes()
        for p in 0:nh0 {
            if a.rc_fp_alias2[p] == fr.temp_slot[t_dist] {
                pdist = p
                <-
            }
        }
    }
    if pdist < 0 {
        << false
    }
    if pd2 == pdist {
        << false
    }
    sti := types.mir_inext(m, fi, divi)
    mut fd := rc_coalesce_f64_fd(&*a, m, fi, fr, t_mag, sti)
    // Coalesce may pick d2/dist's home under pin pressure — reject and
    // fall through to a soft scratch (or reuse dead d2 home below).
    if fd == rc_fp_d(pd2) || fd == rc_fp_d(pdist) {
        fd = -1
    }
    if fd < 0 {
        nh := rc_fp_homes()
        mut pmag := -1
        for p in 0:nh {
            if p == pd2 || p == pdist {
                ->
            }
            if a.rc_fp_pin[p] >= 0 {
                ->
            }
            if a.rc_fp_alias[p] < 0 && a.rc_fp_alias2[p] < 0 {
                pmag = p
                <-
            }
        }
        if pmag < 0 {
            for p in 0:nh {
                if p == pd2 || p == pdist {
                    ->
                }
                if a.rc_fp_pin[p] >= 0 {
                    ->
                }
                if a.rc_fp_dirty[p] == 0 {
                    if a.rc_fp_alias[p] >= 0 {
                        rc_fp_flush_scratch(a, p)
                    }
                    pmag = p
                    <-
                }
            }
        }
        if pmag < 0 {
            for p in 0:nh {
                if p == pd2 || p == pdist {
                    ->
                }
                if a.rc_fp_pin[p] >= 0 {
                    ->
                }
                if a.rc_fp_alias[p] >= 0 {
                    rc_fp_flush_scratch(a, p)
                }
                pmag = p
                <-
            }
        }
        // d2/dist die after the den mul — reuse d2's home when every other
        // SIMD home is pinned (extra locals / pin pressure).
        if pmag < 0 {
            pmag = pd2
        }
        fd = rc_fp_d(pmag)
    }
    a.be_fmul_dd(1, rc_fp_d(pd2), rc_fp_d(pdist))
    a.be_fload(0, 15, slot_off(lo))
    a.be_fdiv_dd(fd, 0, 1)
    mut pmag2 := fd - 2
    if fd >= 16 {
        pmag2 = fd - 10
    }
    if pmag2 >= 0 && pmag2 < rc_fp_homes() {
        a.rc_fp_dirty[pmag2] = 1
        a.rc_fp_alias2[pmag2] = -1
        a.rc_fp_alias[pmag2] = fr.temp_slot[t_mag]
    }
    a.rc_fp_ephem = -1
    a.rc_fp_rhs = -1
    a.rc_fp_fma_dm = -1
    if skip_d2_load >= 0 && skip_dist_load >= 0 {
        a.rc_fp_skip = skip_d2_load
        a.rc_fp_skip2 = skip_dist_load
        a.rc_fp_skip3 = mid
        a.rc_fp_skip4 = divi
    } else if skip_d2_load >= 0 {
        a.rc_fp_skip = skip_d2_load
        a.rc_fp_skip2 = mid
        a.rc_fp_skip3 = divi
        a.rc_fp_skip4 = -1
    } else {
        // Next was the mul itself.
        a.rc_fp_skip = mid
        a.rc_fp_skip2 = divi
        a.rc_fp_skip3 = -1
        a.rc_fp_skip4 = -1
    }
    // Free dead d2/dist homes; keep mag if it reused pd2/pdist.
    if pd2 != pmag2 {
        a.rc_fp_alias[pd2] = -1
        a.rc_fp_alias2[pd2] = -1
    }
    if pdist != pmag2 {
        a.rc_fp_alias[pdist] = -1
        a.rc_fp_alias2[pdist] = -1
    }
    << true
}
fn emit_f64_from_home_to_temp(a &mut Assembler, fr &Frame, t int, fd int) bool {
    if t < 0 || t >= fr.temp_slot.len || fd < 0 {
        << false
    }
    slot := fr.temp_slot[t]
    if is_fp_vreg_slot(slot) {
        dd := fp_vreg_slot_d(slot)
        if dd != fd {
            a.be_fmov_dd(dd, fd)
        }
        << true
    }
    if is_frame_slot(slot) {
        a.be_fstore(15, slot_off(slot), fd)
        << true
    }
    << false
}

fn emit_f64_storelocal(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) bool {
    ia := types.mir_ia(m, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    mut ns := 1
    if ib >= 0 {
        ns = types.mir_temp_nslots(m, fi, ib)
    }
    if ns != 1 {
        << false
    }
    if types.mir_local_ty(m, fi, ia) != 4 {
        << false
    }
    lo := fr.local_slot[ia]
    // StoreLocal is the local promotion boundary. In FP loop-residency mode,
    // do not let a fixed temp home bypass an already-pinned local home: copy
    // into the pin, mark it dirty, and keep the pin live across the backedge.
    // Outside rc_fp_on, retain the original fixed-home fast path.
    mut src_fixed := -1
    if ib >= 0 {
        src_fixed = fixed_fp_temp_d(fr, ib)
        if src_fixed >= 0 && !rc_fp_on(&*a) {
            a.be_fstore(15, slot_off(lo), src_fixed)
            << true
        }
    }
    mut p := rc_fp_index(&*a, lo)
    // FP-only admission has exactly one loop-carried f64 local. If a cold-to-hot
    // entry did not seed the pin yet, recover its predetermined home at the
    // first StoreLocal; this avoids a stack round-trip before the backedge.
    if p < 0 && a.rc_fp_only {
        nh := rc_fp_homes()
        for q in 0:nh {
            locq := a.rc_fp_blk[q]
            if locq >= 0 && locq < fr.local_slot.len && fr.local_slot[locq] == lo {
                p = q
                <-
            }
        }
    }
    mut src_p := -1
    mut src_fd := -1
    if src_fixed >= 0 {
        src_fd = src_fixed
    } else if ib >= 0 {
        src_p = rc_fp_index_alias(&*a, fr.temp_slot[ib])
        if src_p >= 0 {
            src_fd = 2 + src_p
        }
    }
    // Unpinned local: keep bits in the SIMD home and retarget alias to the
    // local slot so later LoadLocal can pick it up without a GPR round-trip.
    // Keep the source temp in alias2 — MIR may still name that temp (CSE).
    if p < 0 {
        if src_fd < 0 {
            << false
        }
        a.rc_fp_dirty[src_p] = 1
        if ib >= 0 {
            a.rc_fp_alias2[src_p] = fr.temp_slot[ib]
        } else {
            a.rc_fp_alias2[src_p] = -1
        }
        a.rc_fp_alias[src_p] = lo
        // Latch skip-store: `_ht` will not reload, so the SIMD home is
        // the source of truth. Exit still `rc_spill_fp`.
        if !(a.rc_wb && a.arch == 0) {
            a.be_fstore(15, slot_off(lo), src_fd)
        }
        << true
    }
    fd := rc_fp_d(p)
    if src_fd >= 0 {
        if src_fd != fd {
            a.be_fmov_dd(fd, src_fd)
        }
        a.rc_fp_dirty[p] = 1
        // Keep any SSA temp aliases attached to this pinned home. The pin itself
        // identifies the local for later LoadLocal, so replacing alias[p] with
        // the local slot would discard a live temp alias (t11/t40 in spectralnorm).
        // The pinned home is the authoritative value while the loop is hot.
        // Defer the frame write to the cold exit/writeback boundary; storing
        // here would preserve correctness but defeat the residency win.
        << true
    }
    src_r := rc_load_reg(a, m, fi, fr, ib, 0)
    a.be_fmov_d_from_gpr(fd, src_r)
    a.rc_fp_dirty[p] = 1
    a.rc_fp_alias[p] = lo
    a.store(15, slot_off(lo), src_r)
    << true
}
