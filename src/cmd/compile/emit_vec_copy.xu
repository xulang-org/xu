@main

#xu/types

// Element copy and vec3 squared-norm loops.


fn vec_find_ind_copy(m &types.Mir, fi int, bi int) int {
    mut ind := -1
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 3 {
            loc := types.mir_ia(m, fi, ii)
            st := types.mir_ib(m, fi, ii)
            if st >= 0 {
                mut jj := types.mir_bhead(m, fi, bi)
                for _ in 0:types.mir_nins(m, fi) {
                    if jj < 0 { <- }
                    if types.mir_ikind(m, fi, jj) == 4 && types.mir_ia(m, fi, jj) == st && types.mir_ib(m, fi, jj) == 1 {
                        lc := types.mir_ic(m, fi, jj)
                        ld := types.mir_id(m, fi, jj)
                        mut other := -1
                        if vec_operand_is_one(m, fi, bi, ld) {
                            other = lc
                        } else if vec_operand_is_one(m, fi, bi, lc) {
                            other = ld
                        }
                        if other >= 0 {
                            if vec_temp_from_local(m, fi, bi, other, loc) {
                                ind = loc
                            }
                        }
                    }
                    jj = types.mir_inext(m, fi, jj)
                }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << ind
}

fn vec_temp_ty_f64(m &types.Mir, fi int, t int) bool {
    if t < 0 { << false }
    if t >= types.mir_local_operand_base {
        loc := t - types.mir_local_operand_base
        if loc < 0 || loc >= types.mir_nlocals(m, fi) { << false }
        << types.mir_local_ty(m, fi, loc) == 4
    }
    if t >= types.mir_ntemps(m, fi) { << false }
    << types.mir_temp_ty(m, fi, t) == 4
}

fn vec_incoming_f64(m &types.Mir, fi int, bi int) int {
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 2 {
            loc := types.mir_ib(m, fi, ii)
            if loc >= 0 && loc < types.mir_nlocals(m, fi) {
                if types.mir_local_ty(m, fi, loc) == 4 {
                    << types.mir_local_operand_base + loc
                }
            }
        }
        if types.mir_ikind(m, fi, ii) == 3 {
            loc := types.mir_ia(m, fi, ii)
            if loc >= 0 && loc < types.mir_nlocals(m, fi) {
                if types.mir_local_ty(m, fi, loc) == 4 {
                    << types.mir_local_operand_base + loc
                }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 4 && types.mir_ib(m, fi, ii) == 1 {
            dest := types.mir_ia(m, fi, ii)
            if vec_temp_ty_f64(m, fi, dest) {
                lc := types.mir_ic(m, fi, ii)
                ld := types.mir_id(m, fi, ii)
                trc := vec_trace(m, fi, bi, lc)
                trd := vec_trace(m, fi, bi, ld)
                if trc >= 0 && !vec_defined_here(m, fi, bi, trc) { << trc }
                if trd >= 0 && !vec_defined_here(m, fi, bi, trd) { << trd }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << -1
}

// `dst[i] = src[i]`, i64 elements. Self-loop or header+body natural loop.
// OOB: n <= src.len && n <= dst.len before the wide copy.
fn match_index_copy(m &types.Mir, fi int, bi int) VecPat {
    mut header := vec_copy_header(m, fi, bi)
    mut else_bb := -1
    if header >= 0 {
        else_bb = vec_copy_else(m, fi, header, bi)
    }
    mut nld := 0
    mut nst := 0
    mut ld_ii := -1
    mut st_ii := -1
    mut badk := -1
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == 14 {
            if !vec_elem8(types.mir_id(m, fi, ii)) { << vec_none() }
            nld += 1
            ld_ii = ii
        } else if k == 20 {
            if !vec_elem8(types.mir_id(m, fi, ii)) { << vec_none() }
            nst += 1
            st_ii = ii
        } else if !vec_copy_kind_ok(k) {
            badk = k
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if header < 0 || else_bb < 0 { << vec_none() }
    if badk >= 0 { << vec_none() }
    if nld != 1 || nst != 1 { << vec_none() }
    mut ind := vec_find_ind_copy(m, fi, bi)
    if ind >= 0 {
        ind = types.mir_local_operand_base + ind
    } else {
        idx := vec_trace(m, fi, bi, types.mir_ic(m, fi, ld_ii))
        if idx < 0 { << vec_none() }
        add1 := vec_find_add1_dest(m, fi, bi, idx)
        if add1 < 0 { << vec_none() }
        ind = idx
    }
    ld_idx := types.mir_ic(m, fi, ld_ii)
    st_idx := types.mir_ib(m, fi, st_ii)
    if ind >= types.mir_local_operand_base {
        lid := ind - types.mir_local_operand_base
        if !vec_temp_from_local(m, fi, bi, ld_idx, lid) { << vec_none() }
        if !vec_temp_from_local(m, fi, bi, st_idx, lid) { << vec_none() }
    } else {
        if !vec_same_val(m, fi, bi, ld_idx, ind) { << vec_none() }
        if !vec_same_val(m, fi, bi, st_idx, ind) { << vec_none() }
    }
    if !vec_same_val(m, fi, bi, types.mir_ic(m, fi, st_ii), types.mir_ia(m, fi, ld_ii)) { << vec_none() }
    src := vec_trace(m, fi, bi, types.mir_ib(m, fi, ld_ii))
    dst := vec_trace(m, fi, bi, types.mir_ia(m, fi, st_ii))
    if src == dst { << vec_none() }
    // `[N]T` lives in the frame, not a slice descriptor. The NEON copy
    // loads data*/len from desc±0/8; firing on fannkuch `perm[i1]=perm1[i1]`
    // OOB'd. copy_bytes is `[]int`.
    if emit_base_fixed_len(m, fi, src) > 0 { << vec_none() }
    if emit_base_fixed_len(m, fi, dst) > 0 { << vec_none() }
    mut lim := vec_copy_limit_in(m, fi, header, ind)
    if lim.kind == 0 && header != bi {
        lim = vec_copy_limit_in(m, fi, bi, ind)
    }
    if lim.kind == 0 { << vec_none() }
    << VecPat{kind: 5, ind: ind, acc: header, mask: 0, limit: lim.limit, limit_t: lim.limit_t, else_bb: else_bb, arr: src, fac: dst}
}

fn emit_vec_index_copy(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, pins &[]int, p VecPat) int {
    // Whole-block NEON replacement. `fill()` in `main` turns RC off
    // (copy_bytes); the peep still owns the copy body, same as Clang
    // lowering `dst[i]=src[i]` to a wide copy instead of frame traffic.
    if p.ind < 0 { << 0 }
    if p.limit_t < 0 && p.limit <= 0 { << 0 }
    if p.else_bb < 0 { << 0 }
    mut ind_local := -1
    mut ind_temp := -1
    if p.ind >= types.mir_local_operand_base {
        ind_local = p.ind - types.mir_local_operand_base
        if ind_local < 0 || ind_local >= fr.local_slot.len { << 0 }
    } else {
        ind_temp = p.ind
        if ind_temp >= fr.temp_slot.len { << 0 }
    }
    mut i_vr := 6
    if a.rc_on && ind_local >= 0 {
        i_vr = vec_local_vr(&*a, pins, bi, ind_local, 6)
    }
    if i_vr == 0 || i_vr == 1 || i_vr == 2 || i_vr == 3 { << 0 }
    if i_vr == 12 || i_vr == 13 { << 0 }
    mut src := vec_resolve_desc(m, fi, bi, p.arr)
    mut dst := vec_resolve_desc(m, fi, bi, p.fac)
    if src < types.mir_local_operand_base && p.acc >= 0 && p.acc != bi {
        src = vec_resolve_desc(m, fi, p.acc, p.arr)
    }
    if dst < types.mir_local_operand_base && p.acc >= 0 && p.acc != bi {
        dst = vec_resolve_desc(m, fi, p.acc, p.fac)
    }
    mut lim_local := -1
    if p.limit_t >= types.mir_local_operand_base {
        lim_local = p.limit_t - types.mir_local_operand_base
        if lim_local < 0 || lim_local >= fr.local_slot.len { << 0 }
    } else if p.limit_t >= 0 {
        if p.limit_t >= fr.temp_slot.len { << 0 }
    }
    if i_vr == 6 {
        if ind_local >= 0 {
            a.load(6, 15, slot_off(fr.local_slot[ind_local]))
        } else {
            emit_load_value(a, m, fi, fr, ind_temp, 6)
        }
    }
    if lim_local >= 0 {
        a.load(1, 15, slot_off(fr.local_slot[lim_local]))
    } else if p.limit_t >= 0 {
        emit_load_value(a, m, fi, fr, p.limit_t, 1)
    } else {
        a.vm_mov_imm64(1, p.limit)
    }
    a.vm_cmp_imm(i_vr, 0)
    a.oob_need = 1
    a.jlt(a.oob_lbl + "")
    emit_index_desc_addr(a, m, fi, fr, src)
    a.load(12, 0, -8)
    a.cmp(12, 1)
    a.oob_need = 1
    a.jlt(a.oob_lbl + "")
    a.load(13, 0, 0)
    a.add_lsl_vr(13, 13, i_vr, 3)
    emit_index_desc_addr(a, m, fi, fr, dst)
    a.load(12, 0, -8)
    a.cmp(12, 1)
    a.jlt(a.oob_lbl + "")
    a.load(3, 0, 0)
    a.add_lsl_vr(3, 3, i_vr, 3)
    a.vm_mov_imm64(0, 0 - 8)
    a.iand(12, 1, 0)
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi)
    vec_lbl := pref + "_cv"
    sc_lbl := pref + "_cs"
    dn_lbl := pref + "_cd"
    else_lbl := types.mir_fn_label(m, fi) + "_bb" + str(p.else_bb)
    a.cmp(i_vr, 12)
    a.jge(sc_lbl + "")
    a.label(vec_lbl + "")
    a.be_neon_ldp_q_post32(0, 1, 13)
    a.be_neon_ldp_q_post32(2, 3, 13)
    a.be_neon_stp_q_post32(0, 1, 3)
    a.be_neon_stp_q_post32(2, 3, 3)
    a.vm_add_imm(i_vr, i_vr, 8)
    a.cmp(i_vr, 12)
    a.jlt(vec_lbl + "")
    a.label(sc_lbl + "")
    a.cmp(i_vr, 1)
    a.jge(dn_lbl + "")
    a.label(pref + "_cb")
    a.load(0, 13, 0)
    a.store(3, 0, 0)
    a.vm_add_imm(13, 13, 8)
    a.vm_add_imm(3, 3, 8)
    a.vm_add_imm(i_vr, i_vr, 1)
    a.cmp(i_vr, 1)
    a.jlt(pref + "_cb")
    a.label(dn_lbl + "")
    if ind_local >= 0 {
        a.store(15, slot_off(fr.local_slot[ind_local]), i_vr)
    } else if is_vreg_slot(fr.temp_slot[ind_temp]) {
        home := vreg_slot_home(fr.temp_slot[ind_temp])
        if home != i_vr {
            a.mov(home, i_vr)
        }
    } else {
        a.store(15, slot_off(fr.temp_slot[ind_temp]), i_vr)
    }
    a.jmp(else_lbl + "")
    << 1
}

fn vec3_kind_ok(k int) bool {
    if k == 0 || k == 1 || k == 2 || k == 3 || k == 4 { << true }
    if k == 10 || k == 23 || k == 26 { << true }
    << false
}

fn match_vec3_sqnorm(m &types.Mir, fi int, bi int) VecPat {
    mut header := vec_copy_header(m, fi, bi)
    mut else_bb := -1
    if header >= 0 {
        else_bb = vec_copy_else(m, fi, header, bi)
    }
    mut n_ea := 0
    mut n_lbp := 0
    mut seen0 := 0
    mut seen8 := 0
    mut seen16 := 0
    mut n_fmul := 0
    mut ea_ii := -1
    mut badk := -1
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == 23 {
            if !vec_elem24(types.mir_id(m, fi, ii)) { << vec_none() }
            n_ea += 1
            ea_ii = ii
        } else if k == 26 {
            if types.mir_id(m, fi, ii) != 1 { << vec_none() }
            off := types.mir_ic(m, fi, ii)
            if off == 0 { seen0 = 1 }
            if off == 8 { seen8 = 1 }
            if off == 16 { seen16 = 1 }
            n_lbp += 1
        } else if k == 4 && types.mir_ib(m, fi, ii) == 3 {
            dest := types.mir_ia(m, fi, ii)
            if vec_temp_ty_f64(m, fi, dest) {
                n_fmul += 1
            }
        } else if !vec3_kind_ok(k) {
            badk = k
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if n_ea >= 1 {
    }
    if header < 0 || else_bb < 0 { << vec_none() }
    if badk >= 0 { << vec_none() }
    if n_ea < 1 { << vec_none() }
    if seen0 != 1 || seen8 != 1 || seen16 != 1 { << vec_none() }
    if n_fmul < 3 { << vec_none() }
    idx := types.mir_ic(m, fi, ea_ii)
    ind := vec_pick_induct(m, fi, bi, idx)
    if ind < 0 {
        << vec_none()
    }
    acc := vec_incoming_f64(m, fi, bi)
    if acc < 0 {
        << vec_none()
    }
    arr := vec_trace(m, fi, bi, types.mir_ib(m, fi, ea_ii))
    mut lim := vec_copy_limit_in(m, fi, header, ind)
    if lim.kind == 0 && header != bi {
        lim = vec_copy_limit_in(m, fi, bi, ind)
    }
    if lim.kind == 0 {
        << vec_none()
    }
    << VecPat{kind: 6, ind: ind, acc: acc, mask: 0, limit: lim.limit, limit_t: lim.limit_t, else_bb: else_bb, arr: arr, fac: header}
}

fn vec_load_f64_acc(a &mut Assembler, m &types.Mir, fi int, fr &Frame, acc int) {
    if acc >= types.mir_local_operand_base {
        loc := acc - types.mir_local_operand_base
        a.be_fload(0, 15, slot_off(fr.local_slot[loc]))
        <<
    }
    if acc >= 0 && acc < fr.temp_slot.len && is_fp_vreg_slot(fr.temp_slot[acc]) {
        a.be_fmov_dd(0, fp_vreg_slot_d(fr.temp_slot[acc]))
        <<
    }
    if acc >= 0 && acc < fr.temp_slot.len {
        a.be_fload(0, 15, slot_off(fr.temp_slot[acc]))
        <<
    }
    <<
}

fn vec_store_f64_acc(a &mut Assembler, m &types.Mir, fi int, fr &Frame, acc int) {
    if acc >= types.mir_local_operand_base {
        loc := acc - types.mir_local_operand_base
        a.be_fstore(15, slot_off(fr.local_slot[loc]), 0)
        <<
    }
    if acc >= 0 && acc < fr.temp_slot.len && is_fp_vreg_slot(fr.temp_slot[acc]) {
        a.be_fmov_dd(fp_vreg_slot_d(fr.temp_slot[acc]), 0)
        <<
    }
    if acc >= 0 && acc < fr.temp_slot.len {
        a.be_fstore(15, slot_off(fr.temp_slot[acc]), 0)
        <<
    }
    <<
}

fn emit_vec3_sqnorm(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, pins &[]int, p VecPat) int {
    if p.ind < 0 { << 0 }
    if p.acc < 0 { << 0 }
    if p.else_bb < 0 { << 0 }
    mut ind_local := -1
    mut ind_temp := -1
    if p.ind >= types.mir_local_operand_base {
        ind_local = p.ind - types.mir_local_operand_base
        if ind_local < 0 || ind_local >= fr.local_slot.len { << 0 }
    } else {
        ind_temp = p.ind
        if ind_temp >= fr.temp_slot.len { << 0 }
    }
    mut src := vec_resolve_desc(m, fi, bi, p.arr)
    if src < types.mir_local_operand_base && p.fac >= 0 && p.fac != bi {
        src = vec_resolve_desc(m, fi, p.fac, p.arr)
    }
    mut lim_local := -1
    if p.limit_t >= types.mir_local_operand_base {
        lim_local = p.limit_t - types.mir_local_operand_base
        if lim_local < 0 || lim_local >= fr.local_slot.len { << 0 }
    } else if p.limit_t >= 0 {
        if p.limit_t >= fr.temp_slot.len { << 0 }
    } else if p.limit <= 0 {
        << 0
    }
    if ind_local >= 0 {
        a.load(6, 15, slot_off(fr.local_slot[ind_local]))
    } else {
        emit_load_value(a, m, fi, fr, ind_temp, 6)
    }
    if lim_local >= 0 {
        a.load(1, 15, slot_off(fr.local_slot[lim_local]))
    } else if p.limit_t >= 0 {
        emit_load_value(a, m, fi, fr, p.limit_t, 1)
    } else {
        a.vm_mov_imm64(1, p.limit)
    }
    a.vm_cmp_imm(6, 0)
    a.oob_need = 1
    a.jlt(a.oob_lbl + "")
    emit_index_desc_addr(a, m, fi, fr, src)
    a.load(14, 0, -8)
    a.cmp(14, 1)
    a.jlt(a.oob_lbl + "")
    a.load(13, 0, 0)
    a.shl_imm(0, 6, 3)
    a.add(13, 13, 0)
    a.shl_imm(0, 6, 4)
    a.add(13, 13, 0)
    vec_load_f64_acc(a, m, fi, fr, p.acc)
    a.vm_mov_imm64(0, 0 - 2)
    a.iand(14, 1, 0)
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi)
    vec_lbl := pref + "_v3"
    sc_lbl := pref + "_v3s"
    dn_lbl := pref + "_v3d"
    else_lbl := types.mir_fn_label(m, fi) + "_bb" + str(p.else_bb)
    a.cmp(6, 14)
    a.jge(sc_lbl + "")
    a.label(vec_lbl + "")
    a.be_neon_ldp_q_post32(1, 2, 13)
    a.be_neon_ldr_q_post16(3, 13)
    a.be_neon_mul_2d(1, 1, 1)
    a.be_neon_mul_2d(2, 2, 2)
    a.be_neon_mul_2d(3, 3, 3)
    a.be_neon_fadd_2d(1, 1, 2)
    a.be_neon_fadd_2d(1, 1, 3)
    a.be_neon_faddp_d(1, 1)
    a.fadd_d(0, 0, 1)
    a.vm_add_imm(6, 6, 2)
    a.cmp(6, 14)
    a.jlt(vec_lbl + "")
    a.label(sc_lbl + "")
    a.cmp(6, 1)
    a.jge(dn_lbl + "")
    a.label(pref + "_v3b")
    a.be_fload(1, 13, 0)
    a.be_fload(2, 13, 8)
    a.be_fload(3, 13, 16)
    a.fmul_d(1, 1, 1)
    a.fmadd_d(1, 2, 2, 1)
    a.fmadd_d(1, 3, 3, 1)
    a.fadd_d(0, 0, 1)
    a.vm_add_imm(13, 13, 24)
    a.vm_add_imm(6, 6, 1)
    a.cmp(6, 1)
    a.jlt(pref + "_v3b")
    a.label(dn_lbl + "")
    vec_store_f64_acc(a, m, fi, fr, p.acc)
    if ind_local >= 0 {
        a.store(15, slot_off(fr.local_slot[ind_local]), 6)
    } else if is_vreg_slot(fr.temp_slot[ind_temp]) {
        home := vreg_slot_home(fr.temp_slot[ind_temp])
        if home != 6 {
            a.mov(home, 6)
        }
    } else {
        a.store(15, slot_off(fr.temp_slot[ind_temp]), 6)
    }
    a.jmp(else_lbl + "")
    << 1
}
