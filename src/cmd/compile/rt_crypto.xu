    a.label("_rt_b64_url_table")
    url := [1145258561, 1212630597, 1280002633, 1347374669, 1414746705, 1482118741, 1650547289, 1717920867, 1785292903, 1852664939, 1920036975, 1987409011, 2054781047, 858927408, 926299444, 1596799288]
    for i in 0:url.len {
        a.emit32(url[i])
    }
}

fn rt_emit_sha512_arm64_compress(a &mut Assembler) {
    rt_emit_arm64_feature_check(a, "_rt_sha512_hw_supported", 21, 30)

    // _rt_sha512_arm64_compress:
    // A0 (18/X0) = &st
    // A1 (19/X1) = &string
    // A2 (20/X2) = off
    a.label("_rt_sha512_arm64_compress")
    // X4 = string.ptr + off
    a.ldr(4, 1, 0)
    a.add_reg(4, 4, 2)

    // Load h0..h7 from State (X0)
    a.ldr(6, 0, 0)
    a.ldur(7, 0, -8)
    a.ins_element_64(0, 0, 6)
    a.ins_element_64(0, 1, 7)

    a.ldur(8, 0, -16)
    a.ldur(9, 0, -24)
    a.ins_element_64(1, 0, 8)
    a.ins_element_64(1, 1, 9)

    a.ldur(10, 0, -32)
    a.ldur(11, 0, -40)
    a.ins_element_64(2, 0, 10)
    a.ins_element_64(2, 1, 11)

    a.ldur(12, 0, -48)
    a.ldur(13, 0, -56)
    a.ins_element_64(3, 0, 12)
    a.ins_element_64(3, 1, 13)

    // Backup initial state: V26..V29
    a.mov_16b(26, 0)
    a.mov_16b(27, 1)
    a.mov_16b(28, 2)
    a.mov_16b(29, 3)

    // Load 128 bytes input message into V16..V23 and rev64
    for i in 0:8 {
        a.ldr_q_uoff(16 + i, 4, i * 16)
        a.rev64_16b(16 + i, 16 + i)
    }

    // Load K512 table base into X3
    a.lea_rip_rel(3, "_rt_sha512_k_table")

    // First K round
    a.ldr_q_uoff(24, 3, 0)

    mut h0 := 0
    mut h1 := 1
    mut h2 := 2
    mut h3 := 3
    mut h4 := 4

    for i in 0:40 {
        w := 16 + (i % 8)
        w_next := 16 + ((i + 1) % 8)
        w_p4 := 16 + ((i + 4) % 8)
        w_p5 := 16 + ((i + 5) % 8)
        w_p7 := 16 + ((i + 7) % 8)

        mut cur_k := 24
        mut next_k := 25
        if (i % 2) != 0 {
            cur_k = 25
            next_k = 24
        }

        a.add_2d(cur_k, cur_k, w)
        if i + 1 < 40 {
            a.ldr_q_uoff(next_k, 3, (i + 1) * 16)
        }
        a.ext_16b(cur_k, cur_k, cur_k, 8)
        a.ext_16b(5, h2, h3, 8)
        a.ext_16b(6, h1, h2, 8)
        a.add_2d(h3, h3, cur_k)

        if i < 32 {
            a.sha512su0_2d(w, w_next)
            a.ext_16b(7, w_p4, w_p5, 8)
        }

        a.sha512h_q(h3, 5, 6)

        if i < 32 {
            a.sha512su1_2d(w, w_p7, 7)
        }

        a.add_2d(h4, h1, h3)
        a.sha512h2_q(h3, h1, h0)

        new_h0 := h3
        new_h1 := h0
        new_h2 := h4
        new_h3 := h2
        new_h4 := h1
        h0 = new_h0
        h1 = new_h1
        h2 = new_h2
        h3 = new_h3
        h4 = new_h4
    }

    // Accumulate initial state
    a.add_2d(0, 0, 26)
    a.add_2d(1, 1, 27)
    a.add_2d(2, 2, 28)
    a.add_2d(3, 3, 29)

    // Store back to st.h0..st.h7 (64-bit int slots)
    a.umov_64(6, 0, 0)
    a.str(6, 0, 0)
    a.umov_64(7, 0, 1)
    a.stur(7, 0, -8)

    a.umov_64(8, 1, 0)
    a.stur(8, 0, -16)
    a.umov_64(9, 1, 1)
    a.stur(9, 0, -24)

    a.umov_64(10, 2, 0)
    a.stur(10, 0, -32)
    a.umov_64(11, 2, 1)
    a.stur(11, 0, -40)

    a.umov_64(12, 3, 0)
    a.stur(12, 0, -48)
    a.umov_64(13, 3, 1)
    a.stur(13, 0, -56)
    a.ret()
}

