fn rt_emit_hex_table(a &mut Assembler) {
    a.label("_rt_hex_table")
    a.emit32(858927408)
    a.emit32(926299444)
    a.emit32(1650538808) // little-endian "89ab"
    a.emit32(1717920867)

    a.label("_rt_hex_dec_rebase")
    a.emit32(3520135168)
    a.emit32(11141322)
    a.emit32(0)
    a.emit32(0)

    a.label("_rt_hex_dec_check")
    a.emit32(1204936944)
    a.emit32(2149228602)
    a.emit32(0)
    a.emit32(0)
}

fn rt_emit_b64_tables(a &mut Assembler) {
    a.label("_rt_b64_std_table")
    std := [1145258561, 1212630597, 1280002633, 1347374669, 1414746705, 1482118741, 1650547289, 1717920867, 1785292903, 1852664939, 1920036975, 1987409011, 2054781047, 858927408, 926299444, 791361848]
    for i in 0:std.len {
