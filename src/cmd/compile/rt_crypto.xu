@main

#xu/types

// Emits hardware crypto helper stubs for supported architectures.
// ARM64: ARMv8-A Crypto Extension (AESE, AESMC, AESD, AESIMC, EOR).
// Invoked with C calling convention / Xu direct user call:
// A0 (18) = out buffer pointer
// A1 (19) = in buffer pointer
// A2 (20) = key buffer pointer (rk or drk)
// A3 (21) = number of rounds nr (10, 12, 14)
fn rt_emit_crypto_hardware(a &mut Assembler) {
    if a.arch == 0 {
        rt_emit_crypto_arm64(a)
    } else if a.arch == 1 {
        rt_emit_crypto_x64(a)
    } else {
        rt_emit_crypto_fallback(a)
    }
}

fn rt_emit_crypto_fallback(a &mut Assembler) {
    a.label("_rt_aes_hw_supported")
    a.vm_mov_imm(14, 0) // Ret = 0
    a.vm_ret()

    a.label("_rt_aes_arm64_block_enc")
    a.vm_ret()

    a.label("_rt_aes_arm64_block_dec")
    a.vm_ret()

    a.label("_rt_aes_arm64_drk")
    a.vm_mov_imm(14, 0)
    a.vm_ret()

    a.label("_rt_aes_x64_block_enc")
    a.vm_ret()

    a.label("_rt_aes_x64_block_dec")
    a.vm_ret()

    a.label("_rt_crc32_hw_ieee_supported")
    a.vm_mov_imm(14, 0)
    a.vm_ret()

    a.label("_rt_crc32_hw_cas_supported")
    a.vm_mov_imm(14, 0)
    a.vm_ret()

    a.label("_rt_crc32_arm64_ieee")
    a.vm_ret()

    a.label("_rt_crc32_arm64_castagnoli")
    a.vm_ret()

    a.label("_rt_crc32_x64_castagnoli")
    a.vm_ret()

    a.label("_rt_crc32_fallback_ieee")
    a.mov(14, 18)
    a.vm_ret()

    a.label("_rt_crc32_fallback_castagnoli")
    a.mov(14, 18)
    a.vm_ret()

    a.label("_rt_sha256_hw_supported")
    a.vm_mov_imm(14, 0)
    a.vm_ret()

    a.label("_rt_sha256_arm64_compress")
    a.vm_ret()

    a.label("_rt_sha512_hw_supported")
    a.vm_mov_imm(14, 0)
    a.vm_ret()

    a.label("_rt_sha512_arm64_compress")
    a.vm_ret()

    a.label("_rt_sha1_hw_supported")
    a.vm_mov_imm(14, 0)
    a.vm_ret()

    a.label("_rt_sha1_arm64_compress")
    a.vm_ret()

    a.label("_rt_sm4_hw_supported")
    a.vm_mov_imm(14, 0)
    a.vm_ret()

    a.label("_rt_sm4_arm64_crypt")
    a.vm_ret()

    a.label("_rt_math_bits_mul64_hi")
    a.vm_mov_imm(14, 0)
    a.vm_ret()

    a.label("_rt_hex_hw_supported")
    a.vm_mov_imm(14, 0)
    a.vm_ret()

    a.label("_rt_hex_arm64_encode")
    a.vm_ret()

    a.label("_rt_hex_arm64_decode")
    a.vm_mov_imm(14, 0)
    a.vm_ret()

    a.label("_rt_math_hw_supported")
    a.vm_mov_imm(14, 0)
    a.vm_ret()

    a.label("_rt_math_hw_floor")
    a.vm_ret()

    a.label("_rt_math_hw_ceil")
    a.vm_ret()

    a.label("_rt_math_hw_trunc")
    a.vm_ret()

    a.label("_rt_math_hw_round_to_even")
    a.vm_ret()

    a.label("_rt_math_hw_fma")
    a.vm_ret()

    a.label("_rt_base64_hw_supported")
    a.vm_mov_imm(14, 0)
    a.vm_ret()

    a.label("_rt_base64_arm64_encode")
    a.vm_ret()
}

fn rt_emit_crypto_arm64(a &mut Assembler) {
    rt_emit_arm64_feature_check(a, "_rt_aes_hw_supported", 3, 30)

    // _rt_aes_arm64_block_enc:
    // A0 (18) = out descriptor pointer (&string)
    // A1 (19) = src descriptor pointer (&string)
    // A2 (20) = rk descriptor pointer (&string)
    // A3 (21) = nr (10, 12, 14)
    a.label("_rt_aes_arm64_block_enc")
    // Dereference descriptor pointers to obtain raw data byte pointers
    a.load(18, 18, 0)
    a.load(19, 19, 0)
    a.load(20, 20, 0)

    // Load 16 bytes plaintext into V0
    a.be_neon_ldr_q(0, 19, 0)

    // Load Round 0 key into V1
    a.be_neon_ldr_q(1, 20, 0)

    // Loop for rounds 1 to nr-1:
    // Vreg 0 = 1 (current round r)
    a.vm_mov_imm(0, 1)

    a.label("_rt_aes_enc_loop")
    // V0 = AESE(V0, V1)
    a.aese_16b(0, 1)
    // V0 = AESMC(V0, V0)
    a.aesmc_16b(0, 0)

    // Load next round key rk[r] from a2 + r*16
    // Vreg 1 = r * 16 + a2
    a.mov(1, 0)
    a.shl_imm(1, 1, 4) // Vreg 1 = r * 16
    a.add(1, 20, 1)    // Vreg 1 = &rk[r*16]
    a.be_neon_ldr_q(1, 1, 0)

    a.vm_add_imm(0, 0, 1)
    a.cmp(0, 21) // while r < nr
    a.jlt("_rt_aes_enc_loop")

    // Final round (Round nr): AESE without AESMC
    a.aese_16b(0, 1)

    // Load final round key rk[nr]
    a.mov(1, 21)
    a.shl_imm(1, 1, 4)
    a.add(1, 20, 1)
    a.be_neon_ldr_q(2, 1, 0) // V2 = rk[nr]
    a.eor_16b(0, 0, 2)       // V0 = V0 ^ V2

    // Store 16 bytes ciphertext into out buffer
    a.be_neon_str_q(0, 18, 0)
    a.ret()

    // _rt_aes_arm64_block_dec:
    // A0 (18) = out descriptor pointer (&string)
    // A1 (19) = src descriptor pointer (&string)
    // A2 (20) = drk descriptor pointer (&string)
    // A3 (21) = nr (10, 12, 14)
    a.label("_rt_aes_arm64_block_dec")
    // Dereference descriptor pointers to obtain raw data byte pointers
    a.load(18, 18, 0)
    a.load(19, 19, 0)
    a.load(20, 20, 0)

    // Load 16 bytes ciphertext into V0
    a.be_neon_ldr_q(0, 19, 0)

    // Load Round 0 key into V1
    a.be_neon_ldr_q(1, 20, 0)

    // Loop for rounds 1 to nr-1:
    // Vreg 0 = 1
    a.vm_mov_imm(0, 1)

    a.label("_rt_aes_dec_loop")
    // V0 = AESD(V0, V1)
    a.aesd_16b(0, 1)
    // V0 = AESIMC(V0, V0)
    a.aesimc_16b(0, 0)

    // Load next round key drk[r] from a2 + r*16
    a.mov(1, 0)
    a.shl_imm(1, 1, 4)
    a.add(1, 20, 1)
    a.be_neon_ldr_q(1, 1, 0)

    a.vm_add_imm(0, 0, 1)
    a.cmp(0, 21) // while r < nr
    a.jlt("_rt_aes_dec_loop")

    // Final round: AESD without AESIMC
    a.aesd_16b(0, 1)

    // Load final round key drk[nr]
    a.mov(1, 21)
    a.shl_imm(1, 1, 4)
    a.add(1, 20, 1)
    a.be_neon_ldr_q(2, 1, 0) // V2 = drk[nr]
    a.eor_16b(0, 0, 2)       // V0 = V0 ^ V2

    // Store 16 bytes plaintext into out buffer
    a.be_neon_str_q(0, 18, 0)
    a.ret()

    // _rt_aes_arm64_drk:
    // A0 (18) = drk descriptor pointer (&string)
    // A1 (19) = rk descriptor pointer (&string)
    // A2 (20) = nr (10, 12, 14)
    a.label("_rt_aes_arm64_drk")
    a.load(18, 18, 0)
    a.load(19, 19, 0)

    // Round 0 of drk: drk[0..16] = rk[nr*16 .. nr*16+16]
    a.mov(1, 20)
    a.shl_imm(1, 1, 4)
    a.add(1, 19, 1)
    a.be_neon_ldr_q(0, 1, 0)
    a.be_neon_str_q(0, 18, 0)

    // Loop for rounds 1 to nr-1:
    a.vm_mov_imm(0, 1)
    a.label("_rt_aes_drk_loop")
    a.mov(1, 20)
    a.sub(1, 1, 0)
    a.shl_imm(1, 1, 4)
    a.add(1, 19, 1)
    a.be_neon_ldr_q(0, 1, 0)
    a.aesimc_16b(0, 0)

    a.mov(1, 0)
    a.shl_imm(1, 1, 4)
    a.add(1, 18, 1)
    a.be_neon_str_q(0, 1, 0)

    a.vm_add_imm(0, 0, 1)
    a.cmp(0, 20)
    a.jlt("_rt_aes_drk_loop")

    // Round nr of drk: drk[nr*16 ..] = rk[0..16]
    a.be_neon_ldr_q(0, 19, 0)
    a.mov(1, 20)
    a.shl_imm(1, 1, 4)
    a.add(1, 18, 1)
    a.be_neon_str_q(0, 1, 0)

    a.vm_mov_imm(14, 1)
    a.ret()

    rt_emit_arm64_feature_check(a, "_rt_crc32_hw_ieee_supported", 7, 31)

    rt_emit_arm64_feature_check(a, "_rt_crc32_hw_cas_supported", 7, 31)

    // _rt_crc32_arm64_ieee:
    // X0 = crc, X1 = &string descriptor (slot 0: ptr, slot -8: len)
    a.label("_rt_crc32_arm64_ieee")
    a.ldur(2, 1, -8) // X2 = len
    a.ldr(1, 1, 0)   // X1 = ptr
    a.mvn32(0, 0)    // W0 = ~W0 (initial inverted crc)

    a.label("_rt_crc32_ieee_loop8")
    a.cmp_imm(2, 8)
    a.blt("_rt_crc32_ieee_tail")
    a.ldr(3, 1, 0)
    a.crc32x(0, 0, 3)
    a.add_imm(1, 1, 8)
    a.sub_imm(2, 2, 8)
    a.b("_rt_crc32_ieee_loop8")

    a.label("_rt_crc32_ieee_tail")
    a.cmp_imm(2, 0)
    a.ble("_rt_crc32_ieee_done")
    a.ldrb(3, 1, 0)
    a.crc32b(0, 0, 3)
    a.add_imm(1, 1, 1)
    a.sub_imm(2, 2, 1)
    a.b("_rt_crc32_ieee_tail")

    a.label("_rt_crc32_ieee_done")
    a.mvn32(0, 0)  // W0 = ~W0 (final inversion, clears upper 32-bits)
    a.ret()

    // _rt_crc32_arm64_castagnoli:
    a.label("_rt_crc32_arm64_castagnoli")
    a.ldur(2, 1, -8) // X2 = len
    a.ldr(1, 1, 0)   // X1 = ptr
    a.mvn32(0, 0)    // W0 = ~W0

    a.label("_rt_crc32_cas_loop8")
    a.cmp_imm(2, 8)
    a.blt("_rt_crc32_cas_tail")
    a.ldr(3, 1, 0)
    a.crc32cx(0, 0, 3)
    a.add_imm(1, 1, 8)
    a.sub_imm(2, 2, 8)
    a.b("_rt_crc32_cas_loop8")

    a.label("_rt_crc32_cas_tail")
    a.cmp_imm(2, 0)
    a.ble("_rt_crc32_cas_done")
    a.ldrb(3, 1, 0)
    a.crc32cb(0, 0, 3)
    a.add_imm(1, 1, 1)
    a.sub_imm(2, 2, 1)
    a.b("_rt_crc32_cas_tail")

    a.label("_rt_crc32_cas_done")
    a.mvn32(0, 0)
    a.ret()

    rt_emit_arm64_feature_check(a, "_rt_sha256_hw_supported", 6, 30)

    // _rt_sha256_arm64_compress:
    // A0 (18) = &mut State (X0)
    // A1 (19) = &string (X1)
    // A2 (20) = off (X2)
    a.label("_rt_sha256_arm64_compress")
    // X4 = string.ptr + off
    a.ldr(4, 1, 0)
    a.add_reg(4, 4, 2)

    // Load initial 8 state words into V0 (ABCD) and V1 (EFGH)
    a.ldr(6, 0, 0)
    a.ldur(7, 0, -8)
    a.ldur(8, 0, -16)
    a.ldur(9, 0, -24)
    a.ins_element_32(0, 0, 6)
    a.ins_element_32(0, 1, 7)
    a.ins_element_32(0, 2, 8)
    a.ins_element_32(0, 3, 9)

    a.ldur(6, 0, -32)
    a.ldur(7, 0, -40)
    a.ldur(8, 0, -48)
    a.ldur(9, 0, -56)
    a.ins_element_32(1, 0, 6)
    a.ins_element_32(1, 1, 7)
    a.ins_element_32(1, 2, 8)
    a.ins_element_32(1, 3, 9)

    // Save initial state: V16=V0, V17=V1
    a.mov_16b(16, 0)
    a.mov_16b(17, 1)

    // Load 64 bytes message into V2, V3, V4, V5 and rev32
    a.ldr_q_uoff(2, 4, 0)
    a.ldr_q_uoff(3, 4, 16)
    a.ldr_q_uoff(4, 4, 32)
    a.ldr_q_uoff(5, 4, 48)
    a.rev32_16b(2, 2)
    a.rev32_16b(3, 3)
    a.rev32_16b(4, 4)
    a.rev32_16b(5, 5)

    // X5 = pointer to K table
    a.lea_rip_rel(5, "_rt_sha256_k_table")

    mut k_off := 0
    for iter in 0:4 {
        // Step 0: rounds using V2
        a.ldr_q_uoff(6, 5, k_off)
        a.add_4s(6, 2, 6)
        a.mov_16b(7, 0)
        a.sha256h(0, 1, 6)
        a.sha256h2(1, 7, 6)
        a.sha256su0(2, 3)
        a.sha256su1(2, 4, 5)
        k_off += 16

        // Step 1: rounds using V3
        a.ldr_q_uoff(6, 5, k_off)
        a.add_4s(6, 3, 6)
        a.mov_16b(7, 0)
        a.sha256h(0, 1, 6)
        a.sha256h2(1, 7, 6)
        a.sha256su0(3, 4)
        a.sha256su1(3, 5, 2)
        k_off += 16

        // Step 2: rounds using V4
        a.ldr_q_uoff(6, 5, k_off)
        a.add_4s(6, 4, 6)
        a.mov_16b(7, 0)
        a.sha256h(0, 1, 6)
        a.sha256h2(1, 7, 6)
        a.sha256su0(4, 5)
        a.sha256su1(4, 2, 3)
        k_off += 16

        // Step 3: rounds using V5
        a.ldr_q_uoff(6, 5, k_off)
        a.add_4s(6, 5, 6)
        a.mov_16b(7, 0)
        a.sha256h(0, 1, 6)
        a.sha256h2(1, 7, 6)
        a.sha256su0(5, 2)
        a.sha256su1(5, 3, 4)
        k_off += 16
    }

    // Accumulate initial state
    a.add_4s(0, 0, 16)
    a.add_4s(1, 1, 17)

    // Write back to st.h0..st.h7 (64-bit int slots)
    a.umov_32(6, 0, 0)
    a.str(6, 0, 0)
    a.umov_32(7, 0, 1)
    a.stur(7, 0, -8)
    a.umov_32(8, 0, 2)
    a.stur(8, 0, -16)
    a.umov_32(9, 0, 3)
    a.stur(9, 0, -24)

    a.umov_32(6, 1, 0)
    a.stur(6, 0, -32)
    a.umov_32(7, 1, 1)
    a.stur(7, 0, -40)
    a.umov_32(8, 1, 2)
    a.stur(8, 0, -48)
    a.umov_32(9, 1, 3)
    a.stur(9, 0, -56)
    a.ret()

    // _rt_sm4_hw_supported: returns 0 on Apple Silicon (safe fallback to software S-Box)
    a.label("_rt_sm4_hw_supported")
    a.mov_imm(0, 0)
    a.ret()

    // _rt_sm4_arm64_crypt: stub for ARMv8.4-A Crypto
    a.label("_rt_sm4_arm64_crypt")
    a.ret()

    rt_emit_arm64_feature_check(a, "_rt_sha1_hw_supported", 5, 30)

    // _rt_sha1_arm64_compress:
    // A0 (18) = &mut State (X0)
    // A1 (19) = &string (X1)
    // A2 (20) = off (X2)
    a.label("_rt_sha1_arm64_compress")
    // X4 = string.ptr + off
    a.ldr(4, 1, 0)
    a.add_reg(4, 4, 2)

    // Load h0..h4 from State
    a.ldr(6, 0, 0)
    a.ldur(7, 0, -8)
    a.ldur(8, 0, -16)
    a.ldur(9, 0, -24)
    a.ldur(10, 0, -32)
    a.ins_element_32(0, 0, 6)
    a.ins_element_32(0, 1, 7)
    a.ins_element_32(0, 2, 8)
    a.ins_element_32(0, 3, 9)
    a.fmov_s_from_w(1, 10)

    // Backup initial state: V21 = V0, V22 = V1
    a.mov_16b(21, 0)
    a.mov_16b(22, 1)

    // Load 64 bytes of message into V4, V5, V6, V7 and rev32
    a.ldr_q_uoff(4, 4, 0)
    a.ldr_q_uoff(5, 4, 16)
    a.ldr_q_uoff(6, 4, 32)
    a.ldr_q_uoff(7, 4, 48)
    a.rev32_16b(4, 4)
    a.rev32_16b(5, 5)
    a.rev32_16b(6, 6)
    a.rev32_16b(7, 7)

    // Load K constants into V19
    a.lea_rip_rel(5, "_rt_sha1_k_table")
    a.ldr_q_uoff(19, 5, 0)

    // Working state: V2 = V0, V3 = V0
    a.mov_16b(2, 0)
    a.mov_16b(3, 2)

    // Rounds 0..19: K0, K1
    a.dup_4s_from_s(17, 19, 0)
    a.dup_4s_from_s(18, 19, 1)

    // Step 0:
    a.add_4s(16, 4, 17)
    a.sha1su0(4, 5, 6)
    a.sha1c(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)
    a.sha1su1(4, 7)

    // Step 1:
    a.add_4s(16, 5, 17)
    a.sha1su0(5, 6, 7)
    a.sha1c(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)
    a.sha1su1(5, 4)

    // Step 2:
    a.add_4s(16, 6, 17)
    a.sha1su0(6, 7, 4)
    a.sha1c(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)
    a.sha1su1(6, 5)

    // Step 3:
    a.add_4s(16, 7, 17)
    a.sha1su0(7, 4, 5)
    a.sha1c(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)
    a.sha1su1(7, 6)

    // Step 4:
    a.add_4s(16, 4, 17)
    a.sha1su0(4, 5, 6)
    a.sha1c(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)
    a.sha1su1(4, 7)

    // Rounds 20..39: K2 in V17
    a.dup_4s_from_s(17, 19, 2)

    // Step 5:
    a.add_4s(16, 5, 18)
    a.sha1su0(5, 6, 7)
    a.sha1p(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)
    a.sha1su1(5, 4)

    // Step 6:
    a.add_4s(16, 6, 18)
    a.sha1su0(6, 7, 4)
    a.sha1p(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)
    a.sha1su1(6, 5)

    // Step 7:
    a.add_4s(16, 7, 18)
    a.sha1su0(7, 4, 5)
    a.sha1p(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)
    a.sha1su1(7, 6)

    // Step 8:
    a.add_4s(16, 4, 18)
    a.sha1su0(4, 5, 6)
    a.sha1p(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)
    a.sha1su1(4, 7)

    // Step 9:
    a.add_4s(16, 5, 18)
    a.sha1su0(5, 6, 7)
    a.sha1p(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)
    a.sha1su1(5, 4)

    // Rounds 40..59: K3 in V18
    a.dup_4s_from_s(18, 19, 3)

    // Step 10:
    a.add_4s(16, 6, 17)
    a.sha1su0(6, 7, 4)
    a.sha1m(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)
    a.sha1su1(6, 5)

    // Step 11:
    a.add_4s(16, 7, 17)
    a.sha1su0(7, 4, 5)
    a.sha1m(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)
    a.sha1su1(7, 6)

    // Step 12:
    a.add_4s(16, 4, 17)
    a.sha1su0(4, 5, 6)
    a.sha1m(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)
    a.sha1su1(4, 7)

    // Step 13:
    a.add_4s(16, 5, 17)
    a.sha1su0(5, 6, 7)
    a.sha1m(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)
    a.sha1su1(5, 4)

    // Step 14:
    a.add_4s(16, 6, 17)
    a.sha1su0(6, 7, 4)
    a.sha1m(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)
    a.sha1su1(6, 5)

    // Rounds 60..79: K3 in V18
    // Step 15:
    a.add_4s(16, 7, 18)
    a.sha1su0(7, 4, 5)
    a.sha1p(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)
    a.sha1su1(7, 6)

    // Step 16:
    a.add_4s(16, 4, 18)
    a.sha1p(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)

    // Step 17:
    a.add_4s(16, 5, 18)
    a.sha1p(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)

    // Step 18:
    a.add_4s(16, 6, 18)
    a.sha1p(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)

    // Step 19:
    a.add_4s(16, 7, 18)
    a.sha1p(0, 1, 16)
    a.sha1h(1, 2)
    a.mov_16b(2, 0)

    // Add back initial state
    a.add_4s(0, 0, 21)
    a.fmov_w_from_s(6, 1)
    a.fmov_w_from_s(7, 22)
    a.add_reg(6, 6, 7)

    // Store back to st.h0..st.h4
    a.umov_32(7, 0, 0)
    a.str(7, 0, 0)
    a.umov_32(7, 0, 1)
    a.stur(7, 0, -8)
    a.umov_32(7, 0, 2)
    a.stur(7, 0, -16)
    a.umov_32(7, 0, 3)
    a.stur(7, 0, -24)
    a.stur(6, 0, -32)
    a.ret()

    // _rt_math_bits_mul64_hi: returns high 64 bits of x * y (unsigned)
    // A0 (18) = x (X0)
    // A1 (19) = y (X1)
    a.label("_rt_math_bits_mul64_hi")
    a.umulh(0, 0, 1)
    a.ret()

    // _rt_hex_hw_supported: returns 1
    a.label("_rt_hex_hw_supported")
    a.mov_imm(0, 1)
    a.ret()

    // _rt_hex_arm64_encode:
    // A0 (18) = &src (X0)
    // A1 (19) = &dst (X1)
    a.label("_rt_hex_arm64_encode")
    // X2 = src.ptr, X3 = src.len
    a.ldr(2, 0, 0)
    a.ldur(3, 0, -8)
    // X4 = dst.ptr
    a.ldr(4, 1, 0)

    // Load hex table into V1
    a.lea_rip_rel(10, "_rt_hex_table")
    a.ldr_q_uoff(1, 10, 0)

    // V2 = 0x0F mask across 16 bytes
    a.movi_16b_imm(2, 15)

    a.label("_rt_hex_loop16")
    a.cmp_imm(3, 16)
    a.blt("_rt_hex_done")

    // Load 16 bytes input into V0
    a.ldr_q_uoff(0, 2, 0)
    a.ushr_16b(30, 0, 4)
    a.and_16b(31, 0, 2)

    a.tbl_16b(5, 1, 30)
    a.tbl_16b(6, 1, 31)

    a.zip1_16b(7, 5, 6)
    a.zip2_16b(8, 5, 6)

    a.str_q_uoff(7, 4, 0)
    a.str_q_uoff(8, 4, 16)

    a.add_imm(2, 2, 16)
    a.add_imm(4, 4, 32)
    a.sub_imm(3, 3, 16)
    a.b("_rt_hex_loop16")

    a.label("_rt_hex_done")
    a.ret()

    // _rt_hex_arm64_decode:
    // A0 (18) = &src (X0)
    // A1 (19) = &dst (X1)
    // Returns number of bytes decoded in X0, or -1 on invalid byte.
    a.label("_rt_hex_arm64_decode")
    // X2 = src.ptr, X3 = src.len
    a.ldr(2, 0, 0)
    a.ldur(3, 0, -8)
    // X4 = dst.ptr
    a.ldr(4, 1, 0)
    // X5 = original src.len
    a.mov_reg(5, 3)

    // Load constant tables into V16 and V17
    a.lea_rip_rel(10, "_rt_hex_dec_rebase")
    a.ldr_q_uoff(16, 10, 0)

    a.lea_rip_rel(10, "_rt_hex_dec_check")
    a.ldr_q_uoff(17, 10, 0)

    // V18 = 0x0F across 16 bytes
    a.movi_16b_imm(18, 15)

    // V19 = 0x01 across 16 bytes
    a.movi_16b_imm(19, 1)

    a.label("_rt_hex_dec_loop32")
    a.cmp_imm(3, 32)
    a.blt("_rt_hex_dec_done")

    // Load 32 ASCII input bytes into V0 and V1
    a.ldr_q_uoff(0, 2, 0)
    a.ldr_q_uoff(1, 2, 16)

    // Unpack even and odd characters
    a.uzp1_16b(2, 0, 1) // V2 = 16 high chars
    a.uzp2_16b(3, 0, 1) // V3 = 16 low chars

    // Subtract 1
    a.sub_16b(4, 2, 19) // V4 = vm1_hi
    a.sub_16b(5, 3, 19) // V5 = vm1_lo

    // Extract hash keys = (vm1 >> 4) & 15
    a.ushr_16b(6, 4, 4)
    a.and_16b(6, 6, 18) // V6 = hash_hi
    a.ushr_16b(7, 5, 4)
    a.and_16b(7, 7, 18) // V7 = hash_lo

    // Validation check: chk = vm1 + tbl(delta_check, hash)
    a.tbl_16b(20, 17, 6)
    a.add_16b(20, 4, 20)  // V20 = chk_hi
    a.tbl_16b(21, 17, 7)
    a.add_16b(21, 5, 21)  // V21 = chk_lo
    a.orr_16b(20, 20, 21) // V20 = chk_hi | chk_lo

    // Check if any character is invalid (bit 7 set)
    a.umaxv_16b(21, 20)
    a.fmov_w_from_s(6, 21)
    a.lsr_imm(6, 6, 7)
    a.cbnz(6, "_rt_hex_dec_err")

    // Valid: rebase to 0..15: val = vm1 + tbl(delta_rebase, hash)
    a.tbl_16b(6, 16, 6)
    a.add_16b(4, 4, 6)   // V4 = val_hi (0..15)
    a.tbl_16b(7, 16, 7)
    a.add_16b(5, 5, 7)   // V5 = val_lo (0..15)

    // Combine nibbles: (val_hi << 4) | val_lo
    a.shl_16b(4, 4, 4)
    a.orr_16b(4, 4, 5)   // V4 = 16 decoded bytes

    // Store 16 decoded bytes to dst
    a.str_q_uoff(4, 4, 0)

    // Advance pointers
    a.add_imm(2, 2, 32)
    a.add_imm(4, 4, 16)
    a.sub_imm(3, 3, 32)
    a.b("_rt_hex_dec_loop32")

    a.label("_rt_hex_dec_done")
    // Return decoded bytes count = (original src.len - remaining src.len) / 2
    a.sub_reg(0, 5, 3)
    a.lsr_imm(0, 0, 1)
    a.ret()

    a.label("_rt_hex_dec_err")
    // Return -1 on error
    a.mov_imm(0, 0)
    a.sub_imm(0, 0, 1)
    a.ret()

    // _rt_math_hw_supported: returns 1
    a.label("_rt_math_hw_supported")
    a.mov_imm(0, 1)
    a.ret()

    // _rt_math_hw_floor:
    a.label("_rt_math_hw_floor")
    a.fmov_d_from_x(0, 0)
    a.frintm_d(0, 0)
    a.fmov_x_from_d(0, 0)
    a.ret()

    // _rt_math_hw_ceil:
    a.label("_rt_math_hw_ceil")
    a.fmov_d_from_x(0, 0)
    a.frintp_d(0, 0)
    a.fmov_x_from_d(0, 0)
    a.ret()

    // _rt_math_hw_trunc:
    a.label("_rt_math_hw_trunc")
    a.fmov_d_from_x(0, 0)
    a.frintz_d(0, 0)
    a.fmov_x_from_d(0, 0)
    a.ret()

    // _rt_math_hw_round_to_even:
    a.label("_rt_math_hw_round_to_even")
    a.fmov_d_from_x(0, 0)
    a.frintn_d(0, 0)
    a.fmov_x_from_d(0, 0)
    a.ret()

    // _rt_math_hw_fma:
    // A0 (18/X0) = x, A1 (19/X1) = y, A2 (20/X2) = z
    a.label("_rt_math_hw_fma")
    a.fmov_d_from_x(0, 0)
    a.fmov_d_from_x(1, 1)
    a.fmov_d_from_x(2, 2)
    a.fmadd_d(0, 0, 1, 2)
    a.fmov_x_from_d(0, 0)
    a.ret()

    // _rt_base64_hw_supported: returns 1
    a.label("_rt_base64_hw_supported")
    a.mov_imm(0, 1)
    a.ret()

    // _rt_base64_arm64_encode:
    // A0 (18/X0) = &src, A1 (19/X1) = &dst, A2 (20/X2) = is_url
    // Returns processed source bytes in X0.
    a.label("_rt_base64_arm64_encode")
    a.mov_reg(6, 2)        // X6 = is_url
    a.ldr(2, 0, 0)         // X2 = src.ptr
    a.ldur(3, 0, -8)       // X3 = src.len
    a.ldr(4, 1, 0)         // X4 = dst.ptr
    a.mov_reg(5, 3)        // X5 = original src.len

    a.cmp_imm(6, 1)
    a.beq("_rt_b64_load_url")
    a.lea_rip_rel(10, "_rt_b64_std_table")
    a.b("_rt_b64_load_tbl")
    a.label("_rt_b64_load_url")
    a.lea_rip_rel(10, "_rt_b64_url_table")
    a.label("_rt_b64_load_tbl")
    a.ldr_q_uoff(20, 10, 0)
    a.ldr_q_uoff(21, 10, 16)
    a.ldr_q_uoff(22, 10, 32)
    a.ldr_q_uoff(23, 10, 48)

    a.movi_16b_imm(15, 63) // V15 = 0x3F mask

    a.label("_rt_b64_loop48")
    a.cmp_imm(3, 48)
    a.blt("_rt_b64_done")

    a.ld3_16b_post(0, 2)

    a.ushr_16b(4, 0, 2)
    a.ushr_16b(5, 1, 4)
    a.ushr_16b(6, 2, 6)
    a.sli_16b(5, 0, 4)
    a.sli_16b(6, 1, 2)

    a.and_16b(5, 5, 15)
    a.and_16b(6, 6, 15)
    a.and_16b(7, 2, 15)

    a.tbl4_16b(4, 20, 4)
    a.tbl4_16b(5, 20, 5)
    a.tbl4_16b(6, 20, 6)
    a.tbl4_16b(7, 20, 7)

    a.st4_16b_post(4, 4)

    a.sub_imm(3, 3, 48)
    a.b("_rt_b64_loop48")

    a.label("_rt_b64_done")
    a.sub_reg(0, 5, 3)     // X0 = original src.len - remaining X3
    a.ret()

    rt_emit_sha512_arm64_compress(a)
    rt_emit_sha256_k_table(a)
    rt_emit_sha512_k_table(a)
    rt_emit_sha1_k_table(a)
    rt_emit_hex_table(a)
    rt_emit_b64_tables(a)
}

fn rt_emit_crypto_x64(a &mut Assembler) {
    rt_emit_x64_cpu_leaf1(a)
    rt_emit_x64_popcount(a)
    rt_emit_x64_feature_check(a, "_rt_aes_hw_supported", 25)

    // x64 uses AES-NI for blocks, but builds inverse round keys in Xu.
    // Keep the shared call target and return false to select that fallback.
    a.label("_rt_aes_arm64_drk")
    a.x64_mov_imm32(0, 0)
    a.x64_ret()

    // _rt_aes_x64_block_enc:
    // A0 (18) = out descriptor pointer (&string)
    // A1 (19) = src descriptor pointer (&string)
    // A2 (20) = rk descriptor pointer (&string)
    // A3 (21) = nr (10, 12, 14)
    a.label("_rt_aes_x64_block_enc")
    // Dereference descriptor pointers to obtain raw data byte pointers:
    a.load(18, 18, 0)
    a.load(19, 19, 0)
    a.load(20, 20, 0)

    // Load 16 bytes plaintext into XMM0
    a.xbe_movdqu_load(0, 19, 0)

    // Load Round 0 key into XMM1
    a.xbe_movdqu_load(1, 20, 0)

    // Initial AddRoundKey: XMM0 = XMM0 ^ XMM1
    a.x64_pxor(0, 1)

    // Loop for rounds 1 to nr-1:
    // Vreg 0 = 1 (current round r)
    a.vm_mov_imm(0, 1)

    a.label("_rt_aes_x64_enc_loop")
    // Load next round key rk[r] from a2 + r*16
    // Vreg 1 = r * 16 + a2
    a.mov(1, 0)
    a.shl_imm(1, 1, 4) // Vreg 1 = r * 16
    a.add(1, 20, 1)    // Vreg 1 = &rk[r*16]
    a.xbe_movdqu_load(1, 1, 0)
    // XMM0 = AESENC(XMM0, XMM1)
    a.x64_aesenc(0, 1)

    a.vm_add_imm(0, 0, 1)
    a.cmp(0, 21) // while r < nr
    a.jlt("_rt_aes_x64_enc_loop")

    // Final round (Round nr): AESENCLAST
    a.mov(1, 21)
    a.shl_imm(1, 1, 4)
    a.add(1, 20, 1)
    a.xbe_movdqu_load(1, 1, 0)
    a.x64_aesenclast(0, 1)

    // Store 16 bytes ciphertext into out buffer
    a.xbe_movdqu_store(18, 0, 0)
    a.x64_ret()

    // _rt_aes_x64_block_dec:
    // A0 (18) = out descriptor pointer (&string)
    // A1 (19) = src descriptor pointer (&string)
    // A2 (20) = drk descriptor pointer (&string)
    // A3 (21) = nr (10, 12, 14)
    a.label("_rt_aes_x64_block_dec")
    // Dereference descriptor pointers to obtain raw data byte pointers:
    a.load(18, 18, 0)
    a.load(19, 19, 0)
    a.load(20, 20, 0)

    // Load 16 bytes ciphertext into XMM0
    a.xbe_movdqu_load(0, 19, 0)

    // Load Round 0 key into XMM1
    a.xbe_movdqu_load(1, 20, 0)

    // Initial AddRoundKey: XMM0 = XMM0 ^ XMM1
    a.x64_pxor(0, 1)

    // Loop for rounds 1 to nr-1:
    // Vreg 0 = 1
    a.vm_mov_imm(0, 1)

    a.label("_rt_aes_x64_dec_loop")
    // Load next round key drk[r] from a2 + r*16
    a.mov(1, 0)
    a.shl_imm(1, 1, 4)
    a.add(1, 20, 1)
    a.xbe_movdqu_load(1, 1, 0)
    // XMM0 = AESDEC(XMM0, XMM1)
    a.x64_aesdec(0, 1)

    a.vm_add_imm(0, 0, 1)
    a.cmp(0, 21) // while r < nr
    a.jlt("_rt_aes_x64_dec_loop")

    // Final round: AESDECLAST
    a.mov(1, 21)
    a.shl_imm(1, 1, 4)
    a.add(1, 20, 1)
    a.xbe_movdqu_load(1, 1, 0)
    a.x64_aesdeclast(0, 1)

    // Store 16 bytes plaintext into out buffer
    a.xbe_movdqu_store(18, 0, 0)
    a.x64_ret()

    // _rt_crc32_hw_ieee_supported: returns 0 on x86 (no native single-instruction IEEE)
    a.label("_rt_crc32_hw_ieee_supported")
    a.x64_mov_imm32(0, 0)
    a.x64_ret()

    rt_emit_x64_feature_check(a, "_rt_crc32_hw_cas_supported", 20)

    // _rt_crc32_x64_castagnoli:
    // RDI (7) = crc, RSI (6) = &string descriptor
    a.label("_rt_crc32_x64_castagnoli")
    a.x64_mov_reg(0, 7)          // RAX = RDI
    a.x64_not32(0)               // not eax
    a.x64_load_offset(1, 6, -8)  // RCX = len
    a.x64_load_offset(6, 6, 0)   // RSI = ptr

    a.label("_rt_crc32_x64_cas_loop8")
    a.x64_cmp_imm(1, 8)
    a.x64_jcc(12, "_rt_crc32_x64_cas_tail") // jl
    a.x64_load_offset(2, 6, 0)   // RDX = *(u64*)RSI
    a.x64_crc32q(0, 2)           // crc32 rax, rdx
    a.x64_add_imm(6, 8)          // add rsi, 8
    a.x64_sub_imm(1, 8)          // sub rcx, 8
    a.x64_jmp("_rt_crc32_x64_cas_loop8")

    a.label("_rt_crc32_x64_cas_tail")
    a.x64_cmp_imm(1, 0)
    a.x64_jcc(14, "_rt_crc32_x64_cas_done") // jle
    a.x64_load_byte_offset(2, 6, 0) // movzx edx, byte ptr [rsi]
    a.x64_crc32b(0, 2)              // crc32 eax, dl
    a.x64_add_imm(6, 1)             // add rsi, 1
    a.x64_sub_imm(1, 1)             // sub rcx, 1
    a.x64_jmp("_rt_crc32_x64_cas_tail")

    a.label("_rt_crc32_x64_cas_done")
    a.x64_not32(0) // not eax
    a.x64_ret()

    // fallback stubs on x64
    a.label("_rt_crc32_fallback_ieee")
    a.x64_mov_reg(0, 7)
    a.x64_ret()

    a.label("_rt_crc32_fallback_castagnoli")
    a.x64_mov_reg(0, 7)
    a.x64_ret()

    a.label("_rt_sha256_hw_supported")
    a.x64_mov_imm32(0, 0)
    a.x64_ret()

    // Private helpers remain referenced by guarded calls even when the
    // capability query returns zero. Match the non-ARM fallback symbols.
    a.label("_rt_sha256_arm64_compress")
    a.x64_ret()

    a.label("_rt_sha512_hw_supported")
    a.x64_mov_imm32(0, 0)
    a.x64_ret()

    a.label("_rt_sha512_arm64_compress")
    a.x64_ret()

    a.label("_rt_sha1_hw_supported")
    a.x64_mov_imm32(0, 0)
    a.x64_ret()

    a.label("_rt_sha1_arm64_compress")
    a.x64_ret()

    a.label("_rt_sm4_hw_supported")
    a.x64_mov_imm32(0, 0)
    a.x64_ret()

    a.label("_rt_sm4_arm64_crypt")
    a.x64_ret()

    // _rt_math_bits_mul64_hi: returns high 64 bits of x * y
    // x in RDI (7), y in RSI (6)
    a.label("_rt_math_bits_mul64_hi")
    a.x64_mov_reg(0, 7) // mov rax, rdi
    a.x64_mul(6)        // mul rsi (RDX:RAX = RAX * RSI)
    a.x64_mov_reg(0, 2) // mov rax, rdx
    a.x64_ret()

    a.label("_rt_hex_hw_supported")
    a.x64_mov_imm32(0, 0)
    a.x64_ret()

    a.label("_rt_hex_arm64_encode")
    a.x64_ret()

    a.label("_rt_hex_arm64_decode")
    a.x64_mov_imm32(0, 0)
    a.x64_ret()

    rt_emit_x64_feature_check(a, "_rt_math_hw_supported", 19)

    // _rt_math_hw_floor:
    // x in RDI (7), return in RAX (0)
    a.label("_rt_math_hw_floor")
    a.x64_movq_xmm_from_r(0, 7)
    a.x64_roundsd(0, 0, 1)
    a.x64_movq_r_from_xmm(0, 0)
    a.x64_ret()

    // _rt_math_hw_ceil:
    a.label("_rt_math_hw_ceil")
    a.x64_movq_xmm_from_r(0, 7)
    a.x64_roundsd(0, 0, 2)
    a.x64_movq_r_from_xmm(0, 0)
    a.x64_ret()

    // _rt_math_hw_trunc:
    a.label("_rt_math_hw_trunc")
    a.x64_movq_xmm_from_r(0, 7)
    a.x64_roundsd(0, 0, 3)
    a.x64_movq_r_from_xmm(0, 0)
    a.x64_ret()

    // _rt_math_hw_round_to_even:
    a.label("_rt_math_hw_round_to_even")
    a.x64_movq_xmm_from_r(0, 7)
    a.x64_roundsd(0, 0, 0)
    a.x64_movq_r_from_xmm(0, 0)
    a.x64_ret()

    // _rt_math_hw_fma:
    // x in RDI (7), y in RSI (6), z in RDX (2)
    a.label("_rt_math_hw_fma")
    a.x64_movq_xmm_from_r(0, 7)
    a.x64_movq_xmm_from_r(1, 6)
    a.x64_mulsd(0, 1)
    a.x64_movq_xmm_from_r(1, 2)
    a.x64_addsd(0, 1)
    a.x64_movq_r_from_xmm(0, 0)
    a.x64_ret()

    a.label("_rt_base64_hw_supported")
    a.x64_mov_imm32(0, 0)
    a.x64_ret()

    a.label("_rt_base64_arm64_encode")
    a.x64_ret()
}

fn rt_sha256_k_consts() []int {
    mut k := []int{}
    k.push(1116352408)
