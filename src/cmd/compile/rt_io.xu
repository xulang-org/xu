@main

#xu/types

fn rt_exit(a &mut Assembler, code_imm int) {
    if a.cover {
        a.call("_rt_dump_cover")
    }
    a.vm_mov_imm(18, code_imm)
    a.vm_exit()
    <<
}

// ===== rt_write: A0 = ptr, A1 = len, A2 = fd =====
fn rt_emit_write(a &mut Assembler) {
    if a.os == 2 {
        // WoA: HANDLE / OUT DWORD slots must be naturally aligned.
        a.align_data(8)
        a.data_label("_rt_stdout")
        rt_emit_zeros(a, 8)
        a.data_label("_rt_stderr")
        rt_emit_zeros(a, 8)
        a.data_label("_rt_written")
        rt_emit_zeros(a, 8)
        a.data_label("_rt_conout")
        // CONOUT$ + NUL ($$ = literal $ in Xu strings)
        rt_emit_bytes(a, "CONOUT$$")
        a.emit_data([0])
        a.data_label("_rt_conerr")
        rt_emit_bytes(a, "CONERR$$")
        a.emit_data([0])
    }
    a.label("_rt_write")
    // Keep a 16-byte-aligned frame; slot for WriteFile's OUT DWORD at fp-32.
    a.prologue(48)
    a.store(15, -8, 18) // ptr
    a.store(15, -16, 19) // len
    a.store(15, -24, 20) // fd
    if a.os == 2 {
        // Windows: GetStdHandle, fallback CreateFileA("CONOUT$"/"CONERR$"), WriteFile.
        a.load(0, 15, -24)
        a.vm_cmp_imm(0, 2)
        a.jeq("_rt_ws_err_slot")
        a.lea(0, "_rt_stdout")
        a.jmp("_rt_ws_slot")
        a.label("_rt_ws_err_slot")
        a.lea(0, "_rt_stderr")
        a.label("_rt_ws_slot")
        a.load(0, 0, 0)
        a.vm_cbnz(0, "_rt_ws_have")
        a.load(0, 15, -24)
        a.mov(18, 0)
        a.neg(18, 18)
        a.vm_sub_imm(18, 18, 10) // 1->-11, 2->-12
        a.vm_call_iat("_iat_GetStdHandle")
        a.mov(0, 14)
        // Treat NULL / INVALID_HANDLE_VALUE (-1) as failure → CONOUT$/CONERR$.
        a.vm_cbz(0, "_rt_ws_open_con")
        a.vm_cmp_imm(0, -1)
        a.jeq("_rt_ws_open_con")
        a.jmp("_rt_ws_got_handle")
        a.label("_rt_ws_open_con")
        a.load(1, 15, -24)
        a.vm_cmp_imm(1, 2)
        a.jeq("_rt_ws_open_err")
        a.lea(18, "_rt_conout")
        a.jmp("_rt_ws_open")
        a.label("_rt_ws_open_err")
        a.lea(18, "_rt_conerr")
        a.label("_rt_ws_open")
        // CreateFileA(name, GENERIC_WRITE, SHARE_READ|SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL)
        a.vm_mov_imm64(19, RT_WIN_GENERIC_WRITE) // 0x40000000 GENERIC_WRITE
        a.vm_mov_imm(20, 3) // FILE_SHARE_READ|WRITE
        a.vm_mov_imm(21, 0)
        a.vm_mov_imm(22, 3) // OPEN_EXISTING
        a.vm_mov_imm(23, 0)
        a.vm_call_iat7("_iat_CreateFileA")
        a.mov(0, 14)
        a.label("_rt_ws_got_handle")
        a.load(1, 15, -24)
        a.vm_cmp_imm(1, 2)
        a.jeq("_rt_ws_store_err")
        a.lea(1, "_rt_stdout")
        a.jmp("_rt_ws_store")
        a.label("_rt_ws_store_err")
        a.lea(1, "_rt_stderr")
        a.label("_rt_ws_store")
        a.store(1, 0, 0)
        a.label("_rt_ws_have")
        a.mov(18, 0)
        a.load(19, 15, -8)
        a.load(20, 15, -16)
        // bytes-written OUT param on stack (fp-32), always aligned.
        a.mov(1, 15)
        a.vm_sub_imm(1, 1, 32)
        a.mov(21, 1)
        a.vm_mov_imm(22, 0)
        a.vm_call_iat("_iat_WriteFile")
    } else {
        if a.os == 3 {
            a.label("_rt_wr_loop")
            a.load(0, 15, -16)
            a.vm_cbz(0, "_rt_wr_done")
            a.load(1, 15, -8)
            a.load_byte(18, 1, 0)
            a.call("_xu_putc")
            a.load(1, 15, -8)
            a.vm_add_imm(1, 1, 1)
            a.store(15, -8, 1)
            a.load(0, 15, -16)
            a.vm_sub_imm(0, 0, 1)
            a.store(15, -16, 0)
            a.jmp("_rt_wr_loop")
            a.label("_rt_wr_done")
        } else {
            a.load(18, 15, -24) // fd
            a.load(19, 15, -8)
            a.load(20, 15, -16)
            a.vm_syscall(syscall_number(a.os, a.arch, 1))
            if xacp_output_supported(&*a) {
                a.vm_normalize_syscall("_rt_write_xacp")
                a.store(15, -32, 14)
                a.load(18, 15, -24)
                a.load(19, 15, -8)
                a.mov(20, 14)
                a.call("_rt_xacp_output_append")
                a.load(14, 15, -32)
            }
        }
    }
    a.epilogue()
    <<
}

// ===== rt_println_int: A0 = value, A2 = fd =====
fn rt_emit_println_int(a &mut Assembler) {
    if a.has_int64_pairs() {
        rt_emit_println_int_thumb64(a)
        <<
    }
    a.data_label("_rt_itoa_buf")
    rt_emit_zeros(a, 32)

    a.label("_rt_println_int")
    a.prologue(64)
    a.store(15, -8, 20) // fd
    // Stack-local digit buffer [fp-48, fp-16): a shared static would race
    // across concurrent goroutines (digits smashed mid-write).
    // V0 = write pointer (walks backwards from the buffer end)
    a.vm_sub_imm(0, 15, 16)
    // V1 = remaining value, V2 = sign flag
    a.mov(1, 18)
    a.vm_mov_imm(2, 0)
    a.vm_cmp_imm(1, 0)
    a.jge("_rt_pi_pos")
    // G7: do not negate (neg(INT_MIN) wraps); fold the sign per digit below.
    a.vm_mov_imm(2, 1)
    a.label("_rt_pi_pos")
    // Trailing newline first (highest address).
    a.vm_mov_imm(4, 10) // '\n'
    a.vm_sub_imm(0, 0, 1)
    a.store_byte(0, 0, 4)
    a.vm_mov_imm(3, 10)
    // Digit loop: store '0' + (value % 10), value /= 10, until value == 0.
    // Trunc division gives a negative remainder/quotient for negative
    // values (incl. INT_MIN, where neg would wrap); per digit, if the
    // remainder is negative, negate both the digit and the quotient.
    a.label("_rt_pi_loop")
    a.imod(4, 1, 3)
    a.div(1, 1, 3)
    a.vm_cmp_imm(4, 0)
    a.jge("_rt_pi_dig")
    a.neg(4, 4)
    a.neg(1, 1)
    a.label("_rt_pi_dig")
    a.vm_add_imm(4, 4, 48) // '0'
    a.vm_sub_imm(0, 0, 1)
    a.store_byte(0, 0, 4)
    a.vm_cmp_imm(1, 0)
    a.jne("_rt_pi_loop")
    // Optional '-'.
    a.vm_cbz(2, "_rt_pi_write")
    a.vm_sub_imm(0, 0, 1)
    a.vm_mov_imm(4, 45) // '-'
    a.store_byte(0, 0, 4)
    // write(fd, ptr, buf_end - ptr)
    a.label("_rt_pi_write")
    a.vm_sub_imm(5, 15, 16)
    a.sub(5, 5, 0)
    a.mov(18, 0)
    a.mov(19, 5)
    a.load(20, 15, -8)
    a.call("_rt_write")
    a.epilogue()
    <<
}

// ===== rt_println_bool: A0 = value, A2 = fd =====
fn rt_emit_println_bool(a &mut Assembler) {
    a.data_label("_rt_true")
    rt_emit_bytes(a, "true\n")
    a.data_label("_rt_false")
    rt_emit_bytes(a, "false\n")

    a.label("_rt_println_bool")
    a.prologue(16)
    a.store(15, -8, 20) // fd
    a.vm_cbz(18, "_rt_pb_false")
    a.lea(18, "_rt_true")
    a.vm_mov_imm(19, 5)
    a.load(20, 15, -8)
    a.call("_rt_write")
    a.jmp("_rt_pb_done")
    a.label("_rt_pb_false")
    a.lea(18, "_rt_false")
    a.vm_mov_imm(19, 6)
    a.load(20, 15, -8)
    a.call("_rt_write")
    a.label("_rt_pb_done")
    a.epilogue()
    <<
}

// ===== rt_println_str: A0 = ptr, A1 = len, A2 = fd =====
fn rt_emit_println_str(a &mut Assembler) {
    a.data_label("_rt_newline")
    rt_emit_bytes(a, "\n")

    a.label("_rt_println_str")
    a.prologue(16)
    a.store(15, -8, 20) // fd
    // First write uses A0/A1 as-is (ptr, len).
    a.call("_rt_write")
    a.lea(18, "_rt_newline")
    a.vm_mov_imm(19, 1)
    a.load(20, 15, -8)
    a.call("_rt_write")
    a.epilogue()
    <<
}

// ===== rt_println_f64: A0 = f64 bits, A2 = fd =====
// Same format as bootstrap: int digits, optional .frac with trailing zeros trimmed.
fn rt_emit_println_f64(a &mut Assembler) {
    a.data_label("_rt_ftoa_buf")
    rt_emit_zeros(a, 64)
    a.data_label("_rt_f64_10")
    // 10.0 as little-endian f64: 0x4024000000000000
    rt_emit_u64(a, 4621819117588971520)

    a.label("_rt_println_f64")
    a.prologue(160)
    a.store(15, -8, 20) // fd
    a.mov(0, 18) // bits

    // sign
    a.vm_mov_imm(2, 0)
    a.vm_cmp_imm(0, 0)
    a.jge("_rt_pf_pos")
    a.vm_mov_imm(2, 1)
    a.vm_mov_imm64(1, 9223372036854775807) // 0x7fffffffffffffff
    a.iand(0, 0, 1)
    a.label("_rt_pf_pos")
    a.store(15, -16, 2)
    a.store(15, -24, 0)

    a.vm_sub_imm(3, 15, 128)
    a.load(1, 15, -16)
    a.vm_cbz(1, "_rt_pf_nosign")
    a.vm_mov_imm(2, 45)
    a.store_byte(3, 0, 2)
    a.vm_add_imm(3, 3, 1)
    a.label("_rt_pf_nosign")

    a.load(0, 15, -24)
    a.be_fcvtzs(1, 0)
    a.store(15, -32, 1)

    a.vm_sub_imm(4, 15, 88)
    a.mov(5, 4)
    a.vm_cmp_imm(1, 0)
    a.jne("_rt_pf_itoa")
    a.vm_mov_imm(2, 48)
    a.store_byte(3, 0, 2)
    a.vm_add_imm(3, 3, 1)
    a.jmp("_rt_pf_after_int")
    a.label("_rt_pf_itoa")
    // V6/V7 do not exist on x64. V0 is dead until the f64 value is reloaded
    // from [fp-24] below, so use it for the integer digit divisor.
    a.vm_mov_imm(0, 10)
    a.label("_rt_pf_itoa_loop")
    a.imod(2, 1, 0)
    a.div(1, 1, 0)
    a.vm_add_imm(2, 2, 48)
    a.vm_sub_imm(5, 5, 1)
    a.store_byte(5, 0, 2)
    a.vm_cmp_imm(1, 0)
    a.jne("_rt_pf_itoa_loop")
    a.label("_rt_pf_copy_int")
    a.cmp(5, 4)
    a.jeq("_rt_pf_after_int")
    a.load_byte(2, 5, 0)
    a.store_byte(3, 0, 2)
    a.vm_add_imm(3, 3, 1)
    a.vm_add_imm(5, 5, 1)
    a.jmp("_rt_pf_copy_int")
    a.label("_rt_pf_after_int")
    a.store(15, -40, 3)

    a.load(0, 15, -24)
    a.load(1, 15, -32)
    a.be_scvtf(2, 1)
    a.be_fsub(0, 0, 2)
    a.vm_cmp_imm(0, 0)
    a.jeq("_rt_pf_finish")

    a.load(3, 15, -40)
    a.vm_mov_imm(2, 46)
    a.store_byte(3, 0, 2)
    a.vm_add_imm(3, 3, 1)

    a.lea(5, "_rt_f64_10")
    a.load(5, 5, 0)

    // Keep the loop counter in V4 and spill the fractional-start pointer.
    // This keeps the helper inside the x64 V0-V5 register set.
    a.mov(4, 3)
    a.store(15, -48, 4)
    a.vm_mov_imm(4, 0)
    a.label("_rt_pf_frac")
    a.vm_cmp_imm(4, 6)
    a.jge("_rt_pf_frac_done")
    a.be_fmul(0, 0, 5)
    a.be_fcvtzs(1, 0)
    a.vm_add_imm(2, 1, 48)
    a.store_byte(3, 0, 2)
    a.vm_add_imm(3, 3, 1)
    a.be_scvtf(2, 1)
    a.be_fsub(0, 0, 2)
    a.vm_add_imm(4, 4, 1)
    a.vm_cmp_imm(0, 0)
    a.jeq("_rt_pf_frac_done")
    a.jmp("_rt_pf_frac")
    a.label("_rt_pf_frac_done")
    a.load(4, 15, -48)
    a.label("_rt_pf_trim")
    a.vm_sub_imm(1, 3, 1)
    a.cmp(1, 4)
    a.jlt("_rt_pf_trim_done")
    a.load_byte(2, 1, 0)
    a.vm_cmp_imm(2, 48)
    a.jne("_rt_pf_trim_done")
    a.mov(3, 1)
    a.jmp("_rt_pf_trim")
    a.label("_rt_pf_trim_done")
    a.cmp(3, 4)
    a.jne("_rt_pf_have_frac")
    a.vm_sub_imm(3, 3, 1)
    a.label("_rt_pf_have_frac")
    a.store(15, -40, 3)

    a.label("_rt_pf_finish")
    a.load(3, 15, -40)
    a.vm_mov_imm(2, 10)
    a.store_byte(3, 0, 2)
    a.vm_add_imm(3, 3, 1)
    a.vm_sub_imm(0, 15, 128)
    a.sub(1, 3, 0)
    a.mov(18, 0)
    a.mov(19, 1)
    a.load(20, 15, -8)
    a.call("_rt_write")
    a.epilogue()
    <<
}

// ===== Thumb-2 64-bit integer formatted output (Stage 2 / P4) =====

fn rt_emit_println_int_thumb64(a &mut Assembler) {
    a.label("_rt_println_int")
    // Push {r4, r5, r6, r7, r8, lr}
    a.t_emit32(0xE92D, 0x41F0)
    a.t_mov_reg(7, 13) // r7 = sp
    a.t_sub_sp(48)
    a.t_store_offset(2, 7, -8) // store fd at fp - 8
    a.t_mov_reg(4, 0) // r4 = val_lo
    a.t_mov_reg(5, 1) // r5 = val_hi
    a.t_subw(6, 7, 16) // r6 = fp - 16 (buffer end)
    a.t_sub_imm(6, 6, 1)
    a.t_mov_imm32(12, 10) // '\n'
    a.t_store_byte_offset(12, 6, 0)
    a.t_mov_imm32(8, 0) // r8 = sign flag (0 = positive)
    a.drop_seq += 1
    l_pos := "_rt_pi64_p_" + str(a.drop_seq)
    a.t_cmp_imm(5, 0)
    a.t_bge(str_clone(&l_pos))
    a.t_mov_imm32(8, 1)
    a.t_neg64_reg(4, 5, 4, 5)
    a.label(l_pos)

    l_loop := "_rt_pi64_l_" + str(a.drop_seq)
    a.label(str_clone(&l_loop))
    a.t_mov_reg(0, 4)
    a.t_mov_reg(1, 5)
    a.t_mov_imm32(2, 10)
    a.t_mov_imm32(3, 0)
    a.t_bl("_rt_aeabi_uldivmod")
    a.t_mov_reg(4, 0) // q_lo
    a.t_mov_reg(5, 1) // q_hi
    a.t_add_imm(2, 2, 48) // '0' + digit
    a.t_sub_imm(6, 6, 1)
    a.t_store_byte_offset(2, 6, 0)
    a.t_orr_reg(12, 4, 5)
    a.t_cmp_imm(12, 0)
    a.t_bne(l_loop)

    l_write := "_rt_pi64_w_" + str(a.drop_seq)
    a.t_cmp_imm(8, 0)
    a.t_beq(str_clone(&l_write))
    a.t_sub_imm(6, 6, 1)
    a.t_mov_imm32(12, 45) // '-'
    a.t_store_byte_offset(12, 6, 0)

    a.label(l_write)
    a.t_subw(1, 7, 16)
    a.t_sub_reg(1, 1, 6) // len = (fp - 16) - r6
    a.t_mov_reg(0, 6) // ptr
    a.t_load_offset(2, 7, -8) // fd
    a.t_bl("_rt_write")
    a.t_mov_reg(13, 7)
    a.t_emit32(0xE8BD, 0x81F0) // pop {r4, r5, r6, r7, r8, pc}
}

// ===== ARM EABI 64-bit runtime helpers (Pure-Xu, Cortex-M compatible) =====

fn rt_emit_aeabi_uldivmod(a &mut Assembler) {
    a.label("__aeabi_uldivmod")
    a.label("_rt_aeabi_uldivmod")
    a.t_orr_reg(12, 2, 3)
    a.t_cmp_imm(12, 0)
    a.t_beq("_rt_div_zero")

    // Fast path: 32-bit / 32-bit
    a.t_orr_reg(12, 1, 3)
    a.t_cmp_imm(12, 0)
    a.drop_seq += 1
    l_gen := "_rt_udiv_gen_" + str(a.drop_seq)
    a.t_bne(str_clone(&l_gen))
    a.t_udiv(12, 0, 2)
    a.t_mls(2, 12, 2, 0)
    a.t_mov_reg(0, 12)
    a.t_mov_imm32(1, 0)
    a.t_mov_imm32(3, 0)
    a.t_bx_lr()

    a.label(l_gen)
    l_not_less := "_rt_udiv_nl_" + str(a.drop_seq)
    l_zero_q := "_rt_udiv_zq_" + str(a.drop_seq)
    a.t_cmp_reg(1, 3)
    a.t_blo(str_clone(&l_zero_q))
    a.t_bhi(str_clone(&l_not_less))
    a.t_cmp_reg(0, 2)
    a.t_blo(str_clone(&l_zero_q))
    a.t_b(str_clone(&l_not_less))

    a.label(l_zero_q)
    a.t_mov_reg(2, 0)
    a.t_mov_reg(3, 1)
    a.t_mov_imm32(0, 0)
    a.t_mov_imm32(1, 0)
    a.t_bx_lr()

    a.label(l_not_less)
    l_not_eq := "_rt_udiv_ne_" + str(a.drop_seq)
    a.t_cmp_reg(1, 3)
    a.t_bne(str_clone(&l_not_eq))
    a.t_cmp_reg(0, 2)
    a.t_bne(str_clone(&l_not_eq))
    a.t_mov_imm32(0, 1)
    a.t_mov_imm32(1, 0)
    a.t_mov_imm32(2, 0)
    a.t_mov_imm32(3, 0)
    a.t_bx_lr()

    a.label(l_not_eq)
    // General restoring 64-bit division
    a.t_emit32(0xE92D, 0x43F0) // push {r4, r5, r6, r7, r8, r9, lr}
    a.t_mov_reg(4, 0)
    a.t_mov_reg(5, 1)
    a.t_mov_reg(6, 2)
    a.t_mov_reg(7, 3)
    a.t_mov_imm32(8, 0)
    a.t_mov_imm32(9, 0)
    a.t_mov_imm32(12, 64)

    l_loop := "_rt_udiv_lp_" + str(a.drop_seq)
    l_no_sub := "_rt_udiv_ns_" + str(a.drop_seq)
    l_do_sub := "_rt_udiv_ds_" + str(a.drop_seq)

    a.label(str_clone(&l_loop))
    a.t_emit16(0x0064) // lsls r4, r4, #1
    a.t_adcs_reg(5, 5, 5)
    a.t_adcs_reg(8, 8, 8)
    a.t_adcs_reg(9, 9, 9)

    a.t_cmp_reg(9, 7)
    a.t_blo(str_clone(&l_no_sub))
    a.t_bhi(str_clone(&l_do_sub))
    a.t_cmp_reg(8, 6)
    a.t_blo(str_clone(&l_no_sub))

    a.label(l_do_sub)
    a.t_subs_reg(8, 8, 6)
    a.t_sbc_reg(9, 9, 7)
    a.t16_add_imm8(4, 1) // adds r4, #1

    a.label(l_no_sub)
    a.t_emit32(0xF1BC, 0x0C01) // subs.w r12, r12, #1
    a.t_bne(l_loop)

    a.t_mov_reg(0, 4)
    a.t_mov_reg(1, 5)
    a.t_mov_reg(2, 8)
    a.t_mov_reg(3, 9)
    a.t_emit32(0xE8BD, 0x83F0) // pop {r4, r5, r6, r7, r8, r9, pc}
}

fn rt_emit_aeabi_ldivmod(a &mut Assembler) {
    a.label("__aeabi_ldivmod")
    a.label("_rt_aeabi_ldivmod")
    a.t_emit32(0xE92D, 0x4030) // push {r4, r5, lr}

    a.t_orr_reg(12, 2, 3)
    a.t_cmp_imm(12, 0)
    a.t_beq("_rt_div_zero")

    a.t_eor_reg(4, 1, 3)
    a.t_mov_reg(5, 1)

    a.drop_seq += 1
    l_n_pos := "_rt_sdiv_np_" + str(a.drop_seq)
    a.t_cmp_imm(1, 0)
    a.t_bge(str_clone(&l_n_pos))
    a.t_neg64_reg(0, 1, 0, 1)
    a.label(l_n_pos)

    l_d_pos := "_rt_sdiv_dp_" + str(a.drop_seq)
    a.t_cmp_imm(3, 0)
    a.t_bge(str_clone(&l_d_pos))
    a.t_neg64_reg(2, 3, 2, 3)
    a.label(l_d_pos)

    a.t_bl("_rt_aeabi_uldivmod")

    l_q_pos := "_rt_sdiv_qp_" + str(a.drop_seq)
    a.t_cmp_imm(4, 0)
    a.t_bge(str_clone(&l_q_pos))
    a.t_neg64_reg(0, 1, 0, 1)
    a.label(l_q_pos)

    l_r_pos := "_rt_sdiv_rp_" + str(a.drop_seq)
    a.t_cmp_imm(5, 0)
    a.t_bge(str_clone(&l_r_pos))
    a.t_neg64_reg(2, 3, 2, 3)
    a.label(l_r_pos)

    a.t_emit32(0xE8BD, 0x8030) // pop {r4, r5, pc}
}

fn rt_emit_aeabi_llsl(a &mut Assembler) {
    a.label("__aeabi_llsl")
    a.label("_rt_aeabi_llsl")
    a.drop_seq += 1
    l_done := "_rt_llsl_d_" + str(a.drop_seq)
    l_ge32 := "_rt_llsl_32_" + str(a.drop_seq)
    l_ge64 := "_rt_llsl_64_" + str(a.drop_seq)
    a.t_cmp_imm(2, 0)
    a.t_beq(str_clone(&l_done))
    a.t_cmp_imm(2, 32)
    a.t_bhs(str_clone(&l_ge32))
    a.t_mov_imm32(12, 32)
    a.t_sub_reg(3, 12, 2)
    a.t_lsr_reg(12, 0, 3)
    a.t_lsl_reg(1, 1, 2)
    a.t_orr_reg(1, 1, 12)
    a.t_lsl_reg(0, 0, 2)
    a.t_bx_lr()

    a.label(l_ge32)
    a.t_cmp_imm(2, 64)
    a.t_bhs(str_clone(&l_ge64))
    a.t_sub_imm(2, 2, 32)
    a.t_lsl_reg(1, 0, 2)
    a.t_mov_imm32(0, 0)
    a.t_bx_lr()

    a.label(l_ge64)
    a.t_mov_imm32(0, 0)
    a.t_mov_imm32(1, 0)
    a.label(l_done)
    a.t_bx_lr()
}

