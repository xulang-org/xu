@main

#xu/types

fn rt_exit(a &mut Assembler, code_imm int) {
    if a.cover {
        a.call("_rt_dump_cover")
    }
    a.vm_mov_imm(18, code_imm)
    a.vm_exit()
    <<
}

// ===== rt_write: A0 = ptr, A1 = len, A2 = fd =====
fn rt_emit_write(a &mut Assembler) {
    if a.os == 2 {
        // WoA: HANDLE / OUT DWORD slots must be naturally aligned.
        a.align_data(8)
        a.data_label("_rt_stdout")
        rt_emit_zeros(a, 8)
        a.data_label("_rt_stderr")
        rt_emit_zeros(a, 8)
        a.data_label("_rt_written")
        rt_emit_zeros(a, 8)
        a.data_label("_rt_conout")
        // CONOUT$ + NUL ($$ = literal $ in Xu strings)
        rt_emit_bytes(a, "CONOUT$$")
        a.emit_data([0])
        a.data_label("_rt_conerr")
        rt_emit_bytes(a, "CONERR$$")
        a.emit_data([0])
    }
    a.label("_rt_write")
    // Keep a 16-byte-aligned frame; slot for WriteFile's OUT DWORD at fp-32.
    a.prologue(48)
    a.store(15, -8, 18) // ptr
    a.store(15, -16, 19) // len
    a.store(15, -24, 20) // fd
    if a.os == 2 {
        // Windows: GetStdHandle, fallback CreateFileA("CONOUT$"/"CONERR$"), WriteFile.
        a.load(0, 15, -24)
        a.vm_cmp_imm(0, 2)
        a.jeq("_rt_ws_err_slot")
        a.lea(0, "_rt_stdout")
        a.jmp("_rt_ws_slot")
        a.label("_rt_ws_err_slot")
        a.lea(0, "_rt_stderr")
        a.label("_rt_ws_slot")
        a.load(0, 0, 0)
        a.vm_cbnz(0, "_rt_ws_have")
        a.load(0, 15, -24)
        a.mov(18, 0)
        a.neg(18, 18)
        a.vm_sub_imm(18, 18, 10) // 1->-11, 2->-12
        a.vm_call_iat("_iat_GetStdHandle")
        a.mov(0, 14)
        // Treat NULL / INVALID_HANDLE_VALUE (-1) as failure → CONOUT$/CONERR$.
        a.vm_cbz(0, "_rt_ws_open_con")
        a.vm_cmp_imm(0, -1)
        a.jeq("_rt_ws_open_con")
        a.jmp("_rt_ws_got_handle")
        a.label("_rt_ws_open_con")
        a.load(1, 15, -24)
        a.vm_cmp_imm(1, 2)
        a.jeq("_rt_ws_open_err")
        a.lea(18, "_rt_conout")
        a.jmp("_rt_ws_open")
        a.label("_rt_ws_open_err")
        a.lea(18, "_rt_conerr")
        a.label("_rt_ws_open")
        // CreateFileA(name, GENERIC_WRITE, SHARE_READ|SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL)
        a.vm_mov_imm64(19, rt_win_generic_write) // 0x40000000 GENERIC_WRITE
        a.vm_mov_imm(20, 3) // FILE_SHARE_READ|WRITE
        a.vm_mov_imm(21, 0)
        a.vm_mov_imm(22, 3) // OPEN_EXISTING
        a.vm_mov_imm(23, 0)
        a.vm_call_iat7("_iat_CreateFileA")
        a.mov(0, 14)
        a.label("_rt_ws_got_handle")
        a.load(1, 15, -24)
        a.vm_cmp_imm(1, 2)
        a.jeq("_rt_ws_store_err")
        a.lea(1, "_rt_stdout")
        a.jmp("_rt_ws_store")
        a.label("_rt_ws_store_err")
        a.lea(1, "_rt_stderr")
        a.label("_rt_ws_store")
        a.store(1, 0, 0)
        a.label("_rt_ws_have")
        a.mov(18, 0)
        a.load(19, 15, -8)
        a.load(20, 15, -16)
        // bytes-written OUT param on stack (fp-32), always aligned.
        a.mov(1, 15)
        a.vm_sub_imm(1, 1, 32)
        a.mov(21, 1)
        a.vm_mov_imm(22, 0)
        a.vm_call_iat("_iat_WriteFile")
    } else {
        if a.os == 3 {
            a.label("_rt_wr_loop")
            a.load(0, 15, -16)
            a.vm_cbz(0, "_rt_wr_done")
            a.load(1, 15, -8)
            a.load_byte(18, 1, 0)
            a.call("_xu_putc")
            a.load(1, 15, -8)
            a.vm_add_imm(1, 1, 1)
            a.store(15, -8, 1)
            a.load(0, 15, -16)
            a.vm_sub_imm(0, 0, 1)
            a.store(15, -16, 0)
            a.jmp("_rt_wr_loop")
            a.label("_rt_wr_done")
        } else {
            a.load(18, 15, -24) // fd
            a.load(19, 15, -8)
            a.load(20, 15, -16)
            a.vm_syscall(syscall_number(a.os, a.arch, 1))
        }
    }
    a.epilogue()
    <<
}

// ===== rt_println_int: A0 = value, A2 = fd =====
fn rt_emit_println_int(a &mut Assembler) {
    a.data_label("_rt_itoa_buf")
    rt_emit_zeros(a, 32)

    a.label("_rt_println_int")
    a.prologue(64)
    a.store(15, -8, 20) // fd
    // Stack-local digit buffer [fp-48, fp-16): a shared static would race
    // across concurrent goroutines (digits smashed mid-write).
    // V0 = write pointer (walks backwards from the buffer end)
    a.vm_sub_imm(0, 15, 16)
    // V1 = remaining value, V2 = sign flag
    a.mov(1, 18)
    a.vm_mov_imm(2, 0)
    a.vm_cmp_imm(1, 0)
    a.jge("_rt_pi_pos")
    // G7: do not negate (neg(INT_MIN) wraps); fold the sign per digit below.
    a.vm_mov_imm(2, 1)
    a.label("_rt_pi_pos")
    // Trailing newline first (highest address).
    a.vm_mov_imm(4, 10) // '\n'
    a.vm_sub_imm(0, 0, 1)
    a.store_byte(0, 0, 4)
    a.vm_mov_imm(3, 10)
    // Digit loop: store '0' + (value % 10), value /= 10, until value == 0.
    // Trunc division gives a negative remainder/quotient for negative
    // values (incl. INT_MIN, where neg would wrap); per digit, if the
    // remainder is negative, negate both the digit and the quotient.
    a.label("_rt_pi_loop")
    a.imod(4, 1, 3)
    a.div(1, 1, 3)
    a.vm_cmp_imm(4, 0)
    a.jge("_rt_pi_dig")
    a.neg(4, 4)
    a.neg(1, 1)
    a.label("_rt_pi_dig")
    a.vm_add_imm(4, 4, 48) // '0'
    a.vm_sub_imm(0, 0, 1)
    a.store_byte(0, 0, 4)
    a.vm_cmp_imm(1, 0)
    a.jne("_rt_pi_loop")
    // Optional '-'.
    a.vm_cbz(2, "_rt_pi_write")
    a.vm_sub_imm(0, 0, 1)
    a.vm_mov_imm(4, 45) // '-'
    a.store_byte(0, 0, 4)
    // write(fd, ptr, buf_end - ptr)
    a.label("_rt_pi_write")
    a.vm_sub_imm(5, 15, 16)
    a.sub(5, 5, 0)
    a.mov(18, 0)
    a.mov(19, 5)
    a.load(20, 15, -8)
    a.call("_rt_write")
    a.epilogue()
    <<
}

// ===== rt_println_bool: A0 = value, A2 = fd =====
fn rt_emit_println_bool(a &mut Assembler) {
    a.data_label("_rt_true")
    rt_emit_bytes(a, "true\n")
    a.data_label("_rt_false")
    rt_emit_bytes(a, "false\n")

    a.label("_rt_println_bool")
    a.prologue(16)
    a.store(15, -8, 20) // fd
    a.vm_cbz(18, "_rt_pb_false")
    a.lea(18, "_rt_true")
    a.vm_mov_imm(19, 5)
    a.load(20, 15, -8)
    a.call("_rt_write")
    a.jmp("_rt_pb_done")
    a.label("_rt_pb_false")
    a.lea(18, "_rt_false")
    a.vm_mov_imm(19, 6)
    a.load(20, 15, -8)
    a.call("_rt_write")
    a.label("_rt_pb_done")
    a.epilogue()
    <<
}

// ===== rt_println_str: A0 = ptr, A1 = len, A2 = fd =====
fn rt_emit_println_str(a &mut Assembler) {
    a.data_label("_rt_newline")
    rt_emit_bytes(a, "\n")

    a.label("_rt_println_str")
    a.prologue(16)
    a.store(15, -8, 20) // fd
    // First write uses A0/A1 as-is (ptr, len).
    a.call("_rt_write")
    a.lea(18, "_rt_newline")
    a.vm_mov_imm(19, 1)
    a.load(20, 15, -8)
    a.call("_rt_write")
    a.epilogue()
    <<
}

// ===== rt_println_f64: A0 = f64 bits, A2 = fd =====
// Same format as bootstrap: int digits, optional .frac with trailing zeros trimmed.
fn rt_emit_println_f64(a &mut Assembler) {
    a.data_label("_rt_ftoa_buf")
    rt_emit_zeros(a, 64)
    a.data_label("_rt_f64_10")
    // 10.0 as little-endian f64: 0x4024000000000000
    rt_emit_u64(a, 4621819117588971520)

    a.label("_rt_println_f64")
    a.prologue(160)
    a.store(15, -8, 20) // fd
    a.mov(0, 18) // bits

    // sign
    a.vm_mov_imm(2, 0)
    a.vm_cmp_imm(0, 0)
    a.jge("_rt_pf_pos")
    a.vm_mov_imm(2, 1)
    a.vm_mov_imm64(1, 9223372036854775807) // 0x7fffffffffffffff
    a.iand(0, 0, 1)
    a.label("_rt_pf_pos")
    a.store(15, -16, 2)
    a.store(15, -24, 0)

    a.vm_sub_imm(3, 15, 128)
    a.load(1, 15, -16)
    a.vm_cbz(1, "_rt_pf_nosign")
    a.vm_mov_imm(2, 45)
    a.store_byte(3, 0, 2)
    a.vm_add_imm(3, 3, 1)
    a.label("_rt_pf_nosign")

    a.load(0, 15, -24)
    a.be_fcvtzs(1, 0)
    a.store(15, -32, 1)

    a.vm_sub_imm(4, 15, 88)
    a.mov(5, 4)
    a.vm_cmp_imm(1, 0)
    a.jne("_rt_pf_itoa")
    a.vm_mov_imm(2, 48)
    a.store_byte(3, 0, 2)
    a.vm_add_imm(3, 3, 1)
    a.jmp("_rt_pf_after_int")
    a.label("_rt_pf_itoa")
    // V6/V7 do not exist on x64. V0 is dead until the f64 value is reloaded
    // from [fp-24] below, so use it for the integer digit divisor.
    a.vm_mov_imm(0, 10)
    a.label("_rt_pf_itoa_loop")
    a.imod(2, 1, 0)
    a.div(1, 1, 0)
    a.vm_add_imm(2, 2, 48)
    a.vm_sub_imm(5, 5, 1)
    a.store_byte(5, 0, 2)
    a.vm_cmp_imm(1, 0)
    a.jne("_rt_pf_itoa_loop")
    a.label("_rt_pf_copy_int")
    a.cmp(5, 4)
    a.jeq("_rt_pf_after_int")
    a.load_byte(2, 5, 0)
    a.store_byte(3, 0, 2)
    a.vm_add_imm(3, 3, 1)
    a.vm_add_imm(5, 5, 1)
    a.jmp("_rt_pf_copy_int")
    a.label("_rt_pf_after_int")
    a.store(15, -40, 3)

    a.load(0, 15, -24)
    a.load(1, 15, -32)
    a.be_scvtf(2, 1)
    a.be_fsub(0, 0, 2)
    a.vm_cmp_imm(0, 0)
    a.jeq("_rt_pf_finish")

    a.load(3, 15, -40)
    a.vm_mov_imm(2, 46)
    a.store_byte(3, 0, 2)
    a.vm_add_imm(3, 3, 1)

    a.lea(5, "_rt_f64_10")
    a.load(5, 5, 0)

    // Keep the loop counter in V4 and spill the fractional-start pointer.
    // This keeps the helper inside the x64 V0-V5 register set.
    a.mov(4, 3)
    a.store(15, -48, 4)
    a.vm_mov_imm(4, 0)
    a.label("_rt_pf_frac")
    a.vm_cmp_imm(4, 6)
    a.jge("_rt_pf_frac_done")
    a.be_fmul(0, 0, 5)
    a.be_fcvtzs(1, 0)
    a.vm_add_imm(2, 1, 48)
    a.store_byte(3, 0, 2)
    a.vm_add_imm(3, 3, 1)
    a.be_scvtf(2, 1)
    a.be_fsub(0, 0, 2)
    a.vm_add_imm(4, 4, 1)
    a.vm_cmp_imm(0, 0)
    a.jeq("_rt_pf_frac_done")
    a.jmp("_rt_pf_frac")
    a.label("_rt_pf_frac_done")
    a.load(4, 15, -48)
    a.label("_rt_pf_trim")
    a.vm_sub_imm(1, 3, 1)
    a.cmp(1, 4)
    a.jlt("_rt_pf_trim_done")
    a.load_byte(2, 1, 0)
    a.vm_cmp_imm(2, 48)
    a.jne("_rt_pf_trim_done")
    a.mov(3, 1)
    a.jmp("_rt_pf_trim")
    a.label("_rt_pf_trim_done")
    a.cmp(3, 4)
    a.jne("_rt_pf_have_frac")
    a.vm_sub_imm(3, 3, 1)
    a.label("_rt_pf_have_frac")
    a.store(15, -40, 3)

    a.label("_rt_pf_finish")
    a.load(3, 15, -40)
    a.vm_mov_imm(2, 10)
    a.store_byte(3, 0, 2)
    a.vm_add_imm(3, 3, 1)
    a.vm_sub_imm(0, 15, 128)
    a.sub(1, 3, 0)
    a.mov(18, 0)
    a.mov(19, 1)
    a.load(20, 15, -8)
    a.call("_rt_write")
    a.epilogue()
    <<
}
