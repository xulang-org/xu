@main

#os
#time

// Stable lock files avoid inode replacement races. Kernel locks are
// nonblocking and close-on-exec; failed downloads and killed compilers cannot
// strand ownership. A bounded wait reports contention or an OS open error.
fn require_guard(path &string, existing bool) os.File {
    require_no_link(path)
    started := now_ns()
    while true {
        file := os.open_lock(path + "", existing) or (err) {
            if now_ns() - started > REQUIRE_LOCK_TIMEOUT_NS {
                eprintln("require: cannot acquire dependency transaction lock " + path + ": " + err.msg())
                <<< 1
            }
            time.sleep(REQUIRE_LOCK_RETRY_NS)
            ->
        }
        << file
    }
    << os.closed_file()
}

fn require_cache_guard(root &string) os.File {
    parent := path_dirname(root)
    mkdir_all(parent)
    lock := root + ".lck"
    << require_guard(&lock, false)
}

fn require_project_guard(project &string) os.File {
    $keys := []string{}
    $vals := []string{}
    collect_direct_require_entries(project, $&keys, $&vals)
    if keys.len == 0 { << os.closed_file() }
    lock := project + "/.xu-deps.lck"
    if require_frozen() && !path_exists(&lock) { << os.closed_file() }
    << require_guard(&lock, require_frozen())
}
