@main

// Immediate readiness only: no socket mode change, worker wait, or fd_set
// limit. Platform pollfd layouts and event constants stay in the runtime.
fn rt_emit_socket_poll(a &mut Assembler) {
    a.label("_rt_socket_poll")
    a.prologue(96)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.vm_cmp_imm(18, 0)
    a.jlt("_rt_sp_bad")
    a.vm_cmp_imm(19, 1)
    a.jeq("_rt_sp_valid")
    a.vm_cmp_imm(19, 4)
    a.jne("_rt_sp_bad")
    a.label("_rt_sp_valid")
    a.vm_mov_imm(1, 0)
    for i in 0:40 { a.store_byte(15, -80 + i, 1) }
    if a.os == 2 {
        a.call("_rt_ws2_init")
        a.vm_cmp_imm(14, 0)
        a.jne("_rt_sp_bad")
        a.load(1, 15, -16)
        a.store(15, -48, 1) // SOCKET is pointer-sized; events at +8.
        a.load(1, 15, -24)
        a.vm_cmp_imm(1, 1)
        a.jne("_rt_sp_win_write")
        a.vm_mov_imm(1, 1)
        a.store_byte(15, -39, 1) // POLLRDNORM = 0x0100.
        a.jmp("_rt_sp_win_call")
        a.label("_rt_sp_win_write")
        a.vm_mov_imm(1, 16)
        a.store_byte(15, -40, 1) // POLLWRNORM = 0x0010.
        a.label("_rt_sp_win_call")
        a.mov(18, 15)
        a.vm_sub_imm(18, 18, 48)
        a.vm_mov_imm(19, 1)
        a.vm_mov_imm(20, 0)
        rt_ws2_call(a, 96)
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_sp_bad")
        a.load_byte(1, 15, -38)
        a.vm_mov_imm(2, 4)
        a.iand(1, 1, 2) // POLLNVAL
        a.vm_cbnz(1, "_rt_sp_bad")
    } else {
        a.load(1, 15, -16)
        for i in 0:4 {
            a.store_byte(15, -48 + i, 1)
            a.shr_imm(1, 1, 8)
        }
        a.load(1, 15, -24)
        a.store_byte(15, -44, 1) // pollfd events: POLLIN=1, POLLOUT=4.
        a.mov(18, 15)
        a.vm_sub_imm(18, 18, 48)
        a.vm_mov_imm(19, 1)
        if a.os == 0 {
            a.vm_mov_imm(20, 0)
            a.vm_syscall(33554662) // Darwin poll(2), verified by sys/syscall.h.
        } else {
            a.mov(20, 15)
            a.vm_sub_imm(20, 20, 80) // zero timespec, never an infinite wait.
            a.vm_mov_imm(21, 0)
            a.vm_mov_imm(22, 8)
            mut number := 73 // Linux generic ppoll.
            if a.arch == 1 { number = 271 }
            if a.arch == 2 { number = 336 }
            a.vm_syscall(number)
        }
        a.vm_normalize_syscall("_rt_sp_n")
        a.vm_cmp_imm(14, -4) // EINTR: let the caller retry on the next pass.
        a.jne("_rt_sp_result")
        a.vm_mov_imm(14, 0)
        a.label("_rt_sp_result")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_sp_bad")
        a.load_byte(1, 15, -42)
        a.vm_mov_imm(2, 32)
        a.iand(1, 1, 2) // POLLNVAL
        a.vm_cbnz(1, "_rt_sp_bad")
    }
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 14)
    a.epilogue()
    a.label("_rt_sp_bad")
    rt_call_throw_strerr_static(a, -8, "_rt_net_sock_msg", 17)
    a.epilogue()
}
