@main

fn (a &mut Assembler) be_cmp(x int, y int) {
    if a.arch == 1 {
        a.xbe_cmp(x, y)
    } else {
        if a.arch == 2 {
            a.tbe_cmp(x, y)
        } else if a.arch == 3 {
            a.rbe_cmp(x, y)
            } else if a.arch == 4 {
                a.lbe_cmp(x, y)
        } else if a.arch == 5 {
                a.vbe_cmp(x, y)
        } else {
            a.cmp_reg(map_reg(x), map_reg(y))
        }
    }
}

fn (a &mut Assembler) be_cmp_imm(x int, imm int) {
    if a.arch == 1 {
        a.xbe_cmp_imm(x, imm)
    } else {
        if a.arch == 2 {
            a.tbe_cmp_imm(x, imm)
        } else if a.arch == 3 {
            a.rbe_cmp_imm(x, imm)
            } else if a.arch == 4 {
                a.lbe_cmp_imm(x, imm)
        } else if a.arch == 5 {
                a.vbe_cmp_imm(x, imm)
        } else {
            a.cmp_imm(map_reg(x), imm)
        }
    }
}

fn (a &mut Assembler) be_cset(dest int, cond int) {
    // Keep the host ARM64 path as the first, explicit exit.  The hosted
    // Gen1 optimizer can mis-lower a long mutually-exclusive target chain
    // when the common case is the final `else`, sending an ARM64 build into
    // the RV64 arm by mistake under high register pressure.
    if a.arch == 0 {
        pr := map_reg(dest)
        a.cset(pr, cond)
        <<
    }
    if a.arch == 1 {
        a.xbe_cset(dest, cond)
    } else {
        if a.arch == 2 {
            a.tbe_cset(dest, cond)
        } else if a.arch == 3 {
            a.rbe_cset(dest, cond)
            } else if a.arch == 4 {
                a.lbe_cset(dest, cond)
        } else if a.arch == 5 {
                a.vbe_cset(dest, cond)
        }
    }
}

fn (a &mut Assembler) be_csel(dest int, yes int, no int, cond int) {
    if a.arch >= 2 { a.be_unsupported("csel") }
    if a.arch == 1 {
        a.xbe_csel(dest, yes, no, cond)
    } else if a.arch == 0 {
        a.csel(map_reg(dest), map_reg(yes), map_reg(no), cond)
    } else {
        // Only the hosted natural-loop tier calls this operation.
        a.mov(dest, yes)
    }
}

fn (a &mut Assembler) be_csinc(dest int, yes int, no int, cond int) {
    if a.arch >= 2 { a.be_unsupported("csinc") }
    if a.arch == 1 {
        a.xbe_csinc(dest, yes, no, cond)
    } else if a.arch == 0 {
        a.csinc(map_reg(dest), map_reg(yes), map_reg(no), cond)
    } else {
        a.mov(dest, yes)
    }
}

fn arm64_float_cond(cond int) int {
    // FCMP unordered flags are N=0,Z=0,C=1,V=1. Signed LT/LE
    // therefore accept NaN; MI/LS express ordered floating LT/LE.
    if cond == 11 { << 4 }
    if cond == 13 { << 9 }
    << cond
}

fn (a &mut Assembler) be_fcset(dest int, cond int) {
    if a.arch == 1 {
        a.xbe_fcset(dest, cond)
    } else if a.arch == 0 {
        a.be_cset(dest, arm64_float_cond(cond))
    } else {
        a.be_cset(dest, cond)
    }
}

fn (a &mut Assembler) be_jmp(label string) {
    mut tmp := []string{}
    tmp.push(label)
    if a.arch == 1 {
        a.xbe_jmp(tmp[0])
    } else {
        if a.arch == 2 {
            a.tbe_jmp(tmp[0])
        } else if a.arch == 3 {
            a.rbe_jmp(tmp[0])
            } else if a.arch == 4 {
                a.lbe_jmp(tmp[0])
        } else if a.arch == 5 {
                a.vbe_jmp(tmp[0])
        } else {
            a.b(tmp[0])
        }
    }
}


