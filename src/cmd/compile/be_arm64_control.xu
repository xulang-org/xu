fn (a &mut Assembler) be_cbz(reg int, label string) {
    mut tmp := []string{}
    tmp.push(label)
    if a.arch == 1 {
        a.xbe_cbz(reg, tmp[0])
    } else {
        if a.arch == 2 {
            a.tbe_cbz(reg, tmp[0])
        } else if a.arch == 3 {
            a.rbe_cbz(reg, tmp[0])
            } else if a.arch == 4 {
                a.lbe_cbz(reg, tmp[0])
        } else if a.arch == 5 {
                a.vbe_cbz(reg, tmp[0])
        } else {
            // Bind map_reg before tmp[0]: string index/move may clobber the
            // caller-saved home of the map_reg result under -O1.
            pr := map_reg(reg)
            a.cbz(pr, tmp[0])
        }
    }
}


fn (a &mut Assembler) be_cbnz(reg int, label string) {
    mut tmp := []string{}
    tmp.push(label)
    if a.arch == 1 {
        a.xbe_cbnz(reg, tmp[0])
    } else {
        if a.arch == 2 {
            a.tbe_cbnz(reg, tmp[0])
        } else if a.arch == 3 {
            a.rbe_cbnz(reg, tmp[0])
            } else if a.arch == 4 {
                a.lbe_cbnz(reg, tmp[0])
        } else if a.arch == 5 {
                a.vbe_cbnz(reg, tmp[0])
        } else {
            pr := map_reg(reg)
            a.cbnz(pr, tmp[0])
        }
    }
}


// ===== Function calls =====

fn (a &mut Assembler) be_prologue(frame_size int) {
    if a.arch == 1 {
        a.xbe_prologue(frame_size)
    } else {
        if a.arch == 2 {
            a.tbe_prologue(frame_size)
        } else if a.arch == 3 {
            a.rbe_prologue(frame_size)
            } else if a.arch == 4 {
                a.lbe_prologue(frame_size)
        } else if a.arch == 5 {
                a.vbe_prologue(frame_size)
        } else {
            // Save S0–S5 pairs (x19–x24) below the FP/LR link; count is a.cs_pairs.
            if a.cs_pairs >= 1 {
                a.stp_pre(19, 20, 31, -16)
            }
            if a.cs_pairs >= 2 {
                a.stp_pre(21, 22, 31, -16)
            }
            if a.cs_pairs >= 3 {
                a.stp_pre(23, 24, 31, -16)
            }
            a.stp_pre(29, 30, 31, -16)
            a.mov_reg(29, 31)
            if frame_size > 0 {
                if a.os == 2 && frame_size > 4096 {
                    mut left := frame_size
                    while left > 4096 {
                        a.sub_imm(31, 31, 4096)
                        // Touch the new page with XZR (not x0) so the probe
                        // does not depend on a live argument register.
                        a.str(31, 31, 0)
                        left = left - 4096
                    }
                    if left > 0 {
                        a.sub_imm(31, 31, left)
                    }
                } else {
                    a.sub_imm(31, 31, frame_size)
                }
            }
        }
    }
}

fn (a &mut Assembler) be_epilogue() {
    if a.arch == 1 {
        a.xbe_epilogue()
    } else {
        if a.arch == 2 {
            a.tbe_epilogue()
        } else if a.arch == 3 {
            a.rbe_epilogue()
            } else if a.arch == 4 {
                a.lbe_epilogue()
        } else if a.arch == 5 {
                a.vbe_epilogue()
        } else {
            a.mov_reg(31, 29)
            a.ldp_post(29, 30, 31, 16)
            if a.cs_pairs >= 3 {
                a.ldp_post(23, 24, 31, 16)
            }
            if a.cs_pairs >= 2 {
                a.ldp_post(21, 22, 31, 16)
            }
            if a.cs_pairs >= 1 {
                a.ldp_post(19, 20, 31, 16)
            }
            a.ret()
        }
    }
}

// Leaf helper: arm64 saves FP/LR only (no S0–S5). Body must use V0–V7
// and A0–A5; a.cs_pairs is ignored. Other arches keep the full frame.
fn (a &mut Assembler) be_prologue_leaf(frame_size int) {
    if a.arch == 0 {
        a.stp_pre(29, 30, 31, -16)
        a.mov_reg(29, 31)
        if frame_size > 0 {
            a.sub_imm(31, 31, frame_size)
        }
    } else if a.arch == 1 {
        a.xbe_prologue_leaf(frame_size)
    } else {
        a.be_prologue(frame_size)
    }
}

fn (a &mut Assembler) be_epilogue_leaf() {
    if a.arch == 0 {
        a.mov_reg(31, 29)
        a.ldp_post(29, 30, 31, 16)
        a.ret()
    } else if a.arch == 1 {
        a.xbe_epilogue_leaf()
    } else {
        a.be_epilogue()
    }
}

fn (a &mut Assembler) be_call(label string) {
    if a.arch == 1 {
        a.xbe_call(label)
        <<
    }
    if a.arch == 2 {
        a.tbe_call(label)
        <<
    }
    if a.arch == 3 {
        a.rbe_call(label)
        <<
    }
    if a.arch == 4 {
        a.lbe_call(label)
        <<
    }
    if a.arch == 5 {
        a.vbe_call(label)
        <<
    }
    a.bl(label)
}

// Reference-form call used when the label was produced by a helper returning
// an owning string. ARM64 keeps the reference all the way to the fixup sink;
// other targets receive an explicit owned copy through their existing
// dispatch path.
fn (a &mut Assembler) be_call_ref(label &string) {
    if a.arch == 0 {
        a.bl_ref(label)
        <<
    }
    owned := asm_string_copy(label)
    a.be_call(owned)
}

fn (a &mut Assembler) be_call_reg(target int) {
    if a.arch == 1 {
        a.x64_call_reg(x64_map_reg(target))
    } else {
        if a.arch == 2 {
            a.tbe_call_reg(target)
        } else if a.arch == 3 {
            a.rbe_call_reg(target)
            } else if a.arch == 4 {
                a.lbe_call_reg(target)
        } else if a.arch == 5 {
                a.vbe_call_reg(target)
        } else {
            a.blr(map_reg(target))
        }
    }
}


fn (a &mut Assembler) be_ret() {
    if a.arch == 1 {
        a.x64_ret()
    } else {
        if a.arch == 2 {
            a.tbe_ret()
        } else if a.arch == 3 {
            a.rbe_ret()
            } else if a.arch == 4 {
                a.lbe_ret()
        } else if a.arch == 5 {
                a.vbe_ret()
        } else {
            a.ret()
        }
    }
}

