@main

#xu/types

// Accelerate a prefix of a proved loop, then let the ordinary MIR emitter
// execute its final iteration. That iteration defines every live-out temp
// and preserves the existing branch, bounds-failure and spill contracts.
// Scratch: V0/V1, S4/S5, Ret, A0-A3 and xmm0-xmm2. Fixed GPR homes
// V2-V5 are untouched. RegCache/FP residency is deliberately excluded.

fn x64_loop_def(m &types.Mir, fi int, bi int, t int) int {
    if t < 0 { << -1 }
    mut found := -1
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_instr_def_m(m, fi, ii) == t {
            if found >= 0 { << -1 }
            found = ii
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << found
}

fn x64_loop_desc(m &types.Mir, fi int, t int) int {
    mut cur := t
    for _ in 0:8 {
        if cur < 0 || cur >= types.mir_local_operand_base { << cur }
        mut found := -1
        for bb in 0:types.mir_nblocks(m, fi) {
            d := x64_loop_def(m, fi, bb, cur)
            if d >= 0 {
                if found >= 0 { << -1 }
                found = d
            }
        }
        if found < 0 { << cur }
        k := types.mir_ikind(m, fi, found)
        if k == 2 { << types.mir_local_operand_base + types.mir_ib(m, fi, found) }
        if k != 1 { << cur }
        cur = types.mir_ib(m, fi, found)
    }
    << -1
}

fn x64_loop_array(m &types.Mir, fi int, base int, elem int) bool {
    if base < 0 { << false }
    ty := emit_index_base_ty(m, fi, base)
    inner := vreg_direct_ref_inner(ty)
    mut at := ty
    if inner >= 0 { at = inner }
    if !types.is_array_type(at) { << false }
    ai := at - 200
    if ai < 0 || ai >= m.arrays.len { << false }
    << m.arrays[ai].fixed_len == 0 && m.arrays[ai].elem_ty == elem
}

fn x64_loop_limit(m &types.Mir, fi int, bi int, cmp int, ind int, next int) VecPat {
    mut p := vec_none()
    if cmp < 0 || types.mir_ikind(m, fi, cmp) != 4 || types.mir_ib(m, fi, cmp) != 8 { << p }
    lhs := types.mir_ic(m, fi, cmp)
    mut ok := lhs == next
    if ind >= types.mir_local_operand_base { ok = vec_load_is_local(m, fi, bi, lhs, ind - types.mir_local_operand_base) }
    if !ok { << p }
    rhs := types.mir_id(m, fi, cmp)
    if vec_has_const(m, fi, rhs) {
        p.limit = vec_const(m, fi, rhs)
        if p.limit < 2 { << vec_none() }
    } else {
        p.limit_t = vec_trace(m, fi, bi, rhs)
        if p.limit_t < 0 { << vec_none() }
        if p.limit_t < types.mir_local_operand_base && x64_loop_def(m, fi, bi, p.limit_t) >= 0 { << vec_none() }
        if p.limit_t == ind { << vec_none() }
    }
    p.kind = 1
    << p
}

fn x64_loop_after(m &types.Mir, fi int, bi int, first int, last int) bool {
    mut seen := false
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if ii == last { << seen }
        if ii == first { seen = true }
        ii = types.mir_inext(m, fi, ii)
    }
    << false
}

fn match_x64_index_copy(m &types.Mir, fi int, bi int) VecPat {
    if types.mir_btkind(m, fi, bi) != 2 || types.mir_btb(m, fi, bi) != bi { << vec_none() }
    mut ld := -1
    mut st := -1
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == 14 {
            if ld >= 0 || types.mir_id(m, fi, ii) != 8 { << vec_none() }
            ld = ii
        } else if k == 20 {
            if ld < 0 || st >= 0 || types.mir_id(m, fi, ii) != 8 { << vec_none() }
            st = ii
        } else if k != 0 && k != 1 && k != 2 && k != 3 && k != 4 { << vec_none() }
        ii = types.mir_inext(m, fi, ii)
    }
    if ld < 0 || st < 0 { << vec_none() }
    idx := types.mir_ic(m, fi, ld)
    mut ind := idx
    loc := vec_local_of_temp(m, fi, bi, idx)
    if loc >= 0 { ind = types.mir_local_operand_base + loc }
    // Do not trace an SSA feedback Copy through its add: that would read
    // the last iteration's result before it is defined at loop entry.
    if ind < 0 { << vec_none() }
    if types.mir_ic(m, fi, st) != types.mir_ia(m, fi, ld) { << vec_none() }
    if ind >= types.mir_local_operand_base {
        if !vec_load_is_local(m, fi, bi, types.mir_ib(m, fi, st), loc) { << vec_none() }
    } else if types.mir_ib(m, fi, st) != idx { << vec_none() }
    mut add := -1
    mut update := -1
    cmp := x64_loop_def(m, fi, bi, types.mir_bta(m, fi, bi))
    if cmp < 0 { << vec_none() }
    ii = types.mir_bhead(m, fi, bi)
    mut after_store := false
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if ii == st { after_store = true }
        k := types.mir_ikind(m, fi, ii)
        if k == 4 && ii != cmp {
            if add >= 0 || types.mir_ib(m, fi, ii) != 1 { << vec_none() }
            c := types.mir_ic(m, fi, ii)
            d := types.mir_id(m, fi, ii)
            mut same := c == ind
            if loc >= 0 { same = vec_load_is_local(m, fi, bi, c, loc) }
            if !same || !vec_operand_is_one(m, fi, bi, d) || !after_store { << vec_none() }
            add = types.mir_ia(m, fi, ii)
        }
        if k == 3 || k == 1 {
            if update >= 0 || add < 0 || types.mir_ib(m, fi, ii) != add { << vec_none() }
            if k == 3 {
                if loc < 0 || types.mir_ia(m, fi, ii) != loc { << vec_none() }
            } else if loc >= 0 || types.mir_ia(m, fi, ii) != ind { << vec_none() }
            update = ii
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if add < 0 || update < 0 { << vec_none() }
    if loc >= 0 {
        lhs := x64_loop_def(m, fi, bi, types.mir_ic(m, fi, cmp))
        if !x64_loop_after(m, fi, bi, update, lhs) { << vec_none() }
    }
    mut p := x64_loop_limit(m, fi, bi, cmp, ind, add)
    if p.kind == 0 { << p }
    p.arr = x64_loop_desc(m, fi, types.mir_ib(m, fi, ld))
    p.fac = x64_loop_desc(m, fi, types.mir_ia(m, fi, st))
    if !x64_loop_array(m, fi, p.arr, 1) || !x64_loop_array(m, fi, p.fac, 1) { << vec_none() }
    // Descriptors and the dynamic limit must remain invariant in this body.
    if p.arr == ind || p.fac == ind { << vec_none() }
    p.ind = ind
    p.kind = 5
    << p
}

fn x64_loop_square(m &types.Mir, fi int, bi int, t int, off int, p &VecPat) bool {
    mul := x64_loop_def(m, fi, bi, t)
    if mul < 0 || types.mir_ikind(m, fi, mul) != 4 || types.mir_ib(m, fi, mul) != 3 { << false }
    v := types.mir_ic(m, fi, mul)
    if v < 0 || v != types.mir_id(m, fi, mul) || types.mir_temp_ty(m, fi, v) != 4 { << false }
    ld := x64_loop_def(m, fi, bi, v)
    if ld < 0 || types.mir_ikind(m, fi, ld) != 26 || types.mir_ic(m, fi, ld) != off || types.mir_id(m, fi, ld) != 1 { << false }
    ea := x64_loop_def(m, fi, bi, types.mir_ib(m, fi, ld))
    if ea < 0 || types.mir_ikind(m, fi, ea) != 23 || types.mir_id(m, fi, ea) != 24 { << false }
    if x64_loop_desc(m, fi, types.mir_ib(m, fi, ea)) != p.arr { << false }
    << vec_load_is_local(m, fi, bi, types.mir_ic(m, fi, ea), p.ind - types.mir_local_operand_base)
}

fn x64_loop_norm_sum(m &types.Mir, fi int, bi int, t int, p &VecPat) bool {
    yz := x64_loop_def(m, fi, bi, t)
    if yz < 0 || types.mir_ikind(m, fi, yz) != 4 || types.mir_ib(m, fi, yz) != 1 { << false }
    xy := x64_loop_def(m, fi, bi, types.mir_ic(m, fi, yz))
    if xy < 0 || types.mir_ikind(m, fi, xy) != 4 || types.mir_ib(m, fi, xy) != 1 { << false }
    << x64_loop_square(m, fi, bi, types.mir_ic(m, fi, xy), 0, p) && x64_loop_square(m, fi, bi, types.mir_id(m, fi, xy), 8, p) && x64_loop_square(m, fi, bi, types.mir_id(m, fi, yz), 16, p)
}

fn match_x64_norm(m &types.Mir, fi int, bi int) VecPat {
    if types.mir_btkind(m, fi, bi) != 2 || types.mir_btb(m, fi, bi) != bi { << vec_none() }
    mut p := match_vec3_sqnorm(m, fi, bi)
    if p.kind != 6 || p.ind < types.mir_local_operand_base || p.acc < types.mir_local_operand_base { << vec_none() }
    if p.acc == p.ind { << vec_none() }
    p.arr = x64_loop_desc(m, fi, p.arr)
    if p.arr < 0 { << vec_none() }
    aty := emit_index_base_ty(m, fi, p.arr)
    if !types.is_array_type(aty) || emit_base_fixed_len(m, fi, p.arr) != 0 { << vec_none() }
    mut bins := 0
    mut eas := 0
    mut loads := 0
    mut stores := 0
    mut sum := -1
    mut next := -1
    mut update := -1
    cmp := x64_loop_def(m, fi, bi, types.mir_bta(m, fi, bi))
    if cmp < 0 { << vec_none() }
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == 4 { bins += 1 }
        else if k == 23 { eas += 1 }
        else if k == 26 { loads += 1 }
        else if k == 3 {
            stores += 1
            l := types.mir_ia(m, fi, ii)
            if l == p.acc - types.mir_local_operand_base {
                if sum >= 0 || next >= 0 { << vec_none() }
                sum = types.mir_ib(m, fi, ii)
            } else if l == p.ind - types.mir_local_operand_base {
                if next >= 0 || sum < 0 { << vec_none() }
                next = types.mir_ib(m, fi, ii)
                update = ii
            } else { << vec_none() }
        } else if k != 0 && k != 2 { << vec_none() }
        ii = types.mir_inext(m, fi, ii)
    }
    if bins != 8 || eas != 3 || loads != 3 || stores != 2 || sum < 0 || next < 0 { << vec_none() }
    root := x64_loop_def(m, fi, bi, sum)
    if root < 0 || types.mir_ikind(m, fi, root) != 4 || types.mir_ib(m, fi, root) != 1 { << vec_none() }
    if !vec_load_is_local(m, fi, bi, types.mir_ic(m, fi, root), p.acc - types.mir_local_operand_base) { << vec_none() }
    if !x64_loop_norm_sum(m, fi, bi, types.mir_id(m, fi, root), &p) { << vec_none() }
    if !vec_is_add1_of(m, fi, bi, next, p.ind) { << vec_none() }
    lhs := x64_loop_def(m, fi, bi, types.mir_ic(m, fi, cmp))
    if !x64_loop_after(m, fi, bi, update, lhs) { << vec_none() }
    lim := x64_loop_limit(m, fi, bi, cmp, p.ind, next)
    if lim.kind == 0 || lim.limit_t == p.acc { << vec_none() }
    p.limit = lim.limit
    p.limit_t = lim.limit_t
    << p
}

fn x64_loop_load(a &mut Assembler, m &types.Mir, fi int, fr &Frame, v int, dest int) {
    if v >= types.mir_local_operand_base { a.load(dest, 15, slot_off(fr.local_slot[v - types.mir_local_operand_base])) }
    else { emit_load_value(a, m, fi, fr, v, dest) }
}

fn x64_loop_store_ind(a &mut Assembler, m &types.Mir, fi int, fr &Frame, v int) {
    if v >= types.mir_local_operand_base { a.store(15, slot_off(fr.local_slot[v - types.mir_local_operand_base]), 18) }
    else { emit_store_scalar_temp(a, m, fi, fr, v, 18) }
}

fn emit_x64_loop_prefix(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int) {
    if a.rc_on || a.rc_fp_only || types.mir_nins(m, fi) > 4096 { << }
    mut p := match_x64_index_copy(m, fi, bi)
    if p.kind == 0 { p = match_x64_norm(m, fi, bi) }
    if p.kind == 0 { emit_x64_madd_prefix(a, m, fi, fr, bi)
        emit_x64_iand_prefix(a, m, fi, fr, bi)
        emit_x64_byte_sum_prefix(a, m, fi, fr, bi)
        << }
    for t in 0:fr.temp_slot.len {
        if is_vreg_slot(fr.temp_slot[t]) {
            h := vreg_slot_home(fr.temp_slot[t])
            if (h < 2 || h > 5) && h != 9 { << }
        }
    }
    if p.kind == 6 {
        for t in 0:fr.temp_slot.len { if is_fp_vreg_slot(fr.temp_slot[t]) { << } }
    }
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi) + "_x64_prefix"
    done := pref + "_scalar"
    x64_loop_load(a, m, fi, fr, p.ind, 18)
    if p.limit_t >= 0 { x64_loop_load(a, m, fi, fr, p.limit_t, 19) }
    else { a.vm_mov_imm64(19, p.limit) }
    a.vm_cmp_imm(18, 0)
    a.jlt(done + "")
    a.cmp(18, 19)
    a.jge(done + "")
    // Failed span/alias guards fall through to the original scalar loop.
    emit_index_desc_addr(a, m, fi, fr, p.arr)
    a.load(0, 0, -8)
    a.cmp(0, 19)
    a.jlt(done + "")
    emit_index_desc_addr(a, m, fi, fr, p.arr)
    a.load(21, 0, 0)
    if p.kind == 5 {
        a.vm_mov_imm64(0, 1152921504606846975)
        a.cmp(19, 0)
        a.jgt(done + "")
        emit_index_desc_addr(a, m, fi, fr, p.fac)
        a.load(0, 0, -8)
        a.cmp(0, 19)
        a.jlt(done + "")
        emit_index_desc_addr(a, m, fi, fr, p.fac)
        a.load(20, 0, 0)
        // Disjoint full spans or identical pointers only. A shifted alias
        // keeps sequential read-after-write behavior on the scalar path.
        a.cmp(20, 21)
        a.jeq(pref + "_copy")
        a.shl_imm(0, 19, 3)
        a.add(1, 21, 0)
        a.cmp(1, 21)
        a.x64_jcc(2, done + "")
        a.cmp(20, 1)
        a.jae(pref + "_copy")
        a.add(1, 20, 0)
        a.cmp(1, 20)
        a.x64_jcc(2, done + "")
        a.cmp(21, 1)
        a.jae(pref + "_copy")
        a.jmp(done + "")
        a.label(pref + "_copy")
        a.shl_imm(0, 18, 3)
        a.add(21, 21, 0)
        a.add(20, 20, 0)
        // At least one scalar iteration remains for all MIR live-outs.
        a.vm_sub_imm(19, 19, 8)
        a.label(pref + "_wide")
        a.cmp(18, 19)
        a.jge(pref + "_saved")
        for off in 0:4 {
            a.x64_movdqu_load(0, x64_map_reg(21), off * 16)
            a.x64_movdqu_store(x64_map_reg(20), off * 16, 0)
        }
        a.vm_add_imm(21, 21, 64)
        a.vm_add_imm(20, 20, 64)
        a.vm_add_imm(18, 18, 8)
        a.jmp(pref + "_wide")
    } else {
        a.shl_imm(0, 18, 3)
        a.add(21, 21, 0)
        a.shl_imm(0, 18, 4)
        a.add(21, 21, 0)
        a.x64_movsd_load(0, 5, slot_off(fr.local_slot[p.acc - types.mir_local_operand_base]))
        a.vm_sub_imm(19, 19, 1)
        a.label(pref + "_ordered")
        a.cmp(18, 19)
        a.jge(pref + "_saved")
        a.x64_movsd_load(1, x64_map_reg(21), 0)
        a.x64_mulsd(1, 1)
        a.x64_movsd_load(2, x64_map_reg(21), 8)
        a.x64_mulsd(2, 2)
        a.x64_addsd(1, 2)
        a.x64_movsd_load(2, x64_map_reg(21), 16)
        a.x64_mulsd(2, 2)
        a.x64_addsd(1, 2)
        a.x64_addsd(0, 1)
        a.vm_add_imm(21, 21, 24)
        a.vm_add_imm(18, 18, 1)
        a.jmp(pref + "_ordered")
    }
    a.label(pref + "_saved")
    if p.kind == 6 { a.x64_movsd_store(5, slot_off(fr.local_slot[p.acc - types.mir_local_operand_base]), 0) }
    x64_loop_store_ind(a, m, fi, fr, p.ind)
    a.label(done)
}
