@main
// PE32+ (64-bit Windows) executable generator (M12).
// Ported from bootstrap/crates/xubin/src/pe.rs.
//
// Assembler emits `_iat_<Name>` slots in the data stream. generate() rebuilds
// the data section in lld order:
//   [data before IAT] [IDT][ILT][IAT][hint names][dll] [data after IAT]
// and rewrites code references from the old slot addresses to the new IAT.
// IAT-before-IDT without a null terminator made WoA report 0xC000007B.
// `--shared` / extra user DLLs: generate_dynamic in pe_dyn.xu (IMAGE_FILE_DLL
// + export `_xu_*` + grouped IDT). Static EXE layout stays when dll_id/ext_dlls
// are empty.

struct Pe64 {
    base_addr int
    machine   int
    dll_id    string
    exp_name  []string
    exp_off   []int
    ext_dlls  []string
    ext_sym   []string
    ext_sym_dll []int
}

fn new_pe64() Pe64 {
    // 0x140000000, IMAGE_FILE_MACHINE_AMD64 = 0x8664
    << Pe64{base_addr: PE_IMAGE_BASE, machine: COFF_MACHINE_AMD64, dll_id: "", exp_name: []string{}, exp_off: []int{}, ext_dlls: []string{}, ext_sym: []string{}, ext_sym_dll: []int{}}
}

fn new_pe64_arm64() Pe64 {
    // IMAGE_FILE_MACHINE_ARM64 = 0xAA64
    << Pe64{base_addr: PE_IMAGE_BASE, machine: COFF_MACHINE_ARM64, dll_id: "", exp_name: []string{}, exp_off: []int{}, ext_dlls: []string{}, ext_sym: []string{}, ext_sym_dll: []int{}}
}

fn pe_set_shared(p Pe64, a &Assembler, install string) Pe64 {
    mut o := p
    o.dll_id = install + ""
    for i in 0:a.lib_exp_name.len {
        o.exp_name.push(a.lib_exp_name[i] + "")
        o.exp_off.push(a.lib_exp_off[i])
    }
    << o
}

fn pe_apply_dlls(p Pe64, a &Assembler) Pe64 {
    mut o := p
    for i in 0:a.dylib_paths.len {
        o.ext_dlls.push(a.dylib_paths[i] + "")
    }
    for i in 0:a.dylib_labs.len {
        o.ext_sym.push(a.dylib_labs[i] + "")
        mut di := 0
        if i < a.dylib_ords.len && a.dylib_ords[i] >= 2 {
            di = a.dylib_ords[i] - 2
        }
        o.ext_sym_dll.push(di)
    }
    << o
}

fn (p Pe64) code_vaddr() int { << p.base_addr + PE_SECTION_ALIGNMENT }

fn (p Pe64) data_vaddr(code_size int) int {
    << p.base_addr + PE_SECTION_ALIGNMENT + ((code_size + (PE_SECTION_ALIGNMENT - 1)) / PE_SECTION_ALIGNMENT) * PE_SECTION_ALIGNMENT
}

fn pe_iat_name(n string) string {
    mut nm := ""
    for ci in 5:n.len {
        nm = nm + string_from_bytes([n[ci]])
    }
    << nm
}

// Collect `_iat_*` data labels sorted by ascending data offset.
fn pe_collect_imports(a &Assembler, names &mut []string, offsets &mut []int) {
    for i in 0:a.labels.len {
        if !a.labels[i].is_data { -> }
        n := a.labels[i].name
        if n.len <= 5 { -> }
        if n[0] != 95 || n[1] != 105 || n[2] != 97 || n[3] != 116 || n[4] != 95 {
            ->
        }
        names.push(pe_iat_name(n))
        offsets.push(a.labels[i].offset)
    }
    // bubble-sort by offset (keep names aligned)
    mut i := 0
    while i < offsets.len {
        mut j := i + 1
        while j < offsets.len {
            if offsets[j] < offsets[i] {
                tmp_o := offsets[i]
                offsets[i] = offsets[j]
                offsets[j] = tmp_o
                tmp_n := names[i]
                names[i] = names[j]
                names[j] = tmp_n
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn pe_remap_find(old_addrs &[]int, new_addrs &[]int, target int) int {
    for i in 0:old_addrs.len {
        if old_addrs[i] == target {
            << new_addrs[i]
        }
    }
    << (0 - 1)
}

fn pe_patch_arm64_adrp_add(code &mut []int, code_base int, old_addrs &[]int, new_addrs &[]int) {
    mut i := 0
    while i + 8 <= code.len {
        w0 := code[i] | (code[i + 1] << 8) | (code[i + 2] << 16) | (code[i + 3] << 24)
        w1 := code[i + 4] | (code[i + 5] << 8) | (code[i + 6] << 16) | (code[i + 7] << 24)
        if (w0 & 2667577344) == 2415919104 && (w1 & 4290772992) == 2432696320 {
            // ADRP mask 0x9F000000 == 0x90000000; ADD imm mask 0xFFC00000 == 0x91000000
            rd0 := w0 & 31
            rd1 := w1 & 31
            rn1 := (w1 >> 5) & 31
            if rd0 == rd1 && rd0 == rn1 {
                immlo := (w0 >> 29) & 3
                immhi := (w0 >> 5) & 524287
                mut imm21 := (immhi << 2) | immlo
                // sign-extend 21-bit
                if (imm21 & 1048576) != 0 {
                    imm21 = imm21 | (0 - 2097152)
                }
                pc := code_base + i
                page := pc & (0 - 4096)
                target_page := page + (imm21 << 12)
                imm12 := (w1 >> 10) & 4095
                target := target_page + imm12
                neu := pe_remap_find(old_addrs, new_addrs, target)
                if neu >= 0 {
                    new_page := neu & (0 - 4096)
                    page_delta := (new_page - page) / 4096
                    n_immlo := page_delta & 3
                    n_immhi := (page_delta >> 2) & 524287
                    adrp := 2415919104 | (n_immlo << 29) | (n_immhi << 5) | rd0
                    add := 2432696320 | ((neu & 4095) << 10) | (rd0 << 5) | rd0
                    code[i] = adrp & 255
                    code[i + 1] = (adrp >> 8) & 255
                    code[i + 2] = (adrp >> 16) & 255
                    code[i + 3] = (adrp >> 24) & 255
                    code[i + 4] = add & 255
                    code[i + 5] = (add >> 8) & 255
                    code[i + 6] = (add >> 16) & 255
                    code[i + 7] = (add >> 24) & 255
                }
            }
        }
        i = i + 4
    }
}

fn pe_x64_rip_disp_at(code &mut []int, i int) int {
    if i + 1 >= code.len {
        << (0 - 1)
    }
    mut p := i
    b0 := code[i]
    if b0 >= 64 && b0 <= 79 {
        p = i + 1
        if p >= code.len {
            << (0 - 1)
        }
    }
    if p + 1 < code.len && code[p] == 255 && code[p + 1] == 21 {
        << p + 2
    }
    if p + 2 < code.len && (code[p] == 139 || code[p] == 141) && (code[p + 1] & 199) == 5 {
        << p + 2
    }
    << (0 - 1)
}

fn pe_patch_x64_rip32(code &mut []int, code_base int, old_addrs &[]int, new_addrs &[]int) {
    mut i := 0
    while i + 6 <= code.len {
        disp_at := pe_x64_rip_disp_at(code, i)
        if disp_at >= 0 && disp_at + 4 <= code.len {
            mut disp := code[disp_at] | (code[disp_at + 1] << 8) | (code[disp_at + 2] << 16) | (code[disp_at + 3] << 24)
            // interpret as signed i32
            if (disp & 2147483648) != 0 {
                disp = disp | (0 - 4294967296)
            }
            next := code_base + disp_at + 4
            target := next + disp
            neu := pe_remap_find(old_addrs, new_addrs, target)
            if neu >= 0 {
                new_disp := neu - next
                code[disp_at] = new_disp & 255
                code[disp_at + 1] = (new_disp >> 8) & 255
                code[disp_at + 2] = (new_disp >> 16) & 255
                code[disp_at + 3] = (new_disp >> 24) & 255
            }
            i = disp_at + 4
            ->
        }
        i = i + 1
    }
}

fn (p Pe64) generate(a &Assembler, start_offset int, buf &mut []int) {
    if p.dll_id.len > 0 || p.ext_dlls.len > 0 {
        p.generate_dynamic(a, start_offset, buf)
        <<
    }
    mut out := []int{}
    mut import_names := []string{}
    mut import_offs := []int{}
    pe_collect_imports(a, mut &import_names, mut &import_offs)

    n_imports := import_names.len
    mut iat_data_offset := 0
    if import_offs.len > 0 {
        iat_data_offset = import_offs[0]
    }

    dos_header_size := PE_DOS_HEADER_BYTES
    coff_header_size := PE_COFF_HEADER_BYTES
    optional_header_size := PE64_OPTIONAL_HEADER_BYTES // 112 + 16*8
    section_header_size := PE_SECTION_HEADER_BYTES
    num_sections := 2
    file_align := PE_FILE_ALIGNMENT
    section_align := PE_SECTION_ALIGNMENT

    headers_size := dos_header_size + PE_SIGNATURE_BYTES + coff_header_size + optional_header_size + num_sections * section_header_size
    mut text_raw_offset := ((headers_size + file_align - 1) / file_align) * file_align
    if text_raw_offset < PE_MIN_HEADER_BYTES {
        text_raw_offset = PE_MIN_HEADER_BYTES // ≥0x400 like lld
    }
    text_rva := section_align
    text_size := a.code.len
    text_raw_size := ((text_size + file_align - 1) / file_align) * file_align
    text_virtual_size := ((text_size + section_align - 1) / section_align) * section_align

    iat_region_len := (n_imports + 1) * 8
    iat_off := iat_data_offset
    iat_end := iat_data_offset + iat_region_len
    mut prefix_len := iat_off
    if prefix_len > a.data.len {
        prefix_len = a.data.len
    }
    mut suffix_start := iat_end
    if suffix_start > a.data.len {
        suffix_start = a.data.len
    }

    idt_size := 40 // 2*20
    ilt_offset := idt_size
    ilt_size := iat_region_len
    iat_offset := ilt_offset + ilt_size
    hint_name_offset := iat_offset + iat_region_len
    mut hint_name_cursor := hint_name_offset
    mut hint_rvas := []int{}
    for i in 0:import_names.len {
        hint_rvas.push(hint_name_cursor)
        mut entry_size := 2 + import_names[i].len + 1
        if entry_size % 2 != 0 {
            entry_size = entry_size + 1
        }
        hint_name_cursor = hint_name_cursor + entry_size
    }
    dll_name_offset := hint_name_cursor
    dll_name := "kernel32.dll"
    import_blob_size := dll_name_offset + dll_name.len + 1

    data_raw_offset := text_raw_offset + text_raw_size
    data_rva := text_rva + text_virtual_size
    suffix_len := a.data.len - suffix_start
    combined_size := prefix_len + import_blob_size + suffix_len
    mut data_raw_size := 0
    if combined_size > 0 {
        data_raw_size = ((combined_size + file_align - 1) / file_align) * file_align
    }
    mut data_virtual_size := section_align
    if combined_size > 0 {
        data_virtual_size = ((combined_size + section_align - 1) / section_align) * section_align
    }

    import_rva := data_rva + prefix_len
    iat_rva := import_rva + iat_offset
    old_iat_rva := data_rva + iat_data_offset
    image_size := data_rva + data_virtual_size
    entry_rva := text_rva + start_offset

    mut import_only := 0
    if prefix_len == 0 && suffix_len == 0 {
        import_only = 1
    }
    mut data_chars := PE_SECTION_RW_FLAGS // INIT|READ|WRITE
    mut data_sec_name := ".data"
    if import_only == 1 {
        data_chars = PE_SECTION_RO_FLAGS // INIT|READ = 0x40000040
        data_sec_name = ".rdata"
    }

    // ===== DOS header =====
    out.push(77) // M
    out.push(90) // Z
    write16(mut &out, 144)
    write16(mut &out, 3)
    write16(mut &out, 0)
    write16(mut &out, 4)
    write16(mut &out, 0)
    write16(mut &out, 65535)
    write16(mut &out, 0)
    write16(mut &out, 184)
    write16(mut &out, 0)
    write16(mut &out, 0)
    write16(mut &out, 0)
    write16(mut &out, 64)
    write16(mut &out, 0)
    for i in 0:4 {
        write16(mut &out, 0)
    }
    write16(mut &out, 0)
    write16(mut &out, 0)
    for i in 0:10 {
        write16(mut &out, 0)
    }
    write32(mut &out, dos_header_size) // e_lfanew

    // ===== PE signature + COFF =====
    out.push(80)
    out.push(69)
    out.push(0)
    out.push(0)
    write16(mut &out, p.machine)
    write16(mut &out, num_sections)
    write32(mut &out, 0)
    write32(mut &out, 0)
    write32(mut &out, 0)
    write16(mut &out, optional_header_size)
    write16(mut &out, 34) // EXECUTABLE | LARGE_ADDRESS_AWARE

    // ===== Optional header PE32+ =====
    write16(mut &out, 523) // 0x20B
    out.push(14)
    out.push(0)
    write32(mut &out, text_raw_size) // SizeOfCode
    write32(mut &out, data_raw_size) // SizeOfInitializedData
    write32(mut &out, 0)
    write32(mut &out, entry_rva)
    write32(mut &out, text_rva)
    write64(mut &out, p.base_addr)
    write32(mut &out, section_align)
    write32(mut &out, file_align)
    write16(mut &out, 6) // MajorOperatingSystemVersion (match lld)
    write16(mut &out, 0)
    write16(mut &out, 0)
    write16(mut &out, 0)
    write16(mut &out, 6) // MajorSubsystemVersion
    write16(mut &out, 0)
    write32(mut &out, 0)
    write32(mut &out, image_size)
    write32(mut &out, text_raw_offset) // SizeOfHeaders
    write32(mut &out, 0)
    write16(mut &out, PE_CONSOLE_SUBSYSTEM) // IMAGE_SUBSYSTEM_CONSOLE
    // HIGH_ENTROPY_VA|DYNAMIC_BASE|NX_COMPAT|TERMINAL_SERVER_AWARE = 0x8160
    write16(mut &out, PE_DLL_CHARACTERISTICS)
    // Compiler frames (build_parser / main CLI) exceed the 1MB MSVC default.
    // Commit several MB up front: a single `sub rsp, 169KB` skips the 4KB
    // guard page and ACCESS_VIOLATIONs before temp error can be printed.
    write64(mut &out, PE_STACK_RESERVE_BYTES) // SizeOfStackReserve 16MB
    write64(mut &out, PE_STACK_COMMIT_BYTES) // SizeOfStackCommit 4MB
    write64(mut &out, PE_HEAP_RESERVE_BYTES)
    write64(mut &out, PE_HEAP_COMMIT_BYTES)
    write32(mut &out, 0)
    write32(mut &out, PE_DATA_DIRECTORY_COUNT) // NumberOfRvaAndSizes

    // Data directories: [1] import, [12] IAT
    write32(mut &out, 0)
    write32(mut &out, 0)
    write32(mut &out, import_rva)
    write32(mut &out, idt_size)
    for i in 2:12 {
        write32(mut &out, 0)
        write32(mut &out, 0)
    }
    write32(mut &out, iat_rva)
    write32(mut &out, iat_region_len)
    for i in 13:16 {
        write32(mut &out, 0)
        write32(mut &out, 0)
    }

    // ===== Section headers =====
    write_str(mut &out, ".text", 8)
    write32(mut &out, text_size)
    write32(mut &out, text_rva)
    write32(mut &out, text_raw_size)
    write32(mut &out, text_raw_offset)
    write32(mut &out, 0)
    write32(mut &out, 0)
    write16(mut &out, 0)
    write16(mut &out, 0)
    write32(mut &out, PE_SECTION_CODE_FLAGS) // CODE|EXECUTE|READ = 0x60000020

    write_str(mut &out, data_sec_name, 8)
    write32(mut &out, combined_size)
    write32(mut &out, data_rva)
    write32(mut &out, data_raw_size)
    write32(mut &out, data_raw_offset)
    write32(mut &out, 0)
    write32(mut &out, 0)
    write16(mut &out, 0)
    write16(mut &out, 0)
    write32(mut &out, data_chars)

    // ===== Import blob: IDT → ILT → IAT → hints → dll =====
    mut idata := []int{}
    write32(mut &idata, import_rva + ilt_offset)
    write32(mut &idata, 0)
    write32(mut &idata, 0)
    write32(mut &idata, import_rva + dll_name_offset)
    write32(mut &idata, iat_rva)
    for i in 0:5 {
        write32(mut &idata, 0)
    }
    for i in 0:hint_rvas.len {
        write64(mut &idata, import_rva + hint_rvas[i])
    }
    write64(mut &idata, 0)
    for i in 0:hint_rvas.len {
        write64(mut &idata, import_rva + hint_rvas[i])
    }
    write64(mut &idata, 0)
    for i in 0:import_names.len {
        write16(mut &idata, 0)
        for ci in 0:import_names[i].len {
            idata.push(import_names[i][ci])
        }
        idata.push(0)
        if idata.len % 2 != 0 {
            idata.push(0)
        }
    }
    for ci in 0:dll_name.len {
        idata.push(dll_name[ci])
    }
    idata.push(0)

    // Copy code and retarget IAT / suffix label references.
    mut code_mut := []int{}
    for i in 0:a.code.len {
        code_mut.push(a.code[i])
    }
    if n_imports > 0 && iat_rva != old_iat_rva {
        mut old_addrs := []int{}
        mut new_addrs := []int{}
        for i in 0:n_imports {
            old_addrs.push(p.base_addr + old_iat_rva + i * 8)
            new_addrs.push(p.base_addr + iat_rva + i * 8)
        }
        if p.machine == COFF_MACHINE_ARM64 {
            pe_patch_arm64_adrp_add(mut &code_mut, p.base_addr + text_rva, &old_addrs, &new_addrs)
        } else if p.machine == COFF_MACHINE_AMD64 {
            pe_patch_x64_rip32(mut &code_mut, p.base_addr + text_rva, &old_addrs, &new_addrs)
        }
    }
    if suffix_len > 0 {
        old_suffix_base := iat_data_offset + iat_region_len
        new_suffix_rva := import_rva + import_blob_size
        mut old_addrs := []int{}
        mut new_addrs := []int{}
        for i in 0:a.labels.len {
            if !a.labels[i].is_data { -> }
            loff := a.labels[i].offset
            if loff >= old_suffix_base && loff < a.data.len {
                old_addrs.push(p.base_addr + data_rva + loff)
                new_addrs.push(p.base_addr + new_suffix_rva + (loff - old_suffix_base))
            }
        }
        if old_addrs.len > 0 {
            if p.machine == COFF_MACHINE_ARM64 {
                pe_patch_arm64_adrp_add(mut &code_mut, p.base_addr + text_rva, &old_addrs, &new_addrs)
            } else if p.machine == COFF_MACHINE_AMD64 {
                pe_patch_x64_rip32(mut &code_mut, p.base_addr + text_rva, &old_addrs, &new_addrs)
            }
        }
    }

    // ===== Sections =====
    pad_to(mut &out, text_raw_offset)
    for i in 0:code_mut.len {
        out.push(code_mut[i])
    }
    pad_to(mut &out, data_raw_offset)
    for i in 0:prefix_len {
        out.push(a.data[i])
    }
    for i in 0:idata.len {
        out.push(idata[i])
    }
    for i in suffix_start:a.data.len {
        out.push(a.data[i])
    }
    // WoA rejects images whose last section SizeOfRawData extends past eof.
    pad_to(mut &out, data_raw_offset + data_raw_size)

    for i in 0:out.len {
        buf.push(out[i])
    }
}
