@main

#xu/types

// B1 machine selection is frozen before frame layout. This single owner is
// shared by allocation, independent binding validation and emission. Original
// MIR definitions/edges remain available to the conservative fallback.
// Header: fi,nlocals,ntemps,nblocks,count. Record: from,join,Bool ValueId,
// two (storage-kind,id,type) outputs, four (kind,id/word,type,increment)
// branch-end expressions, a private region block mask, and four optional
// same-block Temp witnesses. Witnesses do not change the semantic sources.
const SELECT_PAIR_HEADER = 5
const SELECT_PAIR_STRIDE = 30

// A witness is an already executed, one-word snapshot in this exact block.
// Do not compare merge tokens or definitions from different dynamic loop
// iterations. Read-only facts prove ownership, typing and every-path init;
// the same-block prefix proves no later write invalidated the snapshot.
fn select_pair_witness_ok(m &types.Mir, fi int, facts &types.MirValueFacts, bi int, local int, ty int, ti int) bool {
    if ti < 0 || ti >= types.mir_ntemps(m, fi) { << false }
    if types.mir_temp_ty(m, fi, ti) != ty || types.mir_temp_nslots(m, fi, ti) != 1 { << false }
    lv := types.mir_value_facts_version(m, fi, facts, bi, -1, 1, local)
    tv := types.mir_value_facts_version(m, fi, facts, bi, -1, 2, ti)
    if lv < 0 || tv < 0 || tv >= types.mir_nins(m, fi) || types.mir_value_facts_owner(facts, tv) != bi { << false }
    if types.mir_ikind(m, fi, tv) == types.MI_LOAD_LOCAL && types.mir_ib(m, fi, tv) == local {
        << types.mir_value_facts_version(m, fi, facts, bi, tv, 1, local) == lv
    }
    if lv >= types.mir_nins(m, fi) || types.mir_value_facts_owner(facts, lv) != bi { << false }
    if types.mir_ikind(m, fi, lv) != types.MI_STORE_LOCAL || types.mir_ia(m, fi, lv) != local || types.mir_ib(m, fi, lv) != ti { << false }
    << types.mir_value_facts_version(m, fi, facts, bi, lv, 2, ti) == tv
}

fn select_pair_find_witness(m &types.Mir, fi int, facts &types.MirValueFacts, bi int, kind int, id int, ty int) int {
    if kind != 1 { << -1 }
    for t in 0:types.mir_ntemps(m, fi) {
        if select_pair_witness_ok(m, fi, facts, bi, id, ty, t) { << t }
    }
    << -1
}

fn select_pair_at(actions &[]int, bi int) int {
    if actions.len < SELECT_PAIR_HEADER { << -1 }
    count := actions[4]
    if count < 1 || count > 8 || actions.len != SELECT_PAIR_HEADER + count * SELECT_PAIR_STRIDE { << -1 }
    for p in 0:count {
        at := SELECT_PAIR_HEADER + p * SELECT_PAIR_STRIDE
        if actions[at] == bi { << at }
    }
    << -1
}

fn select_pair_use(actions &[]int, at int, pos int) int {
    if at < SELECT_PAIR_HEADER || at + SELECT_PAIR_STRIDE > actions.len { << -1 }
    if pos == 4 { << actions[at + 2] }
    if pos >= 5 && pos < 9 { << actions[at + 26 + pos - 5] }
    if pos < 0 || pos >= 4 { << -1 }
    off := at + 9 + pos * 4
    if actions[off] == 2 { << actions[off + 1] }
    << -1
}

// Preserve all existing whole-region selections. Declining the entire small
// function is conservative when a footprint is wider than one block. These
// matchers decide priority/cost only; they do not provide semantic authority.
fn select_pair_vec_conflict(m &types.Mir, fi int) bool {
    for bi in 0:types.mir_nblocks(m, fi) {
        if match_iand_reduce(m, fi, bi).kind != 0 { << true }
        if match_mul_iand_reduce(m, fi, bi).kind != 0 || match_iand_ssa(m, fi, bi).kind != 0 { << true }
        if match_scan_reduce(m, fi, bi).kind != 0 || match_scan_ssa(m, fi, bi).kind != 0 { << true }
        if match_byte_add_reduce(m, fi, bi).kind != 0 { << true }
        if match_index_copy(m, fi, bi).kind != 0 { << true }
        if match_vec3_sqnorm(m, fi, bi).kind != 0 { << true }
        if match_scan_carry(m, fi, bi).kind != 0 { << true }
        if match_saxpy_rmw47(m, fi, bi).kind != 0 || match_saxpy_ssa(m, fi, bi).kind != 0 { << true }
        if match_crc_bit8(m, fi, bi).kind != 0 || match_crc_bit8_ssa(m, fi, bi).kind != 0 { << true }
        if match_push_fill(m, fi, bi).kind != 0 || match_push_fill_ssa(m, fi, bi).kind != 0 { << true }
        if match_stride_zero(m, fi, bi).kind != 0 || match_stride_zero_ssa(m, fi, bi).kind != 0 { << true }
        if match_pred_scan(m, fi, bi).kind != 0 || match_pred_scan_ssa(m, fi, bi).kind != 0 { << true }
        if match_bsearch(m, fi, bi).kind != 0 || match_bsearch_ssa(m, fi, bi).kind != 0 { << true }
        if push_loop_const_limit(m, fi, bi) > 16 { << true }
    }
    << false
}

fn select_pair_collect(m &types.Mir, fi int) []int {
    $out := []int{}
    facts := types.new_mir_readonly_value_facts(m, fi)
    if facts.reason != 0 { << out }
    if select_pair_vec_conflict(m, fi) { << out }
    out.push(fi)
    out.push(types.mir_nlocals(m, fi))
    out.push(types.mir_ntemps(m, fi))
    out.push(types.mir_nblocks(m, fi))
    out.push(0)
    $owned := 0
    for bi in 0:types.mir_nblocks(m, fi) {
        if out[4] >= 8 { <- }
        if types.mir_btkind(m, fi, bi) != 2 { -> }
        p := types.new_mir_select_pair_plan_discover(m, fi, &facts, bi)
        if p.reason != 0 { -> }
        cond := types.mir_select_pair_field(&p, 2)
        if cond < 0 { -> }
        $region := (1 << bi) | (1 << types.mir_select_pair_field(&p, 1))
        for arm in 0:2 {
            for k in 0:types.mir_select_pair_block_count(&p, arm) {
                region = region | (1 << types.mir_select_pair_block(&p, arm, k))
            }
        }
        if (region & owned) != 0 { -> }
        out.push(bi)
        out.push(types.mir_select_pair_field(&p, 1))
        out.push(cond)
        for output in 0:2 {
            for lane in 0:3 { out.push(types.mir_select_pair_output(&p, output, lane)) }
        }
        for output in 0:2 {
            for arm in 0:2 {
                for lane in 0:4 { out.push(types.mir_select_pair_source(&p, output, arm, lane)) }
            }
        }
        out.push(region)
        for output in 0:2 {
            for arm in 0:2 {
                out.push(select_pair_find_witness(m, fi, &facts, bi, types.mir_select_pair_source(&p, output, arm, 0), types.mir_select_pair_source(&p, output, arm, 1), types.mir_select_pair_source(&p, output, arm, 2)))
            }
        }
        out[4] += 1
        owned = owned | region
    }
    if out[4] == 0 { << []int{} }
    << out
}

// Four immutable snapshots use VM0/1/6/7 (x8/x9/x14/x15), Bool VM14
// (x0), materialized before snapshots. VM6/7 are excluded from source values,
// values live across each selected terminator and both outputs. A dying Bool
// has already been read before they are clobbered; other disjoint ranges may
// also reuse them. Large frame helpers additionally
// use physical x17; this is distinct from VM17 and not an allocatable home.
fn select_pair_reserved(arch int) int {
    if arch != 0 { << 0 }
    << (1 << 6) | (1 << 7)
}

fn select_pair_interference(edge $&[]int, active $&[]int, call_live $&[]int, actions &[]int, at int, live &[]int, n int, nb int, weight int, arch int) {
    for pos in 0:9 {
        u := select_pair_use(actions, at, pos)
        if u < 0 { -> }
        $seen := false
        for prev in 0:pos { if select_pair_use(actions, at, prev) == u { seen = true } }
        if !seen { call_live[n + u] = vreg_spill_weight_add(call_live[n + u], weight) }
        for t in 0:n {
            if t != u && active[t] == 1 {
                vreg_edge_set(edge, n, u, t)
                vreg_edge_set(edge, n, t, u)
            }
        }
        active[u] = 1
    }
    join := actions[at + 1]
    for output in 0:2 {
        off := at + 3 + output * 3
        if actions[off] != 2 { -> }
        d := actions[off + 1]
        for t in 0:n {
            if t != d && (active[t] == 1 || live[join * n + t] == 1) {
                vreg_edge_set(edge, n, d, t)
                vreg_edge_set(edge, n, t, d)
            }
        }
        other := at + 3 + (1 - output) * 3
        if actions[other] == 2 && actions[other + 1] != d {
            vreg_edge_set(edge, n, d, actions[other + 1])
            vreg_edge_set(edge, n, actions[other + 1], d)
        }
        call_live[d] = call_live[d] | (select_pair_reserved(arch) << 8)
    }
    // Preserve original OUT, including arm-only uses dead at join. Sources
    // and witnesses also need exclusions because snapshots precede their
    // last read. The Bool is read into VM14 first: only a dying Bool which
    // is neither another source nor an output may reuse snapshot scratch.
    reserved := select_pair_reserved(arch) << 8
    for t in 0:n {
        if live[nb * n + actions[at] * n + t] == 1 { call_live[t] = call_live[t] | reserved }
    }
    for pos in 0:9 {
        if pos == 4 { -> }
        u := select_pair_use(actions, at, pos)
        if u >= 0 { call_live[u] = call_live[u] | reserved }
    }
}

fn select_pair_slot(fr &Frame, kind int, id int) int {
    if kind == 1 && id >= 0 && id < fr.local_slot.len { << fr.local_slot[id] }
    if kind == 2 && id >= 0 && id < fr.temp_slot.len { << fr.temp_slot[id] }
    << unused_slot()
}

// Frame witnesses retain the canonical source. Only a verified fixed home
// replaces a Local load; the optional Temp still participates in allocation.
fn select_pair_source_slot(fr &Frame, at int, pos int) int {
    off := at + 9 + pos * 4
    witness := fr.select_pairs[at + 26 + pos]
    if witness >= 0 && witness < fr.temp_slot.len && is_vreg_slot(fr.temp_slot[witness]) { << fr.temp_slot[witness] }
    << select_pair_slot(fr, fr.select_pairs[off], fr.select_pairs[off + 1])
}

fn select_pair_slot_ok(slot int, arch int) bool {
    if is_frame_slot(slot) { << true }
    if !is_vreg_slot(slot) || arch != 0 { << false }
    h := vreg_slot_home(slot)
    << (select_pair_reserved(arch) & (1 << h)) == 0
}

// Stable frame cells never coalesce. Audit their full word intervals as well
// as colored homes: a corrupt Local binding must not overwrite a live Temp,
// descriptor word, another source or an otherwise unrelated formal Local.
fn select_pair_frame_cells_ok(fr &Frame, m &types.Mir, fi int) bool {
    nl := types.mir_nlocals(m, fi)
    n := nl + types.mir_ntemps(m, fi)
    if n > 256 || fr.size < 0 || fr.size % 16 != 0 { << false }
    for cell in 0:n {
        $kind := 2
        $id := cell - nl
        $width := 0
        if cell < nl { kind = 1
            id = cell
            width = types.mir_local_nslots(m, fi, id) }
        else { width = types.mir_temp_nslots(m, fi, id) }
        slot := select_pair_slot(fr, kind, id)
        if !is_frame_slot(slot) { -> }
        if width <= 0 || slot > fr.size / 8 || width > fr.size / 8 - slot { << false }
        for prev in 0:cell {
            $pk := 2
            $pid := prev - nl
            $pw := 0
            if prev < nl { pk = 1
                pid = prev
                pw = types.mir_local_nslots(m, fi, pid) }
            else { pw = types.mir_temp_nslots(m, fi, pid) }
            ps := select_pair_slot(fr, pk, pid)
            if is_frame_slot(ps) && slot < ps + pw && ps < slot + width { << false }
        }
    }
    << true
}

// Rebuild the interface from the immutable MIR, independently of planner
// bitmaps. A malformed binding is an internal error, never a late fallback.
fn select_pair_verify_interface(actions &[]int, m &types.Mir, fi int) bool {
    if actions.len == 0 { << true }
    if actions.len < SELECT_PAIR_HEADER { << false }
    if actions[0] != fi || actions[1] != types.mir_nlocals(m, fi) || actions[2] != types.mir_ntemps(m, fi) || actions[3] != types.mir_nblocks(m, fi) { << false }
    count := actions[4]
    if count < 1 || count > 8 || actions.len != SELECT_PAIR_HEADER + count * SELECT_PAIR_STRIDE { << false }
    facts := types.new_mir_readonly_value_facts(m, fi)
    if facts.reason != 0 { << false }
    $owned := 0
    for pi in 0:count {
        at := SELECT_PAIR_HEADER + pi * SELECT_PAIR_STRIDE
        p := types.new_mir_select_pair_plan(m, fi, &facts, actions[at], actions[at + 1])
        if p.reason != 0 || types.mir_select_pair_field(&p, 2) != actions[at + 2] || actions[at + 2] < 0 { << false }
        $region := (1 << actions[at]) | (1 << actions[at + 1])
        for arm in 0:2 {
            for k in 0:types.mir_select_pair_block_count(&p, arm) {
                region = region | (1 << types.mir_select_pair_block(&p, arm, k))
            }
        }
        if region != actions[at + 25] || (region & owned) != 0 { << false }
        owned = owned | region
        for output in 0:2 {
            for lane in 0:3 {
                if actions[at + 3 + output * 3 + lane] != types.mir_select_pair_output(&p, output, lane) { << false }
            }
            for arm in 0:2 {
                for lane in 0:4 {
                    if actions[at + 9 + (output * 2 + arm) * 4 + lane] != types.mir_select_pair_source(&p, output, arm, lane) { << false }
                }
                pos := output * 2 + arm
                witness := actions[at + 26 + pos]
                if witness != -1 {
                    off := at + 9 + pos * 4
                    if actions[off] != 1 || !select_pair_witness_ok(m, fi, &facts, actions[at], actions[off + 1], actions[off + 2], witness) { << false }
                }
            }
        }
    }
    << true
}

// Independently recompute selected uses and original CFG liveness. We audit
// actual frame/fixed slots, not the allocator's edge matrix or its success
// flag. Conservative output/source interference allows the original arms
// and the selected direct-to-join path under the same allocation.
fn select_pair_verify_frame(fr &Frame, m &types.Mir, fi int, arch int) bool {
    actions := &fr.select_pairs
    if actions.len == 0 { << true }
    if arch != 0 || !select_pair_verify_interface(actions, m, fi) { << false }
    n := types.mir_ntemps(m, fi)
    nb := types.mir_nblocks(m, fi)
    if fr.temp_slot.len != n || fr.local_slot.len != types.mir_nlocals(m, fi) { << false }
    if !select_pair_frame_cells_ok(fr, m, fi) { << false }
    $reach := []int{}
    for _ in 0:nb { reach.push(1) }
    $uses := []int{}
    $defs := []int{}
    for _ in 0:nb * n { uses.push(0)
        defs.push(0) }
    for bi in 0:nb {
        $ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            for pos in 0:6 {
                u := vreg_instr_use(m, fi, ii, pos)
                if u >= 0 && defs[bi * n + u] == 0 { uses[bi * n + u] = 1 }
            }
            d := vreg_instr_def(m, fi, ii)
            if d >= 0 { defs[bi * n + d] = 1 }
            ii = types.mir_inext(m, fi, ii)
        }
        tk := types.mir_btkind(m, fi, bi)
        tv := types.mir_bta(m, fi, bi)
        if (tk == 2 || tk == 3) && tv >= 0 && defs[bi * n + tv] == 0 { uses[bi * n + tv] = 1 }
        at := select_pair_at(actions, bi)
        if at >= 0 {
            for pos in 0:9 {
                u := select_pair_use(actions, at, pos)
                if u >= 0 && defs[bi * n + u] == 0 { uses[bi * n + u] = 1 }
            }
        }
    }
    $live := []int{}
    for _ in 0:nb * n * 2 { live.push(0) }
    if !vreg_solve_liveness($&live, m, fi, &reach, &uses, &defs, n, nb) { << false }
    for pi in 0:actions[4] {
        at := SELECT_PAIR_HEADER + pi * SELECT_PAIR_STRIDE
        // Independently reconstruct the clobber boundary from original CFG
        // OUT, not IN[join] or the allocator's reservation tags. Temp ranges
        // disjoint from every selected terminator may legally use VM6/7.
        for t in 0:n {
            if live[nb * n + actions[at] * n + t] == 1 && is_vreg_slot(fr.temp_slot[t]) && !select_pair_slot_ok(fr.temp_slot[t], arch) { << false }
        }
        for pos in 0:9 {
            u := select_pair_use(actions, at, pos)
            if u >= 0 {
                slot := fr.temp_slot[u]
                // A fixed dying Bool was materialized before scratch writes.
                // OUT above, any repeated source use and output checks below
                // still independently forbid a live/data Bool in VM6/7.
                if !(pos == 4 && is_vreg_slot(slot)) && !select_pair_slot_ok(slot, arch) { << false }
                for t in 0:n {
                    if t != u && live[nb * n + actions[at] * n + t] == 1 && fr.temp_slot[t] == slot { << false }
                }
                for prev in 0:pos {
                    v := select_pair_use(actions, at, prev)
                    if v >= 0 && v != u && fr.temp_slot[v] == slot { << false }
                }
            }
        }
        for pos in 0:4 {
            off := at + 9 + pos * 4
            if actions[off] != 3 && !select_pair_slot_ok(select_pair_slot(fr, actions[off], actions[off + 1]), arch) { << false }
        }
        for output in 0:2 {
            off := at + 3 + output * 3
            slot := select_pair_slot(fr, actions[off], actions[off + 1])
            if !select_pair_slot_ok(slot, arch) { << false }
            other := at + 3 + (1 - output) * 3
            if slot == select_pair_slot(fr, actions[other], actions[other + 1]) { << false }
            if actions[off] == 2 {
                d := actions[off + 1]
                for t in 0:n {
                    if t != d && live[actions[at + 1] * n + t] == 1 && fr.temp_slot[t] == slot { << false }
                }
                for pos in 0:9 {
                    u := select_pair_use(actions, at, pos)
                    if u >= 0 && u != d && fr.temp_slot[u] == slot { << false }
                }
            }
        }
    }
    << true
}

// All canonical sources denote their proved branch-end base value. Only
// kind/id/type identify that base; each snapshot's increment is applied later.
// Compare semantic cells, never an incidental colored-home alias or witness.
fn select_pair_base_before(actions &[]int, at int, pos int) int {
    off := at + 9 + pos * 4
    for prev in 0:pos {
        poff := at + 9 + prev * 4
        if actions[off] == actions[poff] && actions[off + 1] == actions[poff + 1] && actions[off + 2] == actions[poff + 2] { << prev }
    }
    << -1
}

// Legality and profitability are separate. Without branch-profile evidence,
// do not speculate extra frame reads. Count the actual first materialization
// of each canonical base; later independent snapshots copy it, against either
// original arm's unique sources. The old arm may reuse a single load for
// both outputs; count that conservative lower bound, not two expression
// occurrences. Fixed homes and immediates do not issue a memory load. This
// conservative memory gate is not a claim about total instruction/spill cost.
fn select_pair_profitable(fr &Frame) bool {
    actions := &fr.select_pairs
    if actions.len == 0 { << true }
    for pi in 0:actions[4] {
        at := SELECT_PAIR_HEADER + pi * SELECT_PAIR_STRIDE
        $loads := 0
        $true_loads := 0
        $false_loads := 0
        for output in 0:2 {
            for arm in 0:2 {
                off := at + 9 + (output * 2 + arm) * 4
                if actions[off] != 3 && select_pair_base_before(actions, at, output * 2 + arm) < 0 && is_frame_slot(select_pair_source_slot(fr, at, output * 2 + arm)) { loads += 1 }
                if actions[off] != 3 && is_frame_slot(select_pair_slot(fr, actions[off], actions[off + 1])) {
                    prev := at + 9 + arm * 4
                    if output == 0 || actions[off] != actions[prev] || actions[off + 1] != actions[prev + 1] {
                        if arm == 0 { true_loads += 1 }
                        else { false_loads += 1 }
                    }
                }
            }
        }
        if loads > true_loads || loads > false_loads { << false }
    }
    << true
}

// Added selected uses/reservations must not spill a previously fixed Temp,
// grow the frame or add callee-save pairs. Compare the actual ordinary plan,
// not a total spill count which can hide one new spill behind another gain.
fn select_pair_pressure_ok(fr &Frame, ordinary &Frame, m &types.Mir, fi int, arch int) bool {
    if fr.size > ordinary.size || frame_vreg_callee_pairs(fr, arch) > frame_vreg_callee_pairs(ordinary, arch) { << false }
    for t in 0:fr.temp_slot.len {
        if vreg_temp_eligible(m, fi, t) && is_vreg_slot(ordinary.temp_slot[t]) && !is_vreg_slot(fr.temp_slot[t]) { << false }
    }
    << true
}

fn select_pair_load(a $&Assembler, fr &Frame, kind int, id int, vr int) {
    if kind == 3 { a.vm_mov_imm64(vr, id)
        << }
    slot := select_pair_slot(fr, kind, id)
    if is_vreg_slot(slot) { a.mov(vr, vreg_slot_home(slot)) }
    else { a.load(vr, 15, slot_off(slot)) }
}

fn select_pair_store(a $&Assembler, fr &Frame, kind int, id int, vr int) {
    slot := select_pair_slot(fr, kind, id)
    if is_vreg_slot(slot) { a.mov(vreg_slot_home(slot), vr) }
    else { a.store(15, slot_off(slot), vr) }
}

fn emit_select_pair_term(a $&Assembler, m &types.Mir, fi int, fr &Frame, bi int) bool {
    at := select_pair_at(&fr.select_pairs, bi)
    if at < 0 { << false }
    // VM14 is outside the fixed-home pool. Frame address helpers use physical
    // x17 and none of the snapshots/increments clobber VM14. Preserve Bool
    // before writing VM6/7, including when its dying fixed home is scratch.
    select_pair_load(a, fr, 2, fr.select_pairs[at + 2], 14)
    for pos in 0:4 {
        $vr := pos
        if pos >= 2 { vr = pos + 4 }
        prev := select_pair_base_before(&fr.select_pairs, at, pos)
        if prev >= 0 {
            $source := prev
            if prev >= 2 { source = prev + 4 }
            // Every snapshot remains independent and all increments follow
            // this loop. Repeated bases do not re-read a frame or immediate.
            a.mov(vr, source)
            ->
        }
        off := at + 9 + pos * 4
        witness := fr.select_pairs[at + 26 + pos]
        if witness >= 0 && is_vreg_slot(fr.temp_slot[witness]) { select_pair_load(a, fr, 2, witness, vr) }
        else { select_pair_load(a, fr, fr.select_pairs[off], fr.select_pairs[off + 1], vr) }
    }
    for pos in 0:4 {
        $vr := pos
        if pos >= 2 { vr = pos + 4 }
        if fr.select_pairs[at + 12 + pos * 4] == 1 { a.vm_add_imm(vr, vr, 1) }
    }
    a.vm_cmp_imm(14, 0)
    a.vm_csel(0, 0, 1, 1) // NE: choose the true expression for Bool != 0.
    a.vm_csel(6, 6, 7, 1)
    select_pair_store(a, fr, fr.select_pairs[at + 3], fr.select_pairs[at + 4], 0)
    select_pair_store(a, fr, fr.select_pairs[at + 6], fr.select_pairs[at + 7], 6)
    a.rc_fused_cc = -1
    a.jmp(types.mir_fn_label(m, fi) + "_bb" + str(fr.select_pairs[at + 1]))
    << true
}
