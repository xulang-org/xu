@main

#xu/types

// Adjacent-element scan with a carried mask.


fn vec_is_sub1_dest(m &types.Mir, fi int, bi int, t int) int {
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 4 && types.mir_ib(m, fi, ii) == 2 {
            dest := types.mir_ia(m, fi, ii)
            lc := types.mir_ic(m, fi, ii)
            ld := types.mir_id(m, fi, ii)
            if vec_operand_is_one(m, fi, bi, ld) && vec_same_val(m, fi, bi, lc, t) { << dest }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << -1
}

fn vec_instr_defines_temp(m &types.Mir, fi int, ii int, t int) bool {
    if t < 0 { << false }
    if types.mir_ia(m, fi, ii) != t { << false }
    k := types.mir_ikind(m, fi, ii)
    if k == 1 || k == 2 || k == 4 || k == 5 || k == 7 || k == 10 || k == 14 || k == 16 || k == 17 || k == 23 {
        << true
    }
    << false
}

fn vec_block_defines_temp(m &types.Mir, fi int, bi int, t int) bool {
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { << false }
        if vec_instr_defines_temp(m, fi, ii, t) { << true }
        ii = types.mir_inext(m, fi, ii)
    }
    << false
}

fn vec_uses_temp_before_def(m &types.Mir, fi int, bi int, t int) bool {
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { << false }
        if mir_instr_uses_temp(m, fi, ii, t) { << true }
        if vec_instr_defines_temp(m, fi, ii, t) { << false }
        ii = types.mir_inext(m, fi, ii)
    }
    << false
}

// Replacing a block drops every temp it defined. The exit edge may still
// read those temps (the outer latch's length or descriptor copy). That is
// a stale value, not a faster scan. Refuse the rewrite.
fn vec_exit_depends_on_body(m &types.Mir, fi int, body int, exit int, kept int) bool {
    if exit < 0 { << true }
    nt := types.mir_ntemps(m, fi)
    mut t := 0
    while t < nt {
        if t != kept && vec_block_defines_temp(m, fi, body, t) && vec_uses_temp_before_def(m, fi, exit, t) {
            << true
        }
        t += 1
    }
    << false
}

// A temp is live on entry when the block reads it before any def, or never
// defines it. A LoadLocal result is defined first: its slot still holds the
// previous trip, so it is not the induction the preheader stored.
fn vec_index_incoming(m &types.Mir, fi int, bi int, t int) bool {
    if t < 0 { << false }
    if t >= types.mir_local_operand_base { << true }
    if vec_uses_temp_before_def(m, fi, bi, t) { << true }
    if !vec_block_defines_temp(m, fi, bi, t) { << true }
    << false
}

fn match_scan_carry(m &types.Mir, fi int, bi int) VecPat {
    mut header := vec_copy_header(m, fi, bi)
    mut else_bb := -1
    if header >= 0 {
        else_bb = vec_copy_else(m, fi, header, bi)
    }
    mut nld := 0
    mut nst := 0
    mut ld0 := -1
    mut ld1 := -1
    mut st_ii := -1
    mut badk := -1
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == 14 {
            if !vec_elem8(types.mir_id(m, fi, ii)) { << vec_none() }
            if nld == 0 { ld0 = ii } else { ld1 = ii }
            nld += 1
        } else if k == 20 {
            if !vec_elem8(types.mir_id(m, fi, ii)) { << vec_none() }
            nst += 1
            st_ii = ii
        } else if k != 0 && k != 1 && k != 2 && k != 3 && k != 4 {
            badk = k
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if nld >= 2 {
    }
    if header < 0 || else_bb < 0 { << vec_none() }
    if badk >= 0 { << vec_none() }
    if nld != 2 || nst != 1 { << vec_none() }
    idx0 := types.mir_ic(m, fi, ld0)
    idx1 := types.mir_ic(m, fi, ld1)
    st_idx := types.mir_ib(m, fi, st_ii)
    mut ind := vec_pick_induct(m, fi, bi, st_idx)
    if ind < 0 {
        << vec_none()
    }
    if ind < types.mir_local_operand_base {
        nb := types.mir_nblocks(m, fi)
        mut b := 0
        for _ in 0:nb {
            r := vec_trace(m, fi, b, ind)
            if r >= types.mir_local_operand_base {
                ind = r
                <-
            }
            d := vec_resolve_desc(m, fi, b, ind)
            if d >= types.mir_local_operand_base {
                ind = d
                <-
            }
            b += 1
        }
    }
    sub1 := vec_is_sub1_dest(m, fi, bi, ind)
    if sub1 < 0 {
        << vec_none()
    }
    mut cur_ld := -1
    mut prev_ld := -1
    if vec_same_val(m, fi, bi, idx0, ind) && vec_same_val(m, fi, bi, idx1, sub1) {
        cur_ld = ld0
        prev_ld = ld1
    } else if vec_same_val(m, fi, bi, idx1, ind) && vec_same_val(m, fi, bi, idx0, sub1) {
        cur_ld = ld1
        prev_ld = ld0
    } else {
        << vec_none()
    }
    if !vec_same_val(m, fi, bi, st_idx, ind) { << vec_none() }
    mut src := vec_trace(m, fi, bi, types.mir_ib(m, fi, cur_ld))
    mut prev_a := vec_trace(m, fi, bi, types.mir_ib(m, fi, prev_ld))
    mut st_a := vec_trace(m, fi, bi, types.mir_ia(m, fi, st_ii))
    if prev_a != src || st_a != src {
        n := types.mir_nblocks(m, fi)
        mut b := 0
        for _ in 0:n {
            r0 := vec_trace(m, fi, b, src)
            r1 := vec_trace(m, fi, b, prev_a)
            r2 := vec_trace(m, fi, b, st_a)
            if r0 >= types.mir_local_operand_base { src = r0 }
            if r1 >= types.mir_local_operand_base { prev_a = r1 }
            if r2 >= types.mir_local_operand_base { st_a = r2 }
            d0 := vec_resolve_desc(m, fi, b, src)
            d1 := vec_resolve_desc(m, fi, b, prev_a)
            d2 := vec_resolve_desc(m, fi, b, st_a)
            if d0 >= types.mir_local_operand_base { src = d0 }
            if d1 >= types.mir_local_operand_base { prev_a = d1 }
            if d2 >= types.mir_local_operand_base { st_a = d2 }
            b += 1
        }
    }
    if prev_a != src || st_a != src {
        << vec_none()
    }
    mut mask := 0
    mut found_and := false
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 4 && types.mir_ib(m, fi, ii) == 14 {
            lc := types.mir_ic(m, fi, ii)
            ld := types.mir_id(m, fi, ii)
            mut cv := 0
            mut okc := false
            if vec_has_const(m, fi, ld) {
                cv = vec_const(m, fi, ld)
                okc = true
            } else if vec_has_const(m, fi, lc) {
                cv = vec_const(m, fi, lc)
                okc = true
            }
            if okc && cv > 0 {
                mask = cv
                found_and = true
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if !found_and {
        << vec_none()
    }
    mut lim := vec_copy_limit_in(m, fi, header, ind)
    if lim.kind == 0 && header != bi {
        lim = vec_copy_limit_in(m, fi, bi, ind)
    }
    if lim.kind == 0 {
        << vec_none()
    }
    if vec_exit_depends_on_body(m, fi, bi, else_bb, ind) {
        << vec_none()
    }
    // Another local stored in this block is an outer counter or a reset
    // (`t = t + 1`, `i = 1`). Replacing the block would run the scan once.
    // The induction itself may be stored only as `i = i + 1`. A second
    // store is a reset that has to run before the walk.
    mut ind_local := -1
    if ind >= types.mir_local_operand_base {
        ind_local = ind - types.mir_local_operand_base
    }
    mut ind_stores := 0
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 3 {
            loc := types.mir_ia(m, fi, ii)
            if loc != ind_local {
                << vec_none()
            }
            ind_stores += 1
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if ind_local >= 0 && ind_stores != 1 {
        << vec_none()
    }
    // Prefer the store index when it is the value live on entry (the
    // predecessor phi). Otherwise the preheader's induction local is that
    // value. The post-increment temp is defined in this block; loading it
    // replays the previous trip and every later outer round is a no-op.
    mut start := -1
    if vec_index_incoming(m, fi, bi, st_idx) {
        start = st_idx
    } else if ind >= types.mir_local_operand_base {
        start = ind
    } else if vec_index_incoming(m, fi, bi, ind) {
        start = ind
    } else {
        << vec_none()
    }
    << VecPat{kind: 7, ind: start, acc: -1, mask: mask, limit: lim.limit, limit_t: lim.limit_t, else_bb: else_bb, arr: src, fac: header}
}

// Virtual register that holds `local` ahead of its frame slot, or -1 when
// the frame slot is the current copy. A dirty regcache pin or a vreg home
// is ahead of the frame; a clean pin is not.
fn scan_live_reg(a &Assembler, fr &Frame, local int) int {
    if local < 0 || local >= fr.local_slot.len { << -1 }
    slot := fr.local_slot[local]
    p := rc_pin_index(a, slot)
    if p >= 0 && a.rc_pin_dirty[p] == 1 {
        << rc_pin_vr(a, p)
    }
    if is_vreg_slot(slot) {
        << vreg_slot_home(slot)
    }
    << -1
}

fn emit_scan_carry(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, pins &[]int, p VecPat) int {
    if p.ind < 0 { << 0 }
    if p.else_bb < 0 { << 0 }
    if p.mask <= 0 { << 0 }
    mut ind_local := -1
    mut ind_temp := -1
    if p.ind >= types.mir_local_operand_base {
        ind_local = p.ind - types.mir_local_operand_base
        if ind_local < 0 || ind_local >= fr.local_slot.len { << 0 }
    } else {
        ind_temp = p.ind
        if ind_temp >= fr.temp_slot.len { << 0 }
    }
    mut src := vec_resolve_desc(m, fi, bi, p.arr)
    if src < types.mir_local_operand_base && p.fac >= 0 && p.fac != bi {
        src = vec_resolve_desc(m, fi, p.fac, p.arr)
    }
    if src < types.mir_local_operand_base { << 0 }
    mut lim_local := -1
    if p.limit_t >= types.mir_local_operand_base {
        lim_local = p.limit_t - types.mir_local_operand_base
        if lim_local < 0 || lim_local >= fr.local_slot.len { << 0 }
    } else if p.limit_t >= 0 {
        if p.limit_t >= fr.temp_slot.len { << 0 }
    } else if p.limit <= 0 {
        << 0
    }
    // A2=i A3=n A4=ptr A5=carry. V0 scratch. Ret=len then mask.
    // Do not use V2-V7/S0-S5: those are vreg homes.
    // A dirty pin (or vreg home) is the live induction. Copy it into A2/A3
    // before the walk clobbers caller-saved regs. Refuse when that copy
    // would overwrite the other operand.
    mut i_src := -1
    mut n_src := -1
    if ind_local >= 0 {
        if ind_local >= fr.local_slot.len { << 0 }
        islot := fr.local_slot[ind_local]
        if !is_frame_slot(islot) && !is_vreg_slot(islot) { << 0 }
        i_src = scan_live_reg(&*a, fr, ind_local)
    }
    if lim_local >= 0 {
        if lim_local >= fr.local_slot.len { << 0 }
        nslot := fr.local_slot[lim_local]
        if !is_frame_slot(nslot) && !is_vreg_slot(nslot) { << 0 }
        n_src = scan_live_reg(&*a, fr, lim_local)
    }
    if i_src == 15 || i_src == 16 || i_src == 17 { << 0 }
    if n_src == 15 || n_src == 16 || n_src == 17 { << 0 }
    if i_src == 21 || n_src == 20 { << 0 }
    if i_src >= 0 && i_src == n_src { << 0 }
    if lim_local >= 0 {
        if n_src >= 0 {
            if n_src != 21 { a.mov(21, n_src) }
        } else {
            a.load(21, 15, slot_off(fr.local_slot[lim_local]))
        }
    } else if p.limit_t >= 0 {
        emit_load_value(a, m, fi, fr, p.limit_t, 21)
    } else {
        a.vm_mov_imm64(21, p.limit)
    }
    if ind_local >= 0 {
        if i_src >= 0 {
            if i_src != 20 { a.mov(20, i_src) }
        } else {
            a.load(20, 15, slot_off(fr.local_slot[ind_local]))
        }
    } else {
        emit_load_value(a, m, fi, fr, ind_temp, 20)
    }
    a.vm_cmp_imm(20, 1)
    a.oob_need = 1
    a.jlt(a.oob_lbl + "")
    emit_index_desc_addr(a, m, fi, fr, src)
    a.load(14, 0, -8)
    a.cmp(14, 21)
    a.jlt(a.oob_lbl + "")
    // `i >= n` takes the exit before touching a[i-1]. i == n would load
    // the last element; i > n would load past it.
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi)
    lp := pref + "_sc"
    dn := pref + "_sd"
    else_lbl := types.mir_fn_label(m, fi) + "_bb" + str(p.else_bb)
    a.cmp(20, 21)
    a.jge(dn + "")
    a.load(22, 0, 0)
    // The x64 fallback for add_lsl_vr shifts its index operand in place;
    // keep the induction value intact because the loop compares it after
    // every element. Use Ret as a scratch only for the address calculation.
    if a.arch == 1 {
        a.shl_imm(14, 20, 3)
        a.add(22, 22, 14)
    } else {
        a.add_lsl_vr(22, 22, 20, 3)
    }
    a.load(23, 22, 0 - 8)
    a.label(lp + "")
    a.load(0, 22, 0)
    a.vm_mov_imm64(14, p.mask)
    a.iand(23, 23, 14)
    a.add(23, 0, 23)
    a.store(22, 0, 23)
    a.vm_add_imm(22, 22, 8)
    a.vm_add_imm(20, 20, 1)
    a.cmp(20, 21)
    a.jlt(lp + "")
    a.label(dn + "")
    if ind_local >= 0 {
        islot := fr.local_slot[ind_local]
        if is_vreg_slot(islot) {
            home := vreg_slot_home(islot)
            if home != 20 { a.mov(home, 20) }
        } else {
            a.store(15, slot_off(islot), 20)
        }
        // Frame and pin must agree. A later LoadLocal trusts a dirty pin
        // over the slot this walk just finished.
        p_i := rc_pin_index(&*a, islot)
        if p_i >= 0 {
            pv := rc_pin_vr(&*a, p_i)
            if pv != 20 { a.mov(pv, 20) }
            a.rc_pin_dirty[p_i] = 0
        }
    } else if is_vreg_slot(fr.temp_slot[ind_temp]) {
        home := vreg_slot_home(fr.temp_slot[ind_temp])
        if home != 20 {
            a.mov(home, 20)
        }
    } else {
        a.store(15, slot_off(fr.temp_slot[ind_temp]), 20)
    }
    // A 2-block loop's exit edge lives on the header. Jumping straight to
    // the else block skips the header and any outer latch that resets the
    // induction (`i = 1` around this scan). Return to the header so its
    // original branch takes the exit with the induction already at `n`.
    if p.fac >= 0 && p.fac != bi {
        hdr := types.mir_fn_label(m, fi) + "_bb" + str(p.fac)
        a.jmp(hdr + "")
    } else {
        a.jmp(else_lbl + "")
    }
    << 1
}
