@main

// Product emit-time diagnostics. Per-map storage follows the map's existing
// exclusive-access contract; no global counters, allocations or formatting
// calls occur on a probe. Stats builds use the shared framed find paths.
fn gen1_map_stats_on() bool { << env_get("XU_GEN1_MAP_STATS") == "1" }
fn rt_map_header_bytes() int {
    if gen1_map_stats_on() { << 32920 }
    << 96
}
fn rt_map_zero_extension(a &mut Assembler) {
    a.vm_mov_imm(4, 80)
    a.label("_rt_ms_zero")
    a.vm_cmp_imm(4, rt_map_header_bytes())
    a.jge("_rt_ms_zero_done")
    a.load(1, 15, -24)
    a.add(1, 1, 4)
    a.vm_mov_imm(0, 0)
    a.store(1, 0, 0)
    a.vm_add_imm(4, 4, 8)
    a.jmp("_rt_ms_zero")
    a.label("_rt_ms_zero_done")
}
fn rt_map_probe_start(a &mut Assembler, slot int) {
    if !gen1_map_stats_on() { << }
    a.vm_mov_imm(0, 0)
    a.store(15, slot, 0)
}
fn rt_map_probe_step(a &mut Assembler, slot int) {
    if !gen1_map_stats_on() { << }
    a.load(4, 15, slot)
    a.vm_add_imm(4, 4, 1)
    a.store(15, slot, 4)
}
fn rt_map_probe_finish(a &mut Assembler, slot int, saved int) {
    if !gen1_map_stats_on() { << }
    a.store(15, saved, 14)
    a.load(18, 15, -8)
    a.load(19, 15, slot)
    a.call("_rt_map_record_probe")
    a.load(14, 15, saved)
}
fn rt_map_stats_event(a &mut Assembler, slot int) {
    if !gen1_map_stats_on() { << }
    a.load(0, 18, slot)
    a.vm_add_imm(0, 0, 1)
    a.store(18, slot, 0)
}
fn rt_emit_map_stats(a &mut Assembler) {
    if !gen1_map_stats_on() { << }
    // A0=handle, A1=visited slots. Clobbers V0/V1 only.
    a.label("_rt_map_record_probe")
    a.load(0, 18, 96)
    a.vm_add_imm(0, 0, 1)
    a.store(18, 96, 0)
    a.load(0, 18, 104)
    a.add(0, 0, 19)
    a.store(18, 104, 0)
    a.load(0, 18, 112)
    a.cmp(0, 19)
    a.jge("_rt_ms_keep_max")
    a.store(18, 112, 19)
    a.label("_rt_ms_keep_max")
    a.mov(0, 19)
    a.vm_cmp_imm(0, 4096)
    a.jle("_rt_ms_bin")
    a.vm_mov_imm(0, 4096)
    a.label("_rt_ms_bin")
    a.shl_imm(0, 0, 3)
    a.vm_add_imm(0, 0, 144)
    a.add(0, 18, 0)
    a.load(1, 0, 0)
    a.vm_add_imm(1, 1, 1)
    a.store(0, 0, 1)
    a.vm_ret()

    mut keys := []string{}
    keys.push("begin")
    keys.push("live")
    keys.push("used")
    keys.push("deleted")
    keys.push("capacity")
    keys.push("searches")
    keys.push("probes")
    keys.push("max_probe")
    keys.push("grows")
    keys.push("compacts")
    keys.push("probe_bucket")
    keys.push("probe_count")
    keys.push("end")
    keys.push("used_recorded")
    keys.push("deleted_recorded")
    for i in 0:keys.len {
        a.data_label("_rt_ms_key_" + str(i))
        rt_emit_bytes(a, "xu_map_stats " + keys[i] + "=")
    }
    a.label("_rt_map_stats")
    a.prologue(64)
    a.store(15, -8, 18)
    // Independently scan slot states so tests can check the tracked counts.
    a.vm_mov_imm(0, 0)
    a.store(15, -16, 0)
    a.store(15, -40, 0)
    a.store(15, -48, 0)
    a.label("_rt_ms_scan")
    a.load(0, 15, -8)
    a.load(1, 0, 16)
    a.load(2, 15, -16)
    a.cmp(2, 1)
    a.jge("_rt_ms_scan_done")
    a.load(1, 0, 24)
    a.shl_imm(2, 2, 3)
    a.add(1, 1, 2)
    a.load(0, 1, 0)
    a.vm_cbz(0, "_rt_ms_scan_next")
    a.load(1, 15, -40)
    a.vm_add_imm(1, 1, 1)
    a.store(15, -40, 1)
    a.vm_cmp_imm(0, 2)
    a.jne("_rt_ms_scan_next")
    a.load(1, 15, -48)
    a.vm_add_imm(1, 1, 1)
    a.store(15, -48, 1)
    a.label("_rt_ms_scan_next")
    a.load(0, 15, -16)
    a.vm_add_imm(0, 0, 1)
    a.store(15, -16, 0)
    a.jmp("_rt_ms_scan")
    a.label("_rt_ms_scan_done")
    mut offsets := []int{}
    offsets.push(0 - 1)
    offsets.push(8)
    offsets.push(80)
    offsets.push(88)
    offsets.push(16)
    offsets.push(96)
    offsets.push(104)
    offsets.push(112)
    offsets.push(120)
    offsets.push(128)
    for i in 0:offsets.len {
        a.load(0, 15, -8)
        if i == 0 { a.vm_mov_imm(0, 1) } else {
            if i == 2 { a.load(0, 15, -40) } else {
                if i == 3 { a.load(0, 15, -48) } else { a.load(0, 0, offsets[i]) }
            }
        }
        a.store(15, -24, 0)
        key := "xu_map_stats " + keys[i] + "="
        rt_emit_heap_stats_line(a, "_rt_ms_key_" + str(i), key.len, -24)
    }
    for i in 13:15 {
        a.load(0, 15, -8)
        a.load(0, 0, 80 + (i - 13) * 8)
        a.store(15, -24, 0)
        key := "xu_map_stats " + keys[i] + "="
        rt_emit_heap_stats_line(a, "_rt_ms_key_" + str(i), key.len, -24)
    }
    a.vm_mov_imm(0, 0)
    a.store(15, -16, 0)
    a.label("_rt_ms_hist")
    a.load(0, 15, -16)
    a.vm_cmp_imm(0, 4096)
    a.jgt("_rt_ms_end")
    a.shl_imm(1, 0, 3)
    a.vm_add_imm(1, 1, 144)
    a.load(0, 15, -8)
    a.add(1, 0, 1)
    a.load(1, 1, 0)
    a.vm_cbz(1, "_rt_ms_hist_next")
    a.store(15, -24, 1)
    rt_emit_heap_stats_line(a, "_rt_ms_key_10", 26, -16)
    rt_emit_heap_stats_line(a, "_rt_ms_key_11", 25, -24)
    a.label("_rt_ms_hist_next")
    a.load(0, 15, -16)
    a.vm_add_imm(0, 0, 1)
    a.store(15, -16, 0)
    a.jmp("_rt_ms_hist")
    a.label("_rt_ms_end")
    a.vm_mov_imm(0, 1)
    a.store(15, -24, 0)
    rt_emit_heap_stats_line(a, "_rt_ms_key_12", 17, -24)
    a.load(18, 15, -8)
    a.epilogue()
}
