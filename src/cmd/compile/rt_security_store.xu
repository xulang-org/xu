@main

#xu/types

// Minimal platform security-store ABI. It enumerates opaque records and
// frames each as uint32 little-endian length + bytes. No ASN.1 parsing,
// certificate semantics, trust policy or path building lives in the runtime.
//
// On Windows the source is CryptoAPI's named system store. The dynamic API
// keeps crypt32.dll out of the static import table and works for x64/ARM64.

fn rt_security_store_load_u32(a &mut Assembler, base int, off int, dest int) {
    a.load_byte(dest, base, off)
    a.load_byte(3, base, off + 1)
    a.shl_imm(3, 3, 8)
    a.ior(dest, dest, 3)
    a.load_byte(3, base, off + 2)
    a.shl_imm(3, 3, 16)
    a.ior(dest, dest, 3)
    a.load_byte(3, base, off + 3)
    a.shl_imm(3, 3, 24)
    a.ior(dest, dest, 3)
    <<
}

fn rt_security_store_call(a &mut Assembler, fp_off int) {
    a.load(1, 15, fp_off)
    a.vm_call_win_fp(1)
    <<
}

fn rt_emit_security_store(a &mut Assembler) {
    a.align_data(8)
    a.data_label("_rt_security_store_dll")
    rt_emit_bytes(a, "crypt32.dll")
    a.emit_data([0])
    a.data_label("_rt_security_store_open")
    rt_emit_bytes(a, "CertOpenSystemStoreA")
    a.emit_data([0])
    a.data_label("_rt_security_store_enum")
    rt_emit_bytes(a, "CertEnumCertificatesInStore")
    a.emit_data([0])
    a.data_label("_rt_security_store_close")
    rt_emit_bytes(a, "CertCloseStore")
    a.emit_data([0])
    a.data_label("_rt_security_store_free_ctx")
    rt_emit_bytes(a, "CertFreeCertificateContext")
    a.emit_data([0])
    a.data_label("_rt_security_store_error")
    rt_emit_bytes(a, "system security store unavailable")

    // Slots: sret -8, name ptr/len -16/-24, nameZ -32, DLL -40,
    // open/enum/close/free-context fp -48/-56/-64/-72, store -80,
    // current context -88, total -96, output -104, write offset -112,
    // current length -120, copy index -128.
    a.label("_rt_security_store")
    a.prologue(144)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.vm_mov_imm(0, 0)
    a.store(15, -32, 0)
    a.store(15, -40, 0)
    a.store(15, -48, 0)
    a.store(15, -56, 0)
    a.store(15, -64, 0)
    a.store(15, -72, 0)
    a.store(15, -80, 0)
    a.store(15, -88, 0)
    a.store(15, -96, 0)
    a.store(15, -104, 0)
    a.store(15, -112, 0)
    if a.os != 2 {
        a.jmp("_rt_security_store_fail")
    } else {
        // The store name is selected by the standard library; runtime only
        // converts the Xu string into the host ABI's NUL-terminated form.
        a.load(18, 15, -16)
        a.load(19, 15, -24)
        a.call("_rt_cstr")
        a.store(15, -32, 14)

        a.lea(18, "_rt_security_store_dll")
        a.vm_call_iat("_iat_LoadLibraryA")
        a.vm_cbz(14, "_rt_security_store_fail")
        a.store(15, -40, 14)

        a.load(18, 15, -40)
        a.lea(19, "_rt_security_store_open")
        a.vm_call_iat("_iat_GetProcAddress")
        a.vm_cbz(14, "_rt_security_store_fail")
        a.store(15, -48, 14)
        a.load(18, 15, -40)
        a.lea(19, "_rt_security_store_enum")
        a.vm_call_iat("_iat_GetProcAddress")
        a.vm_cbz(14, "_rt_security_store_fail")
        a.store(15, -56, 14)
        a.load(18, 15, -40)
        a.lea(19, "_rt_security_store_close")
        a.vm_call_iat("_iat_GetProcAddress")
        a.vm_cbz(14, "_rt_security_store_fail")
        a.store(15, -64, 14)
        a.load(18, 15, -40)
        a.lea(19, "_rt_security_store_free_ctx")
        a.vm_call_iat("_iat_GetProcAddress")
        a.vm_cbz(14, "_rt_security_store_fail")
        a.store(15, -72, 14)

        // First pass computes an exact bounded output size. CERT_CONTEXT on
        // 64-bit Windows has pbCertEncoded at +8 and cbCertEncoded at +16.
        a.vm_mov_imm(18, 0)
        a.load(19, 15, -32)
        rt_security_store_call(a, -48)
        a.vm_cbz(14, "_rt_security_store_fail")
        a.store(15, -80, 14)
        a.vm_mov_imm(0, 0)
        a.store(15, -88, 0)
        a.store(15, -96, 0)

        a.label("_rt_security_store_size_loop")
        a.load(18, 15, -80)
        a.load(19, 15, -88)
        rt_security_store_call(a, -56)
        a.vm_cbz(14, "_rt_security_store_size_done")
        a.store(15, -88, 14)
        a.mov(1, 14)
        rt_security_store_load_u32(a, 1, 16, 2)
        a.store(15, -120, 2)
        a.vm_cmp_imm(2, 0)
        a.jgt("_rt_security_store_size_len_positive")
        a.jmp("_rt_security_store_fail")
        a.label("_rt_security_store_size_len_positive")
        a.vm_mov_imm64(3, 16777216)
        a.cmp(2, 3)
        a.jle("_rt_security_store_size_len_bounded")
        a.jmp("_rt_security_store_fail")
        a.label("_rt_security_store_size_len_bounded")
        a.load(0, 15, -96)
        a.vm_add_imm(1, 0, 4)
        a.cmp(1, 0)
        a.jae("_rt_security_store_size_prefix_ok")
        a.jmp("_rt_security_store_fail")
        a.label("_rt_security_store_size_prefix_ok")
        a.add(1, 1, 2)
        a.cmp(1, 0)
        a.jae("_rt_security_store_size_sum_ok")
        a.jmp("_rt_security_store_fail")
        a.label("_rt_security_store_size_sum_ok")
        // Defensive 64 MiB bound: system root stores are normally <1 MiB.
        a.vm_mov_imm64(2, 67108864)
        a.cmp(1, 2)
        a.jle("_rt_security_store_size_bounded")
        a.jmp("_rt_security_store_fail")
        a.label("_rt_security_store_size_bounded")
        a.store(15, -96, 1)
        a.jmp("_rt_security_store_size_loop")

        a.label("_rt_security_store_size_done")
        a.vm_mov_imm(0, 0)
        a.store(15, -88, 0)
        a.load(18, 15, -80)
        a.vm_mov_imm(19, 0)
        rt_security_store_call(a, -64)
        a.vm_mov_imm(0, 0)
        a.store(15, -80, 0)
        a.load(0, 15, -96)
        a.vm_cbz(0, "_rt_security_store_empty")
        a.mov(18, 0)
        a.call("_rt_alloc")
        a.store(15, -104, 14)

        // Reopen for a second pass. If the store changes concurrently, the
        // output-bound check below fails closed rather than overrunning.
        a.vm_mov_imm(18, 0)
        a.load(19, 15, -32)
        rt_security_store_call(a, -48)
        a.vm_cbz(14, "_rt_security_store_fail")
        a.store(15, -80, 14)
        a.vm_mov_imm(0, 0)
        a.store(15, -88, 0)
        a.store(15, -112, 0)

        a.label("_rt_security_store_copy_next")
        a.load(18, 15, -80)
        a.load(19, 15, -88)
        rt_security_store_call(a, -56)
        a.vm_cbz(14, "_rt_security_store_copy_done")
        a.store(15, -88, 14)
        a.mov(1, 14)
        rt_security_store_load_u32(a, 1, 16, 2)
        a.store(15, -120, 2)
        a.vm_cmp_imm(2, 0)
        a.jgt("_rt_security_store_copy_len_positive")
        a.jmp("_rt_security_store_fail")
        a.label("_rt_security_store_copy_len_positive")
        a.vm_mov_imm64(3, 16777216)
        a.cmp(2, 3)
        a.jle("_rt_security_store_copy_len_bounded")
        a.jmp("_rt_security_store_fail")
        a.label("_rt_security_store_copy_len_bounded")

        a.load(0, 15, -112)
        a.vm_add_imm(1, 0, 4)
        a.cmp(1, 0)
        a.jae("_rt_security_store_copy_prefix_ok")
        a.jmp("_rt_security_store_fail")
        a.label("_rt_security_store_copy_prefix_ok")
        a.add(1, 1, 2)
        a.cmp(1, 0)
        a.jae("_rt_security_store_copy_sum_ok")
        a.jmp("_rt_security_store_fail")
        a.label("_rt_security_store_copy_sum_ok")
        a.load(2, 15, -96)
        a.cmp(1, 2)
        a.jle("_rt_security_store_copy_bounded")
        a.jmp("_rt_security_store_fail")
        a.label("_rt_security_store_copy_bounded")
        a.store(15, -112, 1)

        // Frame length little-endian at output[old_write..old_write+4].
        a.load(4, 15, -104)
        a.add(4, 4, 0)
        a.load(2, 15, -120)
        for i in 0:4 {
            a.store_byte(4, i, 2)
            if i != 3 { a.shr_imm(2, 2, 8) }
        }

        // Copy DER from CERT_CONTEXT.pbCertEncoded.
        a.load(1, 15, -88)
        a.load(1, 1, 8)
        a.vm_add_imm(4, 4, 4)
        a.vm_mov_imm(0, 0)
        a.store(15, -128, 0)
        a.label("_rt_security_store_copy_bytes")
        a.load(0, 15, -128)
        a.load(2, 15, -120)
        a.cmp(0, 2)
        a.jge("_rt_security_store_copy_entry_done")
        a.add(2, 1, 0)
        a.load_byte(3, 2, 0)
        a.add(2, 4, 0)
        a.store_byte(2, 0, 3)
        a.vm_add_imm(0, 0, 1)
        a.store(15, -128, 0)
        a.jmp("_rt_security_store_copy_bytes")
        a.label("_rt_security_store_copy_entry_done")
        a.jmp("_rt_security_store_copy_next")

        a.label("_rt_security_store_copy_done")
        a.vm_mov_imm(0, 0)
        a.store(15, -88, 0)
        a.load(18, 15, -80)
        a.vm_mov_imm(19, 0)
        rt_security_store_call(a, -64)
        a.vm_mov_imm(0, 0)
        a.store(15, -80, 0)
        a.jmp("_rt_security_store_ok")
    }

    a.label("_rt_security_store_fail")
    // Only an early-abort context is live. A normal failed Enum call frees
    // the previous context and clears -88 before reaching cleanup.
    a.load(18, 15, -88)
    a.vm_cbz(18, "_rt_security_store_fail_no_ctx")
    rt_security_store_call(a, -72)
    a.vm_mov_imm(0, 0)
    a.store(15, -88, 0)
    a.label("_rt_security_store_fail_no_ctx")
    a.load(18, 15, -80)
    a.vm_cbz(18, "_rt_security_store_fail_no_store")
    a.vm_mov_imm(19, 0)
    rt_security_store_call(a, -64)
    a.label("_rt_security_store_fail_no_store")
    a.load(18, 15, -104)
    a.vm_cbz(18, "_rt_security_store_fail_no_output")
    a.call("_rt_free")
    a.label("_rt_security_store_fail_no_output")
    a.load(18, 15, -32)
    a.vm_cbz(18, "_rt_security_store_fail_no_name")
    a.call("_rt_free")
    a.label("_rt_security_store_fail_no_name")
    a.load(18, 15, -40)
    a.vm_cbz(18, "_rt_security_store_fail_throw")
    a.vm_call_iat("_iat_FreeLibrary")
    a.label("_rt_security_store_fail_throw")
    rt_call_throw_strerr_static(a, -8, "_rt_security_store_error", 33)
    a.epilogue()

    a.label("_rt_security_store_empty")
    a.load(18, 15, -32)
    a.call("_rt_free")
    a.load(18, 15, -40)
    a.vm_call_iat("_iat_FreeLibrary")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.store(0, -24, 1)
    a.epilogue()

    a.label("_rt_security_store_ok")
    a.load(18, 15, -32)
    a.call("_rt_free")
    a.load(18, 15, -40)
    a.vm_call_iat("_iat_FreeLibrary")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.load(1, 15, -104)
    a.store(0, -8, 1)
    a.load(1, 15, -112)
    a.store(0, -16, 1)
    a.load(1, 15, -96)
    a.store(0, -24, 1)
    a.epilogue()
}
