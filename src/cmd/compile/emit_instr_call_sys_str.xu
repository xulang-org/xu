@main

#xu/types

// A0=ptr, A1=len, A2=byte; result v0. Caller has spilled volatile homes.
// ARM64 short counts keep the zero-free word skip, but sum exact 0/1 lanes
// on hits. Only V0/V1 and caller-saved GPRs are used, as on the long path.
fn emit_count_byte_short_arm64(a &mut Assembler, n int) {
    tag := str(n)
    a.vm_cmp_imm(19, 32)
    a.jge("_xu_cb2_call_" + tag)
    a.vm_cmp_imm(19, 0)
    a.jle("_xu_cb2_zero_" + tag)
    a.vm_and_imm(20, 20, 255)
    a.vm_mov_imm(6, 0)
    a.vm_mov_imm(7, 0)
    a.vm_cmp_imm(19, 8)
    a.jlt("_xu_cb2_scalar_" + tag)
    a.vm_mov_imm64(2, 72340172838076673)
    a.mul(4, 20, 2)
    a.shl_imm(3, 2, 7)
    a.be_neon_movi_2d0(1)
    a.label("_xu_cb2_word_" + tag)
    a.sub(0, 19, 7)
    a.vm_cmp_imm(0, 8)
    a.jlt("_xu_cb2_tail_" + tag)
    a.add(5, 18, 7)
    a.load(5, 5, 0)
    a.ixor(0, 5, 4)
    a.sub(1, 0, 2)
    a.ixor(5, 0, 3)
    a.iand(1, 1, 5)
    a.iand(1, 1, 3)
    a.vm_cbz(1, "_xu_cb2_next_" + tag)
    // Borrow-generated false zero markers are only an any-match test.
    // The byte equality below determines the exact count independently.
    a.fmov_d_from_x(0, map_reg(0))
    a.be_neon_cmeq_16b(0, 0, 1)
    a.be_neon_ushr_16b(0, 0, 7)
    a.addv_8b(0, 0)
    a.fmov_w_from_s(map_reg(0), 0)
    a.add(6, 6, 0)
    a.label("_xu_cb2_next_" + tag)
    a.vm_add_imm(7, 7, 8)
    a.jmp("_xu_cb2_word_" + tag)
    a.label("_xu_cb2_tail_" + tag)
    a.vm_cbz(0, "_xu_cb2_done_" + tag)
    // One to three remaining bytes cost less as scalar comparisons.
    a.vm_cmp_imm(0, 4)
    a.jlt("_xu_cb2_scalar_" + tag)
    // 1..7 bytes remain and original len>=8. The final word is entirely
    // within the input; shifting removes lanes already counted above.
    a.vm_mov_imm(1, 8)
    a.sub(1, 1, 0)
    a.shl_imm(1, 1, 3)
    a.add(5, 18, 19)
    a.vm_sub_imm(5, 5, 8)
    a.load(5, 5, 0)
    a.ixor(5, 5, 4)
    a.fmov_d_from_x(0, map_reg(5))
    a.be_neon_cmeq_16b(0, 0, 1)
    a.be_neon_ushr_16b(0, 0, 7)
    a.fmov_x_from_d(map_reg(5), 0)
    a.shr(5, 5, 1)
    a.fmov_d_from_x(0, map_reg(5))
    a.addv_8b(0, 0)
    a.fmov_w_from_s(map_reg(0), 0)
    a.add(6, 6, 0)
    a.jmp("_xu_cb2_done_" + tag)
    a.label("_xu_cb2_scalar_" + tag)
    a.cmp(7, 19)
    a.jge("_xu_cb2_done_" + tag)
    a.add(0, 18, 7)
    a.load_byte(0, 0, 0)
    a.cmp(0, 20)
    a.be_cset(0, 0)
    a.add(6, 6, 0)
    a.vm_add_imm(7, 7, 1)
    a.jmp("_xu_cb2_scalar_" + tag)
    a.label("_xu_cb2_done_" + tag)
    a.mov(0, 6)
    a.jmp("_xu_cb2_exit_" + tag)
    a.label("_xu_cb2_zero_" + tag)
    a.vm_mov_imm(0, 0)
    a.jmp("_xu_cb2_exit_" + tag)
    a.label("_xu_cb2_call_" + tag)
    a.call("_rt_count_byte")
    a.mov(0, 14)
    a.label("_xu_cb2_exit_" + tag)
}

fn emit_count_byte_short_x64(a &mut Assembler, n int) {
    tag := str(n)
    a.vm_cmp_imm(19, 16)
    a.jge("_xu_cbx_call_" + tag)
    a.vm_cmp_imm(19, 0)
    a.jle("_xu_cbx_zero_" + tag)

    a.x64_mov_imm32(8, 0)
    a.x64_mov_imm32(1, 0)
    a.x64_and_imm(2, 255)

    a.label("_xu_cbx_loop_" + tag)
    a.x64_load_byte_sib(10, 7, 1, 0, 0)
    a.x64_cmp_reg(10, 2)
    a.x64_setcc(10, 4)
    a.x64_and_imm(10, 255)
    a.x64_add_reg(8, 10)
    a.x64_add_imm(1, 1)
    a.x64_cmp_reg(1, 6)
    a.x64_jcc(2, "_xu_cbx_loop_" + tag)

    a.x64_mov_reg(10, 8)
    a.x64_mov_reg(0, 8)
    a.jmp("_xu_cbx_exit_" + tag)

    a.label("_xu_cbx_zero_" + tag)
    a.x64_mov_imm32(10, 0)
    a.x64_mov_imm32(0, 0)
    a.jmp("_xu_cbx_exit_" + tag)

    a.label("_xu_cbx_call_" + tag)
    a.call("_rt_count_byte")
    a.mov(0, 14)

    a.label("_xu_cbx_exit_" + tag)
}

fn emit_instr_call_sysinfo(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ia := types.mir_ia(m, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    if ib >= 45 && ib <= 51 { // pid/ppid/uid/gid/euid/egid/pagesize → int
        a.call(sysinfo_label(ib))
        a.mov(0, 14)
        a.store(15, slot_off(fr.temp_slot[ia]), 0)
        <<
    }
    if ib == 52 || ib == 53 || ib == 56 { // host_name / cwd / tmp_dir → sret string
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call(sysinfo_label(ib))
        <<
    }
    if ib == 54 { // env_get(name) → sret string
        v0 := types.mir_marg_v(m, fi, ic)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_env_get")
        <<
    }
    if ib == 55 { // env_list() → sret []string
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_env_list")
        <<
    }
    if ib == 99 { // xu_target_os() → compile-time OS code (0 macos / 1 linux / 2 win / 3 none)
        a.vm_mov_imm(0, a.os)
        a.store(15, slot_off(fr.temp_slot[ia]), 0)
        <<
    }
    <<
}

// Wave C: stat/mkdir/rename/remove/os_system — split from emit_instr_call_sys (W3).
fn emit_instr_call_fs(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ia := types.mir_ia(m, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    if ib == 57 || ib == 58 || ib == 60 { // stat / mkdir / remove(path) → sret tagged slot
        v0 := types.mir_marg_v(m, fi, ic)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        if ib == 57 { a.call("_rt_stat") }
        if ib == 58 { a.call("_rt_mkdir") }
        if ib == 60 { a.call("_rt_remove") }
        <<
    }
    if ib == 59 { // rename(old, new) → sret tagged slot
        first := ic
        second := types.mir_marg_next(m, fi, first)
        v0 := types.mir_marg_v(m, fi, first)
        v1 := types.mir_marg_v(m, fi, second)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v1]))
        a.mov(20, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v1]) - 8)
        a.mov(21, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_rename")
        <<
    }
    if ib == 72 { // os_open(path, mode) → sret throw<int>
        first := ic
        second := types.mir_marg_next(m, fi, first)
        v0 := types.mir_marg_v(m, fi, first)
        v1 := types.mir_marg_v(m, fi, second)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        emit_load_value(a, m, fi, fr, v1, 0)
        a.mov(20, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_os_open")
        <<
    }
    if ib == 73 { // os_fd_read(fd, max) → sret throw<string>
        first := ic
        second := types.mir_marg_next(m, fi, first)
        emit_load_value(a, m, fi, fr, types.mir_marg_v(m, fi, first), 0)
        a.mov(18, 0)
        emit_load_value(a, m, fi, fr, types.mir_marg_v(m, fi, second), 0)
        a.mov(19, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_os_fd_read")
        <<
    }
    if ib == 74 { // os_fd_write(fd, data) → sret throw<int>
        first := ic
        second := types.mir_marg_next(m, fi, first)
        emit_load_value(a, m, fi, fr, types.mir_marg_v(m, fi, first), 0)
        a.mov(18, 0)
        v1 := types.mir_marg_v(m, fi, second)
        a.load(0, 15, slot_off(fr.temp_slot[v1]))
        a.mov(19, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v1]) - 8)
        a.mov(20, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_os_fd_write")
        <<
    }
    if ib == 75 { // os_fd_close(fd) → sret throw<int>
        emit_load_value(a, m, fi, fr, types.mir_marg_v(m, fi, ic), 0)
        a.mov(18, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_os_fd_close")
        <<
    }
    if ib == 123 { // os_chmod(path, mode) → sret throw<int>
        first := ic
        second := types.mir_marg_next(m, fi, first)
        v0 := types.mir_marg_v(m, fi, first)
        v1 := types.mir_marg_v(m, fi, second)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        emit_load_value(a, m, fi, fr, v1, 0)
        a.mov(20, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_os_chmod")
        <<
    }
    if ib == 124 { // os_chdir(path) → sret throw<int>
        v0 := types.mir_marg_v(m, fi, ic)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_os_chdir")
        <<
    }
    if ib == 125 { // os_symlink(old, new) → sret throw<int>
        first := ic
        second := types.mir_marg_next(m, fi, first)
        v0 := types.mir_marg_v(m, fi, first)
        v1 := types.mir_marg_v(m, fi, second)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v1]))
        a.mov(20, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v1]) - 8)
        a.mov(21, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_os_symlink")
        <<
    }
    if ib == 126 { // os_readlink(path) → sret throw<string>
        v0 := types.mir_marg_v(m, fi, ic)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_os_readlink")
        <<
    }
    if ib == 127 { // os_fd_seek(fd, offset, whence) → sret throw<int>
        first := ic
        second := types.mir_marg_next(m, fi, first)
        third := types.mir_marg_next(m, fi, second)
        emit_load_value(a, m, fi, fr, types.mir_marg_v(m, fi, first), 0)
        a.mov(18, 0)
        emit_load_value(a, m, fi, fr, types.mir_marg_v(m, fi, second), 0)
        a.mov(19, 0)
        emit_load_value(a, m, fi, fr, types.mir_marg_v(m, fi, third), 0)
        a.mov(20, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_os_fd_seek")
        <<
    }
    if ib == 128 { // os_pipe() → sret throw<int>
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_os_pipe")
        <<
    }
    if ib == 130 { // sys_random_fill(n) → sret throw<string>
        emit_load_value(a, m, fi, fr, types.mir_marg_v(m, fi, ic), 0)
        a.mov(18, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_sys_random_fill")
        <<
    }
    if ib == 137 { // sys_security_store(name) → sret throw<string>
        v0 := types.mir_marg_v(m, fi, ic)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_security_store")
        <<
    }
    if ib == 71 { // os_system(cmd) → int in Ret
        v0 := types.mir_marg_v(m, fi, ic)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        a.call("_rt_os_system")
        a.mov(0, 14)
        a.store(15, slot_off(fr.temp_slot[ia]), 0)
        <<
    }
    if ib == 129 { // os_exec(path, blob, redir) → wait status in Ret
        first := ic
        second := types.mir_marg_next(m, fi, first)
        third := types.mir_marg_next(m, fi, second)
        v0 := types.mir_marg_v(m, fi, first)
        v1 := types.mir_marg_v(m, fi, second)
        v2 := types.mir_marg_v(m, fi, third)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v1]))
        a.mov(20, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v1]) - 8)
        a.mov(21, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v2]))
        a.mov(22, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v2]) - 8)
        a.mov(23, 0)
        a.call("_rt_os_exec")
        a.mov(0, 14)
        a.store(15, slot_off(fr.temp_slot[ia]), 0)
        <<
    }
    if ib == 100 { // ui_host_run(tmp) → int in Ret (not 83: that is array slice)
        v0 := types.mir_marg_v(m, fi, ic)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        a.call("_rt_ui_host_run")
        a.mov(0, 14)
        a.store(15, slot_off(fr.temp_slot[ia]), 0)
        <<
    }
    <<
}

// Wave C: atomic_load/store/add/cas — split from emit_instr_call_sys (W3).
fn emit_instr_call_atomic(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ia := types.mir_ia(m, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    if ib == 61 { // atomic_load(mut &x) → int
        v0 := types.mir_marg_v(m, fi, ic)
        emit_load_value(a, m, fi, fr, v0, 0)
        a.vm_atomic_load(1, 0)
        a.store(15, slot_off(fr.temp_slot[ia]), 1)
        <<
    }
    if ib == 62 { // atomic_store(mut &x, v)
        v0 := types.mir_marg_v(m, fi, ic)
        v1 := types.mir_marg_v(m, fi, types.mir_marg_next(m, fi, ic))
        emit_load_value(a, m, fi, fr, v0, 0)
        emit_load_value(a, m, fi, fr, v1, 1)
        a.vm_atomic_store(0, 1)
        <<
    }
    if ib == 63 { // atomic_add(mut &x, d) → int (old value)
        v0 := types.mir_marg_v(m, fi, ic)
        v1 := types.mir_marg_v(m, fi, types.mir_marg_next(m, fi, ic))
        emit_load_value(a, m, fi, fr, v0, 0)
        emit_load_value(a, m, fi, fr, v1, 1)
        a.vm_atomic_add(2, 0, 1)
        a.store(15, slot_off(fr.temp_slot[ia]), 2)
        <<
    }
    if ib == 64 { // atomic_cas(mut &x, old, new) → bool
        v0 := types.mir_marg_v(m, fi, ic)
        v1 := types.mir_marg_v(m, fi, types.mir_marg_next(m, fi, ic))
        v2 := types.mir_marg_v(m, fi, types.mir_marg_next(m, fi, types.mir_marg_next(m, fi, ic)))
        emit_load_value(a, m, fi, fr, v0, 0)
        emit_load_value(a, m, fi, fr, v1, 1)
        emit_load_value(a, m, fi, fr, v2, 2)
        a.vm_atomic_cas(3, 0, 1, 2)
        a.store(15, slot_off(fr.temp_slot[ia]), 3)
        <<
    }
    <<
}

fn emit_instr_call_sys(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ib := types.mir_ib(m, fi, ii)
    if (ib >= 65 && ib <= 70) || ib == 93 || ib == 94 || ib == 96 || ib == 97 || ib == 104 || ib == 121 || ib == 131 || ib == 132 || ib == 133 || ib == 134 || ib == 135 || ib == 138 || ib == 156 {
        emit_instr_call_net(a, m, fi, fr, ii)
        <<
    }
    if ib >= 45 && ib <= 56 || ib == 99 {
        emit_instr_call_sysinfo(a, m, fi, fr, ii)
        <<
    }
    if (ib >= 57 && ib <= 60) || ib == 71 || ib == 129 || ib == 130 || ib == 137 || ib == 100 || (ib >= 72 && ib <= 75) || (ib >= 123 && ib <= 128) {
        emit_instr_call_fs(a, m, fi, fr, ii)
        <<
    }
    if ib >= 61 && ib <= 64 {
        emit_instr_call_atomic(a, m, fi, fr, ii)
        <<
    }
    <<
}

fn pb_invalidate(a &mut Assembler) {
    a.pb_recv = -1
    a.pb_local = -1
}

fn pb_cache_ok(a &Assembler, fr &Frame) bool {
    if a.arch != 0 { << false }
    if a.cs_pairs < 3 { << false }
    if a.rc_on && a.rc_s_pool { << false }
    if frame_vreg_uses_s_regs(fr) { << false }
    << true
}

fn pb_addr_local(m &types.Mir, fi int, v0 int) int {
    mut loc := -1
    for ji in 0:types.mir_nins(m, fi) {
        if types.mir_ikind(m, fi, ji) == types.MI_ADDR && types.mir_ic(m, fi, ji) == 0 {
            if types.mir_ia(m, fi, ji) == v0 {
                loc = types.mir_ib(m, fi, ji)
            }
        }
    }
    << loc
}

// A call or a store of the cached string drops S1–S4. Other scalar ops
// in the same block do not use those callee-saved registers.
fn pb_guard(a &mut Assembler, m &types.Mir, fi int, ii int) {
    if a.pb_local < 0 { << }
    k := types.mir_ikind(m, fi, ii)
    if k == types.MI_CALL {
        if types.mir_ib(m, fi, ii) != 122 {
            pb_invalidate(a)
        }
        <<
    }
    if k == types.MI_STORE_LOCAL {
        if types.mir_ia(m, fi, ii) == a.pb_local {
            pb_invalidate(a)
        }
        <<
    }
    if k == types.MI_DROP {
        pb_invalidate(a)
    }
}

fn pb_forget_local(a &mut Assembler, fr &Frame, loc int) {
    if loc >= 0 && loc < fr.local_slot.len {
        base := fr.local_slot[loc]
        rc_forget_slot(a, base)
        rc_forget_slot(a, base + 1)
        rc_forget_slot(a, base + 2)
    }
}

fn pb_reload(a &mut Assembler, fr &Frame, v0 int) {
    a.load(0, 15, slot_off(fr.temp_slot[v0]))
    a.mov(9, 0)
    a.load(10, 9, 0)
    a.load(11, 9, -8)
    a.load(12, 9, -16)
}

fn pb_spill_scratch(a &mut Assembler) {
    if !a.rc_on { << }
    rc_spill_one(a, 0)
    rc_spill_one(a, 1)
    rc_spill_one(a, 6)
    rc_clobber(a, 0)
    rc_clobber(a, 1)
    rc_clobber(a, 6)
}

// Wave C: push_str — split from emit_instr_call_str (W3).
// When cap >= len+suf_len and cap > 0, inline the in-place append (string_build
// hot path); grow / static still call `_rt_push_str`.
fn emit_instr_call_str_push(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ib := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    if ib == 5 { // rt_push_str(receiver_str, suffix_ptr, suffix_len)
        if ic < 0 {
            <<
        }
        v0 := types.mir_marg_v(m, fi, ic)
        v1 := types.mir_marg_v(m, fi, types.mir_marg_next(m, fi, ic))
        slow := "_ps_slow_" + str(fi) + "_" + str(ii)
        done := "_ps_done_" + str(fi) + "_" + str(ii)
        copy := "_ps_copy_" + str(fi) + "_" + str(ii)
        cdone := "_ps_cdone_" + str(fi) + "_" + str(ii)
        // Probe uses V0–V7; spill V parks first (keeps S pins for loop `i`).
        rc_spill_across_call(a)
        // A0 = &string
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        // V1=ptr V2=len V3=cap; V4=suf_ptr V5=suf_len; V6=new_len
        a.load(1, 18, 0)
        a.load(2, 18, -8)
        a.load(3, 18, -16)
        a.load(4, 15, slot_off(fr.temp_slot[v1]))
        a.load(5, 15, slot_off(fr.temp_slot[v1]) - 8)
        a.add(6, 2, 5)
        a.vm_cbz(3, slow + "")
        a.cmp(3, 6)
        a.jlt(slow + "")
        // dest = ptr + len. Copy 8-byte chunks then a byte tail.
        // Do not use V7: O1 hoists the loop limit there (`i < 100000`).
        a.add(1, 1, 2)
        copy8 := "_ps_c8_" + str(fi) + "_" + str(ii)
        ctail := "_ps_ct_" + str(fi) + "_" + str(ii)
        a.label(copy8 + "")
        a.vm_cmp_imm(5, 8)
        a.jlt(ctail + "")
        a.load(0, 4, 0)
        a.store(1, 0, 0)
        a.vm_add_imm(4, 4, 8)
        a.vm_add_imm(1, 1, 8)
        a.vm_sub_imm(5, 5, 8)
        a.jmp(copy8 + "")
        a.label(ctail + "")
        a.vm_mov_imm(3, 0)
        a.label(copy + "")
        a.cmp(3, 5)
        a.jge(cdone + "")
        a.add(0, 4, 3)
        a.load_byte(0, 0, 0)
        a.add(2, 1, 3)
        a.store_byte(2, 0, 0)
        a.vm_add_imm(3, 3, 1)
        a.jmp(copy + "")
        a.label(cdone + "")
        a.store(18, -8, 6)
        if a.rc_const_vr == 7 {
            a.vm_mov_imm64(7, a.rc_const_val)
        }
        // Drop parks of the string local if &s came from AddrOf.
        mut loc := -1
        for ji in 0:types.mir_nins(m, fi) {
            if types.mir_ikind(m, fi, ji) == types.MI_ADDR && types.mir_ic(m, fi, ji) == 0 {
                if types.mir_ia(m, fi, ji) == v0 {
                    loc = types.mir_ib(m, fi, ji)
                }
            }
        }
        if loc >= 0 && loc < fr.local_slot.len {
            base := fr.local_slot[loc]
            rc_forget_slot(a, base)
            rc_forget_slot(a, base + 1)
            rc_forget_slot(a, base + 2)
        }
        a.jmp(done + "")
        a.label(slow + "")
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v1]))
        a.mov(19, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v1]) - 8)
        a.mov(20, 0)
        a.call("_rt_push_str")
        if a.rc_const_vr == 7 {
            a.vm_mov_imm64(7, a.rc_const_val)
        }
        a.label(done + "")
        <<
    }
    if ib == 122 { // push_byte(&string, byte int)
        if ic < 0 {
            <<
        }
        v0 := types.mir_marg_v(m, fi, ic)
        v1 := types.mir_marg_v(m, fi, types.mir_marg_next(m, fi, ic))
        slow := "_pb_slow_" + str(fi) + "_" + str(ii)
        done := "_pb_done_" + str(fi) + "_" + str(ii)
        locb := pb_addr_local(m, fi, v0)
        // S1=&string, S2=ptr, S3=len, S4=cap. Both the in-place path and
        // the grow path leave those registers matching memory.
        if pb_cache_ok(&*a, fr) && locb >= 0 && a.pb_local == locb {
            pb_spill_scratch(a)
            a.mov(6, 11)
            a.vm_add_imm(6, 6, 1)
            a.cmp(12, 6)
            a.jlt(slow + "")
            a.add(1, 10, 11)
            a.load(0, 15, slot_off(fr.temp_slot[v1]))
            a.store_byte(1, 0, 0)
            a.store(9, -8, 6)
            a.mov(11, 6)
            pb_forget_local(a, fr, locb)
            a.jmp(done + "")
            a.label(slow + "")
            rc_spill_across_call(a)
            a.load(0, 15, slot_off(fr.temp_slot[v0]))
            a.mov(18, 0)
            a.mov(19, 15)
            a.vm_sub_imm(19, 19, 0 - slot_off(fr.temp_slot[v1]))
            a.vm_mov_imm(20, 1)
            a.call("_rt_push_str")
            pb_reload(a, fr, v0)
            if a.rc_const_vr == 7 {
                a.vm_mov_imm64(7, a.rc_const_val)
            }
            a.label(done + "")
            a.pb_recv = v0
            a.pb_local = locb
            <<
        }
        rc_spill_across_call(a)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(1, 18, 0)
        a.load(2, 18, -8)
        a.load(3, 18, -16)
        a.vm_add_imm(6, 2, 1)
        a.vm_cbz(3, slow + "")
        a.cmp(3, 6)
        a.jlt(slow + "")
        if pb_cache_ok(&*a, fr) && locb >= 0 {
            a.mov(9, 18)
            a.mov(10, 1)
            a.mov(12, 3)
            a.pb_recv = v0
            a.pb_local = locb
        } else {
            pb_invalidate(a)
        }
        a.add(1, 1, 2)
        a.load(0, 15, slot_off(fr.temp_slot[v1]))
        a.store_byte(1, 0, 0)
        a.store(18, -8, 6)
        if a.pb_local == locb && locb >= 0 {
            a.mov(11, 6)
        }
        if a.rc_const_vr == 7 {
            a.vm_mov_imm64(7, a.rc_const_val)
        }
        pb_forget_local(a, fr, locb)
        a.jmp(done + "")
        a.label(slow + "")
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.mov(19, 15)
        a.vm_sub_imm(19, 19, 0 - slot_off(fr.temp_slot[v1]))
        a.vm_mov_imm(20, 1)
        a.call("_rt_push_str")
        if pb_cache_ok(&*a, fr) && locb >= 0 {
            pb_reload(a, fr, v0)
            a.pb_recv = v0
            a.pb_local = locb
        } else {
            pb_invalidate(a)
        }
        if a.rc_const_vr == 7 {
            a.vm_mov_imm64(7, a.rc_const_val)
        }
        a.label(done + "")
        <<
    }
    <<
}

// Drop dirty parks for an sret destination so a later rc_spill cannot
// write stale words over the callee's store (container_ring / O1).
fn rc_forget_sret_dest(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ia int) {
    if ia < 0 {
        <<
    }
    base := fr.temp_slot[ia]
    if !is_frame_slot(base) {
        <<
    }
    ns := types.mir_temp_nslots(m, fi, ia)
    for w in 0:ns {
        rc_forget_slot(a, base + w)
    }
    <<
}

// Wave C: str/itoa/from_byte/from_bytes/bool — split from emit_instr_call_str (W3).
fn emit_load_str_abi(a &mut Assembler, m &types.Mir, fi int, fr &Frame, v int) {
    slot := fr.temp_slot[v]
    mut ns := 3
    if v >= 0 && v < types.mir_ntemps(m, fi) {
        ns = types.mir_temp_nslots(m, fi, v)
    }
    if ns == 1 {
        a.load(0, 15, slot_off(slot))
        a.load(1, 0, 0)
        a.mov(18, 1)
        a.load(1, 0, -8)
        a.mov(19, 1)
        <<
    }
    a.load(0, 15, slot_off(slot))
    a.mov(18, 0)
    a.load(0, 15, slot_off(slot) - 8)
    a.mov(19, 0)
}

fn emit_instr_call_str_conv(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ia := types.mir_ia(m, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    if ib == 164 { // split_byte(string, byte) → owned []string, shared slab
        rc_spill_across_call(a)
        rc_forget_sret_dest(a, m, fi, fr, ia)
        v0 := types.mir_marg_v(m, fi, ic)
        emit_load_str_abi(a, m, fi, fr, v0)
        nxt := types.mir_marg_next(m, fi, ic)
        emit_load_value(a, m, fi, fr, types.mir_marg_v(m, fi, nxt), 0)
        a.mov(20, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_split_byte")
        <<
    }
    if ib == 165 { // join_strings([]string, sep) → owned string
        rc_spill_across_call(a)
        rc_forget_sret_dest(a, m, fi, fr, ia)
        nxt := types.mir_marg_next(m, fi, ic)
        emit_load_str_abi(a, m, fi, fr, types.mir_marg_v(m, fi, nxt))
        a.mov(20, 18)
        a.mov(21, 19)
        v0 := types.mir_marg_v(m, fi, ic)
        emit_load_str_abi(a, m, fi, fr, v0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_join")
        <<
    }
    if ib == 162 || ib == 163 {
        rc_spill_across_call(a)
        v0 := types.mir_marg_v(m, fi, ic)
        emit_load_str_abi(a, m, fi, fr, v0)
        nxt := types.mir_marg_next(m, fi, ic)
        emit_load_value(a, m, fi, fr, types.mir_marg_v(m, fi, nxt), 0)
        a.mov(20, 0)
        if ib == 163 {
            nxt2 := types.mir_marg_next(m, fi, nxt)
            emit_load_value(a, m, fi, fr, types.mir_marg_v(m, fi, nxt2), 0)
            a.mov(21, 0)
            a.call("_rt_find_byte")
            a.mov(0, 14)
            if ia >= 0 && ia < fr.temp_slot.len && is_vreg_slot(fr.temp_slot[ia]) {
                a.mov(vreg_slot_home(fr.temp_slot[ia]), 0)
            } else {
                a.store(15, slot_off(fr.temp_slot[ia]), 0)
            }
            <<
        }
        // Keep short inputs inline; exact lane sums replace matching-word
        // rescans and the bounded overlapping tail avoids a byte loop.
        if a.arch == 0 {
            a.drop_seq = a.drop_seq + 1
            emit_count_byte_short_arm64(a, a.drop_seq)
            if ia >= 0 && ia < fr.temp_slot.len && is_vreg_slot(fr.temp_slot[ia]) {
                a.mov(vreg_slot_home(fr.temp_slot[ia]), 0)
            } else {
                a.store(15, slot_off(fr.temp_slot[ia]), 0)
            }
            <<
        }
        if a.arch == 1 {
            a.drop_seq = a.drop_seq + 1
            emit_count_byte_short_x64(a, a.drop_seq)
            if ia >= 0 && ia < fr.temp_slot.len && is_vreg_slot(fr.temp_slot[ia]) {
                a.mov(vreg_slot_home(fr.temp_slot[ia]), 0)
            } else {
                a.store(15, slot_off(fr.temp_slot[ia]), 0)
            }
            <<
        }
        if a.arch == 2 || a.arch == 3 {
            a.call("_rt_count_byte")
            a.mov(0, 14)
            if ia >= 0 && ia < fr.temp_slot.len && is_vreg_slot(fr.temp_slot[ia]) {
                a.mov(vreg_slot_home(fr.temp_slot[ia]), 0)
            } else {
                a.store(15, slot_off(fr.temp_slot[ia]), 0)
            }
            <<
        }
        mut scan_count := 6
        mut scan_offset := 7
        if a.arch == 1 { scan_count = 22
            scan_offset = 23 }
        // Under 32 bytes, one register-only word test covers eight bytes.
        // The framed 16-byte scan stays for longer inputs.
        a.drop_seq = a.drop_seq + 1
        n := a.drop_seq
        a.vm_cmp_imm(19, 32)
        a.jge("_xu_cbc_" + str(n))
        a.vm_cmp_imm(19, 0)
        a.jle("_xu_cbz_" + str(n))
        a.vm_and_imm(20, 20, 255)
        a.vm_mov_imm(2, 1)
        a.shl_imm(0, 2, 8)
        a.ior(2, 2, 0)
        a.shl_imm(0, 2, 16)
        a.ior(2, 2, 0)
        a.shl_imm(0, 2, 32)
        a.ior(2, 2, 0)
        a.mul(4, 20, 2)
        a.shl_imm(3, 2, 7)
        a.vm_mov_imm(scan_count, 0)
        a.vm_mov_imm(scan_offset, 0)
        a.label("_xu_cbw_" + str(n))
        a.cmp(scan_offset, 19)
        a.jge("_xu_cbd_" + str(n))
        a.sub(0, 19, scan_offset)
        a.vm_cmp_imm(0, 8)
        a.jlt("_xu_cbt_" + str(n))
        a.add(5, 18, scan_offset)
        a.load(5, 5, 0)
        a.ixor(0, 5, 4)
        a.sub(1, 0, 2)
        a.vm_mov_imm64(5, 0 - 1)
        a.ixor(5, 0, 5)
        a.iand(1, 1, 5)
        a.iand(1, 1, 3)
        a.vm_cmp_imm(1, 0)
        a.jne("_xu_cb8_" + str(n))
        a.vm_add_imm(scan_offset, scan_offset, 8)
        a.jmp("_xu_cbw_" + str(n))
        a.label("_xu_cb8_" + str(n))
        a.vm_mov_imm(1, 0)
        a.label("_xu_cb8l_" + str(n))
        a.vm_cmp_imm(1, 8)
        a.jge("_xu_cb8d_" + str(n))
        a.add(0, scan_offset, 1)
        a.add(0, 18, 0)
        a.load_byte(0, 0, 0)
        a.cmp(0, 20)
        a.jne("_xu_cb8n_" + str(n))
        a.vm_add_imm(scan_count, scan_count, 1)
        a.label("_xu_cb8n_" + str(n))
        a.vm_add_imm(1, 1, 1)
        a.jmp("_xu_cb8l_" + str(n))
        a.label("_xu_cb8d_" + str(n))
        a.vm_add_imm(scan_offset, scan_offset, 8)
        a.jmp("_xu_cbw_" + str(n))
        a.label("_xu_cbt_" + str(n))
        a.cmp(scan_offset, 19)
        a.jge("_xu_cbd_" + str(n))
        a.add(0, 18, scan_offset)
        a.load_byte(0, 0, 0)
        a.cmp(0, 20)
        a.jne("_xu_cbtn_" + str(n))
        a.vm_add_imm(scan_count, scan_count, 1)
        a.label("_xu_cbtn_" + str(n))
        a.vm_add_imm(scan_offset, scan_offset, 1)
        a.jmp("_xu_cbt_" + str(n))
        a.label("_xu_cbd_" + str(n))
        a.mov(0, scan_count)
        a.jmp("_xu_cbs_" + str(n))
        a.label("_xu_cbz_" + str(n))
        a.vm_mov_imm(0, 0)
        a.jmp("_xu_cbs_" + str(n))
        a.label("_xu_cbc_" + str(n))
        a.call("_rt_count_byte")
        a.mov(0, 14)
        a.label("_xu_cbs_" + str(n))
        a.store(15, slot_off(fr.temp_slot[ia]), 0)
        <<
    }
    if ib == 6 || ib == 10 { // str(int) / string_from_byte(int)
        // S pins survive spill_across_call; forget dest before sret fills it.
        rc_forget_sret_dest(a, m, fi, fr, ia)
        v0 := types.mir_marg_v(m, fi, ic)
        emit_load_value(a, m, fi, fr, v0, 0)
        a.mov(18, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        if ib == 6 {
            eprintln("emit: str(int) must bind to runtime.itoa")
        } else {
            a.call("_rt_str_from_byte")
        }
        <<
    }
    if ib == 21 { // str(bool) → static "true"/"false", cap 0
        v0 := types.mir_marg_v(m, fi, ic)
        emit_load_value(a, m, fi, fr, v0, 0)
        a.drop_seq = a.drop_seq + 1
        n := a.drop_seq
        off := slot_off(fr.temp_slot[ia])
        a.vm_cbz(0, "_xustrb_f_" + str(n))
        a.lea(0, "_xu_str_true")
        a.store(15, off, 0)
        a.vm_mov_imm(0, 4)
        a.store(15, off - 8, 0)
        a.vm_mov_imm(0, 0)
        a.store(15, off - 16, 0)
        a.jmp("_xustrb_d_" + str(n))
        a.label("_xustrb_f_" + str(n))
        a.lea(0, "_xu_str_false")
        a.store(15, off, 0)
        a.vm_mov_imm(0, 5)
        a.store(15, off - 8, 0)
        a.vm_mov_imm(0, 0)
        a.store(15, off - 16, 0)
        a.label("_xustrb_d_" + str(n))
        <<
    }
    if ib == 11 { // string_from_bytes: dynamic descriptor or fixed frame array
        rc_spill_across_call(a)
        rc_forget_sret_dest(a, m, fi, fr, ia)
        v0 := types.mir_marg_v(m, fi, ic)
        fixed_len := types.mir_id(m, fi, ii)
        if fixed_len > 0 {
            emit_load_value(a, m, fi, fr, v0, 0)
            a.mov(18, 0)
            a.vm_mov_imm(19, fixed_len)
        } else {
            a.load(0, 15, slot_off(fr.temp_slot[v0]))
            a.mov(18, 0)
            a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
            a.mov(19, 0)
        }
        start_arg := types.mir_marg_next(m, fi, ic)
        if start_arg >= 0 {
            end_arg := types.mir_marg_next(m, fi, start_arg)
            emit_load_value(a, m, fi, fr, types.mir_marg_v(m, fi, start_arg), 0)
            a.mov(20, 0)
            emit_load_value(a, m, fi, fr, types.mir_marg_v(m, fi, end_arg), 0)
            a.mov(21, 0)
        }
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        if start_arg >= 0 {
            if fixed_len > 0 { a.call("_rt_str_from_fixed_bytes_range") } else { a.call("_rt_str_from_bytes_range") }
        } else {
            if fixed_len > 0 { a.call("_rt_str_from_fixed_bytes") } else { a.call("_rt_str_from_bytes") }
        }
        <<
    }
    if ib == 160 { // make_ints(n) → owned zeroed []int
        rc_spill_across_call(a)
        rc_forget_sret_dest(a, m, fi, fr, ia)
        v0 := types.mir_marg_v(m, fi, ic)
        emit_load_value(a, m, fi, fr, v0, 0)
        a.mov(18, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_make_ints")
        <<
    }
    if ib == 161 { // make_string(n) → owned zeroed string
        rc_spill_across_call(a)
        rc_forget_sret_dest(a, m, fi, fr, ia)
        v0 := types.mir_marg_v(m, fi, ic)
        emit_load_value(a, m, fi, fr, v0, 0)
        a.mov(18, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_make_string")
        <<
    }
    if ib == 81 || ib == 82 { // s.bytes() / s.runes() → []int
        rc_forget_sret_dest(a, m, fi, fr, ia)
        v0 := types.mir_marg_v(m, fi, ic)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        eprintln("emit: bytes/runes must bind to runtime")
        <<
    }
    <<
}

// Wave C: parse_int/starts_with/slice — split from emit_instr_call_str (W3).
fn emit_instr_call_str_ops(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ia := types.mir_ia(m, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    if ib == 25 { // parse_int(string) → sret throw slot
        v0 := types.mir_marg_v(m, fi, ic)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        eprintln("emit: parse_int must bind to runtime.parse_int")
        <<
    }
    if ib == 26 { // starts_with(s, prefix) → bool in Ret
        first := ic
        second := types.mir_marg_next(m, fi, first)
        v0 := types.mir_marg_v(m, fi, first)
        v1 := types.mir_marg_v(m, fi, second)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v1]))
        a.mov(20, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v1]) - 8)
        a.mov(21, 0)
        eprintln("emit: starts_with must bind to runtime.starts_with")
        a.mov(0, 14)
        a.store(15, slot_off(fr.temp_slot[ia]), 0)
        <<
    }
    if ib == 20 { // string slice
        a0i := ic
        a1i := types.mir_marg_next(m, fi, a0i)
        a2i := types.mir_marg_next(m, fi, a1i)
        sv := types.mir_marg_v(m, fi, a0i)
        start := types.mir_marg_v(m, fi, a1i)
        end := types.mir_marg_v(m, fi, a2i)
        a.load(0, 15, slot_off(fr.temp_slot[sv]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[sv]) - 8)
        a.mov(19, 0)
        emit_load_value(a, m, fi, fr, start, 0)
        a.mov(20, 0)
        emit_load_value(a, m, fi, fr, end, 0)
        a.mov(21, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_str_slice")
        <<
    }
    if ib == 83 { // array slice (MS9d): A0=&desc, A1=start, A2=end, A3=elem_size
        a0i := ic
        a1i := types.mir_marg_next(m, fi, a0i)
        a2i := types.mir_marg_next(m, fi, a1i)
        desc := types.mir_marg_v(m, fi, a0i)
        start := types.mir_marg_v(m, fi, a1i)
        end := types.mir_marg_v(m, fi, a2i)
        a.load(0, 15, slot_off(fr.temp_slot[desc]))
        a.mov(18, 0)
        emit_load_value(a, m, fi, fr, start, 0)
        a.mov(19, 0)
        emit_load_value(a, m, fi, fr, end, 0)
        a.mov(20, 0)
        if types.mir_isval(m, fi, ii) != "_rt_array_slice_str" {
            a.vm_mov_imm(21, types.mir_id(m, fi, ii))
        }
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call(types.mir_isval(m, fi, ii))
        <<
    }
    <<
}

fn emit_instr_call_str(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ib := types.mir_ib(m, fi, ii)
    if ib == 5 || ib == 122 {
        emit_instr_call_str_push(a, m, fi, fr, ii)
        <<
    }
    if ib == 6 || ib == 10 || ib == 11 || ib == 21 || ib == 81 || ib == 82 || ib == 160 || ib == 161 || ib == 162 || ib == 163 || ib == 164 || ib == 165 {
        emit_instr_call_str_conv(a, m, fi, fr, ii)
        <<
    }
    if ib == 20 || ib == 25 || ib == 26 || ib == 83 {
        emit_instr_call_str_ops(a, m, fi, fr, ii)
        <<
    }
    <<
}
