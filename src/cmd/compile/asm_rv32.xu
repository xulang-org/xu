@main
// RV32IM assembler for Gen1 (E7): enough for the freestanding runtime
// (integer ops, lw/sw/lb/sb, branches, jal/jalr, csr, wfi).
// Port of bootstrap/crates/xuasm/src/riscv32.rs.
//
// Register numbers are raw RV32 GPRs (0 = x0). Virtual registers map in
// be_rv32.xu. Fixup kinds: 10 = Jal (rd in .rd), 11 = LuiAddi (rd in .rd).

fn (a &mut Assembler) r_emit32(word int) { a.emit32(word) }

fn (a &mut Assembler) r_r_op(rd int, rs1 int, rs2 int, f3 int, f7 int) {
    a.r_emit32((f7 << 25) | ((rs2 & 31) << 20) | ((rs1 & 31) << 15) | (f3 << 12) | ((rd & 31) << 7) | 0x33)
}

// Raw encoders must reject operands they cannot represent. Backend helpers
// materialize large offsets before reaching these final encoding seams.
fn rv_require_i12(imm int) {
    if imm < -2048 || imm > 2047 {
        eprintln("error: RISC-V immediate out of signed 12-bit range: " + str(imm))
        <<< 1
    }
}

fn (a &mut Assembler) r_addi(rd int, rs1 int, imm int) {
    rv_require_i12(imm)
    i := imm & 0xFFF
    a.r_emit32((i << 20) | ((rs1 & 31) << 15) | ((rd & 31) << 7) | 0x13)
}

fn (a &mut Assembler) r_andi(rd int, rs1 int, imm int) {
    i := imm & 0xFFF
    a.r_emit32((i << 20) | ((rs1 & 31) << 15) | (7 << 12) | ((rd & 31) << 7) | 0x13)
}

fn (a &mut Assembler) r_lui(rd int, imm20 int) {
    a.r_emit32(((imm20 & 0xFFFFF) << 12) | ((rd & 31) << 7) | 0x37)
}

fn (a &mut Assembler) r_add(rd int, rs1 int, rs2 int) { a.r_r_op(rd, rs1, rs2, 0, 0x00) }
fn (a &mut Assembler) r_sub(rd int, rs1 int, rs2 int) { a.r_r_op(rd, rs1, rs2, 0, 0x20) }
fn (a &mut Assembler) r_and(rd int, rs1 int, rs2 int) { a.r_r_op(rd, rs1, rs2, 7, 0x00) }
fn (a &mut Assembler) r_or(rd int, rs1 int, rs2 int)  { a.r_r_op(rd, rs1, rs2, 6, 0x00) }
fn (a &mut Assembler) r_xor(rd int, rs1 int, rs2 int) { a.r_r_op(rd, rs1, rs2, 4, 0x00) }
fn (a &mut Assembler) r_sll(rd int, rs1 int, rs2 int) { a.r_r_op(rd, rs1, rs2, 1, 0x00) }
fn (a &mut Assembler) r_srl(rd int, rs1 int, rs2 int) { a.r_r_op(rd, rs1, rs2, 5, 0x00) }
fn (a &mut Assembler) r_sra(rd int, rs1 int, rs2 int) { a.r_r_op(rd, rs1, rs2, 5, 0x20) }
fn (a &mut Assembler) r_mul(rd int, rs1 int, rs2 int) { a.r_r_op(rd, rs1, rs2, 0, 0x01) }
fn (a &mut Assembler) r_div(rd int, rs1 int, rs2 int) { a.r_r_op(rd, rs1, rs2, 4, 0x01) }
fn (a &mut Assembler) r_rem(rd int, rs1 int, rs2 int) { a.r_r_op(rd, rs1, rs2, 6, 0x01) }
fn (a &mut Assembler) r_slt(rd int, rs1 int, rs2 int) { a.r_r_op(rd, rs1, rs2, 2, 0x00) }
fn (a &mut Assembler) r_sltu(rd int, rs1 int, rs2 int) { a.r_r_op(rd, rs1, rs2, 3, 0x00) }

fn (a &mut Assembler) r_slli(rd int, rs1 int, sh int) {
    a.r_emit32(((sh & 31) << 20) | ((rs1 & 31) << 15) | (1 << 12) | ((rd & 31) << 7) | 0x13)
}

fn (a &mut Assembler) r_srli(rd int, rs1 int, sh int) {
    a.r_emit32(((sh & 31) << 20) | ((rs1 & 31) << 15) | (5 << 12) | ((rd & 31) << 7) | 0x13)
}

fn (a &mut Assembler) r_lw(rd int, rs1 int, off int) {
    rv_require_i12(off)
    i := off & 0xFFF
    a.r_emit32((i << 20) | ((rs1 & 31) << 15) | (2 << 12) | ((rd & 31) << 7) | 0x03)
}

fn (a &mut Assembler) r_sw(rs2 int, rs1 int, off int) {
    rv_require_i12(off)
    i := off & 0xFFF
    a.r_emit32(((i >> 5) << 25) | ((rs2 & 31) << 20) | ((rs1 & 31) << 15) | (2 << 12) | ((i & 0x1F) << 7) | 0x23)
}

fn (a &mut Assembler) r_lb(rd int, rs1 int, off int) {
    rv_require_i12(off)
    i := off & 0xFFF
    a.r_emit32((i << 20) | ((rs1 & 31) << 15) | ((rd & 31) << 7) | 0x03)
}

fn (a &mut Assembler) r_sb(rs2 int, rs1 int, off int) {
    rv_require_i12(off)
    i := off & 0xFFF
    a.r_emit32(((i >> 5) << 25) | ((rs2 & 31) << 20) | ((rs1 & 31) << 15) | ((i & 0x1F) << 7) | 0x23)
}

fn (a &mut Assembler) r_mov(rd int, rs int) { a.r_addi(rd, rs, 0) }

fn (a &mut Assembler) r_li32(rd int, imm int) {
    u := imm & 0xFFFFFFFF
    if u + 2048 < 4096 {
        a.r_addi(rd, 0, imm)
        <<
    }
    lo := (imm << 52) >> 52 // sign-extend low 12 bits (i64 arithmetic)
    hi := (u - (lo & 0xFFFFFFFF)) >> 12
    a.r_lui(rd, hi)
    if lo != 0 {
        a.r_addi(rd, rd, lo)
    }
}

fn (a &mut Assembler) r_lea_abs(rd int, label string) {
    fx := Fixup{kind: 11, offset: a.code.len, label: label, rd: rd}
    a.fixups.push(fx)
    a.r_lui(rd, 0)
    a.r_addi(rd, rd, 0)
}

fn (a &mut Assembler) r_jal(label string) {
    fx := Fixup{kind: 10, offset: a.code.len, label: label, rd: 1}
    a.fixups.push(fx)
    a.r_emit32(0x000000EF)
    if a.arch == 5 { a.r_emit32(0x00000013) } // RV64 reserves a second word for far calls.
}

fn (a &mut Assembler) r_j(label string) {
    fx := Fixup{kind: 10, offset: a.code.len, label: label, rd: 0}
    a.fixups.push(fx)
    a.r_emit32(0x0000006F)
    if a.arch == 5 { a.r_emit32(0x00000013) } // RV64 reserves a second word for far jumps.
}

fn (a &mut Assembler) r_jalr(rd int, rs1 int, imm int) {
    rv_require_i12(imm)
    i := imm & 0xFFF
    a.r_emit32((i << 20) | ((rs1 & 31) << 15) | ((rd & 31) << 7) | 0x67)
}

fn (a &mut Assembler) r_ret() { a.r_jalr(0, 1, 0) }

fn (a &mut Assembler) r_beq(rs1 int, rs2 int, off int) {
    fixup_require(off, -4096, 4094, 2)
    i := off & 0xFFFF
    b12 := (i >> 12) & 1
    b10_5 := (i >> 5) & 0x3F
    b4_1 := (i >> 1) & 0xF
    b11 := (i >> 11) & 1
    a.r_emit32((b12 << 31) | (b10_5 << 25) | ((rs2 & 31) << 20) | ((rs1 & 31) << 15) | (b4_1 << 8) | (b11 << 7) | 0x63)
}

fn (a &mut Assembler) r_bne(rs1 int, rs2 int, off int) {
    fixup_require(off, -4096, 4094, 2)
    i := off & 0xFFFF
    b12 := (i >> 12) & 1
    b10_5 := (i >> 5) & 0x3F
    b4_1 := (i >> 1) & 0xF
    b11 := (i >> 11) & 1
    a.r_emit32((b12 << 31) | (b10_5 << 25) | ((rs2 & 31) << 20) | ((rs1 & 31) << 15) | (1 << 12) | (b4_1 << 8) | (b11 << 7) | 0x63)
}

// Invert-cond skip + jal (same pattern as Thumb).
fn (a &mut Assembler) r_bcond_jal(eq bool, rs1 int, rs2 int, label string) {
    mut skip := 8
    if a.arch == 5 { skip = 12 }
    if eq {
        a.r_bne(rs1, rs2, skip)
    } else {
        a.r_beq(rs1, rs2, skip)
    }
    a.r_j(label)
}

fn (a &mut Assembler) r_csrci_mstatus_mie() { a.r_emit32(0x30047073) }
fn (a &mut Assembler) r_csrsi_mstatus_mie() { a.r_emit32(0x30046073) }
fn (a &mut Assembler) r_wfi() { a.r_emit32(0x10500073) }

// Patch pending Jal / LuiAddi fixups (two-pass addressing protocol).
fn (a &mut Assembler) r_fixup_all() {
    for i in 0:a.fixups.len {
        kind := a.fixups[i].kind
        offset := a.fixups[i].offset
        target_addr := a.label_addr(a.fixups[i].label)
        if kind == 10 {
            // JAL has a signed 21-bit byte displacement with bit zero clear.
            current_addr := a.code_vaddr + offset
            rel := target_addr - current_addr
            fixup_require(rel, -1048576, 1048574, 2)
            rr := rel & 0xFFFFFFFF
            b20 := (rr >> 20) & 1
            b10_1 := (rr >> 1) & 0x3FF
            b11 := (rr >> 11) & 1
            b19_12 := (rr >> 12) & 0xFF
            word := (b20 << 31) | (b19_12 << 12) | (b11 << 20) | (b10_1 << 21) | ((a.fixups[i].rd & 31) << 7) | 0x6F
            a.patch32(offset, word)
        } else if kind == 11 {
            fixup_require(target_addr, 0, 4294967295, 1)
            rd := a.fixups[i].rd
            lo := (target_addr << 52) >> 52
            hi := ((target_addr - (lo & 0xFFFFFFFF)) >> 12) & 0xFFFFF
            lui := ((hi & 0xFFFFF) << 12) | ((rd & 31) << 7) | 0x37
            addi := ((lo & 0xFFF) << 20) | ((rd & 31) << 15) | ((rd & 31) << 7) | 0x13
            a.patch32(offset, lui)
            a.patch32(offset + 4, addi)
        }
    }
}

// ==================== RV64 extension (M39 linux-riscv64) ====================
// RV64IMAFD encodings layered on top of the RV32 base above. All base
// integer ops (add/sub/and/or/xor/sll/srl/sra/mul/div/rem/slt/sltu, addi,
// lui, beq/bne, jal/jalr, lb/sb) share the RV32 encoding — RV64 widens them
// to XLEN=64 with identical 32-bit words. The additions here are the 64-bit
// memory ops (ld/sd/lwu/lbu), W-ops (addiw/slliw/srliw/sraiw/addw/subw/
// sllw/srlw/sraw), 6-bit shifts (slli/srli/srai), auipc, full imm64, the
// D-extension FP ops, atomics (lr.d/sc.d/amo*.d), fence and ecall.
//
// Fixup kinds when arch == 5 (riscv64):
//   10 = Jal      (rd in .rd)      — shared with RV32
//   12 = AuipcAddi (rd in .rd)     — PC-relative absolute address
//
// Scratch/flag registers (see be_rv32.xu vmap_reg):
//   t3=x28  mov_imm64 high-half scratch
//   t4=x29  unsigned flag carrier (x <u y)
//   t5=x30  signed flag carrier   (x - y)
//   t6=x31  load/store offset + cmp_imm scratch
//   a7=x17  syscall number

fn (a &mut Assembler) v_w_op(rd int, rs1 int, rs2 int, f3 int, f7 int) {
    a.r_emit32((f7 << 25) | ((rs2 & 31) << 20) | ((rs1 & 31) << 15) | (f3 << 12) | ((rd & 31) << 7) | 0x3B)
}

fn (a &mut Assembler) v_addw(rd int, rs1 int, rs2 int) { a.v_w_op(rd, rs1, rs2, 0, 0x00) }
fn (a &mut Assembler) v_subw(rd int, rs1 int, rs2 int) { a.v_w_op(rd, rs1, rs2, 0, 0x20) }
fn (a &mut Assembler) v_sllw(rd int, rs1 int, rs2 int) { a.v_w_op(rd, rs1, rs2, 1, 0x00) }
fn (a &mut Assembler) v_srlw(rd int, rs1 int, rs2 int) { a.v_w_op(rd, rs1, rs2, 5, 0x00) }
fn (a &mut Assembler) v_sraw(rd int, rs1 int, rs2 int) { a.v_w_op(rd, rs1, rs2, 5, 0x20) }
fn (a &mut Assembler) v_divw(rd int, rs1 int, rs2 int) { a.v_w_op(rd, rs1, rs2, 4, 0x01) }
fn (a &mut Assembler) v_remw(rd int, rs1 int, rs2 int) { a.v_w_op(rd, rs1, rs2, 6, 0x01) }

fn (a &mut Assembler) v_addiw(rd int, rs1 int, imm int) {
    i := imm & 0xFFF
    a.r_emit32((i << 20) | ((rs1 & 31) << 15) | ((rd & 31) << 7) | 0x1B)
}

fn (a &mut Assembler) v_slliw(rd int, rs1 int, sh int) {
    a.r_emit32(((sh & 31) << 20) | ((rs1 & 31) << 15) | (1 << 12) | ((rd & 31) << 7) | 0x1B)
}

fn (a &mut Assembler) v_srliw(rd int, rs1 int, sh int) {
    a.r_emit32(((sh & 31) << 20) | ((rs1 & 31) << 15) | (5 << 12) | ((rd & 31) << 7) | 0x1B)
}

fn (a &mut Assembler) v_sraiw(rd int, rs1 int, sh int) {
    a.r_emit32(((0x400 | (sh & 31)) << 20) | ((rs1 & 31) << 15) | (5 << 12) | ((rd & 31) << 7) | 0x1B)
}

// 6-bit immediate shifts (RV64; the RV32 r_slli/r_srli mask to 5 bits).
fn (a &mut Assembler) v_slli(rd int, rs1 int, sh int) {
    a.r_emit32(((sh & 0x3F) << 20) | ((rs1 & 31) << 15) | (1 << 12) | ((rd & 31) << 7) | 0x13)
}

fn (a &mut Assembler) v_srli(rd int, rs1 int, sh int) {
    a.r_emit32(((sh & 0x3F) << 20) | ((rs1 & 31) << 15) | (5 << 12) | ((rd & 31) << 7) | 0x13)
}

fn (a &mut Assembler) v_srai(rd int, rs1 int, sh int) {
    a.r_emit32(((0x400 | (sh & 0x3F)) << 20) | ((rs1 & 31) << 15) | (5 << 12) | ((rd & 31) << 7) | 0x13)
}

fn (a &mut Assembler) v_xori(rd int, rs1 int, imm int) {
    i := imm & 0xFFF
    a.r_emit32((i << 20) | ((rs1 & 31) << 15) | (4 << 12) | ((rd & 31) << 7) | 0x13)
}

fn (a &mut Assembler) v_andi(rd int, rs1 int, imm int) {
    a.r_andi(rd, rs1, imm)
}

fn (a &mut Assembler) v_auipc(rd int, imm20 int) {
    a.r_emit32(((imm20 & 0xFFFFF) << 12) | ((rd & 31) << 7) | 0x17)
}

// ==================== RV64 loads / stores ====================

fn (a &mut Assembler) v_ld(rd int, rs1 int, off int) {
    rv_require_i12(off)
    i := off & 0xFFF
    a.r_emit32((i << 20) | ((rs1 & 31) << 15) | (3 << 12) | ((rd & 31) << 7) | 0x03)
}

fn (a &mut Assembler) v_sd(rs2 int, rs1 int, off int) {
    rv_require_i12(off)
    i := off & 0xFFF
    a.r_emit32(((i >> 5) << 25) | ((rs2 & 31) << 20) | ((rs1 & 31) << 15) | (3 << 12) | ((i & 0x1F) << 7) | 0x23)
}

fn (a &mut Assembler) v_lwu(rd int, rs1 int, off int) {
    i := off & 0xFFF
    a.r_emit32((i << 20) | ((rs1 & 31) << 15) | (6 << 12) | ((rd & 31) << 7) | 0x03)
}

fn (a &mut Assembler) v_lbu(rd int, rs1 int, off int) {
    rv_require_i12(off)
    i := off & 0xFFF
    a.r_emit32((i << 20) | ((rs1 & 31) << 15) | (4 << 12) | ((rd & 31) << 7) | 0x03)
}

// ==================== immediate materialization ====================

// Full 64-bit materialization: lui + addiw (sext low 32) then a sign-adjusted
// high half (lui + addiw + slli 32 + add). Always correct for arbitrary i64.
// x28 (t3) is the high-half scratch.
fn (a &mut Assembler) v_mov_imm64(rd int, imm int) {
    lo := imm & 0xFFFFFFFF
    hi20 := ((lo + 2048) >> 12) & 0xFFFFF
    a.r_lui(rd, hi20)
    a.v_addiw(rd, rd, lo & 0xFFF)
    h := ((imm >> 32) & 0xFFFFFFFF) + ((imm >> 31) & 1)
    hhi20 := ((h + 2048) >> 12) & 0xFFFFF
    a.r_lui(28, hhi20)
    a.v_addiw(28, 28, h & 0xFFF)
    a.v_slli(28, 28, 32)
    a.r_add(rd, rd, 28)
}

fn (a &mut Assembler) v_mov_imm(rd int, imm int) {
    if imm >= -2048 && imm <= 2047 {
        a.r_addi(rd, 0, imm)
        <<
    }
    a.v_mov_imm64(rd, imm)
}

// PC-relative absolute address of a label via auipc + addi (patched in
// v_fixup_all). Works at temp load base (RV64 virt RAM starts at 0x80000000,
// whose addresses do not fit in a sign-extended 32-bit lui/addiw chain).
fn (a &mut Assembler) v_lea(rd int, label string) {
    fx := Fixup{kind: 12, offset: a.code.len, label: label, rd: rd}
    a.fixups.push(fx)
    a.v_auipc(rd, 0)
    a.r_addi(rd, rd, 0)
}

// ==================== floating point (D extension) ====================
// FPRs f0/f1 are scratch; the payload stays in GPRs (bits-in-GPR convention,
// like arm64/loong). OP-FP opcode is 0x53.

fn (a &mut Assembler) v_fadd_d(rd int, rs1 int, rs2 int) {
    a.r_emit32((1 << 25) | ((rs2 & 31) << 20) | ((rs1 & 31) << 15) | (7 << 12) | ((rd & 31) << 7) | 0x53)
}

fn (a &mut Assembler) v_fsub_d(rd int, rs1 int, rs2 int) {
    a.r_emit32((5 << 25) | ((rs2 & 31) << 20) | ((rs1 & 31) << 15) | (7 << 12) | ((rd & 31) << 7) | 0x53)
}

fn (a &mut Assembler) v_fmul_d(rd int, rs1 int, rs2 int) {
    a.r_emit32((9 << 25) | ((rs2 & 31) << 20) | ((rs1 & 31) << 15) | (7 << 12) | ((rd & 31) << 7) | 0x53)
}

fn (a &mut Assembler) v_fdiv_d(rd int, rs1 int, rs2 int) {
    a.r_emit32((13 << 25) | ((rs2 & 31) << 20) | ((rs1 & 31) << 15) | (7 << 12) | ((rd & 31) << 7) | 0x53)
}

// fneg.d rd, rs = fsgnjn.d rd, rs, rs
fn (a &mut Assembler) v_fneg_d(rd int, rs int) {
    a.r_emit32((0x11 << 25) | ((rs & 31) << 20) | ((rs & 31) << 15) | (1 << 12) | ((rd & 31) << 7) | 0x53)
}

fn (a &mut Assembler) v_feq_d(rd int, rs1 int, rs2 int) {
    a.r_emit32((0x51 << 25) | ((rs2 & 31) << 20) | ((rs1 & 31) << 15) | (2 << 12) | ((rd & 31) << 7) | 0x53)
}

fn (a &mut Assembler) v_flt_d(rd int, rs1 int, rs2 int) {
    a.r_emit32((0x51 << 25) | ((rs2 & 31) << 20) | ((rs1 & 31) << 15) | (1 << 12) | ((rd & 31) << 7) | 0x53)
}

fn (a &mut Assembler) v_fle_d(rd int, rs1 int, rs2 int) {
    a.r_emit32((0x51 << 25) | ((rs2 & 31) << 20) | ((rs1 & 31) << 15) | (0 << 12) | ((rd & 31) << 7) | 0x53)
}

// fmv.d.x rd, rs1 (GPR -> FPR)
fn (a &mut Assembler) v_fmv_d_x(rd int, rs1 int) {
    a.r_emit32((0x79 << 25) | ((rs1 & 31) << 15) | ((rd & 31) << 7) | 0x53)
}

// fmv.x.d rd, rs1 (FPR -> GPR)
fn (a &mut Assembler) v_fmv_x_d(rd int, rs1 int) {
    a.r_emit32((0x71 << 25) | ((rs1 & 31) << 15) | ((rd & 31) << 7) | 0x53)
}

// fcvt.d.l (int64 -> f64)
fn (a &mut Assembler) v_fcvt_d_l(rd int, rs1 int) {
    a.r_emit32((0x69 << 25) | (2 << 20) | ((rs1 & 31) << 15) | (7 << 12) | ((rd & 31) << 7) | 0x53)
}

// fcvt.l.d (f64 -> int64, truncate toward zero)
fn (a &mut Assembler) v_fcvt_l_d(rd int, rs1 int) {
    a.r_emit32((0x61 << 25) | (2 << 20) | ((rs1 & 31) << 15) | (1 << 12) | ((rd & 31) << 7) | 0x53)
}

// ==================== atomics (a extension) ====================
// AMO opcode 0x2F; funct3=3 selects the .d width.

fn (a &mut Assembler) v_lr_d(rd int, rs1 int) {
    a.r_emit32((3 << 25) | (2 << 27) | ((rs1 & 31) << 15) | (3 << 12) | ((rd & 31) << 7) | 0x2F)
}

fn (a &mut Assembler) v_sc_d(rd int, rs2 int, rs1 int) {
    a.r_emit32((3 << 25) | (3 << 27) | ((rs2 & 31) << 20) | ((rs1 & 31) << 15) | (3 << 12) | ((rd & 31) << 7) | 0x2F)
}

fn (a &mut Assembler) v_amoadd_d(rd int, rs2 int, rs1 int) {
    a.r_emit32((3 << 25) | (0 << 27) | ((rs2 & 31) << 20) | ((rs1 & 31) << 15) | (3 << 12) | ((rd & 31) << 7) | 0x2F)
}

fn (a &mut Assembler) v_amoswap_d(rd int, rs2 int, rs1 int) {
    a.r_emit32((3 << 25) | (1 << 27) | ((rs2 & 31) << 20) | ((rs1 & 31) << 15) | (3 << 12) | ((rd & 31) << 7) | 0x2F)
}

// ==================== misc ====================

fn (a &mut Assembler) v_fence() { a.r_emit32(0x0330000F) } // fence rw, rw
fn (a &mut Assembler) v_ecall() { a.r_emit32(0x00000073) }

// Patch pending Jal / AuipcAddi fixups for RV64 (two-pass addressing).
fn (a &mut Assembler) v_fixup_all() {
    for i in 0:a.fixups.len {
        kind := a.fixups[i].kind
        offset := a.fixups[i].offset
        target_addr := a.label_addr(a.fixups[i].label)
        if kind == 10 {
            // jal rd, label (same encoding as RV32).
            current_addr := a.code_vaddr + offset
            rel := target_addr - current_addr
            if rel % 2 != 0 {
                eprintln("error: RV64 relocation misaligned")
                <<< 1
            }
            if rel < -1048576 || rel > 1048574 {
                // AUIPC/JALR has a signed 32-bit PC-relative reach. Calls
                // use ra as both base and link; jumps use reserved t6.
                lo := (rel << 52) >> 52
                hi := (rel - lo) >> 12
                if hi < -524288 || hi > 524287 {
                    eprintln("ERROR: RV64 branch out of AUIPC/JALR range: " + a.fixups[i].label)
                    <<< 1
                }
                rd := a.fixups[i].rd
                mut base := rd
                if base == 0 { base = 31 }
                a.patch32(offset, ((hi & 0xFFFFF) << 12) | (base << 7) | 0x17)
                a.patch32(offset + 4, ((lo & 0xFFF) << 20) | (base << 15) | (rd << 7) | 0x67)
                ->
            }
            rr := rel & 0xFFFFFFFF
            b20 := (rr >> 20) & 1
            b10_1 := (rr >> 1) & 0x3FF
            b11 := (rr >> 11) & 1
            b19_12 := (rr >> 12) & 0xFF
            word := (b20 << 31) | (b19_12 << 12) | (b11 << 20) | (b10_1 << 21) | ((a.fixups[i].rd & 31) << 7) | 0x6F
            a.patch32(offset, word)
        } else if kind == 12 {
            // auipc + addi. disp = target - current; lo is the sign-adjusted
            // low 12 bits, hi the 4KB page delta.
            current_addr := a.code_vaddr + offset
            disp := target_addr - current_addr
            lo := (disp << 52) >> 52
            hi := (disp - lo) >> 12
            fixup_require(hi, -524288, 524287, 1)
            rd := a.fixups[i].rd
            a.patch32(offset, ((hi & 0xFFFFF) << 12) | ((rd & 31) << 7) | 0x17)
            a.patch32(offset + 4, ((lo & 0xFFF) << 20) | ((rd & 31) << 15) | ((rd & 31) << 7) | 0x13)
        }
    }
}
