@main

#xu/types

fn emit_instr_call_os(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ia := types.mir_ia(m, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    if ib == 12 { // read_file(path)
        v0 := types.mir_marg_v(m, fi, ic)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_read_file")
        <<
    }
    if ib == 27 { // read_dir(path)
        v0 := types.mir_marg_v(m, fi, ic)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_read_dir")
        <<
    }
    if ib == 28 { // now_ns() → int in Ret
        a.call("_rt_now_ns")
        a.mov(0, 14)
        emit_store_temp(a, fr, ia, 0)
        <<
    }
    if ib == 136 { // wall_time_ns() → Unix epoch nanoseconds in Ret
        a.call("_rt_wall_time_ns")
        a.mov(0, 14)
        emit_store_temp(a, fr, ia, 0)
        <<
    }
    if ib == 29 { // sleep_ns(n)
        v0 := types.mir_marg_v(m, fi, ic)
        emit_load_value(a, m, fi, fr, v0, 0)
        a.mov(18, 0)
        a.call("_rt_sleep_ns")
        <<
    }
    if ib == 13 { // write_file(path, contents)
        first := ic
        second := types.mir_marg_next(m, fi, first)
        v0 := types.mir_marg_v(m, fi, first)
        v1 := types.mir_marg_v(m, fi, second)
        a.load(0, 15, slot_off(fr.temp_slot[v0]))
        a.mov(18, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.mov(19, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v1]))
        a.mov(20, 0)
        a.load(0, 15, slot_off(fr.temp_slot[v1]) - 8)
        a.mov(21, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_write_file")
        <<
    }
    if ib == 14 { // args()
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, -slot_off(fr.temp_slot[ia]))
        a.call("_rt_args_clone")
        <<
    }
    if ib == 15 { // <<< code — direct-out path; dump cover first.
        if a.cover {
            a.call("_rt_dump_cover")
        }
        v0 := types.mir_marg_v(m, fi, ic)
        emit_load_value(a, m, fi, fr, v0, 0)
        a.mov(18, 0)
        a.vm_exit()
        <<
    }
    <<
}

fn emit_instr_call_test(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ia := types.mir_ia(m, fi, ii)
    ib := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    if ib == 24 { // assert(cond[, msg])
        v0 := types.mir_marg_v(m, fi, ic)
        emit_load_value(a, m, fi, fr, v0, 0)
        a.vm_cbnz(0, "_as_ok_" + str(fi) + "_" + str(ii))
        // A0=file, A1=line, A2=col, A3/A4=msg ptr/len (0/0 when absent).
        a.vm_mov_imm(18, types.mir_ifile(m, fi, ii))
        a.vm_mov_imm(19, types.mir_iline(m, fi, ii))
        a.vm_mov_imm(20, types.mir_icol(m, fi, ii))
        mut msg := -1
        if types.mir_marg_next(m, fi, ic) >= 0 {
            msg = types.mir_marg_v(m, fi, types.mir_marg_next(m, fi, ic))
        }
        if msg >= 0 {
            a.load(21, 15, slot_off(fr.temp_slot[msg]))
            a.load(22, 15, slot_off(fr.temp_slot[msg]) - 8)
        } else {
            a.vm_mov_imm(21, 0)
            a.vm_mov_imm(22, 0)
        }
        a.call("_rt_assert_fail")
        a.label("_as_ok_" + str(fi) + "_" + str(ii))
        <<
    }
    if ib == 30 { // TestPrintName(prefix str) → rt_test_name(ptr, len)
        v0 := types.mir_marg_v(m, fi, ic)
        a.load(18, 15, slot_off(fr.temp_slot[v0]))
        a.load(19, 15, slot_off(fr.temp_slot[v0]) - 8)
        a.call("_rt_test_name")
        <<
    }
    if ib == 31 { // TestSetjmp → int in Ret
        a.lea(18, "_xu_jmpbuf")
        a.call("_rt_test_setjmp")
        a.mov(0, 14)
        emit_store_temp(a, fr, ia, 0)
        <<
    }
    if ib == 32 { // TestReport(delta)
        v0 := types.mir_marg_v(m, fi, ic)
        emit_load_value(a, m, fi, fr, v0, 0)
        a.mov(18, 0)
        a.call("_rt_test_report")
        <<
    }
    if ib == 33 { // TestSummary(pass, run)
        first := ic
        second := types.mir_marg_next(m, fi, first)
        v0 := types.mir_marg_v(m, fi, first)
        v1 := types.mir_marg_v(m, fi, second)
        emit_load_value(a, m, fi, fr, v0, 0)
        a.mov(18, 0)
        emit_load_value(a, m, fi, fr, v1, 0)
        a.mov(19, 0)
        a.call("_rt_test_summary")
        <<
    }
    if ib == 116 { // test_soft_fail
        a.call("_rt_test_soft_fail")
        <<
    }
    if ib == 117 { // test_skip
        a.call("_rt_test_skip")
        <<
    }
    if ib == 118 { // test_flags → int in Ret
        a.call("_rt_test_flags")
        a.mov(0, 14)
        emit_store_temp(a, fr, ia, 0)
        <<
    }
    if ib == 119 { // test_clear
        a.call("_rt_test_clear")
        <<
    }
    if ib == 120 { // test_is_short → int in Ret
        a.call("_rt_test_is_short")
        a.mov(0, 14)
        emit_store_temp(a, fr, ia, 0)
        <<
    }
    if ib >= 16 && ib <= 19 { // ASCII character predicates
        v0 := types.mir_marg_v(m, fi, ic)
        emit_load_value(a, m, fi, fr, v0, 0) // V0 = byte
        if ib == 16 || ib == 18 { // digit component
            a.vm_mov_imm(1, 48)
            a.cmp(0, 1)
            a.vm_cset(2, 10) // >= '0'
            a.vm_mov_imm(1, 57)
            a.cmp(0, 1)
            a.vm_cset(3, 13) // <= '9'
            a.iand(2, 2, 3)
        }
        if ib == 17 || ib == 18 { // alpha component
            a.vm_mov_imm(1, 65)
            a.cmp(0, 1)
            a.vm_cset(3, 10)
            a.vm_mov_imm(1, 90)
            a.cmp(0, 1)
            a.vm_cset(4, 13)
            a.iand(3, 3, 4) // upper
            a.vm_mov_imm(1, 97)
            a.cmp(0, 1)
            a.vm_cset(4, 10)
            a.vm_mov_imm(1, 122)
            a.cmp(0, 1)
            a.vm_cset(5, 13)
            a.iand(4, 4, 5) // lower
            a.ior(3, 3, 4)
            if ib == 18 { a.ior(2, 2, 3) } else { a.mov(2, 3) }
        }
        if ib == 19 { // space / tab / LF / CR
            a.vm_mov_imm(1, 32)
            a.cmp(0, 1)
            a.vm_cset(2, 0)
            a.vm_mov_imm(1, 9)
            a.cmp(0, 1)
            a.vm_cset(3, 0)
            a.ior(2, 2, 3)
            a.vm_mov_imm(1, 10)
            a.cmp(0, 1)
            a.vm_cset(3, 0)
            a.ior(2, 2, 3)
            a.vm_mov_imm(1, 13)
            a.cmp(0, 1)
            a.vm_cset(3, 0)
            a.ior(2, 2, 3)
        }
        a.store(15, slot_off(fr.temp_slot[ia]), 2)
        <<
    }
    <<
}

fn emit_instr_call(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ib := types.mir_ib(m, fi, ii)
    // User Function/Indirect load args then spill. Println/eprintln same
    // (emit_instr_call_println). Early spill here drops skip-store aliases.
    mut early_spill := true
    if ib == 1 || ib == 80 {
        early_spill = false
    }
    if ib == 95 {
        early_spill = false
    }
    if ib == 2 || ib == 3 || ib == 4 || ib == 7 || ib == 8 || ib == 9 || ib == 22 || ib == 23 {
        early_spill = false
    }
    if ib == 5 || ib == 122 {
        // push_str / push_byte may inline in-place; spill only on the grow slow path.
        early_spill = false
    }
    if early_spill {
        rc_spill_across_call(a)
    }
    if ib == 80 || ib == 1 {
        emit_instr_call_user(a, m, fi, fr, ii)
        <<
    }
    if ib == 95 {
        emit_instr_call_user(a, m, fi, fr, ii)
        <<
    }
    // Runtime helpers (`println`, string, os, sys, map) are Call(kind=7)
    // and clobber caller-saved FP. User calls save/reload inside
    // emit_instr_call_user, before argument materialization. Helpers need
    // the same split around the actual `bl`.
    emit_vreg_call_fp_splits(a, m, fi, fr, ii, false)
    mut done := false
    if ib >= 151 && ib <= 155 {
        ic := types.mir_ic(m, fi, ii)
        ia := types.mir_ia(m, fi, ii)
        if ib != 151 {
            first := types.mir_marg_v(m, fi, ic)
            emit_load_value(a, m, fi, fr, first, 0)
            a.mov(18, 0)
        }
        if ib == 152 || ib == 155 {
            second := types.mir_marg_v(m, fi, types.mir_marg_next(m, fi, ic))
            emit_load_value(a, m, fi, fr, second, 0)
            a.mov(19, 0)
        }
        if ib == 151 { a.call("_rt_select_new") }
        if ib == 152 { a.call("_rt_select_watch") }
        if ib == 153 { a.call("_rt_park_until") }
        if ib == 154 { a.call("_rt_select_drop") }
        if ib == 155 { a.call("_rt_wait_cancel") }
        if ia >= 0 {
            a.mov(0, 14)
            a.store(15, slot_off(fr.temp_slot[ia]), 0)
        }
        done = true
    }
    if ib == 40 || ib == 41 || ib == 42 || ib == 43 || ib == 44 {
        emit_instr_call_builtin(a, m, fi, fr, ii)
        done = true
    }
    if !done && (ib == 5 || ib == 6 || ib == 10 || ib == 11 || ib == 20 || ib == 21 || ib == 25 || ib == 26 || ib == 81 || ib == 82 || ib == 83 || ib == 122 || ib == 160 || ib == 161 || ib == 162 || ib == 163 || ib == 164 || ib == 165) {
        emit_instr_call_str(a, m, fi, fr, ii)
        done = true
    }
    if !done && (ib == 12 || ib == 13 || ib == 14 || ib == 15 || ib == 27 || ib == 28 || ib == 29 || ib == 136) {
        emit_instr_call_os(a, m, fi, fr, ii)
        done = true
    }
    if !done && ((ib >= 16 && ib <= 19) || ib == 24 || (ib >= 30 && ib <= 33) || (ib >= 116 && ib <= 120)) {
        emit_instr_call_test(a, m, fi, fr, ii)
        done = true
    }
    if !done && ((ib >= 45 && ib <= 79) || ib == 99 || ib == 100 || (ib >= 101 && ib <= 103) || ib == 93 || ib == 94 || ib == 96 || ib == 97 || ib == 104 || ib == 121 || ib == 131 || ib == 132 || ib == 133 || ib == 134 || ib == 135 || ib == 137 || ib == 138 || ib == 156 || (ib >= 123 && ib <= 130)) {
        emit_instr_call_sys(a, m, fi, fr, ii)
        done = true
    }
    if !done && ((ib >= 84 && ib <= 92) || ib == 98) {
        emit_instr_call_map(a, m, fi, fr, ii)
        done = true
    }
    if !done {
        emit_instr_call_println(a, m, fi, fr, ii)
    }
    emit_vreg_call_fp_splits(a, m, fi, fr, ii, true)
    <<
}

fn emit_instr_call_builtin(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ib := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    if ib == 40 {
        v0 := types.mir_marg_v(m, fi, ic)
        emit_load_value(a, m, fi, fr, v0, 0)
        a.mov(18, 0)
        a.call("_xu_raise_irq")
        <<
    }
    if ib == 41 || ib == 42 {
        v0 := types.mir_marg_v(m, fi, ic)
        v1 := types.mir_marg_v(m, fi, types.mir_marg_next(m, fi, ic))
        emit_load_value(a, m, fi, fr, v0, 0)
        a.mov(18, 0)
        emit_load_value(a, m, fi, fr, v1, 0)
        a.mov(19, 0)
        if ib == 41 {
            a.store(18, 0, 19)
        } else {
            a.store_byte(18, 0, 19)
        }
        <<
    }
    v0 := types.mir_marg_v(m, fi, ic)
    ia := types.mir_ia(m, fi, ii)
    emit_load_value(a, m, fi, fr, v0, 0)
    a.mov(18, 0)
    if ib == 43 {
        a.load(0, 18, 0)
    } else {
        a.load_byte(0, 18, 0)
    }
    emit_store_temp(a, fr, ia, 0)
    <<
}

fn emit_instr_call_println(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ib := types.mir_ib(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    v := types.mir_marg_v(m, fi, ic)
    if a.has_int64_pairs() && (ib == 2 || ib == 7) {
        if v <= -2 {
            imm := types.mir_const_at(m, fi, -v - 2)
            a.t_mov_imm64_pair(0, 1, imm)
        } else if v >= 0 && v < fr.temp_slot.len {
            a.t_load64_offset(0, 1, 7, slot_off(fr.temp_slot[v]))
        }
        if ib == 7 {
            a.t_mov_imm32(2, 2)
        } else {
            a.t_mov_imm32(2, 1)
        }
        if v >= 0 {
            rc_forget_slot(a, fr.temp_slot[v])
        }
        rc_spill_across_call(a)
        a.call("_rt_println_int")
        <<
    }
    emit_load_value(a, m, fi, fr, v, 0)
    a.mov(18, 0)
    if ib == 4 || ib == 9 {
        a.load(0, 15, slot_off(fr.temp_slot[v]) - 8)
        a.mov(19, 0)
    }
    if ib == 7 || ib == 8 || ib == 9 || ib == 23 {
        a.vm_mov_imm(20, 2)
    } else {
        a.vm_mov_imm(20, 1)
    }
    if v >= 0 {
        rc_forget_slot(a, fr.temp_slot[v])
    }
    rc_spill_across_call(a)
    if ib == 2 || ib == 7 { a.call("_rt_println_int") }
    if ib == 3 || ib == 8 { a.call("_rt_println_bool") }
    if ib == 4 || ib == 9 { a.call("_rt_println_str") }
    if ib == 22 || ib == 23 { a.call("_rt_println_f64") }
    <<
}



// Emit UTF-8 bytes of `s` into the data segment (string literals / statics).

// m32: coverage tables for --cover (slot order = CoverTable insertion order).
