@main

#xu/types

// These private SDK seams use the ordinary Xu call ABI, including sret in
// V0. Only the exact non-external signatures may select native storage.
fn string_storage_signature(m &types.Mir, lab &string, kind int) bool {
    for fi in 0:m.fns.len {
        if types.mir_fn_is_extern(m, fi) || types.mir_fn_receiver(m, fi) { -> }
        if types.mir_fn_label_len(m, fi) != lab.len { -> }
        if types.mir_fn_label(m, fi) != lab + "" { -> }
        $nargs := 2
        if kind == 3 { nargs = 1 }
        if types.mir_fn_nparams(m, fi) != nargs || types.mir_nlocals(m, fi) < nargs { << false }
        ref_ty := types.mir_local_ty(m, fi, 0)
        if (!types.is_direct_ref_type(ref_ty) || types.is_mut_ref_type(ref_ty) != (kind == 2) || types.direct_ref_inner(&m.ref_targets, ref_ty) != 3) || types.mir_local_nslots(m, fi, 0) != 1 { << false }
        if nargs == 2 {
            if types.mir_local_ty(m, fi, 1) != 1 || types.mir_local_nslots(m, fi, 1) != 1 { << false }
        }
        if kind == 1 { << types.mir_fn_ret(m, fi) == 3 && types.mir_fn_ret_nslots(m, fi) == 3 }
        if kind == 2 { << types.mir_fn_ret(m, fi) == 0 }
        << types.mir_fn_ret(m, fi) == 1 && types.mir_fn_ret_nslots(m, fi) == 1
    }
    << false
}

// A0=&borrowed string, A1=copies, V0=sret. Allocate once, copy the input,
// then double initialized bytes. Every copy is disjoint and bounded by the
// initialized prefix; the final partial copy never reads past that prefix.
fn rt_emit_string_repeat(a $&Assembler) {
    a.label("_rt_string_repeat")
    a.prologue(64)
    a.store(15, -8, 0)
    a.store(15, -32, 19)
    a.vm_cmp_imm(19, 0)
    a.jle("_rt_rep_empty")
    a.load(0, 18, -8)
    a.store(15, -24, 0)
    a.vm_cbz(0, "_rt_rep_empty")
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_al_oom")
    a.load(1, 18, 0)
    a.store(15, -16, 1)
    a.vm_cbz(1, "_rt_al_oom")
    a.add(2, 1, 0)
    a.cmp(2, 1)
    a.jae("_rt_rep_span_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_rep_span_ok")
    a.vm_mov_imm64(1, 9223372036854775807)
    a.div(1, 1, 0)
    a.cmp(19, 1)
    a.jgt("_rt_al_oom")
    a.mul(18, 0, 19)
    a.store(15, -40, 18)
    a.call("_rt_alloc")
    a.store(15, -48, 14)
    a.load(1, 15, -16)
    a.mov(2, 14)
    a.load(3, 15, -24)
    rt_emit_copy_bytes(a, "repeat_first", 1, 2, 3, 4)
    a.load(5, 15, -24)
    a.store(15, -56, 5)
    a.label("_rt_rep_fill")
    a.load(0, 15, -40)
    a.load(5, 15, -56)
    a.cmp(5, 0)
    a.jge("_rt_rep_done")
    a.sub(3, 0, 5)
    a.cmp(3, 5)
    a.jle("_rt_rep_chunk")
    a.mov(3, 5)
    a.label("_rt_rep_chunk")
    a.add(0, 5, 3)
    a.store(15, -56, 0)
    a.load(1, 15, -48)
    a.add(2, 1, 5)
    rt_emit_copy_bytes(a, "repeat_fill", 1, 2, 3, 4)
    a.jmp("_rt_rep_fill")
    a.label("_rt_rep_done")
    a.load(0, 15, -8)
    a.load(1, 15, -48)
    a.store(0, 0, 1)
    a.load(1, 15, -40)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_rep_empty")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
}

// A0=&mut string, A1=additional bytes. Keep owned capacity when sufficient;
// otherwise copy before releasing the old owned buffer or shared slab view.
fn rt_emit_string_reserve(a $&Assembler) {
    a.label("_rt_string_reserve")
    a.prologue(64)
    a.store(15, -8, 18)
    a.vm_cmp_imm(19, 0)
    a.jle("_rt_rsv_done")
    a.load(0, 18, -8)
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_al_oom")
    a.store(15, -24, 0)
    a.load(1, 18, -16)
    a.store(15, -32, 1)
    a.vm_cmp_imm(1, 0)
    a.jle("_rt_rsv_cap_ok")
    a.cmp(1, 0)
    a.jlt("_rt_al_oom")
    a.label("_rt_rsv_cap_ok")
    a.vm_mov_imm64(2, 9223372036854775807)
    a.sub(2, 2, 0)
    a.cmp(19, 2)
    a.jgt("_rt_al_oom")
    a.add(2, 0, 19)
    a.store(15, -40, 2)
    a.cmp(1, 2)
    a.jge("_rt_rsv_done")
    a.load(1, 18, 0)
    a.store(15, -16, 1)
    a.vm_cbz(0, "_rt_rsv_span_ok")
    a.vm_cbz(1, "_rt_al_oom")
    a.add(3, 1, 0)
    a.cmp(3, 1)
    a.jae("_rt_rsv_span_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_rsv_span_ok")
    a.mov(18, 2)
    a.call("_rt_alloc")
    a.store(15, -48, 14)
    a.load(1, 15, -16)
    a.mov(2, 14)
    a.load(3, 15, -24)
    rt_emit_copy_bytes(a, "reserve", 1, 2, 3, 4)
    a.load(0, 15, -8)
    a.load(1, 15, -48)
    a.store(0, 0, 1)
    a.load(1, 15, -40)
    a.store(0, -16, 1)
    // len is unchanged. Only positive capacities own the old data pointer.
    a.load(18, 15, -32)
    a.vm_cmp_imm(18, 0)
    a.jeq("_rt_rsv_done")
    a.jlt("_rt_rsv_shared")
    a.load(18, 15, -16)
    a.call("_rt_free")
    a.jmp("_rt_rsv_done")
    a.label("_rt_rsv_shared")
    a.call("_rt_str_release")
    a.label("_rt_rsv_done")
    a.epilogue()
}

fn rt_emit_string_storage(a $&Assembler) {
    rt_emit_string_repeat(a)
    rt_emit_string_reserve(a)
    a.label("_rt_string_capacity")
    a.load(0, 18, -8)
    a.load(1, 18, -16)
    a.cmp(1, 0)
    a.jle("_rt_scap_len")
    a.mov(14, 1)
    a.vm_ret()
    a.label("_rt_scap_len")
    a.mov(14, 0)
    a.vm_ret()
}
