@main

#xu/types

fn rt_emit_str_concat(a $&Assembler) {
    a.label("_rt_str_concat")
    a.prologue(64)
    a.store(15, -8, 0)     // sret
    a.store(15, -16, 18)   // a_ptr
    a.store(15, -24, 19)   // a_len
    a.store(15, -32, 20)   // b_ptr
    a.store(15, -40, 21)   // b_len
    // cap = a_len + b_len
    a.load(0, 15, -24)
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_al_oom")
    a.load(1, 15, -40)
    a.vm_cmp_imm(1, 0)
    a.jlt("_rt_al_oom")
    // Non-empty operands need valid, non-wrapping source spans.
    a.vm_cbz(0, "_rt_cc_a_empty")
    a.load(2, 15, -16)
    a.vm_cbz(2, "_rt_al_oom")
    a.add(3, 2, 0)
    a.cmp(3, 2)
    a.jae("_rt_cc_a_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_cc_a_empty")
    a.label("_rt_cc_a_ok")
    a.vm_cbz(1, "_rt_cc_b_empty")
    a.load(2, 15, -32)
    a.vm_cbz(2, "_rt_al_oom")
    a.add(3, 2, 1)
    a.cmp(3, 2)
    a.jae("_rt_cc_b_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_cc_b_empty")
    a.label("_rt_cc_b_ok")
    a.add(0, 0, 1)
    a.load(1, 15, -24)
    a.cmp(0, 1)
    a.jae("_rt_cc_size_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_cc_size_ok")
    a.store(15, -48, 0)    // cap
    // Empty concatenations are canonical non-owning values; avoid alloc(0),
    // whose cap==0 result would be skipped by string drop and leak a block.
    a.vm_cbz(0, "_rt_cc_empty")
    // data = alloc(cap)
    a.mov(18, 0)
    a.call("_rt_alloc")
    a.store(15, -56, 14)   // data
    a.load(1, 15, -16)
    a.load(2, 15, -56)
    a.load(3, 15, -24)
    rt_emit_copy_bytes(a, "concat_a", 1, 2, 3, 4)
    a.load(1, 15, -32)
    a.load(2, 15, -56)
    a.load(4, 15, -24)
    a.add(2, 2, 4)
    a.load(3, 15, -40)
    rt_emit_copy_bytes(a, "concat_b", 1, 2, 3, 4)
    // Write (data, cap, cap) to [sret]
    a.load(0, 15, -8)      // sret
    a.load(1, 15, -56)     // data
    a.store(0, 0, 1)
    a.load(1, 15, -48)     // cap
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_cc_empty")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    <<
}

// ===== rt_push_str: in-place append or grow. Internal ABI:
// A0 = &string (slot 0, ptr field), A1/A2 = suffix (ptr, len). Mirrors
// xurt's emit_push_str exactly: if cap >= new_len, in-place append; else
// realloc with power-of-two growth (min 16), copy, free old, update
// header. Static (cap==0) values always take the realloc path.
fn rt_emit_push_str(a $&Assembler) {
    a.label("_rt_push_str")
    a.prologue(96)
    a.store(15, -8, 18)  // sval
    a.store(15, -16, 19) // suf_ptr
    a.store(15, -24, 20) // suf_len
    a.load(0, 18, 0)
    a.store(15, -32, 0)  // ptr
    a.load(0, 18, -8)
    a.store(15, -40, 0)  // len
    a.load(0, 18, -16)
    a.store(15, -48, 0)  // cap
    // new_len = len + suf_len
    a.load(0, 15, -40)
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_al_oom")
    a.load(1, 15, -24)
    a.vm_cmp_imm(1, 0)
    a.jlt("_rt_al_oom")
    a.load(2, 15, -48)
    // cap<0 is a shared view. It is never in-place; grow copies the bytes
    // and releases the view instead of freeing the interior pointer.
    a.vm_cmp_imm(2, 0)
    a.jlt("_rt_ps_cap_ok")
    // Positive capacity denotes a heap-backed value and must cover len.
    // cap==0 is the static-literal sentinel and remains valid for literals.
    a.vm_cbz(2, "_rt_ps_cap_static")
    a.cmp(2, 0)
    a.jge("_rt_ps_cap_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ps_cap_static")
    a.label("_rt_ps_cap_ok")
    // Validate the old backing span before either in-place writes or the
    // reallocation copy loop. Empty static values may use a null pointer;
    // an empty heap value must still have a pointer for in-place appends.
    a.vm_cbz(0, "_rt_ps_old_empty")
    a.load(3, 15, -32)
    a.vm_cbz(3, "_rt_al_oom")
    a.add(4, 3, 0)
    a.cmp(4, 3)
    a.jae("_rt_ps_old_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ps_old_empty")
    a.vm_cbz(2, "_rt_ps_old_ok")
    a.load(3, 15, -32)
    a.vm_cbz(3, "_rt_al_oom")
    a.label("_rt_ps_old_ok")
    // Validate the suffix backing span before copying it.
    a.vm_cbz(1, "_rt_ps_suf_empty")
    a.load(3, 15, -16)
    a.vm_cbz(3, "_rt_al_oom")
    a.add(4, 3, 1)
    a.cmp(4, 3)
    a.jae("_rt_ps_suf_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ps_suf_empty")
    a.label("_rt_ps_suf_ok")
    a.add(0, 0, 1)
    a.load(1, 15, -40)
    a.cmp(0, 1)
    a.jae("_rt_ps_size_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ps_size_ok")
    a.store(15, -56, 0)
    // if cap >= new_len: in-place append
    a.load(1, 15, -48)
    a.cmp(1, 0)
    a.jge("_rt_ps_inplace")
    // ---- grow: new_cap = 16; while new_cap < new_len: new_cap <<= 1 ----
    a.vm_mov_imm(4, 16)
    a.label("_rt_ps_grow")
    a.load(1, 15, -56)
    a.cmp(4, 1)
    a.jge("_rt_ps_grown")
    a.shl_imm(4, 4, 1)
    a.vm_cmp_imm(4, 0)
    a.jgt("_rt_ps_grow")
    a.jmp("_rt_al_oom")
    a.label("_rt_ps_grown")
    a.store(15, -64, 4)
    // data = alloc(new_cap)
    a.mov(18, 4)
    a.call("_rt_alloc")
    a.store(15, -72, 14)
    a.load(1, 15, -32)
    a.load(2, 15, -72)
    a.load(3, 15, -40)
    rt_emit_copy_bytes(a, "push_old", 1, 2, 3, 4)
    a.load(1, 15, -16)
    a.load(2, 15, -72)
    a.load(4, 15, -40)
    a.add(2, 2, 4)
    a.load(3, 15, -24)
    rt_emit_copy_bytes(a, "push_suffix", 1, 2, 3, 4)
    // cap>0 frees the old buffer. cap<0 releases the shared view.
    a.load(0, 15, -48)
    a.vm_cbz(0, "_rt_ps_nofree")
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_ps_release")
    a.load(18, 15, -32)
    a.call("_rt_free")
    a.jmp("_rt_ps_nofree")
    a.label("_rt_ps_release")
    a.mov(18, 0)
    a.call("_rt_str_release")
    a.label("_rt_ps_nofree")
    // write back
    a.load(0, 15, -8)
    a.load(1, 15, -72)
    a.store(0, 0, 1)
    a.load(1, 15, -56)
    a.store(0, -8, 1)
    a.load(1, 15, -64)
    a.store(0, -16, 1)
    a.epilogue()
    // ---- in-place: append at ptr+len, update len ----
    a.label("_rt_ps_inplace")
    // Check the complete destination span (ptr + new_len) before writing the
    // suffix. The zero-length canonical static case may keep a null pointer.
    a.load(0, 15, -56)
    a.vm_cbz(0, "_rt_ps_inplace_ready")
    a.load(3, 15, -32)
    a.vm_cbz(3, "_rt_al_oom")
    a.add(4, 3, 0)
    a.cmp(4, 3)
    a.jae("_rt_ps_inplace_ready")
    a.jmp("_rt_al_oom")
    a.label("_rt_ps_inplace_ready")
    a.load(1, 15, -16)
    a.load(2, 15, -32)
    a.load(4, 15, -40)
    a.add(2, 2, 4)
    a.load(3, 15, -24)
    rt_emit_copy_bytes(a, "push_inplace", 1, 2, 3, 4)
    a.load(0, 15, -8)
    a.load(1, 15, -56)
    a.store(0, -8, 1)
    a.epilogue()
    <<
}

// ===== rt_oob: loud-fail bounds-check helper. Just prints
// "index out of bounds\n" and exits with code 1. The calling convention is
// nothing — the runtime reads no args; it's called after the failing
// branch is taken.
