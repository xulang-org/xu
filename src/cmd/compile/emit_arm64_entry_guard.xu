@main

#xu/types

// Track only scalar copies of the first parameter. No address, local write,
// call or other effect may be skipped by the frameless identity return.
fn entry_guard_copy(m &types.Mir, fi int, ii int, origins &mut []int) bool {
    k := types.mir_ikind(m, fi, ii)
    if k == 0 { << true }
    if k != 1 && k != 2 { << false }
    dest := types.mir_ia(m, fi, ii)
    src := types.mir_ib(m, fi, ii)
    if dest < 0 || dest >= origins.len { << false }
    if types.mir_temp_ty(m, fi, dest) != 1 || types.mir_temp_nslots(m, fi, dest) != 1 { << false }
    if k == 2 {
        if src != 0 { << false }
    } else {
        if src < 0 || src >= origins.len || origins[src] != 1 { << false }
    }
    origins[dest] = 1
    << true
}

fn entry_guard_limit(m &types.Mir, fi int) int {
    if fi < 0 || fi >= m.fns.len { << -1 }
    if types.mir_fn_is_extern(m, fi) || m.fns[fi].receiver { << -1 }
    if types.mir_fn_nparams(m, fi) != 1 || types.mir_fn_ret(m, fi) != 1 || types.mir_fn_ret_nslots(m, fi) != 1 { << -1 }
    if types.mir_nlocals(m, fi) < 1 || types.mir_local_ty(m, fi, 0) != 1 || types.mir_local_nslots(m, fi, 0) != 1 { << -1 }
    nb := types.mir_nblocks(m, fi)
    nt := types.mir_ntemps(m, fi)
    ni := types.mir_nins(m, fi)
    if nb < 2 || nb > 64 || nt <= 0 || nt > 512 || ni > 1024 { << -1 }
    if types.mir_btkind(m, fi, 0) != 2 { << -1 }
    cmp := types.mir_btail(m, fi, 0)
    if cmp < 0 || types.mir_ikind(m, fi, cmp) != 4 || types.mir_ib(m, fi, cmp) != 8 { << -1 }
    if types.mir_bta(m, fi, 0) != types.mir_ia(m, fi, cmp) { << -1 }
    rhs := types.mir_id(m, fi, cmp)
    if !vec_has_const(m, fi, rhs) { << -1 }
    limit := vec_const(m, fi, rhs)
    if limit < 0 || limit > 4095 { << -1 }
    mut origins := []int{}
    for _ in 0:nt { origins.push(0) }
    mut ii := types.mir_bhead(m, fi, 0)
    for _ in 0:ni {
        if ii < 0 || ii == cmp { <- }
        if !entry_guard_copy(m, fi, ii, mut &origins) { << -1 }
        ii = types.mir_inext(m, fi, ii)
    }
    if ii != cmp { << -1 }
    lhs := types.mir_ic(m, fi, cmp)
    if lhs < 0 || lhs >= nt || origins[lhs] != 1 { << -1 }
    mut bi := types.mir_btb(m, fi, 0)
    for _ in 0:nb {
        if bi <= 0 || bi >= nb { << -1 }
        ii = types.mir_bhead(m, fi, bi)
        for _ in 0:ni {
            if ii < 0 { <- }
            if !entry_guard_copy(m, fi, ii, mut &origins) { << -1 }
            ii = types.mir_inext(m, fi, ii)
        }
        if ii >= 0 { << -1 }
        tk := types.mir_btkind(m, fi, bi)
        if tk == 3 {
            value := types.mir_bta(m, fi, bi)
            if value >= 0 && value < nt && origins[value] == 1 { << limit }
            << -1
        }
        if tk != 1 { << -1 }
        bi = types.mir_bta(m, fi, bi)
    }
    << -1
}

fn emit_arm64_identity_guard(a &mut Assembler, m &types.Mir, fi int) {
    if a.arch != 0 || a.ra_level < 1 || m.opt_level < 1 || a.cover || a.test || a.lib != 0 { << }
    limit := entry_guard_limit(m, fi)
    if limit < 0 { << }
    a.vm_cmp_imm(18, limit)
    // AArch64 A0 and Ret both use X0. B.GE .+8 skips one RET word.
    // The regular path still saves every original home and runs its body.
    a.emit32(0x5400004a)
    a.ret()
}
