    println("")
    println("Options:")
    println("  --target TARGET     check only the specified target platform")
    println("  --desktop           check host toolchains required for desktop packing")
    println("  --webview           also check webview host dependencies")
    println("  -h, --help          show this help message")
}

fn print_setup_help(prog &string) {
    println("usage: " + prog + " setup [options]")
    println("")
    println("Launch Xu language native installer via sibling xu-setup.")
    println("")
    println("Options:")
    println("  --prefix DIR, -p DIR   installation directory (default: ~/.xu or %USERPROFILE%\\.xu)")
    println("  --yes, -y, --silent    silent installation without prompts")
    println("  --cli                  force console CLI interactive mode")
    println("  --version VER          specify version to download (online mode)")
    println("  -h, --help             show this help message")
}

fn print_native_help(prog &string) {
    println("usage: " + prog + " native <command> [options]")
    println("")
    println("Compile, archive, pack, and inspect native C modules via sibling xu-native.")
    println("")
    println("Commands:")
    println("  compile   compile C sources with metadata wrapper into a native .a archive")
    println("  archive   wrap precompiled objects with metadata into a native .a archive")
    println("  pack      bundle target slices into a portable .xulib library")
    println("  inspect   inspect a .xulib container and its slices")
    println("  extract   extract a target slice from a .xulib container")
    println("")
    println("Use \"" + prog + " native <command> --help\" for detailed subcommand options.")
}

fn print_xacp_help(prog &string) {
    println("usage: " + prog + " xacp <inspect|run|debug|record|control|attach> <program> [-- args...]")
    println("")
    println("  inspect   read the program's --xacp-help discovery document")
    println("  attach    run business main; application calls xacp.attach_stdio and polls its Screen")
    println("  run       execute the program and forward args after --")
    println("  debug     inspect first, then execute with the same safe boundary")
    println("")
    println("  control   exclusive framed stdio; hello negotiates host permissions")
    println("connect PORT relays frames to 127.0.0.1:PORT; target starts with --xacp-tcp.")
}

fn print_lsp_help(prog &string) {
    println("usage: " + prog + " lsp [options]")
    println("")
    println("Start Language Server Protocol daemon via sibling xu-lsp.")
    println("Speaks JSON-RPC 2.0 over stdin/stdout.")
    println("")
    println("Options:")
    println("  -h, --help        show this help message")
}

fn print_desktop_help(prog &string) {
    println("usage: " + prog + " build <AppDir> --desktop [options]")
    println("")
    println("Pack a native desktop application via sibling xu-desktop.")
    println("")
    println("Arguments:")
    println("  <AppDir>          application directory containing main.xu")
    println("")
    println("Options:")
    println("  -o, --output OUT  output bundle or executable path")
    println("  --target TARGET   target platform (macos-arm64, macos-x64, windows-x64, etc.)")
    println("  --www DIR         override www/ resource directory to embed")
    println("  -h, --help        show this help message")
}

fn print_sibling_help(name string) {
    $prog := cli_prog()
    if name == "xu-fmt" {
        print_fmt_help(&prog)
        <<
    }
    if name == "xu-map" {
        print_map_help(&prog)
        <<
    }
    if name == "xu-doc" {
        print_doc_help(&prog)
        <<
    }
    if name == "xu-doctor" {
        print_doctor_help(&prog)
        <<
    }
    if name == "xu-setup" {
        print_setup_help(&prog)
        <<
    }
    if name == "xu-native" {
        print_native_help(&prog)
        <<
    }
    if name == "xu-xacp" {
        print_xacp_help(&prog)
        <<
    }
    if name == "xu-lsp" {
        print_lsp_help(&prog)
        <<
    }
    if name == "xu-desktop" {
        print_desktop_help(&prog)
        <<
    }
    println("usage: " + prog + " " + name + " [options]")
    <<
}

// ===== M18b package search (Gen1) =====
// Helper uses function-level early << so Result.unwrap is M2b-legal.
