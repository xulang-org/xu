@main

#os/exec
#path/filepath

#xu/scanner
#xu/parser
#xu/ast
#xu/types
#errors
#os

// The running compiler owns its identity; SDK paths can select older sources.
// scripts/module_versions.py synchronizes this value with the root VERSION.
fn compiler_version() string {
    << "0.11.1"
}

fn hold_check_only(p &parser.Parser, target_code int, lib_mode int) {
    $c := types.Checker{}
    types.check_only(p, target_code, lib_mode, $&c)
}

// Indexed extraction from an owning []string is not an ownership boundary.
// CLI values that outlive the argv parsing loop need their own bytes because
// the compiler may drop argv at its last direct use.
fn cli_arg_owned(argv &[]string, i int) string {
    $bytes := []int{}
    for j in 0:argv[i].len {
        bytes.push(argv[i][j])
    }
    << string_from_bytes(bytes)
}

fn cli_prog_from(argv &[]string) string {
    $prog := "xu"
    if argv.len > 0 {
        prog = cli_arg_owned(argv, 0)
        $cut := 0 - 1
        for i in 0:prog.len {
            if prog[i] == 47 {
                cut = i
            }
        }
        if cut >= 0 {
            prog = prog[cut + 1:prog.len]
        }
        if prog.len == 0 {
            prog = "xu"
        }
    }
    << prog
}

fn cli_prog() string {
    argv := os.argv()
    << cli_prog_from(&argv)
}

fn tool_shell_quote(s &string) string {
    $out := "'"
    for i in 0:s.len {
        if s[i] == 39 {
            out = out + "'\\''"
        } else {
            out = out + string_from_byte(s[i])
        }
    }
    << out + "'"
}

fn tool_beside_self(name string) string {
    argv := os.argv()
    if argv.len > 0 {
        exe := cli_arg_owned(&argv, 0)
        resolved := exec.look_path(exe) or (err) { << "" }
        actual := require_real_path(&resolved)
        dir := path_dirname(&actual)
        $cand := path_join(&dir, &name)
        if xu_target_os() == 2 { cand = cand + ".exe" }
        if path_exists(&cand) {
            << cand
        }
    }
    << exec.look_path(name) or (err) { << "" }
}

// Direct process execution works in native PowerShell/cmd as well as Unix.
// os/exec reports a nonzero child status as an error; preserve that status.
fn cli_exec(bin string, args []string) int {
    $cmd := exec.command(bin)
    for i in 0:args.len { cmd.args.push(str_clone(&args[i])) }
    cmd.run() or (err) {
        msg := err.msg()
        if val_has_prefix(&msg, "exit status ") && msg.len > 12 {
            code := parse_count(msg[12:msg.len])
            if code >= 0 { << code }
        }
        eprintln("xu: " + msg)
        << 127
    }
    << 0
}

fn args_have_help(args &[]string) bool {
    for i in 0:args.len {
        if args[i] == "-h" || args[i] == "--help" {
            << true
        }
    }
    << false
}

fn argv_sub_has_help(argv &[]string) bool {
    $skip := 0
    for i in 2:argv.len {
        if skip == 1 {
            skip = 0
            ->
        }
        if argv[i] == "--" {
            << false
        }
        if argv[i] == "-o" || argv[i] == "--output" || argv[i] == "--target" || argv[i] == "--www" || argv[i] == "--board" || argv[i] == "--xacp-port" {
            skip = 1
            ->
        }
        if argv[i] == "-h" || argv[i] == "--help" {
            << true
        }
    }
    << false
}

fn tool_exec(name string, argv_tail []string) int {
    n := str_clone(&name)
    bin := tool_beside_self(n)
    if bin.len == 0 {
        if args_have_help(&argv_tail) {
            print_sibling_help(name)
            << 0
        }
        eprintln("xu: missing sibling `" + name + "` (run `make xu` / `make " + name + "`, or install next to xu on PATH)")
        << 127
    }
    << cli_exec(bin, argv_tail)
}

fn parse_count(s string) int {
    $n := 0
    if s.len == 0 {
        << -1
    }
    for i in 0:s.len {
        d := s[i] - 48
        if d < 0 || d > 9 {
            << -1
        }
        n = n * 10 + d
        if n > 1000 {
            << -1
        }
    }
    << n
}

// XACP ports are compile-time configuration, so reject malformed values
// before any source loading starts.  Port 0 means that no TCP endpoint is
// selected; the first implementation remains stdio-only.
fn parse_xacp_port(s string) int {
    if s.len == 0 {
        << -1
    }
    $n := 0
    for i in 0:s.len {
        d := s[i] - 48
        if d < 0 || d > 9 {
            << -1
        }
        n = n * 10 + d
        if n > 65535 {
            << -1
        }
    }
    << n
}

fn xacp_port_inline(s &string) int {
    prefix := "--xacp-port="
    if !val_has_prefix(s, prefix) {
        << -1
    }
    << parse_xacp_port(s[prefix.len:s.len])
}

// One versioned automatic policy for build/run/test. Keep ordinary users on
// the validated profile; -On and --ra remain diagnostic/compatibility controls.
const COMPILE_DEFAULT_OPT_LEVEL = 1

fn parse_o_flag(s string) int {
    if s == "--no-opt" || s == "--debug-build" { << 0 }
    if s == "-O0" { << 0 }
    if s == "-O1" { << 1 }
    if s == "-O2" { << 2 }
    if s == "-O3" { << 3 }
    << 0 - 1
}

fn parse_ra_flag(s string) int {
    if s == "--ra=0" { << 0 }
    if s == "--ra0" { << 0 }
    if s == "--ra=1" { << 1 }
    if s == "--ra1" { << 1 }
    if s == "--ra=2" { << 2 }
    if s == "--ra2" { << 2 }
    if s == "--ra=3" { << 3 }
    if s == "--ra3" { << 3 }
    << 0 - 1
}

fn main() int {
    argv := os.argv()
    // Help / errors use argv[0]'s basename: gate copies this binary as
    // `gen1`, product install is `xu`.
    // Clone argv[0] once in this frame.  Passing the old shallow sys_args
    // aggregate through multiple helpers let the bootstrap compiler treat
    // its first element as a transient owner and clear the global element.
    $prog := "xu"
    $host_code := xu_target_os() * 10 + host_native_arch()
    if argv.len > 0 {
        $prog_bytes := []int{}
        for i in 0:argv[0].len { prog_bytes.push(argv[0][i]) }
        prog = string_from_bytes(prog_bytes)
        host_code = host_target_code_from_bin(&prog)
        $cut := 0 - 1
        for i in 0:prog.len {
            if prog[i] == 47 || prog[i] == 92 { cut = i }
        }
        if cut >= 0 { prog = prog[cut + 1:prog.len] }
        if prog.len == 0 { prog = "xu" }
    }
    if argv.len >= 2 {
        if argv[1] == "help" {
            if argv.len == 2 {
                print_help_lines(&prog, 0)
                << 0
            }
            sub := argv[2]
            if sub == "-h" || sub == "--help" {
                print_help_lines(&prog, 0)
                << 0
            }
            if sub == "build" {
                print_build_help(&prog)
                << 0
            }
            if sub == "debug" {
                debug_help(&prog)
                << 0
            }
            if sub == "run" {
                print_run_help(&prog)
                << 0
            }
            if sub == "test" {
                print_test_help(&prog)
                << 0
            }
            if sub == "check" {
                print_check_help(&prog)
                << 0
            }
            if sub == "parse" {
                print_parse_help(&prog)
                << 0
            }
            if sub == "init" {
                print_init_help(&prog)
                << 0
            }
            if sub == "get" {
                get_help()
                << 0
            }
            if sub == "install" {
                print_install_help(&prog)
                << 0
            }
            if sub == "env" {
                print_env_help(&prog)
                << 0
            }
            if sub == "fmt" {
                print_fmt_help(&prog)
                << 0
            }
            if sub == "map" {
                print_map_help(&prog)
                << 0
            }
            if sub == "doc" {
                print_doc_help(&prog)
                << 0
            }
            if sub == "doctor" {
                print_doctor_help(&prog)
                << 0
            }
            if sub == "setup" {
                print_setup_help(&prog)
                << 0
            }
            if sub == "native" {
                print_native_help(&prog)
                << 0
            }
            if sub == "xacp" {
                print_xacp_help(&prog)
                << 0
            }
            if sub == "lsp" {
                print_lsp_help(&prog)
                << 0
            }
            if sub == "desktop" {
                print_desktop_help(&prog)
                << 0
            }
            if sub == "up" || sub == "update" {
                print_update_help()
                << 0
            }
            eprintln(cli_prog() + " help: unknown subcommand '" + sub + "'")
            << 1
        }
        if argv[1] == "lsp" {
            $largs := []string{}
            for j in 2:argv.len {
                largs.push(argv[j])
            }
            << tool_exec("xu-lsp", largs)
        }
        if argv[1] == "doc" {
            $dargs := []string{}
            for j in 2:argv.len {
                dargs.push(argv[j])
            }
            << tool_exec("xu-doc", dargs)
        }
        if argv[1] == "--ver" || argv[1] == "--version" {
            println("    __  __  _   _  ")
            println("    \\ \\/ / | | | |   Xu Compiler Toolchain v" + compiler_version())
            println("     \\  /  | | | |   Rock-Solid Ownership - Zero GC - Supersonic AOT")
            println("     /  \\  | |_| |   Docs: https://xulang.org")
            println("    /_/\\_\\  \\___/    Target: " + target_name(host_code) + " - 64-bit Native")
            << 0
        }
        if argv[1] == "env" {
            if argv_sub_has_help(&argv) {
                print_env_help(&prog)
                << 0
            }
            $e_std := require_stdlib_root()
            $e_root := ""
            if e_std.len > 0 {
                e_root = path_dirname(&e_std)
            } else {
                e_root = env_get("XU_ROOT")
            }
            e_ver := compiler_version()
            e_xupath := env_get("XUPATH")
            $e_cache := env_get("XU_CACHE")
            if e_cache.len == 0 {
                h := os.home_dir()
                if h.len > 0 { e_cache = h + "/.xu/pkg" }
            }
            $e_proxy := env_get("XUPROXY")
            if e_proxy.len == 0 { e_proxy = "direct" }
            e_sumdb := env_get("XUSUMDB")
            e_priv := env_get("XUPRIVATE")
            $host_os_s := target_os_name(host_code)
            $host_arch_s := target_arch_name(host_code)
            $xuos_s := env_get("XUOS")
            if xuos_s.len == 0 { xuos_s = host_os_s + "" }
            $xuarch_s := env_get("XUARCH")
            if xuarch_s.len == 0 { xuarch_s = host_arch_s + "" }

            if argv.len > 2 {
                for i in 2:argv.len {
                    req := argv[i]
                    if req == "XU_VERSION" { println(e_ver) }
                    else if req == "XU_ROOT" { println(e_root) }
                    else if req == "XU_STDLIB_ROOT" { println(e_std) }
                    else if req == "XUPATH" { println(e_xupath) }
                    else if req == "XU_CACHE" { println(e_cache) }
                    else if req == "XUOS" { println(xuos_s) }
                    else if req == "XUARCH" { println(xuarch_s) }
                    else if req == "HOST_OS" { println(host_os_s) }
                    else if req == "HOST_ARCH" { println(host_arch_s) }
                    else if req == "XUPROXY" { println(e_proxy) }
                    else if req == "XUSUMDB" { println(e_sumdb) }
                    else if req == "XUPRIVATE" { println(e_priv) }
                    else { println("") }
                }
                << 0
            }

            println("XU_VERSION=\"" + e_ver + "\"")
            println("XU_ROOT=\"" + e_root + "\"")
            println("XU_STDLIB_ROOT=\"" + e_std + "\"")
            println("XUPATH=\"" + e_xupath + "\"")
            println("XU_CACHE=\"" + e_cache + "\"")
            println("XUOS=\"" + xuos_s + "\"")
            println("XUARCH=\"" + xuarch_s + "\"")
            println("HOST_OS=\"" + host_os_s + "\"")
            println("HOST_ARCH=\"" + host_arch_s + "\"")
            println("XUPROXY=\"" + e_proxy + "\"")
            println("XUSUMDB=\"" + e_sumdb + "\"")
            println("XUPRIVATE=\"" + e_priv + "\"")
            << 0
        }
        if argv[1] == "up" || argv[1] == "update" {
            << run_update(&argv, host_code)
        }
        if argv[1] == "get" { << run_get(&argv) }
        if argv[1] == "_get-install" { << run_get_install(&argv) }
        if argv[1] == "install" {
            if argv_sub_has_help(&argv) {
                print_install_help(&prog)
                << 0
            }
            $dir := "."
            $dir_set := false
            for i in 2:argv.len {
                arg := argv[i]
                if require_policy_flag(&arg) { -> }
                if dir_set || (arg.len > 0 && arg[0] == 45) {
                    eprintln(prog + " install: unexpected argument " + arg)
                    << 1
                }
                dir = cli_arg_owned(&argv, i)
                dir_set = true
            }
            << run_install(dir)
        }
        if argv[1] == "doctor" {
            $dargs := []string{}
            for j in 2:argv.len {
                dargs.push(argv[j])
            }
            << tool_exec("xu-doctor", dargs)
        }
        if argv[1] == "setup" {
            $sargs := []string{}
            for j in 2:argv.len {
                sargs.push(argv[j])
            }
            << tool_exec("xu-setup", sargs)
        }
        if argv[1] == "native" {
            $nargs := []string{}
            for j in 2:argv.len {
                nargs.push(argv[j])
            }
            << tool_exec("xu-native", nargs)
        }
        if argv[1] == "_macho_o" {
            if argv.len < 4 {
                eprintln(prog + " _macho_o: need input.xuobj output.o")
                << 1
            }
            << xuobj_write_macho_o(argv[2], argv[3])
        }
        if argv[1] == "_coff_o" {
            if argv.len < 4 {
                eprintln(prog + " _coff_o: need input.xuobj output.o")
                << 1
            }
            << xuobj_coff_convert(argv[2], argv[3])
        }
        if argv[1] == "_elf_o" {
            if argv.len < 4 {
                eprintln(prog + " _elf_o: need input.xuobj output.o")
                << 1
            }
            << xuobj_elf_convert(argv[2], argv[3])
        }
        if argv[1] == "-h" || argv[1] == "--help" {
            print_help_lines(&prog, 0)
            << 0
        }
    }
    if argv.len < 2 {
        print_help_lines(&prog, 1)
        << 1
    }
    if argv[1] == "init" {
        << run_init_cmd(&argv)
    }
        if argv[1] == "fmt" {
        $fargs := []string{}
        for j in 2:argv.len {
            fargs.push(argv[j])
        }
        << tool_exec("xu-fmt", fargs)
    }
    if argv[1] == "map" {
        $margs := []string{}
        for j in 2:argv.len {
            margs.push(argv[j])
        }
        << tool_exec("xu-map", margs)
    }
    if argv[1] == "parse" {
        if argv_sub_has_help(&argv) {
            print_parse_help(&prog)
            << 0
        }
        if argv.len < 3 {
            eprintln(cli_prog() + " parse: no input files")
            << 1
        }
        for i in 2:argv.len {
            // An indexed argv string is a view into the owning argument
            // array.  `parse_one` retains the path while building diagnostics;
            // clone it before transferring ownership so a later argv drop
            // cannot leave a dangling descriptor.
            path := cli_arg_owned(&argv, i)
            parse_one(path)
        }
        << 0
    }
    if argv[1] == "check" {
        if argv_sub_has_help(&argv) {
            print_check_help(&prog)
            << 0
        }
        if argv.len < 3 {
            eprintln(cli_prog() + " check: no input files")
            << 1
        }
        $paths := []string{}
        $target_code := 0
        $target_set := false
        $lib_mode := 0
        $skip := 0
        for j in 2:argv.len {
            if skip == 1 {
                skip = 0
            } else {
                policy_arg := argv[j]
                if require_policy_flag(&policy_arg) { -> }
                if argv[j] == "--lib" {
                    lib_mode = 1
                } else if argv[j] == "--target" {
                    if j + 1 >= argv.len {
                        eprintln(cli_prog() + " check: --target requires a path")
                        << 1
                    }
                    t := parse_target(argv[j + 1])
                    if t < 0 {
                        eprintln(cli_prog() + ": unknown --target (want macos-arm64|macos-x64|linux-arm64|linux-x64|linux-loongarch64|linux-riscv64|linux-arm32|windows-x64|windows-arm64|thumbv7em-none|riscv32imac-none|xtensa-esp32-none|wasm32)")
                        << 1
                    }
                    target_code = t
                    target_set = true
                    skip = 1
                } else {
                    paths.push(argv[j])
                }
            }
        }
        if paths.len == 0 {
            eprintln(cli_prog() + " check: no input files")
            << 1
        }
        target_code = apply_env_target_host(target_set, target_code, host_code)
        $p := empty_parser()
        $native_objs := []XuObject{}
        $native_temps := []string{}
        load_unit_m18(paths, $&p, target_code, $&native_objs, $&native_temps, false, 0)
        hold_check_only(&p, target_code, lib_mode)
        cleanup_native_paths(&native_temps)
        << 0
    }
    if argv[1] == "test" {
        << run_test_cmd(&argv, host_code)
    }
    if argv[1] == "run" {
        << run_run_cmd(&argv)
    }
    if argv[1] == "build" {
        << run_build_cmd(&argv)
    }
    if argv[1] == "debug" {
        << run_debug_cmd(&argv)
    }
    sub_name := argv[1]
    sibling_name := "xu-" + sub_name
    sibling_bin := tool_beside_self(sibling_name)
    if sibling_bin.len > 0 {
        $sub_args := []string{}
        for j in 2:argv.len {
            sub_args.push(argv[j])
        }
        << cli_exec(sibling_bin, sub_args)
    }
    eprintln(cli_prog() + ": unknown subcommand (want init|parse|check|test|fmt|map|build|run|debug|get|install|lsp|doc|up|update|doctor|native)")
    << 1
}

fn run_init_cmd(argv &[]string) int {
    prog := cli_prog_from(argv)
    if argv_sub_has_help(argv) {
        print_init_help(&prog)
        << 0
    }
    manifest_path := "xu.xun"
    if path_exists(&manifest_path) {
        eprintln(cli_prog() + " init: xu.xun already exists")
        << 1
    }
    cur_dir := cwd()
    $mod_name := ""
    if argv.len > 2 {
        mod_name = cli_arg_owned(argv, 2)
    } else {
        mod_name = filepath.base(&cur_dir)
        if mod_name == "" || mod_name == "." || mod_name == "/" {
            mod_name = "app"
        }
    }
    ver := compiler_version()

    manifest := "module: " + mod_name + "\nversion: !ver 0.1.0\nxu: !ver " + ver + "\n"
    write_file(manifest_path + "", manifest + "") or (err) {
        eprintln(cli_prog() + " init: failed to write xu.xun: " + err.msg())
        << 1
    }

    main_path := "main.xu"
    if !path_exists(&main_path) {
        main_code := "@main\n\nfn main() int {\n    println(\"Hello, Xu!\")\n    << 0\n}\n"
        write_file(main_path + "", main_code + "") or (err) {
            eprintln(cli_prog() + " init: failed to write main.xu: " + err.msg())
            << 1
        }
    }

    println("Initialized Xu module '" + mod_name + "' in " + cur_dir)
    << 0
}

fn run_test_cmd(argv &[]string, host_code int) int {
    prog := cli_prog_from(argv)
    if argv_sub_has_help(argv) {
        print_test_help(&prog)
        << 0
    }
    if argv.len < 3 {
        eprintln(cli_prog() + " test: no input files")
        << 1
    }
    $paths := []string{}
    $out := ""
    $out_set := false
    $target_code := 0
    $target_set := false
    $filter := ""
    $verbose := false
    $cover := false
    $debug := false
    $no_regcache := false
    $opt_level := COMPILE_DEFAULT_OPT_LEVEL
    $ra_level := COMPILE_DEFAULT_OPT_LEVEL
    $ra_explicit := false
    $failfast := false
    $count := 1
    $list_mode := false
    $short := false
    $bench := ""
    $allow_int64_pairs := false
    $board := ""
    $skip := 0
    for j in 2:argv.len {
        if skip == 1 {
            skip = 0
        } else {
            policy_arg := argv[j]
            if require_policy_flag(&policy_arg) { -> }
            ov := parse_o_flag(argv[j])
            if ov >= 0 {
                opt_level = ov
                if argv[j] == "--debug-build" { debug = true }
                if !ra_explicit {
                    ra_level = ov
                }
            } else {
            if argv[j] == "-o" || argv[j] == "--output" {
                if j + 1 >= argv.len {
                    eprintln(cli_prog() + " test: -o requires a path")
                    << 1
                }
                out = cli_arg_owned(argv, j + 1)
                out_set = true
                skip = 1
            } else {
                if argv[j] == "--target" {
                    if j + 1 >= argv.len {
                        eprintln(cli_prog() + " test: --target requires a path")
                        << 1
                    }
                    t := parse_target(argv[j + 1])
                    if t < 0 {
                        eprintln(cli_prog() + ": unknown --target")
                        << 1
                    }
                    target_code = t
                    target_set = true
                    skip = 1
                } else {
                    if argv[j] == "-run" {
                        if j + 1 >= argv.len {
                            eprintln(cli_prog() + " test: -run requires a pattern")
                            << 1
                        }
                        filter = cli_arg_owned(argv, j + 1)
                        skip = 1
                    } else {
                        if argv[j] == "-v" {
                            verbose = true
                        } else {
                            if argv[j] == "--cover" {
                                cover = true
                            } else {
                                if argv[j] == "--debug" {
                                    debug = true
                                } else {
                                    if argv[j] == "--no-regcache" {
                                        no_regcache = true
                                    } else {
                                        rv := parse_ra_flag(argv[j])
                                        if rv >= 0 {
                                            ra_level = rv
                                            ra_explicit = true
                                        } else {
                                        if argv[j] == "-failfast" {
                                            failfast = true
                                        } else {
                                            if argv[j] == "-list" {
                                                list_mode = true
                                            } else {
                                                if argv[j] == "-short" {
                                                    short = true
                                                } else {
                                                    if argv[j] == "-count" {
                                                        if j + 1 >= argv.len {
                                                            eprintln(cli_prog() + " test: -count requires N")
                                                            << 1
                                                        }
                                                        count = parse_count(argv[j + 1])
                                                        if count < 1 {
                                                            eprintln(cli_prog() + " test: -count requires N")
                                                            << 1
                                                        }
                                                        skip = 1
                                                    } else {
                                                        if argv[j] == "-bench" {
                                                            if j + 1 >= argv.len {
                                                                eprintln(cli_prog() + " test: -bench requires a pattern")
                                                                << 1
                                                            }
                                                            bench = cli_arg_owned(argv, j + 1)
                                                            skip = 1
                                                        } else {
                                                            if argv[j] == "--allow-int64-pairs" {
                                                                allow_int64_pairs = true
                                                            } else if argv[j] == "--board" {
                                                                if j + 1 >= argv.len {
                                                                    eprintln(cli_prog() + " test: --board requires a name")
                                                                    << 1
                                                                }
                                                                board = cli_arg_owned(argv, j + 1)
                                                                skip = 1
                                                            } else {
                                                                paths.push(cli_arg_owned(argv, j))
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        }
    }
    if paths.len == 0 {
        eprintln(cli_prog() + " test: no input files")
        << 1
    }
    target_code = apply_env_target_host(target_set, target_code, host_code)
    $out_final := ""
    if out_set {
        out_final = ensure_bin_suffix(out, target_code)
    }
    if out_set == false {
        out_final = default_output_path(&paths, target_code)
    }
    out = out_final
    if target_os(target_code) == 3 || target_code == 46 {
        eprintln(cli_prog() + " test: native test harness is unavailable on freestanding or WASM targets")
        << 1
    }
    $t_front := now_ns()
    $p := empty_parser()
    $native_objs := []XuObject{}
    $native_temps := []string{}
    load_unit_m18(paths, $&p, target_code, $&native_objs, $&native_temps, false, 0)
    $native_paths := []string{}
    collect_native_paths(&native_objs, $&native_paths)
    front_ms := (now_ns() - t_front) / TIME_NS_PER_MILLISECOND
    all_tests := p.inject_test_harness()
    $names := []string{}
    for i in 0:all_tests.len {
        if types.run_pattern_matches(filter, all_tests[i]) {
            names.push(all_tests[i])
        }
    }
    if bench.len > 0 {
        benches := p.collect_bench_names()
        for i in 0:benches.len {
            if types.run_pattern_matches(bench, benches[i]) {
                names.push(benches[i])
            }
        }
    }
    if names.len == 0 {
        eprintln(cli_prog() + " test: no test functions match -run pattern '" + filter + "'")
        cleanup_native_paths(&native_temps)
        << 1
    }
    if native_paths.len > 0 {
        eprintln("xu test: native modules are pending test-harness XUOBJ linkage")
        cleanup_native_paths(&native_temps)
        << 1
    }
    rc_build := build_parser($&p, out, target_code, BuildOpts{names: names, filter: "", verbose: verbose, cover: cover, test: true, debug: debug, timings: false, no_regcache: no_regcache, opt_level: opt_level, ra_level: ra_level, lib: false, shared: false, emit_obj: false, objs: native_objs, failfast: failfast, count: count, list: list_mode, short: short, bench: bench, allow_int64_pairs: allow_int64_pairs, board: board, xacp: false, xacp_port: 0}, front_ms)
    cleanup_native_paths(&native_temps)
    << rc_build
}

fn host_bin_tail_eq(bin &string, start int, end int, lit string) bool {
    if end - start != lit.len { << false }
    for i in 0:lit.len {
        if bin[start + i] != lit[i] { << false }
    }
    << true
}

fn host_from_bin_name_string(bin &string) int {
    // Parse the executable basename in place. Avoid both `s + ""` aliases
    // and owning string/slice temporaries: this path runs before every hosted
    // command and must stay valid after test-option argv moves.
    $start := 0
    $end := bin.len
    for i in 0:end {
        if bin[i] == 47 || bin[i] == 92 {
            start = i + 1
        }
    }
    if end - start >= 4 {
        e0 := bin[end - 4]
        e1 := bin[end - 3]
        e2 := bin[end - 2]
        e3 := bin[end - 1]
        if e0 == 46 && (e1 == 101 || e1 == 69) && (e2 == 120 || e2 == 88) && (e3 == 101 || e3 == 69) {
            end -= 4
        }
    }
    if end - start < 4 {
        << -1
    }
    if bin[start] != 120 || bin[start + 1] != 117 || bin[start + 2] != 46 {
        << -1
    }
    tail := start + 3
    if host_bin_tail_eq(bin, tail, end, "macos.arm64") { << 0 }
    if host_bin_tail_eq(bin, tail, end, "macos.x64") { << 1 }
    if host_bin_tail_eq(bin, tail, end, "linux.arm64") { << 10 }
    if host_bin_tail_eq(bin, tail, end, "linux.x64") { << 11 }
    if host_bin_tail_eq(bin, tail, end, "linux.loongarch64") { << 14 }
    if host_bin_tail_eq(bin, tail, end, "linux.riscv64") { << 15 }
    if host_bin_tail_eq(bin, tail, end, "linux.arm32") { << 12 }
    if host_bin_tail_eq(bin, tail, end, "linux.arm") { << 12 }
    if host_bin_tail_eq(bin, tail, end, "linux.armv7") { << 12 }
    if host_bin_tail_eq(bin, tail, end, "windows.x64") { << 21 }
    if host_bin_tail_eq(bin, tail, end, "windows.arm64") { << 20 }
    if host_bin_tail_eq(bin, tail, end, "thumbv7em.none") { << 32 }
    if host_bin_tail_eq(bin, tail, end, "thumb.none") { << 32 }
    if host_bin_tail_eq(bin, tail, end, "riscv32imac.none") { << 33 }
    if host_bin_tail_eq(bin, tail, end, "riscv32.none") { << 33 }
    if host_bin_tail_eq(bin, tail, end, "xtensa-esp32.none") { << 37 }
    if host_bin_tail_eq(bin, tail, end, "xtensa.none") { << 37 }
    << -1
}

fn host_target_code_from_bin(bin &string) int {
    bn := host_from_bin_name_string(bin)
    if bn >= 0 {
        << bn
    }
    << xu_target_os() * 10 + host_native_arch()
}

fn host_target_code() int {
    argv := os.argv()
    if argv.len > 0 {
        << host_target_code_from_bin(&argv[0])
    }
    << xu_target_os() * 10 + host_native_arch()
}

fn run_wait_exit(rc int) int {
    if rc < 0 {
        << 127
    }
    << (rc >> 8) & 255
}

fn collect_native_paths(objs &[]XuObject, paths $&[]string) {
    for i in 0:objs.len {
        if objs[i].kind == 1 || objs[i].kind == 2 {
            p := objs[i].path
            paths.push(p + "")
        }
    }
}

fn cleanup_native_paths(paths &[]string) {
    for i in 0:paths.len {
        p := paths[i]
        os_system("rm -f " + tool_shell_quote(&p))
    }
}

fn cleanup_native_build_files(xuobj &string, native_o &string) {
    os_system("rm -f " + tool_shell_quote(xuobj) + " " + tool_shell_quote(native_o))
}

fn link_native_macos(xuobj string, out string, target_code int, archives &[]string) int {
    native_o := xuobj + ".o"
    rc_obj := xuobj_write_macho_o_native(xuobj + "", native_o + "")
    if rc_obj != 0 {
        cleanup_native_build_files(&xuobj, &native_o)
        << rc_obj
    }
    clang := tool_beside_self("clang")
    if clang.len == 0 {
        eprintln("xu build: native static link needs clang on PATH")
        cleanup_native_build_files(&xuobj, &native_o)
        << 127
    }
    $triple := "arm64-apple-macos11"
    if target_arch(target_code) == 1 {
        triple = "x86_64-apple-macos11"
    }
    $cmd := tool_shell_quote(&clang) + " --target=" + triple + " " + tool_shell_quote(&native_o)
    sdkroot := os.getenv("SDKROOT")
    if sdkroot.len > 0 {
        cmd = cmd + " -isysroot " + tool_shell_quote(&sdkroot)
    } else {
        xcode_sdk := "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk"
        if path_exists(&xcode_sdk) {
            cmd = cmd + " -isysroot " + tool_shell_quote(&xcode_sdk)
        }
    }
    for i in 0:archives.len {
        p := archives[i]
        cmd = cmd + " " + tool_shell_quote(&p)
    }
    cmd = cmd + " -Wl,-e,_xu_app_start -nostartfiles -o " + tool_shell_quote(&out)
    rc := run_wait_exit(os_system(cmd))
    cleanup_native_build_files(&xuobj, &native_o)
    if rc != 0 {
        eprintln("xu build: native static linker failed with exit status " + str(rc))
    }
    << rc
}

fn run_exec_built(bin string, pargs &[]string, keep int) int {
    if xu_target_os() != 2 { os.chmod(str_clone(&bin), 493) or (err) { << 1 } }
    $args := []string{}
    for i in 0:pargs.len {
        args.push(str_clone(&pargs[i]))
    }
    actual := filepath.abs(&bin)
    rc := cli_exec(actual, args)
    if keep == 0 {
        os.remove(str_clone(&bin)) or (err) { << rc }
    }
    << rc
}

fn parser_has_ui(p &parser.Parser) bool {
    for mi in 0:p.mod_ids.len {
        mid := p.mod_ids[mi]
        if mid == "ui" || val_has_prefix(&mid, "ui/") {
            << true
        }
    }
    << false
}

fn val_has_suffix(s &string, suff string) bool {
    if suff.len > s.len {
        << false
    }
    offset := s.len - suff.len
    for i in 0:suff.len {
        if s[offset + i] != suff[i] {
            << false
        }
    }
    << true
}

fn desktop_run_app_name(path &string) string {
    $cut := 0 - 1
    for i in 0:path.len {
        if path[i] == 47 {
            cut = i
        }
    }
    $base := ""
    if cut < 0 {
        base = path + ""
    } else if cut + 1 < path.len {
        base = path[cut + 1:path.len]
    }
    if val_has_suffix(&base, ".app") && base.len > 4 {
        base = base[0:base.len - 4]
    }
    if base.len == 0 {
        base = "XuApp"
    }
    << base
}

fn run_run_cmd(argv &[]string) int {
    prog := cli_prog_from(argv)
    $help_skip := 0
    $in_pargs := 0
    for i in 2:argv.len {
        if argv[i] == "--" {
            in_pargs = 1
        } else if in_pargs == 0 {
            if help_skip == 1 {
                help_skip = 0
                ->
            }
            if argv[i] == "-o" || argv[i] == "--output" || argv[i] == "--target" || argv[i] == "--board" || argv[i] == "--xacp-port" || argv[i] == "--www" {
                help_skip = 1
                ->
            }
            if argv[i] == "-h" || argv[i] == "--help" {
                print_run_help(&prog)
                << 0
            }
        }
    }
    if argv.len < 3 {
        eprintln(cli_prog() + " run: no input file")
        << 1
    }
    $out := ""
    $out_set := false
    $target_code := 0
    $target_set := false
    $cover := false
    $debug := false
    $timings := false
    $desktop := false
    $webview := false
    $no_webview := false
    $www := ""
    $no_regcache := false
    $opt_level := COMPILE_DEFAULT_OPT_LEVEL
    $ra_level := COMPILE_DEFAULT_OPT_LEVEL
    $ra_explicit := false
    $paths := []string{}
    $pargs := []string{}
    $allow_int64_pairs := false
    $board := ""
    $xacp := false
    $xacp_port := 0
    $skip := 0
    $in_args := 0
    for i in 2:argv.len {
        if in_args == 1 {
            pargs.push(argv[i])
        } else {
        if skip == 1 {
            skip = 0
        } else {
            if argv[i] == "--xacp" {
                xacp = true
                ->
            }
            if argv[i] == "--xacp-port" {
                if i + 1 >= argv.len {
                    eprintln(cli_prog() + " run: --xacp-port requires a number")
                    << 1
                }
                port := parse_xacp_port(argv[i + 1])
                if port < 0 {
                    eprintln(cli_prog() + " run: --xacp-port must be an integer in 0..65535")
                    << 1
                }
                xacp = true
                xacp_port = port
                skip = 1
                ->
            }
            xacp_arg := argv[i]
            if val_has_prefix(&xacp_arg, "--xacp-port=") {
                port := xacp_port_inline(&xacp_arg)
                if port < 0 {
                    eprintln(cli_prog() + " run: --xacp-port must be an integer in 0..65535")
                    << 1
                }
                xacp = true
                xacp_port = port
                ->
            }
            if val_has_prefix(&xacp_arg, "--xacp") {
                eprintln(cli_prog() + " run: unknown flag " + xacp_arg)
                << 1
            }
            policy_arg := argv[i]
            if require_policy_flag(&policy_arg) { -> }
            if argv[i] == "--" {
                in_args = 1
            } else {
            ov := parse_o_flag(argv[i])
            if ov >= 0 {
                opt_level = ov
                if argv[i] == "--debug-build" { debug = true }
                if !ra_explicit {
                    ra_level = ov
                }
            } else {
            if argv[i] == "-o" || argv[i] == "--output" {
                if i + 1 >= argv.len {
                    eprintln(cli_prog() + " run: -o requires a path")
                    << 1
                }
                out = argv[i + 1]
                out_set = true
                skip = 1
            } else {
                if argv[i] == "--target" {
                    if i + 1 >= argv.len {
                        eprintln(cli_prog() + " run: --target requires a path")
                        << 1
                    }
                    t := parse_target(argv[i + 1])
                    if t < 0 {
                        eprintln(cli_prog() + ": unknown --target (want macos-arm64|macos-x64|linux-arm64|linux-x64|linux-loongarch64|linux-riscv64|linux-arm32|windows-x64|windows-arm64|thumbv7em-none|riscv32imac-none|xtensa-esp32-none|wasm32)")
                        << 1
                    }
                    target_code = t
                    target_set = true
                    skip = 1
                } else {
                    if argv[i] == "--desktop" {
                        desktop = true
                    } else if argv[i] == "--webview" {
                        webview = true
                    } else if argv[i] == "--no-webview" {
                        no_webview = true
                    } else if argv[i] == "--www" {
                        if i + 1 >= argv.len {
                            eprintln(cli_prog() + " run: --www requires a directory")
                            << 1
                        }
                        www = argv[i + 1]
                        skip = 1
                    } else if argv[i] == "--cover" {
                        cover = true
                    } else {
                        if argv[i] == "--debug" {
                            debug = true
                        } else {
                            if argv[i] == "--timings" {
                                timings = true
                            } else {
                                if argv[i] == "--no-regcache" {
                                    no_regcache = true
                                } else {
                                    rv := parse_ra_flag(argv[i])
                                    if rv >= 0 {
                                        ra_level = rv
                                        ra_explicit = true
                                    } else {
                                        if argv[i] == "--allow-int64-pairs" {
                                            allow_int64_pairs = true
                                        } else if argv[i] == "--board" {
                                            if i + 1 >= argv.len {
                                                eprintln(cli_prog() + " run: --board requires a name")
                                                << 1
                                            }
                                            board = argv[i + 1]
                                            skip = 1
                                        } else if argv[i].len > 0 && argv[i][0] == 45 {
                                            eprintln(cli_prog() + " run: unknown flag " + argv[i])
                                            << 1
                                        } else {
                                            paths.push(argv[i])
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            }
            }
        }
        }
    }
    if paths.len == 0 {
        eprintln(cli_prog() + " run: no input file")
        << 1
    }
    target_code = apply_env_target(target_set, target_code)
    host := host_target_code()
    if target_code != host {
        eprintln(cli_prog() + " run: cannot run cross-compiled binary (target differs from host); use build")
        << 1
    }
    if target_os(target_code) == 3 {
        eprintln(cli_prog() + " run: not available on freestanding targets")
        << 1
    }
    $keep := 0
    $out_final := ""
    if out_set {
        keep = 1
        out_final = ensure_bin_suffix(out, target_code)
    } else {
        out_final = ensure_bin_suffix(os.temp_dir() + "/xu_run_" + str(os.getpid()) + "_" + str(now_ns() & 2147483647), target_code)
    }
    $first_path := ""
    if paths.len > 0 {
        first_path = str_clone(&paths[0])
    }
    $source_paths := []string{}
    $native_objs := []XuObject{}
    $native_temps := []string{}
    split_native_inputs(paths, target_code, $&source_paths, $&native_objs, $&native_temps)
    $t_front := now_ns()
    $p := empty_parser()
    merge_native_stubs($&p, &native_objs)
    load_unit_m18(source_paths, $&p, target_code, $&native_objs, $&native_temps, xacp, xacp_port)
    $native_paths := []string{}
    collect_native_paths(&native_objs, $&native_paths)
    front_ms := (now_ns() - t_front) / TIME_NS_PER_MILLISECOND
    $has_ui := desktop
    if !has_ui {
        has_ui = parser_has_ui(&p)
    }
    if has_ui {
        if xacp {
            eprintln(cli_prog() + " run: --xacp is not yet supported by desktop UI")
            cleanup_native_paths(&native_temps)
            << 1
        }
        if cover || debug {
            eprintln(cli_prog() + " run: desktop UI does not yet support --cover/--debug")
            cleanup_native_paths(&native_temps)
            << 1
        }
        $target_entry := first_path
        $desktop_pack_args := []string{}
        desktop_pack_args.push("pack")
        desktop_pack_args.push(str_clone(&target_entry))
        desktop_pack_args.push("--target")
        desktop_pack_args.push(target_name(target_code))
        $desktop_out := ""
        $desktop_bin := ""
        if out_set {
            desktop_out = out
        } else {
            stamp := str(os.getpid()) + "_" + str(now_ns() & 2147483647)
            if target_os(target_code) == 0 {
                desktop_out = os.temp_dir() + "/xu_run_ui_" + stamp + ".app"
            } else if target_os(target_code) == 2 {
                desktop_out = os.temp_dir() + "/xu_run_ui_" + stamp + ".exe"
            } else {
                desktop_out = os.temp_dir() + "/xu_run_ui_" + stamp
            }
        }
        desktop_pack_args.push("-o")
        desktop_pack_args.push(str_clone(&desktop_out))
        if www.len > 0 {
            desktop_pack_args.push("--www")
            desktop_pack_args.push(str_clone(&www))
        }
        if webview {
            desktop_pack_args.push("--webview")
        }
        if no_webview {
            desktop_pack_args.push("--no-webview")
        }
        st_pack := tool_exec("xu-desktop", desktop_pack_args)
        cleanup_native_paths(&native_temps)
        if st_pack != 0 {
            << st_pack
        }
        if target_os(target_code) == 0 {
            $app_path := str_clone(&desktop_out)
            if !val_has_suffix(&app_path, ".app") {
                app_path = app_path + ".app"
            }
            $bundle_name := desktop_run_app_name(&app_path)
            desktop_bin = app_path + "/Contents/MacOS/" + bundle_name
            desktop_out = str_clone(&app_path)
        } else {
            desktop_bin = str_clone(&desktop_out)
        }
        rc_run := run_exec_built(str_clone(&desktop_bin), &pargs, 1)
        if keep == 0 {
            if target_os(target_code) == 0 {
                _ := os_system("rm -rf " + tool_shell_quote(&desktop_out))
            } else {
                os.remove(str_clone(&desktop_out)) or (err) { << rc_run }
            }
        }
        << rc_run
    }
    $st := 0
    if native_paths.len > 0 {
        if target_os(target_code) != 0 || (target_arch(target_code) != 0 && target_arch(target_code) != 1) {
            eprintln("xu run: one-step native static link currently requires macos-arm64 or macos-x64")
            cleanup_native_paths(&native_temps)
            << 1
        }
        $tmp := os.temp_dir()
        if tmp.len == 0 {
            tmp = "/tmp"
        }
        xuobj_path := tmp + "/xu_native_run_" + str(now_ns() & 2147483647) + ".xuobj"
        st = build_parser($&p, xuobj_path + "", target_code, BuildOpts{names: []string{}, filter: "", verbose: false, cover: cover, test: false, debug: debug, timings: timings, no_regcache: no_regcache, opt_level: opt_level, ra_level: ra_level, lib: false, shared: false, emit_obj: true, objs: native_objs, failfast: false, count: 1, list: false, short: false, bench: "", allow_int64_pairs: allow_int64_pairs, board: board, xacp: xacp, xacp_port: xacp_port}, front_ms)
        if st == 0 {
            st = link_native_macos(xuobj_path, out_final + "", target_code, &native_paths)
        } else {
            native_o := xuobj_path + ".o"
            cleanup_native_build_files(&xuobj_path, &native_o)
        }
        cleanup_native_paths(&native_temps)
        if st != 0 {
            if keep == 0 {
                os.remove(str_clone(&out_final)) or (err) { << st }
            }
            << st
        }
        << run_exec_built(str_clone(&out_final), &pargs, keep)
    }
    st = build_parser($&p, str_clone(&out_final), target_code, BuildOpts{names: []string{}, filter: "", verbose: false, cover: cover, test: false, debug: debug, timings: timings, no_regcache: no_regcache, opt_level: opt_level, ra_level: ra_level, lib: false, shared: false, emit_obj: false, objs: native_objs, failfast: false, count: 1, list: false, short: false, bench: "", allow_int64_pairs: allow_int64_pairs, board: board, xacp: xacp, xacp_port: xacp_port}, front_ms)
    if st != 0 {
        if keep == 0 {
            os.remove(str_clone(&out_final)) or (err) { << st }
        }
        << st
    }
    << run_exec_built(str_clone(&out_final), &pargs, keep)
}

fn arg_is_emit_obj(s &string) int {
    if s.len != 10 {
        << 0
    }
    if s[0] == 45 && s[1] == 45 && s[2] == 101 && s[3] == 109 && s[4] == 105 && s[5] == 116 && s[6] == 45 && s[7] == 111 && s[8] == 98 && s[9] == 106 {
        << 1
    }
    << 0
}

fn run_build_cmd(argv &[]string) int {
    prog := cli_prog_from(argv)
    if argv_sub_has_help(argv) {
        print_build_help(&prog)
        << 0
    }
    if argv.len < 3 {
        eprintln(cli_prog() + " build: no input file")
        << 1
    }
    $out := ""
    $out_set := false
    $target_code := 0
    $target_set := false
    $cover := false
    $debug := false
    $timings := false
    $no_regcache := false
    $opt_level := COMPILE_DEFAULT_OPT_LEVEL
    $ra_level := COMPILE_DEFAULT_OPT_LEVEL
    $ra_explicit := false
    $no_opt_profile := false
    $desktop := false
    $webview := false
    $no_webview := false
    $emit_obj := false
    $www := ""
    $xacp := false
    $xacp_port := 0
    $paths := []string{}
    $allow_int64_pairs := false
    $board := ""
    $skip := 0
    for i in 2:argv.len {
        if skip == 1 {
            skip = 0
        } else {
            if argv[i] == "--xacp" {
                xacp = true
                ->
            }
            if argv[i] == "--xacp-port" {
                if i + 1 >= argv.len {
                    eprintln(cli_prog() + " build: --xacp-port requires a number")
                    << 1
                }
                port := parse_xacp_port(argv[i + 1])
                if port < 0 {
                    eprintln(cli_prog() + " build: --xacp-port must be an integer in 0..65535")
                    << 1
                }
                xacp = true
                xacp_port = port
                skip = 1
                ->
            }
            xacp_arg := argv[i]
            if val_has_prefix(&xacp_arg, "--xacp-port=") {
                port := xacp_port_inline(&xacp_arg)
                if port < 0 {
                    eprintln(cli_prog() + " build: --xacp-port must be an integer in 0..65535")
                    << 1
                }
                xacp = true
                xacp_port = port
                ->
            }
            if val_has_prefix(&xacp_arg, "--xacp") {
                eprintln(cli_prog() + " build: unknown flag " + xacp_arg)
                << 1
            }
            policy_arg := argv[i]
            if require_policy_flag(&policy_arg) { -> }
            ov := parse_o_flag(argv[i])
            if ov >= 0 {
                opt_level = ov
                if argv[i] == "--debug-build" { debug = true }
                if argv[i] == "--no-opt" || argv[i] == "--debug-build" { no_opt_profile = true }
                if !ra_explicit {
                    ra_level = ov
                }
            } else {
            if argv[i] == "-o" || argv[i] == "--output" {
                if i + 1 >= argv.len {
                    eprintln(cli_prog() + " build: -o requires a path")
                    << 1
                }
                out = argv[i + 1]
                out_set = true
                skip = 1
            } else {
                if argv[i] == "--target" {
                    if i + 1 >= argv.len {
                        eprintln(cli_prog() + " build: --target requires a path")
                        << 1
                    }
                    t := parse_target(argv[i + 1])
                    if t < 0 {
                        eprintln(cli_prog() + ": unknown --target (want macos-arm64|macos-x64|linux-arm64|linux-x64|linux-loongarch64|linux-riscv64|linux-arm32|windows-x64|windows-arm64|thumbv7em-none|riscv32imac-none|xtensa-esp32-none|wasm32)")
                        << 1
                    }
                    target_code = t
                    target_set = true
                    skip = 1
                } else {
                    if argv[i] == "--www" {
                        if i + 1 >= argv.len {
                            eprintln(cli_prog() + " build: --www requires a path")
                            << 1
                        }
                        www = argv[i + 1]
                        skip = 1
                    } else {
                        if argv[i] == "--desktop" {
                            desktop = true
                        } else {
                            if argv[i] == "--webview" {
                                webview = true
                            } else {
                                if argv[i] == "--no-webview" {
                                    no_webview = true
                                } else {
                                    if argv[i] == "--cover" {
                                        cover = true
                                    } else {
                                        if argv[i] == "--debug" {
                                            debug = true
                                        } else {
                                            if argv[i] == "--timings" {
                                                timings = true
                                            } else {
                                                if argv[i] == "--no-regcache" {
                                                    no_regcache = true
                                                } else {
                                                    rv := parse_ra_flag(argv[i])
                                                    if rv >= 0 {
                                                        ra_level = rv
                                                        ra_explicit = true
                                                    } else {
                                                    ai := argv[i]
                                                    if arg_is_emit_obj(&ai) == 1 {
                                                        emit_obj = true
                                                    } else if argv[i] == "--allow-int64-pairs" {
                                                        allow_int64_pairs = true
                                                    } else if argv[i] == "--board" {
                                                        if i + 1 >= argv.len {
                                                            eprintln(cli_prog() + " build: --board requires a name")
                                                            << 1
                                                        }
                                                        board = argv[i + 1]
                                                        skip = 1
                                                    } else {
                                                        paths.push(argv[i])
                                                    }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            }
        }
    }
    if paths.len == 0 {
        eprintln(cli_prog() + " build: no input file")
        << 1
    }
    target_code = apply_env_target(target_set, target_code)
    $out_final := ""
    if out_set {
        out_final = ensure_bin_suffix(out, target_code)
    }
    if out_set == false {
        out_final = default_output_path(&paths, target_code)
    }
    out = out_final
    if desktop && emit_obj {
        eprintln("xu: --desktop conflicts with --emit-obj")
        << 1
    }
    if desktop && require_offline() {
        eprintln("xu: --desktop does not support --offline/--frozen; build the app binary directly")
        << 1
    }
    if desktop {
        if xacp {
            eprintln("xu: --xacp is not yet supported by --desktop; build the app binary directly")
            << 1
        }
        // The packer compiles through its own policy. Do not silently ignore
        // an explicit request for the new source-build profiles.
        if no_opt_profile {
            eprintln("xu: --desktop conflicts with --no-opt/--debug-build")
            << 1
        }
        if cover || debug {
            eprintln("xu: --desktop conflicts with --cover/--debug")
            << 1
        }
        if paths.len != 1 {
            eprintln("xu: --desktop takes exactly one app directory")
            << 1
        }
        $pargs := []string{}
        pargs.push("pack")
        pargs.push(paths[0])
        pargs.push("--target")
        pargs.push(target_name(target_code))
        if out_set {
            pargs.push("-o")
            pargs.push(out)
        }
        if www.len > 0 {
            pargs.push("--www")
            pargs.push(www)
        }
        if webview {
            pargs.push("--webview")
        }
        if no_webview {
            pargs.push("--no-webview")
        }
        << tool_exec("xu-desktop", pargs)
    }
    if cover && target_os(target_code) == 3 {
        eprintln(cli_prog() + " build: --cover is not available on freestanding targets")
        << 1
    }
    if board.len > 0 {
        if target_os(target_code) != 3 || target_arch(target_code) != 2 {
            eprintln(cli_prog() + " build: --board is only supported for freestanding Thumb-2 targets (thumbv7em-none)")
            << 1
        }
        if board != "mps2-an386" && board != "stm32f4" {
            eprintln(cli_prog() + " build: unsupported board '" + board + "' for target 'thumbv7em-none' (supported: mps2-an386, stm32f4)")
            << 1
        }
    }
    $source_paths := []string{}
    $native_objs := []XuObject{}
    $native_temps := []string{}
    split_native_inputs(paths, target_code, $&source_paths, $&native_objs, $&native_temps)
    $t_front := now_ns()
    $p := empty_parser()
    merge_native_stubs($&p, &native_objs)
    load_unit_m18(source_paths, $&p, target_code, $&native_objs, $&native_temps, xacp, xacp_port)
    $native_paths := []string{}
    collect_native_paths(&native_objs, $&native_paths)
    front_ms := (now_ns() - t_front) / TIME_NS_PER_MILLISECOND
    if native_paths.len > 0 && !emit_obj {
        if target_os(target_code) != 0 || (target_arch(target_code) != 0 && target_arch(target_code) != 1) {
            eprintln("xu build: one-step native static link currently requires macos-arm64 or macos-x64; use --emit-obj for this target")
            cleanup_native_paths(&native_temps)
            << 1
        }
        $tmp := os.temp_dir()
        if tmp.len == 0 {
            tmp = "/tmp"
        }
        xuobj_path := tmp + "/xu_native_link_" + str(now_ns() & 2147483647) + ".xuobj"
        rc_build := build_parser($&p, xuobj_path + "", target_code, BuildOpts{names: []string{}, filter: "", verbose: false, cover: cover, test: false, debug: debug, timings: timings, no_regcache: no_regcache, opt_level: opt_level, ra_level: ra_level, lib: false, shared: false, emit_obj: true, objs: native_objs, failfast: false, count: 1, list: false, short: false, bench: "", allow_int64_pairs: allow_int64_pairs, board: board, xacp: xacp, xacp_port: xacp_port}, front_ms)
        if rc_build != 0 {
            cleanup_native_paths(&native_temps)
            << rc_build
        }
        rc_link := link_native_macos(xuobj_path, out + "", target_code, &native_paths)
        cleanup_native_paths(&native_temps)
        << rc_link
    }
    rc := build_parser($&p, str_clone(&out), target_code, BuildOpts{names: []string{}, filter: "", verbose: false, cover: cover, test: false, debug: debug, timings: timings, no_regcache: no_regcache, opt_level: opt_level, ra_level: ra_level, lib: false, shared: false, emit_obj: emit_obj, objs: native_objs, failfast: false, count: 1, list: false, short: false, bench: "", allow_int64_pairs: allow_int64_pairs, board: board, xacp: xacp, xacp_port: xacp_port}, front_ms)
    cleanup_native_paths(&native_temps)
    << rc
}

// Detailed CLI help. Lines are collected into an out-param (the frozen
// subset has no array returns) and printed to stdout (to_err == 0) or
// stderr (to_err == 1).
fn fill_help_lines(prog &string, out $&[]string) {
    out.push("usage: " + prog + " <command> [arguments]")
    out.push("")
    out.push("Build and execution commands:")
    out.push("  build          compile Xu source files into an executable or library")
    out.push("  run            compile and immediately execute a Xu program")
    out.push("  debug          build DWARF and start an interactive source debugger")
    out.push("  test           build and run test harness binaries (fn test_*)")
    out.push("  check          parse and type/borrow check without code generation")
    out.push("")
    out.push("Package and module commands:")
    out.push("  init           initialize a new Xu module and create xu.xun manifest")
    out.push("  get            add or update a pinned module dependency in xu.xun")
    out.push("  install        download remote require: packages into vendor/")
    out.push("  env            print Xu toolchain and environment variables")
    out.push("")
    out.push("Development and diagnostic tools:")
    out.push("  fmt            format Xu source files via sibling xu-fmt")
    out.push("  doc            render declarations as Markdown via sibling xu-doc")
    out.push("  map            visualize source architecture flowchart via sibling xu-map")
    out.push("  doctor         check host tools and dependencies via sibling xu-doctor")
    out.push("  native         compile, archive, pack, and inspect native C modules")
    out.push("  xacp           inspect, run, and debug XACP-enabled programs")
    out.push("  lsp            Language Server Protocol daemon via sibling xu-lsp")
    out.push("  setup          launch native installer via sibling xu-setup")
    out.push("")
    out.push("Toolchain management:")
    out.push("  up, update     download latest release and update toolchain")
    out.push("  help           show help for xu or a specific subcommand")
    out.push("  --ver, --version show toolchain version")
    out.push("")
    out.push("Common build options:")
    out.push("  -o, --output OUT  output binary path (default <stem>; Windows <stem>.exe)")
    out.push("  --target TARGET   target platform (default: host platform)")
    out.push("                    macos-arm64, macos-x64, linux-arm64, linux-x64,")
    out.push("                    linux-loongarch64, linux-riscv64, linux-arm32,")
    out.push("                    windows-x64, windows-arm64, thumbv7em-none,")
    out.push("                    riscv32imac-none, xtensa-esp32-none, wasm32")
    out.push("  --emit-obj        write target XUOBJ object file instead of executable")
    out.push("  --xacp            embed XACP startup metadata and --xacp-help")
    out.push("  --xacp-port PORT  default XACP TCP port (0 = stdio/no TCP)")
    out.push("  --desktop         pack desktop app bundle via sibling xu-desktop")
    out.push("  --www DIR         override desktop webview www/ resource directory")
    out.push("  --offline         resolve dependencies from local cache/vendor; never download")
    out.push("  --frozen          require offline build with existing lockfile")
    out.push("  --cover           instrument block coverage (hosted targets only)")
    out.push("  --debug-build     unoptimized source build with DWARF line tables")
    out.push("  --no-opt          disable MIR optimization and register allocator")
    out.push("  --debug           emit DWARF line tables without changing optimization")
    out.push("  --timings         print per-phase timings and optimization stats on stderr")
    out.push("")
    out.push("Common check/test options:")
    out.push("  --target TARGET   target platform (default: host platform)")
    out.push("  -o, --output OUT  test binary output path (default <stem>; Windows .exe)")
    out.push("  -run REGEXP       run only tests matching the specified regular expression")
    out.push("  -failfast         stop execution after the first failed test")
    out.push("  -count N          repeat test suite N times (1-100)")
    out.push("  -list             list all matching test names without executing them")
    out.push("  -short            mark testing.short() as true to skip long tests")
    out.push("  -bench REGEXP     run benchmark functions matching regexp")
    out.push("  -v                verbose output with per-test timings")
    out.push("  --cover           report test coverage counters")
    out.push("  --debug           emit DWARF line tables")
    out.push("")
    out.push("Environment variables:")
    out.push("  XUOS              default OS when --target is omitted (linux, macos, windows, none)")
    out.push("  XUARCH            default arch when --target is omitted (x64, arm64, ...)")
    out.push("  XUPATH            package search roots (':' on Unix, ';' on Windows)")
    out.push("  XU_STDLIB_ROOT    explicit standard-library source directory (SDK src/)")
    out.push("  XU_CACHE          package cache directory (default ~/.xu/pkg)")
    out.push("  XUPROXY           package download proxy URL list, direct, or off (default direct)")
    out.push("  XUPRIVATE         private module glob patterns bypassing proxy")
    out.push("  XUNOPROXY         proxy bypass patterns (defaults to XUPRIVATE)")
    out.push("  XUSUMDB           checksum database URL/key")
    out.push("  XUNOSUMDB         checksum bypass patterns (defaults to XUPRIVATE)")
    out.push("")
    out.push("Use \"" + prog + " <command> --help\" or \"" + prog + " help <command>\" for more information.")
    <<
}

fn print_help_lines(prog &string, to_err int) {
    $lines := []string{}
    fill_help_lines(prog, $&lines)
    for i in 0:lines.len {
        if to_err == 1 {
            eprintln(lines[i])
        } else {
            println(lines[i])
        }
    }
    <<
}

fn print_build_help(prog &string) {
    println("usage: " + prog + " build [options] <input.xu...> [module.a|module.xulib...]")
    println("")
    println("Compile Xu source files into an executable or object file.")
    println("")
    println("Arguments:")
    println("  <input.xu...>     source files to compile (a directory compiles all *.xu files in it)")
    println("  [module.a/.xulib] precompiled native C modules or slices to link")
    println("")
    println("Options:")
    println("  -o, --output OUT  output file path (default <stem>; Windows <stem>.exe)")
    println("  --target TARGET   target platform (default: host platform)")
    println("                    macos-arm64, macos-x64, linux-arm64, linux-x64,")
    println("                    linux-loongarch64, linux-riscv64, linux-arm32,")
    println("                    windows-x64, windows-arm64, thumbv7em-none,")
    println("                    riscv32imac-none, xtensa-esp32-none, wasm32")
    println("  --board BOARD     bare-metal board profile (mps2-an386 [default], stm32f4)")
    println("  --emit-obj        write target XUOBJ object file instead of executable")
    println("  --xacp            embed XACP startup metadata and --xacp-help")
    println("  --xacp-port PORT  default XACP TCP port (0 = stdio/no TCP)")
    println("  --desktop         pack as native desktop app via sibling xu-desktop")
    println("  --www DIR         override desktop webview www/ resource directory")
    println("  --offline         resolve dependencies from local cache/vendor; never download")
    println("  --frozen          require offline build with existing lockfile")
    println("  --cover           instrument block coverage (hosted targets)")
    println("  --debug-build     unoptimized source build with DWARF line tables")
    println("  --no-opt          disable MIR optimization and register allocator")
    println("  --debug           emit DWARF line tables without changing optimization")
    println("  --timings         print per-phase compilation timings and stats on stderr")
    println("  -h, --help        show this help message")
}

