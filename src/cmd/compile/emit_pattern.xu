@main

// Whole-block loop patterns (SIMD reductions, copies, searches, x64 vector
// prefixes). Each one matches the slot-shaped MIR of a natural loop and
// replaces or prefixes its scalar emission (the *_ssa kinds match the
// promoted SSA form of the same loops); when a pattern is off or does
// not match, the ordinary per-instruction emitter is the fallback. The IDs
// equal VecPat.kind so matchers and the dispatcher share one number space.
//
// XU_PATTERNS_OFF=all, or a comma list of names, disables patterns at build
// time; --timings prints per-pattern hit counts. scripts/pattern_diff.sh
// builds programs with patterns on and off and requires identical output.
const vp_none = 0
const vp_iand_reduce = 1
const vp_scan_reduce = 2
const vp_mul_iand_reduce = 3
const vp_byte_add_reduce = 4
const vp_index_copy = 5
const vp_vec3_sqnorm = 6
const vp_scan_carry = 7
const vp_saxpy_rmw47 = 9
const vp_push_fill = 12
const vp_crc_bit8 = 14
const vp_stride_zero = 15
const vp_pred_scan = 16
const vp_bsearch = 17
const vp_index_set = 18
const vp_byte_pipe = 19
const vp_x64_madd = 20
const vp_x64_iand = 21
const vp_x64_byte_sum = 23
const vp_eq16_jump = 24
const vp_iand_ssa = 26
const vp_mul_iand_ssa = 27
const vp_push_fill_ssa = 28
const vp_scan_ssa = 29
const vp_saxpy_ssa = 30
const vp_stride_zero_ssa = 31
const vp_pred_scan_ssa = 32
const vp_crc_bit8_ssa = 33
const vp_bsearch_ssa = 34
const vp_count = 35

fn vp_name(k int) string {
    if k == vp_iand_reduce { << "iand_reduce" }
    if k == vp_scan_reduce { << "scan_reduce" }
    if k == vp_mul_iand_reduce { << "mul_iand_reduce" }
    if k == vp_byte_add_reduce { << "byte_add_reduce" }
    if k == vp_index_copy { << "index_copy" }
    if k == vp_vec3_sqnorm { << "vec3_sqnorm" }
    if k == vp_scan_carry { << "scan_carry" }
    if k == vp_saxpy_rmw47 { << "saxpy_rmw47" }
    if k == vp_push_fill { << "push_fill" }
    if k == vp_crc_bit8 { << "crc_bit8" }
    if k == vp_stride_zero { << "stride_zero" }
    if k == vp_pred_scan { << "pred_scan" }
    if k == vp_bsearch { << "bsearch" }
    if k == vp_index_set { << "index_set" }
    if k == vp_byte_pipe { << "byte_pipe" }
    if k == vp_x64_madd { << "x64_madd" }
    if k == vp_x64_iand { << "x64_iand" }
    if k == vp_x64_byte_sum { << "x64_byte_sum" }
    if k == vp_eq16_jump { << "eq16_jump" }
    if k == vp_iand_ssa { << "iand_ssa" }
    if k == vp_mul_iand_ssa { << "mul_iand_ssa" }
    if k == vp_push_fill_ssa { << "push_fill_ssa" }
    if k == vp_scan_ssa { << "scan_ssa" }
    if k == vp_saxpy_ssa { << "saxpy_ssa" }
    if k == vp_stride_zero_ssa { << "stride_zero_ssa" }
    if k == vp_pred_scan_ssa { << "pred_scan_ssa" }
    if k == vp_crc_bit8_ssa { << "crc_bit8_ssa" }
    if k == vp_bsearch_ssa { << "bsearch_ssa" }
    << ""
}

fn (a &Assembler) vp_on(k int) bool {
    << k > vp_none && k < vp_count && (a.vp_off & (1 << k)) == 0
}

fn (a &mut Assembler) vp_hit(k int) {
    if k > vp_none && k < a.vp_hits.len { a.vp_hits[k] += 1 }
}

// A pattern matched but its emitter declined; the block owned by that
// match falls back to scalar emission without trying later patterns.
fn (a &mut Assembler) vp_decline(k int) {
    if k > vp_none && k + vp_count < a.vp_hits.len { a.vp_hits[k + vp_count] += 1 }
}

// Returns false (after printing the offending name) on an unknown name.
fn vp_configure(a &mut Assembler, spec string) bool {
    // [0, vp_count) hits, [vp_count, 2 * vp_count) declines.
    a.vp_hits = []int{}
    for _ in 0:vp_count * 2 { a.vp_hits.push(0) }
    a.vp_off = 0
    if spec == "" { << true }
    if spec == "all" {
        for k in 1:vp_count { if vp_name(k) != "" { a.vp_off = a.vp_off | (1 << k) } }
        << true
    }
    mut start := 0
    for i in 0:spec.len + 1 {
        if i < spec.len && spec[i] != 44 { -> }
        name := spec[start:i]
        start = i + 1
        if name == "" { -> }
        mut found := false
        for k in 1:vp_count {
            if vp_name(k) == name {
                a.vp_off = a.vp_off | (1 << k)
                found = true
            }
        }
        if !found {
            eprintln("xu: XU_PATTERNS_OFF: unknown pattern '" + name + "'")
            << false
        }
    }
    << true
}

fn dump_pattern_stats(a &Assembler) {
    mut line := "pattern-hits:"
    for k in 1:vp_count {
        if k < a.vp_hits.len && a.vp_hits[k] > 0 { line = line + " " + vp_name(k) + "=" + str(a.vp_hits[k]) }
    }
    if a.vp_off != 0 { line = line + " (some patterns off)" }
    eprintln(line)
    mut dec := "pattern-declined:"
    for k in 1:vp_count {
        if k + vp_count < a.vp_hits.len && a.vp_hits[k + vp_count] > 0 { dec = dec + " " + vp_name(k) + "=" + str(a.vp_hits[k + vp_count]) }
    }
    eprintln(dec)
}
