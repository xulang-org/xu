@main

#os
#os/exec
#path/filepath
#internal/semver
#encoding/json

fn update_clean_dir(dir &string) {
    os.remove_all(dir + "")
}

fn update_clean_stale_backups(install_root &string) {
    listing := os.listdir(install_root + "") or (err) { << }
    names := split_lines(listing)
    for i in 0:names.len {
        entry := names[i]
        if val_has_prefix(&entry, ".xu-update-backup-") || val_has_prefix(&entry, ".xu-update-stage-") {
            old_path := install_root + "/" + entry
            update_clean_dir(&old_path)
        }
    }
}

fn update_remove_file(path &string) {
    os.remove(path + "") or (err) { << }
}

fn update_rename(old &string, new &string) {
    os.rename(old + "", new + "") or (err) { << }
}

fn update_chmod(path &string, mode int) {
    os.chmod(path + "", mode) or (err) { << }
}

fn update_look_path(name string) string {
    << exec.look_path(name) or (err) { << "" }
}

fn update_cmd_output(cmd &exec.Cmd) string {
    << cmd.output() or (err) { << "" }
}

fn update_run_cmd(cmd &exec.Cmd) bool {
    rc := cmd.run() or (err) { << false }
    << rc == 0
}

fn update_read_version(path &string) string {
    body := read_file(path + "") or (err) { << "0.8.8-dev.2" }
    mut e := body.len
    while e > 0 {
        b := body[e - 1]
        if b == 32 || b == 10 || b == 13 || b == 9 { e = e - 1 }
        else { <- }
    }
    mut s := 0
    while s < e {
        b := body[s]
        if b == 32 || b == 10 || b == 13 || b == 9 { s = s + 1 }
        else { <- }
    }
    << body[s:e]
}

fn update_fetch_latest_tag() string {
    curl := update_look_path("curl")
    if curl.len > 0 {
        // 1. Try GitHub releases latest API
        mut cmd := exec.command("curl", "-sSL", "--connect-timeout", "10", "--max-time", "15", "-H", "User-Agent: Xu-self-update", "https://api.github.com/repos/xulang-org/xu/releases/latest")
        body := update_cmd_output(&cmd)
        if body.len > 0 {
            doc := json.parse(&body)
            if doc.ok() && doc.is_dict(doc.root()) {
                ti := doc.get(doc.root(), "tag_name")
                if ti >= 0 && doc.is_string(ti) {
                    tag := doc.as_string(ti) or (err) { << "" }
                    if tag.len > 0 {
                        mut v := tag + ""
                        if v[0] == 118 { v = v[1:v.len] }
                        << v
                    }
                }
            }
        }
        // 2. Fallback: try GitHub redirect Location header
        mut head_cmd := exec.command("curl", "-sI", "--connect-timeout", "10", "--max-time", "15", "https://github.com/xulang-org/xu/releases/latest")
        headers := update_cmd_output(&head_cmd)
        if headers.len > 0 {
            lines := split_lines(headers)
            for i in 0:lines.len {
                line := lines[i]
                if val_has_prefix(&line, "location: ") || val_has_prefix(&line, "Location: ") {
                    loc := xun_trim(line[10:line.len])
                    mut tag_idx := 0 - 1
                    for j in 0:loc.len - 5 {
                        if loc[j:j + 5] == "/tag/" {
                            tag_idx = j + 5
                            <-
                        }
                    }
                    if tag_idx >= 0 {
                        mut v := xun_trim(loc[tag_idx:loc.len])
                        if v.len > 0 && v[0] == 118 { v = v[1:v.len] }
                        << v
                    }
                }
            }
        }
    }
    if xu_target_os() == 2 {
        ps := update_look_path("powershell")
        if ps.len > 0 {
            mut ps_cmd := exec.command("powershell", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command", "[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; try { (Invoke-RestMethod -Uri 'https://api.github.com/repos/xulang-org/xu/releases/latest' -Headers @{'User-Agent'='Xu-self-update'}).tag_name } catch { }")
            out := update_cmd_output(&ps_cmd)
            tag := xun_trim(out)
            if tag.len > 0 {
                mut v := tag + ""
                if v[0] == 118 { v = v[1:v.len] }
                << v
            }
        }
    }
    << ""
}

fn update_download(url &string, dest &string) bool {
    curl := update_look_path("curl")
    if curl.len > 0 {
        mut cmd := exec.command("curl", "-fSL", "--connect-timeout", "15", "--retry", "2", "-o", dest + "", "--", url + "")
        << update_run_cmd(&cmd)
    }
    wget := update_look_path("wget")
    if wget.len > 0 {
        mut cmd := exec.command("wget", "-q", "-O", dest + "", url + "")
        << update_run_cmd(&cmd)
    }
    if xu_target_os() == 2 {
        ps := update_look_path("powershell")
        if ps.len > 0 {
            mut cmd := exec.command("powershell", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command", "[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; (New-Object Net.WebClient).DownloadFile('" + url + "', '" + dest + "')")
            << update_run_cmd(&cmd)
        }
    }
    << false
}

fn update_extract(archive &string, dest_dir &string, is_windows bool) bool {
    if !is_windows {
        mut cmd := exec.command("tar", "-xzf", archive + "", "-C", dest_dir + "")
        << update_run_cmd(&cmd)
    } else {
        tar := update_look_path("tar")
        if tar.len > 0 {
            mut cmd := exec.command("tar", "-xf", archive + "", "-C", dest_dir + "")
            if update_run_cmd(&cmd) { << true }
        }
        ps := update_look_path("powershell")
        if ps.len > 0 {
            mut cmd := exec.command("powershell", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command", "Expand-Archive -Path '" + archive + "' -DestinationPath '" + dest_dir + "' -Force")
            << update_run_cmd(&cmd)
        }
        << false
    }
    << false
}

fn update_find_sdk(extract_dest &string, tag &string, is_windows bool) string {
    mut exe_name := "xu"
    if is_windows { exe_name = "xu.exe" }
    mut cands := []string{}
    cands.push(extract_dest + "/xu-" + tag)
    cands.push(extract_dest + "/xu-" + tag + "-devkit")
    cands.push(extract_dest + "/xu")
    cands.push(extract_dest + "")
    for i in 0:cands.len {
        c := cands[i]
        b := c + "/bin/" + exe_name
        s := c + "/src"
        if path_exists(&b) && path_exists(&s) {
            << c
        }
    }
    << ""
}

fn print_update_help() {
    println("usage: xu update [options] (or: xu up [options])")
    println("")
    println("Download and install the latest GitHub release matching this system.")
    println("")
    println("Options:")
    println("  --check          check for a new version without installing")
    println("  --version VER    install a specific release version (e.g. 0.8.3)")
    println("  --prefix DIR     install SDK into DIR instead of updating current xu")
    println("  --force          reinstall the same version or allow a downgrade")
    println("  -h, --help       show this help message")
}

fn run_update(argv &[]string, host_code int) int {
    mut check_only := false
    mut force := false
    mut req_version := ""
    mut req_prefix := ""

    mut i := 2
    while i < argv.len {
        arg := argv[i]
        if arg == "-h" || arg == "--help" {
            print_update_help()
            << 0
        }
        if arg == "--check" {
            check_only = true
            i = i + 1
            ->
        }
        if arg == "--force" {
            force = true
            i = i + 1
            ->
        }
        if arg == "--version" {
            if i + 1 >= argv.len {
                eprintln("xu update: --version requires an argument")
                << 1
            }
            req_version = cli_arg_owned(argv, i + 1)
            i = i + 2
            ->
        }
        if arg == "--prefix" {
            if i + 1 >= argv.len {
                eprintln("xu update: --prefix requires an argument")
                << 1
            }
            req_prefix = cli_arg_owned(argv, i + 1)
            i = i + 2
            ->
        }
        eprintln("xu update: unknown option '" + arg + "'")
        << 1
    }

    platform := target_name(host_code)
    if platform == "unknown" || platform.len == 0 {
        eprintln("xu update: unsupported host platform (" + platform + ")")
        << 1
    }
    is_windows := (xu_target_os() == 2) || val_has_prefix(&platform, "windows-")
    mut archive_ext := ".tar.gz"
    mut exe_suffix := ""
    if is_windows {
        archive_ext = ".zip"
        exe_suffix = ".exe"
    }

    exe := cli_arg_owned(argv, 0)
    resolved := exec.look_path(exe) or (err) {
        eprintln("xu update: " + err.msg())
        << 1
    }
    actual_exe := require_real_path(&resolved)
    exe_dir := filepath.dir(&actual_exe)
    mut sdk_root := exe_dir + ""
    exe_base := filepath.base(&exe_dir)
    if exe_base == "bin" {
        sdk_root = filepath.dir(&exe_dir)
    }

    if !check_only && req_prefix.len == 0 {
        git_dir := sdk_root + "/.git"
        if path_exists(&git_dir) {
            eprintln("xu update: refusing to overwrite a git development checkout; use --prefix DIR to install to a separate directory")
            << 1
        }
    }

    vfile := sdk_root + "/VERSION"
    current_version := update_read_version(&vfile)

    mut target_version := req_version + ""
    if target_version.len > 0 && target_version[0] == 118 {
        target_version = target_version[1:target_version.len]
    }
    if target_version.len == 0 {
        println("xu update: checking latest release from GitHub...")
        target_version = update_fetch_latest_tag()
        if target_version.len == 0 {
            eprintln("xu update: cannot query latest release from GitHub (network or rate-limit issue); specify --version <VER> to install a specific release")
            << 1
        }
    }

    canon_target := semver.canonical(&target_version)
    canon_current := semver.canonical(&current_version)
    mut cmp := 0
    if semver.valid(&canon_target) && semver.valid(&canon_current) {
        cmp = semver.compare(&canon_target, &canon_current)
    } else {
        if target_version == current_version { cmp = 0 }
        else { cmp = 1 }
    }

    if check_only {
        println("xu update: current version: " + current_version + " (" + platform + ")")
        println("xu update: latest version:  " + target_version)
        if cmp > 0 {
            println("xu update: update available! Run 'xu up' to upgrade.")
        } else {
            println("xu update: already up to date.")
        }
        << 0
    }

    if cmp <= 0 && !force && req_prefix.len == 0 {
        println("xu update: already up to date (" + current_version + "); use --force to reinstall or downgrade")
        << 0
    }

    mut install_root := sdk_root + ""
    if req_prefix.len > 0 {
        install_root = req_prefix + ""
    }
    install_bin := install_root + "/bin"
    os.mkdir_all(install_bin + "") or (err) {
        eprintln("xu update: cannot create directory " + install_bin + ": " + err.msg())
        << 1
    }

    update_clean_stale_backups(&install_root)

    lock_file := install_root + "/.xu-update.lock"
    if path_exists(&lock_file) {
        eprintln("xu update: another update is running; lock: " + lock_file)
        << 1
    }
    write_file(lock_file, "updating") or (err) {
        eprintln("xu update: cannot create lock file: " + err.msg())
        << 1
    }

    stage_dir := install_root + "/.xu-update-stage-" + str(os.getpid())
    backup_dir := install_root + "/.xu-update-backup-" + str(os.getpid())

    tag := "v" + target_version
    archive_name := "xu-" + tag + "-" + platform + archive_ext
    download_url := "https://github.com/xulang-org/xu/releases/download/" + tag + "/" + archive_name

    os.mkdir_all(stage_dir + "") or (err) {
        update_remove_file(&lock_file)
        eprintln("xu update: cannot create stage directory " + stage_dir)
        << 1
    }
    archive_dest := stage_dir + "/" + archive_name

    println("xu update: downloading " + download_url + "...")
    dl_ok := update_download(&download_url, &archive_dest)
    if !dl_ok {
        update_clean_dir(&stage_dir)
        update_remove_file(&lock_file)
        eprintln("xu update: download failed for " + download_url)
        << 1
    }

    println("xu update: extracting release package...")
    extract_dest := stage_dir + "/pkg"
    os.mkdir_all(extract_dest + "") or (err) {
        update_clean_dir(&stage_dir)
        update_remove_file(&lock_file)
        eprintln("xu update: cannot create extract dir")
        << 1
    }
    ext_ok := update_extract(&archive_dest, &extract_dest, is_windows)
    if !ext_ok {
        update_clean_dir(&stage_dir)
        update_remove_file(&lock_file)
        eprintln("xu update: failed to extract release package")
        << 1
    }

    sdk_src := update_find_sdk(&extract_dest, &tag, is_windows)
    if sdk_src.len == 0 {
        update_clean_dir(&stage_dir)
        update_remove_file(&lock_file)
        eprintln("xu update: extracted package does not contain a valid Xu SDK structure")
        << 1
    }

    println("xu update: verifying downloaded compiler...")
    new_xu := sdk_src + "/bin/xu" + exe_suffix
    mut test_cmd := exec.command(new_xu, "--version")
    ver_out := update_cmd_output(&test_cmd)
    if ver_out.len == 0 {
        update_clean_dir(&stage_dir)
        update_remove_file(&lock_file)
        eprintln("xu update: verified compiler failed to run or produced empty output")
        << 1
    }

    println("xu update: updating installation at " + install_root + "...")
    os.mkdir_all(backup_dir + "/bin") or (err) {
        update_clean_dir(&stage_dir)
        update_remove_file(&lock_file)
        eprintln("xu update: cannot create backup directory")
        << 1
    }

    // Backup and replace src/
    src_target := install_root + "/src"
    src_backup := backup_dir + "/src"
    src_new := sdk_src + "/src"
    if path_exists(&src_target) {
        update_rename(&src_target, &src_backup)
    }
    if path_exists(&src_new) {
        update_rename(&src_new, &src_target)
    }

    // Backup and replace include/ if present
    inc_target := install_root + "/include"
    inc_backup := backup_dir + "/include"
    inc_new := sdk_src + "/include"
    if path_exists(&inc_new) {
        if path_exists(&inc_target) {
            update_rename(&inc_target, &inc_backup)
        }
        update_rename(&inc_new, &inc_target)
    }

    // Backup and replace bin tools
    mut tools := []string{}
    tools.push("xu")
    tools.push("xu-doctor")
    tools.push("xu-fmt")
    tools.push("xu-map")
    tools.push("xu-doc")
    tools.push("xu-desktop")
    for j in 0:tools.len {
        tname := tools[j] + exe_suffix
        t_src := sdk_src + "/bin/" + tname
        t_dst := install_bin + "/" + tname
        t_bak := backup_dir + "/bin/" + tname
        if path_exists(&t_src) {
            if path_exists(&t_dst) {
                update_rename(&t_dst, &t_bak)
            }
            update_rename(&t_src, &t_dst)
            if !is_windows {
                update_chmod(&t_dst, 493) // 0755
            }
        }
    }

    // Metadata files
    mut meta_files := []string{}
    meta_files.push("VERSION")
    meta_files.push("TARGET")
    meta_files.push("bundle.json")
    meta_files.push("install.sh")
    meta_files.push("install.ps1")
    meta_files.push("env.sh")
    meta_files.push("env.ps1")
    for j in 0:meta_files.len {
        mname := meta_files[j]
        m_src := sdk_src + "/" + mname
        m_dst := install_root + "/" + mname
        m_bak := backup_dir + "/" + mname
        if path_exists(&m_src) {
            if path_exists(&m_dst) {
                update_rename(&m_dst, &m_bak)
            }
            update_rename(&m_src, &m_dst)
        }
    }

    // Verification of installed binary
    installed_xu := install_bin + "/xu" + exe_suffix
    mut final_cmd := exec.command(installed_xu, "--version")
    final_out := update_cmd_output(&final_cmd)
    if final_out.len == 0 {
        eprintln("xu update: verification failed on installed compiler; rolling back...")
        if path_exists(&src_backup) {
            update_clean_dir(&src_target)
            update_rename(&src_backup, &src_target)
        }
        if path_exists(&inc_backup) {
            update_clean_dir(&inc_target)
            update_rename(&inc_backup, &inc_target)
        }
        for j in 0:tools.len {
            tname := tools[j] + exe_suffix
            t_dst := install_bin + "/" + tname
            t_bak := backup_dir + "/bin/" + tname
            if path_exists(&t_bak) {
                update_rename(&t_bak, &t_dst)
            }
        }
        for j in 0:meta_files.len {
            mname := meta_files[j]
            m_dst := install_root + "/" + mname
            m_bak := backup_dir + "/" + mname
            if path_exists(&m_bak) {
                update_rename(&m_bak, &m_dst)
            }
        }
        update_clean_dir(&stage_dir)
        update_clean_dir(&backup_dir)
        update_remove_file(&lock_file)
        eprintln("xu update: update failed and rolled back")
        << 1
    }

    update_clean_dir(&stage_dir)
    update_clean_dir(&backup_dir)
    update_remove_file(&lock_file)

    println("xu update: successfully updated to " + tag + " (" + platform + ")")
    << 0
}
