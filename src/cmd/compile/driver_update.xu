@main

#os
#os/exec

fn print_update_help() {
    println("usage: xu update [options] (or: xu up [options])")
    println("")
    println("Download and install the latest GitHub release matching this system.")
    println("")
    println("Options:")
    println("  --check          check for a new version without installing")
    println("  --version VER    install a specific release version (e.g. 0.8.3)")
    println("  --prefix DIR     install SDK into DIR instead of updating current xu")
    println("  --archive FILE   install a local release archive (requires --version)")
    println("  --force          reinstall the same version or allow a downgrade")
    println("  -h, --help       show this help message")
}

// Pass the running compiler's identity; ambient SDK variables can be stale.
fn run_update(argv &[]string, host_code int) int {
    if argv_sub_has_help(argv) {
        print_update_help()
        << 0
    }
    exe := cli_arg_owned(argv, 0)
    resolved := exec.look_path(exe) or (err) {
        eprintln("xu update: " + err.msg())
        << 1
    }
    actual := require_real_path(&resolved)
    mut tail := []string{}
    tail.push("_from_xu")
    tail.push(actual)
    tail.push(compiler_version())
    tail.push(target_name(host_code))
    tail.push("--")
    for i in 2:argv.len { tail.push(cli_arg_owned(argv, i)) }
    << tool_exec("xu-update", tail)
}
