@main

#internal/modulepath
#internal/semver
#path/filepath

#xu/scanner
#xu/parser
#xu/ast
#xu/types
#xu/format
#errors
#os
#os/exec

fn cache_key_hex(mod_id &string, url &string) string {
    mut h := 5381
    for i in 0:mod_id.len {
        h = h * 33 + (mod_id[i] & 255)
        if h < 0 {
            h = 0 - h
        }
    }
    h = h * 33 + 10
    if h < 0 {
        h = 0 - h
    }
    for i in 0:url.len {
        h = h * 33 + (url[i] & 255)
        if h < 0 {
            h = 0 - h
        }
    }
    << hex16(h)
}

// Byte-wise prefix test. Prefer this over the `starts_with` builtin on
// require locators: Gen1 string-call lowering can pass a stale length into
// `_rt_starts_with` and spin (see elf_dyn.xu is_iat_xu_label). Locators are
// short ASCII; a fixed scan cannot retain a descriptor length.
fn val_has_prefix(s &string, p string) bool {
    if p.len > s.len {
        << false
    }
    for i in 0:p.len {
        if s[i] != p[i] {
            << false
        }
    }
    << true
}

fn xu_pkg_cache_dir() string {
    c := env_get("XU_CACHE")
    if c.len > 0 {
        << c
    }
    h := os.home_dir()
    dot_xu := ".xu"
    pkg := "pkg"
    if h.len > 0 {
        mid := path_join(&h, &dot_xu)
        << path_join(&mid, &pkg)
    }
    << path_join(&dot_xu, &pkg)
}

fn path_exists(p &string) bool {
    // Builtin os_stat takes owned path.
    os_stat(str_clone(p)) or (err) {
        << false
    }
    << true
}

fn mkdir_one(p string) {
    if p.len == 0 {
        <<
    }
    if p.len == 1 {
        if p[0] == 46 {
            <<
        }
    }
    if path_exists(&p) {
        <<
    }
    os_mkdir(p) or (err) {
        <<
    }
}

fn mkdir_all(p string) {
    for i in 0:p.len {
        if p[i] == 47 {
            if i > 0 {
                part := p[0:i]
                mkdir_one(str_clone(&part))
            }
        }
    }
    mkdir_one(str_clone(&p))
}

// Publish only completed downloads. Legacy/unmarked caches fail closed.
fn require_stage(root &string) string {
    if path_exists(root) { eprintln("require: incomplete cache; remove after inspection: " + root)
 <<< 1 }
    stage := root + ".partial." + str(os.getpid()) + "." + str(now_ns())
    parent := path_dirname(&stage)
    mkdir_all(parent)
    os.mkdir(str_clone(&stage)) or (err) { eprintln("require: cannot create download stage")
 <<< 1 }
    << stage
}

fn require_publish(stage string, root string) {
    digest := require_tree_hash(&stage)
    stamp := stage + "/.ok"
    write_file(stamp, digest) or (err) { eprintln("require: cannot write cache checksum")
 <<< 1 }
    os.rename(stage, root) or (err) { eprintln("require: cannot publish dependency cache")
 <<< 1 }
}

fn require_archive_check(dest &string) {
    mut listing := exec.command("tar", "-tzf", str_clone(dest))
    body := listing.output() or (err) { eprintln("require: cannot list archive")
 <<< 1 }
    names := split_lines(body)
    if names.len == 0 { eprintln("require: empty archive")
 <<< 1 }
    for i in 0:names.len {
        nm := names[i]
        if nm.len == 0 || nm[0] == 47 { eprintln("require: unsafe archive path")
 <<< 1 }
        mut start := 0
        for j in 0:nm.len + 1 {
            if j == nm.len || nm[j] == 47 || nm[j] == 92 {
                seg := nm[start:j]
                if seg == ".." { eprintln("require: unsafe archive path")
 <<< 1 }
                start = j + 1
            } else if nm[j] == 58 { eprintln("require: unsafe archive path")
 <<< 1 }
        }
    }
    mut verbose := exec.command("tar", "-tvzf", str_clone(dest))
    kinds := verbose.output() or (err) { eprintln("require: cannot inspect archive types")
 <<< 1 }
    rows := split_lines(kinds)
    for i in 0:rows.len {
        row := rows[i]
        if row.len == 0 || (row[0] != 45 && row[0] != 100) {
            eprintln("require: archive links and special files are not allowed")
 <<< 1
        }
    }
}

fn fetch_remote_require(project &string, mod_id string, url string) string {
    require_arg(&url)
    require_module_path(&mod_id)
    entry := require_lock_entry(project, &mod_id, &url)
    suf_xu := ".xu"
    ok_xu := str_ends_with(&url, &suf_xu)
    suf_tgz := ".tar.gz"
    suf_tgz2 := ".tgz"
    if !ok_xu && !str_ends_with(&url, &suf_tgz) && !str_ends_with(&url, &suf_tgz2) {
        eprintln("require '" + mod_id + "': http(s) locator must end in .xu or .tar.gz/.tgz")
 <<< 1
    }
    root := require_cache_root(&mod_id, &url)
    stamp := root + "/.ok"
    if path_exists(&stamp) {
        require_verify_cache(project, &mod_id, &url, &root)
        << root
    }
    require_download_allowed(&mod_id)
    mut cache_guard := require_cache_guard(&root)
    if path_exists(&stamp) {
        require_verify_cache(project, &mod_id, &url, &root)
        cache_guard.close() or (err) { eprintln(err.msg())
            <<< 1 }
        << root
    }
    stage := require_stage(&root)
    mut dest := stage + "/pkg.tgz"
    if ok_xu {
        slash := mod_id_to_slash(&mod_id)
        dest = stage + "/" + slash + ".xu"
        parent := path_dirname(&dest)
        mkdir_all(parent)
    }
    require_arg(&dest)
    mut cmd := exec.command("curl", "-fsSL", "--connect-timeout", require_download_connect_timeout_seconds, "--max-time", require_download_timeout_seconds, "--proto", "=http,https", "--proto-redir", "=http,https", "-o", str_clone(&dest), "--", str_clone(&url))
    cmd.run() or (err) { eprintln("require '" + mod_id + "': curl download failed for " + url)
 <<< 1 }
    if !ok_xu {
        require_archive_check(&dest)
        mut unpack := exec.command("tar", "-xzf", str_clone(&dest), "-C", str_clone(&stage))
        unpack.run() or (err) { eprintln("require '" + mod_id + "': tar extract failed")
 <<< 1 }
    }
    require_publish(stage, str_clone(&root))
    require_verify_cache(project, &mod_id, &url, &root)
    cache_guard.close() or (err) { eprintln(err.msg())
        <<< 1 }
    << root
}

fn fetch_git_require(project &string, mod_id string, spec string) string {
    require_arg(&spec)
    require_module_path(&mod_id)
    entry := require_lock_entry(project, &mod_id, &spec)
    rest := spec[4:spec.len]
    mut url := str_clone(&rest)
    mut ref := "HEAD"
    mut at := -1
    mut authority_end := 0
    for pi in 0:rest.len {
        if pi + 2 < rest.len && rest[pi] == 58 && rest[pi + 1] == 47 && rest[pi + 2] == 47 {
            authority_end = rest.len
            for si in pi + 3:rest.len {
                if rest[si] == 47 { authority_end = si
                    <- }
            }
            <-
        }
    }
    mut i := rest.len - 1
    while i >= 0 {
        if rest[i] == 64 || rest[i] == 35 {
            if i > 7 && (rest[i] == 35 || i > authority_end) { at = i }
            <-
        }
        i = i - 1
    }
    if at >= 0 { url = rest[0:at]
 ref = rest[at + 1:rest.len] }
    if url.len == 0 || url[0] == 45 || ref.len == 0 || ref[0] == 45 {
        eprintln("require '" + mod_id + "': invalid git locator or ref")
 <<< 1
    }
    // Git's ext transport executes a remote helper; locators cannot enable it.
    if val_has_prefix(&url, "ext:") { eprintln("require: git ext transport is not allowed")
 <<< 1 }
    root := require_cache_root(&mod_id, &spec)
    stamp := root + "/.ok"
    if path_exists(&stamp) { require_verify_cache(project, &mod_id, &spec, &root)
 << root }
    require_download_allowed(&mod_id)
    mut cache_guard := require_cache_guard(&root)
    if path_exists(&stamp) {
        require_verify_cache(project, &mod_id, &spec, &root)
        cache_guard.close() or (err) { eprintln(err.msg())
            <<< 1 }
        << root
    }
    stage := require_stage(&root)
    mut clone := exec.command("git", "-c", "protocol.ext.allow=never", "clone", "--no-checkout", "--", str_clone(&url), str_clone(&stage))
    clone.run() or (err) { eprintln("require '" + mod_id + "': git clone failed for " + url)
 <<< 1 }
    mut checkout := exec.command("git", "-C", str_clone(&stage), "checkout", "--detach", str_clone(&ref), "--")
    checkout.run() or (err) { eprintln("require '" + mod_id + "': git checkout failed for ref " + ref)
 <<< 1 }
    require_publish(stage, str_clone(&root))
    require_verify_cache(project, &mod_id, &spec, &root)
    cache_guard.close() or (err) { eprintln(err.msg())
        <<< 1 }
    << root
}

fn is_semver_pin(s string) bool {
    version := require_version(&s)
    << version.len > 0
}

fn mod_id_to_slash(mod_id &string) string {
    if modulepath.is_external(mod_id) { << modulepath.storage_path(mod_id) }
    << str_clone(mod_id)
}

fn str_less(a string, b string) bool {
    mut n := a.len
    if b.len < n {
        n = b.len
    }
    for i in 0:n {
        if a[i] < b[i] {
            << true
        }
        if a[i] > b[i] {
            << false
        }
    }
    << a.len < b.len
}

fn sort_names(names []string) []string {
    n := names.len
    mut used := []int{}
    for i in 0:n {
        used.push(0)
    }
    mut out := []string{}
    for k in 0:n {
        mut best := -1
        for i in 0:n {
            if used[i] == 0 {
                if best < 0 {
                    best = i
                } else {
                    if str_less(names[i], names[best]) {
                        best = i
                    }
                }
            }
        }
        used[best] = 1
        out.push(names[best])
    }
    << out
}

fn split_lines(s string) []string {
    mut out := []string{}
    mut start := 0
    for i in 0:s.len {
        if s[i] == 10 {
            if i > start {
                out.push(s[start:i])
            }
            start = i + 1
        }
    }
    if start < s.len {
        out.push(s[start:s.len])
    }
    << out
}

fn dir_readable(path &string) int {
    info := os_stat(str_clone(path)) or (err) {
        << 0
    }
    if info.is_dir {
        << 1
    }
    << 0
}

fn file_readable(path &string) int {
    read_file(str_clone(path)) or (err) {
        << 0
    }
    << 1
}

fn add_root(roots &mut []string, dir &string) int {
    n := roots.len
    for i in 0:n {
        ri := roots[i]
        if str_eq(&ri, dir) {
            << 0
        }
    }
    roots.push(str_clone(dir))
    << 1
}

fn xun_rtrim(s string) string {
    mut e := s.len
    mut done := 0
    while done == 0 {
        if e == 0 {
            done = 1
        } else {
            b := s[e - 1]
            if b == 32 {
                e = e - 1
            } else {
                if b == 13 {
                    e = e - 1
                } else {
                    done = 1
                }
            }
        }
    }
    << s[0:e]
}

fn xun_trim(s string) string {
    mut i := 0
    mut done := 0
    while done == 0 {
        if i >= s.len {
            done = 1
        } else {
            if s[i] == 32 {
                i = i + 1
            } else {
                done = 1
            }
        }
    }
    << xun_rtrim(s[i:s.len])
}

fn xun_scalar_text(s string) string {
    mut i := 0
    mut done := 0
    while done == 0 {
        if i >= s.len {
            done = 1
        } else {
            if s[i] == 32 {
                i = i + 1
            } else {
                done = 1
            }
        }
    }
    if i >= s.len {
        << ""
    }
    if s[i] != 33 {
        << s[i:s.len]
    }
    mut j := i + 1
    mut sp := -1
    while j < s.len {
        if sp < 0 {
            if s[j] == 32 {
                sp = j
            }
        }
        j = j + 1
    }
    if sp < 0 {
        << ""
    }
    mut k := sp + 1
    mut done2 := 0
    while done2 == 0 {
        if k >= s.len {
            done2 = 1
        } else {
            if s[k] == 32 {
                k = k + 1
            } else {
                done2 = 1
            }
        }
    }
    << s[k:s.len]
}

// Module releases use version:, independently of the xu: language requirement.
fn xun_module_version_valid(s string) bool {
    version := "v" + s
    << semver.valid(&version)
}

fn xun_module_identity(raw string) string {
    if raw.len > 0 && raw[0] == 34 {
        if raw.len < 3 || raw[raw.len - 1] != 34 {
            eprintln("xu.xun: invalid external module path")
            <<< 1
        }
        path := raw[1:raw.len - 1]
        if !modulepath.valid_path(&path) {
            eprintln("xu.xun: invalid external module path " + path)
            <<< 1
        }
        << modulepath.identity(&path)
    }
    << raw
}

fn xun_manifest_module(path string, src string) string {
    lines := split_lines(src)
    mut found := ""
    mut saw := 0
    mut saw_version := 0
    mut module_version := ""
    for i in 0:lines.len {
        raw := lines[i]
        mut has_tab := 0
        for j in 0:raw.len {
            if raw[j] == 9 {
                has_tab = 1
            }
        }
        if has_tab == 1 {
            eprintln(path + ": 1: error: tab is not allowed")
            <<< 1
        }
        t := xun_rtrim(raw)
        if t.len > 0 {
            if t[0] != 35 {
                mut indent := 0
                mut counting := 1
                for k in 0:t.len {
                    if counting == 1 {
                        if t[k] == 32 {
                            indent = indent + 1
                        } else {
                            counting = 0
                        }
                    }
                }
                if indent == 0 {
                    mut colon := -1
                    for k in 0:t.len {
                        if colon < 0 {
                            if t[k] == 58 {
                                colon = k
                            }
                        }
                    }
                    if colon < 0 {
                        eprintln(path + ": 1: error: expected key:")
                        <<< 1
                    }
                    key := t[0:colon]
                    mut val := ""
                    if colon + 1 < t.len {
                        if t[colon + 1] == 32 {
                            val = val + t[colon + 2:t.len]
                        } else {
                            eprintln(path + ": 1: error: colon must be followed by space or end of line")
                            <<< 1
                        }
                    }
                    if key == "module" {
                        mut valc := ""
                        valc = valc + val
                        raw_module := xun_scalar_text(valc)
                        m := xun_module_identity(raw_module)
                        if m.len == 0 {
                            eprintln(path + ": 1: error: xu.xun 'module' must be non-empty")
                            <<< 1
                        }
                        if saw == 1 {
                            eprintln(path + ": 1: error: duplicate key 'module'")
                            <<< 1
                        }
                        saw = 1
                        found = found + m
                    } else {
                        if key == "version" {
                            if saw_version == 1 {
                                eprintln(path + ": 1: error: duplicate key 'version'")
                                <<< 1
                            }
                            saw_version = 1
                            mut version := xun_scalar_text(val)
                            // Accept the same quoted scalar spelling as XUN.
                            if version.len >= 2 {
                                if version[0] == 34 && version[version.len - 1] == 34 {
                                    version = version[1:version.len - 1]
                                }
                            }
                            if !xun_module_version_valid(version) {
                                eprintln(path + ": 1: error: xu.xun 'version' must be a major.minor.patch version")
                                <<< 1
                            }
                            module_version = version + ""
                        } else {
                            if key == "xu" {
                            } else {
                                if key == "require" {
                                } else {
                                    if key == "native" {
                                        if val.len > 0 {
                                            eprintln(path + ": 1: error: native must be a dictionary")
                                            <<< 1
                                        }
                                    } else {
                                        eprintln(path + ": 1: error: unknown xu.xun key '" + key + "'")
                                        <<< 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if saw == 0 {
        eprintln(path + ": 1: error: xu.xun missing key 'module'")
        <<< 1
    }
    if modulepath.is_external(&found) {
        canonical := found + ""
        if !modulepath.valid_module(&canonical) || !modulepath.version_matches(&canonical, &module_version) {
            eprintln(path + ": external module version must match its major path (v0/v1 without suffix; v2+ with /vN)")
            <<< 1
        }
    }
    << found
}

fn require_dir_xu_xun(dir string) {
    xun := "xu.xun"
    path := path_join(&dir, &xun)
    if !path_exists(&path) {
        eprintln("xu: directory " + dir + " requires xu.xun")
        <<< 1
    }
    check_xu_xun(dir, "")
}

fn check_xu_xun(dir string, expected string) {
    xun := "xu.xun"
    path := path_join(&dir, &xun)
    mut rp := ""
    rp = rp + path
    body := read_file(rp) or (err) {
        <<
    }
    mut mp := ""
    mp = mp + path
    mname := xun_manifest_module(mp, body)
    if expected.len > 0 {
        if mname != expected {
            eprintln(path + ": module '" + mname + "' does not match import '" + expected + "'")
            <<< 1
        }
    }
}

fn collect_direct_require_entries(project_dir &string, keys &mut []string, vals &mut []string) {
    xun := "xu.xun"
    path := path_join(project_dir, &xun)
    body := read_file(path) or (err) {
        <<
    }
    lines := split_lines(body)
    mut in_req := 0
    for i in 0:lines.len {
        t := xun_trim(lines[i])
        if t.len == 0 {
            ->
        }
        if t[0] == 35 {
            ->
        }
        mut indent := 0
        mut counting := 1
        for k in 0:lines[i].len {
            if counting == 1 {
                if lines[i][k] == 32 {
                    indent = indent + 1
                } else {
                    counting = 0
                }
            }
        }
        if indent == 0 {
            if t == "require:" {
                in_req = 1
            } else {
                in_req = 0
            }
            ->
        }
        if in_req == 0 {
            ->
        }
        mut colon := -1
        for k in 0:t.len {
            if colon < 0 {
                if t[k] == 58 {
                    colon = k
                }
            }
        }
        if colon < 0 {
            ->
        }
        mut val := ""
        if colon + 1 < t.len {
            if t[colon + 1] == 32 {
                val = t[colon + 2:t.len]
            } else {
                val = t[colon + 1:t.len]
            }
        }
        val = xun_scalar_text(val)
        mut key := ""
        if colon > 0 {
            key = xun_trim(t[0:colon])
        }
        if key.len == 0 {
            ->
        }
        key = xun_module_identity(key)
        require_module_path(&key)
        require_arg(&val)
        require_validate_locator(&key, &val)
        if is_semver_pin(val + "") { val = require_version(&val) }
        norm := import_id_norm(&key)
        for ki in 0:keys.len {
            prior := keys[ki]
            if import_id_norm(&prior) == norm { eprintln("require: duplicate module path " + key)
 <<< 1 }
        }
        keys.push(key)
        vals.push(val)
    }
}

fn collect_native_entries(manifest_dir &string, keys &mut []string, vals &mut []string) {
    xun := "xu.xun"
    path := path_join(manifest_dir, &xun)
    body := read_file(path) or (err) {
        <<
    }
    lines := split_lines(body)
    mut in_native := 0
    for i in 0:lines.len {
        t := xun_trim(lines[i])
        if t.len == 0 {
            ->
        }
        if t[0] == 35 {
            ->
        }
        mut indent := 0
        mut counting := 1
        for k in 0:lines[i].len {
            if counting == 1 {
                if lines[i][k] == 32 {
                    indent = indent + 1
                } else {
                    counting = 0
                }
            }
        }
        if indent == 0 {
            if t == "native:" {
                in_native = 1
            } else {
                in_native = 0
            }
            ->
        }
        if in_native == 0 {
            ->
        }
        mut colon := -1
        for k in 0:t.len {
            if colon < 0 && t[k] == 58 {
                colon = k
            }
        }
        if colon < 0 {
            eprintln(path + ": 1: error: native entry must be module: file:path")
            <<< 1
        }
        mut key := ""
        if colon > 0 {
            key = xun_trim(t[0:colon])
        }
        mut val := ""
        if colon + 1 < t.len {
            if t[colon + 1] == 32 {
                val = t[colon + 2:t.len]
            } else {
                val = t[colon + 1:t.len]
            }
        }
        val = xun_scalar_text(val)
        if key.len == 0 || val.len == 0 {
            eprintln(path + ": 1: error: native entry must be module: file:path")
            <<< 1
        }
        key = xun_module_identity(key)
        keys.push(key)
        vals.push(val)
    }
}

fn vendor_skip_name(nm &string) bool {
    if nm.len == 0 {
        << true
    }
    if str_eq_lit(nm, ".git") || str_eq_lit(nm, ".ok") || str_eq_lit(nm, ".xu-deps.lck") || str_eq_lit(nm, ".xu-lock.lck") { << true }
    << str_eq_lit(nm, "pkg.tgz")
}

fn import_id_norm(s &string) string {
    if modulepath.is_external(s) { << str_clone(s) }
    << str_clone(s)
}

fn require_covers(keys &[]string, imp &string) bool {
    want := import_id_norm(imp)
    n := keys.len
    for i in 0:n {
        kraw := keys[i]
        k := import_id_norm(&kraw)
        if str_eq(&k, &want) {
            << true
        }
        pref := k + "/"
        if want.len >= pref.len {
            mut ok := 1
            for j in 0:pref.len {
                if want[j] != pref[j] {
                    ok = 0
                }
            }
            if ok == 1 {
                << true
            }
        }
    }
    << false
}

fn path_is_under(child &string, parent &string) bool {
    if str_eq(child, parent) {
        << true
    }
    sep := parent + "/"
    if child.len < sep.len {
        << false
    }
    for i in 0:sep.len {
        if child[i] != sep[i] {
            << false
        }
    }
    << true
}

fn loc_is_stdlib(p &string) bool {
    root := require_stdlib_root()
    if root.len == 0 { << false }
    actual := require_real_path(p)
    << path_is_under(&actual, &root)
}

fn import_needs_map(loc &string, project_dir &string) bool {
    if loc_is_stdlib(loc) {
        << false
    }
    vendor_nm := "vendor"
    vdir := path_join(project_dir, &vendor_nm)
    actual := require_real_path(loc)
    vendor_actual := require_real_path(&vdir)
    project_actual := require_real_path(project_dir)
    if path_is_under(&actual, &vendor_actual) {
        << true
    }
    if path_is_under(&actual, &project_actual) {
        << false
    }
    << true
}

fn reject_unmapped_import(imp &string, loc &string, project_dir &string, keys &[]string) {
    if !import_needs_map(loc, project_dir) {
        <<
    }
    if require_covers(keys, imp) && require_location_allowed(imp, loc, project_dir) {
        <<
    }
    eprintln("package '" + (imp + "") + "' is not in the standard library; add it to xu.xun require:")
    <<< 1
}

fn vendor_has_pkg(vdir &string, mod_id &string) bool {
    slash := mod_id_to_slash(mod_id)
    d := path_join(vdir, &slash)
    if dir_readable(&d) == 1 {
        << true
    }
    xu_suf := ".xu"
    fx := slash + xu_suf
    f := path_join(vdir, &fx)
    << path_exists(&f)
}

fn vendor_remove_tree(p string) {
    require_no_link(&p)
    if dir_readable(&p) == 1 {
        listing := os.listdir(str_clone(&p)) or (err) {
            <<
        }
        names := split_lines(listing)
        for i in 0:names.len {
            nm := names[i]
            if nm.len == 0 {
                ->
            }
            if nm.len == 1 && nm[0] == 46 {
                ->
            }
            if nm.len == 2 && nm[0] == 46 && nm[1] == 46 {
                ->
            }
            child := path_join(&p, &nm)
            vendor_remove_tree(child)
        }
        os_remove(str_clone(&p)) or (err) {
            <<
        }
        <<
    }
    if path_exists(&p) {
        os_remove(str_clone(&p)) or (err) {
            <<
        }
    }
}

fn vendor_copy_file(src string, dst string) {
    src_e := str_clone(&src)
    dst_e := str_clone(&dst)
    parent := path_dirname(&dst)
    mkdir_all(parent)
    body := read_file(src) or (err) {
        eprintln("xu install: cannot read " + src_e)
        <<< 1
    }
    write_file(dst, body) or (err) {
        eprintln("xu install: cannot write " + dst_e)
        <<< 1
    }
}

fn vendor_copy_tree(src string, dst string) {
    if dir_readable(&src) == 1 {
        mkdir_all(str_clone(&dst))
        listing := os.listdir(str_clone(&src)) or (err) {
            eprintln("xu install: cannot list " + src)
            <<< 1
        }
        names := split_lines(listing)
        for i in 0:names.len {
            nm := names[i]
            if vendor_skip_name(&nm) {
                ->
            }
            child := path_join(&src, &nm)
            destc := path_join(&dst, &nm)
            vendor_copy_tree(child, destc)
        }
        <<
    }
    vendor_copy_file(src, dst)
}

fn vendor_place(vdir string, mod_id string, cache_root string) {
    require_no_link(&vdir)
    slash := mod_id_to_slash(&mod_id)
    for i in 0:slash.len {
        if slash[i] == 47 {
            prefix := slash[0:i]
            parent := path_join(&vdir, &prefix)
            require_no_link(&parent)
        }
    }
    dest_dir := path_join(&vdir, &slash)
    xu_suf := ".xu"
    dest_name := slash + xu_suf
    dest_xu := path_join(&vdir, &dest_name)
    if modulepath.is_external(&mod_id) {
        // Canonical locators refer to the module root itself, as in Go.
        require_dir_xu_xun(cache_root + "")
        check_xu_xun(cache_root + "", mod_id + "")
        vendor_remove_tree(str_clone(&dest_dir))
        vendor_copy_tree(cache_root, dest_dir)
        <<
    }
    vendor_remove_tree(str_clone(&dest_dir))
    vendor_remove_tree(str_clone(&dest_xu))
    if dir_readable(&cache_root) == 0 {
        vendor_copy_file(cache_root, dest_xu)
        <<
    }
    src_dir := path_join(&cache_root, &slash)
    src_xu := path_join(&cache_root, &dest_name)
    if dir_readable(&src_dir) == 1 {
        vendor_copy_tree(src_dir, dest_dir)
        <<
    }
    if path_exists(&src_xu) {
        vendor_copy_file(src_xu, dest_xu)
        <<
    }
    vendor_copy_tree(cache_root, dest_dir)
}

// M169: collect `require:` locators from project xu.xun into search roots.
// `vendor/` is first when present; packages already there skip the network.
fn resolve_require_roots(project_dir &string) []string {
    mut out := []string{}
    vendor_nm := "vendor"
    vdir := path_join(project_dir, &vendor_nm)
    if dir_readable(&vdir) == 1 {
        out.push(str_clone(&vdir))
    }
    mut keys := []string{}
    mut vals := []string{}
    collect_resolved_require_entries(project_dir, mut &keys, mut &vals)
    require_frozen_preflight(project_dir, &keys, &vals)
    mut i := 0
    while i < keys.len {
        key := str_clone(&keys[i])
        val := str_clone(&vals[i])
        i = i + 1
        if vendor_has_pkg(&vdir, &key) {
            if !val_has_prefix(&val, "file:") || require_frozen() { require_verify_vendor(project_dir, &key, &val, &vdir) }
            if modulepath.is_external(&key) {
                root := require_vendor_path(&vdir, &key)
                require_check_external_root(&root, &key)
            }
            ->
        }
        // file:…
        if val.len >= 5 {
            if val[0] == 102 && val[1] == 105 && val[2] == 108 && val[3] == 101 && val[4] == 58 {
                rest := val[5:val.len]
                mut pth := ""
                if filepath.is_abs(&rest) {
                    pth = rest
                } else {
                    pth = path_join(project_dir, &rest)
                }
                out.push(str_clone(&pth))
                if !modulepath.is_external(&key) {
                    slash := mod_id_to_slash(&key)
                    suffix := "/" + slash
                    if str_ends_with(&pth, &suffix) && pth.len > suffix.len {
                        base := pth[0:pth.len - suffix.len]
                        out.push(base)
                    }
                }
                if modulepath.is_external(&key) {
                    root := require_external_root(project_dir, &key, &val)
                    require_check_external_root(&root, &key)
                }
            }
        }
        // M183: http:// and https:// — curl via os_system (macOS); cache like bootstrap.
        if val_has_prefix(&val, "https://") {
            out.push(fetch_remote_require(project_dir, key, val))
        } else {
            if val_has_prefix(&val, "http://") {
                out.push(fetch_remote_require(project_dir, key, val))
            } else {
                if val.len >= 4 && val[0] == 103 && val[1] == 105 && val[2] == 116 && val[3] == 58 {
                    out.push(fetch_git_require(project_dir, key, val))
                } else {
                    if is_semver_pin(val) { out.push(resolve_semver_require(project_dir, key, val)) }
                    else if !val_has_prefix(&val, "file:") { eprintln("require '" + key + "': invalid locator " + val)
 <<< 1 }
                }
            }
        }
        if modulepath.is_external(&key) && !val_has_prefix(&val, "file:") {
            root := require_external_root(project_dir, &key, &val)
            require_check_external_root(&root, &key)
        }
    }
    << out
}

fn run_install(dir string) int {
    << run_install_project(dir, false)
}

fn run_install_project(dir string, quiet bool) int {
    if require_frozen() {
        eprintln("xu install: --frozen forbids dependency writes; use build/check/test/run --frozen")
        << 1
    }
    xun := "xu.xun"
    path := path_join(&dir, &xun)
    if !path_exists(&path) {
        eprintln("xu install: no xu.xun in " + dir)
        << 1
    }
    mut project_guard := require_project_guard(&dir)
    vendor_nm := "vendor"
    vdir := path_join(&dir, &vendor_nm)
    mut graph_keys := []string{}
    mut graph_vals := []string{}
    collect_require_graph(&dir, mut &graph_keys, mut &graph_vals, true)
    require_install_versions(&dir, &graph_keys, &graph_vals)
    mut keys := []string{}
    mut vals := []string{}
    require_select_graph(&graph_keys, &graph_vals, mut &keys, mut &vals)
    mut n := 0
    mut i := 0
    while i < keys.len {
        key := str_clone(&keys[i])
        val := str_clone(&vals[i])
        i = i + 1
        if val_has_prefix(&val, "file:") {
            source := require_local_source(&dir, &key, &val)
            source_real := require_real_path(&source)
            vendor_real := require_real_path(&vdir)
            if path_is_under(&vendor_real, &source_real) || path_is_under(&source_real, &vendor_real) {
                eprintln("require '" + key + "': local source overlaps the vendor destination")
                <<< 1
            }
            digest := require_tree_hash(&source)
            entry := require_lock_entry(&dir, &key, &val)
            if entry.len > 0 && entry[2] != digest {
                eprintln("require '" + key + "': local source checksum mismatch; review the lock before updating")
                <<< 1
            }
            require_lock_write(&dir, &key, &val, digest + "", "-")
            // source already selects the package root rather than its search parent.
            mut origin := ""
            if dir_readable(&source) == 1 { origin = require_graph_file_base(&dir, &source, &val) }
            vendor_place(str_clone(&vdir), str_clone(&key), source)
            vp := require_vendor_path(&vdir, &key)
            if origin.len > 0 {
                marker := vp + "/.xu-local-root"
                write_file(marker, "xu-local-root-v1\n" + origin) or (err) { eprintln("xu install: cannot write local snapshot origin")
                    <<< 1 }
            }
            require_lock_write(&dir, &key, &val, digest, require_tree_hash(&vp))
            if !quiet { println("xu install: " + key) }
            n = n + 1
            ->
        }
        mut cache := ""
        mut remote := 0
        if val_has_prefix(&val, "https://") {
            cache = fetch_remote_require(&dir, str_clone(&key), str_clone(&val))
            remote = 1
        } else {
            if val_has_prefix(&val, "http://") {
                cache = fetch_remote_require(&dir, str_clone(&key), str_clone(&val))
                remote = 1
            } else {
                if val.len >= 4 && val[0] == 103 && val[1] == 105 && val[2] == 116 && val[3] == 58 {
                    cache = fetch_git_require(&dir, str_clone(&key), str_clone(&val))
                    remote = 1
                } else {
                    if is_semver_pin(str_clone(&val)) { cache = require_graph_root(&dir, &key, &val)
 remote = 1 }
                    else { eprintln("require '" + key + "': invalid locator " + val)
 <<< 1 }
                }
            }
        }
        if remote == 1 {
            vendor_place(str_clone(&vdir), str_clone(&key), cache)
            entry := require_lock_entry(&dir, &key, &val)
            vp := require_vendor_path(&vdir, &key)
            require_lock_write(&dir, &key, &val, str_clone(&entry[2]), require_tree_hash(&vp))
            if !quiet { println("xu install: " + key) }
            n = n + 1
        }
    }
    if !quiet { println("xu install: " + str(n) + " packages in " + vdir) }
    project_guard.close() or (err) { eprintln(err.msg())
        << 1 }
    << 0
}
