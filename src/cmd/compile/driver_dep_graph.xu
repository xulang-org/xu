@main

#path/filepath
#internal/modulepath
#internal/semver

// Nodes are (path, version), not only paths. All reachable versions contribute
// requirements, including versions superseded by a higher requirement.
fn require_graph_add(keys $&[]string, vals $&[]string, key string, val string) {
    for i in 0:keys.len {
        prior := keys[i]
        if prior != key { -> }
        if vals[i] == val { << }
        old := vals[i]
        if require_version(&old).len == 0 || require_version(&val).len == 0 {
            eprintln("require '" + key + "': conflicting dependency sources; declare one consistent locator")
            <<< 1
        }
    }
    if keys.len >= REQUIRE_GRAPH_MAX_VERSION_NODES { eprintln("require: dependency graph exceeds " + str(REQUIRE_GRAPH_MAX_VERSION_NODES) + " version nodes")
        <<< 1 }
    keys.push(key)
    vals.push(val)
}

fn require_graph_root(project &string, key &string, val &string) string {
    vdir := project + "/vendor"
    require_no_link(&vdir)
    version := require_version(val)
    if version.len > 0 {
        snapshot := require_version_vendor(project, key, val)
        if path_exists(&snapshot) {
            snapshot_parent := project + "/vendor/.xu-versions"
            require_no_link(&snapshot_parent)
            entry := require_lock_entry(project, key, val)
            if entry.len == 0 { eprintln("require: version snapshot needs xu.lock")
                <<< 1 }
            actual := require_tree_hash(&snapshot)
            if entry[3] != actual { eprintln("require: version snapshot checksum mismatch")
                <<< 1 }
            require_authenticate_version(key, val, &actual)
            require_check_external_root(&snapshot, key)
            require_check_version(&snapshot, key, val)
            << snapshot
        }
    } else if vendor_has_pkg(&vdir, key) {
        if !val_has_prefix(val, "file:") || require_frozen() { require_verify_vendor(project, key, val, &vdir) }
        << require_vendor_path(&vdir, key)
    }
    if val_has_prefix(val, "file:") { << require_local_source(project, key, val) }
    root := require_cache_root(key, val)
    stamp := root + "/.ok"
    if !path_exists(&stamp) { << "" }
    entry := require_lock_entry(project, key, val)
    if entry.len == 0 { << "" }
    require_verify_cache(project, key, val, &root)
    require_check_version(&root, key, val)
    << root
}

fn require_graph_file_base(project &string, root &string, locator &string) string {
    origin := root + "/.xu-local-root"
    if path_exists(&origin) {
        body := read_file(origin) or (err) { eprintln("require: cannot read local snapshot origin")
            <<< 1 }
        prefix := "xu-local-root-v1\n"
        if !val_has_prefix(&body, prefix + "") || body.len <= prefix.len {
            eprintln("require: invalid local snapshot origin")
            <<< 1
        }
        << body[prefix.len:body.len]
    }
    tail := locator[5:locator.len]
    if filepath.is_abs(&tail) { << filepath.clean(root) }
    base := require_project_base(project)
    << filepath.rel(&base, root) or (err) { eprintln(err.msg())
        <<< 1 }
}


fn require_graph_expand(project &string, parent &string, locator &string, root &string, keys $&[]string, vals $&[]string) {
    if root.len == 0 || dir_readable(root) == 0 { << }
    if modulepath.is_external(parent) { require_check_external_root(root, parent) }
    $manifest_root := str_clone(root)
    if !modulepath.is_external(parent) && !val_has_prefix(locator, "file:") {
        slash := mod_id_to_slash(parent)
        child := path_join(root, &slash)
        if dir_readable(&child) == 1 { manifest_root = child }
    }
    $child_keys := []string{}
    $child_vals := []string{}
    collect_direct_require_entries(&manifest_root, $&child_keys, $&child_vals)
    for i in 0:child_keys.len {
        key := child_keys[i]
        $val := str_clone(&child_vals[i])
        if val_has_prefix(&val, "file:") {
            if !val_has_prefix(locator, "file:") { eprintln("require '" + parent + "': remote module cannot introduce a file: dependency")
                <<< 1 }
            tail := val[5:val.len]
            if !filepath.is_abs(&tail) {
                base := require_graph_file_base(project, &manifest_root, locator)
                joined := path_join(&base, &tail)
                val = "file:" + filepath.clean(&joined)
            }
        }
        require_graph_add(keys, vals, str_clone(&key), val)
    }
}

fn collect_require_graph(project &string, keys $&[]string, vals $&[]string, fetch bool) {
    collect_direct_require_entries(project, keys, vals)
    if keys.len > REQUIRE_GRAPH_MAX_MODULES { eprintln("require: dependency graph exceeds " + str(REQUIRE_GRAPH_MAX_MODULES) + " modules")
        <<< 1 }
    require_frozen_preflight(project, &*keys, &*vals)
    $i := 0
    while i < keys.len {
        key := str_clone(&keys[i])
        val := str_clone(&vals[i])
        $root := require_graph_root(project, &key, &val)
        if root.len == 0 && fetch {
            if is_semver_pin(val + "") { root = resolve_semver_require(project, key + "", val + "") }
            else if val_has_prefix(&val, "git:") { root = fetch_git_require(project, key + "", val + "") }
            else if val_has_prefix(&val, "http://") || val_has_prefix(&val, "https://") { root = fetch_remote_require(project, key + "", val + "") }
        }
        require_graph_expand(project, &key, &val, &root, keys, vals)
        require_frozen_preflight(project, &*keys, &*vals)
        i += 1
    }
}

fn require_select_graph(graph_keys &[]string, graph_vals &[]string, keys $&[]string, vals $&[]string) {
    for i in 0:graph_keys.len {
        key := graph_keys[i]
        val := graph_vals[i]
        $selected := -1
        for j in 0:keys.len { if keys[j] == key { selected = j
            <- } }
        if selected < 0 {
            if keys.len >= REQUIRE_GRAPH_MAX_MODULES { eprintln("require: dependency graph exceeds " + str(REQUIRE_GRAPH_MAX_MODULES) + " modules")
                <<< 1 }
            keys.push(key + "")
            vals.push(val + "")
        } else {
            prior := vals[selected]
            if prior != val {
                // Source conflicts were rejected while collecting the graph.
                if semver.compare(&val, &prior) > 0 { vals[selected] = val + "" }
            }
        }
    }
}

fn collect_require_entries(project &string, keys $&[]string, vals $&[]string) {
    $graph_keys := []string{}
    $graph_vals := []string{}
    collect_require_graph(project, $&graph_keys, $&graph_vals, false)
    require_select_graph(&graph_keys, &graph_vals, keys, vals)
}

fn collect_resolved_require_entries(project &string, keys $&[]string, vals $&[]string) {
    $graph_keys := []string{}
    $graph_vals := []string{}
    collect_require_graph(project, $&graph_keys, $&graph_vals, true)
    require_select_graph(&graph_keys, &graph_vals, keys, vals)
}

// Keep all version nodes for offline MVS graph replay, then install the build
// list at ordinary vendor paths. Each snapshot has its own locked tree hash.
fn require_install_versions(project &string, keys &[]string, vals &[]string) {
    for i in 0:keys.len {
        key := keys[i]
        val := vals[i]
        if require_version(&val).len == 0 { -> }
        root := require_graph_root(project, &key, &val)
        dest := require_version_vendor(project, &key, &val)
        if root == dest { -> }
        snapshot_parent := project + "/vendor/.xu-versions"
        require_no_link(&snapshot_parent)
        vendor_remove_tree(dest + "")
        vendor_copy_tree(root, dest + "")
        entry := require_lock_entry(project, &key, &val)
        digest := require_tree_hash(&dest)
        require_lock_write(project, &key, &val, entry[2] + "", digest)
    }
}
