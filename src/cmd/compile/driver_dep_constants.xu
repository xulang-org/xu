@main

// Dependency admission, lock contention and transfer policies. Timeout
// arguments are decimal strings passed directly to curl. SumDB notes have
// their own cap, independent of record/tile responses and module archives.
const require_graph_max_version_nodes = 1024
const require_graph_max_modules = 256
const require_lock_timeout_ns = 30000000000
const require_lock_retry_ns = 10000000
const require_proxy_max_bytes = 67108864
const require_proxy_connect_timeout_seconds = "3"
const require_proxy_timeout_seconds = "20"
const require_sumdb_response_max_bytes = 65536
const require_sumdb_note_max_bytes = 16384
const require_http_ok = 200
const require_http_not_found = 404
const require_http_gone = 410
