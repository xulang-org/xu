@main

// ESP32-only bounded heap. The first 1024 bytes of the existing 64 KiB
// reservation are a one-bit-per-eight-bytes allocated-start map. Blocks
// occupy the remaining 63 KiB: [size:u32, tag:u32, payload...]. The tag
// includes header address and size, so a damaged size cannot pass alone.
// The sorted free list stores next in the first eight payload bytes.
// No ROM heap, OS mapping or allocator callback participates.

// A relocatable object gets its 64 KiB heap from the host at runtime
// (xu_rt_init stores the base in _xu_heap_base); executables reserve it.
fn rt_bh_heap_start(a $&Assembler, dest int) {
    if a.reloc_obj {
        a.lea(dest, "_xu_heap_base")
        a.load(dest, dest, 0)
    } else {
        a.lea(dest, "_xu_heap_start")
    }
}

fn rt_bh_heap_end(a $&Assembler, dest int) {
    if a.reloc_obj {
        rt_bh_heap_start(a, dest)
        a.vm_add_imm(dest, dest, 65536)
    } else {
        a.lea(dest, "_xu_heap_end")
    }
}

fn rt_bh_get(a $&Assembler, dest int, name string) {
    a.lea(0, name)
    a.load(dest, 0, 0)
}

fn rt_bh_put(a $&Assembler, src int, name string) {
    a.lea(0, name)
    a.store(0, 0, src)
}

fn rt_bh_enter(a $&Assembler) {
    a.xt_rsil(8, 15)
    a.store(15, -8, 0)
}

fn rt_bh_leave(a $&Assembler) {
    a.load(0, 15, -8)
    a.xt_wsr(8, 230)
    a.xt_rsync()
}

// H at fp-24, size at fp-32. Preserve these slots and all list cursors.
// expect=0/1 checks an allocated-start bit; change=-1/0/+1 clears/checks/sets.
fn rt_bh_bit(a $&Assembler, expect int, change int, tag string, bad string) {
    a.load(8, 15, -24)
    rt_bh_heap_start(a, 1)
    a.sub(0, 8, 1)
    a.shr_imm(0, 0, 3)
    a.store(15, -80, 0)
    a.vm_and_imm(0, 0, 31)
    a.vm_mov_imm(1, 1)
    a.shl(1, 1, 0)
    a.store(15, -88, 1)
    a.load(0, 15, -80)
    a.shr_imm(0, 0, 5)
    a.shl_imm(0, 0, 2)
    rt_bh_heap_start(a, 1)
    a.add(0, 0, 1)
    a.store(15, -72, 0)
    a.load(1, 0, 0)
    a.load(8, 15, -88)
    a.iand(2, 1, 8)
    if expect == 0 { a.vm_cbnz(2, bad + "") }
    else { a.vm_cbz(2, bad + "") }
    if change > 0 {
        a.ior(1, 1, 8)
    } else if change < 0 {
        a.vm_mov_imm(2, -1)
        a.ixor(8, 8, 2)
        a.iand(1, 1, 8)
    }
    if change != 0 {
        a.load(8, 15, -72)
        a.store(8, 0, 1)
    }
}

// Verify H is an aligned physical block header, not an interior pointer.
// free_node also checks the sorted next link before any allocation mutates it.
fn rt_bh_validate(a $&Assembler, free_node bool, tag string, bad string) {
    a.load(8, 15, -24)
    rt_bh_heap_start(a, 1)
    a.vm_add_imm(1, 1, 1024)
    a.cmp(8, 1)
    a.jlt(bad + "")
    rt_bh_heap_end(a, 1)
    a.vm_sub_imm(1, 1, 16)
    a.cmp(8, 1)
    a.jgt(bad + "")
    a.vm_and_imm(0, 8, 7)
    a.vm_cbnz(0, bad + "")
    a.load(9, 8, 0)
    a.vm_cmp_imm(9, 16)
    a.jlt(bad + "")
    a.vm_cmp_imm(9, 64512)
    a.jgt(bad + "")
    a.vm_and_imm(0, 9, 7)
    a.vm_cbnz(0, bad + "")
    a.add(10, 8, 9)
    rt_bh_heap_end(a, 1)
    a.cmp(10, 1)
    a.jgt(bad + "")
    a.store(15, -32, 9)
    a.load(0, 8, 4)
    $magic := 0x58414C43
    if free_node { magic = 0x58465245 }
    a.vm_mov_imm(1, magic)
    a.ixor(1, 1, 8)
    a.ixor(1, 1, 9)
    a.cmp(0, 1)
    a.jne(bad + "")
    if free_node {
        a.load(10, 8, 8)
        a.store(15, -48, 10)
        a.vm_cbz(10, tag + "_next_ok")
        a.add(9, 8, 9)
        a.cmp(10, 9)
        a.jlt(bad + "")
        rt_bh_heap_end(a, 1)
        a.vm_sub_imm(1, 1, 16)
        a.cmp(10, 1)
        a.jgt(bad + "")
        a.vm_and_imm(0, 10, 7)
        a.vm_cbnz(0, bad + "")
        a.label(tag + "_next_ok")
        rt_bh_bit(a, 0, 0, tag, bad + "")
    } else {
        rt_bh_bit(a, 1, 0, tag, bad + "")
    }
}

// Write header size/tag from S0=H, S1=size; preserves those registers.
fn rt_bh_header(a $&Assembler, free_node bool) {
    a.store(8, 0, 9)
    $magic := 0x58414C43
    if free_node { magic = 0x58465245 }
    a.vm_mov_imm(0, magic)
    a.ixor(0, 0, 8)
    a.ixor(0, 0, 9)
    a.store(8, 4, 0)
}

fn rt_bh_count(a $&Assembler, name string) {
    rt_bh_get(a, 9, name + "")
    a.vm_add_imm(9, 9, 1)
    rt_bh_put(a, 9, name + "")
}

fn rt_emit_xtensa_heap_alloc(a $&Assembler) {
    a.data_label("_rt_bare_heap_oom_msg")
    rt_emit_bytes(a, "xu: bare heap out of memory\n")
    a.data_label("_rt_bare_heap_bad_msg")
    rt_emit_bytes(a, "xu: bare heap metadata fault\n")
    a.label("_rt_alloc")
    a.prologue(128)
    a.store(15, -16, 18)
    rt_bh_enter(a)
    a.vm_cmp_imm(18, 0)
    a.jlt("_rt_bh_alloc_oom")
    a.vm_cmp_imm(18, 64504)
    a.jgt("_rt_bh_alloc_oom")
    a.vm_cbnz(18, "_rt_bh_alloc_nonzero")
    a.vm_mov_imm(18, 8)
    a.label("_rt_bh_alloc_nonzero")
    a.vm_add_imm(18, 18, 7)
    a.vm_and_imm(18, 18, -8)
    a.vm_add_imm(18, 18, 8)
    a.store(15, -16, 18) // rounded total including header
    rt_bh_get(a, 9, "_rt_bare_heap_init")
    a.vm_mov_imm(1, 0x58485231)
    a.cmp(9, 1)
    a.jeq("_rt_bh_alloc_initialized")
    a.vm_cbnz(9, "_rt_bh_alloc_bad")
    // Zero the in-heap boundary map before publishing a free-list head.
    rt_bh_heap_start(a, 8)
    a.mov(9, 8)
    a.vm_add_imm(10, 8, 1024)
    a.vm_mov_imm(1, 0)
    a.label("_rt_bh_alloc_zero_map")
    a.store(9, 0, 1)
    a.vm_add_imm(9, 9, 4)
    a.cmp(9, 10)
    a.jlt("_rt_bh_alloc_zero_map")
    a.mov(8, 10)
    a.vm_mov_imm(9, 64512)
    rt_bh_header(a, true)
    a.vm_mov_imm(1, 0)
    a.store(8, 8, 1)
    a.store(8, 12, 1)
    rt_bh_put(a, 8, "_rt_bare_heap_head")
    rt_bh_put(a, 8, "_rt_heap_cur")
    a.vm_mov_imm(9, 0x58485231)
    rt_bh_put(a, 9, "_rt_bare_heap_init")
    a.label("_rt_bh_alloc_initialized")
    rt_bh_get(a, 9, "_rt_bare_heap_head")
    a.store(15, -24, 9)
    a.vm_mov_imm(1, 0)
    a.store(15, -40, 1) // previous free node
    a.store(15, -96, 1) // bounded walk
    a.label("_rt_bh_alloc_search")
    a.load(8, 15, -24)
    a.vm_cbz(8, "_rt_bh_alloc_oom")
    a.load(9, 15, -96)
    a.vm_add_imm(9, 9, 1)
    a.store(15, -96, 9)
    a.vm_cmp_imm(9, 4032)
    a.jgt("_rt_bh_alloc_bad")
    rt_bh_validate(a, true, "_rt_bh_alloc_node", "_rt_bh_alloc_bad")
    a.load(8, 15, -32)
    a.load(9, 15, -16)
    a.cmp(8, 9)
    a.jge("_rt_bh_alloc_found")
    a.load(8, 15, -24)
    a.store(15, -40, 8)
    a.load(9, 15, -48)
    a.store(15, -24, 9)
    a.jmp("_rt_bh_alloc_search")
    a.label("_rt_bh_alloc_found")
    a.sub(10, 8, 9)
    a.vm_cmp_imm(10, 16)
    a.jlt("_rt_bh_alloc_whole")
    a.store(15, -56, 9) // allocated total
    a.load(8, 15, -24)
    a.add(8, 8, 9) // remainder header
    a.mov(9, 10)
    rt_bh_header(a, true)
    a.load(1, 15, -48)
    a.store(8, 8, 1)
    a.vm_mov_imm(1, 0)
    a.store(8, 12, 1)
    a.store(15, -64, 8) // replacement link
    a.jmp("_rt_bh_alloc_unlink")
    a.label("_rt_bh_alloc_whole")
    a.store(15, -56, 8)
    a.load(9, 15, -48)
    a.store(15, -64, 9)
    a.label("_rt_bh_alloc_unlink")
    a.load(8, 15, -40)
    a.load(9, 15, -64)
    a.vm_cbz(8, "_rt_bh_alloc_head")
    a.store(8, 8, 9)
    a.jmp("_rt_bh_alloc_unlinked")
    a.label("_rt_bh_alloc_head")
    rt_bh_put(a, 9, "_rt_bare_heap_head")
    a.label("_rt_bh_alloc_unlinked")
    a.load(8, 15, -24)
    a.load(9, 15, -56)
    rt_bh_header(a, false)
    rt_bh_bit(a, 0, 1, "_rt_bh_alloc_bit", "_rt_bh_alloc_bad")
    rt_bh_get(a, 9, "_rt_bare_heap_live")
    a.load(8, 15, -56)
    a.add(9, 9, 8)
    a.vm_cmp_imm(9, 64512)
    a.jgt("_rt_bh_alloc_bad")
    rt_bh_put(a, 9, "_rt_bare_heap_live")
    rt_bh_get(a, 8, "_rt_bare_heap_peak")
    a.cmp(9, 8)
    a.jle("_rt_bh_alloc_peak_done")
    rt_bh_put(a, 9, "_rt_bare_heap_peak")
    a.label("_rt_bh_alloc_peak_done")
    a.load(8, 15, -24)
    a.load(9, 15, -56)
    a.add(9, 8, 9)
    rt_bh_get(a, 8, "_rt_heap_cur")
    a.cmp(9, 8)
    a.jle("_rt_bh_alloc_high_done")
    rt_bh_put(a, 9, "_rt_heap_cur")
    a.label("_rt_bh_alloc_high_done")
    rt_bh_count(a, "_rt_bare_heap_allocs")
    rt_bh_leave(a)
    a.load(14, 15, -24)
    a.vm_add_imm(14, 14, 8)
    a.epilogue()
    a.label("_rt_bh_alloc_oom")
    rt_bh_leave(a)
    a.jmp("_rt_al_oom")
    a.label("_rt_bh_alloc_bad")
    rt_bh_leave(a)
    a.jmp("_rt_bare_heap_corrupt")
    // These tails are also reached from checked array/string helpers,
    // whose frames do not contain the allocator's saved-PS slot.
    a.label("_rt_al_oom")
    a.label("_rt_al_oom_bare")
    a.vm_mov_imm(9, 1)
    rt_bh_put(a, 9, "_rt_bare_heap_error")
    a.lea(18, "_rt_bare_heap_oom_msg")
    a.vm_mov_imm(19, 28)
    a.jmp("_rt_bh_panic_write")
    a.label("_rt_bare_heap_corrupt")
    a.vm_mov_imm(9, 2)
    rt_bh_put(a, 9, "_rt_bare_heap_error")
    a.lea(18, "_rt_bare_heap_bad_msg")
    a.vm_mov_imm(19, 29)
    a.label("_rt_bh_panic_write")
    a.vm_mov_imm(20, 2)
    a.call("_rt_write")
    a.jmp("_rt_exit")
}

fn rt_emit_xtensa_heap_free(a $&Assembler) {
    a.label("_rt_free")
    a.prologue(128)
    a.vm_cbz(18, "_rt_bh_free_empty")
    a.vm_sub_imm(8, 18, 8)
    a.store(15, -24, 8)
    rt_bh_enter(a)
    rt_bh_get(a, 9, "_rt_bare_heap_init")
    a.vm_mov_imm(1, 0x58485231)
    a.cmp(9, 1)
    a.jne("_rt_bh_free_bad")
    rt_bh_validate(a, false, "_rt_bh_free_allocated", "_rt_bh_free_bad")
    a.load(8, 15, -24)
    a.store(15, -104, 8) // original header
    a.load(9, 15, -32)
    a.store(15, -112, 9) // original charged total
    rt_bh_get(a, 9, "_rt_bare_heap_head")
    a.store(15, -24, 9)
    a.vm_mov_imm(1, 0)
    a.store(15, -40, 1)
    a.store(15, -96, 1)
    a.label("_rt_bh_free_search")
    a.load(8, 15, -24)
    a.vm_cbz(8, "_rt_bh_free_insert")
    a.load(9, 15, -96)
    a.vm_add_imm(9, 9, 1)
    a.store(15, -96, 9)
    a.vm_cmp_imm(9, 4032)
    a.jgt("_rt_bh_free_bad")
    rt_bh_validate(a, true, "_rt_bh_free_node", "_rt_bh_free_bad")
    a.load(8, 15, -24)
    a.load(9, 15, -104)
    a.cmp(8, 9)
    a.jge("_rt_bh_free_insert")
    a.store(15, -40, 8)
    a.load(9, 15, -48)
    a.store(15, -24, 9)
    a.jmp("_rt_bh_free_search")
    a.label("_rt_bh_free_insert")
    a.load(8, 15, -24)
    a.store(15, -56, 8) // following free node
    a.load(9, 15, -104)
    a.load(10, 15, -112)
    a.add(10, 9, 10)
    a.vm_cbz(8, "_rt_bh_free_right_valid")
    a.cmp(10, 8)
    a.jgt("_rt_bh_free_bad")
    a.label("_rt_bh_free_right_valid")
    a.load(8, 15, -40)
    a.vm_cbz(8, "_rt_bh_free_left_valid")
    a.load(10, 8, 0)
    a.add(10, 8, 10)
    a.cmp(10, 9)
    a.jgt("_rt_bh_free_bad")
    a.label("_rt_bh_free_left_valid")
    a.store(15, -24, 9)
    rt_bh_bit(a, 1, -1, "_rt_bh_free_bit", "_rt_bh_free_bad")
    a.load(8, 15, -104)
    a.load(9, 15, -112)
    rt_bh_header(a, true)
    a.load(10, 15, -56)
    a.store(8, 8, 10)
    a.vm_mov_imm(1, 0)
    a.store(8, 12, 1)
    a.vm_cbz(10, "_rt_bh_free_right_done")
    a.add(0, 8, 9)
    a.cmp(0, 10)
    a.jne("_rt_bh_free_right_done")
    a.load(1, 10, 0)
    a.add(9, 9, 1)
    a.load(1, 10, 8)
    a.store(8, 8, 1)
    rt_bh_header(a, true)
    a.label("_rt_bh_free_right_done")
    a.load(10, 15, -40)
    a.vm_cbz(10, "_rt_bh_free_new_head")
    a.load(1, 10, 0)
    a.add(0, 10, 1)
    a.cmp(0, 8)
    a.jne("_rt_bh_free_link_previous")
    a.add(9, 9, 1)
    a.load(1, 8, 8)
    a.store(10, 8, 1)
    a.mov(8, 10)
    rt_bh_header(a, true)
    a.jmp("_rt_bh_free_linked")
    a.label("_rt_bh_free_link_previous")
    a.store(10, 8, 8)
    a.jmp("_rt_bh_free_linked")
    a.label("_rt_bh_free_new_head")
    rt_bh_put(a, 8, "_rt_bare_heap_head")
    a.label("_rt_bh_free_linked")
    rt_bh_get(a, 9, "_rt_bare_heap_live")
    a.load(8, 15, -112)
    a.cmp(9, 8)
    a.jlt("_rt_bh_free_bad")
    a.sub(9, 9, 8)
    rt_bh_put(a, 9, "_rt_bare_heap_live")
    rt_bh_count(a, "_rt_bare_heap_frees")
    rt_bh_leave(a)
    a.label("_rt_bh_free_empty")
    a.epilogue()
    a.label("_rt_bh_free_bad")
    rt_bh_leave(a)
    a.jmp("_rt_bare_heap_corrupt")
}
