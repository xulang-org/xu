@main
// x64 backend for Gen1 (M12). Clean register map (no V↔a aliasing):
//
//   A0-A5 = RDI, RSI, RDX, RCX, R8, R9
//   RET   = RAX
//   FP    = RBP, SP = RSP
//   V0-V5 = R10, R11, RBX, R12, R13, R14
//   S1    = R15 (drop-sequence base)
//   S4/S5 = R8/R9 (index len/ptr scratch; caller-saved)
//   V6/V7 / S0/S2/S3 / LR = unused (unmapped → RAX; do not use)
//
// Syscall: number in RAX; args RDI/RSI/RDX/R10/R8/R9 — copy A3 (RCX) to R10
// before SYSCALL. Windows uses call_iat (Win64 shuffle).

// VReg -> physical x64 register.
fn x64_map_reg(v int) int {
    if v == 0 { << 10 } // V0 -> R10
    if v == 1 { << 11 } // V1 -> R11
    if v == 2 { << 3 }  // V2 -> RBX
    if v == 3 { << 12 } // V3 -> R12
    if v == 4 { << 13 } // V4 -> R13
    if v == 5 { << 14 } // V5 -> R14
    if v == 8 { << 3 }  // S0 reserved -> RBX
    if v == 9 { << 15 } // S1 -> R15
    if v == 12 { << 8 } // S4 -> R8 (index len; must not alias RAX)
    if v == 13 { << 9 } // S5 -> R9 (index data ptr; must not alias RAX)
    if v == 14 { << 0 } // Ret -> RAX
    if v == 15 { << 5 } // Fp -> RBP
    if v == 16 { << 4 } // Sp -> RSP
    // A0-A5 -> RDI RSI RDX RCX R8 R9
    if v == 18 { << 7 }
    if v == 19 { << 6 }
    if v == 20 { << 2 }
    if v == 21 { << 1 }
    if v == 22 { << 8 }
    if v == 23 { << 9 }
    << 0
}

// Cond (EQ=0 NE=1 HS=2 LO=3 GE=10 LT=11 GT=12 LE=13) -> x64 setcc/jcc nibble.
fn x64_cc(cond int) int {
    if cond == 0 { << 4 }  // E
    if cond == 1 { << 5 }  // NE
    if cond == 2 { << 3 }  // AE/HS
    if cond == 3 { << 2 }  // B/LO
    if cond == 10 { << 13 } // GE
    if cond == 11 { << 12 } // L
    if cond == 12 { << 15 } // G
    if cond == 13 { << 14 } // LE
    if cond == 6 { << 6 } // VS
    if cond == 8 { << 7 } // a/HI
    if cond == 9 { << 9 } // BE/LS
    << 4
}

// two-operand helper: op(dest, a, b) on a two-operand ISA.
fn (a &mut Assembler) x64_two_op_add(dest int, x int, y int) {
    d := x64_map_reg(dest)
    ra := x64_map_reg(x)
    rb := x64_map_reg(y)
    if d == ra {
        a.x64_add_reg(d, rb)
    } else if d == rb {
        a.x64_add_reg(d, ra)
    } else {
        a.x64_mov_reg(d, ra)
        a.x64_add_reg(d, rb)
    }
}

fn (a &mut Assembler) x64_two_op_sub(dest int, x int, y int) {
    d := x64_map_reg(dest)
    ra := x64_map_reg(x)
    rb := x64_map_reg(y)
    if d == ra {
        a.x64_sub_reg(d, rb)
    } else if d == rb {
        a.x64_mov_reg(0, ra) // RAX scratch
        a.x64_sub_reg(0, d)
        a.x64_mov_reg(d, 0)
    } else {
        a.x64_mov_reg(d, ra)
        a.x64_sub_reg(d, rb)
    }
}

fn (a &mut Assembler) x64_two_op_mul(dest int, x int, y int) {
    d := x64_map_reg(dest)
    ra := x64_map_reg(x)
    rb := x64_map_reg(y)
    if d == ra {
        a.x64_imul(d, rb)
    } else if d == rb {
        a.x64_imul(d, ra)
    } else {
        a.x64_mov_reg(d, ra)
        a.x64_imul(d, rb)
    }
}

fn (a &mut Assembler) x64_two_op_and(dest int, x int, y int) {
    d := x64_map_reg(dest)
    ra := x64_map_reg(x)
    rb := x64_map_reg(y)
    if d == ra {
        a.x64_and_reg(d, rb)
    } else if d == rb {
        a.x64_and_reg(d, ra)
    } else {
        a.x64_mov_reg(d, ra)
        a.x64_and_reg(d, rb)
    }
}

fn (a &mut Assembler) x64_two_op_or(dest int, x int, y int) {
    d := x64_map_reg(dest)
    ra := x64_map_reg(x)
    rb := x64_map_reg(y)
    if d == ra {
        a.x64_or_reg(d, rb)
    } else if d == rb {
        a.x64_or_reg(d, ra)
    } else {
        a.x64_mov_reg(d, ra)
        a.x64_or_reg(d, rb)
    }
}

fn (a &mut Assembler) x64_two_op_xor(dest int, x int, y int) {
    d := x64_map_reg(dest)
    ra := x64_map_reg(x)
    rb := x64_map_reg(y)
    if d == ra {
        a.x64_xor_reg(d, rb)
    } else if d == rb {
        a.x64_xor_reg(d, ra)
    } else {
        a.x64_mov_reg(d, ra)
        a.x64_xor_reg(d, rb)
    }
}

// ===== be_* x64 implementations (called from arm64.xu dispatch) =====

fn (a &mut Assembler) xbe_mov(dest int, src int) {
    a.x64_mov_reg(x64_map_reg(dest), x64_map_reg(src))
}

fn (a &mut Assembler) xbe_mov_imm(dest int, imm int) {
    a.x64_mov_imm(x64_map_reg(dest), imm)
}

fn (a &mut Assembler) xbe_mov_imm64(dest int, imm int) {
    a.x64_mov_imm64(x64_map_reg(dest), imm)
}

fn (a &mut Assembler) xbe_lea(dest int, label string) {
    a.x64_lea_rip_rel(x64_map_reg(dest), label)
}

fn (a &mut Assembler) xbe_load(dest int, base int, offset int) {
    a.x64_load_offset(x64_map_reg(dest), x64_map_reg(base), offset)
}

fn (a &mut Assembler) xbe_store(base int, offset int, src int) {
    a.x64_store_offset(x64_map_reg(base), offset, x64_map_reg(src))
}

fn (a &mut Assembler) xbe_store_byte(base int, offset int, src int) {
    a.x64_store_byte_offset(x64_map_reg(base), offset, x64_map_reg(src))
}

fn (a &mut Assembler) xbe_load_byte(dest int, base int, offset int) {
    a.x64_load_byte_offset(x64_map_reg(dest), x64_map_reg(base), offset)
}

fn (a &mut Assembler) xbe_add(dest int, x int, y int) { a.x64_two_op_add(dest, x, y) }

fn (a &mut Assembler) xbe_add_imm(dest int, src int, imm int) {
    d := x64_map_reg(dest)
    s := x64_map_reg(src)
    if d != s { a.x64_mov_reg(d, s) }
    a.x64_add_imm(d, imm)
}

fn (a &mut Assembler) xbe_sub(dest int, x int, y int) { a.x64_two_op_sub(dest, x, y) }

fn (a &mut Assembler) xbe_sub_imm(dest int, src int, imm int) {
    d := x64_map_reg(dest)
    s := x64_map_reg(src)
    if d != s { a.x64_mov_reg(d, s) }
    a.x64_sub_imm(d, imm)
}

fn (a &mut Assembler) xbe_mul(dest int, x int, y int) { a.x64_two_op_mul(dest, x, y) }

fn (a &mut Assembler) xbe_div(dest int, x int, y int) {
    ra := x64_map_reg(x)
    mut rb := x64_map_reg(y)
    // idiv uses RAX:RDX; divisor must not live in either.
    if rb == 0 || rb == 2 {
        a.x64_mov_reg(10, rb) // R10 scratch (V0)
        rb = 10
    }
    if ra != 0 { a.x64_mov_reg(0, ra) }
    a.x64_cqo()
    a.x64_idiv(rb)
    d := x64_map_reg(dest)
    if d != 0 { a.x64_mov_reg(d, 0) }
}

fn (a &mut Assembler) xbe_mod(dest int, x int, y int) {
    ra := x64_map_reg(x)
    mut rb := x64_map_reg(y)
    if rb == 0 || rb == 2 {
        a.x64_mov_reg(10, rb)
        rb = 10
    }
    if ra != 0 { a.x64_mov_reg(0, ra) }
    a.x64_cqo()
    a.x64_idiv(rb)
    d := x64_map_reg(dest)
    a.x64_mov_reg(d, 2) // remainder in RDX
}

fn (a &mut Assembler) xbe_neg(dest int, src int) {
    d := x64_map_reg(dest)
    s := x64_map_reg(src)
    if d != s { a.x64_mov_reg(d, s) }
    a.x64_neg_reg(d)
}

fn (a &mut Assembler) xbe_shl_imm(dest int, src int, imm int) {
    d := x64_map_reg(dest)
    s := x64_map_reg(src)
    if d != s { a.x64_mov_reg(d, s) }
    a.x64_shl_imm(d, imm)
}

fn (a &mut Assembler) xbe_shr_imm(dest int, src int, imm int) {
    d := x64_map_reg(dest)
    s := x64_map_reg(src)
    if d != s { a.x64_mov_reg(d, s) }
    a.x64_shr_imm(d, imm)
}

fn (a &mut Assembler) xbe_and(dest int, x int, y int) { a.x64_two_op_and(dest, x, y) }

fn (a &mut Assembler) xbe_and_imm(dest int, src int, imm int) {
    d := x64_map_reg(dest)
    s := x64_map_reg(src)
    if d != s { a.x64_mov_reg(d, s) }
    if imm >= -2147483648 && imm <= 2147483647 {
        a.x64_and_imm(d, imm)
        <<
    }
    a.x64_mov_imm64(0, imm)
    a.x64_and_reg(d, 0)
}

fn (a &mut Assembler) xbe_load_scaled(dest int, base int, index int, elem_sz int) {
    idx := x64_map_reg(index)
    if idx == 4 || (elem_sz != 1 && elem_sz != 2 && elem_sz != 4 && elem_sz != 8) {
        if elem_sz == 1 {
            a.xbe_add(dest, base, index)
            a.xbe_load_byte(dest, dest, 0)
            <<
        }
        mut sh := 0
        if elem_sz == 2 { sh = 1 }
        if elem_sz == 4 { sh = 2 }
        if elem_sz == 8 { sh = 3 }
        if sh == 0 && elem_sz != 1 {
            a.xbe_mov_imm(dest, elem_sz)
            a.xbe_mul(dest, index, dest)
        } else {
            a.xbe_shl_imm(dest, index, sh)
        }
        a.xbe_add(dest, base, dest)
        a.xbe_load(dest, dest, 0)
        <<
    }
    sc := x64_scale_bits(elem_sz)
    if elem_sz == 1 {
        a.x64_load_byte_sib(x64_map_reg(dest), x64_map_reg(base), idx, sc, 0)
        <<
    }
    a.x64_load_sib(x64_map_reg(dest), x64_map_reg(base), idx, sc, 0)
}

fn (a &mut Assembler) xbe_store_scaled(base int, index int, src int, elem_sz int) {
    idx := x64_map_reg(index)
    if idx == 4 || (elem_sz != 1 && elem_sz != 2 && elem_sz != 4 && elem_sz != 8) {
        mut scratch := 0
        if src == 0 || base == 0 || index == 0 {
            scratch = 1
        }
        if elem_sz == 1 {
            a.xbe_add(scratch, base, index)
        } else {
            mut sh := 0
            if elem_sz == 2 { sh = 1 }
            if elem_sz == 4 { sh = 2 }
            if elem_sz == 8 { sh = 3 }
            a.xbe_shl_imm(scratch, index, sh)
            a.xbe_add(scratch, base, scratch)
        }
        if elem_sz == 1 {
            a.xbe_store_byte(scratch, 0, src)
        } else {
            a.xbe_store(scratch, 0, src)
        }
        <<
    }
    sc := x64_scale_bits(elem_sz)
    if elem_sz == 1 {
        a.x64_store_byte_sib(x64_map_reg(base), idx, x64_map_reg(src), sc, 0)
        <<
    }
    a.x64_store_sib(x64_map_reg(base), idx, x64_map_reg(src), sc, 0)
}

fn (a &mut Assembler) xbe_or(dest int, x int, y int) { a.x64_two_op_or(dest, x, y) }
fn (a &mut Assembler) xbe_xor(dest int, x int, y int) { a.x64_two_op_xor(dest, x, y) }

fn (a &mut Assembler) xbe_shl(dest int, src int, count int) {
    d := x64_map_reg(dest)
    s := x64_map_reg(src)
    c := x64_map_reg(count)
    if c != 1 { a.x64_mov_reg(1, c) } // RCX = CL
    if d != s { a.x64_mov_reg(d, s) }
    a.x64_shl_cl(d)
}

fn (a &mut Assembler) xbe_shr(dest int, src int, count int) {
    d := x64_map_reg(dest)
    s := x64_map_reg(src)
    c := x64_map_reg(count)
    if c != 1 { a.x64_mov_reg(1, c) }
    if d != s { a.x64_mov_reg(d, s) }
    a.x64_sar_cl(d)
}

fn (a &mut Assembler) xbe_asr_imm(dest int, src int, imm int) {
    d := x64_map_reg(dest)
    s := x64_map_reg(src)
    if d != s { a.x64_mov_reg(d, s) }
    a.x64_sar_imm(d, imm)
}

fn (a &mut Assembler) xbe_ror_imm32(dest int, src int, imm int) {
    d := x64_map_reg(dest)
    s := x64_map_reg(src)
    if d != s { a.x64_mov_reg(d, s) }
    a.x64_ror_imm32(d, imm)
}

// Physical scratch: RAX / R8 / R9 (caller-saved; not a pin home).
fn x64_tmp3(a int, b int, c int) int {
    if a != 0 && b != 0 && c != 0 {
        << 0
    }
    if a != 8 && b != 8 && c != 8 {
        << 8
    }
    << 9
}

fn (a &mut Assembler) xbe_eor_ror32(dest int, acc int, src int, imm int) {
    d := x64_map_reg(dest)
    ra := x64_map_reg(acc)
    s := x64_map_reg(src)
    if d != ra {
        a.x64_mov_reg(d, ra)
    }
    sc := x64_tmp3(d, ra, s)
    a.x64_mov_reg(sc, s)
    a.x64_ror_imm32(sc, imm)
    a.x64_xor_reg(d, sc)
}

fn (a &mut Assembler) xbe_eor_lsr32(dest int, acc int, src int, imm int) {
    d := x64_map_reg(dest)
    ra := x64_map_reg(acc)
    s := x64_map_reg(src)
    if d != ra {
        a.x64_mov_reg(d, ra)
    }
    sc := x64_tmp3(d, ra, s)
    a.x64_mov_reg(sc, s)
    a.x64_shr_imm32(sc, imm)
    a.x64_xor_reg(d, sc)
}

fn (a &mut Assembler) xbe_bic32(dest int, y int, x int) {
    d := x64_map_reg(dest)
    ra := x64_map_reg(y)
    rb := x64_map_reg(x)
    if d != ra {
        a.x64_mov_reg(d, ra)
    }
    sc := x64_tmp3(d, ra, rb)
    a.x64_mov_reg(sc, rb)
    a.x64_not32(sc)
    a.x64_and_reg(d, sc)
}

fn (a &mut Assembler) xbe_mvn32(dest int, src int) {
    d := x64_map_reg(dest)
    s := x64_map_reg(src)
    if d != s {
        a.x64_mov_reg(d, s)
    }
    a.x64_not32(d)
}

fn (a &mut Assembler) xbe_cmp(x int, y int) {
    a.x64_cmp_reg(x64_map_reg(x), x64_map_reg(y))
}

fn (a &mut Assembler) xbe_cmp_imm(x int, imm int) {
    ra := x64_map_reg(x)
    if imm >= -2147483648 && imm <= 2147483647 {
        a.x64_cmp_imm(ra, imm)
    } else {
        a.x64_mov_imm64(0, imm)
        a.x64_cmp_reg(ra, 0)
    }
}

fn (a &mut Assembler) xbe_cset(dest int, cond int) {
    a.x64_setcc(x64_map_reg(dest), x64_cc(cond))
}

fn (a &mut Assembler) xbe_csel(dest int, yes int, no int, cond int) {
    d := x64_map_reg(dest)
    y := x64_map_reg(yes)
    n := x64_map_reg(no)
    if d == y {
        a.x64_cmovcc(d, n, x64_cc(invert_cc(cond)))
    } else {
        if d != n { a.x64_mov_reg(d, n) }
        a.x64_cmovcc(d, y, x64_cc(cond))
    }
}

fn (a &mut Assembler) xbe_csinc(dest int, yes int, no int, cond int) {
    // LEA preserves flags. RAX is caller scratch and never a natural-loop pin.
    n := x64_map_reg(no)
    a.x64_lea_offset(0, n, 1)
    // Virtual Ret (14) maps to the physical RAX scratch populated above.
    a.xbe_csel(dest, yes, 14, cond)
}

fn (a &mut Assembler) xbe_fcset(dest int, cond int) {
    d := x64_map_reg(dest)
    mut sc := 0
    if d == 0 { sc = 2 }
    if cond == 0 { // EQ: equal and ordered
        a.x64_setcc(d, 4)
        a.x64_setcc(sc, 11)
        a.x64_and_reg(d, sc)
    } else if cond == 1 { // NE: unequal or unordered
        a.x64_setcc(d, 5)
        a.x64_setcc(sc, 10)
        a.x64_or_reg(d, sc)
    } else if cond == 11 { // LT: below and ordered
        a.x64_setcc(d, 2)
        a.x64_setcc(sc, 11)
        a.x64_and_reg(d, sc)
    } else if cond == 13 { // LE: below/equal and ordered
        a.x64_setcc(d, 6)
        a.x64_setcc(sc, 11)
        a.x64_and_reg(d, sc)
    } else if cond == 12 { // GT: above
        a.x64_setcc(d, 7)
    } else if cond == 10 { // GE: above/equal
        a.x64_setcc(d, 3)
    } else if cond == 6 { // VS: unordered/parity
        a.x64_setcc(d, 10)
    } else {
        a.x64_setcc(d, x64_cc(cond))
    }
}

fn (a &mut Assembler) xbe_jmp(label string) { a.x64_jmp(label) }
fn (a &mut Assembler) xbe_jeq(label string) { a.x64_jcc(4, label) }
fn (a &mut Assembler) xbe_jne(label string) { a.x64_jcc(5, label) }
fn (a &mut Assembler) xbe_jlt(label string) { a.x64_jcc(12, label) }
fn (a &mut Assembler) xbe_jle(label string) { a.x64_jcc(14, label) }
fn (a &mut Assembler) xbe_jgt(label string) { a.x64_jcc(15, label) }
fn (a &mut Assembler) xbe_jge(label string) { a.x64_jcc(13, label) }
fn (a &mut Assembler) xbe_jae(label string) { a.x64_jcc(3, label) }

fn (a &mut Assembler) xbe_cbz(reg int, label string) {
    r := x64_map_reg(reg)
    a.x64_test_reg(r, r)
    a.x64_jcc(4, label)
}

fn (a &mut Assembler) xbe_cbnz(reg int, label string) {
    r := x64_map_reg(reg)
    a.x64_test_reg(r, r)
    a.x64_jcc(5, label)
}

fn (a &mut Assembler) xbe_prologue(frame_size int) {
    if a.os == 2 {
        a.x64_endbr()
    }
    // rbx, r12–r15 + 8B pad → 48B, then RBP link (matches xubackend).
    a.x64_push(3)  // RBX
    a.x64_push(12) // R12
    a.x64_push(13) // R13
    a.x64_push(14) // R14
    a.x64_push(15) // R15
    a.x64_sub_imm(4, 8)
    a.x64_push(5) // RBP
    a.x64_mov_reg(5, 4) // RBP = RSP
    if frame_size > 0 {
        // Windows grows the stack via a guard page. `sub rsp, N` for N bigger
        // than one page never touches that page, so the first far-slot access
        // is an AV (x64 `up` dying early in startup). Probe each page.
        if a.os == 2 && frame_size > 4096 {
            mut left := frame_size
            // Touch with a zero store (not live RAX), matching ARM64 XZR probe.
            a.x64_mov_imm(0, 0)
            while left > 4096 {
                a.x64_sub_imm(4, 4096)
                a.x64_store_offset(4, 0, 0)
                left = left - 4096
            }
            if left > 0 {
                a.x64_sub_imm(4, left)
            }
        } else {
            a.x64_sub_imm(4, frame_size)
        }
    }
}

fn (a &mut Assembler) xbe_epilogue() {
    a.x64_mov_reg(4, 5)
    a.x64_pop(5)
    a.x64_add_imm(4, 8)
    a.x64_pop(15)
    a.x64_pop(14)
    a.x64_pop(13)
    a.x64_pop(12)
    a.x64_pop(3)
    a.x64_ret()
}

fn (a &mut Assembler) xbe_call(label string) { a.x64_call(label) }

fn (a &mut Assembler) xbe_syscall(num int) {
    // Linux x64 4th arg is R10, but R10 is V0. Save V0, copy A3 (RCX), restore.
    a.x64_push(10)
    a.x64_mov_reg(10, 1)
    a.x64_mov_imm(0, num)
    a.x64_syscall()
    a.x64_pop(10)
}

// Win64: SysV A0-A5 -> RCX/RDX/R8/R9 + shadow + stack args.
fn (a &mut Assembler) xbe_call_iat(label string) {
    a.x64_sub_imm(4, 48) // shadow 32 + arg5 + pad
    a.x64_store_offset(4, 32, 8) // arg5 = A4 (R8)
    a.x64_mov_reg(9, 1) // R9 = A3 (RCX)
    a.x64_mov_reg(8, 2) // R8 = A2 (RDX)
    a.x64_mov_reg(2, 6) // RDX = A1 (RSI)
    a.x64_mov_reg(1, 7) // RCX = A0 (RDI)
    a.x64_call_iat_raw(label)
    a.x64_add_imm(4, 48)
}

// Call a Win64 function pointer in vreg (must be R10/R11 = V0/V1).
fn (a &mut Assembler) xbe_call_reg_win(vreg int) {
    r := x64_map_reg(vreg)
    a.x64_sub_imm(4, 48)
    a.x64_store_offset(4, 32, 8)
    a.x64_mov_reg(9, 1)
    a.x64_mov_reg(8, 2)
    a.x64_mov_reg(2, 6)
    a.x64_mov_reg(1, 7)
    a.x64_call_reg(r)
    a.x64_add_imm(4, 48)
}

fn (a &mut Assembler) xbe_call_reg_win6(vreg int) {
    r := x64_map_reg(vreg)
    a.x64_sub_imm(4, 64)
    a.x64_store_offset(4, 32, 8)
    a.x64_store_offset(4, 40, 9)
    a.x64_mov_reg(9, 1)
    a.x64_mov_reg(8, 2)
    a.x64_mov_reg(2, 6)
    a.x64_mov_reg(1, 7)
    a.x64_call_reg(r)
    a.x64_add_imm(4, 64)
}

fn (a &mut Assembler) xbe_call_iat7(label string) {
    a.x64_sub_imm(4, 64)
    a.x64_store_offset(4, 32, 8) // arg5 = A4
    a.x64_store_offset(4, 40, 9) // arg6 = A5
    a.x64_mov_imm(0, 0)
    a.x64_store_offset(4, 48, 0) // arg7 = NULL
    a.x64_mov_reg(9, 1)
    a.x64_mov_reg(8, 2)
    a.x64_mov_reg(2, 6)
    a.x64_mov_reg(1, 7)
    a.x64_call_iat_raw(label)
    a.x64_add_imm(4, 64)
}

// CreateProcessA: SysV A0=cmdline, A1=&STARTUPINFOA, A2=&PROCESS_INFORMATION.
// Scratch only RAX/R10/R11 (caller-saved) — never RBX/R12+.
fn (a &mut Assembler) xbe_call_iat_createprocess(label string) {
    a.x64_sub_imm(4, 96)
    a.x64_mov_reg(10, 7) // R10 = cmdline
    a.x64_mov_reg(11, 6) // R11 = &si
    a.x64_store_offset(4, 80, 2) // spill &pi (was RDX/A2) above stack args
    a.x64_mov_imm(1, 0) // RCX = NULL
    a.x64_mov_reg(2, 10) // RDX = cmdline
    a.x64_mov_imm(8, 0) // R8 = NULL
    a.x64_mov_imm(9, 0) // R9 = NULL
    a.x64_mov_imm(0, 0)
    a.x64_store_offset(4, 32, 0) // inherit FALSE
    a.x64_store_offset(4, 40, 0) // flags 0
    a.x64_store_offset(4, 48, 0) // env NULL
    a.x64_store_offset(4, 56, 0) // cwd NULL
    a.x64_store_offset(4, 64, 11) // &si
    // arg10 = &pi from spill at [rsp+80]
    a.x64_load_offset(0, 4, 80)
    a.x64_store_offset(4, 72, 0)
    a.x64_call_iat_raw(label)
    a.x64_add_imm(4, 96)
}

// CreateProcessA for os_exec: A0=app A1=cmdline A2=cwd A3=&si A4=&pi A5=inherit.
fn (a &mut Assembler) xbe_call_iat_createprocess_exec(label string) {
    mut tmp := []string{}
    tmp.push(label)
    a.x64_sub_imm(4, 96)
    a.x64_mov_reg(10, 7)
    a.x64_mov_reg(11, 6)
    a.x64_store_offset(4, 80, 2)
    a.x64_store_offset(4, 88, 1)
    a.x64_store_offset(4, 72, 8)
    a.x64_store_offset(4, 32, 9)
    a.x64_mov_reg(1, 10)
    a.x64_mov_reg(2, 11)
    a.x64_mov_imm(8, 0)
    a.x64_mov_imm(9, 0)
    a.x64_mov_imm(0, 0)
    a.x64_store_offset(4, 40, 0)
    a.x64_store_offset(4, 48, 0)
    a.x64_load_offset(0, 4, 80)
    a.x64_store_offset(4, 56, 0)
    a.x64_load_offset(0, 4, 88)
    a.x64_store_offset(4, 64, 0)
    a.x64_call_iat_raw(tmp[0])
    a.x64_add_imm(4, 96)
}

// DeviceIoControl: A0..A5 = handle, code, in, inlen, out, outlen;
// 7th = &local DWORD, 8th = NULL overlapped.
fn (a &mut Assembler) xbe_call_iat_deviceiocontrol(label string) {
    mut tmp := []string{}
    tmp.push(label)
    a.x64_sub_imm(4, 80)
    a.x64_store_offset(4, 32, 8)
    a.x64_store_offset(4, 40, 9)
    a.x64_mov_imm(0, 0)
    a.x64_store_offset(4, 72, 0)
    a.x64_lea_offset(0, 4, 72)
    a.x64_store_offset(4, 48, 0)
    a.x64_mov_imm(0, 0)
    a.x64_store_offset(4, 56, 0)
    a.x64_mov_reg(9, 1)
    a.x64_mov_reg(8, 2)
    a.x64_mov_reg(2, 6)
    a.x64_mov_reg(1, 7)
    a.x64_call_iat_raw(tmp[0])
    a.x64_add_imm(4, 80)
}

fn (a &mut Assembler) xbe_normalize_syscall(ok_label string) {
    // macOS x64: carry set + positive errno -> negate. Linux already -errno.
    // two label copies via []string so M2b allows uses (no string local in if).
    mut t := []string{}
    t.push(ok_label)
    mut s2 := ""
    for i in 0:t[0].len {
        s2 = s2 + string_from_byte(t[0][i])
    }
    t.push(s2)
    if a.os == 0 {
        a.x64_jcc(3, t[0]) // jnc/jae
        a.x64_neg_reg(0)
        a.label(t[1])
    }
}

// ===== Floating point (M13) =====

fn (a &mut Assembler) xbe_fadd(dest int, x int, y int) {
    da := x64_map_reg(x)
    db := x64_map_reg(y)
    dd := x64_map_reg(dest)
    a.x64_movq_xmm_from_r(0, da)
    a.x64_movq_xmm_from_r(1, db)
    a.x64_addsd(0, 1)
    a.x64_movq_r_from_xmm(dd, 0)
}

fn (a &mut Assembler) xbe_fsub(dest int, x int, y int) {
    da := x64_map_reg(x)
    db := x64_map_reg(y)
    dd := x64_map_reg(dest)
    a.x64_movq_xmm_from_r(0, da)
    a.x64_movq_xmm_from_r(1, db)
    a.x64_subsd(0, 1)
    a.x64_movq_r_from_xmm(dd, 0)
}

fn (a &mut Assembler) xbe_fmul(dest int, x int, y int) {
    da := x64_map_reg(x)
    db := x64_map_reg(y)
    dd := x64_map_reg(dest)
    a.x64_movq_xmm_from_r(0, da)
    a.x64_movq_xmm_from_r(1, db)
    a.x64_mulsd(0, 1)
    a.x64_movq_r_from_xmm(dd, 0)
}

fn (a &mut Assembler) xbe_fdiv(dest int, x int, y int) {
    da := x64_map_reg(x)
    db := x64_map_reg(y)
    dd := x64_map_reg(dest)
    a.x64_movq_xmm_from_r(0, da)
    a.x64_movq_xmm_from_r(1, db)
    a.x64_divsd(0, 1)
    a.x64_movq_r_from_xmm(dd, 0)
}

fn (a &mut Assembler) xbe_fneg(dest int, src int) {
    ds := x64_map_reg(src)
    dd := x64_map_reg(dest)
    if dd != ds { a.x64_mov_reg(dd, ds) }
    // XOR with 0x8000_0000_0000_0000 via RAX (i64::MIN without OOR literal)
    a.x64_mov_imm64(0, 0 - 9223372036854775807 - 1)
    a.x64_xor_reg(dd, 0)
}

fn (a &mut Assembler) xbe_fsqrt(dest int, src int) {
    ds := x64_map_reg(src)
    dd := x64_map_reg(dest)
    a.x64_movq_xmm_from_r(0, ds)
    a.x64_sqrtsd(0, 0)
    a.x64_movq_r_from_xmm(dd, 0)
}

// ctlz: 63 - BSR, 64 when src is 0. BSR leaves ZF set on a zero source;
// CMOVE installs -1 so 63-dest is 64, matching Go bits.LeadingZeros64.
fn (a &mut Assembler) xbe_clz(dest int, src int) {
    d := x64_map_reg(dest)
    s := x64_map_reg(src)
    mut sc := 0
    if d == 0 {
        sc = 11
    }
    a.x64_bsr(d, s)
    a.x64_mov_imm(sc, 0 - 1)
    a.x64_cmovcc(d, sc, 4)
    a.x64_mov_imm(sc, 63)
    a.x64_sub_reg(sc, d)
    a.x64_mov_reg(d, sc)
}

// cttz: TZCNT, dest preloaded to 64 so both BMI1 TZCNT and REP BSF
// return 64 for a zero source (Go bits.TrailingZeros64).
fn (a &mut Assembler) xbe_ctz(dest int, src int) {
    d := x64_map_reg(dest)
    s := x64_map_reg(src)
    if d == s {
        mut sc := 0
        if d == 0 {
            sc = 11
        }
        a.x64_mov_reg(sc, s)
        a.x64_mov_imm(d, 64)
        a.x64_tzcnt_compat(d, sc)
        <<
    }
    a.x64_mov_imm(d, 64)
    a.x64_tzcnt_compat(d, s)
}

fn (a &mut Assembler) xbe_fcmp(x int, y int) {
    da := x64_map_reg(x)
    db := x64_map_reg(y)
    a.x64_movq_xmm_from_r(0, da)
    a.x64_movq_xmm_from_r(1, db)
    a.x64_ucomisd(0, 1)
}

fn (a &mut Assembler) xbe_scvtf(dest int, src int) {
    ds := x64_map_reg(src)
    dd := x64_map_reg(dest)
    a.x64_cvtsi2sd(0, ds)
    a.x64_movq_r_from_xmm(dd, 0)
}

fn (a &mut Assembler) xbe_fcvtzs(dest int, src int) {
    ds := x64_map_reg(src)
    dd := x64_map_reg(dest)
    a.x64_movq_xmm_from_r(0, ds)
    a.x64_cvttsd2si(dd, 0)
}

fn (a &mut Assembler) xbe_sse_op(dst int, src int, which int) {
    if which == 0 {
        a.x64_addsd(dst, src)
    }
    if which == 1 {
        a.x64_subsd(dst, src)
    }
    if which == 2 {
        a.x64_mulsd(dst, src)
    }
    if which == 3 {
        a.x64_divsd(dst, src)
    }
}

fn (a &mut Assembler) xbe_sse_binop_d(dd int, dn int, dm int, comm int, which int) {
    if dd == dn {
        a.xbe_sse_op(dd, dm, which)
        <<
    }
    if comm == 1 && dd == dm {
        a.xbe_sse_op(dd, dn, which)
        <<
    }
    if dd == dm {
        mut sc := 0
        if dn == 0 {
            sc = 1
        }
        a.x64_movsd_reg(sc, dm)
        a.x64_movsd_reg(dd, dn)
        a.xbe_sse_op(dd, sc, which)
        <<
    }
    a.x64_movsd_reg(dd, dn)
    a.xbe_sse_op(dd, dm, which)
}

fn (a &mut Assembler) xbe_movdqu_load(xmm int, base int, offset int) {
    a.x64_movdqu_load(xmm, x64_map_reg(base), offset)
}

fn (a &mut Assembler) xbe_movdqu_store(base int, offset int, xmm int) {
    a.x64_movdqu_store(x64_map_reg(base), offset, xmm)
}
