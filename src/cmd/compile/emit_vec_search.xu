@main

#xu/types

// Predicated scan and binary search.


fn vec_pred_load(m &types.Mir, fi int, bi int) VecPat {
    mut r := vec_none()
    if types.mir_btkind(m, fi, bi) != 2 { << r }
    mut nld := 0
    mut ld_ii := -1
    mut neq := 0
    mut eq_ok := false
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == 14 {
            if !vec_elem8(types.mir_id(m, fi, ii)) { << vec_none() }
            nld += 1
            ld_ii = ii
        } else if k == 4 && types.mir_ib(m, fi, ii) == 6 {
            neq += 1
            lc := types.mir_ic(m, fi, ii)
            ld := types.mir_id(m, fi, ii)
            mut cside := false
            mut oside := -1
            if vec_operand_is_one(m, fi, bi, ld) {
                cside = true
                oside = lc
            } else if vec_operand_is_one(m, fi, bi, lc) {
                cside = true
                oside = ld
            }
            if cside {
                if ld_ii >= 0 {
                    if vec_same_val(m, fi, bi, oside, types.mir_ia(m, fi, ld_ii)) {
                        eq_ok = true
                    }
                }
            }
        } else if k != 1 && k != 2 && k != 4 {
            << vec_none()
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if nld != 1 || neq != 1 || !eq_ok { << r }
    r.kind = 1
    r.arr = types.mir_ib(m, fi, ld_ii)
    r.ind = types.mir_ic(m, fi, ld_ii)
    << r
}

fn vec_pred_then(m &types.Mir, fi int, bi int, kloc int) VecPat {
    mut r := vec_none()
    if types.mir_btkind(m, fi, bi) != 1 { << r }
    mut nplus1 := 0
    mut nplusk := 0
    mut cloc := -1
    mut tloc := -1
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == 3 {
            loc := types.mir_ia(m, fi, ii)
            if loc == kloc { << vec_none() }
            st := types.mir_ib(m, fi, ii)
            mut jj := types.mir_bhead(m, fi, bi)
            for _ in 0:types.mir_nins(m, fi) {
                if jj < 0 { <- }
                if types.mir_ikind(m, fi, jj) == 4 && types.mir_ia(m, fi, jj) == st && types.mir_ib(m, fi, jj) == 1 {
                    lc := types.mir_ic(m, fi, jj)
                    ld := types.mir_id(m, fi, jj)
                    from_c := vec_temp_from_local(m, fi, bi, lc, loc)
                    from_d := vec_temp_from_local(m, fi, bi, ld, loc)
                    if from_c && vec_operand_is_one(m, fi, bi, ld) {
                        nplus1 += 1
                        cloc = loc
                    } else if from_d && vec_operand_is_one(m, fi, bi, lc) {
                        nplus1 += 1
                        cloc = loc
                    } else if from_c && vec_temp_from_local(m, fi, bi, ld, kloc) {
                        nplusk += 1
                        tloc = loc
                    } else if from_d && vec_temp_from_local(m, fi, bi, lc, kloc) {
                        nplusk += 1
                        tloc = loc
                    }
                }
                jj = types.mir_inext(m, fi, jj)
            }
        } else if k != 1 && k != 2 && k != 4 {
            << vec_none()
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if nplus1 != 1 || nplusk != 1 { << r }
    if cloc < 0 || tloc < 0 || cloc == tloc { << r }
    r.kind = 1
    r.acc = types.mir_local_operand_base + cloc
    r.fac = types.mir_local_operand_base + tloc
    << r
}

fn match_pred_scan(m &types.Mir, fi int, bi int) VecPat {
    ld := vec_pred_load(m, fi, bi)
    if ld.kind == 0 { << vec_none() }
    idx := vec_trace(m, fi, bi, ld.ind)
    mut kloc := -1
    if idx >= types.mir_local_operand_base {
        kloc = idx - types.mir_local_operand_base
    } else {
        kloc = vec_local_of_temp(m, fi, bi, idx)
    }
    if kloc < 0 { << vec_none() }
    mut arr := vec_trace(m, fi, bi, ld.arr)
    arr = vec_resolve_desc(m, fi, bi, arr)
    if emit_base_fixed_len(m, fi, arr) > 0 { << vec_none() }
    tb := vec_skip_empty(m, fi, types.mir_btb(m, fi, bi))
    tc := vec_skip_empty(m, fi, types.mir_btc(m, fi, bi))
    if tb < 0 || tc < 0 { << vec_none() }
    t1 := vec_pred_then(m, fi, tb, kloc)
    t2 := vec_pred_then(m, fi, tc, kloc)
    mut thenp := t1
    mut then_bb := tb
    mut else_bb := tc
    if t1.kind == 1 && t2.kind == 0 {
    } else if t2.kind == 1 && t1.kind == 0 {
        thenp = t2
        then_bb = tc
        else_bb = tb
    } else {
        << vec_none()
    }
    latch1 := vec_skip_empty(m, fi, types.mir_bta(m, fi, then_bb))
    latch2 := vec_skip_empty(m, fi, else_bb)
    if latch1 < 0 || latch1 != latch2 { << vec_none() }
    if latch1 == bi { << vec_none() }
    mut bit := vec_find_ind_copy(m, fi, latch1)
    if bit < 0 {
        bit = vec_find_ind(m, fi, latch1)
    }
    if bit != kloc { << vec_none() }
    mut lim := vec_copy_limit_in(m, fi, latch1, types.mir_local_operand_base + kloc)
    if lim.kind == 0 {
        lim = vec_copy_limit_cmp(m, fi, latch1, types.mir_local_operand_base + kloc, 9)
        if lim.kind == 0 { << vec_none() }
        if lim.limit_t < 0 {
            if lim.limit <= 16 { << vec_none() }
            lim.limit = lim.limit - 1
            lim.limit_t = -2
        }
    }
    tbh := vec_edge_to(m, fi, types.mir_btb(m, fi, latch1), bi)
    tch := vec_edge_to(m, fi, types.mir_btc(m, fi, latch1), bi)
    mut exit_bb := -1
    if tbh && !tch {
        exit_bb = types.mir_btc(m, fi, latch1)
    } else if tch && !tbh {
        exit_bb = types.mir_btb(m, fi, latch1)
    } else {
        << vec_none()
    }
    << VecPat{kind: 16, ind: types.mir_local_operand_base + kloc, acc: thenp.acc, mask: 1, limit: lim.limit, limit_t: lim.limit_t, else_bb: exit_bb, arr: arr, fac: thenp.fac}
}

fn emit_pred_scan(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, pins &[]int, p VecPat) int {
    kloc := p.ind - types.mir_local_operand_base
    cloc := p.acc - types.mir_local_operand_base
    tloc := p.fac - types.mir_local_operand_base
    if kloc < 0 || kloc >= fr.local_slot.len { << 0 }
    if cloc < 0 || cloc >= fr.local_slot.len { << 0 }
    if tloc < 0 || tloc >= fr.local_slot.len { << 0 }
    if p.else_bb < 0 { << 0 }
    mut lim_local := -1
    if p.limit_t >= types.mir_local_operand_base {
        lim_local = p.limit_t - types.mir_local_operand_base
        if lim_local < 0 || lim_local >= fr.local_slot.len { << 0 }
    } else if p.limit_t >= 0 {
        if p.limit_t >= fr.temp_slot.len { << 0 }
    }
    mut le := 0
    if p.limit_t == 0 - 2 {
        le = 1
    }
    if p.limit_t >= 0 && p.limit == 1 {
        le = 1
    }
    a.load(6, 15, slot_off(fr.local_slot[kloc]))
    if lim_local >= 0 {
        a.load(1, 15, slot_off(fr.local_slot[lim_local]))
    } else if p.limit_t >= 0 {
        emit_load_value(a, m, fi, fr, p.limit_t, 1)
    } else {
        a.vm_mov_imm64(1, p.limit)
    }
    a.load(4, 15, slot_off(fr.local_slot[cloc]))
    a.load(11, 15, slot_off(fr.local_slot[tloc]))
    emit_index_desc_addr(a, m, fi, fr, p.arr)
    a.load(7, 0, -8)
    a.load(13, 0, 0)
    a.oob_need = 1
    a.vm_cmp_imm(6, 0)
    a.jlt(a.oob_lbl + "")
    a.cmp(1, 7)
    if le == 1 {
        a.jae(a.oob_lbl + "")
    } else {
        a.jgt(a.oob_lbl + "")
    }
    a.add_lsl_vr(13, 13, 6, 3)
    a.vm_mov_imm(0, 1)
    a.be_neon_dup_2d(4, 0)
    a.be_neon_ins_d(0, 0, 6)
    a.vm_add_imm(2, 6, 1)
    a.be_neon_ins_d(0, 1, 2)
    a.vm_mov_imm(2, 2)
    a.be_neon_dup_2d(1, 2)
    a.be_neon_add_2d(2, 0, 1)
    a.vm_mov_imm(3, 4)
    a.be_neon_dup_2d(3, 3)
    a.be_neon_movi_2d0(18)
    a.be_neon_movi_2d0(19)
    a.be_neon_movi_2d0(22)
    a.be_neon_movi_2d0(23)
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi)
    s4 := pref + "_q4"
    s1 := pref + "_q1"
    dn := pref + "_qd"
    else_lbl := types.mir_fn_label(m, fi) + "_bb" + str(p.else_bb)
    a.vm_add_imm(5, 6, 3)
    a.cmp(5, 6)
    a.jlt(s1 + "")
    a.label(s4 + "")
    a.vm_add_imm(5, 6, 3)
    a.cmp(5, 1)
    if le == 1 {
        a.jgt(s1 + "")
    } else {
        a.jge(s1 + "")
    }
    a.be_neon_ldp_q_post32(16, 17, 13)
    a.be_neon_cmeq_2d(16, 16, 4)
    a.be_neon_cmeq_2d(17, 17, 4)
    a.be_neon_sub_2d(18, 18, 16)
    a.be_neon_sub_2d(19, 19, 17)
    a.be_neon_and_16b(16, 0, 16)
    a.be_neon_and_16b(17, 2, 17)
    a.be_neon_add_2d(22, 22, 16)
    a.be_neon_add_2d(23, 23, 17)
    a.be_neon_add_2d(0, 0, 3)
    a.be_neon_add_2d(2, 2, 3)
    a.vm_add_imm(6, 6, 4)
    a.jmp(s4 + "")
    a.label(s1 + "")
    a.cmp(6, 1)
    if le == 1 {
        a.jgt(dn + "")
    } else {
        a.jge(dn + "")
    }
    a.load(0, 13, 0)
    a.vm_cmp_imm(0, 1)
    a.vm_mov_imm(2, 0)
    a.vm_csel(2, 6, 2, 0)
    a.vm_csinc(4, 4, 4, 1)
    a.add(11, 11, 2)
    a.vm_add_imm(13, 13, 8)
    a.vm_add_imm(6, 6, 1)
    a.jmp(s1 + "")
    a.label(dn + "")
    a.be_neon_add_2d(18, 18, 19)
    a.be_neon_addp_d(18, 18)
    a.be_fmov_gpr_from_d(0, 18)
    a.add(4, 4, 0)
    a.be_neon_add_2d(22, 22, 23)
    a.be_neon_addp_d(22, 22)
    a.be_fmov_gpr_from_d(0, 22)
    a.add(11, 11, 0)
    a.store(15, slot_off(fr.local_slot[kloc]), 6)
    a.store(15, slot_off(fr.local_slot[cloc]), 4)
    a.store(15, slot_off(fr.local_slot[tloc]), 11)
    a.jmp(else_lbl + "")
    << 1
}

// kind 17: canonical lower-bound loops on a borrowed int slice.
// The inexpensive discovery below is not a transformation proof. The
// complete ordered LoopPlan and the consumer's frame/exit contract gate
// emission separately; names and source paths never participate.
fn vec_bsearch_core(m &types.Mir, fi int, bi int) VecPat {
    mut r := vec_none()
    if types.mir_nlocals(m, fi) > 16 { << r }
    if types.mir_nblocks(m, fi) > 24 { << r }
    if types.mir_btkind(m, fi, bi) != 2 { << r }
    mut nld := 0
    mut ld_ii := -1
    mut nlt := 0
    mut lt_ii := -1
    mut nshr := 0
    mut shr_d := -1
    mut shr_s := -1
    mut nsub := 0
    mut sub_a := -1
    mut sub_b := -1
    mut nadd := 0
    mut add_d := -1
    mut add_a := -1
    mut add_b := -1
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == 14 {
            if !vec_elem8(types.mir_id(m, fi, ii)) { << vec_none() }
            nld += 1
            ld_ii = ii
        } else if k == 4 {
            op := types.mir_ib(m, fi, ii)
            lc := types.mir_ic(m, fi, ii)
            ld := types.mir_id(m, fi, ii)
            if op == 8 {
                nlt += 1
                lt_ii = ii
            } else if op == 18 {
                mut other := -1
                if vec_operand_is_one(m, fi, bi, ld) {
                    other = lc
                } else if vec_operand_is_one(m, fi, bi, lc) {
                    other = ld
                } else {
                    << vec_none()
                }
                nshr += 1
                shr_d = types.mir_ia(m, fi, ii)
                shr_s = other
            } else if op == 2 {
                nsub += 1
                sub_a = lc
                sub_b = ld
            } else if op == 1 {
                nadd += 1
                add_d = types.mir_ia(m, fi, ii)
                add_a = lc
                add_b = ld
            }
        } else if k != 1 && k != 2 && k != 3 && k != 17 && k != 26 {
            << vec_none()
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if nld != 1 || nlt != 1 || nshr != 1 || nsub != 1 || nadd != 1 { << r }
    mut sub_d := -1
    mut jj := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if jj < 0 { <- }
        if types.mir_ikind(m, fi, jj) == 4 && types.mir_ib(m, fi, jj) == 2 {
            sub_d = types.mir_ia(m, fi, jj)
        }
        jj = types.mir_inext(m, fi, jj)
    }
    if sub_d < 0 { << r }
    if !vec_same_val(m, fi, bi, shr_s, sub_d) { << r }
    mut lo_t := -1
    if vec_same_val(m, fi, bi, add_a, shr_d) {
        lo_t = add_b
    } else if vec_same_val(m, fi, bi, add_b, shr_d) {
        lo_t = add_a
    } else {
        << r
    }
    mut lo := vec_local_of_temp(m, fi, bi, lo_t)
    if lo < 0 {
        tr := vec_trace(m, fi, bi, lo_t)
        if tr >= types.mir_local_operand_base {
            lo = tr - types.mir_local_operand_base
        }
    }
    if lo < 0 { << r }
    ha := vec_local_of_temp(m, fi, bi, sub_a)
    hb := vec_local_of_temp(m, fi, bi, sub_b)
    mut hi := -1
    if ha == lo {
        hi = hb
    } else if hb == lo {
        hi = ha
    } else {
        << r
    }
    if hi < 0 || hi == lo { << r }
    mid_t := vec_trace(m, fi, bi, types.mir_ic(m, fi, ld_ii))
    mut mid := -1
    if mid_t >= types.mir_local_operand_base {
        mid = mid_t - types.mir_local_operand_base
    } else {
        mid = vec_local_of_temp(m, fi, bi, mid_t)
    }
    if mid < 0 { << r }
    tradd := vec_trace(m, fi, bi, add_d)
    mut add_to_mid := false
    if tradd == mid_t { add_to_mid = true }
    if tradd == types.mir_local_operand_base + mid { add_to_mid = true }
    if !add_to_mid {
        mut sj := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if sj < 0 { <- }
            if types.mir_ikind(m, fi, sj) == 3 && types.mir_ia(m, fi, sj) == mid {
                if vec_same_val(m, fi, bi, types.mir_ib(m, fi, sj), add_d) {
                    add_to_mid = true
                }
            }
            sj = types.mir_inext(m, fi, sj)
        }
    }
    if !add_to_mid { << r }
    lc := types.mir_ic(m, fi, lt_ii)
    ld := types.mir_id(m, fi, lt_ii)
    load_d := types.mir_ia(m, fi, ld_ii)
    mut v_t := -1
    if vec_same_val(m, fi, bi, lc, load_d) {
        v_t = ld
    } else if vec_same_val(m, fi, bi, ld, load_d) {
        v_t = lc
    } else {
        << r
    }
    mut vloc := vec_local_of_temp(m, fi, bi, v_t)
    if vloc < 0 {
        trv := vec_trace(m, fi, bi, v_t)
        if trv >= types.mir_local_operand_base {
            vloc = trv - types.mir_local_operand_base
        }
    }
    if vloc < 0 { << r }
    if types.mir_local_ty(m, fi, vloc) != 1 { << r }
    if load_d < 0 || load_d >= types.mir_ntemps(m, fi) { << r }
    if types.mir_temp_ty(m, fi, load_d) != 1 { << r }
    mut arr := vec_trace(m, fi, bi, types.mir_ib(m, fi, ld_ii))
    arr = vec_resolve_desc(m, fi, bi, arr)
    if arr < types.mir_local_operand_base {
        mut pj := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if pj < 0 { <- }
            pk := types.mir_ikind(m, fi, pj)
            if pk == 17 || pk == 26 {
                if vec_same_val(m, fi, bi, types.mir_ia(m, fi, pj), arr) {
                    arr = vec_trace(m, fi, bi, types.mir_ib(m, fi, pj))
                    arr = vec_resolve_desc(m, fi, bi, arr)
                    <-
                }
            }
            pj = types.mir_inext(m, fi, pj)
        }
    }
    if arr < types.mir_local_operand_base { << r }
    if emit_base_fixed_len(m, fi, arr) > 0 { << r }
    r.kind = 1
    r.ind = types.mir_local_operand_base + lo
    r.acc = types.mir_local_operand_base + hi
    r.arr = arr
    r.fac = types.mir_local_operand_base + vloc
    r.mask = mid
    r.limit_t = ld_ii
    << r
}

fn vec_bsearch_arm(m &types.Mir, fi int, bi int, mid int, lo int, hi int, want_inc int) bool {
    if types.mir_btkind(m, fi, bi) != 1 { << false }
    mut nst := 0
    mut ok := false
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == 3 {
            loc := types.mir_ia(m, fi, ii)
            st := types.mir_ib(m, fi, ii)
            if want_inc == 1 {
                if loc != lo { << false }
                mut jj := types.mir_bhead(m, fi, bi)
                for _ in 0:types.mir_nins(m, fi) {
                    if jj < 0 { <- }
                    if types.mir_ikind(m, fi, jj) == 4 && types.mir_ia(m, fi, jj) == st && types.mir_ib(m, fi, jj) == 1 {
                        lc := types.mir_ic(m, fi, jj)
                        ld := types.mir_id(m, fi, jj)
                        if vec_operand_is_one(m, fi, bi, ld) && vec_temp_from_local(m, fi, bi, lc, mid) {
                            ok = true
                        }
                        if vec_operand_is_one(m, fi, bi, lc) && vec_temp_from_local(m, fi, bi, ld, mid) {
                            ok = true
                        }
                    }
                    jj = types.mir_inext(m, fi, jj)
                }
            } else {
                if loc != hi { << false }
                if vec_temp_from_local(m, fi, bi, st, mid) {
                    ok = true
                }
                if st >= 0 {
                    mut jj := types.mir_bhead(m, fi, bi)
                    for _ in 0:types.mir_nins(m, fi) {
                        if jj < 0 { <- }
                        if types.mir_ikind(m, fi, jj) == 1 && types.mir_ia(m, fi, jj) == st {
                            if vec_temp_from_local(m, fi, bi, types.mir_ib(m, fi, jj), mid) {
                                ok = true
                            }
                        }
                        jj = types.mir_inext(m, fi, jj)
                    }
                }
            }
            nst += 1
        } else if k != 1 && k != 2 && k != 4 {
            << false
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if nst != 1 || !ok { << false }
    << true
}

// The emitted exit reloads the selected lo from its stable frame cell.
// Refuse an exit depending on a deleted Temp snapshot or on another Local
// written in the loop, even when it has the same abstract scalar role.
// Keep all original exit instructions; this only validates their inputs.
fn vec_bsearch_frame_exit(m &types.Mir, fi int, start int, lo int) bool {
    mut ready := []int{}
    for _ in 0:types.mir_ntemps(m, fi) { ready.push(0) }
    mut bi := start
    for _ in 0:16 {
        if bi < 0 || bi >= types.mir_nblocks(m, fi) { << false }
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            k := types.mir_ikind(m, fi, ii)
            dest := types.mir_ia(m, fi, ii)
            source := types.mir_ib(m, fi, ii)
            if k == 2 {
                if source != lo || dest < 0 || dest >= ready.len { << false }
                ready[dest] = 1
            } else if k == 1 {
                if source < 0 || source >= ready.len || ready[source] != 1 { << false }
                if dest < 0 || dest >= ready.len { << false }
                ready[dest] = 1
            } else if k != 0 { << false }
            ii = types.mir_inext(m, fi, ii)
        }
        tk := types.mir_btkind(m, fi, bi)
        value := types.mir_bta(m, fi, bi)
        if tk == 3 { << value >= 0 && value < ready.len && ready[value] == 1 }
        if tk != 1 { << false }
        bi = value
    }
    << false
}

// -1 rejects; 0 retains the actual mid check; 1 proves every mid in range.
// The reader grants no movement, deletion, register or NoTrap permission.
// This consumer requires its exact canonical state/Index points, private
// pure paths and a fresh frame-based exit before replacing those paths.
fn vec_bsearch_semantics(m &types.Mir, fi int, bi int, latch int, p &VecPat) int {
    plan := types.new_mir_latch_lower_bound_loop_plan(m, fi, bi, latch)
    if plan.reason != 0 || types.mir_loop_plan_kind(&plan) != 2 { << -1 }
    lo := p.ind - types.mir_local_operand_base
    hi := p.acc - types.mir_local_operand_base
    if types.mir_loop_plan_field(&plan, 6) != 1 || types.mir_loop_plan_field(&plan, 7) != lo { << -1 }
    if types.mir_loop_plan_field(&plan, 8) != 1 || types.mir_loop_plan_field(&plan, 9) != hi { << -1 }
    if types.mir_loop_plan_field(&plan, 41) != 1 || types.mir_loop_plan_field(&plan, 42) != lo { << -1 }
    if types.mir_loop_plan_field(&plan, 43) != 1 || types.mir_loop_plan_field(&plan, 44) != hi { << -1 }
    if types.mir_loop_plan_field(&plan, 11) != p.fac - types.mir_local_operand_base { << -1 }
    root := types.mir_loop_plan_field(&plan, 12)
    if root != p.arr - types.mir_local_operand_base || types.mir_loop_plan_field(&plan, 15) != p.limit_t { << -1 }
    if !vec_bsearch_frame_exit(m, fi, p.else_bb, lo) { << -1 }
    // Nonnegative literal lo and hi = this immutable slice's length.
    // On body entry lo < hi, hence 0 <= lo < hi <= length. Canonical
    // midpoint and updates preserve the invariant without signed overflow.
    if types.mir_loop_plan_field(&plan, 24) == 2 && types.mir_loop_plan_field(&plan, 25) >= 0 && types.mir_loop_plan_field(&plan, 27) == 3 {
        if types.mir_loop_plan_field(&plan, 28) == types.mir_loop_plan_field(&plan, 16) && types.mir_loop_plan_field(&plan, 31) == root { << 1 }
    }
    << 0
}

fn match_bsearch(m &types.Mir, fi int, bi int) VecPat {
    mut core := vec_bsearch_core(m, fi, bi)
    if core.kind == 0 { << vec_none() }
    lo := core.ind - types.mir_local_operand_base
    hi := core.acc - types.mir_local_operand_base
    mid := core.mask
    tb := vec_skip_empty(m, fi, types.mir_btb(m, fi, bi))
    tc := vec_skip_empty(m, fi, types.mir_btc(m, fi, bi))
    if tb < 0 || tc < 0 { << vec_none() }
    inc_tb := vec_bsearch_arm(m, fi, tb, mid, lo, hi, 1)
    set_tb := vec_bsearch_arm(m, fi, tb, mid, lo, hi, 0)
    inc_tc := vec_bsearch_arm(m, fi, tc, mid, lo, hi, 1)
    set_tc := vec_bsearch_arm(m, fi, tc, mid, lo, hi, 0)
    mut then_bb := -1
    mut else_bb := -1
    if inc_tb && set_tc {
        then_bb = tb
        else_bb = tc
    } else if inc_tc && set_tb {
        then_bb = tc
        else_bb = tb
    } else {
        << vec_none()
    }
    latch1 := vec_skip_empty(m, fi, types.mir_bta(m, fi, then_bb))
    latch2 := vec_skip_empty(m, fi, types.mir_bta(m, fi, else_bb))
    if latch1 < 0 || latch1 != latch2 { << vec_none() }
    if latch1 == bi { << vec_none() }
    if types.mir_btkind(m, fi, latch1) != 2 { << vec_none() }
    tbh := vec_edge_to(m, fi, types.mir_btb(m, fi, latch1), bi)
    tch := vec_edge_to(m, fi, types.mir_btc(m, fi, latch1), bi)
    mut exit_bb := -1
    if tbh && !tch {
        exit_bb = types.mir_btc(m, fi, latch1)
    } else if tch && !tbh {
        exit_bb = types.mir_btb(m, fi, latch1)
    } else {
        << vec_none()
    }
    core.else_bb = exit_bb
    core.limit = vec_bsearch_semantics(m, fi, bi, latch1, &core)
    if core.limit < 0 { << vec_none() }
    core.kind = 17
    << core
}

fn emit_bsearch_step(a &mut Assembler, checked bool) {
    a.sub(0, 1, 6)
    a.shr_imm(0, 0, 1)
    a.add(0, 6, 0)
    if checked {
        a.oob_need = 1
        a.cmp(0, 7)
        a.jae(a.oob_lbl + "")
    }
    a.load_scaled(2, 13, 0, 8)
    a.cmp(2, 12)
    a.vm_csel(1, 1, 0, 11)
    a.vm_csinc(6, 6, 0, 10)
}

fn emit_bsearch(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, pins &[]int, p VecPat) int {
    // Block counters are observable instrumentation outside the MIR plan.
    if a.cover { << 0 }
    lo := p.ind - types.mir_local_operand_base
    hi := p.acc - types.mir_local_operand_base
    vloc := p.fac - types.mir_local_operand_base
    if lo < 0 || lo >= fr.local_slot.len { << 0 }
    if hi < 0 || hi >= fr.local_slot.len { << 0 }
    if vloc < 0 || vloc >= fr.local_slot.len { << 0 }
    if p.else_bb < 0 { << 0 }
    if !is_frame_slot(fr.local_slot[lo]) || !is_frame_slot(fr.local_slot[hi]) || !is_frame_slot(fr.local_slot[vloc]) { << 0 }
    arr := p.arr - types.mir_local_operand_base
    if arr < 0 || arr >= fr.local_slot.len || !is_frame_slot(fr.local_slot[arr]) { << 0 }
    // Audit every frame interval, including descriptor words and unrelated
    // Temps. Fixed homes cannot substitute for the proven frame contract.
    if !select_pair_frame_cells_ok(fr, m, fi) { << 0 }
    a.load(6, 15, slot_off(fr.local_slot[lo]))
    a.load(1, 15, slot_off(fr.local_slot[hi]))
    a.load(12, 15, slot_off(fr.local_slot[vloc]))
    emit_index_desc_addr(a, m, fi, fr, p.arr)
    a.load(7, 0, -8)
    a.load(13, 0, 0)
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi)
    lp := pref + "_bs"
    dn := pref + "_bd"
    else_lbl := types.mir_fn_label(m, fi) + "_bb" + str(p.else_bb)
    a.cmp(6, 1)
    a.jge(dn + "")
    checked := pref + "_bc"
    if p.limit == 0 {
        // Version the loop without imposing new fault preconditions. Under
        // 0 <= lo < hi <= length, midpoint arithmetic and both updates keep
        // every Index in range. Other intervals retain checks at each mid.
        a.vm_cmp_imm(6, 0)
        a.jlt(checked + "")
        a.cmp(1, 7)
        a.jgt(checked + "")
    }
    a.label(lp + "")
    emit_bsearch_step(a, false)
    a.cmp(6, 1)
    a.jlt(lp + "")
    if p.limit == 0 {
        a.jmp(dn + "")
        a.label(checked + "")
        // A negative mid also fails the unsigned comparison. Wider initial
        // intervals alone do not fault; the empty path performs no Index.
        emit_bsearch_step(a, true)
        a.cmp(6, 1)
        a.jlt(checked + "")
    }
    a.label(dn + "")
    a.store(15, slot_off(fr.local_slot[lo]), 6)
    a.store(15, slot_off(fr.local_slot[hi]), 1)
    a.jmp(else_lbl + "")
    << 1
}
