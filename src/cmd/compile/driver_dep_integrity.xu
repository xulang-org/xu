@main

#os
#os/exec
#internal/dependency
#internal/modulepath
#path/filepath
#xu/types

// Dependency inputs remain data across the process boundary, including NUL.
fn require_arg(s &string) {
    for i in 0:s.len{
        if s[i] == 0 {
            eprintln("require: NUL in tool argument")
            <<< 1
        }
    }
}

fn require_module_path(s &string) {
    if modulepath.is_external(s) {
        raw := str_clone(s)
        if modulepath.valid_module(&raw) { << }
        eprintln("require: invalid external module path " + raw)
        <<< 1
    }
    if modulepath.valid_path(s) { << }
    eprintln("require: invalid module path " + s)
    <<< 1
}

// Validate before choosing a cache/vendor representation. An offline hit
// must not turn a malformed or source-free locator into an accepted one.
fn require_validate_locator(key &string, value &string) {
    if val_has_prefix(value, "file:") {
        if value.len > 5 { << }
    } else if val_has_prefix(value, "https://") || val_has_prefix(value, "http://") {
        xu_suf := ".xu"
        tar_suf := ".tar.gz"
        tgz_suf := ".tgz"
        if str_ends_with(value, &xu_suf) && !modulepath.is_external(key) { << }
        if str_ends_with(value, &tar_suf) || str_ends_with(value, &tgz_suf) { << }
    } else if val_has_prefix(value, "git:") {
        if value.len > 4 {
            rest := value[4:value.len]
            if rest[0] != 45 && !val_has_prefix(&rest, "ext:") { << }
        }
    }
    version := require_version(value)
    if version.len > 0 && modulepath.is_external(key) {
        raw := version[1:version.len]
        if modulepath.version_matches(key, &raw) { << }
    }
    eprintln("require '" + key + "': invalid locator or missing source identity: " + value + "; use file:path or git:URL@ref")
    <<< 1
}

fn require_source_key(mod_id &string, locator &string) string {
    << dependency.source_key(mod_id, locator)
}

fn require_cache_root(mod_id &string, locator &string) string {
    cache := xu_pkg_cache_dir()
    key := require_source_key(mod_id, locator)
    << path_join(&cache, &key)
}

fn require_no_link(p &string) {
    link := os.readlink(str_clone(p)) or(err) { << }
    eprintln("require: symlink is not allowed in dependency content: " + p + " -> " + link)
    <<< 1
}

fn require_readlink(p &string) string {
    << os.readlink(str_clone(p)) or(err) { << ""}
}

fn require_tree_hash(root &string) string {
    << dependency.tree_hash(root) or (err) {
        eprintln(err.msg())
        <<< 1
    }
}

fn require_hex(s &string) bool {
    if s.len != 64 { << false}
    for i in 0:s.len{
        b := s[i]
        if !(b >= 48 && b <= 57) && !(b >= 97 && b <= 102) { << false}
    }
    << true
}

fn require_lock_fields(s string)[]string {
    mut out :=[]string {}
    mut start := 0
    for i in 0:s.len{
        if s[i] == 32 {
            if i > start{out.push(s[start:i])}
            start = i + 1
        }
    }
    if start < s.len{out.push(s[start:s.len])}
    << out
}

fn require_lock_lines(project &string)[]string {
    nm := "xu.lock"
    p := path_join(project, &nm)
    mut out :=[]string {}
    if !path_exists(&p) { << out}
    require_no_link(&p)
    body := read_file(str_clone(&p)) or(err) {eprintln("require: cannot read xu.lock")
        <<< 1}
    lines := split_lines(body)
    if lines.len == 0 {eprintln("require: invalid xu.lock")
        <<< 1}
    v3 := lines[0] == "xu-lock-v3 sha256-tree-v1"
    if !v3 && lines[0] != "xu-lock-v2 sha256-tree-v1" {
        eprintln("require: unsupported xu.lock; review sources, remove legacy lock and reinstall (see docs/DEPENDENCIES.md)")
        <<< 1
    }
    mut seen := types.new_strmap()
    for i in 1:lines.len{
        fields := require_lock_fields(lines[i])
        if (!v3 && fields.len != 4) || (v3 && fields.len != 5) {eprintln("require: malformed xu.lock entry")
            <<< 1}
        key := fields[0]
        source := fields[1]
        content := fields[2]
        vendor := fields[3]
        require_module_path(&key)
        if !require_hex(&source) || !require_hex(&content) ||(vendor != "-" && !require_hex(&vendor)) {
            eprintln("require: malformed xu.lock checksum")
            <<< 1
        }
        mut norm := import_id_norm(&key)
        if v3 {
            version := fields[4]
            if version != "-" {
                require_validate_locator(&key, &version)
                if require_version(&version) != version || source != require_source_key(&key, &version) { eprintln("require: malformed version lock identity")
                    <<< 1 }
                norm = norm + "@" + version
            }
        }
        if seen.lookup(&norm) >= 0 {eprintln("require: duplicate xu.lock entry")
            <<< 1}
        seen.put(norm, 1)
        out.push(lines[i])
    }
    << out
}

fn require_lock_entry(project &string, key &string, locator &string)[]string {
    lines := require_lock_lines(project)
    source := require_source_key(key, locator)
    for i in 0:lines.len{
        fields := require_lock_fields(lines[i])
        field_key := fields[0]
        if str_eq(&field_key, key) {
            wanted := require_version(locator)
            mut locked := ""
            if fields.len == 5 && fields[4] != "-" { locked = fields[4] + "" }
            if wanted != locked { -> }
            if fields[1] != source{eprintln("require '" + key + "': xu.lock source mismatch")
                <<< 1}
            << fields
        }
    }
    mut empty :=[]string {}
    << empty
}

fn require_lock_write(project &string, key &string, locator &string, content string, vendor string) {
    if require_frozen() {
        eprintln("require: frozen build cannot write xu.lock")
        <<< 1
    }
    lock_path := project + "/.xu-lock.lck"
    mut guard := require_guard(&lock_path, false)
    // Re-read after acquiring the lock; a concurrent project may already
    // have authenticated this version. Never replace a different digest.
    prior := require_lock_entry(project, key, locator)
    mut actual_vendor := vendor + ""
    if prior.len > 0 {
        if prior[2] != content { eprintln("require: concurrent xu.lock checksum mismatch")
            <<< 1 }
        if vendor == "-" { actual_vendor = prior[3] + "" }
    }
    lines := require_lock_lines(project)
    version := require_version(locator)
    mut v3 := version.len > 0
    for i in 0:lines.len { if require_lock_fields(lines[i]).len == 5 { v3 = true } }
    mut entries := []string{}
    for i in 0:lines.len {
        fields := require_lock_fields(lines[i])
        field_key := fields[0]
        mut locked_version := ""
        if fields.len == 5 && fields[4] != "-" { locked_version = fields[4] + "" }
        if str_eq(&field_key, key) && locked_version == version { -> }
        mut row := lines[i] + ""
        if v3 && fields.len == 4 { row = row + " -" }
        entries.push(row)
    }
    source := require_source_key(key, locator)
    mut row := key + " " + source + " " + content + " " + actual_vendor
    if v3 {
        mut token := "-"
        if version.len > 0 { token = version + "" }
        row = row + " " + token
    }
    entries.push(row)
    sorted := sort_names(entries)
    mut body := "xu-lock-v2 sha256-tree-v1\n"
    if v3 { body = "xu-lock-v3 sha256-tree-v1\n" }
    for i in 0:sorted.len { body = body + sorted[i] + "\n" }
    p := project + "/xu.lock"
    lock_tmp := p + ".partial." + str(os.getpid()) + "." + str(now_ns())
    write_file(lock_tmp + "", body) or (err) { eprintln("require: cannot write xu.lock")
        <<< 1 }
    os.rename(lock_tmp, p) or (err) { eprintln("require: cannot publish xu.lock")
        <<< 1 }
    guard.close() or (err) { eprintln(err.msg())
        <<< 1 }
}

fn require_verify_cache(project &string, key &string, locator &string, root &string) {
    entry := require_lock_entry(project, key, locator)
    actual := require_tree_hash(root)
    nm := ".ok"
    stamp := path_join(root, &nm)
    expected := read_file(stamp) or(err) {eprintln("require: incomplete cache")
        <<< 1}
    if expected != actual{eprintln("require '" + key + "': cache checksum mismatch")
        <<< 1}
    require_authenticate_version(key, locator, &actual)
    if entry.len > 0 {
        if entry[2] != actual{eprintln("require '" + key + "': xu.lock checksum mismatch")
            <<< 1}
    } else {
        if require_frozen() {
            eprintln("require '" + key + "': frozen build requires an existing xu.lock entry")
            <<< 1
        }
        require_lock_write(project, key, locator, actual, "-")
    }
}

fn require_vendor_path(vdir &string, key &string) string {
    slash := mod_id_to_slash(key)
    d := path_join(vdir, &slash)
    if dir_readable(&d) == 1 { << d}
    f := slash + ".xu"
    << path_join(vdir, &f)
}

fn require_verify_vendor(project &string, key &string, locator &string, vdir &string) {
    require_no_link(vdir)
    slash := mod_id_to_slash(key)
    for i in 0:slash.len {
        if slash[i] == 47 {
            prefix := slash[0:i]
            parent := path_join(vdir, &prefix)
            require_no_link(&parent)
        }
    }
    entry := require_lock_entry(project, key, locator)
    if entry.len == 0 {eprintln("require '" + key + "': vendor needs xu.lock; run xu install")
        <<< 1}
    p := require_vendor_path(vdir, key)
    actual := require_tree_hash(&p)
    if entry[3] != actual{eprintln("require '" + key + "': vendor checksum mismatch")
        <<< 1}
    require_authenticate_version(key, locator, &actual)
}

// Resolve each symlink before consuming '..'. Lexical clean alone can grant
// a standard-library exemption to a child link which escapes the root.
fn require_real_path(p &string) string {
    mut pending := filepath.to_slash(p)
    if !filepath.is_abs(&pending) {pending = cwd() + "/" + pending}
    mut done := ""
    mut links := 0
    mut start := 0
    if pending.len >= 2 && pending[1] == 58 {done = pending[0:2]
        start = 2}
    while start < pending.len{
        if pending[start] == 47 {
            if done.len == 0 {done = "/"}
            start = start + 1
            ->
        }
        mut end := start
        while end < pending.len && pending[end] != 47 {end = end + 1}
        part := pending[start:end]
        start = end
        if part == "." { -> }
        if part == ".." {done = path_dirname(&done)
            -> }
        next := path_join(&done, &part)
        link := require_readlink(&next)
        if link.len > 0 {
            links = links + 1
            if links > 40 {eprintln("require: too many path symlinks")
                <<< 1}
            rest := pending[start:pending.len]
            if filepath.is_abs(&link) {pending = link + rest
                done = ""}
            else {pending = path_join(&done, &link) + rest
                done = ""}
            start = 0
            if pending.len >= 2 && pending[1] == 58 {done = pending[0:2]
                start = 2}
        } else {done = next}
    }
    << done
}

fn require_stdlib_root() string {
    explicit := env_get("XU_STDLIB_ROOT")
    if explicit.len > 0 { << require_real_path(&explicit)}
    xuroot := env_get("XU_ROOT")
    if xuroot.len > 0 {
        xstd := xuroot + "/src"
        if dir_readable(&xstd) == 1 { << require_real_path(&xstd)}
    }
    argv := os.argv()
    if argv.len > 0 {
        exe := cli_arg_owned(&argv, 0)
        resolved := exec.look_path(exe) or(err) { << ""}
        actual := require_real_path(&resolved)
        bindir := path_dirname(&actual)
        // Standalone downloads keep their updated SDK beside the binary.
        adjacent := bindir + "/src"
        if dir_readable(&adjacent) == 1 { << require_real_path(&adjacent)}
        base := path_basename(&bindir)
        if base == "bin" {
            parent := path_dirname(&bindir)
            src := parent + "/src"
            if dir_readable(&src) == 1 { << require_real_path(&src)}
        }
        platform_dir := path_dirname(&bindir)
        platform_base := path_basename(&platform_dir)
        if platform_base == "platform" {
            bin_dir := path_dirname(&platform_dir)
            bin_base := path_basename(&bin_dir)
            if bin_base == "bin" {
                parent := path_dirname(&bin_dir)
                src := parent + "/src"
                if dir_readable(&src) == 1 { << require_real_path(&src)}
            }
        }
    }
    h := os.home_dir()
    if h.len > 0 {
        default_std := h + "/.xu/src"
        if dir_readable(&default_std) == 1 { << require_real_path(&default_std)}
    }
    << ""
}

fn require_mapping_index(keys &[]string, imp &string) int {
    mut selected := - 1
    mut longest := 0
    for i in 0:keys.len{
        key := keys[i]
        mut one :=[]string {}
        one.push(str_clone(&key))
        if require_covers(&one, imp) && key.len > longest{selected = i
            longest = key.len}
    }
    << selected
}

fn require_external_root(project &string, key &string, locator &string) string {
    vdir := project + "/vendor"
    if vendor_has_pkg(&vdir, key) {
        root := require_vendor_path(&vdir, key)
        require_check_version(&root, key, locator)
        << root
    }
    if val_has_prefix(locator, "file:") {
        tail := locator[5:locator.len]
        if filepath.is_abs(&tail) { << tail + "" }
        << path_join(project, &tail)
    }
    << require_cache_root(key, locator)
}

fn require_check_external_root(root &string, key &string) {
    require_dir_xu_xun(str_clone(root))
    check_xu_xun(str_clone(root), str_clone(key))
}

fn require_has_source(dir &string) bool {
    names := os.listdir(str_clone(dir)) or (err) { << false }
    entries := split_lines(names)
    suf := ".xu"
    for i in 0:entries.len {
        name := entries[i]
        if name.len > 0 && name[0] != 46 && str_ends_with(&name, &suf) { << true }
    }
    << false
}

// Resolve from declared module roots; ambient search roots do not provide
// canonical packages. Two modules physically providing the same package fail.
fn require_external_provider(project &string, imp &string, keys &[]string, vals &[]string) int {
    mut found := -1
    for i in 0:keys.len {
        key := keys[i]
        mut one := []string{}
        one.push(str_clone(&key))
        if !require_covers(&one, imp) { -> }
        locator := vals[i]
        root := require_external_root(project, &key, &locator)
        require_check_external_root(&root, &key)
        mut dir := str_clone(&root)
        if imp.len > key.len {
            sub := imp[key.len + 1:imp.len]
            dir = path_join(&root, &sub)
        }
        if !require_has_source(&dir) { -> }
        if found >= 0 {
            eprintln("require: ambiguous external package " + imp + " is provided by multiple modules")
            <<< 1
        }
        found = i
    }
    if found < 0 {
        eprintln("require: external package " + imp + " not found in declared module roots")
        <<< 1
    }
    << found
}

fn require_external_package(project &string, imp &string) string {
    mut keys := []string{}
    mut vals := []string{}
    collect_require_entries(project, mut &keys, mut &vals)
    selected := require_external_provider(project, imp, &keys, &vals)
    key := keys[selected]
    locator := vals[selected]
    root := require_external_root(project, &key, &locator)
    if imp.len == key.len { << root }
    sub := imp[key.len + 1:imp.len]
    << path_join(&root, &sub)
}

fn require_location_allowed(imp &string, loc &string, project &string) bool {
    if modulepath.is_external(imp) {
        dir := require_external_package(project, imp)
        expected := require_real_path(&dir)
        actual := require_real_path(loc)
        << path_is_under(&actual, &expected)
    }
    mut keys := []string{}
    mut vals := []string{}
    collect_require_entries(project, mut &keys, mut &vals)
    selected := require_mapping_index(&keys, imp)
    if selected < 0 { << false }
    key := keys[selected]
    locator := vals[selected]
    vdir := project + "/vendor"
    vp := require_vendor_path(&vdir, &key)
    actual := require_real_path(loc)
    if vendor_has_pkg(&vdir, &key) {
        expected := require_real_path(&vp)
        << path_is_under(&actual, &expected)
    }
    mut root := ""
    if val_has_prefix(&locator, "file:") {
        tail := locator[5:locator.len]
        root = str_clone(&tail)
        if !filepath.is_abs(&tail) {root = path_join(project, &tail)}
    } else {root = require_cache_root(&key, &locator)}
    expected := require_real_path(&root)
    << path_is_under(&actual, &expected)
}

// A locked source manifest cannot refer to native bytes outside its digest.
// A single-file vendor entry does not authenticate its parent's manifest.
fn require_native_boundary(project &string, owner &string, manifest_dir &string, native_path &string) {
    if owner.len == 0 { << }
    mut keys := []string{}
    mut vals := []string{}
    collect_require_entries(project, mut &keys, mut &vals)
    mut selected := require_mapping_index(&keys, owner)
    if modulepath.is_external(owner) { selected = require_external_provider(project, owner, &keys, &vals) }
    if selected >= 0 {
        key := keys[selected]
        locator := vals[selected]
        if val_has_prefix(&locator, "file:") && !require_frozen() { << }
        mut root := require_cache_root(&key, &locator)
        vdir := project + "/vendor"
        if vendor_has_pkg(&vdir, &key) { root = require_vendor_path(&vdir, &key) }
        expected := require_real_path(&root)
        manifest := manifest_dir + "/xu.xun"
        if !path_exists(&manifest) { << }
        actual_manifest := require_real_path(&manifest)
        if !path_is_under(&actual_manifest, &expected) {
            eprintln("require '" + key + "': manifest is outside authenticated dependency content")
            <<< 1
        }
        if native_path.len == 0 { << }
        actual := require_real_path(native_path)
        excluded := expected + "/.git"
        if !path_is_under(&actual, &expected) || path_is_under(&actual, &excluded) {
            eprintln("require '" + key + "': native file is outside authenticated dependency content")
            <<< 1
        }
        <<
    }
}
