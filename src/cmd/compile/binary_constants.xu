@main

// PE/ELF layout defaults and format identifiers. Layout policies are shared
// by static, dynamic and debug writers. PE section alignment is independent
// of the ARM64 ADRP hardware page size, even when both currently equal 4096.
// Header sizes and machine/flag identifiers must match the file-format ABI.
const PE_IMAGE_BASE = 5368709120
const COFF_MACHINE_AMD64 = 34404
const COFF_MACHINE_ARM64 = 43620
const PE_FILE_ALIGNMENT = 512
const PE_SECTION_ALIGNMENT = 4096
const PE_MIN_HEADER_BYTES = 1024
const PE_DOS_HEADER_BYTES = 64
const PE_SIGNATURE_BYTES = 4
const PE_COFF_HEADER_BYTES = 20
const PE64_OPTIONAL_HEADER_BYTES = 240
const PE_SECTION_HEADER_BYTES = 40
const PE_STACK_RESERVE_BYTES = 16777216
const PE_STACK_COMMIT_BYTES = 4194304
const PE_HEAP_RESERVE_BYTES = 1048576
const PE_HEAP_COMMIT_BYTES = 4096
const PE_CONSOLE_SUBSYSTEM = 3
const PE_DLL_CHARACTERISTICS = 33120
const PE_SECTION_CODE_FLAGS = 1610612768
const PE_SECTION_RW_FLAGS = 3221225536
const PE_SECTION_RO_FLAGS = 1073741888
const PE_DATA_DIRECTORY_COUNT = 16
const ELF_IMAGE_BASE = 4194304
const ELF_RISCV_VIRT_CODE_BASE = 2147483648
const ELF_LOAD_PAGE_BYTES = 4096
const ELF_DATA_MEM_PADDING_BYTES = 65536
const ELF_MACHINE_X64 = 62
const ELF_MACHINE_ARM64 = 183
const ELF_MACHINE_LOONG = 258
const ELF_MACHINE_RISCV = 243
const ELF_MACHINE_XTENSA = 94
const ELF_MACHINE_ARM32 = 40
const ELF_ARM_EABI_FLAGS = 83886080
const ELF32_LINUX_ARM_CODE_BASE = 65536
const ELF32_MPS2_DATA_BASE = 536870912
const ELF32_MPS2_VECTOR_BYTES = 192
const ELF32_MPS2_STACK_TOP = 536903680
const ELF32_RISCV_VIRT_DATA_BASE = 2164260864
const ELF32_RISCV_VIRT_STACK_TOP = 2281701376
// ESP32 code lives in the IROM window (0x400D0000-0x403FFFFF), which the
// bootloader maps from flash and executes in place.  The 128 KB IRAM window
// (0x40080000-0x4009FFFF) is only used for vectors and hot code, so a bulk
// application cannot be linked there.
const ELF32_ESP32_CODE_BASE = 1074593824 // 0x400D0020 (IROM, flash-mapped code)
const ELF32_ESP32_IRAM_CODE_BASE = 1074266112 // 0x40080000 (IRAM-only region)
const ELF32_ESP32_IRAM_BYTES = 131072 // end 0x400A0000; higher IRAM aliases ROM DRAM
const ELF32_ESP32_DATA_BASE = 1073479680 // 0x3FFC0000 (above mask-ROM BTDM BSS)
const ELF32_ESP32_STACK_TOP = 1073610752 // 0x3FFE0000 (DRAM stack top)
