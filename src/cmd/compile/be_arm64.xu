@main
// ARM64 / multi-arch backend for Gen1 (M12 + E7 Thumb).
//
// be_* methods take virtual registers and dispatch on a.arch
// (0=arm64, 1=x64, 2=thumb). String params are consumed in exactly one
// branch (if/else) to satisfy M2b linear rules.

// ===== Virtual registers (mirror Rust VReg) =====
//   0..7   V0..V7   general-purpose temporaries
//   8..13  S0..S5   callee-saved
//   14     Ret      << value (X0 / RAX)
//   15     Fp       frame pointer (X29 / RBP / r7)
//   16     Sp       stack pointer
//   17     Lr       link register (X30; unused on x64)
//   18..23 A0..A5   argument registers

// ===== Condition codes (mirror xuasm Cond) =====
//   EQ=0 NE=1 HS=2 LO=3 VS=6 HI=8 LS=9 GE=10 LT=11 GT=12 LE=13

fn map_reg(v int) int {
    if v <= 7 { << v + 8 }
    if v <= 13 { << v + 11 }
    if v == 14 { << 0 }
    if v == 15 { << 29 }
    if v == 16 { << 31 }
    if v == 17 { << 30 }
    << v - 18
}

fn arg_reg(n int) int { << 18 + n }

// M147: FP offset to first caller-spilled arg (matches xubackend::stack_arg_base).
fn stack_arg_base(arch int, cs_pairs int) int {
    if arch == 2 {
        n := thumb_cs_count(thumb_cs_effective(cs_pairs))
        << 8 + 4 * n
    }
    if arch == 3 { << 40 } // rv32: fp/ra/s3/s4/s5
    if arch == 0 { << 16 + 16 * cs_pairs } // arm64: FP/LR + CS pairs
    if arch == 1 { << x64_stack_arg_base(cs_pairs) }
    // Hosted 64-bit (loong/rv64): S0–S5 (48) below FP/LR or RBP link (16) → 64.
    << 64
}

fn stack_spill_bytes(n_stack int) int {
    if n_stack <= 0 { << 0 }
    raw := n_stack * 8
    << ((raw + 15) / 16) * 16
}
