@main

#xu/types

// Clang-style hosted ALU isel (arm64/x64): ror32 xor-tree, bic, mvn.
// Mirrors bootstrap xuemit try_ror32_or_fuse / try_bic32 / try_mvn32.
// Method names go through vm_* so they do not recurse into assembler encoders.

struct ISelLane {
    kind int
    n    int
    dest int
    tail int
}

fn mir_shift32(m &types.Mir, fi int, v int) int {
    if v >= 0 {
        << -1
    }
    c := types.mir_const_at(m, fi, -v - 2)
    if c < 1 || c > 31 {
        << -1
    }
    << c
}

fn mir_temp_load_local(m &types.Mir, fi int, t int) int {
    if t < 0 {
        << -1
    }
    for i in 0:types.mir_nins(m, fi) {
        if types.mir_ikind(m, fi, i) == types.MI_LOAD_LOCAL && types.mir_ia(m, fi, i) == t {
            << types.mir_ib(m, fi, i)
        }
    }
    << -1
}

fn mir_is_m32(m &types.Mir, fi int, v int) bool {
    if v >= 0 {
        << false
    }
    if types.mir_const_at(m, fi, -v - 2) == 4294967295 {
        << true
    }
    << false
}

fn isel_temps_xor(c int, d int, a int, b int) bool {
    if (c == a && d == b) || (c == b && d == a) {
        << true
    }
    << false
}

fn isel_and_m32(m &types.Mir, fi int, ii int, t int) bool {
    if ii < 0 {
        << false
    }
    if types.mir_ikind(m, fi, ii) != types.MI_BIN || types.mir_ib(m, fi, ii) != 14 {
        << false
    }
    c := types.mir_ic(m, fi, ii)
    d := types.mir_id(m, fi, ii)
    if c == t && mir_is_m32(m, fi, d) {
        << true
    }
    if d == t && mir_is_m32(m, fi, c) {
        << true
    }
    << false
}

fn isel_skip_count(m &types.Mir, fi int, from int, last int) int {
    mut n := 0
    mut p := from
    for _ in 0:types.mir_nins(m, fi) {
        if p < 0 {
            << n
        }
        n += 1
        if p == last {
            << n
        }
        p = types.mir_inext(m, fi, p)
    }
    << n
}

fn isel_instr_dest(m &types.Mir, fi int, ii int) int {
    ik := types.mir_ikind(m, fi, ii)
    if ik == types.MI_COPY || ik == types.MI_LOAD_LOCAL || ik == types.MI_BIN || ik == types.MI_UN {
        << types.mir_ia(m, fi, ii)
    }
    << -1
}

fn isel_mid_live(m &types.Mir, fi int, from int, last int, after int, keep int) bool {
    mut p := from
    for _ in 0:types.mir_nins(m, fi) {
        if p < 0 {
            << false
        }
        d := isel_instr_dest(m, fi, p)
        if d >= 0 && d != keep {
            if mir_temp_uses_from(m, fi, d, after) != 0 {
                << true
            }
        }
        if p == last {
            << false
        }
        p = types.mir_inext(m, fi, p)
    }
    << false
}

fn isel_lane_fail() ISelLane {
    << ISelLane{kind: -1, n: 0, dest: 0, tail: -1}
}

// Extra xor operand of the same 32-bit source: ror32 or `(>> n) & m32`.
fn isel_lane_term(m &types.Mir, fi int, pos int, src_temp int, src_local int) ISelLane {
    fail := isel_lane_fail()
    if pos < 0 {
        << fail
    }
    mut i := pos
    mut lhs := src_temp
    if types.mir_ikind(m, fi, i) == types.MI_LOAD_LOCAL && src_local >= 0 && types.mir_ib(m, fi, i) == src_local {
        lhs = types.mir_ia(m, fi, i)
        i = types.mir_inext(m, fi, i)
        if i < 0 {
            << fail
        }
    }
    if types.mir_ikind(m, fi, i) != types.MI_BIN {
        << fail
    }
    op := types.mir_ib(m, fi, i)
    if op != 17 && op != 18 {
        << fail
    }
    if types.mir_ic(m, fi, i) != lhs {
        << fail
    }
    n1 := mir_shift32(m, fi, types.mir_id(m, fi, i))
    if n1 < 0 {
        << fail
    }
    t1 := types.mir_ia(m, fi, i)
    mut j := types.mir_inext(m, fi, i)
    mut lhs2 := lhs
    if j >= 0 && types.mir_ikind(m, fi, j) == types.MI_LOAD_LOCAL && src_local >= 0 && types.mir_ib(m, fi, j) == src_local {
        lhs2 = types.mir_ia(m, fi, j)
        j = types.mir_inext(m, fi, j)
    }
    if j >= 0 && types.mir_ikind(m, fi, j) == types.MI_BIN {
        op2 := types.mir_ib(m, fi, j)
        mut other := 17
        if op == 17 {
            other = 18
        }
        if op2 == other && types.mir_ic(m, fi, j) == lhs2 {
            n2 := mir_shift32(m, fi, types.mir_id(m, fi, j))
            if n1 + n2 == 32 {
                t2 := types.mir_ia(m, fi, j)
                k := types.mir_inext(m, fi, j)
                if k >= 0 && types.mir_ikind(m, fi, k) == types.MI_BIN && types.mir_ib(m, fi, k) == 15 {
                    oc := types.mir_ic(m, fi, k)
                    od := types.mir_id(m, fi, k)
                    if (oc == t1 && od == t2) || (oc == t2 && od == t1) {
                        mut ror_n := n2
                        if op == 18 {
                            ror_n = n1
                        }
                        << ISelLane{kind: 0, n: ror_n, dest: types.mir_ia(m, fi, k), tail: k}
                    }
                }
            }
        }
    }
    if op == 18 {
        nxt := types.mir_inext(m, fi, i)
        if isel_and_m32(m, fi, nxt, t1) {
            << ISelLane{kind: 1, n: n1, dest: types.mir_ia(m, fi, nxt), tail: nxt}
        }
    }
    << fail
}

fn emit_ror32_fire(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int, ror_n int, final_dest int, last_ii int, nextra int, e0 int, e1 int, e2 int, e3 int) {
    pos := types.mir_inext(m, fi, last_ii)
    dest_pin := rc_coalesce_store_pin(&*a, m, fi, fr, final_dest, pos)
    mut dest_r := 0
    mut coalesced := 0
    if dest_pin >= 0 {
        dest_r = dest_pin
        coalesced = 1
    } else {
        dest_r = rc_pick_alu(&*a)
        rc_clobber(a, dest_r)
    }
    src_r := rc_load_reg(a, m, fi, fr, types.mir_ic(m, fi, ii), rc_scratch_avoid(dest_r))
    if nextra > 0 && dest_r == src_r {
        dest_r = rc_scratch_avoid(src_r)
        rc_clobber(a, dest_r)
        coalesced = 0
    }
    a.vm_ror_imm32(dest_r, src_r, ror_n)
    for i in 0:nextra {
        mut packed := e0
        if i == 1 {
            packed = e1
        }
        if i == 2 {
            packed = e2
        }
        if i == 3 {
            packed = e3
        }
        kind := packed / 32
        n := packed - kind * 32
        if kind == 0 {
            a.vm_eor_ror32(dest_r, dest_r, src_r, n)
        } else {
            a.vm_eor_lsr32(dest_r, dest_r, src_r, n)
        }
    }
    emit_wrap_at(a, dest_r, types.mir_temp_ty(m, fi, final_dest))
    rc_commit_alu(a, m, fi, fr, final_dest, dest_r, coalesced, pos)
    nxt := types.mir_inext(m, fi, ii)
    if nxt >= 0 {
        a.rc_fp_skip_n = isel_skip_count(m, fi, nxt, last_ii)
    }
    <<
}

// Clang instcombine: `(x >> n) | (x << (32-n))` → ror32, then xor-tree
// `eor … ror/lsr`. MIR emits LoadLocal per ident: shr; load; shl; or.
fn emit_ror32_or(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) bool {
    if a.arch != 0 && a.arch != 1 {
        << false
    }
    op := types.mir_ib(m, fi, ii)
    if op != 17 && op != 18 {
        << false
    }
    n1 := mir_shift32(m, fi, types.mir_id(m, fi, ii))
    if n1 < 0 {
        << false
    }
    mut ni := types.mir_inext(m, fi, ii)
    if ni < 0 {
        << false
    }
    mut load_ii := -1
    mut t_reload := -1
    if types.mir_ikind(m, fi, ni) == types.MI_LOAD_LOCAL {
        l1 := mir_temp_load_local(m, fi, types.mir_ic(m, fi, ii))
        if l1 < 0 || l1 != types.mir_ib(m, fi, ni) {
            << false
        }
        load_ii = ni
        t_reload = types.mir_ia(m, fi, ni)
        ni = types.mir_inext(m, fi, ni)
        if ni < 0 {
            << false
        }
    }
    if types.mir_ikind(m, fi, ni) != types.MI_BIN {
        << false
    }
    op2 := types.mir_ib(m, fi, ni)
    if op == 18 {
        if op2 != 17 {
            << false
        }
    } else {
        if op2 != 18 {
            << false
        }
    }
    if load_ii >= 0 {
        if types.mir_ic(m, fi, ni) != t_reload {
            << false
        }
    } else {
        if types.mir_ic(m, fi, ni) != types.mir_ic(m, fi, ii) {
            << false
        }
    }
    n2 := mir_shift32(m, fi, types.mir_id(m, fi, ni))
    if n2 < 0 || n1 + n2 != 32 {
        << false
    }
    mut ror_n := n2
    if op == 18 {
        ror_n = n1
    }
    << emit_ror32_or_tail(a, m, fi, fr, ii, ror_n, ni, load_ii)
}

fn emit_ror32_or_tail(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int, ror_n int, ni int, load_ii int) bool {
    mut t_reload := -1
    if load_ii >= 0 {
        t_reload = types.mir_ia(m, fi, load_ii)
    }
    t1 := types.mir_ia(m, fi, ii)
    t2 := types.mir_ia(m, fi, ni)
    nni := types.mir_inext(m, fi, ni)
    if nni < 0 || types.mir_ikind(m, fi, nni) != types.MI_BIN || types.mir_ib(m, fi, nni) != 15 {
        << false
    }
    oc := types.mir_ic(m, fi, nni)
    od := types.mir_id(m, fi, nni)
    if !((oc == t1 && od == t2) || (oc == t2 && od == t1)) {
        << false
    }
    t3 := types.mir_ia(m, fi, nni)
    or_next := types.mir_inext(m, fi, nni)
    if mir_temp_uses_from(m, fi, t1, or_next) != 0 {
        << false
    }
    if mir_temp_uses_from(m, fi, t2, or_next) != 0 {
        << false
    }
    if load_ii >= 0 {
        if mir_temp_uses_from(m, fi, t_reload, nni) != 0 {
            << false
        }
    }
    src_temp := types.mir_ic(m, fi, ii)
    if a.rc_ror32_facts.len == 0 { << false }
    bi := a.rc_cur_bi
    if !isel_ror32_low_source(&a.rc_ror32_facts, m, fi, bi, ii, src_temp) { << false }
    if !isel_ror32_truncated(&a.rc_ror32_facts, m, fi, bi, t3) { << false }
    src_local := mir_temp_load_local(m, fi, src_temp)
    mut pos := or_next
    mut accum := t3
    mut nextra := 0
    mut last_ii := nni
    mut e0 := 0
    mut e1 := 0
    mut e2 := 0
    mut e3 := 0
    for _ in 0:4 {
        lane := isel_lane_term(m, fi, pos, src_temp, src_local)
        if lane.kind < 0 {
            <-
        }
        xi := types.mir_inext(m, fi, lane.tail)
        if xi < 0 {
            <-
        }
        if types.mir_ikind(m, fi, xi) != types.MI_BIN || types.mir_ib(m, fi, xi) != 16 {
            <-
        }
        if !isel_temps_xor(types.mir_ic(m, fi, xi), types.mir_id(m, fi, xi), accum, lane.dest) {
            <-
        }
        packed := lane.kind * 32 + lane.n
        if nextra == 0 {
            e0 = packed
        }
        if nextra == 1 {
            e1 = packed
        }
        if nextra == 2 {
            e2 = packed
        }
        if nextra == 3 {
            e3 = packed
        }
        nextra += 1
        accum = types.mir_ia(m, fi, xi)
        last_ii = xi
        pos = types.mir_inext(m, fi, xi)
    }
    mut final_dest := accum
    if isel_and_m32(m, fi, pos, accum) {
        final_dest = types.mir_ia(m, fi, pos)
        last_ii = pos
        pos = types.mir_inext(m, fi, pos)
    }
    if isel_mid_live(m, fi, types.mir_inext(m, fi, ii), last_ii, pos, final_dest) {
        nextra = 0
        last_ii = nni
        pos = or_next
        final_dest = t3
        if isel_and_m32(m, fi, pos, t3) {
            an := types.mir_inext(m, fi, pos)
            if mir_temp_uses_from(m, fi, t3, an) == 0 {
                final_dest = types.mir_ia(m, fi, pos)
                last_ii = pos
                pos = an
            }
        }
    }
    emit_ror32_fire(a, m, fi, fr, ii, ror_n, final_dest, last_ii, nextra, e0, e1, e2, e3)
    << true
}

// Clang bic: `(x ^ 0xFFFFFFFF) & y` → dest = y & ~x (32-bit lane).
fn emit_clang_bic(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) bool {
    if a.arch != 0 && a.arch != 1 {
        << false
    }
    if types.mir_ib(m, fi, ii) != 16 {
        << false
    }
    t_not := types.mir_ia(m, fi, ii)
    lc := types.mir_ic(m, fi, ii)
    ld := types.mir_id(m, fi, ii)
    mut x := -1
    if mir_is_m32(m, fi, ld) {
        x = lc
    } else if mir_is_m32(m, fi, lc) {
        x = ld
    } else {
        << false
    }
    ni := types.mir_inext(m, fi, ii)
    if ni < 0 {
        << false
    }
    mut y_v := -1
    mut y_local := -1
    mut t_and := -1
    mut last_ii := ni
    if types.mir_ikind(m, fi, ni) == types.MI_BIN && types.mir_ib(m, fi, ni) == 14 {
        ac := types.mir_ic(m, fi, ni)
        ad := types.mir_id(m, fi, ni)
        if ac == t_not {
            y_v = ad
        } else if ad == t_not {
            y_v = ac
        } else {
            << false
        }
        t_and = types.mir_ia(m, fi, ni)
    } else if types.mir_ikind(m, fi, ni) == types.MI_LOAD_LOCAL {
        t_y := types.mir_ia(m, fi, ni)
        loc := types.mir_ib(m, fi, ni)
        ai := types.mir_inext(m, fi, ni)
        if ai < 0 || types.mir_ikind(m, fi, ai) != types.MI_BIN || types.mir_ib(m, fi, ai) != 14 {
            << false
        }
        if !isel_temps_xor(types.mir_ic(m, fi, ai), types.mir_id(m, fi, ai), t_not, t_y) {
            << false
        }
        t_and = types.mir_ia(m, fi, ai)
        y_local = loc
        last_ii = ai
        after := types.mir_inext(m, fi, ai)
        if mir_temp_uses_from(m, fi, t_y, after) != 0 {
            << false
        }
    } else {
        << false
    }
    after := types.mir_inext(m, fi, last_ii)
    if mir_temp_uses_from(m, fi, t_not, after) != 0 {
        << false
    }
    dest_pin := rc_coalesce_store_pin(&*a, m, fi, fr, t_and, after)
    mut dest_r := 0
    mut coalesced := 0
    if dest_pin >= 0 {
        dest_r = dest_pin
        coalesced = 1
    } else {
        dest_r = rc_pick_alu(&*a)
        rc_clobber(a, dest_r)
    }
    mut y_r := 0
    if y_local >= 0 {
        y_r = rc_load_local_reg(a, fr, y_local, rc_scratch_avoid(dest_r))
    } else {
        y_r = rc_load_reg(a, m, fi, fr, y_v, rc_scratch_avoid(dest_r))
    }
    x_r := rc_load_reg(a, m, fi, fr, x, rc_scratch_avoid2(dest_r, y_r))
    if dest_r == x_r {
        dest_r = rc_scratch_avoid2(x_r, y_r)
        rc_clobber(a, dest_r)
        coalesced = 0
    }
    a.vm_bic32(dest_r, y_r, x_r)
    emit_wrap_at(a, dest_r, types.mir_temp_ty(m, fi, t_and))
    rc_commit_alu(a, m, fi, fr, t_and, dest_r, coalesced, after)
    nxt := types.mir_inext(m, fi, ii)
    if nxt >= 0 {
        a.rc_fp_skip_n = isel_skip_count(m, fi, nxt, last_ii)
    }
    << true
}

// Clang mvn: `x ^ 0xFFFFFFFF` → 32-bit not.
fn emit_clang_mvn(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) bool {
    if a.arch != 0 && a.arch != 1 {
        << false
    }
    if types.mir_ib(m, fi, ii) != 16 {
        << false
    }
    lc := types.mir_ic(m, fi, ii)
    ld := types.mir_id(m, fi, ii)
    mut x := -1
    if mir_is_m32(m, fi, ld) {
        x = lc
    } else if mir_is_m32(m, fi, lc) {
        x = ld
    } else {
        << false
    }
    dest := types.mir_ia(m, fi, ii)
    ni := types.mir_inext(m, fi, ii)
    dest_pin := rc_coalesce_store_pin(&*a, m, fi, fr, dest, ni)
    mut dest_r := 0
    mut coalesced := 0
    if dest_pin >= 0 {
        dest_r = dest_pin
        coalesced = 1
    } else {
        dest_r = rc_pick_alu(&*a)
        rc_clobber(a, dest_r)
    }
    src_r := rc_load_reg(a, m, fi, fr, x, rc_scratch_avoid(dest_r))
    a.vm_mvn32(dest_r, src_r)
    emit_wrap_at(a, dest_r, types.mir_temp_ty(m, fi, dest))
    rc_commit_alu(a, m, fi, fr, dest, dest_r, coalesced, ni)
    << true
}

// Emit-time jump table for `ident += intconst` dense match (select-add MIR).
// MIR stays Eq+Mul+Add so the counted while can remain a self-loop; only the
// machine code becomes `ldr [tab, k, lsl #3]`. Scratch is V0/V1 (not V2–V5).
fn emit_match_table_peep(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) int {
    // Hosted arm64 and x64.
    if a.arch != 0 && a.arch != 1 {
        << 0
    }
    bi := a.rc_cur_bi
    if bi < 0 || bi >= types.mir_nblocks(m, fi) {
        << 0
    }
    if types.mir_ikind(m, fi, ii) != types.MI_COPY {
        << 0
    }
    acc := types.mir_ia(m, fi, ii)
    src := types.mir_ib(m, fi, ii)
    if acc < 0 || src >= 0 {
        << 0
    }
    else_val := types.mir_const_at(m, fi, -src - 2)
    mut keys := []int{}
    mut addends := []int{}
    mut subject := -1
    mut cur := types.mir_inext(m, fi, ii)
    mut nskip := 0
    mut ok := 1
    while ok == 1 && cur >= 0 {
        if types.mir_ikind(m, fi, cur) != types.MI_BIN || types.mir_ib(m, fi, cur) != 6 {
            cur = -1
            ->
        }
        eqt := types.mir_ia(m, fi, cur)
        lc := types.mir_ic(m, fi, cur)
        rd := types.mir_id(m, fi, cur)
        mut sub := lc
        mut keyv := rd
        if lc < 0 && rd >= 0 {
            sub = rd
            keyv = lc
        }
        if keyv >= 0 || sub < 0 {
            ok = 0
            ->
        }
        key := types.mir_const_at(m, fi, -keyv - 2)
        if subject < 0 {
            subject = sub
        }
        if sub != subject {
            ok = 0
            ->
        }
        nskip += 1
        nxt := types.mir_inext(m, fi, cur)
        mut addend := else_val
        mut consumed := 0
        if nxt >= 0 && types.mir_ikind(m, fi, nxt) == types.MI_BIN {
            nb := types.mir_ib(m, fi, nxt)
            if nb == 3 {
                mc := types.mir_ic(m, fi, nxt)
                md := types.mir_id(m, fi, nxt)
                mut magv := md
                mut lhs := mc
                if mc < 0 {
                    magv = mc
                    lhs = md
                }
                if lhs == eqt && magv < 0 {
                    mag := types.mir_const_at(m, fi, -magv - 2)
                    pr := types.mir_ia(m, fi, nxt)
                    n2 := types.mir_inext(m, fi, nxt)
                    if n2 >= 0 && types.mir_ikind(m, fi, n2) == types.MI_BIN {
                        ob := types.mir_ib(m, fi, n2)
                        if (ob == 1 || ob == 2) && types.mir_ia(m, fi, n2) == acc {
                            if types.mir_ic(m, fi, n2) == acc && types.mir_id(m, fi, n2) == pr {
                                if ob == 1 {
                                    addend = else_val + mag
                                } else {
                                    addend = else_val - mag
                                }
                                nskip += 2
                                cur = types.mir_inext(m, fi, n2)
                                consumed = 1
                            }
                        }
                    }
                }
            } else if nb == 1 || nb == 2 {
                if types.mir_ia(m, fi, nxt) == acc && types.mir_ic(m, fi, nxt) == acc {
                    if types.mir_id(m, fi, nxt) == eqt {
                        if nb == 1 {
                            addend = else_val + 1
                        } else {
                            addend = else_val - 1
                        }
                        nskip += 1
                        cur = types.mir_inext(m, fi, nxt)
                        consumed = 1
                    }
                }
            }
        }
        if consumed == 0 {
            cur = nxt
        }
        keys.push(key)
        addends.push(addend)
    }
    if ok == 0 || subject < 0 || keys.len < 2 {
        << 0
    }
    mut maxk := keys[0]
    mut i := 0
    while i < keys.len {
        if keys[i] < 0 {
            << 0
        }
        if keys[i] > maxk {
            maxk = keys[i]
        }
        mut j := i + 1
        while j < keys.len {
            if keys[i] == keys[j] {
                << 0
            }
            j += 1
        }
        i += 1
    }
    if maxk >= 16 {
        << 0
    }
    << emit_match_table_emit(a, m, fi, fr, acc, subject, else_val, &keys, &addends, nskip, bi, ii, maxk)
}

fn emit_match_table_emit(a &mut Assembler, m &types.Mir, fi int, fr &Frame, acc int, subject int, else_val int, keys &[]int, addends &[]int, nskip int, bi int, ii int, maxk int) int {
    mut tab_len := maxk + 1
    // `x & M` is in [0, M]. If M covers every explicit key, pad the table
    // with else and skip the per-iter `k >= tab_len` branch.
    mut msk := temp_and_imm(m, fi, bi, ii, subject)
    if msk < 0 {
        loc := temp_local_before(m, fi, bi, ii, subject)
        if loc >= 0 {
            mut jj := types.mir_bhead(m, fi, bi)
            for _ in 0:types.mir_nins(m, fi) {
                if jj < 0 || jj == ii { <- }
                if types.mir_ikind(m, fi, jj) == types.MI_STORE_LOCAL && types.mir_ia(m, fi, jj) == loc {
                    msk = temp_and_imm(m, fi, bi, jj, types.mir_ib(m, fi, jj))
                }
                jj = types.mir_inext(m, fi, jj)
            }
        }
    }
    mut covered := false
    if msk >= maxk && msk <= 15 {
        tab_len = msk + 1
        covered = true
    }
    mut tab := []int{}
    for ti in 0:tab_len {
        tab.push(else_val)
    }
    for ai in 0:keys.len {
        tab[keys[ai]] = addends[ai]
    }
    lab := types.mir_fn_label(m, fi) + "_mtab" + str(bi) + "_" + str(ii)
    a.align_data(8)
    a.data_label(lab + "")
    for ti in 0:tab_len {
        rt_emit_u64(a, tab[ti])
    }
    // Load subject into V0 without depending on RegCache parks (fixed-home
    // functions clear rc_on). Scratch V1 holds the table base.
    mut idx := 0
    if a.rc_on {
        kr := rc_load_reg(a, m, fi, fr, subject, 0)
        if covered {
            idx = kr
        } else if kr != 0 {
            rc_clobber(a, 0)
            a.mov(0, kr)
        }
        rc_clobber(a, 1)
    } else {
        emit_load_value(a, m, fi, fr, subject, 0)
    }
    if covered {
        a.lea(1, lab + "")
        a.be_load_scaled(0, 1, idx, 8)
        emit_store_scalar_temp(a, m, fi, fr, acc, 0)
        << nskip
    }
    a.vm_cmp_imm(0, tab_len)
    el := lab + "_e"
    dn := lab + "_d"
    a.jae(el + "")
    a.lea(1, lab + "")
    a.be_load_scaled(0, 1, 0, 8)
    a.jmp(dn + "")
    a.label(el + "")
    a.vm_mov_imm64(0, else_val)
    a.label(dn + "")
    emit_store_scalar_temp(a, m, fi, fr, acc, 0)
    << nskip
}

// Fixed-home rotate selection has its own proof. It skips only pure,
// single-use integer producers, and uses V0/V1 or the final colored home.
fn isel_ror32_const(m &types.Mir, fi int, value int) int {
    if value > -2 { << -1 }
    ci := 0 - (value + 2)
    if ci < 0 || ci >= types.mir_nconsts(m, fi) { << -1 }
    << types.mir_const_at(m, fi, ci)
}

fn isel_ror32_int(m &types.Mir, fi int, t int) bool {
    if t < 0 || t >= types.mir_ntemps(m, fi) { << false }
    << types.mir_temp_ty(m, fi, t) == 1 && types.mir_temp_nslots(m, fi, t) == 1
}

fn isel_ror32_mask(m &types.Mir, fi int, ii int, t int) bool {
    if types.mir_ikind(m, fi, ii) != types.MI_BIN || types.mir_ib(m, fi, ii) != 14 { << false }
    c := types.mir_ic(m, fi, ii)
    d := types.mir_id(m, fi, ii)
    << (c == t && isel_ror32_const(m, fi, d) == 4294967295) || (d == t && isel_ror32_const(m, fi, c) == 4294967295)
}

fn isel_ror32_note_def(facts &mut []int, n int, t int, ii int, bi int) {
    if t < 0 || t >= n { << }
    if facts[t] == -1 { facts[t] = ii
        facts[2 * n + t] = bi
    } else { facts[t] = -2 }
}

fn isel_ror32_note_use(facts &mut []int, n int, t int, ii int) {
    if t < 0 || t >= n { << }
    if facts[n + t] == 0 { facts[5 * n + t] = ii }
    if facts[n + t] < 2 { facts[n + t] += 1 }
}

fn isel_ror32_has_window(m &types.Mir, fi int) bool {
    ni := types.mir_nins(m, fi)
    for ii in 0:ni {
        if types.mir_ikind(m, fi, ii) != types.MI_BIN { -> }
        op := types.mir_ib(m, fi, ii)
        if op != 17 && op != 18 { -> }
        n1 := isel_ror32_const(m, fi, types.mir_id(m, fi, ii))
        if n1 < 1 || n1 > 31 { -> }
        mut other := types.mir_inext(m, fi, ii)
        if other >= 0 && types.mir_ikind(m, fi, other) == types.MI_LOAD_LOCAL { other = types.mir_inext(m, fi, other) }
        if other >= 0 && isel_ror32_mask(m, fi, other, types.mir_ia(m, fi, ii)) { other = types.mir_inext(m, fi, other) }
        if other < 0 || types.mir_ikind(m, fi, other) != types.MI_BIN || types.mir_ib(m, fi, other) != 35 - op { -> }
        n2 := isel_ror32_const(m, fi, types.mir_id(m, fi, other))
        if n2 >= 1 && n2 <= 31 && n1 + n2 == 32 { << true }
    }
    << false
}

fn isel_ror32_facts(m &types.Mir, fi int) []int {
    mut facts := []int{}
    n := types.mir_ntemps(m, fi)
    ni := types.mir_nins(m, fi)
    nl := types.mir_nlocals(m, fi)
    nb := types.mir_nblocks(m, fi)
    if n <= 0 || n > VREG_PLAN_TEMP_CAP || ni > VREG_PLAN_TEMP_CAP * 2 || nl > 48 || nb <= 0 || nb > 32 { << facts }
    if !types.mir_verify_emission_calls(m, fi) { << facts }
    for t in 0:n { if types.mir_temp_ty(m, fi, t) == 4 { << facts } }
    for _ in 0:6 * n + 3 * nl + ni { facts.push(-1) }
    for t in 0:n { facts[n + t] = 0
        facts[4 * n + t] = 0 }
    for l in 0:nl { facts[6 * n + l] = 0 }
    order := 6 * n + 3 * nl
    for bi in 0:nb {
        for l in 0:nl { facts[6 * n + nl + l] = -1 }
        mut ii := types.mir_bhead(m, fi, bi)
        mut position := 0
        for _ in 0:ni {
            if ii < 0 { <- }
            facts[order + ii] = position
            position += 1
            k := types.mir_ikind(m, fi, ii)
            a := types.mir_ia(m, fi, ii)
            b := types.mir_ib(m, fi, ii)
            c := types.mir_ic(m, fi, ii)
            d := types.mir_id(m, fi, ii)
            if types.mir_instr_has_dest(k) { isel_ror32_note_def(mut &facts, n, a, ii, bi) }
            if k == types.MI_CHAN_RECV { isel_ror32_note_def(mut &facts, n, d, ii, bi) }
            if k == types.MI_CHAN_TRY_RECV { isel_ror32_note_def(mut &facts, n, b, ii, bi) }
            if k == types.MI_LOAD_LOCAL { facts[3 * n + a] = facts[6 * n + nl + b] }
            if k == types.MI_STORE_LOCAL {
                facts[6 * n + nl + a] = ii
                if bi == 0 && facts[6 * n + 2 * nl + a] < 0 { facts[6 * n + 2 * nl + a] = ii }
            }
            if (k == types.MI_STORE_INDEX || k == types.MI_INDEX_RMW) && a >= types.MIR_LOCAL_OPERAND_BASE {
                loc := a - types.MIR_LOCAL_OPERAND_BASE
                if loc >= 0 && loc < nl { facts[6 * n + loc] = 1 }
            }
            if k == types.MI_ADDR {
                if c == 0 { facts[6 * n + b] = 1 }
                if c == 1 { facts[4 * n + b] = 1 }
            }
            schema := types.mir_instr_use_schema(k, c)
            mask := types.mir_instr_use_mask(schema)
            if mask < 0 { << []int{} }
            if (mask & 1) != 0 { isel_ror32_note_use(mut &facts, n, a, ii) }
            if (mask & 2) != 0 { isel_ror32_note_use(mut &facts, n, b, ii) }
            if (mask & 4) != 0 { isel_ror32_note_use(mut &facts, n, c, ii) }
            if (mask & 8) != 0 { isel_ror32_note_use(mut &facts, n, d, ii) }
            mut ap := types.mir_instr_use_arg_head(schema, b, c, d)
            for _ in 0:types.mir_nmargs(m, fi) {
                if ap < 0 { <- }
                isel_ror32_note_use(mut &facts, n, types.mir_marg_v(m, fi, ap), ii)
                ap = types.mir_marg_next(m, fi, ap)
            }
            if ap >= 0 { << []int{} }
            ii = types.mir_inext(m, fi, ii)
        }
        tk := types.mir_btkind(m, fi, bi)
        if tk == 2 || tk == 3 { isel_ror32_note_use(mut &facts, n, types.mir_bta(m, fi, bi), -1) }
    }
    isel_ror32_mark_locals(mut &facts, m, fi)
    << facts
}

fn isel_ror32_unique_def(facts &[]int, m &types.Mir, fi int, t int) int {
    n := types.mir_ntemps(m, fi)
    if t < 0 || t >= n || facts.len < 6 * n { << -1 }
    << facts[t]
}

fn isel_ror32_use_count(facts &[]int, m &types.Mir, fi int, t int) int {
    n := types.mir_ntemps(m, fi)
    if t < 0 || t >= n || facts.len < 6 * n { << -1 }
    << facts[n + t]
}

// Resolve immutable snapshots only inside their defining block. A Local
// may additionally use an entry-initialized invariant when every linked
// write preserves the low lane and no address or tagged write exposes it.
fn isel_ror32_low_value(facts &[]int, m &types.Mir, fi int, bi int, before int, source int, invariants bool) bool {
    n := types.mir_ntemps(m, fi)
    nl := types.mir_nlocals(m, fi)
    order := 6 * n + 3 * nl
    if facts.len != order + types.mir_nins(m, fi) || before < 0 || before >= types.mir_nins(m, fi) { << false }
    mut value := source
    mut limit := before
    for _ in 0:32 {
        if value <= -2 {
            v := isel_ror32_const(m, fi, value)
            << v >= 0 && v <= 4294967295
        }
        if !isel_ror32_int(m, fi, value) || facts[4 * n + value] != 0 { << false }
        def := isel_ror32_unique_def(facts, m, fi, value)
        if def < 0 || facts[2 * n + value] != bi || facts[order + def] >= facts[order + limit] { << false }
        k := types.mir_ikind(m, fi, def)
        if k == types.MI_BIN && types.mir_ib(m, fi, def) == 14 {
            c := types.mir_ic(m, fi, def)
            d := types.mir_id(m, fi, def)
            << isel_ror32_const(m, fi, c) == 4294967295 || isel_ror32_const(m, fi, d) == 4294967295
        }
        if k == types.MI_COPY {
            value = types.mir_ib(m, fi, def)
            limit = def
        } else if k == types.MI_LOAD_LOCAL {
            loc := types.mir_ib(m, fi, def)
            if loc < 0 || loc >= nl || types.mir_local_ty(m, fi, loc) != 1 || types.mir_local_nslots(m, fi, loc) != 1 || (facts[6 * n + loc] & 1) != 0 { << false }
            store_at := facts[3 * n + value]
            // Block zero must actually have passed its entry initializer.
            if invariants && (facts[6 * n + loc] & 2) != 0 && (bi != 0 || store_at >= 0) { << true }
            if store_at < 0 { << false }
            value = types.mir_ib(m, fi, store_at)
            limit = store_at
        } else { << false }
    }
    << false
}

fn isel_ror32_mark_locals(facts &mut []int, m &types.Mir, fi int) {
    n := types.mir_ntemps(m, fi)
    nl := types.mir_nlocals(m, fi)
    ni := types.mir_nins(m, fi)
    for loc in 0:nl {
        first := facts[6 * n + 2 * nl + loc]
        if loc < types.mir_fn_nparams(m, fi) || facts[6 * n + loc] != 0 || first < 0 || types.mir_local_ty(m, fi, loc) != 1 || types.mir_local_nslots(m, fi, loc) != 1 { -> }
        if isel_ror32_low_value(&*facts, m, fi, 0, first, types.mir_ib(m, fi, first), false) { facts[6 * n + loc] = 2 }
    }
    // Start from proved entry values and remove any invariant invalidated
    // by a write. At most nl removals; calls cannot alter non-addressed locals.
    for _ in 0:nl {
        mut changed := false
        for bi in 0:types.mir_nblocks(m, fi) {
            mut ii := types.mir_bhead(m, fi, bi)
            for _ in 0:ni {
                if ii < 0 { <- }
                if types.mir_ikind(m, fi, ii) == types.MI_STORE_LOCAL {
                    loc := types.mir_ia(m, fi, ii)
                    if (facts[6 * n + loc] & 2) != 0 && !isel_ror32_low_value(&*facts, m, fi, bi, ii, types.mir_ib(m, fi, ii), true) {
                        facts[6 * n + loc] = 0
                        changed = true
                    }
                }
                ii = types.mir_inext(m, fi, ii)
            }
        }
        if !changed { << }
    }
}

fn isel_ror32_low_source(facts &[]int, m &types.Mir, fi int, bi int, before int, source int) bool {
    << isel_ror32_low_value(facts, m, fi, bi, before, source, true)
}

fn isel_ror32_truncated(facts &[]int, m &types.Mir, fi int, bi int, value int) bool {
    n := types.mir_ntemps(m, fi)
    mut v := value
    for _ in 0:8 {
        if !isel_ror32_int(m, fi, v) || facts[4 * n + v] != 0 || isel_ror32_use_count(facts, m, fi, v) != 1 { << false }
        consumer := facts[5 * n + v]
        if consumer < 0 || types.mir_ikind(m, fi, consumer) != types.MI_BIN { << false }
        out := types.mir_ia(m, fi, consumer)
        if !isel_ror32_int(m, fi, out) || isel_ror32_unique_def(facts, m, fi, out) != consumer || facts[2 * n + out] != bi { << false }
        if isel_ror32_mask(m, fi, consumer, v) { << true }
        op := types.mir_ib(m, fi, consumer)
        if op != 1 && op != 16 { << false }
        v = out
    }
    << false
}

fn isel_ror32_match(facts &[]int, m &types.Mir, fi int, bi int, ii int) ISelLane {
    fail := isel_lane_fail()
    if fi < 0 || fi >= m.fns.len { << fail }
    ni := types.mir_nins(m, fi)
    if ni > VREG_PLAN_TEMP_CAP * 2 || ii < 0 || ii >= ni || bi < 0 || bi >= types.mir_nblocks(m, fi) { << fail }
    if types.mir_ikind(m, fi, ii) != types.MI_BIN { << fail }
    op := types.mir_ib(m, fi, ii)
    if op != 17 && op != 18 { << fail }
    n1 := isel_ror32_const(m, fi, types.mir_id(m, fi, ii))
    if n1 < 1 || n1 > 31 { << fail }
    i2 := types.mir_inext(m, fi, ii)
    if i2 < 0 || i2 >= ni { << fail }
    i3 := types.mir_inext(m, fi, i2)
    if i3 < 0 || i3 >= ni { << fail }
    i4 := types.mir_inext(m, fi, i3)
    if i4 < 0 || i4 >= ni || types.mir_ikind(m, fi, i4) != types.MI_BIN || types.mir_ib(m, fi, i4) != 15 { << fail }
    source := types.mir_ic(m, fi, ii)
    t1 := types.mir_ia(m, fi, ii)
    t2 := types.mir_ia(m, fi, i2)
    t3 := types.mir_ia(m, fi, i3)
    final := types.mir_ia(m, fi, i4)
    mut other := i3
    mut lo := t2
    mut hi := t3
    if op == 17 {
        if !isel_ror32_mask(m, fi, i2, t1) { << fail }
        if types.mir_ikind(m, fi, i3) != types.MI_BIN || types.mir_ib(m, fi, i3) != 18 { << fail }
    } else {
        other = i2
        lo = t3
        hi = t1
        if types.mir_ikind(m, fi, i2) != types.MI_BIN || types.mir_ib(m, fi, i2) != 17 { << fail }
        if !isel_ror32_mask(m, fi, i3, t2) { << fail }
    }
    if types.mir_ic(m, fi, other) != source { << fail }
    n2 := isel_ror32_const(m, fi, types.mir_id(m, fi, other))
    if n2 < 1 || n2 > 31 || n1 + n2 != 32 { << fail }
    if !isel_temps_xor(types.mir_ic(m, fi, i4), types.mir_id(m, fi, i4), lo, hi) { << fail }
    if !isel_ror32_int(m, fi, t1) || !isel_ror32_int(m, fi, t2) || !isel_ror32_int(m, fi, t3) || !isel_ror32_int(m, fi, final) { << fail }
    if !isel_ror32_low_source(facts, m, fi, bi, ii, source) { << fail }
    if isel_ror32_unique_def(facts, m, fi, t1) != ii || isel_ror32_unique_def(facts, m, fi, t2) != i2 || isel_ror32_unique_def(facts, m, fi, t3) != i3 || isel_ror32_unique_def(facts, m, fi, final) != i4 { << fail }
    if isel_ror32_use_count(facts, m, fi, t1) != 1 || isel_ror32_use_count(facts, m, fi, t2) != 1 || isel_ror32_use_count(facts, m, fi, t3) != 1 { << fail }
    mut ror := n2
    if op == 18 { ror = n1 }
    << ISelLane{kind: 0, n: ror, dest: final, tail: i4}
}

// The wide left-shift lane is discarded only by the final m32 mask.
fn isel_ror32_tail_match(facts &[]int, m &types.Mir, fi int, bi int, ii int) ISelLane {
    fail := isel_lane_fail()
    if fi < 0 || fi >= m.fns.len { << fail }
    ni := types.mir_nins(m, fi)
    if ni > VREG_PLAN_TEMP_CAP * 2 || ii < 0 || ii >= ni || bi < 0 || bi >= types.mir_nblocks(m, fi) { << fail }
    if types.mir_ikind(m, fi, ii) != types.MI_BIN { << fail }
    op := types.mir_ib(m, fi, ii)
    if op != 17 && op != 18 { << fail }
    n1 := isel_ror32_const(m, fi, types.mir_id(m, fi, ii))
    if n1 < 1 || n1 > 31 { << fail }
    mut i2 := types.mir_inext(m, fi, ii)
    mut reload := -1
    if i2 >= 0 && i2 < ni && types.mir_ikind(m, fi, i2) == types.MI_LOAD_LOCAL {
        reload = i2
        i2 = types.mir_inext(m, fi, i2)
    }
    if i2 < 0 || i2 >= ni || types.mir_ikind(m, fi, i2) != types.MI_BIN { << fail }
    if types.mir_ib(m, fi, i2) != 35 - op { << fail }
    source := types.mir_ic(m, fi, ii)
    other_source := types.mir_ic(m, fi, i2)
    if reload < 0 {
        if other_source != source { << fail }
    } else {
        source_def := isel_ror32_unique_def(facts, m, fi, source)
        if source_def < 0 || types.mir_ikind(m, fi, source_def) != types.MI_LOAD_LOCAL { << fail }
        if types.mir_ib(m, fi, reload) != types.mir_ib(m, fi, source_def) || types.mir_ia(m, fi, reload) != other_source { << fail }
        if !isel_ror32_int(m, fi, other_source) || isel_ror32_unique_def(facts, m, fi, other_source) != reload || isel_ror32_use_count(facts, m, fi, other_source) != 1 { << fail }
    }
    n2 := isel_ror32_const(m, fi, types.mir_id(m, fi, i2))
    if n2 < 1 || n2 > 31 || n1 + n2 != 32 { << fail }
    i3 := types.mir_inext(m, fi, i2)
    if i3 < 0 || i3 >= ni || types.mir_ikind(m, fi, i3) != types.MI_BIN || types.mir_ib(m, fi, i3) != 15 { << fail }
    t1 := types.mir_ia(m, fi, ii)
    t2 := types.mir_ia(m, fi, i2)
    t3 := types.mir_ia(m, fi, i3)
    if !isel_temps_xor(types.mir_ic(m, fi, i3), types.mir_id(m, fi, i3), t1, t2) { << fail }
    i4 := types.mir_inext(m, fi, i3)
    if i4 < 0 || i4 >= ni || types.mir_ikind(m, fi, i4) != types.MI_BIN { << fail }
    mut kind := 1
    mut tail := i4
    if types.mir_ib(m, fi, i4) == 1 {
        if types.mir_ic(m, fi, i4) != t3 && types.mir_id(m, fi, i4) != t3 { << fail }
        sum := types.mir_ia(m, fi, i4)
        tail = types.mir_inext(m, fi, i4)
        if tail < 0 || tail >= ni || !isel_ror32_mask(m, fi, tail, sum) { << fail }
        if !isel_ror32_int(m, fi, sum) || isel_ror32_unique_def(facts, m, fi, sum) != i4 || isel_ror32_use_count(facts, m, fi, sum) != 1 { << fail }
        kind = 2
    } else if !isel_ror32_mask(m, fi, i4, t3) { << fail }
    final := types.mir_ia(m, fi, tail)
    if !isel_ror32_int(m, fi, t1) || !isel_ror32_int(m, fi, t2) || !isel_ror32_int(m, fi, t3) || !isel_ror32_int(m, fi, final) { << fail }
    if !isel_ror32_low_source(facts, m, fi, bi, ii, source) { << fail }
    if isel_ror32_unique_def(facts, m, fi, t1) != ii || isel_ror32_unique_def(facts, m, fi, t2) != i2 || isel_ror32_unique_def(facts, m, fi, t3) != i3 || isel_ror32_unique_def(facts, m, fi, final) != tail { << fail }
    if isel_ror32_use_count(facts, m, fi, t1) != 1 || isel_ror32_use_count(facts, m, fi, t2) != 1 || isel_ror32_use_count(facts, m, fi, t3) != 1 { << fail }
    mut ror := n2
    if op == 18 { ror = n1 }
    if reload >= 0 { kind += 2 }
    << ISelLane{kind: kind, n: ror, dest: final, tail: tail}
}

// A rotate may feed additions/xors before its final low-word mask. The
// high lane is unobservable along that entire single-use chain, so retain
// the ordinary consumers and replace only the two shifts and their OR.
fn isel_ror32_truncated_match(facts &[]int, m &types.Mir, fi int, bi int, ii int) ISelLane {
    fail := isel_lane_fail()
    if types.mir_ikind(m, fi, ii) != types.MI_BIN { << fail }
    op := types.mir_ib(m, fi, ii)
    if op != 17 && op != 18 { << fail }
    n1 := isel_ror32_const(m, fi, types.mir_id(m, fi, ii))
    if n1 < 1 || n1 > 31 { << fail }
    ni := types.mir_nins(m, fi)
    source := types.mir_ic(m, fi, ii)
    mut other := types.mir_inext(m, fi, ii)
    mut reload := -1
    if other >= 0 && other < ni && types.mir_ikind(m, fi, other) == types.MI_LOAD_LOCAL {
        reload = other
        other = types.mir_inext(m, fi, other)
    }
    if other < 0 || other >= ni || types.mir_ikind(m, fi, other) != types.MI_BIN || types.mir_ib(m, fi, other) != 35 - op { << fail }
    other_source := types.mir_ic(m, fi, other)
    if reload < 0 {
        if other_source != source { << fail }
    } else {
        source_def := isel_ror32_unique_def(facts, m, fi, source)
        if source_def < 0 || types.mir_ikind(m, fi, source_def) != types.MI_LOAD_LOCAL { << fail }
        if types.mir_ib(m, fi, reload) != types.mir_ib(m, fi, source_def) || types.mir_ia(m, fi, reload) != other_source { << fail }
        if !isel_ror32_int(m, fi, other_source) || isel_ror32_unique_def(facts, m, fi, other_source) != reload || isel_ror32_use_count(facts, m, fi, other_source) != 1 { << fail }
    }
    n2 := isel_ror32_const(m, fi, types.mir_id(m, fi, other))
    if n2 < 1 || n2 > 31 || n1 + n2 != 32 { << fail }
    tail := types.mir_inext(m, fi, other)
    if tail < 0 || tail >= ni || types.mir_ikind(m, fi, tail) != types.MI_BIN || types.mir_ib(m, fi, tail) != 15 { << fail }
    t1 := types.mir_ia(m, fi, ii)
    t2 := types.mir_ia(m, fi, other)
    dest := types.mir_ia(m, fi, tail)
    if !isel_temps_xor(types.mir_ic(m, fi, tail), types.mir_id(m, fi, tail), t1, t2) { << fail }
    if !isel_ror32_int(m, fi, t1) || !isel_ror32_int(m, fi, t2) || !isel_ror32_int(m, fi, dest) { << fail }
    if isel_ror32_unique_def(facts, m, fi, t1) != ii || isel_ror32_unique_def(facts, m, fi, t2) != other || isel_ror32_unique_def(facts, m, fi, dest) != tail { << fail }
    if isel_ror32_use_count(facts, m, fi, t1) != 1 || isel_ror32_use_count(facts, m, fi, t2) != 1 { << fail }
    if !isel_ror32_low_source(facts, m, fi, bi, ii, source) || !isel_ror32_truncated(facts, m, fi, bi, dest) { << fail }
    mut rotation := n2
    if op == 18 { rotation = n1 }
    mut kind := 5
    if reload >= 0 { kind = 6 }
    << ISelLane{kind: kind, n: rotation, dest: dest, tail: tail}
}

fn emit_fixed_ror32(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) bool {
    if (a.arch != 0 && a.arch != 1) || a.rc_ror32_facts.len == 0 { << false }
    bi := a.rc_cur_bi
    mut lane := isel_ror32_tail_match(&a.rc_ror32_facts, m, fi, bi, ii)
    if lane.kind < 0 { lane = isel_ror32_match(&a.rc_ror32_facts, m, fi, bi, ii) }
    if lane.kind < 0 { lane = isel_ror32_truncated_match(&a.rc_ror32_facts, m, fi, bi, ii) }
    if lane.kind < 0 { << false }
    source := types.mir_ic(m, fi, ii)
    src_r := rc_load_reg(a, m, fi, fr, source, 0)
    mut dest_r := 0
    slot := fr.temp_slot[lane.dest]
    if is_vreg_slot(slot) { dest_r = vreg_slot_home(slot) }
    if lane.kind == 2 || lane.kind == 4 {
        mut i2 := types.mir_inext(m, fi, ii)
        if lane.kind == 4 { i2 = types.mir_inext(m, fi, i2) }
        i3 := types.mir_inext(m, fi, i2)
        i4 := types.mir_inext(m, fi, i3)
        rot := types.mir_ia(m, fi, i3)
        mut acc := types.mir_ic(m, fi, i4)
        if acc == rot { acc = types.mir_id(m, fi, i4) }
        a.vm_ror_imm32(0, src_r, lane.n)
        acc_r := rc_load_reg(a, m, fi, fr, acc, 1)
        a.vm_add32(dest_r, 0, acc_r)
    } else {
        a.vm_ror_imm32(dest_r, src_r, lane.n)
    }
    emit_store_scalar_temp(a, m, fi, fr, lane.dest, dest_r)
    a.rc_fp_skip_n = 3
    if lane.kind == 2 { a.rc_fp_skip_n = 4 }
    if lane.kind == 3 { a.rc_fp_skip_n = 4 }
    if lane.kind == 4 { a.rc_fp_skip_n = 5 }
    if lane.kind == 5 { a.rc_fp_skip_n = 2 }
    if lane.kind == 6 { a.rc_fp_skip_n = 3 }
    << true
}

fn isel_ror32_gate_one(m &types.Mir, mode int) bool {
    facts := isel_ror32_facts(m, 0)
    ii := types.mir_btb(m, 0, 0)
    mut lane := isel_lane_fail()
    if facts.len > 0 { lane = isel_ror32_match(&facts, m, 0, 0, ii) }
    want := mode == 0 || mode == 1 || mode == 14 || mode == 19
    if (lane.kind >= 0) != want { << false }
    if want && (lane.n != 25 || lane.dest != 5) { << false }
    << true
}

fn isel_ror32_internal_gate() bool {
    for mode in 0:20 {
        m := types.mir_ror32_gate_fixture(mode)
        if !isel_ror32_gate_one(&m, mode) { << false }
    }
    << true
}
