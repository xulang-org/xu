// Hosted coroutine frames use a fixed 128 KiB stack. Function entry checks
// the owning G's stack range and cookie before installing a user frame, then
// jumps here when a preceding frame has reached the fixed-stack boundary.
fn rt_emit_stack_check(a $&Assembler) {
    a.data_label("_rt_stack_overflow_msg")
    rt_emit_bytes(a, "coroutine stack overflow\n")
    a.label("_rt_stack_overflow")
    a.lea(18, "_rt_stack_overflow_msg")
    a.vm_mov_imm(19, 25)
    a.vm_mov_imm(20, 2)
    a.call("_rt_write")
    rt_exit(a, 1)
    <<
}

// ===== m32 helpers: backward buffer writes (used by assert/cover/tests) =====

// Emit code that writes the bytes of `s` backwards into the write pointer V0
// (last byte first), decrementing V0; the buffer then reads `s` forward.
fn rt_emit_bwd_str(a $&Assembler, s string) {
    for i in 0:s.len {
        ch := s[s.len - 1 - i]
        a.vm_mov_imm(4, ch)
        a.vm_sub_imm(0, 0, 1)
        a.store_byte(0, 0, 4)
    }
    <<
}

// Emit code that appends decimal digits of V1 (non-negative) backwards into
// the write pointer V0, decrementing V0. Clobbers V1/V3/V4/V5.
fn rt_emit_itoa_bwd(a $&Assembler) {
    a.drop_seq = a.drop_seq + 1
    n := a.drop_seq
    a.vm_mov_imm(3, 10)
    a.label("_rt_ib" + str(n) + "_loop")
    a.imod(4, 1, 3)
    a.div(1, 1, 3)
    a.vm_mov_imm(5, 48)
    a.add(4, 4, 5)
    a.vm_sub_imm(0, 0, 1)
    a.store_byte(0, 0, 4)
    a.vm_cmp_imm(1, 0)
    a.jne("_rt_ib" + str(n) + "_loop")
    <<
}

// Emit code that copies V1 bytes from V2 backwards into the write pointer V0
// (last byte first), decrementing V0. Caller guarantees V1 > 0.
fn rt_emit_memcpy_bwd(a $&Assembler) {
    a.drop_seq = a.drop_seq + 1
    n := a.drop_seq
    a.vm_mov_imm(3, 0)
    a.label("_rt_mcb" + str(n) + "_loop")
    a.cmp(3, 1)
    a.jge("_rt_mcb" + str(n) + "_done")
    a.mov(4, 2)
    a.add(4, 4, 1)
    a.sub(4, 4, 3)
    a.vm_sub_imm(4, 4, 1)
    a.load_byte(5, 4, 0)
    a.vm_sub_imm(0, 0, 1)
    a.store_byte(0, 0, 5)
    a.vm_add_imm(3, 3, 1)
    a.jmp("_rt_mcb" + str(n) + "_loop")
    a.label("_rt_mcb" + str(n) + "_done")
    <<
}

// File-name table read: A0 = file idx, A1 = out ptr (2 slots). Writes
// (ptr,len) into out; empty/unknown path yields (0,0).
fn rt_emit_file_str(a $&Assembler) {
    a.label("_rt_file_str")
    a.prologue(32)
    a.store(15, -8, 19)   // out ptr
    a.store(15, -16, 18)  // file idx
    a.lea(0, "_xuf_n")
    a.load(1, 0, 0)       // V1 = nfiles
    a.load(2, 15, -16)    // V2 = file idx
    a.cmp(2, 1)
    a.jae("_rt_fs_zero")
    a.lea(0, "_xuf_off")
    a.shl_imm(1, 2, 3)    // V1 = idx*8
    a.add(0, 0, 1)
    a.load(3, 0, 0)       // start
    a.load(4, 0, 8)       // end
    a.sub(4, 4, 3)        // len + 1 (NUL included)
    a.vm_sub_imm(4, 4, 1)  // len — match bootstrap emit_file_str
    a.vm_cbz(4, "_rt_fs_zero")
    a.lea(0, "_xuf_all")
    a.add(0, 0, 3)        // ptr
    a.load(1, 15, -8)
    a.store(1, 0, 0)
    a.store(1, 8, 4)
    a.epilogue()
    a.label("_rt_fs_zero")
    a.load(1, 15, -8)
    a.vm_mov_imm(0, 0)
    a.store(1, 0, 0)
    a.store(1, 8, 0)
    a.epilogue()
    <<
}

fn rt_emit_assert_fail(a $&Assembler) {
    a.label("_rt_assert_fail")
    a.prologue(1088)
    a.store(15, -8, 21)   // msg_ptr
    a.store(15, -16, 22)  // msg_len
    a.store(15, -24, 20)  // col
    a.store(15, -32, 19)  // line
    a.store(15, -40, 18)  // file idx
    // file path -> [fp-48]=ptr, [fp-40]=len (out slots at fp-48)
    a.vm_sub_imm(19, 15, 48)
    a.call("_rt_file_str")
    a.vm_sub_imm(0, 15, 72) // wp = fp-72 (buffer [fp-1024, fp-72))
    rt_emit_bwd_str(a, "\n")
    a.load(1, 15, -16) // msg_len
    a.vm_cbz(1, "_rt_af_nomsg")
    a.load(2, 15, -8)  // msg_ptr
    rt_emit_memcpy_bwd(a)
    rt_emit_bwd_str(a, ": ")
    a.label("_rt_af_nomsg")
    rt_emit_bwd_str(a, " assertion failed")
    rt_emit_bwd_str(a, ":")
    a.load(1, 15, -24) // col
    rt_emit_itoa_bwd(a)
    rt_emit_bwd_str(a, ":")
    a.load(1, 15, -32) // line
    rt_emit_itoa_bwd(a)
    rt_emit_bwd_str(a, ":")
    a.load(1, 15, -40) // path len
    a.vm_cbz(1, "_rt_af_nopath")
    a.load(2, 15, -48) // path ptr
    rt_emit_memcpy_bwd(a)
    a.label("_rt_af_nopath")
    a.vm_sub_imm(5, 15, 72)
    a.sub(5, 5, 0)
    a.mov(18, 0)
    a.mov(19, 5)
    a.vm_mov_imm(20, 2) // stderr
    a.call("_rt_write")
    if a.test {
        a.lea(18, "_xu_jmpbuf")
        a.vm_mov_imm(19, 1)
        a.call("_rt_test_longjmp")
    } else {
        rt_exit(a, 1)
    }
    a.epilogue()
    <<
}

// rt_unwrap_fail: A0/A1 = Err string payload (ptr,len); 0/0 = generic.
// Prints `unwrap on Err[: <msg>]\n` to stderr, then exits 1 (or longjmps
// back into the --test harness, same as assert_fail).
fn rt_emit_unwrap_fail(a $&Assembler) {
    a.data_label("_rt_uw_msg")
    rt_emit_bytes(a, "unwrap on Err")
    a.data_label("_rt_uw_sep")
    rt_emit_bytes(a, ": ")
    a.data_label("_rt_uw_nl")
    rt_emit_bytes(a, "\n")
    a.label("_rt_unwrap_fail")
    a.prologue(32)
    a.store(15, -8, 18)   // msg_ptr
    a.store(15, -16, 19)  // msg_len
    a.lea(18, "_rt_uw_msg")
    a.vm_mov_imm(19, 13)  // "unwrap on Err"
    a.vm_mov_imm(20, 2)   // stderr
    a.call("_rt_write")
    a.load(0, 15, -16)
    a.vm_cbz(0, "_rt_uw_nonl")
    a.lea(18, "_rt_uw_sep")
    a.vm_mov_imm(19, 2)
    a.vm_mov_imm(20, 2)
    a.call("_rt_write")
    a.load(18, 15, -8)
    a.load(19, 15, -16)
    a.vm_mov_imm(20, 2)
    a.call("_rt_write")
    a.label("_rt_uw_nonl")
    a.lea(18, "_rt_uw_nl")
    a.vm_mov_imm(19, 1)
    a.vm_mov_imm(20, 2)
    a.call("_rt_write")
    if a.cover {
        a.call("_rt_dump_cover")
    }
    if a.test {
        a.lea(18, "_xu_jmpbuf")
        a.vm_mov_imm(19, 1)
        a.call("_rt_test_longjmp")
    } else {
        rt_exit(a, 1)
    }
    a.epilogue()
    <<
}

// rt_unwrap_err_fail (M157): unwrap_err on Ok — fixed message + exit 1.
fn rt_emit_unwrap_err_fail(a $&Assembler) {
    a.data_label("_rt_uwe_msg")
    rt_emit_bytes(a, "unwrap_err on Ok\n")
    a.label("_rt_unwrap_err_fail")
    a.prologue(16)
    a.lea(18, "_rt_uwe_msg")
    a.vm_mov_imm(19, 17)
    a.vm_mov_imm(20, 2)
    a.call("_rt_write")
    if a.cover {
        a.call("_rt_dump_cover")
    }
    if a.test {
        a.lea(18, "_xu_jmpbuf")
        a.vm_mov_imm(19, 1)
        a.call("_rt_test_longjmp")
    } else {
        rt_exit(a, 1)
    }
    a.epilogue()
    <<
}

// ===== m32 test harness runtime =====

// rt_test_name: A0=ptr, A1=len — write verbatim to stdout (no newline).
fn rt_emit_test_name(a $&Assembler) {
    a.label("_rt_test_name")
    a.prologue(16)
    a.vm_mov_imm(20, 1)
    a.call("_rt_write")
    a.epilogue()
    <<
}

// rt_test_report(delta): -1→"FAIL\n", -2→" ok\n", >=0→" ok <d>ns\n".
fn rt_emit_test_report(a $&Assembler) {
    a.data_label("_rt_tr_fail_msg")
    rt_emit_bytes(a, "FAIL\n")
    a.data_label("_rt_tr_ok_msg")
    rt_emit_bytes(a, "ok\n")
    a.data_label("_rt_tr_skip_msg")
    rt_emit_bytes(a, "SKIP\n")
    a.label("_rt_test_report")
    a.prologue(64)
    a.vm_cmp_imm(18, -1)
    a.jeq("_rt_tr_fail")
    a.vm_cmp_imm(18, -2)
    a.jeq("_rt_tr_ok")
    a.vm_cmp_imm(18, -3)
    a.jeq("_rt_tr_skip")
    a.vm_sub_imm(0, 15, 16)
    rt_emit_bwd_str(a, "\n")
    rt_emit_bwd_str(a, "ns")
    a.mov(1, 18)
    rt_emit_itoa_bwd(a)
    rt_emit_bwd_str(a, " ")
    rt_emit_bwd_str(a, "ok")
    a.vm_sub_imm(5, 15, 16)
    a.sub(5, 5, 0)
    a.mov(18, 0)
    a.mov(19, 5)
    a.vm_mov_imm(20, 1)
    a.call("_rt_write")
    a.epilogue()
    a.label("_rt_tr_fail")
    a.lea(18, "_rt_tr_fail_msg")
    a.vm_mov_imm(19, 5)
    a.vm_mov_imm(20, 1)
    a.call("_rt_write")
    a.epilogue()
    a.label("_rt_tr_ok")
    a.lea(18, "_rt_tr_ok_msg")
    a.vm_mov_imm(19, 3)
    a.vm_mov_imm(20, 1)
    a.call("_rt_write")
    a.epilogue()
    a.label("_rt_tr_skip")
    a.lea(18, "_rt_tr_skip_msg")
    a.vm_mov_imm(19, 5)
    a.vm_mov_imm(20, 1)
    a.call("_rt_write")
    a.epilogue()
    <<
}

// rt_test_summary(pass, run): "<pass>/<run> passed\n".
fn rt_emit_test_summary(a $&Assembler) {
    a.label("_rt_test_summary")
    a.prologue(64)
    a.vm_sub_imm(0, 15, 16)
    rt_emit_bwd_str(a, "\n")
    rt_emit_bwd_str(a, " passed")
    a.mov(1, 19) // run
    rt_emit_itoa_bwd(a)
    rt_emit_bwd_str(a, "/")
    a.mov(1, 18) // pass
    rt_emit_itoa_bwd(a)
    a.vm_sub_imm(5, 15, 16)
    a.sub(5, 5, 0)
    a.mov(18, 0)
    a.mov(19, 5)
    a.vm_mov_imm(20, 1)
    a.call("_rt_write")
    a.epilogue()
    <<
}

// rt_dump_cover: per slot "<path>:<line> <count>\n" to stdout.
fn rt_emit_dump_cover(a $&Assembler) {
    a.label("_rt_dump_cover")
    a.prologue(640)
    a.vm_mov_imm(0, 0)
    a.store(15, -8, 0) // i = 0
    a.label("_rt_dc_loop")
    a.load(0, 15, -8)
    a.lea(1, "_xu_cover_n")
    a.load(1, 1, 0)
    a.cmp(0, 1)
    a.jge("_rt_dc_done")
    a.lea(1, "_xu_cover_files")
    a.mov(2, 0)
    a.shl_imm(2, 2, 3)
    a.add(1, 1, 2)
    a.load(2, 1, 0) // file idx
    a.lea(3, "_xu_cover_lines")
    a.mov(4, 0)
    a.shl_imm(4, 4, 3)
    a.add(3, 3, 4)
    a.load(4, 3, 0) // line
    a.store(15, -16, 4)
    a.lea(3, "_xu_cover_counts")
    a.mov(5, 0)
    a.shl_imm(5, 5, 3)
    a.add(3, 3, 5)
    a.load(5, 3, 0) // count
    a.store(15, -24, 5)
    a.mov(18, 2)
    a.vm_sub_imm(19, 15, 48)
    a.call("_rt_file_str")
    a.vm_sub_imm(0, 15, 72)
    rt_emit_bwd_str(a, "\n")
    a.load(1, 15, -24)
    rt_emit_itoa_bwd(a)
    rt_emit_bwd_str(a, " ")
    a.load(1, 15, -16)
    rt_emit_itoa_bwd(a)
    rt_emit_bwd_str(a, ":")
    a.load(1, 15, -40) // path len
    a.vm_cbz(1, "_rt_dc_nopath")
    a.load(2, 15, -48) // path ptr
    rt_emit_memcpy_bwd(a)
    a.label("_rt_dc_nopath")
    a.vm_sub_imm(5, 15, 72)
    a.sub(5, 5, 0)
    a.mov(18, 0)
    a.mov(19, 5)
    a.vm_mov_imm(20, 1)
    a.call("_rt_write")
    a.load(0, 15, -8)
    a.vm_add_imm(0, 0, 1)
    a.store(15, -8, 0)
    a.jmp("_rt_dc_loop")
    a.label("_rt_dc_done")
    a.epilogue()
    <<
}

// rt_test_setjmp(buf): save callee-saved regs + fp + lr + sp; << 0.
// xu_jmpbuf is 16×8 slots. arm64: x19-x28,fp,lr,sp; x64: rbx,r15,r12,r13,
// r14,rbp,rsp,retaddr.
fn rt_emit_test_setjmp(a $&Assembler) {
    a.label("_rt_test_setjmp")
    if a.arch == 1 {
        a.x64_store_offset(7, 0, 3)   // rbx
        a.x64_store_offset(7, 8, 15)  // r15
        a.x64_store_offset(7, 16, 12) // r12
        a.x64_store_offset(7, 24, 13) // r13
        a.x64_store_offset(7, 32, 14) // r14
        a.x64_store_offset(7, 40, 5)  // rbp
        a.x64_store_offset(7, 48, 4)  // rsp
        a.x64_load_offset(0, 4, 0)    // rax = [rsp] = retaddr
        a.x64_store_offset(7, 56, 0)  // retaddr
        a.x64_mov_imm(0, 0)
        a.x64_ret()
    } else if a.arch == 4 {
        // loong64: s0-s8 + fp + sp + ra (12 slots; jmpbuf is 16 slots).
        a.l_st_d(23, 4, 0)
        a.l_st_d(24, 4, 8)
        a.l_st_d(25, 4, 16)
        a.l_st_d(26, 4, 24)
        a.l_st_d(27, 4, 32)
        a.l_st_d(28, 4, 40)
        a.l_st_d(29, 4, 48)
        a.l_st_d(30, 4, 56)
        a.l_st_d(31, 4, 64)
        a.l_st_d(22, 4, 72)  // fp
        a.l_st_d(3, 4, 80)   // sp
        a.l_st_d(1, 4, 88)   // ra
        a.l_mov_imm(4, 0)
        a.l_ret()
    } else if a.arch == 5 {
        // riscv64: s0-s11 + sp + ra (14 slots; jmpbuf is 16 slots).
        a.v_sd(8, 10, 0)
        a.v_sd(9, 10, 8)
        a.v_sd(18, 10, 16)
        a.v_sd(19, 10, 24)
        a.v_sd(20, 10, 32)
        a.v_sd(21, 10, 40)
        a.v_sd(22, 10, 48)
        a.v_sd(23, 10, 56)
        a.v_sd(24, 10, 64)
        a.v_sd(25, 10, 72)
        a.v_sd(26, 10, 80)
        a.v_sd(27, 10, 88)
        a.v_sd(2, 10, 96)   // sp
        a.v_sd(1, 10, 104)  // ra
        a.v_mov_imm(10, 0)
        a.r_ret()
    } else {
        a.str(19, 0, 0)
        a.str(20, 0, 8)
        a.str(21, 0, 16)
        a.str(22, 0, 24)
        a.str(23, 0, 32)
        a.str(24, 0, 40)
        a.str(25, 0, 48)
        a.str(26, 0, 56)
        a.str(27, 0, 64)
        a.str(28, 0, 72)
        a.str(29, 0, 80)  // fp
        a.str(30, 0, 88)  // lr
        a.mov_reg(1, 31)  // x1 = sp
        a.str(1, 0, 96)   // sp
        a.mov_imm(0, 0)
        a.ret()
    }
    <<
}

// rt_test_longjmp(buf, value): restore regs and sp, << `value` via ret.
// M179: this is NOT stack unwinding — the test frame is abandoned; owning
// heap allocated in the test may leak. Documented in ACCEPTANCE.md (process
// is short-lived). Do not pretend drops run after longjmp.
fn rt_emit_test_longjmp(a $&Assembler) {
    a.label("_rt_test_longjmp")
    if a.arch == 1 {
        a.x64_load_offset(3, 7, 0)   // rbx
        a.x64_load_offset(15, 7, 8)  // r15
        a.x64_load_offset(12, 7, 16) // r12
        a.x64_load_offset(13, 7, 24) // r13
        a.x64_load_offset(14, 7, 32) // r14
        a.x64_load_offset(5, 7, 40)  // rbp
        a.x64_load_offset(1, 7, 48)  // rcx = saved rsp
        a.x64_mov_reg(4, 1)          // rsp = saved rsp
        a.x64_mov_reg(0, 6)          // rax = value (A1/RSI)
        a.x64_ret()
    } else if a.arch == 4 {
        a.l_ld_d(23, 4, 0)
        a.l_ld_d(24, 4, 8)
        a.l_ld_d(25, 4, 16)
        a.l_ld_d(26, 4, 24)
        a.l_ld_d(27, 4, 32)
        a.l_ld_d(28, 4, 40)
        a.l_ld_d(29, 4, 48)
        a.l_ld_d(30, 4, 56)
        a.l_ld_d(31, 4, 64)
        a.l_ld_d(22, 4, 72)  // fp
        a.l_ld_d(1, 4, 88)   // ra
        a.l_ld_d(20, 4, 80)  // T8 = saved sp
        a.l_or(3, 20, 0)     // sp = saved sp
        a.l_or(4, 5, 0)      // A0 = value (A1)
        a.l_ret()
    } else if a.arch == 5 {
        a.v_ld(8, 10, 0)
        a.v_ld(9, 10, 8)
        a.v_ld(18, 10, 16)
        a.v_ld(19, 10, 24)
        a.v_ld(20, 10, 32)
        a.v_ld(21, 10, 40)
        a.v_ld(22, 10, 48)
        a.v_ld(23, 10, 56)
        a.v_ld(24, 10, 64)
        a.v_ld(25, 10, 72)
        a.v_ld(26, 10, 80)
        a.v_ld(27, 10, 88)
        a.v_ld(31, 10, 96)   // t6 = saved sp
        a.r_mov(2, 31)       // sp = saved sp
        a.v_ld(1, 10, 104)   // ra
        a.r_mov(10, 11)      // a = value (a1)
        a.r_ret()
    } else {
        a.ldr(19, 0, 0)
        a.ldr(20, 0, 8)
        a.ldr(21, 0, 16)
        a.ldr(22, 0, 24)
        a.ldr(23, 0, 32)
        a.ldr(24, 0, 40)
        a.ldr(25, 0, 48)
        a.ldr(26, 0, 56)
        a.ldr(27, 0, 64)
        a.ldr(28, 0, 72)
        a.ldr(29, 0, 80)  // fp
        a.ldr(30, 0, 88)  // lr
        a.ldr(2, 0, 96)   // x2 = saved sp
        a.mov_reg(31, 2)  // sp = x2
        a.mov_reg(0, 1)   // x0 = value (A1)
        a.ret()
    }
    <<
}

fn rt_emit_test_soft_fail(a $&Assembler) {
    a.label("_rt_test_soft_fail")
    a.prologue(16)
    a.lea(0, "_xu_test_soft")
    a.vm_mov_imm(1, 1)
    a.store(0, 0, 1)
    a.epilogue()
    <<
}

fn rt_emit_test_clear(a $&Assembler) {
    a.label("_rt_test_clear")
    a.prologue(16)
    a.lea(0, "_xu_test_soft")
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.epilogue()
    <<
}

fn rt_emit_test_flags(a $&Assembler) {
    a.label("_rt_test_flags")
    a.prologue(16)
    a.lea(0, "_xu_test_soft")
    a.load(14, 0, 0)
    a.epilogue()
    <<
}

fn rt_emit_test_is_short(a $&Assembler) {
    a.label("_rt_test_is_short")
    a.prologue(16)
    a.lea(0, "_xu_test_short")
    a.load(14, 0, 0)
    a.epilogue()
    <<
}

fn rt_emit_test_skip(a $&Assembler) {
    a.label("_rt_test_skip")
    a.prologue(16)
    a.lea(18, "_xu_jmpbuf")
    a.vm_mov_imm(19, 2)
    a.call("_rt_test_longjmp")
    <<
}

// ===== rt_str_clone: A0/A1/A2 = source (ptr, len, cap), V0 = sret.
// cap == 0 (static literal) returns the descriptor unchanged; heap values
// get an exact-fit copy (cap = len). Internally uses rt_alloc.
