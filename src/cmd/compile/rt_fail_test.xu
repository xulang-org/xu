@main

#xu/types

fn rt_emit_oob(a $&Assembler) {
    a.data_label("_rt_oob_msg")
    rt_emit_bytes(a, "index out of bounds\n")
    a.label("_rt_oob")
    a.prologue(16)
    a.lea(18, "_rt_oob_msg")
    a.vm_mov_imm(19, 20)
    a.vm_mov_imm(20, 2) // stderr
    a.call("_rt_write")
    rt_exit(a, 1)
    a.epilogue()
    <<
}

fn rt_emit_as_fail(a $&Assembler) {
    a.data_label("_rt_as_fail_msg")
    rt_emit_bytes(a, "type assert failed\n")
    a.label("_rt_as_fail")
    a.prologue(16)
    a.lea(18, "_rt_as_fail_msg")
    a.vm_mov_imm(19, 19)
    a.vm_mov_imm(20, 2) // stderr
    a.call("_rt_write")
    rt_exit(a, 1)
    a.epilogue()
    <<
}

