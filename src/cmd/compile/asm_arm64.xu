@main
// ARM64 assembler, ported from bootstrap/crates/xuasm/src/lib.rs (which was
// ported from asm.js `asm/arm64.js`). Emit the whole program into one code
// buffer; references to not-yet-addressed labels are recorded as pending
// fixups and patched by `fixup_all()` once `code_vaddr`/`data_vaddr` have
// been assigned by the binary writer (two-pass addressing protocol).
//
// Authoring-subset notes:
// - No hex literals in Xu: every opcode constant is decimal, with the
//   reference hex value in a comment.
// - No HashMap: labels are a []Label scanned linearly.
// - All integers are i64; 32-bit instruction words are kept as non-negative
//   i64 values and masked on emission.
// - `>>` is an arithmetic shift; the fixup math below only ever divides
//   values that are exact multiples of the shift amount, so it matches the
//   reference's truncating `/`.

// register numbers (encoding shared with XZR where context dependent)
// SP = 31, XZR = 31, FP = 29, LR = 30, X16 = 16 (scratch)

// condition codes
// EQ = 0, NE = 1, HS = 2, LO = 3, VS = 6, HI = 8, LS = 9,
// GE = 10, LT = 11, GT = 12, LE = 13

// fixup kinds
// FK_B = 0, FK_BL = 1, FK_CBZ = 2, FK_CBNZ = 3, FK_ADRP_ADD = 4

struct Label {
    name    string
    offset  int
    is_data bool
}

// Free-fn field reads on `&[]Label` / `&[]Fixup`. `a.labels[i].name`
// through a large Assembler is a Gen1 3-level string-field miscompile
// (gen2 hello copies a garbage ptr). Same workaround as mfn_isval.
fn lab_name(ls &[]Label, i int) string { << ls[i].name + "" }
fn lab_name_len(ls &[]Label, i int) int { << ls[i].name.len }
fn lab_name_byte(ls &[]Label, i int, j int) int { << ls[i].name[j] }
fn lab_off(ls &[]Label, i int) int { << ls[i].offset }
fn lab_is_data(ls &[]Label, i int) bool { << ls[i].is_data }

struct Fixup {
    kind   int
    offset int
    label  string
    rd     int
}

fn fix_kind(fs &[]Fixup, i int) int { << fs[i].kind }
fn fix_off(fs &[]Fixup, i int) int { << fs[i].offset }
fn fix_label(fs &[]Fixup, i int) string { << asm_string_copy(&fs[i].label) }
fn fix_label_len(fs &[]Fixup, i int) int { << fs[i].label.len }
fn fix_rd(fs &[]Fixup, i int) int { << fs[i].rd }

// `s + ""` is only a descriptor alias under the hosted Gen1 ABI.  Fixup
// labels outlive the call that records them (they are resolved after all code
// emission), so retaining that alias can leave a dangling pointer when the
// producer returns a temporary label.  Materialise an independent string at
// this boundary instead.  Keep this helper local to the assembler so every
// backend can continue passing ordinary string values without an ownership
// convention hidden in Fixup.
fn asm_string_copy(s &string) string {
    if s.len == 0 {
        << ""
    }
    mut bytes := []int{}
    for i in 0:s.len {
        bytes.push(s[i])
    }
    << string_from_bytes(bytes)
}

// Target OS / arch on the assembler (M12). Compile-time only; selects
// encoder, syscall ABI, and binary writer. Defaults = host gen1 path.
//   OS:   0 = macos, 1 = linux, 2 = windows, 3 = none
//   ARCH: 0 = arm64, 1 = x64, 2 = thumb, 3 = riscv32

struct Assembler {
    // Not field 0: Gen1-compiled Gen2 misreads/miswrites the first
    // field of this large struct (emit32 saw ncode=0; `mut &a.code`
    // copied a garbage string header).
    pad0       int
    code       []int
    data       []int
    labels     []Label
    label_keys []string
    label_vals []int
    label_used []int
    label_n    int
    label_cap  int
    fixups     []Fixup
    code_vaddr int
    data_vaddr int
    drop_seq   int
    os         int
    arch       int
    // loong64 (M39): compare state recorded by be_cmp/be_cmp_imm/be_fcmp and
    // consumed by the immediately-following be_cset/be_jcc (LoongArch has no
    // condition flags). cmp_fp: 0 = integer regs in cmp_a/cmp_b, 1 = float
    // (operands already moved to F0/F1).
    cmp_fp     int
    cmp_a      int
    cmp_b      int
    // m32: emit-mode flags set by the driver before emit_program.
    cover      bool
    test       bool
    test_short bool
    // OPT P2/P3: block-local scalar register cache (hosted arm64/x64).
    rc_on      bool
    /// 0=off, 1=block cache, 2=carry+S-pool, 3=linear-scan pins.
    ra_level   int
    rc_carry   bool
    rc_s_pool  bool
    rc_ls      bool
    /// MIR function count for this unit. CopyProp/skip-store cost gate:
    /// self-host (~2841 fns) keeps the conservative frame writeback so
    /// gen2==gen3; user programs (<64) can skip pin stores like bootstrap.
    rc_nfn     int
    /// Labels of `fn_is_small_indexed_kernel` callees. Filled once per unit
    /// so rc_alu_fwd does not rescan all ~2800 fns on every ALU instr.
    rc_kern_labs []string
    /// 1 if the fn currently being emitted may ALU-forward (rc_off path).
    rc_alu_fwd_fn int
    /// Void scalar leaves whose A0..A{n-1} survive the call (Acc.add).
    rc_preserve_labs []string
    rc_preserve_mask []int
    /// Arm64: S0–S5 pairs saved in prologue (0..=3). Helpers keep 3.
    cs_pairs   int
    rc_wb      bool
    rc_leaf    bool
    /// Current block belongs to a proved uniform-pin natural loop.  Enables
    /// read-only pointer forwarding and the guarded conditional-update tier.
    rc_nat_wb  bool
    /// Next emit_store_scalar_temp may park_dirty+skip (ALU→index only).
    rc_alu_eph int
    /// One-use integer ALU result forwarded to the immediately following Bin.
    rc_int_ephem_t int
    rc_int_ephem_vr int
    rc_int_ephem_ii int
    rc_fused_cc int
    rc_branch_cond int
    rc_const_vr int
    rc_const_val int
    rc_hot_lbl string
    rc_slot    []int
    rc_used    []int
    rc_dirty   []int
    rc_alias   []int
    rc_tick    int
    rc_pin     []int
    rc_pin_dirty []int
    /// LoadLocal temp aliased onto an S-pool pin (arm64 O2); -1 = unused.
    rc_pin_alias []int
    /// Call-dest / reserved S home (arm64 O1): frame slot, -1 free, -2 reserved
    /// (AddrOf/const). Survives spill_across_call; not written back as pin_alias.
    rc_s_hold []int
    /// Block-entry S pin slots (arm64); not cleared by spill — StoreLocal sync.
    rc_blk_pin []int
    /// Sticky last slot parked in each S home (survives spill alias clear).
    rc_s_cache []int
    // M192b: per-block pred counts + pending cache restore (emit_function).
    rc_pred    []int
    rc_in_ok   []int
    rc_in_slot []int
    rc_in_dirty []int
    rc_in_alias []int
    rc_in_used []int
    rc_in_tick []int
    rc_in_pin  []int
    oob_lbl    string
    oob_need   int
    // SIMD/XMM f64 homes (hosted arm64/x64). ARM64: d2–d7 + d16–d31.
    // x64: xmm2–xmm7. d0/d1 stay operand scratch in rc_fp_operand_d.
    rc_fp_pin   []int
    rc_fp_dirty []int
    rc_fp_alias []int
    rc_fp_alias2 []int
    rc_fp_rhs   int
    /// When >= 0: FieldRMW should `fmadd`/`fmsub` d0 with (d1 * rc_fp_fma_dm)
    /// instead of add/sub of a fully-multiplied rhs (nbody `dx*mj*mag`).
    rc_fp_fma_dm int
    /// Ephemeral f64 temp in d0 (single next FP consumer); -1 = empty.
    /// Keeps d2–d7 free for pinned locals / masses (nbody mj/mi).
    rc_fp_ephem int
    rc_fp_skip  int
    /// Second instr to skip after rc_fp_skip (mul*mul→RMW peeks LoadLocal).
    rc_fp_skip2 int
    /// Third skip (nbody mag: LoadLocal dt fuses LoadLocal+mul+div).
    rc_fp_skip3 int
    rc_fp_skip4 int
    /// Skip the next N instrs along the block chain (Clang isel windows).
    rc_fp_skip_n int
    /// push_byte header cache. pb_local >= 0 means S1–S4 hold &string,
    /// ptr, len and cap for that local. Invalid across blocks and calls.
    pb_recv int
    pb_local int
    /// Block currently being emitted (for def-before-use store elision).
    rc_cur_bi   int
    rc_fp_blk   []int
    /// FP-only loop residency; intentionally independent from the GPR regcache.
    rc_fp_only   bool
    /// Set when a GPR vreg plan left the SIMD pool free. setup_walk turns
    /// this into rc_fp_only and runs the full f64 pin collector (nbody).
    rc_fp_hold   bool
    /// Bit i set: vreg owns physical GPR i. RC must not park or pick it.
    rc_vreg_mask int
    /// Blocks in a proved multi-block natural loop.  Intra-loop edges may
    /// jump to the block's hot entry and keep the common pin layout live.
    rc_loop_hot []int
    /// Leaf: 1-slot incoming args still in A0–A5 (no park mov). -1 = empty.
    rc_arg      []int
    rc_arg_alias []int
    /// Emit-hoisted AddrOf(Local): S reg holds &local across bl.
    rc_addr_local int
    rc_addr_vr    int
    rc_addr_alias int
    /// Block-local array data-pointer cache (arm64): keys in rc_arr_t0/t1,
    /// sticky values in V6/V7. Survives element RMW; invalidated on calls.
    rc_arr_t0     int
    rc_arr_t1     int
    rc_cur_arr    int
    /// Dest temp of the first ElemAddr in this function (nbody `sys[i]`).
    /// Same-index re-emits update the dest and clear `rc_fp_inv_ld`.
    /// A later ElemAddr with a different index (`sys[j]`) does not overwrite.
    /// -1 = empty. Not cleared by rc_flush (cross-block emit).
    rc_fp_inv_t   int
    rc_fp_inv_idx int
    /// 1 after vx/vy/vz were filled into d28–d30 for the current inv pointer.
    rc_fp_inv_ld  int
    /// GPR holding the last ElemAddr pointer (nbody sys[j] in x24 / S5).
    /// -1 = empty. S5 is outside rc_slot[0..7], so rc_park cannot record it.
    rc_elem_vr    int
    /// Clang-style row walk: V6/V7 hold data+hoist*8 (keys = arr temps).
    rc_row_k0     int
    rc_row_k1     int
    /// Arm64 self-loop: hoisted loc_a*loc_b for a*b+j (keys; -1 = empty).
    /// Homes: V4/V5 when s_pool, else S0/S1.
    rc_madd_k0    int
    rc_madd_k1    int
    /// Self-loop induction local id (-1 = none).
    rc_ind_local  int
    /// 1 = small read-only indexed diamond (skip-store + `_ht`).
    /// 2 = assign-diamond only (nocheck / seed, no forward `_ht`).
    rc_kernel     int
    /// Forward hot-edge `_ht` without kernel skip-store / V6 seed.
    /// 1-slot `&[]T` search: skip pin reload on header→body.
    rc_fwd_ht     bool
    /// 1 after seeding a self-loop `i < L` with arr.len >= L (skip per-iter OOB).
    rc_ind_nocheck int
    /// Proven descriptors for rc_ind_nocheck (at most two; -1 = unset).
    /// The consumer must match the current access descriptor against these:
    /// a third array in the loop never gets a length proof.
    rc_ind_desc0 int
    rc_ind_desc1 int
    /// 0 = off; M+1 = header proved arr.len > M for `x & M` indexes (0≤M≤255).
    rc_and_nocheck int
    /// Proven descriptors for rc_and_nocheck (at most two; -1 = unset).
    /// The consumer must match the current access descriptor against these:
    /// a third array in the loop never gets a mask proof.
    rc_and_desc0 int
    rc_and_desc1 int
    /// Row-walk madd: local of the invariant operand parked in S4 (-1 = none).
    rc_aik_loc    int
    /// Word-ArrPush cursor: local id (-1 none). S1=len, S2=cap, S3=ptr.
    rc_push_loc     int
    rc_push_ptr_off int
    rc_push_len_off int
    rc_push_cap_off int
    rc_push_dirty   int
    rc_push_ii      int
    rc_push_elem    int
    rc_push_val_loc int
    rc_push_stub    int
    rc_push_slow    string
    rc_push_done    string
    rc_push_fuse    int
    /// Deferred home+ind for index-only temps (matmul). Empty: temp < 0.
    rc_fold_t0    int
    rc_fold_t1    int
    rc_fold_h0    int
    rc_fold_h1    int
    rc_fold_i0    int
    rc_fold_i1    int
    rc_fold_u0    int
    rc_fold_u1    int
    /// Per-fn GPR pin table (nblk*4). Lives on Assembler (heap) so Gen2
    /// cannot corrupt a frame-local []int header in large emit_function.
    rc_pins       []int
    // --lib / --shared / link .dylib (driver fills before emit_program)
    lib           int
    dylib_paths   []string
    dylib_labs    []string
    dylib_ords    []int
    lib_exp_name  []string
    lib_exp_off   []int
    // Stage 0 OptStats: RA admission observation only. Never changes coloring.
    ra_fn      int
    ra_try     int
    ra_vreg    int
    ra_rc      int
    ra_frame   int
    ra_keep_rc int
    ra_empty   int
    ra_spill   int
    ra_report  bool // per-function diagnostics, enabled only by --timings
    // Data-segment offset of `_xus_{i}` string literals (fixup kind 5).
    xus_off       []int
    // Immutable per-function rotate proof, invalidated before every function.
    rc_ror32_facts []int
}

// Fill a zeroed Assembler in place. Do not return Assembler by value:
// Gen1 sret of this large struct is garbage in gen2 (hello copies a
// wild string header at 0x16fe00000). Mirror Checker{}.
fn init_assembler(a &mut Assembler, os int, arch int) {
    a.os = os
    a.arch = arch
    a.label_cap = 256
    a.rc_on = os != 3 && arch == 0
    a.rc_fp_hold = false
    a.rc_vreg_mask = 0
    a.ra_level = 1
    a.cs_pairs = 3
    a.rc_int_ephem_t = -1
    a.rc_int_ephem_vr = -1
    a.rc_int_ephem_ii = -1
    a.rc_fused_cc = -1
    a.rc_branch_cond = -1
    a.rc_const_vr = -1
    a.rc_fp_rhs = -1
    a.rc_fp_fma_dm = -1
    a.rc_fp_ephem = -1
    a.rc_fp_skip = -1
    a.rc_fp_skip2 = -1
    a.rc_fp_skip3 = -1
    a.rc_fp_skip4 = -1
    a.pb_recv = -1
    a.pb_local = -1
    a.rc_cur_bi = -1
    a.rc_addr_local = -1
    a.rc_addr_vr = -1
    a.rc_addr_alias = -1
    a.rc_arr_t0 = -1
    a.rc_arr_t1 = -1
    a.rc_cur_arr = -1
    a.rc_fp_inv_t = -1
    a.rc_fp_inv_idx = -1
    a.rc_fp_inv_ld = 0
    a.rc_elem_vr = -1
    a.rc_row_k0 = -1
    a.rc_row_k1 = -1
    a.rc_madd_k0 = -1
    a.rc_madd_k1 = -1
    a.rc_ind_local = -1
    a.rc_and_nocheck = 0
    a.rc_aik_loc = -1
    a.rc_push_loc = -1
    a.rc_push_ii = -1
    a.rc_push_elem = -1
    a.rc_push_val_loc = -1
    a.rc_fold_t0 = -1
    a.rc_fold_t1 = -1
    for i in 0:a.label_cap {
        a.label_keys.push("")
        a.label_vals.push(0)
        a.label_used.push(0)
    }
    a.xus_off = []int{}
    for i in 0:8 {
        a.rc_slot.push(-1)
        a.rc_used.push(0)
        a.rc_dirty.push(0)
        a.rc_alias.push(-1)
    }
    for i in 0:4 {
        a.rc_pin.push(-1)
        a.rc_pin_dirty.push(0)
        a.rc_pin_alias.push(-1)
        a.rc_s_hold.push(-1)
        a.rc_blk_pin.push(-1)
        a.rc_s_cache.push(-1)
    }
    nhf := rc_fp_homes()
    for i in 0:nhf {
        a.rc_fp_pin.push(-1)
        a.rc_fp_dirty.push(0)
        a.rc_fp_alias.push(-1)
        a.rc_fp_alias2.push(-1)
    }
    for i in 0:6 {
        a.rc_arg.push(-1)
        a.rc_arg_alias.push(-1)
    }
}

// Parse hosted five-target plus E0 freestanding, plus M39 loong64.
// Returns os*10+arch, or -1 if unknown.
// os: 0 macos, 1 linux, 2 windows, 3 none
// arch: 0 arm64, 1 x64, 2 thumb, 3 riscv32, 4 loong64
fn parse_target(s string) int {
    if s == "wasm32" { << 46 }
    if s == "macos-arm64" { << 0 }
    if s == "macos-x64" { << 1 }
    if s == "linux-arm64" { << 10 }
    if s == "linux-x64" { << 11 }
    if s == "linux-loongarch64" { << 14 }
    if s == "linux-riscv64" { << 15 }
    if s == "linux-arm32" { << 12 }
    if s == "linux-arm" { << 12 }
    if s == "linux-armv7" { << 12 }
    if s == "windows-x64" { << 21 }
    if s == "windows-arm64" { << 20 }
    if s == "thumbv7em-none" { << 32 }
    if s == "thumb-none" { << 32 }
    if s == "riscv32imac-none" { << 33 }
    if s == "riscv32-none" { << 33 }
    << -1
}

// XUOS + XUARCH (host OS/arch env names). Both must be set and valid.
// --target on the CLI wins; callers apply this only when --target is omitted.
fn target_from_env() int {
    osn := env_get("XUOS")
    archn := env_get("XUARCH")
    if osn.len == 0 {
        << -1
    }
    if archn.len == 0 {
        << -1
    }
    mut name := ""
    if osn == "none" {
        if archn == "thumb" || archn == "thumbv7em" || archn == "arm32" || archn == "armv7" || archn == "arm" {
            name = "thumbv7em-none"
        }
        if archn == "riscv32" || archn == "riscv32imac" {
            name = "riscv32imac-none"
        }
    } else {
        mut os_part := ""
        if osn == "macos" { os_part = "macos" }
        if osn == "linux" { os_part = "linux" }
        if osn == "windows" { os_part = "windows" }
        mut arch_part := ""
        if archn == "arm64" || archn == "aarch64" { arch_part = "arm64" }
        if archn == "x64" || archn == "x86_64" || archn == "amd64" { arch_part = "x64" }
        if archn == "loong64" || archn == "loongarch64" { arch_part = "loongarch64" }
        if archn == "riscv64" || archn == "rv64" { arch_part = "riscv64" }
        if archn == "arm32" || archn == "armv7" || archn == "arm" || archn == "thumb" || archn == "thumbv7em" {
            arch_part = "arm32"
        }
        if os_part.len > 0 && arch_part.len > 0 {
            name = os_part + "-" + arch_part
        }
    }
    if name.len == 0 {
        << -1
    }
    << parse_target(name)
}

fn apply_env_target(target_set bool, target_code int) int {
    if target_set {
        << target_code
    }
    te := target_from_env()
    if te >= 0 {
        << te
    }
    << host_target_code()
}

// Bootstrap bridge for callers that already own argv.  Old hosted runtimes
// returned a shallow sys_args descriptor, so asking for argv again after CLI
// parsing could observe freed elements before the new deep-clone runtime had
// bootstrapped itself.
fn apply_env_target_host(target_set bool, target_code int, host_code int) int {
    if target_set {
        << target_code
    }
    te := target_from_env()
    if te >= 0 {
        << te
    }
    << host_code
}

fn target_os(t int) int { << t / 10 }
fn target_arch(t int) int { << t % 10 }

// Thumb / RV32 are ILP32. Hosted linux-arm32 reuses the Thumb ISA.
fn ptr_shift(arch int) int {
    if arch == 2 { << 2 }
    if arch == 3 { << 2 }
    << 3
}

fn ptr_bytes(arch int) int {
    if arch == 2 { << 4 }
    if arch == 3 { << 4 }
    << 8
}

fn target_os_name(t int) string {
    o := target_os(t)
    if o == 0 { << "macos" }
    if o == 1 { << "linux" }
    if o == 2 { << "windows" }
    if o == 3 { << "none" }
    if o == 4 { << "wasm" }
    << ""
}

fn target_arch_name(t int) string {
    if t == 46 { << "wasm32" }
    a := target_arch(t)
    if a == 0 { << "arm64" }
    if a == 1 { << "x64" }
    if a == 2 { << "thumb" }
    if a == 3 { << "riscv32" }
    if a == 4 { << "loong64" }
    if a == 5 { << "riscv64" }
    << ""
}

fn target_name(t int) string {
    if t == 46 { << "wasm32" }
    if t == 0 { << "macos-arm64" }
    if t == 1 { << "macos-x64" }
    if t == 10 { << "linux-arm64" }
    if t == 11 { << "linux-x64" }
    if t == 14 { << "linux-loongarch64" }
    if t == 15 { << "linux-riscv64" }
    if t == 12 { << "linux-arm32" }
    if t == 20 { << "windows-arm64" }
    if t == 21 { << "windows-x64" }
    if t == 32 { << "thumbv7em-none" }
    if t == 33 { << "riscv32imac-none" }
    << "unknown"
}

// Syscall numbers (Sys enum: 0=Exit 1=Write 2=Mmap 3=Munmap 4=Open 5=Read
// 6=Close 7=Clone 8=Futex 9=Getdents 10=ClockGettime 11=Nanosleep
// 12..17 uid/gid/pid family 18=Uname 19=Getcwd 20=Stat 21=Mkdir 22=Rename
// 23=Unlink 24=Rmdir 25=Socket 26=Connect 27=Bind 28=Listen 29=Accept
// 30=Setsockopt 31=Sendto 32=Recvfrom 33=UlockWait 34=UlockWake).
fn syscall_number(os int, arch int, sys int) int {
    if os == 0 { // macos BSD class 0x2000000
        if sys == 0 { << 33554433 } // exit
        if sys == 1 { << 33554436 } // write
        if sys == 2 { << 33554629 } // mmap
        if sys == 3 { << 33554505 } // munmap
        if sys == 4 { << 33554437 } // open
        if sys == 5 { << 33554435 } // read
        if sys == 6 { << 33554438 } // close
        if sys == 9 { << 33554776 } // getdirentries64
        if sys == 10 { << 0 } // clock_gettime: libSystem IAT
        if sys == 11 { << 0 } // nanosleep: libSystem IAT
        if sys == 12 { << 33554452 } // getpid
        if sys == 13 { << 33554471 } // getppid
        if sys == 14 { << 33554456 } // getuid
        if sys == 15 { << 33554479 } // getgid
        if sys == 16 { << 33554457 } // geteuid
        if sys == 17 { << 33554475 } // getegid
        if sys == 18 { << 0 } // uname: libSystem gethostname IAT
        if sys == 19 { << 0 } // getcwd: libSystem IAT
        if sys == 20 { << 33554770 } // stat64 = 0x2000000+338
        if sys == 21 { << 33554568 } // mkdir = 0x2000000+136
        if sys == 22 { << 33554560 } // rename = 0x2000000+128
        if sys == 23 { << 33554442 } // unlink = 0x2000000+10
        if sys == 24 { << 33554569 } // rmdir = 0x2000000+137
        if sys == 25 { << 33554529 } // socket = 0x2000000+97
        if sys == 26 { << 33554530 } // connect = 0x2000000+98
        if sys == 27 { << 33554536 } // bind = 0x2000000+104
        if sys == 28 { << 33554538 } // listen = 0x2000000+106
        if sys == 29 { << 33554462 } // accept = 0x2000000+30
        if sys == 30 { << 33554537 } // setsockopt = 0x2000000+105
        if sys == 31 { << 33554565 } // sendto = 0x2000000+133
        if sys == 32 { << 33554461 } // recvfrom = 0x2000000+29
        if sys == 33 { << 33554947 } // ulock_wait = 0x2000000+515
        if sys == 34 { << 33554948 } // ulock_wake = 0x2000000+516
        if sys == 39 { << 33554447 } // chmod = 0x2000000+15
        if sys == 40 { << 33554444 } // chdir = 0x2000000+12
        if sys == 41 { << 33554489 } // symlink = 0x2000000+57
        if sys == 42 { << 33554490 } // readlink = 0x2000000+58
        if sys == 43 { << 33554631 } // lseek = 0x2000000+199
        if sys == 44 { << 33554474 } // pipe = 0x2000000+42
        if sys == 36 { << 33554434 } // fork = 0x2000000+2
        if sys == 37 { << 33554491 } // execve = 0x2000000+59
        if sys == 38 { << 33554439 } // wait4 = 0x2000000+7
        if sys == 45 { << 33554522 } // dup2 = 0x2000000+90
        if sys == 46 { << 33554486 } // ioctl = 0x2000000+54
        << 0
    }
    if os == 1 && arch == 2 { // linux ARM EABI (not the generic aarch64 table)
        if sys == 0 { << 248 } // exit_group
        if sys == 1 { << 4 } // write
        if sys == 2 { << 192 } // mmap2
        if sys == 3 { << 91 } // munmap
        if sys == 4 { << 322 } // openat
        if sys == 5 { << 3 } // read
        if sys == 6 { << 6 } // close
        if sys == 7 { << 120 } // clone
        if sys == 8 { << 240 } // futex
        if sys == 9 { << 217 } // getdents64
        if sys == 10 { << 263 } // clock_gettime
        if sys == 11 { << 162 } // nanosleep
        if sys == 12 { << 20 } // getpid
        if sys == 13 { << 64 } // getppid
        if sys == 14 { << 24 } // getuid
        if sys == 15 { << 47 } // getgid
        if sys == 16 { << 49 } // geteuid
        if sys == 17 { << 50 } // getegid
        if sys == 18 { << 122 } // uname
        if sys == 19 { << 183 } // getcwd
        if sys == 20 { << 327 } // newfstatat
        if sys == 21 { << 323 } // mkdirat
        if sys == 22 { << 329 } // renameat
        if sys == 23 { << 328 } // unlinkat
        if sys == 24 { << 328 } // unlinkat (AT_REMOVEDIR)
        if sys == 25 { << 281 } // socket
        if sys == 26 { << 283 } // connect
        if sys == 27 { << 282 } // bind
        if sys == 28 { << 284 } // listen
        if sys == 29 { << 285 } // accept
        if sys == 30 { << 294 } // setsockopt
        if sys == 31 { << 290 } // sendto
        if sys == 32 { << 292 } // recvfrom
        if sys == 36 { << 120 } // clone
        if sys == 37 { << 11 } // execve
        if sys == 38 { << 114 } // wait4
        if sys == 39 { << 333 } // fchmodat
        if sys == 40 { << 12 } // chdir
        if sys == 41 { << 331 } // symlinkat
        if sys == 42 { << 332 } // readlinkat
        if sys == 43 { << 19 } // lseek
        if sys == 44 { << 359 } // pipe2
        if sys == 45 { << 358 } // dup3
        if sys == 46 { << 54 } // ioctl
        if sys == 47 { << 143 } // flock
        << 0
    }
    if os == 1 && (arch == 0 || arch == 4 || arch == 5) { // linux arm64 / loong64 / riscv64 (generic table)
        if sys == 0 { << 94 } // exit_group
        if sys == 1 { << 64 }
        if sys == 2 { << 222 }
        if sys == 3 { << 215 }
        if sys == 4 { << 56 } // openat
        if sys == 5 { << 63 }
        if sys == 6 { << 57 }
        if sys == 7 { << 220 } // clone
        if sys == 8 { << 98 } // futex
        if sys == 9 { << 61 } // getdents64
        if sys == 10 { << 113 } // clock_gettime
        if sys == 11 { << 101 } // nanosleep
        if sys == 12 { << 172 } // getpid
        if sys == 13 { << 173 } // getppid
        if sys == 14 { << 174 } // getuid
        if sys == 15 { << 176 } // getgid
        if sys == 16 { << 175 } // geteuid
        if sys == 17 { << 177 } // getegid
        if sys == 18 { << 160 } // uname
        if sys == 19 { << 17 } // getcwd
        if sys == 20 { << 79 } // newfstatat
        if sys == 21 { << 34 } // mkdirat
        if sys == 22 { << 38 } // renameat
        if sys == 23 { << 35 } // unlinkat
        if sys == 24 { << 35 } // unlinkat (AT_REMOVEDIR)
        if sys == 25 { << 198 } // socket
        if sys == 26 { << 203 } // connect
        if sys == 27 { << 200 } // bind
        if sys == 28 { << 201 } // listen
        if sys == 29 { << 202 } // accept
        if sys == 30 { << 208 } // setsockopt
        if sys == 31 { << 206 } // sendto
        if sys == 32 { << 207 } // recvfrom
        if sys == 36 { << 220 } // clone (fork-like)
        if sys == 37 { << 221 } // execve
        if sys == 38 { << 260 } // wait4
        if sys == 39 { << 53 } // fchmodat
        if sys == 40 { << 49 } // chdir
        if sys == 41 { << 36 } // symlinkat
        if sys == 42 { << 78 } // readlinkat
        if sys == 43 { << 62 } // lseek
        if sys == 44 { << 59 } // pipe2
        if sys == 45 { << 24 } // dup3
        if sys == 46 { << 29 } // ioctl
        if sys == 47 { << 32 } // flock
        << 0
    }
    if os == 1 && arch == 1 { // linux x64
        if sys == 0 { << 231 } // exit_group
        if sys == 1 { << 1 }
        if sys == 2 { << 9 }
        if sys == 3 { << 11 }
        if sys == 4 { << 2 }
        if sys == 5 { << 0 }
        if sys == 6 { << 3 }
        if sys == 7 { << 56 } // clone
        if sys == 8 { << 202 } // futex
        if sys == 9 { << 217 } // getdents64
        if sys == 10 { << 228 } // clock_gettime
        if sys == 11 { << 35 } // nanosleep
        if sys == 12 { << 39 } // getpid
        if sys == 13 { << 110 } // getppid
        if sys == 14 { << 102 } // getuid
        if sys == 15 { << 104 } // getgid
        if sys == 16 { << 107 } // geteuid
        if sys == 17 { << 108 } // getegid
        if sys == 18 { << 63 } // uname
        if sys == 19 { << 79 } // getcwd
        if sys == 20 { << 4 } // stat
        if sys == 21 { << 83 } // mkdir
        if sys == 22 { << 82 } // rename
        if sys == 23 { << 263 } // unlinkat
        if sys == 24 { << 263 } // unlinkat (AT_REMOVEDIR)
        if sys == 25 { << 41 } // socket
        if sys == 26 { << 42 } // connect
        if sys == 27 { << 49 } // bind
        if sys == 28 { << 50 } // listen
        if sys == 29 { << 43 } // accept
        if sys == 30 { << 54 } // setsockopt
        if sys == 31 { << 44 } // sendto
        if sys == 32 { << 45 } // recvfrom
        if sys == 36 { << 57 } // fork
        if sys == 37 { << 59 } // execve
        if sys == 38 { << 61 } // wait4
        if sys == 39 { << 90 } // chmod
        if sys == 40 { << 80 } // chdir
        if sys == 41 { << 88 } // symlink
        if sys == 42 { << 89 } // readlink
        if sys == 43 { << 8 } // lseek
        if sys == 44 { << 22 } // pipe
        if sys == 45 { << 33 } // dup2
        if sys == 46 { << 16 } // ioctl
        if sys == 47 { << 73 } // flock
        << 0
    }
    << 0 // windows: not used
}

fn linux_exit_thread(arch int) int {
    if arch == 0 { << 93 }
    if arch == 4 { << 93 } // loong64 uses the generic table, same as arm64
    if arch == 5 { << 93 } // riscv64 uses the generic table, same as arm64
    << 60
}

fn mmap_flags(os int) int {
    if os == 0 { << 4098 } // MAP_PRIVATE|MAP_ANON
    if os == 1 { << 34 } // MAP_PRIVATE|MAP_ANONYMOUS
    << 0
}

fn open_flags_write(os int) int {
    if os == 0 { << 1537 } // 0x601
    if os == 1 { << 577 } // 0x241
    << 0
}

fn open_flags_excl(os int) int {
    if os == 0 { << 2561 } // O_WRONLY|O_CREAT|O_EXCL
    if os == 1 { << 193 } // O_WRONLY|O_CREAT|O_EXCL
    << 0
}

fn open_flags_mode(os int, mode int) int {
    if mode == 1 {
        << open_flags_write(os)
    }
    if mode == 2 {
        if os == 0 { << 521 } // O_WRONLY|O_CREAT|O_APPEND
        if os == 1 { << 1089 } // 1|64|1024
        << 0
    }
    if mode == 3 {
        << open_flags_excl(os)
    }
    << 0
}

// Unique label for drop sequences (program-wide counter on the assembler).
fn (a &mut Assembler) drop_label(kind string) string {
    a.drop_seq = a.drop_seq + 1
    << "_xudrop_" + str(a.drop_seq) + "_" + kind
}

// Append one 32-bit instruction word, little-endian.
// Gen2 cannot `mut &a.code` + push4 (wrong field / SEGV). Four `a.code.push`
// writes persist.
fn (a &mut Assembler) emit32(word int) {
    a.code.push(word & 255)
    a.code.push((word >> 8) & 255)
    a.code.push((word >> 16) & 255)
    a.code.push((word >> 24) & 255)
}

fn (a &mut Assembler) emit64(val int) {
    a.emit32(val & 4294967295)
    a.emit32((val >> 32) & 4294967295)
}

// Current byte offset in the code buffer.
fn (a Assembler) current_offset() int { << a.code.len }

fn label_hash(s &string) int {
    mut h := 5381
    for i in 0:s.len {
        h = ((h << 5) + h) + (s[i] & 255)
        h = h & 2147483647
    }
    << h
}

// Block labels share numeric/_ht suffixes. Raw djb2 low bits cluster badly
// in this power-of-two table. Mix only the bucket selector: label hashes,
// stable symbol IDs, full-name equality and relocation formats stay intact.
// Mask after each multiply so this uses the same low 31 bits on every target.
fn label_bucket(h int, cap int) int {
    if cap <= 0 { << 0 }
    mut mixed := ((h ^ (h >> 16)) * 73244475) & 2147483647
    mixed = ((mixed ^ (mixed >> 16)) * 73244475) & 2147483647
    << (mixed ^ (mixed >> 16)) & (cap - 1)
}

fn (a &mut Assembler) label_index_grow() {
    old_cap := a.label_cap
    mut ncap := old_cap * 2
    if ncap < 1024 {
        ncap = 1024
    }
    if ncap <= 0 {
        <<
    }
    mut new_keys := []string{}
    mut new_vals := []int{}
    mut new_used := []int{}
    for i in 0:ncap {
        new_keys.push("")
        new_vals.push(0)
        new_used.push(0)
    }
    mask := ncap - 1
    for i in 0:old_cap {
        if a.label_used[i] == 1 {
            // Rehashing is an ownership boundary: the old table is released
            // immediately after these arrays are swapped, so a descriptor
            // alias would leave every moved key dangling.  Copy bytes into a
            // fresh string before installing the key in the new table.
            key0 := a.label_keys[i] + ""
            key := asm_string_copy(&key0)
            h := label_hash(&key)
            mut j := label_bucket(h, ncap)
            while true {
                if new_used[j] == 0 {
                    new_used[j] = 1
                    new_keys[j] = key
                    new_vals[j] = a.label_vals[i]
                    <-
                }
                j = (j + 1) & mask
            }
        }
    }
    a.label_keys = new_keys
    a.label_vals = new_vals
    a.label_used = new_used
    a.label_cap = ncap
}

fn (a &mut Assembler) label_index_put(name string, idx int) {
    if a.label_cap <= 0 {
        a.label_cap = 1024
        for i in 0:a.label_cap {
            a.label_keys.push("")
            a.label_vals.push(0)
            a.label_used.push(0)
        }
    }
    if (a.label_n + 1) * 4 >= a.label_cap * 3 {
        a.label_index_grow()
    }
    cap := a.label_cap
    if cap <= 0 {
        <<
    }
    h := label_hash(&name)
    mask := cap - 1
    mut i := label_bucket(h, cap)
    while true {
        if a.label_used[i] == 0 {
            a.label_used[i] = 1
            owned := asm_string_copy(&name)
            a.label_keys[i] = owned
            a.label_vals[i] = idx
            a.label_n += 1
            <<
        }
        if a.label_keys[i] == name {
            eprintln("duplicate assembly label: " + name)
            <<< 1
        }
        i = (i + 1) & mask
    }
}

fn (a Assembler) label_index(name string) int {
    cap := a.label_cap
    if cap <= 0 {
        << -1
    }
    h := label_hash(&name)
    mask := cap - 1
    mut i := label_bucket(h, cap)
    start := i
    while true {
        if a.label_used[i] == 0 {
            << -1
        }
        if a.label_keys[i] == name {
            << a.label_vals[i]
        }
        i = (i + 1) & mask
        if i == start {
            << -1
        }
    }
    << -1
}

// Full-name interning yields a stable Label index even before definition.
// Hashes choose a probe bucket; they never identify a relocation target.
fn (a &Assembler) label_index_ref(name &string) int {
    if a.label_cap <= 0 { << -1 }
    mask := a.label_cap - 1
    mut i := label_bucket(label_hash(name), a.label_cap)
    start := i
    while a.label_used[i] != 0 {
        mut same := a.label_keys[i].len == name.len
        if same {
            for j in 0:name.len {
                if a.label_keys[i][j] != name[j] { same = false
                    <- }
            }
        }
        if same { << a.label_vals[i] }
        i = (i + 1) & mask
        if i == start { << -1 }
    }
    << -1
}

fn (a &mut Assembler) label_symbol(name &string) int {
    existing := a.label_index_ref(name)
    if existing >= 0 { << existing }
    owned := asm_string_copy(name)
    key := asm_string_copy(name)
    a.labels.push(Label{name: owned, offset: -1, is_data: false})
    idx := a.labels.len - 1
    a.label_index_put(key, idx)
    << idx
}

fn lab_define(ls &mut []Label, idx int, off int, data bool) {
    ls[idx].offset = off
    ls[idx].is_data = data
}

fn (a &mut Assembler) define_label(name &string, off int, data bool) {
    idx := a.label_symbol(name)
    if lab_off(&a.labels, idx) >= 0 {
        eprintln("duplicate assembly label: " + name)
        <<< 1
    }
    lab_define(mut &a.labels, idx, off, data)
}

// Pad the code buffer so `code.len` is a multiple of `n`.
fn (a &mut Assembler) align_code(n int) {
    if n <= 1 {
        <<
    }
    if n <= 0 {
        <<
    }
    rem := a.code.len % n
    if rem == 0 {
        <<
    }
    pad := n - rem
    for i in 0:pad {
        if a.arch == 1 {
            a.x64_nop()
        } else {
            a.code.push(144)
        }
    }
}

// Define a code-segment label at the current code offset.
fn (a &mut Assembler) label(name string) {
    // x64: 16-byte-align every code label. WoA's x64 emulator has been
    // observed to drop a tiny PE whose `call` targets (e.g. collect_args)
    // land on an odd address, while the same glue at an even RVA in the
    // large compiler image runs.
    if a.arch == 1 {
        a.align_code(16)
    }
    // Hoisted: the push mutably borrows `a`, so `a.code.len` cannot be
    // read inside the same call expression.
    a.code_label_at(name, a.code.len)
}

// Register a decided block-entry alias at its captured code offset.
fn (a &mut Assembler) code_label_at(name string, off int) {
    a.define_label(&name, off, false)
}

// Define a data-segment label at the current data offset.
fn (a &mut Assembler) data_label(name string) {
    a.define_label(&name, a.data.len, true)
}

// Append raw bytes to the data buffer.
fn (a &mut Assembler) emit_data(bytes []int) {
    for b in bytes {
        a.data.push(b & 255)
    }
}

// Offset of a label within its segment, 0 if undefined (mirrors the
// reference's `unwrap_or(0)` used for the `_start` lookup).
fn (a Assembler) label_offset(name string) int {
    idx := a.label_index(name)
    if idx >= 0 && idx < a.labels.len {
        << lab_off(&a.labels, idx)
    }
    << 0
}

fn (a Assembler) label_is_data(name string) bool {
    idx := a.label_index(name)
    if idx >= 0 && idx < a.labels.len {
        << lab_is_data(&a.labels, idx)
    }
    << false
}

fn (a Assembler) is_dylib_lab(lab string) bool {
    for i in 0:a.dylib_labs.len {
        if a.dylib_labs[i] == lab {
            << true
        }
    }
    << false
}

fn iat_from_xu_label(lab string) string {
    s := lab + ""
    if s.len > 0 {
        c := s[0]
        if c == 95 {
            << "_iat_" + s[1:s.len]
        }
    }
    << "_iat_" + s
}

fn (a &mut Assembler) call_user(lab string) {
    name := lab + ""
    if a.is_dylib_lab(name + "") {
        a.vm_call_iat(iat_from_xu_label(name + ""))
        <<
    }
    a.call(name)
}

fn (a &mut Assembler) align_data(n int) {
    if n <= 0 {
        <<
    }
    rem := a.data.len % n
    if rem == 0 {
        <<
    }
    pad := n - rem
    for i in 0:pad {
        a.data.push(0)
    }
}

fn (a Assembler) label_addr(name string) int {
    // `label_index` takes ownership of its argument under the hosted ABI;
    // passing `name + ""` can therefore consume/poison the caller's
    // descriptor before the diagnostic below.  Keep independent copies for
    // lookup and reporting.
    idx := a.label_index(name + "")
    if idx >= 0 && idx < a.labels.len {
        data_flag := lab_is_data(&a.labels, idx)
        label_off := lab_off(&a.labels, idx)
        if data_flag {
            result := a.data_vaddr + label_off
            << result
        }
        result := a.code_vaddr + label_off
        << result
    }
    eprintln("ERROR: Unknown label: " + name)
    <<< 1
    << 0
}

fn label_hash_at(ls &[]Label, i int) int {
    mut h := 5381
    n := lab_name_len(ls, i)
    for j in 0:n {
        h = ((h << 5) + h) + (lab_name_byte(ls, i, j) & 255)
        h = h & 2147483647
    }
    << h
}

// Resolve a hash-only ARM64 fixup.  We deliberately scan the compact label
// table (rather than the full label vector) instead of retaining a string in
// Fixup; this keeps correctness independent of the hosted Gen1
// aggregate-copy/drop implementation while preserving near-O(1) fixup time
// for the compiler's tens of thousands of branches.
fn (a Assembler) label_addr_hash(h int) int {
    cap := a.label_cap
    mut idx := -1
    // Keep the nonzero proof separate from the table-shape guards.
    if cap > 0 {
        if cap <= 1048576 && a.label_used.len >= cap {
            mut i := h % cap
            start := i
            while true {
                if a.label_used[i] == 0 {
                    <-
                }
                mut kh := 5381
                for j in 0:a.label_keys[i].len {
                    kh = ((kh << 5) + kh) + (a.label_keys[i][j] & 255)
                    kh = kh & 2147483647
                }
                if kh == h {
                    if idx >= 0 && idx != a.label_vals[i] {
                        kname := a.label_keys[i] + ""
                        lname := lab_name(&a.labels, idx)
                        eprintln("ambiguous assembly label hash: " + lname + " / " + kname)
                        <<< 1
                    }
                    idx = a.label_vals[i]
                }
                i = (i + 1) % cap
                if i == start {
                    <-
                }
            }
        }
    }
    if idx >= 0 && idx < a.labels.len {
        if lab_is_data(&a.labels, idx) {
            << a.data_vaddr + lab_off(&a.labels, idx)
        }
        << a.code_vaddr + lab_off(&a.labels, idx)
    }
    eprintln("ERROR: unknown label hash " + str(h))
    // Surface the candidate label name(s) that produced this hash, so the
    // host-side fixup emitter can identify which call site is asking for a
    // label that was never registered via a.label(...). Cap the scan to keep
    // this fail-loud path bounded on huge label tables.
    mut scanned := 0
    for i in 0:a.labels.len {
        if scanned >= 256 { <- }
        if label_hash_at(&a.labels, i) == h {
            eprintln("  candidate: " + lab_name(&a.labels, i))
        }
        scanned += 1
    }
    // Fail-closed: emitting a BL with target=0 lands in __PAGEZERO and
    // crashes the produced binary at runtime (observed as Gen2 SIGBUS when
    // an indirect call's fnval real did not match any in-unit MIR fn).
    // Surface the missing label as a build error so the self-host chain
    // aborts with a clear root cause instead of producing a broken image.
    <<< 1
    << 0
}

fn (a Assembler) label_name_hash(h int) string {
    for i in 0:a.labels.len {
        if label_hash_at(&a.labels, i) == h {
            nm := lab_name(&a.labels, i)
            << asm_string_copy(&nm)
        }
    }
    << ""
}

// Resolve a stable Label index without touching a Fixup owning string.
// Forward references remain offset=-1 until their full-name definition.
fn (a Assembler) label_addr_symbol(sym int) int {
    if sym >= 0 && sym < a.labels.len && lab_off(&a.labels, sym) >= 0 {
        if lab_is_data(&a.labels, sym) { << a.data_vaddr + lab_off(&a.labels, sym) }
        << a.code_vaddr + lab_off(&a.labels, sym)
    }
    if sym >= 0 && sym < a.labels.len {
        eprintln("ERROR: Unknown label: " + lab_name(&a.labels, sym))
    } else {
        eprintln("ERROR: Unknown label symbol")
    }
    <<< 1
    << 0
}

// ==================== Data movement ====================

// MOV with a full 64-bit immediate: MOVZ for the low 16 bits, then MOVK
// for each non-zero higher 16-bit field (LSL #16/#32/#48).
fn (a &mut Assembler) mov_imm64(rd int, imm int) {
    // MOVZ rd, #imm16, LSL #0  (0xD2800000)
    a.emit32(3531603968 | ((imm & 65535) << 5) | rd)
    high16 := (imm >> 16) & 65535
    if high16 != 0 {
        a.emit32(4070572032 | (high16 << 5) | rd) // MOVK lsl #16 (0xF2A00000)
    }
    high32 := (imm >> 32) & 65535
    if high32 != 0 {
        a.emit32(4072669184 | (high32 << 5) | rd) // MOVK lsl #32 (0xF2C00000)
    }
    high48 := (imm >> 48) & 65535
    if high48 != 0 {
        a.emit32(4074766336 | (high48 << 5) | rd) // MOVK lsl #48 (0xF2E00000)
    }
}

// MOV with a signed immediate. MOVN only encodes 0xFFFFFFFFFFFF0000|~imm16,
// i.e. values in -65536..=-1. GENERIC_READ (0x80000000) and other large
// negatives must use the 64-bit MOVZ/MOVK path — otherwise ARM64 Windows
// CreateFileA gets 0xFFFF0000 instead of 0x80000000.
fn (a &mut Assembler) mov_imm(rd int, imm int) {
    if imm < 0 {
        if imm >= -65536 {
            inverted := (-imm - 1) & 65535
            a.emit32(2457862144 | (inverted << 5) | rd) // MOVN (0x92800000)
            <<
        }
    }
    a.mov_imm64(rd, imm)
}

// MOV register. Uses ADD rd, rn, #0 when SP(31) is involved, otherwise
// ORR rd, XZR, rn (asm.js `movReg`).
fn (a &mut Assembler) mov_reg(rd int, rn int) {
    if rd == 31 || rn == 31 {
        a.emit32(2432696320 | (rn << 5) | rd) // 0x91000000
    } else {
        a.emit32(2852127712 | (rn << 16) | rd) // 0xAA0003E0
    }
}

