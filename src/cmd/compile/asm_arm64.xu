    a.emit32(1309162496 | (idx << 20) | (vn << 5) | rd)
}

// FADD Dd, Dn, Dm  0x1E602800
fn (a &mut Assembler) fadd_d(dd int, dn int, dm int) {
    a.emit32(509618176 | (dm << 16) | (dn << 5) | dd)
}

// ==================== Integer NEON (Q regs; wrapping i64×2) ====================
// GPR `xn` arguments are physical X numbers (same as fmov_d_from_x).

// DUP Vd.2D, Xn  0x4E080C00
fn (a &mut Assembler) dup_2d_from_x(vd int, xn int) {
    a.emit32(1309150208 | (xn << 5) | vd)
}

// DUP Vd.16B, Wn  0x4E010C00. Low 8 bits fill every byte lane.
fn (a &mut Assembler) dup_16b_from_w(vd int, wn int) {
    a.emit32(1308691456 | (wn << 5) | vd)
}

// STR Qt, [Xn], #16  0x3C810400. Post-index 16, 128-bit store.
fn (a &mut Assembler) str_q_post16(qt int, rn int) {
    a.emit32(1015088128 | (rn << 5) | qt)
}

// INS Vd.D[lane], Xn  0x4E001C00 | imm5<<16; lane 0 → imm5=8, lane 1 → 24
fn (a &mut Assembler) ins_d_from_x(vd int, lane int, xn int) {
    mut imm5 := 8
    if lane != 0 {
        imm5 = 24
    }
    a.emit32(1308630016 | (imm5 << 16) | (xn << 5) | vd)
}

