    a.emit32(238139392 | (vn << 5) | bd)
}

// ADDV Bd, Vn.16B 0x4E31B800. The count kernel shifts equality
// masks to 0/1 first, so the 16-byte sum is at most 16 and cannot wrap.
fn (a &mut Assembler) addv_16b(bd int, vn int) {
    a.emit32(0x4E31B800 | (vn << 5) | bd)
}

// UMAXV Bd, Vn.16B  0x6E30A800
