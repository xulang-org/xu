// FNMSUB Dd, Dn, Dm, Da  (Dd = Dn*Dm - Da). 0x1F608000
fn (a &mut Assembler) fnmsub_d(dd int, dn int, dm int, da int) {
    a.emit32(526336000 | (dm << 16) | (da << 10) | (dn << 5) | dd)
}

// FDIV Dd, Dn, Dm  0x1E601800
fn (a &mut Assembler) fdiv_d(dd int, dn int, dm int) {
    a.emit32(509614080 | (dm << 16) | (dn << 5) | dd)
}

// FNEG Dd, Dn  0x1E614000
fn (a &mut Assembler) fneg_d(dd int, dn int) {
    a.emit32(509689856 | (dn << 5) | dd)
}

// FSQRT Dd, Dn  0x1E61C000
fn (a &mut Assembler) fsqrt_d(dd int, dn int) {
    a.emit32(509722624 | (dn << 5) | dd)
}

// FRINTM Dd, Dn (Floor)  0x1E654000
// 0x1E654000 = 509952000
fn (a &mut Assembler) frintm_d(dd int, dn int) {
    a.emit32(509952000 | (dn << 5) | dd)
}

// FRINTP Dd, Dn (Ceil)  0x1E64C000
// 0x1E64C000 = 509919232
fn (a &mut Assembler) frintp_d(dd int, dn int) {
    a.emit32(509919232 | (dn << 5) | dd)
}

// FRINTZ Dd, Dn (Trunc)  0x1E65C000
// 0x1E65C000 = 509984768
fn (a &mut Assembler) frintz_d(dd int, dn int) {
    a.emit32(509984768 | (dn << 5) | dd)
}

// FRINTN Dd, Dn (Round to even)  0x1E644000
// 0x1E644000 = 509886464
fn (a &mut Assembler) frintn_d(dd int, dn int) {
    a.emit32(509886464 | (dn << 5) | dd)
}

// CLZ Xd, Xn  0xDAC01000.  The opcode does not fit in a signed 32-bit
// immediate, so emit the four little-endian bytes directly.
fn (a &mut Assembler) clz_x(rd int, rn int) {
    a.code.push((rd & 31) | ((rn & 7) << 5))
    a.code.push(16 | ((rn >> 3) & 3))
    a.code.push(192)
    a.code.push(218)
}

// RBIT Xd, Xn  0xDAC00000
fn (a &mut Assembler) rbit_x(rd int, rn int) {
    a.code.push((rd & 31) | ((rn & 7) << 5))
    a.code.push((rn >> 3) & 3)
    a.code.push(192)
    a.code.push(218)
}

// FCMP Dn, Dm  0x1E602000
fn (a &mut Assembler) fcmp_d(dn int, dm int) {
    a.emit32(509616128 | (dm << 16) | (dn << 5))
}

// SCVTF Dd, Xn  0x9E620000 (0x9E630000 would be UCVTF — unsigned!)
fn (a &mut Assembler) scvtf_d_from_x(dd int, xn int) {
    a.emit32(2657222656 | (xn << 5) | dd) // SCVTF 0x9E620000 (signed)
}

// FCVTZS Xd, Dn  0x9E780000
fn (a &mut Assembler) fcvtzs_x_from_d(xd int, dn int) {
    a.emit32(2658664448 | (dn << 5) | xd)
}

// STUR Dt, [Xn, #imm] (unscaled signed 9-bit). 0xFC000000
fn (a &mut Assembler) stur_d(dt int, rn int, offset int) {
    imm9 := offset & 511
    a.emit32(4227858432 | (imm9 << 12) | (rn << 5) | dt)
}

// LDUR Dt, [Xn, #imm] (unscaled signed 9-bit). 0xFC400000
fn (a &mut Assembler) ldur_d(dt int, rn int, offset int) {
    imm9 := offset & 511
    a.emit32(4232052736 | (imm9 << 12) | (rn << 5) | dt)
}

// STR Dt, [Xn, #imm] (scaled unsigned, 8-byte units). 0xFD000000
fn (a &mut Assembler) str_d(dt int, rn int, offset int) {
    imm12 := (offset >> 3) & 4095
    a.emit32(4244635648 | (imm12 << 10) | (rn << 5) | dt)
}

// LDR Dt, [Xn, #imm] (scaled unsigned, 8-byte units). 0xFD400000
fn (a &mut Assembler) ldr_d(dt int, rn int, offset int) {
    imm12 := (offset >> 3) & 4095
    a.emit32(4248829952 | (imm12 << 10) | (rn << 5) | dt)
}

fn (a &mut Assembler) load_d_offset(dt int, rn int, offset int) {
    if offset >= 0 && offset % 8 == 0 {
        a.ldr_d(dt, rn, offset)
    } else {
        a.ldur_d(dt, rn, offset)
    }
}

fn (a &mut Assembler) store_d_offset(dt int, rn int, offset int) {
    if offset >= 0 && offset % 8 == 0 {
        a.str_d(dt, rn, offset)
    } else {
        a.stur_d(dt, rn, offset)
    }
}

// FMOV Dd, Dn (register). 0x1E604000
fn (a &mut Assembler) fmov_d_from_d(dd int, dn int) {
    a.emit32(509624320 | (dn << 5) | dd)
}

// ==================== Arithmetic ====================

// ADD register (shifted register, LSL #0). 0x8B000000
fn (a &mut Assembler) add_reg(rd int, rn int, rm int) {
    a.emit32(2332033024 | (rm << 16) | (rn << 5) | rd)
}

// ADD 32-bit register (shifted register, LSL #0). 0x0B000000
fn (a &mut Assembler) add_reg32(rd int, rn int, rm int) {
    a.emit32(184549376 | (rm << 16) | (rn << 5) | rd)
}

// SUB register (shifted register, LSL #0). 0xCB000000
fn (a &mut Assembler) sub_reg(rd int, rn int, rm int) {
    a.emit32(3405774848 | (rm << 16) | (rn << 5) | rd)
}

// SUB immediate. Same 12-bit / hi+lo split as `add_imm` (asm.js `subImm`).
fn (a &mut Assembler) sub_imm(rd int, rn int, imm int) {
    if imm > 4095 {
        if imm > 16777215 {
            eprintln("sub_imm: immediate too large: imm=" + str(imm) + " rd=" + str(rd) + " rn=" + str(rn))
            <<< 1
        }
        // Compute hi12 before lo12: O1 may AND in-place on imm's park reg;
        // doing & 4095 first would make (imm >> 12) see only the low 12 bits
        // (heap chunk end became add #0 instead of #0x10,LSL#12).
        hi12 := (imm >> 12) & 4095
        lo12 := imm & 4095
        mut rsrc := rn
        if hi12 != 0 {
            // SUB rd, rsrc, #hi12, LSL #12 (sh bit = bit 22)  0xD1000000
            a.emit32(3506438144 | (1 << 22) | (hi12 << 10) | (rsrc << 5) | rd)
            rsrc = rd
        }
        if lo12 != 0 || hi12 == 0 {
            a.emit32(3506438144 | (lo12 << 10) | (rsrc << 5) | rd)
        }
    } else {
        a.emit32(3506438144 | (imm << 10) | (rn << 5) | rd)
    }
}

// MUL rd = rn * rm (MADD rd, rn, rm, XZR). 0x9B007C00
// (named mul_reg for consistency and to leave `mul` free for the vm layer)
fn (a &mut Assembler) mul_reg(rd int, rn int, rm int) {
    a.emit32(2600500224 | (rm << 16) | (rn << 5) | rd)
}

// MADD rd = ra + rn * rm. 0x9B000000
fn (a &mut Assembler) madd_reg(rd int, rn int, rm int, ra int) {
    a.emit32(2600468480 | (rm << 16) | (ra << 10) | (rn << 5) | rd)
}

// ADD rd = rn + (rm << sh). 0x8B000000 | (rm<<16) | (sh<<10) | (rn<<5) | rd
fn (a &mut Assembler) add_lsl(rd int, rn int, rm int, sh int) {
    a.emit32(2332033024 | (rm << 16) | ((sh & 63) << 10) | (rn << 5) | rd)
}

// SUB rd = rn - (rm << sh). 0xCB000000
fn (a &mut Assembler) sub_lsl(rd int, rn int, rm int, sh int) {
    a.emit32(3405774848 | (rm << 16) | ((sh & 63) << 10) | (rn << 5) | rd)
}

// LDR Dt, [Xn, Xm, LSL #3]  SIMD&FP register offset. 0xFC607800
fn (a &mut Assembler) ldr_d_reg_lsl(dt int, rn int, rm int) {
    a.emit32(4234180608 | (rm << 16) | (rn << 5) | dt)
}

// STR Dt, [Xn, Xm, LSL #3]. 0xFC207800
fn (a &mut Assembler) str_d_reg_lsl(dt int, rn int, rm int) {
    a.emit32(4229986304 | (rm << 16) | (rn << 5) | dt)
}

// LDR Dt, [Xn], #imm9  post-index. 0xFC400400
fn (a &mut Assembler) ldr_d_post(dt int, rn int, imm int) {
    a.emit32(4232053760 | ((imm & 511) << 12) | (rn << 5) | dt)
}

// LDR Xt, [Xn, Xm, LSL #3] / W LSL#2 / H LSL#1 / B. elem_sz in {1,2,4,8}.
fn (a &mut Assembler) ldr_reg_lsl(rt int, rn int, rm int, elem_sz int) {
    if elem_sz == 8 {
        a.emit32(4167071744 | (rm << 16) | (rn << 5) | rt) // 0xF8607800
        <<
    }
    if elem_sz == 4 {
        a.emit32(3093329920 | (rm << 16) | (rn << 5) | rt) // 0xB8607800
        <<
    }
    if elem_sz == 2 {
        a.emit32(2019588096 | (rm << 16) | (rn << 5) | rt) // 0x78607800
        <<
    }
    // byte: no shift amount
    a.emit32(945842176 | (rm << 16) | (rn << 5) | rt) // 0x38606800
    <<
}

// STR Xt/W/H/B, [Xn, Xm, LSL #…] — same elem_sz set as ldr_reg_lsl.
fn (a &mut Assembler) str_reg_lsl(rt int, rn int, rm int, elem_sz int) {
    if elem_sz == 8 {
        a.emit32(4162877440 | (rm << 16) | (rn << 5) | rt) // 0xF8207800
        <<
    }
    if elem_sz == 4 {
        a.emit32(3089135616 | (rm << 16) | (rn << 5) | rt) // 0xB8207800
        <<
    }
    if elem_sz == 2 {
        a.emit32(2015393792 | (rm << 16) | (rn << 5) | rt) // 0x78207800
        <<
    }
    a.emit32(941647872 | (rm << 16) | (rn << 5) | rt) // 0x38206800
    <<
}

// SDIV: signed division. 0x9AC00C00
fn (a &mut Assembler) sdiv(rd int, rn int, rm int) {
    a.emit32(2596277248 | (rm << 16) | (rn << 5) | rd)
}

// SMULH rd = (rn * rm) >> 64 (signed high 64-bit product). 0x9B407C00
fn (a &mut Assembler) smulh(rd int, rn int, rm int) {
    a.emit32(2604694528 | (rm << 16) | (rn << 5) | rd)
}

// MSUB rd = ra - rn * rm (used for `rem` after SDIV). 0x9B008000
fn (a &mut Assembler) msub(rd int, rn int, rm int, ra int) {
    a.emit32(2600501248 | (rm << 16) | (ra << 10) | (rn << 5) | rd)
}

// NEG rd = -rm (SUB rd, XZR, rm). 0xCB0003E0
fn (a &mut Assembler) neg_reg(rd int, rm int) {
    a.emit32(3405775840 | (rm << 16) | rd)
}

// AND rd = rn & rm (shifted register, LSL #0). 0x8A000000
fn (a &mut Assembler) and_reg(rd int, rn int, rm int) {
    a.emit32(2315255808 | (rm << 16) | (rn << 5) | rd)
}

// AND rd = rn & (2^k-1). N=1, immr=0, imms=k-1. 0x92400000 | imms<<10
fn (a &mut Assembler) and_imm(rd int, rn int, imm int) {
    mut n := 0
    mut x := imm
    while x > 0 {
        n = n + 1
        x = x / 2
    }
    imms := n - 1
    a.emit32(2453667840 | (imms << 10) | (rn << 5) | rd)
}

// ORR rd = rn | rm. 0xAA000000
fn (a &mut Assembler) orr_reg(rd int, rn int, rm int) {
    a.emit32(2852126720 | (rm << 16) | (rn << 5) | rd)
}

// EOR rd = rn ^ rm. 0xCA000000
fn (a &mut Assembler) eor_reg(rd int, rn int, rm int) {
    a.emit32(3388997632 | (rm << 16) | (rn << 5) | rd)
}

// LSLV rd = rn << rm (register shift). 0x9AC02000
fn (a &mut Assembler) lsl_reg(rd int, rn int, rm int) {
    a.emit32(2596282368 | (rm << 16) | (rn << 5) | rd)
}

// LSRV rd = rn >> rm (register shift, logical). 0x9AC02400
fn (a &mut Assembler) lsr_reg(rd int, rn int, rm int) {
    a.emit32(2596283392 | (rm << 16) | (rn << 5) | rd)
}

// ASRV rd = rn >> rm (register shift, arithmetic). 0x9AC02800
fn (a &mut Assembler) asr_reg(rd int, rn int, rm int) {
    a.emit32(2596284416 | (rm << 16) | (rn << 5) | rd)
}

// ASR immediate: SBFM Xd, Xn, #shift, #63. 0x93400000
fn (a &mut Assembler) asr_imm(rd int, rn int, shift int) {
    immr := shift & 63
    a.emit32(2470445056 | (immr << 16) | (63 << 10) | (rn << 5) | rd)
}

// ROR Xd, Xn, #imm — EXTR Xd, Xn, Xn, #imm. 0x93C00000
fn (a &mut Assembler) ror_imm(rd int, rn int, imm int) {
    immr := imm & 63
    a.emit32(2478833664 | (rn << 16) | (immr << 10) | (rn << 5) | rd)
}

// ROR Wd, Wn, #imm — 32-bit EXTR; writing Wd zeros the high half. 0x13800000
fn (a &mut Assembler) ror_imm32(rd int, rn int, imm int) {
    immr := imm & 31
    a.emit32(327155712 | (rn << 16) | (immr << 10) | (rn << 5) | rd)
}

// LSR immediate (logical shift right): UBFM Xd, Xn, #shift, #63. 0xD3400000
// LSR Wd, Wn, #imm — UBFM 32-bit. 0x53000000
fn (a &mut Assembler) lsr_imm32(rd int, rn int, imm int) {
    immr := imm & 31
    a.emit32(1392508928 | (immr << 16) | (31 << 10) | (rn << 5) | rd)
}

// 32-bit logical shifted-register. opc 0=AND 1=ORR 2=EOR; shift 0=LSL 1=LSR 2=ASR 3=ROR.
fn (a &mut Assembler) logical32(opc int, rd int, rn int, rm int, shift int, imm int, invert int) {
    mut base := 167772160
    if opc == 1 {
        base = 704643072
    }
    if opc == 2 {
        base = 1241513984
    }
    mut nbit := 0
    if invert != 0 {
        nbit = 2097152
    }
    a.emit32(base | nbit | ((shift & 3) << 22) | (rm << 16) | ((imm & 31) << 10) | (rn << 5) | rd)
}

fn (a &mut Assembler) eor_ror32(rd int, rn int, rm int, imm int) {
    a.logical32(2, rd, rn, rm, 3, imm, 0)
}

fn (a &mut Assembler) eor_lsr32(rd int, rn int, rm int, imm int) {
    a.logical32(2, rd, rn, rm, 1, imm, 0)
}

fn (a &mut Assembler) bic32(rd int, rn int, rm int) {
    a.logical32(0, rd, rn, rm, 0, 0, 1)
}

fn (a &mut Assembler) mvn32(rd int, rm int) {
    a.logical32(1, rd, 31, rm, 0, 0, 1)
}

// LSR immediate (logical shift right): UBFM Xd, Xn, #shift, #63. 0xD3400000
fn (a &mut Assembler) lsr_imm(rd int, rn int, shift int) {
    immr := shift & 63
    a.emit32(3544186880 | (immr << 16) | (63 << 10) | (rn << 5) | rd)
}

// LSL immediate (logical shift left): UBFM Xd, Xn, #(-shift mod 64), #(63-shift).
fn (a &mut Assembler) lsl_imm(rd int, rn int, shift int) {
    immr := (64 - shift) & 63
    imms := (63 - shift) & 63
    a.emit32(3544186880 | (immr << 16) | (imms << 10) | (rn << 5) | rd)
}

// ==================== Compare ====================

// CMP rn, rm (SUBS XZR, rn, rm). 0xEB00001F
fn (a &mut Assembler) cmp_reg(rn int, rm int) {
    a.emit32(3942645791 | (rm << 16) | (rn << 5))
}

// CMP rn, #imm (SUBS XZR, rn, #imm). 12-bit immediates encode directly;
// anything else is materialized in X16 and compared as a register.
fn (a &mut Assembler) cmp_imm(rn int, imm int) {
    if rn == 16 {
        eprintln("cmp_imm: rn must not be X16 (scratch)")
        <<< 1
    }
    if imm >= 0 && imm <= 4095 {
        a.emit32(4043309087 | (imm << 10) | (rn << 5)) // 0xF100001F
    } else {
        a.mov_imm(16, imm)
        a.cmp_reg(rn, 16)
    }
}

// CSET rd, cond (CSINC rd, XZR, XZR, !cond). 0x9A9F07E0
fn (a &mut Assembler) cset(rd int, cond int) {
    a.emit32(2594113504 | ((cond ^ 1) << 12) | rd)
}

// CSEL rd, rn, rm, cond. 0x9A800000
fn (a &mut Assembler) csel(rd int, rn int, rm int, cond int) {
    a.emit32(2592079872 | (rm << 16) | (cond << 12) | (rn << 5) | rd)
}

// CSINC rd, rn, rm, cond. 0x9A800400
fn (a &mut Assembler) csinc(rd int, rn int, rm int, cond int) {
    a.emit32(2592080896 | (rm << 16) | (cond << 12) | (rn << 5) | rd)
}

// ==================== Memory access ====================

// STP Xt1, Xt2, [Xn, #imm]! (pre-indexed; imm must be a multiple of 8).
// 0xA9800000. Offset is a multiple of 8, so /8 == >>3 here.
fn (a &mut Assembler) stp_pre(rt1 int, rt2 int, rn int, offset int) {
    imm7 := (offset >> 3) & 127
    a.emit32(2843738112 | (imm7 << 15) | (rt2 << 10) | (rn << 5) | rt1)
}

// LDP Xt1, Xt2, [Xn], #imm (post-indexed; imm must be a multiple of 8).
// 0xA8C00000
fn (a &mut Assembler) ldp_post(rt1 int, rt2 int, rn int, offset int) {
    imm7 := (offset >> 3) & 127
    a.emit32(2831155200 | (imm7 << 15) | (rt2 << 10) | (rn << 5) | rt1)
}

// STP Xt1, Xt2, [Xn], #imm (post-indexed; imm must be a multiple of 8).
// 0xA8800000
fn (a &mut Assembler) stp_post(rt1 int, rt2 int, rn int, offset int) {
    imm7 := (offset >> 3) & 127
    a.emit32(2826960896 | (imm7 << 15) | (rt2 << 10) | (rn << 5) | rt1)
}

// STR Xt, [Xn, #imm] (scaled unsigned offset, 8-byte units). 0xF9000000
fn (a &mut Assembler) str(rt int, rn int, offset int) {
    imm12 := (offset >> 3) & 4095
    a.emit32(4177526784 | (imm12 << 10) | (rn << 5) | rt)
}

// LDR Xt, [Xn, #imm] (scaled unsigned offset, 8-byte units). 0xF9400000
fn (a &mut Assembler) ldr(rt int, rn int, offset int) {
    imm12 := (offset >> 3) & 4095
    a.emit32(4181721088 | (imm12 << 10) | (rn << 5) | rt)
}

// STUR Xt, [Xn, #imm] (unscaled signed 9-bit offset). 0xF8000000
fn (a &mut Assembler) stur(rt int, rn int, offset int) {
    imm9 := offset & 511
    a.emit32(4160749568 | (imm9 << 12) | (rn << 5) | rt)
}

// LDUR Xt, [Xn, #imm] (unscaled signed 9-bit offset). 0xF8400000
fn (a &mut Assembler) ldur(rt int, rn int, offset int) {
    imm9 := offset & 511
    a.emit32(4164943872 | (imm9 << 12) | (rn << 5) | rt)
}

// STRB Wt, [Xn, #imm] (unsigned 12-bit offset). 0x39000000
fn (a &mut Assembler) strb(rt int, rn int, offset int) {
    a.emit32(956301312 | ((offset & 4095) << 10) | (rn << 5) | rt)
}

// STURB Wt, [Xn, #imm] (unscaled signed 9-bit offset). 0x38000000
fn (a &mut Assembler) sturb(rt int, rn int, offset int) {
    imm9 := offset & 511
    a.emit32(939524096 | (imm9 << 12) | (rn << 5) | rt)
}

// LDRB Wt, [Xn, #imm] (unsigned 12-bit offset, zero-extended byte load).
// 0x39400000
fn (a &mut Assembler) ldrb(rt int, rn int, offset int) {
    a.emit32(960495616 | ((offset & 4095) << 10) | (rn << 5) | rt)
}

// LDURB Wt, [Xn, #imm] (unscaled signed 9-bit offset). 0x38400000
fn (a &mut Assembler) ldurb(rt int, rn int, offset int) {
    imm9 := offset & 511
    a.emit32(943718400 | (imm9 << 12) | (rn << 5) | rt)
}

// Byte load with base + signed byte offset.
fn (a &mut Assembler) load_byte_offset(rt int, rn int, offset int) {
    if offset >= 0 {
        a.ldrb(rt, rn, offset)
    } else {
        a.ldurb(rt, rn, offset)
    }
}

// Load with base + signed byte offset (asm.js `movLoadOffset`): LDR for
// non-negative multiples of 8, LDUR otherwise.
fn (a &mut Assembler) load_offset(rt int, rn int, offset int) {
    if offset >= 0 && offset % 8 == 0 {
        a.ldr(rt, rn, offset)
    } else {
        a.ldur(rt, rn, offset)
    }
}

// Store with base + signed byte offset (asm.js `movStoreOffset`).
fn (a &mut Assembler) store_offset(rt int, rn int, offset int) {
    if offset >= 0 && offset % 8 == 0 {
        a.str(rt, rn, offset)
    } else {
        a.stur(rt, rn, offset)
    }
}

// Byte store with base + signed byte offset.
fn (a &mut Assembler) store_byte_offset(rt int, rn int, offset int) {
    if offset >= 0 {
        a.strb(rt, rn, offset)
    } else {
        a.sturb(rt, rn, offset)
    }
}

// ADD immediate. Encodes directly for 12-bit immediates; larger values up
// to 0xFFFFFF are split into `imm12 << 12` + `imm12` (asm.js `addImm`).
fn (a &mut Assembler) add_imm(rd int, rn int, imm int) {
    if imm > 4095 {
        if imm > 16777215 {
            eprintln("add_imm: immediate too large")
            <<< 1
        }
        // hi12 before lo12 — see add_imm (O1 in-place AND on imm park).
        hi12 := (imm >> 12) & 4095
        lo12 := imm & 4095
        mut rsrc := rn
        if hi12 != 0 {
            // ADD rd, rsrc, #hi12, LSL #12 (sh bit = bit 22)  0x91000000
            a.emit32(2432696320 | (1 << 22) | (hi12 << 10) | (rsrc << 5) | rd)
            rsrc = rd
        }
        if lo12 != 0 || hi12 == 0 {
            a.emit32(2432696320 | (lo12 << 10) | (rsrc << 5) | rd)
        }
    } else {
        a.emit32(2432696320 | (imm << 10) | (rn << 5) | rd)
    }
}

// ==================== Branches ====================

fn (a &mut Assembler) push_fixup(kind int, label string, rd int) {
    a.push_fixup_at(kind, a.code.len, &label, rd)
}

fn (a &mut Assembler) push_fixup_ref(kind int, label &string, rd int) {
    a.push_fixup_at(kind, a.code.len, label, rd)
}

fn (a &mut Assembler) push_fixup_at(kind int, off int, label &string, rd int) {
    mut lab := ""
    mut out_rd := rd
    mut out_kind := kind
    if a.arch == 0 {
        if kind < 0 || kind > 4 {
            eprintln("ERROR: unsupported symbolic relocation kind " + str(kind))
            <<< 1
        }
        sym := a.label_symbol(label)
        out_rd = ((sym + 1) << 5) | (rd & 31)
        // Kinds 6..10 distinguish full-name symbols from legacy hash tokens.
        out_kind = kind + 6
    } else if a.arch == 1 {
        sym := a.label_symbol(label)
        out_rd = sym
        out_kind = kind
    } else {
        lab = asm_string_copy(label)
    }
    a.fixups.push(Fixup{kind: out_kind, offset: off, label: lab, rd: out_rd})
}

// Unconditional branch to a label (patched by `fixup_all`). 0x14000000
fn (a &mut Assembler) b(label string) {
    a.push_fixup(0, label, 0)
    a.emit32(335544320)
}

// Branch with link to a label (patched by `fixup_all`). 0x94000000
fn (a &mut Assembler) bl(label string) {
    a.push_fixup(1, label, 0)
    a.emit32(2483027968)
}

fn (a &mut Assembler) bl_ref(label &string) {
    a.push_fixup_ref(1, label, 0)
    a.emit32(2483027968)
}

// Scalar-hash relocation forms for labels that originate in nested MIR
// aggregates.  The caller computes the hash from byte accessors and passes no
// string descriptor through the backend forwarding chain.
// Emit an ARM64 BL whose target is a MIR function index.  The target offset
// is bound by emit_function_entry and resolved in fixup_all after the code
// virtual address is known.  Encoding the index in Fixup.rd keeps this path
// entirely numeric and avoids carrying a temporary string through the large
// Assembler receiver.  rd is otherwise non-negative for BL fixups, so
// -(fi+1) is an unambiguous sentinel.
fn (a &mut Assembler) call_fn_index(fi int) {
    off := a.code.len
    marker := 0 - fi - 1
    a.fixups.push(Fixup{kind: 1, offset: off, label: "", rd: marker})
    a.emit32(2483027968)
}

// Branch with link to register (indirect call): BLR rn. 0xD63F0000
fn (a &mut Assembler) blr(rn int) {
    a.emit32(3594452992 | (rn << 5))
}

// LDAXR Xt, [Xn]  0xC85FFC00
fn (a &mut Assembler) ldaxr(rt int, rn int) {
    a.emit32(3361733632 | (rn << 5) | rt)
}

// STLXR Ws, Xt, [Xn]  0xC800FC00
fn (a &mut Assembler) stlxr(rs int, rt int, rn int) {
    a.emit32(3355507712 | (rs << 16) | (rn << 5) | rt)
}

// LDAR Xt, [Xn] — load-acquire (64-bit, sequential consistency). 0xC8DFFC00
fn (a &mut Assembler) ldar(rt int, rn int) {
    a.emit32(3370122240 | (rn << 5) | rt)
}

// STLR Xt, [Xn] — store-release (64-bit, sequential consistency). 0xC89FFC00
fn (a &mut Assembler) stlr(rt int, rn int) {
    a.emit32(3365927936 | (rn << 5) | rt)
}

// Compare and branch if zero (patched by `fixup_all`). 0xB4000000
// Compute the placeholder before `push_fixup`: under -O1 the call can
// clobber the caller-saved home of `rt` (rd is not passed for CBZ).
// Stash `rt` in Fixup.rd so `fixup_all` need not re-read the low bits.
fn (a &mut Assembler) cbz(rt int, label string) {
    r := rt & 31
    word := 3019898880 | r
    a.push_fixup(2, label, r)
    a.emit32(word)
}

// Compare and branch if non-zero (patched by `fixup_all`). 0xB5000000
fn (a &mut Assembler) cbnz(rt int, label string) {
    r := rt & 31
    word := 3036676096 | r
    a.push_fixup(3, label, r)
    a.emit32(word)
}

// Conditional branch. Already-defined nearby labels (loop back-edges) use
// a real B.cond (imm19). Forward/far targets keep `b.<inv> .+8` + `b`.
// 0x54000000
fn (a &mut Assembler) bcond(cond int, label string) {
    idx := a.label_index_ref(&label)
    if idx >= 0 && idx < a.labels.len {
        is_data := lab_is_data(&a.labels, idx)
        if !is_data {
            off := lab_off(&a.labels, idx)
            if off >= 0 {
                here := a.code.len
                delta := (off - here) / 4
                if delta >= -262144 && delta < 262144 {
                    imm19 := delta & 524287
                    a.emit32(1409286144 | (imm19 << 5) | cond)
                    <<
                }
            }
        }
    }
    inv := cond ^ 1
    a.emit32(1409286144 | (2 << 5) | inv) // b.<inv> .+8
    a.b(label)
}

fn (a &mut Assembler) beq(label string) { a.bcond(0, label) }
fn (a &mut Assembler) bne(label string) { a.bcond(1, label) }
fn (a &mut Assembler) blt(label string) { a.bcond(11, label) }
fn (a &mut Assembler) bge(label string) { a.bcond(10, label) }
fn (a &mut Assembler) bgt(label string) { a.bcond(12, label) }
fn (a &mut Assembler) ble(label string) { a.bcond(13, label) }

// ==================== Address loading ====================

// Load the address of a label into `rd` via ADRP + ADD (asm.js
// `leaRipRel`). Both instructions are patched by `fixup_all`.
fn (a &mut Assembler) lea_rip_rel(rd int, label string) {
    a.push_fixup(4, label, rd)
    a.emit32(2415919104 | rd) // ADRP rd, <page> placeholder (0x90000000)
    a.emit32(2432696320 | (rd << 5) | rd) // ADD rd, rd, #0 (0x91000000)
}

// LEA of `_xus_{ib}` string literal via data-offset table (avoids label-hash collisions).
fn (a &mut Assembler) lea_xus(rd int, ib int) {
    off := a.code.len
    a.fixups.push(Fixup{kind: 5, offset: off, label: "", rd: (ib << 5) | (rd & 31)})
    a.emit32(2415919104 | (rd & 31))
    a.emit32(2432696320 | ((rd & 31) << 5) | (rd & 31))
}

// Numeric variant used by LoadFnAddr on ARM64.  Fixup kind 4 normally stores
// the destination register in rd; encode both the MIR function index and that
// register in one negative sentinel so the Fixup/Assembler layouts remain
// unchanged: token = (fi+1)*32 + rd + 1, rd_field = -token.
fn (a &mut Assembler) lea_fn_index(rd int, fi int) {
    off := a.code.len
    token := (fi + 1) * 32 + (rd & 31) + 1
    marker := 0 - token
    a.fixups.push(Fixup{kind: 4, offset: off, label: "", rd: marker})
    a.emit32(2415919104 | (rd & 31))
    a.emit32(2432696320 | ((rd & 31) << 5) | (rd & 31))
}

// ==================== System calls ====================

// SVC with a 16-bit immediate. 0xD4000001
fn (a &mut Assembler) svc(imm int) {
    a.emit32(3556769793 | (imm << 5))
}

// macOS raw syscall trap: SVC #0x80.
fn (a &mut Assembler) syscall() { a.svc(128) }

// ==================== Misc ====================

fn (a &mut Assembler) ret() { a.emit32(3596551104) } // 0xD65F03C0
fn (a &mut Assembler) nop() { a.emit32(3573751839) } // 0xD503201F
fn (a &mut Assembler) mrs_tpidr_el0(rt int) {
    // MRS Xt, TPIDR_EL0 = D53BD040 | Rt. Bytes keep immediates in 0..255.
    a.code.push((64 | (rt & 31)) & 255)
    a.code.push(208)
    a.code.push(59)
    a.code.push(213)
}

// ==================== Fixups ====================

fn (a &mut Assembler) patch32(offset int, word int) {
    a.code[offset] = word & 255
    a.code[offset + 1] = (word >> 8) & 255
    a.code[offset + 2] = (word >> 16) & 255
    a.code[offset + 3] = (word >> 24) & 255
}

// Patch all pending fixups. Must be called after `code_vaddr` and
// `data_vaddr` have been assigned by the binary writer, and after all
// code/data emission is complete (two-pass addressing protocol).
fn (a &mut Assembler) fixup_all() {
    if a.arch == 1 {
        a.x64_fixup_all()
        <<
    }
    if a.arch == 2 {
        a.t_fixup_all()
        <<
    }
    if a.arch == 3 {
        a.r_fixup_all()
        <<
    }
    if a.arch == 4 {
        a.l_fixup_all()
        <<
    }
    if a.arch == 5 {
        a.v_fixup_all()
        <<
    }
    for i in 0:a.fixups.len {
        mut kind := fix_kind(&a.fixups, i)
        offset := fix_off(&a.fixups, i)
        // BL fixups emitted by call_fn_index carry a negative rd sentinel
        // instead of a string label. Resolve those directly from the
        // MIR-index -> code-offset table; all ordinary fixups retain the
        // existing string-label path.
        mut target_addr := 0
        mut numeric_fn := false
        fix_rd0 := fix_rd(&a.fixups, i)
        mut patch_rd := fix_rd0
        if kind >= 6 && kind <= 10 {
            kind -= 6
            target_addr = a.label_addr_symbol((fix_rd0 >> 5) - 1)
            patch_rd = fix_rd0 & 31
            numeric_fn = true
        }
        if !numeric_fn && kind == 1 && fix_rd0 < 0 {
            fi := 0 - fix_rd0 - 1
            if a.lib == 0 && fi >= 0 && fi < a.lib_exp_off.len {
                fn_off := a.lib_exp_off[fi]
                if fn_off >= 0 {
                    target_addr = a.code_vaddr + fn_off
                    numeric_fn = true
                }
            }
        } else if !numeric_fn && kind == 4 && fix_rd0 < 0 {
            // ADRP+ADD numeric token also carries the destination register.
            tok := 0 - fix_rd0 - 1
            pr := tok % 32
            fi := tok / 32 - 1
            if a.lib == 0 && fi >= 0 && fi < a.lib_exp_off.len {
                fn_off := a.lib_exp_off[fi]
                if fn_off >= 0 {
                    target_addr = a.code_vaddr + fn_off
                    patch_rd = pr
                    numeric_fn = true
                }
            }
        }
        mut encoded_label := false
        if kind == 5 {
            // String-literal LEA: rd packs (intern_index << 5) | dest_reg.
            ib := fix_rd0 >> 5
            patch_rd = fix_rd0 & 31
            if ib >= 0 && ib < a.xus_off.len && a.xus_off[ib] >= 0 {
                target_addr = a.data_vaddr + a.xus_off[ib]
            } else {
                target_addr = a.data_vaddr
            }
            numeric_fn = true
        }
        // ARM64 hash-token fixups use rd>=32; ordinary register operands are
        // limited to 0..31.  Trust the numeric marker even when a stale
        // string descriptor carries a non-zero length, otherwise malformed
        // metadata can route a valid token through the dangling-label path.
        if !numeric_fn && fix_rd0 >= 32 {
            hash := (fix_rd0 >> 5) - 1
            patch_rd = fix_rd0 & 31
            target_addr = a.label_addr_hash(hash)
            encoded_label = true
        }
        if !numeric_fn && !encoded_label {
            // Object files produced by older compilers still carry a string
            // label; retain this compatibility path.
            lbl := fix_label(&a.fixups, i)
            target_addr = a.label_addr(lbl)
        }
        current_addr := a.code_vaddr + offset
        if kind == 0 || kind == 1 {
            // B / BL, imm26. target and current are both 4-byte aligned,
            // so >>2 equals the reference's truncating /4.
            imm26 := ((target_addr - current_addr) >> 2) & 67108863
            mut opcode := 335544320
            if kind == 1 {
                opcode = 2483027968
            }
            a.patch32(offset, opcode | imm26)
        } else if kind == 2 || kind == 3 {
            // CBZ / CBNZ, imm19; encoded fixups use patch_rd, while legacy
            // object fixups keep the raw register in rd.
            imm19 := ((target_addr - current_addr) >> 2) & 524287
            rt := patch_rd & 31
            mut opcode := 3019898880
            if kind == 3 {
                opcode = 3036676096
            }
            a.patch32(offset, opcode | (imm19 << 5) | rt)
        } else {
            // ADRP + ADD: ADRP computes the 4KB page, ADD the page offset.
            current_page := current_addr & -4096
            target_page := target_addr & -4096
            page_offset := (target_page - current_page) >> 12
            immlo := page_offset & 3
            immhi := (page_offset >> 2) & 524287
            rd := patch_rd
            a.patch32(offset, 2415919104 | (immlo << 29) | (immhi << 5) | rd)
            offset_in_page := target_addr & 4095
            a.patch32(offset + 4, 2432696320 | (offset_in_page << 10) | (rd << 5) | rd)
        }
    }
}
