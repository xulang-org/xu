@main
// RV32IM backend for Gen1 (E7): ILP32, a0-a5 args, s0 frame pointer.
// Port of bootstrap/crates/xubackend/src/riscv32.rs. Operates on the low
// 32 bits of each 8-byte MIR slot (like Thumb).

fn rmap_reg(v int) int {
    if v == 0 { << 5 }  // V0 = t0
    if v == 1 { << 6 }  // V1 = t1
    if v == 2 { << 7 }  // V2 = t2
    if v == 3 { << 19 } // V3 = s3 (t3/t4/t5 are flag scratch)
    if v == 4 { << 20 } // V4 = s4
    if v == 5 { << 21 } // V5 = s5
    if v == 6 || v == 7 {
        << v
    }
    if v == 8 { << 9 }  // S0 = s1
    if v == 9 { << 18 } // S1 = s2
    if v >= 10 && v <= 13 {
        << v
    }
    if v == 14 { << 10 } // Ret = a0
    if v == 15 { << 8 }  // Fp = s0
    if v == 16 { << 2 }  // Sp
    if v == 17 { << 1 }  // Lr = ra
    if v >= 18 && v <= 23 { << v - 8 } // A0-A5 = a0-a5
    eprintln("E5: unknown vreg v=" + str(v) + " (ignored, map to t0)")
    << 5
}

fn e5_rv_unimp(op string) {
    eprintln("E5 RV32 backend does not implement " + op)
    <<< 1
}

fn (a &mut Assembler) rbe_mov(dest int, src int) {
    if a.arch != 3 && a.arch != 2 && a.arch != 4 && a.arch != 5 {
        eprintln("rbe_mov misdispatch dest=" + str(dest) + " src=" + str(src) + " arch=" + str(a.arch))
        a.mov_reg(map_reg(dest), map_reg(src))
        <<
    }
    a.r_mov(rmap_reg(dest), rmap_reg(src))
}

fn (a &mut Assembler) rbe_mov_imm(dest int, imm int) {
    a.r_li32(rmap_reg(dest), imm)
}

fn (a &mut Assembler) rbe_mov_imm64(dest int, imm int) {
    a.r_li32(rmap_reg(dest), imm)
}

fn (a &mut Assembler) rbe_lea(dest int, label string) {
    a.r_lea_abs(rmap_reg(dest), label)
}

fn (a &mut Assembler) rbe_load(dest int, base int, offset int) {
    a.r_lw(rmap_reg(dest), rmap_reg(base), offset)
}

fn (a &mut Assembler) rbe_store(base int, offset int, src int) {
    a.r_sw(rmap_reg(src), rmap_reg(base), offset)
}

fn (a &mut Assembler) rbe_store_byte(base int, offset int, src int) {
    a.r_sb(rmap_reg(src), rmap_reg(base), offset)
}

fn (a &mut Assembler) rbe_load_byte(dest int, base int, offset int) {
    a.r_lb(rmap_reg(dest), rmap_reg(base), offset)
}

fn (a &mut Assembler) rbe_add(dest int, x int, y int) {
    a.r_add(rmap_reg(dest), rmap_reg(x), rmap_reg(y))
}

fn (a &mut Assembler) rbe_add_imm(dest int, src int, imm int) {
    if imm < 2048 {
        a.r_addi(rmap_reg(dest), rmap_reg(src), imm)
    } else {
        a.r_li32(30, imm)
        a.r_add(rmap_reg(dest), rmap_reg(src), 30)
    }
}

fn (a &mut Assembler) rbe_sub(dest int, x int, y int) {
    a.r_sub(rmap_reg(dest), rmap_reg(x), rmap_reg(y))
}

fn (a &mut Assembler) rbe_sub_imm(dest int, src int, imm int) {
    if imm < 2048 {
        a.r_addi(rmap_reg(dest), rmap_reg(src), 0 - imm)
    } else {
        a.r_li32(30, imm)
        a.r_sub(rmap_reg(dest), rmap_reg(src), 30)
    }
}

fn (a &mut Assembler) rbe_mul(dest int, x int, y int) {
    a.r_mul(rmap_reg(dest), rmap_reg(x), rmap_reg(y))
}

fn (a &mut Assembler) rbe_div(dest int, x int, y int) {
    a.r_div(rmap_reg(dest), rmap_reg(x), rmap_reg(y))
}

fn (a &mut Assembler) rbe_mod(dest int, x int, y int) {
    a.r_rem(rmap_reg(dest), rmap_reg(x), rmap_reg(y))
}

fn (a &mut Assembler) rbe_neg(dest int, src int) {
    a.r_sub(rmap_reg(dest), 0, rmap_reg(src))
}

fn (a &mut Assembler) rbe_shl_imm(dest int, src int, imm int) {
    a.r_slli(rmap_reg(dest), rmap_reg(src), imm)
}

fn (a &mut Assembler) rbe_shr_imm(dest int, src int, imm int) {
    a.r_srli(rmap_reg(dest), rmap_reg(src), imm)
}

fn (a &mut Assembler) rbe_and(dest int, x int, y int) {
    a.r_and(rmap_reg(dest), rmap_reg(x), rmap_reg(y))
}

fn (a &mut Assembler) rbe_and_imm(dest int, src int, imm int) {
    a.r_andi(rmap_reg(dest), rmap_reg(src), imm)
}

fn (a &mut Assembler) rbe_or(dest int, x int, y int) {
    a.r_or(rmap_reg(dest), rmap_reg(x), rmap_reg(y))
}

fn (a &mut Assembler) rbe_xor(dest int, x int, y int) {
    a.r_xor(rmap_reg(dest), rmap_reg(x), rmap_reg(y))
}

fn (a &mut Assembler) rbe_shl(dest int, src int, count int) {
    a.r_sll(rmap_reg(dest), rmap_reg(src), rmap_reg(count))
}

fn (a &mut Assembler) rbe_shr(dest int, src int, count int) {
    // A sign-extended i32 shifted by 32..63 is its sign bit (0 or -1).
    // RV32 SRA masks the count to five bits, so use 31 for that half of
    // Xu's six-bit shift count. t3 is reserved backend scratch and is never
    // mapped by rmap_reg; materialize the count before touching either input.
    a.r_srli(28, rmap_reg(count), 5)
    a.r_andi(28, 28, 1)
    a.r_sub(28, 0, 28)
    a.r_or(28, rmap_reg(count), 28)
    a.r_sra(rmap_reg(dest), rmap_reg(src), 28)
}

// Compare flags: t5 = x - y (signed flag carrier); t4 = 1 if x <u y
// (unsigned flag carrier — S3: OOB checks must reject negative indices).
fn (a &mut Assembler) rbe_cmp(x int, y int) {
    a.r_sub(30, rmap_reg(x), rmap_reg(y))
    a.r_sltu(29, rmap_reg(x), rmap_reg(y))
}

fn (a &mut Assembler) rbe_cmp_imm(x int, imm int) {
    a.r_li32(29, imm) // t4 = imm
    a.r_sub(30, rmap_reg(x), 29)
    a.r_li32(28, imm) // t3 = imm again (sltu clobbers t4's operand)
    a.r_sltu(29, rmap_reg(x), 28)
}

fn (a &mut Assembler) rbe_cset(dest int, cond int) {
    // cond = ARM condition codes: 0 EQ, 1 NE, 2 CS/HS, 3 CC/LO,
    // 10 GE, 11 LT, 12 GT, 13 LE. t5 = x-y (signed flag), t4 = x <u y.
    // Pattern: dest = 0; skip-to-label when NOT taken; dest = 1.
    n := a.drop_seq
    a.drop_seq += 1
    skip := "_xurv_cset_" + str(n)
    a.r_li32(rmap_reg(dest), 0)
    if cond == 0 {
        a.r_bcond_jal(false, 30, 0, skip + "") // skip when t5 != 0
    } else if cond == 1 {
        a.r_bcond_jal(true, 30, 0, skip + "") // skip when t5 == 0
    } else if cond == 2 {
        a.r_bcond_jal(false, 29, 0, skip + "") // skip when x >=u y (t4 == 0)
    } else if cond == 3 {
        a.r_bcond_jal(true, 29, 0, skip + "") // skip when x <u y (t4 == 1)
    } else if cond == 11 {
        // LT: t4 = (t5 < 0); skip when t4 == 0.
        a.r_slt(29, 30, 0)
        a.r_bcond_jal(true, 29, 0, skip + "")
    } else if cond == 10 {
        // GE: t4 = (t5 < 0); skip when t4 != 0.
        a.r_slt(29, 30, 0)
        a.r_bcond_jal(false, 29, 0, skip + "")
    } else if cond == 12 {
        // GT: t4 = (0 < t5); skip when t4 == 0.
        a.r_slt(29, 0, 30)
        a.r_bcond_jal(true, 29, 0, skip + "")
    } else {
        // LE: t4 = (0 < t5) = (t5 > 0); skip when t4 != 0.
        a.r_slt(29, 0, 30)
        a.r_bcond_jal(false, 29, 0, skip + "")
    }
    a.r_li32(rmap_reg(dest), 1)
    a.label(skip)
}

fn (a &mut Assembler) rbe_jmp(label string) { a.r_j(label) }

fn (a &mut Assembler) rbe_jeq(label string) { a.r_bcond_jal(true, 0, 30, label) }
fn (a &mut Assembler) rbe_jne(label string) { a.r_bcond_jal(false, 0, 30, label) }

fn (a &mut Assembler) rbe_jlt(label string) {
    // take if t5 < 0: slt t4, t5, x0; skip if t4 == 0
    a.r_slt(29, 30, 0)
    a.r_bcond_jal(false, 29, 0, label)
}

fn (a &mut Assembler) rbe_jle(label string) {
    a.rbe_jlt(label + "")
    a.rbe_jeq(label)
}

fn (a &mut Assembler) rbe_jgt(label string) {
    // take if t5 > 0: slt t4, x0, t5
    a.r_slt(29, 0, 30)
    a.r_bcond_jal(false, 29, 0, label)
}

fn (a &mut Assembler) rbe_jge(label string) {
    n := a.drop_seq
    a.drop_seq += 1
    skip := "_xurv_jge_" + str(n)
    a.rbe_jlt(skip + "")
    a.r_j(label)
    a.label(skip)
}

fn (a &mut Assembler) rbe_jae(label string) {
    // Unsigned >=: take when t4 == 0 (x >=u y). S3: negative indices fail.
    a.r_bcond_jal(true, 29, 0, label)
}

fn (a &mut Assembler) rbe_cbz(reg int, label string) { a.r_bcond_jal(true, rmap_reg(reg), 0, label) }
fn (a &mut Assembler) rbe_cbnz(reg int, label string) { a.r_bcond_jal(false, rmap_reg(reg), 0, label) }

fn (a &mut Assembler) rbe_prologue(frame_size int) {
    a.r_addi(2, 2, -40)      // sp -= 40 (fp, ra, s3, s4, s5)
    a.r_sw(8, 2, 0)          // [sp] = fp
    a.r_sw(1, 2, 8)          // [sp+8] = ra
    a.r_sw(19, 2, 16)        // [sp+16] = s3
    a.r_sw(20, 2, 24)        // [sp+24] = s4
    a.r_sw(21, 2, 32)        // [sp+32] = s5
    a.r_mov(8, 2)            // fp = sp — locals live BELOW fp, saves at [fp..fp+32]
    if frame_size > 0 {
        a.r_addi(2, 2, 0 - frame_size)
    }
}

fn (a &mut Assembler) rbe_epilogue() {
    a.r_mov(2, 8)            // sp = fp (undoes the frame sub; saves sit at [fp..fp+32])
    a.r_lw(8, 2, 0)          // fp = [sp]
    a.r_lw(1, 2, 8)          // ra = [sp+8]
    a.r_lw(19, 2, 16)        // s3 = [sp+16]
    a.r_lw(20, 2, 24)        // s4 = [sp+24]
    a.r_lw(21, 2, 32)        // s5 = [sp+32]
    a.r_addi(2, 2, 40)
    a.r_ret()
}

fn (a &mut Assembler) rbe_call(label string) { a.r_jal(label) }

fn (a &mut Assembler) rbe_call_reg(target int) { a.r_jalr(1, rmap_reg(target), 0) }

fn (a &mut Assembler) rbe_ret() { a.r_ret() }

// Freestanding halt / interrupt masking (dispatched from be_thumb's
// thumb-only definitions via arch checks there; these are the RV32 halves).
fn (a &mut Assembler) rv_halt() { a.r_wfi() }
fn (a &mut Assembler) rv_irq_off() { a.r_csrci_mstatus_mie() }
fn (a &mut Assembler) rv_irq_on() { a.r_csrsi_mstatus_mie() }

// ==================== RV64 backend (M39 linux-riscv64) ====================
// Port of bootstrap/crates/xubackend (RV64 LP64) + the RV32 flag model.
//
// VReg -> physical (RISC-V RV64 psABI):
//   V0-V2 -> t0-t2 (x5-x7)   V3 -> s1 (x9)   V4-V7 -> s2-s5 (x18-x21)
//   S0-S5 -> s6-s11 (x22-x27)
//   Ret -> a0 (x10)   Fp -> s0/fp (x8)   Sp -> sp (x2)   Lr -> ra (x1)
//   A0-A5 -> a0-a5 (x10-x15)
//
// Flag scratch (same model as RV32): t5 (x30) = signed x-y, t4 (x29) =
// unsigned x <u y. t3 (x28) = mov_imm64 high-half scratch; t6 (x31) =
// load/store offset + cmp_imm scratch; a7 (x17) = syscall number.

fn vmap_reg(v int) int {
    // Never abort the hosted product; RV64 mapper must not see arm64 homes.
    if v >= 0 && v <= 23 {
        if v == 0 { << 5 }
        if v == 1 { << 6 }
        if v == 2 { << 7 }
        if v == 3 { << 9 }
        if v == 4 { << 18 }
        if v == 5 { << 19 }
        if v == 6 { << 20 }
        if v == 7 { << 21 }
        if v == 8 { << 22 }
        if v == 9 { << 23 }
        if v == 10 { << 24 }
        if v == 11 { << 25 }
        if v == 12 { << 26 }
        if v == 13 { << 27 }
        if v == 14 { << 10 }
        if v == 15 { << 8 }
        if v == 16 { << 2 }
        if v == 17 { << 1 }
        << v - 8
    }
    eprintln("E5: unknown vreg v=" + str(v) + " (passthrough)")
    << v
}

// ===== Data movement =====

fn (a &mut Assembler) vbe_mov(dest int, src int) {
    if a.arch != 5 {
        // Hosted arm64 must not take the RV64 mapper (nested generic emit).
        eprintln("vbe_mov misdispatch dest=" + str(dest) + " src=" + str(src) + " arch=" + str(a.arch))
        a.mov_reg(map_reg(dest), map_reg(src))
        <<
    }
    a.r_mov(vmap_reg(dest), vmap_reg(src))
}

fn (a &mut Assembler) vbe_mov_imm(dest int, imm int) {
    if a.arch != 5 {
        eprintln("vbe_mov_imm misdispatch dest=" + str(dest) + " arch=" + str(a.arch))
        a.mov_imm(map_reg(dest), imm)
        <<
    }
    a.v_mov_imm(vmap_reg(dest), imm)
}

fn (a &mut Assembler) vbe_mov_imm64(dest int, imm int) {
    if a.arch != 5 {
        eprintln("vbe_mov_imm64 misdispatch dest=" + str(dest) + " arch=" + str(a.arch))
        a.mov_imm64(map_reg(dest), imm)
        <<
    }
    a.v_mov_imm64(vmap_reg(dest), imm)
}

fn (a &mut Assembler) vbe_lea(dest int, label string) {
    a.v_lea(vmap_reg(dest), label)
}

fn (a &mut Assembler) vbe_load(dest int, base int, offset int) {
    d := vmap_reg(dest)
    b := vmap_reg(base)
    if offset >= -2048 && offset <= 2047 {
        a.v_ld(d, b, offset)
    } else {
        if offset >= 0 {
            a.v_mov_imm(31, offset)
            a.r_add(31, 31, b)
            a.v_ld(d, 31, 0)
        } else {
            a.v_mov_imm(31, 0 - offset)
            a.r_sub(31, b, 31)
            a.v_ld(d, 31, 0)
        }
    }
}

fn (a &mut Assembler) vbe_store(base int, offset int, src int) {
    b := vmap_reg(base)
    s := vmap_reg(src)
    if offset >= -2048 && offset <= 2047 {
        a.v_sd(s, b, offset)
    } else {
        if offset >= 0 {
            a.v_mov_imm(31, offset)
            a.r_add(31, 31, b)
            a.v_sd(s, 31, 0)
        } else {
            a.v_mov_imm(31, 0 - offset)
            a.r_sub(31, b, 31)
            a.v_sd(s, 31, 0)
        }
    }
}

fn (a &mut Assembler) vbe_store_byte(base int, offset int, src int) {
    b := vmap_reg(base)
    s := vmap_reg(src)
    if offset >= -2048 && offset <= 2047 {
        a.r_sb(s, b, offset)
    } else {
        if offset >= 0 {
            a.v_mov_imm(31, offset)
            a.r_add(31, 31, b)
            a.r_sb(s, 31, 0)
        } else {
            a.v_mov_imm(31, 0 - offset)
            a.r_sub(31, b, 31)
            a.r_sb(s, 31, 0)
        }
    }
}

fn (a &mut Assembler) vbe_load_byte(dest int, base int, offset int) {
    d := vmap_reg(dest)
    b := vmap_reg(base)
    if offset >= -2048 && offset <= 2047 {
        a.v_lbu(d, b, offset)
    } else {
        if offset >= 0 {
            a.v_mov_imm(31, offset)
            a.r_add(31, 31, b)
            a.v_lbu(d, 31, 0)
        } else {
            a.v_mov_imm(31, 0 - offset)
            a.r_sub(31, b, 31)
            a.v_lbu(d, 31, 0)
        }
    }
}

// ===== Arithmetic =====

fn (a &mut Assembler) vbe_add(dest int, x int, y int) {
    a.r_add(vmap_reg(dest), vmap_reg(x), vmap_reg(y))
}

fn (a &mut Assembler) vbe_add_imm(dest int, src int, imm int) {
    if imm >= -2048 && imm <= 2047 {
        a.r_addi(vmap_reg(dest), vmap_reg(src), imm)
    } else {
        a.v_mov_imm(31, imm)
        a.r_add(vmap_reg(dest), vmap_reg(src), 31)
    }
}

fn (a &mut Assembler) vbe_sub(dest int, x int, y int) {
    a.r_sub(vmap_reg(dest), vmap_reg(x), vmap_reg(y))
}

fn (a &mut Assembler) vbe_sub_imm(dest int, src int, imm int) {
    if imm <= 2047 {
        a.r_addi(vmap_reg(dest), vmap_reg(src), 0 - imm)
    } else {
        a.v_mov_imm(31, imm)
        a.r_sub(vmap_reg(dest), vmap_reg(src), 31)
    }
}

fn (a &mut Assembler) vbe_mul(dest int, x int, y int) {
    a.r_mul(vmap_reg(dest), vmap_reg(x), vmap_reg(y))
}

fn (a &mut Assembler) vbe_div(dest int, x int, y int) {
    a.r_div(vmap_reg(dest), vmap_reg(x), vmap_reg(y))
}

fn (a &mut Assembler) vbe_mod(dest int, x int, y int) {
    a.r_rem(vmap_reg(dest), vmap_reg(x), vmap_reg(y))
}

fn (a &mut Assembler) vbe_neg(dest int, src int) {
    a.r_sub(vmap_reg(dest), 0, vmap_reg(src))
}

fn (a &mut Assembler) vbe_shl_imm(dest int, src int, imm int) {
    a.v_slli(vmap_reg(dest), vmap_reg(src), imm)
}

fn (a &mut Assembler) vbe_shr_imm(dest int, src int, imm int) {
    a.v_srli(vmap_reg(dest), vmap_reg(src), imm)
}

fn (a &mut Assembler) vbe_and(dest int, x int, y int) {
    a.r_and(vmap_reg(dest), vmap_reg(x), vmap_reg(y))
}

fn (a &mut Assembler) vbe_and_imm(dest int, src int, imm int) {
    a.v_andi(vmap_reg(dest), vmap_reg(src), imm)
}

fn (a &mut Assembler) vbe_or(dest int, x int, y int) {
    a.r_or(vmap_reg(dest), vmap_reg(x), vmap_reg(y))
}

fn (a &mut Assembler) vbe_xor(dest int, x int, y int) {
    a.r_xor(vmap_reg(dest), vmap_reg(x), vmap_reg(y))
}

fn (a &mut Assembler) vbe_shl(dest int, src int, count int) {
    a.r_sll(vmap_reg(dest), vmap_reg(src), vmap_reg(count))
}

fn (a &mut Assembler) vbe_shr(dest int, src int, count int) {
    a.r_sra(vmap_reg(dest), vmap_reg(src), vmap_reg(count))
}

// ===== Compare & jump (RV32 flag model) =====
// t5 = x - y (signed flag carrier); t4 = x <u y (unsigned flag carrier).

fn (a &mut Assembler) vbe_cmp(x int, y int) {
    a.cmp_fp = 0
    a.r_sub(30, vmap_reg(x), vmap_reg(y))
    a.r_sltu(29, vmap_reg(x), vmap_reg(y))
}

fn (a &mut Assembler) vbe_cmp_imm(x int, imm int) {
    a.cmp_fp = 0
    a.v_mov_imm(29, imm) // t4 = imm
    a.r_sub(30, vmap_reg(x), 29)
    a.v_mov_imm(31, imm) // t6 = imm again (sltu clobbers t4's operand)
    a.r_sltu(29, vmap_reg(x), 31)
}

fn (a &mut Assembler) vbe_cset(dest int, cond int) {
    d := vmap_reg(dest)
    if a.cmp_fp == 1 {
        // FP compare: F0/F1 hold the operands (see vbe_fcmp).
        if cond == 0 {
            a.v_feq_d(d, 0, 1)
        } else if cond == 1 {
            a.v_feq_d(d, 0, 1)
            a.v_xori(d, d, 1)
        } else if cond == 11 {
            a.v_flt_d(d, 0, 1)
        } else if cond == 13 {
            a.v_fle_d(d, 0, 1)
        } else if cond == 12 {
            a.v_flt_d(d, 1, 0)
        } else {
            a.v_fle_d(d, 1, 0) // cond == 10 (GE)
        }
        <<
    }
    n := a.drop_seq
    a.drop_seq += 1
    skip := "_xurv64_cset_" + str(n)
    a.v_mov_imm(d, 0)
    if cond == 0 {
        a.r_bcond_jal(false, 30, 0, skip + "") // skip when t5 != 0
    } else if cond == 1 {
        a.r_bcond_jal(true, 30, 0, skip + "") // skip when t5 == 0
    } else if cond == 2 {
        a.r_bcond_jal(false, 29, 0, skip + "") // skip when x >=u y (t4 == 0)
    } else if cond == 3 {
        a.r_bcond_jal(true, 29, 0, skip + "") // skip when x <u y (t4 == 1)
    } else if cond == 11 {
        a.r_slt(29, 30, 0)
        a.r_bcond_jal(true, 29, 0, skip + "")
    } else if cond == 10 {
        a.r_slt(29, 30, 0)
        a.r_bcond_jal(false, 29, 0, skip + "")
    } else if cond == 12 {
        a.r_slt(29, 0, 30)
        a.r_bcond_jal(true, 29, 0, skip + "")
    } else {
        a.r_slt(29, 0, 30)
        a.r_bcond_jal(false, 29, 0, skip + "")
    }
    a.v_mov_imm(d, 1)
    a.label(skip)
}

fn (a &mut Assembler) vbe_jmp(label string) { a.r_j(label) }

fn (a &mut Assembler) vbe_jeq(label string) { a.r_bcond_jal(true, 0, 30, label) }
fn (a &mut Assembler) vbe_jne(label string) { a.r_bcond_jal(false, 0, 30, label) }

fn (a &mut Assembler) vbe_jlt(label string) {
    a.r_slt(29, 30, 0)
    a.r_bcond_jal(false, 29, 0, label)
}

fn (a &mut Assembler) vbe_jle(label string) {
    a.vbe_jlt(label + "")
    a.vbe_jeq(label)
}

fn (a &mut Assembler) vbe_jgt(label string) {
    a.r_slt(29, 0, 30)
    a.r_bcond_jal(false, 29, 0, label)
}

fn (a &mut Assembler) vbe_jge(label string) {
    n := a.drop_seq
    a.drop_seq += 1
    skip := "_xurv64_jge_" + str(n)
    a.vbe_jlt(skip + "")
    a.r_j(label)
    a.label(skip)
}

fn (a &mut Assembler) vbe_jae(label string) {
    a.r_bcond_jal(true, 29, 0, label)
}

fn (a &mut Assembler) vbe_cbz(reg int, label string) { a.r_bcond_jal(true, vmap_reg(reg), 0, label) }
fn (a &mut Assembler) vbe_cbnz(reg int, label string) { a.r_bcond_jal(false, vmap_reg(reg), 0, label) }

// ===== Function calls =====

fn (a &mut Assembler) vbe_prologue(frame_size int) {
    // Save S0–S5 (x22–x27 / s6–s11) below the FP/RA link.
    a.r_addi(2, 2, -48)
    a.v_sd(22, 2, 0)
    a.v_sd(23, 2, 8)
    a.v_sd(24, 2, 16)
    a.v_sd(25, 2, 24)
    a.v_sd(26, 2, 32)
    a.v_sd(27, 2, 40)
    a.r_addi(2, 2, -16)      // sp -= 16
    a.v_sd(1, 2, 0)          // [sp] = ra
    a.v_sd(8, 2, 8)          // [sp+8] = fp
    a.r_mov(8, 2)            // fp = sp
    if frame_size > 0 {
        if frame_size <= 2047 {
            a.r_addi(2, 2, 0 - frame_size)
        } else {
            a.v_mov_imm(31, frame_size)
            a.r_sub(2, 2, 31)
        }
    }
}

fn (a &mut Assembler) vbe_epilogue() {
    a.r_mov(2, 8)            // sp = fp
    a.v_ld(8, 2, 8)          // fp = [sp+8]
    a.v_ld(1, 2, 0)          // ra = [sp+0]
    a.r_addi(2, 2, 16)       // sp += 16
    a.v_ld(22, 2, 0)
    a.v_ld(23, 2, 8)
    a.v_ld(24, 2, 16)
    a.v_ld(25, 2, 24)
    a.v_ld(26, 2, 32)
    a.v_ld(27, 2, 40)
    a.r_addi(2, 2, 48)
    a.r_ret()
}

fn (a &mut Assembler) vbe_call(label string) { a.r_jal(label) }

fn (a &mut Assembler) vbe_call_reg(target int) { a.r_jalr(1, vmap_reg(target), 0) }

fn (a &mut Assembler) vbe_ret() { a.r_ret() }

// ===== Floating point (bits in GPRs; D extension) =====

fn (a &mut Assembler) vbe_fadd(dest int, x int, y int) {
    da := vmap_reg(x)
    db := vmap_reg(y)
    dd := vmap_reg(dest)
    a.v_fmv_d_x(0, da)
    a.v_fmv_d_x(1, db)
    a.v_fadd_d(0, 0, 1)
    a.v_fmv_x_d(dd, 0)
}

fn (a &mut Assembler) vbe_fsub(dest int, x int, y int) {
    da := vmap_reg(x)
    db := vmap_reg(y)
    dd := vmap_reg(dest)
    a.v_fmv_d_x(0, da)
    a.v_fmv_d_x(1, db)
    a.v_fsub_d(0, 0, 1)
    a.v_fmv_x_d(dd, 0)
}

fn (a &mut Assembler) vbe_fmul(dest int, x int, y int) {
    da := vmap_reg(x)
    db := vmap_reg(y)
    dd := vmap_reg(dest)
    a.v_fmv_d_x(0, da)
    a.v_fmv_d_x(1, db)
    a.v_fmul_d(0, 0, 1)
    a.v_fmv_x_d(dd, 0)
}

fn (a &mut Assembler) vbe_fdiv(dest int, x int, y int) {
    da := vmap_reg(x)
    db := vmap_reg(y)
    dd := vmap_reg(dest)
    a.v_fmv_d_x(0, da)
    a.v_fmv_d_x(1, db)
    a.v_fdiv_d(0, 0, 1)
    a.v_fmv_x_d(dd, 0)
}

fn (a &mut Assembler) vbe_fneg(dest int, src int) {
    ds := vmap_reg(src)
    dd := vmap_reg(dest)
    a.v_fmv_d_x(0, ds)
    a.v_fneg_d(0, 0)
    a.v_fmv_x_d(dd, 0)
}

fn (a &mut Assembler) vbe_fcmp(x int, y int) {
    a.cmp_fp = 1
    da := vmap_reg(x)
    db := vmap_reg(y)
    a.v_fmv_d_x(0, da)
    a.v_fmv_d_x(1, db)
}

fn (a &mut Assembler) vbe_scvtf(dest int, src int) {
    ds := vmap_reg(src)
    dd := vmap_reg(dest)
    a.v_fcvt_d_l(0, ds)
    a.v_fmv_x_d(dd, 0)
}

fn (a &mut Assembler) vbe_fcvtzs(dest int, src int) {
    ds := vmap_reg(src)
    dd := vmap_reg(dest)
    a.v_fmv_d_x(0, ds)
    a.v_fcvt_l_d(dd, 0)
}

// ===== Platform-specific =====

fn (a &mut Assembler) vbe_syscall(num int) {
    a.v_mov_imm(17, num) // a7 = syscall number
    a.v_ecall()
}

// Linux returns -errno directly in a0; no normalization needed (like arm64).

// ===== Atomics (M35) =====

fn (a &mut Assembler) vbe_atomic_xchg(dest int, addr int, val int) {
    a.v_amoswap_d(vmap_reg(dest), vmap_reg(val), vmap_reg(addr))
}

fn (a &mut Assembler) vbe_atomic_load(dest int, addr int) {
    a.v_ld(vmap_reg(dest), vmap_reg(addr), 0)
    a.v_fence()
}

fn (a &mut Assembler) vbe_atomic_store(addr int, val int) {
    a.v_fence()
    a.v_sd(vmap_reg(val), vmap_reg(addr), 0)
}

fn (a &mut Assembler) vbe_atomic_add(dest int, addr int, val int) {
    a.v_amoadd_d(vmap_reg(dest), vmap_reg(val), vmap_reg(addr))
}

fn (a &mut Assembler) vbe_atomic_cas(dest int, addr int, old int, new int) {
    n := a.drop_seq
    a.drop_seq += 1
    mut labs := []string{}
    labs.push("_xurv64_cas_" + str(n))
    labs.push("_xurv64_cas_f_" + str(n))
    labs.push("_xurv64_cas_d_" + str(n))
    d := vmap_reg(dest)
    ad := vmap_reg(addr)
    o := vmap_reg(old)
    nv := vmap_reg(new)
    a.label(labs[0])
    a.v_lr_d(31, ad)         // t6 = [addr] (load-reserved)
    a.r_bcond_jal(false, 31, o, labs[1]) // if t6 != old -> fail (bne t6,old)
    a.r_mov(31, nv)          // t6 = new
    a.v_sc_d(31, 31, ad)     // [addr] = t6; t6 = 0 success / nonzero failure
    a.r_bcond_jal(false, 31, 0, labs[0]) // retry on sc failure (bne t6, zero)
    a.v_mov_imm(d, 1)
    a.r_j(labs[2])
    a.label(labs[1])
    a.v_mov_imm(d, 0)
    a.label(labs[2])
}
