@main

#xu/types

// Straight byte loops: one bounds proof, then pointer post-increment.


// scale*4 + offset. scale 1..4, and the offset stays inside the group
// except the existing scale-1 `i+1` encoding (5).
fn pipe_aff_sum(a int, b int) int {
    if a < 4 || b < 4 { << 0 }
    sc := a / 4 + b / 4
    off := (a - (a / 4) * 4) + (b - (b / 4) * 4)
    if sc < 1 || sc > 4 { << 0 }
    if off < 0 || off >= sc { << 0 }
    << sc * 4 + off
}

fn pipe_aff_add_k(inner int, k int) int {
    if inner == 4 && k == 1 { << 5 }
    if inner == 8 && k == 1 { << 9 }
    if inner == 12 && k == 1 { << 13 }
    if inner == 12 && k == 2 { << 14 }
    if inner == 16 && k >= 1 && k <= 3 { << 16 + k }
    << 0
}

// scale 1 off 0 → 4, scale 1 off 1 → 5, scale 2 off 0 → 8, scale 2 off 1 → 9.
// scale 3 off 0..2 → 12..14, scale 4 off 0..3 → 16..19.
fn vec_affine_index(m &types.Mir, fi int, bi int, idx int, ind int) int {
    if idx < 0 { << 0 }
    if vec_temp_from_local(m, fi, bi, idx, ind) { << 4 }
    mut op := 0
    mut lc := 0
    mut ld := 0
    mut found := 0
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == types.mi_bin && types.mir_ia(m, fi, ii) == idx && types.mir_ib(m, fi, ii) == 1 {
            op = 1
            lc = types.mir_ic(m, fi, ii)
            ld = types.mir_id(m, fi, ii)
            found = 1
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if found == 0 {
        ii = types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            if types.mir_ikind(m, fi, ii) == types.mi_bin && types.mir_ia(m, fi, ii) == idx {
                opx := types.mir_ib(m, fi, ii)
                sl := types.mir_ic(m, fi, ii)
                sr := types.mir_id(m, fi, ii)
                if opx == 17 && sl >= 0 && vec_temp_from_local(m, fi, bi, sl, ind) && sr < 0 && vec_has_const(m, fi, sr) {
                    sh := vec_const(m, fi, sr)
                    if sh == 1 { << 8 }
                    if sh == 2 { << 16 }
                }
                if opx == 3 {
                    mut base := -1
                    mut mulk := 0
                    if sl >= 0 && vec_temp_from_local(m, fi, bi, sl, ind) && sr < 0 && vec_has_const(m, fi, sr) {
                        base = sl
                        mulk = vec_const(m, fi, sr)
                    } else if sr >= 0 && vec_temp_from_local(m, fi, bi, sr, ind) && sl < 0 && vec_has_const(m, fi, sl) {
                        base = sr
                        mulk = vec_const(m, fi, sl)
                    }
                    if base >= 0 && mulk == 3 { << 12 }
                    if base >= 0 && mulk == 4 { << 16 }
                }
            }
            ii = types.mir_inext(m, fi, ii)
        }
        << 0
    }
    if lc >= 0 && ld >= 0 {
        la := vec_affine_index(m, fi, bi, lc, ind)
        ra := vec_affine_index(m, fi, bi, ld, ind)
        if la > 0 && ra > 0 {
            sm := pipe_aff_sum(la, ra)
            if sm > 0 { << sm }
        }
    }
    mut other := -1
    mut addk := 0
    if ld < 0 && vec_has_const(m, fi, ld) && lc >= 0 {
        other = lc
        addk = vec_const(m, fi, ld)
    } else if lc < 0 && vec_has_const(m, fi, lc) && ld >= 0 {
        other = ld
        addk = vec_const(m, fi, lc)
    }
    if other < 0 { << 0 }
    inner := vec_affine_index(m, fi, bi, other, ind)
    << pipe_aff_add_k(inner, addk)
}

fn vec_base_local(m &types.Mir, fi int, bi int, base int) int {
    if base >= types.mir_local_operand_base {
        << base - types.mir_local_operand_base
    }
    loc := vec_local_of_temp(m, fi, bi, base)
    if loc >= 0 { << loc }
    // Simplify/LICM hoists the descriptor load into the preheader.
    if vec_defined_here(m, fi, bi, base) { << -1 }
    nb := types.mir_nblocks(m, fi)
    for bj in 0:nb {
        hoisted := vec_local_of_temp(m, fi, bj, base)
        if hoisted >= 0 { << hoisted }
    }
    << -1
}

fn vec_low_ones(m int) bool {
    if m <= 0 { << false }
    << (m & (m + 1)) == 0
}

// Borrowed string indexing may materialize its descriptor with LoadField.
// Only the zero-offset, three-slot string projection from a thin reference
// is an identity descriptor; arbitrary fields remain on the scalar path.
fn pipe_base_local(m &types.Mir, fi int, bi int, base int) int {
    loc := vec_base_local(m, fi, bi, base)
    if loc >= 0 { << loc }
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == types.mi_load_ptr && types.mir_ia(m, fi, ii) == base && types.mir_ic(m, fi, ii) == 0 && types.mir_id(m, fi, ii) == 3 && types.mir_temp_ty(m, fi, base) == 3 {
            root := vec_base_local(m, fi, bi, types.mir_ib(m, fi, ii))
            if root >= 0 && types.mir_local_nslots(m, fi, root) == 1 { << root }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << -1
}

// A direct AND with a low-bit mask proves a lookup index is nonnegative.
// Stop at the use: a later definition must not justify an earlier load.
fn pipe_lookup_mask(m &types.Mir, fi int, bi int, at int, idx int) int {
    if idx < 0 { << 0 }
    mut mask := 0
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 || ii == at { <- }
        k := types.mir_ikind(m, fi, ii)
        if (k == types.mi_copy || k == types.mi_load_local || k == types.mi_bin || k == types.mi_un || k == types.mi_load_index) && types.mir_ia(m, fi, ii) == idx {
            mask = 0
            if k == types.mi_bin && types.mir_ib(m, fi, ii) == 14 {
                lc := types.mir_ic(m, fi, ii)
                ld := types.mir_id(m, fi, ii)
                mut cv := -1
                if lc < 0 && vec_has_const(m, fi, lc) { cv = vec_const(m, fi, lc) }
                if ld < 0 && vec_has_const(m, fi, ld) { cv = vec_const(m, fi, ld) }
                if cv <= 255 && vec_low_ones(cv) { mask = cv }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << mask
}

// mov_imm64 of a value outside 0..65535 is MOVZ plus at least one MOVK.
// A negative value is four instructions. One register for the whole loop
// beats rebuilding it on every use.
fn pipe_const_wide(v int) bool {
    if v < 0 { << true }
    if v > 65535 { << true }
    << false
}

// Caller-saved temps for the byte pipe. Virt 1 is the limit, 6 is the
// induction, 12/13 are data pointers, 14 is the lookup table pointer,
// 0 is the immediate scratch.
// x1–x5 (19–23) are free inside a call-free block.
fn pipe_tmp_reg(rr int) bool {
    if rr == 2 || rr == 3 || rr == 4 || rr == 5 || rr == 7 { << true }
    if rr >= 8 && rr <= 11 { << true }
    if rr >= 19 && rr <= 23 { << true }
    << false
}

// Straight-line byte loop: i += 1, indexes are i / i+1 / 2*i / 2*i+1,
// values are add/sub/mul/and/or/xor/shl/asr of constants and loads.
// A 1-slot int read before it is stored stays in one register and is
// written back for the blocks after the loop. One bounds proof per
// array, then pointer post-increment. One extra readonly byte table may
// use a direct low-bit mask up to 255; short tables use the scalar fallback.
// Not a name or benchmark gate.
fn match_byte_pipe(m &types.Mir, fi int, bi int) VecPat {
    if types.mir_btkind(m, fi, bi) != 2 { << vec_none() }
    if !vec_edge_to(m, fi, types.mir_btb(m, fi, bi), bi) { << vec_none() }
    else_bb := types.mir_btc(m, fi, bi)
    if else_bb < 0 || else_bb == bi { << vec_none() }
    ind := vec_find_ind(m, fi, bi)
    if ind < 0 { << vec_none() }
    limit_t := vec_block_lt_limit(m, fi, bi, ind)
    if limit_t < 0 { << vec_none() }
    // Simplify hoists `n := len` out of the latch. The compare then uses
    // that temp. It must not be redefined in the loop.
    mut lim_loc := vec_local_of_temp(m, fi, bi, limit_t)
    mut lim_enc := limit_t
    if lim_loc >= 0 {
        if lim_loc == ind { << vec_none() }
        lim_enc = types.mir_local_operand_base + lim_loc
    } else if vec_defined_here(m, fi, bi, limit_t) {
        << vec_none()
    }
    mut nst := 0
    mut nld := 0
    mut nind := 0
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == types.mi_store_index {
            nst = nst + 1
            w := types.mir_id(m, fi, ii)
            mut aw := w
            if aw < 0 { aw = 0 - aw }
            if aw != 1 { << vec_none() }
            if vec_affine_index(m, fi, bi, types.mir_ib(m, fi, ii), ind) == 0 {
                << vec_none()
            }
            bl := pipe_base_local(m, fi, bi, types.mir_ia(m, fi, ii))
            if bl < 0 || bl == ind || bl == lim_loc { << vec_none() }
            if emit_base_fixed_len(m, fi, types.mir_local_operand_base + bl) > 0 { << vec_none() }
        } else if k == types.mi_load_index {
            nld = nld + 1
            w := types.mir_id(m, fi, ii)
            mut aw := w
            if aw < 0 { aw = 0 - aw }
            if aw != 1 { << vec_none() }
            if vec_affine_index(m, fi, bi, types.mir_ic(m, fi, ii), ind) == 0 && pipe_lookup_mask(m, fi, bi, ii, types.mir_ic(m, fi, ii)) == 0 {
                << vec_none()
            }
            bl := pipe_base_local(m, fi, bi, types.mir_ib(m, fi, ii))
            if bl < 0 || bl == ind || bl == lim_loc { << vec_none() }
            if emit_base_fixed_len(m, fi, types.mir_local_operand_base + bl) > 0 { << vec_none() }
        } else if k == types.mi_load_ptr {
            if pipe_base_local(m, fi, bi, types.mir_ia(m, fi, ii)) < 0 { << vec_none() }
        } else if k == types.mi_store_local {
            loc := types.mir_ia(m, fi, ii)
            if loc == lim_loc { << vec_none() }
            if loc == ind {
                nind = nind + 1
            } else if loc >= 0 {
                // Fat locals are not one register. Fail closed.
                if types.mir_local_nslots(m, fi, loc) != 1 || types.mir_local_ty(m, fi, loc) != 1 {
                    << vec_none()
                }
            }
        } else if k == types.mi_bin {
            op := types.mir_ib(m, fi, ii)
            if op != 1 && op != 2 && op != 3 && op != 14 && op != 15 && op != 16 && op != 17 && op != 18 && (op < 6 || op > 11) {
                << vec_none()
            }
        } else if k == types.mi_un {
            // Unary minus. LICM may leave it in the latch when the
            // function also has a pointer store (error alloc).
            if types.mir_ib(m, fi, ii) != 1 { << vec_none() }
        } else if k != types.mi_copy && k != types.mi_load_local {
            << vec_none()
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if nst < 1 || nind != 1 {
        << vec_none()
    }
    // Carried int: loaded before it is stored (`bad = bad | flag`).
    // Same-iteration scratch (`c`, `d`) is stored first. A later block
    // may read a carried int because the pipe writes that register back.
    // Any other stored local stays on the scalar path.
    nloc := types.mir_nlocals(m, fi)
    mut st_at := []int{}
    mut ld_at := []int{}
    for _ in 0:nloc {
        st_at.push(-1)
        ld_at.push(-1)
    }
    mut ord := 0
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == types.mi_store_local {
            loc := types.mir_ia(m, fi, ii)
            if loc >= 0 && loc < nloc && loc != ind && st_at[loc] < 0 {
                st_at[loc] = ord
            }
        }
        if k == types.mi_load_local {
            loc := types.mir_ib(m, fi, ii)
            if loc >= 0 && loc < nloc && loc != ind && loc != lim_loc && ld_at[loc] < 0 {
                ld_at[loc] = ord
            }
        }
        ord = ord + 1
        ii = types.mir_inext(m, fi, ii)
    }
    for loc in 0:nloc {
        if st_at[loc] >= 0 && ld_at[loc] >= 0 && ld_at[loc] < st_at[loc] {
            // One register for a loop-carried int. Fat locals stay scalar.
            if types.mir_local_nslots(m, fi, loc) != 1 || types.mir_local_ty(m, fi, loc) != 1 {
                << vec_none()
            }
        }
    }
    nb := types.mir_nblocks(m, fi)
    for bj in 0:nb {
        if bj == bi { -> }
        mut jj := types.mir_bhead(m, fi, bj)
        for _ in 0:types.mir_nins(m, fi) {
            if jj < 0 { <- }
            if types.mir_ikind(m, fi, jj) == types.mi_load_local {
                loc := types.mir_ib(m, fi, jj)
                if loc >= 0 && loc < nloc && st_at[loc] >= 0 && loc != ind {
                    if ld_at[loc] < 0 || ld_at[loc] >= st_at[loc] {
                        << vec_none()
                    }
                }
            }
            jj = types.mir_inext(m, fi, jj)
        }
    }
    << VecPat{kind: vp_byte_pipe, ind: ind, acc: 0, mask: 0, limit: 0, limit_t: lim_enc, else_bb: else_bb, arr: -1, fac: -1}
}

// The pool owns its array so replacement writes through a mutable field.
struct BytePipeRegPool {
    regs []int
}

fn pipe_pop_reg(pool &mut BytePipeRegPool) int {
    if pool.regs.len == 0 { << -1 }
    r := pool.regs[pool.regs.len - 1]
    mut np := []int{}
    for z in 0:pool.regs.len - 1 { np.push(pool.regs[z]) }
    pool.regs = np
    << r
}

fn pipe_allocate_prepass(a &Assembler, m &types.Mir, fi int, fr &Frame, bi int, p VecPat, nt int, nloc int, lim_loc int, needed &[]int, refs &mut []int, pool &mut BytePipeRegPool, home &mut []int, carried &mut []int, const_ok &mut []int, const_of &mut []int, mem_ok &mut []int, wide_v &mut []int, wide_r &mut []int, reg_of &mut []int, ld_left &mut []int) int {
    mut st_at := []int{}
    mut ld_at := []int{}
    for _ in 0:nloc {
        carried.push(0)
        st_at.push(-1)
        ld_at.push(-1)
        ld_left.push(0)
    }
    mut cord := 0
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == types.mi_store_local {
            loc := types.mir_ia(m, fi, ii)
            if loc >= 0 && loc < nloc && loc != p.ind && loc != lim_loc && st_at[loc] < 0 {
                st_at[loc] = cord
            }
        }
        if k == types.mi_load_local {
            loc := types.mir_ib(m, fi, ii)
            if loc >= 0 && loc < nloc && loc != p.ind && loc != lim_loc {
                if ld_at[loc] < 0 { ld_at[loc] = cord }
                ld_left[loc] = ld_left[loc] + 1
            }
        }
        cord = cord + 1
        ii = types.mir_inext(m, fi, ii)
    }
    for loc in 0:nloc {
        if st_at[loc] >= 0 && ld_at[loc] >= 0 && ld_at[loc] < st_at[loc] {
            if types.mir_local_nslots(m, fi, loc) != 1 || types.mir_local_ty(m, fi, loc) != 1 {
                << 0
            } else {
                carried[loc] = 1
                r := pipe_pop_reg(pool)
                if r < 0 {
                    << 0
                } else {
                    home[loc] = r
                    refs[r] = 1
                }
            }
        }
    }
    mut const_bad := []int{}
    for _ in 0:nt {
        const_of.push(0)
        const_ok.push(0)
        const_bad.push(0)
    }
    nb2 := types.mir_nblocks(m, fi)
    for bj in 0:nb2 {
        mut jj := types.mir_bhead(m, fi, bj)
        for _ in 0:types.mir_nins(m, fi) {
            if jj < 0 { <- }
            dk := types.mir_ikind(m, fi, jj)
            if dk == types.mi_copy || dk == types.mi_load_local || dk == types.mi_bin || dk == types.mi_load_index {
                dest := types.mir_ia(m, fi, jj)
                if dest >= 0 && dest < nt {
                    if dk == types.mi_copy {
                        src := types.mir_ib(m, fi, jj)
                        if src < 0 && vec_has_const(m, fi, src) && const_bad[dest] == 0 {
                            cv := vec_const(m, fi, src)
                            if const_ok[dest] == 0 {
                                const_of[dest] = cv
                                const_ok[dest] = 1
                            } else if const_of[dest] != cv {
                                const_ok[dest] = 0
                                const_bad[dest] = 1
                            }
                        } else {
                            const_ok[dest] = 0
                            const_bad[dest] = 1
                        }
                    } else {
                        const_ok[dest] = 0
                        const_bad[dest] = 1
                    }
                }
            }
            jj = types.mir_inext(m, fi, jj)
        }
    }
    for t in 0:nt {
        if needed[t] == 1 && const_ok[t] == 1 {
            r := pipe_pop_reg(pool)
            if r < 0 {
                << 0
            } else {
                reg_of[t] = r
                refs[r] = 1000000
            }
        }
    }
    mut def_here := []int{}
    for _ in 0:nt {
        def_here.push(0)
        mem_ok.push(0)
    }
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        dk := types.mir_ikind(m, fi, ii)
        if dk == types.mi_copy || dk == types.mi_load_local || dk == types.mi_bin || dk == types.mi_un || dk == types.mi_load_index {
            dest := types.mir_ia(m, fi, ii)
            if dest >= 0 && dest < nt { def_here[dest] = 1 }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if a.rc_on == false {
        for t in 0:nt {
            if needed[t] == 1 && def_here[t] == 0 && reg_of[t] < 0 && t < fr.temp_slot.len {
                if !is_frame_slot(fr.temp_slot[t]) {
                    << 0
                } else {
                    r := pipe_pop_reg(pool)
                    if r < 0 {
                        << 0
                    } else {
                        reg_of[t] = r
                        refs[r] = 1000000
                        mem_ok[t] = 1
                    }
                }
            }
        }
    }
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == types.mi_bin {
            opw := types.mir_ib(m, fi, ii)
            if opw < 6 || opw > 11 {
                mut side := 0
                while side < 2 {
                    mut cv_id := types.mir_ic(m, fi, ii)
                    if side == 1 { cv_id = types.mir_id(m, fi, ii) }
                    if cv_id < 0 && vec_has_const(m, fi, cv_id) {
                        cv := vec_const(m, fi, cv_id)
                        if pipe_const_wide(cv) && wide_v.len < 4 {
                            mut seen := 0
                            for q in 0:wide_v.len {
                                if wide_v[q] == cv { seen = 1 }
                            }
                            if seen == 0 && pool.regs.len > 0 {
                                r := pipe_pop_reg(pool)
                                refs[r] = 1000000
                                wide_v.push(cv)
                                wide_r.push(r)
                            }
                        }
                    }
                    side = side + 1
                }
            }
        } else if types.mir_ikind(m, fi, ii) == types.mi_un && types.mir_ib(m, fi, ii) == 1 {
            srcw := types.mir_ic(m, fi, ii)
            if srcw < 0 && vec_has_const(m, fi, srcw) {
                cv := 0 - vec_const(m, fi, srcw)
                if pipe_const_wide(cv) && wide_v.len < 4 {
                    mut seen := 0
                    for q in 0:wide_v.len {
                        if wide_v[q] == cv { seen = 1 }
                    }
                    if seen == 0 && pool.regs.len > 0 {
                        r := pipe_pop_reg(pool)
                        refs[r] = 1000000
                        wide_v.push(cv)
                        wide_r.push(r)
                    }
                }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << 1
}

fn pipe_allocate_registers(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, p VecPat, nt int, nloc int, lim_loc int, needed &[]int, uses &mut []int, reg_of &mut []int, home &mut []int, carried &mut []int, const_ok &mut []int, const_of &mut []int, mem_ok &mut []int, wide_v &mut []int, wide_r &mut []int) int {
    mut refs := []int{}
    mut pool := BytePipeRegPool{regs: []int{}}
    for _ in 0:nt { reg_of.push(-1) }
    for _ in 0:24 { refs.push(0) }
    for _ in 0:nloc { home.push(-1) }
    pool.regs.push(2)
    pool.regs.push(3)
    pool.regs.push(4)
    pool.regs.push(5)
    pool.regs.push(7)
    pool.regs.push(8)
    pool.regs.push(9)
    pool.regs.push(10)
    pool.regs.push(11)
    pool.regs.push(19)
    pool.regs.push(20)
    pool.regs.push(21)
    pool.regs.push(22)
    pool.regs.push(23)
    mut ld_left := []int{}
    if pipe_allocate_prepass(&*a, m, fi, fr, bi, p, nt, nloc, lim_loc, needed, mut &refs, mut &pool, home, carried, const_ok, const_of, mem_ok, wide_v, wide_r, reg_of, mut &ld_left) == 0 {
        << 0
    }
    mut failed := 0
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if failed == 1 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == types.mi_load_index {
            dest := types.mir_ia(m, fi, ii)
            if dest >= 0 && dest < nt && needed[dest] == 1 {
                r := pipe_pop_reg(mut &pool)
                if r < 0 { failed = 1 } else {
                    reg_of[dest] = r
                    refs[r] = 1
                }
                idx := types.mir_ic(m, fi, ii)
                if pipe_lookup_mask(m, fi, bi, ii, idx) > 0 && idx >= 0 && idx < nt && uses[idx] > 0 {
                    uses[idx] = uses[idx] - 1
                    if uses[idx] == 0 {
                        rr := reg_of[idx]
                        if pipe_tmp_reg(rr) {
                            if refs[rr] > 0 { refs[rr] = refs[rr] - 1 }
                            if refs[rr] == 0 {
                                mut pin := 0
                                for h in 0:nloc { if home[h] == rr { pin = 1 } }
                                if pin == 0 { pool.regs.push(rr) }
                            }
                        }
                    }
                }
            }
        } else if k == types.mi_bin {
            dest := types.mir_ia(m, fi, ii)
            op := types.mir_ib(m, fi, ii)
            if dest >= 0 && dest < nt && needed[dest] == 1 && (op < 6 || op > 11) {
                r := pipe_pop_reg(mut &pool)
                if r < 0 { failed = 1 } else {
                    reg_of[dest] = r
                    refs[r] = 1
                }
                if failed == 0 {
                    lc := types.mir_ic(m, fi, ii)
                    ld := types.mir_id(m, fi, ii)
                    if lc >= 0 && lc < nt && uses[lc] > 0 {
                        uses[lc] = uses[lc] - 1
                        if uses[lc] == 0 {
                            rr := reg_of[lc]
                            if pipe_tmp_reg(rr) {
                                if refs[rr] > 0 { refs[rr] = refs[rr] - 1 }
                                if refs[rr] == 0 {
                                    mut pin := 0
                                    for h in 0:nloc { if home[h] == rr { pin = 1 } }
                                    if pin == 0 { pool.regs.push(rr) }
                                }
                            }
                        }
                    }
                    if ld >= 0 && ld < nt && uses[ld] > 0 {
                        uses[ld] = uses[ld] - 1
                        if uses[ld] == 0 {
                            rr := reg_of[ld]
                            if pipe_tmp_reg(rr) {
                                if refs[rr] > 0 { refs[rr] = refs[rr] - 1 }
                                if refs[rr] == 0 {
                                    mut pin := 0
                                    for h in 0:nloc { if home[h] == rr { pin = 1 } }
                                    if pin == 0 { pool.regs.push(rr) }
                                }
                            }
                        }
                    }
                }
            }
        } else if k == types.mi_un {
            dest := types.mir_ia(m, fi, ii)
            op := types.mir_ib(m, fi, ii)
            if op == 1 && dest >= 0 && dest < nt && needed[dest] == 1 && reg_of[dest] < 0 {
                src0 := types.mir_ic(m, fi, ii)
                mut aliased := 0
                if src0 < 0 && vec_has_const(m, fi, src0) {
                    cvn := 0 - vec_const(m, fi, src0)
                    for q in 0:wide_v.len {
                        if wide_v[q] == cvn {
                            reg_of[dest] = wide_r[q]
                            aliased = 1
                        }
                    }
                }
                if aliased == 0 {
                    r := pipe_pop_reg(mut &pool)
                    if r < 0 { failed = 1 } else {
                        reg_of[dest] = r
                        refs[r] = 1
                    }
                }
                if failed == 0 {
                    src := types.mir_ic(m, fi, ii)
                    if src >= 0 && src < nt && uses[src] > 0 {
                        uses[src] = uses[src] - 1
                        if uses[src] == 0 {
                            rr := reg_of[src]
                            if pipe_tmp_reg(rr) {
                                if refs[rr] > 0 { refs[rr] = refs[rr] - 1 }
                                if refs[rr] == 0 {
                                    mut pin := 0
                                    for h in 0:nloc { if home[h] == rr { pin = 1 } }
                                    if pin == 0 { pool.regs.push(rr) }
                                }
                            }
                        }
                    }
                }
            }
        } else if k == types.mi_copy {
            dest := types.mir_ia(m, fi, ii)
            src := types.mir_ib(m, fi, ii)
            if dest >= 0 && dest < nt && needed[dest] == 1 {
                if src >= 0 && src < nt && reg_of[src] >= 0 {
                    rr := reg_of[src]
                    reg_of[dest] = rr
                    if pipe_tmp_reg(rr) { refs[rr] = refs[rr] + 1 }
                    if uses[src] > 0 {
                        uses[src] = uses[src] - 1
                        if uses[src] == 0 && pipe_tmp_reg(rr) {
                            if refs[rr] > 0 { refs[rr] = refs[rr] - 1 }
                            if refs[rr] == 0 {
                                mut pin := 0
                                for h in 0:nloc { if home[h] == rr { pin = 1 } }
                                if pin == 0 { pool.regs.push(rr) }
                            }
                        }
                    }
                } else if src < 0 && vec_has_const(m, fi, src) {
                    r := pipe_pop_reg(mut &pool)
                    if r < 0 { failed = 1 } else {
                        reg_of[dest] = r
                        refs[r] = 1
                    }
                } else {
                    failed = 1
                }
            }
        } else if k == types.mi_load_local {
            dest := types.mir_ia(m, fi, ii)
            loc := types.mir_ib(m, fi, ii)
            if loc >= 0 && loc < nloc && loc != p.ind && loc != lim_loc && ld_left[loc] > 0 {
                ld_left[loc] = ld_left[loc] - 1
            }
            if dest >= 0 && dest < nt && needed[dest] == 1 {
                if loc == p.ind {
                    reg_of[dest] = 6
                } else if loc == lim_loc {
                    reg_of[dest] = 1
                } else if loc >= 0 && loc < nloc && home[loc] >= 0 {
                    r := home[loc]
                    reg_of[dest] = r
                    if pipe_tmp_reg(r) { refs[r] = refs[r] + 1 }
                    if carried[loc] == 0 && ld_left[loc] == 0 { home[loc] = -1 }
                } else {
                    failed = 1
                }
            }
        } else if k == types.mi_store_local {
            loc := types.mir_ia(m, fi, ii)
            v := types.mir_ib(m, fi, ii)
            if loc != p.ind && loc >= 0 && loc < nloc && v >= 0 && v < nt && needed[v] == 1 {
                rr := reg_of[v]
                if rr < 0 { failed = 1 } else if carried[loc] == 1 {
                    if uses[v] > 0 {
                        uses[v] = uses[v] - 1
                        if uses[v] == 0 && pipe_tmp_reg(rr) && rr != home[loc] {
                            if refs[rr] > 0 { refs[rr] = refs[rr] - 1 }
                            if refs[rr] == 0 {
                                mut pin := 0
                                for h in 0:nloc { if home[h] == rr { pin = 1 } }
                                if pin == 0 { pool.regs.push(rr) }
                            }
                        }
                    }
                } else if ld_left[loc] == 0 {
                    if uses[v] > 0 {
                        uses[v] = uses[v] - 1
                        if uses[v] == 0 && pipe_tmp_reg(rr) {
                            if refs[rr] > 0 { refs[rr] = refs[rr] - 1 }
                            if refs[rr] == 0 {
                                mut pin := 0
                                for h in 0:nloc { if home[h] == rr { pin = 1 } }
                                if pin == 0 { pool.regs.push(rr) }
                            }
                        }
                    }
                } else {
                    old := home[loc]
                    home[loc] = rr
                    if uses[v] > 0 {
                        uses[v] = uses[v] - 1
                        if uses[v] == 0 && pipe_tmp_reg(rr) {
                            if refs[rr] > 0 { refs[rr] = refs[rr] - 1 }
                        }
                    }
                    if old >= 0 && old != rr && pipe_tmp_reg(old) && refs[old] == 0 {
                        mut pin := 0
                        for h in 0:nloc { if home[h] == old { pin = 1 } }
                        if pin == 0 { pool.regs.push(old) }
                    }
                }
            }
        } else if k == types.mi_store_index {
            v := types.mir_ic(m, fi, ii)
            if v >= 0 && v < nt && needed[v] == 1 && uses[v] > 0 {
                uses[v] = uses[v] - 1
                if uses[v] == 0 {
                    rr := reg_of[v]
                    if pipe_tmp_reg(rr) {
                        if refs[rr] > 0 { refs[rr] = refs[rr] - 1 }
                        if refs[rr] == 0 {
                            mut pin := 0
                            for h in 0:nloc { if home[h] == rr { pin = 1 } }
                            if pin == 0 { pool.regs.push(rr) }
                        }
                    }
                }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if failed == 1 {
        << 0
    }
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == types.mi_load_index || k == types.mi_bin || k == types.mi_copy || k == types.mi_un {
            dest := types.mir_ia(m, fi, ii)
            mut op := 0
            if k == types.mi_bin || k == types.mi_un { op = types.mir_ib(m, fi, ii) }
            if dest >= 0 && dest < nt && needed[dest] == 1 && (k != types.mi_bin || (op < 6 || op > 11)) && (k != types.mi_un || op == 1) {
                if reg_of[dest] < 0 {
                    << 0
                }
                if k == types.mi_load_index && pipe_lookup_mask(m, fi, bi, ii, types.mir_ic(m, fi, ii)) > 0 {
                    idx := types.mir_ic(m, fi, ii)
                    if idx < 0 || idx >= nt || reg_of[idx] < 0 { << 0 }
                }
                if k == types.mi_bin {
                    lc := types.mir_ic(m, fi, ii)
                    ld := types.mir_id(m, fi, ii)
                    if lc >= 0 && lc < nt && reg_of[lc] < 0 { << 0 }
                    if ld >= 0 && ld < nt && reg_of[ld] < 0 { << 0 }
                }
                if k == types.mi_un {
                    src := types.mir_ic(m, fi, ii)
                    if src >= 0 && src < nt && reg_of[src] < 0 { << 0 }
                }
            }
        } else if k == types.mi_store_local {
            loc := types.mir_ia(m, fi, ii)
            v := types.mir_ib(m, fi, ii)
            if loc >= 0 && loc < nloc && carried[loc] == 1 && v >= 0 && v < nt && needed[v] == 1 {
                if reg_of[v] < 0 { << 0 }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << 1
}

fn emit_byte_pipe_body(a &mut Assembler, m &types.Mir, fi int, bi int, p VecPat, nt int, nloc int, needed &[]int, reg_of &[]int, wide_v &[]int, wide_r &[]int, blocs &[]int, carried &[]int, home &[]int) int {
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == types.mi_un {
            dest := types.mir_ia(m, fi, ii)
            op := types.mir_ib(m, fi, ii)
            if op == 1 && dest >= 0 && dest < nt && needed[dest] == 1 && reg_of[dest] >= 0 {
                rd := reg_of[dest]
                src := types.mir_ic(m, fi, ii)
                if src < 0 && vec_has_const(m, fi, src) {
                    cvn := 0 - vec_const(m, fi, src)
                    mut wr := -1
                    for q in 0:wide_v.len {
                        if wide_v[q] == cvn { wr = wide_r[q] }
                    }
                    if wr >= 0 {
                        if wr != rd { a.mov(rd, wr) }
                    } else {
                        a.vm_mov_imm64(rd, cvn)
                    }
                } else if src >= 0 && src < nt && reg_of[src] >= 0 {
                    a.neg(rd, reg_of[src])
                } else {
                    << 0
                }
            }
        } else if k == types.mi_load_index {
            dest := types.mir_ia(m, fi, ii)
            if dest >= 0 && dest < nt && needed[dest] == 1 {
                bl := pipe_base_local(m, fi, bi, types.mir_ib(m, fi, ii))
                aff := vec_affine_index(m, fi, bi, types.mir_ic(m, fi, ii), p.ind)
                if aff == 0 {
                    idx := types.mir_ic(m, fi, ii)
                    a.add(0, 14, reg_of[idx])
                    a.load_byte(reg_of[dest], 0, 0)
                } else {
                    sc := aff / 4
                    off := aff - sc * 4
                    mut ptr := 12
                    if blocs.len > 1 && bl == blocs[1] { ptr = 13 }
                    a.load_byte(reg_of[dest], ptr, off)
                }
            }
        } else if k == types.mi_store_index {
            bl := pipe_base_local(m, fi, bi, types.mir_ia(m, fi, ii))
            aff := vec_affine_index(m, fi, bi, types.mir_ib(m, fi, ii), p.ind)
            sc := aff / 4
            off := aff - sc * 4
            mut ptr := 12
            if blocs.len > 1 && bl == blocs[1] { ptr = 13 }
            v := types.mir_ic(m, fi, ii)
            if v < 0 && vec_has_const(m, fi, v) {
                a.vm_mov_imm64(0, vec_const(m, fi, v))
                a.store_byte(ptr, off, 0)
            } else if v >= 0 && v < nt && reg_of[v] >= 0 {
                a.store_byte(ptr, off, reg_of[v])
            } else {
                << 0
            }
        } else if k == types.mi_bin {
            dest := types.mir_ia(m, fi, ii)
            op := types.mir_ib(m, fi, ii)
            if dest >= 0 && dest < nt && needed[dest] == 1 && (op < 6 || op > 11) {
                rd := reg_of[dest]
                lc := types.mir_ic(m, fi, ii)
                ld := types.mir_id(m, fi, ii)
                mut lr := -1
                mut rr := -1
                mut lk := 0
                mut rk := 0
                if lc < 0 && vec_has_const(m, fi, lc) {
                    lk = vec_const(m, fi, lc)
                    for q in 0:wide_v.len {
                        if wide_v[q] == lk { lr = wide_r[q] }
                    }
                } else if lc >= 0 && lc < nt {
                    lr = reg_of[lc]
                }
                if ld < 0 && vec_has_const(m, fi, ld) {
                    rk = vec_const(m, fi, ld)
                    for q in 0:wide_v.len {
                        if wide_v[q] == rk { rr = wide_r[q] }
                    }
                } else if ld >= 0 && ld < nt {
                    rr = reg_of[ld]
                }
                if op == 1 {
                    if lc < 0 && lk >= 0 && lk <= 4095 && rr >= 0 {
                        a.vm_add_imm(rd, rr, lk)
                    } else if ld < 0 && rk >= 0 && rk <= 4095 && lr >= 0 {
                        a.vm_add_imm(rd, lr, rk)
                    } else {
                        if lc < 0 && lr < 0 {
                            a.vm_mov_imm64(0, lk)
                            lr = 0
                        }
                        if ld < 0 && rr < 0 {
                            a.vm_mov_imm64(0, rk)
                            rr = 0
                        }
                        if lr < 0 || rr < 0 { << 0 }
                        a.add(rd, lr, rr)
                    }
                } else if op == 2 {
                    if ld < 0 && rk >= 0 && rk <= 4095 && lr >= 0 {
                        a.vm_sub_imm(rd, lr, rk)
                    } else {
                        if lc < 0 && lr < 0 {
                            a.vm_mov_imm64(0, lk)
                            lr = 0
                        }
                        if ld < 0 && rr < 0 {
                            a.vm_mov_imm64(0, rk)
                            rr = 0
                        }
                        if lr < 0 || rr < 0 { << 0 }
                        a.sub(rd, lr, rr)
                    }
                } else if op == 15 {
                    if lc < 0 && lr < 0 {
                        a.vm_mov_imm64(0, lk)
                        lr = 0
                    }
                    if ld < 0 && rr < 0 {
                        a.vm_mov_imm64(0, rk)
                        rr = 0
                    }
                    if lr < 0 || rr < 0 { << 0 }
                    a.ior(rd, lr, rr)
                } else if op == 16 {
                    if lc < 0 && lr < 0 {
                        a.vm_mov_imm64(0, lk)
                        lr = 0
                    }
                    if ld < 0 && rr < 0 {
                        a.vm_mov_imm64(0, rk)
                        rr = 0
                    }
                    if lr < 0 || rr < 0 { << 0 }
                    a.ixor(rd, lr, rr)
                } else if op == 3 {
                    if lc < 0 && lr < 0 {
                        a.vm_mov_imm64(0, lk)
                        lr = 0
                    }
                    if ld < 0 && rr < 0 {
                        a.vm_mov_imm64(0, rk)
                        rr = 0
                    }
                    if lr < 0 || rr < 0 { << 0 }
                    a.mul(rd, lr, rr)
                } else if op == 14 {
                    if ld < 0 && vec_low_ones(rk) && lr >= 0 {
                        a.vm_and_imm(rd, lr, rk)
                    } else if lc < 0 && vec_low_ones(lk) && rr >= 0 {
                        a.vm_and_imm(rd, rr, lk)
                    } else {
                        if lc < 0 && lr < 0 {
                            a.vm_mov_imm64(0, lk)
                            lr = 0
                        }
                        if ld < 0 && rr < 0 {
                            a.vm_mov_imm64(0, rk)
                            rr = 0
                        }
                        if lr < 0 || rr < 0 { << 0 }
                        a.iand(rd, lr, rr)
                    }
                } else if op == 17 {
                    if ld < 0 && lr >= 0 {
                        a.shl_imm(rd, lr, rk & 63)
                    } else {
                        if lc < 0 && lr < 0 {
                            a.vm_mov_imm64(0, lk)
                            lr = 0
                        }
                        if ld < 0 && rr < 0 {
                            a.vm_mov_imm64(0, rk)
                            rr = 0
                        }
                        if lr < 0 || rr < 0 { << 0 }
                        a.shl(rd, lr, rr)
                    }
                } else if op == 18 {
                    if ld < 0 && lr >= 0 {
                        a.asr_imm(map_reg(rd), map_reg(lr), rk & 63)
                    } else {
                        if lc < 0 && lr < 0 {
                            a.vm_mov_imm64(0, lk)
                            lr = 0
                        }
                        if ld < 0 && rr < 0 {
                            a.vm_mov_imm64(0, rk)
                            rr = 0
                        }
                        if lr < 0 || rr < 0 { << 0 }
                        a.shr(rd, lr, rr)
                    }
                }
            }
        } else if k == types.mi_copy {
            dest := types.mir_ia(m, fi, ii)
            src := types.mir_ib(m, fi, ii)
            if dest >= 0 && dest < nt && needed[dest] == 1 && reg_of[dest] >= 0 {
                if src < 0 && vec_has_const(m, fi, src) {
                    a.vm_mov_imm64(reg_of[dest], vec_const(m, fi, src))
                } else if src >= 0 && src < nt && reg_of[src] >= 0 && reg_of[src] != reg_of[dest] {
                    a.mov(reg_of[dest], reg_of[src])
                }
            }
        } else if k == types.mi_store_local {
            loc := types.mir_ia(m, fi, ii)
            if loc == p.ind {
                a.vm_add_imm(6, 6, 1)
            } else if loc >= 0 && loc < nloc && carried[loc] == 1 {
                v := types.mir_ib(m, fi, ii)
                if v >= 0 && v < nt && reg_of[v] >= 0 && reg_of[v] != home[loc] {
                    a.mov(home[loc], reg_of[v])
                }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << 1
}

fn emit_byte_pipe_code(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, p VecPat, nt int, nloc int, lim_loc int, table_loc int, table_mask int, needed &[]int, reg_of &[]int, home &[]int, carried &[]int, const_ok &[]int, const_of &[]int, mem_ok &[]int, wide_v &[]int, wide_r &[]int, blocs &[]int, bscale &[]int, boff &[]int, bstore &[]int) int {
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi)
    slow := pref + "_bp_scalar"
    mut bounds_lbl := a.oob_lbl + ""
    if table_loc >= 0 { bounds_lbl = slow + "" }
    skip := pref + "_bp0"
    loop := pref + "_bp1"
    else_lbl := types.mir_fn_label(m, fi) + "_bb" + str(p.else_bb)
    a.load(6, 15, slot_off(fr.local_slot[p.ind]))
    if lim_loc >= 0 {
        a.load(1, 15, slot_off(fr.local_slot[lim_loc]))
    } else {
        emit_load_value(a, m, fi, fr, p.limit_t, 1)
    }
    a.cmp(6, 1)
    a.jge(skip + "")
    if table_loc >= 0 {
        emit_index_desc_addr(a, m, fi, fr, types.mir_local_operand_base + table_loc)
        a.load(2, 0, -8)
        a.vm_cmp_imm(2, table_mask + 1)
        // A short table may still serve every actual index. Fall back,
        // preserving scalar bounds checks and their order of side effects.
        a.jlt(slow + "")
        a.load(14, 0, 0)
    }
    a.vm_cmp_imm(6, 0)
    a.oob_need = 1
    a.jlt(bounds_lbl + "")
    for q in 0:blocs.len {
        enc := types.mir_local_operand_base + blocs[q]
        emit_index_desc_addr(a, m, fi, fr, enc)
        a.load(2, 0, -8)
        a.vm_cmp_imm(2, 0)
        a.jlt(bounds_lbl + "")
        if bscale[q] == 1 {
            a.cmp(1, 2)
            a.jgt(bounds_lbl + "")
        } else if bscale[q] == 2 && boff[q] >= 1 {
            a.shr_imm(4, 2, 1)
            a.cmp(1, 4)
            a.jgt(bounds_lbl + "")
        } else if bscale[q] == 2 {
            a.vm_sub_imm(4, 2, 1)
            a.shr_imm(4, 4, 1)
            a.vm_sub_imm(2, 1, 1)
            a.cmp(2, 4)
            a.jgt(bounds_lbl + "")
        } else if bscale[q] == 4 {
            a.shr_imm(4, 2, 2)
            a.cmp(1, 4)
            a.jgt(bounds_lbl + "")
        } else if bscale[q] == 3 {
            a.vm_mov_imm64(3, 3)
            a.div(4, 2, 3)
            a.cmp(1, 4)
            a.jgt(bounds_lbl + "")
        } else {
            << 0
        }
        if bstore[q] == 1 && emit_store_base_is_string(m, fi, enc) {
            a.load(2, 0, -16)
            a.vm_cmp_imm(2, 1)
            a.jlt(bounds_lbl + "")
        }
        mut ptr := 12
        if q == 1 { ptr = 13 }
        a.load(ptr, 0, 0)
        if bscale[q] == 2 {
            a.add_lsl_vr(ptr, ptr, 6, 1)
        } else if bscale[q] == 4 {
            a.add_lsl_vr(ptr, ptr, 6, 2)
        } else if bscale[q] == 3 {
            a.add_lsl_vr(0, 6, 6, 1)
            a.add(ptr, ptr, 0)
        } else {
            a.add(ptr, ptr, 6)
        }
    }
    for loc in 0:nloc {
        if carried[loc] == 1 && home[loc] >= 0 {
            a.load(home[loc], 15, slot_off(fr.local_slot[loc]))
        }
    }
    for t in 0:nt {
        if const_ok[t] == 1 && reg_of[t] >= 0 {
            a.vm_mov_imm64(reg_of[t], const_of[t])
        } else if mem_ok[t] == 1 && reg_of[t] >= 0 {
            a.load(reg_of[t], 15, slot_off(fr.temp_slot[t]))
        }
    }
    for q in 0:wide_v.len {
        a.vm_mov_imm64(wide_r[q], wide_v[q])
    }
    a.label(loop + "")
    if emit_byte_pipe_body(a, m, fi, bi, p, nt, nloc, needed, reg_of, wide_v, wide_r, blocs, carried, home) == 0 {
        << 0
    }
    for q in 0:blocs.len {
        mut ptr := 12
        if q == 1 { ptr = 13 }
        a.vm_add_imm(ptr, ptr, bscale[q])
    }
    a.cmp(6, 1)
    a.jlt(loop + "")
    for loc in 0:nloc {
        if carried[loc] == 1 && home[loc] >= 0 {
            a.store(15, slot_off(fr.local_slot[loc]), home[loc])
        }
    }
    a.label(skip + "")
    a.store(15, slot_off(fr.local_slot[p.ind]), 6)
    a.jmp(else_lbl + "")
    if table_loc >= 0 {
        a.label(slow + "")
        // The caller emits the unchanged scalar block after this label.
        // The fast path already jumps to the loop exit.
        << 0
    }
    << 1
}

fn emit_byte_pipe(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, p VecPat) int {
    if p.kind != 19 || p.ind < 0 || p.ind >= fr.local_slot.len { << 0 }
    if p.else_bb >= 0 && emit_byte_eq16(a, m, fi, fr, bi, p) != 0 { << 1 }
    if p.else_bb >= 0 && emit_byte_x2(a, m, fi, fr, bi, p) != 0 { << 1 }
    // The generic pipe allocates ARM64 virtual registers. Other backends
    // alias those registers (x64 A4 aliases the data pointer in S4), so only
    // the target-aware specializations above may replace their scalar loop.
    if a.arch != 0 { << 0 }
    mut lim_loc := -1
    if p.limit_t >= types.mir_local_operand_base {
        lim_loc = p.limit_t - types.mir_local_operand_base
        if lim_loc < 0 || lim_loc >= fr.local_slot.len { << 0 }
    } else if p.limit_t < 0 || p.limit_t >= fr.temp_slot.len {
        << 0
    }
    if p.else_bb < 0 { << 0 }
    nt := types.mir_ntemps(m, fi)
    if nt < 1 { << 0 }
    nloc := types.mir_nlocals(m, fi)
    mut table_loc := -1
    mut table_mask := 0
    mut ti := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ti < 0 { <- }
        if types.mir_ikind(m, fi, ti) == types.mi_load_index && vec_affine_index(m, fi, bi, types.mir_ic(m, fi, ti), p.ind) == 0 {
            mask := pipe_lookup_mask(m, fi, bi, ti, types.mir_ic(m, fi, ti))
            bl := pipe_base_local(m, fi, bi, types.mir_ib(m, fi, ti))
            if mask == 0 || bl < 0 { << 0 }
            if table_loc >= 0 && table_loc != bl { << 0 }
            table_loc = bl
            if mask > table_mask { table_mask = mask }
        }
        ti = types.mir_inext(m, fi, ti)
    }
    if table_loc < 0 {
        // Descriptor projections are admitted for the guarded lookup path.
        // Leave other newly recognized borrowed loops on their scalar path.
        ti = types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ti < 0 { <- }
            if types.mir_ikind(m, fi, ti) == types.mi_load_ptr { << 0 }
            ti = types.mir_inext(m, fi, ti)
        }
    }
    if table_loc >= 0 {
        // The scalar fallback reads frame values. A register-cached block
        // needs a separate preservation plan and stays on its original path.
        if a.rc_on { << 0 }
        // rc_on can also be false for a fixed-home allocation plan. Its
        // live registers must survive both the fast guard and scalar fallback.
        for t in 0:fr.temp_slot.len {
            if is_vreg_slot(fr.temp_slot[t]) || is_fp_vreg_slot(fr.temp_slot[t]) { << 0 }
        }
        for loc in 0:nloc {
            if !is_frame_slot(fr.local_slot[loc]) { << 0 }
        }
        ti = types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ti < 0 { <- }
            if types.mir_ikind(m, fi, ti) == types.mi_store_index && pipe_base_local(m, fi, bi, types.mir_ia(m, fi, ti)) == table_loc { << 0 }
            ti = types.mir_inext(m, fi, ti)
        }
    }
    mut needed := []int{}
    mut live_loc := []int{}
    for _ in 0:nt { needed.push(0) }
    for _ in 0:nloc { live_loc.push(0) }
    mut guard := 0
    mut changed := 1
    while changed == 1 && guard < nt + nt + nloc + 8 {
        changed = 0
        guard = guard + 1
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            k := types.mir_ikind(m, fi, ii)
            if k == types.mi_store_index {
                v := types.mir_ic(m, fi, ii)
                if v >= 0 && v < nt && needed[v] == 0 {
                    needed[v] = 1
                    changed = 1
                }
            } else if k == types.mi_load_index {
                dest := types.mir_ia(m, fi, ii)
                idx := types.mir_ic(m, fi, ii)
                if dest >= 0 && dest < nt && needed[dest] == 1 && pipe_lookup_mask(m, fi, bi, ii, idx) > 0 && idx >= 0 && idx < nt && needed[idx] == 0 {
                    needed[idx] = 1
                    changed = 1
                }
            } else if k == types.mi_copy {
                dest := types.mir_ia(m, fi, ii)
                src := types.mir_ib(m, fi, ii)
                if dest >= 0 && dest < nt && needed[dest] == 1 && src >= 0 && src < nt && needed[src] == 0 {
                    needed[src] = 1
                    changed = 1
                }
            } else if k == types.mi_bin {
                op := types.mir_ib(m, fi, ii)
                dest := types.mir_ia(m, fi, ii)
                if dest >= 0 && dest < nt && needed[dest] == 1 && op >= 1 && op <= 18 && (op < 6 || op > 11) {
                    lc := types.mir_ic(m, fi, ii)
                    ld := types.mir_id(m, fi, ii)
                    if lc >= 0 && lc < nt && needed[lc] == 0 {
                        needed[lc] = 1
                        changed = 1
                    }
                    if ld >= 0 && ld < nt && needed[ld] == 0 {
                        needed[ld] = 1
                        changed = 1
                    }
                }
            } else if k == types.mi_un {
                dest := types.mir_ia(m, fi, ii)
                src := types.mir_ic(m, fi, ii)
                if types.mir_ib(m, fi, ii) == 1 && dest >= 0 && dest < nt && needed[dest] == 1 && src >= 0 && src < nt && needed[src] == 0 {
                    needed[src] = 1
                    changed = 1
                }
            } else if k == types.mi_load_local {
                dest := types.mir_ia(m, fi, ii)
                loc := types.mir_ib(m, fi, ii)
                if dest >= 0 && dest < nt && needed[dest] == 1 && loc >= 0 && loc < nloc && loc != p.ind && loc != lim_loc {
                    if live_loc[loc] == 0 {
                        live_loc[loc] = 1
                        changed = 1
                    }
                }
            } else if k == types.mi_store_local {
                loc := types.mir_ia(m, fi, ii)
                v := types.mir_ib(m, fi, ii)
                // The stored value is a real use. A carried update
                // (`acc = acc | byte`) is otherwise invisible: the load
                // is not needed until the store is, and the store waited
                // for that load.
                if loc >= 0 && loc < nloc && loc != p.ind && v >= 0 && v < nt && needed[v] == 0 {
                    needed[v] = 1
                    changed = 1
                }
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    mut uses := []int{}
    for _ in 0:nt { uses.push(0) }
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == types.mi_store_index {
            v := types.mir_ic(m, fi, ii)
            if v >= 0 && v < nt && needed[v] == 1 { uses[v] = uses[v] + 1 }
        } else if k == types.mi_load_index {
            dest := types.mir_ia(m, fi, ii)
            idx := types.mir_ic(m, fi, ii)
            if dest >= 0 && dest < nt && needed[dest] == 1 && pipe_lookup_mask(m, fi, bi, ii, idx) > 0 && idx >= 0 && idx < nt { uses[idx] = uses[idx] + 1 }
        } else if k == types.mi_store_local {
            v := types.mir_ib(m, fi, ii)
            if v >= 0 && v < nt && needed[v] == 1 { uses[v] = uses[v] + 1 }
        } else if k == types.mi_copy {
            dest := types.mir_ia(m, fi, ii)
            src := types.mir_ib(m, fi, ii)
            if dest >= 0 && dest < nt && needed[dest] == 1 && src >= 0 && src < nt {
                uses[src] = uses[src] + 1
            }
        } else if k == types.mi_bin {
            dest := types.mir_ia(m, fi, ii)
            op := types.mir_ib(m, fi, ii)
            if dest >= 0 && dest < nt && needed[dest] == 1 && (op < 6 || op > 11) {
                lc := types.mir_ic(m, fi, ii)
                ld := types.mir_id(m, fi, ii)
                if lc >= 0 && lc < nt { uses[lc] = uses[lc] + 1 }
                if ld >= 0 && ld < nt { uses[ld] = uses[ld] + 1 }
            }
        } else if k == types.mi_un {
            dest := types.mir_ia(m, fi, ii)
            src := types.mir_ic(m, fi, ii)
            if types.mir_ib(m, fi, ii) == 1 && dest >= 0 && dest < nt && needed[dest] == 1 && src >= 0 && src < nt {
                uses[src] = uses[src] + 1
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    mut reg_of := []int{}
    mut home := []int{}
    mut carried := []int{}
    mut const_ok := []int{}
    mut const_of := []int{}
    mut mem_ok := []int{}
    mut wide_v := []int{}
    mut wide_r := []int{}
    if pipe_allocate_registers(a, m, fi, fr, bi, p, nt, nloc, lim_loc, &needed, mut &uses, mut &reg_of, mut &home, mut &carried, mut &const_ok, mut &const_of, mut &mem_ok, mut &wide_v, mut &wide_r) == 0 {
        << 0
    }
    mut blocs := []int{}
    mut bscale := []int{}
    mut boff := []int{}
    mut bstore := []int{}
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == types.mi_store_index || (k == types.mi_load_index && vec_affine_index(m, fi, bi, types.mir_ic(m, fi, ii), p.ind) > 0) {
            mut base := 0
            mut idx := 0
            mut st := 0
            if k == types.mi_load_index {
                base = types.mir_ib(m, fi, ii)
                idx = types.mir_ic(m, fi, ii)
            } else {
                base = types.mir_ia(m, fi, ii)
                idx = types.mir_ib(m, fi, ii)
                st = 1
            }
            bl := pipe_base_local(m, fi, bi, base)
            aff := vec_affine_index(m, fi, bi, idx, p.ind)
            sc := aff / 4
            off := aff - sc * 4
            mut found_b := -1
            for q in 0:blocs.len {
                if blocs[q] == bl { found_b = q }
            }
            if found_b < 0 {
                if blocs.len >= 2 { << 0 }
                blocs.push(bl)
                bscale.push(sc)
                boff.push(off)
                bstore.push(st)
            } else {
                if bscale[found_b] != sc { << 0 }
                if off > boff[found_b] { boff[found_b] = off }
                if st == 1 { bstore[found_b] = 1 }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if blocs.len < 1 { << 0 }
    for q in 0:blocs.len {
        if bscale[q] < 1 || bscale[q] > 4 { << 0 }
        if bscale[q] > 2 && boff[q] >= bscale[q] { << 0 }
    }
    // Keep emission temporaries out of the analysis/register-allocation frame.
    << emit_byte_pipe_code(a, m, fi, fr, bi, p, nt, nloc, lim_loc, table_loc, table_mask, &needed, &reg_of, &home, &carried, &const_ok, &const_of, &mem_ok, &wide_v, &wide_r, &blocs, &bscale, &boff, &bstore)
}
