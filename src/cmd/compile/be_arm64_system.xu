@main

fn (a $&Assembler) be_syscall(num int) {
    if a.arch == 3 { a.be_unsupported("syscall") }
    if a.arch == 1 {
        a.xbe_syscall(num)
    } else {
        if a.arch == 2 {
            if a.os == 3 {
                e1_thumb_unimp("syscall (freestanding has none)")
            } else {
                // EABI: nr in r7 (also FP). Args r0–r5; Xu A4/A5 live in r10/r11.
                a.t_emit16(0xB4B0) // push {r4, r5, r7}
                a.t_mov_reg(4, 10)
                a.t_mov_reg(5, 11)
                a.t_mov_imm(7, num)
                a.t_svc(0)
                a.t_emit16(0xBCB0) // pop {r4, r5, r7}
            }
        } else if a.arch == 4 {
            a.lbe_syscall(num)
        } else if a.arch == 5 {
            a.vbe_syscall(num)
        } else {
            if a.os == 1 {
                a.mov_imm(8, num)
                a.svc(0)
            } else {
                a.mov_imm(16, num)
                a.svc(128)
            }
        }
    }
}

fn (a $&Assembler) be_call_iat(label string) {
    $tmp := []string{}
    tmp.push(label)
    // Windows x64 needs Win64 ABI shuffle; Windows ARM64 is AAPCS-compatible
    // (same lea/load/blr path as macos/linux arm64).
    if a.os == 2 && a.arch == 1 {
        a.xbe_call_iat(tmp[0])
    } else {
        if a.arch == 1 {
            a.x64_call_iat_raw(tmp[0])
        } else {
            if a.arch == 2 {
                e1_thumb_unimp("call_iat (no OS imports)")
            } else {
                // Scratch is V1 (X9), not V0 (X8): multi-slot returns put sret in X8.
                a.be_lea(1, tmp[0])
                a.be_load(1, 1, 0)
                a.be_call_reg(1)
            }
        }
    }
}


fn (a $&Assembler) be_call_iat7(label string) {
    $tmp := []string{}
    tmp.push(label)
    if a.os == 2 && a.arch == 1 {
        a.xbe_call_iat7(tmp[0])
    } else {
        if a.os == 2 && a.arch == 0 {
            // WinARM64: 7th integer arg is X6; CreateFileA template = NULL.
            a.mov_imm(6, 0)
        }
        a.be_call_iat(tmp[0])
    }
}

// CreateProcessA on WinARM64: A0=cmdline, A1=&si, A2=&pi →
// x0=NULL, x1=cmdline, x2..x7=0, [sp+0]=&si, [sp+8]=&pi.
fn (a $&Assembler) abe_call_iat_createprocess(label string) {
    a.mov(2, 18)
    a.mov(3, 19)
    a.mov(4, 20)
    a.vm_mov_imm(18, 0)
    a.mov(19, 2)
    a.vm_mov_imm(20, 0)
    a.vm_mov_imm(21, 0)
    a.vm_mov_imm(22, 0)
    a.vm_mov_imm(23, 0)
    a.mov_imm(6, 0)
    a.mov_imm(7, 0)
    a.vm_sub_imm(16, 16, 16)
    a.store(16, 0, 3)
    a.store(16, 8, 4)
    a.vm_call_iat(label)
    a.vm_add_imm(16, 16, 16)
}

fn (a $&Assembler) abe_call_iat_createprocess_exec(label string) {
    $tmp := []string{}
    tmp.push(label)
    a.vm_sub_imm(16, 16, 16)
    a.store(16, 0, 21)
    a.store(16, 8, 22)
    a.emit32(2432696320 | (2 << 5) | 7)
    a.mov(22, 23)
    a.vm_mov_imm(20, 0)
    a.vm_mov_imm(21, 0)
    a.vm_mov_imm(23, 0)
    a.mov_imm(6, 0)
    a.be_call_iat(tmp[0])
    a.vm_add_imm(16, 16, 16)
}

// DeviceIoControl 8 integer args: x0..x5 from A0..A5, x6=&DWORD, x7=NULL.
fn (a $&Assembler) abe_call_iat_deviceiocontrol(label string) {
    $tmp := []string{}
    tmp.push(label)
    a.vm_sub_imm(16, 16, 16)
    a.vm_mov_imm(0, 0)
    a.store(16, 0, 0)
    a.emit32(2432696320 | (31 << 5) | 6) // ADD X6, SP, #0
    a.mov_imm(7, 0)
    a.be_call_iat(tmp[0])
    a.vm_add_imm(16, 16, 16)
}

fn (a $&Assembler) be_normalize_syscall(ok_label string) {
    $tmp := []string{}
    tmp.push(ok_label)
    if a.arch == 1 {
        a.xbe_normalize_syscall(tmp[0])
    } else {
        if a.arch == 2 {
        } else {
            if a.os == 0 {
                a.emit32(3665835008)
            }
        }
    }
}


fn (a $&Assembler) be_atomic_xchg(dest int, addr int, val int) {
    if a.arch == 2 { a.t_dmb() }
    if a.arch == 3 { a.be_unsupported("atomic_xchg") }
    a.drop_seq = a.drop_seq + 1
    $labs := []string{}
    labs.push("_xu_xchg_" + str(a.drop_seq))
    if a.arch == 1 {
        d := x64_map_reg(dest)
        ad := x64_map_reg(addr)
        v := x64_map_reg(val)
        if d != v {
            a.x64_mov_reg(d, v)
        }
        a.x64_xchg_mem(d, ad)
    } else {
        if a.arch == 2 {
            ad := td_thumb_phys(addr)
            v := td_thumb_phys(val)
            d := td_thumb_phys(dest)
            a.drop_seq = a.drop_seq + 1
            lab := "_xu_txchg_" + str(a.drop_seq)
            a.label(str_clone(&lab))
            a.t_ldrex(12, ad)
            a.t_strex(11, v, ad)
            a.t_cbnz(11, lab)
            a.t_mov_reg(d, 12)
        } else if a.arch == 4 {
            a.lbe_atomic_xchg(dest, addr, val)
        } else if a.arch == 5 {
            a.vbe_atomic_xchg(dest, addr, val)
        } else {
            d := map_reg(dest)
            ad := map_reg(addr)
            v := map_reg(val)
            a.label(labs[0])
            a.ldaxr(d, ad)
            a.stlxr(16, v, ad)
            a.cbnz(16, labs[0])
        }
    }
    if a.arch == 2 { a.t_dmb() }
}

// M35: sequential-consistency atomic load. arm64: ldar; x64: plain aligned
// 64-bit mov is naturally atomic.
fn (a $&Assembler) be_atomic_load(dest int, addr int) {
    if a.arch == 2 { a.t_dmb() }
    if a.arch == 3 { a.be_unsupported("atomic_load") }
    if a.arch == 1 {
        a.xbe_load(dest, addr, 0)
    } else {
        if a.arch == 2 {
            a.t_load_offset(td_thumb_phys(dest), td_thumb_phys(addr), 0)
        } else if a.arch == 4 {
            a.lbe_atomic_load(dest, addr)
        } else if a.arch == 5 {
            a.vbe_atomic_load(dest, addr)
        } else {
            a.ldar(map_reg(dest), map_reg(addr))
        }
    }
    if a.arch == 2 { a.t_dmb() }
}

// M35: sequential-consistency atomic store. arm64: stlr; x64: xchg (implicit
// lock). old value is discarded.
fn (a $&Assembler) be_atomic_store(addr int, val int) {
    if a.arch == 2 { a.t_dmb() }
    if a.arch == 3 { a.be_unsupported("atomic_store") }
    if a.arch == 1 {
        v := x64_map_reg(val)
        ad := x64_map_reg(addr)
        a.x64_xchg_mem(v, ad)
    } else {
        if a.arch == 2 {
            a.t_store_offset(td_thumb_phys(val), td_thumb_phys(addr), 0)
        } else if a.arch == 4 {
            a.lbe_atomic_store(addr, val)
        } else if a.arch == 5 {
            a.vbe_atomic_store(addr, val)
        } else {
            a.stlr(map_reg(val), map_reg(addr))
        }
    }
    if a.arch == 2 { a.t_dmb() }
}

// M35: atomic add; returns the old value. arm64: ldaxr/stlxr retry loop;
// x64: lock xadd.
fn (a $&Assembler) be_atomic_add(dest int, addr int, val int) {
    if a.arch == 2 { a.t_dmb() }
    if a.arch == 3 { a.be_unsupported("atomic_add") }
    a.drop_seq = a.drop_seq + 1
    $labs := []string{}
    labs.push("_xu_aadd_" + str(a.drop_seq))
    if a.arch == 1 {
        d := x64_map_reg(dest)
        ad := x64_map_reg(addr)
        v := x64_map_reg(val)
        if d != v {
            a.x64_mov_reg(d, v)
        }
        a.x64_xadd_mem(d, ad)
    } else {
        if a.arch == 2 {
            ad := td_thumb_phys(addr)
            v := td_thumb_phys(val)
            d := td_thumb_phys(dest)
            a.drop_seq = a.drop_seq + 1
            lab := "_xu_tadd_" + str(a.drop_seq)
            a.label(str_clone(&lab))
            a.t_ldrex(12, ad)
            a.t_add_reg(10, 12, v)
            a.t_strex(11, 10, ad)
            a.t_cbnz(11, lab)
            a.t_mov_reg(d, 12)
        } else if a.arch == 4 {
            a.lbe_atomic_add(dest, addr, val)
        } else if a.arch == 5 {
            a.vbe_atomic_add(dest, addr, val)
        } else {
            d := map_reg(dest)
            ad := map_reg(addr)
            v := map_reg(val)
            a.label(labs[0])
            a.ldaxr(d, ad)
            a.add_reg(17, d, v) // X17 scratch = old + val
            a.stlxr(16, 17, ad)
            a.cbnz(16, labs[0])
        }
    }
    if a.arch == 2 { a.t_dmb() }
}

// M35: compare-and-swap; returns bool success. arm64: ldaxr/stlxr loop with
// compare; x64: lock cmpxchg.
fn (a $&Assembler) be_atomic_cas(dest int, addr int, old int, new int) {
    if a.arch == 2 { a.t_dmb() }
    if a.arch == 3 { a.be_unsupported("atomic_cas") }
    a.drop_seq = a.drop_seq + 1
    $labs := []string{}
    labs.push("_xu_acas_" + str(a.drop_seq))
    labs.push("_xu_acas_f_" + str(a.drop_seq))
    labs.push("_xu_acas_d_" + str(a.drop_seq))
    if a.arch == 1 {
        db := x64_map_reg(dest)
        ad := x64_map_reg(addr)
        o := x64_map_reg(old)
        n := x64_map_reg(new)
        if o != 0 {
            a.x64_mov_reg(0, o) // RAX = old
        }
        a.x64_cmpxchg_mem(n, ad)
        a.x64_setcc(db, 4) // ZF → dest = 1 (equal) / 0
    } else {
        if a.arch == 2 {
            // Thumb-2 ARMv7E-M: LDREX/STREX with a retry loop. Keep the
            // status/current registers outside the operand set where
            // possible; all values are 32-bit on this backend.
            ad := td_thumb_phys(addr)
            o := td_thumb_phys(old)
            n := td_thumb_phys(new)
            db := td_thumb_phys(dest)
            $cur := 12
            if cur == ad || cur == o || cur == n { cur = 3 }
            if cur == ad || cur == o || cur == n { cur = 10 }
            $status := 11
            if status == ad || status == o || status == n || status == cur { status = 12 }
            a.drop_seq = a.drop_seq + 1
            $labs := []string{}
            labs.push("_xu_tcas_" + str(a.drop_seq))
            labs.push("_xu_tcas_fail_" + str(a.drop_seq))
            labs.push("_xu_tcas_done_" + str(a.drop_seq))
            a.label(labs[0])
            a.t_ldrex(cur, ad)
            a.t_cmp_reg(cur, o)
            a.t_bne(labs[1])
            a.t_strex(status, n, ad)
            a.t_cbnz(status, labs[0])
            a.t_mov_imm(db, 1)
            a.t_b(labs[2])
            a.label(labs[1])
            a.t_mov_imm(db, 0)
            a.label(labs[2])
        } else if a.arch == 4 {
            a.lbe_atomic_cas(dest, addr, old, new)
        } else if a.arch == 5 {
            a.vbe_atomic_cas(dest, addr, old, new)
        } else {
            db := map_reg(dest)
            ad := map_reg(addr)
            o := map_reg(old)
            n := map_reg(new)
            a.label(labs[0])
            a.ldaxr(17, ad) // X17 = current
            a.cmp_reg(17, o)
            a.bne(labs[1])
            a.stlxr(16, n, ad)
            a.cbnz(16, labs[0])
            a.mov_imm(db, 1)
            a.b(labs[2])
            a.label(labs[1])
            a.mov_imm(db, 0)
            a.label(labs[2])
        }
    }
    if a.arch == 2 { a.t_dmb() }
}


fn (a $&Assembler) be_exit() {
    if a.os == 3 {
        a.be_jmp("_rt_exit")
    } else {
        if a.os == 2 {
            a.be_call_iat("_iat_ExitProcess")
        } else {
            a.be_syscall(syscall_number(a.os, a.arch, 0))
        }
    }
}
