@main

// Optional instructions are selected from runtime capabilities, independently
// of the OS/architecture target. No AVX bit is used here: a future AVX path
// must also check OSXSAVE/XCR0 before touching YMM/ZMM state.
fn rt_emit_x64_cpu_leaf1(a &mut Assembler) {
    a.align_data(8)
    a.data_label("_rt_cpu_x64_leaf1_cache")
    // -1 means uninitialized. CPUID ECX is zero-extended, so cannot be -1.
    for _ in 0:8 { a.data.push(255) }
    a.label("_rt_cpu_x64_leaf1_ecx")
    a.x64_lea_rip_rel(0, "_rt_cpu_x64_leaf1_cache")
    a.x64_load_offset(0, 0, 0)
    a.x64_cmp_imm(0, -1)
    a.x64_jcc(5, "_rt_cpu_x64_leaf1_done")
    // This private query preserves every register except its RAX result.
    // In particular RBX is a fixed home and RCX/RDX can hold helper inputs.
    a.x64_push(3)
    a.x64_push(1)
    a.x64_push(2)
    a.x64_mov_imm32(0, 1)
    a.x64_cpuid()
    a.x64_mov_reg(0, 1)
    a.x64_lea_rip_rel(1, "_rt_cpu_x64_leaf1_cache")
    // Aligned scalar publication; concurrent first queries publish the same
    // process CPU capabilities, without a lock or partially-written mask.
    a.x64_store_offset(1, 0, 0)
    a.x64_pop(2)
    a.x64_pop(1)
    a.x64_pop(3)
    a.label("_rt_cpu_x64_leaf1_done")
    a.x64_ret()
}

fn rt_emit_x64_feature_check(a &mut Assembler, name string, bit int) {
    a.label(name)
    a.x64_call("_rt_cpu_x64_leaf1_ecx")
    a.x64_shr_imm(0, bit)
    a.x64_and_imm(0, 1)
    a.x64_ret()
}

fn rt_emit_arm64_feature_check(a &mut Assembler, name string, bit int, win_feature int) {
    a.label(name)
    if a.os == 0 {
        // Apple's macOS arm64 baseline includes AES, SHA1/SHA2 and CRC32.
        a.vm_mov_imm(14, 1)
        a.ret()
    } else if a.os == 1 {
        // Linux AT_HWCAP, populated before main. A library without our
        // executable entry keeps the zero default and uses software safely.
        a.lea(0, "_rt_cpu_arm64_hwcap")
        a.load(14, 0, 0)
        a.shr_imm(14, 14, bit)
        a.vm_and_imm(14, 14, 1)
        a.ret()
    } else if a.os == 2 {
        // PF_ARM_V8_CRYPTO_INSTRUCTIONS_AVAILABLE=30, CRC32=31.
        a.prologue(32)
        a.vm_mov_imm(18, win_feature)
        a.vm_call_iat("_iat_IsProcessorFeaturePresent")
        a.vm_cmp_imm(14, 0)
        a.vm_cset(14, 1)
        a.epilogue()
    } else {
        a.vm_mov_imm(14, 0)
        a.ret()
    }
}

fn rt_emit_x64_popcount(a &mut Assembler) {
    // A real scalar ABI helper, rather than an ABI-free intrinsic: its
    // capability query and software path may clobber RAX/RCX/RDX.
    a.label("_rt_math_bits_ones_count")
    a.x64_call("_rt_cpu_x64_leaf1_ecx")
    a.x64_and_imm(0, 1 << 23) // CPUID.1:ECX.POPCNT
    a.x64_jcc(4, "_rt_bits_popcount_swar")
    a.x64_popcnt(0, 7)
    a.x64_ret()
    a.label("_rt_bits_popcount_swar")
    a.x64_mov_reg(0, 7)
    a.x64_mov_reg(2, 0)
    a.x64_shr_imm(2, 1)
    a.x64_mov_imm64(1, 0x5555555555555555)
    a.x64_and_reg(2, 1)
    a.x64_sub_reg(0, 2)
    a.x64_mov_reg(2, 0)
    a.x64_shr_imm(2, 2)
    a.x64_mov_imm64(1, 0x3333333333333333)
    a.x64_and_reg(0, 1)
    a.x64_and_reg(2, 1)
    a.x64_add_reg(0, 2)
    a.x64_mov_reg(2, 0)
    a.x64_shr_imm(2, 4)
    a.x64_add_reg(0, 2)
    a.x64_mov_imm64(1, 0x0f0f0f0f0f0f0f0f)
    a.x64_and_reg(0, 1)
    a.x64_mov_imm64(1, 0x0101010101010101)
    a.x64_imul(0, 1)
    a.x64_shr_imm(0, 56)
    a.x64_ret()
}
