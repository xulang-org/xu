@main

#xu/types

fn rt_emit_zeros(a $&Assembler, n int) {
    for i in 0:n {
        a.emit_data([0])
    }
    <<
}

// Darwin PTHREAD_MUTEX_INITIALIZER = {_PTHREAD_MUTEX_SIG_init(0x32AAABA7), {0}}:
// 64-byte mutex data pre-seeded with the magic sig (zeroed mutex would fail
// every lock with EINVAL). Used for the global heap lock on macOS.
fn rt_emit_magic_mu(a $&Assembler) {
    a.emit_data([0xa7, 0xab, 0xaa, 0x32, 0, 0, 0, 0])
    rt_emit_zeros(a, 56)
    <<
}

fn rt_emit_bytes(a $&Assembler, s string) {
    for i in 0:s.len {
        a.emit_data([s[i]])
    }
    <<
}

// Emit 8 little-endian bytes of an int bit pattern (for f64 constants).
fn rt_emit_u64(a $&Assembler, v int) {
    for i in 0:8 {
        b := (v >> (i * 8)) & 255
        a.emit_data([b])
    }
    <<
}

// ==================== M17b channel + cooperative xu ====================
// Header words: lock, elem_slots, cap, len, head, tail, buf_ptr, closed,
// wait_head@64 wait_tail@72. HDR = 80 bytes.
// Waiter nodes: next@0 kind@8 done@16 buf@24 data@32;
// kind 1=SEND 2=RECV 3=SEND_DETACHED (coop pumping send); done 0/1/2.
// Reclaimed by the parked owner after done != 0, or by the matching peer
// when kind is SEND_DETACHED.
// VRegs: 0-7 V, 8-13 S, 14 Ret, 15 Fp, 18-23 A0-A5. Frame via Fp=15.
