@main
// Thumb-2 assembler (Cortex-m4 / ARMv7E-M). Port of bootstrap xuasm/thumb.rs.
// T16 + T32. 64-bit MIR slots; ALU uses the low 32 bits.
//
// Fixup kinds when arch == 2:
//   0 = B.W
//   1 = BL
//   2 = MOVW+MOVT absolute address

fn (a &mut Assembler) t_emit16(hw int) {
    a.code.push(hw & 255)
    a.code.push((hw >> 8) & 255)
}

fn (a &mut Assembler) t_emit32(hw1 int, hw2 int) {
    a.t_emit16(hw1)
    a.t_emit16(hw2)
}

fn (a &mut Assembler) t_patch16(offset int, hw int) {
    a.code[offset] = hw & 255
    a.code[offset + 1] = (hw >> 8) & 255
}

fn (a &mut Assembler) t_push_fixup(kind int, label string, rd int) {
    off := a.code.len
    fs := mut &a.fixups
    fs.push(Fixup{kind: kind, offset: off, label: label, rd: rd})
}

fn t_scratch_not(x int, y int) int {
    if 1 != x && 1 != y { << 1 }
    if 2 != x && 2 != y { << 2 }
    if 3 != x && 3 != y { << 3 }
    << 6
}

fn (a &mut Assembler) t_push_r7_lr() { a.t_emit16(0xB580) }
fn (a &mut Assembler) t_pop_r7_pc() { a.t_emit16(0xBD80) }
fn (a &mut Assembler) t_pop_r7_lr() { a.t_emit32(0xE8BD, 0x4080) }
fn (a &mut Assembler) t_push_r4_r5_r6_r8() { a.t_emit32(0xE92D, 0x0170) }
fn (a &mut Assembler) t_pop_r4_r5_r6_r8() { a.t_emit32(0xE8BD, 0x0170) }
fn (a &mut Assembler) t_wfi() { a.t_emit16(0xBF30) }
fn (a &mut Assembler) t_cpsid_i() { a.t_emit16(0xB672) }
fn (a &mut Assembler) t_cpsie_i() { a.t_emit16(0xB662) }
fn (a &mut Assembler) t_nop() { a.t_emit16(0xBF00) }
fn (a &mut Assembler) t_bx_lr() { a.t_emit16(0x4770) }
fn (a &mut Assembler) t_svc(imm int) { a.t_emit16(0xDF00 | (imm & 255)) }

fn (a &mut Assembler) t_mrs_ipsr(rd int) {
    a.t_emit32(0xF3EF, 0x8000 | (rd << 8) | 5)
}

fn (a &mut Assembler) t_addw(rd int, rn int, imm12 int) {
    i := (imm12 >> 11) & 1
    imm3 := (imm12 >> 8) & 7
    imm8 := imm12 & 255
    a.t_emit32(0xF200 | (i << 10) | rn, (imm3 << 12) | (rd << 8) | imm8)
}

fn (a &mut Assembler) t_subw(rd int, rn int, imm12 int) {
    i := (imm12 >> 11) & 1
    imm3 := (imm12 >> 8) & 7
    imm8 := imm12 & 255
    a.t_emit32(0xF2A0 | (i << 10) | rn, (imm3 << 12) | (rd << 8) | imm8)
}

fn (a &mut Assembler) t_sub_sp(imm int) {
    if imm == 0 { << }
    if imm <= 508 && imm % 4 == 0 {
        a.t_emit16(0xB080 | (imm / 4))
        <<
    }
    if imm <= 4095 {
        a.t_subw(13, 13, imm)
        <<
    }
    eprintln("E1: frame larger than 4095")
    <<< 1
}

fn (a &mut Assembler) t_add_sp(imm int) {
    if imm == 0 { << }
    if imm <= 508 && imm % 4 == 0 {
        a.t_emit16(0xB000 | (imm / 4))
        <<
    }
    if imm <= 4095 {
        a.t_addw(13, 13, imm)
        <<
    }
    eprintln("E1: add_sp larger than 4095")
    <<< 1
}

fn (a &mut Assembler) t_mov_reg(rd int, rm int) {
    hw := 0x4600 | ((rm & 15) << 3) | (rd & 7) | ((rd & 8) << 4)
    a.t_emit16(hw)
}

fn (a &mut Assembler) t_movw(rd int, imm16 int) {
    i := (imm16 >> 11) & 1
    imm4 := (imm16 >> 12) & 15
    imm3 := (imm16 >> 8) & 7
    imm8 := imm16 & 255
    a.t_emit32(0xF240 | (i << 10) | imm4, (imm3 << 12) | (rd << 8) | imm8)
}

fn (a &mut Assembler) t_movt(rd int, imm16 int) {
    i := (imm16 >> 11) & 1
    imm4 := (imm16 >> 12) & 15
    imm3 := (imm16 >> 8) & 7
    imm8 := imm16 & 255
    a.t_emit32(0xF2C0 | (i << 10) | imm4, (imm3 << 12) | (rd << 8) | imm8)
}

fn (a &mut Assembler) t_mov_imm32(rd int, imm int) {
    u := imm & 4294967295
    if rd <= 7 && u <= 255 {
        a.t_emit16(0x2000 | (rd << 8) | u)
        <<
    }
    a.t_movw(rd, u & 65535)
    hi := (u >> 16) & 65535
    if hi != 0 {
        a.t_movt(rd, hi)
    }
}

fn (a &mut Assembler) t_mov_imm(rd int, imm int) { a.t_mov_imm32(rd, imm) }
fn (a &mut Assembler) t_mov_imm64(rd int, imm int) { a.t_mov_imm32(rd, imm) }

fn (a &mut Assembler) t_str_imm12(rt int, rn int, imm12 int) {
    a.t_emit32(0xF8C0 | rn, (rt << 12) | (imm12 & 4095))
}
fn (a &mut Assembler) t_ldr_imm12(rt int, rn int, imm12 int) {
    a.t_emit32(0xF8D0 | rn, (rt << 12) | (imm12 & 4095))
}
fn (a &mut Assembler) t_str_neg(rt int, rn int, imm8 int) {
    a.t_emit32(0xF840 | rn, (rt << 12) | 0x0C00 | (imm8 & 255))
}
fn (a &mut Assembler) t_ldr_neg(rt int, rn int, imm8 int) {
    a.t_emit32(0xF850 | rn, (rt << 12) | 0x0C00 | (imm8 & 255))
}
fn (a &mut Assembler) t_strb_imm12(rt int, rn int, imm12 int) {
    a.t_emit32(0xF880 | rn, (rt << 12) | (imm12 & 4095))
}
fn (a &mut Assembler) t_ldrb_imm12(rt int, rn int, imm12 int) {
    a.t_emit32(0xF890 | rn, (rt << 12) | (imm12 & 4095))
}
fn (a &mut Assembler) t_strb_neg(rt int, rn int, imm8 int) {
    a.t_emit32(0xF800 | rn, (rt << 12) | 0x0C00 | (imm8 & 255))
}
fn (a &mut Assembler) t_ldrb_neg(rt int, rn int, imm8 int) {
    a.t_emit32(0xF810 | rn, (rt << 12) | 0x0C00 | (imm8 & 255))
}

fn (a &mut Assembler) t_add_imm(rd int, rn int, imm int) {
    if imm < 0 {
        a.t_sub_imm(rd, rn, 0 - imm)
        <<
    }
    if imm <= 4095 {
        a.t_addw(rd, rn, imm)
        <<
    }
    scratch := t_scratch_not(rd, rn)
    a.t_mov_imm32(scratch, imm)
    a.t_add_reg(rd, rn, scratch)
}

fn (a &mut Assembler) t_sub_imm(rd int, rn int, imm int) {
    if imm < 0 {
        a.t_add_imm(rd, rn, 0 - imm)
        <<
    }
    if imm <= 4095 {
        a.t_subw(rd, rn, imm)
        <<
    }
    scratch := t_scratch_not(rd, rn)
    a.t_mov_imm32(scratch, imm)
    a.t_sub_reg(rd, rn, scratch)
}

fn (a &mut Assembler) t_store_offset(rt int, rn int, offset int) {
    if offset >= 0 && offset <= 4095 {
        a.t_str_imm12(rt, rn, offset)
        <<
    }
    if offset >= 0 - 255 && offset < 0 {
        a.t_str_neg(rt, rn, 0 - offset)
        <<
    }
    s := t_scratch_not(rt, rn)
    a.t_mov_reg(s, rn)
    if offset >= 0 {
        a.t_add_imm(s, s, offset)
    } else {
        a.t_sub_imm(s, s, 0 - offset)
    }
    a.t_str_imm12(rt, s, 0)
}

fn (a &mut Assembler) t_load_offset(rt int, rn int, offset int) {
    if offset >= 0 && offset <= 4095 {
        a.t_ldr_imm12(rt, rn, offset)
        <<
    }
    if offset >= 0 - 255 && offset < 0 {
        a.t_ldr_neg(rt, rn, 0 - offset)
        <<
    }
    s := t_scratch_not(rt, rn)
    a.t_mov_reg(s, rn)
    if offset >= 0 {
        a.t_add_imm(s, s, offset)
    } else {
        a.t_sub_imm(s, s, 0 - offset)
    }
    a.t_ldr_imm12(rt, s, 0)
}

fn (a &mut Assembler) t_store_byte_offset(rt int, rn int, offset int) {
    if offset >= 0 && offset <= 4095 {
        a.t_strb_imm12(rt, rn, offset)
        <<
    }
    if offset >= 0 - 255 && offset < 0 {
        a.t_strb_neg(rt, rn, 0 - offset)
        <<
    }
    s := t_scratch_not(rt, rn)
    a.t_mov_reg(s, rn)
    if offset >= 0 {
        a.t_add_imm(s, s, offset)
    } else {
        a.t_sub_imm(s, s, 0 - offset)
    }
    a.t_strb_imm12(rt, s, 0)
}

fn (a &mut Assembler) t_load_byte_offset(rt int, rn int, offset int) {
    if offset >= 0 && offset <= 4095 {
        a.t_ldrb_imm12(rt, rn, offset)
        <<
    }
    if offset >= 0 - 255 && offset < 0 {
        a.t_ldrb_neg(rt, rn, 0 - offset)
        <<
    }
    s := t_scratch_not(rt, rn)
    a.t_mov_reg(s, rn)
    if offset >= 0 {
        a.t_add_imm(s, s, offset)
    } else {
        a.t_sub_imm(s, s, 0 - offset)
    }
    a.t_ldrb_imm12(rt, s, 0)
}

fn (a &mut Assembler) t_add_reg(rd int, rn int, rm int) {
    a.t_emit32(0xEB00 | rn, (rd << 8) | rm)
}
fn (a &mut Assembler) t_sub_reg(rd int, rn int, rm int) {
    a.t_emit32(0xEBA0 | rn, (rd << 8) | rm)
}
fn (a &mut Assembler) t_mul(rd int, rn int, rm int) {
    a.t_emit32(0xFB00 | rn, 0xF000 | (rd << 8) | rm)
}
fn (a &mut Assembler) t_sdiv(rd int, rn int, rm int) {
    a.t_emit32(0xFB90 | rn, 0xF0F0 | (rd << 8) | rm)
}
fn (a &mut Assembler) t_mls(rd int, rn int, rm int, ra int) {
    a.t_emit32(0xFB00 | rn, (ra << 12) | (rd << 8) | 0x0010 | rm)
}
fn (a &mut Assembler) t_neg_reg(rd int, rn int) {
    a.t_emit32(0xF1C0 | rn, rd << 8)
}
fn (a &mut Assembler) t_and_reg(rd int, rn int, rm int) {
    a.t_emit32(0xEA00 | rn, (rd << 8) | rm)
}
fn (a &mut Assembler) t_orr_reg(rd int, rn int, rm int) {
    a.t_emit32(0xEA40 | rn, (rd << 8) | rm)
}
fn (a &mut Assembler) t_eor_reg(rd int, rn int, rm int) {
    a.t_emit32(0xEA80 | rn, (rd << 8) | rm)
}
fn (a &mut Assembler) t_lsl_reg(rd int, rn int, rm int) {
    a.t_emit32(0xFA00 | rn, 0xF000 | (rd << 8) | rm)
}
fn (a &mut Assembler) t_lsr_reg(rd int, rn int, rm int) {
    a.t_emit32(0xFA20 | rn, 0xF000 | (rd << 8) | rm)
}
fn (a &mut Assembler) t_asr_reg(rd int, rn int, rm int) {
    a.t_emit32(0xFA40 | rn, 0xF000 | (rd << 8) | rm)
}

fn (a &mut Assembler) t_lsl_imm(rd int, rm int, shift int) {
    sh := shift & 31
    imm3 := (sh >> 2) & 7
    imm2 := sh & 3
    a.t_emit32(0xEA4F, (imm3 << 12) | (rd << 8) | (imm2 << 6) | rm)
}

fn (a &mut Assembler) t_lsr_imm(rd int, rm int, shift int) {
    sh := shift & 31
    if sh == 0 {
        a.t_mov_reg(rd, rm)
        <<
    }
    imm3 := (sh >> 2) & 7
    imm2 := sh & 3
    a.t_emit32(0xEA4F, (imm3 << 12) | (rd << 8) | (imm2 << 6) | (1 << 4) | rm)
}

fn (a &mut Assembler) t_cmp_reg(rn int, rm int) {
    a.t_emit32(0xEBB0 | rn, 0x0F00 | rm)
}

fn (a &mut Assembler) t_cmp_imm(rn int, imm int) {
    if imm == 0 {
        a.t_emit32(0xF1B0 | rn, 0x0F00)
        <<
    }
    if imm >= 0 && imm <= 255 {
        a.t_emit32(0xF1B0 | rn, 0x0F00 | (imm & 255))
        <<
    }
    s := t_scratch_not(rn, 15)
    a.t_mov_imm(s, imm)
    a.t_cmp_reg(rn, s)
}

fn (a &mut Assembler) t_lea_abs(rd int, label string) {
    a.t_push_fixup(2, label, rd)
    a.t_movw(rd, 0)
    a.t_movt(rd, 0)
}

fn (a &mut Assembler) t_b(label string) {
    a.t_push_fixup(0, label, 0)
    a.t_emit32(0xF000, 0xB800)
}

fn (a &mut Assembler) t_bl(label string) {
    a.t_push_fixup(1, label, 0)
    a.t_emit32(0xF000, 0xF800)
}

fn (a &mut Assembler) t_blx(rm int) {
    a.t_emit16(0x4780 | (rm << 3))
}

fn (a &mut Assembler) t_bcond(cond int, label string) {
    inv := cond ^ 1
    a.t_emit16(0xD000 | (inv << 8) | 1)
    a.t_b(label)
}

fn (a &mut Assembler) t_beq(label string) { a.t_bcond(0, label) }
fn (a &mut Assembler) t_bne(label string) { a.t_bcond(1, label) }
fn (a &mut Assembler) t_bhs(label string) { a.t_bcond(2, label) }
fn (a &mut Assembler) t_blt(label string) { a.t_bcond(11, label) }
fn (a &mut Assembler) t_bge(label string) { a.t_bcond(10, label) }
fn (a &mut Assembler) t_bgt(label string) { a.t_bcond(12, label) }
fn (a &mut Assembler) t_ble(label string) { a.t_bcond(13, label) }

fn t_thm_hw1(offset int) int {
    s := (offset >> 24) & 1
    imm10 := (offset >> 12) & 1023
    << 0xF000 | (s << 10) | imm10
}

fn t_thm_hw2(offset int, link int) int {
    s := (offset >> 24) & 1
    i1 := (offset >> 23) & 1
    i2 := (offset >> 22) & 1
    imm11 := (offset >> 1) & 2047
    j1 := (i1 ^ s ^ 1) & 1
    j2 := (i2 ^ s ^ 1) & 1
    mut op := 0x9000
    if link == 1 {
        op = 0xD000
    }
    << op | (j1 << 13) | (j2 << 11) | imm11
}

fn (a &mut Assembler) t_fixup_all() {
    for i in 0:a.fixups.len {
        kind := a.fixups[i].kind
        offset := a.fixups[i].offset
        rd := a.fixups[i].rd
        target_addr := a.label_addr(a.fixups[i].label)
        if kind == 0 || kind == 1 {
            current_addr := a.code_vaddr + offset
            disp := target_addr - current_addr - 4
            if disp % 2 != 0 {
                eprintln("ERROR: Thumb branch offset must be even")
                <<< 1
            }
            mut link := 0
            if kind == 1 {
                link = 1
            }
            a.t_patch16(offset, t_thm_hw1(disp))
            a.t_patch16(offset + 2, t_thm_hw2(disp, link))
        } else {
            mut addr := target_addr
            if !a.label_is_data(a.fixups[i].label) {
                addr = addr | 1
            }
            u := addr & 4294967295
            lo := u & 65535
            hi := (u >> 16) & 65535
            i0 := (lo >> 11) & 1
            imm4_0 := (lo >> 12) & 15
            imm3_0 := (lo >> 8) & 7
            imm8_0 := lo & 255
            a.t_patch16(offset, 0xF240 | (i0 << 10) | imm4_0)
            a.t_patch16(offset + 2, (imm3_0 << 12) | (rd << 8) | imm8_0)
            i1 := (hi >> 11) & 1
            imm4_1 := (hi >> 12) & 15
            imm3_1 := (hi >> 8) & 7
            imm8_1 := hi & 255
            a.t_patch16(offset + 4, 0xF2C0 | (i1 << 10) | imm4_1)
            a.t_patch16(offset + 6, (imm3_1 << 12) | (rd << 8) | imm8_1)
        }
    }
}
