@main
// Thumb-2 assembler (Cortex-m4 / ARMv7E-M). Port of bootstrap xuasm/thumb.rs.
// T16 + T32. 64-bit MIR slots; ALU uses the low 32 bits.
//
// Fixup kinds when arch == 2:
//   0 = B.W
//   1 = BL
//   2 = MOVW+MOVT absolute address

fn (a $&Assembler) t_emit16(hw int) {
    a.code.push(hw & 255)
    a.code.push((hw >> 8) & 255)
}

fn (a $&Assembler) t_emit32(hw1 int, hw2 int) {
    a.t_emit16(hw1)
    a.t_emit16(hw2)
}

fn (a $&Assembler) t_patch16(offset int, hw int) {
    a.code[offset] = hw & 255
    a.code[offset + 1] = (hw >> 8) & 255
}

fn (a $&Assembler) t_push_fixup(kind int, label string, rd int) {
    off := a.code.len
    fs := $&a.fixups
    fs.push(Fixup{kind: kind, offset: off, label: label, rd: rd})
}

fn t_scratch_not(x int, y int) int {
    if 14 != x && 14 != y { << 14 }
    if 12 != x && 12 != y { << 12 }
    if 3 != x && 3 != y { << 3 }
    if 2 != x && 2 != y { << 2 }
    if 1 != x && 1 != y { << 1 }
    << 0
}

fn t_scratch_not3(x int, y int, z int) int {
    if 14 != x && 14 != y && 14 != z { << 14 }
    if 12 != x && 12 != y && 12 != z { << 12 }
    if 3 != x && 3 != y && 3 != z { << 3 }
    if 2 != x && 2 != y && 2 != z { << 2 }
    if 1 != x && 1 != y && 1 != z { << 1 }
    << 0
}

fn t_check_lo(r int, op string) {
    if r < 0 || r > 7 {
        eprintln("ERROR: Thumb-16 " + op + " requires low register r0..r7, got r" + str(r))
        <<< 1
    }
}

fn t_check_imm(cond bool, op string) {
    if !cond {
        eprintln("ERROR: Thumb-16 " + op + " immediate/offset out of range")
        <<< 1
    }
}

fn (a $&Assembler) t16_mov_imm8(rd int, imm8 int) {
    t_check_lo(rd, "mov_imm8")
    t_check_imm(imm8 >= 0 && imm8 <= 255, "mov_imm8")
    a.t_emit16(0x2000 | (rd << 8) | imm8)
}

fn (a $&Assembler) t16_add_imm3(rd int, rn int, imm3 int) {
    t_check_lo(rd, "add_imm3")
    t_check_lo(rn, "add_imm3")
    t_check_imm(imm3 >= 0 && imm3 <= 7, "add_imm3")
    a.t_emit16(0x1C00 | (imm3 << 6) | (rn << 3) | rd)
}

fn (a $&Assembler) t16_sub_imm3(rd int, rn int, imm3 int) {
    t_check_lo(rd, "sub_imm3")
    t_check_lo(rn, "sub_imm3")
    t_check_imm(imm3 >= 0 && imm3 <= 7, "sub_imm3")
    a.t_emit16(0x1E00 | (imm3 << 6) | (rn << 3) | rd)
}

fn (a $&Assembler) t16_add_imm8(rdn int, imm8 int) {
    t_check_lo(rdn, "add_imm8")
    t_check_imm(imm8 >= 0 && imm8 <= 255, "add_imm8")
    a.t_emit16(0x3000 | (rdn << 8) | imm8)
}

fn (a $&Assembler) t16_sub_imm8(rdn int, imm8 int) {
    t_check_lo(rdn, "sub_imm8")
    t_check_imm(imm8 >= 0 && imm8 <= 255, "sub_imm8")
    a.t_emit16(0x3800 | (rdn << 8) | imm8)
}

fn (a $&Assembler) t16_add_reg(rd int, rn int, rm int) {
    t_check_lo(rd, "add_reg")
    t_check_lo(rn, "add_reg")
    t_check_lo(rm, "add_reg")
    a.t_emit16(0x1800 | (rm << 6) | (rn << 3) | rd)
}

fn (a $&Assembler) t16_sub_reg(rd int, rn int, rm int) {
    t_check_lo(rd, "sub_reg")
    t_check_lo(rn, "sub_reg")
    t_check_lo(rm, "sub_reg")
    a.t_emit16(0x1A00 | (rm << 6) | (rn << 3) | rd)
}

fn (a $&Assembler) t16_cmp_reg(rn int, rm int) {
    t_check_lo(rn, "cmp_reg")
    t_check_lo(rm, "cmp_reg")
    a.t_emit16(0x4280 | (rm << 3) | rn)
}

fn (a $&Assembler) t16_cmp_imm8(rn int, imm8 int) {
    t_check_lo(rn, "cmp_imm8")
    t_check_imm(imm8 >= 0 && imm8 <= 255, "cmp_imm8")
    a.t_emit16(0x2800 | (rn << 8) | imm8)
}

fn (a $&Assembler) t16_ldr_imm5(rt int, rn int, byte_off int) {
    t_check_lo(rt, "ldr_imm5")
    t_check_lo(rn, "ldr_imm5")
    t_check_imm(byte_off >= 0 && byte_off <= 124 && byte_off % 4 == 0, "ldr_imm5")
    a.t_emit16(0x6800 | ((byte_off / 4) << 6) | (rn << 3) | rt)
}

fn (a $&Assembler) t16_str_imm5(rt int, rn int, byte_off int) {
    t_check_lo(rt, "str_imm5")
    t_check_lo(rn, "str_imm5")
    t_check_imm(byte_off >= 0 && byte_off <= 124 && byte_off % 4 == 0, "str_imm5")
    a.t_emit16(0x6000 | ((byte_off / 4) << 6) | (rn << 3) | rt)
}

fn (a $&Assembler) t16_ldr_sp(rt int, byte_off int) {
    t_check_lo(rt, "ldr_sp")
    t_check_imm(byte_off >= 0 && byte_off <= 1020 && byte_off % 4 == 0, "ldr_sp")
    a.t_emit16(0x9800 | (rt << 8) | (byte_off / 4))
}

fn (a $&Assembler) t16_str_sp(rt int, byte_off int) {
    t_check_lo(rt, "str_sp")
    t_check_imm(byte_off >= 0 && byte_off <= 1020 && byte_off % 4 == 0, "str_sp")
    a.t_emit16(0x9000 | (rt << 8) | (byte_off / 4))
}

fn (a $&Assembler) t16_ldrb_imm5(rt int, rn int, byte_off int) {
    t_check_lo(rt, "ldrb_imm5")
    t_check_lo(rn, "ldrb_imm5")
    t_check_imm(byte_off >= 0 && byte_off <= 31, "ldrb_imm5")
    a.t_emit16(0x7800 | (byte_off << 6) | (rn << 3) | rt)
}

fn (a $&Assembler) t16_strb_imm5(rt int, rn int, byte_off int) {
    t_check_lo(rt, "strb_imm5")
    t_check_lo(rn, "strb_imm5")
    t_check_imm(byte_off >= 0 && byte_off <= 31, "strb_imm5")
    a.t_emit16(0x7000 | (byte_off << 6) | (rn << 3) | rt)
}

fn (a $&Assembler) t16_lsl_imm5(rd int, rm int, sh int) {
    t_check_lo(rd, "lsl_imm5")
    t_check_lo(rm, "lsl_imm5")
    t_check_imm(sh >= 0 && sh <= 31, "lsl_imm5")
    a.t_emit16(0x0000 | (sh << 6) | (rm << 3) | rd)
}

fn (a $&Assembler) t16_lsr_imm5(rd int, rm int, sh int) {
    t_check_lo(rd, "lsr_imm5")
    t_check_lo(rm, "lsr_imm5")
    t_check_imm(sh >= 1 && sh <= 31, "lsr_imm5")
    a.t_emit16(0x0800 | (sh << 6) | (rm << 3) | rd)
}

fn (a $&Assembler) t16_and_reg(rdn int, rm int) {
    t_check_lo(rdn, "and_reg")
    t_check_lo(rm, "and_reg")
    a.t_emit16(0x4000 | (rm << 3) | rdn)
}

fn (a $&Assembler) t16_eor_reg(rdn int, rm int) {
    t_check_lo(rdn, "eor_reg")
    t_check_lo(rm, "eor_reg")
    a.t_emit16(0x4040 | (rm << 3) | rdn)
}

fn (a $&Assembler) t16_lsl_reg(rdn int, rm int) {
    t_check_lo(rdn, "lsl_reg")
    t_check_lo(rm, "lsl_reg")
    a.t_emit16(0x4080 | (rm << 3) | rdn)
}

fn (a $&Assembler) t16_asr_reg(rdn int, rm int) {
    t_check_lo(rdn, "asr_reg")
    t_check_lo(rm, "asr_reg")
    a.t_emit16(0x4100 | (rm << 3) | rdn)
}

fn (a $&Assembler) t16_orr_reg(rdn int, rm int) {
    t_check_lo(rdn, "orr_reg")
    t_check_lo(rm, "orr_reg")
    a.t_emit16(0x4300 | (rm << 3) | rdn)
}

fn (a $&Assembler) t16_mul_reg(rdn int, rm int) {
    t_check_lo(rdn, "mul_reg")
    t_check_lo(rm, "mul_reg")
    a.t_emit16(0x4340 | (rm << 3) | rdn)
}

fn (a $&Assembler) t16_neg_reg(rd int, rm int) {
    t_check_lo(rd, "neg_reg")
    t_check_lo(rm, "neg_reg")
    a.t_emit16(0x4240 | (rm << 3) | rd)
}

fn (a $&Assembler) t_push_r7_lr() { a.t_emit16(0xB580) }
fn (a $&Assembler) t_pop_r7_pc() { a.t_emit16(0xBD80) }
fn (a $&Assembler) t_pop_r7_lr() { a.t_emit32(0xE8BD, 0x4080) }
fn (a $&Assembler) t_push_r4_r5_r6_r8() { a.t_emit32(0xE92D, 0x0170) }
fn (a $&Assembler) t_pop_r4_r5_r6_r8() { a.t_emit32(0xE8BD, 0x0170) }
fn (a $&Assembler) t_wfi() { a.t_emit16(0xBF30) }
fn (a $&Assembler) t_cpsid_i() { a.t_emit16(0xB672) }
fn (a $&Assembler) t_cpsie_i() { a.t_emit16(0xB662) }
fn (a $&Assembler) t_nop() { a.t_emit16(0xBF00) }
fn (a $&Assembler) t_bx_lr() { a.t_emit16(0x4770) }
fn (a $&Assembler) t_svc(imm int) { a.t_emit16(0xDF00 | (imm & 255)) }

fn (a $&Assembler) t_mrs_ipsr(rd int) {
    a.t_emit32(0xF3EF, 0x8000 | (rd << 8) | 5)
}

// ARMv7 exclusive word operations. The encodings use an immediate offset of
// zero; the backend supplies the address and the status/value registers.
fn (a $&Assembler) t_ldrex(rt int, rn int) {
    a.t_emit32(0xE850 | rn, (rt << 12) | 0x0F00)
}

fn (a $&Assembler) t_strex(rd int, rt int, rn int) {
    a.t_emit32(0xE840 | rn, ((rt & 15) << 12) | ((rd & 15) << 8))
}

fn (a $&Assembler) t_addw(rd int, rn int, imm12 int) {
    i := (imm12 >> 11) & 1
    imm3 := (imm12 >> 8) & 7
    imm8 := imm12 & 255
    a.t_emit32(0xF200 | (i << 10) | rn, (imm3 << 12) | (rd << 8) | imm8)
}

fn (a $&Assembler) t_subw(rd int, rn int, imm12 int) {
    i := (imm12 >> 11) & 1
    imm3 := (imm12 >> 8) & 7
    imm8 := imm12 & 255
    a.t_emit32(0xF2A0 | (i << 10) | rn, (imm3 << 12) | (rd << 8) | imm8)
}

fn (a $&Assembler) t_sub_sp(imm int) {
    if imm == 0 { << }
    if imm > 4095 {
        $rem := imm
        while rem > 4095 {
            a.t_subw(13, 13, 4095)
            rem = rem - 4095
        }
        if rem > 0 { a.t_sub_sp(rem) }
        <<
    }
    if imm <= 508 && imm % 4 == 0 {
        a.t_emit16(0xB080 | (imm / 4))
        <<
    }
    if imm <= 4095 {
        a.t_subw(13, 13, imm)
        <<
    }
    eprintln("E1: frame larger than 4095")
    <<< 1
}

fn (a $&Assembler) t_add_sp(imm int) {
    if imm == 0 { << }
    if imm > 4095 {
        $rem := imm
        while rem > 4095 {
            a.t_addw(13, 13, 4095)
            rem = rem - 4095
        }
        if rem > 0 { a.t_add_sp(rem) }
        <<
    }
    if imm <= 508 && imm % 4 == 0 {
        a.t_emit16(0xB000 | (imm / 4))
        <<
    }
    if imm <= 4095 {
        a.t_addw(13, 13, imm)
        <<
    }
    eprintln("E1: add_sp larger than 4095")
    <<< 1
}

fn (a $&Assembler) t_mov_reg(rd int, rm int) {
    hw := 0x4600 | ((rm & 15) << 3) | (rd & 7) | ((rd & 8) << 4)
    a.t_emit16(hw)
}

fn (a $&Assembler) t_movw(rd int, imm16 int) {
    i := (imm16 >> 11) & 1
    imm4 := (imm16 >> 12) & 15
    imm3 := (imm16 >> 8) & 7
    imm8 := imm16 & 255
    a.t_emit32(0xF240 | (i << 10) | imm4, (imm3 << 12) | (rd << 8) | imm8)
}

fn (a $&Assembler) t_movt(rd int, imm16 int) {
    i := (imm16 >> 11) & 1
    imm4 := (imm16 >> 12) & 15
    imm3 := (imm16 >> 8) & 7
    imm8 := imm16 & 255
    a.t_emit32(0xF2C0 | (i << 10) | imm4, (imm3 << 12) | (rd << 8) | imm8)
}

fn (a $&Assembler) t_mov_imm32(rd int, imm int) {
    u := imm & 4294967295
    if rd <= 7 && u <= 255 {
        a.t16_mov_imm8(rd, u)
        <<
    }
    a.t_movw(rd, u & 65535)
    hi := (u >> 16) & 65535
    if hi != 0 {
        a.t_movt(rd, hi)
    }
}

fn (a $&Assembler) t_mov_imm(rd int, imm int) { a.t_mov_imm32(rd, imm) }
fn (a $&Assembler) t_mov_imm64(rd int, imm int) { a.t_mov_imm32(rd, imm) }

fn (a $&Assembler) t_str_imm12(rt int, rn int, imm12 int) {
    if rn == 13 && rt <= 7 && imm12 >= 0 && imm12 <= 1020 && imm12 % 4 == 0 {
        a.t16_str_sp(rt, imm12)
        <<
    }
    if rt <= 7 && rn <= 7 && imm12 >= 0 && imm12 <= 124 && imm12 % 4 == 0 {
        a.t16_str_imm5(rt, rn, imm12)
        <<
    }
    a.t_emit32(0xF8C0 | rn, (rt << 12) | (imm12 & 4095))
}
fn (a $&Assembler) t_ldr_imm12(rt int, rn int, imm12 int) {
    if rn == 13 && rt <= 7 && imm12 >= 0 && imm12 <= 1020 && imm12 % 4 == 0 {
        a.t16_ldr_sp(rt, imm12)
        <<
    }
    if rt <= 7 && rn <= 7 && imm12 >= 0 && imm12 <= 124 && imm12 % 4 == 0 {
        a.t16_ldr_imm5(rt, rn, imm12)
        <<
    }
    a.t_emit32(0xF8D0 | rn, (rt << 12) | (imm12 & 4095))
}
fn (a $&Assembler) t_str_neg(rt int, rn int, imm8 int) {
    a.t_emit32(0xF840 | rn, (rt << 12) | 0x0C00 | (imm8 & 255))
}
fn (a $&Assembler) t_ldr_neg(rt int, rn int, imm8 int) {
    a.t_emit32(0xF850 | rn, (rt << 12) | 0x0C00 | (imm8 & 255))
}
fn (a $&Assembler) t_strb_imm12(rt int, rn int, imm12 int) {
    if rt <= 7 && rn <= 7 && imm12 >= 0 && imm12 <= 31 {
        a.t16_strb_imm5(rt, rn, imm12)
        <<
    }
    a.t_emit32(0xF880 | rn, (rt << 12) | (imm12 & 4095))
}
fn (a $&Assembler) t_ldrb_imm12(rt int, rn int, imm12 int) {
    if rt <= 7 && rn <= 7 && imm12 >= 0 && imm12 <= 31 {
        a.t16_ldrb_imm5(rt, rn, imm12)
        <<
    }
    a.t_emit32(0xF890 | rn, (rt << 12) | (imm12 & 4095))
}
fn (a $&Assembler) t_strb_neg(rt int, rn int, imm8 int) {
    a.t_emit32(0xF800 | rn, (rt << 12) | 0x0C00 | (imm8 & 255))
}
fn (a $&Assembler) t_ldrb_neg(rt int, rn int, imm8 int) {
    a.t_emit32(0xF810 | rn, (rt << 12) | 0x0C00 | (imm8 & 255))
}

fn t_mod_imm(v int) int {
    if v < 0 { << 0 }
    if v <= 255 {
        << (1 << 12) | v
    }
    if (v & 0xFF00FF00) == 0 && (v >> 16) == (v & 255) {
        << (1 << 12) | (1 << 8) | (v & 255)
    }
    if (v & 0x00FF00FF) == 0 && (v >> 24) == ((v >> 8) & 255) {
        << (1 << 12) | (2 << 8) | ((v >> 8) & 255)
    }
    if ((v >> 24) & 255) == (v & 255) && ((v >> 16) & 255) == (v & 255) && ((v >> 8) & 255) == (v & 255) {
        << (1 << 12) | (3 << 8) | (v & 255)
    }
    u := v & 0xFFFFFFFF
    for rot in 1:32 {
        val := ((u << rot) | (u >> (32 - rot))) & 0xFFFFFFFF
        if (val >> 8) == 0 && (val & 128) != 0 {
            imm7 := val & 127
            i := (rot >> 4) & 1
            imm3 := (rot >> 1) & 7
            imm8 := ((rot & 1) << 7) | imm7
            << (1 << 12) | (i << 11) | (imm3 << 8) | imm8
        }
    }
    << 0
}

fn (a $&Assembler) t_add_imm(rd int, rn int, imm int) {
    if imm < 0 {
        a.t_sub_imm(rd, rn, 0 - imm)
        <<
    }
    if rd <= 7 && rn <= 7 {
        if imm <= 7 {
            a.t16_add_imm3(rd, rn, imm)
            <<
        }
        if rd == rn && imm <= 255 {
            a.t16_add_imm8(rd, imm)
            <<
        }
    }
    if imm <= 4095 {
        a.t_addw(rd, rn, imm)
        <<
    }
    m := t_mod_imm(imm)
    if (m & (1 << 12)) != 0 {
        i := (m >> 11) & 1
        imm3 := (m >> 8) & 7
        imm8 := m & 255
        a.t_emit32(0xF100 | (i << 10) | rn, (imm3 << 12) | (rd << 8) | imm8)
        <<
    }
    scratch := t_scratch_not(rd, rn)
    a.t_mov_imm32(scratch, imm)
    a.t_add_reg(rd, rn, scratch)
}

fn (a $&Assembler) t_sub_imm(rd int, rn int, imm int) {
    if imm < 0 {
        a.t_add_imm(rd, rn, 0 - imm)
        <<
    }
    if rd <= 7 && rn <= 7 {
        if imm <= 7 {
            a.t16_sub_imm3(rd, rn, imm)
            <<
        }
        if rd == rn && imm <= 255 {
            a.t16_sub_imm8(rd, imm)
            <<
        }
    }
    if imm <= 4095 {
        a.t_subw(rd, rn, imm)
        <<
    }
    m := t_mod_imm(imm)
    if (m & (1 << 12)) != 0 {
        i := (m >> 11) & 1
        imm3 := (m >> 8) & 7
        imm8 := m & 255
        a.t_emit32(0xF1A0 | (i << 10) | rn, (imm3 << 12) | (rd << 8) | imm8)
        <<
    }
    scratch := t_scratch_not(rd, rn)
    a.t_mov_imm32(scratch, imm)
    a.t_sub_reg(rd, rn, scratch)
}

fn (a $&Assembler) t_adjust_base_offset(dest int, src int, offset int) {
    a.t_mov_reg(dest, src)
    if offset >= 0 {
        $rem := offset
        while rem > 4095 {
            a.t_addw(dest, dest, 4095)
            rem = rem - 4095
        }
        if rem > 0 { a.t_addw(dest, dest, rem) }
    } else {
        $rem := 0 - offset
        while rem > 4095 {
            a.t_subw(dest, dest, 4095)
            rem = rem - 4095
        }
        if rem > 0 { a.t_subw(dest, dest, rem) }
    }
}

fn (a $&Assembler) t_store_offset(rt int, rn int, offset int) {
    if offset >= 0 && offset <= 4095 {
        a.t_str_imm12(rt, rn, offset)
        <<
    }
    if offset >= 0 - 255 && offset < 0 {
        a.t_str_neg(rt, rn, 0 - offset)
        <<
    }
    s := t_scratch_not(rt, rn)
    a.t_adjust_base_offset(s, rn, offset)
    a.t_str_imm12(rt, s, 0)
}

fn (a $&Assembler) t_load_offset(rt int, rn int, offset int) {
    if offset >= 0 && offset <= 4095 {
        a.t_ldr_imm12(rt, rn, offset)
        <<
    }
    if offset >= 0 - 255 && offset < 0 {
        a.t_ldr_neg(rt, rn, 0 - offset)
        <<
    }
    if rt != rn {
        a.t_adjust_base_offset(rt, rn, offset)
        a.t_ldr_imm12(rt, rt, 0)
        <<
    }
    s := t_scratch_not(rt, rn)
    a.t_adjust_base_offset(s, rn, offset)
    a.t_ldr_imm12(rt, s, 0)
}

fn (a $&Assembler) t_store_byte_offset(rt int, rn int, offset int) {
    if offset >= 0 && offset <= 4095 {
        a.t_strb_imm12(rt, rn, offset)
        <<
    }
    if offset >= 0 - 255 && offset < 0 {
        a.t_strb_neg(rt, rn, 0 - offset)
        <<
    }
    s := t_scratch_not(rt, rn)
    a.t_adjust_base_offset(s, rn, offset)
    a.t_strb_imm12(rt, s, 0)
}

fn (a $&Assembler) t_load_byte_offset(rt int, rn int, offset int) {
    if offset >= 0 && offset <= 4095 {
        a.t_ldrb_imm12(rt, rn, offset)
        <<
    }
    if offset >= 0 - 255 && offset < 0 {
        a.t_ldrb_neg(rt, rn, 0 - offset)
        <<
    }
    if rt != rn {
        a.t_adjust_base_offset(rt, rn, offset)
        a.t_ldrb_imm12(rt, rt, 0)
        <<
    }
    s := t_scratch_not(rt, rn)
    a.t_adjust_base_offset(s, rn, offset)
    a.t_ldrb_imm12(rt, s, 0)
}

fn (a $&Assembler) t_add_reg(rd int, rn int, rm int) {
    if rd <= 7 && rn <= 7 && rm <= 7 {
        a.t16_add_reg(rd, rn, rm)
        <<
    }
    a.t_emit32(0xEB00 | rn, (rd << 8) | rm)
}
fn (a $&Assembler) t_sub_reg(rd int, rn int, rm int) {
    if rd <= 7 && rn <= 7 && rm <= 7 {
        a.t16_sub_reg(rd, rn, rm)
        <<
    }
    a.t_emit32(0xEBA0 | rn, (rd << 8) | rm)
}
fn (a $&Assembler) t_mul(rd int, rn int, rm int) {
    if rd <= 7 && rn <= 7 && rm <= 7 {
        if rd == rn {
            a.t16_mul_reg(rd, rm)
            <<
        }
        if rd == rm {
            a.t16_mul_reg(rd, rn)
            <<
        }
    }
    a.t_emit32(0xFB00 | rn, 0xF000 | (rd << 8) | rm)
}
fn (a $&Assembler) t_sdiv(rd int, rn int, rm int) {
    a.t_emit32(0xFB90 | rn, 0xF0F0 | (rd << 8) | rm)
}
fn (a $&Assembler) t_mls(rd int, rn int, rm int, ra int) {
    a.t_emit32(0xFB00 | rn, (ra << 12) | (rd << 8) | 0x0010 | rm)
}
fn (a $&Assembler) t_neg_reg(rd int, rn int) {
    if rd <= 7 && rn <= 7 {
        a.t16_neg_reg(rd, rn)
        <<
    }
    a.t_emit32(0xF1C0 | rn, rd << 8)
}
fn (a $&Assembler) t_and_reg(rd int, rn int, rm int) {
    if rd <= 7 && rn <= 7 && rm <= 7 {
        if rd == rn {
            a.t16_and_reg(rd, rm)
            <<
        }
        if rd == rm {
            a.t16_and_reg(rd, rn)
            <<
        }
    }
    a.t_emit32(0xEA00 | rn, (rd << 8) | rm)
}
fn (a $&Assembler) t_and_imm(rd int, rn int, imm int) {
    m := t_mod_imm(imm)
    if (m & (1 << 12)) != 0 {
        i := (m >> 11) & 1
        imm3 := (m >> 8) & 7
        imm8 := m & 255
        a.t_emit32(0xF000 | (i << 10) | rn, (imm3 << 12) | (rd << 8) | imm8)
        <<
    }
    scratch := t_scratch_not(rd, rn)
    a.t_mov_imm32(scratch, imm)
    a.t_and_reg(rd, rn, scratch)
}
fn (a $&Assembler) t_orr_reg(rd int, rn int, rm int) {
    if rd <= 7 && rn <= 7 && rm <= 7 {
        if rd == rn {
            a.t16_orr_reg(rd, rm)
            <<
        }
        if rd == rm {
            a.t16_orr_reg(rd, rn)
            <<
        }
    }
    a.t_emit32(0xEA40 | rn, (rd << 8) | rm)
}
fn (a $&Assembler) t_eor_reg(rd int, rn int, rm int) {
    if rd <= 7 && rn <= 7 && rm <= 7 {
        if rd == rn {
            a.t16_eor_reg(rd, rm)
            <<
        }
        if rd == rm {
            a.t16_eor_reg(rd, rn)
            <<
        }
    }
    a.t_emit32(0xEA80 | rn, (rd << 8) | rm)
}
fn (a $&Assembler) t_lsl_reg(rd int, rn int, rm int) {
    if rd <= 7 && rn == rd && rm <= 7 {
        a.t16_lsl_reg(rd, rm)
        <<
    }
    a.t_emit32(0xFA00 | rn, 0xF000 | (rd << 8) | rm)
}
fn (a $&Assembler) t_lsr_reg(rd int, rn int, rm int) {
    a.t_emit32(0xFA20 | rn, 0xF000 | (rd << 8) | rm)
}
fn (a $&Assembler) t_asr_reg(rd int, rn int, rm int) {
    if rd <= 7 && rn == rd && rm <= 7 {
        a.t16_asr_reg(rd, rm)
        <<
    }
    a.t_emit32(0xFA40 | rn, 0xF000 | (rd << 8) | rm)
}

fn (a $&Assembler) t_lsl_imm(rd int, rm int, shift int) {
    sh := shift & 31
    if rd <= 7 && rm <= 7 {
        a.t16_lsl_imm5(rd, rm, sh)
        <<
    }
    imm3 := (sh >> 2) & 7
    imm2 := sh & 3
    a.t_emit32(0xEA4F, (imm3 << 12) | (rd << 8) | (imm2 << 6) | rm)
}

fn (a $&Assembler) t_lsr_imm(rd int, rm int, shift int) {
    sh := shift & 31
    if sh == 0 {
        a.t_mov_reg(rd, rm)
        <<
    }
    if rd <= 7 && rm <= 7 {
        a.t16_lsr_imm5(rd, rm, sh)
        <<
    }
    imm3 := (sh >> 2) & 7
    imm2 := sh & 3
    a.t_emit32(0xEA4F, (imm3 << 12) | (rd << 8) | (imm2 << 6) | (1 << 4) | rm)
}

fn (a $&Assembler) t_cmp_reg(rn int, rm int) {
    if rn <= 7 && rm <= 7 {
        a.t16_cmp_reg(rn, rm)
        <<
    }
    a.t_emit32(0xEBB0 | rn, 0x0F00 | rm)
}

fn (a $&Assembler) t_cmp_imm(rn int, imm int) {
    if imm >= 0 && imm <= 255 {
        if rn <= 7 {
            a.t16_cmp_imm8(rn, imm)
            <<
        }
        a.t_emit32(0xF1B0 | rn, 0x0F00 | (imm & 255))
        <<
    }
    s := t_scratch_not(rn, 15)
    a.t_mov_imm(s, imm)
    a.t_cmp_reg(rn, s)
}

fn (a $&Assembler) t_lea_abs(rd int, label string) {
    a.t_push_fixup(2, label, rd)
    a.t_movw(rd, 0)
    a.t_movt(rd, 0)
}

fn (a $&Assembler) t_b(label string) {
    a.t_push_fixup(0, label, 0)
    a.t_emit32(0xF000, 0xB800)
}

fn (a $&Assembler) t_bl(label string) {
    a.t_push_fixup(1, label, 0)
    a.t_emit32(0xF000, 0xF800)
}

fn (a $&Assembler) t_blx(rm int) {
    a.t_emit16(0x4780 | (rm << 3))
}

fn (a $&Assembler) t_bcond(cond int, label string) {
    a.t_push_fixup(3, label, cond & 15)
    a.t_emit16(0)
}

fn (a $&Assembler) t_cbz(rn int, label string) {
    if rn <= 7 {
        a.t_push_fixup(6, label, rn & 7)
        a.t_emit16(0)
        <<
    }
    a.t_cmp_imm(rn, 0)
    a.t_beq(label)
}

fn (a $&Assembler) t_cbnz(rn int, label string) {
    if rn <= 7 {
        a.t_push_fixup(6, label, (rn & 7) | 16)
        a.t_emit16(0)
        <<
    }
    a.t_cmp_imm(rn, 0)
    a.t_bne(label)
}

fn (a $&Assembler) t_beq(label string) { a.t_bcond(0, label) }
fn (a $&Assembler) t_bne(label string) { a.t_bcond(1, label) }
fn (a $&Assembler) t_bhs(label string) { a.t_bcond(2, label) }
fn (a $&Assembler) t_blo(label string) { a.t_bcond(3, label) }
fn (a $&Assembler) t_bhi(label string) { a.t_bcond(8, label) }
fn (a $&Assembler) t_bls(label string) { a.t_bcond(9, label) }
fn (a $&Assembler) t_blt(label string) { a.t_bcond(11, label) }
fn (a $&Assembler) t_bge(label string) { a.t_bcond(10, label) }
fn (a $&Assembler) t_bgt(label string) { a.t_bcond(12, label) }
fn (a $&Assembler) t_ble(label string) { a.t_bcond(13, label) }

fn t_thm_hw1(offset int) int {
    s := (offset >> 24) & 1
    imm10 := (offset >> 12) & 1023
    << 0xF000 | (s << 10) | imm10
}

fn t_thm_hw2(offset int, link int) int {
    s := (offset >> 24) & 1
    i1 := (offset >> 23) & 1
    i2 := (offset >> 22) & 1
    imm11 := (offset >> 1) & 2047
    j1 := (i1 ^ s ^ 1) & 1
    j2 := (i2 ^ s ^ 1) & 1
    $op := 0x9000
    if link == 1 {
        op = 0xD000
    }
    << op | (j1 << 13) | (j2 << 11) | imm11
}

fn t_bcond_w_hw1(cond int, offset int) int {
    s := (offset >> 20) & 1
    imm6 := (offset >> 12) & 63
    << 0xF000 | (s << 10) | ((cond & 15) << 6) | imm6
}

fn t_bcond_w_hw2(offset int) int {
    j2 := (offset >> 19) & 1
    j1 := (offset >> 18) & 1
    imm11 := (offset >> 1) & 2047
    << 0x8000 | (j1 << 13) | (j2 << 11) | imm11
}

fn t_fixup_set(fs $&[]Fixup, i int, kind int, offset int, rd int) {
    fs[i].kind = kind
    fs[i].offset = offset
    fs[i].rd = rd
}

fn t_lab_shift(ls $&[]Label, i int, new_off int) {
    ls[i].offset = new_off
}

fn (a $&Assembler) t_relax_branches() {
    for _ in 0:64 {
        nfix := a.fixups.len
        $grow := []int{}
        $next_kind := []int{}
        $any_grow := false
        for i in 0:nfix {
            kind := fix_kind(&a.fixups, i)
            offset := fix_off(&a.fixups, i)
            $g := 0
            $nk := kind
            if kind == 3 || kind == 4 || kind == 6 {
                target_addr := a.label_addr(fix_label(&a.fixups, i))
                disp := target_addr - (a.code_vaddr + offset) - 4
                if kind == 3 {
                    if disp < -256 || disp > 254 {
                        if disp >= -1048576 && disp <= 1048574 {
                            nk = 4
                            g = 2
                        } else {
                            nk = 5
                            g = 4
                        }
                        any_grow = true
                    }
                } else if kind == 4 {
                    if disp < -1048576 || disp > 1048574 {
                        nk = 5
                        g = 2
                        any_grow = true
                    }
                } else if kind == 6 {
                    if disp < 0 || disp > 126 {
                        if disp - 2 >= -256 && disp - 2 <= 254 {
                            nk = 3
                            g = 2
                        } else if disp - 2 >= -1048576 && disp - 2 <= 1048574 {
                            nk = 4
                            g = 4
                        } else {
                            nk = 5
                            g = 6
                        }
                        any_grow = true
                    }
                }
            }
            grow.push(g)
            next_kind.push(nk)
        }
        if !any_grow { <- }

        // Build new_code in one linear scan and record prefix delta before each fixup.
        $delta_before := []int{}
        $acc := 0
        for i in 0:nfix {
            delta_before.push(acc)
            acc += grow[i]
        }

        $new_code := []int{}
        $pos := 0
        $fi := 0
        old_len := a.code.len
        while pos < old_len {
            if fi < nfix && pos == fix_off(&a.fixups, fi) && grow[fi] > 0 {
                old_kind := fix_kind(&a.fixups, fi)
                rd := fix_rd(&a.fixups, fi)
                $old_sz := 2
                if old_kind == 4 { old_sz = 4 }
                if old_kind == 6 {
                    // Emit 16-bit CMP rn, #0 (0x2800 | (rn << 8)), then branch placeholder
                    hw := 0x2800 | ((rd & 7) << 8)
                    new_code.push(hw & 255)
                    new_code.push((hw >> 8) & 255)
                    for _ in 0:grow[fi] { new_code.push(0) }
                } else {
                    new_sz := old_sz + grow[fi]
                    for _ in 0:new_sz { new_code.push(0) }
                }
                pos += old_sz
                fi += 1
            } else {
                if fi < nfix && pos == fix_off(&a.fixups, fi) {
                    fi += 1
                }
                new_code.push(a.code[pos])
                pos += 1
            }
        }
        a.code = new_code

        // Shift code labels by total growth of fixups strictly before label.offset.
        nlab := a.labels.len
        for li in 0:nlab {
            if !lab_is_data(&a.labels, li) {
                loff := lab_off(&a.labels, li)
                if loff >= 0 {
                    $d := 0
                    for k in 0:nfix {
                        if fix_off(&a.fixups, k) < loff {
                            d += grow[k]
                        } else {
                            <-
                        }
                    }
                    if d > 0 {
                        t_lab_shift($&a.labels, li, loff + d)
                    }
                }
            }
        }

        for ei in 0:a.lib_exp_off.len {
            eoff := a.lib_exp_off[ei]
            if eoff >= 0 {
                $d := 0
                for k in 0:nfix {
                    if fix_off(&a.fixups, k) < eoff {
                        d += grow[k]
                    } else {
                        <-
                    }
                }
                a.lib_exp_off[ei] = eoff + d
            }
        }

        // Update fixups with new offsets and relaxed kinds.
        for k in 0:nfix {
            old_kind := fix_kind(&a.fixups, k)
            old_off := fix_off(&a.fixups, k)
            old_rd := fix_rd(&a.fixups, k)
            if old_kind == 6 && grow[k] > 0 {
                t_fixup_set($&a.fixups, k, next_kind[k], old_off + delta_before[k] + 2, (old_rd >> 4) & 1)
            } else {
                t_fixup_set($&a.fixups, k, next_kind[k], old_off + delta_before[k], old_rd)
            }
        }
    }
}

fn (a $&Assembler) t_fixup_all() {
    a.t_relax_branches()
    if a.os != 3 {
        a.data_vaddr = a.code_vaddr + ((a.code.len + 4095) / 4096) * 4096
    }
    for i in 0:a.fixups.len {
        kind := fix_kind(&a.fixups, i)
        offset := fix_off(&a.fixups, i)
        rd := fix_rd(&a.fixups, i)
        lab := fix_label(&a.fixups, i)
        target_addr := a.label_addr(lab)
        if kind == 0 || kind == 1 {
            current_addr := a.code_vaddr + offset
            disp := target_addr - current_addr - 4
            if disp % 2 != 0 {
                eprintln("ERROR: Thumb branch offset must be even")
                <<< 1
            }
            if disp < -16777216 || disp > 16777214 {
                eprintln("ERROR: Thumb branch offset out of range (need +/-16 MiB)")
                <<< 1
            }
            $link := 0
            if kind == 1 {
                link = 1
            }
            a.t_patch16(offset, t_thm_hw1(disp))
            a.t_patch16(offset + 2, t_thm_hw2(disp, link))
        } else if kind == 3 {
            current_addr := a.code_vaddr + offset
            disp := target_addr - current_addr - 4
            if disp % 2 != 0 || disp < -256 || disp > 254 {
                eprintln("ERROR: Thumb B<cond> 16-bit offset out of range")
                <<< 1
            }
            imm8 := (disp >> 1) & 255
            a.t_patch16(offset, 0xD000 | ((rd & 15) << 8) | imm8)
        } else if kind == 4 {
            current_addr := a.code_vaddr + offset
            disp := target_addr - current_addr - 4
            if disp % 2 != 0 || disp < -1048576 || disp > 1048574 {
                eprintln("ERROR: Thumb B<cond>.W 32-bit offset out of range")
                <<< 1
            }
            a.t_patch16(offset, t_bcond_w_hw1(rd, disp))
            a.t_patch16(offset + 2, t_bcond_w_hw2(disp))
        } else if kind == 5 {
            inv := (rd ^ 1) & 15
            a.t_patch16(offset, 0xD000 | (inv << 8) | 1)
            current_addr := a.code_vaddr + offset + 2
            disp := target_addr - current_addr - 4
            if disp % 2 != 0 || disp < -16777216 || disp > 16777214 {
                eprintln("ERROR: Thumb branch offset out of range (need +/-16 MiB)")
                <<< 1
            }
            a.t_patch16(offset + 2, t_thm_hw1(disp))
            a.t_patch16(offset + 4, t_thm_hw2(disp, 0))
        } else if kind == 6 {
            current_addr := a.code_vaddr + offset
            disp := target_addr - current_addr - 4
            if disp % 2 != 0 || disp < 0 || disp > 126 {
                eprintln("ERROR: Thumb CBZ/CBNZ 16-bit offset out of range")
                <<< 1
            }
            rn := rd & 7
            op := (rd >> 4) & 1
            i_bit := (disp >> 6) & 1
            imm5 := (disp >> 1) & 31
            a.t_patch16(offset, 0xB100 | (op << 11) | (i_bit << 9) | (imm5 << 3) | rn)
        } else {
            $addr := target_addr
            if !a.label_is_data(fix_label(&a.fixups, i)) {
                addr = addr | 1
            }
            u := addr & 4294967295
            lo := u & 65535
            hi := (u >> 16) & 65535
            i0 := (lo >> 11) & 1
            imm4_0 := (lo >> 12) & 15
            imm3_0 := (lo >> 8) & 7
            imm8_0 := lo & 255
            a.t_patch16(offset, 0xF240 | (i0 << 10) | imm4_0)
            a.t_patch16(offset + 2, (imm3_0 << 12) | (rd << 8) | imm8_0)
            i1 := (hi >> 11) & 1
            imm4_1 := (hi >> 12) & 15
            imm3_1 := (hi >> 8) & 7
            imm8_1 := hi & 255
            a.t_patch16(offset, 0xF240 | (i0 << 10) | imm4_0)
            a.t_patch16(offset + 2, (imm3_0 << 12) | (rd << 8) | imm8_0)
            a.t_patch16(offset + 4, 0xF2C0 | (i1 << 10) | imm4_1)
            a.t_patch16(offset + 6, (imm3_1 << 12) | (rd << 8) | imm8_1)
        }
    }
}

// ===== Thumb-2 64-bit integer primitives (Stage 2 / P4) =====

fn (a $&Assembler) t_asr_imm(rd int, rm int, shift int) {
    $sh := shift
    if sh < 1 { sh = 1 }
    if sh > 31 { sh = 31 }
    imm3 := (sh >> 2) & 7
    imm2 := sh & 3
    a.t_emit32(0xEA4F, (imm3 << 12) | (rd << 8) | (imm2 << 6) | (2 << 4) | rm)
}

fn (a $&Assembler) t_adds_reg(rd int, rn int, rm int) {
    if rd <= 7 && rn <= 7 && rm <= 7 {
        a.t16_add_reg(rd, rn, rm)
        <<
    }
    a.t_emit32(0xEB10 | rn, (rd << 8) | rm)
}

fn (a $&Assembler) t_adc_reg(rd int, rn int, rm int) {
    a.t_emit32(0xEB40 | rn, (rd << 8) | rm)
}

fn (a $&Assembler) t_adcs_reg(rd int, rn int, rm int) {
    if rd <= 7 && rn == rd && rm <= 7 {
        a.t_emit16(0x4140 | (rm << 3) | rd)
        <<
    }
    a.t_emit32(0xEB50 | rn, (rd << 8) | rm)
}

fn (a $&Assembler) t_subs_reg(rd int, rn int, rm int) {
    if rd <= 7 && rn <= 7 && rm <= 7 {
        a.t16_sub_reg(rd, rn, rm)
        <<
    }
    a.t_emit32(0xEBB0 | rn, (rd << 8) | rm)
}

fn (a $&Assembler) t_sbc_reg(rd int, rn int, rm int) {
    a.t_emit32(0xEB60 | rn, (rd << 8) | rm)
}

fn (a $&Assembler) t_sbcs_reg(rd int, rn int, rm int) {
    if rd <= 7 && rn == rd && rm <= 7 {
        a.t_emit16(0x4180 | (rm << 3) | rd)
        <<
    }
    a.t_emit32(0xEB70 | rn, (rd << 8) | rm)
}

fn (a $&Assembler) t_rsbs_imm0(rd int, rn int) {
    if rd <= 7 && rn <= 7 {
        a.t_emit16(0x4240 | (rn << 3) | rd)
        <<
    }
    a.t_emit32(0xF1D0 | rn, rd << 8)
}

fn (a $&Assembler) t_umull(rdlo int, rdhi int, rn int, rm int) {
    a.t_emit32(0xFBA0 | rn, (rdlo << 12) | (rdhi << 8) | rm)
}

fn (a $&Assembler) t_mla(rd int, rn int, rm int, ra int) {
    a.t_emit32(0xFB00 | rn, (ra << 12) | (rd << 8) | rm)
}

fn (a $&Assembler) t_udiv(rd int, rn int, rm int) {
    a.t_emit32(0xFBB0 | rn, 0xF0F0 | (rd << 8) | rm)
}

fn (a $&Assembler) t_mov_imm64_pair(rdlo int, rdhi int, imm int) {
    lo := imm & 4294967295
    $hi := (imm >> 32) & 4294967295
    a.t_mov_imm32(rdlo, lo)
    a.t_mov_imm32(rdhi, hi)
}

fn (a $&Assembler) t_load64_offset(rdlo int, rdhi int, rn int, offset int) {
    if offset >= 0 - 255 && offset <= 4091 {
        if rdlo == rn {
            a.t_load_offset(rdhi, rn, offset + 4)
            a.t_load_offset(rdlo, rn, offset)
        } else {
            a.t_load_offset(rdlo, rn, offset)
            a.t_load_offset(rdhi, rn, offset + 4)
        }
        <<
    }
    if rdlo != rn {
        a.t_adjust_base_offset(rdlo, rn, offset)
        a.t_load_offset(rdhi, rdlo, 4)
        a.t_load_offset(rdlo, rdlo, 0)
        <<
    }
    s := t_scratch_not3(rdlo, rdhi, rn)
    a.t_adjust_base_offset(s, rn, offset)
    a.t_load_offset(rdlo, s, 0)
    a.t_load_offset(rdhi, s, 4)
}

fn (a $&Assembler) t_store64_offset(rslo int, rshi int, rn int, offset int) {
    if offset >= 0 - 255 && offset <= 4091 {
        a.t_store_offset(rslo, rn, offset)
        a.t_store_offset(rshi, rn, offset + 4)
        <<
    }
    s := t_scratch_not3(rslo, rshi, rn)
    a.t_adjust_base_offset(s, rn, offset)
    a.t_store_offset(rslo, s, 0)
    a.t_store_offset(rshi, s, 4)
}

fn (a $&Assembler) t_add64_reg(rdlo int, rdhi int, ralo int, rahi int, rblo int, rbhi int) {
    if rdlo == rahi || rdlo == rbhi {
        a.t_adds_reg(12, ralo, rblo)
        a.t_adc_reg(rdhi, rahi, rbhi)
        a.t_mov_reg(rdlo, 12)
    } else {
        a.t_adds_reg(rdlo, ralo, rblo)
        a.t_adc_reg(rdhi, rahi, rbhi)
    }
}

fn (a $&Assembler) t_sub64_reg(rdlo int, rdhi int, ralo int, rahi int, rblo int, rbhi int) {
    if rdlo == rahi || rdlo == rbhi {
        a.t_subs_reg(12, ralo, rblo)
        a.t_sbc_reg(rdhi, rahi, rbhi)
        a.t_mov_reg(rdlo, 12)
    } else {
        a.t_subs_reg(rdlo, ralo, rblo)
        a.t_sbc_reg(rdhi, rahi, rbhi)
    }
}

fn (a $&Assembler) t_mul64_reg(rdlo int, rdhi int, ralo int, rahi int, rblo int, rbhi int) {
    a.t_mul(12, ralo, rbhi)
    a.t_mla(12, rahi, rblo, 12)
    a.t_umull(rdlo, rdhi, ralo, rblo)
    a.t_add_reg(rdhi, rdhi, 12)
}

fn (a $&Assembler) t_neg64_reg(rdlo int, rdhi int, rslo int, rshi int) {
    if rdlo == rshi {
        a.t_mov_reg(rdhi, rshi)
        a.t_mov_imm32(12, 0)
        a.t_rsbs_imm0(rdlo, rslo)
        a.t_sbc_reg(rdhi, 12, rdhi)
    } else {
        a.t_mov_imm32(12, 0)
        a.t_rsbs_imm0(rdlo, rslo)
        a.t_sbc_reg(rdhi, 12, rshi)
    }
}

fn (a $&Assembler) t_lsl64_imm(rdlo int, rdhi int, rslo int, rshi int, sh int) {
    s := sh & 63
    if s == 0 {
        if rdlo != rslo || rdhi != rshi {
            if rdlo == rshi {
                a.t_mov_reg(rdhi, rshi)
                a.t_mov_reg(rdlo, rslo)
            } else {
                a.t_mov_reg(rdlo, rslo)
                a.t_mov_reg(rdhi, rshi)
            }
        }
        <<
    }
    if s == 32 {
        a.t_mov_reg(rdhi, rslo)
        a.t_mov_imm32(rdlo, 0)
        <<
    }
    if s > 32 {
        a.t_lsl_imm(rdhi, rslo, s - 32)
        a.t_mov_imm32(rdlo, 0)
        <<
    }
    a.t_lsl_imm(12, rshi, s)
    a.t_lsr_imm(rdhi, rslo, 32 - s)
    a.t_orr_reg(rdhi, rdhi, 12)
    a.t_lsl_imm(rdlo, rslo, s)
}

fn (a $&Assembler) t_lsr64_imm(rdlo int, rdhi int, rslo int, rshi int, sh int) {
    s := sh & 63
    if s == 0 {
        if rdlo != rslo || rdhi != rshi {
            if rdlo == rshi {
                a.t_mov_reg(rdhi, rshi)
                a.t_mov_reg(rdlo, rslo)
            } else {
                a.t_mov_reg(rdlo, rslo)
                a.t_mov_reg(rdhi, rshi)
            }
        }
        <<
    }
    if s == 32 {
        a.t_mov_reg(rdlo, rshi)
        a.t_mov_imm32(rdhi, 0)
        <<
    }
    if s > 32 {
        a.t_lsr_imm(rdlo, rshi, s - 32)
        a.t_mov_imm32(rdhi, 0)
        <<
    }
    a.t_lsr_imm(12, rslo, s)
    a.t_lsl_imm(rdlo, rshi, 32 - s)
    a.t_orr_reg(rdlo, rdlo, 12)
    a.t_lsr_imm(rdhi, rshi, s)
}

fn (a $&Assembler) t_asr64_imm(rdlo int, rdhi int, rslo int, rshi int, sh int) {
    s := sh & 63
    if s == 0 {
        if rdlo != rslo || rdhi != rshi {
            if rdlo == rshi {
                a.t_mov_reg(rdhi, rshi)
                a.t_mov_reg(rdlo, rslo)
            } else {
                a.t_mov_reg(rdlo, rslo)
                a.t_mov_reg(rdhi, rshi)
            }
        }
        <<
    }
    if s >= 32 {
        if s > 32 {
            a.t_asr_imm(rdlo, rshi, s - 32)
        } else {
            a.t_mov_reg(rdlo, rshi)
        }
        a.t_asr_imm(rdhi, rshi, 31)
        <<
    }
    a.t_lsr_imm(12, rslo, s)
    a.t_lsl_imm(rdlo, rshi, 32 - s)
    a.t_orr_reg(rdlo, rdlo, 12)
    a.t_asr_imm(rdhi, rshi, s)
}

fn (a $&Assembler) t_and64_reg(rdlo int, rdhi int, ralo int, rahi int, rblo int, rbhi int) {
    a.t_and_reg(rdlo, ralo, rblo)
    a.t_and_reg(rdhi, rahi, rbhi)
}

fn (a $&Assembler) t_orr64_reg(rdlo int, rdhi int, ralo int, rahi int, rblo int, rbhi int) {
    a.t_orr_reg(rdlo, ralo, rblo)
    a.t_orr_reg(rdhi, rahi, rbhi)
}

fn (a $&Assembler) t_eor64_reg(rdlo int, rdhi int, ralo int, rahi int, rblo int, rbhi int) {
    a.t_eor_reg(rdlo, ralo, rblo)
    a.t_eor_reg(rdhi, rahi, rbhi)
}

fn (a $&Assembler) t_cmp64_cset(dest int, op int, ralo int, rahi int, rblo int, rbhi int) {
    a.drop_seq += 1
    l_true := "_xu_c64_t_" + str(a.drop_seq)
    l_done := "_xu_c64_d_" + str(a.drop_seq)
    l_fin := "_xu_c64_f_" + str(a.drop_seq)

    if op == 6 { // ==
        a.t_cmp_reg(rahi, rbhi)
        a.t_bne(str_clone(&l_done))
        a.t_cmp_reg(ralo, rblo)
        a.t_beq(str_clone(&l_true))
    } else if op == 7 { // !=
        a.t_cmp_reg(rahi, rbhi)
        a.t_bne(str_clone(&l_true))
        a.t_cmp_reg(ralo, rblo)
        a.t_bne(str_clone(&l_true))
    } else if op == 8 { // <
        a.t_cmp_reg(rahi, rbhi)
        a.t_blt(str_clone(&l_true))
        a.t_bgt(str_clone(&l_done))
        a.t_cmp_reg(ralo, rblo)
        a.t_blo(str_clone(&l_true))
    } else if op == 9 { // <=
        a.t_cmp_reg(rahi, rbhi)
        a.t_blt(str_clone(&l_true))
        a.t_bgt(str_clone(&l_done))
        a.t_cmp_reg(ralo, rblo)
        a.t_bls(str_clone(&l_true))
    } else if op == 10 { // >
        a.t_cmp_reg(rahi, rbhi)
        a.t_bgt(str_clone(&l_true))
        a.t_blt(str_clone(&l_done))
        a.t_cmp_reg(ralo, rblo)
        a.t_bhi(str_clone(&l_true))
    } else if op == 11 { // >=
        a.t_cmp_reg(rahi, rbhi)
        a.t_bgt(str_clone(&l_true))
        a.t_blt(str_clone(&l_done))
        a.t_cmp_reg(ralo, rblo)
        a.t_bhs(str_clone(&l_true))
    }

    a.label(l_done)
    a.t_mov_imm32(dest, 0)
    a.t_b(str_clone(&l_fin))

    a.label(l_true)
    a.t_mov_imm32(dest, 1)

    a.label(l_fin)
}

// Full-system memory barrier for the sequentially consistent atomic seam.
fn (a $&Assembler) t_dmb() {
    a.t_emit16(0xF3BF)
    a.t_emit16(0x8F5F)
}
