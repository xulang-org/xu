@main

#xu/types
#os

// Xu MIR -> WebAssembly. No foreign code generator or compiler is involved.
// Values use Xu's 64-bit slots; frame descriptors descend, heap arrays ascend.
// Every internal function has (argument-frame i32, return-frame i32) -> void.
// Per-evaluation arena allocation lets the worker discard an entire execution.
struct WModule{
    data []int
    strings []int
    functions []int
    labels []string
}

struct WFrame{
    locals []int
    temps []int
    size int
    scratch int
}

fn w_u(b $&[]int, v int) {
    $n := v
    while n >= 128 {b.push((n &127) | 128)
        n = n >> 7}
    b.push(n)
}

fn w_s(b $&[]int, v int) {
    $n := v
    $done := false
    while !done{
        x := n &127
        n = n >> 7
        done =(n == 0 &&(x &64) == 0) ||(n == - 1 &&(x &64) != 0)
        if done{b.push(x)} else {b.push(x | 128)}
    }
}

fn w_bytes(b $&[]int, v &[]int) {for i in 0:v.len{b.push(v[i])}}
fn w_name(b $&[]int, v string) {w_u(b, v.len)
    for i in 0:v.len{b.push(v[i])}}
fn w_section(b $&[]int, id int, v &[]int) {b.push(id)
    w_u(b, v.len)
    w_bytes(b, v)}
fn w_i32(b $&[]int, v int) {b.push(65)
    w_s(b, v)}
fn w_i64(b $&[]int, v int) {b.push(66)
    w_s(b, v)}
fn w_get(b $&[]int, i int) {b.push(32)
    w_u(b, i)}
fn w_set(b $&[]int, i int) {b.push(33)
    w_u(b, i)}
fn w_load(b $&[]int, off int) {b.push(41)
    w_u(b, 3)
    w_u(b, off)}
fn w_store(b $&[]int, off int) {b.push(55)
    w_u(b, 3)
    w_u(b, off)}
fn w_addr(b $&[]int, off int) {w_get(b, 2)
    w_i32(b, off)
    b.push(107)}
fn w_value(b $&[]int, m &types.Mir, fi int, fr &WFrame, v int, slot int) {
    if v >= 0 {w_addr(b, fr.temps[v] + slot * 8)
        w_load(b, 0)}
    else if slot == 0 && v <= - 2 {w_i64(b, types.mir_const_at(m, fi, - v - 2))}
    else {w_i64(b, 0)}
}
fn w_dest(b $&[]int, fr &WFrame, v int, slot int) {w_addr(b, fr.temps[v] + slot * 8)}
fn w_slots(m &types.Mir, fi int, v int) int {
    if v < 0 { << 1}
    << types.mir_temp_nslots(m, fi, v)
}
fn w_frame(m &types.Mir, fi int) WFrame{
    $f := WFrame{locals:[]int {}, temps:[]int {}, size: 0, scratch: 0}
    for i in 0:types.mir_nlocals(m, fi) {
        offset := f.size
        f.locals.push(offset)
        f.size += types.mir_local_nslots(m, fi, i) * 8
    }
    for i in 0:types.mir_ntemps(m, fi) {
        offset := f.size
        f.temps.push(offset)
        f.size += types.mir_temp_nslots(m, fi, i) * 8
    }
    f.scratch = f.size
    f.size += WASM_FRAME_SCRATCH_BYTES
    << f
}
fn w_copy(b $&[]int, m &types.Mir, fi int, fr &WFrame, off int, src int, n int) {
    for s in 0:n{w_addr(b, off + s * 8)
        w_value(b, m, fi, fr, src, s)
        w_store(b, 0)}
}
fn w_named(m &types.Mir, fi int, name string) bool {
    if types.mir_fn_name_len(m, fi) != name.len { << false }
    for i in 0:name.len { if types.mir_fn_name_byte(m, fi, i) != name[i] { << false } }
    << true
}
fn w_find(m &types.Mir, label string) int {
    // Optimizer commits append replacements with the same label. Superseded
    // entries keep their metadata, but the sweep clears their bodies/locals.
    for i in 0:m.fns.len{
        if types.mir_fn_is_extern(m, i) { -> }
        if types.mir_fn_label(m, i) == label{ << i}
    }
    if label.len > 4 && label[0:4] == "_xu_" {
        name := label[4:label.len]
        for i in 0:m.fns.len {
            if types.mir_fn_is_extern(m, i) { -> }
            if w_named(m, i, name + "") { << i }
        }
    }
    << -1
}
fn w_index(w &WModule, fi int) int {
    for i in 0:w.functions.len{if w.functions[i] == fi{ << i}}
    eprintln("wasm: missing function " + str(fi))
    <<< 1
}
fn w_fail(m &types.Mir, fi int, ii int, message string) {
    eprintln("wasm: " + types.mir_fn_label(m, fi) + ":" + str(types.mir_iline(m, fi, ii)) + ": " + message)
    <<< 1
}
fn w_call(b $&[]int, w &WModule, m &types.Mir, fi int, fr &WFrame, dest int, callee int, args &[]int, pointer_args bool) {
    $off := fr.scratch
    for j in 0:args.len{
        n := types.mir_local_nslots(m, callee, j)
        $indirect := pointer_args && types.mir_type_abi_class(types.mir_local_ty(m, callee, j)) == types.TY_ABI_POINTER
        if j == 0 && types.mir_fn_receiver(m, callee) { indirect = false }
        if indirect {
            for slot in 0:n {
                w_addr(b, off + slot * 8)
                w_value(b, m, fi, fr, args[j], 0)
                b.push(167)
                w_i32(b, slot * 8)
                b.push(107)
                w_load(b, 0)
                w_store(b, 0)
            }
        } else { w_copy(b, m, fi, fr, off, args[j], n) }
        off += n * 8
    }
    w_addr(b, fr.scratch)
    if dest >= 0 {w_dest(b, fr, dest, 0)} else {w_addr(b, fr.scratch + WASM_SCRATCH_RESULT_OFFSET)}
    b.push(16)
    w_u(b, w_index(w, callee))
}
fn w_helper(b $&[]int, w &WModule, m &types.Mir, fi int, fr &WFrame, dest int, name string, args &[]int) {
    f := w_find(m, "_xu_" + name)
    if f < 0 {eprintln("wasm: missing Xu helper " + name)
        <<< 1}
    w_call(b, w, m, fi, fr, dest, f, args, false)
}
// Append an immediate scalar to a helper argument frame.
fn w_arg_int(b $&[]int, fr &WFrame, slot int, n int) {
    w_addr(b, fr.scratch + slot * 8)
    w_i64(b, n)
    w_store(b, 0)
}
fn w_helper_raw(b $&[]int, w &WModule, m &types.Mir, fr &WFrame, dest int, name string) {
    f := w_find(m, "_xu_" + name)
    if f < 0 {eprintln("wasm: missing Xu helper " + name)
        <<< 1}
    w_addr(b, fr.scratch)
    if dest >= 0 {w_dest(b, fr, dest, 0)} else {w_addr(b, fr.scratch + WASM_SCRATCH_RESULT_OFFSET)}
    b.push(16)
    w_u(b, w_index(w, f))
}

fn w_builtin(b $&[]int, w &WModule, m &types.Mir, fi int, fr &WFrame, ii int) {
    a := types.mir_ia(m, fi, ii)
    $k := types.mir_ib(m, fi, ii)
    $at := types.mir_ic(m, fi, ii)
    $args :=[]int {}
    while at >= 0 {args.push(types.mir_marg_v(m, fi, at))
        at = types.mir_marg_next(m, fi, at)}
    if k == 1 {
        label := types.mir_isval(m, fi, ii)
        if label == "_rt_div_zero" || label == "_rt_div_overflow" { b.push(0)
            << }
        to := w_find(m, types.mir_isval(m, fi, ii))
        if w_named(m, to, "wasm_mem_load") { k = 43 }
        else if w_named(m, to, "wasm_mem_load8") { k = 44 }
        else if w_named(m, to, "wasm_mem_store") { k = 41 }
        else if w_named(m, to, "wasm_mem_store8") { k = 42 }
        else { w_call(b, w, m, fi, fr, a, to, &args, true)
            << }
    }
    if k == 41 || k == 42 {
        w_value(b, m, fi, fr, args[0], 0)
        b.push(167)
        w_value(b, m, fi, fr, args[1], 0)
        if k == 41 {w_store(b, 0)} else {b.push(167)
            b.push(58)
            w_u(b, 0)
            w_u(b, 0)}
        <<
    }
    if k == 43 || k == 44 {
        w_dest(b, fr, a, 0)
        w_value(b, m, fi, fr, args[0], 0)
        b.push(167)
        if k == 43 {w_load(b, 0)} else {b.push(45)
            w_u(b, 0)
            w_u(b, 0)
            b.push(173)}
        w_store(b, 0)
        <<
    }
    if k == 160 || k == 161 {
        w_copy(b, m, fi, fr, fr.scratch, args[0], 1)
        if k == 160 {
            w_addr(b, fr.scratch)
            w_value(b, m, fi, fr, args[0], 0)
            w_i64(b, 8)
            b.push(126)
            w_store(b, 0)
        }
        w_helper_raw(b, w, m, fr, a, "wasm_rt_alloc")
        w_dest(b, fr, a, 1)
        w_value(b, m, fi, fr, args[0], 0)
        w_store(b, 0)
        w_dest(b, fr, a, 2)
        w_value(b, m, fi, fr, args[0], 0)
        w_store(b, 0)
        <<
    }
    if k == 15 {b.push(0)
        << }
    if k == 28 || k == 99 || k == 100 {
        w_dest(b, fr, a, 0)
        w_i64(b, 0)
        w_store(b, 0)
        <<
    }
    $helper := ""
    if k == 6 {helper = "wasm_rt_str"}
    if k == 10 {helper = "wasm_rt_byte"}
    if k == 11 {helper = "wasm_rt_from_bytes"}
    if k == 20 {helper = "wasm_rt_slice"}
    if k == 21 {helper = "wasm_rt_bool"}
    if k == 160 {helper = "wasm_rt_ints"}
    if k == 161 {helper = "wasm_rt_string"}
    if k == 81 {helper = "wasm_rt_bytes"}
    if k == 24 {helper = "wasm_rt_assert"}
    if k == 5 {helper = "wasm_rt_push_str"}
    if k == 122 {helper = "wasm_rt_push_byte"}
    if k >= 16 && k <= 19 {helper = "wasm_rt_class_" + str(k)}
    if helper.len > 0 {w_helper(b, w, m, fi, fr, a, helper, &args)
        << }
    if k == 2 || k == 3 || k == 4 || k == 7 || k == 8 || k == 9 || k == 22 || k == 23 {
        helper = "wasm_rt_print_int"
        if k == 3 || k == 8 {helper = "wasm_rt_print_bool"}
        if k == 4 || k == 9 || k == 23 {helper = "wasm_rt_print_str"}
        n := w_slots(m, fi, args[0])
        w_copy(b, m, fi, fr, fr.scratch, args[0], n)
        $err := 0
        if k == 7 || k == 8 || k == 9 {err = 1}
        w_arg_int(b, fr, n, err)
        $nl := 1
        if k == 22 || k == 23 {nl = 0}
        w_arg_int(b, fr, n + 1, nl)
        w_helper_raw(b, w, m, fr, - 1, helper)
        <<
    }
    w_fail(m, fi, ii, "unsupported builtin " + str(k))
}

fn w_binary(b $&[]int, op int) {
    $code := 0
    if op == 1 {code = 124}
    if op == 2 {code = 125}
    if op == 3 {code = 126}
    if op == 4 {code = 127}
    if op == 5 {code = 129}
    if op == 6 {code = 81}
    if op == 7 {code = 82}
    if op == 8 {code = 83}
    if op == 9 {code = 87}
    if op == 10 {code = 85}
    if op == 11 {code = 89}
    if op == 12 || op == 14 {code = 131}
    if op == 13 || op == 15 {code = 132}
    if op == 16 {code = 133}
    if op == 17 {code = 134}
    if op == 18 {code = 135}
    if code == 0 {eprintln("wasm: unsupported binary op " + str(op))
        <<< 1}
    b.push(code)
    if op >= 6 && op <= 11 {b.push(173)}
}

// MIR comparisons are eq/ne/lt/le/gt/ge; Wasm orders gt before le.
// Inputs are f64 on the Wasm stack, but every result uses an i64 slot.
fn w_binary_f64(b $&[]int, op int) {
    $code := 0
    if op >= 1 && op <= 4 {code = 159 + op} // f64.add/sub/mul/div
    if op == 6 {code = 97} // f64.eq
    if op == 7 {code = 98} // f64.ne
    if op == 8 {code = 99} // f64.lt
    if op == 9 {code = 101} // f64.le
    if op == 10 {code = 100} // f64.gt
    if op == 11 {code = 102} // f64.ge
    if code == 0 {eprintln("wasm: unsupported f64 binary op " + str(op))
        <<< 1}
    b.push(code)
    if op >= 6 && op <= 11 {b.push(173)} // i64.extend_i32_u
    else {b.push(189)} // i64.reinterpret_f64 (0xBD)
}

fn w_instr(b $&[]int, w &WModule, m &types.Mir, fi int, fr &WFrame, ii int) {
    k := types.mir_ikind(m, fi, ii)
    a := types.mir_ia(m, fi, ii)
    v := types.mir_ib(m, fi, ii)
    c := types.mir_ic(m, fi, ii)
    d := types.mir_id(m, fi, ii)
    if k == types.MI_NOP || k == types.MI_DROP || k == types.MI_DROP_FIELD || k == types.MI_DROP_PTR_FIELD || k == types.MI_DROP_BUF_FIELD { << }
    if k == types.MI_COPY || k == types.MI_STR_CLONE {w_copy(b, m, fi, fr, fr.temps[a], v, types.mir_temp_nslots(m, fi, a))
        << }
    if k == types.MI_LOAD_LOCAL {
        for s in 0:types.mir_temp_nslots(m, fi, a) {
            w_dest(b, fr, a, s)
            w_addr(b, fr.locals[v] + s * 8)
            w_load(b, 0)
            w_store(b, 0)
        }
        <<
    }
    if k == types.MI_STORE_LOCAL {w_copy(b, m, fi, fr, fr.locals[a], v, types.mir_local_nslots(m, fi, a))
        << }
    if k == types.MI_BIN {
        if (a >= 0 && types.mir_temp_ty(m, fi, a) == 4) || (c >= 0 && types.mir_temp_ty(m, fi, c) == 4) || (d >= 0 && types.mir_temp_ty(m, fi, d) == 4) {
            w_dest(b, fr, a, 0)
            w_value(b, m, fi, fr, c, 0)
            b.push(191) // f64.reinterpret_i64 (0xBF)
            w_value(b, m, fi, fr, d, 0)
            b.push(191)
            w_binary_f64(b, v)
            w_store(b, 0)
            <<
        }
        if c >= 0 && types.mir_temp_ty(m, fi, c) == 3 {
            cd := [c, d]
            if v == 1 {
                w_helper(b, w, m, fi, fr, a, "wasm_rt_concat", &cd)
                <<
            }
            if v == 6 || v == 7 {
                w_helper(b, w, m, fi, fr, a, "wasm_rt_eq", &cd)
                if v == 7 {
                    w_dest(b, fr, a, 0)
                    w_value(b, m, fi, fr, a, 0)
                    b.push(80)
                    b.push(173)
                    w_store(b, 0)
                }
                <<
            }
        }
        w_dest(b, fr, a, 0)
        w_value(b, m, fi, fr, c, 0)
        w_value(b, m, fi, fr, d, 0)
        w_binary(b, v)
        w_store(b, 0)
        <<
    }
    if k == types.MI_UN {
        if v < 1 || v > 5 { w_fail(m, fi, ii, "unsupported unary operation") }
        w_dest(b, fr, a, 0)
        if v == 3 {w_value(b, m, fi, fr, c, 0)
            b.push(185) // f64.convert_i64_s (0xB9)
            b.push(189)} // i64.reinterpret_f64
        else if v == 4 {w_value(b, m, fi, fr, c, 0)
            b.push(191) // f64.reinterpret_i64
            b.push(252)
            b.push(6)} // i64.trunc_sat_f64_s (0xFC 0x06): NaN -> 0, clamp overflow
        else if v == 1 && types.mir_temp_ty(m, fi, a) == 4 {
            w_value(b, m, fi, fr, c, 0)
            b.push(191)
            b.push(154) // f64.neg (0x9A), including signed zero
            b.push(189)}
        else if v == 1 {w_i64(b, 0)
            w_value(b, m, fi, fr, c, 0)
            b.push(125)}
        else if v == 2 {w_value(b, m, fi, fr, c, 0)
            b.push(80)
            b.push(173)}
        else {
            w_value(b, m, fi, fr, c, 0)
            ty := types.mir_temp_ty(m, fi, a)
            if ty == 8 || ty == 9 {
                b.push(167) // i32.wrap_i64
                if ty == 8 { b.push(172) } else { b.push(173) }
            } else if ty == 10 {
                w_i64(b, 255)
                b.push(131) // i64.and
            } else if ty != 1 {
                w_fail(m, fi, ii, "unsupported integer cast")
            }
        }
        w_store(b, 0)
        <<
    }
    if k == types.MI_STR_CONST {
        w_dest(b, fr, a, 0)
        w_i64(b, w.strings[v])
        w_store(b, 0)
        w_dest(b, fr, a, 1)
        w_i64(b, m.strings[v].len)
        w_store(b, 0)
        w_dest(b, fr, a, 2)
        w_i64(b, 0)
        w_store(b, 0)
        <<
    }
    if k == types.MI_CALL {w_builtin(b, w, m, fi, fr, ii)
        << }
    if k == types.MI_LOAD_FIELD || k == types.MI_STORE_FIELD {
        for s in 0:d{
            if k == types.MI_LOAD_FIELD {
                w_dest(b, fr, a, s)
                w_addr(b, fr.temps[v] + c + s * 8)
                w_load(b, 0)
                w_store(b, 0)
            } else {
                w_addr(b, fr.temps[v] + c + s * 8)
                w_value(b, m, fi, fr, a, s)
                w_store(b, 0)
            }
        }
        <<
    }
    if k == types.MI_ADDR {
        w_dest(b, fr, a, 0)
        if c == 0 {w_addr(b, fr.locals[v])} else {w_addr(b, fr.temps[v])}
        b.push(173)
        w_store(b, 0)
        <<
    }
    if k == types.MI_LOAD_PTR || k == types.MI_STORE_PTR || k == types.MI_STORE_BUF_PTR || k == types.MI_LOAD_BUF_PTR {
        for s in 0:d{
            $off := c + s * 8
            if k == types.MI_LOAD_PTR || k == types.MI_STORE_PTR {off = - off}
            if k == types.MI_LOAD_PTR || k == types.MI_LOAD_BUF_PTR {w_dest(b, fr, a, s)}
            w_value(b, m, fi, fr, v, 0)
            b.push(167)
            w_i32(b, off)
            b.push(106)
            if k == types.MI_LOAD_PTR || k == types.MI_LOAD_BUF_PTR {w_load(b, 0)
                w_store(b, 0)}
            else {w_value(b, m, fi, fr, a, s)
                w_store(b, 0)}
        }
        <<
    }
    if k == types.MI_ARRAY_LIT {
        // Array literal: argument chain elements copied into ascending heap.
        w_arg_int(b, fr, 0, v * d)
        w_helper_raw(b, w, m, fr, a, "wasm_rt_alloc")
        w_dest(b, fr, a, 1)
        w_i64(b, v)
        w_store(b, 0)
        w_dest(b, fr, a, 2)
        w_i64(b, v)
        w_store(b, 0)
        $arg := c
        for j in 0:v{
            elem := types.mir_marg_v(m, fi, arg)
            for s in 0:d / 8 {
                w_value(b, m, fi, fr, a, 0)
                b.push(167)
                w_value(b, m, fi, fr, elem, s)
                w_store(b, j * d + s * 8)
            }
            arg = types.mir_marg_next(m, fi, arg)
        }
        <<
    }
    if k == types.MI_ARR_PUSH {
        w_addr(b, fr.scratch)
        if c == 1 {w_value(b, m, fi, fr, a, 0)
            b.push(167)} else if a >= types.MIR_LOCAL_OPERAND_BASE {w_addr(b, fr.locals[a - types.MIR_LOCAL_OPERAND_BASE])} else {w_addr(b, fr.temps[a])}
        b.push(173)
        w_store(b, 0)
        w_addr(b, fr.scratch + 8)
        w_dest(b, fr, v, 0)
        b.push(173)
        w_store(b, 0)
        w_arg_int(b, fr, 2, d)
        w_helper_raw(b, w, m, fr, - 1, "wasm_rt_push")
        <<
    }
    if k == types.MI_FIELD_RMW {
        w_value(b, m, fi, fr, a, 0)
        b.push(167)
        offset := types.mir_iline(m, fi, ii)
        w_i32(b, offset)
        if v == 0 { b.push(107) } else { b.push(106) }
        w_set(b, 4)
        w_get(b, 4)
        w_get(b, 4)
        w_load(b, 0)
        // FieldRMW.d is the field type tag; slots retain raw f64 bits.
        if d == 4 { b.push(191) } // f64.reinterpret_i64
        w_value(b, m, fi, fr, c, 0)
        if d == 4 { b.push(191)
            w_binary_f64(b, types.mir_icol(m, fi, ii)) }
        else { w_binary(b, types.mir_icol(m, fi, ii)) }
        w_store(b, 0)
        <<
    }
    if k == types.MI_LOAD_INDEX || k == types.MI_STORE_INDEX || k == types.MI_ELEM_ADDR || k == types.MI_INDEX_RMW {
        $base := v
        $idx := c
        if k == types.MI_STORE_INDEX || k == types.MI_INDEX_RMW {base = a
            idx = v}
        $off := 0
        $ty := 0
        if base >= types.MIR_LOCAL_OPERAND_BASE {off = fr.locals[base - types.MIR_LOCAL_OPERAND_BASE]
            ty = types.mir_local_ty(m, fi, base - types.MIR_LOCAL_OPERAND_BASE)}
        else {off = fr.temps[base]
            ty = types.mir_temp_ty(m, fi, base)}
        $width := d
        if width < 0 {width = - width}
        if ty == 3 {width = 1}
        // Bounds checks remain active even when the native MIR proved them.
        w_value(b, m, fi, fr, idx, 0)
        w_i64(b, 0)
        b.push(83)
        w_value(b, m, fi, fr, idx, 0)
        w_addr(b, off + 8)
        w_load(b, 0)
        b.push(89)
        b.push(114)
        b.push(4)
        b.push(64)
        b.push(0)
        b.push(11)
        w_addr(b, off)
        w_load(b, 0)
        w_value(b, m, fi, fr, idx, 0)
        w_i64(b, width)
        b.push(126)
        b.push(124)
        b.push(167)
        w_set(b, 4)
        if k == types.MI_ELEM_ADDR {w_dest(b, fr, a, 0)
            w_get(b, 4)
            b.push(173)
            w_store(b, 0)
            << }
        if k == types.MI_INDEX_RMW {
            w_get(b, 4)
            w_get(b, 4)
            w_load(b, 0)
            // IndexRMW.d encodes width/nocheck, not the element type.
            // Folding can replace a typed RHS with an untyped constant, so
            // select arithmetic from the array descriptor's element type.
            arr_ty := types.strip_direct_ref(&m.ref_targets, ty)
            fp := types.is_array_type(arr_ty) && m.arrays[types.array_index(arr_ty)].elem_ty == 4
            if fp { b.push(191) } // f64.reinterpret_i64
            w_value(b, m, fi, fr, c, 0)
            if fp { b.push(191)
                w_binary_f64(b, types.mir_icol(m, fi, ii)) }
            else { w_binary(b, types.mir_icol(m, fi, ii)) }
            w_store(b, 0)
            <<
        }
        // i64 loads/stores copy f64 bit patterns without numeric conversion.
        $n := width / 8
        if width == 1 {n = 1}
        for s in 0:n{
            if k == types.MI_LOAD_INDEX {w_dest(b, fr, a, s)
                w_get(b, 4)}
            else {w_get(b, 4)
                w_value(b, m, fi, fr, c, s)}
            if k == types.MI_LOAD_INDEX {
                if width == 1 {b.push(45)
                    w_u(b, 0)
                    w_u(b, 0)
                    b.push(173)} else {w_load(b, s * 8)}
                w_store(b, 0)
            } else if width == 1 {b.push(167)
                b.push(58)
                w_u(b, 0)
                w_u(b, 0)}
            else {w_store(b, s * 8)}
        }
        <<
    }
    if k == types.MI_RESULT_TEST {
        w_dest(b, fr, a, 0)
        w_value(b, m, fi, fr, v, 0)
        w_i64(b, c)
        b.push(81)
        b.push(173)
        w_store(b, 0)
        <<
    }
    if k == types.MI_THROW_UNWRAP || k == types.MI_THROW_UNWRAP_ERR {
        w_value(b, m, fi, fr, v, 0)
        w_i64(b, 0)
        b.push(82)
        b.push(4)
        b.push(64)
        b.push(0)
        b.push(11)
        for s in 0:d{w_dest(b, fr, a, s)
            w_value(b, m, fi, fr, v, s + 1)
            w_store(b, 0)}
        <<
    }
    w_fail(m, fi, ii, "unsupported MIR instruction " + str(k))
}

fn w_body(w &WModule, m &types.Mir, fi int)[]int {
    fr := w_frame(m, fi)
    $b :=[]int {}
    w_u($&b, 1)
    w_u($&b, 3)
    b.push(127)  // fp, pc, scratch i32
    b.push(35)
    w_u($&b, 0)
    w_set($&b, 2)
    w_get($&b, 2)
    w_i32($&b, fr.size)
    b.push(107)
    b.push(36)
    w_u($&b, 0)
    w_addr($&b, fr.size - 8)
    w_i32($&b, 0)
    w_i32($&b, fr.size)
    b.push(252)
    b.push(11)
    b.push(0)
    $argslot := 0
    for j in 0:types.mir_fn_nparams(m, fi) {
        for s in 0:types.mir_local_nslots(m, fi, j) {
            w_addr($&b, fr.locals[j] + s * 8)
            w_get($&b, 0)
            w_i32($&b, argslot * 8)
            b.push(107)
            w_load($&b, 0)
            w_store($&b, 0)
            argslot += 1
        }
    }
    w_i32($&b, 0)
    w_set($&b, 3)
    b.push(3)
    b.push(64)  // dispatch loop
    for bi in 0:types.mir_nblocks(m, fi) {
        w_get($&b, 3)
        w_i32($&b, bi)
        b.push(70)
        b.push(4)
        b.push(64)
        $ii := types.mir_bhead(m, fi, bi)
        while ii >= 0 {w_instr($&b, w, m, fi, &fr, ii)
            ii = types.mir_inext(m, fi, ii)}
        tk := types.mir_btkind(m, fi, bi)
        if tk == 3 {
            v := types.mir_bta(m, fi, bi)
            for s in 0:types.mir_fn_ret_nslots(m, fi) {
                w_get($&b, 1)
                w_i32($&b, s * 8)
                b.push(107)
                w_value($&b, m, fi, &fr, v, s)
                w_store($&b, 0)
            }
            w_get($&b, 2)
            b.push(36)
            w_u($&b, 0)
            b.push(15)
        } else if tk == 1 || tk == 2 {
            if tk == 1 {w_i32($&b, types.mir_bta(m, fi, bi))}
            else {
                w_i32($&b, types.mir_btb(m, fi, bi))
                w_i32($&b, types.mir_btc(m, fi, bi))
                w_value($&b, m, fi, &fr, types.mir_bta(m, fi, bi), 0)
                b.push(167)
                b.push(27)
            }
            w_set($&b, 3)
            b.push(12)
            w_u($&b, 1)
        } else {b.push(0)}
        b.push(11)
    }
    b.push(0)
    b.push(11)
    b.push(11)
    << b
}

fn wasm_emit(m &types.Mir, c_fns &[]types.CFn, path string) int {
    $w := WModule{data:[]int {}, strings:[]int {}, functions:[]int {}, labels:[]string {}}
    // Public free functions in @main are host entry points; main is exported
    // even without pub. All use the documented frame ABI, not native registers.
    $exports := []int{}
    $export_names := []string{}
    for i in 0:c_fns.len {
        if c_fns[i].mod_id == "main" && c_fns[i].recv < 0 && !c_fns[i].is_extern && !c_fns[i].is_template {
            if c_fns[i].is_pub || c_fns[i].name == "main" {
                fi := w_find(m, c_fns[i].label + "")
                if fi >= 0 {
                    exports.push(fi)
                    export_names.push(c_fns[i].name + "_frame")
                    w.functions.push(fi)
                }
            }
        }
    }
    // Xu-provided runtime helpers implement allocation, strings and output.
    // Applications own the arena; the compiler has no browser or site dependency.
    for i in 0:m.fns.len {
        if types.mir_fn_is_extern(m, i) { -> }
        lab := types.mir_fn_label(m, i)
        if lab.len >= 17 && lab[0:17] == "_xu_main_wasm_rt_" {
            w.functions.push(i)
        }
    }
    if exports.len == 0 { eprintln("wasm: no main or public @main entry point")
        << 1 }
    $pos := 0
    while pos < w.functions.len{
        fi := w.functions[pos]
        for ii in 0:types.mir_nins(m, fi) {
            if types.mir_ikind(m, fi, ii) == types.MI_CALL && types.mir_ib(m, fi, ii) == 1 {
                lab := types.mir_isval(m, fi, ii)
                to := w_find(m, lab + "")
                if to < 0 {
                    if lab == "_rt_div_zero" || lab == "_rt_div_overflow" { -> }
                    w_fail(m, fi, ii, "unknown callee " + lab)
                }
                $found := false
                for j in 0:w.functions.len{if w.functions[j] == to{found = true}}
                if !found{w.functions.push(to)}
            }
        }
        pos += 1
    }
    $missing := []int{}
    for j in 0:w.functions.len {
        fi := w.functions[j]
        for ii in 0:types.mir_nins(m, fi) {
            kind := types.mir_ikind(m, fi, ii)
            $tag := 0
            if kind == types.MI_CALL {
                bk := types.mir_ib(m, fi, ii)
                if !(bk >= 1 && bk <= 11 || bk >= 15 && bk <= 21 || bk == 24 || bk == 28 || bk >= 41 && bk <= 44 || bk == 81 || bk == 99 || bk == 100 || bk == 122 || bk == 160 || bk == 161) { tag = 1000 + bk }
            } else if !(kind >= 0 && kind <= 26 || kind == types.MI_INDEX_RMW || kind == types.MI_FIELD_RMW) { tag = kind }
            if tag > 0 {
                $seen := false
                for n in 0:missing.len { if missing[n] == tag { seen = true } }
                if !seen { missing.push(tag)
                    eprintln("wasm requirement " + str(tag) + " in " + types.mir_fn_label(m, fi)) }
            }
        }
    }
    if missing.len > 0 { << 1 }
    for i in 0:m.strings.len{
        address := WASM_DATA_BASE + w.data.len
        w.strings.push(address)
        for j in 0:m.strings[i].len{w.data.push(m.strings[i][j])}
    }
    if w.data.len > WASM_CONSTANT_POOL_MAX_BYTES {eprintln("wasm: constant pool exceeds " + str(WASM_CONSTANT_POOL_MAX_BYTES / 1048576) + " MiB")
        << 1}
    $out :=[0, 97, 115, 109, 1, 0, 0, 0]
    $section :=[1, 96, 2, 127, 127, 0]
    w_section($&out, 1, &section)
    section =[]int {}
    w_u($&section, w.functions.len)
    for _ in 0:w.functions.len{w_u($&section, 0)}
    w_section($&out, 3, &section)
    section =[1, 1] // one memory, explicit maximum; limits use unsigned LEB128
    w_u($&section, WASM_MEMORY_PAGES)
    w_u($&section, WASM_MEMORY_PAGES)
    w_section($&out, 5, &section)
    section =[1, 127, 1, 65]
    w_s($&section, WASM_INITIAL_STACK_POINTER)
    section.push(11)
    w_section($&out, 6, &section)
    section =[]int {}
    w_u($&section, 1 + exports.len)
    w_name($&section, "memory")
    section.push(2)
    w_u($&section, 0)
    for i in 0:exports.len {
        w_name($&section, export_names[i] + "")
        section.push(0)
        w_u($&section, w_index(&w, exports[i]))
    }
    w_section($&out, 7, &section)
    section =[]int {}
    w_u($&section, w.functions.len)
    for j in 0:w.functions.len{
        body := w_body(&w, m, w.functions[j])
        w_u($&section, body.len)
        w_bytes($&section, &body)
    }
    w_section($&out, 10, &section)
    section =[1, 0, 65]
    w_s($&section, WASM_DATA_BASE)
    section.push(11)
    w_u($&section, w.data.len)
    w_bytes($&section, &w.data)
    w_section($&out, 11, &section)
    // Provenance is embedded in the binary rather than inferred from its name.
    section =[]int {}
    w_name($&section, "xu.source")
    w_name($&section, "Xu compiler wasm32 backend; Xu MIR; frame ABI v1; no foreign code generator")
    w_section($&out, 0, &section)
    section = []int{}
    w_name($&section, "name")
    $names := []int{}
    w_u($&names, w.functions.len)
    for j in 0:w.functions.len {
        w_u($&names, j)
        w_name($&names, types.mir_fn_label(m, w.functions[j]))
    }
    section.push(1)
    w_u($&section, names.len)
    w_bytes($&section, &names)
    w_section($&out, 0, &section)
    bytes := string_from_bytes(out)
    os.write(path + "", bytes + "") or(err) {eprintln("wasm: cannot write " + path)
        << 1}
    println("Xu -> WASM: " + str(w.functions.len) + " functions, " + str(bytes.len) + " bytes")
    << 0
}
