@main
// Target-independent operation forwarders. Backend selection lives in the
// Assembler be_* methods; operations that collide with raw encoders use the
// vm_ prefix. Target OS/architecture are carried by Assembler.

// ===== Data movement =====

fn (a &mut Assembler) mov(dest int, src int) { a.be_mov(dest, src) }

// vm_ prefix: Assembler already has a physical-register mov_imm.
fn (a &mut Assembler) vm_mov_imm(dest int, imm int) { a.be_mov_imm(dest, imm) }

fn (a &mut Assembler) vm_mov_imm64(dest int, imm int) { a.be_mov_imm64(dest, imm) }

fn (a &mut Assembler) lea(dest int, label string) { a.be_lea(dest, label) }

// ARM64 string-literal LEA via intern index (fixup kind 5).
fn (a &mut Assembler) lea_str(dest int, ib int) {
    if a.arch == 0 {
        pr := map_reg(dest)
        a.lea_xus(pr, ib)
        <<
    }
    a.be_lea(dest, "_xus_" + str(ib))
}

fn (a &mut Assembler) load(dest int, base int, offset int) { a.be_load(dest, base, offset) }

fn (a &mut Assembler) store(base int, offset int, src int) { a.be_store(base, offset, src) }

fn (a &mut Assembler) load_scaled(dest int, base int, index int, elem_sz int) {
    a.be_load_scaled(dest, base, index, elem_sz)
}

fn (a &mut Assembler) store_scaled(base int, index int, src int, elem_sz int) {
    a.be_store_scaled(base, index, src, elem_sz)
}

fn (a &mut Assembler) add_lsl_vr(dest int, base int, index int, sh int) {
    a.be_add_lsl(dest, base, index, sh)
}

fn (a &mut Assembler) sub_lsl_vr(dest int, base int, index int, sh int) {
    a.be_sub_lsl(dest, base, index, sh)
}

fn (a &mut Assembler) store_byte(base int, offset int, src int) { a.be_store_byte(base, offset, src) }

fn (a &mut Assembler) load_byte(dest int, base int, offset int) { a.be_load_byte(dest, base, offset) }

