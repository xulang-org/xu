fn (a &mut Assembler) vm_neon_addp_d(dd int, vn int) { a.be_neon_addp_d(dd, vn) }
fn (a &mut Assembler) vm_neon_ldp_q_post32(qt1 int, qt2 int, base int) { a.be_neon_ldp_q_post32(qt1, qt2, base) }
fn (a &mut Assembler) vm_neon_stp_q_post32(qt1 int, qt2 int, base int) { a.be_neon_stp_q_post32(qt1, qt2, base) }

fn (a &mut Assembler) vm_call_iat7(label string) { a.be_call_iat7(label) }

fn (a &mut Assembler) vm_normalize_syscall(ok_label string) { a.be_normalize_syscall(ok_label) }

fn (a &mut Assembler) vm_exit() { a.be_exit() }
