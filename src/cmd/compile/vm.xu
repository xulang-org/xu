fn (a &mut Assembler) add(dest int, x int, y int) { a.be_add(dest, x, y) }

fn (a &mut Assembler) vm_add_imm(dest int, src int, imm int) { a.be_add_imm(dest, src, imm) }

fn (a &mut Assembler) sub(dest int, x int, y int) { a.be_sub(dest, x, y) }

fn (a &mut Assembler) vm_sub_imm(dest int, src int, imm int) { a.be_sub_imm(dest, src, imm) }

fn (a &mut Assembler) mul(dest int, x int, y int) { a.be_mul(dest, x, y) }

fn (a &mut Assembler) madd(dest int, x int, y int, addend int) { a.be_madd(dest, x, y, addend) }

fn (a &mut Assembler) div(dest int, x int, y int) { a.be_div(dest, x, y) }

fn (a &mut Assembler) imod(dest int, x int, y int) { a.be_mod(dest, x, y) }

fn (a &mut Assembler) neg(dest int, src int) { a.be_neg(dest, src) }

fn (a &mut Assembler) shl_imm(dest int, src int, imm int) { a.be_shl_imm(dest, src, imm) }

fn (a &mut Assembler) shr_imm(dest int, src int, imm int) { a.be_shr_imm(dest, src, imm) }

fn (a &mut Assembler) vm_ror_imm32(dest int, src int, imm int) { a.be_ror_imm32(dest, src, imm) }

fn (a &mut Assembler) vm_eor_ror32(dest int, acc int, src int, imm int) { a.be_eor_ror32(dest, acc, src, imm) }

fn (a &mut Assembler) vm_eor_lsr32(dest int, acc int, src int, imm int) { a.be_eor_lsr32(dest, acc, src, imm) }

fn (a &mut Assembler) vm_bic32(dest int, y int, x int) { a.be_bic32(dest, y, x) }

fn (a &mut Assembler) vm_mvn32(dest int, src int) { a.be_mvn32(dest, src) }

fn (a &mut Assembler) vm_add32(dest int, x int, y int) { a.be_add32(dest, x, y) }

fn (a &mut Assembler) iand(dest int, x int, y int) { a.be_and(dest, x, y) }

fn (a &mut Assembler) vm_and_imm(dest int, src int, imm int) { a.be_and_imm(dest, src, imm) }

