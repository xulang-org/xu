fn (a &mut Assembler) jgt(label string) { a.be_jgt(label) }
fn (a &mut Assembler) jge(label string) { a.be_jge(label) }
fn (a &mut Assembler) jae(label string) { a.be_jae(label) }

fn (a &mut Assembler) vm_cbz(reg int, label string) { a.be_cbz(reg, label) }
fn (a &mut Assembler) vm_cbnz(reg int, label string) { a.be_cbnz(reg, label) }

// ===== Function calls =====

fn (a &mut Assembler) prologue(frame_size int) { a.be_prologue(frame_size) }

fn (a &mut Assembler) epilogue() { a.be_epilogue() }

fn (a &mut Assembler) prologue_leaf(frame_size int) { a.be_prologue_leaf(frame_size) }

fn (a &mut Assembler) epilogue_leaf() { a.be_epilogue_leaf() }

fn (a &mut Assembler) call(label string) { a.be_call(label) }

fn (a &mut Assembler) call_ref(label &string) { a.be_call_ref(label) }

fn (a &mut Assembler) call_reg(target int) { a.be_call_reg(target) }

fn (a &mut Assembler) vm_ret() { a.be_ret() }

// nop / label: raw Assembler methods (label is arch-neutral).

// ===== Platform-specific =====

// Raw syscall with the given number (args already in A0..A5). vm_ prefix:
// Assembler has the no-arg macOS `syscall` trap.
fn (a &mut Assembler) vm_syscall(num int) { a.be_syscall(num) }

fn (a &mut Assembler) vm_call_iat(label string) { a.be_call_iat(label) }

// Call a resolved Win64/AAPCS function pointer in vreg (V0/V1).
fn (a &mut Assembler) vm_call_win_fp(vreg int) {
    if a.os == 2 && a.arch == 1 {
        a.xbe_call_reg_win(vreg)
    } else {
        a.call_reg(vreg)
    }
}

fn (a &mut Assembler) vm_call_win_fp6(vreg int) {
    if a.os == 2 && a.arch == 1 {
        a.xbe_call_reg_win6(vreg)
    } else {
        a.call_reg(vreg)
    }
}

fn (a &mut Assembler) vm_call_win_fp7(vreg int) {
    if a.os == 2 && a.arch == 1 {
        a.xbe_call_reg_win7(vreg)
    } else if a.os == 2 && a.arch == 0 {
        // Windows ARM64 follows AAPCS: the seventh integer argument is X6.
        // WSARecv/WSASend use it for the optional completion routine.
        a.vm_mov_imm(6, 0)
        a.call_reg(vreg)
    } else {
        // Non-Win64 targets have no seventh register argument in this ABI;
        // callers use this only from the Windows IOCP path.
        a.call_reg(vreg)
    }
}

fn (a &mut Assembler) vm_call_win_fp7_arg(vreg int, arg7 int) {
    if a.os == 2 && a.arch == 1 {
        a.xbe_call_reg_win7_arg(vreg, arg7)
    } else if a.os == 2 && a.arch == 0 {
        // AAPCS64 places the seventh integer argument in physical X6. The
        // ORR alias is used here because virtual register 6 is not X6.
        phys := map_reg(arg7)
        // ORR X6, XZR, Xn (MOV X6, Xn). Keep the seventh argument in the
        // AAPCS64 register slot without clobbering the caller's virtual regs.
        a.emit32(2852127712 | (phys << 16) | 6)
        a.call_reg(vreg)
    } else {
        a.call_reg(vreg)
    }
}

fn (a &mut Assembler) vm_atomic_xchg(dest int, addr int, val int) { a.be_atomic_xchg(dest, addr, val) }

fn (a &mut Assembler) vm_atomic_load(dest int, addr int) { a.be_atomic_load(dest, addr) }

fn (a &mut Assembler) vm_atomic_store(addr int, val int) { a.be_atomic_store(addr, val) }

fn (a &mut Assembler) vm_atomic_add(dest int, addr int, val int) { a.be_atomic_add(dest, addr, val) }

fn (a &mut Assembler) vm_atomic_cas(dest int, addr int, old int, new int) { a.be_atomic_cas(dest, addr, old, new) }

fn (a &mut Assembler) vm_neon_dup_2d(vd int, xn int) { a.be_neon_dup_2d(vd, xn) }
fn (a &mut Assembler) vm_neon_ins_d(vd int, lane int, xn int) { a.be_neon_ins_d(vd, lane, xn) }
fn (a &mut Assembler) vm_neon_add_2d(vd int, vn int, vm int) { a.be_neon_add_2d(vd, vn, vm) }
