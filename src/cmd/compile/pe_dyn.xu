@main
// PE IMAGE_FILE_DLL (--shared) and extra user-DLL imports.
// Static PE generate() in pe.xu stays unchanged when dll_id/ext_dlls are empty.

fn pe_import_sym(iat string, xu_us int) string {
    if iat.len <= 5 {
        << iat
    }
    rest := iat[5:iat.len]
    if xu_us == 1 && starts_with(rest, "xu_") {
        << "_" + rest
    }
    << rest
}

fn pe_collect_iat_labs(a &Assembler, names $&[]string, offsets $&[]int) {
    for i in 0:a.labels.len {
        if !a.labels[i].is_data { -> }
        n := a.labels[i].name + ""
        if n.len <= 5 { -> }
        if n[0] != 95 || n[1] != 105 || n[2] != 97 || n[3] != 116 || n[4] != 95 {
            ->
        }
        names.push(n)
        offsets.push(a.labels[i].offset)
    }
    $i := 0
    while i < offsets.len {
        $j := i + 1
        while j < offsets.len {
            if offsets[j] < offsets[i] {
                tmp_o := offsets[i]
                offsets[i] = offsets[j]
                offsets[j] = tmp_o
                tmp_n := names[i] + ""
                names[i] = names[j] + ""
                names[j] = tmp_n
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn pe_dllmain_stub(machine int, code $&[]int) {
    if machine == COFF_MACHINE_AMD64 {
        code.push(184)
        code.push(1)
        code.push(0)
        code.push(0)
        code.push(0)
        code.push(195)
        <<
    }
    // mov w0,#1 ; ret  (0x52800020, 0xD65F03C0)
    w0 := 1384128544
    w1 := 3596551104
    code.push(w0 & 255)
    code.push((w0 >> 8) & 255)
    code.push((w0 >> 16) & 255)
    code.push((w0 >> 24) & 255)
    code.push(w1 & 255)
    code.push((w1 >> 8) & 255)
    code.push((w1 >> 16) & 255)
    code.push((w1 >> 24) & 255)
}

fn pe_str_gt(a string, b string) bool {
    $n := a.len
    if b.len < n {
        n = b.len
    }
    for i in 0:n {
        if a[i] != b[i] {
            << a[i] > b[i]
        }
    }
    << a.len > b.len
}

fn pe_export_blob(install string, names &[]string, offs &[]int, text_rva int, export_rva int) []int {
    n := names.len
    $order := []int{}
    for i in 0:n {
        order.push(i)
    }
    $a := 1
    while a < n {
        $b := a
        while b > 0 {
            if !pe_str_gt(names[order[b - 1]] + "", names[order[b]] + "") {
                <-
            }
            t := order[b]
            order[b] = order[b - 1]
            order[b - 1] = t
            b = b - 1
        }
        a = a + 1
    }
    dir_sz := 40
    eat_off := dir_sz
    ent_off := eat_off + n * 4
    eot_off := ent_off + n * 4
    $str_off := eot_off + n * 2
    if str_off % 2 != 0 {
        str_off = str_off + 1
    }
    $strs := []int{}
    $name_rvas := []int{}
    for k in 0:n {
        i := order[k]
        name_rvas.push(export_rva + str_off + strs.len)
        nm := names[i] + ""
        for ci in 0:nm.len {
            strs.push(nm[ci])
        }
        strs.push(0)
    }
    dll_name_rva := export_rva + str_off + strs.len
    for ci in 0:install.len {
        strs.push(install[ci])
    }
    strs.push(0)
    $b := []int{}
    write32($&b, 0)
    write32($&b, 0)
    write16($&b, 0)
    write16($&b, 0)
    write32($&b, dll_name_rva)
    write32($&b, 1)
    write32($&b, n)
    write32($&b, n)
    write32($&b, export_rva + eat_off)
    write32($&b, export_rva + ent_off)
    write32($&b, export_rva + eot_off)
    for k in 0:n {
        i := order[k]
        write32($&b, text_rva + offs[i])
    }
    for k in 0:n {
        write32($&b, name_rvas[k])
    }
    for k in 0:n {
        write16($&b, k)
    }
    while b.len < str_off {
        b.push(0)
    }
    for i in 0:strs.len {
        b.push(strs[i])
    }
    << b
}

fn (p Pe64) generate_dynamic(a &Assembler, start_offset int, buf $&[]int) {
    $out := []int{}
    $iat_labs := []string{}
    $iat_offs := []int{}
    pe_collect_iat_labs(a, $&iat_labs, $&iat_offs)
    n_imports := iat_labs.len
    $xu_us := 0
    if p.ext_dlls.len > 0 {
        xu_us = 1
    }

    $gdll := []string{}
    $gfirst := []int{}
    $gn := []int{}
    $gslots := []int{}
    if xu_us == 0 {
        if n_imports > 0 {
            gdll.push("kernel32.dll")
            gfirst.push(0)
            gn.push(n_imports)
            for i in 0:n_imports {
                gslots.push(i)
            }
        }
    } else {
        $nk := 0
        $gf := gslots.len
        for i in 0:n_imports {
            if !starts_with(iat_labs[i], "_iat_xu_") {
                gslots.push(i)
                nk = nk + 1
            }
        }
        if nk > 0 {
            gdll.push("kernel32.dll")
            gfirst.push(gf)
            gn.push(nk)
        }
        for d in 0:p.ext_dlls.len {
            $n := 0
            gf = gslots.len
            for i in 0:n_imports {
                if !starts_with(iat_labs[i], "_iat_xu_") {
                    ->
                }
                sym := "_" + iat_labs[i][5:iat_labs[i].len]
                $hit := false
                $anyhit := false
                for j in 0:p.ext_sym.len {
                    if p.ext_sym[j] == sym {
                        $di := 0
                        if j < p.ext_sym_dll.len {
                            di = p.ext_sym_dll[j]
                        }
                        anyhit = true
                        if di == d {
                            hit = true
                        }
                    }
                }
                if !anyhit && d == 0 {
                    hit = true
                }
                if hit {
                    gslots.push(i)
                    n = n + 1
                }
            }
            if n > 0 {
                gdll.push(p.ext_dlls[d] + "")
                gfirst.push(gf)
                gn.push(n)
            }
        }
    }

    $code_mut := []int{}
    for i in 0:a.code.len {
        code_mut.push(a.code[i])
    }
    orig_len := a.code.len
    if p.dll_id.len > 0 {
        pe_dllmain_stub(p.machine, $&code_mut)
    }

    dos_header_size := PE_DOS_HEADER_BYTES
    optional_header_size := PE64_OPTIONAL_HEADER_BYTES
    num_sections := 2
    file_align := PE_FILE_ALIGNMENT
    section_align := PE_SECTION_ALIGNMENT
    headers_size := dos_header_size + PE_SIGNATURE_BYTES + PE_COFF_HEADER_BYTES + optional_header_size + num_sections * PE_SECTION_HEADER_BYTES
    $text_raw_offset := ((headers_size + file_align - 1) / file_align) * file_align
    if text_raw_offset < PE_MIN_HEADER_BYTES {
        text_raw_offset = PE_MIN_HEADER_BYTES
    }
    text_rva := section_align
    text_size := code_mut.len
    text_raw_size := ((text_size + file_align - 1) / file_align) * file_align
    text_virtual_size := ((text_size + section_align - 1) / section_align) * section_align

    $prefix_len := 0
    $suffix_start := 0
    $iat_data_offset := 0
    if n_imports == 0 {
        prefix_len = a.data.len
        suffix_start = a.data.len
    } else {
        iat_data_offset = iat_offs[0]
        prefix_len = iat_data_offset
        if prefix_len > a.data.len {
            prefix_len = a.data.len
        }
        iat_end := iat_data_offset + (n_imports + 1) * 8
        suffix_start = iat_end
        if suffix_start > a.data.len {
            suffix_start = a.data.len
        }
    }
    suffix_len := a.data.len - suffix_start

    ng := gdll.len
    $idt_size := 0
    if ng > 0 {
        idt_size = (ng + 1) * 20
    }
    $ilt_total := 0
    $iat_total := 0
    for i in 0:ng {
        sz := (gn[i] + 1) * 8
        ilt_total = ilt_total + sz
        iat_total = iat_total + sz
    }
    ilt_offset := idt_size
    iat_offset := ilt_offset + ilt_total
    hint_name_offset := iat_offset + iat_total
    $hint_name_cursor := hint_name_offset
    $hint_rvas := []int{}
    for gi in 0:ng {
        for k in 0:gn[gi] {
            hint_rvas.push(hint_name_cursor)
            si := gslots[gfirst[gi] + k]
            nm := pe_import_sym(iat_labs[si] + "", xu_us)
            $entry_size := 2 + nm.len + 1
            if entry_size % 2 != 0 {
                entry_size = entry_size + 1
            }
            hint_name_cursor = hint_name_cursor + entry_size
        }
    }
    $dll_name_off := []int{}
    for gi in 0:ng {
        dll_name_off.push(hint_name_cursor)
        hint_name_cursor = hint_name_cursor + gdll[gi].len + 1
    }
    $import_blob_size := 0
    if ng > 0 {
        import_blob_size = hint_name_cursor
    }

    data_raw_offset := text_raw_offset + text_raw_size
    data_rva := text_rva + text_virtual_size
    $import_rva := 0
    if ng > 0 {
        import_rva = data_rva + prefix_len
    }
    export_rva_base := data_rva + prefix_len + import_blob_size
    $expb := []int{}
    $export_rva := 0
    if p.dll_id.len > 0 && p.exp_name.len > 0 {
        dlln := p.dll_id + ""
        $en := []string{}
        $eo := []int{}
        for ei in 0:p.exp_name.len {
            en.push(p.exp_name[ei] + "")
            eo.push(p.exp_off[ei])
        }
        expb = pe_export_blob(dlln, &en, &eo, text_rva, export_rva_base)
        export_rva = export_rva_base
    }
    combined_size := prefix_len + import_blob_size + expb.len + suffix_len
    $data_raw_size := 0
    if combined_size > 0 {
        data_raw_size = ((combined_size + file_align - 1) / file_align) * file_align
    }
    $data_virtual_size := section_align
    if combined_size > 0 {
        data_virtual_size = ((combined_size + section_align - 1) / section_align) * section_align
    }
    image_size := data_rva + data_virtual_size
    $entry_rva := text_rva + start_offset
    if p.dll_id.len > 0 {
        entry_rva = text_rva + orig_len
    }
    $iat_rva := 0
    if ng > 0 {
        iat_rva = import_rva + iat_offset
    }
    $import_only := 0
    if prefix_len == 0 && suffix_len == 0 && expb.len == 0 {
        import_only = 1
    }
    $data_chars := PE_SECTION_RW_FLAGS
    $data_sec_name := ".data"
    if import_only == 1 {
        data_chars = PE_SECTION_RO_FLAGS
        data_sec_name = ".rdata"
    }

    out.push(77)
    out.push(90)
    write16($&out, 144)
    write16($&out, 3)
    write16($&out, 0)
    write16($&out, 4)
    write16($&out, 0)
    write16($&out, 65535)
    write16($&out, 0)
    write16($&out, 184)
    write16($&out, 0)
    write16($&out, 0)
    write16($&out, 0)
    write16($&out, 64)
    write16($&out, 0)
    for i in 0:4 {
        write16($&out, 0)
    }
    write16($&out, 0)
    write16($&out, 0)
    for i in 0:10 {
        write16($&out, 0)
    }
    write32($&out, dos_header_size)

    out.push(80)
    out.push(69)
    out.push(0)
    out.push(0)
    write16($&out, p.machine)
    write16($&out, num_sections)
    write32($&out, 0)
    write32($&out, 0)
    write32($&out, 0)
    write16($&out, optional_header_size)
    $coff := 34
    if p.dll_id.len > 0 {
        coff = 8226
    }
    write16($&out, coff)

    write16($&out, 523)
    out.push(14)
    out.push(0)
    write32($&out, text_raw_size)
    write32($&out, data_raw_size)
    write32($&out, 0)
    write32($&out, entry_rva)
    write32($&out, text_rva)
    write64($&out, p.base_addr)
    write32($&out, section_align)
    write32($&out, file_align)
    write16($&out, 6)
    write16($&out, 0)
    write16($&out, 0)
    write16($&out, 0)
    write16($&out, 6)
    write16($&out, 0)
    write32($&out, 0)
    write32($&out, image_size)
    write32($&out, text_raw_offset)
    write32($&out, 0)
    write16($&out, PE_CONSOLE_SUBSYSTEM)
    write16($&out, PE_DLL_CHARACTERISTICS)
    write64($&out, PE_STACK_RESERVE_BYTES)
    write64($&out, PE_STACK_COMMIT_BYTES)
    write64($&out, PE_HEAP_RESERVE_BYTES)
    write64($&out, PE_HEAP_COMMIT_BYTES)
    write32($&out, 0)
    write32($&out, PE_DATA_DIRECTORY_COUNT)

    write32($&out, export_rva)
    write32($&out, expb.len)
    write32($&out, import_rva)
    write32($&out, idt_size)
    for i in 2:12 {
        write32($&out, 0)
        write32($&out, 0)
    }
    write32($&out, iat_rva)
    write32($&out, iat_total)
    for i in 13:16 {
        write32($&out, 0)
        write32($&out, 0)
    }

    write_str($&out, ".text", 8)
    write32($&out, text_size)
    write32($&out, text_rva)
    write32($&out, text_raw_size)
    write32($&out, text_raw_offset)
    write32($&out, 0)
    write32($&out, 0)
    write16($&out, 0)
    write16($&out, 0)
    write32($&out, PE_SECTION_CODE_FLAGS)

    write_str($&out, data_sec_name, 8)
    write32($&out, combined_size)
    write32($&out, data_rva)
    write32($&out, data_raw_size)
    write32($&out, data_raw_offset)
    write32($&out, 0)
    write32($&out, 0)
    write16($&out, 0)
    write16($&out, 0)
    write32($&out, data_chars)

    $idata := []int{}
    if ng > 0 {
        $ilt_off_i := ilt_offset
        $iat_off_i := iat_offset
        $hi := 0
        for gi in 0:ng {
            write32($&idata, import_rva + ilt_off_i)
            write32($&idata, 0)
            write32($&idata, 0)
            write32($&idata, import_rva + dll_name_off[gi])
            write32($&idata, import_rva + iat_off_i)
            ilt_off_i = ilt_off_i + (gn[gi] + 1) * 8
            iat_off_i = iat_off_i + (gn[gi] + 1) * 8
        }
        for i in 0:5 {
            write32($&idata, 0)
        }
        for gi in 0:ng {
            for k in 0:gn[gi] {
                write64($&idata, import_rva + hint_rvas[hi])
                hi = hi + 1
            }
            write64($&idata, 0)
        }
        hi = 0
        for gi in 0:ng {
            for k in 0:gn[gi] {
                write64($&idata, import_rva + hint_rvas[hi])
                hi = hi + 1
            }
            write64($&idata, 0)
        }
        for gi in 0:ng {
            for k in 0:gn[gi] {
                si := gslots[gfirst[gi] + k]
                nm := pe_import_sym(iat_labs[si] + "", xu_us)
                write16($&idata, 0)
                for ci in 0:nm.len {
                    idata.push(nm[ci])
                }
                idata.push(0)
                if idata.len % 2 != 0 {
                    idata.push(0)
                }
            }
        }
        for gi in 0:ng {
            nm := gdll[gi] + ""
            for ci in 0:nm.len {
                idata.push(nm[ci])
            }
            idata.push(0)
        }
    }

    $new_rva := []int{}
    for i in 0:n_imports {
        new_rva.push(0)
    }
    $iat_cursor := iat_offset
    for gi in 0:ng {
        for k in 0:gn[gi] {
            si := gslots[gfirst[gi] + k]
            new_rva[si] = import_rva + iat_cursor + k * 8
        }
        iat_cursor = iat_cursor + (gn[gi] + 1) * 8
    }
    if n_imports > 0 {
        $old_addrs := []int{}
        $new_addrs := []int{}
        for i in 0:n_imports {
            old_addrs.push(p.base_addr + data_rva + iat_offs[i])
            new_addrs.push(p.base_addr + new_rva[i])
        }
        if p.machine == COFF_MACHINE_ARM64 {
            pe_patch_arm64_adrp_add($&code_mut, p.base_addr + text_rva, &old_addrs, &new_addrs)
        } else if p.machine == COFF_MACHINE_AMD64 {
            pe_patch_x64_rip32($&code_mut, p.base_addr + text_rva, &old_addrs, &new_addrs)
        }
    }
    if suffix_len > 0 {
        old_base := iat_data_offset + (n_imports + 1) * 8
        new_base := import_rva + import_blob_size + expb.len
        $sold := []int{}
        $snew := []int{}
        for li in 0:a.labels.len {
            if !a.labels[li].is_data {
                ->
            }
            loff := a.labels[li].offset
            if loff >= old_base && loff < a.data.len {
                ov := p.base_addr + data_rva + loff
                nv := p.base_addr + new_base + (loff - old_base)
                if ov != nv {
                    sold.push(ov)
                    snew.push(nv)
                }
            }
        }
        if sold.len > 0 {
            if p.machine == COFF_MACHINE_ARM64 {
                pe_patch_arm64_adrp_add($&code_mut, p.base_addr + text_rva, &sold, &snew)
            } else if p.machine == COFF_MACHINE_AMD64 {
                pe_patch_x64_rip32($&code_mut, p.base_addr + text_rva, &sold, &snew)
            }
        }
    }

    pad_to($&out, text_raw_offset)
    for i in 0:code_mut.len {
        out.push(code_mut[i])
    }
    pad_to($&out, data_raw_offset)
    for i in 0:prefix_len {
        out.push(a.data[i])
    }
    for i in 0:idata.len {
        out.push(idata[i])
    }
    for i in 0:expb.len {
        out.push(expb[i])
    }
    for i in suffix_start:a.data.len {
        out.push(a.data[i])
    }
    pad_to($&out, data_raw_offset + data_raw_size)
    for i in 0:out.len {
        buf.push(out[i])
    }
}
