@main

// Xtensa LX6 (ESP32) assembler for Xu (E8).
// Encodes instructions for the Call0 ABI (flat register model, no windowing).
//
// Register numbers are physical Xtensa a0..a15 (0..15).
// Fixup kinds:
//   31 = CALL0 (18-bit signed word displacement)
//   32 = J     (18-bit signed byte displacement)
//   33 = LEA   (32-bit absolute address synthesis sequence)

fn (a $&Assembler) xt_emit24(word int) {
    a.code.push(word & 255)
    a.code.push((word >> 8) & 255)
    a.code.push((word >> 16) & 255)
}

fn (a $&Assembler) xt_emit16(word int) {
    a.code.push(word & 255)
    a.code.push((word >> 8) & 255)
}

fn (a $&Assembler) xt_patch24(off int, word int) {
    a.code[off] = word & 255
    a.code[off + 1] = (word >> 8) & 255
    a.code[off + 2] = (word >> 16) & 255
}

// ===== ALU Instructions =====

fn (a $&Assembler) xt_add(ar int, as_reg int, at int) {
    a.code.push((at & 15) << 4)
    a.code.push(((ar & 15) << 4) | (as_reg & 15))
    a.code.push(0x80)
}

fn (a $&Assembler) xt_sub(ar int, as_reg int, at int) {
    a.code.push((at & 15) << 4)
    a.code.push(((ar & 15) << 4) | (as_reg & 15))
    a.code.push(0xC0)
}

fn (a $&Assembler) xt_and(ar int, as_reg int, at int) {
    a.code.push((at & 15) << 4)
    a.code.push(((ar & 15) << 4) | (as_reg & 15))
    a.code.push(0x10)
}

fn (a $&Assembler) xt_or(ar int, as_reg int, at int) {
    a.code.push((at & 15) << 4)
    a.code.push(((ar & 15) << 4) | (as_reg & 15))
    a.code.push(0x20)
}

fn (a $&Assembler) xt_xor(ar int, as_reg int, at int) {
    a.code.push((at & 15) << 4)
    a.code.push(((ar & 15) << 4) | (as_reg & 15))
    a.code.push(0x30)
}

fn (a $&Assembler) xt_mull(ar int, as_reg int, at int) {
    a.code.push((at & 15) << 4)
    a.code.push(((ar & 15) << 4) | (as_reg & 15))
    a.code.push(0x82)
}

fn (a $&Assembler) xt_quos(ar int, as_reg int, at int) {
    a.code.push((at & 15) << 4)
    a.code.push(((ar & 15) << 4) | (as_reg & 15))
    a.code.push(0xD2)
}

fn (a $&Assembler) xt_quou(ar int, as_reg int, at int) {
    a.code.push((at & 15) << 4)
    a.code.push(((ar & 15) << 4) | (as_reg & 15))
    a.code.push(0xC2)
}

fn (a $&Assembler) xt_rems(ar int, as_reg int, at int) {
    a.code.push((at & 15) << 4)
    a.code.push(((ar & 15) << 4) | (as_reg & 15))
    a.code.push(0xF2)
}

fn (a $&Assembler) xt_remu(ar int, as_reg int, at int) {
    a.code.push((at & 15) << 4)
    a.code.push(((ar & 15) << 4) | (as_reg & 15))
    a.code.push(0xE2)
}

fn (a $&Assembler) xt_neg(ar int, as_reg int) {
    a.code.push((as_reg & 15) << 4)
    a.code.push((ar & 15) << 4)
    a.code.push(0x60)
}

fn (a $&Assembler) xt_mov(ar int, as_reg int) {
    a.xt_or(ar, as_reg, as_reg)
}

fn (a $&Assembler) xt_ssl(as_reg int) {
    a.code.push(0x00)
    a.code.push(0x10 | (as_reg & 15))
    a.code.push(0x40)
}

fn (a $&Assembler) xt_ssr(as_reg int) {
    a.code.push(0x00)
    a.code.push(as_reg & 15)
    a.code.push(0x40)
}

fn (a $&Assembler) xt_sll(ar int, as_reg int) {
    a.code.push(0x00)
    a.code.push(((ar & 15) << 4) | (as_reg & 15))
    a.code.push(0xA1)
}

fn (a $&Assembler) xt_srl(ar int, as_reg int) {
    a.code.push((as_reg & 15) << 4)
    a.code.push((ar & 15) << 4)
    a.code.push(0x91)
}

fn (a $&Assembler) xt_sra(ar int, as_reg int) {
    a.code.push((as_reg & 15) << 4)
    a.code.push((ar & 15) << 4)
    a.code.push(0xB1)
}

fn (a $&Assembler) xt_slli(ar int, as_reg int, sh int) {
    sa := 32 - sh
    b0 := (sa & 15) << 4
    b1 := ((ar & 15) << 4) | (as_reg & 15)
    b2 := 0x01 | (((sa >> 4) & 1) << 4)
    a.code.push(b0)
    a.code.push(b1)
    a.code.push(b2)
}

fn (a $&Assembler) xt_srli(ar int, as_reg int, sh int) {
    b0 := (as_reg & 15) << 4
    b1 := ((ar & 15) << 4) | (sh & 15)
    $b2 := 0x41
    if sh >= 16 {
        b2 = ((31 - sh) << 4) | 0x05
    }
    a.code.push(b0)
    a.code.push(b1)
    a.code.push(b2)
}

fn (a $&Assembler) xt_srai(ar int, as_reg int, sh int) {
    b0 := (as_reg & 15) << 4
    b1 := ((ar & 15) << 4) | (sh & 15)
    $b2 := 0x21
    if sh >= 16 {
        b2 = 0x31
    }
    a.code.push(b0)
    a.code.push(b1)
    a.code.push(b2)
}

// movi ar, imm12 (-2048..2047)
fn (a $&Assembler) xt_movi(ar int, imm12 int) {
    i := imm12 & 4095
    b0 := 0x02 | ((ar & 15) << 4)
    b1 := 0xA0 | ((i >> 8) & 15)
    b2 := i & 255
    a.code.push(b0)
    a.code.push(b1)
    a.code.push(b2)
}

// addi ar, as, imm8 (-128..127)
// Read PS and raise INTLEVEL atomically while a mixed-ABI stack pointer
// and its window spill descriptor are being changed.
fn (a $&Assembler) xt_rsil(ar int, level int) {
    a.xt_emit24(0x006000 | ((level & 15) << 8) | ((ar & 15) << 4))
}

fn (a $&Assembler) xt_addi(ar int, as_reg int, imm8 int) {
    i := imm8 & 255
    b0 := 0x02 | ((ar & 15) << 4)
    b1 := 0xC0 | (as_reg & 15)
    b2 := i
    a.code.push(b0)
    a.code.push(b1)
    a.code.push(b2)
}

// addmi ar, as, imm8 * 256 (signed 8-bit high-byte adjustment).
fn (a $&Assembler) xt_addmi(ar int, as_reg int, imm8 int) {
    a.xt_emit24(0x00D002 | ((ar & 15) << 4) | (as_reg & 15) << 8 | ((imm8 & 255) << 16))
}

// ===== Memory Instructions =====

// l32i at, as, off (off: 0..1020, multiple of 4)
fn (a $&Assembler) xt_l32i(at int, as_reg int, off int) {
    b0 := 0x02 | ((at & 15) << 4)
    b1 := 0x20 | (as_reg & 15)
    b2 := (off / 4) & 255
    a.code.push(b0)
    a.code.push(b1)
    a.code.push(b2)
}

// s32i at, as, off (off: 0..1020, multiple of 4)
fn (a $&Assembler) xt_s32i(at int, as_reg int, off int) {
    b0 := 0x02 | ((at & 15) << 4)
    b1 := 0x60 | (as_reg & 15)
    b2 := (off / 4) & 255
    a.code.push(b0)
    a.code.push(b1)
    a.code.push(b2)
}

// l8ui at, as, off (off: 0..255)
fn (a $&Assembler) xt_l8ui(at int, as_reg int, off int) {
    b0 := 0x02 | ((at & 15) << 4)
    b1 := as_reg & 15
    b2 := off & 255
    a.code.push(b0)
    a.code.push(b1)
    a.code.push(b2)
}

// s8i at, as, off (off: 0..255)
fn (a $&Assembler) xt_s8i(at int, as_reg int, off int) {
    b0 := 0x02 | ((at & 15) << 4)
    b1 := 0x40 | (as_reg & 15)
    b2 := off & 255
    a.code.push(b0)
    a.code.push(b1)
    a.code.push(b2)
}

// l16ui at, as, off (off: 0..510, multiple of 2)
fn (a $&Assembler) xt_l16ui(at int, as_reg int, off int) {
    b0 := 0x02 | ((at & 15) << 4)
    b1 := 0x10 | (as_reg & 15)
    b2 := (off / 2) & 255
    a.code.push(b0)
    a.code.push(b1)
    a.code.push(b2)
}

// s16i at, as, off (off: 0..510, multiple of 2)
fn (a $&Assembler) xt_s16i(at int, as_reg int, off int) {
    b0 := 0x02 | ((at & 15) << 4)
    b1 := 0x50 | (as_reg & 15)
    b2 := (off / 2) & 255
    a.code.push(b0)
    a.code.push(b1)
    a.code.push(b2)
}

// ===== Control Flow =====

fn (a $&Assembler) xt_ret() {
    a.code.push(0x0D)
    a.code.push(0xF0)
}

fn (a $&Assembler) xt_waiti() {
    a.code.push(0x00)
    a.code.push(0x70)
    a.code.push(0x00)
}

fn (a $&Assembler) xt_jx(as_reg int) {
    a.code.push(0xA0)
    a.code.push(as_reg & 15)
    a.code.push(0x00)
}

fn (a $&Assembler) xt_callx0(as_reg int) {
    a.code.push(0xC0)
    a.code.push(as_reg & 15)
    a.code.push(0x00)
}

fn (a $&Assembler) xt_callx8(as_reg int) {
    a.xt_emit24(0x0000E0 | ((as_reg & 15) << 8))
}

fn (a $&Assembler) xt_rsr(rd int, sr int) {
    a.xt_emit24(0x030000 | ((sr & 255) << 8) | ((rd & 15) << 4))
}

fn (a $&Assembler) xt_wsr(rs int, sr int) {
    a.xt_emit24(0x130000 | ((sr & 255) << 8) | ((rs & 15) << 4))
}

fn (a $&Assembler) xt_rsync() { a.xt_emit24(0x002010) }
fn (a $&Assembler) xt_memw() { a.xt_emit24(0x0020C0) }

// bcond: sub_op: 1 beq, 9 bne, 2 blt, 10 bge, 3 bltu, 11 bgeu
fn (a $&Assembler) xt_emit_bcond(sub_op int, as_reg int, at int, disp int) {
    b0 := 0x07 | ((at & 15) << 4)
    b1 := ((sub_op & 15) << 4) | (as_reg & 15)
    b2 := disp & 255
    a.code.push(b0)
    a.code.push(b1)
    a.code.push(b2)
}

fn (a $&Assembler) xt_j(label string) {
    fx := Fixup{kind: 32, offset: a.code.len, label: label, rd: 0}
    a.fixups.push(fx)
    a.code.push(0x06)
    a.code.push(0x00)
    a.code.push(0x00)
}

fn (a $&Assembler) xt_call0(label string) {
    // Reserve one fixed-size call site so final label resolution can select
    // CALL0 or an absolute CALLX0 without moving any later labels. a10/a11
    // are caller scratch; scalar args a2..a7 and aggregate result a8 survive.
    fx := Fixup{kind: 34, offset: a.code.len, label: label, rd: 11}
    a.fixups.push(fx)
    a.xt_synth32(11, 0)
    a.xt_callx0(11)
}

// Internal windowed calls use the same PC-relative encoding and fixup as
// CALL0, with a nonzero call increment (1/2/3 = CALL4/8/12).
fn (a $&Assembler) xt_call_windowed(label string, increment int) {
    fx := Fixup{kind: 31, offset: a.code.len, label: label, rd: increment}
    a.fixups.push(fx)
    a.xt_emit24(0x05 | ((increment & 3) << 4))
}

// 7-instruction full 32-bit constant/address synthesis (21 bytes).
fn (a $&Assembler) xt_synth32(rd int, val int) {
    u := val & 4294967295
    p0 := (u >> 20) & 4095
    p1 := (u >> 10) & 1023
    p2 := u & 1023
    $sc := 11
    if rd == 11 { sc = 10 }
    // 1. movi rd, p0
    a.xt_movi(rd, p0)
    // 2. slli rd, rd, 10
    a.xt_slli(rd, rd, 10)
    // 3. movi sc, p1
    a.xt_movi(sc, p1)
    // 4. or rd, rd, sc
    a.xt_or(rd, rd, sc)
    // 5. slli rd, rd, 10
    a.xt_slli(rd, rd, 10)
    // 6. movi sc, p2
    a.xt_movi(sc, p2)
    // 7. or rd, rd, sc
    a.xt_or(rd, rd, sc)
}

fn (a $&Assembler) xt_mov_imm32(rd int, imm int) {
    if imm >= -2048 && imm <= 2047 {
        a.xt_movi(rd, imm)
        <<
    }
    a.xt_synth32(rd, imm)
}

fn (a $&Assembler) xt_lea_abs(rd int, label string) {
    fx := Fixup{kind: 33, offset: a.code.len, label: label, rd: rd}
    a.fixups.push(fx)
    a.xt_synth32(rd, 0)
}

fn (a $&Assembler) xt_patch_synth32(offset int, rd int, value int) {
    u := value & 4294967295
    p0 := (u >> 20) & 4095
    p1 := (u >> 10) & 1023
    p2 := u & 1023
    $sc := 11
    if rd == 11 { sc = 10 }
    w0 := 0x02 | ((rd & 15) << 4) | (0xA0 << 8) | (((p0 >> 8) & 15) << 8) | ((p0 & 255) << 16)
    a.xt_patch24(offset, w0)
    w1 := 0x02 | ((sc & 15) << 4) | (0xA0 << 8) | (((p1 >> 8) & 15) << 8) | ((p1 & 255) << 16)
    a.xt_patch24(offset + 6, w1)
    w2 := 0x02 | ((sc & 15) << 4) | (0xA0 << 8) | (((p2 >> 8) & 15) << 8) | ((p2 & 255) << 16)
    a.xt_patch24(offset + 15, w2)
}

fn (a $&Assembler) xt_fixup_all() {
    for i in 0:a.fixups.len {
        kind := a.fixups[i].kind
        offset := a.fixups[i].offset
        target_addr := a.label_addr(a.fixups[i].label)
        if kind == 31 {
            // CALL0: 18-bit signed word displacement
            current_addr := a.code_vaddr + offset
            base := ((current_addr + 4) / 4) * 4
            diff := target_addr - base
            if diff % 4 != 0 {
                eprintln("ERROR: Xtensa call0 unaligned target: " + a.fixups[i].label + " at " + str(target_addr))
                <<< 1
            }
            word_disp := diff / 4
            if word_disp < -131072 || word_disp > 131071 {
                eprintln("ERROR: Xtensa call0 target out of range: " + a.fixups[i].label)
                <<< 1
            }
            word24 := 0x05 | ((a.fixups[i].rd & 3) << 4) | ((word_disp & 0x3FFFF) << 6)
            a.xt_patch24(offset, word24)
        } else if kind == 32 {
            // J: 18-bit signed byte displacement
            current_addr := a.code_vaddr + offset
            diff := target_addr - (current_addr + 4)
            if diff < -131072 || diff > 131071 {
                eprintln("ERROR: Xtensa jump target out of range: " + a.fixups[i].label)
                <<< 1
            }
            word24 := 0x06 | ((diff & 0x3FFFF) << 6)
            a.xt_patch24(offset, word24)
        } else if kind == 33 {
            // LEA: patch 3 movi instructions in the 7-instruction synthesis
            a.xt_patch_synth32(offset, a.fixups[i].rd, target_addr)
        } else if kind == 34 {
            current_addr := a.code_vaddr + offset
            base := ((current_addr + 4) / 4) * 4
            diff := target_addr - base
            if diff % 4 != 0 {
                eprintln("ERROR: Xtensa call0 unaligned target: " + a.fixups[i].label)
                <<< 1
            }
            word_disp := diff / 4
            if word_disp >= -131072 && word_disp <= 131071 {
                a.xt_patch24(offset, 0x05 | ((word_disp & 0x3FFFF) << 6))
                for padding in 1:8 { a.xt_patch24(offset + padding * 3, 0x0020F0) }
            } else {
                a.xt_patch_synth32(offset, 11, target_addr)
            }
        }
    }
}
