@main

#xu/types

// Plain records have no ownership or interior references, and their buffer
// field offsets are exactly the offsets emitted by checked ElemAddr paths.
fn int_record_type(m &types.Mir, ty int) bool {
    if !types.is_struct_type(ty) { << false }
    si := types.struct_index(ty)
    if si < 0 || si >= m.structs.len { << false }
    nf := m.structs[si].fields.len
    if nf <= 0 || nf > 16 || m.type_slots(ty) != nf || m.type_size_bytes(ty) != nf * 8 { << false }
    for j in 0:nf {
        if m.structs[si].fields[j].ty != 1 || m.structs[si].fields[j].slot != j * 8 { << false }
    }
    << true
}

fn int_record_array_type(m &types.Mir, ty int) bool {
    if !types.is_array_type(ty) { << false }
    ai := types.array_index(ty)
    if ai < 0 || ai >= m.arrays.len || m.arrays[ai].fixed_len != 0 { << false }
    et := m.arrays[ai].elem_ty
    if et == 1 { << m.arrays[ai].elem_bytes == 8 }
    << int_record_type(m, et) && m.arrays[ai].elem_bytes == m.type_size_bytes(et)
}

fn int_record_receiver_type(m &types.Mir, ty int) bool {
    inner := vreg_direct_ref_inner(m, ty)
    if !types.is_struct_type(inner) { << false }
    si := types.struct_index(inner)
    if si < 0 || si >= m.structs.len { << false }
    nf := m.structs[si].fields.len
    if nf <= 0 || nf > 16 { << false }
    mut record := false
    for j in 0:nf {
        ft := m.structs[si].fields[j].ty
        if ft == 1 { -> }
        if !int_record_array_type(m, ft) { << false }
        if int_record_type(m, m.arrays[types.array_index(ft)].elem_ty) { record = true }
    }
    << record
}

// Every descriptor definition must snapshot an exact array field from the
// immutable receiver local. This does not cache its contents or its length.
fn int_record_descriptor_type(m &types.Mir, fi int, t int, recv int) int {
    nt := types.mir_ntemps(m, fi)
    if t < 0 || t >= nt || types.mir_temp_nslots(m, fi, t) != 3 { << -1 }
    ty := types.mir_temp_ty(m, fi, t)
    if !int_record_array_type(m, ty) { << -1 }
    si := types.struct_index(vreg_direct_ref_inner(m, recv))
    mut saw := false
    for ii in 0:types.mir_nins(m, fi) {
        k := types.mir_ikind(m, fi, ii)
        if !types.mir_instr_has_dest(k) || types.mir_ia(m, fi, ii) != t { -> }
        if k != types.MI_LOAD_PTR || types.mir_id(m, fi, ii) != 3 { << -1 }
        if !int_container_receiver_base(m, fi, types.mir_ib(m, fi, ii), recv) { << -1 }
        mut field := false
        for j in 0:m.structs[si].fields.len {
            if m.structs[si].fields[j].ty == ty && m.structs[si].fields[j].slot == types.mir_ic(m, fi, ii) { field = true }
        }
        if !field { << -1 }
        saw = true
    }
    if !saw { << -1 }
    << ty
}

// ElemAddr results are represented by an integer TempId. Prove every
// definition is a checked element address with the same record layout;
// arbitrary integer addresses and copied/rebound pointer values fail closed.
fn int_record_element_type(m &types.Mir, fi int, t int, recv int) int {
    if t < 0 || t >= types.mir_ntemps(m, fi) || types.mir_temp_ty(m, fi, t) != 1 || types.mir_temp_nslots(m, fi, t) != 1 { << -1 }
    mut elem := -1
    for ii in 0:types.mir_nins(m, fi) {
        k := types.mir_ikind(m, fi, ii)
        if !types.mir_instr_has_dest(k) || types.mir_ia(m, fi, ii) != t { -> }
        if k != types.MI_ELEM_ADDR { << -1 }
        ty := int_record_descriptor_type(m, fi, types.mir_ib(m, fi, ii), recv)
        if ty < 0 { << -1 }
        et := m.arrays[types.array_index(ty)].elem_ty
        if !int_record_type(m, et) || types.mir_id(m, fi, ii) != m.arrays[types.array_index(ty)].elem_bytes { << -1 }
        if elem >= 0 && elem != et { << -1 }
        if !vreg_index_value_ok(m, fi, types.mir_ic(m, fi, ii)) { << -1 }
        elem = et
    }
    << elem
}

// Bounded call-free integer-record methods. Descriptors, references and
// element addresses retain frame homes; only scalar values enter the ordinary
// must-def/interference/scratch planner. This predicate grants no bounds reuse.
fn fn_is_int_record_container_leaf(m &types.Mir, fi int) bool {
    if fi < 0 || fi >= m.fns.len || types.mir_fn_is_extern(m, fi) { << false }
    nb := types.mir_nblocks(m, fi)
    nl := types.mir_nlocals(m, fi)
    nt := types.mir_ntemps(m, fi)
    ni := types.mir_nins(m, fi)
    if nb <= 0 || nb > 32 || nl <= 0 || nl > 32 || nt > 256 || ni > 512 { << false }
    np := types.mir_fn_nparams(m, fi)
    if np <= 0 || np > 6 || np > nl { << false }
    rt := types.mir_fn_ret(m, fi)
    if rt != 0 && rt != 1 { << false }
    recv := types.mir_local_ty(m, fi, 0)
    if types.mir_local_nslots(m, fi, 0) != 1 || !int_record_receiver_type(m, recv) { << false }
    for l in 1:nl {
        if types.mir_local_ty(m, fi, l) != 1 || types.mir_local_nslots(m, fi, l) != 1 { << false }
    }
    for t in 0:nt {
        ty := types.mir_temp_ty(m, fi, t)
        ns := types.mir_temp_nslots(m, fi, t)
        if ns == 1 && (ty == 1 || ty == 2 || ty == recv) { -> }
        if ns == 3 && int_record_array_type(m, ty) { -> }
        << false
    }
    si := types.struct_index(vreg_direct_ref_inner(m, recv))
    mut element := false
    mut store := false
    for ii in 0:ni {
        k := types.mir_ikind(m, fi, ii)
        if k == types.MI_NOP { -> }
        if k != types.MI_COPY && k != types.MI_LOAD_LOCAL && k != types.MI_STORE_LOCAL && k != types.MI_BIN && k != types.MI_UN && k != types.MI_LOAD_FIELD && k != types.MI_LOAD_INDEX && k != types.MI_LOAD_PTR && k != types.MI_STORE_PTR && k != types.MI_STORE_INDEX && k != types.MI_ELEM_ADDR && k != types.MI_STORE_BUF_PTR && k != types.MI_LOAD_BUF_PTR && k != types.MI_FIELD_RMW { << false }
        if k == types.MI_STORE_LOCAL && types.mir_ia(m, fi, ii) == 0 { << false }
        if k == types.MI_LOAD_PTR || k == types.MI_STORE_PTR {
            if !int_container_receiver_base(m, fi, types.mir_ib(m, fi, ii), recv) { << false }
            val := types.mir_ia(m, fi, ii)
            mut field := false
            for j in 0:m.structs[si].fields.len {
                ft := m.structs[si].fields[j].ty
                if m.structs[si].fields[j].slot != types.mir_ic(m, fi, ii) { -> }
                if k == types.MI_LOAD_PTR && val >= 0 && val < nt && types.mir_temp_ty(m, fi, val) == ft && types.mir_id(m, fi, ii) == m.type_slots(ft) { field = true }
                if k == types.MI_STORE_PTR && ft == 1 && types.mir_id(m, fi, ii) == 1 && vreg_scalar_value_ok(m, fi, val) {
                    if val < 0 || types.mir_temp_ty(m, fi, val) == 1 { field = true }
                }
            }
            if !field { << false }
        }
        if k == types.MI_ELEM_ADDR {
            if int_record_element_type(m, fi, types.mir_ia(m, fi, ii), recv) < 0 { << false }
            element = true
        }
        if k == types.MI_STORE_BUF_PTR || k == types.MI_LOAD_BUF_PTR {
            et := int_record_element_type(m, fi, types.mir_ib(m, fi, ii), recv)
            if et < 0 { << false }
            off := types.mir_ic(m, fi, ii)
            if types.mir_id(m, fi, ii) != 1 || off < 0 || off % 8 != 0 || off >= m.type_size_bytes(et) { << false }
            val := types.mir_ia(m, fi, ii)
            if !vreg_scalar_value_ok(m, fi, val) { << false }
            if val >= 0 && types.mir_temp_ty(m, fi, val) != 1 { << false }
            if k == types.MI_LOAD_BUF_PTR && val < 0 { << false }
            if k == types.MI_STORE_BUF_PTR { store = true }
        }
        if k == types.MI_LOAD_INDEX || k == types.MI_STORE_INDEX {
            mut base := types.mir_ib(m, fi, ii)
            if k == types.MI_STORE_INDEX { base = types.mir_ia(m, fi, ii) }
            ty := int_record_descriptor_type(m, fi, base, recv)
            if ty < 0 || m.arrays[types.array_index(ty)].elem_ty != 1 || types.mir_id(m, fi, ii) != 8 { << false }
        }
        if k == types.MI_LOAD_FIELD {
            if int_record_descriptor_type(m, fi, types.mir_ib(m, fi, ii), recv) < 0 { << false }
            off := types.mir_ic(m, fi, ii)
            val := types.mir_ia(m, fi, ii)
            if types.mir_id(m, fi, ii) != 1 || (off != 0 && off != 8 && off != 16) { << false }
            if val < 0 || val >= nt || types.mir_temp_ty(m, fi, val) != 1 { << false }
        }
        if k == types.MI_FIELD_RMW {
            if !int_container_receiver_base(m, fi, types.mir_ia(m, fi, ii), recv) || types.mir_id(m, fi, ii) != 1 || !vreg_field_rmw_ok(m, fi, ii) { << false }
            mut field := false
            for j in 0:m.structs[si].fields.len {
                if m.structs[si].fields[j].ty == 1 && m.structs[si].fields[j].slot == types.mir_iline(m, fi, ii) { field = true }
            }
            if !field { << false }
        }
    }
    << element && store
}
