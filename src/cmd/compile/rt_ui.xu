@main

#xu/types

// UI host: call xu_ui_host_run(tmp) in the same binary.
// Xu emits a weak stub (returns 127); static link with the native host
// (XU_UI_STATIC) overrides it.

fn rt_emit_ui_host_run(a &mut Assembler) {
    a.label("_rt_ui_host_run")
    // Windows x64 — PE symbol xu_ui_host_run
    if a.os == 2 && a.arch == 1 {
        a.prologue(16)
        a.call("_rt_cstr")
        a.x64_sub_imm(4, 32)
        a.x64_mov_reg(1, 0) // RCX = RAX
        a.call("xu_ui_host_run")
        a.x64_add_imm(4, 32)
        a.epilogue()
        a.label("xu_ui_host_run")
        a.prologue(16)
        a.vm_mov_imm(14, 127)
        a.epilogue()
        <<
    }
    // macOS — Mach-O C ABI xu_ui_host_run
    if a.os == 0 {
        if a.arch == 0 || a.arch == 1 {
            a.prologue(16)
            a.call("_rt_cstr")
            a.call("_xu_ui_host_run")
            a.epilogue()
            a.label("_xu_ui_host_run")
            a.prologue(16)
            a.vm_mov_imm(14, 127)
            a.epilogue()
            <<
        }
    }
    // Linux — ELF C ABI xu_ui_host_run (no leading underscore)
    if a.os == 1 {
        if a.arch == 0 || a.arch == 1 {
            a.prologue(16)
            a.call("_rt_cstr")
            a.call("xu_ui_host_run")
            a.epilogue()
            a.label("xu_ui_host_run")
            a.prologue(16)
            a.vm_mov_imm(14, 127)
            a.epilogue()
            <<
        }
    }
    a.prologue(16)
    a.vm_mov_imm(14, 127)
    a.epilogue()
    <<
}
