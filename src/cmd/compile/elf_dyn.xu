@main
// ELF ET_DYN .so and dynamically linked ET_EXEC (DT_NEEDED + PT_INTERP).
// Mirrors bootstrap/crates/xubin/src/elf.rs generate_dynamic.

fn elf_align8(v int) int {
    << ((v + 7) / 8) * 8
}

fn elf_hash(s string) int {
    $h := 0
    for i in 0:s.len {
        c := s[i] & 255
        h = ((h << 4) + c) & 4294967295
        g := h & 4026531840
        if g != 0 {
            h = h ^ ((g >> 24) & 4294967295)
        }
        h = (h & (g ^ 4294967295)) & 4294967295
    }
    << h
}

fn elf_hash_mod(h int, nbucket int) int {
    if nbucket <= 0 {
        << 0
    }
    << h % nbucket
}

fn elf_glob_dat(machine int) int {
    if machine == 62 {
        << 6
    }
    << 1025
}

fn elf_interp_path(machine int) string {
    if machine == 62 {
        << "/lib64/ld-linux-x86-64.so.2"
    }
    << "/lib/ld-linux-aarch64.so.1"
}

fn write_elf_sym(buf $&[]int, name int, info int, shndx int, value int) {
    write32(buf, name)
    buf.push(info & 255)
    buf.push(0)
    write16(buf, shndx)
    write64(buf, value)
    write64(buf, 0)
}

fn dynstr_add(ds $&[]int, s string) int {
    off := ds.len
    for i in 0:s.len {
        ds.push(s[i] & 255)
    }
    ds.push(0)
    << off
}

// Avoid the generic starts_with builtin here.  This code runs while a hosted
// compiler is emitting its own Mach-O and passes strings loaded from an
// owning Label field; Gen2's string-call lowering can retain a stale length
// across that boundary and spin in _rt_starts_with.  The fixed eight-byte
// prefix is cheaper and does not allocate or call back into the runtime.
fn is_iat_xu_label(n string) bool {
    if n.len < 8 {
        << false
    }
    if n[0] != 95 || n[1] != 105 || n[2] != 97 || n[3] != 116 || n[4] != 95 || n[5] != 120 || n[6] != 117 || n[7] != 95 {
        << false
    }
    << true
}

fn (a &Assembler) collect_iat_xu(names $&[]string, offs $&[]int) {
    for i in 0:a.labels.len {
        if !a.labels[i].is_data {
            ->
        }
        n := a.labels[i].name + ""
        if !is_iat_xu_label(n + "") {
            ->
        }
        // `_iat_xu_foo` → `_foo`; materialise the suffix instead of passing a
        // borrowed slice into the next owning string operation.
        $rest := ""
        for j in 5:n.len {
            rest = rest + string_from_byte(n[j])
        }
        names.push("_" + rest)
        offs.push(a.labels[i].offset)
    }
    n := offs.len
    for i in 1:n {
        $j := i
        while j > 0 {
            if offs[j] >= offs[j - 1] {
                <-
            }
            t := offs[j]
            offs[j] = offs[j - 1]
            offs[j - 1] = t
            tn := names[j] + ""
            names[j] = names[j - 1] + ""
            names[j - 1] = tn
            j = j - 1
        }
    }
}

fn (e Elf64) generate_dynamic(a &Assembler, start_offset int, buf $&[]int) {
    is_so := e.so_id.len > 0
    code_file_offset := e.code_file_offset()
    code_vaddr := e.code_vaddr()
    data_file_offset := code_file_offset + ((a.code.len + (ELF_LOAD_PAGE_BYTES - 1)) / ELF_LOAD_PAGE_BYTES) * ELF_LOAD_PAGE_BYTES
    data_vaddr := e.base_addr + data_file_offset
    $entry_point := 0
    if !is_so {
        entry_point = code_vaddr + start_offset
    }

    $dyn_names := []string{}
    $iat_off := []int{}
    if is_so {
        for i in 0:e.so_exp_name.len {
            dyn_names.push(e.so_exp_name[i] + "")
        }
    } else {
        a.collect_iat_xu($&dyn_names, $&iat_off)
    }

    $dynstr := []int{}
    dynstr.push(0)
    $name_off := []int{}
    for i in 0:dyn_names.len {
        name_off.push(dynstr_add($&dynstr, dyn_names[i] + ""))
    }
    $needed_off := []int{}
    for i in 0:e.needed.len {
        needed_off.push(dynstr_add($&dynstr, e.needed[i] + ""))
    }
    $soname_off := 0 - 1
    if is_so {
        soname_off = dynstr_add($&dynstr, e.so_id + "")
    }

    nsyms := 1 + dyn_names.len
    // nsyms >= 1 always (null symbol + exports).
    nbucket := nsyms
    $buckets := []int{}
    $chains := []int{}
    for i in 0:nbucket {
        buckets.push(0)
    }
    for i in 0:nsyms {
        chains.push(0)
    }
    for i in 0:dyn_names.len {
        si := i + 1
        h := elf_hash_mod(elf_hash(dyn_names[i] + ""), nbucket)
        chains[si] = buckets[h]
        buckets[h] = si
    }
    $hash := []int{}
    write32($&hash, nbucket)
    write32($&hash, nsyms)
    for i in 0:buckets.len {
        write32($&hash, buckets[i])
    }
    for i in 0:chains.len {
        write32($&hash, chains[i])
    }

    $dynsym := []int{}
    write_elf_sym($&dynsym, 0, 0, 0, 0)
    if is_so {
        for i in 0:e.so_exp_name.len {
            write_elf_sym($&dynsym, name_off[i], 18, 1, code_vaddr + e.so_exp_off[i])
        }
    } else {
        for i in 0:name_off.len {
            write_elf_sym($&dynsym, name_off[i], 18, 0, 0)
        }
    }

    $rela := []int{}
    if !is_so {
        typ := elf_glob_dat(e.machine)
        for i in 0:iat_off.len {
            r_off := data_vaddr + iat_off[i]
            if r_off % 8 != 0 {
                eprintln("IAT GLOB_DAT slot must be 8-byte aligned")
                <<< 1
            }
            write64($&rela, r_off)
            info := ((i + 1) << 32) | typ
            write64($&rela, info)
            write64($&rela, 0)
        }
    }

    extra_file := elf_align8(data_file_offset + a.data.len)
    $n_dyn := e.needed.len + 6
    if rela.len > 0 {
        n_dyn = n_dyn + 3
    }
    if soname_off >= 0 {
        n_dyn = n_dyn + 1
    }
    dyn_size := n_dyn * 16
    dyn_file := extra_file
    hash_file := dyn_file + dyn_size
    sym_file := elf_align8(hash_file + hash.len)
    str_file := sym_file + dynsym.len
    rela_file := elf_align8(str_file + dynstr.len)
    extra_end := rela_file + rela.len
    data_filesz := extra_end - data_file_offset

    dyn_va := e.base_addr + dyn_file
    hash_va := e.base_addr + hash_file
    sym_va := e.base_addr + sym_file
    str_va := e.base_addr + str_file
    rela_va := e.base_addr + rela_file

    $dynsec := []int{}
    for i in 0:needed_off.len {
        write64($&dynsec, 1)
        write64($&dynsec, needed_off[i])
    }
    if soname_off >= 0 {
        write64($&dynsec, 14)
        write64($&dynsec, soname_off)
    }
    write64($&dynsec, 4)
    write64($&dynsec, hash_va)
    write64($&dynsec, 5)
    write64($&dynsec, str_va)
    write64($&dynsec, 6)
    write64($&dynsec, sym_va)
    write64($&dynsec, 10)
    write64($&dynsec, dynstr.len)
    write64($&dynsec, 11)
    write64($&dynsec, 24)
    if rela.len > 0 {
        write64($&dynsec, 7)
        write64($&dynsec, rela_va)
        write64($&dynsec, 8)
        write64($&dynsec, rela.len)
        write64($&dynsec, 9)
        write64($&dynsec, 24)
    }
    write64($&dynsec, 0)
    write64($&dynsec, 0)

    phnum := 5
    interp_off := 64 + 56 * phnum
    $etype := 2
    if is_so {
        etype = 3
    }

    $out := []int{}
    out.push(127)
    out.push(69)
    out.push(76)
    out.push(70)
    out.push(2)
    out.push(1)
    out.push(1)
    out.push(0)
    for i in 0:8 {
        out.push(0)
    }
    write16($&out, etype)
    write16($&out, e.machine)
    write32($&out, 1)
    write64($&out, entry_point)
    write64($&out, 64)
    write64($&out, 0)
    write32($&out, 0)
    write16($&out, 64)
    write16($&out, 56)
    write16($&out, phnum)
    write16($&out, 64)
    write16($&out, 0)
    write16($&out, 0)

    if is_so {
        write32($&out, 6)
        write32($&out, 4)
        write64($&out, 64)
        write64($&out, e.base_addr + 64)
        write64($&out, e.base_addr + 64)
        write64($&out, 56 * phnum)
        write64($&out, 56 * phnum)
        write64($&out, 8)
    } else {
        ip := elf_interp_path(e.machine)
        write32($&out, 3)
        write32($&out, 4)
        write64($&out, interp_off)
        write64($&out, e.base_addr + interp_off)
        write64($&out, e.base_addr + interp_off)
        isz := ip.len + 1
        write64($&out, isz)
        write64($&out, isz)
        write64($&out, 1)
    }

    write32($&out, 1)
    write32($&out, 5)
    write64($&out, 0)
    write64($&out, e.base_addr)
    write64($&out, e.base_addr)
    write64($&out, code_file_offset + a.code.len)
    write64($&out, code_file_offset + a.code.len)
    write64($&out, ELF_LOAD_PAGE_BYTES)

    write32($&out, 1)
    write32($&out, 6)
    write64($&out, data_file_offset)
    write64($&out, data_vaddr)
    write64($&out, data_vaddr)
    write64($&out, data_filesz)
    write64($&out, data_filesz + e.data_memsz_bump)
    write64($&out, ELF_LOAD_PAGE_BYTES)

    write32($&out, 2)
    write32($&out, 6)
    write64($&out, dyn_file)
    write64($&out, dyn_va)
    write64($&out, dyn_va)
    write64($&out, dynsec.len)
    write64($&out, dynsec.len)
    write64($&out, 8)

    write32($&out, 1685382481)
    write32($&out, 6)
    write64($&out, 0)
    write64($&out, 0)
    write64($&out, 0)
    write64($&out, 0)
    write64($&out, 0)
    write64($&out, 16)

    if !is_so {
        pad_to($&out, interp_off)
        ip2 := elf_interp_path(e.machine)
        for i in 0:ip2.len {
            out.push(ip2[i] & 255)
        }
        out.push(0)
    }
    pad_to($&out, code_file_offset)
    for i in 0:a.code.len {
        out.push(a.code[i])
    }
    pad_to($&out, data_file_offset)
    for i in 0:a.data.len {
        out.push(a.data[i])
    }
    pad_to($&out, dyn_file)
    for i in 0:dynsec.len {
        out.push(dynsec[i])
    }
    pad_to($&out, hash_file)
    for i in 0:hash.len {
        out.push(hash[i])
    }
    pad_to($&out, sym_file)
    for i in 0:dynsym.len {
        out.push(dynsym[i])
    }
    pad_to($&out, str_file)
    for i in 0:dynstr.len {
        out.push(dynstr[i])
    }
    pad_to($&out, rela_file)
    for i in 0:rela.len {
        out.push(rela[i])
    }

    for i in 0:out.len {
        buf.push(out[i])
    }
}
