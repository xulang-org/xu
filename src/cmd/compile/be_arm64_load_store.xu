@main

// ===== Data movement =====

fn (a &mut Assembler) be_mov(dest int, src int) {
    if dest < 0 || dest > 63 || src < 0 || src > 63 {
        eprintln("be_mov odd dest=" + str(dest) + " src=" + str(src) + " arch=" + str(a.arch))
    }
    if a.arch == 1 {
        a.xbe_mov(dest, src)
    } else {
        if a.arch == 2 {
            a.tbe_mov(dest, src)
        } else if a.arch == 3 {
            a.rbe_mov(dest, src)
            } else if a.arch == 4 {
                a.lbe_mov(dest, src)
        } else if a.arch == 5 {
                a.vbe_mov(dest, src)
        } else {
            a.mov_reg(map_reg(dest), map_reg(src))
        }
    }
}

fn (a &mut Assembler) be_mov_imm(dest int, imm int) {
    if a.arch == 1 {
        a.xbe_mov_imm(dest, imm)
    } else {
        if a.arch == 2 {
            a.tbe_mov_imm(dest, imm)
        } else if a.arch == 3 {
            a.rbe_mov_imm(dest, imm)
            } else if a.arch == 4 {
                a.lbe_mov_imm(dest, imm)
        } else if a.arch == 5 {
                a.vbe_mov_imm(dest, imm)
        } else {
            a.mov_imm(map_reg(dest), imm)
        }
    }
}

fn (a &mut Assembler) be_mov_imm64(dest int, imm int) {
    if a.arch == 1 {
        a.xbe_mov_imm64(dest, imm)
    } else {
        if a.arch == 2 {
            a.tbe_mov_imm64(dest, imm)
        } else if a.arch == 3 {
            a.rbe_mov_imm64(dest, imm)
            } else if a.arch == 4 {
                a.lbe_mov_imm64(dest, imm)
        } else if a.arch == 5 {
                a.vbe_mov_imm64(dest, imm)
        } else {
            a.mov_imm64(map_reg(dest), imm)
        }
    }
}

fn (a &mut Assembler) be_lea(dest int, label string) {
    if a.arch == 1 {
        a.xbe_lea(dest, label)
        <<
    }
    if a.arch == 2 {
        a.tbe_lea(dest, label)
        <<
    }
    if a.arch == 3 {
        a.rbe_lea(dest, label)
        <<
    }
    if a.arch == 4 {
        a.lbe_lea(dest, label)
        <<
    }
    if a.arch == 5 {
        a.vbe_lea(dest, label)
        <<
    }
    a.lea_rip_rel(map_reg(dest), label)
}


// LDR/STR [base, index * elem_sz] — arm64 scaled register; x64 SIB.
fn (a &mut Assembler) be_load_scaled(dest int, base int, index int, elem_sz int) {
    if a.arch == 0 {
        a.ldr_reg_lsl(map_reg(dest), map_reg(base), map_reg(index), elem_sz)
        <<
    }
    if a.arch == 1 {
        a.xbe_load_scaled(dest, base, index, elem_sz)
        <<
    }
    if elem_sz == 1 {
        a.be_add(dest, base, index)
        a.be_load_byte(dest, dest, 0)
        <<
    }
    mut sh := 0
    if elem_sz == 2 { sh = 1 }
    if elem_sz == 4 { sh = 2 }
    if elem_sz == 8 { sh = 3 }
    a.be_shl_imm(dest, index, sh)
    a.be_add(dest, base, dest)
    a.be_load(dest, dest, 0)
}

fn (a &mut Assembler) be_store_scaled(base int, index int, src int, elem_sz int) {
    if a.arch == 0 {
        a.str_reg_lsl(map_reg(src), map_reg(base), map_reg(index), elem_sz)
        <<
    }
    if a.arch == 1 {
        a.xbe_store_scaled(base, index, src, elem_sz)
        <<
    }
    mut scratch := 0
    if src == 0 || base == 0 || index == 0 {
        scratch = 1
    }
    if elem_sz == 1 {
        a.be_add(scratch, base, index)
        a.be_store_byte(scratch, 0, src)
        <<
    }
    mut sh := 0
    if elem_sz == 2 { sh = 1 }
    if elem_sz == 4 { sh = 2 }
    if elem_sz == 8 { sh = 3 }
    a.be_shl_imm(scratch, index, sh)
    a.be_add(scratch, base, scratch)
    a.be_store(scratch, 0, src)
}

fn (a &mut Assembler) be_add_lsl(dest int, base int, index int, sh int) {
    if a.arch == 0 {
        a.add_lsl(map_reg(dest), map_reg(base), map_reg(index), sh)
        <<
    }
    a.be_shl_imm(index, index, sh)
    a.be_add(dest, base, index)
    <<
}

fn (a &mut Assembler) be_sub_lsl(dest int, base int, index int, sh int) {
    if a.arch == 0 {
        a.sub_lsl(map_reg(dest), map_reg(base), map_reg(index), sh)
        <<
    }
    a.be_shl_imm(index, index, sh)
    a.be_sub(dest, base, index)
    <<
}

fn (a &mut Assembler) be_load(dest int, base int, offset int) {
    if a.arch == 1 {
        a.xbe_load(dest, base, offset)
    } else {
        if a.arch == 2 {
            a.tbe_load(dest, base, offset)
        } else if a.arch == 3 {
            a.rbe_load(dest, base, offset)
            } else if a.arch == 4 {
                a.lbe_load(dest, base, offset)
        } else if a.arch == 5 {
                a.vbe_load(dest, base, offset)
        } else {
            d := map_reg(dest)
            b := map_reg(base)
            // LDUR signed 9-bit is -256..255; LDR unsigned scaled is 0..32760.
            // Large frame slots (nbody temps) previously paid mov+2×sub+mem.
            // Prefer one shifted SUB/ADD plus a residual LDUR when the
            // remainder fits unscaled imm9.
            if offset >= -256 && offset <= 32760 {
                a.load_offset(d, b, offset)
            } else if offset < 0 {
                abs_off := 0 - offset
                mut hi := 0
                mut lo := abs_off
                if abs_off > 4095 {
                    hi = (abs_off >> 12) << 12
                    lo = abs_off - hi
                }
                if hi == 0 {
                    a.sub_imm(17, b, lo)
                    a.ldr(d, 17, 0)
                } else if lo <= 256 {
                    hi12 := (hi >> 12) & 4095
                    a.emit32(3506438144 | (1 << 22) | (hi12 << 10) | (b << 5) | 17)
                    if lo == 0 {
                        a.ldr(d, 17, 0)
                    } else {
                        a.ldur(d, 17, 0 - lo)
                    }
                } else {
                    a.sub_imm(17, b, abs_off)
                    a.ldr(d, 17, 0)
                }
            } else if offset > 4095 && (offset & 4095) <= 255 && (offset >> 12) <= 4095 {
                hi12 := (offset >> 12) & 4095
                lo12 := offset & 4095
                a.emit32(2432696320 | (1 << 22) | (hi12 << 10) | (b << 5) | 17)
                if lo12 == 0 {
                    a.ldr(d, 17, 0)
                } else {
                    a.ldur(d, 17, lo12)
                }
            } else {
                a.mov_reg(17, b)
                a.add_imm(17, 17, offset)
                a.ldur(d, 17, 0)
            }
        }
    }
}

fn (a &mut Assembler) be_store(base int, offset int, src int) {
    if a.arch == 1 {
        a.xbe_store(base, offset, src)
    } else {
        if a.arch == 2 {
            a.tbe_store(base, offset, src)
        } else if a.arch == 3 {
            a.rbe_store(base, offset, src)
            } else if a.arch == 4 {
                a.lbe_store(base, offset, src)
        } else if a.arch == 5 {
                a.vbe_store(base, offset, src)
        } else {
            b := map_reg(base)
            s := map_reg(src)
            if offset >= -256 && offset <= 32760 {
                a.store_offset(s, b, offset)
            } else if offset < 0 {
                abs_off := 0 - offset
                mut hi := 0
                mut lo := abs_off
                if abs_off > 4095 {
                    hi = (abs_off >> 12) << 12
                    lo = abs_off - hi
                }
                if hi == 0 {
                    a.sub_imm(17, b, lo)
                    a.str(s, 17, 0)
                } else if lo <= 256 {
                    hi12 := (hi >> 12) & 4095
                    a.emit32(3506438144 | (1 << 22) | (hi12 << 10) | (b << 5) | 17)
                    if lo == 0 {
                        a.str(s, 17, 0)
                    } else {
                        a.stur(s, 17, 0 - lo)
                    }
                } else {
                    a.sub_imm(17, b, abs_off)
                    a.str(s, 17, 0)
                }
            } else if offset > 4095 && (offset & 4095) <= 255 && (offset >> 12) <= 4095 {
                hi12 := (offset >> 12) & 4095
                lo12 := offset & 4095
                a.emit32(2432696320 | (1 << 22) | (hi12 << 10) | (b << 5) | 17)
                if lo12 == 0 {
                    a.str(s, 17, 0)
                } else {
                    a.stur(s, 17, lo12)
                }
            } else {
                a.mov_reg(17, b)
                a.add_imm(17, 17, offset)
                a.stur(s, 17, 0)
            }
        }
    }
}

fn (a &mut Assembler) be_store_byte(base int, offset int, src int) {
    if a.arch == 1 {
        a.xbe_store_byte(base, offset, src)
    } else {
        if a.arch == 2 {
            a.tbe_store_byte(base, offset, src)
        } else if a.arch == 3 {
            a.rbe_store_byte(base, offset, src)
            } else if a.arch == 4 {
                a.lbe_store_byte(base, offset, src)
        } else if a.arch == 5 {
                a.vbe_store_byte(base, offset, src)
        } else {
            b := map_reg(base)
            s := map_reg(src)
            if offset >= -255 && offset <= 4095 {
                a.store_byte_offset(s, b, offset)
            } else {
                a.mov_reg(17, b)
                if offset >= 0 {
                    a.add_imm(17, 17, offset)
                } else {
                    a.sub_imm(17, 17, -offset)
                }
                a.sturb(s, 17, 0)
            }
        }
    }
}

fn (a &mut Assembler) be_load_byte(dest int, base int, offset int) {
    if a.arch == 1 {
        a.xbe_load_byte(dest, base, offset)
    } else {
        if a.arch == 2 {
            a.tbe_load_byte(dest, base, offset)
        } else if a.arch == 3 {
            a.rbe_load_byte(dest, base, offset)
            } else if a.arch == 4 {
                a.lbe_load_byte(dest, base, offset)
        } else if a.arch == 5 {
                a.vbe_load_byte(dest, base, offset)
        } else {
            d := map_reg(dest)
            b := map_reg(base)
            if offset >= -255 && offset <= 4095 {
                a.load_byte_offset(d, b, offset)
            } else {
                a.mov_reg(17, b)
                if offset >= 0 {
                    a.add_imm(17, 17, offset)
                } else {
                    a.sub_imm(17, 17, -offset)
                }
                a.ldurb(d, 17, 0)
            }
        }
    }
}

