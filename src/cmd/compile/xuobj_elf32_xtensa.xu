@main
// Xtensa (ESP32) ELF32 ET_REL writer for `--emit-obj -o x.o` on
// xtensa-esp32-none. The object is linked by a host C toolchain (ESP-IDF).
// Exports: `xu_rt_init` and every `_rom_cb*` windowed entry. Externals named
// by c_call6 stay undefined. All absolute references are R_XTENSA_32 on
// inline literals; branches/calls inside .text are already PC-relative.

// EM_XTENSA=94 R_XTENSA_32=1 EF_XTENSA (as emitted by esp32 gcc)=0x300

fn xt_elf_is_export(name &string) bool {
    if str_eq_lit(name, "xu_rt_init") { << true }
    if name.len <= 7 { << false }
    pre := "_rom_cb"
    for i in 0:7 {
        if name[i] != pre[i] { << false }
    }
    << true
}

fn xt_elf_put_sym(b $&[]int, name int, value int, info int, shndx int) {
    elf_put_u32(b, name)
    elf_put_u32(b, value)
    elf_put_u32(b, 0)
    elf_put_u8(b, info)
    elf_put_u8(b, 0)
    elf_put_u16(b, shndx)
}

fn xt_elf_put_shdr(b $&[]int, name int, ty int, flags int, off int, size int, link int, info int, align int, entsize int) {
    elf_put_u32(b, name)
    elf_put_u32(b, ty)
    elf_put_u32(b, flags)
    elf_put_u32(b, 0)
    elf_put_u32(b, off)
    elf_put_u32(b, size)
    elf_put_u32(b, link)
    elf_put_u32(b, info)
    elf_put_u32(b, align)
    elf_put_u32(b, entsize)
}

fn xt_elf_write_obj(a &Assembler, out_path string) int {
    $strtab := []int{}
    strtab.push(0)
    $syms := []int{}
    xt_elf_put_sym($&syms, 0, 0, 0, 0)
    xt_elf_put_sym($&syms, 0, 0, 3, 1) // .text section symbol
    xt_elf_put_sym($&syms, 0, 0, 3, 2) // .data section symbol
    first_global := 3
    $nsym := 3
    $nexport := 0
    for i in 0:a.labels.len {
        nm := lab_name(&a.labels, i)
        off := lab_off(&a.labels, i)
        if off >= 0 && !lab_is_data(&a.labels, i) && xt_elf_is_export(&nm) {
            xt_elf_put_sym($&syms, elf_strtab_add($&strtab, nm), off, 0x12, 1)
            nsym += 1
            nexport += 1
        }
    }
    if nexport == 0 {
        eprintln("error: xtensa object exports nothing (use rom_callback(fn) to export a C entry)")
        << 1
    }
    $und_names := []string{}
    $und_idx := []int{}
    $rela := []int{}
    for r in 0:a.xt_rel_off.len {
        lab := a.xt_rel_lab[r] + ""
        idx := a.label_index(lab + "")
        $sym := 0
        $addend := 0
        if idx >= 0 && idx < a.labels.len && lab_off(&a.labels, idx) >= 0 {
            sym = 1
            if lab_is_data(&a.labels, idx) { sym = 2 }
            addend = lab_off(&a.labels, idx)
        } else {
            for u in 0:und_names.len {
                if und_names[u] == lab { sym = und_idx[u] }
            }
            if sym == 0 {
                xt_elf_put_sym($&syms, elf_strtab_add($&strtab, lab + ""), 0, 0x10, 0)
                und_names.push(lab + "")
                und_idx.push(nsym)
                sym = nsym
                nsym += 1
            }
        }
        elf_put_u32($&rela, a.xt_rel_off[r])
        elf_put_u32($&rela, (sym << 8) | 1)
        elf_put_u32($&rela, addend)
    }

    $shstr := []int{}
    shstr.push(0)
    n_text := elf_strtab_add($&shstr, ".text")
    n_data := elf_strtab_add($&shstr, ".data")
    n_rela := elf_strtab_add($&shstr, ".rela.text")
    n_sym := elf_strtab_add($&shstr, ".symtab")
    n_str := elf_strtab_add($&shstr, ".strtab")
    n_shs := elf_strtab_add($&shstr, ".shstrtab")

    $out := []int{}
    rt_emit_zeros_list($&out, 52)
    pad_text := elf_align(out.len, 4)
    elf_pad_to($&out, pad_text)
    off_text := out.len
    elf_append_bytes($&out, &a.code)
    size_text := out.len - off_text
    pad_data := elf_align(out.len, 16)
    elf_pad_to($&out, pad_data)
    off_data := out.len
    elf_append_bytes($&out, &a.data)
    size_data := out.len - off_data
    pad_rela := elf_align(out.len, 4)
    elf_pad_to($&out, pad_rela)
    off_rela := out.len
    elf_append_bytes($&out, &rela)
    off_sym := out.len
    elf_append_bytes($&out, &syms)
    off_str := out.len
    elf_append_bytes($&out, &strtab)
    off_shs := out.len
    elf_append_bytes($&out, &shstr)
    pad_sh := elf_align(out.len, 4)
    elf_pad_to($&out, pad_sh)
    off_sh := out.len
    xt_elf_put_shdr($&out, 0, 0, 0, 0, 0, 0, 0, 0, 0)
    xt_elf_put_shdr($&out, n_text, 1, 6, off_text, size_text, 0, 0, 4, 0)
    xt_elf_put_shdr($&out, n_data, 1, 3, off_data, size_data, 0, 0, 16, 0)
    xt_elf_put_shdr($&out, n_rela, 4, 64, off_rela, rela.len, 4, 1, 4, 12)
    xt_elf_put_shdr($&out, n_sym, 2, 0, off_sym, syms.len, 5, first_global, 4, 16)
    xt_elf_put_shdr($&out, n_str, 3, 0, off_str, strtab.len, 0, 0, 1, 0)
    xt_elf_put_shdr($&out, n_shs, 3, 0, off_shs, shstr.len, 0, 0, 1, 0)

    $h := []int{}
    h.push(0x7F)
    h.push(69)
    h.push(76)
    h.push(70)
    h.push(1) // ELFCLASS32
    h.push(1) // little-endian
    h.push(1) // EV_CURRENT
    rt_emit_zeros_list($&h, 9)
    elf_put_u16($&h, 1)  // ET_REL
    elf_put_u16($&h, 94) // EM_XTENSA
    elf_put_u32($&h, 1)
    elf_put_u32($&h, 0)  // e_entry
    elf_put_u32($&h, 0)  // e_phoff
    elf_put_u32($&h, off_sh)
    elf_put_u32($&h, 0x300)
    elf_put_u16($&h, 52)
    elf_put_u16($&h, 0)
    elf_put_u16($&h, 0)
    elf_put_u16($&h, 40)
    elf_put_u16($&h, 7)
    elf_put_u16($&h, 6)
    for i in 0:52 { out[i] = h[i] }

    write_file(out_path, string_from_bytes(out)) or (err) {
        eprintln(cli_prog() + ": cannot write " + out_path)
        << 1
    }
    << 0
}

fn rt_emit_zeros_list(b $&[]int, n int) {
    for _ in 0:n { b.push(0) }
}
