@main

#xu/types

// Prove the entire self-loop, including both local updates. A SIMD prefix
// leaves ordinary iterations to materialize every MIR temp and live-out.
fn match_x64_byte_sum(m &types.Mir, fi int, bi int) VecPat {
    if types.mir_btkind(m, fi, bi) != 2 || types.mir_btb(m, fi, bi) != bi { << vec_none() }
    mut first := -1
    mut second := -1
    mut indexed := -1
    mut bins := 0
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == types.MI_STORE_LOCAL {
            if first < 0 { first = ii }
            else if second < 0 { second = ii }
            else { << vec_none() }
        } else if k == types.MI_LOAD_INDEX {
            if indexed >= 0 { << vec_none() }
            width := types.mir_id(m, fi, ii)
            if width != 1 && width != -1 { << vec_none() }
            indexed = ii
        } else if k == types.MI_BIN { bins += 1 }
        else if k != types.MI_NOP && k != types.MI_LOAD_LOCAL { << vec_none() }
        ii = types.mir_inext(m, fi, ii)
    }
    if first < 0 || second < 0 || indexed < 0 || bins != 3 { << vec_none() }
    acc := types.mir_ia(m, fi, first)
    ind := types.mir_ia(m, fi, second)
    if acc == ind || types.mir_local_ty(m, fi, acc) != 1 || types.mir_local_ty(m, fi, ind) != 1 { << vec_none() }
    if types.mir_local_nslots(m, fi, acc) != 1 || types.mir_local_nslots(m, fi, ind) != 1 { << vec_none() }
    next := types.mir_ib(m, fi, second)
    if !vec_is_add1_of(m, fi, bi, next, types.MIR_LOCAL_OPERAND_BASE + ind) { << vec_none() }
    inc := x64_loop_def(m, fi, bi, next)
    if !x64_loop_after(m, fi, bi, first, inc) || !x64_loop_after(m, fi, bi, inc, second) { << vec_none() }
    cmp := x64_loop_def(m, fi, bi, types.mir_bta(m, fi, bi))
    if cmp < 0 { << vec_none() }
    lhs := x64_loop_def(m, fi, bi, types.mir_ic(m, fi, cmp))
    if !x64_loop_after(m, fi, bi, second, lhs) || !x64_loop_after(m, fi, bi, lhs, cmp) { << vec_none() }
    mut p := x64_loop_limit(m, fi, bi, cmp, types.MIR_LOCAL_OPERAND_BASE + ind, next)
    if p.kind == 0 || p.limit_t == types.MIR_LOCAL_OPERAND_BASE + acc { << vec_none() }
    if !vec_load_is_local(m, fi, bi, types.mir_ic(m, fi, indexed), ind) { << vec_none() }
    add := x64_loop_def(m, fi, bi, types.mir_ib(m, fi, first))
    if add < 0 || types.mir_ikind(m, fi, add) != types.MI_BIN || types.mir_ib(m, fi, add) != 1 { << vec_none() }
    value := types.mir_ia(m, fi, indexed)
    c := types.mir_ic(m, fi, add)
    d := types.mir_id(m, fi, add)
    mut old := -1
    if c == value && vec_load_is_local(m, fi, bi, d, acc) { old = d }
    else if d == value && vec_load_is_local(m, fi, bi, c, acc) { old = c }
    if old < 0 { << vec_none() }
    if !x64_loop_after(m, fi, bi, x64_loop_def(m, fi, bi, old), add) { << vec_none() }
    if !x64_loop_after(m, fi, bi, indexed, add) || !x64_loop_after(m, fi, bi, add, first) { << vec_none() }
    mut desc := types.mir_ib(m, fi, indexed)
    if desc < 0 || emit_index_base_ty(m, fi, desc) != 3 { << vec_none() }
    // Keep a preheader snapshot. A descriptor loaded in the body may use
    // its local directly: this body writes only the two scalar int locals.
    mut desc_load := -1
    if desc < types.MIR_LOCAL_OPERAND_BASE { desc_load = x64_loop_def(m, fi, bi, desc) }
    if desc_load >= 0 {
        if types.mir_ikind(m, fi, desc_load) != types.MI_LOAD_LOCAL { << vec_none() }
        loc := types.mir_ib(m, fi, desc_load)
        if types.mir_local_ty(m, fi, loc) != 3 || types.mir_local_nslots(m, fi, loc) != 3 { << vec_none() }
        if types.mir_temp_nslots(m, fi, desc) != 3 || !x64_loop_after(m, fi, bi, desc_load, indexed) { << vec_none() }
        desc = types.MIR_LOCAL_OPERAND_BASE + loc
    }
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == types.MI_BIN && ii != inc && ii != cmp && ii != add { << vec_none() }
        if k == types.MI_LOAD_LOCAL && ii != desc_load {
            loc := types.mir_ib(m, fi, ii)
            if loc != ind && loc != acc { << vec_none() }
            dest := types.mir_ia(m, fi, ii)
            if types.mir_temp_ty(m, fi, dest) != 1 || types.mir_temp_nslots(m, fi, dest) != 1 { << vec_none() }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    p.kind = VP_X64_BYTE_SUM
    p.ind = types.MIR_LOCAL_OPERAND_BASE + ind
    p.acc = types.MIR_LOCAL_OPERAND_BASE + acc
    p.arr = desc
    << p
}

fn emit_x64_byte_sum_prefix(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int) {
    if !a.vp_on(VP_X64_BYTE_SUM) { << }
    p := match_x64_byte_sum(m, fi, bi)
    if p.kind == 0 { << }
    // Fixed homes V2-V5 and S1 survive. Exclude all FP residency because
    // xmm0-xmm2 are scratch, including on Windows where they are volatile.
    for t in 0:fr.temp_slot.len {
        if is_fp_vreg_slot(fr.temp_slot[t]) { << }
        if is_vreg_slot(fr.temp_slot[t]) {
            home := vreg_slot_home(fr.temp_slot[t])
            if (home < 2 || home > 5) && home != 9 { << }
        }
    }
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi) + "_x64_bytes"
    a.vp_hit(VP_X64_BYTE_SUM)
    done := pref + "_scalar"
    x64_loop_load(a, m, fi, fr, p.ind, 18)
    if p.limit_t >= 0 { x64_loop_load(a, m, fi, fr, p.limit_t, 19) }
    else { a.vm_mov_imm64(19, p.limit) }
    a.vm_cmp_imm(18, 0)
    a.jlt(done + "")
    a.cmp(18, 19)
    a.jge(done + "")
    emit_index_desc_addr(a, m, fi, fr, p.arr)
    a.load(1, 0, -8)
    a.cmp(1, 19)
    a.jlt(done + "")
    a.load(21, 0, 0)
    a.vm_cbz(21, done + "")
    a.add(1, 21, 19)
    a.cmp(1, 21)
    a.x64_jcc(2, done + "")
    a.vm_sub_imm(19, 19, 16)
    a.cmp(18, 19)
    a.jge(done + "")
    a.add(21, 21, 18)
    a.x64_pxor(0, 0)
    a.x64_pxor(1, 1)
    a.label(pref + "_wide")
    a.x64_movdqu_load(2, x64_map_reg(21), 0)
    a.x64_packed_reg(246, 2, 0) // psadbw: unsigned byte sums in two qwords
    a.x64_packed_reg(212, 1, 2) // paddq, modulo 2^64 like the scalar sum
    a.vm_add_imm(21, 21, 16)
    a.vm_add_imm(18, 18, 16)
    a.cmp(18, 19)
    a.jlt(pref + "_wide")
    a.x64_packed_reg(111, 2, 1)
    a.x64_psrldq(2, 8)
    a.x64_packed_reg(212, 1, 2)
    a.x64_movq_r_from_xmm(x64_map_reg(14), 1)
    x64_loop_load(a, m, fi, fr, p.acc, 0)
    a.add(0, 0, 14)
    a.store(15, slot_off(fr.local_slot[p.acc - types.MIR_LOCAL_OPERAND_BASE]), 0)
    x64_loop_store_ind(a, m, fi, fr, p.ind)
    a.label(done)
}
