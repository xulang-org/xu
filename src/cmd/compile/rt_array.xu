@main

#xu/types

fn rt_emit_arr_push(a &mut Assembler) {
    a.label("_rt_arr_push")
    a.prologue(96)
    a.store(15, -8, 18)  // descriptor
    a.store(15, -16, 19) // element
    a.store(15, -24, 20) // element size
    a.load(0, 18, 0)
    a.store(15, -32, 0)  // ptr
    a.load(0, 18, -8)
    a.store(15, -40, 0)  // len
    a.load(0, 18, -16)
    a.store(15, -48, 0)  // cap
    // Reject malformed descriptors before any growth arithmetic.  A zero
    // element size would make the quotient overflow check divide by zero.
    a.load(0, 15, -24)
    a.vm_cmp_imm(0, 0)
    a.jle("_rt_al_oom")
    a.load(0, 15, -40)
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_al_oom")
    a.load(0, 15, -48)
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_al_oom")

    // Compute the exact post-push requirement before growth.  A malformed
    // descriptor with len > cap must not get a too-small buffer and then
    // overflow while copying the existing elements.
    a.load(0, 15, -40)
    a.vm_add_imm(0, 0, 1)
    a.load(1, 15, -40)
    a.cmp(0, 1)
    a.jae("_rt_ap_required_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ap_required_ok")
    a.store(15, -80, 0) // required len

    a.load(0, 15, -40)
    a.load(1, 15, -48)
    a.cmp(0, 1)
    a.jlt("_rt_ap_room")

    // new_cap = max(8, cap * 2), then keep doubling until required len.
    a.load(2, 15, -48)
    a.mov(0, 2)
    a.shl_imm(2, 2, 1)
    a.cmp(2, 0)
    a.jae("_rt_ap_cap_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ap_cap_ok")
    a.vm_cmp_imm(2, 8)
    a.jge("_rt_ap_cap_min_ok")
    a.vm_mov_imm(2, 8)
    a.label("_rt_ap_cap_min_ok")
    a.label("_rt_ap_caploop")
    a.load(0, 15, -80)
    a.cmp(2, 0)
    a.jge("_rt_ap_capset")
    a.mov(0, 2)
    a.shl_imm(2, 2, 1)
    a.cmp(2, 0)
    a.jae("_rt_ap_caploop")
    a.jmp("_rt_al_oom")
    a.label("_rt_ap_capset")
    a.store(15, -56, 2)
    // new_buf = alloc(new_cap * elem_size)
    a.load(3, 15, -24)
    a.mul(0, 2, 3)
    a.div(1, 0, 3)
    a.cmp(1, 2)
    a.jeq("_rt_ap_bytes_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ap_bytes_ok")
    a.store(15, -72, 0)
    a.mov(18, 0)
    a.call("_rt_alloc")
    a.store(15, -64, 14)

    // Copy used bytes (word loop when 8-aligned).
    a.load(0, 15, -40)
    a.load(1, 15, -24)
    a.mul(2, 0, 1)
    a.div(3, 2, 1)
    a.cmp(3, 0)
    a.jeq("_rt_ap_copy_bytes_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ap_copy_bytes_ok")
    a.mul(1, 0, 1)
    a.store(15, -72, 1)
    a.vm_mov_imm(4, 0)
    a.mov(0, 1)
    a.vm_mov_imm(3, 7)
    a.iand(0, 0, 3)
    a.vm_cbnz(0, "_rt_ap_c1")
    a.label("_rt_ap_c1w")
    a.load(1, 15, -72)
    a.cmp(4, 1)
    a.jge("_rt_ap_c1_done")
    a.load(2, 15, -32)
    a.add(2, 2, 4)
    a.load(5, 2, 0)
    a.load(3, 15, -64)
    a.add(3, 3, 4)
    a.store(3, 0, 5)
    a.vm_add_imm(4, 4, 8)
    a.jmp("_rt_ap_c1w")
    a.label("_rt_ap_c1")
    a.load(1, 15, -72)
    a.cmp(4, 1)
    a.jge("_rt_ap_c1_done")
    a.load(2, 15, -32)
    a.add(2, 2, 4)
    a.load_byte(5, 2, 0)
    a.load(3, 15, -64)
    a.add(3, 3, 4)
    a.store_byte(3, 0, 5)
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_ap_c1")
    a.label("_rt_ap_c1_done")

    // Free an owned old buffer, then write ptr/cap back.
    a.load(0, 15, -48)
    a.vm_cbz(0, "_rt_ap_nofree")
    a.load(18, 15, -32)
    a.call("_rt_free")
    a.label("_rt_ap_nofree")
    a.load(0, 15, -8)
    a.load(1, 15, -64)
    a.store(0, 0, 1)
    a.load(1, 15, -56)
    a.store(0, -16, 1)
    a.load(1, 15, -64)
    a.store(15, -32, 1)

    // Copy one element; size 8 / 1 take word / byte fast paths.
    a.label("_rt_ap_room")
    a.load(0, 15, -40)
    a.load(1, 15, -24)
    a.mul(2, 0, 1)
    a.div(3, 2, 1)
    a.cmp(3, 0)
    a.jeq("_rt_ap_room_offset_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ap_room_offset_ok")
    a.load(1, 15, -24)
    a.vm_cmp_imm(1, 8)
    a.jeq("_rt_ap_room8")
    a.vm_cmp_imm(1, 1)
    a.jeq("_rt_ap_room1")
    a.vm_mov_imm(4, 0)
    a.label("_rt_ap_c2")
    a.load(1, 15, -24)
    a.cmp(4, 1)
    a.jge("_rt_ap_c2_done")
    a.load(2, 15, -32)
    a.load(0, 15, -40)
    a.load(1, 15, -24)
    a.mul(0, 0, 1)
    a.add(2, 2, 0)
    a.add(2, 2, 4)
    a.load(3, 15, -16)
    a.mov(0, 4)
    a.shr_imm(0, 0, 3)
    a.shl_imm(0, 0, 3)
    a.sub(3, 3, 0)
    a.mov(0, 4)
    a.vm_mov_imm(1, 7)
    a.iand(0, 0, 1)
    a.add(3, 3, 0)
    a.load_byte(5, 3, 0)
    a.store_byte(2, 0, 5)
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_ap_c2")
    a.label("_rt_ap_room8")
    a.load(2, 15, -32)
    a.load(0, 15, -40)
    a.shl_imm(0, 0, 3)
    a.load(1, 15, -40)
    a.cmp(0, 1)
    a.jae("_rt_ap_room8_offset_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ap_room8_offset_ok")
    a.add(2, 2, 0)
    a.load(3, 15, -16)
    a.load(5, 3, 0)
    a.store(2, 0, 5)
    a.jmp("_rt_ap_c2_done")
    a.label("_rt_ap_room1")
    a.load(2, 15, -32)
    a.load(0, 15, -40)
    a.add(2, 2, 0)
    a.load(3, 15, -16)
    a.load_byte(5, 3, 0)
    a.store_byte(2, 0, 5)
    a.label("_rt_ap_c2_done")
    a.load(0, 15, -8)
    a.load(1, 15, -40)
    a.vm_add_imm(1, 1, 1)
    a.store(0, -8, 1)
    a.epilogue()
    <<
}

// A0=&desc, A1=min_cap, A2=elem_size. Ensures cap >= min_cap.
fn rt_emit_arr_grow(a &mut Assembler) {
    a.label("_rt_arr_grow")
    a.prologue(80)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    a.load(0, 18, 0)
    a.store(15, -32, 0)
    a.load(0, 18, -8)
    a.store(15, -40, 0)
    a.load(0, 18, -16)
    a.store(15, -48, 0)
    a.load(0, 15, -24)
    a.vm_cmp_imm(0, 0)
    a.jle("_rt_al_oom")
    a.load(0, 15, -40)
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_al_oom")
    a.load(0, 15, -48)
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_al_oom")
    a.load(0, 15, -16)
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_al_oom")
    a.load(1, 15, -48)
    a.cmp(0, 1)
    a.jle("_rt_ag_done")
    a.mov(2, 0)
    a.vm_cmp_imm(2, 8)
    a.jge("_rt_ag_capset")
    a.vm_mov_imm(2, 8)
    a.label("_rt_ag_capset")
    a.store(15, -56, 2)
    a.load(3, 15, -24)
    a.mul(0, 2, 3)
    a.div(1, 0, 3)
    a.cmp(1, 2)
    a.jeq("_rt_ag_bytes_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ag_bytes_ok")
    a.mov(18, 0)
    a.call("_rt_alloc")
    a.store(15, -64, 14)
    a.vm_mov_imm(4, 0)
    a.load(1, 15, -24)
    a.vm_cmp_imm(1, 8)
    a.jeq("_rt_ag_c8")
    a.load(0, 15, -40)
    a.load(1, 15, -24)
    a.mul(2, 0, 1)
    a.div(3, 2, 1)
    a.cmp(3, 0)
    a.jeq("_rt_ag_copy_bytes_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ag_copy_bytes_ok")
    a.label("_rt_ag_c1")
    a.load(0, 15, -40)
    a.load(1, 15, -24)
    a.mul(1, 0, 1)
    a.cmp(4, 1)
    a.jge("_rt_ag_copy_done")
    a.load(2, 15, -32)
    a.add(2, 2, 4)
    a.load_byte(5, 2, 0)
    a.load(3, 15, -64)
    a.add(3, 3, 4)
    a.store_byte(3, 0, 5)
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_ag_c1")
    a.label("_rt_ag_c8")
    a.load(0, 15, -40)
    a.shl_imm(1, 0, 3)
    a.cmp(1, 0)
    a.jae("_rt_ag_copy8_bytes_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ag_copy8_bytes_ok")
    a.cmp(4, 1)
    a.jge("_rt_ag_copy_done")
    a.load(2, 15, -32)
    a.add(2, 2, 4)
    a.load(5, 2, 0)
    a.load(3, 15, -64)
    a.add(3, 3, 4)
    a.store(3, 0, 5)
    a.vm_add_imm(4, 4, 8)
    a.jmp("_rt_ag_c8")
    a.label("_rt_ag_copy_done")
    a.load(0, 15, -48)
    a.vm_cbz(0, "_rt_ag_nofree")
    a.load(18, 15, -32)
    a.call("_rt_free")
    a.label("_rt_ag_nofree")
    a.load(0, 15, -8)
    a.load(1, 15, -64)
    a.store(0, 0, 1)
    a.load(1, 15, -56)
    a.store(0, -16, 1)
    a.label("_rt_ag_done")
    a.epilogue()
    <<
}

// make_ints(n): one owned []int of length n, zeroed. n < 0 or n*8 overflow
// is a loud failure. Empty n returns the canonical zero descriptor.
fn rt_emit_make_ints(a &mut Assembler) {
    a.data_label("_rt_mi_msg")
    rt_emit_bytes(a, "make_ints: invalid length\n")
    a.label("_rt_make_ints")
    a.prologue(48)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.load(0, 15, -16)
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_mi_fail")
    a.vm_cbz(0, "_rt_mi_empty")
    a.shl_imm(1, 0, 3)
    a.shr_imm(2, 1, 3)
    a.cmp(2, 0)
    a.jeq("_rt_mi_bytes_ok")
    a.jmp("_rt_mi_fail")
    a.label("_rt_mi_bytes_ok")
    a.mov(18, 1)
    a.call("_rt_alloc")
    a.store(15, -24, 14)
    a.vm_mov_imm(4, 0)
    a.vm_mov_imm(5, 0)
    a.label("_rt_mi_z")
    a.load(1, 15, -16)
    a.shl_imm(1, 1, 3)
    a.cmp(4, 1)
    a.jge("_rt_mi_zd")
    a.load(3, 15, -24)
    a.add(3, 3, 4)
    a.store(3, 0, 5)
    a.vm_add_imm(4, 4, 8)
    a.jmp("_rt_mi_z")
    a.label("_rt_mi_zd")
    a.load(0, 15, -8)
    a.load(1, 15, -24)
    a.store(0, 0, 1)
    a.load(1, 15, -16)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_mi_empty")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_mi_fail")
    a.lea(18, "_rt_mi_msg")
    a.vm_mov_imm(19, 26)
    a.vm_mov_imm(20, 2)
    a.call("_rt_write")
    rt_exit(a, 1)
    a.epilogue()
    <<
}

// make_string(n): one owned string of length n, zeroed. n < 0 aborts.
// Empty n returns the canonical zero descriptor (cap 0, not an allocation).
// cap == n so a later byte store can tell this buffer from a literal.
fn rt_emit_make_string(a &mut Assembler) {
    a.data_label("_rt_ms_msg")
    rt_emit_bytes(a, "make_string: invalid length\n")
    a.label("_rt_make_string")
    a.prologue(48)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.load(0, 15, -16)
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_ms_fail")
    a.vm_cbz(0, "_rt_ms_empty")
    a.mov(18, 0)
    a.call("_rt_alloc")
    a.store(15, -24, 14)
    a.vm_mov_imm(4, 0)
    a.vm_mov_imm(5, 0)
    a.label("_rt_ms_z8")
    a.load(1, 15, -16)
    a.sub(0, 1, 4)
    a.vm_cmp_imm(0, 8)
    a.jlt("_rt_ms_zt")
    a.load(3, 15, -24)
    a.add(3, 3, 4)
    a.store(3, 0, 5)
    a.vm_add_imm(4, 4, 8)
    a.jmp("_rt_ms_z8")
    a.label("_rt_ms_zt")
    a.load(1, 15, -16)
    a.cmp(4, 1)
    a.jge("_rt_ms_zd")
    a.load(3, 15, -24)
    a.add(3, 3, 4)
    a.store_byte(3, 0, 5)
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_ms_zt")
    a.label("_rt_ms_zd")
    a.load(0, 15, -8)
    a.load(1, 15, -24)
    a.store(0, 0, 1)
    a.load(1, 15, -16)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_ms_empty")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_ms_fail")
    a.lea(18, "_rt_ms_msg")
    a.vm_mov_imm(19, 28)
    a.vm_mov_imm(20, 2)
    a.call("_rt_write")
    rt_exit(a, 1)
    a.epilogue()
    <<
}

// Append four ints (elem size 8): A0=&desc, A1..A4 = values.
fn rt_emit_arr_push4(a &mut Assembler) {
    a.label("_rt_arr_push4")
    a.prologue(112)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    a.store(15, -32, 21)
    a.store(15, -40, 22)
    a.load(0, 18, 0)
    a.store(15, -48, 0)
    a.load(0, 18, -8)
    a.store(15, -56, 0)
    a.load(0, 18, -16)
    a.store(15, -64, 0)
    a.load(0, 15, -56)
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_al_oom")
    a.vm_add_imm(0, 0, 4)
    a.load(1, 15, -56)
    a.cmp(0, 1)
    a.jlt("_rt_al_oom")
    a.load(1, 15, -64)
    a.vm_cmp_imm(1, 0)
    a.jlt("_rt_al_oom")
    a.cmp(0, 1)
    a.jle("_rt_ap4_room")
    a.load(2, 15, -64)
    a.mov(0, 2)
    a.shl_imm(2, 2, 1)
    a.cmp(2, 0)
    a.jae("_rt_ap4_cap_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ap4_cap_ok")
    a.vm_cmp_imm(2, 8)
    a.jge("_rt_ap4_caploop")
    a.vm_mov_imm(2, 8)
    a.label("_rt_ap4_caploop")
    a.load(0, 15, -56)
    a.vm_add_imm(0, 0, 4)
    a.cmp(2, 0)
    a.jge("_rt_ap4_capset")
    a.mov(0, 2)
    a.shl_imm(2, 2, 1)
    a.cmp(2, 0)
    a.jae("_rt_ap4_caploop")
    a.jmp("_rt_al_oom")
    a.label("_rt_ap4_capset")
    a.store(15, -72, 2)
    a.shl_imm(0, 2, 3)
    a.cmp(0, 2)
    a.jae("_rt_ap4_bytes_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ap4_bytes_ok")
    a.store(15, -88, 0)
    a.mov(18, 0)
    a.call("_rt_alloc")
    a.store(15, -80, 14)
    a.load(0, 15, -56)
    a.shl_imm(1, 0, 3)
    a.vm_mov_imm(4, 0)
    a.label("_rt_ap4_c1")
    a.cmp(4, 1)
    a.jge("_rt_ap4_c1_done")
    a.load(2, 15, -48)
    a.add(2, 2, 4)
    a.load(5, 2, 0)
    a.load(3, 15, -80)
    a.add(3, 3, 4)
    a.store(3, 0, 5)
    a.vm_add_imm(4, 4, 8)
    a.jmp("_rt_ap4_c1")
    a.label("_rt_ap4_c1_done")
    a.load(0, 15, -64)
    a.vm_cbz(0, "_rt_ap4_nofree")
    a.load(18, 15, -48)
    a.call("_rt_free")
    a.label("_rt_ap4_nofree")
    a.load(0, 15, -8)
    a.load(1, 15, -80)
    a.store(0, 0, 1)
    a.load(1, 15, -72)
    a.store(0, -16, 1)
    a.load(1, 15, -80)
    a.store(15, -48, 1)

    a.label("_rt_ap4_room")
    a.load(2, 15, -48)
    a.load(0, 15, -56)
    a.shl_imm(0, 0, 3)
    a.load(1, 15, -56)
    a.cmp(0, 1)
    a.jae("_rt_ap4_room_bytes_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ap4_room_bytes_ok")
    a.add(2, 2, 0)
    a.load(5, 15, -16)
    a.store(2, 0, 5)
    a.load(5, 15, -24)
    a.store(2, 8, 5)
    a.load(5, 15, -32)
    a.store(2, 16, 5)
    a.load(5, 15, -40)
    a.store(2, 24, 5)
    a.load(0, 15, -8)
    a.load(1, 15, -56)
    a.vm_add_imm(1, 1, 4)
    a.store(0, -8, 1)
    a.epilogue()
    <<
}

// Copying array slice: A0=&descriptor, A1=start, A2=end, A3=elem_size, V0=sret.
fn rt_emit_array_slice(a &mut Assembler) {
    a.data_label("_rt_as_msg")
    rt_emit_bytes(a, "slice out of bounds\n")
    // sret -8, desc -16, start -24, end -32, esz -40, ptr -48, len -56, n -64, buf -72
    a.label("_rt_array_slice")
    a.prologue(96)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.store(15, -32, 20)
    a.store(15, -40, 21)
    a.load(0, 18, 0)
    a.store(15, -48, 0)
    a.load(0, 18, -8)
    a.store(15, -56, 0)
    // cap==0 denotes static literals; positive cap must cover len.
    a.load(3, 18, -16)
    a.vm_cmp_imm(3, 0)
    a.jlt("_rt_array_slice_fail")
    a.vm_cbz(3, "_rt_as_cap_ok")
    a.load(2, 15, -56)
    a.cmp(2, 3)
    a.jgt("_rt_array_slice_fail")
    a.label("_rt_as_cap_ok")
    a.load(0, 15, -24)
    a.load(1, 15, -32)
    a.cmp(0, 1)
    a.jgt("_rt_array_slice_fail")
    a.load(2, 15, -56)
    a.cmp(1, 2)
    a.jgt("_rt_array_slice_fail")
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_array_slice_fail")
    a.sub(3, 1, 0)
    a.store(15, -64, 3)
    a.load(4, 15, -40)
    a.vm_cmp_imm(4, 0)
    a.jle("_rt_array_slice_fail")
    a.vm_cbz(3, "_rt_as_empty")
    // A non-empty descriptor must carry a backing pointer; fail closed before
    // the copy loop would dereference a null/corrupt source.
    a.load(5, 15, -48)
    a.vm_cbz(5, "_rt_array_slice_fail")
    // Validate start/end byte offsets before indexing the source buffer.
    a.load(0, 15, -24)
    a.mul(2, 0, 4)
    a.div(3, 2, 4)
    a.cmp(3, 0)
    a.jne("_rt_array_slice_fail")
    a.store(15, -80, 2)
    a.load(0, 15, -32)
    a.mul(2, 0, 4)
    a.div(3, 2, 4)
    a.cmp(3, 0)
    a.jne("_rt_array_slice_fail")
    a.load(5, 15, -48)
    a.store(15, -88, 5)
    a.add(5, 5, 2)
    a.load(0, 15, -88)
    a.cmp(5, 0)
    a.jae("_rt_as_span_ok")
    a.jmp("_rt_array_slice_fail")
    a.label("_rt_as_span_ok")
    a.load(3, 15, -64)
    a.mul(0, 3, 4)
    a.div(1, 0, 4)
    a.cmp(1, 3)
    a.jeq("_rt_as_bytes_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_as_bytes_ok")
    a.mov(18, 0)
    a.call("_rt_alloc")
    a.store(15, -72, 14)
    a.vm_mov_imm(4, 0)
    a.label("_rt_as_copy")
    a.load(0, 15, -64)
    a.load(1, 15, -40)
    a.mul(1, 0, 1)
    a.cmp(4, 1)
    a.jge("_rt_as_done")
    a.load(2, 15, -48)
    a.load(0, 15, -80)
    a.add(2, 2, 0)
    a.add(2, 2, 4)
    a.load_byte(5, 2, 0)
    a.load(3, 15, -72)
    a.add(3, 3, 4)
    a.store_byte(3, 0, 5)
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_as_copy")
    a.label("_rt_as_done")
    a.load(0, 15, -8)
    a.load(1, 15, -72)
    a.store(0, 0, 1)
    a.load(1, 15, -64)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_as_empty")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_array_slice_fail")
    a.lea(18, "_rt_as_msg")
    a.vm_mov_imm(19, 20)
    a.vm_mov_imm(20, 2)
    a.call("_rt_write")
    rt_exit(a, 1)
    a.epilogue()
    <<
}

// Array slice of []string: A0=&descriptor, A1=start, A2=end, V0=sret.
fn rt_emit_array_slice_str(a &mut Assembler) {
    a.data_label("_rt_ass_msg")
    rt_emit_bytes(a, "slice out of bounds\n")
    // sret -8, desc -16, start -24, end -32, ptr -40, len -48, n -56, buf -64,
    // i -72, src_elem -80, slen -88, sdata -96
    a.label("_rt_array_slice_str")
    a.prologue(112)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.store(15, -32, 20)
    a.load(0, 18, 0)
    a.store(15, -40, 0)
    a.load(0, 18, -8)
    a.store(15, -48, 0)
    // cap==0 denotes static literals; positive cap must cover len.
    a.load(3, 18, -16)
    a.vm_cmp_imm(3, 0)
    a.jlt("_rt_ass_fail")
    a.vm_cbz(3, "_rt_ass_cap_ok")
    a.load(2, 15, -48)
    a.cmp(2, 3)
    a.jgt("_rt_ass_fail")
    a.label("_rt_ass_cap_ok")
    a.load(0, 15, -24)
    a.load(1, 15, -32)
    a.cmp(0, 1)
    a.jgt("_rt_ass_fail")
    a.load(2, 15, -48)
    a.cmp(1, 2)
    a.jgt("_rt_ass_fail")
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_ass_fail")
    a.sub(3, 1, 0)
    a.store(15, -56, 3)
    a.vm_cbz(3, "_rt_ass_empty")
    // Validate source span `(start+i)*24` and pointer addition up front.
    // Reject null backing storage for any non-empty result.
    a.load(5, 15, -40)
    a.vm_cbz(5, "_rt_ass_fail")
    a.vm_mov_imm(4, 24)
    a.load(0, 15, -24)
    a.mul(2, 0, 4)
    a.div(3, 2, 4)
    a.cmp(3, 0)
    a.jne("_rt_ass_fail")
    a.store(15, -104, 2)
    a.load(0, 15, -32)
    a.mul(2, 0, 4)
    a.div(3, 2, 4)
    a.cmp(3, 0)
    a.jne("_rt_ass_fail")
    a.load(5, 15, -40)
    a.store(15, -112, 5)
    a.add(5, 5, 2)
    a.load(0, 15, -112)
    a.cmp(5, 0)
    a.jae("_rt_ass_span_ok")
    a.jmp("_rt_ass_fail")
    a.label("_rt_ass_span_ok")
    a.load(3, 15, -56)
    a.mul(0, 3, 4)
    a.div(1, 0, 4)
    a.cmp(1, 3)
    a.jeq("_rt_ass_bytes_ok")
    a.jmp("_rt_al_oom")
    a.label("_rt_ass_bytes_ok")
    a.mov(18, 0)
    a.call("_rt_alloc")
    a.store(15, -64, 14)
    a.vm_mov_imm(0, 0)
    a.store(15, -72, 0)
    a.label("_rt_ass_loop")
    a.load(0, 15, -72)
    a.load(1, 15, -56)
    a.cmp(0, 1)
    a.jge("_rt_ass_done")
    a.load(2, 15, -104)
    a.add(2, 2, 0)
    a.load(3, 15, -40)
    a.add(2, 3, 2)
    a.store(15, -80, 2)
    a.load(3, 15, -64)
    a.vm_mov_imm(1, 24)
    a.mul(0, 0, 1)
    a.add(3, 3, 0)
    a.load(0, 2, 16)
    a.vm_cbnz(0, "_rt_ass_heap")
    a.load(0, 2, 0)
    a.store(3, 0, 0)
    a.load(0, 2, 8)
    a.store(3, 8, 0)
    a.vm_mov_imm(0, 0)
    a.store(3, 16, 0)
    a.jmp("_rt_ass_next")
    a.label("_rt_ass_heap")
    a.load(0, 2, 8)
    a.store(15, -88, 0)
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_ass_fail")
    a.vm_cbz(0, "_rt_ass_heap_empty")
    // Heap-owned string elements must have a non-null, non-wrapping source
    // span before copying their bytes.
    a.load(1, 2, 0)
    a.vm_cbz(1, "_rt_ass_fail")
    a.add(4, 1, 0)
    a.cmp(4, 1)
    a.jae("_rt_ass_elem_span_ok")
    a.jmp("_rt_ass_fail")
    a.label("_rt_ass_elem_span_ok")
    a.mov(18, 0)
    a.call("_rt_alloc")
    a.store(15, -96, 14)
    a.vm_mov_imm(4, 0)
    a.label("_rt_ass_copy")
    a.load(1, 15, -88)
    a.cmp(4, 1)
    a.jge("_rt_ass_cdone")
    a.load(2, 15, -80)
    a.load(2, 2, 0)
    a.add(2, 2, 4)
    a.load_byte(5, 2, 0)
    a.load(3, 15, -96)
    a.add(3, 3, 4)
    a.store_byte(3, 0, 5)
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_ass_copy")
    a.label("_rt_ass_cdone")
    a.load(0, 15, -72)
    a.vm_mov_imm(1, 24)
    a.mul(0, 0, 1)
    a.load(3, 15, -64)
    a.add(3, 3, 0)
    a.load(1, 15, -96)
    a.store(3, 0, 1)
    a.load(1, 15, -88)
    a.store(3, 8, 1)
    a.store(3, 16, 1)
    a.jmp("_rt_ass_next")
    a.label("_rt_ass_heap_empty")
    a.load(0, 15, -72)
    a.vm_mov_imm(1, 24)
    a.mul(0, 0, 1)
    a.load(3, 15, -64)
    a.add(3, 3, 0)
    a.vm_mov_imm(0, 0)
    a.store(3, 0, 0)
    a.store(3, 8, 0)
    a.store(3, 16, 0)
    a.label("_rt_ass_next")
    a.load(0, 15, -72)
    a.vm_add_imm(0, 0, 1)
    a.store(15, -72, 0)
    a.jmp("_rt_ass_loop")
    a.label("_rt_ass_done")
    a.load(0, 15, -8)
    a.load(1, 15, -64)
    a.store(0, 0, 1)
    a.load(1, 15, -56)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_ass_empty")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.epilogue()
    a.label("_rt_ass_fail")
    a.lea(18, "_rt_ass_msg")
    a.vm_mov_imm(19, 20)
    a.vm_mov_imm(20, 2)
    a.call("_rt_write")
    rt_exit(a, 1)
    a.epilogue()
    <<
}
