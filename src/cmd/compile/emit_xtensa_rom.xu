@main

#xu/types

// Cadence coreasm.h window_spill8/window_spill_common for a 64-register LX6.
// This is emitted by Xu, not linked from an assembly object. Enter with
// CALL8; a0..a7 are preserved and every older live register window is spilled
// against a stable ABI stack pointer before control enters call0 Xu code.
fn rt_emit_xtensa_rom_window_spill(a $&Assembler) {
    a.align_code(4)
    a.label("_xu_rom_window_spill8")
    a.xt_emit24(0x002136) // entry a1,16 (assist56)
    a.xt_call_windowed("_xu_rom_window_spill52", 1)
    a.xt_emit16(0xF01D)
    a.align_code(4)
    a.label("_xu_rom_window_spill52")
    a.xt_emit24(0x006136) // entry a1,48
    a.xt_call_windowed("_xu_rom_window_spill40", 3)
    a.xt_emit16(0xF01D)
    a.align_code(4)
    a.label("_xu_rom_window_spill40")
    a.xt_emit24(0x006136)
    a.xt_call_windowed("_xu_rom_window_spill28", 3)
    a.xt_emit16(0xF01D)
    a.align_code(4)
    a.label("_xu_rom_window_spill28")
    a.xt_emit24(0x006136)
    a.xt_call_windowed("_xu_rom_window_spill16", 3)
    a.xt_emit16(0xF01D)
    a.align_code(4)
    a.label("_xu_rom_window_spill16")
    a.xt_emit24(0x002136) // entry a1,16
    a.xt_movi(15, 0)
    a.xt_emit16(0xF01D)
}

// Scalar-only, windowed mask-ROM call. Address/target checks live in the
// checker. This adapter has no BLE/PHY policy and never fabricates fn values.
fn emit_xtensa_rom_call(a $&Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    emit_xtensa_windowed_call(a, m, fi, fr, ii, "")
}

// c_call6: the entry is an external C symbol, resolvable only through an
// R_XTENSA_32 relocation in a relocatable object.
fn emit_xtensa_c_call(a $&Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    if !a.reloc_obj {
        eprintln("c_call6 requires --emit-obj with an .o output for xtensa-esp32-none")
        <<< 1
    }
    emit_xtensa_windowed_call(a, m, fi, fr, ii, types.mir_isval(m, fi, ii) + "")
}

fn emit_xtensa_windowed_call(a $&Assembler, m &types.Mir, fi int, fr &Frame, ii int, sym string) {
    if a.arch != 7 || a.os != 3 {
        eprintln("rom_call6/c_call6 require xtensa-esp32-none")
        <<< 1
    }
    ic := types.mir_ic(m, fi, ii)
    a.xt_rsil(9, 15)
    a.xt_addi(1, 1, -128)
    a.xt_s32i(9, 1, 84)
    // Low 48 bytes are reserved for the window spill/extra save areas.
    a.xt_s32i(0, 1, 64)
    for r in 12:16 { a.xt_s32i(r, 1, 68 + (r - 12) * 4) }
    a.xt_addi(8, 1, 48)
    a.xt_addi(9, 1, -12)
    a.xt_s32i(8, 9, 0)
    a.xt_l32i(9, 1, 84)
    a.xt_wsr(9, 230)
    a.xt_rsync()
    // Stage six words below incoming SP-16; the last 16 bytes of this
    // allocation may still hold native ancestor base-save registers.
    $arg := types.mir_marg_next(m, fi, ic)
    for i in 0:6 {
        v := types.mir_marg_v(m, fi, arg)
        emit_load_value(a, m, fi, fr, v, 0)
        a.xt_s32i(8, 1, 88 + i * 4)
        arg = types.mir_marg_next(m, fi, arg)
    }
    if sym.len > 0 {
        a.xt_lea_abs(8, sym)
    } else {
        emit_load_value(a, m, fi, fr, types.mir_marg_v(m, fi, ic), 0)
    }
    for i in 0:6 { a.xt_l32i(10 + i, 1, 88 + i * 4) }
    a.xt_callx8(8)
    a.xt_mov(2, 10) // windowed scalar result -> Xu Ret
    a.xt_rsil(9, 15)
    a.xt_l32i(0, 1, 64)
    for r in 12:16 { a.xt_l32i(r, 1, 68 + (r - 12) * 4) }
    a.xt_addi(1, 1, 64)
    a.xt_addi(1, 1, 64)
    a.xt_wsr(9, 230)
    a.xt_rsync()
    a.mov(0, 14)
    emit_store_temp(a, fr, types.mir_ia(m, fi, ii), 0)
}
