@main

#xu/types

// Wrapping i64 reductions. kind 1: `s += i & mask` with a const trip.
// kind 2: `s += a[j] & mask`. kind 3 multiplies, kind 4 adds bytes.


fn vec_and_src(m &types.Mir, fi int, bi int, dest int) int {
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == types.MI_BIN && types.mir_ib(m, fi, ii) == 14 && types.mir_ia(m, fi, ii) == dest {
            lc := types.mir_ic(m, fi, ii)
            ld := types.mir_id(m, fi, ii)
            if vec_has_const(m, fi, lc) && ld >= 0 { << ld }
            if vec_has_const(m, fi, ld) && lc >= 0 { << lc }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << -1
}

fn vec_mul_fac(m &types.Mir, fi int, bi int, mul_dest int, ind int) int {
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == types.MI_BIN && types.mir_ib(m, fi, ii) == 3 && types.mir_ia(m, fi, ii) == mul_dest {
            lc := types.mir_ic(m, fi, ii)
            ld := types.mir_id(m, fi, ii)
            a_ind := vec_temp_from_local(m, fi, bi, lc, ind)
            b_ind := vec_temp_from_local(m, fi, bi, ld, ind)
            if a_ind && !b_ind {
                << vec_local_of_temp(m, fi, bi, ld)
            }
            if b_ind && !a_ind {
                << vec_local_of_temp(m, fi, bi, lc)
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << -1
}

fn vec_find_and_of_ind(m &types.Mir, fi int, bi int, ind int) VecPat {
    mut r := vec_none()
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == types.MI_BIN && types.mir_ib(m, fi, ii) == 14 {
            lc := types.mir_ic(m, fi, ii)
            ld := types.mir_id(m, fi, ii)
            mut ok := false
            mut mv := 0
            if vec_has_const(m, fi, lc) {
                mv = vec_const(m, fi, lc)
                ok = true
            } else if vec_has_const(m, fi, ld) {
                mv = vec_const(m, fi, ld)
                ok = true
            }
            if ok {
                dest := types.mir_ia(m, fi, ii)
                src := vec_and_src(m, fi, bi, dest)
                if src >= 0 && vec_temp_from_local(m, fi, bi, src, ind) {
                    r.kind = 1
                    r.acc = dest
                    r.mask = mv
                    << r
                }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << r
}

fn vec_find_and(m &types.Mir, fi int, bi int) VecPat {
    mut r := vec_none()
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == types.MI_BIN && types.mir_ib(m, fi, ii) == 14 {
            lc := types.mir_ic(m, fi, ii)
            ld := types.mir_id(m, fi, ii)
            mut ok := false
            mut mv := 0
            if vec_has_const(m, fi, lc) {
                mv = vec_const(m, fi, lc)
                ok = true
            } else if vec_has_const(m, fi, ld) {
                mv = vec_const(m, fi, ld)
                ok = true
            }
            if ok {
                r.kind = 1
                r.acc = types.mir_ia(m, fi, ii)
                r.mask = mv
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << r
}

fn vec_find_acc(m &types.Mir, fi int, bi int, ind int, and_dest int) int {
    mut acc := -1
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == types.MI_STORE_LOCAL {
            loc := types.mir_ia(m, fi, ii)
            st := types.mir_ib(m, fi, ii)
            if loc != ind && st >= 0 {
                mut jj := types.mir_bhead(m, fi, bi)
                for _ in 0:types.mir_nins(m, fi) {
                    if jj < 0 { <- }
                    if types.mir_ikind(m, fi, jj) == types.MI_BIN && types.mir_ia(m, fi, jj) == st && types.mir_ib(m, fi, jj) == 1 {
                        lc := types.mir_ic(m, fi, jj)
                        ld := types.mir_id(m, fi, jj)
                        if lc == and_dest || ld == and_dest {
                            acc = loc
                        }
                    }
                    jj = types.mir_inext(m, fi, jj)
                }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << acc
}

fn vec_find_index(m &types.Mir, fi int, bi int, ind int) VecPat {
    mut r := vec_none()
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { << r }
        if types.mir_ikind(m, fi, ii) == types.MI_LOAD_INDEX {
            d := types.mir_id(m, fi, ii)
            mut esz := d
            if esz >= 0 { << r }
            esz = 0 - esz
            if esz != 8 { << r }
            ic := types.mir_ic(m, fi, ii)
            if !vec_temp_from_local(m, fi, bi, ic, ind) {
                << r
            }
            r.kind = 1
            r.acc = types.mir_ia(m, fi, ii)
            r.arr = types.mir_ib(m, fi, ii)
            << r
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << r
}

fn match_iand_reduce(m &types.Mir, fi int, bi int) VecPat {
    if types.mir_btkind(m, fi, bi) != 2 { << vec_none() }
    if types.mir_btb(m, fi, bi) != bi { << vec_none() }
    if !vec_kinds_ok(m, fi, bi, 0) { << vec_none() }
    ind := vec_find_ind(m, fi, bi)
    if ind < 0 { << vec_none() }
    andp := vec_find_and_of_ind(m, fi, bi, ind)
    if andp.kind == 0 { << vec_none() }
    mut acc := vec_find_acc(m, fi, bi, ind, andp.acc)
    mut bias := 0
    if acc < 0 {
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            if types.mir_ikind(m, fi, ii) == types.MI_BIN && types.mir_ib(m, fi, ii) == 1 {
                lc := types.mir_ic(m, fi, ii)
                ld := types.mir_id(m, fi, ii)
                mut cv := -1
                if lc == andp.acc && vec_has_const(m, fi, ld) { cv = ld }
                if ld == andp.acc && vec_has_const(m, fi, lc) { cv = lc }
                if cv <= -2 {
                    hit := vec_find_acc(m, fi, bi, ind, types.mir_ia(m, fi, ii))
                    if hit >= 0 {
                        if acc >= 0 { << vec_none() }
                        acc = hit
                        bias = vec_const(m, fi, cv)
                    }
                }
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    if acc < 0 { << vec_none() }
    if acc == ind { << vec_none() }
    limit := vec_find_lt_const(m, fi, bi, ind)
    if limit <= 16 { << vec_none() }
    if !types.mir_iand_body_proved(m, fi, bi, ind, acc, andp.mask, bias, limit) { << vec_none() }
    // kind 1 uses fac as a wrapping additive bias; other kinds keep their
    // existing factor-local interpretation.
    << VecPat{kind: VP_IAND_REDUCE, ind: ind, acc: acc, mask: andp.mask, limit: limit, limit_t: -1, else_bb: types.mir_btc(m, fi, bi), arr: -1, fac: bias}
}

fn match_mul_iand_reduce(m &types.Mir, fi int, bi int) VecPat {
    if types.mir_btkind(m, fi, bi) != 2 { << vec_none() }
    if types.mir_btb(m, fi, bi) != bi { << vec_none() }
    if !vec_kinds_ok(m, fi, bi, 0) { << vec_none() }
    ind := vec_find_ind(m, fi, bi)
    if ind < 0 { << vec_none() }
    andp := vec_find_and(m, fi, bi)
    if andp.kind == 0 { << vec_none() }
    src := vec_and_src(m, fi, bi, andp.acc)
    if src < 0 { << vec_none() }
    if vec_temp_from_local(m, fi, bi, src, ind) { << vec_none() }
    fac := vec_mul_fac(m, fi, bi, src, ind)
    if fac < 0 { << vec_none() }
    if fac == ind { << vec_none() }
    if vec_local_stored(m, fi, bi, fac) { << vec_none() }
    acc := vec_find_acc(m, fi, bi, ind, andp.acc)
    if acc < 0 { << vec_none() }
    if acc == ind { << vec_none() }
    if acc == fac { << vec_none() }
    limit := vec_find_lt_const(m, fi, bi, ind)
    if limit <= 16 { << vec_none() }
    if !types.mir_mul_iand_body_proved(m, fi, bi, ind, acc, andp.mask, fac, limit) { << vec_none() }
    << VecPat{kind: VP_MUL_IAND_REDUCE, ind: ind, acc: acc, mask: andp.mask, limit: limit, limit_t: -1, else_bb: types.mir_btc(m, fi, bi), arr: -1, fac: fac}
}

fn match_scan_reduce(m &types.Mir, fi int, bi int) VecPat {
    if types.mir_btkind(m, fi, bi) != 2 { << vec_none() }
    if types.mir_btb(m, fi, bi) != bi { << vec_none() }
    if !vec_kinds_ok(m, fi, bi, 1) { << vec_none() }
    ind := vec_find_ind(m, fi, bi)
    if ind < 0 { << vec_none() }
    idxp := vec_find_index(m, fi, bi, ind)
    if idxp.kind == 0 { << vec_none() }
    andp := vec_find_and(m, fi, bi)
    if andp.kind == 0 { << vec_none() }
    acc := vec_find_acc(m, fi, bi, ind, andp.acc)
    if acc < 0 { << vec_none() }
    if acc == ind { << vec_none() }
    limit_t := vec_find_lt_temp(m, fi, bi, ind)
    if limit_t < 0 { << vec_none() }
    << VecPat{kind: VP_SCAN_REDUCE, ind: ind, acc: acc, mask: andp.mask, limit: 0, limit_t: limit_t, else_bb: types.mir_btc(m, fi, bi), arr: idxp.arr, fac: -1}
}

fn vec_find_byte_index(m &types.Mir, fi int, bi int, ind int) VecPat {
    mut r := vec_none()
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { << r }
        if types.mir_ikind(m, fi, ii) == types.MI_LOAD_INDEX {
            d := types.mir_id(m, fi, ii)
            mut esz := d
            if esz < 0 { esz = 0 - esz }
            if esz != 1 { << r }
            ic := types.mir_ic(m, fi, ii)
            if !vec_temp_from_local(m, fi, bi, ic, ind) {
                << r
            }
            r.kind = 1
            r.acc = types.mir_ia(m, fi, ii)
            r.arr = types.mir_ib(m, fi, ii)
            << r
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << r
}

// `c += s[j]` self-loop: byte LoadIndex + add into an accumulator.
fn match_byte_add_reduce(m &types.Mir, fi int, bi int) VecPat {
    if types.mir_btkind(m, fi, bi) != 2 { << vec_none() }
    if types.mir_btb(m, fi, bi) != bi { << vec_none() }
    if !vec_kinds_ok(m, fi, bi, 1) { << vec_none() }
    ind := vec_find_ind(m, fi, bi)
    if ind < 0 { << vec_none() }
    idxp := vec_find_byte_index(m, fi, bi, ind)
    if idxp.kind == 0 { << vec_none() }
    acc := vec_find_acc(m, fi, bi, ind, idxp.acc)
    if acc < 0 { << vec_none() }
    if acc == ind { << vec_none() }
    limit_t := vec_find_lt_temp(m, fi, bi, ind)
    if limit_t < 0 { << vec_none() }
    << VecPat{kind: VP_BYTE_ADD_REDUCE, ind: ind, acc: acc, mask: 0, limit: 0, limit_t: limit_t, else_bb: types.mir_btc(m, fi, bi), arr: idxp.arr, fac: -1}
}

fn vec_local_vr(a &Assembler, pins &[]int, bi int, loc int, fallback int) int {
    if pins.len >= (bi + 1) * 4 {
        for p in 0:4 {
            if pins[bi * 4 + p] == loc {
                << rc_pin_vr(a, p)
            }
        }
    }
    << fallback
}

fn vec_fold_q(a &mut Assembler, s_vr int, qd int) {
    a.be_neon_addp_d(qd, qd)
    a.be_fmov_gpr_from_d(0, qd)
    a.add(s_vr, s_vr, 0)
}

fn vec_and_acc(a &mut Assembler, acc_q int, src_q int) {
    a.be_neon_and_16b(5, src_q, 2)
    a.be_neon_add_2d(acc_q, acc_q, 5)
}

fn vec_and_bias_acc(a &mut Assembler, acc_q int, src_q int, bias int) {
    a.be_neon_and_16b(5, src_q, 2)
    if bias != 0 { a.be_neon_add_2d(5, 5, 4) }
    a.be_neon_add_2d(acc_q, acc_q, 5)
}

fn vec_zero_accs(a &mut Assembler) {
    a.be_neon_movi_2d0(0)
    a.be_neon_movi_2d0(6)
    a.be_neon_movi_2d0(16)
    a.be_neon_movi_2d0(17)
}

fn vec_dup_mask(a &mut Assembler, mask int) {
    a.vm_mov_imm64(0, mask)
    a.be_neon_dup_2d(2, 0)
}

fn vec_store_is(a &mut Assembler, fr &Frame, ind int, acc int, i_vr int, s_vr int) {
    a.store(15, slot_off(fr.local_slot[ind]), i_vr)
    a.store(15, slot_off(fr.local_slot[acc]), s_vr)
}

fn emit_vec_iand(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, pins &[]int, p VecPat) int {
    if p.ind < 0 || p.ind >= fr.local_slot.len { << 0 }
    if p.acc < 0 || p.acc >= fr.local_slot.len { << 0 }
    i_vr := vec_local_vr(&*a, pins, bi, p.ind, 6)
    s_vr := vec_local_vr(&*a, pins, bi, p.acc, 7)
    if i_vr == s_vr { << 0 }
    if i_vr == 6 {
        a.load(6, 15, slot_off(fr.local_slot[p.ind]))
    }
    if s_vr == 7 {
        a.load(7, 15, slot_off(fr.local_slot[p.acc]))
    }
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi)
    emit_iand_core(a, pref, p, i_vr, s_vr)
    vec_store_is(a, fr, p.ind, p.acc, i_vr, s_vr)
    a.jmp(types.mir_fn_label(m, fi) + "_bb" + str(p.else_bb))
    << 1
}

// Runs i..limit (i < limit on entry) into s; leaves i == limit. Scratch is
// V0/V1 and SIMD v0-v7/v16-v19 only.
fn emit_iand_core(a &mut Assembler, pref string, p VecPat, i_vr int, s_vr int) {
    // Compare against limit-7, so every batch satisfies i+7 < limit.
    // Rounding the absolute limit assumed an aligned starting induction.
    lim8 := p.limit - 7
    vec_lbl := pref + "_v"
    sc_lbl := pref + "_vs"
    dn_lbl := pref + "_vd"
    vec_zero_accs(a)
    a.be_neon_dup_2d(1, i_vr)
    a.vm_mov_imm(0, 1)
    a.be_neon_movi_2d0(4)
    a.be_neon_ins_d(4, 1, 0)
    a.be_neon_add_2d(1, 1, 4)
    a.vm_mov_imm(0, 2)
    a.be_neon_dup_2d(4, 0)
    a.be_neon_add_2d(7, 1, 4)
    a.be_neon_add_2d(18, 7, 4)
    a.be_neon_add_2d(19, 18, 4)
    vec_dup_mask(a, p.mask)
    if p.fac != 0 {
        a.vm_mov_imm64(0, p.fac)
        a.be_neon_dup_2d(4, 0)
    }
    a.vm_mov_imm(0, 8)
    a.be_neon_dup_2d(3, 0)
    a.vm_mov_imm64(1, lim8)
    a.cmp(i_vr, 1)
    a.jge(sc_lbl + "")
    a.label(vec_lbl + "")
    vec_and_bias_acc(a, 0, 1, p.fac)
    vec_and_bias_acc(a, 6, 7, p.fac)
    vec_and_bias_acc(a, 16, 18, p.fac)
    vec_and_bias_acc(a, 17, 19, p.fac)
    a.be_neon_add_2d(1, 1, 3)
    a.be_neon_add_2d(7, 7, 3)
    a.be_neon_add_2d(18, 18, 3)
    a.be_neon_add_2d(19, 19, 3)
    a.vm_add_imm(i_vr, i_vr, 8)
    a.cmp(i_vr, 1)
    a.jlt(vec_lbl + "")
    vec_fold_q(a, s_vr, 0)
    vec_fold_q(a, s_vr, 6)
    vec_fold_q(a, s_vr, 16)
    vec_fold_q(a, s_vr, 17)
    a.label(sc_lbl + "")
    a.vm_mov_imm64(1, p.limit)
    a.cmp(i_vr, 1)
    a.jge(dn_lbl + "")
    a.label(pref + "_vb")
    a.vm_and_imm(0, i_vr, p.mask)
    if p.fac != 0 {
        a.vm_add_imm(0, 0, p.fac)
    }
    a.add(s_vr, s_vr, 0)
    a.vm_add_imm(i_vr, i_vr, 1)
    a.cmp(i_vr, 1)
    a.jlt(pref + "_vb")
    a.label(dn_lbl + "")
}

fn emit_vec_mul_iand(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, pins &[]int, p VecPat) int {
    if p.ind < 0 || p.ind >= fr.local_slot.len { << 0 }
    if p.acc < 0 || p.acc >= fr.local_slot.len { << 0 }
    if p.fac < 0 || p.fac >= fr.local_slot.len { << 0 }
    mut i_vr := vec_local_vr(&*a, pins, bi, p.ind, -1)
    mut s_vr := vec_local_vr(&*a, pins, bi, p.acc, -1)
    mut f_vr := vec_local_vr(&*a, pins, bi, p.fac, -1)
    is_period := p.mask >= 0 && p.mask <= 65535 && ((p.mask + 1) & p.mask) == 0
    if is_period && (i_vr < 0 || s_vr < 0 || f_vr < 0) {
        i_vr = 2
        s_vr = 3
        f_vr = 4
        a.load(i_vr, 15, slot_off(fr.local_slot[p.ind]))
        a.load(s_vr, 15, slot_off(fr.local_slot[p.acc]))
        a.load(f_vr, 15, slot_off(fr.local_slot[p.fac]))
    }
    if i_vr < 0 || s_vr < 0 || f_vr < 0 { << 0 }
    if i_vr == s_vr || i_vr == f_vr || s_vr == f_vr { << 0 }
    if i_vr == 0 || i_vr == 1 || i_vr == 6 || i_vr == 12 { << 0 }
    if s_vr == 0 || s_vr == 1 || s_vr == 6 || s_vr == 12 { << 0 }
    if f_vr == 0 || f_vr == 1 || f_vr == 6 || f_vr == 12 { << 0 }
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi)
    if is_period {
        emit_mul_iand_periods(a, pref, p, i_vr, s_vr, f_vr)
    } else {
        // S4 is an old product scratch; do not touch it without a saved pair.
        if a.cs_pairs < 3 { << 0 }
        emit_mul_iand_pairs(a, pref, p, i_vr, s_vr, f_vr, 12, 6)
    }
    vec_store_is(a, fr, p.ind, p.acc, i_vr, s_vr)
    a.jmp(types.mir_fn_label(m, fi) + "_bb" + str(p.else_bb))
    << 1
}

// `prod` carries f*i and `mreg` the mask; both are clobbered, as are V0/V1.
fn emit_mul_iand_pairs(a &mut Assembler, pref string, p VecPat, i_vr int, s_vr int, f_vr int, prod int, mreg int) {
    // A two-element batch must prove i+1 < limit, for any starting i.
    lim2 := p.limit - 1
    vec_lbl := pref + "_mv"
    sc_lbl := pref + "_ms"
    dn_lbl := pref + "_md"
    a.mul(prod, f_vr, i_vr)
    a.vm_mov_imm64(mreg, p.mask)
    a.vm_mov_imm64(1, lim2)
    a.cmp(i_vr, 1)
    a.jge(sc_lbl + "")
    a.label(vec_lbl + "")
    a.iand(0, prod, mreg)
    a.add(s_vr, s_vr, 0)
    a.add(prod, prod, f_vr)
    a.iand(0, prod, mreg)
    a.add(s_vr, s_vr, 0)
    a.add(prod, prod, f_vr)
    a.vm_add_imm(i_vr, i_vr, 2)
    a.cmp(i_vr, 1)
    a.jlt(vec_lbl + "")
    a.label(sc_lbl + "")
    a.vm_mov_imm64(1, p.limit)
    a.cmp(i_vr, 1)
    a.jge(dn_lbl + "")
    a.label(pref + "_mb")
    a.iand(0, prod, mreg)
    a.add(s_vr, s_vr, 0)
    a.add(prod, prod, f_vr)
    a.vm_add_imm(i_vr, i_vr, 1)
    a.cmp(i_vr, 1)
    a.jlt(pref + "_mb")
    a.label(dn_lbl + "")
}

fn emit_vec_scan(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, pins &[]int, p VecPat) int {
    if p.ind < 0 || p.ind >= fr.local_slot.len { << 0 }
    if p.acc < 0 || p.acc >= fr.local_slot.len { << 0 }
    if p.limit_t < 0 || p.limit_t >= fr.temp_slot.len { << 0 }
    i_vr := vec_local_vr(&*a, pins, bi, p.ind, 6)
    s_vr := vec_local_vr(&*a, pins, bi, p.acc, 7)
    if i_vr == s_vr { << 0 }
    if i_vr == 0 || i_vr == 1 || s_vr == 0 || s_vr == 1 { << 0 }
    if i_vr == 6 {
        a.load(6, 15, slot_off(fr.local_slot[p.ind]))
    }
    if s_vr == 7 {
        a.load(7, 15, slot_off(fr.local_slot[p.acc]))
    }
    emit_scan_core(a, m, fi, fr, bi, p, i_vr, s_vr)
    vec_store_is(a, fr, p.ind, p.acc, i_vr, s_vr)
    a.jmp(types.mir_fn_label(m, fi) + "_bb" + str(p.else_bb))
    << 1
}

// s += a[i] & mask for i in i..limit_t. Scratch V0/V1, S4/S5 and SIMD.
// limit_t == -1 scans to the descriptor's own length.
fn emit_scan_core(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, p VecPat, i_vr int, s_vr int) {
    if p.limit_t != -1 {
        emit_load_value(a, m, fi, fr, p.limit_t, 1)
        a.vm_mov_imm64(0, -8)
        a.iand(12, 1, 0)
    }
    mut desc := p.arr
    if desc < types.MIR_LOCAL_OPERAND_BASE {
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            if types.mir_ikind(m, fi, ii) == types.MI_LOAD_LOCAL && types.mir_ia(m, fi, ii) == desc {
                desc = types.MIR_LOCAL_OPERAND_BASE + types.mir_ib(m, fi, ii)
                <-
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    emit_index_desc_addr(a, m, fi, fr, desc)
    if p.limit_t == -1 { a.load(1, 0, -8) }
    a.load(13, 0, 0)
    if p.limit_t == -1 {
        a.vm_mov_imm64(0, -8)
        a.iand(12, 1, 0)
    }
    a.add_lsl_vr(13, 13, i_vr, 3)
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi)
    vec_lbl := pref + "_sv"
    sc_lbl := pref + "_ss"
    dn_lbl := pref + "_sd"
    vec_zero_accs(a)
    vec_dup_mask(a, p.mask)
    a.cmp(i_vr, 12)
    a.jge(sc_lbl + "")
    a.label(vec_lbl + "")
    a.be_neon_ldp_q_post32(1, 7, 13)
    a.be_neon_ldp_q_post32(18, 19, 13)
    vec_and_acc(a, 0, 1)
    vec_and_acc(a, 6, 7)
    vec_and_acc(a, 16, 18)
    vec_and_acc(a, 17, 19)
    a.vm_add_imm(i_vr, i_vr, 8)
    a.cmp(i_vr, 12)
    a.jlt(vec_lbl + "")
    vec_fold_q(a, s_vr, 0)
    vec_fold_q(a, s_vr, 6)
    vec_fold_q(a, s_vr, 16)
    vec_fold_q(a, s_vr, 17)
    a.label(sc_lbl + "")
    a.cmp(i_vr, 1)
    a.jge(dn_lbl + "")
    a.label(pref + "_sb")
    a.load(0, 13, 0)
    a.vm_and_imm(0, 0, p.mask)
    a.add(s_vr, s_vr, 0)
    a.vm_add_imm(13, 13, 8)
    a.vm_add_imm(i_vr, i_vr, 1)
    a.cmp(i_vr, 1)
    a.jlt(pref + "_sb")
    a.label(dn_lbl + "")
}

fn emit_vec_byte_add(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, pins &[]int, p VecPat) int {
    if p.ind < 0 || p.ind >= fr.local_slot.len { << 0 }
    if p.acc < 0 || p.acc >= fr.local_slot.len { << 0 }
    if p.limit_t < 0 || p.limit_t >= fr.temp_slot.len { << 0 }
    i_vr := vec_local_vr(&*a, pins, bi, p.ind, 6)
    s_vr := vec_local_vr(&*a, pins, bi, p.acc, 7)
    if i_vr == s_vr { << 0 }
    if i_vr == 0 || i_vr == 1 || s_vr == 0 || s_vr == 1 { << 0 }
    if i_vr == 6 {
        a.load(6, 15, slot_off(fr.local_slot[p.ind]))
    }
    if s_vr == 7 {
        a.load(7, 15, slot_off(fr.local_slot[p.acc]))
    }
    emit_load_value(a, m, fi, fr, p.limit_t, 1)
    mut desc := p.arr
    if desc < types.MIR_LOCAL_OPERAND_BASE {
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            if types.mir_ikind(m, fi, ii) == types.MI_LOAD_LOCAL && types.mir_ia(m, fi, ii) == desc {
                desc = types.MIR_LOCAL_OPERAND_BASE + types.mir_ib(m, fi, ii)
                <-
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    emit_index_desc_addr(a, m, fi, fr, desc)
    a.load(13, 0, 0)
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi)
    lp := pref + "_ba"
    else_lbl := types.mir_fn_label(m, fi) + "_bb" + str(p.else_bb)
    dn := pref + "_bd"
    a.cmp(i_vr, 1)
    a.jge(dn + "")
    a.label(lp + "")
    a.load_scaled(0, 13, i_vr, 1)
    a.add(s_vr, s_vr, 0)
    a.vm_add_imm(i_vr, i_vr, 1)
    a.cmp(i_vr, 1)
    a.jlt(lp + "")
    a.label(dn + "")
    vec_store_is(a, fr, p.ind, p.acc, i_vr, s_vr)
    a.jmp(else_lbl + "")
    << 1
}

// Low-k-bit multiplication has period P=2^k/gcd(factor,2^k).
// Every complete period sums to P*(2^k-gcd)/2, independently of start.
// Compute its wrapping contribution, then execute only the residual tail.
// Only V0/V1/Ret are scratch; induction and accumulator are their existing
// pinned homes, and the factor home is read-only across the entire block.
fn emit_mul_iand_periods(a &mut Assembler, pref string, p VecPat, iv int, sv int, fv int) {
    zero := pref + "_pz"
    tail := pref + "_pt"
    done := pref + "_pd"
    modulus := p.mask + 1
    mut bits := 0
    mut value := modulus
    while value > 1 { value = value >> 1
        bits += 1 }
    a.vm_mov_imm64(1, p.mask)
    a.iand(0, fv, 1)
    a.vm_cmp_imm(0, 0)
    a.jeq(zero + "")
    a.vm_mov_imm(14, 0)
    a.sub(14, 14, 0)
    a.iand(0, 0, 14) // gcd = low & -low
    a.be_clz(14, 0)
    a.vm_mov_imm(1, 63 - bits)
    a.sub(14, 14, 1) // log2(P), in 1..bits (zero low handled above)
    a.vm_mov_imm64(1, p.limit)
    a.sub(iv, 1, iv) // N as an unsigned 64-bit count; consume current pin
    a.vm_mov_imm64(1, modulus)
    a.sub(0, 1, 0)
    a.vm_mov_imm(1, 1)
    a.shl(1, 1, 14) // P
    a.mul(0, 0, 1)
    a.shr_imm(0, 0, 1) // period sum fits below 2^32; divide before Q multiply
    a.vm_sub_imm(1, 1, 1)
    a.iand(1, iv, 1) // R = N & (P-1)
    a.shr(iv, iv, 14) // unsigned Q
    a.mul(0, 0, iv)
    a.add(sv, sv, 0)
    a.vm_mov_imm64(0, p.limit)
    a.sub(iv, 0, 1) // residual starts at limit-R
    a.mov(14, 0)
    a.cmp(iv, 14)
    a.jge(done + "")
    a.mul(0, fv, iv)
    a.label(tail + "")
    a.vm_and_imm(1, 0, p.mask)
    a.add(sv, sv, 1)
    a.add(0, 0, fv)
    a.vm_add_imm(iv, iv, 1)
    a.cmp(iv, 14)
    a.jlt(tail + "")
    a.jmp(done + "")
    a.label(zero + "")
    a.vm_mov_imm64(iv, p.limit)
    a.label(done + "")
}

fn vec_ssa_fp_free(a &Assembler, fr &Frame) bool {
    if a.rc_fp_only || a.rc_fp_hold || frame_plan_uses_fp(fr) { << false }
    for p in 0:rc_fp_homes() {
        if p < a.rc_fp_pin.len && a.rc_fp_pin[p] >= 0 { << false }
    }
    << true
}

// SSA headers: phis are read into A2-A4, which no fixed home or RegCache
// park uses. Results go to the body temps the latch and exit read; the
// exit block starts from a flushed cache, so dirty parks are spilled here.
fn emit_vec_iand_ssa(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, p VecPat) int {
    if a.arch != 0 { << 0 }
    s := types.mir_iand_ssa_match(m, fi, bi)
    if !s.ok { << 0 }
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi)
    iv := 20
    sv := 21
    fv := 22
    if s.mul {
        emit_load_value(a, m, fi, fr, s.i_phi, iv)
        emit_load_value(a, m, fi, fr, s.s_phi, sv)
        emit_load_value(a, m, fi, fr, s.fac, fv)
        is_period := p.mask >= 0 && p.mask <= 65535 && ((p.mask + 1) & p.mask) == 0
        if is_period {
            emit_mul_iand_periods(a, pref, p, iv, sv, fv)
        } else {
            emit_mul_iand_pairs(a, pref, p, iv, sv, fv, 23, 19)
        }
    } else {
        if !vec_ssa_fp_free(&*a, fr) { << 0 }
        emit_load_value(a, m, fi, fr, s.i_phi, iv)
        emit_load_value(a, m, fi, fr, s.s_phi, sv)
        emit_iand_core(a, pref, p, iv, sv)
    }
    emit_store_temp(a, fr, s.s_next, sv)
    emit_store_temp(a, fr, s.i_next, iv)
    rc_spill(a)
    a.jmp(types.mir_fn_label(m, fi) + "_bb" + str(s.exit))
    << 1
}

fn match_iand_ssa(m &types.Mir, fi int, bi int) VecPat {
    s := types.mir_iand_ssa_match(m, fi, bi)
    if !s.ok { << vec_none() }
    mut k := VP_IAND_SSA
    mut fac := s.bias
    if s.mul {
        k = VP_MUL_IAND_SSA
        fac = s.fac
    }
    << VecPat{kind: k, ind: s.i_phi, acc: s.s_phi, mask: s.mask, limit: s.limit, limit_t: -1, else_bb: s.exit, arr: -1, fac: fac}
}
