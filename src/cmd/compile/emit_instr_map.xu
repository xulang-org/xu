@main

#xu/types

fn emit_map_addr_temp(a &mut Assembler, fr &Frame, v int, dest int) {
    a.mov(dest, 15)
    a.vm_sub_imm(dest, dest, 0 - slot_off(fr.temp_slot[v]))
}

fn emit_instr_call_map(a &mut Assembler, m &types.Mir, fi int, fr &Frame, ii int) {
    ib := types.mir_ib(m, fi, ii)
    ia := types.mir_ia(m, fi, ii)
    ic := types.mir_ic(m, fi, ii)
    if ib == 84 { // MapNew
        kd := types.mir_id(m, fi, ii)
        a.vm_mov_imm(18, kd & 255)
        a.vm_mov_imm(19, (kd >> 8) & 255)
        a.vm_mov_imm(20, (kd >> 16) & 255)
        ty := types.mir_temp_ty(m, fi, ia)
        mi := types.map_index(ty)
        if mi >= 0 && mi < m.maps.len && m.maps[mi].vkind == 2 && m.type_owning(m.maps[mi].val_ty) {
            a.lea(21, drop_map_val_name(mi))
        } else {
            a.vm_mov_imm(21, 0)
        }
        a.call("_rt_map_new")
        a.mov(0, 14)
        emit_store_temp(a, fr, ia, 0)
        <<
    }
    if ib == 92 { // MapIterNext: handle, start slot, &key dest, &val dest; Ret=slot
        hv := types.mir_marg_v(m, fi, ic)
        sarg := types.mir_marg_next(m, fi, ic)
        sv := types.mir_marg_v(m, fi, sarg)
        karg := types.mir_marg_next(m, fi, sarg)
        kv := types.mir_marg_v(m, fi, karg)
        varg := types.mir_marg_next(m, fi, karg)
        vv := types.mir_marg_v(m, fi, varg)
        emit_load_value(a, m, fi, fr, hv, 0)
        a.mov(18, 0)
        emit_load_value(a, m, fi, fr, sv, 0)
        a.mov(19, 0)
        emit_map_addr_temp(a, fr, kv, 20)
        emit_map_addr_temp(a, fr, vv, 21)
        a.call("_rt_map_iter_next")
        a.mov(0, 14)
        emit_store_temp(a, fr, ia, 0)
        <<
    }
    if ib == 88 { // MapLen
        v := types.mir_marg_v(m, fi, ic)
        emit_load_value(a, m, fi, fr, v, 0)
        a.mov(18, 0)
        a.call("_rt_map_len")
        a.mov(0, 14)
        emit_store_temp(a, fr, ia, 0)
        <<
    }
    // Scalar calls use values throughout MIR; no addr_of key/value or sret
    // address can accidentally expose a fixed-register home as frame storage.
    if types.mir_scalar_map_call_kind(ib) && types.mir_id(m, fi, ii) != 0 {
        if !types.mir_scalar_map_call_ok(m, fi, ii) {
            eprintln("internal compiler error: scalar map ABI contract")
            <<< 1
        }
        ap0 := ic
        ap1 := types.mir_marg_next(m, fi, ap0)
        emit_load_value(a, m, fi, fr, types.mir_marg_v(m, fi, ap0), 0)
        a.mov(18, 0)
        emit_load_value(a, m, fi, fr, types.mir_marg_v(m, fi, ap1), 0)
        a.mov(19, 0)
        if ib == 86 || ib == 91 {
            ap2 := types.mir_marg_next(m, fi, ap1)
            emit_load_value(a, m, fi, fr, types.mir_marg_v(m, fi, ap2), 0)
            a.mov(20, 0)
        }
        if ib == 86 { a.call("_rt_map_insert_scalar_ii") }
        else if ib == 87 { a.call("_rt_map_has_scalar_ii") }
        else if ib == 89 { a.call("_rt_map_delete_scalar_ii") }
        else if ib == 91 { a.call("_rt_map_get_or_scalar_ii") }
        else { a.call("_rt_map_get_scalar_ii") }
        if ia >= 0 {
            a.mov(0, 14)
            emit_store_temp(a, fr, ia, 0)
        }
        <<
    }
    // handle + key pointer [+ extra pointer]
    hv := types.mir_marg_v(m, fi, ic)
    karg := types.mir_marg_next(m, fi, ic)
    kv := types.mir_marg_v(m, fi, karg)
    emit_load_value(a, m, fi, fr, hv, 0)
    a.mov(18, 0)
    // Bootstrap MapInsert uses addr_of(key/val) so copy_in_* see a descriptor
    // frame. Loading the first word of a multi-slot string temp passes the
    // heap ptr and copy_in_val then reads cap from the wrong place.
    if kv >= 0 && kv < types.mir_ntemps(m, fi) && types.mir_temp_nslots(m, fi, kv) > 1 {
        emit_map_addr_temp(a, fr, kv, 19)
    } else {
        emit_load_value(a, m, fi, fr, kv, 0)
        a.mov(19, 0)
    }
    if ib == 87 { // has
        a.call("_rt_map_has")
        a.mov(0, 14)
        emit_store_temp(a, fr, ia, 0)
        <<
    }
    if ib == 89 { // delete
        a.call("_rt_map_delete")
        <<
    }
    if ib == 98 { // val_ptr: Ret = &live value slot
        a.call("_rt_map_val_ptr")
        a.mov(0, 14)
        emit_store_temp(a, fr, ia, 0)
        <<
    }
    if ib == 86 { // insert: + val pointer
        varg := types.mir_marg_next(m, fi, karg)
        vv := types.mir_marg_v(m, fi, varg)
        if vv >= 0 && vv < types.mir_ntemps(m, fi) && types.mir_temp_nslots(m, fi, vv) > 1 {
            emit_map_addr_temp(a, fr, vv, 20)
        } else {
            emit_load_value(a, m, fi, fr, vv, 0)
            a.mov(20, 0)
        }
        a.call("_rt_map_insert")
        <<
    }
    if ib == 91 { // get_or: + default pointer, sret dest
        varg := types.mir_marg_next(m, fi, karg)
        vv := types.mir_marg_v(m, fi, varg)
        emit_load_value(a, m, fi, fr, vv, 0)
        a.mov(20, 0)
        a.mov(0, 15)
        a.vm_sub_imm(0, 0, 0 - slot_off(fr.temp_slot[ia]))
        a.call("_rt_map_get_or")
        <<
    }
    // get / take: sret dest
    a.mov(0, 15)
    a.vm_sub_imm(0, 0, 0 - slot_off(fr.temp_slot[ia]))
    if ib == 90 {
        a.call("_rt_map_take")
    } else {
        a.call("_rt_map_get")
    }
    <<
}
