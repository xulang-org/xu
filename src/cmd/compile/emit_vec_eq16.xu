@main

#xu/types

// Byte select `b[i] = (a[i] == old) ? new : a[i]`.


fn eq16_def_in(m &types.Mir, fi int, bi int, t int) int {
    if t < 0 { << -1 }
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if (k == 1 || k == 2 || k == 4 || k == 5) && types.mir_ia(m, fi, ii) == t {
            << ii
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << -1
}

// Same-block def wins. Otherwise one def in the whole function: LICM
// hoists the byte mask and the shift constants into the preheader.
fn eq16_def(m &types.Mir, fi int, bi int, t int) int {
    if t < 0 { << -1 }
    here := eq16_def_in(m, fi, bi, t)
    if here >= 0 { << here }
    nb := types.mir_nblocks(m, fi)
    mut found := -1
    mut n := 0
    for bj in 0:nb {
        if bj == bi { -> }
        ii := eq16_def_in(m, fi, bj, t)
        if ii >= 0 {
            found = ii
            n = n + 1
        }
    }
    if n == 1 { << found }
    << -1
}

fn eq16_is_k(m &types.Mir, fi int, bi int, t int, k int) bool {
    ii := eq16_def(m, fi, bi, t)
    if ii < 0 { << false }
    dk := types.mir_ikind(m, fi, ii)
    if dk == 1 {
        src := types.mir_ib(m, fi, ii)
        if src < 0 && vec_has_const(m, fi, src) && vec_const(m, fi, src) == k {
            << true
        }
        << eq16_is_k(m, fi, bi, src, k)
    }
    << false
}

// The 3-slot reload is often elided: the index reads through the original
// `&string` pointer. That pointer addresses the descriptor's ptr word.
fn eq16_local_of_temp(m &types.Mir, fi int, t int, depth int) int {
    if depth > 4 || t < 0 { << -1 }
    nb := types.mir_nblocks(m, fi)
    for bj in 0:nb {
        mut ii := types.mir_bhead(m, fi, bj)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            k := types.mir_ikind(m, fi, ii)
            if types.mir_ia(m, fi, ii) == t && k == 2 {
                << types.mir_ib(m, fi, ii)
            }
            if types.mir_ia(m, fi, ii) == t && k == 1 {
                << eq16_local_of_temp(m, fi, types.mir_ib(m, fi, ii), depth + 1)
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << -1
}

fn eq16_borrowed_ref(m &types.Mir, fi int, desc int) int {
    if desc < 0 || desc >= types.mir_ntemps(m, fi) { << -1 }
    if types.mir_temp_ty(m, fi, desc) != 3 { << -1 }
    nb := types.mir_nblocks(m, fi)
    for bj in 0:nb {
        mut ii := types.mir_bhead(m, fi, bj)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            k := types.mir_ikind(m, fi, ii)
            if (k == 17 || k == 26) && types.mir_ia(m, fi, ii) == desc && types.mir_id(m, fi, ii) == 3 {
                << eq16_local_of_temp(m, fi, types.mir_ib(m, fi, ii), 0)
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << -1
}

fn eq16_is_loc(m &types.Mir, fi int, bi int, t int, loc int) bool {
    ii := eq16_def(m, fi, bi, t)
    if ii < 0 { << false }
    dk := types.mir_ikind(m, fi, ii)
    if dk == 2 && types.mir_ib(m, fi, ii) == loc { << true }
    if dk == 1 { << eq16_is_loc(m, fi, bi, types.mir_ib(m, fi, ii), loc) }
    << false
}

fn eq16_is_byte(m &types.Mir, fi int, bi int, t0 int, load_t int) bool {
    t := eq16_root(m, fi, bi, t0)
    if t == load_t { << true }
    ii := eq16_def(m, fi, bi, t)
    if ii < 0 { << false }
    dk := types.mir_ikind(m, fi, ii)
    if dk == 1 { << eq16_is_byte(m, fi, bi, types.mir_ib(m, fi, ii), load_t) }
    if dk == 4 && types.mir_ib(m, fi, ii) == 14 {
        lc := types.mir_ic(m, fi, ii)
        ld := types.mir_id(m, fi, ii)
        if eq16_is_k(m, fi, bi, lc, 255) { << eq16_is_byte(m, fi, bi, ld, load_t) }
        if ld < 0 && vec_has_const(m, fi, ld) && vec_const(m, fi, ld) == 255 {
            << eq16_is_byte(m, fi, bi, lc, load_t)
        }
        if eq16_is_k(m, fi, bi, ld, 255) { << eq16_is_byte(m, fi, bi, lc, load_t) }
        if lc < 0 && vec_has_const(m, fi, lc) && vec_const(m, fi, lc) == 255 {
            << eq16_is_byte(m, fi, bi, ld, load_t)
        }
    }
    << false
}

fn eq16_side_k(m &types.Mir, fi int, bi int, v int, k int) bool {
    if v < 0 && vec_has_const(m, fi, v) && vec_const(m, fi, v) == k { << true }
    if v < 0 { << false }
    if eq16_is_k(m, fi, bi, v, k) { << true }
    // `-1` is often `neg(1)`, not a const operand.
    ii := eq16_def(m, fi, bi, v)
    if ii < 0 { << false }
    if types.mir_ikind(m, fi, ii) == 5 && types.mir_ib(m, fi, ii) == 1 {
        src := types.mir_ic(m, fi, ii)
        want := 0 - k
        if src < 0 && vec_has_const(m, fi, src) && vec_const(m, fi, src) == want { << true }
        << eq16_is_k(m, fi, bi, src, want)
    }
    << false
}

fn eq16_is_u8(m &types.Mir, fi int, bi int, t int, depth int) bool {
    if depth > 6 { << false }
    if t < 0 && vec_has_const(m, fi, t) {
        k := vec_const(m, fi, t)
        << k >= 0 && k <= 255
    }
    ii := eq16_def(m, fi, bi, t)
    if ii < 0 { << false }
    dk := types.mir_ikind(m, fi, ii)
    if dk == 1 { << eq16_is_u8(m, fi, bi, types.mir_ib(m, fi, ii), depth + 1) }
    if dk == 4 && types.mir_ib(m, fi, ii) == 14 {
        lc := types.mir_ic(m, fi, ii)
        ld := types.mir_id(m, fi, ii)
        if eq16_side_k(m, fi, bi, lc, 255) || eq16_side_k(m, fi, bi, ld, 255) { << true }
    }
    << false
}

// One StoreLocal in the function. A loop assignment is not a proof.
fn eq16_store_any(m &types.Mir, fi int, loc int) int {
    nb := types.mir_nblocks(m, fi)
    mut found := -1
    mut n := 0
    for bj in 0:nb {
        mut ii := types.mir_bhead(m, fi, bj)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            if types.mir_ikind(m, fi, ii) == 3 && types.mir_ia(m, fi, ii) == loc {
                found = types.mir_ib(m, fi, ii)
                n = n + 1
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    if n == 1 { << found }
    << -1
}

// CMEQ compares the low 8 bits. The scalar `byte == old` matches that only
// when `old` is a 0..255 constant or the result of `& 255`.
fn eq16_masked_loc(m &types.Mir, fi int, bi int, t int, loc int, depth int) bool {
    if depth > 6 { << false }
    ii := eq16_def(m, fi, bi, t)
    if ii < 0 { << false }
    dk := types.mir_ikind(m, fi, ii)
    if dk == 1 { << eq16_masked_loc(m, fi, bi, types.mir_ib(m, fi, ii), loc, depth + 1) }
    if dk == 4 && types.mir_ib(m, fi, ii) == 14 {
        lc := types.mir_ic(m, fi, ii)
        ld := types.mir_id(m, fi, ii)
        if eq16_side_k(m, fi, bi, ld, 255) {
            if eq16_is_loc(m, fi, bi, lc, loc) { << true }
            << eq16_masked_loc(m, fi, bi, lc, loc, depth + 1)
        }
        if eq16_side_k(m, fi, bi, lc, 255) {
            if eq16_is_loc(m, fi, bi, ld, loc) { << true }
            << eq16_masked_loc(m, fi, bi, ld, loc, depth + 1)
        }
    }
    if dk == 2 && types.mir_ib(m, fi, ii) == loc {
        sv := eq16_store_any(m, fi, loc)
        if sv < 0 { << false }
        << eq16_is_u8(m, fi, bi, sv, 0)
    }
    << false
}

fn eq16_is_old(m &types.Mir, fi int, bi int, t int, old_loc int, old_k int, old_is_k int) bool {
    if old_is_k == 1 {
        if old_k < 0 || old_k > 255 { << false }
        << eq16_is_k(m, fi, bi, t, old_k)
    }
    << eq16_masked_loc(m, fi, bi, t, old_loc, 0)
}

fn eq16_is_new(m &types.Mir, fi int, bi int, t int, new_loc int, new_k int, new_is_k int) bool {
    if new_is_k == 1 { << eq16_is_k(m, fi, bi, t, new_k) }
    if eq16_is_loc(m, fi, bi, t, new_loc) { << true }
    ii := eq16_def(m, fi, bi, t)
    if ii < 0 { << false }
    dk := types.mir_ikind(m, fi, ii)
    if dk == 1 { << eq16_is_new(m, fi, bi, types.mir_ib(m, fi, ii), new_loc, new_k, new_is_k) }
    if dk == 4 && types.mir_ib(m, fi, ii) == 14 {
        lc := types.mir_ic(m, fi, ii)
        ld := types.mir_id(m, fi, ii)
        if eq16_side_k(m, fi, bi, ld, 255) { << eq16_is_new(m, fi, bi, lc, new_loc, new_k, new_is_k) }
        if eq16_side_k(m, fi, bi, lc, 255) { << eq16_is_new(m, fi, bi, ld, new_loc, new_k, new_is_k) }
    }
    << false
}

fn eq16_store_of(m &types.Mir, fi int, bi int, loc int) int {
    mut v := -1
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        if types.mir_ikind(m, fi, ii) == 3 && types.mir_ia(m, fi, ii) == loc {
            v = types.mir_ib(m, fi, ii)
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << v
}

fn eq16_root(m &types.Mir, fi int, bi int, t int) int {
    ii := eq16_def(m, fi, bi, t)
    if ii < 0 { << t }
    dk := types.mir_ikind(m, fi, ii)
    if dk == 1 { << eq16_root(m, fi, bi, types.mir_ib(m, fi, ii)) }
    if dk == 2 {
        sv := eq16_store_of(m, fi, bi, types.mir_ib(m, fi, ii))
        if sv >= 0 { << sv }
    }
    << t
}

fn eq16_is_mask(m &types.Mir, fi int, bi int, t0 int, load_t int, old_loc int, old_k int, old_is_k int) bool {
    t := eq16_root(m, fi, bi, t0)
    ii := eq16_def(m, fi, bi, t)
    if ii < 0 { << false }
    dk := types.mir_ikind(m, fi, ii)
    if dk == 1 { << eq16_is_mask(m, fi, bi, types.mir_ib(m, fi, ii), load_t, old_loc, old_k, old_is_k) }
    if dk != 4 || types.mir_ib(m, fi, ii) != 18 { << false }
    lc := types.mir_ic(m, fi, ii)
    ld := types.mir_id(m, fi, ii)
    mut body := -1
    if eq16_side_k(m, fi, bi, ld, 63) { body = lc }
    if eq16_side_k(m, fi, bi, lc, 63) { body = ld }
    if body < 0 { << false }
    mut bguard := 0
    mut si := -1
    while bguard < 4 {
        si = eq16_def(m, fi, bi, body)
        if si < 0 { << false }
        if types.mir_ikind(m, fi, si) != 1 { <- }
        body = types.mir_ib(m, fi, si)
        bguard = bguard + 1
    }
    if si < 0 { << false }
    sop := types.mir_ib(m, fi, si)
    if types.mir_ikind(m, fi, si) != 4 { << false }
    sl := types.mir_ic(m, fi, si)
    sr := types.mir_id(m, fi, si)
    mut xor_t := -1
    if sop == 2 {
        if eq16_side_k(m, fi, bi, sr, 1) { xor_t = sl }
        if eq16_side_k(m, fi, bi, sl, 1) { xor_t = sr }
    } else if sop == 1 {
        if eq16_side_k(m, fi, bi, sr, 0 - 1) { xor_t = sl }
        if eq16_side_k(m, fi, bi, sl, 0 - 1) { xor_t = sr }
    }
    if xor_t < 0 { << false }
    mut xt := xor_t
    mut xguard := 0
    mut xi := -1
    while xguard < 4 {
        xi = eq16_def(m, fi, bi, xt)
        if xi < 0 { << false }
        if types.mir_ikind(m, fi, xi) != 1 { <- }
        xt = types.mir_ib(m, fi, xi)
        xguard = xguard + 1
    }
    if xi < 0 { << false }
    if types.mir_ikind(m, fi, xi) != 4 || types.mir_ib(m, fi, xi) != 16 { << false }
    xl := types.mir_ic(m, fi, xi)
    xr := types.mir_id(m, fi, xi)
    if eq16_is_byte(m, fi, bi, xl, load_t) && eq16_is_old(m, fi, bi, xr, old_loc, old_k, old_is_k) {
        << true
    }
    if eq16_is_byte(m, fi, bi, xr, load_t) && eq16_is_old(m, fi, bi, xl, old_loc, old_k, old_is_k) {
        << true
    }
    << false
}

fn eq16_is_notm(m &types.Mir, fi int, bi int, t0 int, load_t int, old_loc int, old_k int, old_is_k int) bool {
    t := eq16_root(m, fi, bi, t0)
    ii := eq16_def(m, fi, bi, t)
    if ii < 0 { << false }
    dk := types.mir_ikind(m, fi, ii)
    if dk == 1 { << eq16_is_notm(m, fi, bi, types.mir_ib(m, fi, ii), load_t, old_loc, old_k, old_is_k) }
    if dk == 5 && types.mir_ib(m, fi, ii) == 2 {
        << eq16_is_mask(m, fi, bi, types.mir_ic(m, fi, ii), load_t, old_loc, old_k, old_is_k)
    }
    if dk != 4 || types.mir_ib(m, fi, ii) != 16 { << false }
    lc := types.mir_ic(m, fi, ii)
    ld := types.mir_id(m, fi, ii)
    if eq16_side_k(m, fi, bi, ld, 0 - 1) {
        << eq16_is_mask(m, fi, bi, lc, load_t, old_loc, old_k, old_is_k)
    }
    if eq16_side_k(m, fi, bi, lc, 0 - 1) {
        << eq16_is_mask(m, fi, bi, ld, load_t, old_loc, old_k, old_is_k)
    }
    << false
}

fn eq16_and_role(m &types.Mir, fi int, bi int, t0 int, load_t int, old_loc int, old_k int, old_is_k int, new_loc int, new_k int, new_is_k int) int {
    t := eq16_root(m, fi, bi, t0)
    ii := eq16_def(m, fi, bi, t)
    if ii < 0 { << 0 }
    if types.mir_ikind(m, fi, ii) == 1 {
        << eq16_and_role(m, fi, bi, types.mir_ib(m, fi, ii), load_t, old_loc, old_k, old_is_k, new_loc, new_k, new_is_k)
    }
    if types.mir_ikind(m, fi, ii) != 4 || types.mir_ib(m, fi, ii) != 14 { << 0 }
    lc := types.mir_ic(m, fi, ii)
    ld := types.mir_id(m, fi, ii)
    if (eq16_is_new(m, fi, bi, lc, new_loc, new_k, new_is_k) && eq16_is_mask(m, fi, bi, ld, load_t, old_loc, old_k, old_is_k)) || (eq16_is_new(m, fi, bi, ld, new_loc, new_k, new_is_k) && eq16_is_mask(m, fi, bi, lc, load_t, old_loc, old_k, old_is_k)) {
        << 1
    }
    if (eq16_is_byte(m, fi, bi, lc, load_t) && eq16_is_notm(m, fi, bi, ld, load_t, old_loc, old_k, old_is_k)) || (eq16_is_byte(m, fi, bi, ld, load_t) && eq16_is_notm(m, fi, bi, lc, load_t, old_loc, old_k, old_is_k)) {
        << 2
    }
    << 0
}

fn eq16_is_sel(m &types.Mir, fi int, bi int, t0 int, load_t int, old_loc int, old_k int, old_is_k int, new_loc int, new_k int, new_is_k int) bool {
    t := eq16_root(m, fi, bi, t0)
    ii := eq16_def(m, fi, bi, t)
    if ii < 0 { << false }
    if types.mir_ikind(m, fi, ii) == 1 {
        << eq16_is_sel(m, fi, bi, types.mir_ib(m, fi, ii), load_t, old_loc, old_k, old_is_k, new_loc, new_k, new_is_k)
    }
    if types.mir_ikind(m, fi, ii) == 4 && types.mir_ib(m, fi, ii) == 14 {
        lc := types.mir_ic(m, fi, ii)
        ld := types.mir_id(m, fi, ii)
        if eq16_side_k(m, fi, bi, ld, 255) {
            << eq16_is_sel(m, fi, bi, lc, load_t, old_loc, old_k, old_is_k, new_loc, new_k, new_is_k)
        }
        if eq16_side_k(m, fi, bi, lc, 255) {
            << eq16_is_sel(m, fi, bi, ld, load_t, old_loc, old_k, old_is_k, new_loc, new_k, new_is_k)
        }
    }
    if types.mir_ikind(m, fi, ii) != 4 || types.mir_ib(m, fi, ii) != 15 { << false }
    r0 := eq16_and_role(m, fi, bi, types.mir_ic(m, fi, ii), load_t, old_loc, old_k, old_is_k, new_loc, new_k, new_is_k)
    r1 := eq16_and_role(m, fi, bi, types.mir_id(m, fi, ii), load_t, old_loc, old_k, old_is_k, new_loc, new_k, new_is_k)
    if r0 == 1 && r1 == 2 { << true }
    if r0 == 2 && r1 == 1 { << true }
    << false
}

// The replacement writes induction back and nothing else. A carried int or
// a scratch local read after the loop stays on the scalar pipe.
fn eq16_body_ok(m &types.Mir, fi int, bi int, ind int, lim_loc int) bool {
    nloc := types.mir_nlocals(m, fi)
    mut nind := 0
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k != 1 && k != 2 && k != 14 && k != 20 {
            if k == 5 {
                op := types.mir_ib(m, fi, ii)
                if op != 1 && op != 2 { << false }
            } else if k == 4 {
                op := types.mir_ib(m, fi, ii)
                if op != 1 && op != 2 && op != 14 && op != 15 && op != 16 && op != 18 { << false }
            } else if k == 3 {
                loc := types.mir_ia(m, fi, ii)
                if loc == lim_loc { << false }
                if loc == ind {
                    nind = nind + 1
                } else if loc >= 0 {
                    if types.mir_local_nslots(m, fi, loc) != 1 || types.mir_local_ty(m, fi, loc) != 1 {
                        << false
                    }
                }
            } else if k == 17 || k == 26 {
                // Reload of a borrowed string into a frame descriptor.
                // The bytes stay with the caller; this loop only reads them.
                if types.mir_id(m, fi, ii) != 3 { << false }
                dest := types.mir_ia(m, fi, ii)
                if dest < 0 || dest >= types.mir_ntemps(m, fi) { << false }
                if types.mir_temp_ty(m, fi, dest) != 3 { << false }
            } else {
                << false
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if nind != 1 { << false }
    mut st_at := []int{}
    mut ld_at := []int{}
    for _ in 0:nloc {
        st_at.push(-1)
        ld_at.push(-1)
    }
    mut ord := 0
    ii = types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == 3 {
            loc := types.mir_ia(m, fi, ii)
            if loc >= 0 && loc < nloc && loc != ind && st_at[loc] < 0 {
                st_at[loc] = ord
            }
        }
        if k == 2 {
            loc := types.mir_ib(m, fi, ii)
            if loc >= 0 && loc < nloc && loc != ind && ld_at[loc] < 0 {
                ld_at[loc] = ord
            }
        }
        ord = ord + 1
        ii = types.mir_inext(m, fi, ii)
    }
    for loc in 0:nloc {
        if st_at[loc] >= 0 && ld_at[loc] >= 0 && ld_at[loc] < st_at[loc] { << false }
    }
    nb := types.mir_nblocks(m, fi)
    for bj in 0:nb {
        if bj == bi { -> }
        mut jj := types.mir_bhead(m, fi, bj)
        for _ in 0:types.mir_nins(m, fi) {
            if jj < 0 { <- }
            if types.mir_ikind(m, fi, jj) == 2 {
                loc := types.mir_ib(m, fi, jj)
                if loc >= 0 && loc < nloc && loc != ind && st_at[loc] >= 0 { << false }
            }
            jj = types.mir_inext(m, fi, jj)
        }
    }
    << true
}

fn emit_byte_eq16(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int, p VecPat) int {
    if a.arch != 0 && a.arch != 1 { << 0 }
    mut nld := 0
    mut nst := 0
    mut load_t := -1
    mut src_loc := -1
    mut src_base := -1
    mut dst_loc := -1
    mut store_v := -1
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == 14 {
            mut w := types.mir_id(m, fi, ii)
            if w < 0 { w = 0 - w }
            if w != 1 { << 0 }
            if vec_affine_index(m, fi, bi, types.mir_ic(m, fi, ii), p.ind) != 4 { << 0 }
            base := types.mir_ib(m, fi, ii)
            src_loc = vec_base_local(m, fi, bi, base)
            if src_loc < 0 {
                src_loc = eq16_borrowed_ref(m, fi, base)
            }
            if src_loc >= 0 {
                src_base = types.mir_local_operand_base + src_loc
            }
            load_t = types.mir_ia(m, fi, ii)
            nld = nld + 1
        } else if k == 20 {
            mut w := types.mir_id(m, fi, ii)
            if w < 0 { w = 0 - w }
            if w != 1 { << 0 }
            if vec_affine_index(m, fi, bi, types.mir_ib(m, fi, ii), p.ind) != 4 { << 0 }
            dst_loc = vec_base_local(m, fi, bi, types.mir_ia(m, fi, ii))
            store_v = types.mir_ic(m, fi, ii)
            nst = nst + 1
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if nld != 1 || nst != 1 || load_t < 0 || store_v < 0 { << 0 }
    if src_base < 0 || dst_loc < 0 { << 0 }
    if src_loc >= 0 && src_loc == p.ind { << 0 }
    if dst_loc == p.ind { << 0 }
    // Pick the two invariants from the select. Try each int local once.
    nloc := types.mir_nlocals(m, fi)
    mut old_loc := -1
    mut new_loc := -1
    mut old_k := 0
    mut new_k := 0
    mut old_is_k := 0
    mut new_is_k := 0
    mut matched := 0
    for loc in 0:nloc {
        if loc == p.ind || loc == src_loc || loc == dst_loc { -> }
        if types.mir_local_nslots(m, fi, loc) != 1 || types.mir_local_ty(m, fi, loc) != 1 { -> }
        for loc2 in 0:nloc {
            if loc2 == loc || loc2 == p.ind || loc2 == src_loc || loc2 == dst_loc { -> }
            if types.mir_local_nslots(m, fi, loc2) != 1 || types.mir_local_ty(m, fi, loc2) != 1 { -> }
            if eq16_is_sel(m, fi, bi, store_v, load_t, loc, 0, 0, loc2, 0, 0) {
                old_loc = loc
                new_loc = loc2
                matched = 1
            }
        }
    }
    if matched == 0 { << 0 }
    if p.ind < 0 || p.ind >= fr.local_slot.len { << 0 }
    if old_loc < 0 || old_loc >= fr.local_slot.len { << 0 }
    if new_loc < 0 || new_loc >= fr.local_slot.len { << 0 }
    if src_loc >= 0 && src_loc >= fr.local_slot.len { << 0 }
    if dst_loc >= fr.local_slot.len { << 0 }
    if emit_base_fixed_len(m, fi, src_base) > 0 { << 0 }
    if emit_base_fixed_len(m, fi, types.mir_local_operand_base + dst_loc) > 0 { << 0 }
    mut lim_loc := -1
    if p.limit_t >= types.mir_local_operand_base {
        lim_loc = p.limit_t - types.mir_local_operand_base
        if lim_loc < 0 || lim_loc >= fr.local_slot.len { << 0 }
    }
    if !eq16_body_ok(m, fi, bi, p.ind, lim_loc) { << 0 }
    pref := types.mir_fn_label(m, fi) + "_bb" + str(bi)
    vec_lbl := pref + "_eq16"
    sc_lbl := pref + "_eq16s"
    dn_lbl := pref + "_eq16d"
    ov_lbl := pref + "_eq16o"
    else_lbl := types.mir_fn_label(m, fi) + "_bb" + str(p.else_bb)
    a.load(6, 15, slot_off(fr.local_slot[p.ind]))
    if lim_loc >= 0 {
        a.load(1, 15, slot_off(fr.local_slot[lim_loc]))
    } else {
        emit_load_value(a, m, fi, fr, p.limit_t, 1)
    }
    a.vm_cmp_imm(6, 0)
    a.oob_need = 1
    a.jlt(a.oob_lbl + "")
    a.cmp(6, 1)
    a.jge(dn_lbl + "")
    if old_is_k == 1 {
        a.vm_mov_imm64(4, old_k)
    } else {
        a.load(4, 15, slot_off(fr.local_slot[old_loc]))
    }
    if new_is_k == 1 {
        a.vm_mov_imm64(5, new_k)
    } else {
        a.load(5, 15, slot_off(fr.local_slot[new_loc]))
    }
    // The recognizer proved `old` is a byte. Masking keeps DUP and the
    // scalar compare on the same 8 bits.
    a.vm_and_imm(4, 4, 255)
    a.vm_and_imm(5, 5, 255)
    if a.arch == 0 {
        a.be_neon_dup_16b(1, 4)
        a.be_neon_dup_16b(2, 5)
    } else if a.arch == 1 {
        // Broadcast old byte to all 16 lanes of xmm1
        a.x64_mov_imm64(0, 0x0101010101010101)
        a.x64_mov_reg(2, x64_map_reg(4))
        a.x64_imul(2, 0)
        a.x64_movq_xmm_from_r(1, 2)
        a.x64_packed_reg(108, 1, 1)

        // Broadcast new byte to all 16 lanes of xmm2
        a.x64_mov_reg(2, x64_map_reg(5))
        a.x64_imul(2, 0)
        a.x64_movq_xmm_from_r(2, 2)
        a.x64_packed_reg(108, 2, 2)
    }
    emit_index_desc_addr(a, m, fi, fr, src_base)
    a.load(2, 0, -8)
    a.cmp(1, 2)
    a.oob_need = 1
    a.jgt(a.oob_lbl + "")
    a.load(12, 0, 0)
    a.add(12, 12, 6)
    emit_index_desc_addr(a, m, fi, fr, types.mir_local_operand_base + dst_loc)
    a.load(2, 0, -8)
    a.cmp(1, 2)
    a.jgt(a.oob_lbl + "")
    if emit_store_base_is_string(m, fi, types.mir_local_operand_base + dst_loc) {
        a.load(2, 0, -16)
        a.cmp(1, 2)
        a.jgt(a.oob_lbl + "")
    }
    a.load(13, 0, 0)
    a.add(13, 13, 6)
    // Forward same-index map. Identical pointers are in place. Any other
    // overlap keeps the scalar tail, which matches a byte-by-byte walk.
    a.sub(2, 1, 6)
    a.cmp(12, 13)
    a.jeq(ov_lbl + "")
    a.add(3, 12, 2)
    a.cmp(13, 3)
    a.jae(ov_lbl + "")
    a.add(3, 13, 2)
    a.cmp(12, 3)
    a.jae(ov_lbl + "")
    a.jmp(sc_lbl + "")
    a.label(ov_lbl + "")
    // i + 15 < limit, so each 16-byte group stays inside the checked length.
    a.vm_sub_imm(7, 1, 15)
    a.cmp(6, 7)
    a.jge(sc_lbl + "")
    a.label(vec_lbl + "")
    if a.arch == 0 {
        a.be_neon_ldr_q_post16(0, 12)
        a.be_neon_cmeq_16b(3, 0, 1)
        a.be_neon_bit_16b(0, 2, 3)
        a.be_neon_str_q_post16(0, 13)
    } else if a.arch == 1 {
        a.x64_movdqu_load(0, x64_map_reg(12), 0)
        a.x64_packed_reg(111, 3, 0)
        a.x64_packed_reg(116, 3, 1)
        a.x64_packed_reg(111, 4, 2)
        a.x64_packed_reg(219, 4, 3)
        a.x64_packed_reg(223, 3, 0)
        a.x64_packed_reg(235, 4, 3)
        a.x64_movdqu_store(x64_map_reg(13), 0, 4)
        a.vm_add_imm(12, 12, 16)
        a.vm_add_imm(13, 13, 16)
    }
    a.vm_add_imm(6, 6, 16)
    a.cmp(6, 7)
    a.jlt(vec_lbl + "")
    a.label(sc_lbl + "")
    a.cmp(6, 1)
    a.jge(dn_lbl + "")
    a.load_byte(3, 12, 0)
    a.cmp(3, 4)
    if a.arch == 0 {
        a.vm_csel(2, 5, 3, 0)
    } else {
        sk_lbl := pref + "_sk"
        a.mov(2, 3)
        a.jne(sk_lbl + "")
        a.mov(2, 5)
        a.label(sk_lbl + "")
    }
    a.store_byte(13, 0, 2)
    a.vm_add_imm(12, 12, 1)
    a.vm_add_imm(13, 13, 1)
    a.vm_add_imm(6, 6, 1)
    a.jmp(sc_lbl + "")
    a.label(dn_lbl + "")
    a.store(15, slot_off(fr.local_slot[p.ind]), 6)
    a.jmp(else_lbl + "")
    << 1
}

fn eq16_reaches(m &types.Mir, fi int, from int, want int, depth int) bool {
    if from < 0 || depth > 6 { << false }
    if from == want { << true }
    tk := types.mir_btkind(m, fi, from)
    if tk == 1 { << eq16_reaches(m, fi, types.mir_bta(m, fi, from), want, depth + 1) }
    if tk == 2 {
        if eq16_reaches(m, fi, types.mir_btb(m, fi, from), want, depth + 1) { << true }
        << eq16_reaches(m, fi, types.mir_btc(m, fi, from), want, depth + 1)
    }
    << false
}

fn try_eq16_jump(a &mut Assembler, m &types.Mir, fi int, fr &Frame, bi int) int {
    if types.mir_btkind(m, fi, bi) != 1 { << 0 }
    mut header := vec_copy_header(m, fi, bi)
    mut ind := vec_find_ind(m, fi, bi)
    if header < 0 {
        h := vec_skip_empty(m, fi, types.mir_bta(m, fi, bi))
        if h >= 0 && h != bi && types.mir_btkind(m, fi, h) == 2 && ind >= 0 {
            header = h
        }
    }
    if header < 0 || header == bi || ind < 0 { << 0 }
    tb := types.mir_btb(m, fi, header)
    tc := types.mir_btc(m, fi, header)
    mut else_bb := -1
    if eq16_reaches(m, fi, tb, bi, 0) && !eq16_reaches(m, fi, tc, bi, 0) {
        else_bb = tc
    } else if eq16_reaches(m, fi, tc, bi, 0) && !eq16_reaches(m, fi, tb, bi, 0) {
        else_bb = tb
    }
    if else_bb < 0 { << 0 }
    mut hi := types.mir_bhead(m, fi, header)
    for _ in 0:types.mir_nins(m, fi) {
        if hi < 0 { <- }
        hk := types.mir_ikind(m, fi, hi)
        if hk == 3 || hk == 7 || hk == 8 || hk == 9 || hk == 11 || hk == 14 || hk == 18 || hk == 20 || hk == 22 { << 0 }
        hi = types.mir_inext(m, fi, hi)
    }
    limit_t := vec_block_lt_limit(m, fi, header, ind)
    if limit_t < 0 { << 0 }
    mut lim_loc := vec_local_of_temp(m, fi, header, limit_t)
    if lim_loc < 0 { lim_loc = vec_local_of_temp(m, fi, bi, limit_t) }
    mut lim_enc := limit_t
    if lim_loc >= 0 {
        if lim_loc == ind { << 0 }
        lim_enc = types.mir_local_operand_base + lim_loc
    }
    p := VecPat{kind: 19, ind: ind, acc: 0, mask: 0, limit: 0, limit_t: lim_enc, else_bb: else_bb, arr: -1, fac: -1}
    << emit_byte_eq16(a, m, fi, fr, bi, p)
}
