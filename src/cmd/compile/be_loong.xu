@main
// LoongArch64 backend for Gen1 (M39). Port of bootstrap/crates/xubackend/src/loong.rs.
//
// VReg -> physical mapping (LoongArch ELF psABI v2.1):
//   V0-V7  -> t0-t7   (r12-r19, caller-saved)
//   S0-S5  -> s0-s5   (r23-r28, callee-saved)
//   Ret    -> a0      (r4)
//   Fp     -> fp      (r22)
//   Sp     -> sp      (r3)
//   Lr     -> ra      (r1)
//   A0-A5  -> a0-a5   (r4-r9)
//
// r10 (a6) / r11 (a7) stay free: r11 is the Linux syscall-number register.
// r20 (t8) is the dedicated compare/immediate scratch.
//
// LoongArch has no condition flags: `cmp`/`cmp_imm`/`fcmp` record their
// operands in a.cmp_fp/a.cmp_a/a.cmp_b; the immediately-following
// `cset`/`jcc` re-derive the boolean/branch (the emitter always pairs them
// adjacently).

fn lmap_reg(v int) int {
    if v <= 7 { << v + 12 }
    if v <= 13 { << v + 15 }
    if v == 14 { << 4 }
    if v == 15 { << 22 }
    if v == 16 { << 3 }
    if v == 17 { << 1 }
    << v - 14
}

// ===== Data movement =====

fn (a &mut Assembler) lbe_mov(dest int, src int) {
    d := lmap_reg(dest)
    s := lmap_reg(src)
    if d != s {
        a.l_or(d, 0, s) // or rd, r0, rj
    }
}

fn (a &mut Assembler) lbe_mov_imm(dest int, imm int) {
    a.l_mov_imm(lmap_reg(dest), imm)
}

fn (a &mut Assembler) lbe_mov_imm64(dest int, imm int) {
    a.l_mov_imm64(lmap_reg(dest), imm)
}

fn (a &mut Assembler) lbe_lea(dest int, label string) {
    a.l_lea(lmap_reg(dest), label)
}

fn (a &mut Assembler) lbe_load(dest int, base int, offset int) {
    d := lmap_reg(dest)
    b := lmap_reg(base)
    if offset >= -2048 && offset <= 2047 {
        a.l_ld_d(d, b, offset)
    } else {
        if offset >= 0 {
            a.l_mov_imm(20, offset)
            a.l_add_d(20, 20, b)
            a.l_ld_d(d, 20, 0)
        } else {
            a.l_mov_imm(20, 0 - offset)
            a.l_sub_d(20, b, 20)
            a.l_ld_d(d, 20, 0)
        }
    }
}

fn (a &mut Assembler) lbe_store(base int, offset int, src int) {
    b := lmap_reg(base)
    s := lmap_reg(src)
    if offset >= -2048 && offset <= 2047 {
        a.l_st_d(s, b, offset)
    } else {
        if offset >= 0 {
            a.l_mov_imm(20, offset)
            a.l_add_d(20, 20, b)
            a.l_st_d(s, 20, 0)
        } else {
            a.l_mov_imm(20, 0 - offset)
            a.l_sub_d(20, b, 20)
            a.l_st_d(s, 20, 0)
        }
    }
}

fn (a &mut Assembler) lbe_store_byte(base int, offset int, src int) {
    b := lmap_reg(base)
    s := lmap_reg(src)
    if offset >= -2048 && offset <= 2047 {
        a.l_st_b(s, b, offset)
    } else {
        if offset >= 0 {
            a.l_mov_imm(20, offset)
            a.l_add_d(20, 20, b)
            a.l_st_b(s, 20, 0)
        } else {
            a.l_mov_imm(20, 0 - offset)
            a.l_sub_d(20, b, 20)
            a.l_st_b(s, 20, 0)
        }
    }
}

fn (a &mut Assembler) lbe_load_byte(dest int, base int, offset int) {
    d := lmap_reg(dest)
    b := lmap_reg(base)
    if offset >= -2048 && offset <= 2047 {
        a.l_ld_bu(d, b, offset)
    } else {
        if offset >= 0 {
            a.l_mov_imm(20, offset)
            a.l_add_d(20, 20, b)
            a.l_ld_bu(d, 20, 0)
        } else {
            a.l_mov_imm(20, 0 - offset)
            a.l_sub_d(20, b, 20)
            a.l_ld_bu(d, 20, 0)
        }
    }
}

// ===== Arithmetic =====

fn (a &mut Assembler) lbe_add(dest int, x int, y int) {
    a.l_add_d(lmap_reg(dest), lmap_reg(x), lmap_reg(y))
}

fn (a &mut Assembler) lbe_add_imm(dest int, src int, imm int) {
    d := lmap_reg(dest)
    s := lmap_reg(src)
    if imm <= 2047 {
        a.l_addi_d(d, s, imm)
    } else {
        a.l_mov_imm(20, imm)
        a.l_add_d(d, s, 20)
    }
}

fn (a &mut Assembler) lbe_sub(dest int, x int, y int) {
    a.l_sub_d(lmap_reg(dest), lmap_reg(x), lmap_reg(y))
}

fn (a &mut Assembler) lbe_sub_imm(dest int, src int, imm int) {
    d := lmap_reg(dest)
    s := lmap_reg(src)
    if imm <= 2047 {
        a.l_addi_d(d, s, 0 - imm)
    } else {
        a.l_mov_imm(20, imm)
        a.l_sub_d(d, s, 20)
    }
}

fn (a &mut Assembler) lbe_mul(dest int, x int, y int) {
    a.l_mul_d(lmap_reg(dest), lmap_reg(x), lmap_reg(y))
}

fn (a &mut Assembler) lbe_div(dest int, x int, y int) {
    a.l_div_d(lmap_reg(dest), lmap_reg(x), lmap_reg(y))
}

fn (a &mut Assembler) lbe_mod(dest int, x int, y int) {
    a.l_mod_d(lmap_reg(dest), lmap_reg(x), lmap_reg(y))
}

fn (a &mut Assembler) lbe_neg(dest int, src int) {
    a.l_sub_d(lmap_reg(dest), 0, lmap_reg(src))
}

fn (a &mut Assembler) lbe_shl_imm(dest int, src int, imm int) {
    a.l_slli_d(lmap_reg(dest), lmap_reg(src), imm)
}

fn (a &mut Assembler) lbe_shr_imm(dest int, src int, imm int) {
    a.l_srli_d(lmap_reg(dest), lmap_reg(src), imm)
}

fn (a &mut Assembler) lbe_and(dest int, x int, y int) {
    a.l_and(lmap_reg(dest), lmap_reg(x), lmap_reg(y))
}

fn (a &mut Assembler) lbe_and_imm(dest int, src int, imm int) {
    if imm >= 0 && imm <= 4095 {
        a.l_andi(lmap_reg(dest), lmap_reg(src), imm)
        <<
    }
    a.l_mov_imm(lmap_reg(1), imm)
    a.lbe_and(dest, src, 1)
}

fn (a &mut Assembler) lbe_or(dest int, x int, y int) {
    a.l_or(lmap_reg(dest), lmap_reg(x), lmap_reg(y))
}

fn (a &mut Assembler) lbe_xor(dest int, x int, y int) {
    a.l_xor(lmap_reg(dest), lmap_reg(x), lmap_reg(y))
}

fn (a &mut Assembler) lbe_shl(dest int, src int, count int) {
    a.l_sll_d(lmap_reg(dest), lmap_reg(src), lmap_reg(count))
}

fn (a &mut Assembler) lbe_shr(dest int, src int, count int) {
    a.l_sra_d(lmap_reg(dest), lmap_reg(src), lmap_reg(count))
}

// ===== Compare & jump =====

fn (a &mut Assembler) lbe_cmp(x int, y int) {
    a.cmp_fp = 0
    a.cmp_a = lmap_reg(x)
    a.cmp_b = lmap_reg(y)
}

fn (a &mut Assembler) lbe_cmp_imm(x int, imm int) {
    a.cmp_fp = 0
    ra := lmap_reg(x)
    if imm >= -2048 && imm <= 2047 {
        a.l_addi_d(20, 0, imm) // T8 = imm
    } else {
        a.l_mov_imm(20, imm)
    }
    a.cmp_a = ra
    a.cmp_b = 20
}

fn (a &mut Assembler) lbe_cset(dest int, cond int) {
    d := lmap_reg(dest)
    if a.cmp_fp == 1 {
        if cond == 0 {
            a.l_fcmp_d(2, 7, 0, 1) // ceq
        } else if cond == 1 {
            a.l_fcmp_d(8, 7, 0, 1) // cne
        } else if cond == 11 {
            a.l_fcmp_d(1, 7, 0, 1) // clt
        } else if cond == 13 {
            a.l_fcmp_d(3, 7, 0, 1) // cle
        } else if cond == 12 {
            a.l_fcmp_d(1, 7, 1, 0) // clt (swapped)
        } else {
            a.l_fcmp_d(3, 7, 1, 0) // cle (swapped)
        }
        a.l_movcf2gr(d, 7)
        <<
    }
    aa := a.cmp_a
    bb := a.cmp_b
    if cond == 0 {
        a.l_sub_d(20, aa, bb)
        a.l_sltui(d, 20, 1)
    } else if cond == 1 {
        a.l_sub_d(20, aa, bb)
        a.l_sltu(d, 0, 20)
    } else if cond == 11 {
        a.l_slt(d, aa, bb)
    } else if cond == 13 {
        a.l_slt(20, bb, aa)
        a.l_xori(d, 20, 1)
    } else if cond == 12 {
        a.l_slt(d, bb, aa)
    } else {
        a.l_slt(20, aa, bb)
        a.l_xori(d, 20, 1)
    }
}

fn (a &mut Assembler) lbe_jmp(label string) { a.l_b(label) }

fn (a &mut Assembler) lbe_jeq(label string) { a.l_beq(a.cmp_a, a.cmp_b, label) }
fn (a &mut Assembler) lbe_jne(label string) { a.l_bne(a.cmp_a, a.cmp_b, label) }
fn (a &mut Assembler) lbe_jlt(label string) { a.l_blt(a.cmp_a, a.cmp_b, label) }
fn (a &mut Assembler) lbe_jle(label string) { a.l_bge(a.cmp_b, a.cmp_a, label) }
fn (a &mut Assembler) lbe_jgt(label string) { a.l_blt(a.cmp_b, a.cmp_a, label) }
fn (a &mut Assembler) lbe_jge(label string) { a.l_bge(a.cmp_a, a.cmp_b, label) }
fn (a &mut Assembler) lbe_jae(label string) { a.l_bgeu(a.cmp_a, a.cmp_b, label) }

fn (a &mut Assembler) lbe_cbz(reg int, label string) { a.l_beqz(lmap_reg(reg), label) }
fn (a &mut Assembler) lbe_cbnz(reg int, label string) { a.l_bnez(lmap_reg(reg), label) }

// ===== Function calls =====

fn (a &mut Assembler) lbe_prologue(frame_size int) {
    // Save S0–S5 (r23–r28) below the FP/RA link (matches xubackend).
    a.l_addi_d(3, 3, -48)
    a.l_st_d(23, 3, 0)
    a.l_st_d(24, 3, 8)
    a.l_st_d(25, 3, 16)
    a.l_st_d(26, 3, 24)
    a.l_st_d(27, 3, 32)
    a.l_st_d(28, 3, 40)
    a.l_addi_d(3, 3, -16)   // sp -= 16
    a.l_st_d(1, 3, 0)       // [sp] = ra
    a.l_st_d(22, 3, 8)      // [sp+8] = fp
    a.l_or(22, 0, 3)        // fp = sp (or fp, r0, sp)
    if frame_size > 0 {
        if frame_size <= 2047 {
            a.l_addi_d(3, 3, 0 - frame_size)
        } else {
            a.l_mov_imm(20, frame_size)
            a.l_sub_d(3, 3, 20)
        }
    }
}

fn (a &mut Assembler) lbe_epilogue() {
    a.l_or(3, 0, 22)        // sp = fp
    a.l_ld_d(22, 3, 8)      // fp = [sp+8]
    a.l_ld_d(1, 3, 0)       // ra = [sp+0]
    a.l_addi_d(3, 3, 16)    // sp += 16
    a.l_ld_d(23, 3, 0)
    a.l_ld_d(24, 3, 8)
    a.l_ld_d(25, 3, 16)
    a.l_ld_d(26, 3, 24)
    a.l_ld_d(27, 3, 32)
    a.l_ld_d(28, 3, 40)
    a.l_addi_d(3, 3, 48)
    a.l_ret()
}

fn (a &mut Assembler) lbe_call(label string) { a.l_bl(label) }

fn (a &mut Assembler) lbe_call_reg(target int) { a.l_jirl(1, lmap_reg(target), 0) }

fn (a &mut Assembler) lbe_ret() { a.l_ret() }

// ===== Floating point (bits in GPRs; M13) =====

fn (a &mut Assembler) lbe_fadd(dest int, x int, y int) {
    da := lmap_reg(x)
    db := lmap_reg(y)
    dd := lmap_reg(dest)
    a.l_movgr2fr_d(0, da)
    a.l_movgr2fr_d(1, db)
    a.l_fadd_d(0, 0, 1)
    a.l_movfr2gr_d(dd, 0)
}

fn (a &mut Assembler) lbe_fsub(dest int, x int, y int) {
    da := lmap_reg(x)
    db := lmap_reg(y)
    dd := lmap_reg(dest)
    a.l_movgr2fr_d(0, da)
    a.l_movgr2fr_d(1, db)
    a.l_fsub_d(0, 0, 1)
    a.l_movfr2gr_d(dd, 0)
}

fn (a &mut Assembler) lbe_fmul(dest int, x int, y int) {
    da := lmap_reg(x)
    db := lmap_reg(y)
    dd := lmap_reg(dest)
    a.l_movgr2fr_d(0, da)
    a.l_movgr2fr_d(1, db)
    a.l_fmul_d(0, 0, 1)
    a.l_movfr2gr_d(dd, 0)
}

fn (a &mut Assembler) lbe_fdiv(dest int, x int, y int) {
    da := lmap_reg(x)
    db := lmap_reg(y)
    dd := lmap_reg(dest)
    a.l_movgr2fr_d(0, da)
    a.l_movgr2fr_d(1, db)
    a.l_fdiv_d(0, 0, 1)
    a.l_movfr2gr_d(dd, 0)
}

fn (a &mut Assembler) lbe_fneg(dest int, src int) {
    ds := lmap_reg(src)
    dd := lmap_reg(dest)
    a.l_movgr2fr_d(0, ds)
    a.l_fneg_d(0, 0)
    a.l_movfr2gr_d(dd, 0)
}

fn (a &mut Assembler) lbe_fsqrt(dest int, src int) {
    ds := lmap_reg(src)
    dd := lmap_reg(dest)
    a.l_movgr2fr_d(0, ds)
    a.l_fsqrt_d(0, 0)
    a.l_movfr2gr_d(dd, 0)
}

fn (a &mut Assembler) lbe_clz(dest int, src int) {
    a.l_clz_d(lmap_reg(dest), lmap_reg(src))
}

fn (a &mut Assembler) lbe_ctz(dest int, src int) {
    a.l_ctz_d(lmap_reg(dest), lmap_reg(src))
}

fn (a &mut Assembler) lbe_rbit(dest int, src int) {
    a.l_bitrev_d(lmap_reg(dest), lmap_reg(src))
}

fn (a &mut Assembler) lbe_fcmp(x int, y int) {
    a.cmp_fp = 1
    da := lmap_reg(x)
    db := lmap_reg(y)
    a.l_movgr2fr_d(0, da)
    a.l_movgr2fr_d(1, db)
}

fn (a &mut Assembler) lbe_scvtf(dest int, src int) {
    ds := lmap_reg(src)
    dd := lmap_reg(dest)
    a.l_movgr2fr_d(0, ds)
    a.l_ffint_d_l(0, 0)
    a.l_movfr2gr_d(dd, 0)
}

fn (a &mut Assembler) lbe_fcvtzs(dest int, src int) {
    ds := lmap_reg(src)
    dd := lmap_reg(dest)
    a.l_movgr2fr_d(0, ds)
    a.l_ftintrz_l_d(0, 0)
    a.l_movfr2gr_d(dd, 0)
}

// ===== Platform-specific =====

fn (a &mut Assembler) lbe_syscall(num int) {
    a.l_mov_imm(11, num) // a7 = syscall number
    a.l_syscall()
}

fn (a &mut Assembler) lbe_call_iat(label string) {
    a.lbe_lea(0, label)
    a.lbe_load(0, 0, 0)
    a.lbe_call_reg(0)
}

fn (a &mut Assembler) lbe_call_iat7(label string) {
    a.lbe_call_iat(label)
}

// Linux returns -errno directly in a0; no normalization needed (like arm64).
fn (a &mut Assembler) lbe_normalize_syscall(ok_label string) {
}

// ===== Atomics (M35) =====

fn (a &mut Assembler) lbe_atomic_xchg(dest int, addr int, val int) {
    a.l_amswap_d(lmap_reg(dest), lmap_reg(addr), lmap_reg(val))
}

fn (a &mut Assembler) lbe_atomic_load(dest int, addr int) {
    a.l_ld_d(lmap_reg(dest), lmap_reg(addr), 0)
    a.l_dbar()
}

fn (a &mut Assembler) lbe_atomic_store(addr int, val int) {
    a.l_dbar()
    a.l_st_d(lmap_reg(val), lmap_reg(addr), 0)
}

fn (a &mut Assembler) lbe_atomic_add(dest int, addr int, val int) {
    a.l_amadd_d(lmap_reg(dest), lmap_reg(addr), lmap_reg(val))
}

fn (a &mut Assembler) lbe_atomic_cas(dest int, addr int, old int, new int) {
    n := a.drop_seq
    a.drop_seq = a.drop_seq + 1
    mut labs := []string{}
    labs.push("_xul_cas_" + str(n))
    labs.push("_xul_cas_f_" + str(n))
    labs.push("_xul_cas_d_" + str(n))
    d := lmap_reg(dest)
    ad := lmap_reg(addr)
    o := lmap_reg(old)
    nv := lmap_reg(new)
    a.label(labs[0])
    a.l_ll_d(20, ad, 0)      // T8 = [addr] (load-linked)
    a.l_bne(20, o, labs[1])  // if T8 != old -> fail
    a.l_or(20, 0, nv)        // T8 = new
    a.l_sc_d(20, ad, 0)      // [addr] = T8; T8 = 1 success / 0 failure
    a.l_beqz(20, labs[0])    // retry on failure
    a.l_addi_d(d, 0, 1)
    a.l_b(labs[2])
    a.label(labs[1])
    a.l_addi_d(d, 0, 0)
    a.label(labs[2])
}
