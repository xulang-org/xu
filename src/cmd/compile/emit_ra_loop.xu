@main

#xu/types

// Loop / leaf / pin-eligibility predicates. Split from emit_frame.xu.

fn mir_temp_uses_from(m &types.Mir, fi int, t int, start_ii int) int {
    if t < 0 || start_ii < 0 { << 0 }
    mut count := 0
    mut ii := start_ii
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { << count }
        count += types.mir_instr_read_occurrences_m(m, fi, ii, t)
        ii = types.mir_inext(m, fi, ii)
    }
    if ii >= 0 { count += 2 }
    << count
}

// True when some MIR temp mapped to `slot` still has operand uses from
// `start_ii` onward. Used to skip dead "materialize previous alias" stores
// when LoadLocal retargets a pin/home alias (nbody: j's index temp before j+=1).
fn rc_slot_temp_live_from(m &types.Mir, fi int, fr &Frame, slot int, start_ii int) bool {
    if slot < 0 || start_ii < 0 {
        << false
    }
    for t in 0:fr.temp_slot.len {
        if fr.temp_slot[t] == slot {
            if mir_temp_uses_from(m, fi, t, start_ii) > 0 {
                << true
            }
        }
    }
    << false
}

// Dest can stay SIMD-only when every remaining use is FP-aware (binop /
// sqrt / StorePtr / StoreBufPtr). Multiple uses OK (`dx*dx`).
fn fn_uses_s_scratch(m &types.Mir, fi int) int {
    // S0–S5 scratch: drop / array / iface / spawn / index (S4/S5).
    // Scalar field/pointer mem (10/11/16/17/18) only uses V0–V2 — must not
    // force cs_pairs=3.
    for ii in 0:types.mir_nins(m, fi) {
        ik := types.mir_ikind(m, fi, ii)
        // Retired stable InstrIds are explicit NoOp records. They have no
        // emitted instruction or scratch effect; unknown real opcodes below
        // remain conservative. Do not turn deletion into extra callee saves.
        if ik == types.MI_NOP || ik == types.MI_COPY || ik == types.MI_LOAD_LOCAL || ik == types.MI_STORE_LOCAL || ik == types.MI_BIN || ik == types.MI_UN || ik == types.MI_STR_CONST || ik == types.MI_CALL || ik == types.MI_LOAD_FIELD || ik == types.MI_STORE_FIELD || ik == types.MI_ADDR || ik == types.MI_LOAD_PTR || ik == types.MI_STORE_PTR || ik == types.MI_LOAD_FN_ADDR || ik == types.MI_FIELD_RMW {
            ->
        }
        << 1
    }
    << 0
}

// True when S0–S3 are free for O2-style pins: no drop / iface / spawn
// scratch there. Index/ElemAddr/BufPtr only touch S4/S5 — pin-safe.
// Walk live block chains only (detached instrs after a CFG split must not
// keep an otherwise pin-safe kernel off the S pool). Drop/ArrayLit stay
// out: they scratch S1, which is an S-pool pin home.
fn fn_s_pin_safe(m &types.Mir, fi int) int {
    for bi in 0:types.mir_nblocks(m, fi) {
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 {
                <-
            }
            ik := types.mir_ikind(m, fi, ii)
            mut ok := false
            if ik == types.MI_COPY || ik == types.MI_LOAD_LOCAL || ik == types.MI_STORE_LOCAL || ik == types.MI_BIN || ik == types.MI_UN || ik == types.MI_STR_CONST || ik == types.MI_CALL || ik == types.MI_STR_CLONE || ik == types.MI_LOAD_FIELD || ik == types.MI_STORE_FIELD || ik == types.MI_ARR_PUSH || ik == types.MI_ADDR || ik == types.MI_LOAD_PTR || ik == types.MI_STORE_PTR || ik == types.MI_LOAD_FN_ADDR || ik == types.MI_ARR_PUSH4 || ik == types.MI_FIELD_RMW {
                ok = true
            }
            // Epilogue Drop is not an S-scratch hazard on small kernels
            // (f64_sum). Compiler-sized functions stay closed.
            if ik == types.MI_DROP && types.mir_nblocks(m, fi) <= 12 && types.mir_ntemps(m, fi) <= 48 {
                ok = true
            }
            // Index / ElemAddr / BufPtr / IndexRMW: S4/S5 only.
            if ik == types.MI_LOAD_INDEX || ik == types.MI_STORE_INDEX || ik == types.MI_ELEM_ADDR || ik == types.MI_STORE_BUF_PTR || ik == types.MI_LOAD_BUF_PTR || ik == types.MI_INDEX_RMW {
                ok = true
            }
            // InterfaceMethod data* lives in S4, same as index. Box is
            // entry-only in iface_sum; S0–S3 stay pin homes.
            if ik == types.MI_BOX_INTERFACE || ik == types.MI_INTERFACE_METHOD || ik == types.MI_BOX_TEMP {
                ok = true
            }
            if !ok {
                << 0
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << 1
}

fn mir_all_s_pin_safe(m &types.Mir) int {
    for fi in 0:m.fns.len {
        if types.mir_fn_is_extern(m, fi) { -> }
        if fn_s_pin_safe(m, fi) == 0 {
            << 0
        }
    }
    << 1
}

fn mir_has_self_loop(m &types.Mir) int {
    for fi in 0:m.fns.len {
        if types.mir_fn_is_extern(m, fi) { -> }
        nblk := types.mir_nblocks(m, fi)
        for bi in 0:nblk {
            tkind := types.mir_btkind(m, fi, bi)
            if tkind == 1 && types.mir_bta(m, fi, bi) == bi {
                << 1
            }
            if tkind == 2 && (types.mir_btb(m, fi, bi) == bi || types.mir_btc(m, fi, bi) == bi) {
                << 1
            }
        }
    }
    << 0
}

fn fn_is_self_recursive(m &types.Mir, fi int) bool {
    lab := types.mir_fn_label(m, fi) + ""
    if lab.len == 0 { << false }
    for bi in 0:types.mir_nblocks(m, fi) {
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            if types.mir_ikind(m, fi, ii) == types.MI_CALL && types.mir_ib(m, fi, ii) == 1 {
                if types.mir_isval(m, fi, ii) == lab {
                    << true
                }
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << false
}

fn fn_has_self_loop(m &types.Mir, fi int) int {
    mut f := types.mir_cfg_clone_fn(m, fi, false)
    for bi in 0:f.blocks.len {
        tkind := f.blocks[bi].tkind
        if tkind == 1 && f.blocks[bi].ta == bi { << 1 }
        if tkind == 2 && (f.blocks[bi].tb == bi || f.blocks[bi].tc == bi) { << 1 }
    }
    << 0
}

fn fn_has_any_index(m &types.Mir, fi int) bool {
    for bi in 0:types.mir_nblocks(m, fi) {
        if block_has_index(m, fi, bi) {
            << true
        }
    }
    << false
}

// 8-byte LoadIndex only. ElemAddr of `[]Struct` (RGBA = 32) must not take
// the assign-diamond kernel: V6/fold treated the induction as a pointer.
fn fn_has_i64_loadindex(m &types.Mir, fi int) bool {
    for bi in 0:types.mir_nblocks(m, fi) {
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            if types.mir_ikind(m, fi, ii) == types.MI_LOAD_INDEX {
                es := types.mir_id(m, fi, ii)
                if es == 8 || es == 0 - 8 {
                    << true
                }
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << false
}

fn fn_has_memory_write(m &types.Mir, fi int) bool {
    for bi in 0:types.mir_nblocks(m, fi) {
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            ik := types.mir_ikind(m, fi, ii)
            if ik == types.MI_STORE_FIELD || ik == types.MI_ARR_PUSH || ik == types.MI_STORE_PTR || ik == types.MI_STORE_INDEX || ik == types.MI_STORE_BUF_PTR || ik == types.MI_ARR_PUSH4 || ik == types.MI_INDEX_RMW || ik == types.MI_FIELD_RMW {
                << true
            }
            if ik == types.MI_CALL && types.mir_ib(m, fi, ii) == 95 {
                << true
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << false
}

// StorePtr/Index/RMW. ArrPush and ctor StoreField are entry init
// (iface_sum `xs.push(Src(A{x:1}))`) and must not poison latch skip-store.
fn fn_has_slot_mem_write(m &types.Mir, fi int) bool {
    for bi in 0:types.mir_nblocks(m, fi) {
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            ik := types.mir_ikind(m, fi, ii)
            if ik == types.MI_STORE_PTR || ik == types.MI_STORE_INDEX || ik == types.MI_STORE_BUF_PTR || ik == types.MI_INDEX_RMW || ik == types.MI_FIELD_RMW {
                << true
            }
            if ik == types.MI_CALL && types.mir_ib(m, fi, ii) == 95 {
                << true
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << false
}

// StoreIndex (20) / IndexRMW (47) only. Field/Ptr/ArrPush stay out — those
// still need skip-store off. Clone: Gen1 nested `m.fns[fi].instrs[ii]`
// misreads kinds.
fn fn_index_writes_only(m &types.Mir, fi int) bool {
    mut f := types.mir_cfg_clone_fn(m, fi, true)
    mut saw := false
    mut other := false
    for ii in 0:f.instrs.len {
        ik := types.mfn_ikind(&f.instrs, ii)
        if ik == types.MI_STORE_INDEX || ik == types.MI_INDEX_RMW {
            saw = true
        } else if ik == types.MI_STORE_FIELD || ik == types.MI_ARR_PUSH || ik == types.MI_STORE_PTR || ik == types.MI_STORE_BUF_PTR || ik == types.MI_ARR_PUSH4 || ik == types.MI_FIELD_RMW {
            other = true
        } else if ik == types.MI_CALL && types.mfn_ib(&f.instrs, ii) == 95 {
            other = true
        }
    }
    << saw && !other
}

fn fn_has_direct_user_call(m &types.Mir, fi int) bool {
    mut f := types.mir_cfg_clone_fn(m, fi, true)
    for ii in 0:f.instrs.len {
        if types.mfn_ikind(&f.instrs, ii) != types.MI_CALL {
            ->
        }
        ck := types.mfn_ib(&f.instrs, ii)
        if ck != 1 {
            ->
        }
        sval := types.mfn_isval(&f.instrs, ii)
        if sval == f.label {
            ->
        }
        if sval == "_xu_math_sqrt" {
            ->
        }
        << true
    }
    << false
}

// search_ints: natural loop + LoadIndex, no StoreIndex. Insertion/partition
// have StoreIndex and must not take this path. A Call (search_strings) is
// not a closed kernel — pins would not survive `bl`.
fn fn_is_small_indexed_kernel(m &types.Mir, fi int) bool {
    if types.mir_fn_is_extern(m, fi) { << false }
    if types.mir_nblocks(m, fi) > 16 { << false }
    if types.mir_nlocals(m, fi) > 12 { << false }
    if types.mir_ntemps(m, fi) > 64 { << false }
    if types.mir_fn_ret_nslots(m, fi) > 1 { << false }
    if fn_has_memory_write(m, fi) { << false }
    if !fn_has_any_index(m, fi) { << false }
    for bi in 0:types.mir_nblocks(m, fi) {
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 {
                <-
            }
            if types.mir_ikind(m, fi, ii) == types.MI_CALL && types.mir_ib(m, fi, ii) != 95 {
                << false
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << fn_has_assign_diamond(m, fi)
}

// nbody `advance`: FieldRMW of f64 fields through `&[N]struct`, plus
// canonical math.sqrt that hosted 64-bit backends lower without `bl`.
// Large units (`nfn>64`) otherwise skip natural-loop detection; this
// kernel is the FieldRMW analogue of `fn_is_small_indexed_kernel`.
fn fn_is_f64_field_rmw_kernel(m &types.Mir, fi int) bool {
    if types.mir_fn_is_extern(m, fi) { << false }
    if types.mir_nblocks(m, fi) > 128 { << false }
    if types.mir_nlocals(m, fi) > 48 { << false }
    if types.mir_ntemps(m, fi) > VREG_PLAN_TEMP_CAP { << false }
    mut has_f64 := false
    mut has_frmw := false
    mut other_st := false
    mut bad_call := false
    for i in 0:types.mir_nlocals(m, fi) {
        if types.mir_local_ty(m, fi, i) == 4 {
            has_f64 = true
        }
    }
    for i in 0:types.mir_ntemps(m, fi) {
        if types.mir_temp_ty(m, fi, i) == 4 {
            has_f64 = true
        }
    }
    if !has_f64 {
        << false
    }
    // Clone: Gen1 `m.fns[fi].instrs[ii]` misreads kinds (same as
    // product_rc_mir_safe / fn_index_writes_only). Walk the live linked
    // lists only — dead pool records from CFG rewrites would otherwise
    // count leftover Calls as `bad_call` and keep RA off nbody `advance`.
    mut f := types.mir_cfg_clone_fn(m, fi, true)
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            ik := types.mfn_ikind(&f.instrs, ii)
            // LoadPtr/LoadBufPtr of f64 (nbody energy) share the same
            // FP-home need as FieldRMW; without them `dx*dx` sees a
            // clobbered GPR/FP temp and the potential term becomes 0.
            if ik == types.MI_FIELD_RMW || ik == types.MI_STORE_BUF_PTR || ik == types.MI_STORE_PTR || ik == types.MI_LOAD_PTR || ik == types.MI_LOAD_BUF_PTR {
                has_frmw = true
            }
            if ik == types.MI_STORE_FIELD || ik == types.MI_ARR_PUSH || ik == types.MI_STORE_INDEX || ik == types.MI_ARR_PUSH4 || ik == types.MI_INDEX_RMW {
                other_st = true
            }
            if ik == types.MI_CALL {
                ck := types.mfn_ib(&f.instrs, ii)
                if ck == 95 {
                    other_st = true
                } else if ck == 1 {
                    sval := types.mfn_isval(&f.instrs, ii)
                    if sval != "_xu_math_sqrt" {
                        bad_call = true
                    }
                } else if ck != 2 && ck != 3 && ck != 4 && ck != 5 && ck != 22 {
                    bad_call = true
                }
            }
            ii = types.mfn_inext(&f.instrs, ii)
        }
    }
    << has_f64 && has_frmw && !other_st && !bad_call
}

// Indexed f64 loops use whole-CFG fixed homes. The descriptor cache is only
// a memory-access aid; it must not substitute a private accumulator pin for
// the allocator's live scalar values or elide repeated indexed reads.
fn fn_is_f64_index_acc_kernel(m &types.Mir, fi int) bool {
    if types.mir_fn_is_extern(m, fi) { << false }
    if types.mir_nblocks(m, fi) > 128 { << false }
    for bi in 0:types.mir_nblocks(m, fi) {
        if block_ip0_arr_key(m, fi, bi) >= 0 {
            << true
        }
    }
    << false
}

// Scalar f64 arithmetic in a bounded loop, with optional scalar indexed
// access. Pure arithmetic needs the same whole-CFG homes as indexed loops:
// requiring an index left multi-block scalar loops entirely frame-backed.
// Descriptors and unused reference parameters stay in the frame; the planner
// verifies widths, effects, liveness and scratch homes. Field writes use a
// separate admission proof. A proven single-accumulator self-loop keeps its
// existing FP-cache path; whole-CFG homes must not displace that residency.
// The shape is independent of source names.
fn fn_is_f64_scalar_loop_kernel(m &types.Mir, fi int) bool {
    if types.mir_fn_is_extern(m, fi) { << false }
    if types.mir_nblocks(m, fi) > 128 { << false }
    if types.mir_nlocals(m, fi) > 48 { << false }
    if types.mir_ntemps(m, fi) > 768 { << false }
    mut has_idx := false
    mut has_f64 := false
    mut other_st := false
    mut bad_call := false
    for i in 0:types.mir_nlocals(m, fi) {
        if types.mir_local_ty(m, fi, i) == 4 { has_f64 = true }
    }
    for i in 0:types.mir_ntemps(m, fi) {
        if types.mir_temp_ty(m, fi, i) == 4 { has_f64 = true }
    }
    if !has_f64 { << false }
    mut f := types.mir_cfg_clone_fn(m, fi, true)
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            ik := types.mfn_ikind(&f.instrs, ii)
            if ik == types.MI_LOAD_INDEX || ik == types.MI_STORE_INDEX { has_idx = true }
            if ik == types.MI_STORE_FIELD || ik == types.MI_ARR_PUSH || ik == types.MI_STORE_PTR || ik == types.MI_STORE_BUF_PTR || ik == types.MI_ARR_PUSH4 || ik == types.MI_INDEX_RMW || ik == types.MI_FIELD_RMW {
                other_st = true
            }
            if ik == types.MI_CALL {
                ck := types.mfn_ib(&f.instrs, ii)
                if ck == 95 {
                    other_st = true
                } else if ck == 1 {
                    sval := types.mfn_isval(&f.instrs, ii)
                    if sval != "_xu_math_sqrt" {
                        bad_call = true
                    }
                } else if ck != 2 && ck != 3 && ck != 4 && ck != 5 && ck != 22 {
                    bad_call = true
                }
            }
            ii = types.mfn_inext(&f.instrs, ii)
        }
    }
    if !has_f64 || other_st || bad_call { << false }
    if fn_has_natural_loop(m, fi) == 0 && fn_has_self_loop(m, fi) == 0 { << false }
    if !has_idx && f64_loop_fp_only_admit(m, fi) { << false }
    << true
}

// sha256 `compress_block`: integer LoadIndex/StoreIndex, 8-word state in
// scalar locals. Descriptors stay frame-backed. Not FieldRMW (that kernel
// is f64) and not the f64 index-acc kernel.
fn fn_is_int_index_kernel(m &types.Mir, fi int) bool {
    if types.mir_fn_is_extern(m, fi) { << false }
    if types.mir_nblocks(m, fi) > 128 { << false }
    if types.mir_nlocals(m, fi) > 48 { << false }
    if types.mir_ntemps(m, fi) > VREG_PLAN_TEMP_CAP { << false }
    mut has_i64 := false
    mut has_f64 := false
    mut has_ld := false
    mut has_st := false
    mut has_i_idx := false
    mut other_st := false
    mut bad_call := false
    for i in 0:types.mir_nlocals(m, fi) {
        ty := types.mir_local_ty(m, fi, i)
        if ty == 4 { has_f64 = true }
        if ty == 1 { has_i64 = true }
    }
    for i in 0:types.mir_ntemps(m, fi) {
        ty := types.mir_temp_ty(m, fi, i)
        if ty == 4 { has_f64 = true }
        if ty == 1 { has_i64 = true }
    }
    if has_f64 || !has_i64 {
        << false
    }
    mut f := types.mir_cfg_clone_fn(m, fi, true)
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            ik := types.mfn_ikind(&f.instrs, ii)
            if ik == types.MI_LOAD_INDEX {
                has_ld = true
                d := types.mfn_ia(&f.instrs, ii)
                if d >= 0 && d < types.mir_ntemps(m, fi) {
                    if types.mir_temp_ty(m, fi, d) == 1 {
                        has_i_idx = true
                    }
                }
            }
            if ik == types.MI_STORE_INDEX {
                has_st = true
                v := types.mfn_ic(&f.instrs, ii)
                if v >= 0 && v < types.mir_ntemps(m, fi) {
                    if types.mir_temp_ty(m, fi, v) == 1 {
                        has_i_idx = true
                    }
                }
            }
            if ik == types.MI_INDEX_RMW {
                has_ld = true
                has_st = true
                v := types.mfn_ic(&f.instrs, ii)
                if v >= 0 && v < types.mir_ntemps(m, fi) {
                    if types.mir_temp_ty(m, fi, v) == 1 {
                        has_i_idx = true
                    }
                }
            }
            if ik == types.MI_STORE_BUF_PTR || ik == types.MI_ARR_PUSH4 || ik == types.MI_FIELD_RMW {
                other_st = true
            }
            // Multi-word LoadPtr/LoadBufPtr copies of `[]int` / struct
            // fields are frame-layout sensitive. Borrowed string views have the
            // established three-word string layout and remain frame-backed;
            // array/struct descriptor materialization stays excluded.
            // vreg turns rc_on off, so
            // the rc_nat_wb skip no longer hides a bad 3-slot materialize
            // (sha256 `d.w` / `d.st`). Keep those kernels on the frame path.
            if ik == types.MI_LOAD_PTR || ik == types.MI_LOAD_BUF_PTR {
                mid := types.mfn_id(&f.instrs, ii)
                mia := types.mfn_ia(&f.instrs, ii)
                mut ok_slice := false
                if ik == types.MI_LOAD_PTR && mid == 3 {
                    aty := types.mir_temp_ty(m, fi, mia)
                    if aty == 3 {
                        ok_slice = true
                    } else if types.is_array_type(aty) {
                        ai := types.array_index(aty)
                        if ai >= 0 && ai < m.arrays.len && m.arrays[ai].fixed_len == 0 && m.arrays[ai].elem_ty == 1 {
                            ok_slice = true
                        }
                    }
                }
                if mid >= 2 && !ok_slice {
                    other_st = true
                }
            }
            if ik == types.MI_CALL {
                ck := types.mfn_ib(&f.instrs, ii)
                if ck == 95 {
                    other_st = true
                } else if ck == 1 {
                    sval := types.mfn_isval(&f.instrs, ii)
                    if sval != "_xu_math_sqrt" {
                        bad_call = true
                    }
                } else if ck != 2 && ck != 3 && ck != 4 && ck != 5 && ck != 22 {
                    bad_call = true
                }
            }
            ii = types.mfn_inext(&f.instrs, ii)
        }
    }
    << has_ld && has_st && has_i_idx && !other_st && !bad_call
}

fn fn_has_one_slot_ref(m &types.Mir, fi int) bool {
    for i in 0:types.mir_nlocals(m, fi) {
        if types.mir_local_nslots(m, fi, i) == 1 && types.is_ref_type(types.mir_local_ty(m, fi, i)) {
            << true
        }
    }
    << false
}

// The `_ht` fast path is specifically for one-slot `&[]T` search helpers.
// A one-slot reference to a struct (for example `&Ring` / `&List`) also has
// indexed fields, but its receiver is not an array descriptor; forwarding
// its hot edge as an array kernel leaves the next/prev field base stale and
// trips rt_oob.  Keep the broad helper above for general RA policy and use
// this stricter predicate only for array-data forwarding.
fn fn_has_one_slot_array_ref(m &types.Mir, fi int) bool {
    for i in 0:types.mir_nlocals(m, fi) {
        if types.mir_local_nslots(m, fi, i) != 1 { -> }
        ty := types.mir_local_ty(m, fi, i)
        if !types.is_ref_type(ty) { -> }
        inner := types.ref_inner_at(&m.refs,ty)
        if types.is_array_type(inner) { << true }
    }
    << false
}

fn mir_call_is_index_kernel(a &Assembler, lab string) bool {
    for i in 0:a.rc_kern_labs.len {
        if a.rc_kern_labs[i] == lab {
            << true
        }
    }
    << false
}

fn fn_calls_index_kernel(a &Assembler, m &types.Mir, fi int) bool {
    if a.rc_kern_labs.len == 0 {
        << false
    }
    for ii in 0:types.mir_nins(m, fi) {
        if types.mir_ikind(m, fi, ii) != types.MI_CALL {
            ->
        }
        if types.mir_ib(m, fi, ii) != 1 {
            ->
        }
        if mir_call_is_index_kernel(a, types.mir_isval(m, fi, ii)) {
            << true
        }
    }
    << false
}

fn fn_has_natural_loop(m &types.Mir, fi int) int {
    // How many other functions were compiled is not a property of this
    // loop. Oversized bodies stay on the self-loop tier unless they are
    // an already-proven kernel; ordinary functions are scanned in every unit.
    mut oversized := false
    if types.mir_nblocks(m, fi) > 128 || types.mir_ntemps(m, fi) > 2048 || types.mir_nins(m, fi) > 2048 {
        oversized = true
    }
    if oversized && !fn_is_small_indexed_kernel(m, fi) && !fn_is_f64_field_rmw_kernel(m, fi) && !fn_is_f64_index_acc_kernel(m, fi) {
        << 0
    }
    hot := natural_loop_hot_blocks(m, fi)
    for bi in 0:hot.len {
        if hot[bi] > 0 { << 1 }
    }
    << 0
}

// rc_fwd_ht jumps directly to a hot block entry that omits the ordinary
// frame-to-pin reload/seed sequence. A loop-carried LoadLocal is safe on that
// edge only when the destination block has a real S-pool pin for it;
// StoreLocal keeps that pin synchronized. Read-only parameters may remain in
// ordinary parks because their value never changes across the loop.
fn fwd_hot_pins_cover_written_loads(m &types.Mir, fi int, pins &[]int, hot &[]int) bool {
    nblk := types.mir_nblocks(m, fi)
    if hot.len < nblk || pins.len < nblk * 4 { << false }
    // The cold-exit stub is emitted after the hot successor and therefore
    // observes the assembler's current pin metadata.  Runtime control can
    // jump to that stub before executing the hot-edge shuffle, so every hot
    // block must agree on the physical S0-S3 layout.  Otherwise disable the
    // shortcut and let ordinary block entries reload from the frame.
    mut layout := -1
    for bi in 0:nblk {
        if hot[bi] <= 0 { -> }
        if layout < 0 {
            layout = bi
            ->
        }
        for p in 0:4 {
            if pins[bi * 4 + p] != pins[layout * 4 + p] { << false }
        }
    }
    for bi in 0:nblk {
        if hot[bi] <= 0 { -> }
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            if types.mir_ikind(m, fi, ii) == types.MI_LOAD_LOCAL {
                loc := types.mir_ib(m, fi, ii)
                if loc >= 0 && loc < types.mir_nlocals(m, fi) && types.mir_local_ty(m, fi, loc) == 4 {
                    ->
                }
                mut written := false
                for wb in 0:nblk {
                    if hot[wb] <= 0 { -> }
                    mut wi := types.mir_bhead(m, fi, wb)
                    for _ in 0:types.mir_nins(m, fi) {
                        if wi < 0 { <- }
                        if types.mir_ikind(m, fi, wi) == types.MI_STORE_LOCAL && types.mir_ia(m, fi, wi) == loc {
                            written = true
                        }
                        wi = types.mir_inext(m, fi, wi)
                    }
                }
                if written {
                    mut covered := false
                    for p in 0:4 {
                        if pins[bi * 4 + p] == loc { covered = true }
                    }
                    if !covered { << false }
                }
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << true
}

fn mir_instr_uses_temp(m &types.Mir, fi int, ii int, t int) bool {
    << types.mir_instr_uses_temp_m(m, fi, ii, t)
}

fn temp_used_after_ii(m &types.Mir, fi int, bi int, ii int, t int) bool {
    if t < 0 { << false }
    mut n := types.mir_inext(m, fi, ii)
    for _ in 0:types.mir_nins(m, fi) {
        if n < 0 { <- }
        if mir_instr_uses_temp(m, fi, n, t) { << true }
        n = types.mir_inext(m, fi, n)
    }
    if bi >= 0 && bi < types.mir_nblocks(m, fi) {
        tk := types.mir_btkind(m, fi, bi)
        if tk == 2 && types.mir_bta(m, fi, bi) == t { << true }
        if tk == 3 && types.mir_bta(m, fi, bi) == t { << true }
        << false
    }
    for b in 0:types.mir_nblocks(m, fi) {
        mut k := types.mir_bhead(m, fi, b)
        mut hit := false
        for _ in 0:types.mir_nins(m, fi) {
            if k < 0 { <- }
            if k == ii {
                hit = true
                <-
            }
            k = types.mir_inext(m, fi, k)
        }
        if hit {
            tk := types.mir_btkind(m, fi, b)
            if tk == 2 && types.mir_bta(m, fi, b) == t { << true }
            if tk == 3 && types.mir_bta(m, fi, b) == t { << true }
            <-
        }
    }
    << false
}

// Auto RA tier from target + MIR. Never returns 3 (LS only via -O3).
//   freestanding / non-arm64-x64 → 0
//   hosted x64                   → 1
//   hosted arm64 + all pin-safe + self-loop → 2
//   else hosted arm64            → 1
fn choose_ra_level(arch int, os int, m &types.Mir) int {
    if os == 3 || (arch != 0 && arch != 1) {
        << 0
    }
    if arch == 1 {
        << 0
    }
    if mir_all_s_pin_safe(m) == 1 && mir_has_self_loop(m) == 1 {
        << 2
    }
    << 1
}

// Self-loop writeback whitelist (ALU / local / call / field / ptr /
// ElemAddr+BufPtr / FieldRMW). ArrIndex/StoreIndex/IndexRMW stay out —
// integer array induction hangs with wb (matmul); nbody uses ElemAddr.
fn mir_wb_kind_ok(ik int) int {
    if ik == 1 || ik == 2 || ik == 3 || ik == 4 || ik == 5 || ik == 6 || ik == 7 || ik == 9 || ik == 10 || ik == 11 || ik == 13 || ik == 16 || ik == 17 || ik == 18 || ik == 46 || ik == 48 {
        << 1
    }
    if ik == 23 || ik == 25 || ik == 26 {
        << 1
    }
    // Self-loop Index/StoreIndex/IndexRMW: pins in V2–V5, index scratch is
    // V0/V1/S4/S5. Natural-loop joins with StoreIndex still stay off RA.
    if ik == 14 || ik == 20 || ik == 47 {
        << 1
    }
    // Closed-world InterfaceMethod peeps to csel (no `bl`). Counting it
    // as a seam kept iface_sum storing s/i every iter.
    if ik == 43 {
        << 1
    }
    << 0
}

// Leaf skip-store is only safe for pure ALU + Load/StoreLocal (kinds 1–5).
// ElemAddr/BufPtr/field keep wb but must not enable rc_leaf (stack must stay
// live — enabling leaf for mem ops miscompiles selfhost).
// Calls are not leaf operations; callees cross the ordinary function seam.
fn mir_fp_leaf_kind_ok(ik int) int {
    if ik == 1 || ik == 2 || ik == 3 || ik == 4 || ik == 5 {
        << 1
    }
    << 0
}

fn fn_needs_call_s(m &types.Mir, fi int) int {
    mut n := 0
    mut rec := 0
    lab := types.mir_fn_label(m, fi) + ""
    for ii in 0:types.mir_nins(m, fi) {
        if types.mir_ikind(m, fi, ii) != types.MI_CALL {
            ->
        }
        n += 1
        // push_str clobbers V0–V6; pins must live in S across the copy.
        if types.mir_ib(m, fi, ii) == 5 {
            << 1
        }
        if types.mir_ib(m, fi, ii) == 1 {
            if types.mir_isval(m, fi, ii) == lab {
                rec = 1
            }
        }
    }
    if n >= 2 {
        << 1
    }
    if rec == 1 {
        << 1
    }
    // Writeback self-loop with a call: pins must live in S across bl.
    nblk := types.mir_nblocks(m, fi)
    for bi in 0:nblk {
        tkind := types.mir_btkind(m, fi, bi)
        mut self_loop := false
        if tkind == 1 && types.mir_bta(m, fi, bi) == bi {
            self_loop = true
        }
        if tkind == 2 && (types.mir_btb(m, fi, bi) == bi || types.mir_btc(m, fi, bi) == bi) {
            self_loop = true
        }
        if !self_loop {
            ->
        }
        mut wb_ok := true
        mut has_call := false
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 {
                <-
            } else {
            ik := types.mir_ikind(m, fi, ii)
            if mir_wb_kind_ok(ik) == 0 {
                wb_ok = false
            }
            if ik == types.MI_CALL || ik == types.MI_STR_CLONE {
                has_call = true
            }
            ii = types.mir_inext(m, fi, ii)
            }
        }
        if wb_ok && has_call {
            << 1
        }
    }
    << 0
}

// O1 S-pool for writeback self-loops that are not leaves and have no
// index (field RMW / call). Index kernels keep V2–V5 (matmul / nbody).
fn fn_needs_wb_s(m &types.Mir, fi int) int {
    nblk := types.mir_nblocks(m, fi)
    for bi in 0:nblk {
        tkind := types.mir_btkind(m, fi, bi)
        mut self_loop := false
        if tkind == 1 && types.mir_bta(m, fi, bi) == bi {
            self_loop = true
        }
        if tkind == 2 && (types.mir_btb(m, fi, bi) == bi || types.mir_btc(m, fi, bi) == bi) {
            self_loop = true
        }
        if !self_loop {
            ->
        }
        if mir_block_has_chan_xu(m, fi, bi) != 0 {
            ->
        }
        if block_has_index(m, fi, bi) {
            ->
        }
        mut wb_ok := true
        mut leaf_ok := true
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 {
                <-
            } else {
            ik := types.mir_ikind(m, fi, ii)
            if mir_wb_kind_ok(ik) == 0 {
                wb_ok = false
                leaf_ok = false
            }
            if ik == types.MI_CALL {
                if types.mir_ib(m, fi, ii) == 1 && types.mir_isval(m, fi, ii) == "_xu_math_sqrt" {
                    // hardware fsqrt; still not a leaf ALU loop
                    leaf_ok = false
                } else {
                    leaf_ok = false
                }
            } else if mir_fp_leaf_kind_ok(ik) == 0 {
                leaf_ok = false
            }
            ii = types.mir_inext(m, fi, ii)
            }
        }
        if wb_ok && !leaf_ok {
            << 1
        }
        // Leaf ALU loops (f64_sum) get S homes in every unit. Importing
        // the standard library must not drop the same loop back to the stack.
        if wb_ok {
            << 1
        }
    }
    << 0
}

fn fn_ncalls(m &types.Mir, fi int) int {
    mut n := 0
    for ii in 0:types.mir_nins(m, fi) {
        if types.mir_ikind(m, fi, ii) == types.MI_CALL {
            n += 1
        }
    }
    << n
}

fn fn_is_straight(m &types.Mir, fi int) int {
    n := types.mir_nblocks(m, fi)
    if n != 1 && n != 2 {
        << 0
    }
    if n == 2 {
        if types.mir_btkind(m, fi, 0) == 2 || types.mir_btkind(m, fi, 1) == 2 {
            << 0
        }
    }
    if fn_uses_s_scratch(m, fi) == 1 {
        << 0
    }
    if fn_ncalls(m, fi) != 0 {
        << 0
    }
    << 1
}

// eval_a: 1–2 blocks (empty trailing return), no Call. Not `fn_is_straight`
// (that requires 1 block), so emit keeps rc_leaf off — parks only, no
// skip-store. nfn<64 is applied at the product_rc gate.
fn fn_is_scalar_leaf(m &types.Mir, fi int) bool {
    if types.mir_fn_is_extern(m, fi) {
        << false
    }
    if types.mir_nblocks(m, fi) > 2 {
        << false
    }
    if types.mir_nlocals(m, fi) > 8 {
        << false
    }
    if types.mir_ntemps(m, fi) > 40 {
        << false
    }
    // Array/Index/Drop/iface instructions use the frame as an explicit
    // materialization boundary (ArrayLit also hides `_rt_alloc`).  Treating
    // such a body as a scalar leaf omits temp slots and makes emit_arraylit's
    // direct frame loads read synthetic/garbage offsets.  Leaf elision is
    // limited to pure scalar ALU/local instructions.
    if fn_uses_s_scratch(m, fi) != 0 {
        << false
    }
    if types.mir_fn_ret_nslots(m, fi) > 1 {
        << false
    }
    if fn_ncalls(m, fi) != 0 {
        << false
    }
    << true
}

// eval_a: 2 blocks, jump then return — skip-store ALU like a 1-block
// straight leaf. Branches (if/else, loops) stay out: O1 has no park carry.
fn fn_is_scalar_leaf_skip(m &types.Mir, fi int) bool {
    if !fn_is_scalar_leaf(m, fi) {
        << false
    }
    n := types.mir_nblocks(m, fi)
    if n == 1 {
        << true
    }
    if n != 2 {
        << false
    }
    for bi in 0:n {
        if types.mir_btkind(m, fi, bi) == 2 {
            << false
        }
    }
    << true
}

// ABI: scalars / refs / chan / map in registers; structs / strings by pointer.
fn abi_pass_by_value(ty int) bool {
    if ty == 1 || ty == 2 || ty == 4 || ty == 8 || ty == 9 || ty == 10 {
        << true
    }
    if types.is_ref_type(ty) {
        << true
    }
    if types.is_chan_type(ty) {
        << true
    }
    if types.is_map_type(ty) {
        << true
    }
    << false
}

fn fn_loop_addr_local(m &types.Mir, fi int) int {
    if fn_ncalls(m, fi) == 0 {
        << -1
    }
    // Follow emitted block chains. Optimizer rewrites retain detached MInstr
    // owners in the pool; scanning the whole backing vector can select a dead
    // AddrOf whose local was correctly omitted from the final frame.
    for bi in 0:types.mir_nblocks(m, fi) {
        mut ii := types.mir_bhead(m, fi, bi)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            if types.mir_ikind(m, fi, ii) == types.MI_ADDR && types.mir_ic(m, fi, ii) == 0 {
                << types.mir_ib(m, fi, ii)
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << -1
}

fn fn_spare_s_pin(a &Assembler, pins &[]int, nblk int) int {
    if !a.rc_s_pool || a.arch != 0 {
        << -1
    }
    mut lim := a.cs_pairs * 2
    if lim > 4 {
        lim = 4
    }
    for p in 0:lim {
        mut used := 0
        for bi in 0:nblk {
            // >=0: local pin; -2: temporarily reserved (const vs AddrOf spare).
            v := pins[bi * 4 + p]
            if v >= 0 || v == -2 {
                used = 1
            }
        }
        if used == 0 {
            << p
        }
    }
    << -1
}

fn fn_large_const(m &types.Mir, fi int) int {
    for bi in 0:types.mir_nblocks(m, fi) {
        c := rc_hoist_const(m, fi, bi)
        if c > 4095 {
            << c
        }
    }
    << 0
}

fn collect_call_locals(m &types.Mir, fi int) []int {
    mut extra := []int{}
    for loc in 0:types.mir_nlocals(m, fi) {
        if extra.len >= 4 {
            << extra
        }
        if types.mir_local_nslots(m, fi, loc) != 1 {
            ->
        }
        if !rc_pin_ty_ok(types.mir_local_ty(m, fi, loc)) {
            ->
        }
        mut used := false
        for ii in 0:types.mir_nins(m, fi) {
            ik := types.mir_ikind(m, fi, ii)
            if ik == types.MI_LOAD_LOCAL && types.mir_ib(m, fi, ii) == loc {
                used = true
            }
            if ik == types.MI_STORE_LOCAL && types.mir_ia(m, fi, ii) == loc {
                used = true
            }
        }
        if used {
            extra.push(loc)
        }
    }
    << extra
}

fn merge_call_pins(pins &mut []int, nblk int, extra &[]int) {
    for bi in 0:nblk {
        for ei in 0:extra.len {
            loc := extra[ei]
            mut seen := false
            mut empty := -1
            for p in 0:4 {
                if pins[bi * 4 + p] == loc {
                    seen = true
                }
                if empty < 0 && pins[bi * 4 + p] < 0 {
                    empty = p
                }
            }
            if !seen && empty >= 0 {
                pins[bi * 4 + empty] = loc
            }
        }
    }
    <<
}

fn callee_preserves_arg_mask_fi(m &types.Mir, fi int) int {
    if fi < 0 {
        << 0
    }
    if types.mir_fn_ret_nslots(m, fi) != 0 || types.mir_nblocks(m, fi) != 1 {
        << 0
    }
    if types.mir_btkind(m, fi, 0) != 3 || types.mir_bta(m, fi, 0) != -1 {
        << 0
    }
    mut ii := types.mir_bhead(m, fi, 0)
    while ii >= 0 {
        k := types.mir_ikind(m, fi, ii)
        // Copy / LoadLocal / StoreLocal / Bin / Un / LoadField / StoreField / Addr
        if k != types.MI_COPY && k != types.MI_LOAD_LOCAL && k != types.MI_STORE_LOCAL && k != types.MI_BIN && k != types.MI_UN && k != types.MI_LOAD_FIELD && k != types.MI_STORE_FIELD && k != types.MI_ADDR {
            << 0
        }
        ii = types.mir_inext(m, fi, ii)
    }
    mut n := types.mir_fn_nparams(m, fi)
    if n > 6 {
        n = 6
    }
    if n == 0 {
        << 0
    }
    << (1 << n) - 1
}

fn callee_preserves_arg_mask(a &Assembler, m &types.Mir, label string) int {
    for i in 0:a.rc_preserve_labs.len {
        if a.rc_preserve_labs[i] == label {
            << a.rc_preserve_mask[i]
        }
    }
    << 0
}

// Before hot: mov A0, &local when the loop calls a void leaf that keeps A0.
fn fn_has_ror32_or(m &types.Mir, fi int) bool {
    for ii in 0:types.mir_nins(m, fi) {
        if types.mir_ikind(m, fi, ii) != types.MI_BIN {
            ->
        }
        op := types.mir_ib(m, fi, ii)
        if op != 17 && op != 18 {
            ->
        }
        n1 := mir_shift32(m, fi, types.mir_id(m, fi, ii))
        if n1 < 0 {
            ->
        }
        mut ni := types.mir_inext(m, fi, ii)
        if ni >= 0 && types.mir_ikind(m, fi, ni) == types.MI_LOAD_LOCAL {
            ni = types.mir_inext(m, fi, ni)
        }
        if ni < 0 || types.mir_ikind(m, fi, ni) != types.MI_BIN {
            ->
        }
        op2 := types.mir_ib(m, fi, ni)
        if op == 18 {
            if op2 != 17 {
                ->
            }
        } else if op2 != 18 {
            ->
        }
        n2 := mir_shift32(m, fi, types.mir_id(m, fi, ni))
        if n2 >= 0 && n1 + n2 == 32 {
            << true
        }
    }
    << false
}

// Forward ALU/LoadLocal past temp slots when RA is off: rotate kernels
// and callers of index kernels. "Any index in a small user unit" is not
// enough — heap `child := root*2+1` then skipped the temp store and the
// madd fuse reloaded an unset slot (init became a no-op, even at -O0).
fn rc_alu_fwd(a &Assembler, m &types.Mir, fi int) bool {
    << a.rc_alu_fwd_fn == 1
}

fn rc_scalar_temp(m &types.Mir, fi int, t int) bool {
    if t < 0 || t >= types.mir_ntemps(m, fi) {
        << false
    }
    if types.mir_temp_nslots(m, fi, t) != 1 {
        << false
    }
    if types.mir_temp_ty(m, fi, t) == 4 {
        << false
    }
    << true
}

fn rc_scalar_local(m &types.Mir, fi int, loc int) bool {
    if loc < 0 || loc >= types.mir_nlocals(m, fi) {
        << false
    }
    if types.mir_local_nslots(m, fi, loc) != 1 {
        << false
    }
    if types.mir_local_ty(m, fi, loc) == 4 {
        << false
    }
    << true
}

// Operand reads of `t` in the whole fn (Bin counts both sides; terminators too).
fn rc_temp_use_count(m &types.Mir, fi int, t int) int {
    if t < 0 {
        << 0
    }
    mut n := 0
    for ii in 0:types.mir_nins(m, fi) {
        k := types.mir_ikind(m, fi, ii)
        if k == types.MI_BIN {
            if types.mir_ic(m, fi, ii) == t {
                n += 1
            }
            if types.mir_id(m, fi, ii) == t {
                n += 1
            }
        } else if rc_instr_reads_temp(m, fi, ii, t) {
            n += 1
        }
    }
    for bi in 0:types.mir_nblocks(m, fi) {
        tk := types.mir_btkind(m, fi, bi)
        if tk == 2 || tk == 3 {
            if types.mir_bta(m, fi, bi) == t {
                n += 1
            }
        }
    }
    << n
}

// Operand reads of `t` in non-terminator instructions.
fn rc_temp_instr_use_count(m &types.Mir, fi int, t int) int {
    if t < 0 {
        << 0
    }
    mut n := 0
    for ii in 0:types.mir_nins(m, fi) {
        k := types.mir_ikind(m, fi, ii)
        mut hit := false
        if k == types.MI_BIN {
            if types.mir_ic(m, fi, ii) == t || types.mir_id(m, fi, ii) == t {
                hit = true
            }
        } else if rc_instr_reads_temp(m, fi, ii, t) {
            hit = true
        }
        if hit {
            n += 1
        }
    }
    << n
}

fn mir_alu_feeds_index(m &types.Mir, fi int, dest int, start_ii int) int {
    if dest < 0 || start_ii < 0 {
        << 0
    }
    mut uses := 0
    mut ii := start_ii
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 {
            <-
        }
        ik := types.mir_ikind(m, fi, ii)
        a0 := types.mir_ia(m, fi, ii)
        // Def of dest ends the scan.
        if ik == types.MI_COPY || ik == types.MI_LOAD_LOCAL || ik == types.MI_BIN || ik == types.MI_UN || ik == types.MI_STR_CONST || ik == types.MI_LOAD_INDEX || ik == types.MI_ADDR || ik == types.MI_LOAD_PTR || ik == types.MI_ELEM_ADDR || ik == types.MI_LOAD_BUF_PTR {
            if a0 == dest {
                <-
            }
        }
        if ik == types.MI_CALL && a0 == dest {
            <-
        }
        if rc_instr_reads_temp(m, fi, ii, dest) {
            if ik != types.MI_LOAD_INDEX && ik != types.MI_STORE_INDEX && ik != types.MI_ELEM_ADDR && ik != types.MI_INDEX_RMW {
                << 0
            }
            uses += 1
        }
        ii = types.mir_inext(m, fi, ii)
    }
    if uses < 1 {
        << 0
    }
    << 1
}

fn fn_is_i64_scalar_loop_kernel(m &types.Mir, fi int) bool {
    if types.mir_fn_is_extern(m, fi) { << false }
    nb := types.mir_nblocks(m, fi)
    if nb <= 1 || nb > 128 { << false }
    nl := types.mir_nlocals(m, fi)
    nt := types.mir_ntemps(m, fi)
    if nl > 48 || nt > 768 { << false }
    for i in 0:nl {
        ty := types.mir_local_ty(m, fi, i)
        if (ty != 1 && ty != 2) || types.mir_local_nslots(m, fi, i) != 1 { << false }
    }
    for i in 0:nt {
        ty := types.mir_temp_ty(m, fi, i)
        if (ty != 1 && ty != 2) || types.mir_temp_nslots(m, fi, i) != 1 { << false }
    }
    mut f := types.mir_cfg_clone_fn(m, fi, true)
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            ik := types.mfn_ikind(&f.instrs, ii)
            if ik != types.MI_COPY && ik != types.MI_LOAD_LOCAL && ik != types.MI_STORE_LOCAL && ik != types.MI_BIN && ik != types.MI_UN {
                if ik == types.MI_CALL {
                    ck := types.mfn_ib(&f.instrs, ii)
                    if ck != 2 && ck != 3 && ck != 4 && ck != 5 && ck != 22 {
                        << false
                    }
                } else {
                    << false
                }
            }
            ii = types.mfn_inext(&f.instrs, ii)
        }
    }
    << true
}
