@main
// ELF32 ET_EXEC for MPS2 Thumb (QEMU mps2-an386).
// Port of bootstrap xubin/elf32.rs Elf32Exec::new_mps2().

struct Elf32Exec {
    data_base    int
    vector_size  int
    stack_top    int
    code_base    int
    machine      int
    flags        int
}

struct Elf32Sym {
    name  int
    value int
    size  int
    info  int
    other int
    shndx int
}

// Linux ARM EABI userspace (qemu-arm / armv7). No Cortex-M vector table.
fn new_elf32_linux_arm() Elf32Exec {
    << Elf32Exec{
        data_base: 0,
        vector_size: 0,
        stack_top: 0,
        code_base: 65536,
        machine: 40,
        flags: 83886080
    }
}

fn new_elf32_mps2() Elf32Exec {
    << Elf32Exec{
        data_base: 536870912,
        vector_size: 192,
        stack_top: 536903680,
        code_base: 0,
        machine: 40,
        flags: 83886080
    }
}

// RV32 QEMU `virt` (E7): code at 0x80000000, data at 0x81000000, EM_RISCV.
fn new_elf32_riscv_virt() Elf32Exec {
    << Elf32Exec{
        data_base: 2164260864, // 0x81000000
        vector_size: 0,
        stack_top: 2281701376, // 0x88000000
        code_base: 2147483648, // 0x80000000
        machine: 243,
        flags: 0
    }
}

fn (e Elf32Exec) code_vaddr() int { << e.code_base + e.vector_size }
fn (e Elf32Exec) data_vaddr(code_size int) int {
    if e.vector_size == 0 && e.machine == 40 {
        << e.code_base + ((code_size + 4095) / 4096) * 4096
    }
    << e.data_base
}

fn elf32_st_info(bind int, ty int) int { << (bind << 4) | (ty & 15) }

fn elf32_export_label(name string) bool {
    if name.len >= 3 {
        lim := name.len - 2
        for i in 0:lim {
            if name[i] == 95 && name[i + 1] == 98 && name[i + 2] == 98 {
                << false
            }
        }
    }
    if name.len >= 8 {
        if name[0] == 95 && name[1] == 120 && name[2] == 117 && name[3] == 100 && name[4] == 114 && name[5] == 111 && name[6] == 112 && name[7] == 95 {
            << false
        }
    }
    if name.len >= 9 {
        if name[0] == 95 && name[1] == 120 && name[2] == 117 && name[3] == 95 && name[4] == 99 && name[5] == 115 && name[6] == 101 && name[7] == 116 && name[8] == 95 {
            << false
        }
    }
    if name.len >= 3 && name[0] == 95 && name[1] == 120 && name[2] == 117 {
        << true
    }
    if name.len >= 3 && name[0] == 95 && name[1] == 114 && name[2] == 116 {
        << true
    }
    if name.len >= 6 && name[0] == 95 && name[1] == 114 && name[2] == 101 && name[3] == 115 && name[4] == 101 && name[5] == 116 {
        << true
    }
    << false
}

fn elf32_push_str(tab &mut []int, s string) int {
    off := tab.len
    for i in 0:s.len {
        tab.push(s[i])
    }
    tab.push(0)
    << off
}

fn elf32_label_off(a &Assembler, name string) int {
    for i in 0:a.labels.len {
        candidate := a.labels[i].name
        if candidate == name {
            << a.labels[i].offset
        }
    }
    << 0
}

fn elf32_arm_attrs() []int {
    mut attrs := []int{}
    attrs.push(5)
    s := "cortex-m4"
    for i in 0:s.len {
        attrs.push(s[i])
    }
    attrs.push(0)
    attrs.push(6)
    attrs.push(13)
    attrs.push(7)
    attrs.push(77)
    attrs.push(8)
    attrs.push(0)
    attrs.push(9)
    attrs.push(2)
    mut file := []int{}
    file.push(1)
    file_size := 4 + attrs.len
    file.push(file_size & 255)
    file.push((file_size >> 8) & 255)
    file.push((file_size >> 16) & 255)
    file.push((file_size >> 24) & 255)
    for i in 0:attrs.len {
        file.push(attrs[i])
    }
    mut vendor := []int{}
    ae := "aeabi"
    for i in 0:ae.len {
        vendor.push(ae[i])
    }
    vendor.push(0)
    for i in 0:file.len {
        vendor.push(file[i])
    }
    mut out := []int{}
    out.push(65)
    sec := 4 + vendor.len
    out.push(sec & 255)
    out.push((sec >> 8) & 255)
    out.push((sec >> 16) & 255)
    out.push((sec >> 24) & 255)
    for i in 0:vendor.len {
        out.push(vendor[i])
    }
    << out
}

struct Elf32Shdr {
    name      int
    typ       int
    flags     int
    addr      int
    off       int
    size      int
    link      int
    info      int
    addralign int
    entsize   int
}

fn elf32_shdr_bytes(h Elf32Shdr) []int {
    mut b := []int{}
    write32(mut &b, h.name)
    write32(mut &b, h.typ)
    write32(mut &b, h.flags)
    write32(mut &b, h.addr)
    write32(mut &b, h.off)
    write32(mut &b, h.size)
    write32(mut &b, h.link)
    write32(mut &b, h.info)
    write32(mut &b, h.addralign)
    write32(mut &b, h.entsize)
    << b
}

fn elf32_append(dst &mut []int, src []int) {
    for i in 0:src.len {
        dst.push(src[i])
    }
}

fn (e Elf32Exec) generate(a &Assembler, buf &mut []int) {
    mut out := []int{}
    reset_off := elf32_label_off(a, "_reset")
    reset_va := e.code_vaddr() + reset_off
    mut reset_thumb := reset_va | 1
    if e.machine == 243 {
        reset_thumb = reset_va
    }
    isr_off := elf32_label_off(a, "_xu_isr")
    mut isr_thumb := reset_thumb
    mut has_isr := false
    for i in 0:a.labels.len {
        candidate := a.labels[i].name
        if candidate == "_xu_isr" {
            has_isr = true
        }
    }
    if has_isr {
        isr_thumb = e.code_vaddr() + isr_off
        if e.machine != 243 {
            isr_thumb = isr_thumb | 1
        }
    }

    mut image := []int{}
    nvec := e.vector_size / 4
    if e.machine != 243 {
        image.push(e.stack_top & 255)
        image.push((e.stack_top >> 8) & 255)
        image.push((e.stack_top >> 16) & 255)
        image.push((e.stack_top >> 24) & 255)
        image.push(reset_thumb & 255)
        image.push((reset_thumb >> 8) & 255)
        image.push((reset_thumb >> 16) & 255)
        image.push((reset_thumb >> 24) & 255)
    }
    for i in 2:nvec {
        mut h := reset_thumb
        if i >= 16 {
            h = isr_thumb
        }
        image.push(h & 255)
        image.push((h >> 8) & 255)
        image.push((h >> 16) & 255)
        image.push((h >> 24) & 255)
    }
    for i in 0:a.code.len {
        image.push(a.code[i] & 255)
    }

    text_off := 256
    data_off := align_up(text_off + image.len, 256)
    shoff := align_up(data_off + a.data.len, 4)
    attrs := elf32_arm_attrs()
    attr_off := shoff

    mut shstrtab := []int{}
    shstrtab.push(0)
    sh_text := elf32_push_str(mut &shstrtab, ".text")
    sh_data := elf32_push_str(mut &shstrtab, ".data")
    sh_sym := elf32_push_str(mut &shstrtab, ".symtab")
    sh_str := elf32_push_str(mut &shstrtab, ".strtab")
    sh_shstr := elf32_push_str(mut &shstrtab, ".shstrtab")
    sh_attr := elf32_push_str(mut &shstrtab, ".ARM.attributes")

    mut strtab := []int{}
    strtab.push(0)
    mut syms := []Elf32Sym{}
    syms.push(Elf32Sym{name: 0, value: 0, size: 0, info: 0, other: 0, shndx: 0})
    d_name := elf32_push_str(mut &strtab, "$$d")
    syms.push(Elf32Sym{name: d_name, value: 0, size: 0, info: elf32_st_info(0, 0), other: 0, shndx: 1})
    t_name := elf32_push_str(mut &strtab, "$$t")
    syms.push(Elf32Sym{name: t_name, value: e.code_vaddr(), size: 0, info: elf32_st_info(0, 0), other: 0, shndx: 1})
    first_global := syms.len

    for i in 0:a.labels.len {
        raw := a.labels[i].name
        exported := elf32_export_label(raw)
        if exported {
            nm := a.labels[i].name
            off := a.labels[i].offset
            is_data := a.labels[i].is_data
            mut val := 0
            mut shndx := 1
            mut info := elf32_st_info(1, 2)
            if is_data {
                val = e.data_base + off
                shndx = 2
                info = elf32_st_info(0, 0)
            } else {
                val = e.code_vaddr() + off
                if e.machine != 243 {
                    val = val | 1
                }
            }
            mut add_main := false
            if nm == "_xu_main" {
                add_main = true
            }
            sname := elf32_push_str(mut &strtab, nm)
            syms.push(Elf32Sym{name: sname, value: val, size: 0, info: info, other: 0, shndx: shndx})
            if add_main {
                main_nm := elf32_push_str(mut &strtab, "main")
                syms.push(Elf32Sym{name: main_nm, value: val, size: 0, info: elf32_st_info(1, 2), other: 0, shndx: 1})
            }
        }
    }

    sym_off := align_up(attr_off + attrs.len, 4)
    str_off := sym_off + syms.len * 16
    shstr_off := str_off + strtab.len
    shdr_off := align_up(shstr_off + shstrtab.len, 4)

    out.push(127)
    out.push(69)
    out.push(76)
    out.push(70)
    out.push(1)
    out.push(1)
    out.push(1)
    out.push(0)
    for i in 0:8 {
        out.push(0)
    }
    write16(mut &out, 2)
    write16(mut &out, e.machine)
    write32(mut &out, 1)
    write32(mut &out, reset_thumb)
    write32(mut &out, 52)
    write32(mut &out, shdr_off)
    write32(mut &out, e.flags)
    write16(mut &out, 52)
    write16(mut &out, 32)
    write16(mut &out, 2)
    write16(mut &out, 40)
    write16(mut &out, 7)
    write16(mut &out, 6)

    write32(mut &out, 1)
    write32(mut &out, text_off)
    write32(mut &out, e.code_base)
    write32(mut &out, e.code_base)
    write32(mut &out, image.len)
    write32(mut &out, image.len)
    write32(mut &out, 5)
    write32(mut &out, 256)

    write32(mut &out, 1)
    write32(mut &out, data_off)
    write32(mut &out, e.data_base)
    write32(mut &out, e.data_base)
    write32(mut &out, a.data.len)
    write32(mut &out, a.data.len)
    write32(mut &out, 6)
    write32(mut &out, 256)

    pad_to(mut &out, text_off)
    for i in 0:image.len {
        out.push(image[i])
    }
    pad_to(mut &out, data_off)
    for i in 0:a.data.len {
        out.push(a.data[i] & 255)
    }
    pad_to(mut &out, attr_off)
    for i in 0:attrs.len {
        out.push(attrs[i])
    }
    pad_to(mut &out, sym_off)
    for i in 0:syms.len {
        write32(mut &out, syms[i].name)
        write32(mut &out, syms[i].value)
        write32(mut &out, syms[i].size)
        out.push(syms[i].info & 255)
        out.push(syms[i].other & 255)
        write16(mut &out, syms[i].shndx)
    }
    for i in 0:strtab.len {
        out.push(strtab[i])
    }
    for i in 0:shstrtab.len {
        out.push(shstrtab[i])
    }
    pad_to(mut &out, shdr_off)
    h0 := elf32_shdr_bytes(Elf32Shdr{name: 0, typ: 0, flags: 0, addr: 0, off: 0, size: 0, link: 0, info: 0, addralign: 0, entsize: 0})
    for i in 0:h0.len { out.push(h0[i]) }
    h1 := elf32_shdr_bytes(Elf32Shdr{name: sh_text, typ: 1, flags: 6, addr: e.code_base, off: text_off, size: image.len, link: 0, info: 0, addralign: 4, entsize: 0})
    for i in 0:h1.len { out.push(h1[i]) }
    h2 := elf32_shdr_bytes(Elf32Shdr{name: sh_data, typ: 1, flags: 3, addr: e.data_base, off: data_off, size: a.data.len, link: 0, info: 0, addralign: 4, entsize: 0})
    for i in 0:h2.len { out.push(h2[i]) }
    h3 := elf32_shdr_bytes(Elf32Shdr{name: sh_attr, typ: 1879048195, flags: 0, addr: 0, off: attr_off, size: attrs.len, link: 0, info: 0, addralign: 1, entsize: 0})
    for i in 0:h3.len { out.push(h3[i]) }
    h4 := elf32_shdr_bytes(Elf32Shdr{name: sh_sym, typ: 2, flags: 0, addr: 0, off: sym_off, size: syms.len * 16, link: 5, info: first_global, addralign: 4, entsize: 16})
    for i in 0:h4.len { out.push(h4[i]) }
    h5 := elf32_shdr_bytes(Elf32Shdr{name: sh_str, typ: 3, flags: 0, addr: 0, off: str_off, size: strtab.len, link: 0, info: 0, addralign: 1, entsize: 0})
    for i in 0:h5.len { out.push(h5[i]) }
    h6 := elf32_shdr_bytes(Elf32Shdr{name: sh_shstr, typ: 3, flags: 0, addr: 0, off: shstr_off, size: shstrtab.len, link: 0, info: 0, addralign: 1, entsize: 0})
    for i in 0:h6.len { out.push(h6[i]) }

    for i in 0:out.len {
        buf.push(out[i])
    }
}

// Hosted linux-arm32: ELF32 ET_EXEC, two page-aligned PT_LOAD, Thumb e_entry.
fn (e Elf32Exec) generate_linux(a &Assembler, start_offset int, buf &mut []int) {
    mut out := []int{}
    code_off := 4096
    code_vaddr := e.code_base
    data_off := code_off + ((a.code.len + 4095) / 4096) * 4096
    data_vaddr := e.data_vaddr(a.code.len)
    entry := (code_vaddr + start_offset) | 1

    out.push(127)
    out.push(69)
    out.push(76)
    out.push(70)
    out.push(1)
    out.push(1)
    out.push(1)
    out.push(0)
    for i in 0:8 {
        out.push(0)
    }
    write16(mut &out, 2)
    write16(mut &out, 40)
    write32(mut &out, 1)
    write32(mut &out, entry)
    write32(mut &out, 52)
    write32(mut &out, 0)
    write32(mut &out, e.flags)
    write16(mut &out, 52)
    write16(mut &out, 32)
    write16(mut &out, 2)
    write16(mut &out, 0)
    write16(mut &out, 0)
    write16(mut &out, 0)

    write32(mut &out, 1)
    write32(mut &out, code_off)
    write32(mut &out, code_vaddr)
    write32(mut &out, code_vaddr)
    write32(mut &out, a.code.len)
    write32(mut &out, a.code.len)
    write32(mut &out, 5)
    write32(mut &out, 4096)

    write32(mut &out, 1)
    write32(mut &out, data_off)
    write32(mut &out, data_vaddr)
    write32(mut &out, data_vaddr)
    write32(mut &out, a.data.len)
    write32(mut &out, a.data.len)
    write32(mut &out, 6)
    write32(mut &out, 4096)

    pad_to(mut &out, code_off)
    for i in 0:a.code.len {
        out.push(a.code[i] & 255)
    }
    pad_to(mut &out, data_off)
    for i in 0:a.data.len {
        out.push(a.data[i] & 255)
    }
    for i in 0:out.len {
        buf.push(out[i])
    }
}
