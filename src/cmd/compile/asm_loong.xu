@main
// LoongArch64 assembler for Gen1 (M39): LP64 base integer + f64 (bits kept
// in GPRs, moved to/from FPRs only for FP ops) + atomic am*/ll.sc.
// Encodings follow the LoongArch ELF psABI v2.x / Linux inst.h (32-bit
// fixed-width, little-endian). Port of bootstrap/crates/xuasm/src/loong.rs.
//
// Register numbers are raw LoongArch GPRs:
//   r0=zero r1=ra r2=tp r3=sp r4-r11=a0-a7 r12-r20=t0-t8
//   r21=reserved r22=fp r23-r31=s0-s8
//
// Fixup kinds when arch == 4 (loong64):
//   20 = B / BL                      (I26)
//   21 = BEQ/BNE/BLT/BGE/BLTU/BGEU   (2RI16)
//   22 = BEQZ / BNEZ                 (1RI21)
//   23 = BCEQZ / BCNEZ               (FP branch)
//   24 = PCADDU12I + ADDI.D          (absolute address)

// ==================== 2RI12 (opcode<<22 | imm12<<10 | rj<<5 | rd) ====================

fn (a &mut Assembler) l_2ri12(op int, rd int, rj int, imm int) {
    a.emit32((op << 22) | ((imm & 4095) << 10) | ((rj & 31) << 5) | (rd & 31))
}

fn (a &mut Assembler) l_addi_d(rd int, rj int, imm int) { a.l_2ri12(11, rd, rj, imm) }   // 0x0b
fn (a &mut Assembler) l_sltui(rd int, rj int, imm int) { a.l_2ri12(9, rd, rj, imm) }     // 0x09
fn (a &mut Assembler) l_lu52i_d(rd int, rj int, imm int) { a.l_2ri12(12, rd, rj, imm) }  // 0x0c
fn (a &mut Assembler) l_andi(rd int, rj int, imm int) { a.l_2ri12(13, rd, rj, imm) }     // 0x0d
fn (a &mut Assembler) l_ori(rd int, rj int, imm int) { a.l_2ri12(14, rd, rj, imm) }      // 0x0e
fn (a &mut Assembler) l_xori(rd int, rj int, imm int) { a.l_2ri12(15, rd, rj, imm) }     // 0x0f
fn (a &mut Assembler) l_ld_b(rd int, rj int, imm int) { a.l_2ri12(160, rd, rj, imm) }    // 0xa0
fn (a &mut Assembler) l_ld_w(rd int, rj int, imm int) { a.l_2ri12(162, rd, rj, imm) }    // 0xa2
fn (a &mut Assembler) l_ld_d(rd int, rj int, imm int) { a.l_2ri12(163, rd, rj, imm) }    // 0xa3
fn (a &mut Assembler) l_st_b(rd int, rj int, imm int) { a.l_2ri12(164, rd, rj, imm) }    // 0xa4
fn (a &mut Assembler) l_st_w(rd int, rj int, imm int) { a.l_2ri12(166, rd, rj, imm) }    // 0xa6
fn (a &mut Assembler) l_st_d(rd int, rj int, imm int) { a.l_2ri12(167, rd, rj, imm) }    // 0xa7
fn (a &mut Assembler) l_ld_bu(rd int, rj int, imm int) { a.l_2ri12(168, rd, rj, imm) }   // 0xa8

// ==================== 3R (opcode<<15 | rk<<10 | rj<<5 | rd) ====================

fn (a &mut Assembler) l_3r(op int, rd int, rj int, rk int) {
    a.emit32((op << 15) | ((rk & 31) << 10) | ((rj & 31) << 5) | (rd & 31))
}

fn (a &mut Assembler) l_slt(rd int, rj int, rk int) { a.l_3r(36, rd, rj, rk) }          // 0x24
fn (a &mut Assembler) l_sltu(rd int, rj int, rk int) { a.l_3r(37, rd, rj, rk) }         // 0x25
fn (a &mut Assembler) l_add_d(rd int, rj int, rk int) { a.l_3r(33, rd, rj, rk) }        // 0x21
fn (a &mut Assembler) l_sub_d(rd int, rj int, rk int) { a.l_3r(35, rd, rj, rk) }        // 0x23
fn (a &mut Assembler) l_and(rd int, rj int, rk int) { a.l_3r(41, rd, rj, rk) }          // 0x29
fn (a &mut Assembler) l_or(rd int, rj int, rk int) { a.l_3r(42, rd, rj, rk) }           // 0x2a
fn (a &mut Assembler) l_xor(rd int, rj int, rk int) { a.l_3r(43, rd, rj, rk) }          // 0x2b
fn (a &mut Assembler) l_sll_d(rd int, rj int, rk int) { a.l_3r(49, rd, rj, rk) }        // 0x31
fn (a &mut Assembler) l_srl_d(rd int, rj int, rk int) { a.l_3r(50, rd, rj, rk) }        // 0x32
fn (a &mut Assembler) l_sra_d(rd int, rj int, rk int) { a.l_3r(51, rd, rj, rk) }        // 0x33
fn (a &mut Assembler) l_mul_d(rd int, rj int, rk int) { a.l_3r(59, rd, rj, rk) }        // 0x3b
fn (a &mut Assembler) l_div_d(rd int, rj int, rk int) { a.l_3r(68, rd, rj, rk) }        // 0x44
fn (a &mut Assembler) l_mod_d(rd int, rj int, rk int) { a.l_3r(69, rd, rj, rk) }        // 0x45
fn (a &mut Assembler) l_amswap_d(rd int, rj int, rk int) { a.l_3r(28865, rd, rj, rk) }  // 0x70c1
fn (a &mut Assembler) l_amadd_d(rd int, rj int, rk int) { a.l_3r(28867, rd, rj, rk) }   // 0x70c3

// ==================== 2RI6 (opcode<<16 | imm6<<10 | rj<<5 | rd) ====================

fn (a &mut Assembler) l_2ri6(op int, rd int, rj int, imm int) {
    a.emit32((op << 16) | ((imm & 63) << 10) | ((rj & 31) << 5) | (rd & 31))
}

fn (a &mut Assembler) l_slli_d(rd int, rj int, imm int) { a.l_2ri6(65, rd, rj, imm) }   // 0x41
fn (a &mut Assembler) l_srli_d(rd int, rj int, imm int) { a.l_2ri6(69, rd, rj, imm) }   // 0x45
fn (a &mut Assembler) l_srai_d(rd int, rj int, imm int) { a.l_2ri6(73, rd, rj, imm) }   // 0x49

// ==================== 2RI14 (opcode<<24 | imm14<<10 | rj<<5 | rd) ====================

fn (a &mut Assembler) l_ll_d(rd int, rj int, imm int) {
    a.emit32((34 << 24) | ((imm & 16383) << 10) | ((rj & 31) << 5) | (rd & 31))  // 0x22
}

fn (a &mut Assembler) l_sc_d(rd int, rj int, imm int) {
    a.emit32((35 << 24) | ((imm & 16383) << 10) | ((rj & 31) << 5) | (rd & 31))  // 0x23
}

// ==================== 1RI20 (opcode<<25 | imm20<<5 | rd) ====================

fn (a &mut Assembler) l_1ri20(op int, rd int, imm int) {
    a.emit32((op << 25) | ((imm & 1048575) << 5) | (rd & 31))
}

fn (a &mut Assembler) l_lu12i_w(rd int, imm int) { a.l_1ri20(10, rd, imm) }       // 0x0a
fn (a &mut Assembler) l_lu32i_d(rd int, imm int) { a.l_1ri20(11, rd, imm) }       // 0x0b
fn (a &mut Assembler) l_pcaddu12i(rd int, imm int) { a.l_1ri20(14, rd, imm) }     // 0x0e

// ==================== FP (bits-in-GPR convention, like arm64) ====================
// FPRs f0/f1 are scratch; the payload stays in GPRs.

fn (a &mut Assembler) l_movgr2fr_d(fd int, rj int) {
    a.emit32(18130944 | ((rj & 31) << 5) | (fd & 31))  // 0x0114a800
}

fn (a &mut Assembler) l_movfr2gr_d(rd int, fj int) {
    a.emit32(18135040 | ((fj & 31) << 5) | (rd & 31))  // 0x0114b800
}

fn (a &mut Assembler) l_fadd_d(fd int, fj int, fk int) {
    a.emit32(16842752 | ((fk & 31) << 10) | ((fj & 31) << 5) | (fd & 31))  // 0x01010000
}

fn (a &mut Assembler) l_fsub_d(fd int, fj int, fk int) {
    a.emit32(16973824 | ((fk & 31) << 10) | ((fj & 31) << 5) | (fd & 31))  // 0x01030000
}

fn (a &mut Assembler) l_fmul_d(fd int, fj int, fk int) {
    a.emit32(17104896 | ((fk & 31) << 10) | ((fj & 31) << 5) | (fd & 31))  // 0x01050000
}

fn (a &mut Assembler) l_fdiv_d(fd int, fj int, fk int) {
    a.emit32(17235968 | ((fk & 31) << 10) | ((fj & 31) << 5) | (fd & 31))  // 0x01070000
}

fn (a &mut Assembler) l_fneg_d(fd int, fj int) {
    a.emit32(18094080 | ((fj & 31) << 5) | (fd & 31))  // 0x01141800
}

// 2R-type: opcode | rj<<5 | rd. LLVM Fmt2R.
fn (a &mut Assembler) l_2r(op int, rd int, rj int) {
    a.emit32(op | ((rj & 31) << 5) | (rd & 31))
}

fn (a &mut Assembler) l_clz_d(rd int, rj int) { a.l_2r(9216, rd, rj) }         // CLZ.D 0x00002400
fn (a &mut Assembler) l_ctz_d(rd int, rj int) { a.l_2r(11264, rd, rj) }        // CTZ.D 0x00002c00
fn (a &mut Assembler) l_bitrev_d(rd int, rj int) { a.l_2r(21504, rd, rj) }     // BITREV.D 0x00005400
fn (a &mut Assembler) l_fsqrt_d(fd int, fj int) { a.l_2r(18106368, fd, fj) }   // FSQRT.D 0x01144800

// fcmp.cond.d fcc, fj, fk — `cond` is the FP condition code (0-31):
//   ceq=2, cne=8, clt=1, cle=3 (quiet-NaN variants).
fn (a &mut Assembler) l_fcmp_d(cond int, fcc int, fj int, fk int) {
    a.emit32(203423744 | ((cond & 31) << 16) | ((fk & 31) << 10) | ((fj & 31) << 5) | (fcc & 7))  // 0x0c200000
}

// movcf2gr rd, fcc — FP condition-code bit to GPR (0/1).
fn (a &mut Assembler) l_movcf2gr(rd int, fcc int) {
    a.emit32(18144256 | ((fcc & 7) << 5) | (rd & 31))  // 0x0114dc00
}

// ffint.d.l (int64 -> f64) and ftintrz.l.d (f64 -> int64, truncate).
fn (a &mut Assembler) l_ffint_d_l(fd int, fj int) {
    a.emit32(18688000 | ((fj & 31) << 5) | (fd & 31))  // 0x011d2800
}

fn (a &mut Assembler) l_ftintrz_l_d(fd int, fj int) {
    a.emit32(18524160 | ((fj & 31) << 5) | (fd & 31))  // 0x011aa800
}

// ==================== branches ====================

// Push a loong fixup at the current code offset.
fn (a &mut Assembler) l_push_fixup(kind int, label string, rd int) {
    off := a.code.len
    fs := mut &a.fixups
    fs.push(Fixup{kind: kind, offset: off, label: label, rd: rd})
}

// B / BL placeholders (imm26 field zeroed).
fn (a &mut Assembler) l_b(label string) {
    a.l_push_fixup(20, label, 0)
    a.emit32(1342177280) // 0x50000000
}

fn (a &mut Assembler) l_bl(label string) {
    a.l_push_fixup(20, label, 0)
    a.emit32(1409286144) // 0x54000000
}

// reg2i16 conditional branches (imm16 field zeroed). rj and rd are both
// source operands: `beq rj, rd` means "if rj == rd".
fn (a &mut Assembler) l_branch16(op int, rj int, rd int, label string) {
    a.l_push_fixup(21, label, 0)
    a.emit32((op << 26) | ((rj & 31) << 5) | (rd & 31))
}

fn (a &mut Assembler) l_beq(rj int, rd int, label string) { a.l_branch16(22, rj, rd, label) }
fn (a &mut Assembler) l_bne(rj int, rd int, label string) { a.l_branch16(23, rj, rd, label) }
fn (a &mut Assembler) l_blt(rj int, rd int, label string) { a.l_branch16(24, rj, rd, label) }
fn (a &mut Assembler) l_bge(rj int, rd int, label string) { a.l_branch16(25, rj, rd, label) }
fn (a &mut Assembler) l_bltu(rj int, rd int, label string) { a.l_branch16(26, rj, rd, label) }
fn (a &mut Assembler) l_bgeu(rj int, rd int, label string) { a.l_branch16(27, rj, rd, label) }

// reg1i21 zero-branches (imm21 field zeroed): beqz/bnez rj, label.
fn (a &mut Assembler) l_zero_branch(op int, rj int, label string) {
    a.l_push_fixup(22, label, 0)
    a.emit32((op << 26) | ((rj & 31) << 5))
}

fn (a &mut Assembler) l_beqz(rj int, label string) { a.l_zero_branch(16, rj, label) }
fn (a &mut Assembler) l_bnez(rj int, label string) { a.l_zero_branch(17, rj, label) }

// jirl rd, rj, offs16 (immediate form; not a fixup).
fn (a &mut Assembler) l_jirl(rd int, rj int, offs int) {
    a.emit32((19 << 26) | ((offs & 65535) << 10) | ((rj & 31) << 5) | (rd & 31))  // 0x13
}

// ==================== misc ====================

fn (a &mut Assembler) l_syscall() { a.emit32(2818048) } // 0x002b0000 (syscall 0)
fn (a &mut Assembler) l_ret() { a.emit32(1275068448) }  // jirl r0, ra, 0 (0x4C000020)
fn (a &mut Assembler) l_dbar() { a.emit32(946995200) }  // 0x38720000 (dbar 0)

// ==================== immediate materialization ====================

// Full 64-bit materialization: lu12i.w + ori + lu32i.d + lu52i.d. Always
// correct for arbitrary i64 `imm` (each field is extracted in two's
// complement, and lu52i.d clears any lu12i.w sign extension).
fn (a &mut Assembler) l_mov_imm64(rd int, imm int) {
    a.l_lu12i_w(rd, (imm >> 12) & 1048575)
    a.l_ori(rd, rd, imm & 4095)
    a.l_lu32i_d(rd, (imm >> 32) & 1048575)
    a.l_lu52i_d(rd, rd, (imm >> 52) & 4095)
}

fn (a &mut Assembler) l_mov_imm(rd int, imm int) {
    if imm >= -2048 && imm <= 2047 {
        a.l_addi_d(rd, 0, imm)
        <<
    }
    a.l_mov_imm64(rd, imm)
}

// Absolute address of a label via pcaddu12i + addi.d (patched by l_fixup_all).
fn (a &mut Assembler) l_lea(rd int, label string) {
    a.l_push_fixup(24, label, rd)
    a.l_pcaddu12i(rd, 0)
    a.l_addi_d(rd, rd, 0)
}

// ==================== fixups ====================

// OR a sign-adjusted branch immediate into the placeholder word.
fn (a &mut Assembler) l_patch_imm(offset int, kind int, imm int) {
    w := a.code[offset] | (a.code[offset + 1] << 8) | (a.code[offset + 2] << 16) | (a.code[offset + 3] << 24)
    mut nw := w
    if kind == 20 {
        fixup_require(imm, -33554432, 33554431, 1)
        // I26: imm26{15:0} -> [25:10], imm26{25:16} -> [9:0].
        nw = w | ((imm & 65535) << 10) | ((imm >> 16) & 1023)
    } else if kind == 21 {
        fixup_require(imm, -32768, 32767, 1)
        // 2RI16: imm16 -> [25:10].
        nw = w | ((imm & 65535) << 10)
    } else if kind == 22 {
        fixup_require(imm, -1048576, 1048575, 1)
        // 1RI21: imm21{15:0} -> [25:10], imm21{20:16} -> [4:0].
        nw = w | ((imm & 65535) << 10) | ((imm >> 16) & 31)
    } else if kind == 23 {
        fixup_require(imm, -1048576, 1048575, 1)
        // FP branch: same imm21 layout as 1RI21.
        nw = w | ((imm & 65535) << 10) | ((imm >> 16) & 31)
    }
    a.patch32(offset, nw)
}

// Patch all pending loong fixups (two-pass addressing protocol).
fn (a &mut Assembler) l_fixup_all() {
    for i in 0:a.fixups.len {
        kind := a.fixups[i].kind
        offset := a.fixups[i].offset
        lbl := a.fixups[i].label
        target_addr := a.label_addr(lbl)
        if kind == 24 {
            // pcaddu12i + addi.d. disp = target - current; lo is the
            // sign-adjusted low 12 bits, hi the 4KB page delta.
            current_addr := a.code_vaddr + offset
            disp := target_addr - current_addr
            lo := (disp << 52) >> 52
            hi := (disp - lo) >> 12
            fixup_require(hi, -524288, 524287, 1)
            imm20 := hi & 1048575
            lo12 := lo & 4095
            rd := a.fixups[i].rd
            a.patch32(offset, (14 << 25) | (imm20 << 5) | (rd & 31))
            a.patch32(offset + 4, (11 << 22) | (lo12 << 10) | ((rd & 31) << 5) | (rd & 31))
        } else {
            current_addr := a.code_vaddr + offset
            rel := target_addr - current_addr
            fixup_require(rel, -134217728, 134217724, 4)
            imm := rel >> 2
            a.l_patch_imm(offset, kind, imm)
        }
    }
}
