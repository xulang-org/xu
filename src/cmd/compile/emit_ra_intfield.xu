@main

#xu/types

// Bounded straight-line integer field/index functions. References and array
// descriptors remain frame-backed; this admission only gives scalar temps
// to the ordinary must-def, interference and call-clobber planner.
fn intfield_array_type(m &types.Mir, ty int) bool {
    if !types.is_array_type(ty) { << false }
    ai := types.array_index(ty)
    if ai < 0 || ai >= m.arrays.len { << false }
    << m.arrays[ai].fixed_len == 0 && m.arrays[ai].elem_ty == 1 && m.arrays[ai].elem_bytes == 8
}

fn intfield_ref_type(m &types.Mir, ty int) bool {
    inner := vreg_direct_ref_inner(m,ty)
    if !types.is_struct_type(inner) { << false }
    si := types.struct_index(inner)
    if si < 0 || si >= m.structs.len { << false }
    if m.structs[si].fields.len <= 0 || m.structs[si].fields.len > 16 { << false }
    mut array := false
    for j in 0:m.structs[si].fields.len {
        ft := m.structs[si].fields[j].ty
        if intfield_array_type(m, ft) { array = true }
        else if ft != 1 { << false }
    }
    << array
}

// Receiver addresses are sometimes represented by an integer TempId.
// Every definition must be LoadLocal(0), never arbitrary integer arithmetic
// or a reference formed from another local. The caller rejects rebinding 0.
fn int_container_receiver_base(m &types.Mir, fi int, t int, recv int) bool {
    if t < 0 || t >= types.mir_ntemps(m, fi) { << false }
    if types.mir_temp_nslots(m, fi, t) != 1 { << false }
    ty := types.mir_temp_ty(m, fi, t)
    if ty != 1 && ty != recv { << false }
    mut saw := false
    for ii in 0:types.mir_nins(m, fi) {
        k := types.mir_ikind(m, fi, ii)
        if !types.mir_instr_has_dest(k) || types.mir_ia(m, fi, ii) != t { -> }
        if k != types.MI_LOAD_LOCAL || types.mir_ib(m, fi, ii) != 0 { << false }
        saw = true
    }
    << saw
}

// Bounded integer-container leaf methods. The receiver and []int
// descriptors stay in frame slots; only scalar TempIds enter fixed homes.
// This is separate from the straight-line field/index predicate: it does
// not authorize bounds-check reuse, descriptor caching, or unchecked loads.
fn fn_is_int_container_leaf(m &types.Mir, fi int) bool {
    if fi < 0 || fi >= m.fns.len || types.mir_fn_is_extern(m, fi) { << false }
    nb := types.mir_nblocks(m, fi)
    nl := types.mir_nlocals(m, fi)
    nt := types.mir_ntemps(m, fi)
    ni := types.mir_nins(m, fi)
    if nb <= 0 || nb > 32 || nl <= 0 || nl > 32 || nt > 256 || ni > 512 { << false }
    np := types.mir_fn_nparams(m, fi)
    if np <= 0 || np > 6 || np > nl { << false }
    rt := types.mir_fn_ret(m, fi)
    if rt != 0 && rt != 1 { << false }
    recv := types.mir_local_ty(m, fi, 0)
    if types.mir_local_nslots(m, fi, 0) != 1 || !intfield_ref_type(m, recv) { << false }
    for l in 1:nl {
        if types.mir_local_ty(m, fi, l) != 1 || types.mir_local_nslots(m, fi, l) != 1 { << false }
    }
    for t in 0:nt {
        ty := types.mir_temp_ty(m, fi, t)
        ns := types.mir_temp_nslots(m, fi, t)
        if (ty == 1 || ty == 2 || ty == recv) && ns == 1 { -> }
        if ns == 3 && intfield_array_type(m, ty) { -> }
        if ns == 1 && intfield_array_type(m, vreg_direct_ref_inner(m,ty)) { -> }
        << false
    }
    si := types.struct_index(vreg_direct_ref_inner(m,recv))
    mut load := false
    mut store := false
    for ii in 0:ni {
        k := types.mir_ikind(m, fi, ii)
        if k == types.MI_NOP { -> }
        // No user/runtime Call, aggregate construction, escaping scalar
        // address, struct elements, or aggregate return. Word ArrPush has
        // an existing ABI call-live barrier for its grow path in the planner.
        if k != types.MI_COPY && k != types.MI_LOAD_LOCAL && k != types.MI_STORE_LOCAL && k != types.MI_BIN && k != types.MI_UN && k != types.MI_DROP && k != types.MI_LOAD_FIELD && k != types.MI_ARR_PUSH && k != types.MI_LOAD_INDEX && k != types.MI_ADDR && k != types.MI_LOAD_PTR && k != types.MI_STORE_PTR && k != types.MI_STORE_INDEX && k != types.MI_FIELD_RMW { << false }
        if k == types.MI_STORE_LOCAL && types.mir_ia(m, fi, ii) == 0 { << false }
        if k == types.MI_ARR_PUSH && types.mir_id(m, fi, ii) != 8 { << false }
        if k == types.MI_LOAD_INDEX || k == types.MI_STORE_INDEX {
            // Negative widths carry an external bounds proof. This new
            // shape has no such proof and keeps both operations checked.
            if types.mir_id(m, fi, ii) != 8 { << false }
            if k == types.MI_LOAD_INDEX { load = true } else { store = true }
        }
        if k == types.MI_LOAD_FIELD {
            base := types.mir_ib(m, fi, ii)
            off := types.mir_ic(m, fi, ii)
            if base < 0 || base >= nt || !intfield_array_type(m, types.mir_temp_ty(m, fi, base)) { << false }
            if types.mir_id(m, fi, ii) != 1 || (off != 0 && off != 8 && off != 16) { << false }
            val := types.mir_ia(m, fi, ii)
            if val < 0 || val >= nt || types.mir_temp_ty(m, fi, val) != 1 { << false }
        }
        if k == types.MI_FIELD_RMW {
            if !int_container_receiver_base(m, fi, types.mir_ia(m, fi, ii), recv) { << false }
            if types.mir_id(m, fi, ii) != 1 || !vreg_field_rmw_ok(m, fi, ii) { << false }
            mut matched := false
            for j in 0:m.structs[si].fields.len {
                if m.structs[si].fields[j].ty == 1 && m.structs[si].fields[j].slot == types.mir_iline(m, fi, ii) { matched = true }
            }
            if !matched { << false }
        }
        if k == types.MI_LOAD_PTR || k == types.MI_STORE_PTR {
            base := types.mir_ib(m, fi, ii)
            if !int_container_receiver_base(m, fi, base, recv) { << false }
            val := types.mir_ia(m, fi, ii)
            mut matched := false
            for j in 0:m.structs[si].fields.len {
                ft := m.structs[si].fields[j].ty
                if m.structs[si].fields[j].slot != types.mir_ic(m, fi, ii) { -> }
                if k == types.MI_LOAD_PTR && val >= 0 && val < nt && types.mir_temp_ty(m, fi, val) == ft && types.mir_id(m, fi, ii) == m.type_slots(ft) { matched = true }
                // Stores may update scalar fields, never a descriptor.
                if k == types.MI_STORE_PTR && ft == 1 && types.mir_id(m, fi, ii) == 1 && vreg_scalar_value_ok(m, fi, val) {
                    if val < 0 || types.mir_temp_ty(m, fi, val) == 1 { matched = true }
                }
            }
            if !matched { << false }
        }
    }
    << load || store
}

// Resolve by exact MIR identity, then prove a scalar, memory-free callee.
// No name has semantic significance. Ordinary calls still retain their ABI
// barrier even when a later backend can lower an arithmetic idiom directly.
fn intfield_scalar_call(m &types.Mir, fi int, ii int) bool {
    if types.mir_ib(m, fi, ii) != 1 { << false }
    if m.fns.len <= 0 || m.fns.len > VREG_DIRECT_CALL_FN_CAP { << false }
    ln := types.mir_isval_len(m, fi, ii)
    if ln <= 0 || ln > 256 { << false }
    mut cf := -1
    for j in 0:m.fns.len {
        if types.mir_fn_is_extern(m, j) || types.mir_fn_label_len(m, j) != ln { -> }
        mut same := true
        for k in 0:ln {
            if types.mir_isval_byte(m, fi, ii, k) != types.mir_fn_label_byte(m, j, k) { same = false }
        }
        if same {
            if cf >= 0 { << false }
            cf = j
        }
    }
    if cf < 0 || types.mir_fn_receiver(m, cf) { << false }
    if types.mir_fn_ret(m, cf) != 1 || types.mir_fn_ret_nslots(m, cf) != 1 { << false }
    np := types.mir_fn_nparams(m, cf)
    if np <= 0 || np > 6 || np > types.mir_nlocals(m, cf) { << false }
    if types.mir_nblocks(m, cf) <= 0 || types.mir_nblocks(m, cf) > 2 { << false }
    if types.mir_nlocals(m, cf) > 24 || types.mir_ntemps(m, cf) > 128 || types.mir_nins(m, cf) > 256 { << false }
    for l in 0:types.mir_nlocals(m, cf) {
        if types.mir_local_ty(m, cf, l) != 1 || types.mir_local_nslots(m, cf, l) != 1 { << false }
    }
    for t in 0:types.mir_ntemps(m, cf) {
        if types.mir_temp_ty(m, cf, t) != 1 || types.mir_temp_nslots(m, cf, t) != 1 { << false }
    }
    for b in 0:types.mir_nblocks(m, cf) {
        tk := types.mir_btkind(m, cf, b)
        if tk != 3 && !(tk == 0 && types.mir_bhead(m, cf, b) < 0) { << false }
        mut ki := types.mir_bhead(m, cf, b)
        for _ in 0:types.mir_nins(m, cf) {
            if ki < 0 { <- }
            k := types.mir_ikind(m, cf, ki)
            if k != 0 && (k < 1 || k > 5) { << false }
            ki = types.mir_inext(m, cf, ki)
        }
    }
    << vreg_direct_call_ok(m, fi, ii)
}

fn fn_is_int_field_index_kernel(m &types.Mir, fi int) bool {
    if fi < 0 || fi >= m.fns.len || types.mir_fn_is_extern(m, fi) { << false }
    nb := types.mir_nblocks(m, fi)
    nl := types.mir_nlocals(m, fi)
    nt := types.mir_ntemps(m, fi)
    ni := types.mir_nins(m, fi)
    if nb <= 0 || nb > 32 || nl <= 0 || nl > 48 || nt > 512 || ni > 1024 { << false }
    np := types.mir_fn_nparams(m, fi)
    if np <= 0 || np > 6 || np > nl { << false }
    rt := types.mir_fn_ret(m, fi)
    if rt != 0 && rt != 1 { << false }
    recv := types.mir_local_ty(m, fi, 0)
    if types.mir_local_nslots(m, fi, 0) != 1 || !intfield_ref_type(m, recv) { << false }
    for l in 1:nl {
        if types.mir_local_ty(m, fi, l) != 1 || types.mir_local_nslots(m, fi, l) != 1 { << false }
    }
    for t in 0:nt {
        tt := types.mir_temp_ty(m, fi, t)
        ns := types.mir_temp_nslots(m, fi, t)
        if tt == 1 && ns == 1 { -> }
        if tt == recv && ns == 1 { -> }
        if ns == 3 && intfield_array_type(m, tt) { -> }
        << false
    }
    si := types.struct_index(vreg_direct_ref_inner(m,recv))
    mut load := false
    mut store := false
    mut field := false
    mut calls := 0
    for b in 0:nb {
        tk := types.mir_btkind(m, fi, b)
        if tk != 3 && !(tk == 0 && types.mir_bhead(m, fi, b) < 0) { << false }
        mut ii := types.mir_bhead(m, fi, b)
        for _ in 0:ni {
            if ii < 0 { <- }
            k := types.mir_ikind(m, fi, ii)
            if k == types.MI_STORE_LOCAL && types.mir_ia(m, fi, ii) == 0 { << false }
            if k == types.MI_CALL {
                if calls >= 16 { << false }
                calls += 1
                if !intfield_scalar_call(m, fi, ii) { << false }
            } else if k == types.MI_LOAD_PTR {
                d := types.mir_ia(m, fi, ii)
                p := types.mir_ib(m, fi, ii)
                if d < 0 || d >= nt || p < 0 || p >= nt { << false }
                if types.mir_temp_ty(m, fi, p) != recv || types.mir_id(m, fi, ii) != 3 { << false }
                if !intfield_array_type(m, types.mir_temp_ty(m, fi, d)) { << false }
                mut found := false
                for j in 0:m.structs[si].fields.len {
                    if m.structs[si].fields[j].slot == types.mir_ic(m, fi, ii) && m.structs[si].fields[j].ty == types.mir_temp_ty(m, fi, d) { found = true }
                }
                if !found { << false }
                field = true
            } else if k == types.MI_LOAD_INDEX || k == types.MI_STORE_INDEX {
                mut base := types.mir_ib(m, fi, ii)
                if k == types.MI_STORE_INDEX { base = types.mir_ia(m, fi, ii) }
                if base < 0 || base >= nt || !intfield_array_type(m, types.mir_temp_ty(m, fi, base)) { << false }
                w := types.mir_id(m, fi, ii)
                if w != 8 && w != -8 { << false }
                if k == types.MI_LOAD_INDEX { load = true } else { store = true }
            } else if k != types.MI_NOP && (k < 1 || k > 5) { << false }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << load && store && field
}

// Ordered reaching definition in an already qualified straight-line block.
// StoreLocal/StoreIndex use `a` as an operand, never as a Temp definition.
fn intfield_def_before(m &types.Mir, fi int, bi int, before int, t int) int {
    if before < 0 { << -1 }
    def := types.mir_value_def_before(m, fi, bi, before, 2, t)
    if def < 0 { << -1 }
    << def
}

fn intfield_receiver_root(m &types.Mir, fi int, bi int, before int, value int) bool {
    mut t := value
    mut stop := before
    for _ in 0:32 {
        ii := intfield_def_before(m, fi, bi, stop, t)
        if ii < 0 { << false }
        k := types.mir_ikind(m, fi, ii)
        if k == types.MI_LOAD_LOCAL { << types.mir_ib(m, fi, ii) == 0 }
        if k != types.MI_COPY { << false }
        t = types.mir_ib(m, fi, ii)
        stop = ii
    }
    << false
}

// Return the actual field offset, not an array TempId or receiver identity.
fn intfield_descriptor_key(m &types.Mir, fi int, bi int, before int, value int) int {
    mut t := value
    mut stop := before
    for _ in 0:32 {
        ii := intfield_def_before(m, fi, bi, stop, t)
        if ii < 0 { << -1 }
        k := types.mir_ikind(m, fi, ii)
        if k == types.MI_LOAD_PTR {
            if !intfield_receiver_root(m, fi, bi, ii, types.mir_ib(m, fi, ii)) { << -1 }
            << types.mir_ic(m, fi, ii)
        }
        if k != types.MI_COPY { << -1 }
        t = types.mir_ib(m, fi, ii)
        stop = ii
    }
    << -1
}

fn intfield_param_unchanged(m &types.Mir, fi int, loc int) bool {
    for b in 0:types.mir_nblocks(m, fi) {
        mut ii := types.mir_bhead(m, fi, b)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            if types.mir_ikind(m, fi, ii) == types.MI_STORE_LOCAL && types.mir_ia(m, fi, ii) == loc { << false }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << true
}

// Nonnegative keys are immutable formal locals; <= -2 are validated
// constant-pool values. -1 is unknown. No computed or memory index equality.
fn intfield_index_key(m &types.Mir, fi int, bi int, before int, value int) int {
    mut t := value
    mut stop := before
    for _ in 0:32 {
        if t <= -2 {
            ci := 0 - t - 2
            if ci < 0 || ci >= types.mir_nconsts(m, fi) { << -1 }
            << t
        }
        ii := intfield_def_before(m, fi, bi, stop, t)
        if ii < 0 { << -1 }
        k := types.mir_ikind(m, fi, ii)
        if k == types.MI_LOAD_LOCAL {
            loc := types.mir_ib(m, fi, ii)
            if loc <= 0 || loc >= types.mir_fn_nparams(m, fi) { << -1 }
            if !intfield_param_unchanged(m, fi, loc) { << -1 }
            << loc
        }
        if k != types.MI_COPY { << -1 }
        t = types.mir_ib(m, fi, ii)
        stop = ii
    }
    << -1
}

fn intfield_same_index_key(m &types.Mir, fi int, left int, right int) bool {
    if left >= 0 && right >= 0 { << left == right }
    if left <= -2 && right <= -2 {
        << types.mir_const_at(m, fi, 0 - left - 2) == types.mir_const_at(m, fi, 0 - right - 2)
    }
    << false
}

// Reuse only a check already executed on this block's current path. The
// whole-function proof forbids descriptor mutation, escaping references and
// unknown calls. A chain of reused checks ends at the first original check;
// never move that check ahead of an earlier write or trap.
fn intfield_prior_index_check(m &types.Mir, fi int, bi int, before int, base int, idx int) bool {
    if !fn_is_int_field_index_kernel(m, fi) { << false }
    if bi < 0 || bi >= types.mir_nblocks(m, fi) || types.mir_btkind(m, fi, bi) != 3 { << false }
    field := intfield_descriptor_key(m, fi, bi, before, base)
    key := intfield_index_key(m, fi, bi, before, idx)
    if field < 0 || key == -1 { << false }
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 || ii == before { << false }
        k := types.mir_ikind(m, fi, ii)
        if (k == types.MI_LOAD_INDEX || k == types.MI_STORE_INDEX) && types.mir_id(m, fi, ii) > 0 {
            mut arr := types.mir_ib(m, fi, ii)
            mut ind := types.mir_ic(m, fi, ii)
            if k == types.MI_STORE_INDEX {
                arr = types.mir_ia(m, fi, ii)
                ind = types.mir_ib(m, fi, ii)
            }
            if intfield_descriptor_key(m, fi, bi, ii, arr) == field {
                prior := intfield_index_key(m, fi, bi, ii, ind)
                if intfield_same_index_key(m, fi, prior, key) { << true }
            }
        }
        ii = types.mir_inext(m, fi, ii)
    }
    << false
}
fn intfield_bounds_gate_mode(mode int, want bool) bool {
    m := types.mir_intfield_bounds_gate_fixture(mode)
    ii := types.mir_btb(&m, 0, 0)
    mut base := types.mir_ia(&m, 0, ii)
    mut idx := types.mir_ib(&m, 0, ii)
    if types.mir_ikind(&m, 0, ii) == types.MI_LOAD_INDEX {
        base = types.mir_ib(&m, 0, ii)
        idx = types.mir_ic(&m, 0, ii)
    }
    << intfield_prior_index_check(&m, 0, 0, ii, base, idx) == want
}

fn intfield_bounds_internal_gate() bool {
    for mode in 0:20 {
        want := mode == 0 || mode == 1 || mode == 2 || mode == 13
        if !intfield_bounds_gate_mode(mode, want) { << false }
    }
    << true
}
// Defined once: a skipped producer cannot accidentally hide another version
// of the same TempId. The bound is supplied by the intfield body admission.
fn intfield_unique_temp_def(m &types.Mir, fi int, t int) int {
    if t < 0 || t >= types.mir_ntemps(m, fi) { << -1 }
    mut found := -1
    for b in 0:types.mir_nblocks(m, fi) {
        mut ii := types.mir_bhead(m, fi, b)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            k := types.mir_ikind(m, fi, ii)
            if types.mir_instr_has_dest(k) && types.mir_ia(m, fi, ii) == t {
                if found >= 0 { << -1 }
                found = ii
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << found
}

fn intfield_instr_block(m &types.Mir, fi int, want int) int {
    for b in 0:types.mir_nblocks(m, fi) {
        mut ii := types.mir_bhead(m, fi, b)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            if ii == want { << b }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << -1
}

// Call only after a qualified integer field body. Descriptor Copies and any
// non-index or cross-block uses retain their original frame materialization.
fn intfield_elided_descriptor_field(m &types.Mir, fi int, t int) int {
    if t < 0 || t >= types.mir_ntemps(m, fi) { << -1 }
    if !intfield_array_type(m, types.mir_temp_ty(m, fi, t)) { << -1 }
    d := intfield_unique_temp_def(m, fi, t)
    if d < 0 || types.mir_ikind(m, fi, d) != types.MI_LOAD_PTR { << -1 }
    bi := intfield_instr_block(m, fi, d)
    if bi < 0 || !intfield_receiver_root(m, fi, bi, d, types.mir_ib(m, fi, d)) { << -1 }
    mut uses := 0
    for b in 0:types.mir_nblocks(m, fi) {
        if types.mir_bta(m, fi, b) == t { << -1 }
        mut ii := types.mir_bhead(m, fi, b)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            if mir_instr_uses_temp(m, fi, ii, t) {
                k := types.mir_ikind(m, fi, ii)
                mut ok := k == types.MI_LOAD_INDEX && types.mir_ib(m, fi, ii) == t && types.mir_ic(m, fi, ii) != t
                if k == types.MI_STORE_INDEX && types.mir_ia(m, fi, ii) == t && types.mir_ib(m, fi, ii) != t && types.mir_ic(m, fi, ii) != t { ok = true }
                if !ok || b != bi || types.mir_icol(m, fi, ii) != 0 { << -1 }
                if intfield_def_before(m, fi, bi, ii, t) != d { << -1 }
                uses += 1
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    if uses <= 0 { << -1 }
    << types.mir_ic(m, fi, d)
}

fn intfield_elided_receiver_temp(m &types.Mir, fi int, t int) bool {
    if t < 0 || t >= types.mir_ntemps(m, fi) { << false }
    if types.mir_temp_ty(m, fi, t) != types.mir_local_ty(m, fi, 0) { << false }
    d := intfield_unique_temp_def(m, fi, t)
    if d < 0 || types.mir_ikind(m, fi, d) != types.MI_LOAD_LOCAL || types.mir_ib(m, fi, d) != 0 { << false }
    bi := intfield_instr_block(m, fi, d)
    mut uses := 0
    for b in 0:types.mir_nblocks(m, fi) {
        if types.mir_bta(m, fi, b) == t { << false }
        mut ii := types.mir_bhead(m, fi, b)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            if mir_instr_uses_temp(m, fi, ii, t) {
                if b != bi || types.mir_ikind(m, fi, ii) != types.MI_LOAD_PTR || types.mir_ib(m, fi, ii) != t { << false }
                if intfield_elided_descriptor_field(m, fi, types.mir_ia(m, fi, ii)) < 0 { << false }
                uses += 1
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << uses > 0
}

fn intfield_elided_frame_temp(m &types.Mir, fi int, t int) bool {
    << intfield_elided_descriptor_field(m, fi, t) >= 0 || intfield_elided_receiver_temp(m, fi, t)
}
fn intfield_receiver_frame_ok(fr &Frame) bool {
    << fr.local_slot.len > 0 && is_frame_slot(fr.local_slot[0])
}

fn intfield_forward_enabled(m &types.Mir, fi int, fr &Frame) bool {
    << frame_has_vregs(fr) && intfield_receiver_frame_ok(fr) && (fn_is_int_field_index_kernel(m, fi) || fn_is_readonly_i64_field_index(m, fi))
}

fn intfield_descriptor_gate_mode(mode int) bool {
    m := types.mir_intfield_bounds_gate_fixture(mode)
    shape := fn_is_int_field_index_kernel(&m, 0)
    mut desc := false
    mut recv := false
    if shape {
        desc = intfield_elided_descriptor_field(&m, 0, 1) >= 0
        recv = intfield_elided_receiver_temp(&m, 0, 0)
    }
    want_desc := mode != 7 && mode != 8 && mode != 9 && mode != 11 && mode != 13 && mode != 17 && mode != 18 && mode != 20 && mode != 21 && mode != 22 && mode != 23 && mode != 25 && mode != 27 && mode != 30
    want_recv := want_desc && mode != 2 && mode != 24 && mode != 26 && mode != 28 && mode != 29
    if desc != want_desc || recv != want_recv { << false }
    if mode == 26 && intfield_elided_descriptor_field(&m, 0, 5) != 0 { << false }
    if mode == 22 && intfield_elided_descriptor_field(&m, 0, 7) >= 0 { << false }
    << true
}

fn intfield_descriptor_internal_gate() bool {
    for mode in 0:31 { if !intfield_descriptor_gate_mode(mode) { << false } }
    << true
}

// Read-only integer/byte indexing may color scalars while direct references
// and array/string descriptors stay in the frame. Writes/calls are excluded.
fn readonly_i64_array(m &types.Mir, ty int) bool {
    if !types.is_array_type(ty) { << false }
    ai := types.array_index(ty)
    if ai < 0 || ai >= m.arrays.len { << false }
    << m.arrays[ai].elem_ty == 1 && m.arrays[ai].elem_bytes == 8 && m.arrays[ai].fixed_len == 0
}
fn readonly_i64_type(m &types.Mir, ty int, ns int) bool {
    if ty == 1 || ty == 2 { << ns == 1 }
    if ty == 3 { << ns == 3 }
    if readonly_i64_array(m, ty) { << ns == 3 }
    if ns != 1 { << false }
    inner := vreg_direct_ref_inner(m,ty)
    if inner == 1 || inner == 2 || inner == 3 { << true }
    if readonly_i64_array(m, inner) { << true }
    // Bounded lookup tables are borrowed payloads, not dynamic descriptors.
    // Do not admit inline fixed-array copies or change record-field shortcuts.
    if types.is_array_type(inner) {
        ai := types.array_index(inner)
        if ai < 0 || ai >= m.arrays.len { << false }
        << m.arrays[ai].elem_ty == 1 && m.arrays[ai].elem_bytes == 8 && m.arrays[ai].fixed_len > 0 && m.arrays[ai].fixed_len <= 256
    }
    if !types.is_struct_type(inner) { << false }
    si := types.struct_index(inner)
    if si < 0 || si >= m.structs.len || m.structs[si].fields.len > 64 { << false }
    words := m.structs[si].nslots
    size := m.structs[si].size_bytes
    if words <= 0 || words > 256 || size <= (words - 1) * 8 || size > words * 8 { << false }
    for f in 0:m.structs[si].fields.len {
        ft := m.structs[si].fields[f].ty
        if ft != 1 && ft != 2 && !readonly_i64_array(m, ft) { << false }
        off := m.structs[si].fields[f].slot
        width := m.type_size_bytes(ft)
        if width <= 0 || off < 0 || off > size || width > size - off { << false }
    }
    << true
}
fn fn_is_readonly_i64_index(m &types.Mir, fi int) bool {
    if fi < 0 || fi >= m.fns.len || types.mir_fn_is_extern(m, fi) { << false }
    if types.mir_nblocks(m, fi) <= 0 || types.mir_nblocks(m, fi) > 128 || types.mir_nlocals(m, fi) > 48 || types.mir_ntemps(m, fi) > 512 || types.mir_nins(m, fi) > 1024 { << false }
    if types.mir_fn_nparams(m, fi) < 0 || types.mir_fn_nparams(m, fi) > 6 || types.mir_fn_nparams(m, fi) > types.mir_nlocals(m, fi) { << false }
    if m.fns[fi].locals_owning.len != types.mir_nlocals(m, fi) { << false }
    if m.fns[fi].locals_nslots.len != types.mir_nlocals(m, fi) || m.fns[fi].temps_nslots.len != types.mir_ntemps(m, fi) { << false }
    ret := types.mir_fn_ret(m, fi)
    if ret != 0 && ret != 1 && ret != 2 { << false }
    if ret != 0 && types.mir_fn_ret_nslots(m, fi) != 1 { << false }
    if ret == 0 && types.mir_fn_ret_nslots(m, fi) != 0 && types.mir_fn_ret_nslots(m, fi) != 1 { << false }
    for i in 0:types.mir_nlocals(m, fi) {
        if !readonly_i64_type(m, types.mir_local_ty(m, fi, i), types.mir_local_nslots(m, fi, i)) { << false }
    }
    for t in 0:types.mir_ntemps(m, fi) {
        if !readonly_i64_type(m, types.mir_temp_ty(m, fi, t), types.mir_temp_nslots(m, fi, t)) { << false }
    }
    if !vreg_mir_shape_ok(m, fi) || !types.mir_verify_emission_calls(m, fi) { << false }
    mut indexed := false
    for b in 0:types.mir_nblocks(m, fi) {
        tk := types.mir_btkind(m, fi, b)
        if tk == 2 && !vreg_scalar_value_ok(m, fi, types.mir_bta(m, fi, b)) { << false }
        if tk == 3 {
            value := types.mir_bta(m, fi, b)
            if ret == 0 { if value != -1 { << false } }
            else {
                if !vreg_scalar_value_ok(m, fi, value) { << false }
                if value >= 0 && types.mir_temp_ty(m, fi, value) != ret { << false }
            }
        }
        mut ii := types.mir_bhead(m, fi, b)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            k := types.mir_ikind(m, fi, ii)
            if k != types.MI_NOP && k != types.MI_COPY && k != types.MI_LOAD_LOCAL && k != types.MI_STORE_LOCAL && k != types.MI_BIN && k != types.MI_UN && k != types.MI_LOAD_FIELD && k != types.MI_LOAD_INDEX && k != types.MI_LOAD_PTR { << false }
            if k == types.MI_STORE_LOCAL {
                loc := types.mir_ia(m, fi, ii)
                ty := types.mir_local_ty(m, fi, loc)
                if (ty != 1 && ty != 2) || types.mir_local_nslots(m, fi, loc) != 1 { << false }
                if loc >= m.fns[fi].locals_owning.len || m.fns[fi].locals_owning[loc] { << false }
            }
            if k >= 1 && k <= 5 && !vreg_basic_instr_ok(m, fi, ii) { << false }
            if k == types.MI_LOAD_FIELD && !vreg_loadfield_ok(m, fi, types.mir_ia(m, fi, ii), types.mir_ib(m, fi, ii), types.mir_ic(m, fi, ii), types.mir_id(m, fi, ii)) { << false }
            if k == types.MI_LOAD_PTR {
                d := types.mir_ia(m, fi, ii)
                p := types.mir_ib(m, fi, ii)
                off := types.mir_ic(m, fi, ii)
                ns := types.mir_id(m, fi, ii)
                if !vreg_loadptr_ok(m, fi, d, p, off, ns) { << false }
                inner := vreg_direct_ref_inner(m,types.mir_temp_ty(m, fi, p))
                dt := types.mir_temp_ty(m, fi, d)
                if types.is_struct_type(inner) {
                    si := types.struct_index(inner)
                    mut exact := false
                    for f in 0:m.structs[si].fields.len {
                        if m.structs[si].fields[f].slot == off && m.structs[si].fields[f].ty == dt { exact = true }
                    }
                    if !exact { << false }
                } else if off != 0 || inner != dt {
                    // Array length/capacity and string length are int header
                    // reads. Strings keep the complete descriptor in memory.
                    // The complete pointer span was checked above.
                    if dt != 1 || ns != 1 { << false }
                    if inner == 3 { if off != 8 { << false } }
                    else if !readonly_i64_array(m, inner) || (off != 8 && off != 16) { << false }
                }
            }
            if k == types.MI_LOAD_INDEX {
                d := types.mir_ia(m, fi, ii)
                if types.mir_temp_ty(m, fi, d) != 1 || types.mir_temp_nslots(m, fi, d) != 1 { << false }
                base := types.mir_ib(m, fi, ii)
                if !vreg_index_value_ok(m, fi, types.mir_ic(m, fi, ii)) { << false }
                w := types.mir_id(m, fi, ii)
                if vreg_string_base_temp(m, fi, base) {
                    // Byte indexing zero-extends into the language int. The
                    // negative width preserves MIR's existing bounds proof,
                    // just as it does for read-only integer array loads below.
                    if (w != 1 && w != -1) || types.mir_icol(m, fi, ii) != 0 { << false }
                } else {
                    if w != 8 && w != -8 { << false }
                    if vreg_index_elem_ty(m, fi, base) == 1 {
                        if types.mir_icol(m, fi, ii) != 0 { << false }
                    } else {
                        // The emitter uses a distinct fixed-payload path.
                        // Match its literal bound to the actual borrowed type.
                        tag := types.MIR_LOCAL_OPERAND_BASE
                        mut bty := 0
                        mut bslots := 0
                        if base >= tag {
                            loc := base - tag
                            if loc < 0 || loc >= types.mir_nlocals(m, fi) { << false }
                            bty = types.mir_local_ty(m, fi, loc)
                            bslots = types.mir_local_nslots(m, fi, loc)
                        } else {
                            if base < 0 || base >= types.mir_ntemps(m, fi) { << false }
                            bty = types.mir_temp_ty(m, fi, base)
                            bslots = types.mir_temp_nslots(m, fi, base)
                        }
                        inner := vreg_direct_ref_inner(m,bty)
                        if bslots != 1 || !types.is_array_type(inner) { << false }
                        ai := types.array_index(inner)
                        if ai < 0 || ai >= m.arrays.len { << false }
                        len := m.arrays[ai].fixed_len
                        if len <= 0 || len > 256 || len != types.mir_icol(m, fi, ii) || m.arrays[ai].elem_ty != 1 || m.arrays[ai].elem_bytes != 8 { << false }
                    }
                }
                indexed = true
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << indexed
}

// The field shortcut reads Local0 directly. Qualify its immutable receiver
// and every array LoadPtr against the actual declared field layout first.
fn fn_is_readonly_i64_field_index(m &types.Mir, fi int) bool {
    // A field shortcut needs a record receiver. Check that cheap necessary
    // condition before repeatedly proving the whole CFG for scalar callers.
    if fi < 0 || fi >= m.fns.len || types.mir_fn_nparams(m, fi) <= 0 { << false }
    nl := types.mir_nlocals(m, fi)
    if nl <= 0 || m.fns[fi].locals_nslots.len != nl { << false }
    recv := types.mir_local_ty(m, fi, 0)
    inner := vreg_direct_ref_inner(m,recv)
    if !types.is_struct_type(inner) || types.mir_local_nslots(m, fi, 0) != 1 { << false }
    si := types.struct_index(inner)
    if si < 0 || si >= m.structs.len { << false }
    if !fn_is_readonly_i64_index(m, fi) { << false }
    mut field := false
    for b in 0:types.mir_nblocks(m, fi) {
        mut ii := types.mir_bhead(m, fi, b)
        for _ in 0:types.mir_nins(m, fi) {
            if ii < 0 { <- }
            if types.mir_ikind(m, fi, ii) == types.MI_LOAD_PTR {
                d := types.mir_ia(m, fi, ii)
                if readonly_i64_array(m, types.mir_temp_ty(m, fi, d)) {
                    p := types.mir_ib(m, fi, ii)
                    if types.mir_temp_ty(m, fi, p) != recv || types.mir_id(m, fi, ii) != 3 { << false }
                    mut found := false
                    for f in 0:m.structs[si].fields.len {
                        if m.structs[si].fields[f].slot == types.mir_ic(m, fi, ii) && m.structs[si].fields[f].ty == types.mir_temp_ty(m, fi, d) { found = true }
                    }
                    if !found { << false }
                    field = true
                }
            }
            ii = types.mir_inext(m, fi, ii)
        }
    }
    << field
}
