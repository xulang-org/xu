@main

#internal/modulepath
// Xu static object / Unix ar (mirrors bootstrap xubin/xuobj.rs).

struct XuExport {
    name   string
    label  string
    params []int
    ret    int
}

struct XuObject {
    os      int
    arch    int
    module  string
    path    string
    kind    int
    exports []XuExport
    code    []int
    data    []int
    // labels: name, offset, is_data (0/1)
    lname   []string
    loff    []int
    ldata   []int
    // relocs: kind, offset, rd, label
    rkind   []int
    roff    []int
    rrd     []int
    rlab    []string
    // Mach-O pack scratch (only during xuobj_macho_from_obj).
    mx_pk   []int
    mx_po   []int
    mx_pl   []string
    mx_sn   []string
    mx_st   []int
    mx_ss   []int
    mx_sd   []int
    mx_sv   []int
    mx_tr   []int
    mx_dr   []int
    mx_ndef int
    mx_nund int
}

fn path_is_ar(p string) bool {
    if p.len >= 2 && p[p.len - 2] == 46 && p[p.len - 1] == 97 {
        << true
    }
    << false
}

fn path_is_xulib(p string) bool {
    n := p.len
    if n >= 6 && p[n - 6] == 46 && p[n - 5] == 120 && p[n - 4] == 117 && p[n - 3] == 108 && p[n - 2] == 105 && p[n - 1] == 98 {
        << true
    }
    << false
}

fn path_is_dll(p string) bool {
    n := p.len
    if n >= 4 && p[n - 4] == 46 && p[n - 3] == 100 && p[n - 2] == 108 && p[n - 1] == 108 {
        << true
    }
    << false
}

fn pe_win_path(s string) string {
    mut o := ""
    for i in 0:s.len {
        if s[i] == 47 {
            o = o + "\\"
        } else {
            o = o + string_from_bytes([s[i]])
        }
    }
    << o
}

fn dll_load_name(out string, dylib string) string {
    ap := abs_link_path(dylib)
    if out.len == 0 {
        << path_basename(&ap)
    }
    out_abs := abs_link_path(out)
    od := path_dirname(&out_abs)
    rel := dylib_rel_under(od + "", ap + "")
    if rel.len > 0 {
        << pe_win_path(rel + "")
    }
    par := path_dirname(&od)
    if par.len > 0 && par != "/" {
        rel2 := dylib_rel_under(par, ap + "")
        if rel2.len > 0 {
            << "..\\" + pe_win_path(rel2 + "")
        }
        par2 := path_dirname(&par)
        if par2.len > 0 && par2 != "/" {
            rel3 := dylib_rel_under(par2, ap + "")
            if rel3.len > 0 {
                << "..\\..\\" + pe_win_path(rel3 + "")
            }
        }
    }
    << path_basename(&ap)
}

fn path_is_dylib(p string) bool {
    n := p.len
    if n >= 6 && p[n - 6] == 46 && p[n - 5] == 100 && p[n - 4] == 121 && p[n - 3] == 108 && p[n - 2] == 105 && p[n - 1] == 98 {
        << true
    }
    if n >= 3 && p[n - 3] == 46 && p[n - 2] == 115 && p[n - 1] == 111 {
        << true
    }
    if path_is_dll(p + "") {
        << true
    }
    << false
}

fn abs_link_path(p string) string {
    if p.len > 0 && p[0] == 47 {
        << p
    }
    c := cwd()
    if c.len > 0 && c[c.len - 1] == 47 {
        << c + p
    }
    << c + "/" + p
}

fn dylib_rel_under(dir string, file string) string {
    if dir.len == 0 {
        << ""
    }
    if dir == "/" {
        if file.len > 1 && file[0] == 47 {
            << file[1:file.len]
        }
        << ""
    }
    if file.len <= dir.len {
        << ""
    }
    for i in 0:dir.len {
        if file[i] != dir[i] {
            << ""
        }
    }
    if file[dir.len] != 47 {
        << ""
    }
    << file[dir.len + 1:file.len]
}

fn dylib_load_name(out string, dylib string, origin string) string {
    ap := abs_link_path(dylib)
    if out.len == 0 {
        << ap
    }
    out_abs := abs_link_path(out)
    od := path_dirname(&out_abs)
    rel := dylib_rel_under(od + "", ap + "")
    if rel.len > 0 {
        << origin + "/" + rel
    }
    par := path_dirname(&od)
    if par.len > 0 && par != "/" {
        rel2 := dylib_rel_under(par, ap + "")
        if rel2.len > 0 {
            << origin + "/../" + rel2
        }
        par2 := path_dirname(&par)
        if par2.len > 0 && par2 != "/" {
            rel3 := dylib_rel_under(par2, ap + "")
            if rel3.len > 0 {
                << origin + "/../../" + rel3
            }
        }
    }
    << ap
}

fn xuobj_decode_dylib(b []int) XuObject {
    mut pos := 0 - 1
    if b.len >= 8 {
        mut i := b.len - 8
        while i >= 0 {
            if (b[i] & 255) == 88 && (b[i + 1] & 255) == 85 && (b[i + 2] & 255) == 79 && (b[i + 3] & 255) == 66 && (b[i + 4] & 255) == 74 && (b[i + 5] & 255) == 1 {
                pos = i
                <-
            }
            i = i - 1
        }
    }
    if pos < 0 {
        << XuObject{os: 0, arch: 0, module: "", path: "", kind: 0, exports: []XuExport{}, code: []int{}, data: []int{}, lname: []string{}, loff: []int{}, ldata: []int{}, rkind: []int{}, roff: []int{}, rrd: []int{}, rlab: []string{}, mx_pk: []int{}, mx_po: []int{}, mx_pl: []string{}, mx_sn: []string{}, mx_st: []int{}, mx_ss: []int{}, mx_sd: []int{}, mx_sv: []int{}, mx_tr: []int{}, mx_dr: []int{}, mx_ndef: 0, mx_nund: 0}
    }
    mut slice := []int{}
    for j in pos:b.len {
        slice.push(b[j] & 255)
    }
    << xuobj_decode(slice)
}

fn put_u16(b &mut []int, v int) {
    b.push(v & 255)
    b.push((v >> 8) & 255)
}

fn put_u32(b &mut []int, v int) {
    b.push(v & 255)
    b.push((v >> 8) & 255)
    b.push((v >> 16) & 255)
    b.push((v >> 24) & 255)
}

fn put_str_obj(b &mut []int, s string) {
    put_u16(b, s.len)
    for i in 0:s.len {
        b.push(s[i] & 255)
    }
}

fn xuobj_encode(o &XuObject) []int {
    mut b := []int{}
    // "XUOBJ\x01\0\0"
    b.push(88)
    b.push(85)
    b.push(79)
    b.push(66)
    b.push(74)
    b.push(1)
    b.push(0)
    b.push(0)
    b.push(o.os & 255)
    b.push(o.arch & 255)
    put_u16(mut &b, 0)
    put_str_obj(mut &b, o.module)
    put_u32(mut &b, o.exports.len)
    for i in 0:o.exports.len {
        put_str_obj(mut &b, o.exports[i].name)
        put_str_obj(mut &b, o.exports[i].label)
        b.push(o.exports[i].ret & 255)
        b.push(o.exports[i].params.len & 255)
        for j in 0:o.exports[i].params.len {
            b.push(o.exports[i].params[j] & 255)
        }
    }
    put_u32(mut &b, o.lname.len)
    for i in 0:o.lname.len {
        b.push(o.ldata[i] & 255)
        put_u32(mut &b, o.loff[i])
        put_str_obj(mut &b, o.lname[i])
    }
    put_u32(mut &b, o.rkind.len)
    for i in 0:o.rkind.len {
        b.push(o.rkind[i] & 255)
        b.push(o.rrd[i] & 255)
        put_u32(mut &b, o.roff[i])
        put_str_obj(mut &b, o.rlab[i])
    }
    put_u32(mut &b, o.code.len)
    for i in 0:o.code.len {
        b.push(o.code[i] & 255)
    }
    put_u32(mut &b, o.data.len)
    for i in 0:o.data.len {
        b.push(o.data[i] & 255)
    }
    << b
}

fn xuobj_encode_archive(o &XuObject) []int {
    member := xuobj_encode(o)
    mut out := []int{}
    hdr := "!<arch>\n"
    for i in 0:hdr.len {
        out.push(hdr[i] & 255)
    }
    // 60-byte ar header: xu.o/
    name := "xu.o/"
    for i in 0:16 {
        if i < name.len {
            out.push(name[i] & 255)
        } else {
            out.push(32)
        }
    }
    // date/uid/gid
    for i in 0:12 { out.push(32) }
    for i in 0:6 { out.push(32) }
    for i in 0:6 { out.push(32) }
    mode := "100644  "
    for i in 0:8 { out.push(mode[i] & 255) }
    mut size_s := str(member.len)
    for i in 0:10 {
        if i < size_s.len {
            out.push(size_s[i] & 255)
        } else {
            out.push(32)
        }
    }
    out.push(96) // `
    out.push(10)
    for i in 0:member.len {
        out.push(member[i] & 255)
    }
    if member.len % 2 == 1 {
        out.push(0)
    }
    << out
}

fn (a &mut Assembler) merge_xuobj(o &XuObject) {
    code_off := a.code.len
    data_off := a.data.len
    for i in 0:o.code.len {
        a.code.push(o.code[i])
    }
    for i in 0:o.data.len {
        a.data.push(o.data[i])
    }
    for i in 0:o.lname.len {
        // Object-image names may alias a decoder buffer; copy before lookup
        // and before retaining the value in the assembler.
        raw_name := o.lname[i]
        name := asm_string_copy(&raw_name)
        lookup := asm_string_copy(&name)
        existing := a.label_index(lookup)
        if existing >= 0 && lab_off(&a.labels, existing) >= 0 {
            ->
        }
        mut off := code_off + o.loff[i]
        if o.ldata[i] != 0 {
            off = data_off + o.loff[i]
            a.data_label_at(name, off)
        } else {
            a.label_at(name, off)
        }
    }
    for i in 0:o.rkind.len {
        lab := o.rlab[i]
        a.push_fixup_at(o.rkind[i], code_off + o.roff[i], &lab, o.rrd[i])
    }
}

fn (a &mut Assembler) label_at(name string, off int) {
    a.define_label(&name, off, false)
}

fn (a &mut Assembler) data_label_at(name string, off int) {
    a.define_label(&name, off, true)
}

fn get_u16_at(b &[]int, i int) int {
    << (b[i] & 255) + ((b[i + 1] & 255) << 8)
}

fn get_u32_at(b &[]int, i int) int {
    << (b[i] & 255) + ((b[i + 1] & 255) << 8) + ((b[i + 2] & 255) << 16) + ((b[i + 3] & 255) << 24)
}

fn get_u64_at(b &[]int, i int) int {
    lo := get_u32_at(b, i) & 4294967295
    hi := get_u32_at(b, i + 4) & 4294967295
    << lo | (hi << 32)
}

fn bytes_match_string(b &[]int, start int, n int, s &string) bool {
    if n != s.len || start < 0 || start + n > b.len {
        << false
    }
    for i in 0:n {
        if (b[start + i] & 255) != (s[i] & 255) {
            << false
        }
    }
    << true
}

fn xuobj_xulib_extract(b &[]int, target &string) []int {
    mut out := []int{}
    // XULIB\x01\x00 + version:u16 + flags:u16 + manifest_len:u32.
    if b.len < 19 {
        << out
    }
    if (b[0] & 255) != 88 || (b[1] & 255) != 85 || (b[2] & 255) != 76 || (b[3] & 255) != 73 || (b[4] & 255) != 66 || (b[5] & 255) != 1 || (b[6] & 255) != 0 {
        << out
    }
    if get_u16_at(b, 7) != 1 {
        << out
    }
    manifest_len := get_u32_at(b, 11)
    mut pos := 15 + manifest_len
    if manifest_len < 0 || pos < 15 || pos + 4 > b.len {
        << out
    }
    count := get_u32_at(b, pos)
    pos = pos + 4
    if count < 0 || count > 1024 {
        << out
    }
    for _ in 0:count {
        if pos + 2 > b.len {
            << []int{}
        }
        target_len := get_u16_at(b, pos)
        pos = pos + 2
        if target_len < 0 || pos + target_len + 1 > b.len {
            << []int{}
        }
        mut matched := bytes_match_string(b, pos, target_len, target)
        pos = pos + target_len
        kind_len := b[pos] & 255
        pos = pos + 1
        if pos + kind_len + 48 > b.len {
            << []int{}
        }
        archive_kind := "archive"
        if !bytes_match_string(b, pos, kind_len, &archive_kind) {
            matched = false
        }
        pos = pos + kind_len
        offset := get_u64_at(b, pos)
        size := get_u64_at(b, pos + 8)
        pos = pos + 48
        if offset < 0 || size < 0 || offset > b.len || size > b.len - offset {
            << []int{}
        }
        if matched {
            for i in 0:size {
                out.push(b[offset + i] & 255)
            }
            << out
        }
    }
    << out
}

fn get_str_at(b &[]int, i &mut int) string {
    n := get_u16_at(b, *i)
    *i = *i + 2
    mut chars := []int{}
    for k in 0:n {
        chars.push(b[*i + k] & 255)
    }
    *i = *i + n
    << bytes_to_str(chars)
}

fn bytes_to_str(chars []int) string {
    mut s := ""
    for i in 0:chars.len {
        s = s + intern_byte(chars[i])
    }
    << s
}

fn intern_byte(b int) string {
    << string_from_byte(b)
}

fn xuobj_decode(b []int) XuObject {
    mut o := XuObject{os: 0, arch: 0, module: "", path: "", kind: 0, exports: []XuExport{}, code: []int{}, data: []int{}, lname: []string{}, loff: []int{}, ldata: []int{}, rkind: []int{}, roff: []int{}, rrd: []int{}, rlab: []string{}, mx_pk: []int{}, mx_po: []int{}, mx_pl: []string{}, mx_sn: []string{}, mx_st: []int{}, mx_ss: []int{}, mx_sd: []int{}, mx_sv: []int{}, mx_tr: []int{}, mx_dr: []int{}, mx_ndef: 0, mx_nund: 0}
    if b.len < 8 { << o }
    mut i := 8
    o.os = b[8]
    o.arch = b[9]
    i = 12
    mut ip := i
    o.module = get_str_at(&b, mut &ip)
    i = ip
    nexp := get_u32_at(&b, i)
    i = i + 4
    for _ in 0:nexp {
        ip = i
        nm := get_str_at(&b, mut &ip)
        i = ip
        ip = i
        lb := get_str_at(&b, mut &ip)
        i = ip
        ret := b[i] & 255
        i = i + 1
        np := b[i] & 255
        i = i + 1
        mut ps := []int{}
        for j in 0:np {
            ps.push(b[i] & 255)
            i = i + 1
        }
        o.exports.push(XuExport{name: nm, label: lb, params: ps, ret: ret})
    }
    nlab := get_u32_at(&b, i)
    i = i + 4
    for _ in 0:nlab {
        fl := b[i] & 255
        i = i + 1
        off := get_u32_at(&b, i)
        i = i + 4
        ip = i
        nm := get_str_at(&b, mut &ip)
        i = ip
        o.lname.push(nm)
        o.loff.push(off)
        o.ldata.push(fl)
    }
    nrel := get_u32_at(&b, i)
    i = i + 4
    for _ in 0:nrel {
        k := b[i] & 255
        i = i + 1
        rd := b[i] & 255
        i = i + 1
        off := get_u32_at(&b, i)
        i = i + 4
        ip = i
        lb := get_str_at(&b, mut &ip)
        i = ip
        o.rkind.push(k)
        o.roff.push(off)
        o.rrd.push(rd)
        o.rlab.push(lb)
    }
    cl := get_u32_at(&b, i)
    i = i + 4
    for _ in 0:cl {
        o.code.push(b[i] & 255)
        i = i + 1
    }
    dl := get_u32_at(&b, i)
    i = i + 4
    for _ in 0:dl {
        o.data.push(b[i] & 255)
        i = i + 1
    }
    << o
}

fn ar_member_name_is_xuobj(b &[]int, start int, n int) bool {
    if start < 0 || n < 0 || start + n > b.len {
        << false
    }
    mut end := n
    while end > 0 {
        ch := b[start + end - 1] & 255
        if ch != 0 && ch != 32 && ch != 47 {
            <-
        }
        end = end - 1
    }
    if end != 4 {
        << false
    }
    << (b[start] & 255) == 120 && (b[start + 1] & 255) == 117 && (b[start + 2] & 255) == 46 && (b[start + 3] & 255) == 111
}

fn xuobj_decode_archive(b []int) XuObject {
    if b.len >= 8 {
        mut mag := 1
        sig := "!<arch>\n"
        for i in 0:8 {
            if (b[i] & 255) != (sig[i] & 255) {
                mag = 0
            }
        }
        if mag == 0 {
            << xuobj_decode(b)
        }
        mut i := 8
        while i + 60 <= b.len {
            header := i
            mut s := ""
            for k in 48:58 {
                ch := b[header + k] & 255
                if ch != 32 {
                    s = s + intern_byte(ch)
                }
            }
            size := atoi_simple(s)
            i = i + 60
            if size < 0 || i + size > b.len {
                <-
            }

            mut body_start := i
            mut body_size := size
            mut is_xuobj := false
            if (b[header] & 255) == 35 && (b[header + 1] & 255) == 49 && (b[header + 2] & 255) == 47 {
                mut ns := ""
                for k in 3:16 {
                    ch := b[header + k] & 255
                    if ch != 32 {
                        ns = ns + intern_byte(ch)
                    }
                }
                name_size := atoi_simple(ns)
                if name_size >= 0 && name_size <= body_size {
                    is_xuobj = ar_member_name_is_xuobj(&b, body_start, name_size)
                    body_start = body_start + name_size
                    body_size = body_size - name_size
                }
            } else {
                is_xuobj = ar_member_name_is_xuobj(&b, header, 16)
            }
            if is_xuobj {
                mut body := []int{}
                for k in 0:body_size {
                    body.push(b[body_start + k] & 255)
                }
                << xuobj_decode_dylib(body)
            }
            i = i + size
            if size % 2 == 1 {
                i = i + 1
            }
        }
    }
    << xuobj_decode(b)
}

fn atoi_simple(s string) int {
    mut n := 0
    for i in 0:s.len {
        c := s[i] & 255
        if c >= 48 && c <= 57 {
            n = n * 10 + (c - 48)
        }
    }
    << n
}

fn lib_export_param_ok(t int) bool {
    if t == 1 || t == 2 || t == 3 || t == 4 { << true }
    if t == 8 || t == 9 || t == 10 { << true }
    << false
}

fn lib_export_ret_ok(t int) bool {
    if t == 0 { << true }
    << lib_export_param_ok(t)
}

fn stub_ret_body(ret int) string {
    if ret == 0 { << " { }\n" }
    if ret == 2 { << " { << false }\n" }
    if ret == 3 { << " { << \"\" }\n" }
    if ret == 4 { << " { << 0.0 }\n" }
    if ret == 8 { << " { << i32(0) }\n" }
    if ret == 9 { << " { << u32(0) }\n" }
    if ret == 10 { << " { << u8(0) }\n" }
    << " { << 0 }\n"
}

fn lib_stub_source(i int, objs &[]XuObject) string {
    mut s := "@" + objs[i].module + "\n\n"
    if modulepath.is_external(&objs[i].module) {
        s = "@\"" + objs[i].module + "\"\n\n"
    }
    for ei in 0:objs[i].exports.len {
        s = s + "pub fn " + objs[i].exports[ei].name + "("
        for j in 0:objs[i].exports[ei].params.len {
            if j > 0 { s = s + ", " }
            s = s + "a" + str(j) + " " + ty_name_u8(objs[i].exports[ei].params[j])
        }
        s = s + ")"
        if objs[i].exports[ei].ret != 0 {
            s = s + " " + ty_name_u8(objs[i].exports[ei].ret)
        }
        s = s + stub_ret_body(objs[i].exports[ei].ret)
    }
    << s
}

fn ty_name_u8(t int) string {
    if t == 2 { << "bool" }
    if t == 3 { << "string" }
    if t == 4 { << "f64" }
    if t == 8 { << "i32" }
    if t == 9 { << "u32" }
    if t == 10 { << "u8" }
    << "int"
}

fn xuobj_os_code(os int) int { << os + 1 }
fn xuobj_arch_code(arch int) int { << arch + 1 }

fn (o &XuObject) matches_target(os int, arch int) bool {
    if o.os != xuobj_os_code(os) {
        << false
    }
    if o.arch != xuobj_arch_code(arch) {
        << false
    }
    << true
}

fn (a &Assembler) snapshot_xuobj(module string, exports []XuExport, os int, arch int) XuObject {
    mut o := XuObject{os: xuobj_os_code(os), arch: xuobj_arch_code(arch), module: module, path: "", kind: 0, exports: exports, code: []int{}, data: []int{}, lname: []string{}, loff: []int{}, ldata: []int{}, rkind: []int{}, roff: []int{}, rrd: []int{}, rlab: []string{}, mx_pk: []int{}, mx_po: []int{}, mx_pl: []string{}, mx_sn: []string{}, mx_st: []int{}, mx_ss: []int{}, mx_sd: []int{}, mx_sv: []int{}, mx_tr: []int{}, mx_dr: []int{}, mx_ndef: 0, mx_nund: 0}
    for i in 0:a.code.len {
        o.code.push(a.code[i] & 255)
    }
    for i in 0:a.data.len {
        o.data.push(a.data[i] & 255)
    }
    for i in 0:a.labels.len {
        if lab_off(&a.labels, i) < 0 { -> }
        nm0 := lab_name(&a.labels, i)
        nm := asm_string_copy(&nm0)
        o.lname.push(nm)
        o.loff.push(a.labels[i].offset)
        if a.labels[i].is_data {
            o.ldata.push(1)
        } else {
            o.ldata.push(0)
        }
    }
    for i in 0:a.fixups.len {
        mut rk := fix_kind(&a.fixups, i)
        symbol := arch == 0 && rk >= 6 && rk <= 10
        literal := arch == 0 && rk == 5
        if symbol { rk -= 6 }
        if literal { rk = 4 }
        o.rkind.push(rk)
        o.roff.push(fix_off(&a.fixups, i))
        // ARM64 executable fixups retain only an interned symbol slot;
        // materialise the label at the object-file boundary so XUOBJ keeps
        // its existing relocation ABI.  Other targets retain their legacy
        // string payload.
        mut out_lab := ""
        rd0 := fix_rd(&a.fixups, i)
        // ARM64 hash-token fixups encode `(hash+1)<<5 | rd` in `rd`.
        // The numeric marker is authoritative; consulting a stale/corrupt
        // string length can incorrectly re-enter the borrowed-label path.
        // Legacy raw register fields are <=31, preserving the XUOBJ ABI.
        if arch == 0 && rd0 < 0 && (rk == 1 || rk == 4) {
            // Executable MIR-index fixups also occur in --emit-obj/native
            // builds. Convert the private index to its ordinary symbol.
            mut fi := 0 - rd0 - 1
            mut reg := 0
            if rk == 4 {
                token := 0 - rd0 - 1
                fi = token / 32 - 1
                reg = token & 31
            }
            if fi < 0 || fi >= a.lib_exp_off.len {
                eprintln("xuobj: invalid function-index relocation")
                <<< 1
            }
            target := a.lib_exp_off[fi]
            for li in 0:a.labels.len {
                is_data := lab_is_data(&a.labels, li)
                if !is_data && lab_off(&a.labels, li) == target {
                    name := lab_name(&a.labels, li)
                    if starts_with(name + "", "_xu_") {
                        out_lab = asm_string_copy(&name)
                        <-
                    }
                }
            }
            if out_lab.len == 0 {
                eprintln("xuobj: function-index relocation has no symbol")
                <<< 1
            }
            o.rrd.push(reg)
        } else if literal {
            // Literal intern IDs are local to the emitting MIR. Export the
            // ordinary data-symbol relocation instead of the private token.
            out_lab = "_xus_" + str(rd0 >> 5)
            o.rrd.push(rd0 & 31)
        } else if symbol {
            sym := (rd0 >> 5) - 1
            nm := lab_name(&a.labels, sym)
            out_lab = asm_string_copy(&nm)
            o.rrd.push(rd0 & 31)
        } else if arch == 0 && rd0 >= 32 {
            out_lab = a.label_name_hash((rd0 >> 5) - 1)
            o.rrd.push(rd0 & 31)
        } else {
            out_lab = fix_label(&a.fixups, i)
            o.rrd.push(rd0)
        }
        o.rlab.push(out_lab)
    }
    << o
}
