@main
// x86_64 instruction encoder (M12). Same label/fixup protocol as arm64.
// Ported from bootstrap/crates/xuasm/src/x64.rs (subset used by xuemit/xurt).
//
// Fixup kinds when arch == x64 (Assembler.arch = 1):
//   0 = Rel32  (JMP/CALL/Jcc displacement field)
//   1 = Rip32  (LEA rip-rel / CALL [rip] IAT)
//
// Registers: RAX=0 RCX=1 RDX=2 RBX=3 RSP=4 RBP=5 RSI=6 RDI=7
//            R8=8 R9=9 R10=10 R11=11 R12=12 R13=13 R14=14 R15=15

fn (a &mut Assembler) x64_emit(b int) {
    a.code.push(b & 255)
}

fn (a &mut Assembler) x64_emit32(v int) {
    a.code.push(v & 255)
    a.code.push((v >> 8) & 255)
    a.code.push((v >> 16) & 255)
    a.code.push((v >> 24) & 255)
}

fn (a &mut Assembler) x64_emit64(v int) {
    a.x64_emit32(v)
    a.x64_emit32(v >> 32)
}

fn x64_rex(w int, r int, x int, b int) int {
    << 64 | (w << 3) | (r << 2) | (x << 1) | b
}

fn x64_modrm(md int, reg int, rm int) int {
    << ((md & 3) << 6) | ((reg & 7) << 3) | (rm & 7)
}

fn x64_hi(r int) int {
    if r >= 8 { << 1 }
    << 0
}

fn x64_sib(scale_bits int, index int, base int) int {
    << ((scale_bits & 3) << 6) | ((index & 7) << 3) | (base & 7)
}

fn x64_scale_bits(elem_sz int) int {
    if elem_sz == 2 { << 1 }
    if elem_sz == 4 { << 2 }
    if elem_sz == 8 { << 3 }
    << 0
}

// ==================== Data movement ====================

fn (a &mut Assembler) x64_mov_imm32(rd int, imm int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(rd)))
    a.x64_emit(199) // 0xC7
    a.x64_emit(x64_modrm(3, 0, rd & 7))
    a.x64_emit32(imm)
}

fn (a &mut Assembler) x64_mov_imm64(rd int, imm int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(rd)))
    a.x64_emit(184 + (rd & 7)) // 0xB8+
    a.x64_emit64(imm)
}

fn (a &mut Assembler) x64_mov_imm(rd int, imm int) {
    // i32 range: use short form
    if imm >= -2147483648 && imm <= 2147483647 {
        a.x64_mov_imm32(rd, imm)
        <<
    }
    a.x64_mov_imm64(rd, imm)
}

fn (a &mut Assembler) x64_mov_reg(dst int, src int) {
    a.x64_emit(x64_rex(1, x64_hi(src), 0, x64_hi(dst)))
    a.x64_emit(137) // 0x89
    a.x64_emit(x64_modrm(3, src & 7, dst & 7))
}

fn (a &mut Assembler) x64_mov_reg32(dst int, src int) {
    rex := x64_rex(0, x64_hi(src), 0, x64_hi(dst))
    if rex != 0 { a.x64_emit(rex) }
    a.x64_emit(137) // 0x89
    a.x64_emit(x64_modrm(3, src & 7, dst & 7))
}

fn (a &mut Assembler) x64_mem_operands(reg_field int, base int, offset int) {
    if offset == 0 && (base & 7) != 5 {
        a.x64_emit(x64_modrm(0, reg_field, base & 7))
        if (base & 7) == 4 {
            a.x64_emit(36) // SIB for RSP/R12
        }
        <<
    }
    mut md := 2
    mut disp1 := false
    if offset >= -128 && offset <= 127 {
        md = 1
        disp1 = true
    }
    a.x64_emit(x64_modrm(md, reg_field, base & 7))
    if (base & 7) == 4 {
        a.x64_emit(36)
    }
    if disp1 {
        a.x64_emit(offset & 255)
    } else {
        a.x64_emit32(offset)
    }
}

fn (a &mut Assembler) x64_mem_sib_operands(reg_field int, base int, index int, scale_bits int, offset int) {
    if offset == 0 && (base & 7) != 5 {
        a.x64_emit(x64_modrm(0, reg_field, 4))
        a.x64_emit(x64_sib(scale_bits, index, base))
        <<
    }
    mut md := 2
    mut disp1 := false
    if offset >= -128 && offset <= 127 {
        md = 1
        disp1 = true
    }
    a.x64_emit(x64_modrm(md, reg_field, 4))
    a.x64_emit(x64_sib(scale_bits, index, base))
    if disp1 {
        a.x64_emit(offset & 255)
    } else {
        a.x64_emit32(offset)
    }
}

fn (a &mut Assembler) x64_load_offset(dst int, base int, offset int) {
    a.x64_emit(x64_rex(1, x64_hi(dst), 0, x64_hi(base)))
    a.x64_emit(139) // 0x8B
    a.x64_mem_operands(dst, base, offset)
}

fn (a &mut Assembler) x64_store_offset(base int, offset int, src int) {
    a.x64_emit(x64_rex(1, x64_hi(src), 0, x64_hi(base)))
    a.x64_emit(137) // 0x89
    a.x64_mem_operands(src, base, offset)
}

fn (a &mut Assembler) x64_load_sib(dst int, base int, index int, scale_bits int, offset int) {
    a.x64_emit(x64_rex(1, x64_hi(dst), x64_hi(index), x64_hi(base)))
    a.x64_emit(139) // 0x8B
    a.x64_mem_sib_operands(dst, base, index, scale_bits, offset)
}

fn (a &mut Assembler) x64_store_sib(base int, index int, src int, scale_bits int, offset int) {
    a.x64_emit(x64_rex(1, x64_hi(src), x64_hi(index), x64_hi(base)))
    a.x64_emit(137) // 0x89
    a.x64_mem_sib_operands(src, base, index, scale_bits, offset)
}

fn (a &mut Assembler) x64_load_byte_sib(dst int, base int, index int, scale_bits int, offset int) {
    a.x64_emit(x64_rex(1, x64_hi(dst), x64_hi(index), x64_hi(base)))
    a.x64_emit(15)
    a.x64_emit(182) // 0xB6
    a.x64_mem_sib_operands(dst, base, index, scale_bits, offset)
}

fn (a &mut Assembler) x64_store_byte_sib(base int, index int, src int, scale_bits int, offset int) {
    if src >= 4 || base >= 8 || index >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(src), x64_hi(index), x64_hi(base)))
    }
    a.x64_emit(136) // 0x88
    a.x64_mem_sib_operands(src, base, index, scale_bits, offset)
}

fn (a &mut Assembler) x64_load_byte_offset(dst int, base int, offset int) {
    a.x64_emit(x64_rex(1, x64_hi(dst), 0, x64_hi(base)))
    a.x64_emit(15) // 0x0F
    a.x64_emit(182) // 0xB6
    a.x64_mem_operands(dst, base, offset)
}

fn (a &mut Assembler) x64_store_byte_offset(base int, offset int, src int) {
    if src >= 4 || base >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(src), 0, x64_hi(base)))
    }
    a.x64_emit(136) // 0x88
    a.x64_mem_operands(src, base, offset)
}

// LEA dst, [rip + disp32(label)]
fn (a &mut Assembler) x64_lea_rip_rel(dst int, label string) {
    a.x64_emit(x64_rex(1, x64_hi(dst), 0, 0))
    a.x64_emit(141) // 0x8D
    a.x64_emit(x64_modrm(0, dst & 7, 5))
    a.push_fixup(1, label, 0) // Rip32
    a.x64_emit32(0)
}

// ==================== Floating point (XMM; M13) ====================

// MOVQ xmm, r64: 66 REX.W 0F 6E /r
fn (a &mut Assembler) x64_movq_xmm_from_r(xmm int, r int) {
    a.x64_emit(102) // 0x66
    a.x64_emit(x64_rex(1, x64_hi(xmm), 0, x64_hi(r)))
    a.x64_emit(15)
    a.x64_emit(110) // 0x6E
    a.x64_emit(x64_modrm(3, xmm & 7, r & 7))
}

// MOVQ r64, xmm: 66 REX.W 0F 7E /r
fn (a &mut Assembler) x64_movq_r_from_xmm(r int, xmm int) {
    a.x64_emit(102)
    a.x64_emit(x64_rex(1, x64_hi(xmm), 0, x64_hi(r)))
    a.x64_emit(15)
    a.x64_emit(126) // 0x7E
    a.x64_emit(x64_modrm(3, xmm & 7, r & 7))
}

// ADDSD xmm1, xmm2: F2 0F 58 /r
fn (a &mut Assembler) x64_addsd(dst int, src int) {
    a.x64_emit(242) // 0xF2
    if dst >= 8 || src >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(dst), 0, x64_hi(src)))
    }
    a.x64_emit(15)
    a.x64_emit(88) // 0x58
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

fn (a &mut Assembler) x64_subsd(dst int, src int) {
    a.x64_emit(242)
    if dst >= 8 || src >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(dst), 0, x64_hi(src)))
    }
    a.x64_emit(15)
    a.x64_emit(92) // 0x5C
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

fn (a &mut Assembler) x64_mulsd(dst int, src int) {
    a.x64_emit(242)
    if dst >= 8 || src >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(dst), 0, x64_hi(src)))
    }
    a.x64_emit(15)
    a.x64_emit(89) // 0x59
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

fn (a &mut Assembler) x64_divsd(dst int, src int) {
    a.x64_emit(242)
    if dst >= 8 || src >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(dst), 0, x64_hi(src)))
    }
    a.x64_emit(15)
    a.x64_emit(94) // 0x5E
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

// SQRTSD xmm1, xmm2: F2 0F 51 /r
fn (a &mut Assembler) x64_sqrtsd(dst int, src int) {
    a.x64_emit(242)
    if dst >= 8 || src >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(dst), 0, x64_hi(src)))
    }
    a.x64_emit(15)
    a.x64_emit(81) // 0x51
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

// ROUNDSD xmm1, xmm2, imm8: 66 0F 3A 0B /r ib
fn (a &mut Assembler) x64_roundsd(dst int, src int, mode int) {
    a.x64_emit(102) // 0x66
    if dst >= 8 || src >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(dst), 0, x64_hi(src)))
    }
    a.x64_emit(15)  // 0x0F
    a.x64_emit(58)  // 0x3A
    a.x64_emit(11)  // 0x0B
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
    a.x64_emit(mode & 255)
}

// UCOMISD xmm1, xmm2: 66 0F 2E /r
fn (a &mut Assembler) x64_ucomisd(x int, y int) {
    a.x64_emit(102)
    if x >= 8 || y >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(x), 0, x64_hi(y)))
    }
    a.x64_emit(15)
    a.x64_emit(46) // 0x2E
    a.x64_emit(x64_modrm(3, x & 7, y & 7))
}

// CVTSI2SD xmm, r64: F2 REX.W 0F 2a /r
fn (a &mut Assembler) x64_cvtsi2sd(xmm int, r int) {
    a.x64_emit(242)
    a.x64_emit(x64_rex(1, x64_hi(xmm), 0, x64_hi(r)))
    a.x64_emit(15)
    a.x64_emit(42) // 0x2A
    a.x64_emit(x64_modrm(3, xmm & 7, r & 7))
}

// CVTTSD2SI r64, xmm: F2 REX.W 0F 2C /r
fn (a &mut Assembler) x64_cvttsd2si(r int, xmm int) {
    a.x64_emit(242)
    a.x64_emit(x64_rex(1, x64_hi(r), 0, x64_hi(xmm)))
    a.x64_emit(15)
    a.x64_emit(44) // 0x2C
    a.x64_emit(x64_modrm(3, r & 7, xmm & 7))
}

// MOVSD xmm, [base+off]: F2 [REX] 0F 10 /r
fn (a &mut Assembler) x64_movsd_load(xmm int, base int, offset int) {
    a.x64_emit(242)
    if xmm >= 8 || base >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(xmm), 0, x64_hi(base)))
    }
    a.x64_emit(15)
    a.x64_emit(16)
    a.x64_mem_operands(xmm, base, offset)
}

// MOVSD [base+off], xmm: F2 [REX] 0F 11 /r
fn (a &mut Assembler) x64_movsd_store(base int, offset int, xmm int) {
    a.x64_emit(242)
    if xmm >= 8 || base >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(xmm), 0, x64_hi(base)))
    }
    a.x64_emit(15)
    a.x64_emit(17)
    a.x64_mem_operands(xmm, base, offset)
}

// MOVSD xmm1, xmm2: F2 [REX] 0F 10 /r
fn (a &mut Assembler) x64_movsd_reg(dst int, src int) {
    a.x64_emit(242)
    if dst >= 8 || src >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(dst), 0, x64_hi(src)))
    }
    a.x64_emit(15)
    a.x64_emit(16)
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

// ==================== Arithmetic ====================

fn (a &mut Assembler) x64_add_reg(dst int, src int) {
    a.x64_emit(x64_rex(1, x64_hi(src), 0, x64_hi(dst)))
    a.x64_emit(1) // 0x01
    a.x64_emit(x64_modrm(3, src & 7, dst & 7))
}

fn (a &mut Assembler) x64_add_reg32(dst int, src int) {
    rex := x64_rex(0, x64_hi(src), 0, x64_hi(dst))
    if rex != 0 { a.x64_emit(rex) }
    a.x64_emit(1) // 0x01
    a.x64_emit(x64_modrm(3, src & 7, dst & 7))
}

fn (a &mut Assembler) x64_add_imm(dst int, imm int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(dst)))
    if imm >= -128 && imm <= 127 {
        a.x64_emit(131) // 0x83
        a.x64_emit(x64_modrm(3, 0, dst & 7))
        a.x64_emit(imm & 255)
    } else {
        a.x64_emit(129) // 0x81
        a.x64_emit(x64_modrm(3, 0, dst & 7))
        a.x64_emit32(imm)
    }
}

fn (a &mut Assembler) x64_sub_reg(dst int, src int) {
    a.x64_emit(x64_rex(1, x64_hi(src), 0, x64_hi(dst)))
    a.x64_emit(41) // 0x29
    a.x64_emit(x64_modrm(3, src & 7, dst & 7))
}

fn (a &mut Assembler) x64_sub_imm(dst int, imm int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(dst)))
    if imm >= -128 && imm <= 127 {
        a.x64_emit(131)
        a.x64_emit(x64_modrm(3, 5, dst & 7))
        a.x64_emit(imm & 255)
    } else {
        a.x64_emit(129)
        a.x64_emit(x64_modrm(3, 5, dst & 7))
        a.x64_emit32(imm)
    }
}

fn (a &mut Assembler) x64_imul(dst int, src int) {
    a.x64_emit(x64_rex(1, x64_hi(dst), 0, x64_hi(src)))
    a.x64_emit(15)
    a.x64_emit(175) // 0xAF
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

// ADD qword [base+offset], src. The scalar prefix owns the proved span.
fn (a &mut Assembler) x64_add_mem_reg(base int, offset int, src int) {
    a.x64_emit(x64_rex(1, x64_hi(src), 0, x64_hi(base)))
    a.x64_emit(1)
    a.x64_mem_operands(src, base, offset)
}

fn (a &mut Assembler) x64_cqo() {
    a.x64_emit(x64_rex(1, 0, 0, 0))
    a.x64_emit(153) // 0x99
}

fn (a &mut Assembler) x64_idiv(src int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(src)))
    a.x64_emit(247) // 0xF7
    a.x64_emit(x64_modrm(3, 7, src & 7))
}

fn (a &mut Assembler) x64_mul(src int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(src)))
    a.x64_emit(247) // 0xF7
    a.x64_emit(x64_modrm(3, 4, src & 7))
}

fn (a &mut Assembler) x64_neg_reg(reg int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(reg)))
    a.x64_emit(247)
    a.x64_emit(x64_modrm(3, 3, reg & 7))
}

fn (a &mut Assembler) x64_and_reg(dst int, src int) {
    a.x64_emit(x64_rex(1, x64_hi(src), 0, x64_hi(dst)))
    a.x64_emit(33) // 0x21
    a.x64_emit(x64_modrm(3, src & 7, dst & 7))
}

fn (a &mut Assembler) x64_or_reg(dst int, src int) {
    a.x64_emit(x64_rex(1, x64_hi(src), 0, x64_hi(dst)))
    a.x64_emit(9) // 0x09
    a.x64_emit(x64_modrm(3, src & 7, dst & 7))
}

fn (a &mut Assembler) x64_xor_reg(dst int, src int) {
    a.x64_emit(x64_rex(1, x64_hi(src), 0, x64_hi(dst)))
    a.x64_emit(49) // 0x31
    a.x64_emit(x64_modrm(3, src & 7, dst & 7))
}

fn (a &mut Assembler) x64_xor_imm(dst int, imm int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(dst)))
    if imm >= -128 && imm <= 127 {
        a.x64_emit(131) // 0x83 /6
        a.x64_emit(x64_modrm(3, 6, dst & 7))
        a.x64_emit(imm & 255)
    } else {
        a.x64_emit(129) // 0x81 /6
        a.x64_emit(x64_modrm(3, 6, dst & 7))
        a.x64_emit32(imm)
    }
}

fn (a &mut Assembler) x64_and_imm(dst int, imm int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(dst)))
    if imm >= -128 && imm <= 127 {
        a.x64_emit(131) // 0x83 /4
        a.x64_emit(x64_modrm(3, 4, dst & 7))
        a.x64_emit(imm & 255)
    } else {
        a.x64_emit(129) // 0x81 /4
        a.x64_emit(x64_modrm(3, 4, dst & 7))
        a.x64_emit32(imm)
    }
}

// BSR dst,src. The caller initializes dst to define the zero-input result.
fn (a &mut Assembler) x64_bsr(dst int, src int) {
    a.x64_emit(x64_rex(1, x64_hi(dst), 0, x64_hi(src)))
    a.x64_emit(15)
    a.x64_emit(189) // 0xBD
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

// TZCNT on BMI1 CPUs, REP BSF on older CPUs. Initializing dst to 64 makes
// both interpretations return 64 for zero.
fn (a &mut Assembler) x64_tzcnt_compat(dst int, src int) {
    a.x64_emit(243) // 0xF3
    a.x64_emit(x64_rex(1, x64_hi(dst), 0, x64_hi(src)))
    a.x64_emit(15)
    a.x64_emit(188) // 0xBC
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

fn (a &mut Assembler) x64_bswap(reg int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(reg)))
    a.x64_emit(15)
    a.x64_emit(200 + (reg & 7)) // 0xC8+
}

fn (a &mut Assembler) x64_popcnt(dst int, src int) {
    a.x64_emit(243) // F3
    a.x64_emit(x64_rex(1, x64_hi(dst), 0, x64_hi(src)))
    a.x64_emit(15)
    a.x64_emit(184) // 0F B8 /r
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

fn (a &mut Assembler) x64_ror_imm64(dst int, imm int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(dst)))
    a.x64_emit(193) // C1 /1 ib
    a.x64_emit(x64_modrm(3, 1, dst & 7))
    a.x64_emit(imm & 63)
}

fn (a &mut Assembler) x64_rol_cl(dst int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(dst)))
    a.x64_emit(211) // 0xD3 /0
    a.x64_emit(x64_modrm(3, 0, dst & 7))
}

fn (a &mut Assembler) x64_ror_cl(dst int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(dst)))
    a.x64_emit(211) // 0xD3 /1
    a.x64_emit(x64_modrm(3, 1, dst & 7))
}

fn (a &mut Assembler) x64_ror_imm32(dst int, imm int) {
    if x64_hi(dst) != 0 {
        a.x64_emit(x64_rex(0, 0, 0, 1))
    }
    if imm == 1 {
        a.x64_emit(209) // 0xD1
        a.x64_emit(x64_modrm(3, 1, dst & 7))
    } else {
        a.x64_emit(193) // 0xC1
        a.x64_emit(x64_modrm(3, 1, dst & 7))
        a.x64_emit(imm & 31)
    }
}

fn (a &mut Assembler) x64_shr_imm32(dst int, imm int) {
    if x64_hi(dst) != 0 {
        a.x64_emit(x64_rex(0, 0, 0, 1))
    }
    if imm == 1 {
        a.x64_emit(209)
        a.x64_emit(x64_modrm(3, 5, dst & 7))
    } else {
        a.x64_emit(193)
        a.x64_emit(x64_modrm(3, 5, dst & 7))
        a.x64_emit(imm & 31)
    }
}

fn (a &mut Assembler) x64_not32(dst int) {
    if x64_hi(dst) != 0 {
        a.x64_emit(x64_rex(0, 0, 0, 1))
    }
    a.x64_emit(247)
    a.x64_emit(x64_modrm(3, 2, dst & 7))
}

fn (a &mut Assembler) x64_shl_cl(dst int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(dst)))
    a.x64_emit(211) // 0xD3
    a.x64_emit(x64_modrm(3, 4, dst & 7))
}

fn (a &mut Assembler) x64_sar_cl(dst int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(dst)))
    a.x64_emit(211)
    a.x64_emit(x64_modrm(3, 7, dst & 7))
}

fn (a &mut Assembler) x64_sar_imm(dst int, imm int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(dst)))
    if imm == 1 {
        a.x64_emit(209) // 0xD1
        a.x64_emit(x64_modrm(3, 7, dst & 7))
    } else {
        a.x64_emit(193) // 0xC1
        a.x64_emit(x64_modrm(3, 7, dst & 7))
        a.x64_emit(imm & 63)
    }
}

fn (a &mut Assembler) x64_shl_imm(dst int, imm int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(dst)))
    if imm == 1 {
        a.x64_emit(209) // 0xD1
        a.x64_emit(x64_modrm(3, 4, dst & 7))
    } else {
        a.x64_emit(193) // 0xC1
        a.x64_emit(x64_modrm(3, 4, dst & 7))
        a.x64_emit(imm & 63)
    }
}

fn (a &mut Assembler) x64_shr_imm(dst int, imm int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(dst)))
    if imm == 1 {
        a.x64_emit(209)
        a.x64_emit(x64_modrm(3, 5, dst & 7))
    } else {
        a.x64_emit(193)
        a.x64_emit(x64_modrm(3, 5, dst & 7))
        a.x64_emit(imm & 63)
    }
}

// ==================== Compare ====================

fn (a &mut Assembler) x64_cmp_reg(dst int, src int) {
    a.x64_emit(x64_rex(1, x64_hi(src), 0, x64_hi(dst)))
    a.x64_emit(57) // 0x39
    a.x64_emit(x64_modrm(3, src & 7, dst & 7))
}

fn (a &mut Assembler) x64_cmp_imm(dst int, imm int) {
    a.x64_emit(x64_rex(1, 0, 0, x64_hi(dst)))
    if imm >= -128 && imm <= 127 {
        a.x64_emit(131)
        a.x64_emit(x64_modrm(3, 7, dst & 7))
        a.x64_emit(imm & 255)
    } else {
        a.x64_emit(129)
        a.x64_emit(x64_modrm(3, 7, dst & 7))
        a.x64_emit32(imm)
    }
}

fn (a &mut Assembler) x64_test_reg(dst int, src int) {
    a.x64_emit(x64_rex(1, x64_hi(src), 0, x64_hi(dst)))
    a.x64_emit(133) // 0x85
    a.x64_emit(x64_modrm(3, src & 7, dst & 7))
}

// SETcc + MOVZX. cc = low nibble (0x4=E, 0x5=NE, 0xC=L, 0xE=LE, 0xF=G, 0xD=GE, 0x3=AE).
fn (a &mut Assembler) x64_setcc(rd int, cc int) {
    a.x64_emit(x64_rex(0, 0, 0, x64_hi(rd)))
    a.x64_emit(15)
    a.x64_emit(144 | (cc & 15)) // 0x90|cc
    a.x64_emit(x64_modrm(3, 0, rd & 7))
    a.x64_emit(x64_rex(1, x64_hi(rd), 0, x64_hi(rd)))
    a.x64_emit(15)
    a.x64_emit(182)
    a.x64_emit(x64_modrm(3, rd & 7, rd & 7))
}

// CMOVcc r64, r64.  Flags are preserved, which lets CFG if-conversion update
// several loop-carried values from one compare.
fn (a &mut Assembler) x64_cmovcc(dst int, src int, cc int) {
    a.x64_emit(x64_rex(1, x64_hi(dst), 0, x64_hi(src)))
    a.x64_emit(15)
    a.x64_emit(64 | (cc & 15))
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

fn (a &mut Assembler) x64_lea_offset(dst int, base int, offset int) {
    a.x64_emit(x64_rex(1, x64_hi(dst), 0, x64_hi(base)))
    a.x64_emit(141)
    a.x64_mem_operands(dst, base, offset)
}

// ==================== Branches ====================

fn (a &mut Assembler) x64_rel32_fixup(label string) {
    a.push_fixup(0, label, 0) // Rel32
    a.x64_emit32(0)
}

fn (a &mut Assembler) x64_jmp(label string) {
    a.x64_emit(233) // 0xE9
    a.x64_rel32_fixup(label)
}

fn (a &mut Assembler) x64_call(label string) {
    a.x64_emit(232) // 0xE8
    a.x64_rel32_fixup(label)
}

// CALL r/m64 (indirect). reg is physical 0..15.
fn (a &mut Assembler) x64_call_reg(reg int) {
    if reg >= 8 {
        a.x64_emit(65) // REX.B 0x41
    }
    a.x64_emit(255) // 0xFF
    a.x64_emit(208 | (reg & 7)) // modrm: mod=11 reg=2 rm=reg  → 0xD0|rm
}

fn (a &mut Assembler) x64_jcc(cc int, label string) {
    a.x64_emit(15)
    a.x64_emit(128 | (cc & 15)) // 0x80|cc
    a.x64_rel32_fixup(label)
}

fn (a &mut Assembler) x64_ret() { a.x64_emit(195) } // 0xC3
fn (a &mut Assembler) x64_nop() { a.x64_emit(144) } // 0x90

// ENDBR64 (F3 0F 1E FA). NOP on CPUs without CET; required IBT landing pad.
fn (a &mut Assembler) x64_endbr() {
    a.x64_emit(243)
    a.x64_emit(15)
    a.x64_emit(30)
    a.x64_emit(250)
}

fn (a &mut Assembler) x64_push(reg int) {
    if reg >= 8 {
        a.x64_emit(x64_rex(0, 0, 0, 1))
    }
    a.x64_emit(80 + (reg & 7))
}

fn (a &mut Assembler) x64_pop(reg int) {
    if reg >= 8 {
        a.x64_emit(x64_rex(0, 0, 0, 1))
    }
    a.x64_emit(88 + (reg & 7))
}

fn (a &mut Assembler) x64_syscall() {
    a.x64_emit(15)
    a.x64_emit(5)
}

// XCHG [base], reg — implicit LOCK.
fn (a &mut Assembler) x64_xchg_mem(reg int, base int) {
    a.x64_emit(x64_rex(1, x64_hi(reg), 0, x64_hi(base)))
    a.x64_emit(135) // 0x87
    a.x64_mem_operands(reg, base, 0)
}

// LOCK XADD [base], reg — F0 REX.W 0F c1 /r. reg = old value afterwards.
fn (a &mut Assembler) x64_xadd_mem(reg int, base int) {
    a.x64_emit(240) // 0xF0 lock
    a.x64_emit(x64_rex(1, x64_hi(reg), 0, x64_hi(base)))
    a.x64_emit(15)
    a.x64_emit(193) // 0xC1
    a.x64_mem_operands(reg, base, 0)
}

// LOCK CMPXCHG [base], reg — F0 REX.W 0F B1 /r. Compares RAX with [base].
fn (a &mut Assembler) x64_cmpxchg_mem(reg int, base int) {
    a.x64_emit(240) // 0xF0 lock
    a.x64_emit(x64_rex(1, x64_hi(reg), 0, x64_hi(base)))
    a.x64_emit(15)
    a.x64_emit(177) // 0xB1
    a.x64_mem_operands(reg, base, 0)
}

// CALL qword [rip + disp32(label)] — IAT import (FF 15).
fn (a &mut Assembler) x64_call_iat_raw(label string) {
    a.x64_emit(255) // 0xFF
    a.x64_emit(21) // 0x15
    a.push_fixup(1, label, 0) // Rip32
    a.x64_emit32(0)
}

// ==================== Fixups ====================

fn (a &mut Assembler) x64_fixup_all() {
    for i in 0:a.fixups.len {
        kind := a.fixups[i].kind
        offset := a.fixups[i].offset
        mut target_addr := 0
        sym := a.fixups[i].rd
        if sym >= 0 && sym < a.labels.len && lab_off(&a.labels, sym) >= 0 {
            target_addr = a.label_addr_symbol(sym)
        } else {
            lbl := a.fixups[i].label
            target_addr = a.label_addr(lbl)
        }
        field_addr := a.code_vaddr + offset
        rel := target_addr - (field_addr + 4)
        // kind is unused for patch (both Rel32 and Rip32 use same disp formula)
        a.code[offset] = rel & 255
        a.code[offset + 1] = (rel >> 8) & 255
        a.code[offset + 2] = (rel >> 16) & 255
        a.code[offset + 3] = (rel >> 24) & 255
        // silence unused
        if kind < 0 { a.x64_nop() }
    }
}

// ==================== AES-NI & SSE 128-bit ====================

// CPUID: 0F A2
fn (a &mut Assembler) x64_cpuid() {
    a.x64_emit(15)  // 0x0F
    a.x64_emit(162) // 0xA2
}

// PXOR xmm1, xmm2: 66 [REX] 0F EF /r
fn (a &mut Assembler) x64_pxor(dst int, src int) {
    a.x64_emit(102) // 0x66
    if dst >= 8 || src >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(dst), 0, x64_hi(src)))
    }
    a.x64_emit(15)  // 0x0F
    a.x64_emit(239) // 0xEF
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

// AESENC xmm1, xmm2: 66 [REX] 0F 38 DC /r
fn (a &mut Assembler) x64_aesenc(dst int, src int) {
    a.x64_emit(102) // 0x66
    if dst >= 8 || src >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(dst), 0, x64_hi(src)))
    }
    a.x64_emit(15)  // 0x0F
    a.x64_emit(56)  // 0x38
    a.x64_emit(220) // 0xDC
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

// AESENCLAST xmm1, xmm2: 66 [REX] 0F 38 DD /r
fn (a &mut Assembler) x64_aesenclast(dst int, src int) {
    a.x64_emit(102) // 0x66
    if dst >= 8 || src >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(dst), 0, x64_hi(src)))
    }
    a.x64_emit(15)  // 0x0F
    a.x64_emit(56)  // 0x38
    a.x64_emit(221) // 0xDD
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

// AESDEC xmm1, xmm2: 66 [REX] 0F 38 DE /r
fn (a &mut Assembler) x64_aesdec(dst int, src int) {
    a.x64_emit(102) // 0x66
    if dst >= 8 || src >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(dst), 0, x64_hi(src)))
    }
    a.x64_emit(15)  // 0x0F
    a.x64_emit(56)  // 0x38
    a.x64_emit(222) // 0xDE
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

// AESDECLAST xmm1, xmm2: 66 [REX] 0F 38 DF /r
fn (a &mut Assembler) x64_aesdeclast(dst int, src int) {
    a.x64_emit(102) // 0x66
    if dst >= 8 || src >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(dst), 0, x64_hi(src)))
    }
    a.x64_emit(15)  // 0x0F
    a.x64_emit(56)  // 0x38
    a.x64_emit(223) // 0xDF
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

// MOVDQU xmm, [base+offset]: F3 [REX] 0F 6F /r
fn (a &mut Assembler) x64_movdqu_load(xmm int, base int, offset int) {
    a.x64_emit(243) // 0xF3
    if xmm >= 8 || base >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(xmm), 0, x64_hi(base)))
    }
    a.x64_emit(15)  // 0x0F
    a.x64_emit(111) // 0x6F
    a.x64_mem_operands(xmm, base, offset)
}

// MOVDQU [base+offset], xmm: F3 [REX] 0F 7F /r
fn (a &mut Assembler) x64_movdqu_store(base int, offset int, xmm int) {
    a.x64_emit(243) // 0xF3
    if xmm >= 8 || base >= 8 {
        a.x64_emit(x64_rex(0, x64_hi(xmm), 0, x64_hi(base)))
    }
    a.x64_emit(15)  // 0x0F
    a.x64_emit(127) // 0x7F
    a.x64_mem_operands(xmm, base, offset)
}

// SSE2 packed integer operations. All x64 targets have SSE2; prefix users
// use volatile XMM homes: xmm0-xmm5 on Windows, xmm0-xmm15 on System V.
fn (a &mut Assembler) x64_packed_reg(op int, dst int, src int) {
    a.x64_emit(102)
    if dst >= 8 || src >= 8 { a.x64_emit(x64_rex(0, x64_hi(dst), 0, x64_hi(src))) }
    a.x64_emit(15)
    a.x64_emit(op)
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

fn (a &mut Assembler) x64_psrldq(dst int, bytes int) {
    a.x64_emit(102)
    if dst >= 8 { a.x64_emit(x64_rex(0, 0, 0, 1)) }
    a.x64_emit(15)
    a.x64_emit(115)
    a.x64_emit(x64_modrm(3, 3, dst & 7))
    a.x64_emit(bytes & 255)
}

// CRC32 r64, r64: F2 REX.W 0F 38 F1 /r
fn (a &mut Assembler) x64_crc32q(dst int, src int) {
    a.x64_emit(242) // 0xF2
    a.x64_emit(x64_rex(1, x64_hi(dst), 0, x64_hi(src)))
    a.x64_emit(15)  // 0x0F
    a.x64_emit(56)  // 0x38
    a.x64_emit(241) // 0xF1
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}

// CRC32 r32, r8: F2 [REX] 0F 38 F0 /r
fn (a &mut Assembler) x64_crc32b(dst int, src int) {
    a.x64_emit(242) // 0xF2
    if dst >= 8 || src >= 4 {
        a.x64_emit(x64_rex(0, x64_hi(dst), 0, x64_hi(src)))
    }
    a.x64_emit(15)  // 0x0F
    a.x64_emit(56)  // 0x38
    a.x64_emit(240) // 0xF0
    a.x64_emit(x64_modrm(3, dst & 7, src & 7))
}
