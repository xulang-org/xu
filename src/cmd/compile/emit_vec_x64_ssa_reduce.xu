@main

#xu/types

// Promotion destroys a reduction's Phi nodes into a separate Copy backedge.
// Match that complete cycle without tracing a feedback Copy as a definition
// available before entry. The prefix leaves ordinary iterations to define
// every body result and execute the original edge copies and exit.
fn match_x64_ssa_iand(m &types.Mir, fi int, bi int) VecPat {
    if types.mir_btkind(m, fi, bi) != 2 { << vec_none() }
    edge := types.mir_btb(m, fi, bi)
    nb := types.mir_nblocks(m, fi)
    if edge < 0 || edge >= nb || edge == bi { << vec_none() }
    if types.mir_btkind(m, fi, edge) != 1 || types.mir_bta(m, fi, edge) != bi { << vec_none() }
    cmp := x64_loop_def(m, fi, bi, types.mir_bta(m, fi, bi))
    if cmp < 0 || cmp != types.mir_btail(m, fi, bi) { << vec_none() }
    if types.mir_ikind(m, fi, cmp) != types.MI_BIN || types.mir_ib(m, fi, cmp) != 8 { << vec_none() }
    bound := types.mir_id(m, fi, cmp)
    if !vec_has_const(m, fi, bound) || vec_const(m, fi, bound) < 2 { << vec_none() }
    next := types.mir_ic(m, fi, cmp)
    inc := x64_loop_def(m, fi, bi, next)
    if inc < 0 || types.mir_ikind(m, fi, inc) != types.MI_BIN || types.mir_ib(m, fi, inc) != 1 { << vec_none() }
    mut ind := -1
    if vec_is_const1(m, fi, types.mir_id(m, fi, inc)) { ind = types.mir_ic(m, fi, inc) }
    else if vec_is_const1(m, fi, types.mir_ic(m, fi, inc)) { ind = types.mir_id(m, fi, inc) }
    if ind < 0 || x64_loop_def(m, fi, bi, ind) >= 0 { << vec_none() }
    mut mask := -1
    mut mul := -1
    mut add := -1
    mut count := 0
    mut ii := types.mir_bhead(m, fi, bi)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == types.MI_BIN {
            count += 1
            if types.mir_ib(m, fi, ii) == 14 {
                if mask >= 0 { << vec_none() }
                mask = ii
            } else if types.mir_ib(m, fi, ii) == 3 {
                if mul >= 0 { << vec_none() }
                mul = ii
            } else if ii != inc && ii != cmp {
                if add >= 0 || types.mir_ib(m, fi, ii) != 1 { << vec_none() }
                add = ii
            }
        } else if k != types.MI_NOP { << vec_none() }
        ii = types.mir_inext(m, fi, ii)
    }
    mut want := 4
    if mul >= 0 { want = 5 }
    if count != want || mask < 0 || add < 0 { << vec_none() }
    if !x64_loop_after(m, fi, bi, mask, add) || !x64_loop_after(m, fi, bi, add, inc) || !x64_loop_after(m, fi, bi, inc, cmp) { << vec_none() }
    mc := types.mir_ic(m, fi, mask)
    md := types.mir_id(m, fi, mask)
    mut input := ind
    mut factor := -1
    if mul >= 0 {
        if !x64_loop_after(m, fi, bi, mul, mask) { << vec_none() }
        lc := types.mir_ic(m, fi, mul)
        ld := types.mir_id(m, fi, mul)
        if lc == ind { factor = ld }
        else if ld == ind { factor = lc }
        if factor < 0 || factor == ind || x64_loop_def(m, fi, bi, factor) >= 0 { << vec_none() }
        if types.mir_temp_ty(m, fi, factor) != 1 || types.mir_temp_nslots(m, fi, factor) != 1 { << vec_none() }
        input = types.mir_ia(m, fi, mul)
        if input < 0 || types.mir_temp_ty(m, fi, input) != 1 || types.mir_temp_nslots(m, fi, input) != 1 { << vec_none() }
    }
    mut constant := -1
    if mc == input && vec_has_const(m, fi, md) { constant = md }
    else if md == input && vec_has_const(m, fi, mc) { constant = mc }
    if constant > 0 - 2 { << vec_none() }
    masked := types.mir_ia(m, fi, mask)
    sum := types.mir_ia(m, fi, add)
    mut acc := -1
    if types.mir_ic(m, fi, add) == masked { acc = types.mir_id(m, fi, add) }
    else if types.mir_id(m, fi, add) == masked { acc = types.mir_ic(m, fi, add) }
    if acc < 0 || x64_loop_def(m, fi, bi, acc) >= 0 { << vec_none() }
    // The only edge writes below are ind and acc, so this proves the
    // multiplication factor remains invariant across every accelerated trip.
    if factor == acc { << vec_none() }
    values := [ind, acc, masked, sum, next]
    for i in 0:values.len {
        t := values[i]
        if t < 0 || t >= types.mir_ntemps(m, fi) { << vec_none() }
        if types.mir_temp_ty(m, fi, t) != 1 || types.mir_temp_nslots(m, fi, t) != 1 { << vec_none() }
        for j in 0:i { if values[j] == t { << vec_none() } }
    }
    // Exactly the two feedback assignments; no hidden edge side effects.
    mut seen := 0
    ii = types.mir_bhead(m, fi, edge)
    for _ in 0:types.mir_nins(m, fi) {
        if ii < 0 { <- }
        k := types.mir_ikind(m, fi, ii)
        if k == types.MI_COPY {
            dst := types.mir_ia(m, fi, ii)
            src := types.mir_ib(m, fi, ii)
            if dst == ind && src == next && (seen & 1) == 0 { seen = seen | 1 }
            else if dst == acc && src == sum && (seen & 2) == 0 { seen = seen | 2 }
            else { << vec_none() }
        } else if k != types.MI_NOP { << vec_none() }
        ii = types.mir_inext(m, fi, ii)
    }
    if seen != 3 { << vec_none() }
    << VecPat{kind: VP_X64_IAND, ind: ind, acc: acc, mask: vec_const(m, fi, constant), limit: vec_const(m, fi, bound), limit_t: -1, else_bb: -1, arr: -1, fac: factor}
}
