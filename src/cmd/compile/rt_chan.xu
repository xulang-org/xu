@main

#xu/types

fn rt_wn_free(a &mut Assembler) {
    a.load(18, 15, -40)
    a.call("_rt_free")
    <<
}

fn rt_emit_chan_new(a &mut Assembler) {
    a.label("_rt_chan_new")
    a.prologue(32)
    a.store(15, -8, 18) // elem_slots
    a.store(15, -16, 19) // cap
    a.vm_cmp_imm(18, 0)
    a.jlt("_rt_chan_new_bad")
    a.vm_cmp_imm(19, 0)
    a.jlt("_rt_chan_new_bad")
    a.mul(0, 18, 19)
    a.vm_cbz(19, "_rt_cn_bytes_ok")
    a.mov(1, 0)
    a.div(1, 0, 19)
    a.cmp(1, 18)
    a.jne("_rt_chan_new_bad")
    a.mov(0, 1)
    a.mul(0, 18, 19)
    a.label("_rt_cn_bytes_ok")
    a.mov(1, 0)
    a.shl_imm(0, 0, 3)
    a.cmp(0, 1)
    a.jae("_rt_cn_size_ok")
    a.jmp("_rt_chan_new_bad")
    a.label("_rt_cn_size_ok")
    a.vm_add_imm(0, 0, 80)
    a.cmp(0, 1)
    a.jae("_rt_cn_alloc_ok")
    a.jmp("_rt_chan_new_bad")
    a.label("_rt_cn_alloc_ok")
    a.mov(18, 0)
    a.call("_rt_alloc")
    a.store(15, -24, 14) // ch
    a.load(0, 15, -24)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, 8, 1)
    a.store(0, 16, 1)
    a.store(0, 24, 1)
    a.store(0, 32, 1)
    a.store(0, 40, 1)
    a.store(0, 48, 1)
    a.store(0, 56, 1)
    a.store(0, 64, 1)
    a.store(0, 72, 1)
    a.load(1, 15, -8)
    a.store(0, 8, 1)
    a.load(1, 15, -16)
    a.store(0, 16, 1)
    a.vm_cmp_imm(1, 0)
    a.jeq("_rt_chan_new_nobuf")
    a.vm_add_imm(1, 0, 80)
    a.store(0, 48, 1)
    a.jmp("_rt_chan_new_done")
    a.label("_rt_chan_new_nobuf")
    a.vm_mov_imm(1, 0)
    a.store(0, 48, 1)
    a.label("_rt_chan_new_done")
    a.mov(14, 0)
    a.epilogue()
    a.label("_rt_chan_new_bad")
    a.jmp("_rt_al_oom")
    <<
}

fn rt_emit_chan_send(a &mut Assembler) {
    a.label("_rt_chan_send")
    a.prologue(48)
    a.store(15, -8, 18) // ch
    a.store(15, -16, 19) // src
    a.store(15, -24, 20) // slots
    a.label("_rt_cs_lock")
    a.load(0, 15, -8)
    a.load(1, 0, 0)
    a.vm_cbnz(1, "_rt_cs_lock")
    a.vm_mov_imm(1, 1)
    a.store(0, 0, 1)
    // closed?
    a.load(1, 0, 56)
    a.vm_cbnz(1, "_rt_cs_closed")
    // wait_head != 0 && head->kind == RECV (2): rendezvous with head waiter
    a.load(1, 0, 64)
    a.vm_cbz(1, "_rt_cs_no_recv")
    a.load(2, 1, 8)
    a.vm_cmp_imm(2, 2)
    a.jne("_rt_cs_no_recv")
    a.load(2, 1, 24) // node.buf = parked recv's dst
    a.store(15, -32, 2)
    a.vm_mov_imm(1, 0)
    a.label("_rt_cs_rv_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_cs_rv_done")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_cs_rv_copy")
    a.label("_rt_cs_rv_done")
    // serve: done=1 (SERVED), head=next, clear tail when queue empties
    a.load(0, 15, -8)
    a.load(1, 0, 64)
    a.vm_mov_imm(2, 1)
    a.store(1, 16, 2)
    a.load(2, 1, 0)
    a.store(0, 64, 2)
    a.vm_cbnz(2, "_rt_cs_pop_keep")
    a.vm_mov_imm(2, 0)
    a.store(0, 72, 2)
    a.label("_rt_cs_pop_keep")
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.epilogue()
    a.label("_rt_cs_no_recv")
    // cap > 0 && len < cap?
    a.load(1, 0, 16)
    a.vm_cmp_imm(1, 0)
    a.jeq("_rt_cs_block")
    a.load(2, 0, 24)
    a.cmp(2, 1)
    a.jge("_rt_cs_block")
    a.load(1, 0, 40)
    a.load(2, 0, 8)
    a.mul(3, 1, 2)
    a.shl_imm(3, 3, 3)
    a.load(4, 0, 48)
    a.add(3, 4, 3)
    a.store(15, -32, 3)
    a.vm_mov_imm(1, 0)
    a.label("_rt_cs_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_cs_copied")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_cs_copy")
    a.label("_rt_cs_copied")
    a.load(0, 15, -8)
    a.load(1, 0, 40)
    a.vm_add_imm(1, 1, 1)
    a.load(2, 0, 16)
    a.cmp(1, 2)
    a.jlt("_rt_cs_tail_ok")
    a.vm_mov_imm(1, 0)
    a.label("_rt_cs_tail_ok")
    a.store(0, 40, 1)
    a.load(1, 0, 24)
    a.vm_add_imm(1, 1, 1)
    a.store(0, 24, 1)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.epilogue()
    a.label("_rt_cs_block")
    // Allocate waiter node (slots*8 + 32 header bytes) and copy the value INTO
    // the node at park time (the greedy/coop frame dies while parked).
    a.load(1, 15, -24)
    a.shl_imm(1, 1, 3)
    a.vm_add_imm(1, 1, 32)
    a.mov(18, 1)
    a.call("_rt_alloc")
    a.store(15, -40, 14) // node
    a.lea(0, "_rt_xu_pumping")
    a.load(1, 0, 0)
    a.vm_cbnz(1, "_rt_cs_stamp_det")
    a.load(1, 15, -40)
    a.vm_mov_imm(2, 0)
    a.store(1, 0, 2) // next = 0
    a.vm_mov_imm(2, 1)
    a.store(1, 8, 2) // kind = SEND
    a.jmp("_rt_cs_stamped")
    a.label("_rt_cs_stamp_det")
    a.load(1, 15, -40)
    a.vm_mov_imm(2, 0)
    a.store(1, 0, 2) // next = 0
    a.vm_mov_imm(2, 3)
    a.store(1, 8, 2) // kind = SEND_DETACHED
    a.label("_rt_cs_stamped")
    a.vm_mov_imm(2, 0)
    a.store(1, 16, 2) // done = WAITING
    a.vm_add_imm(2, 1, 32)
    a.store(1, 24, 2) // node.buf = node+32 (data area)
    a.store(15, -32, 2) // copy target
    a.vm_mov_imm(1, 0)
    a.label("_rt_cs_park_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_cs_park_copied")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_cs_park_copy")
    a.label("_rt_cs_park_copied")
    // enqueue at tail
    a.load(0, 15, -8)
    a.load(2, 0, 72) // tail
    a.vm_cbnz(2, "_rt_cs_q_append")
    a.load(1, 15, -40)
    a.store(0, 64, 1) // head = node
    a.store(0, 72, 1) // tail = node
    a.jmp("_rt_cs_q_done")
    a.label("_rt_cs_q_append")
    a.load(1, 15, -40)
    a.store(2, 0, 1) // tail->next = node
    a.store(0, 72, 1) // tail = node
    a.label("_rt_cs_q_done")
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    // if pumping → park-and-<<
    a.lea(0, "_rt_xu_pumping")
    a.load(1, 0, 0)
    a.vm_cbnz(1, "_rt_cs_parked_ret")
    a.label("_rt_cs_wait")
    a.call("_rt_xu_pump")
    a.load(0, 15, -8)
    a.label("_rt_cs_wlock")
    a.load(1, 0, 0)
    a.vm_cbnz(1, "_rt_cs_wlock")
    a.vm_mov_imm(1, 1)
    a.store(0, 0, 1)
    a.load(1, 15, -40)
    a.load(2, 1, 16) // node.done
    a.vm_cbz(2, "_rt_cs_wait_again")
    a.vm_cmp_imm(2, 1) // SERVED
    a.jeq("_rt_cs_peer_done")
    a.jmp("_rt_cs_closed_node") // CLOSED → free then fail-loud
    a.label("_rt_cs_wait_again")
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.jmp("_rt_cs_wait")
    a.label("_rt_cs_peer_done")
    rt_wn_free(a)
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.epilogue()
    a.label("_rt_cs_parked_ret")
    a.epilogue()
    a.label("_rt_cs_closed_node")
    rt_wn_free(a)
    a.load(0, 15, -8)
    a.label("_rt_cs_closed")
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    rt_exit(a, 1)
    a.epilogue()
    <<
}

fn rt_emit_chan_recv(a &mut Assembler) {
    a.label("_rt_chan_recv")
    a.prologue(48)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    a.label("_rt_cr_lock")
    a.load(0, 15, -8)
    a.load(1, 0, 0)
    a.vm_cbnz(1, "_rt_cr_lock")
    a.vm_mov_imm(1, 1)
    a.store(0, 0, 1)
    // wait_head != 0 && head->kind != RECV (2): SEND or SEND_DETACHED
    a.load(1, 0, 64)
    a.vm_cbz(1, "_rt_cr_no_send")
    a.load(2, 1, 8)
    a.vm_cmp_imm(2, 2)
    a.jeq("_rt_cr_no_send")
    a.store(15, -40, 1) // node (for detached free)
    a.load(2, 1, 24) // node.buf = node+32 (data area)
    a.store(15, -32, 2)
    a.vm_mov_imm(1, 0)
    a.label("_rt_cr_rv_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_cr_rv_done")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_cr_rv_copy")
    a.label("_rt_cr_rv_done")
    // serve: done=1 (SERVED), head=next, clear tail when queue empties
    a.load(0, 15, -8)
    a.load(1, 0, 64)
    a.vm_mov_imm(2, 1)
    a.store(1, 16, 2)
    a.load(2, 1, 0)
    a.store(0, 64, 2)
    a.vm_cbnz(2, "_rt_cr_pop_keep")
    a.vm_mov_imm(2, 0)
    a.store(0, 72, 2)
    a.label("_rt_cr_pop_keep")
    a.load(1, 15, -40)
    a.load(2, 1, 8) // kind
    a.vm_cmp_imm(2, 3) // SEND_DETACHED?
    a.jne("_rt_cr_ndet")
    rt_wn_free(a)
    a.load(0, 15, -8)
    a.label("_rt_cr_ndet")
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.vm_mov_imm(14, 1) // MS9e: data
    a.epilogue()
    a.label("_rt_cr_no_send")
    a.load(1, 0, 24)
    a.vm_cmp_imm(1, 0)
    a.jeq("_rt_cr_empty")
    a.load(1, 0, 32)
    a.load(2, 0, 8)
    a.mul(3, 1, 2)
    a.shl_imm(3, 3, 3)
    a.load(4, 0, 48)
    a.add(3, 4, 3)
    a.store(15, -32, 3)
    a.vm_mov_imm(1, 0)
    a.label("_rt_cr_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_cr_copied")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_cr_copy")
    a.label("_rt_cr_copied")
    a.load(0, 15, -8)
    a.load(1, 0, 32)
    a.vm_add_imm(1, 1, 1)
    a.load(2, 0, 16)
    a.cmp(1, 2)
    a.jlt("_rt_cr_head_ok")
    a.vm_mov_imm(1, 0)
    a.label("_rt_cr_head_ok")
    a.store(0, 32, 1)
    a.load(1, 0, 24)
    a.vm_sub_imm(1, 1, 1)
    a.store(0, 24, 1)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.vm_mov_imm(14, 1) // MS9e: data
    a.epilogue()
    a.label("_rt_cr_empty")
    a.load(1, 0, 56)
    a.vm_cbnz(1, "_rt_cr_zero")
    // park: RECV node whose buf is our destination
    a.vm_mov_imm(1, 32)
    a.mov(18, 1)
    a.call("_rt_alloc")
    a.store(15, -40, 14) // node
    a.load(1, 15, -40)
    a.vm_mov_imm(2, 0)
    a.store(1, 0, 2) // next = 0
    a.vm_mov_imm(2, 2)
    a.store(1, 8, 2) // kind = RECV
    a.vm_mov_imm(2, 0)
    a.store(1, 16, 2) // done = WAITING
    a.load(2, 15, -16)
    a.store(1, 24, 2) // node.buf = dst
    // enqueue at tail
    a.load(0, 15, -8)
    a.load(2, 0, 72) // tail
    a.vm_cbnz(2, "_rt_cr_q_append")
    a.load(1, 15, -40)
    a.store(0, 64, 1) // head = node
    a.store(0, 72, 1) // tail = node
    a.jmp("_rt_cr_q_done")
    a.label("_rt_cr_q_append")
    a.load(1, 15, -40)
    a.store(2, 0, 1) // tail->next = node
    a.store(0, 72, 1) // tail = node
    a.label("_rt_cr_q_done")
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.label("_rt_cr_wait")
    a.call("_rt_xu_pump")
    a.load(0, 15, -8)
    a.label("_rt_cr_wlock")
    a.load(1, 0, 0)
    a.vm_cbnz(1, "_rt_cr_wlock")
    a.vm_mov_imm(1, 1)
    a.store(0, 0, 1)
    a.load(1, 15, -40)
    a.load(2, 1, 16) // node.done
    a.vm_cbz(2, "_rt_cr_wait_again")
    a.vm_cmp_imm(2, 1) // SERVED
    a.jeq("_rt_cr_peer_done")
    a.jmp("_rt_cr_zero_node") // CLOSED: dst zeroed by close; re-zero harmless
    a.label("_rt_cr_wait_again")
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.jmp("_rt_cr_wait")
    a.label("_rt_cr_peer_done")
    rt_wn_free(a)
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.vm_mov_imm(14, 1) // MS9e: data
    a.epilogue()
    a.label("_rt_cr_zero_node")
    rt_wn_free(a)
    a.label("_rt_cr_zero")
    a.vm_mov_imm(1, 0)
    a.label("_rt_cr_zloop")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_cr_zdone")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.vm_mov_imm(4, 0)
    a.store(3, 0, 4)
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_cr_zloop")
    a.label("_rt_cr_zdone")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.vm_mov_imm(14, 2) // MS9e: closed-empty
    a.epilogue()
    <<
}

fn rt_emit_chan_close(a &mut Assembler) {
    a.label("_rt_chan_close")
    a.prologue(16)
    a.store(15, -8, 18)
    a.load(0, 15, -8)
    a.label("_rt_cc_lock")
    a.load(1, 0, 0)
    a.vm_cbnz(1, "_rt_cc_lock")
    a.vm_mov_imm(1, 1)
    a.store(0, 0, 1)
    a.vm_mov_imm(1, 1)
    a.store(0, 56, 1) // closed
    // Drain the wait queue: zero parked recv destinations, mark all done=CLOSED
    // (parked senders wake to done==CLOSED and <<< 1 fail-loud).
    a.load(1, 0, 64)
    a.vm_cbz(1, "_rt_cc_qdone")
    a.label("_rt_cc_qloop")
    a.store(15, -16, 1) // node
    a.load(2, 1, 8) // kind
    a.vm_cmp_imm(2, 2) // RECV?
    a.jne("_rt_cc_qmark")
    a.load(2, 1, 24) // buf (dst)
    a.load(3, 0, 8) // elem_slots
    a.vm_mov_imm(4, 0)
    // Keep the loop index in V4; use V0 for the zero value.  Resetting V4 in
    // the body makes a multi-slot parked receive spin forever on close.
    a.vm_mov_imm(0, 0)
    a.label("_rt_cc_zloop")
    a.cmp(4, 3)
    a.jge("_rt_cc_zdone")
    a.mov(5, 4)
    a.shl_imm(5, 5, 3)
    a.add(5, 2, 5)
    a.store(5, 0, 0)
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_cc_zloop")
    a.label("_rt_cc_zdone")
    a.load(0, 15, -8)
    a.load(1, 15, -16)
    a.label("_rt_cc_qmark")
    a.vm_mov_imm(2, 2)
    a.store(1, 16, 2) // done = CLOSED
    a.load(2, 1, 0) // next
    a.store(0, 64, 2)
    a.load(1, 15, -16)
    a.load(2, 1, 8)
    a.vm_cmp_imm(2, 3) // SEND_DETACHED?
    a.jne("_rt_cc_nofree")
    a.load(18, 15, -16)
    a.call("_rt_free")
    a.load(0, 15, -8)
    a.label("_rt_cc_nofree")
    a.load(1, 0, 64)
    a.vm_cbnz(1, "_rt_cc_qloop")
    a.label("_rt_cc_qdone")
    a.vm_mov_imm(1, 0)
    a.store(0, 64, 1)
    a.store(0, 72, 1)
    a.label("_rt_cc_done")
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.epilogue()
    <<
}

fn rt_emit_chan_try_send(a &mut Assembler) {
    a.label("_rt_chan_try_send")
    a.prologue(48)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    a.load(0, 15, -8)
    a.label("_rt_cts_lock")
    a.load(1, 0, 0)
    a.vm_cbnz(1, "_rt_cts_lock")
    a.vm_mov_imm(1, 1)
    a.store(0, 0, 1)
    a.load(1, 0, 56)
    a.vm_cbnz(1, "_rt_cts_closed")
    a.load(1, 0, 64)
    a.vm_cbz(1, "_rt_cts_no_recv")
    a.load(2, 1, 8)
    a.vm_cmp_imm(2, 2)
    a.jne("_rt_cts_no_recv")
    a.load(2, 1, 24)
    a.store(15, -32, 2)
    a.vm_mov_imm(1, 0)
    a.label("_rt_cts_rv_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_cts_rv_done")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_cts_rv_copy")
    a.label("_rt_cts_rv_done")
    a.load(0, 15, -8)
    a.load(1, 0, 64)
    a.vm_mov_imm(2, 1)
    a.store(1, 16, 2) // done = SERVED
    a.load(2, 1, 0) // next
    a.store(0, 64, 2) // head = next
    a.vm_cbnz(2, "_rt_cts_pop_keep")
    a.vm_mov_imm(2, 0)
    a.store(0, 72, 2) // tail = 0
    a.label("_rt_cts_pop_keep")
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.vm_mov_imm(14, 1)
    a.epilogue()
    a.label("_rt_cts_no_recv")
    a.load(1, 0, 16)
    a.vm_cmp_imm(1, 0)
    a.jeq("_rt_cts_block")
    a.load(2, 0, 24)
    a.cmp(2, 1)
    a.jge("_rt_cts_block")
    a.load(1, 0, 40)
    a.load(2, 0, 8)
    a.mul(3, 1, 2)
    a.shl_imm(3, 3, 3)
    a.load(4, 0, 48)
    a.add(3, 4, 3)
    a.store(15, -32, 3)
    a.vm_mov_imm(1, 0)
    a.label("_rt_cts_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_cts_copied")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_cts_copy")
    a.label("_rt_cts_copied")
    a.load(0, 15, -8)
    a.load(1, 0, 40)
    a.vm_add_imm(1, 1, 1)
    a.load(2, 0, 16)
    a.cmp(1, 2)
    a.jlt("_rt_cts_tail_ok")
    a.vm_mov_imm(1, 0)
    a.label("_rt_cts_tail_ok")
    a.store(0, 40, 1)
    a.load(1, 0, 24)
    a.vm_add_imm(1, 1, 1)
    a.store(0, 24, 1)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.vm_mov_imm(14, 1)
    a.epilogue()
    a.label("_rt_cts_block")
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.vm_mov_imm(14, 0)
    a.epilogue()
    a.label("_rt_cts_closed")
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    rt_exit(a, 1)
    a.epilogue()
    <<
}

fn rt_emit_chan_try_recv(a &mut Assembler) {
    a.label("_rt_chan_try_recv")
    a.prologue(48)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    a.load(0, 15, -8)
    a.label("_rt_ctr_lock")
    a.load(1, 0, 0)
    a.vm_cbnz(1, "_rt_ctr_lock")
    a.vm_mov_imm(1, 1)
    a.store(0, 0, 1)
    a.load(1, 0, 64)
    a.vm_cbz(1, "_rt_ctr_no_send")
    a.load(2, 1, 8)
    a.vm_cmp_imm(2, 2) // RECV? then not a send waiter
    a.jeq("_rt_ctr_no_send")
    a.store(15, -40, 1)
    a.load(2, 1, 24)
    a.store(15, -32, 2)
    a.vm_mov_imm(1, 0)
    a.label("_rt_ctr_rv_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_ctr_rv_done")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_ctr_rv_copy")
    a.label("_rt_ctr_rv_done")
    a.load(0, 15, -8)
    a.load(1, 0, 64)
    a.vm_mov_imm(2, 1)
    a.store(1, 16, 2) // done = SERVED
    a.load(2, 1, 0) // next
    a.store(0, 64, 2) // head = next
    a.vm_cbnz(2, "_rt_ctr_pop_keep")
    a.vm_mov_imm(2, 0)
    a.store(0, 72, 2) // tail = 0
    a.label("_rt_ctr_pop_keep")
    a.load(1, 15, -40)
    a.load(2, 1, 8)
    a.vm_cmp_imm(2, 3) // SEND_DETACHED?
    a.jne("_rt_ctr_ndet")
    rt_wn_free(a)
    a.load(0, 15, -8)
    a.label("_rt_ctr_ndet")
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.vm_mov_imm(14, 1)
    a.epilogue()
    a.label("_rt_ctr_no_send")
    a.load(1, 0, 24)
    a.vm_cmp_imm(1, 0)
    a.jeq("_rt_ctr_empty")
    a.load(1, 0, 32)
    a.load(2, 0, 8)
    a.mul(3, 1, 2)
    a.shl_imm(3, 3, 3)
    a.load(4, 0, 48)
    a.add(3, 4, 3)
    a.store(15, -32, 3)
    a.vm_mov_imm(1, 0)
    a.label("_rt_ctr_copy")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_ctr_copied")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -32)
    a.add(3, 3, 2)
    a.load(4, 3, 0)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.store(3, 0, 4)
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_ctr_copy")
    a.label("_rt_ctr_copied")
    a.load(0, 15, -8)
    a.load(1, 0, 32)
    a.vm_add_imm(1, 1, 1)
    a.load(2, 0, 16)
    a.cmp(1, 2)
    a.jlt("_rt_ctr_head_ok")
    a.vm_mov_imm(1, 0)
    a.label("_rt_ctr_head_ok")
    a.store(0, 32, 1)
    a.load(1, 0, 24)
    a.vm_sub_imm(1, 1, 1)
    a.store(0, 24, 1)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.vm_mov_imm(14, 1)
    a.epilogue()
    a.label("_rt_ctr_empty")
    a.load(1, 0, 56)
    a.vm_cbnz(1, "_rt_ctr_zero")
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.vm_mov_imm(14, 0)
    a.epilogue()
    a.label("_rt_ctr_zero")
    a.vm_mov_imm(1, 0)
    a.label("_rt_ctr_zloop")
    a.load(2, 15, -24)
    a.cmp(1, 2)
    a.jge("_rt_ctr_zdone")
    a.mov(2, 1)
    a.shl_imm(2, 2, 3)
    a.load(3, 15, -16)
    a.add(3, 3, 2)
    a.vm_mov_imm(4, 0)
    a.store(3, 0, 4)
    a.vm_add_imm(1, 1, 1)
    a.jmp("_rt_ctr_zloop")
    a.label("_rt_ctr_zdone")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.vm_mov_imm(14, 2)
    a.epilogue()
    <<
}
