// os_exec(path, blob, redir) → wait(2) status (blocks until the child exits).
// blob = dir\0 + argv (unix: arg0\0arg1\0...) or dir\0cmdline (windows).
// redir:
//   empty: inherit stdio
//   [0]==1, rest path: stdout+stderr file (else stdout file if [0]!=2 and !=3)
//   [0]==2, [1..8] LE stdout fd; if len>=17, [9..16] LE stdin fd
//   [0]==3, [1..8] LE stdin fd
// Parent closes the passed fds after fork. Child dup2 then exec.
fn rt_emit_os_exec(a &mut Assembler) {
    a.label("_rt_os_exec")
    a.prologue(256)
    a.store(15, -8, 18)
    a.store(15, -16, 19)
    a.store(15, -24, 20)
    a.store(15, -32, 21)
    a.store(15, -40, 22)
    a.store(15, -48, 23)
    // Cmd.start may run inline on the calling M. Move its blocking process
    // wait to a worker before fork so the caller can feed the child's pipes.
    a.call("_rt_enter_syscall")
    a.load(18, 15, -8)
    a.load(19, 15, -16)
    a.call("_rt_cstr")
    a.store(15, -56, 14)
    // Initialize all optional/parent-cleanup slots explicitly to NULL/false.
    // Keep the source register and stores obvious here: a non-zero sentinel in
    // -96 makes the no-redirection path call `_rt_free` on an invalid pointer.
    a.vm_mov_imm(0, 0)
    a.store(15, -64, 0)  // dir pointer: NULL (use current working directory)
    a.vm_mov_imm(0, 0)
    a.store(15, -104, 0) // redirection flag: false
    a.vm_mov_imm(0, 0)
    a.store(15, -96, 0)  // optional redirection path cstr: NULL
    a.vm_mov_imm(0, 0)
    a.store(15, -160, 0) // stdout-fd redir flag
    a.vm_mov_imm(0, 0)
    a.store(15, -168, 0) // stdout-fd value
    a.vm_mov_imm(0, 0)
    a.store(15, -176, 0) // stdin-fd redir flag
    a.vm_mov_imm(0, 0)
    a.store(15, -184, 0) // stdin-fd value
    a.load(2, 15, -24)
    a.load(3, 15, -32)
    a.vm_mov_imm(4, 0)
    a.label("_rt_ox_dir")
    a.cmp(4, 3)
    a.jge("_rt_ox_dir_done")
    a.add(5, 2, 4)
    a.load_byte(1, 5, 0)
    a.vm_cbz(1, "_rt_ox_dir_hit")
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_ox_dir")
    a.label("_rt_ox_dir_hit")
    a.vm_cmp_imm(4, 0)
    a.jeq("_rt_ox_dir_skip")
    a.store(15, -64, 2)
    a.label("_rt_ox_dir_skip")
    a.vm_add_imm(4, 4, 1)
    a.label("_rt_ox_dir_done")
    a.add(2, 2, 4)
    a.sub(3, 3, 4)
    a.store(15, -120, 2)
    a.store(15, -128, 3)
    a.load(2, 15, -40)
    a.load(3, 15, -48)
    a.vm_cmp_imm(3, 0)
    a.jeq("_rt_ox_nr")
    a.load_byte(1, 2, 0)
    a.vm_cmp_imm(1, 2)
    a.jeq("_rt_ox_mode2")
    a.vm_cmp_imm(1, 3)
    a.jne("_rt_ox_notfd")
    // redir[0]==3, redir[1..8] little-endian stdin fd.
    a.vm_cmp_imm(3, 9)
    a.jlt("_rt_ox_nr")
    rt_ox_load_le64(a, 2, 1)
    a.store(15, -184, 0)
    a.vm_mov_imm(1, 1)
    a.store(15, -176, 1)
    a.jmp("_rt_ox_nr")
    a.label("_rt_ox_mode2")
    // redir[0]==2, redir[1..8] little-endian stdout fd; if len>=17,
    // redir[9..16] is the stdin fd.
    // Parent closes the passed fds after fork so leftover pipe ends
    // in the parent see EOF / EPIPE when the child exits.
    a.vm_cmp_imm(3, 9)
    a.jlt("_rt_ox_nr")
    rt_ox_load_le64(a, 2, 1)
    a.store(15, -168, 0)
    a.vm_mov_imm(1, 1)
    a.store(15, -160, 1)
    a.load(3, 15, -48)
    a.vm_cmp_imm(3, 17)
    a.jlt("_rt_ox_nr")
    a.load(2, 15, -40)
    rt_ox_load_le64(a, 2, 9)
    a.store(15, -184, 0)
    a.vm_mov_imm(1, 1)
    a.store(15, -176, 1)
    a.jmp("_rt_ox_nr")
    a.label("_rt_ox_notfd")
    a.vm_cmp_imm(1, 1)
    a.jne("_rt_ox_r1")
    a.vm_mov_imm(1, 1)
    a.store(15, -104, 1)
    a.vm_add_imm(2, 2, 1)
    a.vm_sub_imm(3, 3, 1)
    a.label("_rt_ox_r1")
    a.vm_cmp_imm(3, 0)
    a.jeq("_rt_ox_nr")
    a.mov(18, 2)
    a.mov(19, 3)
    a.call("_rt_cstr")
    a.store(15, -96, 14)
    a.label("_rt_ox_nr")
    if a.os == 2 {
        rt_emit_os_exec_win(a)
        <<
    }
    rt_emit_os_exec_unix(a)
    <<
}

