@main

#xu/types

fn rt_emit_os_fs2_data(a $&Assembler) {
    a.data_label("_rt_os_unsup")
    rt_emit_bytes(a, "os: unsupported")
    <<
}

fn rt_os_fs2_ok_int(a $&Assembler, val_reg int) {
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, val_reg)
    a.epilogue()
    <<
}

fn rt_os_fs2_fail(a $&Assembler) {
    if a.os == 2 {
        a.vm_mov_imm(18, 2)
    } else {
        a.neg(18, 14)
    }
    a.call("_rt_errno_msg")
    rt_call_throw_strerr_args(a, -8)
    a.epilogue()
    <<
}

// Variant for helpers that hold an owning `_rt_cstr` temporary in a frame
// slot.  Preserve the normalized errno before `_rt_free` clobbers V0/Ret, then
// route through the same stable PathError construction as the legacy helper.
fn rt_os_fs2_fail_cstr(a $&Assembler, cstr_off int, save_off int) {
    if a.os == 2 {
        a.vm_mov_imm(18, 2)
    } else {
        a.neg(18, 14)
    }
    a.store(15, save_off, 18)
    rt_free_cstr_slot(a, cstr_off)
    a.load(18, 15, save_off)
    a.call("_rt_errno_msg")
    rt_call_throw_strerr_args(a, -8)
    a.epilogue()
    <<
}

fn rt_os_fs2_fail_cstr2(a $&Assembler, first_off int, second_off int, save_off int) {
    if a.os == 2 {
        a.vm_mov_imm(18, 2)
    } else {
        a.neg(18, 14)
    }
    a.store(15, save_off, 18)
    rt_free_cstr_slot(a, first_off)
    rt_free_cstr_slot(a, second_off)
    a.load(18, 15, save_off)
    a.call("_rt_errno_msg")
    rt_call_throw_strerr_args(a, -8)
    a.epilogue()
    <<
}

fn rt_os_fs2_unsup(a $&Assembler) {
    rt_call_throw_strerr_static(a, -8, "_rt_os_unsup", 15)
    a.epilogue()
    <<
}

fn rt_emit_os_chmod(a $&Assembler) {
    a.label("_rt_os_chmod")
    a.prologue(48)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.store(15, -32, 20)
    a.call("_rt_cstr")
    a.store(15, -40, 14)
    if a.os == 2 {
        a.load(2, 15, -32)
        a.vm_mov_imm(19, 128)
        a.vm_mov_imm(1, 146)
        a.iand(1, 2, 1)
        a.vm_cmp_imm(1, 0)
        a.jne("_rt_chm_win_set")
        a.vm_mov_imm(19, 1)
        a.label("_rt_chm_win_set")
        a.load(18, 15, -40)
        a.vm_call_iat("_iat_SetFileAttributesA")
        a.vm_cbz(14, "_rt_chm_fail")
    } else {
        if a.os == 1 && (a.arch == 0 || a.arch == 4 || a.arch == 5) {
            a.vm_mov_imm(18, -100)
            a.load(19, 15, -40)
            a.load(20, 15, -32)
            a.vm_mov_imm(21, 0)
        } else {
            a.load(18, 15, -40)
            a.load(19, 15, -32)
        }
        a.vm_syscall(syscall_number(a.os, a.arch, 39))
        a.vm_normalize_syscall("_rt_chm_n")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_chm_fail")
    }
    a.vm_mov_imm(1, 0)
    // Write the result before releasing pathZ; the free helper may reuse V1.
    a.load(0, 15, -8)
    a.store(0, 0, 1)
    a.vm_mov_imm(1, 0)
    a.store(0, -8, 1)
    rt_free_cstr_slot(a, -40)
    a.epilogue()
    a.label("_rt_chm_fail")
    rt_os_fs2_fail_cstr(a, -40, -48)
    <<
}

fn rt_emit_os_chdir(a $&Assembler) {
    a.label("_rt_os_chdir")
    a.prologue(32)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.call("_rt_cstr")
    a.store(15, -32, 14)
    if a.os == 2 {
        a.load(18, 15, -32)
        a.vm_call_iat("_iat_SetCurrentDirectoryA")
        a.vm_cbz(14, "_rt_cd_fail")
    } else {
        a.load(18, 15, -32)
        a.vm_syscall(syscall_number(a.os, a.arch, 40))
        a.vm_normalize_syscall("_rt_cd_n")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_cd_fail")
    }
    a.vm_mov_imm(1, 0)
    a.load(0, 15, -8)
    a.store(0, 0, 1)
    a.vm_mov_imm(1, 0)
    a.store(0, -8, 1)
    rt_free_cstr_slot(a, -32)
    a.epilogue()
    a.label("_rt_cd_fail")
    rt_os_fs2_fail_cstr(a, -32, -24)
    <<
}

fn rt_emit_os_symlink(a $&Assembler) {
    a.label("_rt_os_symlink")
    a.prologue(64)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.store(15, -32, 20)
    a.store(15, -40, 21)
    a.load(18, 15, -16)
    a.load(19, 15, -24)
    a.call("_rt_cstr")
    a.store(15, -48, 14)
    a.load(18, 15, -32)
    a.load(19, 15, -40)
    a.call("_rt_cstr")
    a.store(15, -56, 14)
    if a.os == 2 {
        a.load(18, 15, -56)
        a.load(19, 15, -48)
        a.vm_mov_imm(20, 2)
        a.vm_call_iat("_iat_CreateSymbolicLinkA")
        a.vm_cbnz(14, "_rt_sy_ok")
        a.load(18, 15, -56)
        a.load(19, 15, -48)
        a.vm_mov_imm(20, 0)
        a.vm_call_iat("_iat_CreateSymbolicLinkA")
        a.vm_cbz(14, "_rt_sy_fail")
        a.label("_rt_sy_ok")
    } else {
        if a.os == 1 && (a.arch == 0 || a.arch == 4 || a.arch == 5) {
            a.load(18, 15, -48)
            a.vm_mov_imm(19, -100)
            a.load(20, 15, -56)
        } else {
            a.load(18, 15, -48)
            a.load(19, 15, -56)
        }
        a.vm_syscall(syscall_number(a.os, a.arch, 41))
        a.vm_normalize_syscall("_rt_sy_n")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_sy_fail")
    }
    a.vm_mov_imm(1, 0)
    a.load(0, 15, -8)
    a.store(0, 0, 1)
    a.vm_mov_imm(1, 0)
    a.store(0, -8, 1)
    rt_free_cstr_slot(a, -48)
    rt_free_cstr_slot(a, -56)
    a.epilogue()
    a.label("_rt_sy_fail")
    // Preserve errno while releasing both NUL-terminated path copies.
    rt_os_fs2_fail_cstr2(a, -48, -56, -64)
    <<
}

// Windows: CreateFile(OPEN_REPARSE_POINT) + FSCTL_GET_REPARSE_POINT, then
// UTF-16LE print/subst name bytes (os.readlink decodes to UTF-8).
fn rt_emit_os_readlink_win(a $&Assembler) {
    a.prologue(96)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.call("_rt_cstr")
    a.store(15, -32, 14)
    a.vm_mov_imm(0, 0)
    a.store(15, -40, 0) // HANDLE (zero until CreateFile succeeds)
    a.store(15, -48, 0) // reparse buffer
    a.load(18, 15, -32)
    a.vm_mov_imm64(19, 2147483648)
    a.vm_mov_imm(20, 7)
    a.vm_mov_imm(21, 0)
    a.vm_mov_imm(22, 3)
    a.vm_mov_imm(23, 35651584)
    a.vm_call_iat7("_iat_CreateFileA")
    rt_win_cmp_invalid_handle(a)
    a.jeq("_rt_rl_fail")
    a.store(15, -40, 14)
    a.vm_mov_imm(18, 16384)
    a.call("_rt_alloc")
    a.store(15, -48, 14)
    a.load(18, 15, -40)
    a.vm_mov_imm(19, 589992)
    a.vm_mov_imm(20, 0)
    a.vm_mov_imm(21, 0)
    a.load(22, 15, -48)
    a.vm_mov_imm(23, 16384)
    if a.arch == 1 {
        a.xbe_call_iat_deviceiocontrol("_iat_DeviceIoControl")
    } else {
        a.abe_call_iat_deviceiocontrol("_iat_DeviceIoControl")
    }
    a.vm_cbz(14, "_rt_rl_wfailb")
    a.load(1, 15, -48)
    a.load(2, 1, 0)
    a.vm_mov_imm64(3, 4294967295)
    a.iand(2, 2, 3)
    a.vm_mov_imm(3, 10)
    a.shl_imm(3, 3, 24)
    a.vm_add_imm(4, 3, 12)
    a.cmp(2, 4)
    a.jeq("_rt_rl_sym")
    a.vm_add_imm(4, 3, 3)
    a.cmp(2, 4)
    a.jeq("_rt_rl_mnt")
    a.jmp("_rt_rl_wfailb")
    a.label("_rt_rl_sym")
    a.vm_mov_imm(5, 20)
    a.jmp("_rt_rl_names")
    a.label("_rt_rl_mnt")
    a.vm_mov_imm(5, 16)
    a.label("_rt_rl_names")
    a.store(15, -56, 5)
    a.load(1, 15, -48)
    a.load_byte(2, 1, 12)
    a.load_byte(3, 1, 13)
    a.shl_imm(3, 3, 8)
    a.ior(2, 2, 3)
    a.load_byte(3, 1, 14)
    a.load_byte(4, 1, 15)
    a.shl_imm(4, 4, 8)
    a.ior(3, 3, 4)
    a.vm_cbnz(3, "_rt_rl_have")
    a.load_byte(2, 1, 8)
    a.load_byte(3, 1, 9)
    a.shl_imm(3, 3, 8)
    a.ior(2, 2, 3)
    a.load_byte(3, 1, 10)
    a.load_byte(4, 1, 11)
    a.shl_imm(4, 4, 8)
    a.ior(3, 3, 4)
    a.label("_rt_rl_have")
    a.load(5, 15, -56)
    a.add(1, 1, 5)
    a.add(1, 1, 2)
    a.store(15, -64, 1)
    a.shr_imm(3, 3, 1)
    a.shl_imm(3, 3, 1)
    a.store(15, -72, 3)
    a.vm_cbz(3, "_rt_rl_empty")
    a.mov(18, 3)
    a.call("_rt_alloc")
    a.store(15, -80, 14)
    a.vm_mov_imm(4, 0)
    a.store(15, -88, 4)
    a.label("_rt_rl_cpy")
    a.load(4, 15, -88)
    a.load(3, 15, -72)
    a.cmp(4, 3)
    a.jge("_rt_rl_cdone")
    a.load(1, 15, -64)
    a.add(1, 1, 4)
    a.load_byte(2, 1, 0)
    a.load(1, 15, -80)
    a.add(1, 1, 4)
    a.store_byte(1, 0, 2)
    a.vm_add_imm(4, 4, 1)
    a.store(15, -88, 4)
    a.jmp("_rt_rl_cpy")
    a.label("_rt_rl_cdone")
    a.load(18, 15, -48)
    a.call("_rt_free")
    a.load(18, 15, -40)
    a.vm_call_iat("_iat_CloseHandle")
    a.vm_mov_imm(0, 0)
    a.store(15, -40, 0)
    a.store(15, -48, 0)
    rt_free_cstr_slot(a, -32)
    a.label("_rt_rl_ok")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.load(1, 15, -80)
    a.store(0, -8, 1)
    a.load(1, 15, -72)
    a.store(0, -16, 1)
    a.store(0, -24, 1)
    a.epilogue()
    a.label("_rt_rl_empty")
    a.load(18, 15, -48)
    a.call("_rt_free")
    a.load(18, 15, -40)
    a.vm_call_iat("_iat_CloseHandle")
    a.vm_mov_imm(0, 0)
    a.store(15, -40, 0)
    a.store(15, -48, 0)
    rt_free_cstr_slot(a, -32)
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.store(0, -24, 1)
    a.epilogue()
    a.label("_rt_rl_wfailb")
    a.load(18, 15, -48)
    a.call("_rt_free")
    a.load(18, 15, -40)
    a.vm_call_iat("_iat_CloseHandle")
    a.vm_mov_imm(0, 0)
    a.store(15, -40, 0)
    a.store(15, -48, 0)
    a.label("_rt_rl_fail")
    rt_os_fs2_fail_cstr(a, -32, -96)
    <<
}

fn rt_emit_os_readlink(a $&Assembler) {
    a.label("_rt_os_readlink")
    if a.os == 2 {
        rt_emit_os_readlink_win(a)
        <<
    }
    a.prologue(64)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.call("_rt_cstr")
    a.store(15, -32, 14)
    a.vm_mov_imm(18, RT_READLINK_BUFFER_BYTES)
    a.call("_rt_alloc")
    a.store(15, -40, 14)
    if a.os == 1 && (a.arch == 0 || a.arch == 4 || a.arch == 5) {
        a.vm_mov_imm(18, -100)
        a.load(19, 15, -32)
        a.load(20, 15, -40)
        a.vm_mov_imm(21, RT_READLINK_BUFFER_BYTES)
    } else {
        a.load(18, 15, -32)
        a.load(19, 15, -40)
        a.vm_mov_imm(20, RT_READLINK_BUFFER_BYTES)
    }
    a.vm_syscall(syscall_number(a.os, a.arch, 42))
    a.vm_normalize_syscall("_rt_rl_n")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_rl_fail")
    a.store(15, -48, 14)
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.load(1, 15, -40)
    a.store(0, -8, 1)
    a.load(1, 15, -48)
    a.store(0, -16, 1)
    a.vm_mov_imm(1, RT_READLINK_BUFFER_BYTES)
    a.store(0, -24, 1)
    rt_free_cstr_slot(a, -32)
    a.epilogue()
    a.label("_rt_rl_fail")
    // Save errno before releasing both the readlink buffer and pathZ.
    a.neg(18, 14)
    a.store(15, -56, 18)
    a.load(18, 15, -40)
    a.call("_rt_free")
    rt_free_cstr_slot(a, -32)
    a.load(18, 15, -56)
    a.call("_rt_errno_msg")
    rt_call_throw_strerr_args(a, -8)
    a.epilogue()
    <<
}

fn rt_emit_os_fd_seek(a $&Assembler) {
    a.label("_rt_os_fd_seek")
    a.prologue(48)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.store(15, -32, 20)
    if a.os == 2 {
        a.load(18, 15, -16)
        a.load(19, 15, -24)
        a.mov(20, 15)
        a.vm_sub_imm(20, 20, 40)
        a.load(21, 15, -32)
        a.vm_call_iat("_iat_SetFilePointerEx")
        a.vm_cbz(14, "_rt_sk_fail")
        a.load(14, 15, -40)
    } else {
        a.load(18, 15, -16)
        a.load(19, 15, -24)
        a.load(20, 15, -32)
        a.vm_syscall(syscall_number(a.os, a.arch, 43))
        a.vm_normalize_syscall("_rt_sk_n")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_sk_fail")
    }
    rt_os_fs2_ok_int(a, 14)
    a.label("_rt_sk_fail")
    rt_os_fs2_fail(a)
    <<
}

fn rt_emit_os_pipe(a $&Assembler) {
    a.label("_rt_os_pipe")
    a.prologue(48)
    a.store(15, -8, 0)
    if a.os == 2 {
        a.mov(18, 15)
        a.vm_sub_imm(18, 18, 24)
        a.mov(19, 15)
        a.vm_sub_imm(19, 19, 32)
        a.vm_mov_imm(20, 0)
        a.vm_mov_imm(21, 0)
        a.vm_call_iat("_iat_CreatePipe")
        a.vm_cbz(14, "_rt_pp_fail")
        a.load(1, 15, -24)
        a.load(2, 15, -32)
        a.shl_imm(1, 1, 32)
        a.vm_mov_imm64(3, 4294967295)
        a.iand(2, 2, 3)
        a.ior(14, 1, 2)
        rt_os_fs2_ok_int(a, 14)
        a.label("_rt_pp_fail")
        rt_os_fs2_fail(a)
        <<
    }
    a.mov(18, 15)
    a.vm_sub_imm(18, 18, 24)
    a.vm_mov_imm(1, 0)
    a.store(15, -24, 1)
    if a.os == 0 {
        a.vm_call_iat("_iat_pipe")
        a.vm_cmp_imm(14, 0)
        a.jne("_rt_pp_ufail")
        a.load(1, 15, -24)
        a.vm_mov_imm64(3, 4294967295)
        a.iand(2, 1, 3)
        a.shr_imm(1, 1, 32)
        a.iand(1, 1, 3)
        a.shl_imm(2, 2, 32)
        a.ior(14, 2, 1)
        rt_os_fs2_ok_int(a, 14)
        a.label("_rt_pp_ufail")
        rt_os_fs2_fail(a)
        <<
    }
    if a.os == 1 && (a.arch == 0 || a.arch == 4 || a.arch == 5) {
        a.vm_mov_imm(19, 0)
    }
    a.vm_syscall(syscall_number(a.os, a.arch, 44))
    a.vm_normalize_syscall("_rt_pp_n")
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_pp_ufail")
    a.load(1, 15, -24)
    a.vm_mov_imm64(3, 4294967295)
    a.iand(2, 1, 3)
    a.shr_imm(1, 1, 32)
    a.iand(1, 1, 3)
    a.shl_imm(2, 2, 32)
    a.ior(14, 2, 1)
    rt_os_fs2_ok_int(a, 14)
    a.label("_rt_pp_ufail")
    rt_os_fs2_fail(a)
    <<
}
