@main

#xu/types

fn rt_emit_file_error(a $&Assembler, prefix string) {
    rt_call_throw_strerr_static(a, -8, prefix, 18)
    a.epilogue()
    <<
}

// INVALID_HANDLE_VALUE is (HANDLE)-1. Compare the low 32 bits so both
// sign-extended 0xFFFFFFFFFFFFFFFF (x64) and zero-extended 0xFFFFFFFF
// (some WoA returns) count as failure. Leaves EQ if invalid.
fn rt_win_cmp_invalid_handle(a $&Assembler) {
    a.vm_mov_imm64(0, 4294967295)
    a.iand(1, 14, 0)
    a.cmp(1, 0)
    <<
}

fn rt_win_load_written(a $&Assembler) {
    a.lea(0, "_rt_written")
    a.load(14, 0, 0)
    a.vm_mov_imm64(0, 4294967295)
    a.iand(14, 14, 0)
    <<
}

// Pack/oneexe ":xu:" mailbox — Win/mac/Linux x64+arm64 (aligned with bootstrap xurt).
fn rt_ui_mem_mailbox(a &Assembler) bool {
    if a.os == 2 && (a.arch == 0 || a.arch == 1) {
        << true
    }
    if a.os == 0 && (a.arch == 0 || a.arch == 1) {
        << true
    }
    if a.os == 1 && (a.arch == 0 || a.arch == 1) {
        << true
    }
    << false
}

// Free pathZ from rt_cstr before leaving read_file/write_file. Forgetting this
// leaks every idle IPC poll into bump chunks (VM_ALLOCATE 64KB → multi-GB).
fn rt_free_pathz(a $&Assembler, off int) {
    a.load(18, 15, off)
    a.call("_rt_free")
    <<
}

// pathZ[0..4] == ":xu:" → take mailbox miss (never open() the virtual path).
fn rt_jmp_if_xu_path(a $&Assembler, pathz_off int, label string) {
    // One miss label string; clone before each consume (jne/label take by value).
    miss := "_rt_xu_path_no_" + (label + "")
    a.load(0, 15, pathz_off)
    a.load_byte(1, 0, 0)
    a.vm_cmp_imm(1, 58) // ':'
    a.jne(miss + "")
    a.load_byte(1, 0, 1)
    a.vm_cmp_imm(1, 120) // 'x'
    a.jne(miss + "")
    a.load_byte(1, 0, 2)
    a.vm_cmp_imm(1, 117) // 'u'
    a.jne(miss + "")
    a.load_byte(1, 0, 3)
    a.vm_cmp_imm(1, 58) // ':'
    a.jne(miss + "")
    a.jmp(label)
    a.label(miss)
    <<
}

fn rt_emit_read_file(a $&Assembler) {
    a.data_label("_rt_rf_error")
    rt_emit_bytes(a, "read_file failed\n")
    // sret -8, path ptr -16, path len -24, pathZ -32, fd -40,
    // buf -48, total -56, cap -64, n -72, newbuf -80, mem_len -112
    a.label("_rt_read_file")
    a.prologue(128)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.call("_rt_cstr")
    a.store(15, -32, 14)
    // Keep cleanup idempotent on every open/read failure path.  The buffer is
    // allocated only after open succeeds, so initialize the slot before the
    // first syscall and clear it after freeing below.
    a.vm_mov_imm(0, 0)
    a.store(15, -48, 0)
    if rt_ui_mem_mailbox(&*a) {
        a.vm_mov_imm(0, 0)
        a.store(15, -112, 0)
        if a.os == 2 && a.arch == 1 {
            // Win64 C ABI: RCX=path RDX=&len via A3/A2
            a.load(21, 15, -32)
            a.mov(20, 15)
            a.vm_sub_imm(20, 20, 112)
            a.x64_sub_imm(4, 32)
            a.call("xu_ui_mem_try_read_len")
            a.x64_add_imm(4, 32)
        } else {
            a.load(18, 15, -32)
            a.mov(19, 15)
            a.vm_sub_imm(19, 19, 112)
            if a.os == 0 {
                a.call("_xu_ui_mem_try_read_len")
            } else {
                a.call("xu_ui_mem_try_read_len")
            }
        }
        // C int return: compare low 32 bits (ARM64 writing w0 zero-extends, but
        // be defensive against high-bit noise from older stubs).
        a.vm_mov_imm64(0, 4294967295)
        a.iand(14, 14, 0)
        a.vm_cmp_imm(14, 1)
        a.jeq("_rt_rf_mem_ok")
        // Missing used to return -1; ARM64 C int is w0-only so x0==-1 never matched
        // and fell through to open()+throw (multi-GB leak). Mailbox now returns 1+len0.
        // Virtual ":xu:" paths must never open(2) — even if try_read returns 0 (weak stub).
        rt_jmp_if_xu_path(a, -32, "_rt_rf_mem_miss")
        a.vm_cmp_imm(14, 0)
        a.jeq("_rt_rf_open_disk")
        a.jmp("_rt_rf_mem_miss")
        a.label("_rt_rf_open_disk")
    }
    // open(pathZ, O_RDONLY) / openat / CreateFileA
    if a.os == 2 {
        a.load(18, 15, -32)
        a.vm_mov_imm64(19, RT_WIN_GENERIC_READ) // GENERIC_READ 0x80000000
        a.vm_mov_imm(20, 3) // FILE_SHARE_READ|WRITE
        a.vm_mov_imm(21, 0)
        a.vm_mov_imm(22, 3) // OPEN_EXISTING
        a.vm_mov_imm(23, 128) // FILE_ATTRIBUTE_NORMAL
        a.vm_call_iat7("_iat_CreateFileA")
        rt_win_cmp_invalid_handle(a)
        a.jne("_rt_rf_opened")
        a.jmp("_rt_rf_fail")
        a.label("_rt_rf_opened")
    } else {
        if a.os == 1 && (a.arch == 0 || a.arch == 2 || a.arch == 4 || a.arch == 5) {
            a.vm_mov_imm(18, -100) // AT_FDCWD
            a.load(19, 15, -32)
            a.vm_mov_imm(20, 0)
            a.vm_mov_imm(21, 0)
        } else {
            a.load(18, 15, -32)
            a.vm_mov_imm(19, 0)
            a.vm_mov_imm(20, 0)
        }
        a.vm_syscall(syscall_number(a.os, a.arch, 4))
        a.vm_normalize_syscall("_rt_rf_n1")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_rf_fail")
    }
    a.store(15, -40, 14)
    a.vm_mov_imm(0, RT_FILE_READ_INITIAL_BYTES)
    if a.os != 2 {
        // Probe file size with lseek(fd, 0, SEEK_END)
        a.load(18, 15, -40)
        a.vm_mov_imm(19, 0)
        a.vm_mov_imm(20, 2)
        a.vm_syscall(syscall_number(a.os, a.arch, 43))
        a.vm_normalize_syscall("_rt_rf_nlseek1")
        a.vm_cmp_imm(14, 0)
        a.jle("_rt_rf_alloc_buf")
        a.vm_mov_imm64(1, 2147483647)
        a.cmp(14, 1)
        a.jge("_rt_rf_alloc_buf")
        a.store(15, -64, 14)
        // Rewind with lseek(fd, 0, SEEK_SET)
        a.load(18, 15, -40)
        a.vm_mov_imm(19, 0)
        a.vm_mov_imm(20, 0)
        a.vm_syscall(syscall_number(a.os, a.arch, 43))
        a.vm_normalize_syscall("_rt_rf_nlseek2")
        a.load(0, 15, -64)
        a.vm_add_imm(0, 0, 1)
        a.label("_rt_rf_alloc_buf")
    }
    a.store(15, -64, 0) // cap
    a.mov(18, 0)
    a.call("_rt_alloc")
    a.store(15, -48, 14)
    a.vm_mov_imm(0, 0)
    a.store(15, -56, 0) // total

    a.label("_rt_rf_loop")
    a.load(0, 15, -64)
    a.load(1, 15, -56)
    a.sub(2, 0, 1)
    a.vm_cbz(2, "_rt_rf_grow")
    a.load(18, 15, -40)
    a.load(19, 15, -48)
    a.add(19, 19, 1)
    a.mov(20, 2)
    if a.os == 2 {
        a.lea(1, "_rt_written")
        a.vm_mov_imm(0, 0)
        a.store(1, 0, 0)
        a.mov(21, 1)
        a.vm_mov_imm(22, 0)
        a.vm_call_iat("_iat_ReadFile")
        rt_win_load_written(a)
    } else {
        a.vm_syscall(syscall_number(a.os, a.arch, 5))
        a.vm_normalize_syscall("_rt_rf_n2")
    }
    a.store(15, -72, 14)
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_rf_fail_close")
    a.vm_cbz(14, "_rt_rf_eof")
    a.load(0, 15, -56)
    a.add(0, 0, 14)
    a.store(15, -56, 0)
    a.jmp("_rt_rf_loop")

    a.label("_rt_rf_grow")
    a.load(0, 15, -64)
    a.shl_imm(0, 0, 1)
    a.store(15, -64, 0)
    a.mov(18, 0)
    a.call("_rt_alloc")
    a.store(15, -80, 14)
    a.vm_mov_imm(4, 0)
    a.label("_rt_rf_gcopy8")
    a.load(1, 15, -56)
    a.sub(0, 1, 4)
    a.vm_cmp_imm(0, 8)
    a.jlt("_rt_rf_gcopy1")
    a.load(2, 15, -48)
    a.add(2, 2, 4)
    a.load(5, 2, 0)
    a.load(3, 15, -80)
    a.add(3, 3, 4)
    a.store(3, 0, 5)
    a.vm_add_imm(4, 4, 8)
    a.jmp("_rt_rf_gcopy8")
    a.label("_rt_rf_gcopy1")
    a.load(1, 15, -56)
    a.cmp(4, 1)
    a.jge("_rt_rf_gdone")
    a.load(2, 15, -48)
    a.add(2, 2, 4)
    a.load_byte(5, 2, 0)
    a.load(3, 15, -80)
    a.add(3, 3, 4)
    a.store_byte(3, 0, 5)
    a.vm_add_imm(4, 4, 1)
    a.jmp("_rt_rf_gcopy1")
    a.label("_rt_rf_gdone")
    a.load(18, 15, -48)
    a.call("_rt_free")
    a.load(0, 15, -80)
    a.store(15, -48, 0)
    a.jmp("_rt_rf_loop")

    a.label("_rt_rf_fail_close")
    a.load(18, 15, -40)
    if a.os == 2 {
        a.vm_call_iat("_iat_CloseHandle")
    } else {
        a.vm_syscall(syscall_number(a.os, a.arch, 6))
    }
    a.label("_rt_rf_fail")
    // A read error occurs after the 64 KiB buffer is allocated.  The old
    // path closed the descriptor but leaked that buffer on every EISDIR,
    // I/O, or interrupted-read failure.  Keep the error path safe for both
    // open failures (no buffer) and post-open failures (buffer present).
    a.load(0, 15, -48)
    a.vm_cbz(0, "_rt_rf_no_buf")
    a.mov(18, 0)
    a.call("_rt_free")
    a.vm_mov_imm(0, 0)
    a.store(15, -48, 0)
    a.label("_rt_rf_no_buf")
    rt_free_pathz(a, -32)
    rt_emit_file_error(a, "_rt_rf_error")

    a.label("_rt_rf_eof")
    a.load(18, 15, -40)
    if a.os == 2 {
        a.vm_call_iat("_iat_CloseHandle")
    } else {
        a.vm_syscall(syscall_number(a.os, a.arch, 6))
    }
    // Ok(string(buf, total, cap))
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.load(1, 15, -48)
    a.store(0, -8, 1)
    a.load(1, 15, -56)
    a.store(0, -16, 1)
    a.load(1, 15, -64)
    a.store(0, -24, 1)
    rt_free_pathz(a, -32)
    a.epilogue()
    if rt_ui_mem_mailbox(&*a) {
        // Missing ":xu:" slot → Ok("") (IPC poll hits this every few ms; throwing
        // allocates error strings + 64KB chunks unboundedly and OOMs the machine).
        a.label("_rt_rf_mem_miss")
        a.lea(18, "_rt_empty_cstr")
        a.load(0, 15, -8)
        a.vm_mov_imm(1, 0)
        a.store(0, 0, 1)
        a.store(0, -8, 18)
        a.vm_mov_imm(1, 0)
        a.store(0, -16, 1)
        a.vm_mov_imm(1, 0)
        a.store(0, -24, 1)
        rt_free_pathz(a, -32)
        a.epilogue()
        a.label("_rt_rf_mem_ok")
        a.load(0, 15, -112)
        a.vm_cbz(0, "_rt_rf_mem_miss") // len==0 → Ok("") without heap alloc
        a.vm_add_imm(18, 0, 1)
        a.call("_rt_alloc")
        a.store(15, -48, 14)
        a.load(0, 15, -112)
        a.store(15, -56, 0)
        a.vm_add_imm(1, 0, 1)
        a.store(15, -64, 1)
        if a.os == 2 && a.arch == 1 {
            a.load(21, 15, -32)
            a.load(20, 15, -48)
            a.load(22, 15, -64)
            a.x64_sub_imm(4, 32)
            a.call("xu_ui_mem_try_read_copy")
            a.x64_add_imm(4, 32)
        } else {
            a.load(18, 15, -32)
            a.load(19, 15, -48)
            a.load(20, 15, -64)
            if a.os == 0 {
                a.call("_xu_ui_mem_try_read_copy")
            } else {
                a.call("xu_ui_mem_try_read_copy")
            }
        }
        a.load(0, 15, -8)
        a.vm_mov_imm(1, 0)
        a.store(0, 0, 1)
        a.load(1, 15, -48)
        a.store(0, -8, 1)
        a.load(1, 15, -56)
        a.store(0, -16, 1)
        a.load(1, 15, -64)
        a.store(0, -24, 1)
        rt_free_pathz(a, -32)
        a.epilogue()
        // Weak stubs; pack links strong xu_ui_mem_try_* from libxu_ui_host.a.
        if a.os == 0 {
            a.label("_xu_ui_mem_try_read_len")
            a.prologue(16)
            a.vm_mov_imm(14, 0)
            a.epilogue()
            a.label("_xu_ui_mem_try_read_copy")
            a.prologue(16)
            a.vm_mov_imm(14, 0)
            a.epilogue()
        } else {
            a.label("xu_ui_mem_try_read_len")
            a.prologue(16)
            a.vm_mov_imm(14, 0)
            a.epilogue()
            a.label("xu_ui_mem_try_read_copy")
            a.prologue(16)
            a.vm_mov_imm(14, 0)
            a.epilogue()
        }
    }
    <<
}

fn rt_emit_read_dir(a $&Assembler) {
    a.data_label("_rt_rd_error")
    rt_emit_bytes(a, "read_dir failed\n")
    a.data_label("_rt_rd_nl")
    rt_emit_bytes(a, "\n")
    a.label("_rt_read_dir")
    a.prologue(128)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.call("_rt_cstr")
    a.store(15, -32, 14)
    // Cleanup slots are initialized before any allocation/open attempt.  This
    // lets the shared failure epilogue distinguish an open failure from a
    // post-open read failure without touching uninitialized frame memory.
    a.vm_mov_imm(0, 0)
    a.store(15, -40, 0)  // fd/HANDLE
    a.store(15, -48, 0)  // dirent/FindData scratch
    a.store(15, -104, 0) // Windows wildcard scratch
    a.vm_mov_imm(18, 16)
    a.call("_rt_alloc")
    a.store(15, -56, 14)
    a.vm_mov_imm(0, 0)
    a.store(15, -64, 0)
    a.vm_mov_imm(0, 16)
    a.store(15, -72, 0)
    if a.os == 2 {
        a.vm_mov_imm(18, 1024)
        a.call("_rt_alloc")
        a.store(15, -104, 14)
        a.vm_mov_imm(4, 0)
        a.label("_rt_rd_wcopy")
        a.load(2, 15, -32)
        a.add(2, 2, 4)
        a.load_byte(5, 2, 0)
        a.load(3, 15, -104)
        a.add(3, 3, 4)
        a.store_byte(3, 0, 5)
        a.vm_cmp_imm(5, 0)
        a.jeq("_rt_rd_wcopy_done")
        a.vm_add_imm(4, 4, 1)
        a.jmp("_rt_rd_wcopy")
        a.label("_rt_rd_wcopy_done")
        a.load(3, 15, -104)
        a.add(3, 3, 4)
        a.vm_mov_imm(5, 92) // '\\' — FindFirstFileA wants a Windows wildcard
        a.store_byte(3, 0, 5)
        a.vm_add_imm(3, 3, 1)
        a.vm_mov_imm(5, 42)
        a.store_byte(3, 0, 5)
        a.vm_add_imm(3, 3, 1)
        a.vm_mov_imm(5, 0)
        a.store_byte(3, 0, 5)
        a.vm_mov_imm(18, 320)
        a.call("_rt_alloc")
        a.store(15, -48, 14)
        a.load(18, 15, -104)
        a.load(19, 15, -48)
        a.vm_call_iat("_iat_FindFirstFileA")
        rt_win_cmp_invalid_handle(a)
        a.jne("_rt_rd_wopened")
        a.jmp("_rt_rd_fail")
        a.label("_rt_rd_wopened")
        a.store(15, -40, 14)
        a.label("_rt_rd_went")
        a.load(5, 15, -48)
        a.vm_add_imm(5, 5, 44)
        a.vm_mov_imm(4, 0)
        a.label("_rt_rd_wstrlen")
        a.add(0, 5, 4)
        a.load_byte(1, 0, 0)
        a.vm_cmp_imm(1, 0)
        a.jeq("_rt_rd_wstrlen_done")
        a.vm_add_imm(4, 4, 1)
        a.jmp("_rt_rd_wstrlen")
        a.label("_rt_rd_wstrlen_done")
        a.vm_cmp_imm(4, 0)
        a.jeq("_rt_rd_wnext")
        a.load_byte(1, 5, 0)
        a.vm_cmp_imm(1, 46)
        a.jne("_rt_rd_wname")
        a.vm_cmp_imm(4, 1)
        a.jeq("_rt_rd_wnext")
        a.vm_cmp_imm(4, 2)
        a.jne("_rt_rd_wname")
        a.load_byte(1, 5, 1)
        a.vm_cmp_imm(1, 46)
        a.jeq("_rt_rd_wnext")
        a.label("_rt_rd_wname")
        a.mov(18, 15)
        a.vm_sub_imm(18, 18, 56)
        a.mov(19, 5)
        a.mov(20, 4)
        a.call("_rt_push_str")
        a.mov(18, 15)
        a.vm_sub_imm(18, 18, 56)
        a.lea(19, "_rt_rd_nl")
        a.vm_mov_imm(20, 1)
        a.call("_rt_push_str")
        a.label("_rt_rd_wnext")
        a.load(18, 15, -40)
        a.load(19, 15, -48)
        a.vm_call_iat("_iat_FindNextFileA")
        a.vm_cmp_imm(14, 0)
        a.jne("_rt_rd_went")
        a.load(18, 15, -40)
        a.vm_call_iat("_iat_FindClose")
        a.vm_mov_imm(0, 0)
        a.store(15, -40, 0)
        // The returned string owns the output buffer; release only the
        // cstr, wildcard, and FindData temporaries.
        a.load(0, 15, -104)
        a.vm_cbz(0, "_rt_rd_w_no_wild")
        a.mov(18, 0)
        a.call("_rt_free")
        a.label("_rt_rd_w_no_wild")
        a.load(0, 15, -48)
        a.vm_cbz(0, "_rt_rd_w_no_data")
        a.mov(18, 0)
        a.call("_rt_free")
        a.label("_rt_rd_w_no_data")
        rt_free_pathz(a, -32)
        a.load(0, 15, -8)
        a.vm_mov_imm(1, 0)
        a.store(0, 0, 1)
        a.load(1, 15, -56)
        a.store(0, -8, 1)
        a.load(1, 15, -64)
        a.store(0, -16, 1)
        a.load(1, 15, -72)
        a.store(0, -24, 1)
        a.epilogue()
        a.label("_rt_rd_fail")
        // FindFirstFile may fail before a handle is returned.  On later
        // failures close it exactly once, then release all frame-owned
        // allocations before constructing the error object.
        a.load(0, 15, -40)
        a.vm_cbz(0, "_rt_rd_w_no_handle")
        a.mov(18, 0)
        a.vm_call_iat("_iat_FindClose")
        a.vm_mov_imm(0, 0)
        a.store(15, -40, 0)
        a.label("_rt_rd_w_no_handle")
        a.load(0, 15, -48)
        a.vm_cbz(0, "_rt_rd_w_fail_no_data")
        a.mov(18, 0)
        a.call("_rt_free")
        a.label("_rt_rd_w_fail_no_data")
        a.load(0, 15, -104)
        a.vm_cbz(0, "_rt_rd_w_fail_no_wild")
        a.mov(18, 0)
        a.call("_rt_free")
        a.label("_rt_rd_w_fail_no_wild")
        a.load(0, 15, -56)
        a.vm_cbz(0, "_rt_rd_w_fail_no_out")
        a.mov(18, 0)
        a.call("_rt_free")
        a.label("_rt_rd_w_fail_no_out")
        rt_free_pathz(a, -32)
        rt_call_throw_strerr_static(a, -8, "_rt_rd_error", 16)
        a.epilogue()
        <<
    }
    a.vm_mov_imm(18, RT_DIR_READ_BUFFER_BYTES)
    a.call("_rt_alloc")
    a.store(15, -48, 14)
    if a.os == 1 && (a.arch == 0 || a.arch == 2 || a.arch == 4 || a.arch == 5) {
        a.vm_mov_imm(18, -100)
        a.load(19, 15, -32)
        a.vm_mov_imm(20, 0)
        a.vm_mov_imm(21, 0)
    } else {
        a.load(18, 15, -32)
        a.vm_mov_imm(19, 0)
        a.vm_mov_imm(20, 0)
    }
    a.vm_syscall(syscall_number(a.os, a.arch, 4))
    a.vm_normalize_syscall("_rt_rd_n1")
    a.vm_cmp_imm(14, 0)
    a.jge("_rt_rd_opened")
    a.jmp("_rt_rd_fail")
    a.label("_rt_rd_opened")
    a.store(15, -40, 14)
    a.vm_mov_imm(0, 0)
    a.store(15, -96, 0)
    a.label("_rt_rd_sys")
    a.load(18, 15, -40)
    a.load(19, 15, -48)
    a.vm_mov_imm(20, RT_DIR_READ_BUFFER_BYTES)
    if a.os == 0 {
        a.mov(21, 15)
        a.vm_sub_imm(21, 21, 96)
    }
    a.vm_syscall(syscall_number(a.os, a.arch, 9))
    a.vm_normalize_syscall("_rt_rd_n2")
    a.store(15, -80, 14)
    a.load(0, 15, -80)
    a.vm_cmp_imm(0, 0)
    a.jlt("_rt_rd_fail_close")
    a.jeq("_rt_rd_eof")
    a.vm_mov_imm(0, 0)
    a.store(15, -88, 0)
    a.label("_rt_rd_ent")
    a.load(0, 15, -88)
    a.load(1, 15, -80)
    a.cmp(0, 1)
    a.jge("_rt_rd_sys")
    a.load(2, 15, -48)
    a.add(2, 2, 0)
    a.load_byte(3, 2, 16)
    a.load_byte(4, 2, 17)
    a.shl_imm(4, 4, 8)
    a.add(3, 3, 4)
    a.vm_cmp_imm(3, 0)
    a.jeq("_rt_rd_eof")
    if a.os == 0 {
        a.load_byte(4, 2, 18)
        a.load_byte(5, 2, 19)
        a.shl_imm(5, 5, 8)
        a.add(4, 4, 5)
        a.vm_add_imm(5, 2, 21)
    } else {
        a.vm_add_imm(5, 2, 19)
        a.vm_mov_imm(4, 0)
        a.label("_rt_rd_strlen")
        a.add(0, 5, 4)
        a.load_byte(1, 0, 0)
        a.vm_cmp_imm(1, 0)
        a.jeq("_rt_rd_strlen_done")
        a.vm_add_imm(4, 4, 1)
        a.jmp("_rt_rd_strlen")
        a.label("_rt_rd_strlen_done")
    }
    a.vm_cmp_imm(4, 0)
    a.jeq("_rt_rd_next")
    a.load_byte(1, 5, 0)
    a.vm_cmp_imm(1, 46)
    a.jne("_rt_rd_name")
    a.vm_cmp_imm(4, 1)
    a.jeq("_rt_rd_next")
    a.vm_cmp_imm(4, 2)
    a.jne("_rt_rd_name")
    a.load_byte(1, 5, 1)
    a.vm_cmp_imm(1, 46)
    a.jeq("_rt_rd_next")
    a.label("_rt_rd_name")
    a.store(15, -112, 3)
    a.mov(18, 15)
    a.vm_sub_imm(18, 18, 56)
    a.mov(19, 5)
    a.mov(20, 4)
    a.call("_rt_push_str")
    a.mov(18, 15)
    a.vm_sub_imm(18, 18, 56)
    a.lea(19, "_rt_rd_nl")
    a.vm_mov_imm(20, 1)
    a.call("_rt_push_str")
    a.load(3, 15, -112)
    a.label("_rt_rd_next")
    a.load(0, 15, -88)
    a.add(0, 0, 3)
    a.store(15, -88, 0)
    a.jmp("_rt_rd_ent")
    a.label("_rt_rd_fail_close")
    a.load(18, 15, -40)
    a.vm_syscall(syscall_number(a.os, a.arch, 6))
    a.vm_mov_imm(0, 0)
    a.store(15, -40, 0)
    a.jmp("_rt_rd_fail")
    a.label("_rt_rd_eof")
    a.load(18, 15, -40)
    a.vm_syscall(syscall_number(a.os, a.arch, 6))
    a.vm_mov_imm(0, 0)
    a.store(15, -40, 0)
    // The result transfers ownership of the output buffer.  Release the
    // directory-read scratch and path cstr before returning it.
    a.load(0, 15, -48)
    a.vm_cbz(0, "_rt_rd_u_no_data")
    a.mov(18, 0)
    a.call("_rt_free")
    a.label("_rt_rd_u_no_data")
    rt_free_pathz(a, -32)
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.load(1, 15, -56)
    a.store(0, -8, 1)
    a.load(1, 15, -64)
    a.store(0, -16, 1)
    a.load(1, 15, -72)
    a.store(0, -24, 1)
    a.epilogue()
    a.label("_rt_rd_fail")
    // Open/readdir failures used to abandon both the output accumulator and
    // the 4 KiB directory buffer (plus the NUL-terminated path).  All slots
    // are initialized above, so this cleanup is safe for an early open error.
    a.load(0, 15, -48)
    a.vm_cbz(0, "_rt_rd_u_fail_no_data")
    a.mov(18, 0)
    a.call("_rt_free")
    a.label("_rt_rd_u_fail_no_data")
    a.load(0, 15, -56)
    a.vm_cbz(0, "_rt_rd_u_fail_no_out")
    a.mov(18, 0)
    a.call("_rt_free")
    a.label("_rt_rd_u_fail_no_out")
    rt_free_pathz(a, -32)
    rt_call_throw_strerr_static(a, -8, "_rt_rd_error", 16)
    a.epilogue()
    <<
}

fn rt_emit_write_file(a $&Assembler) {
    a.data_label("_rt_wf_error")
    rt_emit_bytes(a, "write_file failed\n")
    // sret -8, path ptr -16, path len -24, data ptr -32, data len -40,
    // pathZ -48, fd -56, written -64, n -72
    a.label("_rt_write_file")
    a.prologue(80)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.store(15, -32, 20)
    a.store(15, -40, 21)
    a.call("_rt_cstr")
    a.store(15, -48, 14)
    if rt_ui_mem_mailbox(&*a) {
        // Virtual writes can wait for events, invoke replies or bounded queue
        // capacity. Release M0 / make runnable peers progress before C parks.
        rt_jmp_if_xu_path(a, -48, "_rt_wf_prepare_host")
        a.jmp("_rt_wf_call_host")
        a.label("_rt_wf_prepare_host")
        a.call("_rt_enter_syscall")
        a.label("_rt_wf_call_host")
        a.vm_mov_imm(0, 0)
        a.store(15, -72, 0)
        if a.os == 2 && a.arch == 1 {
            a.load(21, 15, -48)
            a.load(20, 15, -32)
            a.load(22, 15, -40)
            a.mov(23, 15)
            a.vm_sub_imm(23, 23, 72)
            a.x64_sub_imm(4, 32)
            a.call("xu_ui_mem_try_write")
            a.x64_add_imm(4, 32)
        } else {
            a.load(18, 15, -48)
            a.load(19, 15, -32)
            a.load(20, 15, -40)
            a.mov(21, 15)
            a.vm_sub_imm(21, 21, 72)
            if a.os == 0 {
                a.call("_xu_ui_mem_try_write")
            } else {
                a.call("xu_ui_mem_try_write")
            }
        }
        a.vm_mov_imm64(0, 4294967295)
        a.iand(14, 14, 0)
        a.vm_cmp_imm(14, 1)
        a.jeq("_rt_wf_mem_ok")
        // ":xu:" must not fall through to CreateFile/open (pack has no such path).
        rt_jmp_if_xu_path(a, -48, "_rt_wf_xu_miss")
    }
    if a.os == 2 {
        a.load(18, 15, -48)
        a.vm_mov_imm(19, RT_WIN_GENERIC_WRITE) // GENERIC_WRITE
        a.vm_mov_imm(20, 3) // FILE_SHARE_READ|WRITE
        a.vm_mov_imm(21, 0)
        a.vm_mov_imm(22, 2) // CREATE_ALWAYS
        a.vm_mov_imm(23, 128)
        a.vm_call_iat7("_iat_CreateFileA")
        rt_win_cmp_invalid_handle(a)
        a.jne("_rt_wf_opened")
        a.jmp("_rt_wf_fail")
        a.label("_rt_wf_opened")
    } else {
        if a.os == 1 && (a.arch == 0 || a.arch == 2 || a.arch == 4 || a.arch == 5) {
            a.vm_mov_imm(18, -100)
            a.load(19, 15, -48)
            a.vm_mov_imm(20, open_flags_write(a.os))
            a.vm_mov_imm(21, 493) // 0755 — binaries (and other write_file outs) runnable
        } else {
            a.load(18, 15, -48)
            a.vm_mov_imm(19, open_flags_write(a.os))
            a.vm_mov_imm(20, 493)
        }
        a.vm_syscall(syscall_number(a.os, a.arch, 4))
        a.vm_normalize_syscall("_rt_wf_n1")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_wf_fail")
    }
    a.store(15, -56, 14)
    a.vm_mov_imm(0, 0)
    a.store(15, -64, 0)
    a.label("_rt_wf_loop")
    a.load(0, 15, -40)
    a.load(1, 15, -64)
    a.cmp(1, 0)
    a.jge("_rt_wf_done")
    a.load(18, 15, -56)
    a.load(19, 15, -32)
    a.add(19, 19, 1)
    a.sub(20, 0, 1)
    if a.os == 2 {
        a.lea(1, "_rt_written")
        a.vm_mov_imm(0, 0)
        a.store(1, 0, 0)
        a.mov(21, 1)
        a.vm_mov_imm(22, 0)
        a.vm_call_iat("_iat_WriteFile")
        rt_win_load_written(a)
    } else {
        a.vm_syscall(syscall_number(a.os, a.arch, 1))
        a.vm_normalize_syscall("_rt_wf_n2")
    }
    a.store(15, -72, 14)
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_wf_fail_close")
    a.load(0, 15, -64)
    a.add(0, 0, 14)
    a.store(15, -64, 0)
    a.jmp("_rt_wf_loop")
    a.label("_rt_wf_done")
    a.load(18, 15, -56)
    if a.os == 2 {
        a.vm_call_iat("_iat_CloseHandle")
    } else {
        a.vm_syscall(syscall_number(a.os, a.arch, 6))
    }
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.load(1, 15, -64)
    a.store(0, -8, 1)
    rt_free_pathz(a, -48)
    a.epilogue()
    a.label("_rt_wf_fail_close")
    a.load(18, 15, -56)
    if a.os == 2 {
        a.vm_call_iat("_iat_CloseHandle")
    } else {
        a.vm_syscall(syscall_number(a.os, a.arch, 6))
    }
    a.label("_rt_wf_fail")
    rt_free_pathz(a, -48)
    rt_emit_file_error(a, "_rt_wf_error")
    if rt_ui_mem_mailbox(&*a) {
        a.label("_rt_wf_xu_miss")
        // Virtual path but try_write returned 0 (weak stub) — treat as ok write of 0.
        a.load(0, 15, -8)
        a.vm_mov_imm(1, 0)
        a.store(0, 0, 1)
        a.store(0, -8, 1)
        rt_free_pathz(a, -48)
        a.epilogue()
        a.label("_rt_wf_mem_ok")
        // A handled virtual path may reject a write (capacity/validation/OOM).
        // Propagate that failure instead of reporting the requested byte count.
        a.load(0, 15, -72)
        a.load(1, 15, -40)
        a.cmp(0, 1)
        a.jne("_rt_wf_fail")
        a.load(0, 15, -8)
        a.vm_mov_imm(1, 0)
        a.store(0, 0, 1)
        a.load(1, 15, -40)
        a.store(0, -8, 1)
        rt_free_pathz(a, -48)
        a.epilogue()
        if a.os == 0 {
            a.label("_xu_ui_mem_try_write")
            a.prologue(16)
            a.vm_mov_imm(14, 0)
            a.epilogue()
        } else {
            a.label("xu_ui_mem_try_write")
            a.prologue(16)
            a.vm_mov_imm(14, 0)
            a.epilogue()
        }
    }
    <<
}

fn rt_emit_os_open(a $&Assembler) {
    a.label("_rt_os_open")
    a.prologue(48)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.store(15, -32, 20)
    a.call("_rt_cstr")
    a.store(15, -40, 14)
    a.load(2, 15, -32)
    if a.os == 2 {
        a.load(18, 15, -40)
        a.vm_mov_imm64(19, RT_WIN_GENERIC_READ) // GENERIC_READ
        a.vm_cmp_imm(2, 0)
        a.jeq("_rt_oo_win_rd")
        a.vm_mov_imm(19, RT_WIN_GENERIC_WRITE)
        a.label("_rt_oo_win_rd")
        a.vm_mov_imm(20, 3) // FILE_SHARE_READ|WRITE
        a.vm_cmp_imm(2, 4)
        a.jlt("_rt_oo_win_shared")
        a.vm_mov_imm(20, 0) // Exclusive handle, released by CloseHandle/exit
        a.vm_mov_imm64(19, RT_WIN_GENERIC_READ)
        a.vm_cmp_imm(2, 5)
        a.jeq("_rt_oo_win_shared")
        a.vm_mov_imm64(19, 3221225472) // GENERIC_READ|WRITE
        a.label("_rt_oo_win_shared")
        a.vm_mov_imm(21, 0)
        a.vm_mov_imm(22, 3)
        a.vm_cmp_imm(2, 1)
        a.jne("_rt_oo_win_m3")
        a.vm_mov_imm(22, 2)
        a.label("_rt_oo_win_m3")
        a.vm_cmp_imm(2, 3)
        a.jne("_rt_oo_win_disp")
        a.vm_mov_imm(22, 1)
        a.label("_rt_oo_win_disp")
        a.vm_cmp_imm(2, 4)
        a.jne("_rt_oo_win_lock_disp")
        a.vm_mov_imm(22, 4) // OPEN_ALWAYS
        a.label("_rt_oo_win_lock_disp")
        a.vm_mov_imm(23, 128)
        a.vm_call_iat7("_iat_CreateFileA")
        rt_win_cmp_invalid_handle(a)
        a.jeq("_rt_oo_fail")
    } else {
        a.vm_mov_imm(3, 0)
        a.vm_cmp_imm(2, 1)
        a.jne("_rt_oo_m2")
        a.vm_mov_imm(3, open_flags_write(a.os))
        a.label("_rt_oo_m2")
        a.vm_cmp_imm(2, 2)
        a.jne("_rt_oo_m3")
        a.vm_mov_imm(3, open_flags_mode(a.os, 2))
        a.label("_rt_oo_m3")
        a.vm_cmp_imm(2, 3)
        a.jne("_rt_oo_flags")
        a.vm_mov_imm(3, open_flags_excl(a.os))
        a.label("_rt_oo_flags")
        a.vm_cmp_imm(2, 4)
        a.jlt("_rt_oo_lock_flags_done")
        // No truncation; no symlink following; do not inherit the lock in
        // curl/git children. Darwin can acquire flock atomically at open.
        if a.os == 0 {
            a.vm_mov_imm(3, 16777508) // O_CLOEXEC|O_NOFOLLOW|O_EXLOCK|O_NONBLOCK
            a.vm_cmp_imm(2, 5)
            a.jeq("_rt_oo_lock_flags_done")
            a.vm_mov_imm(3, 16778022) // plus O_RDWR|O_CREAT
        } else {
            a.vm_mov_imm(3, 655360) // O_CLOEXEC|O_NOFOLLOW
            a.vm_cmp_imm(2, 5)
            a.jeq("_rt_oo_lock_flags_done")
            a.vm_mov_imm(3, 655426) // plus O_RDWR|O_CREAT
        }
        a.label("_rt_oo_lock_flags_done")
        if a.os == 1 && (a.arch == 0 || a.arch == 2 || a.arch == 4 || a.arch == 5) {
            a.vm_mov_imm(18, -100)
            a.load(19, 15, -40)
            a.mov(20, 3)
            a.vm_mov_imm(21, 420)
        } else {
            a.load(18, 15, -40)
            a.mov(19, 3)
            a.vm_mov_imm(20, 420)
        }
        a.vm_syscall(syscall_number(a.os, a.arch, 4))
        a.vm_normalize_syscall("_rt_oo_n1")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_oo_fail")
        if a.os == 1 {
            a.store(15, -48, 14)
            a.load(2, 15, -32)
            a.vm_cmp_imm(2, 4)
            a.jlt("_rt_oo_flock_done")
            a.mov(18, 14)
            a.vm_mov_imm(19, 6) // LOCK_EX|LOCK_NB
            a.vm_syscall(syscall_number(a.os, a.arch, 47))
            a.vm_cmp_imm(14, 0)
            a.jge("_rt_oo_flock_done")
            a.store(15, -32, 14)
            a.load(18, 15, -48)
            a.vm_syscall(syscall_number(a.os, a.arch, 6))
            a.load(14, 15, -32)
            a.jmp("_rt_oo_fail")
            a.label("_rt_oo_flock_done")
            a.load(14, 15, -48)
        }
    }
    // Preserve the returned descriptor while releasing the temporary cstr.
    // `_rt_free` clobbers caller-saved V0/X8/RAX on every hosted target, so
    // the sret pointer must be reloaded after the free — not before.
    a.store(15, -48, 14)
    rt_free_pathz(a, -40)
    a.load(0, 15, -8)
    a.load(14, 15, -48)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 14)
    a.epilogue()
    a.label("_rt_oo_fail")
    if a.os == 2 {
        a.vm_mov_imm(18, 2)
    } else {
        a.neg(18, 14)
    }
    a.store(15, -48, 18)
    rt_free_pathz(a, -40)
    a.load(18, 15, -48)
    a.call("_rt_errno_msg")
    rt_call_throw_strerr_args(a, -8)
    a.epilogue()
    <<
}

// Windows fd APIs accept native HANDLEs from os_open/os_pipe, and the
// conventional 0/1/2 for redirected standard streams. No CRT fd table exists.
fn rt_emit_win_fd_handle(a $&Assembler) {
    a.label("_rt_win_fd_handle")
    a.prologue(16)
    a.vm_cmp_imm(18, 0)
    a.jlt("_rt_wfh_done")
    a.vm_cmp_imm(18, 2)
    a.jgt("_rt_wfh_done")
    a.vm_mov_imm(1, -10) // STD_INPUT_HANDLE, STD_OUTPUT_HANDLE, STD_ERROR_HANDLE
    a.sub(18, 1, 18)
    a.vm_call_iat("_iat_GetStdHandle")
    a.mov(18, 14)
    a.label("_rt_wfh_done")
    a.epilogue()
}

// Non-consuming Windows file probe. No overlapped read, helper thread, or
// handle-mode change: anonymous stdio pipes need synchronous HANDLEs. The
// caller must exclusively own reads; synchronous PeekNamedPipe can block
// behind another thread's pending I/O on the same handle. Console signals
// include non-key events and do not promise a complete line to ReadFile.
fn rt_emit_fd_peek_read(a $&Assembler) {
    a.data_label("_rt_fd_wait_failed")
    rt_emit_bytes(a, "os: fd wait failed")
    a.data_label("_rt_fd_wait_unsupported")
    rt_emit_bytes(a, "os: unsupported handle type")
    if a.os == 2 { rt_emit_win_fd_handle(a) }
    a.label("_rt_fd_peek_read")
    a.prologue(32)
    a.store(15, -8, 0)
    if a.os == 2 {
        a.call("_rt_win_fd_handle")
        a.store(15, -16, 18)
        a.vm_call_iat("_iat_GetFileType")
        a.vm_cmp_imm(14, 1) // FILE_TYPE_DISK: reads/EOF never wait for input.
        a.jeq("_rt_fpr_ready")
        a.vm_cmp_imm(14, 2) // FILE_TYPE_CHAR
        a.jeq("_rt_fpr_char")
        a.vm_cmp_imm(14, 3) // FILE_TYPE_PIPE (Winsock SOCKETs are unsupported).
        a.jeq("_rt_fpr_pipe")
        a.vm_cbnz(14, "_rt_fpr_unsupported")
        a.vm_call_iat("_iat_GetLastError")
        a.vm_cbnz(14, "_rt_fpr_fail")
        a.jmp("_rt_fpr_unsupported")
        a.label("_rt_fpr_pipe")
        a.vm_mov_imm(1, 0)
        a.store(15, -24, 1) // Zero all 8 bytes; PeekNamedPipe writes a DWORD.
        a.load(18, 15, -16)
        a.vm_mov_imm(19, 0)
        a.vm_mov_imm(20, 0)
        a.vm_mov_imm(21, 0)
        a.vm_sub_imm(22, 15, 24)
        a.vm_mov_imm(23, 0)
        // The existing seven-argument bridge also passes A5 on Win64's
        // stack. PeekNamedPipe takes six arguments and ignores the NULL tail.
        a.vm_call_iat7("_iat_PeekNamedPipe")
        a.vm_cbz(14, "_rt_fpr_pipe_error")
        a.load(1, 15, -24)
        a.vm_cbnz(1, "_rt_fpr_ready")
        a.jmp("_rt_fpr_pending")
        a.label("_rt_fpr_pipe_error")
        a.vm_call_iat("_iat_GetLastError")
        a.vm_cmp_imm(14, 109) // ERROR_BROKEN_PIPE: next ReadFile yields EOF.
        a.jeq("_rt_fpr_ready")
        a.jmp("_rt_fpr_fail")
        a.label("_rt_fpr_char")
        a.load(18, 15, -16)
        a.vm_mov_imm(19, 0)
        a.vm_call_iat("_iat_WaitForSingleObject")
        a.vm_cbz(14, "_rt_fpr_ready") // WAIT_OBJECT_0
        a.vm_cmp_imm(14, 258) // WAIT_TIMEOUT
        a.jne("_rt_fpr_fail")
        a.label("_rt_fpr_pending")
        a.vm_mov_imm(14, 0)
        a.jmp("_rt_fpr_ok")
        a.label("_rt_fpr_ready")
        a.vm_mov_imm(14, 1)
        a.label("_rt_fpr_ok")
        a.load(0, 15, -8)
        a.vm_mov_imm(1, 0)
        a.store(0, 0, 1)
        a.store(0, -8, 14)
        a.epilogue()
        a.label("_rt_fpr_fail")
        rt_call_throw_strerr_static(a, -8, "_rt_fd_wait_failed", 18)
        a.epilogue()
    }
    a.label("_rt_fpr_unsupported")
    rt_call_throw_strerr_static(a, -8, "_rt_fd_wait_unsupported", 27)
    a.epilogue()
}

fn rt_emit_os_fd_read(a $&Assembler) {
    a.label("_rt_os_fd_read")
    a.prologue(48)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.load(1, 15, -24)
    a.vm_cmp_imm(1, 0)
    a.jle("_rt_frd_empty")
    a.mov(18, 1)
    a.call("_rt_alloc")
    a.store(15, -32, 14)
    // Pipe/terminal reads can block. Hand runnable peers to a worker first.
    a.call("_rt_enter_syscall")
    a.load(18, 15, -16)
    if a.os == 2 { a.call("_rt_win_fd_handle") }
    a.load(19, 15, -32)
    a.load(20, 15, -24)
    if a.os == 2 {
        a.mov(1, 15)
        a.vm_sub_imm(1, 1, 48)
        a.vm_mov_imm(0, 0)
        a.store(1, 0, 0)
        a.mov(21, 1)
        a.vm_mov_imm(22, 0)
        a.vm_call_iat("_iat_ReadFile")
        a.load(14, 15, -48)
    } else {
        a.vm_syscall(syscall_number(a.os, a.arch, 5))
        a.vm_normalize_syscall("_rt_frd_n")
    }
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_frd_fail")
    a.store(15, -40, 14)
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.load(1, 15, -32)
    a.store(0, -8, 1)
    a.load(1, 15, -40)
    a.store(0, -16, 1)
    a.load(1, 15, -24)
    a.store(0, -24, 1)
    a.epilogue()
    a.label("_rt_frd_fail")
    a.store(15, -40, 14)
    a.load(18, 15, -32)
    a.call("_rt_free")
    a.load(14, 15, -40)
    a.neg(18, 14)
    a.call("_rt_errno_msg")
    rt_call_throw_strerr_args(a, -8)
    a.epilogue()
    a.label("_rt_frd_empty")
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 1)
    a.store(0, -16, 1)
    a.store(0, -24, 1)
    a.epilogue()
    <<
}

fn rt_emit_os_fd_write(a $&Assembler) {
    a.label("_rt_os_fd_write")
    a.prologue(48)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.store(15, -24, 19)
    a.store(15, -32, 20)
    // Backpressure on stdout must not suspend unrelated coroutines.
    a.call("_rt_enter_syscall")
    a.load(18, 15, -16)
    if a.os == 2 { a.call("_rt_win_fd_handle") }
    a.load(19, 15, -24)
    a.load(20, 15, -32)
    if a.os == 2 {
        a.mov(1, 15)
        a.vm_sub_imm(1, 1, 48)
        a.vm_mov_imm(0, 0)
        a.store(1, 0, 0)
        a.mov(21, 1)
        a.vm_mov_imm(22, 0)
        a.vm_call_iat("_iat_WriteFile")
        a.load(14, 15, -48)
    } else {
        a.vm_syscall(syscall_number(a.os, a.arch, 1))
        a.vm_normalize_syscall("_rt_fwr_n")
    }
    a.vm_cmp_imm(14, 0)
    a.jlt("_rt_fwr_fail")
    if xacp_output_supported(&*a) {
        a.store(15, -40, 14)
        a.load(18, 15, -16)
        a.load(19, 15, -24)
        a.load(20, 15, -40) // Preserve the byte count while loading fd into A0.
        a.call("_rt_xacp_output_append")
        a.load(14, 15, -40)
    }
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 14)
    a.epilogue()
    a.label("_rt_fwr_fail")
    a.neg(18, 14)
    a.call("_rt_errno_msg")
    rt_call_throw_strerr_args(a, -8)
    a.epilogue()
    <<
}

fn rt_emit_os_fd_close(a $&Assembler) {
    a.label("_rt_os_fd_close")
    a.prologue(16)
    a.store(15, -8, 0)
    a.store(15, -16, 18)
    a.load(18, 15, -16)
    if a.os == 2 {
        a.vm_call_iat("_iat_CloseHandle")
        a.vm_cbz(14, "_rt_fcl_fail")
    } else {
        a.vm_syscall(syscall_number(a.os, a.arch, 6))
        a.vm_normalize_syscall("_rt_fcl_n")
        a.vm_cmp_imm(14, 0)
        a.jlt("_rt_fcl_fail")
    }
    a.load(0, 15, -8)
    a.vm_mov_imm(1, 0)
    a.store(0, 0, 1)
    a.store(0, -8, 1)
    a.epilogue()
    a.label("_rt_fcl_fail")
    if a.os == 2 {
        a.vm_mov_imm(18, 5)
    } else {
        a.neg(18, 14)
    }
    a.call("_rt_errno_msg")
    rt_call_throw_strerr_args(a, -8)
    a.epilogue()
    <<
}

// args(): a shallow, non-owning descriptor view of the collected argv.
