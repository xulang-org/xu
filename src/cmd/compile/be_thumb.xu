@main
// Thumb-2 backend: AAPCS32, r0–r3 args, r7 frame pointer.
// E1 operates on the low 32 bits of each 8-byte MIR slot.

fn tmap_reg(v int) int {
    if v == 0 { << 12 } // V0 = r12
    if v == 1 { << 3 }  // V1 = r3
    if v == 2 { << 2 }  // V2 = r2
    if v == 3 { << 6 }  // V3 = r6
    if v == 4 { << 4 }  // V4 = r4
    if v == 5 { << 5 }  // V5 = r5
    if v == 6 { << 8 }  // V6 = r8
    if v == 7 { << 9 }  // V7 = r9
    if v == 8 { << 8 }  // S0 = r8
    if v == 9 { << 9 }  // S1 = r9
    if v == 10 { << 4 }  // S2 = r4
    if v == 11 { << 5 }  // S3 = r5
    if v == 12 { << 1 }  // S4 = r1
    if v == 13 { << 8 }  // S5 = r8
    if v == 14 { << 0 }  // Ret = r0
    if v == 15 { << 7 }  // Fp = r7
    if v == 16 { << 13 } // Sp
    if v == 17 { << 14 } // Lr
    if v == 18 { << 0 }  // A0
    if v == 19 { << 1 }
    if v == 20 { << 2 }
    if v == 21 { << 3 }
    if v == 22 { << 10 } // A4
    if v == 23 { << 11 } // A5
    eprintln("E1: unknown vreg")
    <<< 1
    << 0
}

fn e1_thumb_unimp(op string) {
    eprintln("E1 Thumb backend does not implement " + op)
    <<< 1
}

fn (a &mut Assembler) tbe_mov(dest int, src int) {
    a.t_mov_reg(tmap_reg(dest), tmap_reg(src))
}
fn (a &mut Assembler) tbe_mov_imm(dest int, imm int) {
    a.t_mov_imm(tmap_reg(dest), imm)
}
fn (a &mut Assembler) tbe_mov_imm64(dest int, imm int) {
    a.t_mov_imm64(tmap_reg(dest), imm)
}
fn (a &mut Assembler) tbe_lea(dest int, label string) {
    a.t_lea_abs(tmap_reg(dest), label)
}
fn (a &mut Assembler) tbe_load(dest int, base int, offset int) {
    a.t_load_offset(tmap_reg(dest), tmap_reg(base), offset)
}
fn (a &mut Assembler) tbe_store(base int, offset int, src int) {
    a.t_store_offset(tmap_reg(src), tmap_reg(base), offset)
}
fn (a &mut Assembler) tbe_store_byte(base int, offset int, src int) {
    a.t_store_byte_offset(tmap_reg(src), tmap_reg(base), offset)
}
fn (a &mut Assembler) tbe_load_byte(dest int, base int, offset int) {
    a.t_load_byte_offset(tmap_reg(dest), tmap_reg(base), offset)
}
fn (a &mut Assembler) tbe_add(dest int, x int, y int) {
    a.t_add_reg(tmap_reg(dest), tmap_reg(x), tmap_reg(y))
}
fn (a &mut Assembler) tbe_add_imm(dest int, src int, imm int) {
    a.t_add_imm(tmap_reg(dest), tmap_reg(src), imm)
}
fn (a &mut Assembler) tbe_sub(dest int, x int, y int) {
    a.t_sub_reg(tmap_reg(dest), tmap_reg(x), tmap_reg(y))
}
fn (a &mut Assembler) tbe_sub_imm(dest int, src int, imm int) {
    a.t_sub_imm(tmap_reg(dest), tmap_reg(src), imm)
}
fn (a &mut Assembler) tbe_mul(dest int, x int, y int) {
    a.t_mul(tmap_reg(dest), tmap_reg(x), tmap_reg(y))
}
fn (a &mut Assembler) tbe_div(dest int, x int, y int) {
    a.t_sdiv(tmap_reg(dest), tmap_reg(x), tmap_reg(y))
}
fn (a &mut Assembler) tbe_mod(dest int, x int, y int) {
    ra := tmap_reg(x)
    rb := tmap_reg(y)
    rd := tmap_reg(dest)
    mut q := 1
    if ra == 1 || rb == 1 || rd == 1 {
        q = 6
    }
    a.t_sdiv(q, ra, rb)
    a.t_mls(rd, q, rb, ra)
}
fn (a &mut Assembler) tbe_neg(dest int, src int) {
    a.t_neg_reg(tmap_reg(dest), tmap_reg(src))
}
fn (a &mut Assembler) tbe_shl_imm(dest int, src int, imm int) {
    a.t_lsl_imm(tmap_reg(dest), tmap_reg(src), imm)
}
fn (a &mut Assembler) tbe_shr_imm(dest int, src int, imm int) {
    a.t_lsr_imm(tmap_reg(dest), tmap_reg(src), imm)
}
fn (a &mut Assembler) tbe_and(dest int, x int, y int) {
    a.t_and_reg(tmap_reg(dest), tmap_reg(x), tmap_reg(y))
}
fn (a &mut Assembler) tbe_or(dest int, x int, y int) {
    a.t_orr_reg(tmap_reg(dest), tmap_reg(x), tmap_reg(y))
}
fn (a &mut Assembler) tbe_xor(dest int, x int, y int) {
    a.t_eor_reg(tmap_reg(dest), tmap_reg(x), tmap_reg(y))
}
fn (a &mut Assembler) tbe_shl(dest int, src int, count int) {
    a.t_lsl_reg(tmap_reg(dest), tmap_reg(src), tmap_reg(count))
}
fn (a &mut Assembler) tbe_shr(dest int, src int, count int) {
    a.t_asr_reg(tmap_reg(dest), tmap_reg(src), tmap_reg(count))
}
fn (a &mut Assembler) tbe_cmp(x int, y int) {
    a.t_cmp_reg(tmap_reg(x), tmap_reg(y))
}
fn (a &mut Assembler) tbe_cmp_imm(x int, imm int) {
    a.t_cmp_imm(tmap_reg(x), imm)
}
fn (a &mut Assembler) tbe_cset(dest int, cond int) {
    if cond == 6 {
        e1_thumb_unimp("cset Vs")
    }
    a.drop_seq = a.drop_seq + 1
    mut labs := []string{}
    labs.push("_xu_cset_" + str(a.drop_seq))
    a.tbe_mov_imm(dest, 0)
    a.t_bcond(cond ^ 1, labs[0])
    a.tbe_mov_imm(dest, 1)
    a.label(labs[0])
}
fn (a &mut Assembler) tbe_jmp(label string) { a.t_b(label) }
fn (a &mut Assembler) tbe_jeq(label string) { a.t_beq(label) }
fn (a &mut Assembler) tbe_jne(label string) { a.t_bne(label) }
fn (a &mut Assembler) tbe_jlt(label string) { a.t_blt(label) }
fn (a &mut Assembler) tbe_jle(label string) { a.t_ble(label) }
fn (a &mut Assembler) tbe_jgt(label string) { a.t_bgt(label) }
fn (a &mut Assembler) tbe_jge(label string) { a.t_bge(label) }
fn (a &mut Assembler) tbe_jae(label string) { a.t_bhs(label) }
fn (a &mut Assembler) tbe_cbz(reg int, label string) {
    mut tmp := []string{}
    tmp.push(label)
    a.tbe_cmp_imm(reg, 0)
    a.t_beq(tmp[0])
}
fn (a &mut Assembler) tbe_cbnz(reg int, label string) {
    mut tmp := []string{}
    tmp.push(label)
    a.tbe_cmp_imm(reg, 0)
    a.t_bne(tmp[0])
}
fn (a &mut Assembler) tbe_prologue(frame_size int) {
    a.t_push_r4_r5_r6_r8()
    a.t_push_r7_lr()
    a.t_mov_reg(7, 13)
    if frame_size > 0 {
        a.t_sub_sp(frame_size)
    }
}
fn (a &mut Assembler) tbe_epilogue() {
    a.t_mov_reg(13, 7)
    a.t_pop_r7_lr()
    a.t_pop_r4_r5_r6_r8()
    a.t_bx_lr()
}
fn (a &mut Assembler) tbe_call(label string) { a.t_bl(label) }
fn (a &mut Assembler) tbe_call_reg(target int) { a.t_blx(tmap_reg(target)) }
fn (a &mut Assembler) tbe_ret() { a.t_bx_lr() }

fn (a &mut Assembler) halt() {
    if a.arch == 3 {
        a.rv_halt()
        <<
    }
    a.t_cpsid_i()
    a.t_wfi()
}
fn (a &mut Assembler) irq_off() {
    if a.arch == 3 {
        a.rv_irq_off()
        <<
    }
    a.t_cpsid_i()
}
fn (a &mut Assembler) irq_on() {
    if a.arch == 3 {
        a.rv_irq_on()
        <<
    }
    a.t_cpsie_i()
}
fn (a &mut Assembler) read_ipsr(dest int) {
    if a.arch == 3 {
        a.rbe_mov_imm(dest, 0)
        <<
    }
    a.t_mrs_ipsr(tmap_reg(dest))
}
