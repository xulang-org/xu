@main
// Thumb-2 backend: AAPCS32, r0–r3 args, r7 frame pointer.
// E1 operates on the low 32 bits of each 8-byte MIR slot.

fn e1_thumb_unimp(op string) {
    eprintln("E1 Thumb backend does not implement " + op)
    <<< 1
}

fn (a $&Assembler) tbe_mov(dest int, src int) {
    a.t_mov_reg(td_thumb_phys(dest), td_thumb_phys(src))
}
fn (a $&Assembler) tbe_mov_imm(dest int, imm int) {
    a.t_mov_imm(td_thumb_phys(dest), imm)
}
fn (a $&Assembler) tbe_mov_imm64(dest int, imm int) {
    a.t_mov_imm64(td_thumb_phys(dest), imm)
}
fn (a $&Assembler) tbe_lea(dest int, label string) {
    a.t_lea_abs(td_thumb_phys(dest), label)
}
fn (a $&Assembler) tbe_load(dest int, base int, offset int) {
    a.t_load_offset(td_thumb_phys(dest), td_thumb_phys(base), offset)
}
fn (a $&Assembler) tbe_store(base int, offset int, src int) {
    a.t_store_offset(td_thumb_phys(src), td_thumb_phys(base), offset)
}
fn (a $&Assembler) tbe_store_byte(base int, offset int, src int) {
    a.t_store_byte_offset(td_thumb_phys(src), td_thumb_phys(base), offset)
}
fn (a $&Assembler) tbe_load_byte(dest int, base int, offset int) {
    a.t_load_byte_offset(td_thumb_phys(dest), td_thumb_phys(base), offset)
}
fn (a $&Assembler) tbe_add(dest int, x int, y int) {
    a.t_add_reg(td_thumb_phys(dest), td_thumb_phys(x), td_thumb_phys(y))
}
fn (a $&Assembler) tbe_add_imm(dest int, src int, imm int) {
    a.t_add_imm(td_thumb_phys(dest), td_thumb_phys(src), imm)
}
fn (a $&Assembler) tbe_sub(dest int, x int, y int) {
    a.t_sub_reg(td_thumb_phys(dest), td_thumb_phys(x), td_thumb_phys(y))
}
fn (a $&Assembler) tbe_sub_imm(dest int, src int, imm int) {
    a.t_sub_imm(td_thumb_phys(dest), td_thumb_phys(src), imm)
}
fn (a $&Assembler) tbe_mul(dest int, x int, y int) {
    a.t_mul(td_thumb_phys(dest), td_thumb_phys(x), td_thumb_phys(y))
}
fn (a $&Assembler) tbe_div(dest int, x int, y int) {
    a.t_sdiv(td_thumb_phys(dest), td_thumb_phys(x), td_thumb_phys(y))
}
fn (a $&Assembler) tbe_mod(dest int, x int, y int) {
    ra := td_thumb_phys(x)
    rb := td_thumb_phys(y)
    rd := td_thumb_phys(dest)
    $q := 1
    if ra == 1 || rb == 1 {
        q = 12
        if ra == 12 || rb == 12 {
            q = 3
        }
    }
    a.t_sdiv(q, ra, rb)
    a.t_mls(rd, q, rb, ra)
}
fn (a $&Assembler) tbe_neg(dest int, src int) {
    a.t_neg_reg(td_thumb_phys(dest), td_thumb_phys(src))
}
fn (a $&Assembler) tbe_shl_imm(dest int, src int, imm int) {
    a.t_lsl_imm(td_thumb_phys(dest), td_thumb_phys(src), imm)
}
fn (a $&Assembler) tbe_shr_imm(dest int, src int, imm int) {
    a.t_lsr_imm(td_thumb_phys(dest), td_thumb_phys(src), imm)
}
fn (a $&Assembler) tbe_and(dest int, x int, y int) {
    a.t_and_reg(td_thumb_phys(dest), td_thumb_phys(x), td_thumb_phys(y))
}
fn (a $&Assembler) tbe_and_imm(dest int, src int, imm int) {
    a.t_and_imm(td_thumb_phys(dest), td_thumb_phys(src), imm)
}
fn (a $&Assembler) tbe_or(dest int, x int, y int) {
    a.t_orr_reg(td_thumb_phys(dest), td_thumb_phys(x), td_thumb_phys(y))
}
fn (a $&Assembler) tbe_xor(dest int, x int, y int) {
    a.t_eor_reg(td_thumb_phys(dest), td_thumb_phys(x), td_thumb_phys(y))
}
fn (a $&Assembler) tbe_shl(dest int, src int, count int) {
    a.t_lsl_reg(td_thumb_phys(dest), td_thumb_phys(src), td_thumb_phys(count))
}
fn (a $&Assembler) tbe_shr(dest int, src int, count int) {
    a.t_asr_reg(td_thumb_phys(dest), td_thumb_phys(src), td_thumb_phys(count))
}
fn (a $&Assembler) tbe_cmp(x int, y int) {
    a.t_cmp_reg(td_thumb_phys(x), td_thumb_phys(y))
}
fn (a $&Assembler) tbe_cmp_imm(x int, imm int) {
    a.t_cmp_imm(td_thumb_phys(x), imm)
}
fn (a $&Assembler) tbe_cset(dest int, cond int) {
    if cond == 6 {
        e1_thumb_unimp("cset Vs")
    }
    a.drop_seq = a.drop_seq + 1
    $labs := []string{}
    labs.push("_xu_cset_" + str(a.drop_seq))
    // Use 32-bit MOVW #0 so APSR condition flags remain intact for t_bcond.
    a.t_movw(td_thumb_phys(dest), 0)
    a.t_bcond(cond ^ 1, labs[0])
    a.tbe_mov_imm(dest, 1)
    a.label(labs[0])
}
fn (a $&Assembler) tbe_jmp(label string) { a.t_b(label) }
fn (a $&Assembler) tbe_jeq(label string) { a.t_beq(label) }
fn (a $&Assembler) tbe_jne(label string) { a.t_bne(label) }
fn (a $&Assembler) tbe_jlt(label string) { a.t_blt(label) }
fn (a $&Assembler) tbe_jle(label string) { a.t_ble(label) }
fn (a $&Assembler) tbe_jgt(label string) { a.t_bgt(label) }
fn (a $&Assembler) tbe_jge(label string) { a.t_bge(label) }
fn (a $&Assembler) tbe_jae(label string) { a.t_bhs(label) }
fn (a $&Assembler) tbe_cbz(reg int, label string) {
    a.t_cbz(td_thumb_phys(reg), label)
}
fn (a $&Assembler) tbe_cbnz(reg int, label string) {
    a.t_cbnz(td_thumb_phys(reg), label)
}
fn (a $&Assembler) tbe_prologue(frame_size int) {
    mask := thumb_cs_effective(a.cs_pairs)
    if (mask & 0x0F00) != 0 {
        a.t_emit32(0xE92D, mask)
    } else if (mask & 0x0070) != 0 {
        a.t_emit16(0xB400 | (mask & 0x00FF))
    }
    a.t_push_r7_lr()
    a.t_mov_reg(7, 13)
    if frame_size > 0 {
        a.t_sub_sp(frame_size)
    }
}
fn (a $&Assembler) tbe_epilogue() {
    a.t_mov_reg(13, 7)
    mask := thumb_cs_effective(a.cs_pairs)
    if mask == 0 {
        a.t_pop_r7_pc()
        <<
    }
    a.t_pop_r7_lr()
    if (mask & 0x0F00) != 0 {
        a.t_emit32(0xE8BD, mask)
    } else if (mask & 0x0070) != 0 {
        a.t_emit16(0xBC00 | (mask & 0x00FF))
    }
    a.t_bx_lr()
}
fn (a $&Assembler) tbe_call(label string) { a.t_bl(label) }
fn (a $&Assembler) tbe_call_reg(target int) { a.t_blx(td_thumb_phys(target)) }
fn (a $&Assembler) tbe_ret() { a.t_bx_lr() }

fn (a $&Assembler) halt() {
    if a.arch == 3 {
        a.rv_halt()
        <<
    }
    a.t_cpsid_i()
    a.t_wfi()
}
fn (a $&Assembler) irq_off() {
    if a.arch == 3 {
        a.rv_irq_off()
        <<
    }
    a.t_cpsid_i()
}
fn (a $&Assembler) irq_on() {
    if a.arch == 3 {
        a.rv_irq_on()
        <<
    }
    a.t_cpsie_i()
}
fn (a $&Assembler) read_ipsr(dest int) {
    if a.arch == 3 {
        a.rbe_mov_imm(dest, 0)
        <<
    }
    a.t_mrs_ipsr(td_thumb_phys(dest))
}

fn (a $&Assembler) tbe_load64(rdlo int, rdhi int, base int, offset int) {
    a.t_load64_offset(td_thumb_phys(rdlo), td_thumb_phys(rdhi), td_thumb_phys(base), offset)
}

fn (a $&Assembler) tbe_store64(base int, offset int, rslo int, rshi int) {
    a.t_store64_offset(td_thumb_phys(rslo), td_thumb_phys(rshi), td_thumb_phys(base), offset)
}
