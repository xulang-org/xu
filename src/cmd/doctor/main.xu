@main
// xu-doctor — check host tools for desktop pack (product tool; NOT bootstrap).
// User: `xu-doctor [--target T] [--webview]` or via `xu doctor`.
// Host-aware: Darwin / Linux / Windows binaries (xu_target_os) use portable PATH
// probes; default "all" only requires toolchains that this host can actually pack.

#os
#path/filepath
#errors

fn str_clone(s &string) string {
    << s + ""
}

fn parse_target(s string) int {
    if s == "macos-arm64" { << 0 }
    if s == "macos-x64" { << 1 }
    if s == "linux-arm64" { << 10 }
    if s == "linux-x64" { << 11 }
    if s == "windows-arm64" { << 20 }
    if s == "windows-x64" { << 21 }
    << -1
}

fn target_os(t int) int {
    << t / 10
}

fn target_name(t int) string {
    if t == 0 { << "macos-arm64" }
    if t == 1 { << "macos-x64" }
    if t == 10 { << "linux-arm64" }
    if t == 11 { << "linux-x64" }
    if t == 20 { << "windows-arm64" }
    if t == 21 { << "windows-x64" }
    << "unknown"
}

fn doctor_host_os() int {
    // Compile-time OS of this xu-doctor binary (= runtime host when run natively).
    << xu_target_os()
}

fn doctor_host_label() string {
    h := doctor_host_os()
    if h == 0 { << "darwin" }
    if h == 1 { << "linux" }
    if h == 2 { << "windows" }
    << "unknown"
}

fn doctor_shell_quote(s &string) string {
    ss := str_clone(s)
    mut out := "'"
    for i in 0:ss.len {
        c := ss[i] & 255
        if c == 39 {
            out = out + "'\\''"
        } else {
            out = out + ss[i:i + 1]
        }
    }
    << out + "'"
}

fn path_exists(p &string) bool {
    os_stat(str_clone(p)) or (err) {
        << false
    }
    << true
}

fn doctor_file_exists(path &string) int {
    if path_exists(path) {
        << 1
    }
    << 0
}

fn doctor_rm(path string) {
    os.remove(path) or (err) {
        <<
    }
    <<
}

fn doctor_stamp(tag string) string {
    td := os.temp_dir()
    if td.len == 0 {
        if doctor_host_os() == 2 {
            << "xu_" + tag + "_" + str(now_ns() & 1048575)
        }
        << "/tmp/xu_" + tag + "_" + str(now_ns() & 1048575)
    }
    // Forward slash is accepted by Windows CRT path APIs.
    << td + "/xu_" + tag + "_" + str(now_ns() & 1048575)
}

fn doctor_find_repo_root() string {
    env_root := os.getenv("XU_ROOT")
    if env_root.len > 0 {
        host := env_root + "/src/ui/host/macos_host.swift"
        abi := env_root + "/src/ui/host/xu_content_abi.h"
        if doctor_file_exists(&host) == 1 && doctor_file_exists(&abi) == 1 {
            << env_root
        }
    }
    mut cur := os.getwd()
    for _ in 0:12 {
        host := cur + "/src/ui/host/macos_host.swift"
        abi := cur + "/src/ui/host/xu_content_abi.h"
        if doctor_file_exists(&host) == 1 {
            if doctor_file_exists(&abi) == 1 {
                << cur
            }
        }
        nxt := filepath.dir(&cur)
        if nxt.len == 0 || nxt == cur {
            << ""
        }
        cur = nxt
    }
    << ""
}

fn doctor_is_macos_target(code int) int {
    if code == 0 || code == 1 {
        << 1
    }
    << 0
}

fn doctor_is_windows_target(code int) int {
    if code == 20 || code == 21 {
        << 1
    }
    << 0
}

fn doctor_windows_mingw_prefix(code int) string {
    if code == 20 {
        << "aarch64-w64-mingw32"
    }
    << "x86_64-w64-mingw32"
}

fn doctor_is_linux_target(code int) int {
    if code == 10 || code == 11 {
        << 1
    }
    << 0
}

fn doctor_path_has_sep(p &string) int {
    for i in 0:p.len {
        c := p[i] & 255
        if c == 47 || c == 92 {
            << 1
        }
    }
    << 0
}

fn doctor_join_path(dir string, name string) string {
    if dir.len == 0 {
        << name + ""
    }
    last := dir[dir.len - 1] & 255
    if last == 47 || last == 92 {
        << dir + name
    }
    if doctor_host_os() == 2 {
        << dir + "\\" + name
    }
    << dir + "/" + name
}

fn doctor_try_exe(cand string) string {
    if doctor_file_exists(&cand) == 1 {
        << cand + ""
    }
    if doctor_host_os() == 2 {
        e := cand + ".exe"
        if doctor_file_exists(&e) == 1 {
            << e
        }
        c := cand + ".cmd"
        if doctor_file_exists(&c) == 1 {
            << c
        }
        b := cand + ".bat"
        if doctor_file_exists(&b) == 1 {
            << b
        }
    }
    << ""
}

// Portable PATH lookup (no /bin/sh, no `where`). Works on Darwin / Linux / Windows.
fn doctor_which(name string) string {
    if name.len == 0 {
        << ""
    }
    if doctor_path_has_sep(&name) == 1 {
        << doctor_try_exe(name + "")
    }
    path := os.getenv("PATH")
    mut i := 0
    mut start := 0
    mut sep := 58
    if doctor_host_os() == 2 {
        sep = 59
    }
    while i <= path.len {
        if i == path.len || (path[i] & 255) == sep {
            mut dir := ""
            if i > start {
                dir = path[start:i]
            }
            if dir.len > 0 {
                cand := doctor_join_path(dir, name)
                hit := doctor_try_exe(cand)
                if hit.len > 0 {
                    << hit
                }
            }
            start = i + 1
        }
        i = i + 1
    }
    << ""
}

fn doctor_devnull_redirect() string {
    if doctor_host_os() == 2 {
        << " >nul 2>&1"
    }
    << " >/dev/null 2>&1"
}

fn doctor_wrap_shell(cmd string) string {
    h := doctor_host_os()
    if h == 2 {
        // CreateProcessA does not interpret redirects; route through cmd.exe.
        << "cmd.exe /d /s /c \"" + cmd + "\""
    }
    << cmd + ""
}

fn doctor_cmd_ok(cmd string) int {
    h := doctor_host_os()
    mut line := cmd + doctor_devnull_redirect()
    if h == 2 {
        line = doctor_wrap_shell(cmd + doctor_devnull_redirect())
    }
    rc := os_system(line)
    if rc == 0 {
        << 1
    }
    // Linux hosted os_system may still be stub (127); treat as "cannot probe".
    << 0
}

fn doctor_tool_line(name string, ver_flag string) string {
    path := doctor_which(name)
    if path.len == 0 {
        << ""
    }
    // Version capture needs a working shell redirect. Darwin: system(3).
    // Windows: cmd.exe. Linux: path-only (hosted os_system often stub).
    h := doctor_host_os()
    if h == 1 {
        << str_clone(&path)
    }
    stamp := doctor_stamp("ver")
    mut line_cmd := ""
    if h == 2 {
        line_cmd = "cmd.exe /d /s /c \"\"" + path + "\" " + ver_flag + " > \"" + stamp + "\" 2>&1\""
    } else {
        pq := doctor_shell_quote(&path)
        sq := doctor_shell_quote(&stamp)
        line_cmd = pq + " " + ver_flag + " >" + sq + " 2>&1"
    }
    os_system(line_cmd)
    sp := stamp + ""
    body := read_file(sp + "") or (err) {
        doctor_rm(sp + "")
        << str_clone(&path)
    }
    doctor_rm(sp + "")
    mut line := ""
    mut got := 0
    for i in 0:body.len {
        if got == 0 {
            if body[i] == 10 || body[i] == 13 {
                line = body[0:i]
                got = 1
            }
        }
    }
    if got == 0 {
        line = str_clone(&body)
    }
    if line.len > 0 {
        << path + " (" + line + ")"
    }
    << str_clone(&path)
}

fn doctor_print_check(tag string, name string, detail string) {
    pad := "                    "
    mut n := str_clone(&name)
    if n.len < 22 {
        n = n + pad[0:22 - n.len]
    }
    if tag == "ok" {
        println("  [ok]      " + n + " " + detail)
    } else {
        if tag == "missing" {
            println("  [missing] " + n + " " + detail)
        } else {
            println("  [skip]    " + n + " " + detail)
        }
    }
    <<
}

fn doctor_pc_search_dirs() []string {
    mut dirs := []string{}
    pc := os.getenv("PKG_CONFIG_PATH")
    mut i := 0
    mut start := 0
    while i <= pc.len {
        if i == pc.len || (pc[i] & 255) == 58 {
            if i > start {
                dirs.push(pc[start:i])
            }
            start = i + 1
        }
        i = i + 1
    }
    dirs.push("/usr/lib/pkgconfig")
    dirs.push("/usr/share/pkgconfig")
    dirs.push("/usr/lib/x86_64-linux-gnu/pkgconfig")
    dirs.push("/usr/lib/aarch64-linux-gnu/pkgconfig")
    dirs.push("/usr/local/lib/pkgconfig")
    dirs.push("/usr/lib64/pkgconfig")
    << dirs
}

fn doctor_find_pc(name string) string {
    file := name + ".pc"
    dirs := doctor_pc_search_dirs()
    for i in 0:dirs.len {
        p := doctor_join_path(dirs[i], file)
        if doctor_file_exists(&p) == 1 {
            << p
        }
    }
    << ""
}

fn doctor_pc_version(pc_path string) string {
    body := read_file(pc_path) or (err) {
        << ""
    }
    key := "Version:"
    mut i := 0
    while i + key.len <= body.len {
        mut okm := 1
        for j in 0:key.len {
            if (body[i + j] & 255) != (key[j] & 255) {
                okm = 0
            }
        }
        if okm == 1 {
            mut k := i + key.len
            while k < body.len {
                c := body[k] & 255
                if c != 32 && c != 9 {
                    <-
                } else {
                    k = k + 1
                }
            }
            mut end := k
            while end < body.len {
                c := body[end] & 255
                if c == 10 || c == 13 {
                    <-
                } else {
                    end = end + 1
                }
            }
            if end > k {
                << body[k:end]
            }
            << ""
        }
        i = i + 1
    }
    << ""
}

fn doctor_version_at_least_410(ver string) int {
    // Accept major>=5, or major==4 && minor>=10.
    mut major := -1
    mut minor := 0
    mut cur := 0
    mut which := 0
    mut saw := 0
    for i in 0:ver.len {
        c := ver[i] & 255
        if c >= 48 && c <= 57 {
            cur = cur * 10 + (c - 48)
            saw = 1
        } else {
            if c == 46 {
                if which == 0 {
                    major = cur
                    cur = 0
                    which = 1
                    saw = 0
                } else {
                    <-
                }
            } else {
                <-
            }
        }
    }
    if which == 0 {
        if saw == 1 {
            major = cur
        }
    } else {
        if saw == 1 {
            minor = cur
        }
    }
    if major > 4 {
        << 1
    }
    if major == 4 && minor >= 10 {
        << 1
    }
    << 0
}

fn doctor_pkg_exists(name string) int {
    if doctor_which("pkg-config").len > 0 {
        if doctor_cmd_ok("pkg-config --exists " + name) == 1 {
            << 1
        }
        // Linux os_system stub → fall through to .pc probe.
    }
    if doctor_find_pc(name).len > 0 {
        << 1
    }
    << 0
}

fn doctor_pkg_gtk410_ok() int {
    if doctor_which("pkg-config").len > 0 {
        if doctor_cmd_ok("pkg-config --atleast-version=4.10 gtk4") == 1 {
            << 1
        }
    }
    pc := doctor_find_pc("gtk4")
    if pc.len == 0 {
        << 0
    }
    ver := doctor_pc_version(pc)
    if ver.len == 0 {
        << 0
    }
    << doctor_version_at_least_410(ver)
}

fn doctor_windows_find_loader(root string) string {
    dir := root + "/dist/windows-x64-ui/_build"
    p0 := dir + "/WebView2Loader.dll"
    if doctor_file_exists(&p0) == 1 {
        << p0
    }
    p1 := dir + "/WebView2Loader_x64.dll"
    if doctor_file_exists(&p1) == 1 {
        << p1
    }
    p2 := dir + "/WebView2Loader_arm64.dll"
    if doctor_file_exists(&p2) == 1 {
        << p2
    }
    << ""
}

fn doctor_windows_loader_matches(path string, target_code int) bool {
    data := read_file(path) or (err) { << false }
    if data.len < 64 || data[0] != 77 || data[1] != 90 { << false }
    mut off := 0
    for i in 0:4 { off = off | ((data[60 + i] & 255) << (i * 8)) }
    if off < 64 || off > data.len - 6 { << false }
    if data[off] != 80 || data[off + 1] != 69 || data[off + 2] != 0 || data[off + 3] != 0 { << false }
    machine := (data[off + 4] & 255) | ((data[off + 5] & 255) << 8)
    if target_code == 20 { << machine == 43620 }
    if target_code == 21 { << machine == 34404 }
    << false
}

fn doctor_windows_find_loader_for(root string, target_code int) string {
    dir := root + "/dist/windows-x64-ui/_build"
    mut named := dir + "/WebView2Loader_x64.dll"
    if target_code == 20 { named = dir + "/WebView2Loader_arm64.dll" }
    if doctor_windows_loader_matches(named + "", target_code) { << named }
    generic := dir + "/WebView2Loader.dll"
    if doctor_windows_loader_matches(generic + "", target_code) { << generic }
    // A missing matching DLL must never fall back to the opposite architecture.
    << ""
}

fn doctor_check_macos(webview int, required int) int {
    mut failed := 0
    if doctor_host_os() != 0 {
        if required == 1 {
            doctor_print_check("missing", "macos tools", "pack macos-* requires Darwin host (swiftc / Xcode)")
            << 1
        }
        doctor_print_check("skip", "macos tools", "pack macos-* requires Darwin host (swiftc / Xcode)")
        << 0
    }
    swiftc := doctor_tool_line("swiftc", "--version")
    if swiftc.len == 0 {
        doctor_print_check("missing", "swiftc", "not found: swiftc")
        failed = 1
    } else {
        doctor_print_check("ok", "swiftc", swiftc)
    }
    clang := doctor_tool_line("clang", "--version")
    if clang.len == 0 {
        doctor_print_check("missing", "clang", "not found: clang")
        failed = 1
    } else {
        doctor_print_check("ok", "clang", clang)
    }
    ar := doctor_which("ar")
    if ar.len == 0 {
        doctor_print_check("missing", "ar", "not found: ar")
        failed = 1
    } else {
        doctor_print_check("ok", "ar", ar)
    }
    xcrun := doctor_which("xcrun")
    if xcrun.len == 0 {
        doctor_print_check("missing", "xcrun", "not found: xcrun")
        failed = 1
    } else {
        doctor_print_check("ok", "xcrun", xcrun)
    }
    if doctor_cmd_ok("xcode-select -p") == 0 {
        doctor_print_check("missing", "xcode-select", "no developer dir (xcode-select -p)")
        failed = 1
    } else {
        doctor_print_check("ok", "xcode-select", "developer dir present")
    }
    if webview == 1 {
        doctor_print_check("ok", "webview", "WebKit host plugin (macos-arm64 / macos-x64)")
    }
    << failed
}

fn doctor_resolve_win_tool(pfx string, tool string) string {
    // Cross prefix first (Darwin/Linux mingw, or named llvm-mingw on Windows).
    cross := doctor_tool_line(pfx + "-" + tool, "--version")
    if cross.len > 0 {
        << cross
    }
    // Windows host / MSYS2 mingw64 PATH often exposes bare g++/gcc/ar/windres.
    if doctor_host_os() == 2 {
        bare := doctor_tool_line(tool + "", "--version")
        if bare.len > 0 {
            << bare
        }
    }
    << ""
}

fn doctor_resolve_win_which(pfx string, tool string) string {
    cross := doctor_which(pfx + "-" + tool)
    if cross.len > 0 {
        << cross
    }
    if doctor_host_os() == 2 {
        bare := doctor_which(tool + "")
        if bare.len > 0 {
            << bare
        }
    }
    << ""
}

fn doctor_check_windows(root string, target_code int, webview int) int {
    mut failed := 0
    pfx := doctor_windows_mingw_prefix(target_code)
    tname := target_name(target_code)
    gpp := doctor_resolve_win_tool(pfx + "", "g++")
    if gpp.len == 0 {
        mut hint := "not found: " + pfx + "-g++"
        if doctor_host_os() == 2 {
            hint = hint + " (or g++.exe on PATH / MSYS2 mingw64)"
        } else {
            if target_code == 20 {
                hint = hint + " (need llvm-mingw / aarch64-w64-mingw32)"
            }
        }
        doctor_print_check("missing", "mingw g++", hint)
        failed = 1
    } else {
        doctor_print_check("ok", "mingw g++", gpp)
    }
    gcc := doctor_resolve_win_tool(pfx + "", "gcc")
    if gcc.len == 0 {
        mut hint2 := "not found: " + pfx + "-gcc"
        if doctor_host_os() == 2 {
            hint2 = hint2 + " (or gcc.exe on PATH)"
        }
        doctor_print_check("missing", "mingw gcc", hint2)
        failed = 1
    } else {
        doctor_print_check("ok", "mingw gcc", gcc)
    }
    arp := doctor_resolve_win_which(pfx + "", "ar")
    if arp.len == 0 {
        doctor_print_check("missing", "mingw ar", "not found: " + pfx + "-ar")
        failed = 1
    } else {
        doctor_print_check("ok", "mingw ar", arp)
    }
    wr := doctor_resolve_win_which(pfx + "", "windres")
    if wr.len == 0 {
        doctor_print_check("missing", "mingw windres", "not found: " + pfx + "-windres")
        failed = 1
    } else {
        doctor_print_check("ok", "mingw windres", wr)
    }
    xxd := doctor_which("xxd")
    if xxd.len == 0 {
        if doctor_host_os() == 2 {
            doctor_print_check("missing", "xxd", "not found: xxd (Git for Windows / MSYS2; used to embed assets)")
        } else {
            doctor_print_check("missing", "xxd", "not found: xxd")
        }
        failed = 1
    } else {
        doctor_print_check("ok", "xxd", xxd)
    }
    mut cv := doctor_which("magick")
    // Windows convert.exe is an NTFS utility, not ImageMagick.
    if cv.len == 0 && doctor_host_os() != 2 {
        cv = doctor_which("convert")
    }
    if cv.len == 0 {
        doctor_print_check("skip", "convert/magick", "optional (PE .ico resource)")
    } else {
        doctor_print_check("ok", "convert/magick", cv)
    }
    if doctor_host_os() == 2 {
        shell := doctor_which("sh")
        if shell.len == 0 {
            doctor_print_check("missing", "pack shell", "not found: sh (Git Bash / MSYS2)")
            failed = 1
        } else { doctor_print_check("ok", "pack shell", shell) }
    }
    if webview == 1 {
        doctor_print_check("ok", "webview", "WebView2 host plugin (" + tname + ")")
        lp := doctor_windows_find_loader_for(root, target_code)
        if lp.len == 0 {
            doctor_print_check("skip", "WebView2Loader", "optional arch-matching DLL in dist/windows-x64-ui/_build/")
        } else {
            doctor_print_check("ok", "WebView2Loader", lp)
        }
    }
    << failed
}

fn doctor_check_linux(webview int, required int) int {
    mut failed := 0
    if doctor_host_os() != 1 {
        if required == 1 {
            doctor_print_check("missing", "linux tools", "pack linux-* requires Linux host (gtk4 / pkg-config)")
            << 1
        }
        doctor_print_check("skip", "linux tools", "pack linux-* requires Linux host (gtk4 / pkg-config)")
        << 0
    }
    mut cxx := doctor_tool_line("g++", "--version")
    if cxx.len == 0 {
        cxx = doctor_tool_line("c++", "--version")
    }
    if cxx.len == 0 {
        cxx = doctor_tool_line("clang++", "--version")
    }
    if cxx.len == 0 {
        doctor_print_check("missing", "g++/c++", "not found: g++ or c++ or clang++")
        failed = 1
    } else {
        doctor_print_check("ok", "g++/c++", cxx)
    }
    arp := doctor_which("ar")
    if arp.len == 0 {
        doctor_print_check("missing", "ar", "not found: ar")
        failed = 1
    } else {
        doctor_print_check("ok", "ar", arp)
    }
    xxd := doctor_which("xxd")
    if xxd.len == 0 {
        doctor_print_check("missing", "xxd", "not found: xxd")
        failed = 1
    } else {
        doctor_print_check("ok", "xxd", xxd)
    }
    pk := doctor_which("pkg-config")
    if pk.len == 0 {
        doctor_print_check("missing", "pkg-config", "not found: pkg-config")
        failed = 1
    } else {
        doctor_print_check("ok", "pkg-config", pk)
    }
    if doctor_pkg_exists("gtk4") == 0 {
        doctor_print_check("missing", "gtk4", "need gtk4.pc / libgtk-4-dev")
        failed = 1
    } else {
        if doctor_pkg_gtk410_ok() == 0 {
            doctor_print_check("missing", "gtk4>=4.10", "host needs GtkFileDialog/GtkAlertDialog (GTK ≥ 4.10)")
            failed = 1
        } else {
            doctor_print_check("ok", "gtk4", "gtk4 (>=4.10)")
        }
    }
    if webview == 1 {
        if doctor_pkg_exists("webkitgtk-6.0") == 0 {
            doctor_print_check("missing", "webkitgtk-6.0", "need webkitgtk-6.0.pc / libwebkitgtk-6.0-dev")
            failed = 1
        } else {
            doctor_print_check("ok", "webkitgtk-6.0", "webkitgtk-6.0 present")
        }
    }
    << failed
}

fn doctor_check_one(root string, target_code int, webview int) int {
    if doctor_is_macos_target(target_code) == 1 {
        << doctor_check_macos(webview, 1)
    }
    if doctor_is_windows_target(target_code) == 1 {
        << doctor_check_windows(root, target_code, webview)
    }
    if doctor_is_linux_target(target_code) == 1 {
        << doctor_check_linux(webview, 1)
    }
    doctor_print_check("skip", "host tools", "target is not macos-* / windows-x64|arm64 / linux-x64|arm64")
    << 0
}

fn doctor_check_all(root string, webview int) int {
    mut failed := 0
    println("")
    println("== macos-arm64 / macos-x64 ==")
    if doctor_check_macos(webview, 0) != 0 {
        failed = 1
    }
    println("")
    println("== windows-x64 ==")
    if doctor_check_windows(root, 21, webview) != 0 {
        failed = 1
    }
    println("")
    println("== windows-arm64 ==")
    if doctor_check_windows(root, 20, webview) != 0 {
        failed = 1
    }
    println("")
    println("== linux-arm64 / linux-x64 ==")
    if doctor_check_linux(webview, 0) != 0 {
        failed = 1
    }
    << failed
}

fn doctor_run(argv []string) int {
    mut target_code := 0
    mut target_set := 0
    mut webview := 0
    mut i := 0
    while i < argv.len {
        a := argv[i]
        if a == "--desktop" {
            // clarity alias
        } else {
            if a == "--webview" {
                webview = 1
            } else {
                if a == "--target" {
                    if i + 1 >= argv.len {
                        eprintln("xu-doctor: --target requires a name")
                        << 1
                    }
                    t := parse_target(argv[i + 1])
                    if t < 0 {
                        eprintln("xu-doctor: unknown --target")
                        << 1
                    }
                    if target_os(t) == 3 {
                        eprintln("xu-doctor: freestanding target cannot pack desktop")
                        << 1
                    }
                    target_code = t
                    target_set = 1
                    i = i + 1
                } else {
                    if a == "-h" || a == "--help" {
                        println("usage: xu-doctor [options]")
                        println("")
                        println("Check host environment and external toolchain requirements.")
                        println("")
                        println("Options:")
                        println("  --target TARGET   check only the specified target platform")
                        println("  --desktop         check host toolchains required for desktop packing")
                        println("  --webview         also check webview host dependencies")
                        println("  -h, --help        show this help message")
                        << 0
                    } else {
                        eprintln("xu-doctor: unexpected argument '" + a + "'")
                        << 1
                    }
                }
            }
        }
        i = i + 1
    }
    root := doctor_find_repo_root()
    mut failed := 0
    host := doctor_host_label()
    if target_set == 1 {
        tname := target_name(target_code)
        println("xu-doctor — desktop toolchain (" + tname + ") [host=" + host + "]")
    } else {
        println("xu-doctor — desktop toolchains (all; host=" + host + ")")
    }
    if root.len == 0 {
        doctor_print_check("missing", "xu repo root", "need src/ui/host/macos_host.swift")
        failed = 1
    } else {
        doctor_print_check("ok", "xu repo root", root)
    }
    if failed == 0 {
        if target_set == 1 {
            if doctor_check_one(root, target_code, webview) != 0 {
                failed = 1
            }
        } else {
            if doctor_check_all(root, webview) != 0 {
                failed = 1
            }
        }
    }
    if failed == 1 {
        << 1
    }
    << 0
}

fn main() int {
    argv := args()
    mut dargs := []string{}
    mut i := 1
    while i < argv.len {
        dargs.push(argv[i])
        i = i + 1
    }
    << doctor_run(dargs)
}
