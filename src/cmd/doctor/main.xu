@main
// xu-doctor — check host environment, SDK integrity, desktop packing, and phone toolchains.
// User: `xu-doctor [options]` or via `xu doctor`.

#os
#os/exec
#path/filepath
#errors
#encoding/json
#strings
#internal/toolpath

struct DoctorCheck {
    category string
    name string
    status string // "ok" | "warn" | "missing" | "skip"
    detail string
    hint string
}

struct DoctorState {
    checks []DoctorCheck
    ok_count int
    warn_count int
    missing_count int
    skip_count int
    json_mode bool
    verbose bool
    quiet bool
}

fn new_doctor_state(json_mode bool, verbose bool, quiet bool) DoctorState {
    << DoctorState{
        checks: []DoctorCheck{},
        ok_count: 0,
        warn_count: 0,
        missing_count: 0,
        skip_count: 0,
        json_mode: json_mode,
        verbose: verbose,
        quiet: quiet
    }
}

fn str_clone(s &string) string {
    << s + ""
}

fn fail_status(required int) string {
    if required == 1 {
        << "missing"
    }
    << "warn"
}

fn doctor_section(st &DoctorState, title string) {
    if !st.json_mode && !st.quiet {
        println("")
        println("== " + title + " ==")
    }
}

fn doctor_record(st $&DoctorState, category string, status string, name string, detail string, hint string) {
    if status == "ok" {
        st.ok_count = st.ok_count + 1
    } else if status == "warn" {
        st.warn_count = st.warn_count + 1
    } else if status == "missing" {
        st.missing_count = st.missing_count + 1
    } else {
        st.skip_count = st.skip_count + 1
    }
    st.checks.push(DoctorCheck{
        category: category + "",
        name: name + "",
        status: status + "",
        detail: detail + "",
        hint: hint + ""
    })
    if st.json_mode {
        <<
    }
    if st.quiet && (status == "ok" || status == "skip") {
        <<
    }
    pad := "                    "
    $n := str_clone(&name)
    if st.quiet {
        n = "[" + category + "] " + n
    }
    if n.len < 22 {
        n = n + pad[0:22 - n.len]
    }
    if status == "ok" {
        println("  [ok]      " + n + " " + detail)
    } else if status == "warn" {
        println("  [warn]    " + n + " " + detail)
    } else if status == "missing" {
        println("  [missing] " + n + " " + detail)
    } else {
        println("  [skip]    " + n + " " + detail)
    }
    if hint.len > 0 && (status == "missing" || status == "warn") {
        println("            fix: " + hint)
    }
}

fn parse_target(s string) int {
    if s == "macos-arm64" { << 0 }
    if s == "macos-x64" { << 1 }
    if s == "linux-arm64" { << 10 }
    if s == "linux-x64" { << 11 }
    if s == "windows-arm64" { << 20 }
    if s == "windows-x64" { << 21 }
    if s == "ios-arm64" { << 30 }
    if s == "ios-simulator-arm64" { << 31 }
    if s == "android-arm64" { << 32 }
    << -1
}

fn target_os(t int) int {
    << t / 10
}

fn target_name(t int) string {
    if t == 0 { << "macos-arm64" }
    if t == 1 { << "macos-x64" }
    if t == 10 { << "linux-arm64" }
    if t == 11 { << "linux-x64" }
    if t == 20 { << "windows-arm64" }
    if t == 21 { << "windows-x64" }
    if t == 30 { << "ios-arm64" }
    if t == 31 { << "ios-simulator-arm64" }
    if t == 32 { << "android-arm64" }
    << "unknown"
}

fn doctor_host_os() int {
    // Compile-time OS of this xu-doctor binary (= runtime host when run natively).
    << xu_target_os()
}

fn doctor_host_label() string {
    h := doctor_host_os()
    if h == 0 { << "darwin" }
    if h == 1 { << "linux" }
    if h == 2 { << "windows" }
    << "unknown"
}

fn path_exists(p &string) bool {
    _ := os_stat(str_clone(p)) >>> (err) {
        _ := err.msg()
        << false
    }
    << true
}

fn file_exists(p &string) bool {
    info := os_stat(str_clone(p)) >>> (err) {
        _ := err.msg()
        << false
    }
    << !info.is_dir
}

fn dir_exists(p &string) bool {
    info := os_stat(str_clone(p)) >>> (err) {
        _ := err.msg()
        << false
    }
    << info.is_dir
}

fn is_executable_file(p &string) bool {
    info := os_stat(str_clone(p)) >>> (err) {
        _ := err.msg()
        << false
    }
    if info.is_dir {
        << false
    }
    if doctor_host_os() == 2 {
        << true
    }
    << (info.mode & 73) != 0
}

fn doctor_file_exists(path &string) int {
    if path_exists(path) {
        << 1
    }
    << 0
}

fn doctor_rm(path string) {
    os.remove(path) >>> (err) {
        _ := err.msg()
        <<
    }
    <<
}

fn doctor_stamp(tag string) string {
    td := os.temp_dir()
    if td.len == 0 {
        if doctor_host_os() == 2 {
            << "xu_" + tag + "_" + str(now_ns() & 1048575)
        }
        << "/tmp/xu_" + tag + "_" + str(now_ns() & 1048575)
    }
    << td + "/xu_" + tag + "_" + str(now_ns() & 1048575)
}

fn doctor_find_repo_root() string {
    << toolpath.ui_root() >>> (err) {
        _ := err.msg()
        << ""
    }
}

fn doctor_is_macos_target(code int) int {
    if code == 0 || code == 1 { << 1 }
    << 0
}

fn doctor_is_linux_target(code int) int {
    if code == 10 || code == 11 { << 1 }
    << 0
}

fn doctor_is_windows_target(code int) int {
    if code == 20 || code == 21 { << 1 }
    << 0
}

fn doctor_is_phone_target(code int) int {
    if code == 30 || code == 31 || code == 32 { << 1 }
    << 0
}

fn doctor_windows_mingw_prefix(code int) string {
    if code == 20 {
        << "aarch64-w64-mingw32"
    }
    << "x86_64-w64-mingw32"
}

fn doctor_path_has_sep(p &string) int {
    for i in 0:p.len {
        c := p[i] & 255
        if c == 47 || c == 92 {
            << 1
        }
    }
    << 0
}

fn doctor_join_path(dir string, name string) string {
    if dir.len == 0 {
        << name + ""
    }
    last := dir[dir.len - 1] & 255
    if last == 47 || last == 92 {
        << dir + name
    }
    if doctor_host_os() == 2 {
        << dir + "\\" + name
    }
    << dir + "/" + name
}

fn doctor_try_exe(cand string) string {
    if doctor_file_exists(&cand) == 1 && !dir_exists(&cand) {
        << cand + ""
    }
    if doctor_host_os() == 2 {
        e := cand + ".exe"
        if doctor_file_exists(&e) == 1 && !dir_exists(&e) { << e }
        c := cand + ".cmd"
        if doctor_file_exists(&c) == 1 && !dir_exists(&c) { << c }
        b := cand + ".bat"
        if doctor_file_exists(&b) == 1 && !dir_exists(&b) { << b }
    }
    << ""
}

// Portable PATH lookup (no /bin/sh, no `where`). Works on Darwin / Linux / Windows.
fn doctor_which(name string) string {
    if name.len == 0 {
        << ""
    }
    if doctor_path_has_sep(&name) == 1 {
        << doctor_try_exe(name + "")
    }
    path := os.getenv("PATH")
    $i := 0
    $start := 0
    $sep := 58
    if doctor_host_os() == 2 {
        sep = 59
    }
    while i <= path.len {
        if i == path.len || (path[i] & 255) == sep {
            $dir := ""
            if i > start {
                dir = path[start:i]
            }
            if dir.len > 0 {
                cand := doctor_join_path(dir, name)
                hit := doctor_try_exe(cand)
                if hit.len > 0 {
                    << hit
                }
            }
            start = i + 1
        }
        i = i + 1
    }
    << ""
}

fn doctor_exec_output(bin string, args []string) string {
    $cmd := exec.command(bin + "")
    for i in 0:args.len {
        cmd.args.push(args[i] + "")
    }
    out := cmd.combined_output() >>> (err) {
        _ := err.msg()
        << ""
    }
    << out
}

fn doctor_exec_stdout(bin string, args []string) string {
    $cmd := exec.command(bin + "")
    for i in 0:args.len {
        cmd.args.push(args[i] + "")
    }
    out := cmd.output() >>> (err) {
        _ := err.msg()
        << ""
    }
    << out
}

fn doctor_exec_ok(bin string, args []string) bool {
    $cmd := exec.command(bin + "")
    for i in 0:args.len {
        cmd.args.push(args[i] + "")
    }
    _ := cmd.combined_output() >>> (err) {
        _ := err.msg()
        << false
    }
    << true
}

fn doctor_first_nonempty_line(body &string) string {
    lines := strings.split(body, "\n")
    for i in 0:lines.len {
        t := strings.trim_space(&lines[i])
        if t.len > 0 {
            << t
        }
    }
    << ""
}

fn doctor_tool_line(name string, ver_flag string) string {
    path := doctor_which(name)
    if path.len == 0 {
        << ""
    }
    out := doctor_exec_output(path + "", [ver_flag])
    line := doctor_first_nonempty_line(&out)
    if line.len > 0 {
        << path + " (" + line + ")"
    }
    << str_clone(&path)
}

fn doctor_pc_search_dirs() []string {
    $dirs := []string{}
    pc := os.getenv("PKG_CONFIG_PATH")
    $i := 0
    $start := 0
    while i <= pc.len {
        if i == pc.len || (pc[i] & 255) == 58 {
            if i > start {
                dirs.push(pc[start:i])
            }
            start = i + 1
        }
        i = i + 1
    }
    dirs.push("/usr/lib/pkgconfig")
    dirs.push("/usr/share/pkgconfig")
    dirs.push("/usr/lib/x86_64-linux-gnu/pkgconfig")
    dirs.push("/usr/lib/aarch64-linux-gnu/pkgconfig")
    dirs.push("/usr/local/lib/pkgconfig")
    dirs.push("/usr/lib64/pkgconfig")
    << dirs
}

fn doctor_find_pc(name string) string {
    file := name + ".pc"
    dirs := doctor_pc_search_dirs()
    for i in 0:dirs.len {
        p := doctor_join_path(dirs[i], file)
        if doctor_file_exists(&p) == 1 {
            << p
        }
    }
    << ""
}

fn doctor_pc_version(pc_path string) string {
    body := read_file(pc_path) >>> (err) {
        _ := err.msg()
        << ""
    }
    key := "Version:"
    $i := 0
    while i + key.len <= body.len {
        $okm := 1
        for j in 0:key.len {
            if (body[i + j] & 255) != (key[j] & 255) {
                okm = 0
            }
        }
        if okm == 1 {
            $k := i + key.len
            while k < body.len {
                c := body[k] & 255
                if c != 32 && c != 9 { <- }
                k = k + 1
            }
            $end := k
            while end < body.len {
                c := body[end] & 255
                if c == 10 || c == 13 { <- }
                end = end + 1
            }
            if end > k {
                << body[k:end]
            }
            << ""
        }
        i = i + 1
    }
    << ""
}

fn doctor_version_at_least_410(ver string) int {
    $major := -1
    $minor := 0
    $cur := 0
    $which := 0
    $saw := 0
    for i in 0:ver.len {
        c := ver[i] & 255
        if c >= 48 && c <= 57 {
            cur = cur * 10 + (c - 48)
            saw = 1
        } else if c == 46 {
            if which == 0 {
                major = cur
                cur = 0
                which = 1
                saw = 0
            } else {
                <-
            }
        } else {
            <-
        }
    }
    if which == 0 {
        if saw == 1 { major = cur }
    } else {
        if saw == 1 { minor = cur }
    }
    if major > 4 { << 1 }
    if major == 4 && minor >= 10 { << 1 }
    << 0
}

fn doctor_pkg_exists(name string) int {
    if doctor_which("pkg-config").len > 0 {
        if doctor_exec_ok("pkg-config", ["--exists", name + ""]) {
            << 1
        }
    }
    if doctor_find_pc(name).len > 0 {
        << 1
    }
    << 0
}

fn doctor_pkg_gtk410_ok() int {
    if doctor_which("pkg-config").len > 0 {
        if doctor_exec_ok("pkg-config", ["--atleast-version=4.10", "gtk4"]) {
            << 1
        }
    }
    pc := doctor_find_pc("gtk4")
    if pc.len == 0 { << 0 }
    ver := doctor_pc_version(pc)
    if ver.len == 0 { << 0 }
    << doctor_version_at_least_410(ver)
}

fn doctor_windows_find_loader(root string) string {
    dir := root + "/dist/windows-x64-ui/_build"
    p0 := dir + "/WebView2Loader.dll"
    if doctor_file_exists(&p0) == 1 { << p0 }
    p1 := dir + "/WebView2Loader_x64.dll"
    if doctor_file_exists(&p1) == 1 { << p1 }
    p2 := dir + "/WebView2Loader_arm64.dll"
    if doctor_file_exists(&p2) == 1 { << p2 }
    << ""
}

fn doctor_windows_find_loader_for(root string, target_code int) string {
    dir := root + "/dist/windows-x64-ui/_build"
    if target_code == 20 {
        p := dir + "/WebView2Loader_arm64.dll"
        if doctor_file_exists(&p) == 1 { << p }
    } else {
        p0 := dir + "/WebView2Loader_x64.dll"
        if doctor_file_exists(&p0) == 1 { << p0 }
        p1 := dir + "/WebView2Loader.dll"
        if doctor_file_exists(&p1) == 1 { << p1 }
    }
    << doctor_windows_find_loader(root + "")
}

fn doctor_probe_macos_x64_clang() bool {
    tmp_c := doctor_stamp("x64") + ".c"
    tmp_o := doctor_stamp("x64") + ".o"
    write_file(tmp_c + "", "int x;\n") >>> (err) {
        _ := err.msg()
        << false
    }
    ok := doctor_exec_ok("clang", ["-target", "x86_64-apple-macos", "-c", tmp_c + "", "-o", tmp_o + ""])
    doctor_rm(tmp_c)
    doctor_rm(tmp_o)
    << ok
}

fn doctor_check_macos(st $&DoctorState, target_code int, webview int, required int) {
    cat := "macos"
    if doctor_host_os() != 0 {
        if required == 1 {
            doctor_record(st, cat + "", "missing", "macos tools", "pack macos-* requires Darwin host (swiftc / Xcode)", "Run on macOS with Xcode / Command Line Tools installed")
            <<
        }
        doctor_record(st, cat + "", "skip", "macos tools", "pack macos-* requires Darwin host (swiftc / Xcode)", "")
        <<
    }
    fst := fail_status(required)
    swiftc := doctor_tool_line("swiftc", "--version")
    if swiftc.len == 0 {
        doctor_record(st, cat + "", fst + "", "swiftc", "not found: swiftc", "Install Xcode or Command Line Tools: xcode-select --install")
    } else {
        doctor_record(st, cat + "", "ok", "swiftc", swiftc, "")
    }
    clang := doctor_tool_line("clang", "--version")
    if clang.len == 0 {
        doctor_record(st, cat + "", fst + "", "clang", "not found: clang", "Install Xcode or Command Line Tools: xcode-select --install")
    } else {
        doctor_record(st, cat + "", "ok", "clang", clang, "")
    }
    ar := doctor_which("ar")
    if ar.len == 0 {
        doctor_record(st, cat + "", fst + "", "ar", "not found: ar", "Install Xcode Command Line Tools: xcode-select --install")
    } else if !strings.has_prefix(&ar, "/usr/bin/") && !strings.contains(&ar, "/Xcode.app/") && !strings.contains(&ar, "/CommandLineTools/") {
        doctor_record(st, cat + "", "warn", "ar", ar + " (shadows Apple /usr/bin/ar; may break Mach-O archives)", "Ensure /usr/bin precedes conda/brew in PATH or check 'xcrun -f ar'")
    } else {
        doctor_record(st, cat + "", "ok", "ar", ar, "")
    }
    xcrun := doctor_which("xcrun")
    if xcrun.len == 0 {
        doctor_record(st, cat + "", fst + "", "xcrun", "not found: xcrun", "Install Xcode Command Line Tools: xcode-select --install")
    } else {
        doctor_record(st, cat + "", "ok", "xcrun", xcrun, "")
    }
    if !doctor_exec_ok("xcode-select", ["-p"]) {
        doctor_record(st, cat + "", fst + "", "xcode-select", "no developer dir (xcode-select -p)", "Run: xcode-select --install")
    } else {
        sdk_dir := doctor_exec_stdout("xcode-select", ["-p"])
        sdk_line := doctor_first_nonempty_line(&sdk_dir)
        if sdk_line.len > 0 {
            doctor_record(st, cat + "", "ok", "xcode-select", sdk_line, "")
        } else {
            doctor_record(st, cat + "", "ok", "xcode-select", "developer dir present", "")
        }
    }
    if target_code == 1 {
        if doctor_probe_macos_x64_clang() {
            doctor_record(st, cat + "", "ok", "x86_64 cross clang", "-target x86_64-apple-macos", "")
        } else {
            doctor_record(st, cat + "", fst + "", "x86_64 cross clang", "clang -target x86_64-apple-macos failed", "Install macOS SDK via Xcode / Command Line Tools")
        }
    }
    if webview == 1 {
        doctor_record(st, cat + "", "ok", "webview", "WebKit host plugin (macos-arm64 / macos-x64)", "")
    }
}

fn doctor_resolve_win_tool(pfx string, tool string) string {
    cross := doctor_tool_line(pfx + "-" + tool, "--version")
    if cross.len > 0 {
        << cross
    }
    if doctor_host_os() == 2 {
        bare := doctor_tool_line(tool + "", "--version")
        if bare.len > 0 {
            << bare
        }
    }
    << ""
}

fn doctor_resolve_win_which(pfx string, tool string) string {
    cross := doctor_which(pfx + "-" + tool)
    if cross.len > 0 {
        << cross
    }
    if doctor_host_os() == 2 {
        bare := doctor_which(tool + "")
        if bare.len > 0 {
            << bare
        }
    }
    << ""
}

fn doctor_win_install_hint(target_code int) string {
    h := doctor_host_os()
    if h == 0 {
        if target_code == 20 { << "Install llvm-mingw (aarch64-w64-mingw32) and add bin/ to PATH" }
        << "Install mingw-w64: brew install mingw-w64"
    }
    if h == 1 {
        if target_code == 20 { << "Install llvm-mingw (aarch64-w64-mingw32) and add bin/ to PATH" }
        << "Install mingw-w64: sudo apt install mingw-w64"
    }
    << "Install MSYS2 mingw64 or llvm-mingw and add bin/ to PATH"
}

fn doctor_check_windows(st $&DoctorState, root string, target_code int, webview int, required int) {
    pfx := doctor_windows_mingw_prefix(target_code)
    tname := target_name(target_code)
    cat := tname + ""
    fst := fail_status(required)
    install_hint := doctor_win_install_hint(target_code)

    gpp := doctor_resolve_win_tool(pfx + "", "g++")
    if gpp.len == 0 {
        $hint := "not found: " + pfx + "-g++"
        if doctor_host_os() == 2 {
            hint = hint + " (or g++.exe on PATH / MSYS2 mingw64)"
        } else if target_code == 20 {
            hint = hint + " (need llvm-mingw / aarch64-w64-mingw32)"
        }
        doctor_record(st, cat + "", fst + "", "mingw g++", hint, install_hint + "")
    } else {
        doctor_record(st, cat + "", "ok", "mingw g++", gpp, "")
    }
    gcc := doctor_resolve_win_tool(pfx + "", "gcc")
    if gcc.len == 0 {
        $hint2 := "not found: " + pfx + "-gcc"
        if doctor_host_os() == 2 {
            hint2 = hint2 + " (or gcc.exe on PATH)"
        }
        doctor_record(st, cat + "", fst + "", "mingw gcc", hint2, install_hint + "")
    } else {
        doctor_record(st, cat + "", "ok", "mingw gcc", gcc, "")
    }
    arp := doctor_resolve_win_which(pfx + "", "ar")
    if arp.len == 0 {
        doctor_record(st, cat + "", fst + "", "mingw ar", "not found: " + pfx + "-ar", install_hint + "")
    } else {
        doctor_record(st, cat + "", "ok", "mingw ar", arp, "")
    }
    wr := doctor_resolve_win_which(pfx + "", "windres")
    if wr.len == 0 {
        doctor_record(st, cat + "", fst + "", "mingw windres", "not found: " + pfx + "-windres", install_hint + "")
    } else {
        doctor_record(st, cat + "", "ok", "mingw windres", wr, "")
    }
    xxd := doctor_which("xxd")
    if xxd.len == 0 {
        if doctor_host_os() == 2 {
            doctor_record(st, cat + "", fst + "", "xxd", "not found: xxd (Git for Windows / MSYS2; used to embed assets)", "Install Git for Windows / MSYS2 vim-common and add to PATH")
        } else {
            doctor_record(st, cat + "", fst + "", "xxd", "not found: xxd", "Install xxd (macOS Xcode CLT or apt install xxd)")
        }
    } else {
        doctor_record(st, cat + "", "ok", "xxd", xxd, "")
    }
    $cv := doctor_which("magick")
    if cv.len == 0 && doctor_host_os() != 2 {
        cv = doctor_which("convert")
    }
    if cv.len == 0 {
        doctor_record(st, cat + "", "skip", "convert/magick", "optional (PE .ico resource)", "")
    } else {
        doctor_record(st, cat + "", "ok", "convert/magick", cv, "")
    }
    if doctor_host_os() == 2 {
        shell := doctor_which("sh")
        if shell.len == 0 {
            doctor_record(st, cat + "", fst + "", "pack shell", "not found: sh (install Git Bash or MSYS2 and add its bin directory to PATH)", "Install Git for Windows or MSYS2 and add usr\\bin to PATH")
        } else {
            doctor_record(st, cat + "", "ok", "pack shell", shell, "")
        }
    }
    if webview == 1 {
        doctor_record(st, cat + "", "ok", "webview", "WebView2 host plugin (" + tname + ")", "")
        lp := doctor_windows_find_loader_for(root, target_code)
        if lp.len == 0 {
            doctor_record(st, cat + "", "skip", "WebView2Loader", "optional arch-matching DLL in dist/windows-x64-ui/_build/", "")
        } else {
            doctor_record(st, cat + "", "ok", "WebView2Loader", lp, "")
        }
    }
}

fn doctor_check_linux(st $&DoctorState, webview int, required int) {
    cat := "linux"
    if doctor_host_os() != 1 {
        if required == 1 {
            doctor_record(st, cat + "", "missing", "linux tools", "pack linux-* requires Linux host (gtk4 / pkg-config)", "Run on a Linux host with build-essential, pkg-config, libgtk-4-dev")
            <<
        }
        doctor_record(st, cat + "", "skip", "linux tools", "pack linux-* requires Linux host (gtk4 / pkg-config)", "")
        <<
    }
    fst := fail_status(required)
    $cxx := doctor_tool_line("g++", "--version")
    if cxx.len == 0 { cxx = doctor_tool_line("c++", "--version") }
    if cxx.len == 0 { cxx = doctor_tool_line("clang++", "--version") }
    if cxx.len == 0 {
        doctor_record(st, cat + "", fst + "", "g++/c++", "not found: g++ or c++ or clang++", "Install C++ compiler: sudo apt install build-essential")
    } else {
        doctor_record(st, cat + "", "ok", "g++/c++", cxx, "")
    }
    arp := doctor_which("ar")
    if arp.len == 0 {
        doctor_record(st, cat + "", fst + "", "ar", "not found: ar", "Install binutils: sudo apt install binutils")
    } else {
        doctor_record(st, cat + "", "ok", "ar", arp, "")
    }
    xxd := doctor_which("xxd")
    if xxd.len == 0 {
        doctor_record(st, cat + "", fst + "", "xxd", "not found: xxd", "Install xxd: sudo apt install xxd")
    } else {
        doctor_record(st, cat + "", "ok", "xxd", xxd, "")
    }
    pk := doctor_which("pkg-config")
    if pk.len == 0 {
        doctor_record(st, cat + "", fst + "", "pkg-config", "not found: pkg-config", "Install pkg-config: sudo apt install pkg-config")
    } else {
        doctor_record(st, cat + "", "ok", "pkg-config", pk, "")
    }
    if doctor_pkg_exists("gtk4") == 0 {
        doctor_record(st, cat + "", fst + "", "gtk4", "need gtk4.pc / libgtk-4-dev", "Install GTK4 dev package: sudo apt install libgtk-4-dev")
    } else if doctor_pkg_gtk410_ok() == 0 {
        doctor_record(st, cat + "", fst + "", "gtk4>=4.10", "host needs GtkFileDialog/GtkAlertDialog (GTK >= 4.10)", "Upgrade libgtk-4-dev to >= 4.10")
    } else {
        doctor_record(st, cat + "", "ok", "gtk4", "gtk4 (>=4.10)", "")
    }
    if webview == 1 {
        if doctor_pkg_exists("webkitgtk-6.0") == 0 {
            doctor_record(st, cat + "", fst + "", "webkitgtk-6.0", "need webkitgtk-6.0.pc / libwebkitgtk-6.0-dev", "Install WebKitGTK 6.0: sudo apt install libwebkitgtk-6.0-dev")
        } else {
            doctor_record(st, cat + "", "ok", "webkitgtk-6.0", "webkitgtk-6.0 present", "")
        }
    }
}

fn doctor_check_one(st $&DoctorState, root string, target_code int, webview int, phone_profile string) {
    if doctor_is_macos_target(target_code) == 1 {
        doctor_check_macos(st, target_code, webview, 1)
        <<
    }
    if doctor_is_windows_target(target_code) == 1 {
        doctor_check_windows(st, root, target_code, webview, 1)
        <<
    }
    if doctor_is_linux_target(target_code) == 1 {
        doctor_check_linux(st, webview, 1)
        <<
    }
    if doctor_is_phone_target(target_code) == 1 {
        doctor_check_phone_target(st, root, target_code, phone_profile, 1)
        <<
    }
    doctor_record(st, "target", "skip", "host tools", "target is not a supported desktop or phone target", "")
}

fn doctor_check_desktop_all(st $&DoctorState, root string, webview int, cross_required int) {
    h := doctor_host_os()
    $mac_req := 0
    if h == 0 { mac_req = 1 }
    $lin_req := 0
    if h == 1 { lin_req = 1 }
    $win_req := cross_required
    if h == 2 { win_req = 1 }

    doctor_section(st, "macos-arm64 / macos-x64")
    doctor_check_macos(st, 0, webview, mac_req)

    doctor_section(st, "windows-x64")
    doctor_check_windows(st, str_clone(&root), 21, webview, win_req)

    doctor_section(st, "windows-arm64")
    doctor_check_windows(st, root, 20, webview, win_req)

    doctor_section(st, "linux-arm64 / linux-x64")
    doctor_check_linux(st, webview, lin_req)
}

fn doctor_print_summary(st &DoctorState) {
    println("")
    $verdict := "ready"
    if st.missing_count > 0 {
        verdict = "not ready — fix [missing] items above"
    } else if st.warn_count > 0 {
        verdict = "ready with warnings"
    }
    println("Summary: ok=" + str(st.ok_count) +
        " warn=" + str(st.warn_count) +
        " missing=" + str(st.missing_count) +
        " skip=" + str(st.skip_count) +
        " (" + verdict + ")")
}

fn json_bool_str(v bool) string {
    if v { << "true" }
    << "false"
}

fn doctor_emit_json(st &DoctorState, mode string, target_str string, sdk_root string, strict bool) {
    passed := st.missing_count == 0 && (!strict || st.warn_count == 0)
    host := doctor_host_label()
    $b := strings.new_byte_builder(1024)
    b.write_str("{\n")
    b.write_str("  \"schema_version\": 1,\n")
    b.write_str("  \"host\": " + json.quote(&host) + ",\n")
    b.write_str("  \"mode\": " + json.quote(&mode) + ",\n")
    b.write_str("  \"target\": " + json.quote(&target_str) + ",\n")
    b.write_str("  \"sdk_root\": " + json.quote(&sdk_root) + ",\n")
    b.write_str("  \"passed\": " + json_bool_str(passed) + ",\n")
    b.write_str("  \"summary\": {\"ok\": " + str(st.ok_count) +
        ", \"warn\": " + str(st.warn_count) +
        ", \"missing\": " + str(st.missing_count) +
        ", \"skip\": " + str(st.skip_count) + "},\n")
    b.write_str("  \"checks\": [")
    for i in 0:st.checks.len {
        if i > 0 { b.write_str(",") }
        c := &st.checks[i]
        cat_s := c.category + ""
        name_s := c.name + ""
        stat_s := c.status + ""
        det_s := c.detail + ""
        hint_s := c.hint + ""
        b.write_str("\n    {\"category\": " + json.quote(&cat_s) +
            ", \"name\": " + json.quote(&name_s) +
            ", \"status\": " + json.quote(&stat_s) +
            ", \"detail\": " + json.quote(&det_s) +
            ", \"hint\": " + json.quote(&hint_s) + "}")
    }
    if st.checks.len > 0 {
        b.write_str("\n  ")
    }
    b.write_str("]\n}")
    println(b.to_string())
}

fn print_help() {
    println("usage: xu-doctor [options]")
    println("")
    println("Check Xu SDK integrity, desktop packing toolchains, and mobile phone targets.")
    println("")
    println("Options:")
    println("  --target TARGET         check only the specified target platform")
    println("                          (macos-arm64|macos-x64|linux-arm64|linux-x64|")
    println("                           windows-x64|windows-arm64|")
    println("                           ios-arm64|ios-simulator-arm64|android-arm64)")
    println("  --sdk                   check Xu SDK and sibling toolchain integrity only")
    println("  --desktop               check host toolchains required for desktop packing")
    println("  --phone                 check iOS & Android phone build toolchains")
    println("  --all                   check SDK, desktop, and phone toolchains")
    println("  --phone-profile PROF    phone profile for mobile checks: ui (default) | game")
    println("  --webview               also check desktop webview host dependencies")
    println("  --json                  emit machine-readable JSON report")
    println("  --strict                treat warnings as failures (exit 1)")
    println("  -q, --quiet             show only warnings, missing items, and summary")
    println("  -v, --verbose           show detailed per-tool SDK checks")
    println("  --version               print xu-doctor version and active Xu compiler")
    println("  -h, --help              show this help message")
}

fn doctor_run(argv []string) int {
    $target_code := 0
    $target_set := 0
    $webview := 0
    $mode_sdk := false
    $mode_desktop := false
    $mode_phone := false
    $mode_all := false
    $phone_profile := "ui"
    $profile_set := false
    $json_mode := false
    $strict := false
    $verbose := false
    $quiet := false

    $i := 0
    while i < argv.len {
        a := argv[i] + ""
        if a == "--desktop" {
            mode_desktop = true
        } else if a == "--sdk" {
            mode_sdk = true
        } else if a == "--phone" {
            mode_phone = true
        } else if a == "--all" {
            mode_all = true
        } else if a == "--webview" {
            webview = 1
        } else if a == "--json" {
            json_mode = true
        } else if a == "--strict" {
            strict = true
        } else if a == "-q" || a == "--quiet" {
            quiet = true
        } else if a == "-v" || a == "--verbose" {
            verbose = true
        } else if a == "--version" {
            xu_sib := sdk_sibling_or_empty("xu")
            $ver := ""
            if xu_sib.len > 0 {
                ver = doctor_probe_xu_version(&xu_sib)
            }
            if ver.len > 0 {
                println("xu-doctor (" + ver + ")")
            } else {
                println("xu-doctor")
            }
            << 0
        } else if a == "--phone-profile" {
            if i + 1 >= argv.len {
                eprintln("xu-doctor: --phone-profile requires ui or game")
                << 1
            }
            prof := argv[i + 1] + ""
            if prof != "ui" && prof != "game" {
                eprintln("xu-doctor: unknown --phone-profile '" + prof + "' (want ui or game)")
                << 1
            }
            phone_profile = prof
            profile_set = true
            i = i + 1
        } else if a == "--target" {
            if i + 1 >= argv.len {
                eprintln("xu-doctor: --target requires a name")
                << 1
            }
            t := parse_target(argv[i + 1])
            if t < 0 {
                eprintln("xu-doctor: unknown --target '" + argv[i + 1] + "' (valid: macos-arm64, macos-x64, linux-arm64, linux-x64, windows-x64, windows-arm64, ios-arm64, ios-simulator-arm64, android-arm64)")
                << 1
            }
            target_code = t
            target_set = 1
            i = i + 1
        } else if a == "-h" || a == "--help" {
            print_help()
            << 0
        } else {
            eprintln("xu-doctor: unexpected argument '" + a + "'")
            << 1
        }
        i = i + 1
    }

    if target_set == 1 && (mode_sdk || mode_desktop || mode_phone || mode_all) {
        eprintln("xu-doctor: --target cannot be combined with --sdk/--desktop/--phone/--all")
        << 1
    }

    if target_set == 0 && !mode_sdk && !mode_desktop && !mode_phone && !mode_all && profile_set {
        mode_phone = true
    }

    $mode_label := "all"
    $target_str := ""
    if target_set == 1 {
        mode_label = "target"
        target_str = target_name(target_code)
    } else if !mode_all && (mode_sdk || mode_desktop || mode_phone) {
        if mode_sdk && !mode_desktop && !mode_phone {
            mode_label = "sdk"
        } else if mode_desktop && !mode_sdk && !mode_phone {
            mode_label = "desktop"
        } else if mode_phone && !mode_sdk && !mode_desktop {
            mode_label = "phone"
        } else {
            mode_label = "custom"
        }
    }

    $st := new_doctor_state(json_mode, verbose, quiet)
    root := doctor_find_repo_root()
    host := doctor_host_label()

    if !st.json_mode {
        if target_set == 1 {
            println("xu-doctor — toolchain (" + target_str + ") [host=" + host + "]")
        } else if mode_label == "sdk" {
            println("xu-doctor — Xu SDK & toolchain integrity [host=" + host + "]")
        } else if mode_label == "desktop" {
            println("xu-doctor — desktop toolchains [host=" + host + "]")
        } else if mode_label == "phone" {
            println("xu-doctor — phone toolchains (profile=" + phone_profile + ") [host=" + host + "]")
        } else if mode_label == "custom" {
            println("xu-doctor — selected toolchains [host=" + host + "]")
        } else {
            println("xu-doctor — SDK, desktop & phone toolchains [host=" + host + "]")
        }
    }

    if root.len == 0 {
        doctor_record($&st, "sdk", "missing", "Xu SDK root", "need a full SDK with src/ui/host", "Set XU_ROOT or run from an installed Xu SDK")
    } else if target_set == 1 {
        doctor_check_sdk_core($&st, &root)
        doctor_check_one($&st, root + "", target_code, webview, phone_profile + "")
    } else if mode_label == "all" {
        doctor_section(&st, "sdk & toolchain")
        doctor_check_sdk_full($&st, &root)
        doctor_check_desktop_all($&st, root + "", webview, 0)
        doctor_check_phone_all($&st, root + "", phone_profile + "", 0)
    } else {
        if mode_sdk {
            if mode_desktop || mode_phone {
                doctor_section(&st, "sdk & toolchain")
            }
            doctor_check_sdk_full($&st, &root)
        } else {
            doctor_check_sdk_core($&st, &root)
        }
        if mode_desktop {
            doctor_check_desktop_all($&st, root + "", webview, 1)
        }
        if mode_phone {
            doctor_check_phone_all($&st, root + "", phone_profile + "", 1)
        }
    }

    if st.json_mode {
        doctor_emit_json(&st, mode_label, target_str, root + "", strict)
    } else {
        doctor_print_summary(&st)
    }

    if st.missing_count > 0 || (strict && st.warn_count > 0) {
        << 1
    }
    << 0
}

fn main() int {
    argv := args()
    $dargs := []string{}
    $i := 1
    while i < argv.len {
        dargs.push(argv[i])
        i = i + 1
    }
    << doctor_run(dargs)
}
