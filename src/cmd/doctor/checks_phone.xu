@main

#os
#strings

const PHONE_SDL_REVISION = "147a8ee32dbf9ac02f3794964490687b6bbda1bc"
const ANDROID_PLATFORM = "android-35"
const ANDROID_BUILD_TOOLS = "35.0.0"
const ANDROID_NDK_VER = "27.2.12479018"
const ANDROID_CMAKE_VER = "3.22.1"

fn phone_read_or_empty(path string) string {
    << read_file(path) or (err) {
        _ := err.msg()
        << ""
    }
}

fn phone_has_sdl_define(body &string, name string, expected string) bool {
    lines := strings.split(body, "\n")
    for i in 0:lines.len {
        trimmed := strings.trim_space(&lines[i])
        if !strings.has_prefix(&trimmed, "#define") { -> }
        rest := strings.trim_space(&trimmed[7:trimmed.len])
        if !strings.has_prefix(&rest, name + "") { -> }
        if rest.len <= name.len { -> }
        sep := rest[name.len] & 255
        if sep != 32 && sep != 9 { -> }
        val := strings.trim_space(&rest[name.len:rest.len])
        if val == expected { << true }
    }
    << false
}

fn doctor_check_phone_sdk_sources(st $&DoctorState, root &string, required int) {
    cat := "phone-sdk"
    fst := fail_status(required)
    req_files := [
        "src/ui/host/phone/host.cc",
        "src/ui/host/phone/runtime.cc",
        "src/ui/host/phone/canvas.html"
    ]
    req_dirs := [
        "src/cmd/phone/templates/ios",
        "src/cmd/phone/templates/android",
        "src/cmd/phone/templates/game"
    ]
    $missing := []string{}
    for i in 0:req_files.len {
        p := doctor_join_path(root + "", req_files[i] + "")
        if !file_exists(&p) { missing.push(req_files[i] + "") }
    }
    for i in 0:req_dirs.len {
        p := doctor_join_path(root + "", req_dirs[i] + "")
        if !dir_exists(&p) { missing.push(req_dirs[i] + "") }
    }
    miss_n := missing.len
    miss_str := strings.join(missing, ", ")
    if miss_n == 0 {
        doctor_record(st, cat + "", "ok", "phone host/templates", "host sources + ios/android/game templates present", "")
    } else {
        doctor_record(st, cat + "", fst + "", "phone host/templates", "missing: " + miss_str, "Ensure full Xu SDK sources are installed or set XU_ROOT")
    }
}

fn doctor_check_phone_sdl_source(st $&DoctorState, cat string, required int) {
    fst := fail_status(required)
    hint := "Checkout SDL release-3.4.14 (" + PHONE_SDL_REVISION + ") and export XU_PHONE_SDL_SOURCE=/path/to/SDL"
    src := os.getenv("XU_PHONE_SDL_SOURCE")
    if src.len == 0 {
        doctor_record(st, cat + "", fst + "", "XU_PHONE_SDL_SOURCE", "not set (required for --phone-profile game)", hint + "")
        <<
    }
    if !dir_exists(&src) {
        doctor_record(st, cat + "", fst + "", "XU_PHONE_SDL_SOURCE", "directory does not exist: " + src, hint + "")
        <<
    }
    git_dir := doctor_join_path(src + "", ".git")
    if path_exists(&git_dir) {
        git_bin := doctor_which("git")
        tar_bin := doctor_which("tar")
        if git_bin.len == 0 || tar_bin.len == 0 {
            doctor_record(st, cat + "", fst + "", "XU_PHONE_SDL_SOURCE", "git and tar are required to archive SDL git checkout", "Install git and tar on PATH")
            <<
        }
        out := doctor_exec_stdout(git_bin + "", ["-C", src + "", "rev-parse", "HEAD"])
        rev := strings.trim_space(&out)
        if rev != PHONE_SDL_REVISION {
            doctor_record(st, cat + "", fst + "", "XU_PHONE_SDL_SOURCE", "HEAD '" + rev + "' != locked " + PHONE_SDL_REVISION, "git -C \"" + src + "\" checkout " + PHONE_SDL_REVISION)
            <<
        }
        doctor_record(st, cat + "", "ok", "XU_PHONE_SDL_SOURCE", src + " (git " + PHONE_SDL_REVISION[0:12] + ")", "")
        <<
    }

    cm := doctor_join_path(src + "", "CMakeLists.txt")
    vh := doctor_join_path(src + "", "include/SDL3/SDL_version.h")
    if !file_exists(&cm) || !file_exists(&vh) {
        doctor_record(st, cat + "", fst + "", "XU_PHONE_SDL_SOURCE", "missing CMakeLists.txt or include/SDL3/SDL_version.h in " + src, hint + "")
        <<
    }
    hdr := phone_read_or_empty(vh + "")
    if !phone_has_sdl_define(&hdr, "SDL_MAJOR_VERSION", "3") ||
       !phone_has_sdl_define(&hdr, "SDL_MINOR_VERSION", "4") ||
       !phone_has_sdl_define(&hdr, "SDL_MICRO_VERSION", "14") {
        doctor_record(st, cat + "", fst + "", "XU_PHONE_SDL_SOURCE", "SDL_version.h is not release-3.4.14 in " + src, hint + "")
        <<
    }
    doctor_record(st, cat + "", "ok", "XU_PHONE_SDL_SOURCE", src + " (SDL 3.4.14)", "")
}

fn doctor_check_ios(st $&DoctorState, target_code int, profile string, required int, check_sdl bool) {
    cat := target_name(target_code)
    if profile == "game" && target_code == 31 {
        if required == 1 {
            doctor_record(st, cat + "", "missing", "ios game profile", "SDL GPU does not support iOS Simulator", "Use --target ios-arm64 with --phone-profile game")
        } else {
            doctor_record(st, cat + "", "skip", "ios game profile", "SDL GPU does not support iOS Simulator (use ios-arm64)", "")
        }
        <<
    }
    if doctor_host_os() != 0 {
        if required == 1 {
            doctor_record(st, cat + "", "missing", "ios tools", "iOS builds require a macOS host with Xcode", "Run on macOS with Xcode installed")
        } else {
            doctor_record(st, cat + "", "skip", "ios tools", "iOS builds require a macOS host with Xcode", "")
        }
        <<
    }

    fst := fail_status(required)
    xcrun := doctor_which("xcrun")
    if xcrun.len == 0 {
        doctor_record(st, cat + "", fst + "", "xcrun", "not found: xcrun", "Install Xcode and run: xcode-select --install")
        <<
    }
    doctor_record(st, cat + "", "ok", "xcrun", xcrun + "", "")

    if !doctor_exec_ok("xcode-select", ["-p"]) {
        doctor_record(st, cat + "", fst + "", "xcode-select", "no active developer directory", "Install Xcode and run: sudo xcode-select -s /Applications/Xcode.app/Contents/Developer")
    } else {
        dev := doctor_exec_stdout("xcode-select", ["-p"])
        dev_line := doctor_first_nonempty_line(&dev)
        if strings.contains(&dev_line, "CommandLineTools") {
            doctor_record(st, cat + "", fst + "", "xcode-select", dev_line + " (Command Line Tools only; full Xcode required for iOS)", "Install Xcode and run: sudo xcode-select -s /Applications/Xcode.app/Contents/Developer")
        } else {
            doctor_record(st, cat + "", "ok", "xcode-select", dev_line, "")
        }
    }

    $sdk_name := "iphoneos"
    if target_code == 31 { sdk_name = "iphonesimulator" }
    sdk_out := doctor_exec_stdout("xcrun", ["--sdk", sdk_name + "", "--show-sdk-path"])
    sdk_path := doctor_first_nonempty_line(&sdk_out)
    if sdk_path.len == 0 {
        doctor_record(st, cat + "", fst + "", sdk_name + " SDK", "xcrun --sdk " + sdk_name + " --show-sdk-path failed", "Install Xcode with iOS platform SDK (xcodebuild -downloadPlatform iOS)")
    } else {
        doctor_record(st, cat + "", "ok", sdk_name + " SDK", sdk_path + "", "")
    }

    clang_out := doctor_exec_stdout("xcrun", ["--sdk", sdk_name + "", "--find", "clang++"])
    clang_path := doctor_first_nonempty_line(&clang_out)
    if clang_path.len == 0 {
        doctor_record(st, cat + "", fst + "", "ios clang++", "xcrun --sdk " + sdk_name + " --find clang++ failed", "Ensure Xcode iOS toolchain is installed")
    } else {
        doctor_record(st, cat + "", "ok", "ios clang++", clang_path + "", "")
    }

    cs := doctor_which("codesign")
    if cs.len == 0 {
        doctor_record(st, cat + "", fst + "", "codesign", "not found: codesign", "Install Xcode Command Line Tools")
    } else {
        doctor_record(st, cat + "", "ok", "codesign", cs + "", "")
    }

    if target_code == 30 {
        ident := os.getenv("CODE_SIGN_IDENTITY")
        if ident.len == 0 {
            doctor_record(st, cat + "", "warn", "CODE_SIGN_IDENTITY", "not set (needed for device signing/install; unsigned game builds still compile)", "Export CODE_SIGN_IDENTITY=\"Apple Development: ...\" before device install")
        } else {
            doctor_record(st, cat + "", "ok", "CODE_SIGN_IDENTITY", ident + "", "")
        }
    } else if target_code == 31 {
        if doctor_exec_ok("xcrun", ["simctl", "help"]) {
            doctor_record(st, cat + "", "ok", "simctl", "xcrun simctl available", "")
        } else {
            doctor_record(st, cat + "", "skip", "simctl", "optional (iOS Simulator control)", "")
        }
    }

    if profile == "game" {
        cmake := doctor_tool_line("cmake", "--version")
        if cmake.len == 0 {
            doctor_record(st, cat + "", fst + "", "cmake", "not found: cmake (required for iOS game profile)", "Install CMake: brew install cmake")
        } else {
            doctor_record(st, cat + "", "ok", "cmake", cmake + "", "")
        }
        ninja := doctor_tool_line("ninja", "--version")
        if ninja.len == 0 {
            doctor_record(st, cat + "", fst + "", "ninja", "not found: ninja (required for iOS game profile)", "Install Ninja: brew install ninja")
        } else {
            doctor_record(st, cat + "", "ok", "ninja", ninja + "", "")
        }
        if check_sdl {
            doctor_check_phone_sdl_source(st, cat + "", required)
        }
    }
}

fn parse_javac_major(line &string) int {
    $i := 0
    while i < line.len {
        c := line[i] & 255
        if c >= 48 && c <= 57 {
            $val := 0
            while i < line.len {
                d := line[i] & 255
                if d < 48 || d > 57 { <- }
                val = val * 10 + (d - 48)
                i = i + 1
            }
            << val
        }
        i = i + 1
    }
    << -1
}

fn ndk_host_prebuilt_tag() string {
    h := doctor_host_os()
    if h == 0 { << "darwin-x86_64" }
    if h == 2 { << "windows-x86_64" }
    << "linux-x86_64"
}

fn doctor_check_android(st $&DoctorState, profile string, required int, check_sdl bool) {
    cat := "android-arm64"
    fst := fail_status(required)

    android_home := os.getenv("ANDROID_HOME")
    if android_home.len == 0 {
        sdk_root := os.getenv("ANDROID_SDK_ROOT")
        if sdk_root.len > 0 && dir_exists(&sdk_root) {
            doctor_record(st, cat + "", fst + "", "ANDROID_HOME", "ANDROID_HOME is not set (found ANDROID_SDK_ROOT=" + sdk_root + ")", "export ANDROID_HOME=" + sdk_root + " (Phone build.sh requires ANDROID_HOME)")
        } else {
            doctor_record(st, cat + "", fst + "", "ANDROID_HOME", "ANDROID_HOME is not set", "Install Android SDK and export ANDROID_HOME=/path/to/Android/Sdk")
        }
    } else if !dir_exists(&android_home) {
        doctor_record(st, cat + "", fst + "", "ANDROID_HOME", "directory does not exist: " + android_home, "Export ANDROID_HOME to a valid Android SDK directory")
    } else {
        doctor_record(st, cat + "", "ok", "ANDROID_HOME", android_home + "", "")

        jar_p := doctor_join_path(android_home + "", "platforms/" + ANDROID_PLATFORM + "/android.jar")
        if !file_exists(&jar_p) {
            doctor_record(st, cat + "", fst + "", "android platform", "missing " + jar_p, "sdkmanager \"platforms;" + ANDROID_PLATFORM + "\"")
        } else {
            doctor_record(st, cat + "", "ok", "android platform", ANDROID_PLATFORM, "")
        }

        bt_dir := doctor_join_path(android_home + "", "build-tools/" + ANDROID_BUILD_TOOLS)
        bt_bins := ["aapt2", "d8", "zipalign", "apksigner"]
        $bt_miss := []string{}
        for i in 0:bt_bins.len {
            cand := doctor_try_exe(doctor_join_path(bt_dir + "", bt_bins[i] + ""))
            if cand.len == 0 {
                bt_miss.push(bt_bins[i] + "")
            }
        }
        bt_miss_n := bt_miss.len
        bt_miss_str := strings.join(bt_miss, ", ")
        if bt_miss_n > 0 {
            doctor_record(st, cat + "", fst + "", "build-tools " + ANDROID_BUILD_TOOLS, "missing in " + bt_dir + ": " + bt_miss_str, "sdkmanager \"build-tools;" + ANDROID_BUILD_TOOLS + "\"")
        } else {
            doctor_record(st, cat + "", "ok", "build-tools " + ANDROID_BUILD_TOOLS, bt_dir + "", "")
        }

        cmake_bin := doctor_try_exe(doctor_join_path(android_home + "", "cmake/" + ANDROID_CMAKE_VER + "/bin/cmake"))
        ninja_bin := doctor_try_exe(doctor_join_path(android_home + "", "cmake/" + ANDROID_CMAKE_VER + "/bin/ninja"))
        if cmake_bin.len == 0 || ninja_bin.len == 0 {
            doctor_record(st, cat + "", fst + "", "SDK cmake " + ANDROID_CMAKE_VER, "missing cmake/ninja under " + android_home + "/cmake/" + ANDROID_CMAKE_VER, "sdkmanager \"cmake;" + ANDROID_CMAKE_VER + "\"")
        } else {
            doctor_record(st, cat + "", "ok", "SDK cmake " + ANDROID_CMAKE_VER, cmake_bin + "", "")
        }
    }

    $ndk_dir := os.getenv("ANDROID_NDK_HOME")
    if ndk_dir.len == 0 && android_home.len > 0 {
        ndk_dir = doctor_join_path(android_home + "", "ndk/" + ANDROID_NDK_VER)
    }
    if ndk_dir.len == 0 {
        doctor_record(st, cat + "", fst + "", "Android NDK", "ANDROID_NDK_HOME not set and ANDROID_HOME missing", "sdkmanager \"ndk;" + ANDROID_NDK_VER + "\"")
    } else {
        tc := doctor_join_path(ndk_dir + "", "build/cmake/android.toolchain.cmake")
        if !file_exists(&tc) {
            doctor_record(st, cat + "", fst + "", "Android NDK", "missing " + tc, "sdkmanager \"ndk;" + ANDROID_NDK_VER + "\" (or set ANDROID_NDK_HOME)")
        } else {
            doctor_record(st, cat + "", "ok", "Android NDK", ndk_dir + "", "")
        }
    }

    java_home := os.getenv("JAVA_HOME")
    if java_home.len == 0 {
        doctor_record(st, cat + "", fst + "", "JAVA_HOME", "JAVA_HOME is not set (requires JDK 17+)", "Install JDK 17+ and export JAVA_HOME")
    } else if !dir_exists(&java_home) {
        doctor_record(st, cat + "", fst + "", "JAVA_HOME", "directory does not exist: " + java_home, "Export JAVA_HOME to a valid JDK 17+ directory")
    } else {
        javac := doctor_try_exe(doctor_join_path(java_home + "", "bin/javac"))
        jar_tool := doctor_try_exe(doctor_join_path(java_home + "", "bin/jar"))
        keytool := doctor_try_exe(doctor_join_path(java_home + "", "bin/keytool"))
        if javac.len == 0 || jar_tool.len == 0 || keytool.len == 0 {
            doctor_record(st, cat + "", fst + "", "JAVA_HOME", "missing javac/jar/keytool in " + java_home + "/bin", "Install a full JDK 17+ and export JAVA_HOME")
        } else {
            jout := doctor_exec_output(javac + "", ["-version"])
            jline := doctor_first_nonempty_line(&jout)
            jver := parse_javac_major(&jline)
            if jver > 0 && jver < 17 {
                doctor_record(st, cat + "", fst + "", "JAVA_HOME (JDK 17+)", "found " + jline + " (need >= 17)", "Install JDK 17+ and export JAVA_HOME")
            } else if jline.len > 0 {
                doctor_record(st, cat + "", "ok", "JAVA_HOME (JDK 17+)", java_home + " (" + jline + ")", "")
            } else {
                doctor_record(st, cat + "", "ok", "JAVA_HOME (JDK 17+)", java_home + "", "")
            }
        }
    }

    zip_bin := doctor_which("zip")
    if zip_bin.len == 0 {
        doctor_record(st, cat + "", fst + "", "zip", "not found: zip (needed by Android build.sh)", "Install zip on PATH")
    } else {
        doctor_record(st, cat + "", "ok", "zip", zip_bin + "", "")
    }

    $adb := ""
    if android_home.len > 0 {
        adb = doctor_try_exe(doctor_join_path(android_home + "", "platform-tools/adb"))
    }
    if adb.len == 0 {
        adb = doctor_which("adb")
    }
    if adb.len == 0 {
        doctor_record(st, cat + "", "skip", "adb", "optional (Android device install / logcat)", "")
    } else {
        doctor_record(st, cat + "", "ok", "adb", adb + "", "")
    }

    if profile == "game" {
        if ndk_dir.len > 0 {
            re := doctor_try_exe(doctor_join_path(ndk_dir + "", "toolchains/llvm/prebuilt/" + ndk_host_prebuilt_tag() + "/bin/llvm-readelf"))
            if re.len == 0 {
                doctor_record(st, cat + "", fst + "", "NDK llvm-readelf", "not found in NDK prebuilt toolchain (needed for 16KB ELF alignment check)", "Reinstall NDK " + ANDROID_NDK_VER)
            } else {
                doctor_record(st, cat + "", "ok", "NDK llvm-readelf", re + "", "")
            }
        }
        if check_sdl {
            doctor_check_phone_sdl_source(st, cat + "", required)
        }
    }
}

fn doctor_check_phone_target(st $&DoctorState, root string, target_code int, profile string, required int) {
    doctor_check_phone_sdk_sources(st, &root, required)
    if target_code == 30 || target_code == 31 {
        doctor_check_ios(st, target_code, profile + "", required, true)
    } else if target_code == 32 {
        doctor_check_android(st, profile + "", required, true)
    }
}

fn doctor_check_phone_all(st $&DoctorState, root string, profile string, required int) {
    doctor_section(st, "phone SDK sources")
    doctor_check_phone_sdk_sources(st, &root, 1)
    if profile == "game" {
        doctor_check_phone_sdl_source(st, "phone-sdk", required)
    }

    $ios_req := 0
    if required == 1 && doctor_host_os() == 0 { ios_req = 1 }
    doctor_section(st, "ios-arm64")
    doctor_check_ios(st, 30, profile + "", ios_req, false)

    if profile != "game" {
        doctor_section(st, "ios-simulator-arm64")
        doctor_check_ios(st, 31, profile + "", ios_req, false)
    } else {
        doctor_section(st, "ios-simulator-arm64")
        doctor_check_ios(st, 31, profile + "", 0, false)
    }

    doctor_section(st, "android-arm64")
    doctor_check_android(st, profile + "", required, false)
}
