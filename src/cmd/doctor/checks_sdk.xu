@main

#os
#path/filepath
#strings
#internal/toolpath

fn sdk_sibling_or_empty(name string) string {
    << toolpath.sibling(&name) or (err) {
        _ := err.msg()
        << ""
    }
}

fn sdk_real_path_or(path &string) string {
    << toolpath.real_path(path) or (err) {
        _ := err.msg()
        << *path + ""
    }
}

fn sdk_read_or_empty(path string) string {
    << read_file(path) or (err) {
        _ := err.msg()
        << ""
    }
}

fn sdk_dir_write_state(path string) int {
    // Returns: 1 = writable dir, 0 = read-only dir or non-dir file, -1 = missing
    info := os_stat(path) or (err) {
        _ := err.msg()
        << -1
    }
    if !info.is_dir { << 0 }
    if doctor_host_os() == 2 { << 1 }
    if (info.mode & 146) != 0 { << 1 }
    << 0
}

fn sdk_is_writable_dir_or_parent(path &string) int {
    // Returns: 1 = writable, 0 = not writable, -1 = cannot resolve existing ancestor
    $cur := path + ""
    for _ in 0:16 {
        if cur.len == 0 { << -1 }
        st := sdk_dir_write_state(cur + "")
        if st >= 0 { << st }
        parent := filepath.dir(&cur)
        if parent == cur { << -1 }
        cur = parent
    }
    << -1
}

fn doctor_extract_xu_semver(ver_line &string) string {
    idx := strings.index_of(ver_line, " v")
    if idx < 0 {
        << ""
    }
    $k := idx + 2
    $end := k
    while end < ver_line.len {
        c := ver_line[end] & 255
        if c == 32 || c == 9 || c == 10 || c == 13 { <- }
        end += 1
    }
    if end > k {
        << ver_line[k:end] + ""
    }
    << ""
}

fn doctor_read_xun_xu_ver(xun_path &string) string {
    raw := sdk_read_or_empty(*xun_path + "")
    if raw.len == 0 { << "" }
    lines := strings.split(&raw, "\n")
    for i in 0:lines.len {
        line := strings.trim_space(&lines[i])
        if !strings.has_prefix(&line, "xu:") { -> }
        vidx := strings.index_of(&line, "!ver")
        if vidx < 0 { -> }
        rest := strings.trim_space(&line[vidx + 4 : line.len])
        $end := 0
        while end < rest.len {
            c := rest[end] & 255
            if c == 32 || c == 9 || c == 35 || c == 13 { <- }
            end += 1
        }
        if end > 0 {
            << rest[0:end] + ""
        }
    }
    << ""
}

fn doctor_probe_xu_version(xu_bin &string) string {
    out := doctor_exec_output(xu_bin + "", ["--version"])
    if out.len == 0 {
        << ""
    }
    lines := strings.split(&out, "\n")
    for i in 0:lines.len {
        t := strings.trim_space(&lines[i])
        idx := strings.index_of(&t, "Xu Compiler")
        if idx >= 0 {
            << t[idx:t.len] + ""
        }
    }
    << doctor_first_nonempty_line(&out)
}

fn doctor_check_sdk_core(st $&DoctorState, root &string) {
    // Keep "Xu SDK root" name and exact path detail intact for test_installed_sdk.py.
    doctor_record(st, "sdk", "ok", "Xu SDK root", root + "", "")

    xu_sib := sdk_sibling_or_empty("xu")
    if xu_sib.len == 0 {
        doctor_record(st, "sdk", "missing", "xu compiler", "missing sibling xu binary", "Build with 'make xu' or reinstall Xu SDK")
        <<
    }
    if !is_executable_file(&xu_sib) {
        doctor_record(st, "sdk", "missing", "xu compiler", xu_sib + " (not executable)", "Run: chmod +x " + xu_sib)
        <<
    }
    ver := doctor_probe_xu_version(&xu_sib)
    if ver.len > 0 {
        doctor_record(st, "sdk", "ok", "xu compiler", xu_sib + " (" + ver + ")", "")
    } else {
        doctor_record(st, "sdk", "ok", "xu compiler", xu_sib + "", "")
    }
}

fn doctor_check_sdk_full(st $&DoctorState, root &string) {
    doctor_check_sdk_core(st, root)

    req_dirs := [
        "src/core",
        "src/os",
        "src/ui/host",
        "src/ui/host/phone",
        "src/cmd/phone/templates"
    ]
    $missing_dirs := []string{}
    for i in 0:req_dirs.len {
        full := doctor_join_path(root + "", req_dirs[i] + "")
        if !dir_exists(&full) {
            missing_dirs.push(req_dirs[i] + "")
        }
    }
    miss_n := missing_dirs.len
    miss_str := strings.join(missing_dirs, ", ")
    if miss_n == 0 {
        doctor_record(st, "sdk", "ok", "SDK stdlib/host dirs", str(req_dirs.len) + "/" + str(req_dirs.len) + " present", "")
    } else {
        doctor_record(st, "sdk", "missing", "SDK stdlib/host dirs", "missing: " + miss_str, "Reinstall full Xu SDK or set XU_ROOT to a complete checkout")
    }

    siblings := [
        "xu-desktop",
        "xu-phone",
        "xu-fmt",
        "xu-doc",
        "xu-map",
        "xu-lsp",
        "xu-native",
        "xu-setup",
        "xu-update",
        "xu-xacp"
    ]
    $ok_tools := 0
    $bad_tools := []string{}
    for i in 0:siblings.len {
        tname := siblings[i] + ""
        sib := sdk_sibling_or_empty(tname + "")
        if sib.len == 0 {
            bad_tools.push(tname + " (missing)")
            if st.verbose {
                doctor_record(st, "sdk", "warn", tname + "", "missing sibling binary", "Run 'make tools' or reinstall Xu SDK")
            }
        } else if !is_executable_file(&sib) {
            bad_tools.push(tname + " (not executable)")
            if st.verbose {
                doctor_record(st, "sdk", "warn", tname + "", sib + " (not executable)", "Run: chmod +x " + sib)
            }
        } else {
            ok_tools = ok_tools + 1
            if st.verbose {
                doctor_record(st, "sdk", "ok", tname + "", sib, "")
            }
        }
    }
    bad_n := bad_tools.len
    bad_str := strings.join(bad_tools, ", ")
    if !st.verbose {
        if bad_n == 0 {
            doctor_record(st, "sdk", "ok", "sibling tools", str(ok_tools) + "/" + str(siblings.len) + " present and executable", "")
        } else {
            doctor_record(st, "sdk", "warn", "sibling tools", str(ok_tools) + "/" + str(siblings.len) + " ready; issues: " + bad_str, "Run 'make tools' in xu repo or reinstall Xu SDK")
        }
    }

    xu_root_env := os.getenv("XU_ROOT")
    if xu_root_env.len > 0 {
        abi := doctor_join_path(xu_root_env + "", "src/ui/host/xu_content_abi.h")
        if !dir_exists(&xu_root_env) || !file_exists(&abi) {
            doctor_record(st, "sdk", "warn", "XU_ROOT", "XU_ROOT='" + xu_root_env + "' is incomplete (missing src/ui/host/xu_content_abi.h)", "Unset XU_ROOT or point it to a valid Xu SDK root")
        } else {
            resolved_env := sdk_real_path_or(&xu_root_env)
            resolved_root := sdk_real_path_or(root)
            if resolved_env != resolved_root {
                doctor_record(st, "sdk", "warn", "XU_ROOT", "XU_ROOT=" + resolved_env + " differs from active SDK " + resolved_root, "Unset XU_ROOT if using an installed SDK")
            } else {
                doctor_record(st, "sdk", "ok", "XU_ROOT", xu_root_env, "")
            }
        }
    }

    xu_sib := sdk_sibling_or_empty("xu")
    path_xu := doctor_which("xu")
    if path_xu.len == 0 {
        $bin_hint := "Add Xu bin/ directory to PATH"
        if xu_sib.len > 0 {
            bin_hint = "Add " + filepath.dir(&xu_sib) + " to PATH"
        }
        doctor_record(st, "sdk", "warn", "PATH (xu)", "xu not found on PATH", bin_hint)
    } else if xu_sib.len > 0 {
        r_path := sdk_real_path_or(&path_xu)
        r_sib := sdk_real_path_or(&xu_sib)
        if r_path != r_sib {
            doctor_record(st, "sdk", "warn", "PATH (xu)", "PATH xu (" + r_path + ") differs from sibling (" + r_sib + ")", "Put " + filepath.dir(&r_sib) + " earlier in PATH")
        } else {
            doctor_record(st, "sdk", "ok", "PATH (xu)", path_xu, "")
        }
    }

    // Check XU_CACHE writability.
    $cache_dir := os.getenv("XU_CACHE")
    if cache_dir.len == 0 && xu_sib.len > 0 {
        cout := doctor_exec_stdout(xu_sib + "", ["env", "XU_CACHE"])
        cache_dir = doctor_first_nonempty_line(&cout)
    }
    if cache_dir.len > 0 {
        cw := sdk_is_writable_dir_or_parent(&cache_dir)
        if cw == 1 {
            doctor_record(st, "sdk", "ok", "XU_CACHE", cache_dir + " (writable)", "")
        } else if cw == 0 {
            doctor_record(st, "sdk", "warn", "XU_CACHE", cache_dir + " is not writable", "chmod u+w \"" + cache_dir + "\" or set XU_CACHE to a writable directory")
        }
    }

    // Check current working directory xu.xun version compatibility if present.
    cwd := os.getwd()
    if cwd.len > 0 {
        xun_p := doctor_join_path(cwd + "", "xu.xun")
        if file_exists(&xun_p) {
            req_ver := doctor_read_xun_xu_ver(&xun_p)
            if req_ver.len > 0 && xu_sib.len > 0 {
                ver_line := doctor_probe_xu_version(&xu_sib)
                actual_ver := doctor_extract_xu_semver(&ver_line)
                if actual_ver.len > 0 && actual_ver != req_ver {
                    doctor_record(st, "sdk", "warn", "workspace xu.xun", "requires xu " + req_ver + ", active compiler is " + actual_ver, "Switch PATH/XU to Xu " + req_ver + " or update xu: !ver in xu.xun")
                } else {
                    doctor_record(st, "sdk", "ok", "workspace xu.xun", "requires xu " + req_ver + " (matches active compiler)", "")
                }
            }
        }
    }

    // Core developer utilities used by `xu native`, `xu get`, `xu debug`, and wasm32-wasi.
    $cc := doctor_tool_line("clang", "--version")
    if cc.len == 0 { cc = doctor_tool_line("gcc", "--version") }
    if cc.len == 0 { cc = doctor_tool_line("cc", "--version") }
    if cc.len == 0 {
        doctor_record(st, "dev", "warn", "host C compiler", "not found: clang/gcc/cc (needed by 'xu native')", "Install clang or gcc")
    } else {
        doctor_record(st, "dev", "ok", "host C compiler", cc, "")
    }

    git := doctor_tool_line("git", "--version")
    if git.len == 0 {
        doctor_record(st, "dev", "warn", "git", "not found: git (needed by 'xu get' / 'xu install')", "Install git")
    } else {
        doctor_record(st, "dev", "ok", "git", git, "")
    }

    $dbg := doctor_which("lldb")
    if dbg.len == 0 { dbg = doctor_which("gdb") }
    if dbg.len == 0 {
        doctor_record(st, "dev", "skip", "debugger", "optional (install lldb or gdb for 'xu debug')", "")
    } else {
        doctor_record(st, "dev", "ok", "debugger", dbg, "")
    }

    $wasi := doctor_which("wasmtime")
    if wasi.len == 0 { wasi = doctor_which("wasmer") }
    if wasi.len == 0 { wasi = doctor_which("node") }
    if wasi.len == 0 {
        doctor_record(st, "dev", "skip", "wasm runtime", "optional (install wasmtime or node for wasm32-wasi)", "")
    } else {
        doctor_record(st, "dev", "ok", "wasm runtime", wasi, "")
    }
}
