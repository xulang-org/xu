@main

#os
#path/filepath
#errors

fn desktop_macos_rm_td(td &string) {
    os_system("rm -rf " + desktop_shell_quote(td))
}

fn desktop_macos_meta(td &string, key string) string {
    << td + "/pack." + key
}

fn desktop_macos_meta_write(td &string, key string, val string) int {
    write_file(desktop_macos_meta(td, key), val) or (err) {
        << 1
    }
    << 0
}

fn desktop_macos_meta_read(td &string, key string) string {
    body := read_file(desktop_macos_meta(td, key)) or (err) {
        << ""
    }
    << body
}

fn desktop_macos_cmd_emit_xu(td &string, main_xu string, target_code int) int {
    << desktop_macos_cmd_emit_xu_go(td, main_xu, target_code)
}

fn desktop_macos_cmd_emit_xu_go(td &string, main_xu string, target_code int) int {
    mut xu_target := "macos-arm64"
    if target_code == 1 {
        xu_target = "macos-x64"
    }
    xuobj := td + "/app.xuobj"
    self := desktop_compiler_bin()
    emit_cmd := desktop_shell_quote(&self) + " build " + desktop_shell_quote(&main_xu) + " --target " + xu_target + " --emit-obj -o " + desktop_shell_quote(&xuobj)
    rc := os_system(emit_cmd)
    if rc != 0 {
        eprintln("xu: --emit-obj failed")
        desktop_macos_rm_td(td)
        << 1
    }
    << desktop_macos_cmd_emit_xu_macho(td, xuobj)
}

fn desktop_macos_cmd_emit_xu_macho(td &string, xuobj string) int {
    xu_o := td + "/app.o"
    self := desktop_compiler_bin()
    macho_cmd := desktop_shell_quote(&self) + " _macho_o " + desktop_shell_quote(&xuobj) + " " + desktop_shell_quote(&xu_o)
    rc := os_system(macho_cmd)
    if rc != 0 {
        eprintln("xu: xuobj→macho failed")
        desktop_macos_rm_td(td)
        << 1
    }
    << desktop_macos_pack_phases_swift(td)
}

fn desktop_macos_run_doctor(target_code int, webview int) int {
    << desktop_run_doctor_exec(target_code, webview)
}

fn desktop_macos_alloc_td() string {
    mut td := "/tmp/xu_mac_ui_" + str(now_ns() & 268435455)
    desktop_macos_rm_td(&td)
    host_dir := td + "/host"
    os_system("mkdir -p " + desktop_shell_quote(&host_dir))
    << td
}

fn desktop_macos_pack_write_icon(td &string, app_dir string) int {
    icon := desktop_resolve_icon(str_clone(&app_dir))
    if icon.len == 0 {
        eprintln("xu: missing brand icon — put one under App/brand/:")
        eprintln("xu:   brand/icon.png | brand/xu_app_icon.png | brand/xu_app_logo.png")
        << 1
    }
    << desktop_macos_meta_write(td, "icon", icon)
}

fn desktop_macos_pack_write_www(td &string, app_dir string, need_wv int, www_override string) int {
    mut www := str_clone(&www_override)
    if www.len == 0 && need_wv == 1 {
        sib := app_dir + "/www"
        if desktop_is_dir(&sib) == 1 {
            www = str_clone(&sib)
        }
    }
    << desktop_macos_meta_write(td, "www", www)
}

fn desktop_macos_pack_write_env(td &string, triple string, root string, out string, arch string, xu_target string, www string, need_wv int, bundle string, icon string, app_dir string) int {
    mut wv_src := ""
    mut wv_fw := ""
    if need_wv == 1 {
        wv_src = root + "/src/ui/host/macos_webview.swift"
        wv_fw = " -framework WebKit"
    }
    mut www_o := ""
    if www.len > 0 {
        www_o = td + "/www_blob.o"
    }
    oneexe := td + "/oneexe"
    env := "td=" + desktop_shell_quote(td) + "\ntriple=" + desktop_shell_quote(&triple) + "\nroot=" + desktop_shell_quote(&root) + "\nout=" + desktop_shell_quote(&out) + "\noneexe=" + desktop_shell_quote(&oneexe) + "\nbundle=" + desktop_shell_quote(&bundle) + "\nicon=" + desktop_shell_quote(&icon) + "\narch=" + desktop_shell_quote(&arch) + "\nxu_target=" + desktop_shell_quote(&xu_target) + "\nwww=" + desktop_shell_quote(&www) + "\nwww_o=" + desktop_shell_quote(&www_o) + "\nwv_src=" + desktop_shell_quote(&wv_src) + "\nwv_fw=" + desktop_shell_quote(&wv_fw) + "\napp_dir=" + desktop_shell_quote(&app_dir) + "\n"
    << desktop_macos_meta_write(td, "env", env)
}

fn desktop_macos_pack_init(td &string, main_xu &string, target_code int, out string, webview int, no_webview int, www_override string, root string) int {
    mut arch := "arm64"
    mut xu_target := "macos-arm64"
    if target_code == 1 {
        arch = "x64"
        xu_target = "macos-x64"
    }
    triple := desktop_apple_triple(str_clone(&arch))
    app_dir := desktop_parent_dir(main_xu)
    app_out := desktop_macos_normalize_app_out(str_clone(&out), str_clone(&app_dir))
    mut bundle := desktop_basename(&app_out)
    bundle = desktop_strip_app_suffix(str_clone(&bundle))
    if bundle.len == 0 {
        bundle = "XuApp"
    }
    need_wv := desktop_needs_webview(str_clone(&app_dir), str_clone(main_xu), str_clone(&www_override), webview, no_webview)
    mut www := str_clone(&www_override)
    if www.len == 0 && need_wv == 1 {
        sib := app_dir + "/www"
        if desktop_is_dir(&sib) == 1 {
            www = str_clone(&sib)
        }
    }
    if desktop_macos_meta_write(td, "main_xu", str_clone(main_xu)) != 0 {
        << 1
    }
    if desktop_macos_meta_write(td, "out", str_clone(&app_out)) != 0 {
        << 1
    }
    if desktop_macos_meta_write(td, "bundle", str_clone(&bundle)) != 0 {
        << 1
    }
    if desktop_macos_meta_write(td, "root", str_clone(&root)) != 0 {
        << 1
    }
    if desktop_macos_meta_write(td, "arch", str_clone(&arch)) != 0 {
        << 1
    }
    if desktop_macos_meta_write(td, "xu_target", str_clone(&xu_target)) != 0 {
        << 1
    }
    if desktop_macos_meta_write(td, "triple", str_clone(&triple)) != 0 {
        << 1
    }
    if desktop_macos_meta_write(td, "app_dir", str_clone(&app_dir)) != 0 {
        << 1
    }
    if desktop_macos_pack_write_www(td, str_clone(&app_dir), need_wv, str_clone(&www_override)) != 0 {
        << 1
    }
    if desktop_macos_pack_write_icon(td, str_clone(&app_dir)) != 0 {
        << 1
    }
    icon := desktop_macos_meta_read(td, "icon")
    mut wv_s := "0"
    if need_wv == 1 {
        wv_s = "1"
    }
    if desktop_macos_meta_write(td, "need_wv", wv_s) != 0 {
        << 1
    }
    << desktop_macos_pack_write_env(td, triple, root, app_out, arch, xu_target, www, need_wv, bundle, icon, app_dir)
}

fn desktop_macos_write_text(path &string, body string) int {
    write_file(str_clone(path), body) or (err) {
        << 1
    }
    << 0
}

fn desktop_macos_cmd_swift_host(td &string) int {
    sh := td + "/swift_host.sh"
    tdq := desktop_shell_quote(td)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\nhost_swift=\"$$root/src/ui/host/macos_host.swift\"\ndraw_swift=\"$$root/src/ui/host/macos_draw.swift\"\nif [ -n \"$$wv_src\" ]; then\n  exec swiftc -target \"$$triple\" -parse-as-library -c -O -D XU_UI_STATIC -module-name XuUIHost \"$$host_swift\" \"$$draw_swift\" \"$$wv_src\" -working-directory " + tdq + "/host -framework AppKit -framework UserNotifications -framework QuartzCore$$wv_fw\nfi\nexec swiftc -target \"$$triple\" -parse-as-library -c -O -D XU_UI_STATIC -module-name XuUIHost \"$$host_swift\" \"$$draw_swift\" -working-directory " + tdq + "/host -framework AppKit -framework UserNotifications -framework QuartzCore\n"
    if desktop_macos_write_text(&sh, body) != 0 {
        eprintln("xu: cannot write swift_host.sh")
        desktop_macos_rm_td(td)
        << 1
    }
    rc := os_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: swiftc host compile failed")
        desktop_macos_rm_td(td)
        << 1
    }
    << desktop_macos_pack_phases_clang(td)
}

fn desktop_macos_cmd_clang_file(triple &string, root &string, src &string, out_o &string) int {
    host_inc := root + "/src/ui/host"
    clang_c := "clang -target " + triple + " -c -O2 -I" + desktop_shell_quote(&host_inc)
    rc := os_system(clang_c + " " + desktop_shell_quote(src) + " -o " + desktop_shell_quote(out_o))
    << rc
}

fn desktop_macos_cmd_clang_assets(td &string) int {
    sh := td + "/clang_assets.sh"
    tdq := desktop_shell_quote(td)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\ninc=\"$$root/src/ui/host\"\nclang -target \"$$triple\" -c -O2 -I\"$$inc\" \"$$root/src/ui/host/xu_pack_assets.c\" -o " + tdq + "/xu_pack_assets.o\nclang -target \"$$triple\" -c -O2 -I\"$$inc\" \"$$root/src/ui/host/xu_pack_assets_weak.c\" -o " + tdq + "/xu_pack_assets_weak.o\nclang++ -target \"$$triple\" -c -O2 -I\"$$inc\" \"$$root/src/ui/host/xu_ui_mem.cc\" -o " + tdq + "/xu_ui_mem.o\n"
    if desktop_macos_write_text(&sh, body) != 0 {
        eprintln("xu: cannot write clang_assets.sh")
        desktop_macos_rm_td(td)
        << 1
    }
    rc := os_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: clang assets failed")
        desktop_macos_rm_td(td)
        << 1
    }
    << desktop_macos_pack_phases_icon(td)
}

fn desktop_macos_cmd_icon_blob(td &string) int {
    icon_c := td + "/icon_blob.c"
    icon_o := td + "/icon_blob.o"
    icon_png := desktop_meta_trim(desktop_macos_meta_read(td, "icon"))
    if desktop_write_icon_blob_c(icon_png, str_clone(&icon_c)) != 0 {
        desktop_macos_rm_td(td)
        << 1
    }
    sh := td + "/icon_clang.sh"
    tdq := desktop_shell_quote(td)
    icq := desktop_shell_quote(&icon_c)
    ioq := desktop_shell_quote(&icon_o)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\nclang -target \"$$triple\" -c -O2 -I\"$$root/src/ui/host\" " + icq + " -o " + ioq + "\n"
    if desktop_macos_write_text(&sh, body) != 0 {
        desktop_macos_rm_td(td)
        << 1
    }
    rc2 := os_system("sh " + desktop_shell_quote(&sh))
    if rc2 != 0 {
        eprintln("xu: clang icon_blob.c failed")
        desktop_macos_rm_td(td)
        << 1
    }
    << desktop_macos_pack_phases_www(td)
}

fn desktop_macos_cmd_www_blob(td &string) int {
    www_dir := desktop_meta_trim(desktop_macos_meta_read(td, "www"))
    if www_dir.len == 0 {
        << desktop_macos_pack_phases_shim(td)
    }
    www_c := td + "/www_blob.c"
    www_o := td + "/www_blob.o"
    icon_png := desktop_meta_trim(desktop_macos_meta_read(td, "icon"))
    app_dir := desktop_meta_trim(desktop_macos_meta_read(td, "app_dir"))
    root := desktop_meta_trim(desktop_macos_meta_read(td, "root"))
    mut rc := desktop_write_www_blob_c(www_dir, icon_png, app_dir, root, str_clone(&www_c))
    if rc != 0 {
        eprintln("xu: www blob write failed")
        desktop_macos_rm_td(td)
        << 1
    }
    sh := td + "/www_clang.sh"
    tdq := desktop_shell_quote(td)
    wcq := desktop_shell_quote(&www_c)
    woq := desktop_shell_quote(&www_o)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\nclang -target \"$$triple\" -c -O2 -I\"$$root/src/ui/host\" " + wcq + " -o " + woq + "\n"
    if desktop_macos_write_text(&sh, body) != 0 {
        desktop_macos_rm_td(td)
        << 1
    }
    rc = os_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: clang www_blob.c failed")
        desktop_macos_rm_td(td)
        << 1
    }
    << desktop_macos_pack_phases_shim(td)
}

fn desktop_macos_cmd_shim(td &string) int {
    shim_c := td + "/shim.c"
    shim_o := td + "/shim.o"
    if desktop_write_shim_c(str_clone(&shim_c)) != 0 {
        desktop_macos_rm_td(td)
        << 1
    }
    sh := td + "/shim_clang.sh"
    tdq := desktop_shell_quote(td)
    scq := desktop_shell_quote(&shim_c)
    soq := desktop_shell_quote(&shim_o)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\nclang -target \"$$triple\" -c -O2 -I\"$$root/src/ui/host\" " + scq + " -o " + soq + "\n"
    if desktop_macos_write_text(&sh, body) != 0 {
        desktop_macos_rm_td(td)
        << 1
    }
    mut rc := os_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: clang shim.c failed")
        desktop_macos_rm_td(td)
        << 1
    }
    << desktop_macos_pack_phases_archive(td)
}

fn desktop_macos_cmd_archive(td &string) int {
    sh := td + "/archive.sh"
    tdq := desktop_shell_quote(td)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\nar rcs \"$$td/libxu_ui_host.a\" \"$$td\"/host/*.o \"$$td/xu_pack_assets.o\" \"$$td/xu_pack_assets_weak.o\" \"$$td/xu_ui_mem.o\"\n"
    if desktop_macos_write_text(&sh, body) != 0 {
        desktop_macos_rm_td(td)
        << 1
    }
    rc := os_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: ar libxu_ui_host.a failed")
        desktop_macos_rm_td(td)
        << 1
    }
    << desktop_macos_cmd_link(td)
}

fn desktop_macos_cmd_link(td &string) int {
    sh := td + "/link.sh"
    tdq := desktop_shell_quote(td)
    // Link bare Mach-O to $$oneexe; wrap into Finder .app next.
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\nobjs=\"$$td/shim.o $$td/icon_blob.o $$td/app.o $$www_o\"\nswiftc -target \"$$triple\" -O -o \"$$oneexe\" $$objs -framework AppKit -framework UserNotifications -framework QuartzCore$$wv_fw -Xlinker -force_load -Xlinker \"$$td/libxu_ui_host.a\" -Xlinker -undefined -Xlinker dynamic_lookup\n"
    if desktop_macos_write_text(&sh, body) != 0 {
        desktop_macos_rm_td(td)
        << 1
    }
    rc := os_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: desktop link failed")
        desktop_macos_rm_td(td)
        << 1
    }
    << desktop_macos_cmd_wrap_app(td)
}

fn desktop_macos_cmd_wrap_app(td &string) int {
    sh := td + "/wrap_app.sh"
    tdq := desktop_shell_quote(td)
    // Assemble .app: MacOS/exe + Resources/AppIcon.icns + Info.plist + ad-hoc sign.
    // Explicit sips lines (avoid ${var%%pat} — $$ escaping is easy to get wrong under sh).
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\nrm -rf \"$$out\"\nmkdir -p \"$$out/Contents/MacOS\" \"$$out/Contents/Resources\"\ncp \"$$oneexe\" \"$$out/Contents/MacOS/$$bundle\"\nchmod 755 \"$$out/Contents/MacOS/$$bundle\"\niconset=\"$$td/AppIcon.iconset\"\nrm -rf \"$$iconset\"\nmkdir -p \"$$iconset\"\nsips -z 16 16 \"$$icon\" --out \"$$iconset/icon_16x16.png\" >/dev/null\nsips -z 32 32 \"$$icon\" --out \"$$iconset/diana.s@example.org\" >/dev/null\nsips -z 32 32 \"$$icon\" --out \"$$iconset/icon_32x32.png\" >/dev/null\nsips -z 64 64 \"$$icon\" --out \"$$iconset/ivan.p@example.net\" >/dev/null\nsips -z 128 128 \"$$icon\" --out \"$$iconset/icon_128x128.png\" >/dev/null\nsips -z 256 256 \"$$icon\" --out \"$$iconset/wendy.h@example.net\" >/dev/null\nsips -z 256 256 \"$$icon\" --out \"$$iconset/icon_256x256.png\" >/dev/null\nsips -z 512 512 \"$$icon\" --out \"$$iconset/wendy.h@example.net\" >/dev/null\nsips -z 512 512 \"$$icon\" --out \"$$iconset/icon_512x512.png\" >/dev/null\nsips -z 1024 1024 \"$$icon\" --out \"$$iconset/walt.e@example.net\" >/dev/null\niconutil -c icns \"$$iconset\" -o \"$$out/Contents/Resources/AppIcon.icns\"\nplist=\"$$out/Contents/Info.plist\"\nprintf '%s\\n' '<?xml version=\"1.0\" encoding=\"UTF-8\"?>' '<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">' '<plist version=\"1.0\">' '<dict>' '	<key>CFBundleDevelopmentRegion</key>' '	<string>en</string>' '	<key>CFBundleDisplayName</key>' \"	<string>$$bundle</string>\" '	<key>CFBundleExecutable</key>' \"	<string>$$bundle</string>\" '	<key>CFBundleIconFile</key>' '	<string>AppIcon</string>' '	<key>CFBundleIdentifier</key>' \"	<string>dev.xu.ui.$$bundle</string>\" '	<key>CFBundleInfoDictionaryVersion</key>' '	<string>6.0</string>' '	<key>CFBundleName</key>' \"	<string>$$bundle</string>\" '	<key>CFBundlePackageType</key>' '	<string>APPL</string>' '	<key>CFBundleShortVersionString</key>' '	<string>0.9.2</string>' '	<key>XuToolchainVersion</key>' '	<string>0.9.2-dev.2</string>' '	<key>CFBundleVersion</key>' '	<string>1</string>' '	<key>LSMinimumSystemVersion</key>' '	<string>12.0</string>' '	<key>NSHighResolutionCapable</key>' '	<true/>' '	<key>NSUserNotificationAlertStyle</key>' '	<string>banner</string>' '	<key>NSPrincipalClass</key>' '	<string>NSApplication</string>' '	<key>NSSupportsAutomaticTermination</key>' '	<false/>' '	<key>NSSupportsSuddenTermination</key>' '	<false/>' '</dict>' '</plist>' > \"$$plist\"\nprintf 'APPL????' > \"$$out/Contents/PkgInfo\"\nxattr -cr \"$$out\" >/dev/null 2>&1 || true\ncodesign --force --deep --sign - \"$$out\" >/dev/null 2>&1 || true\nif [ -d \"$$app_dir/sample\" ]; then mkdir -p \"$$out/Contents/MacOS/sample\" && cp -R \"$$app_dir/sample/.\" \"$$out/Contents/MacOS/sample/\"; fi\necho \"ship: $$out arch=$$arch target=$$xu_target triple=$$triple\"\necho \"run: open $$out\"\n"

    if desktop_macos_write_text(&sh, body) != 0 {
        desktop_macos_rm_td(td)
        << 1
    }
    rc := os_system("sh " + desktop_shell_quote(&sh))
    desktop_macos_rm_td(td)
    if rc != 0 {
        eprintln("xu: macOS .app wrap failed (need sips + iconutil)")
        << 1
    }
    << 0
}

fn desktop_macos_pack_phases_swift(td &string) int {
    << desktop_macos_cmd_swift_host(td)
}

fn desktop_macos_pack_phases_clang(td &string) int {
    << desktop_macos_cmd_clang_assets(td)
}

fn desktop_macos_pack_phases_icon(td &string) int {
    << desktop_macos_cmd_icon_blob(td)
}

fn desktop_macos_pack_phases_www(td &string) int {
    << desktop_macos_cmd_www_blob(td)
}

fn desktop_macos_pack_phases_shim(td &string) int {
    << desktop_macos_cmd_shim(td)
}

fn desktop_macos_pack_phases_archive(td &string) int {
    << desktop_macos_cmd_archive(td)
}

fn desktop_macos_pack_body(main_xu string, target_code int, out string, webview int, no_webview int, www_override string, root string) int {
    mut td := desktop_macos_alloc_td()
    mut entry := main_xu
    if desktop_macos_pack_init(&td, &entry, target_code, out, webview, no_webview, www_override, root) != 0 {
        desktop_macos_rm_td(&td)
        << 1
    }
    << desktop_macos_cmd_emit_xu(&td, entry, target_code)
}

fn run_desktop_pack_macos(main_xu string, target_code int, out string, webview int, no_webview int, www_override string, root string) int {
    << desktop_macos_pack_body(main_xu, target_code, out, webview, no_webview, www_override, root)
}
