@main

#os
#path/filepath
#errors

fn desktop_linux_rm_td(td &string) {
    desktop_system("rm -rf " + desktop_shell_quote(td))
}

fn desktop_linux_meta(td &string, key string) string {
    << td + "/pack." + key
}

fn desktop_linux_meta_write(td &string, key string, val string) int {
    write_file(desktop_linux_meta(td, key), val) or (err) {
        << 1
    }
    << 0
}

fn desktop_linux_meta_read(td &string, key string) string {
    body := read_file(desktop_linux_meta(td, key)) or (err) {
        << ""
    }
    << body
}

fn desktop_linux_write_text(path &string, body string) int {
    write_file(str_clone(path), body) or (err) {
        << 1
    }
    << 0
}

fn desktop_linux_alloc_td() string {
    mut td := desktop_temp_path("xu_linux_ui_") + str(now_ns() & 268435455)
    desktop_linux_rm_td(&td)
    desktop_system("mkdir -p " + desktop_shell_quote(&td))
    << td
}

fn desktop_linux_cxx() string {
    g := desktop_which("g++")
    if g.len > 0 {
        << g
    }
    << desktop_which("c++")
}

fn desktop_linux_run_doctor(target_code int, webview int) int {
    << desktop_run_doctor_exec(target_code, webview)
}

fn desktop_linux_pack_write_env(td &string, root string, out string, xu_target string, www string, need_wv int, icon string, cxx string) int {
    mut wv_flag := "0"
    if need_wv == 1 {
        wv_flag = "1"
    }
    mut www_o := ""
    if www.len > 0 {
        www_o = td + "/www_blob.o"
    }
    mut out_dir := desktop_parent_dir(&out)
    if out_dir.len == 0 {
        out_dir = "."
    }
    env := "td=" + desktop_shell_quote(td) + "\nroot=" + desktop_shell_quote(&root) + "\nout=" + desktop_shell_quote(&out) + "\nout_dir=" + desktop_shell_quote(&out_dir) + "\nicon=" + desktop_shell_quote(&icon) + "\nxu_target=" + desktop_shell_quote(&xu_target) + "\nwww=" + desktop_shell_quote(&www) + "\nwww_o=" + desktop_shell_quote(&www_o) + "\nneed_wv=" + desktop_shell_quote(&wv_flag) + "\ncxx=" + desktop_shell_quote(&cxx) + "\n"
    << desktop_linux_meta_write(td, "env", env)
}

fn desktop_linux_pack_init(td &string, main_xu &string, out string, target_code int, webview int, no_webview int, www_override string, root string) int {
    xu_target := target_name(target_code)
    app_dir := desktop_parent_dir(main_xu)
    app_out := desktop_linux_normalize_out(str_clone(&out), str_clone(&app_dir))
    need_wv := desktop_needs_webview(str_clone(&app_dir), str_clone(main_xu), str_clone(&www_override), webview, no_webview)
    mut www := str_clone(&www_override)
    if www.len == 0 && need_wv == 1 {
        sib := app_dir + "/www"
        if desktop_is_dir(&sib) == 1 {
            www = str_clone(&sib)
        }
    }
    cxx := desktop_linux_cxx()
    if cxx.len == 0 {
        eprintln("xu: g++/c++ not found")
        << 1
    }
    if desktop_linux_meta_write(td, "main_xu", str_clone(main_xu)) != 0 {
        << 1
    }
    if desktop_linux_meta_write(td, "out", str_clone(&app_out)) != 0 {
        << 1
    }
    if desktop_linux_meta_write(td, "root", str_clone(&root)) != 0 {
        << 1
    }
    if desktop_linux_meta_write(td, "xu_target", str_clone(&xu_target)) != 0 {
        << 1
    }
    if desktop_linux_meta_write(td, "app_dir", str_clone(&app_dir)) != 0 {
        << 1
    }
    if desktop_linux_meta_write(td, "www", str_clone(&www)) != 0 {
        << 1
    }
    icon := desktop_resolve_icon(str_clone(&app_dir))
    if icon.len == 0 {
        eprintln("xu: missing brand icon — put one under App/brand/:")
        eprintln("xu:   brand/icon.png | brand/xu_app_icon.png | brand/xu_app_logo.png")
        << 1
    }
    if desktop_linux_meta_write(td, "icon", str_clone(&icon)) != 0 {
        << 1
    }
    << desktop_linux_pack_write_env(td, root, app_out, xu_target, www, need_wv, icon, cxx)
}

fn desktop_linux_cmd_emit_xu(td &string, main_xu string) int {
    xuobj := td + "/app.xuobj"
    self := desktop_compiler_bin()
    mut tgt := desktop_linux_meta_read(td, "xu_target")
    if tgt.len > 0 && tgt[tgt.len - 1] == 10 {
        tgt = tgt[0:tgt.len - 1]
    }
    emit_cmd := desktop_ui_compile_prefix() + desktop_shell_quote(&self) + " build " + desktop_shell_quote(&main_xu) + " --target " + desktop_shell_quote(&tgt) + " --emit-obj -o " + desktop_shell_quote(&xuobj)
    mut rc := desktop_system(emit_cmd)
    if rc != 0 {
        eprintln("xu: --emit-obj failed")
        desktop_linux_rm_td(td)
        << 1
    }
    xu_o := td + "/app.o"
    elf_cmd := desktop_shell_quote(&self) + " _elf_o " + desktop_shell_quote(&xuobj) + " " + desktop_shell_quote(&xu_o)
    rc = desktop_system(elf_cmd)
    if rc != 0 {
        eprintln("xu: xuobj→elf failed")
        desktop_linux_rm_td(td)
        << 1
    }
    << desktop_linux_cmd_host(td)
}

fn desktop_linux_cmd_host(td &string) int {
    sh := td + "/linux_host.sh"
    tdq := desktop_shell_quote(td)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\nCXX=\"$$cxx\"\ncompile_host() { \"$$CXX\" -O2 -std=c++17 -c -DXU_UI_STATIC -I\"$$root/src/ui/host\" \"$$@\"; }\nGTK=$$(pkg-config --cflags --libs gtk4)\nif pkg-config --exists x11; then GTK=\"$$GTK $$(pkg-config --cflags --libs x11)\"; fi\ncompile_host \"$$root/src/ui/host/linux_host.cc\" -o \"$$td/linux_host.o\" $$GTK\ncompile_host \"$$root/src/ui/host/linux_draw.cc\" -o \"$$td/linux_draw.o\" $$GTK\n$$CXX -O2 -std=c++17 -c -I\"$$root/src/ui/host\" \"$$root/src/ui/host/xu_ui_mem.cc\" -o \"$$td/xu_ui_mem.o\"\n$$CXX -O2 -c -I\"$$root/src/ui/host\" -x c \"$$root/src/ui/host/xu_pack_assets.c\" -o \"$$td/xu_pack_assets.o\"\n$$CXX -O2 -c -I\"$$root/src/ui/host\" -x c \"$$root/src/ui/host/xu_pack_assets_weak.c\" -o \"$$td/xu_pack_assets_weak.o\"\nif [ \"$$need_wv\" = \"1\" ]; then\n  WK=$$(pkg-config --cflags --libs webkitgtk-6.0)\n  compile_host \"$$root/src/ui/host/linux_webview.cc\" -o \"$$td/linux_webview.o\" $$GTK $$WK\nelse\n  printf '%s\\n' '#include \"xu_content_abi.h\"' 'extern \"C\" const XuContentVTable *xu_webview_plugin_vtable(void) { return nullptr; }' > \"$$td/webview_stub.cc\"\n  compile_host \"$$td/webview_stub.cc\" -o \"$$td/webview_stub.o\"\nfi\n"
    if desktop_linux_write_text(&sh, body) != 0 {
        desktop_linux_rm_td(td)
        << 1
    }
    rc := desktop_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: linux host compile failed")
        desktop_linux_rm_td(td)
        << 1
    }
    << desktop_linux_cmd_icon(td)
}

fn desktop_linux_cmd_icon(td &string) int {
    icon_c := td + "/icon_blob.c"
    icon_o := td + "/icon_blob.o"
    icon_png := desktop_meta_trim(desktop_linux_meta_read(td, "icon"))
    if desktop_write_icon_blob_c(icon_png, str_clone(&icon_c)) != 0 {
        desktop_linux_rm_td(td)
        << 1
    }
    sh := td + "/icon_cxx.sh"
    tdq := desktop_shell_quote(td)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\n\"$$cxx\" -O2 -x c -c " + desktop_shell_quote(&icon_c) + " -o " + desktop_shell_quote(&icon_o) + "\n"
    if desktop_linux_write_text(&sh, body) != 0 {
        desktop_linux_rm_td(td)
        << 1
    }
    mut rc := desktop_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: icon blob compile failed")
        desktop_linux_rm_td(td)
        << 1
    }
    << desktop_linux_cmd_www(td)
}

fn desktop_linux_cmd_www(td &string) int {
    www_dir := desktop_meta_trim(desktop_linux_meta_read(td, "www"))
    if www_dir.len == 0 {
        << desktop_linux_cmd_shim(td)
    }
    www_c := td + "/www_blob.c"
    www_o := td + "/www_blob.o"
    icon_png := desktop_meta_trim(desktop_linux_meta_read(td, "icon"))
    app_dir := desktop_meta_trim(desktop_linux_meta_read(td, "app_dir"))
    root := desktop_meta_trim(desktop_linux_meta_read(td, "root"))
    mut resource_webview := 0
    if desktop_meta_trim(desktop_linux_meta_read(td, "need_wv")) == "1" { resource_webview = 1 }
    if desktop_write_www_blob_c(www_dir, icon_png, app_dir, root, resource_webview, str_clone(&www_c)) != 0 {
        desktop_linux_rm_td(td)
        << 1
    }
    sh := td + "/www_cxx.sh"
    tdq := desktop_shell_quote(td)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\n\"$$cxx\" -O2 -x c -c -I\"$$root/src/ui/host\" " + desktop_shell_quote(&www_c) + " -o " + desktop_shell_quote(&www_o) + "\n"
    if desktop_linux_write_text(&sh, body) != 0 {
        desktop_linux_rm_td(td)
        << 1
    }
    rc := desktop_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: www blob compile failed")
        desktop_linux_rm_td(td)
        << 1
    }
    << desktop_linux_cmd_shim(td)
}

fn desktop_linux_cmd_shim(td &string) int {
    shim_c := td + "/shim.c"
    if desktop_write_shim_c(str_clone(&shim_c)) != 0 {
        desktop_linux_rm_td(td)
        << 1
    }
    shim_o := td + "/shim.o"
    sh := td + "/shim_cxx.sh"
    tdq := desktop_shell_quote(td)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\n\"$$cxx\" -O2 -I\"$$root/src/ui/host\" -x c -c " + desktop_shell_quote(&shim_c) + " -o " + desktop_shell_quote(&shim_o) + "\n"
    if desktop_linux_write_text(&sh, body) != 0 {
        desktop_linux_rm_td(td)
        << 1
    }
    mut rc := desktop_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: shim.c compile failed")
        desktop_linux_rm_td(td)
        << 1
    }
    << desktop_linux_cmd_archive(td)
}

fn desktop_linux_cmd_archive(td &string) int {
    sh := td + "/archive.sh"
    tdq := desktop_shell_quote(td)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\nobjs=\"$$td/linux_host.o $$td/linux_draw.o $$td/xu_ui_mem.o $$td/xu_pack_assets.o $$td/xu_pack_assets_weak.o\"\nif [ \"$$need_wv\" = \"1\" ]; then\n  objs=\"$$objs $$td/linux_webview.o\"\nelse\n  objs=\"$$objs $$td/webview_stub.o\"\nfi\nar rcs \"$$td/libxu_ui_host.a\" $$objs\n"
    if desktop_linux_write_text(&sh, body) != 0 {
        desktop_linux_rm_td(td)
        << 1
    }
    rc := desktop_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: ar libxu_ui_host.a failed")
        desktop_linux_rm_td(td)
        << 1
    }
    << desktop_linux_cmd_link(td)
}

fn desktop_linux_cmd_link(td &string) int {
    sh := td + "/link.sh"
    tdq := desktop_shell_quote(td)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\nmkdir -p \"$$out_dir\"\nextra=\"$$td/icon_blob.o\"\nif [ -n \"$$www_o\" ] && [ -f \"$$www_o\" ]; then extra=\"$$extra $$www_o\"; fi\nGTK=$$(pkg-config --cflags --libs gtk4)\nif pkg-config --exists x11; then GTK=\"$$GTK $$(pkg-config --cflags --libs x11)\"; fi\nWK=\"\"\nif [ \"$$need_wv\" = \"1\" ]; then WK=$$(pkg-config --cflags --libs webkitgtk-6.0); fi\n\"$$cxx\" -O2 \"$$td/shim.o\" \"$$td/app.o\" $$extra -Wl,--whole-archive \"$$td/libxu_ui_host.a\" -Wl,--no-whole-archive -Wl,--allow-multiple-definition -o \"$$out\" $$GTK $$WK\n"
    if desktop_linux_write_text(&sh, body) != 0 {
        desktop_linux_rm_td(td)
        << 1
    }
    rc := desktop_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: desktop link failed")
        desktop_linux_rm_td(td)
        << 1
    }
    mut outf := desktop_linux_meta_read(td, "out")
    if outf.len > 0 && outf[outf.len - 1] == 10 {
        outf = outf[0:outf.len - 1]
    }
    mut tgt := desktop_linux_meta_read(td, "xu_target")
    if tgt.len > 0 && tgt[tgt.len - 1] == 10 {
        tgt = tgt[0:tgt.len - 1]
    }
    println("ship: " + outf + " target=" + tgt)
    desktop_linux_rm_td(td)
    << 0
}

fn desktop_linux_pack_body(main_xu string, out string, target_code int, webview int, no_webview int, www_override string, root string) int {
    mut td := desktop_linux_alloc_td()
    entry := str_clone(&main_xu)
    if desktop_linux_pack_init(&td, &entry, out, target_code, webview, no_webview, www_override, root) != 0 {
        desktop_linux_rm_td(&td)
        << 1
    }
    env := desktop_linux_meta_read(&td, "env")
    env_path := td + "/pack.env"
    if desktop_linux_write_text(&env_path, env) != 0 {
        desktop_linux_rm_td(&td)
        << 1
    }
    << desktop_linux_cmd_emit_xu(&td, entry)
}

fn run_desktop_pack_linux(main_xu string, target_code int, out string, webview int, no_webview int, www_override string, root string) int {
    << desktop_linux_pack_body(main_xu, out, target_code, webview, no_webview, www_override, root)
}

fn run_desktop_pack_linux_go(src0 string, target_code int, out string, webview int, no_webview int, www string) int {
    src_in := str_clone(&src0)
    src := desktop_resolve_entry(str_clone(&src_in))
    if src.len == 0 {
        << 1
    }
    root := desktop_find_repo_root()
    if root.len == 0 {
        eprintln("xu: --desktop needs full SDK host sources (src/ui/host); reinstall the SDK or set XU_ROOT")
        << 1
    }
    app_dir0 := desktop_parent_dir(&src)
    need_doc := desktop_needs_webview(str_clone(&app_dir0), str_clone(&src), str_clone(&www), webview, no_webview)
    if desktop_linux_run_doctor(target_code, need_doc) != 0 {
        eprintln("xu: --desktop aborted (doctor)")
        << 1
    }
    out_path := desktop_linux_normalize_out(str_clone(&out), str_clone(&app_dir0))
    println("xu: desktop pack → " + out_path)
    << desktop_linux_pack_body(src, out_path, target_code, webview, no_webview, www, root)
}
