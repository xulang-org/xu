@main
// xu-desktop — product desktop pack (NOT bootstrap language core).
// User: `xu-desktop pack` or via `xu build --desktop`. Doctor is `xu-doctor` / `xu doctor`.
// Host toolchain only: host C/C++ and platform pack tools only.
// Layout: common.xu | assets.xu | pack_windows.xu | pack_macos.xu | pack_linux.xu | main.xu

#os
#path/filepath
#errors

fn run_desktop_pack_go(src0 string, target_code int, out string, webview int, no_webview int, www string) int {
    src_in := str_clone(&src0)
    src := desktop_resolve_entry(str_clone(&src_in))
    if src.len == 0 {
        << 1
    }
    root := desktop_find_repo_root()
    if root.len == 0 {
        eprintln("xu: --desktop needs xu checkout (src/ui/host)")
        << 1
    }
    app_dir0 := desktop_parent_dir(&src)
    need_wv := desktop_needs_webview(str_clone(&app_dir0), str_clone(&src), str_clone(&www), webview, no_webview)
    if desktop_macos_run_doctor(target_code, need_wv) != 0 {
        eprintln("xu: --desktop aborted (doctor)")
        << 1
    }
    mut out_path := str_clone(&out)
    out_path = desktop_macos_normalize_app_out(str_clone(&out_path), str_clone(&app_dir0))
    println("xu: desktop pack → " + out_path)
    << desktop_macos_pack_body(src, target_code, out_path, need_wv, no_webview, www, root)
}

fn run_desktop_pack(src0 string, target_code int, out string, webview int, no_webview int, www string) int {
    if desktop_is_macos_target(target_code) == 1 {
        << run_desktop_pack_go(src0, target_code, out, webview, no_webview, www)
    }
    if desktop_is_windows_target(target_code) == 1 {
        << run_desktop_pack_windows_go(src0, target_code, out, webview, no_webview, www)
    }
    if desktop_is_linux_target(target_code) == 1 {
        << run_desktop_pack_linux_go(src0, target_code, out, webview, no_webview, www)
    }
    eprintln("xu-desktop: pack for this target is not implemented yet")
    << 1
}

fn desktop_pack_cli(argv []string) int {
    mut target_code := 0
    mut out := ""
    mut out_set := 0
    mut www := ""
    mut webview := 0
    mut no_webview := 0
    mut paths := []string{}
    mut i := 0
    while i < argv.len {
        a := argv[i]
        if a == "--target" {
            if i + 1 >= argv.len {
                eprintln("xu-desktop pack: --target requires a name")
                << 1
            }
            t := parse_target(argv[i + 1])
            if t < 0 {
                eprintln("xu-desktop pack: unknown --target")
                << 1
            }
            target_code = t
            i = i + 1
        } else {
            if a == "-o" {
                if i + 1 >= argv.len {
                    eprintln("xu-desktop pack: -o requires a path")
                    << 1
                }
                out = argv[i + 1]
                out_set = 1
                i = i + 1
            } else {
                if a == "--www" {
                    if i + 1 >= argv.len {
                        eprintln("xu-desktop pack: --www requires a directory")
                        << 1
                    }
                    www = argv[i + 1]
                    i = i + 1
                } else {
                    if a == "--webview" {
                        webview = 1
                    } else {
                        if a == "--no-webview" {
                            no_webview = 1
                        } else {
                            if a == "-h" || a == "--help" {
                                println("usage: xu-desktop pack [options] <AppDir>")
                                println("")
                                println("Pack a native desktop application bundle.")
                                println("")
                                println("Arguments:")
                                println("  <AppDir>          application directory containing main.xu")
                                println("")
                                println("Options:")
                                println("  -o, --output OUT  output bundle or executable path")
                                println("  --target TARGET   target platform (macos-arm64, windows-x64, etc.)")
                                println("  --www DIR         override www/ resource directory to embed")
                                println("  -h, --help        show this help message")
                                << 0
                            } else {
                                paths.push(a)
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    if paths.len != 1 {
        eprintln("xu-desktop pack: need exactly one app directory")
        << 1
    }
    mut desktop_out := ""
    if out_set == 1 {
        desktop_out = str_clone(&out)
    }
    << run_desktop_pack(paths[0], target_code, desktop_out, webview, no_webview, www)
}

fn main() int {
    argv := args()
    mut prog := "xu-desktop"
    if argv.len > 0 {
        prog = argv[0]
        mut cut := 0 - 1
        for i in 0:prog.len {
            if prog[i] == 47 {
                cut = i
            }
        }
        if cut >= 0 {
            prog = prog[cut + 1:prog.len]
        }
    }
    if argv.len < 2 {
        eprintln("usage: " + prog + " pack AppDir [--target T] [-o out] [--www DIR]")
        eprintln("  doctor: use sibling xu-doctor / `xu doctor`")
        << 1
    }
    if argv[1] == "doctor" {
        // Compat: forward argv tail to sibling xu-doctor.
        bin := desktop_doctor_bin()
        if bin.len == 0 {
            eprintln(prog + ": missing sibling `xu-doctor` (run `make xu` / `make xu-doctor`)")
            << 127
        }
        mut cmd := desktop_shell_quote(&bin)
        for j in 2:argv.len {
            a := argv[j]
            cmd = cmd + " " + desktop_shell_quote(&a)
        }
        rc := os_system(cmd)
        if rc < 0 {
            << 127
        }
        << (rc >> 8) & 255
    }
    if argv[1] == "pack" {
        mut pargs := []string{}
        for j in 2:argv.len {
            pargs.push(argv[j])
        }
        << desktop_pack_cli(pargs)
    }
    if argv[1] == "-h" || argv[1] == "--help" {
        println("usage: " + prog + " pack [options] <AppDir>")
        println("")
        println("Pack a native desktop application bundle.")
        println("")
        println("Arguments:")
        println("  <AppDir>          application directory containing main.xu")
        println("")
        println("Options:")
        println("  -o, --output OUT  output bundle or executable path")
        println("  --target TARGET   target platform (macos-arm64, windows-x64, etc.)")
        println("  --www DIR         override www/ resource directory to embed")
        println("  -h, --help        show this help message")
        << 0
    }
    eprintln(prog + ": unknown subcommand '" + argv[1] + "' (want pack; doctor → xu-doctor)")
    << 1
}
