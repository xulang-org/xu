@main

#os
#path/filepath
#errors
#internal/toolpath
#os/exec
#strconv

// Desktop pack recipes use POSIX quoting and pipelines. Windows os_system is
// direct CreateProcess, so explicitly invoke the documented Git Bash/MSYS2 shell.
// Preserve the wait-status encoding expected by the existing pack callers.
fn desktop_system(command string) int {
    if xu_target_os() != 2 { << os_system(command) }
    // A UTF-8 script keeps the command text out of Windows ANSI argv.
    script := desktop_temp_path("xu_desktop_" + str(os.getpid()) + "_" + str(now_ns()) + ".sh")
    write_file(script + "",command + "\n") or (err) {
        eprintln("xu-desktop: pack script: " + err.msg())
        << 127 << 8
    }
    $child := exec.command("sh",script + "")
    child.run() or (err) {
        os.remove(script + "") or (cleanup_err) { eprintln(cleanup_err.msg())
            << 127 << 8 }
        message := err.msg()
        if message.len > 12 && message[0:12] == "exit status " {
            digits := message[12:message.len] + ""
            code := strconv.atoi(&digits) or (parse_err) { << 127 << 8 }
            << (code & 255) << 8
        }
        eprintln("xu-desktop: POSIX pack shell: " + message)
        << 127 << 8
    }
    os.remove(script) or (err) { eprintln(err.msg())
        << 127 << 8 }
    << 0
}
fn desktop_native_path(path &string) string {
    if xu_target_os() == 2 { << filepath.to_slash(path) }
    << path + ""
}
fn desktop_temp_root() string {
    if xu_target_os() == 2 {
        directory := os.temp_dir()
        << filepath.to_slash(&directory)
    }
    << "/tmp"
}
fn desktop_temp_path(name string) string {
    << desktop_temp_root() + "/" + name
}
fn desktop_shell_quote_tmp() string {
    directory := desktop_temp_root()
    << desktop_shell_quote(&directory)
}

fn str_clone(s &string) string {
    << s + ""
}

fn str_slice_owned(s &string, from int, to int) string {
    $out := ""
    for i in from:to {
        out = out + string_from_byte(s[i])
    }
    << out
}

// Desktop-relevant targets only (mirror asm_arm64 parse_target subset).
fn parse_target(s string) int {
    if s == "macos-arm64" { << 0 }
    if s == "macos-x64" { << 1 }
    if s == "linux-arm64" { << 10 }
    if s == "linux-x64" { << 11 }
    if s == "windows-arm64" { << 20 }
    if s == "windows-x64" { << 21 }
    << -1
}

fn target_os(t int) int {
    << t / 10
}

fn target_name(t int) string {
    if t == 0 { << "macos-arm64" }
    if t == 1 { << "macos-x64" }
    if t == 10 { << "linux-arm64" }
    if t == 11 { << "linux-x64" }
    if t == 20 { << "windows-arm64" }
    if t == 21 { << "windows-x64" }
    << "unknown"
}

fn desktop_meta_trim(s string) string {
    if s.len > 0 && s[s.len - 1] == 10 {
        << s[0:s.len - 1]
    }
    << s
}

fn desktop_shell_quote(s &string) string {
    // Slice on &string is unsafe under bootstrap; clone once.
    ss := str_clone(s)
    $out := "'"
    for i in 0:ss.len {
        c := ss[i] & 255
        if c == 39 {
            out = out + "'\\''"
        } else {
            out = out + ss[i:i + 1]
        }
    }
    << out + "'"
}

fn desktop_parent_dir(path &string) string {
    ss := str_clone(path)
    $cut := 0 - 1
    for i in 0:ss.len {
        if ss[i] == 47 {
            cut = i
        }
    }
    if cut <= 0 {
        << ""
    }
    << str_slice_owned(&ss, 0, cut)
}

fn path_exists(p &string) bool {
    os_stat(str_clone(p)) or (err) {
        << false
    }
    << true
}

fn desktop_file_exists(path &string) int {
    if path_exists(path) {
        << 1
    }
    << 0
}

fn desktop_read_or_empty(path string) string {
    body := read_file(str_clone(&path)) or (err) {
        << ""
    }
    << body
}

fn desktop_ends_with_xu(path &string) int {
    if path.len < 3 {
        << 0
    }
    if path[path.len - 3] == 46 && path[path.len - 2] == 120 && path[path.len - 1] == 117 {
        << 1
    }
    << 0
}

fn desktop_ends_with_app(path &string) int {
    ss := str_clone(path)
    if ss.len < 4 {
        << 0
    }
    // ".app"
    if ss[ss.len - 4] == 46 && ss[ss.len - 3] == 97 && ss[ss.len - 2] == 112 && ss[ss.len - 1] == 112 {
        << 1
    }
    << 0
}

fn desktop_basename(path &string) string {
    ss := str_clone(path)
    $cut := 0 - 1
    for i in 0:ss.len {
        if ss[i] == 47 {
            cut = i
        }
    }
    if cut < 0 {
        << ss
    }
    if cut + 1 >= ss.len {
        << ""
    }
    << ss[cut + 1:ss.len]
}

fn desktop_strip_app_suffix(path string) string {
    $ss := str_clone(&path)
    if desktop_ends_with_app(&ss) == 1 {
        << ss[0:ss.len - 4]
    }
    << ss
}

// macOS --desktop always ships a Finder .app; bare Mach-O is only an intermediate.
fn desktop_macos_normalize_app_out(out0 string, app_dir string) string {
    $o := str_clone(&out0)
    if o.len > 0 && o[o.len - 1] == 47 {
        o = o[0:o.len - 1]
    }
    if o.len == 0 {
        base := desktop_basename(&app_dir)
        if base.len == 0 {
            o = "XuApp"
        } else {
            o = str_clone(&base)
        }
    }
    if desktop_ends_with_app(&o) == 0 {
        o = o + ".app"
    }
    // Relative -o / default → absolute under process cwd (os.getwd via filepath.abs).
    absolute := filepath.abs(&o)
    << desktop_native_path(&absolute)
}

fn desktop_is_dir(path &string) int {
    info := os_stat(str_clone(path)) or (err) {
        << 0
    }
    if info.is_dir {
        << 1
    }
    << 0
}

fn desktop_resolve_entry(path0 string) string {
    $base := desktop_native_path(&path0)
    if base.len > 0 && base[base.len - 1] == 47 {
        base = base[0:base.len - 1]
    }
    if desktop_ends_with_xu(&base) == 1 {
        eprintln("xu: --desktop requires an app directory, not a .xu file")
        eprintln("xu: want:  xu build App/ --desktop -o Out")
        eprintln("xu: layout: App/main.xu + App/brand/<icon>.png (+ optional www/)")
        << ""
    }
    if desktop_is_dir(&base) == 0 {
        eprintln("xu: --desktop needs an app directory: " + base)
        eprintln("xu: layout: App/main.xu + App/brand/<icon>.png (+ optional www/)")
        << ""
    }
    main := base + "/main.xu"
    if desktop_file_exists(&main) == 0 {
        eprintln("xu: --desktop app dir missing main.xu: " + base)
        << ""
    }
    << main
}

// The task stack profile is emitted into the object, before the native shim runs.
fn desktop_ui_compile_prefix() string {
    << "XU_UI_PACK=1 "
}

fn desktop_find_repo_root() string {
    root := toolpath.ui_root() or (err) {
        eprintln("xu-desktop: SDK root: " + err.msg())
        << ""
    }
    << desktop_native_path(&root)
}

fn desktop_is_macos_target(code int) int {
    if code == 0 || code == 1 {
        << 1
    }
    << 0
}

fn desktop_is_windows_target(code int) int {
    // windows-arm64=20, windows-x64=21
    if code == 20 || code == 21 {
        << 1
    }
    << 0
}

fn desktop_windows_mingw_prefix(code int) string {
    if code == 20 {
        << "aarch64-w64-mingw32"
    }
    << "x86_64-w64-mingw32"
}

fn desktop_windows_arch_label(code int) string {
    if code == 20 {
        << "arm64"
    }
    << "x64"
}

fn desktop_is_linux_target(code int) int {
    // linux-arm64=10, linux-x64=11
    if code == 10 || code == 11 {
        << 1
    }
    << 0
}

fn desktop_linux_normalize_out(out0 string, app_dir string) string {
    $o := str_clone(&out0)
    if o.len > 0 && o[o.len - 1] == 47 {
        o = o[0:o.len - 1]
    }
    if o.len == 0 {
        base := desktop_basename(&app_dir)
        if base.len == 0 {
            o = "XuApp"
        } else {
            o = str_clone(&base)
        }
    }
    absolute := filepath.abs(&o)
    << desktop_native_path(&absolute)
}

fn desktop_ends_with_exe(path &string) int {
    if path.len < 4 {
        << 0
    }
    l := path.len
    if path[l - 4] != 46 {
        << 0
    }
    e1 := path[l - 3]
    x := path[l - 2]
    e2 := path[l - 1]
    if e1 == 101 || e1 == 69 {
        if x == 120 || x == 88 {
            if e2 == 101 || e2 == 69 {
                << 1
            }
        }
    }
    << 0
}

fn desktop_windows_normalize_out(out0 string, app_dir string) string {
    $o := str_clone(&out0)
    if o.len > 0 && o[o.len - 1] == 47 {
        o = o[0:o.len - 1]
    }
    if o.len == 0 {
        base := desktop_basename(&app_dir)
        if base.len == 0 {
            o = "XuApp.exe"
        } else {
            o = base + ".exe"
        }
    }
    if desktop_ends_with_exe(&o) == 0 {
        o = o + ".exe"
    }
    absolute := filepath.abs(&o)
    << desktop_native_path(&absolute)
}

fn desktop_pe_put_u64(data $&[]int, off int, v int) {
    data[off] = v & 255
    data[off + 1] = (v >> 8) & 255
    data[off + 2] = (v >> 16) & 255
    data[off + 3] = (v >> 24) & 255
    data[off + 4] = 0
    data[off + 5] = 0
    data[off + 6] = 0
    data[off + 7] = 0
}

fn desktop_pe_patch_stack(path string) int {
    body := read_file(str_clone(&path)) or (err) {
        eprintln("xu: pe patch: cannot read " + path)
        << 1
    }
    $data := []int{}
    for i in 0:body.len {
        data.push(body[i] & 255)
    }
    if data.len < 64 {
        eprintln("xu: pe patch: file too small")
        << 1
    }
    if data[0] != 77 || data[1] != 90 {
        eprintln("xu: pe patch: not a PE (missing MZ)")
        << 1
    }
    e_lfanew := data[60] | (data[61] << 8) | (data[62] << 16) | (data[63] << 24)
    if e_lfanew + 28 > data.len {
        eprintln("xu: pe patch: bad e_lfanew")
        << 1
    }
    if data[e_lfanew] != 80 || data[e_lfanew + 1] != 69 || data[e_lfanew + 2] != 0 || data[e_lfanew + 3] != 0 {
        eprintln("xu: pe patch: missing PE signature")
        << 1
    }
    opt := e_lfanew + 24
    magic := data[opt] | (data[opt + 1] << 8)
    if magic != 523 {
        eprintln("xu: pe patch: not PE32+ (magic=" + str(magic) + ")")
        << 1
    }
    reserve := 16777216
    commit := 4194304
    desktop_pe_put_u64($&data, opt + 72, reserve)
    desktop_pe_put_u64($&data, opt + 80, commit)
    write_file(str_clone(&path), string_from_bytes(data)) or (err) {
        eprintln("xu: pe patch: cannot write " + path)
        << 1
    }
    println("pe: stack reserve/commit → 16MB/4MB " + path)
    << 0
}

fn desktop_write_file_blob_c(src_path string, tmp_base string, out_c string, comment string) int {
    eprintln("xu: embedding blob " + src_path)
    tmp := desktop_temp_path(tmp_base + "")
    qsrc := desktop_shell_quote(&src_path)
    qtmp := desktop_shell_quote(&tmp)
    qout := desktop_shell_quote(&out_c)
    $rc := desktop_system("cp " + qsrc + " " + qtmp)
    if rc != 0 {
        eprintln("xu: cannot copy blob " + src_path)
        << 1
    }
    hdr := desktop_temp_path("xu_blob_hdr_") + str(now_ns() & 1048575)
    qhdr := desktop_shell_quote(&hdr)
    write_file(hdr, "/* " + comment + " */\n") or (err) {
        << 1
    }
    rc = desktop_system("cat " + qhdr + " > " + qout + " && (cd " + desktop_shell_quote_tmp() + " && xxd -i " + tmp_base + " | sed 's/^unsigned /const unsigned /') >> " + qout)
    desktop_system("rm -f " + qhdr + " " + qtmp)
    if rc != 0 {
        eprintln("xu: xxd blob failed for " + src_path)
        << 1
    }
    << 0
}

fn desktop_which(name string) string {
    stamp := desktop_temp_path("xu_which_") + str(now_ns() & 1048575)
    rc := desktop_system("command -v " + name + " >" + desktop_shell_quote(&stamp) + " 2>/dev/null")
    if rc != 0 {
        << ""
    }
    body := read_file(str_clone(&stamp)) or (err) {
        << ""
    }
    desktop_system("rm -f " + desktop_shell_quote(&stamp))
    $s := str_clone(&body)
    if s.len > 0 && s[s.len - 1] == 10 {
        s = s[0:s.len - 1]
    }
    << s
}

fn desktop_sibling(name string) string {
    sibling := toolpath.sibling(&name) or (err) {
        eprintln("xu-desktop: sibling tool: " + err.msg())
        << ""
    }
    << desktop_native_path(&sibling)
}
fn desktop_doctor_bin() string {
    sibling := desktop_sibling("xu-doctor")
    if sibling.len > 0 { << sibling }
    << desktop_which("xu-doctor")
}

fn desktop_run_doctor_exec(target_code int, webview int) int {
    bin := desktop_doctor_bin()
    if bin.len == 0 {
        eprintln("xu-desktop: missing sibling `xu-doctor` (run `make xu` / `make xu-doctor`)")
        << 127
    }
    tname := target_name(target_code)
    $cmd := desktop_shell_quote(&bin) + " --target " + desktop_shell_quote(&tname)
    if webview == 1 {
        cmd = cmd + " --webview"
    }
    rc := desktop_system(cmd)
    if rc < 0 {
        << 127
    }
    << (rc >> 8) & 255
}

fn desktop_apple_triple(arch string) string {
    $cpu := "arm64"
    if arch == "x64" {
        cpu = "x86_64"
    }
    stamp := desktop_temp_path("xu_sdk_") + str(now_ns() & 1048575)
    rc := desktop_system("xcrun --sdk macosx --show-sdk-version >" + desktop_shell_quote(&stamp) + " 2>/dev/null")
    if rc != 0 {
        << cpu + "-apple-macos"
    }
    body := read_file(str_clone(&stamp)) or (err) {
        << cpu + "-apple-macos"
    }
    desktop_system("rm -f " + desktop_shell_quote(&stamp))
    $major := ""
    $done := 0
    for i in 0:body.len {
        if done == 0 {
            c := body[i]
            if c == 46 {
                done = 1
            } else {
                if c == 10 {
                    done = 1
                } else {
                    if c >= 48 {
                        if c <= 57 {
                            major = major + body[i:i + 1]
                        } else {
                            done = 1
                        }
                    } else {
                        done = 1
                    }
                }
            }
        }
    }
    if major.len == 0 {
        << cpu + "-apple-macos"
    }
    << cpu + "-apple-macos" + major
}

fn desktop_str_contains(s &string, sub string) int {
    if sub.len == 0 {
        << 1
    }
    if s.len < sub.len {
        << 0
    }
    limit := s.len - sub.len + 1
    for i in 0:limit {
        $found := 1
        for j in 0:sub.len {
            if s[i + j] != sub[j] {
                found = 0
                <-
            }
        }
        if found == 1 {
            << 1
        }
    }
    << 0
}

fn desktop_detect_webview(app_dir string, main_xu string, www_override string) int {
    if www_override.len > 0 {
        << 1
    }
    www_dir := app_dir + "/www"
    if desktop_is_dir(&www_dir) == 1 {
        << 1
    }
    body := desktop_read_or_empty(str_clone(&main_xu))
    if body.len > 0 {
        if desktop_str_contains(&body, "#ui/webview") == 1 {
            << 1
        }
        if desktop_str_contains(&body, "webview.") == 1 {
            << 1
        }
    }
    manifest := desktop_read_or_empty(app_dir + "/xu.xun")
    if manifest.len > 0 {
        if desktop_str_contains(&manifest, "ui/webview") == 1 {
            << 1
        }
    }
    << 0
}

fn desktop_needs_webview(app_dir string, main_xu string, www_override string, force_wv int, force_no int) int {
    if force_no == 1 {
        << 0
    }
    if force_wv == 1 {
        << 1
    }
    << desktop_detect_webview(app_dir, main_xu, www_override)
}

fn desktop_resolve_icon(app_dir string) string {
    // Required in the app project (no silent fallback to repo brand/).
    a := app_dir + "/brand/icon.png"
    if desktop_file_exists(&a) == 1 {
        << str_clone(&a)
    }
    b := app_dir + "/brand/xu_app_icon.png"
    if desktop_file_exists(&b) == 1 {
        << str_clone(&b)
    }
    c := app_dir + "/brand/xu_app_logo.png"
    if desktop_file_exists(&c) == 1 {
        << str_clone(&c)
    }
    << ""
}

fn desktop_compiler_bin() string {
    sibling := desktop_sibling("xu")
    if sibling.len > 0 { << sibling }
    w := desktop_which("xu")
    if w.len > 0 { << w }
    << "xu"
}
