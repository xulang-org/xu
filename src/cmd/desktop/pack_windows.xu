@main

#os
#path/filepath
#errors

fn desktop_windows_find_loader(root string) string {
    // Prefer arch-matching loader when both exist under build/.
    dir := root + "/dist/windows-x64-ui/_build"
    stamp := desktop_temp_path("xu_loader_") + str(now_ns() & 1048575)
    qdir := desktop_shell_quote(&dir)
    qstamp := desktop_shell_quote(&stamp)
    desktop_system("ls " + qdir + "/WebView2Loader*.dll 2>/dev/null | head -1 >" + qstamp)
    body := read_file(stamp) or (err) {
        desktop_system("rm -f " + qstamp)
        << ""
    }
    desktop_system("rm -f " + qstamp)
    mut s := str_clone(&body)
    if s.len > 0 && s[s.len - 1] == 10 {
        s = s[0:s.len - 1]
    }
    << s
}

fn desktop_windows_loader_matches(path string, target_code int) bool {
    data := read_file(path) or (err) { << false }
    if data.len < 64 || data[0] != 77 || data[1] != 90 { << false }
    mut off := 0
    for i in 0:4 { off = off | ((data[60 + i] & 255) << (i * 8)) }
    if off < 64 || off > data.len - 6 { << false }
    if data[off] != 80 || data[off + 1] != 69 || data[off + 2] != 0 || data[off + 3] != 0 { << false }
    machine := (data[off + 4] & 255) | ((data[off + 5] & 255) << 8)
    if target_code == 20 { << machine == 43620 }
    if target_code == 21 { << machine == 34404 }
    << false
}

fn desktop_windows_find_loader_for(root string, target_code int) string {
    dir := root + "/dist/windows-x64-ui/_build"
    mut named := dir + "/WebView2Loader_x64.dll"
    if target_code == 20 { named = dir + "/WebView2Loader_arm64.dll" }
    if desktop_windows_loader_matches(named + "", target_code) { << named }
    generic := dir + "/WebView2Loader.dll"
    if desktop_windows_loader_matches(generic + "", target_code) { << generic }
    // A missing matching DLL must never fall back to the opposite architecture.
    << ""
}

fn desktop_windows_rm_td(td &string) {
    desktop_system("rm -rf " + desktop_shell_quote(td))
}

fn desktop_windows_meta(td &string, key string) string {
    << td + "/pack." + key
}

fn desktop_windows_meta_write(td &string, key string, val string) int {
    write_file(desktop_windows_meta(td, key), val) or (err) {
        << 1
    }
    << 0
}

fn desktop_windows_meta_read(td &string, key string) string {
    body := read_file(desktop_windows_meta(td, key)) or (err) {
        << ""
    }
    << body
}

fn desktop_windows_alloc_td() string {
    mut td := desktop_temp_path("xu_win_ui_") + str(now_ns() & 268435455)
    desktop_windows_rm_td(&td)
    desktop_system("mkdir -p " + desktop_shell_quote(&td))
    << td
}

fn desktop_windows_run_doctor(target_code int, webview int) int {
    << desktop_run_doctor_exec(target_code, webview)
}


fn desktop_windows_pack_write_icon(td &string, app_dir string) int {
    icon := desktop_resolve_icon(str_clone(&app_dir))
    if icon.len == 0 {
        eprintln("xu: missing brand icon — put one under App/brand/:")
        eprintln("xu:   brand/icon.png | brand/xu_app_icon.png | brand/xu_app_logo.png")
        << 1
    }
    << desktop_windows_meta_write(td, "icon", icon)
}

fn desktop_windows_pack_write_www(td &string, app_dir string, need_wv int, www_override string) int {
    mut www := str_clone(&www_override)
    if www.len == 0 && need_wv == 1 {
        sib := app_dir + "/www"
        if desktop_is_dir(&sib) == 1 {
            www = str_clone(&sib)
        }
    }
    << desktop_windows_meta_write(td, "www", www)
}

fn desktop_windows_pack_write_env(td &string, root string, out string, xu_target string, www string, need_wv int, icon string, loader string, mingw_pfx string) int {
    mut wv_flag := "0"
    if need_wv == 1 {
        wv_flag = "1"
    }
    // PE needs a strong xu_pack_www_files even when www/ is absent (weak
    // __attribute__ does not satisfy MinGW .refptr; see cmd_www empty blob).
    www_o := td + "/www_blob.o"
    // The shim references loader metadata even for Draw-only applications.
    // cmd_loader always builds a strong empty or populated blob for PE.
    loader_o := td + "/loader_blob.o"
    mut out_dir := desktop_parent_dir(&out)
    if out_dir.len == 0 {
        out_dir = "."
    }
    mut stack_cflags := ""
    if xu_target == "windows-x64" {
        stack_cflags = "-mstackrealign"
    }
    env := "td=" + desktop_shell_quote(td) + "\nroot=" + desktop_shell_quote(&root) + "\nout=" + desktop_shell_quote(&out) + "\nout_dir=" + desktop_shell_quote(&out_dir) + "\nicon=" + desktop_shell_quote(&icon) + "\nxu_target=" + desktop_shell_quote(&xu_target) + "\nwww=" + desktop_shell_quote(&www) + "\nwww_o=" + desktop_shell_quote(&www_o) + "\nneed_wv=" + desktop_shell_quote(&wv_flag) + "\nloader=" + desktop_shell_quote(&loader) + "\nloader_o=" + desktop_shell_quote(&loader_o) + "\nmingw_pfx=" + desktop_shell_quote(&mingw_pfx) + "\nstack_cflags=" + desktop_shell_quote(&stack_cflags) + "\n"
    << desktop_windows_meta_write(td, "env", env)
}

fn desktop_windows_pack_init(td &string, main_xu &string, out string, webview int, no_webview int, www_override string, root string, target_code int) int {
    xu_target := target_name(target_code)
    mingw_pfx := desktop_windows_mingw_prefix(target_code)
    app_dir := desktop_parent_dir(main_xu)
    app_out := desktop_windows_normalize_out(str_clone(&out), str_clone(&app_dir))
    need_wv := desktop_needs_webview(str_clone(&app_dir), str_clone(main_xu), str_clone(&www_override), webview, no_webview)
    mut www := str_clone(&www_override)
    if www.len == 0 && need_wv == 1 {
        sib := app_dir + "/www"
        if desktop_is_dir(&sib) == 1 {
            www = str_clone(&sib)
        }
    }
    mut loader := ""
    if need_wv == 1 { loader = desktop_windows_find_loader_for(str_clone(&root), target_code) }
    if need_wv == 1 && loader.len == 0 {
        eprintln("xu: warn: matching WebView2Loader.dll not in dist/windows-x64-ui/_build/ (pack continues)")
    }
    // pack.loader = DLL path text (cmd_loader reads it); empty → empty blob.
    if desktop_windows_meta_write(td, "loader", str_clone(&loader)) != 0 {
        << 1
    }
    if desktop_windows_meta_write(td, "main_xu", str_clone(main_xu)) != 0 {
        << 1
    }
    if desktop_windows_meta_write(td, "out", str_clone(&app_out)) != 0 {
        << 1
    }
    if desktop_windows_meta_write(td, "root", str_clone(&root)) != 0 {
        << 1
    }
    if desktop_windows_meta_write(td, "xu_target", str_clone(&xu_target)) != 0 {
        << 1
    }
    if desktop_windows_meta_write(td, "mingw_pfx", str_clone(&mingw_pfx)) != 0 {
        << 1
    }
    if desktop_windows_meta_write(td, "app_dir", str_clone(&app_dir)) != 0 {
        << 1
    }
    if desktop_windows_pack_write_www(td, str_clone(&app_dir), need_wv, str_clone(&www_override)) != 0 {
        << 1
    }
    if desktop_windows_pack_write_icon(td, str_clone(&app_dir)) != 0 {
        << 1
    }
    icon := desktop_windows_meta_read(td, "icon")
    << desktop_windows_pack_write_env(td, root, app_out, xu_target, www, need_wv, icon, loader, mingw_pfx)
}

fn desktop_windows_write_text(path &string, body string) int {
    write_file(str_clone(path), body) or (err) {
        << 1
    }
    << 0
}

fn desktop_windows_cmd_emit_xu(td &string, main_xu string) int {
    xuobj := td + "/app.xuobj"
    self := desktop_compiler_bin()
    mut xu_target := desktop_windows_meta_read(td, "xu_target")
    if xu_target.len == 0 {
        xu_target = "windows-x64"
    }
    emit_cmd := desktop_ui_compile_prefix() + desktop_shell_quote(&self) + " build " + desktop_shell_quote(&main_xu) + " --target " + desktop_shell_quote(&xu_target) + " --emit-obj -o " + desktop_shell_quote(&xuobj)
    mut rc := desktop_system(emit_cmd)
    if rc != 0 {
        eprintln("xu: --emit-obj failed")
        desktop_windows_rm_td(td)
        << 1
    }
    xu_o := td + "/app.o"
    py_tool := desktop_windows_meta_read(td, "root") + "/scripts/xuobj_to_coff_o.py"
    mut rc := 1
    if desktop_file_exists(&py_tool) == 1 {
        py_cmd := "python3 " + desktop_shell_quote(&py_tool) + " " + desktop_shell_quote(&xuobj) + " " + desktop_shell_quote(&xu_o)
        rc = desktop_system(py_cmd)
    }
    if rc != 0 {
        coff_cmd := desktop_shell_quote(&self) + " _coff_o " + desktop_shell_quote(&xuobj) + " " + desktop_shell_quote(&xu_o)
        rc = desktop_system(coff_cmd)
    }
    if rc != 0 {
        eprintln("xu: xuobj→coff failed")
        desktop_windows_rm_td(td)
        << 1
    }
    << desktop_windows_cmd_mingw_host(td)
}

fn desktop_windows_cmd_mingw_host(td &string) int {
    sh := td + "/mingw_host.sh"
    tdq := desktop_shell_quote(td)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\nCXX=\"$${mingw_pfx}-g++\"\nGCC=\"$${mingw_pfx}-gcc\"\ncompile_host() { \"$$CXX\" -O2 -std=c++17 -c -DXU_UI_STATIC $$stack_cflags -I\"$$root/src/ui/host\" \"$$@\"; }\ncompile_host \"$$root/src/ui/host/windows_host.cc\" -o \"$$td/windows_host.o\"\ncompile_host \"$$root/src/ui/host/windows_draw.cc\" -o \"$$td/windows_draw.o\"\n$$GCC -O2 -c -I\"$$root/src/ui/host\" \"$$root/src/ui/host/xu_pack_assets.c\" -o \"$$td/xu_pack_assets.o\"\n$$GCC -O2 -c -I\"$$root/src/ui/host\" \"$$root/src/ui/host/xu_pack_assets_weak.c\" -o \"$$td/xu_pack_assets_weak.o\"\n$$CXX -O2 -std=c++17 -c -DXU_UI_STATIC $$stack_cflags -I\"$$root/src/ui/host\" \"$$root/src/ui/host/xu_ui_mem.cc\" -o \"$$td/xu_ui_mem.o\"\n$$CXX -O2 -std=c++17 -c \"$$root/src/ui/host/cxx_string_force.cc\" -o \"$$td/cxx_string_force.o\"\n$$CXX -O2 -std=c++17 -c \"$$root/src/ui/host/cxxabi_stub.cc\" -o \"$$td/cxxabi_stub.o\"\nif [ \"$$need_wv\" = \"1\" ]; then\n  compile_host \"$$root/src/ui/host/windows_webview.cc\" -o \"$$td/windows_webview.o\"\nelse\n  printf '%s\\n' '#include \"xu_content_abi.h\"' 'extern \"C\" const XuContentVTable *xu_webview_plugin_vtable(void) { return nullptr; }' > \"$$td/webview_stub.cc\"\n  compile_host \"$$td/webview_stub.cc\" -o \"$$td/webview_stub.o\"\nfi\n"
    if desktop_windows_write_text(&sh, body) != 0 {
        eprintln("xu: cannot write mingw_host.sh")
        desktop_windows_rm_td(td)
        << 1
    }
    rc := desktop_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: mingw host compile failed")
        desktop_windows_rm_td(td)
        << 1
    }
    << desktop_windows_cmd_icon(td)
}

fn desktop_windows_cmd_icon(td &string) int {
    icon_c := td + "/icon_blob.c"
    icon_o := td + "/icon_blob.o"
    icon_png := desktop_meta_trim(desktop_windows_meta_read(td, "icon"))
    if desktop_write_icon_blob_c(icon_png, str_clone(&icon_c)) != 0 {
        desktop_windows_rm_td(td)
        << 1
    }
    sh := td + "/icon_mingw.sh"
    tdq := desktop_shell_quote(td)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\n\"$${mingw_pfx}-gcc\" -O2 -c -I\"$$root/src/ui/host\" " + desktop_shell_quote(&icon_c) + " -o " + desktop_shell_quote(&icon_o) + "\n"
    if desktop_windows_write_text(&sh, body) != 0 {
        desktop_windows_rm_td(td)
        << 1
    }
    rc := desktop_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: mingw icon_blob.c failed")
        desktop_windows_rm_td(td)
        << 1
    }
    << desktop_windows_cmd_icon_ico(td)
}

fn desktop_windows_write_empty_icon_ico_c(out_c string) int {
    body := "/* Empty tray .ico placeholder when convert/magick unavailable. */\nconst unsigned char xu_pack_icon_ico[] = {0};\nconst unsigned int xu_pack_icon_ico_len = 0;\n"
    write_file(out_c, body) or (err) {
        << 1
    }
    << 0
}

fn desktop_windows_cmd_icon_ico(td &string) int {
    // pack.icon holds the PNG *path* (not file bytes). Reading the PNG here
    // would feed binary into magick and leave xu_pack_icon_ico_len=0.
    mut icon_png := desktop_windows_meta_read(td, "icon")
    if icon_png.len > 0 && icon_png[icon_png.len - 1] == 10 {
        icon_png = icon_png[0:icon_png.len - 1]
    }
    if icon_png.len == 0 {
        eprintln("xu: icon path missing in pack meta")
        desktop_windows_rm_td(td)
        << 1
    }
    ico := td + "/xu_app_icon.ico"
    // Prefer pack.env $icon via shell (same pattern as other pack stages).
    sh_make := td + "/make_ico.sh"
    tdq := desktop_shell_quote(td)
    make_body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\nico=\"$$td/xu_app_icon.ico\"\nif command -v magick >/dev/null 2>&1; then\n  magick \"$$icon\" -define icon:auto-resize=256,128,96,64,48,32,16 \"$$ico\"\nelif [ \"$$OS\" != \"Windows_NT\" ] && command -v convert >/dev/null 2>&1; then\n  convert \"$$icon\" -define icon:auto-resize=256,128,96,64,48,32,16 \"$$ico\"\nelse\n  exit 1\nfi\ntest -s \"$$ico\"\n"
    mut got_ico := 0
    if desktop_windows_write_text(&sh_make, make_body) == 0 {
        if desktop_system("sh " + desktop_shell_quote(&sh_make)) == 0 {
            got_ico = 1
        }
    }
    icon_ico_c := td + "/icon_ico_blob.c"
    if got_ico == 0 {
        eprintln("xu: warn: convert/magick failed — empty icon_ico blob")
        if desktop_windows_write_empty_icon_ico_c(icon_ico_c) != 0 {
            desktop_windows_rm_td(td)
            << 1
        }
    } else {
        if desktop_write_file_blob_c(str_clone(&ico), "xu_pack_icon_ico", icon_ico_c, "Embedded brand icon as .ico (Windows tray)") != 0 {
            desktop_windows_rm_td(td)
            << 1
        }
    }
    icon_ico_o := td + "/icon_ico_blob.o"
    sh := td + "/icon_ico_mingw.sh"
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\n\"$${mingw_pfx}-gcc\" -O2 -c " + desktop_shell_quote(&icon_ico_c) + " -o " + desktop_shell_quote(&icon_ico_o) + "\n"
    if desktop_windows_write_text(&sh, body) != 0 {
        desktop_windows_rm_td(td)
        << 1
    }
    mut rc := desktop_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        desktop_windows_rm_td(td)
        << 1
    }
    if got_ico == 1 {
        rc_path := td + "/xu_app.rc"
        rc_body := "/* Windows app icon resource (must match IDI_XUAPP in windows_host.cc). */\n#define IDI_XUAPP 101\nIDI_XUAPP ICON \"xu_app_icon.ico\"\n"
        if desktop_windows_write_text(&rc_path, rc_body) != 0 {
            desktop_windows_rm_td(td)
            << 1
        }
        wr_sh := td + "/windres.sh"
        wr_body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\ncd \"$$td\"\n\"$${mingw_pfx}-windres\" -i xu_app.rc -o xu_app_res.o --input-format=rc --output-format=coff\n"
        if desktop_windows_write_text(&wr_sh, wr_body) != 0 {
            desktop_windows_rm_td(td)
            << 1
        }
        rc = desktop_system("sh " + desktop_shell_quote(&wr_sh))
        if rc != 0 {
            eprintln("xu: warn: windres failed — skip PE icon resource")
        }
    }
    << desktop_windows_cmd_www(td)
}

fn desktop_windows_write_empty_www_c(out_c string) int {
    // Strong empty table. PE/MinGW .refptr cannot bind to weak empties in
    // xu_pack_assets_weak.o (ld: undefined reference to xu_pack_www_files).
    body := "/* Strong empty www table (PE cannot use weak .refptr). */\ntypedef struct { const char *path; const unsigned char *data; unsigned len; } XuWwwFile;\nconst XuWwwFile xu_pack_www_files[] = {{0, 0, 0}};\nconst unsigned xu_pack_www_files_count = 0;\n"
    write_file(out_c, body) or (err) {
        << 1
    }
    << 0
}

fn desktop_windows_cmd_www(td &string) int {
    www_dir := desktop_meta_trim(desktop_windows_meta_read(td, "www"))
    www_c := td + "/www_blob.c"
    www_o := td + "/www_blob.o"
    if www_dir.len == 0 {
        if desktop_windows_write_empty_www_c(str_clone(&www_c)) != 0 {
            desktop_windows_rm_td(td)
            << 1
        }
    } else {
        icon_png := desktop_meta_trim(desktop_windows_meta_read(td, "icon"))
        app_dir := desktop_meta_trim(desktop_windows_meta_read(td, "app_dir"))
        root := desktop_meta_trim(desktop_windows_meta_read(td, "root"))
        mut resource_webview := 0
        if desktop_meta_trim(desktop_windows_meta_read(td, "need_wv")) == "1" { resource_webview = 1 }
        if desktop_write_www_blob_c(www_dir, icon_png, app_dir, root, resource_webview, str_clone(&www_c)) != 0 {
            desktop_windows_rm_td(td)
            << 1
        }
    }
    sh := td + "/www_mingw.sh"
    tdq := desktop_shell_quote(td)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\n\"$${mingw_pfx}-gcc\" -O2 -c -I\"$$root/src/ui/host\" " + desktop_shell_quote(&www_c) + " -o " + desktop_shell_quote(&www_o) + "\n"
    if desktop_windows_write_text(&sh, body) != 0 {
        desktop_windows_rm_td(td)
        << 1
    }
    rc := desktop_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: mingw www_blob.c failed")
        desktop_windows_rm_td(td)
        << 1
    }
    << desktop_windows_cmd_loader(td)
}

fn desktop_windows_write_empty_loader_c(out_c string) int {
    body := "/* Empty WebView2Loader placeholder. */\nconst unsigned char xu_pack_webview2_loader[] = {0};\nconst unsigned int xu_pack_webview2_loader_len = 0;\n"
    write_file(out_c, body) or (err) {
        << 1
    }
    << 0
}

fn desktop_windows_cmd_loader(td &string) int {
    // pack.loader holds the DLL *path*, not the DLL bytes.
    mut loader_dll := desktop_windows_meta_read(td, "loader")
    if loader_dll.len > 0 && loader_dll[loader_dll.len - 1] == 10 {
        loader_dll = loader_dll[0:loader_dll.len - 1]
    }
    loader_c := td + "/loader_blob.c"
    mut have := 0
    if loader_dll.len > 0 {
        if desktop_system("test -s " + desktop_shell_quote(&loader_dll)) == 0 {
            have = 1
        }
    }
    if have == 0 {
        if desktop_windows_write_empty_loader_c(loader_c) != 0 {
            desktop_windows_rm_td(td)
            << 1
        }
    } else {
        eprintln("xu: embedding WebView2Loader " + loader_dll)
        if desktop_write_file_blob_c(str_clone(&loader_dll), "xu_pack_webview2_loader", loader_c, "Embedded WebView2Loader.dll") != 0 {
            desktop_windows_rm_td(td)
            << 1
        }
    }
    loader_o := td + "/loader_blob.o"
    sh := td + "/loader_mingw.sh"
    tdq := desktop_shell_quote(td)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\n\"$${mingw_pfx}-gcc\" -O2 -c " + desktop_shell_quote(&loader_c) + " -o " + desktop_shell_quote(&loader_o) + "\n"
    if desktop_windows_write_text(&sh, body) != 0 {
        desktop_windows_rm_td(td)
        << 1
    }
    mut rc := desktop_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        desktop_windows_rm_td(td)
        << 1
    }
    desktop_windows_meta_write(td, "loader_o", loader_o)
    << desktop_windows_cmd_shim(td)
}

fn desktop_windows_cmd_shim(td &string) int {
    shim_src := desktop_windows_meta_read(td, "root") + "/src/ui/host/winmain_pack_shim.c"
    shim_o := td + "/winmain_pack_shim.o"
    sh := td + "/shim_mingw.sh"
    tdq := desktop_shell_quote(td)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\n\"$${mingw_pfx}-gcc\" -O2 -c " + desktop_shell_quote(&shim_src) + " -o " + desktop_shell_quote(&shim_o) + "\n"
    if desktop_windows_write_text(&sh, body) != 0 {
        desktop_windows_rm_td(td)
        << 1
    }
    mut rc := desktop_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: mingw winmain_pack_shim.c failed")
        desktop_windows_rm_td(td)
        << 1
    }
    << desktop_windows_cmd_archive(td)
}

fn desktop_windows_cmd_archive(td &string) int {
    sh := td + "/archive.sh"
    tdq := desktop_shell_quote(td)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\nAR=\"$${mingw_pfx}-ar\"\nobjs=\"$$td/windows_host.o $$td/windows_draw.o $$td/xu_pack_assets.o $$td/xu_pack_assets_weak.o $$td/xu_ui_mem.o $$td/cxx_string_force.o $$td/cxxabi_stub.o\"\nif [ \"$$need_wv\" = \"1\" ]; then\n  objs=\"$$objs $$td/windows_webview.o\"\nelse\n  objs=\"$$objs $$td/webview_stub.o\"\nfi\n$$AR rcs \"$$td/libxu_ui_host.a\" $$objs\n"
    if desktop_windows_write_text(&sh, body) != 0 {
        desktop_windows_rm_td(td)
        << 1
    }
    rc := desktop_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: ar libxu_ui_host.a failed")
        desktop_windows_rm_td(td)
        << 1
    }
    << desktop_windows_cmd_link(td)
}

fn desktop_windows_cmd_link(td &string) int {
    sh := td + "/link.sh"
    tdq := desktop_shell_quote(td)
    body := "#!/bin/sh\nset -e\n. " + tdq + "/pack.env\nmkdir -p \"$$out_dir\"\nextra=\"\"\nif [ -f \"$$td/icon_ico_blob.o\" ]; then extra=\"$$extra $$td/icon_ico_blob.o\"; fi\nif [ -f \"$$td/xu_app_res.o\" ]; then extra=\"$$extra $$td/xu_app_res.o\"; fi\nif [ -n \"$$loader_o\" ] && [ -f \"$$loader_o\" ]; then extra=\"$$extra $$loader_o\"; fi\nif [ -n \"$$www_o\" ] && [ -f \"$$www_o\" ]; then extra=\"$$extra $$www_o\"; fi\nLIBS=\"-luser32 -lgdi32 -lgdiplus -ldwrite -limm32 -lole32 -loleaut32 -lshell32 -luuid -lcomdlg32 -lshlwapi\"\n\"$${mingw_pfx}-g++\" -O2 \"$$td/app.o\" -Wl,--whole-archive \"$$td/libxu_ui_host.a\" -Wl,--no-whole-archive \"$$td/icon_blob.o\" $$extra \"$$td/winmain_pack_shim.o\" -o \"$$out\" -mwindows -static -static-libgcc -static-libstdc++ -Wl,-u,__cxa_pure_virtual -Wl,-u,xu_force_cxx_string_syms $$LIBS\n"
    if desktop_windows_write_text(&sh, body) != 0 {
        desktop_windows_rm_td(td)
        << 1
    }
    rc := desktop_system("sh " + desktop_shell_quote(&sh))
    if rc != 0 {
        eprintln("xu: desktop link failed")
        desktop_windows_rm_td(td)
        << 1
    }
    outf := desktop_windows_meta_read(td, "out")
    desktop_pe_patch_stack(str_clone(&outf))
    xu_target := desktop_windows_meta_read(td, "xu_target")
    mut arch := "x64"
    if xu_target == "windows-arm64" {
        arch = "arm64"
    }
    println("ship: " + outf + " arch=" + arch + " target=" + xu_target)
    desktop_windows_rm_td(td)
    << 0
}

fn desktop_windows_pack_body(main_xu string, out string, webview int, no_webview int, www_override string, root string, target_code int) int {
    mut td := desktop_windows_alloc_td()
    mut entry := main_xu
    if desktop_windows_pack_init(&td, &entry, out, webview, no_webview, www_override, root, target_code) != 0 {
        desktop_windows_rm_td(&td)
        << 1
    }
    env := desktop_windows_meta_read(&td, "env")
    env_path := td + "/pack.env"
    write_file(env_path, env) or (err) {
        desktop_windows_rm_td(&td)
        << 1
    }
    << desktop_windows_cmd_emit_xu(&td, entry)
}

fn run_desktop_pack_windows(main_xu string, out string, webview int, no_webview int, www_override string, root string, target_code int) int {
    << desktop_windows_pack_body(main_xu, out, webview, no_webview, www_override, root, target_code)
}

fn run_desktop_pack_windows_go(src0 string, target_code int, out string, webview int, no_webview int, www string) int {
    src_in := str_clone(&src0)
    src := desktop_resolve_entry(str_clone(&src_in))
    if src.len == 0 {
        << 1
    }
    root := desktop_find_repo_root()
    if root.len == 0 {
        eprintln("xu: --desktop needs full SDK host sources (src/ui/host); reinstall the SDK or set XU_ROOT")
        << 1
    }
    app_dir0 := desktop_parent_dir(&src)
    need_wv := desktop_needs_webview(str_clone(&app_dir0), str_clone(&src), str_clone(&www), webview, no_webview)
    if desktop_windows_run_doctor(target_code, need_wv) != 0 {
        eprintln("xu: --desktop aborted (doctor)")
        << 1
    }
    out_path := desktop_windows_normalize_out(str_clone(&out), str_clone(&app_dir0))
    println("xu: desktop pack → " + out_path)
    << desktop_windows_pack_body(src, out_path, need_wv, no_webview, www, root, target_code)
}
