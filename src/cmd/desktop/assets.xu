@main

#os
#path/filepath
#errors

fn desktop_hex_byte(b int) string {
    hex := "0123456789abcdef"
    hi := (b >> 4) & 15
    lo := b & 15
    << "0x" + hex[hi:hi + 1] + hex[lo:lo + 1]
}

fn desktop_write_icon_blob_c(png_path string, out_c string) int {
    // Hex-in-Xu is O(n²) and appears hung on multi-MB PNGs. Use xxd (same class as clang).
    eprintln("xu: embedding icon " + png_path)
    temp_root := desktop_temp_dir()
    tmp := desktop_temp_dir() + "/xu_pack_icon_png"
    qpng := desktop_shell_quote(&png_path)
    qtmp := desktop_shell_quote(&tmp)
    qout := desktop_shell_quote(&out_c)
    mut rc := desktop_system("cp " + qpng + " " + qtmp)
    if rc != 0 {
        eprintln("xu: cannot copy icon " + png_path)
        << 1
    }
    // xxd -i uses basename for symbols; run from /tmp so we get xu_pack_icon_png.
    hdr := desktop_temp_dir() + "/xu_icon_hdr_" + str(now_ns() & 1048575)
    qhdr := desktop_shell_quote(&hdr)
    write_file(hdr, "/* Embedded brand icon — served from memory. */\n") or (err) {
        << 1
    }
    rc = desktop_system("cat " + qhdr + " > " + qout + " && (cd " + desktop_shell_quote(&temp_root) + " && xxd -i xu_pack_icon_png | sed 's/^unsigned /const unsigned /') >> " + qout)
    desktop_system("rm -f " + qhdr + " " + qtmp)
    if rc != 0 {
        eprintln("xu: xxd icon blob failed (need xxd in PATH)")
        << 1
    }
    << 0
}

fn desktop_list_www_files(www_dir string, out_list string) int {
    rc := desktop_system("find " + desktop_shell_quote(&www_dir) + " -type f | sort >" + desktop_shell_quote(&out_list))
    if rc != 0 {
        << 1
    }
    << 0
}

fn desktop_write_www_blob_c(www_dir string, icon_png string, app_dir string, root string, webview int, out_c string) int {
    list := desktop_temp_dir() + "/xu_www_list_" + str(now_ns() & 1048575)
    if desktop_list_www_files(str_clone(&www_dir), str_clone(&list)) != 0 {
        eprintln("xu: cannot list www/ " + www_dir)
        << 1
    }
    body := read_file(list) or (err) {
        << 1
    }
    desktop_system("rm -f " + desktop_shell_quote(&list))
    mut paths := []string{}
    mut start := 0
    for i in 0:body.len {
        if body[i] == 10 {
            if i > start {
                paths.push(body[start:i])
            }
            start = i + 1
        }
    }
    if start < body.len {
        paths.push(body[start:body.len])
    }
    mut rels := []string{}
    mut srcs := []string{}
    mut prefix := str_clone(&www_dir)
    if prefix.len > 0 && prefix[prefix.len - 1] != 47 {
        prefix = prefix + "/"
    }
    for i in 0:paths.len {
        abs := paths[i]
        mut rel := str_clone(&abs)
        if abs.len >= prefix.len {
            mut ok := 1
            for j in 0:prefix.len {
                if abs[j] != prefix[j] {
                    ok = 0
                }
            }
            if ok == 1 {
                rel = abs[prefix.len:abs.len]
            }
        }
        rels.push(rel)
        srcs.push(abs)
    }
    if icon_png.len > 0 {
        rels.push("brand/xu_app_icon.png")
        srcs.push(icon_png)
    }
    mut bridge_path := ""
    if webview == 1 {
        // macOS WithReply bridge; emit is host-pushed (no JS poll).
        bridge_js := "window.__XU__=window.__XU__||{};(function(X){function sc(s){s=String(s==null?'':s);if(!s.length)return '!s ';for(var i=0;i<s.length;i++){var c=s.charCodeAt(i);if(c===10||c===13||c===9||c===35||c===58||c===32||c===33||c===64||c===36)return '!s '+s;}return s;}function enc(n,p){return 'name: '+sc(n)+'\\npayload: '+sc(p)+'\\n';}function dec(t){var o={};String(t||'').split('\\n').forEach(function(line){var i=line.indexOf(': ');if(i>0){var k=line.slice(0,i),v=line.slice(i+2);if(v.indexOf('!s ')===0)v=v.slice(3);o[k]=v;}});return o;}var B='xu://app/__xu';X._deliver=function(n,p){var cb=(X._L||{})[n];if(cb)try{cb(p);}catch(e){}};X.invoke=function(n,p){var wh=window.webkit&&window.webkit.messageHandlers&&window.webkit.messageHandlers.xuInvoke;if(wh){var body={name:String(n==null?'':n),payload:String(p==null?'':p)};var pr=wh.postMessage(body);if(pr&&typeof pr.then==='function')return pr;}return fetch(B+'/invoke',{method:'POST',headers:{'Content-Type':'text/xun; charset=utf-8'},body:enc(n,p)}).then(function(r){return r.text();}).then(function(t){var o=dec(t);if(o.ok==='false'||o.ok==='0')throw new Error(o.error||'error');return o.result!=null?o.result:t;});};X.listen=function(n,cb){(X._L=X._L||{})[n]=cb;};window.invoke=X.invoke;window.listen=function(n,cb){return X.listen(n,cb);};})(window.__XU__);"
        bridge_path = desktop_temp_dir() + "/xu_bridge_" + str(now_ns() & 1048575) + ".js"
        write_file(str_clone(&bridge_path), bridge_js) or (err) {
            << 1
        }
        rels.push("__xu/bridge.js")
        srcs.push(str_clone(&bridge_path))
        mut classic_svg := app_dir + "/brand/xu_classic.svg"
        if desktop_file_exists(&classic_svg) != 1 {
            classic_svg = root + "/brand/xu_classic.svg"
        }
        if desktop_file_exists(&classic_svg) == 1 {
            rels.push("brand/xu_classic.svg")
            srcs.push(classic_svg)
        }
        mut classic_png := app_dir + "/brand/xu_classic.png"
        if desktop_file_exists(&classic_png) != 1 {
            classic_png = root + "/brand/xu_classic.png"
        }
        if desktop_file_exists(&classic_png) == 1 {
            rels.push("brand/xu_classic.png")
            srcs.push(classic_png)
        }
    }
    if rels.len == 0 {
        eprintln("xu: empty www dir " + www_dir)
        << 1
    }
    eprintln("xu: embedding www (" + str(rels.len) + " files via xxd)")
    hdr := "/* Embedded #ui/webview www/ static root. */\n#include <stddef.h>\ntypedef struct { const char *path; const unsigned char *data; unsigned len; } XuWwwFile;\n"
    write_file(out_c, hdr) or (err) {
        eprintln("xu: cannot write " + out_c)
        << 1
    }
    qout := desktop_shell_quote(&out_c)
    for i in 0:srcs.len {
        tmpi := desktop_temp_dir() + "/xu_www_" + str(i)
        // Do not borrow &srcs[i] (array string element); clone first.
        src_i := srcs[i] + ""
        qsrc := desktop_shell_quote(&src_i)
        qtmp := desktop_shell_quote(&tmpi)
        mut rc := desktop_system("cp " + qsrc + " " + qtmp)
        if rc != 0 {
            eprintln("xu: cannot copy www src " + src_i)
            << 1
        }
        // xxd symbols from basename: xu_www_N / xu_www_N_len (must run in /tmp)
        temp_root := desktop_temp_dir()
        rc = desktop_system("(cd " + desktop_shell_quote(&temp_root) + " && xxd -i xu_www_" + str(i) + " | sed 's/^unsigned char/static const unsigned char/; s/^unsigned int/static const unsigned int/') >> " + qout)
        desktop_system("rm -f " + qtmp)
        if rc != 0 {
            eprintln("xu: xxd www blob failed for " + src_i)
            << 1
        }
    }
    mut table := "const XuWwwFile xu_pack_www_files[] = {\n"
    for i in 0:rels.len {
        rel_i := rels[i] + ""
        table = table + "  {\"" + rel_i + "\", xu_www_" + str(i) + ", xu_www_" + str(i) + "_len},\n"
    }
    table = table + "};\n"
    table = table + "const unsigned xu_pack_www_files_count = " + str(rels.len) + ";\n"
    // append table
    tpath := desktop_temp_dir() + "/xu_www_tbl_" + str(now_ns() & 1048575)
    write_file(tpath, table) or (err) {
        << 1
    }
    qt := desktop_shell_quote(&tpath)
    desktop_system("cat " + qt + " >> " + qout)
    desktop_system("rm -f " + qt)
    if bridge_path.len > 0 { desktop_system("rm -f " + desktop_shell_quote(&bridge_path)) }
    println("www: embed " + str(rels.len) + " files from " + www_dir + " (in-memory xu://)")
    << 0
}

fn desktop_write_shim_c(out_c string) int {
    body := "/* Packaged UI entry: assets stay in the binary; IPC is in-process. */\n#include <stdlib.h>\n#include \"xu_ui_mem.h\"\n#include \"xu_pack_assets.h\"\n#include \"xu_ui_text.h\"\n#ifdef __linux__\n#include <unistd.h>\n#include <sys/auxv.h>\nextern char **environ;\n#endif\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n#ifdef __linux__\nvoid xu_app_start_hosted(int argc, char **argv, char **envp, long page_size, unsigned long hwcap, int (*start_worker)(void *(*)(void *), void *));\nint xu_ui_runtime_start_worker(void *(*entry)(void *), void *argument);\n#else\nvoid xu_app_start(int argc, char **argv);\n#endif\n#ifdef __cplusplus\n}\n#endif\nstatic void xu_pack_setup(void) {\n  xu_ui_set_asset_reader(xu_pack_asset_ptr);\n  xu_draw_text_init();\n  unsetenv(\"XU_UI_TMP\");\n  setenv(\"XU_UI_PACK\", \"1\", 1);\n  setenv(\"XU_UI_WWW\", \":mem:\", 1);\n}\nint main(int argc, char **argv) {\n  xu_pack_setup();\n#ifdef __linux__\n  xu_app_start_hosted(argc, argv, environ, sysconf(_SC_PAGESIZE), getauxval(AT_HWCAP), xu_ui_runtime_start_worker);\n#else\n  xu_app_start(argc, argv);\n#endif\n  return 0;\n}\n"
    write_file(out_c, body) or (err) {
        << 1
    }
    << 0
}
