@main

#errors
#os
#internal/sdk
#path/filepath

fn update_stage(root &string, stage &string, version &string, platform &string, archive &string) int {
    is_windows := xu_target_os() == 2
    mut ext := ".tar.gz"
    mut suffix := ""
    if is_windows {
        ext = ".zip"
        suffix = ".exe"
    }
    tag := "v" + version
    name := "xu-" + tag + "-" + platform + ext
    mut data := ""
    if archive.len > 0 {
        println("xu update: reading " + archive + "...")
        data = os.read(archive + "") or >>
    } else {
        url := "https://github.com/xulang-org/xu/releases/download/" + tag + "/" + name
        println("xu update: downloading " + url + "...")
        data = update_download(url, 300000000000) or >>
    }
    dest := stage + "/pkg"
    os.mkdir_all(dest + "") or >>
    println("xu update: extracting release package...")
    update_extract(&data, &dest, is_windows) or >>
    payload := update_find_sdk(&dest, &tag, is_windows) or >>
    compiler := payload + "/bin/xu" + suffix
    println("xu update: verifying downloaded compiler...")
    got := update_compiler_version(&compiler) or >>
    if got != version + "" {
        >> errors.new("downloaded compiler version does not match requested release " + tag)
    }
    println("xu update: replacing the complete SDK at " + root + "...")
    backup := sdk.install_sdk(&payload, root, version, platform) or >>
    if backup.len > 0 { println("xu update: original SDK retained at " + backup) }
    << 0
}

fn update_install(root &string, version &string, platform &string, archive &string) int {
    parent := filepath.dir(root)
    os.mkdir_all(parent + "") or >>
    stage := os.mkdir_temp(parent, ".xu-update-download-") or >>
    update_stage(root, &stage, version, platform, archive) or (err) {
        update_cleanup(&stage)
        >> err
    }
    update_cleanup(&stage)
    << 0
}
