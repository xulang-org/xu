@main

#errors
#os

struct UpdateChange {
    path string
    backed_up bool
    installed bool
}

fn update_replace(src &string, root &string, backup &string, changes &mut []UpdateChange) int {
    mut paths := []string{}
    paths.push("src")
    paths.push("include")
    entries := os.entries(src + "/bin") or >>
    for i in 0:entries.len {
        name := entries[i].name + ""
        if name == ".DS_Store" { -> }
        // A release can also contain bin/platform and native runtime assets.
        paths.push("bin/" + name)
    }
    metadata := ["VERSION", "TARGET", "bundle.json", "install.sh", "install.ps1", "env.sh", "env.ps1"]
    for i in 0:metadata.len { paths.push(metadata[i] + "") }
    for i in 0:paths.len {
        path := paths[i] + ""
        new_path := src + "/" + path
        if !update_exists(new_path + "") { -> }
        target := root + "/" + path
        saved := backup + "/" + path
        idx := changes.len
        changes.push(UpdateChange{path: path, backed_up: false, installed: false})
        if update_exists(target + "") {
            os.rename(target + "", saved) or >>
            changes[idx].backed_up = true
        }
        os.rename(new_path, target) or >>
        changes[idx].installed = true
    }
    << 0
}

fn update_rollback(root &string, backup &string, changes &[]UpdateChange) bool {
    mut ok := true
    mut i := changes.len
    while i > 0 {
        i = i - 1
        target := root + "/" + changes[i].path
        saved := backup + "/" + changes[i].path
        if changes[i].installed {
            os.remove_all(target + "") or (err) {
                eprintln("xu update: rollback cannot remove " + target + ": " + err.msg())
                ok = false
                ->
            }
        }
        if changes[i].backed_up {
            os.rename(saved, target) or (err) {
                eprintln("xu update: rollback cannot restore " + changes[i].path + ": " + err.msg())
                ok = false
                ->
            }
        }
    }
    << ok
}

fn update_stage(root &string, stage &string, backup &string, version &string, platform &string, archive &string) int {
    is_windows := xu_target_os() == 2
    mut ext := ".tar.gz"
    mut suffix := ""
    if is_windows {
        ext = ".zip"
        suffix = ".exe"
    }
    tag := "v" + version
    name := "xu-" + tag + "-" + platform + ext
    mut data := ""
    if archive.len > 0 {
        println("xu update: reading " + archive + "...")
        data = os.read(archive + "") or >>
    } else {
        url := "https://github.com/xulang-org/xu/releases/download/" + tag + "/" + name
        println("xu update: downloading " + url + "...")
        data = update_download(url, 300000000000) or >>
    }
    dest := stage + "/pkg"
    os.mkdir_all(dest + "") or >>
    println("xu update: extracting release package...")
    update_extract(&data, &dest, is_windows) or >>
    sdk := update_find_sdk(&dest, &tag, is_windows) or >>
    compiler := sdk + "/bin/xu" + suffix
    println("xu update: verifying downloaded compiler...")
    got := update_compiler_version(&compiler) or >>
    if got != version + "" {
        >> errors.new("downloaded compiler version does not match requested release " + tag)
    }
    os.mkdir_all(root + "/bin") or >>
    os.mkdir_all(backup + "/bin") or >>
    println("xu update: updating installation at " + root + "...")
    mut changes := []UpdateChange{}
    update_commit(&sdk, root, backup, version, &suffix, mut &changes) or (err) {
        eprintln("xu update: " + err.msg() + "; rolling back...")
        if !update_rollback(root, backup, &changes) {
            >> errors.new("rollback incomplete; backup retained at " + backup)
        }
        update_cleanup(backup)
        >> errors.new("update failed and rolled back: " + err.msg())
    }
    update_cleanup(backup)
    << 0
}

fn update_commit(sdk &string, root &string, backup &string, version &string, suffix &string, changes &mut []UpdateChange) int {
    update_replace(sdk, root, backup, changes) or >>
    installed := root + "/bin/xu" + suffix
    got := update_compiler_version(&installed) or >>
    if got != version + "" { >> errors.new("verification failed on installed compiler") }
    << 0
}

fn update_install(root &string, version &string, platform &string, archive &string) int {
    os.mkdir_all(root + "") or >>
    lock_path := root + "/.xu-update.lock"
    // O_EXCL closes the check/create race. Never clean another process's stage.
    mut lock := os.create_excl(lock_path + "") or (err) {
        if update_exists(lock_path + "") { >> errors.new("another update is running; lock: " + lock_path) }
        >> err
    }
    lock.close() or (err) {
        update_remove_lock(&lock_path)
        >> err
    }
    stage := os.mkdir_temp(root + "", ".xu-update-stage-") or (err) {
        update_remove_lock(&lock_path)
        >> err
    }
    backup := os.mkdir_temp(root + "", ".xu-update-backup-") or (err) {
        update_cleanup(&stage)
        update_remove_lock(&lock_path)
        >> err
    }
    update_stage(root, &stage, &backup, version, platform, archive) or (err) {
        update_cleanup(&stage)
        // A nonempty backup may be the only recovery copy after failed rollback.
        listing := os.listdir(backup + "") or (list_error) {
            update_remove_lock(&lock_path)
            >> err
        }
        if listing.len == 0 { update_cleanup(&backup) }
        update_remove_lock(&lock_path)
        >> err
    }
    update_cleanup(&stage)
    update_remove_lock(&lock_path)
    << 0
}
