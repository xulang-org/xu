@main

fn print_update_help() {
    println("usage: xu update [options] (or: xu up [options])")
    println("")
    println("Download and install the latest GitHub release matching this system.")
    println("")
    println("Options:")
    println("  --check          check for a new version without installing")
    println("  --version VER    install a specific release version (e.g. 0.10.3)")
    println("  --prefix DIR     install SDK into DIR instead of updating current xu")
    println("  --archive FILE   install a local release archive (requires --version)")
    println("  --force          reinstall the same version or allow a downgrade")
    println("  -h, --help       show this help message")
}
