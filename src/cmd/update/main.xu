@main

#errors
#os
#os/exec
#path/filepath
#strings
#internal/semver

struct UpdateContext {
    compiler string
    version string
    platform string
}

fn update_version(output &string) string {
    prefix := "Xu Compiler Toolchain v"
    suffix := " (self-hosted)"
    start := strings.index_of(output, prefix + "")
    if start < 0 { >> errors.new("invalid compiler version output") }
    rest := output[start + prefix.len:output.len] + ""
    end := strings.index_of(&rest, suffix)
    if end < 0 { >> errors.new("invalid compiler version output") }
    version := rest[0:end] + ""
    << update_valid_version(&version) or >>
}

fn update_compiler_version(compiler &string) string {
    mut cmd := exec.command(compiler + "", "--version")
    output := cmd.output() or >>
    << update_version(&output) or >>
}

fn update_context(argv &[]string) UpdateContext {
    if argv.len >= 6 && argv[1] == "_from_xu" && argv[5] == "--" {
        << UpdateContext{compiler: argv[2] + "", version: argv[3] + "", platform: argv[4] + ""}
    }
    exe := exec.look_path(argv[0] + "") or >>
    actual := update_real_path(&exe) or >>
    dir := filepath.dir(&actual)
    mut compiler := dir + "/xu"
    if xu_target_os() == 2 { compiler = compiler + ".exe" }
    version := update_compiler_version(&compiler) or >>
    mut os_cmd := exec.command(compiler + "", "env", "HOST_OS")
    os_out := os_cmd.output() or >>
    mut arch_cmd := exec.command(compiler + "", "env", "HOST_ARCH")
    arch_out := arch_cmd.output() or >>
    platform := strings.trim_space(&os_out) + "-" + strings.trim_space(&arch_out)
    << UpdateContext{compiler: compiler, version: version, platform: platform}
}

fn update_run(argv &[]string) int {
    mut check_only := false
    mut force := false
    mut req_version := ""
    mut req_prefix := ""
    mut archive := ""
    mut i := 1
    if argv.len >= 6 && argv[1] == "_from_xu" && argv[5] == "--" { i = 6 }
    for j in i:argv.len {
        if argv[j] == "--help" || argv[j] == "-h" {
            print_update_help()
            << 0
        }
    }
    while i < argv.len {
        arg := argv[i]
        if arg == "--check" { check_only = true }
        else if arg == "--force" { force = true }
        else if arg == "--version" || arg == "--prefix" || arg == "--archive" {
            if i + 1 >= argv.len {
                >> errors.new(arg + " requires an argument")
            }
            if arg == "--version" { req_version = argv[i + 1] + "" }
            if arg == "--prefix" { req_prefix = argv[i + 1] + "" }
            if arg == "--archive" { archive = argv[i + 1] + "" }
            i = i + 1
        } else { >> errors.new("unknown option '" + arg + "'") }
        i = i + 1
    }
    if archive.len > 0 && req_version.len == 0 {
        >> errors.new("--archive requires --version")
    }
    if req_version.len > 0 { req_version = update_valid_version(&req_version) or >> }
    ctx := update_context(argv) or >>
    platform := ctx.platform + ""
    if platform != "macos-arm64" && platform != "macos-x64" && platform != "linux-arm64" && platform != "linux-x64" && platform != "linux-loongarch64" && platform != "linux-riscv64" && platform != "linux-arm32" && platform != "windows-x64" && platform != "windows-arm64" {
        >> errors.new("unsupported host platform (" + platform + ")")
    }
    compiler := update_real_path(&ctx.compiler) or >>
    exe_dir := filepath.dir(&compiler)
    mut sdk_root := exe_dir + ""
    if filepath.base(&exe_dir) == "bin" { sdk_root = filepath.dir(&exe_dir) }
    mut install_root := sdk_root + ""
    if req_prefix.len > 0 { install_root = update_real_path(&req_prefix) or >> }
    if !check_only && update_exists(install_root + "/.git") {
        >> errors.new("refusing to overwrite a git development checkout; use --prefix DIR to install to a separate directory")
    }
    mut target_version := req_version + ""
    if target_version.len == 0 {
        println("xu update: checking latest release from GitHub...")
        target_version = update_fetch_latest_tag() or >>
    }
    target_version = update_valid_version(&target_version) or >>
    current_version := ctx.version + ""
    canon_target := semver.canonical(&target_version)
    canon_current := semver.canonical(&current_version)
    cmp := semver.compare(&canon_target, &canon_current)
    if check_only {
        println("xu update: current version: " + current_version + " (" + platform + ")")
        println("xu update: latest version:  " + target_version)
        if cmp > 0 { println("xu update: update available! Run 'xu up' to upgrade.") }
        else { println("xu update: already up to date.") }
        << 0
    }
    if cmp <= 0 && !force && req_prefix.len == 0 {
        println("xu update: already up to date (" + current_version + "); use --force to reinstall or downgrade")
        << 0
    }
    update_install(&install_root, &target_version, &platform, &archive) or >>
    println("xu update: successfully updated to v" + target_version + " (" + platform + ")")
    << 0
}

fn main() int {
    argv := os.argv()
    << update_run(&argv) or (err) {
        eprintln("xu update: " + err.msg())
        << 1
    }
}
