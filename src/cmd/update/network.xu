@main

#errors
#encoding/json
#internal/sdk
#net/http
#strings

fn update_valid_version(version &string) string {
    << sdk.release_version(version) or >>
}

fn update_get(raw_url string, timeout_ns int) string {
    << sdk.get(raw_url, timeout_ns) or >>
}

fn update_download(raw_url string, timeout_ns int) string {
    data := sdk.download(raw_url, timeout_ns, update_download_progress) or (err) {
        // 失败也要结束进度行，错误信息才不会拼在进度条后面。
        sdk.term_progress_end()
        >> err
    }
    sdk.term_progress_end()
    << data
}

fn update_fetch_latest_api() string {
    body := update_get("https://api.github.com/repos/xulang-org/xu/releases/latest", 15000000000) or >>
    doc := json.parse(&body)
    if !doc.ok() || !doc.is_dict(doc.root()) { >> errors.new("invalid release response") }
    node := doc.get(doc.root(), "tag_name")
    if node < 0 || !doc.is_string(node) { >> errors.new("missing release tag") }
    tag := doc.as_string(node) or >>
    << update_valid_version(&tag) or >>
}

fn update_fetch_latest_tag() string {
    << update_fetch_latest_api() or (api_error) {
        // The public redirect remains usable when the API rate limit is hit.
        $client := http.new_client()
        client.set_timeout(15000000000)
        client.max_redirects = -1
        empty := ""
        response := client.do("HEAD", "https://github.com/xulang-org/xu/releases/latest", &empty) or (err) {
            >> errors.new("cannot query latest release: " + api_error.msg() + "; " + err.msg())
        }
        location := response.header("Location")
        prefix := "https://github.com/xulang-org/xu/releases/tag/"
        relative := "/xulang-org/xu/releases/tag/"
        $tag := ""
        if strings.has_prefix(&location, prefix + "") { tag = location[prefix.len:location.len] + "" }
        else if strings.has_prefix(&location, relative + "") { tag = location[relative.len:location.len] + "" }
        if tag.len == 0 { >> errors.new("cannot query latest release: " + api_error.msg() + "; specify --version <VER>") }
        << update_valid_version(&tag) or >>
    }
}
