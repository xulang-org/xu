@main

#internal/sdk

fn update_download_progress(received int, total int) {
    mut line := "xu update: downloaded " + sdk.format_size(received)
    if total > 0 {
        percent := received * 100 / total
        line = line + " / " + sdk.format_size(total) + " (" + str(percent) + "%)"
    }
    println(line)
}
