@main

#errors
#internal/sdk
#os
#path/filepath

fn update_exists(path string) bool {
    os.stat(path) or (err) { << false }
    << true
}

fn update_real_path(path &string) string {
    << sdk.real_path(path) or >>
}

fn update_cleanup(path &string) {
    os.remove_all(path + "") or (err) {
        eprintln("xu update: cannot clean " + path + ": " + err.msg())
        <<
    }
}

fn update_remove_lock(path &string) {
    os.remove(path + "") or (err) {
        eprintln("xu update: cannot remove lock " + path + ": " + err.msg())
        <<
    }
}

fn update_find_sdk(dest &string, tag &string, is_windows bool) string {
    mut suffix := ""
    if is_windows { suffix = ".exe" }
    cands := [dest + "/xu-" + tag, dest + "/xu-" + tag + "-devkit", dest + "/xu", dest + ""]
    for i in 0:cands.len {
        if update_exists(cands[i] + "/bin/xu" + suffix) && os.is_dir(cands[i] + "/src") {
            << cands[i] + ""
        }
    }
    >> errors.new("extracted package does not contain a valid Xu SDK structure")
}
