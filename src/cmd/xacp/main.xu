@main
// xu-xacp — safe launcher/inspector for XACP-enabled Xu programs.
//
// This tool deliberately delegates execution to the target process.  It can
// inspect the target's discovery document and run it with a protected `--`
// boundary, but it cannot grant permissions or inject control payloads.

#os
#os/exec
#strconv

const MAX_RECORD_BYTES = 1048576

fn usage() {
    println("usage: xu xacp <inspect|run|debug|record> <program> [-- args...]")
    println("")
    println("  inspect   read the program's --xacp-help discovery document")
    println("  run       execute the program and forward args after --")
    println("  debug     inspect first, then execute with the same safe boundary")
    println("  record    stream bounded stdout; redirect it to a file yourself")
    println("")
    println("The current dispatcher is help-only; no permissions or control events are granted.")
}

fn target_help(path string) int {
    mut child := exec.command(path)
    child.args.push("--xacp-help")
    text := child.output() or (err) {
        eprintln("xu xacp: " + err.msg())
        << 1
    }
    println(text)
    << 0
}

fn child_exit_code(msg string) int {
    prefix := "exit status "
    if msg.len <= prefix.len || msg[0:prefix.len] != prefix {
        << -1
    }
    mut tail := msg[prefix.len:msg.len]
    code := strconv.parse(&tail, 10) or (err) {
        << -1
    }
    << code
}

fn target_run(path string, argv &[]string) int {
    mut forwarded := []string{}
    // Always add a delimiter so a user argument named --xacp-help cannot be
    // interpreted as a startup command by the generated target.
    forwarded.push("--")
    for i in 0:argv.len {
        forwarded.push(argv[i] + "")
    }
    mut child := exec.command(path)
    for i in 0:forwarded.len {
        child.args.push(forwarded[i] + "")
    }
    child.run() or (err) {
        eprintln("xu xacp: " + err.msg())
        code := child_exit_code(err.msg())
        if code >= 0 { << code }
        << 1
    }
    << 0
}

fn target_record(path string, argv &[]string) int {
    if xu_target_os() == 2 {
        eprintln("xu xacp: record is not available on Windows yet")
        << 1
    }
    mut child := exec.command(path)
    child.args.push("--")
    for i in 0:argv.len {
        child.args.push(argv[i] + "")
    }
    mut pipe := child.stdout_pipe() or (err) {
        eprintln("xu xacp: " + err.msg())
        << 1
    }
    child.start() or (err) {
        eprintln("xu xacp: " + err.msg())
        pipe.close() or (close_err) { << 1 }
        << 1
    }
    mut total := 0
    mut overflow := false
    while overflow == false {
        chunk := pipe.read(65536) or (err) {
            <-
        }
        if chunk.len == 0 { <- }
        if chunk.len > MAX_RECORD_BYTES - total {
            overflow = true
        } else {
            _ := os_fd_write(1, chunk) or (err) {
                eprintln("xu xacp: recording output failed: " + err.msg())
                << 1
            }
            total = total + chunk.len
        }
    }
    _ := pipe.close() or (err) { << 0 }
    child.wait() or (err) {
        code := child_exit_code(err.msg())
        if overflow {
            eprintln("xu xacp: recording exceeded 1 MiB")
        } else {
            eprintln("xu xacp: " + err.msg())
        }
        if code >= 0 { << code }
        << 1
    }
    if overflow {
        eprintln("xu xacp: recording exceeded 1 MiB")
        << 1
    }
    << 0
}

fn main() int {
    argv := os.args()
    if argv.len < 2 || argv[1] == "-h" || argv[1] == "--help" {
        usage()
        << 0
    }
    mode := argv[1]
    if mode != "inspect" && mode != "run" && mode != "debug" && mode != "record" {
        eprintln("xu xacp: unknown command '" + mode + "'")
        usage()
        << 1
    }
    if argv.len < 3 {
        eprintln("xu xacp: missing program path")
        usage()
        << 1
    }
    path := argv[2]
    if mode == "inspect" {
        << target_help(path)
    }
    mut forwarded := []string{}
    mut after := 0
    mut i := 3
    while i < argv.len {
        if after == 1 {
            forwarded.push(argv[i] + "")
        } else if argv[i] == "--" {
            after = 1
        } else {
            eprintln("xu xacp: arguments must follow --")
            << 1
        }
        i += 1
    }
    if mode == "record" {
        << target_record(path, &forwarded)
    }
    if mode == "debug" {
        if target_help(path) != 0 { << 1 }
    }
    << target_run(path, &forwarded)
}
