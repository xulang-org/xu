@main
// xu-xacp — safe launcher/inspector for XACP-enabled Xu programs.
//
// Control forwards the caller's stdin/stdout to an explicit stdio session.

#os
#os/exec
#strconv
#errors
#strings

const MAX_RECORD_BYTES = 1048576

fn usage() {
    println("usage: xu xacp <inspect|run|debug|record|control|attach> <program> [-- args...]")
    println("")
    println("  inspect   read the program's --xacp-help discovery document")
    println("  attach    run business main; application calls xacp.attach_stdio and polls its Screen")
    println("  control   serve framed stdin/stdout exclusively (business main is skipped)")
    println("  run       execute the program and forward args after --")
    println("  debug     inspect first, then execute with the same safe boundary")
    println("  record    stream bounded stdout; redirect it to a file yourself")
    println("")
    println("  connect PORT  relay framed stdin/stdout to 127.0.0.1:PORT")
    println("control/attach: pipe XACP frames; hello negotiates INFO or host-token permissions.")
}

fn target_help(path string) int {
    $child := exec.command(path)
    child.args.push("--xacp-help")
    text := child.output() or (err) {
        eprintln("xu xacp: " + err.msg())
        << 1
    }
    println(text)
    << 0
}

fn child_exit_code(msg string) int {
    prefix := "exit status "
    if msg.len <= prefix.len || msg[0:prefix.len] != prefix {
        << -1
    }
    $tail := msg[prefix.len:msg.len]
    code := strconv.parse(&tail, 10) or (err) {
        << -1
    }
    << code
}

fn target_run(path string, argv &[]string) int {
    $forwarded := []string{}
    // Always add a delimiter so a user argument named --xacp-help cannot be
    // interpreted as a startup command by the generated target.
    forwarded.push("--")
    for i in 0:argv.len {
        forwarded.push(argv[i] + "")
    }
    $child := exec.command(path)
    for i in 0:forwarded.len {
        child.args.push(forwarded[i] + "")
    }
    child.run() or (err) {
        eprintln("xu xacp: " + err.msg())
        code := child_exit_code(err.msg())
        if code >= 0 { << code }
        << 1
    }
    << 0
}

fn target_record(path string, argv &[]string) int {
    if xu_target_os() == 2 {
        eprintln("xu xacp: record is not available on Windows yet")
        << 1
    }
    $child := exec.command(path)
    child.args.push("--")
    for i in 0:argv.len {
        child.args.push(argv[i] + "")
    }
    $pipe := child.stdout_pipe() or (err) {
        eprintln("xu xacp: " + err.msg())
        << 1
    }
    child.start() or (err) {
        eprintln("xu xacp: " + err.msg())
        pipe.close() or (close_err) { << 1 }
        << 1
    }
    $total := 0
    $overflow := false
    $failed := false
    while overflow == false {
        chunk := pipe.read(65536) or (err) {
            eprintln("xu xacp: recording read failed: " + err.msg())
            failed = true
            <-
        }
        if chunk.len == 0 { <- }
        if chunk.len > MAX_RECORD_BYTES - total {
            overflow = true
        } else {
            $written := 0
            while written < chunk.len {
                n := os_fd_write(1, chunk[written:chunk.len]) or (err) {
                    eprintln("xu xacp: recording output failed: " + err.msg())
                    failed = true
                    <-
                }
                if n <= 0 {
                    eprintln("xu xacp: recording output made no progress")
                    failed = true
                    <-
                }
                written += n
            }
            total = total + written
            if failed { <- }
        }
    }
    _ := pipe.close() or (err) { << 0 }
    child.wait() or (err) {
        code := child_exit_code(err.msg())
        if overflow {
            eprintln("xu xacp: recording exceeded 1 MiB")
        } else {
            eprintln("xu xacp: " + err.msg())
        }
        if code >= 0 { << code }
        << 1
    }
    if overflow {
        eprintln("xu xacp: recording exceeded 1 MiB")
        << 1
    }
    if failed { << 1 }
    << 0
}

fn main() int {
    argv := os.args()
    if argv.len < 2 || argv[1] == "-h" || argv[1] == "--help" {
        usage()
        << 0
    }
    mode := argv[1]
    if mode == "connect" {
        if argv.len != 3 {
            eprintln("xu xacp: connect requires a loopback port")
            << 1
        }
        code := tcp_connect(argv[2]) or (err) {
            eprintln("xu xacp: " + err.msg())
            << 1
        }
        << code
    }
    if mode != "inspect" && mode != "run" && mode != "debug" && mode != "record" && mode != "control" && mode != "attach" {
        eprintln("xu xacp: unknown command '" + mode + "'")
        usage()
        << 1
    }
    if argv.len < 3 {
        eprintln("xu xacp: missing program path")
        usage()
        << 1
    }
    path := argv[2]
    if mode == "control" {
        if argv.len != 3 {
            eprintln("xu xacp: control does not accept business arguments")
            << 1
        }
        $child := exec.command(path + "")
        child.args.push("--xacp-stdio")
        child.run() or (err) {
            eprintln("xu xacp: " + err.msg())
            code := child_exit_code(err.msg())
            if code >= 0 { << code }
            << 1
        }
        << 0
    }
    if mode == "inspect" {
        if argv.len != 3 {
            eprintln("xu xacp: inspect does not accept program arguments")
            << 1
        }
        << target_help(path)
    }
    $forwarded := []string{}
    $after := 0
    $i := 3
    while i < argv.len {
        if after == 1 {
            forwarded.push(argv[i] + "")
        } else if argv[i] == "--" {
            after = 1
        } else {
            eprintln("xu xacp: arguments must follow --")
            << 1
        }
        i += 1
    }
    if mode == "record" {
        << target_record(path, &forwarded)
    }
    if mode == "debug" {
        if target_help(path) != 0 { << 1 }
    }
    << target_run(path, &forwarded)
}

// One request/response at a time; bounded frames and short-write handling.
// EOF at a frame boundary closes the connection without waiting for server EOF.
fn tcp_connect(port_text string) int {
    port := strconv.parse(&port_text, 10) or >>
    if port < 1 || port > 65535 { >> errors.new("invalid TCP port") }
    fd := os.socket(2, 1, 0) or >>
    tcp_relay(fd, port) or (err) {
        _ := os.socket_close(fd) or (close_err) { >> err }
        >> err
    }
    _ := os.socket_close(fd) or >>
    << 0
}

fn relay_write(fd int, tcp bool, text string) int {
    $offset := 0
    while offset < text.len {
        $n := 0
        if tcp {
            n = os.socket_write(fd, text[offset:text.len]) or >>
        } else {
            n = os_fd_write(fd, text[offset:text.len]) or >>
        }
        if n <= 0 { >> errors.new("control output made no progress") }
        offset += n
    }
    << 0
}

fn relay_byte(fd int, tcp bool) string {
    if tcp { << os.socket_read(fd, 1) or >> }
    << os_fd_read(fd, 1) or >>
}

fn relay_line(fd int, tcp bool, first bool) string {
    $line := strings.builder()
    while line.length() < 16 {
        chunk := relay_byte(fd, tcp) or >>
        if chunk.len == 0 {
            if first && line.length() == 0 { << "" }
            >> errors.new("truncated control frame")
        }
        if (chunk[0] & 255) == 10 { << line.text() }
        line.write_byte(chunk[0] & 255)
    }
    >> errors.new("control frame header too long")
}

// Relays one XACP/1 length-prefixed frame verbatim; "" at clean EOF.
fn relay_frame(fd int, tcp bool) string {
    magic := relay_line(fd, tcp, true) or >>
    if magic == "" { << "" }
    if magic != "XACP/1" { >> errors.new("control frame missing XACP/1 magic") }
    count := relay_line(fd, tcp, false) or >>
    $n := 0
    if count.len == 0 || count.len > 8 { >> errors.new("invalid control frame length") }
    for k in 0:count.len {
        d := count[k] & 255
        if d < 48 || d > 57 { >> errors.new("invalid control frame length") }
        n = n * 10 + (d - 48)
    }
    if n == 0 { >> errors.new("invalid control frame length") }
    if n > MAX_RECORD_BYTES { >> errors.new("control frame exceeds 1 MiB") }
    $frame := strings.builder()
    frame.write_string(&magic)
    frame.write_byte(10)
    frame.write_string(&count)
    frame.write_byte(10)
    $got := 0
    while got < n {
        $want := n - got
        if want > 4096 { want = 4096 }
        $chunk := ""
        if tcp { chunk = os.socket_read(fd, want) or >> } else { chunk = os_fd_read(fd, want) or >> }
        if chunk.len == 0 { >> errors.new("truncated control frame") }
        frame.write_string(&chunk)
        got += chunk.len
    }
    << frame.text()
}

fn tcp_relay(fd int, port int) int {
    os.connect4(fd, 127, 0, 0, 1, port) or >>
    while true {
        request := relay_frame(0, false) or >>
        if request.len == 0 { << 0 }
        relay_write(fd, true, request) or >>
        response := relay_frame(fd, true) or >>
        if response.len == 0 { >> errors.new("control peer closed before response") }
        relay_write(1, false, response) or >>
    }
    << 0
}
