@main
// xu-xacp — safe launcher/inspector for XACP-enabled Xu programs.
//
// Control forwards the caller's stdin/stdout to an explicit stdio session.

#os
#os/exec
#strconv
#errors
#strings
#time

const MAX_RECORD_BYTES = 1048576

fn usage() {
    println("usage: xu xacp <inspect|run|debug|record|control|attach> <program> [-- args...]")
    println("")
    println("  inspect   read the program's --xacp-help discovery document")
    println("  attach    run business main; application calls xacp.attach_stdio and polls its Screen")
    println("  control   serve framed stdin/stdout exclusively (business main is skipped)")
    println("  run       execute the program and forward args after --")
    println("  debug     inspect first, then execute with the same safe boundary")
    println("  record    stream bounded stdout; redirect it to a file yourself")
    println("")
    println("  connect PORT        relay framed stdin/stdout to 127.0.0.1:PORT")
    println("  call PORT OP [ARGS] handshake and send one XACP request, printing its response")
    println("control/attach: pipe XACP frames; hello negotiates INFO or host-token permissions.")
}

fn target_help(path string) int {
    $child := exec.command(path)
    child.args.push("--xacp-help")
    text := child.output() >>> (err) {
        eprintln("xu xacp: " + err.msg())
        << 1
    }
    println(text)
    << 0
}

fn child_exit_code(msg string) int {
    prefix := "exit status "
    if msg.len <= prefix.len || msg[0:prefix.len] != prefix {
        << -1
    }
    $tail := msg[prefix.len:msg.len]
    code := strconv.parse(&tail, 10) >>> (err) {
        << -1
    }
    << code
}

fn target_run(path string, argv &[]string) int {
    $forwarded := []string{}
    // Always add a delimiter so a user argument named --xacp-help cannot be
    // interpreted as a startup command by the generated target.
    forwarded.push("--")
    for i in 0:argv.len {
        forwarded.push(argv[i] + "")
    }
    $child := exec.command(path)
    for i in 0:forwarded.len {
        child.args.push(forwarded[i] + "")
    }
    child.run() >>> (err) {
        eprintln("xu xacp: " + err.msg())
        code := child_exit_code(err.msg())
        if code >= 0 { << code }
        << 1
    }
    << 0
}

fn target_record(path string, argv &[]string) int {
    if xu_target_os() == 2 {
        eprintln("xu xacp: record is not available on Windows yet")
        << 1
    }
    $child := exec.command(path)
    child.args.push("--")
    for i in 0:argv.len {
        child.args.push(argv[i] + "")
    }
    $pipe := child.stdout_pipe() >>> (err) {
        eprintln("xu xacp: " + err.msg())
        << 1
    }
    child.start() >>> (err) {
        eprintln("xu xacp: " + err.msg())
        pipe.close() >>> (close_err) { << 1 }
        << 1
    }
    $total := 0
    $overflow := false
    $failed := false
    while overflow == false {
        chunk := pipe.read(65536) >>> (err) {
            eprintln("xu xacp: recording read failed: " + err.msg())
            failed = true
            <-
        }
        if chunk.len == 0 { <- }
        if chunk.len > MAX_RECORD_BYTES - total {
            overflow = true
        } else {
            $written := 0
            while written < chunk.len {
                n := os_fd_write(1, chunk[written:chunk.len]) >>> (err) {
                    eprintln("xu xacp: recording output failed: " + err.msg())
                    failed = true
                    <-
                }
                if n <= 0 {
                    eprintln("xu xacp: recording output made no progress")
                    failed = true
                    <-
                }
                written += n
            }
            total = total + written
            if failed { <- }
        }
    }
    _ := pipe.close() >>> (err) { << 0 }
    child.wait() >>> (err) {
        code := child_exit_code(err.msg())
        if overflow {
            eprintln("xu xacp: recording exceeded 1 MiB")
        } else {
            eprintln("xu xacp: " + err.msg())
        }
        if code >= 0 { << code }
        << 1
    }
    if overflow {
        eprintln("xu xacp: recording exceeded 1 MiB")
        << 1
    }
    if failed { << 1 }
    << 0
}

fn main() int {
    argv := os.args()
    if argv.len < 2 || argv[1] == "-h" || argv[1] == "--help" {
        usage()
        << 0
    }
    mode := argv[1]
    if mode == "connect" {
        if argv.len != 3 {
            eprintln("xu xacp: connect requires a loopback port")
            << 1
        }
        code := tcp_connect(argv[2]) >>> (err) {
            eprintln("xu xacp: " + err.msg())
            << 1
        }
        << code
    }
    if mode == "call" {
        if argv.len != 4 && argv.len != 5 {
            eprintln("xu xacp: usage: xu xacp call PORT OP [ARGS]")
            << 1
        }
        $raw_args := ""
        if argv.len == 5 { raw_args = argv[4] + "" }
        code := tcp_call(argv[2], argv[3], raw_args) or (err) {
            eprintln("xu xacp: " + err.msg())
            << 1
        }
        << code
    }
    if mode != "inspect" && mode != "run" && mode != "debug" && mode != "record" && mode != "control" && mode != "attach" {
        eprintln("xu xacp: unknown command '" + mode + "'")
        usage()
        << 1
    }
    if argv.len < 3 {
        eprintln("xu xacp: missing program path")
        usage()
        << 1
    }
    path := argv[2]
    if mode == "control" {
        if argv.len != 3 {
            eprintln("xu xacp: control does not accept business arguments")
            << 1
        }
        $child := exec.command(path + "")
        child.args.push("--xacp-stdio")
        child.run() >>> (err) {
            eprintln("xu xacp: " + err.msg())
            code := child_exit_code(err.msg())
            if code >= 0 { << code }
            << 1
        }
        << 0
    }
    if mode == "inspect" {
        if argv.len != 3 {
            eprintln("xu xacp: inspect does not accept program arguments")
            << 1
        }
        << target_help(path)
    }
    $forwarded := []string{}
    $after := 0
    $i := 3
    while i < argv.len {
        if after == 1 {
            forwarded.push(argv[i] + "")
        } else if argv[i] == "--" {
            after = 1
        } else {
            eprintln("xu xacp: arguments must follow --")
            << 1
        }
        i += 1
    }
    if mode == "record" {
        << target_record(path, &forwarded)
    }
    if mode == "debug" {
        if target_help(path) != 0 { << 1 }
    }
    << target_run(path, &forwarded)
}

// One request/response at a time; bounded frames and short-write handling.
// EOF at a frame boundary closes the connection without waiting for server EOF.
fn tcp_connect(port_text string) int {
    port := strconv.parse(&port_text, 10) >>>
    if port < 1 || port > 65535 { >> errors.new("invalid TCP port") }
    fd := os.socket(2, 1, 0) >>>
    tcp_relay(fd, port) >>> (err) {
        _ := os.socket_close(fd) >>> (close_err) { >> err }
        >> err
    }
    _ := os.socket_close(fd) >>>
    << 0
}

fn relay_write(fd int, tcp bool, text string) int {
    $offset := 0
    while offset < text.len {
        $n := 0
        if tcp {
            n = os.socket_write(fd, text[offset:text.len]) >>>
        } else {
            n = os_fd_write(fd, text[offset:text.len]) >>>
        }
        if n <= 0 { >> errors.new("control output made no progress") }
        offset += n
    }
    << 0
}

fn relay_byte(fd int, tcp bool) string {
    if tcp { << os.socket_read(fd, 1) >>> }
    << os_fd_read(fd, 1) >>>
}

fn relay_line(fd int, tcp bool, first bool) string {
    $line := strings.builder()
    while line.length() < 16 {
        chunk := relay_byte(fd, tcp) >>>
        if chunk.len == 0 {
            if first && line.length() == 0 { << "" }
            >> errors.new("truncated control frame")
        }
        if (chunk[0] & 255) == 10 { << line.text() }
        line.write_byte(chunk[0] & 255)
    }
    >> errors.new("control frame header too long")
}

// Relays one XACP/1 length-prefixed frame verbatim; "" at clean EOF.
fn relay_frame(fd int, tcp bool) string {
    magic := relay_line(fd, tcp, true) >>>
    if magic == "" { << "" }
    if magic != "XACP/1" { >> errors.new("control frame missing XACP/1 magic") }
    count := relay_line(fd, tcp, false) >>>
    $n := 0
    if count.len == 0 || count.len > 8 { >> errors.new("invalid control frame length") }
    for k in 0:count.len {
        d := count[k] & 255
        if d < 48 || d > 57 { >> errors.new("invalid control frame length") }
        n = n * 10 + (d - 48)
    }
    if n == 0 { >> errors.new("invalid control frame length") }
    if n > MAX_RECORD_BYTES { >> errors.new("control frame exceeds 1 MiB") }
    $frame := strings.builder()
    frame.write_string(&magic)
    frame.write_byte(10)
    frame.write_string(&count)
    frame.write_byte(10)
    $got := 0
    while got < n {
        $want := n - got
        if want > 4096 { want = 4096 }
        $chunk := ""
        if tcp { chunk = os.socket_read(fd, want) >>> } else { chunk = os_fd_read(fd, want) >>> }
        if chunk.len == 0 { >> errors.new("truncated control frame") }
        frame.write_string(&chunk)
        got += chunk.len
    }
    << frame.text()
}

fn tcp_relay(fd int, port int) int {
    os.connect4(fd, 127, 0, 0, 1, port) >>>
    while true {
        request := relay_frame(0, false) >>>
        if request.len == 0 { << 0 }
        relay_write(fd, true, request) >>>
        response := relay_frame(fd, true) >>>
        if response.len == 0 { >> errors.new("control peer closed before response") }
        relay_write(1, false, response) >>>
    }
    << 0
}

fn quote_xun(value &string) string {
    hex := "0123456789ABCDEF"
    $out := strings.builder()
    out.write_byte(34)
    for i in 0:value.len {
        c := value[i] & 255
        if c == 34 || c == 92 {
            out.write_byte(92)
            out.write_byte(c)
        } else if c == 10 {
            out.write_byte(92)
            out.write_byte(110)
        } else if c == 13 {
            out.write_byte(92)
            out.write_byte(114)
        } else if c == 9 {
            out.write_byte(92)
            out.write_byte(116)
        } else if c < 32 || c == 127 {
            out.write_byte(92)
            out.write_byte(120)
            out.write_byte(hex[c >> 4])
            out.write_byte(hex[c & 15])
        } else {
            out.write_byte(c)
        }
    }
    out.write_byte(34)
    << out.text()
}

fn trim_ws(s &string) string {
    $a := 0
    $b := s.len
    while a < b && ((s[a] & 255) <= 32) { a += 1 }
    while b > a && ((s[b - 1] & 255) <= 32) { b -= 1 }
    << s[a:b]
}

fn build_args_block(raw_args &string) string {
    trimmed := trim_ws(raw_args)
    if trimmed.len == 0 { << "args: {}\n" }
    if trimmed[0] == 123 { << "args: " + trimmed + "\n" }
    $out := strings.builder()
    out.write_string(&"args:\n")
    lines := strings.split(&trimmed, "\n")
    for line in lines {
        clean := trim_ws(&line)
        if clean.len == 0 { -> }
        out.write_string(&"  ")
        out.write_string(&clean)
        out.write_byte(10)
    }
    << out.text()
}

fn read_frame_body(fd int) string {
    magic := relay_line(fd, true, true) or >>
    if magic == "" { >> errors.new("control peer closed before response") }
    if magic != "XACP/1" { >> errors.new("control frame missing XACP/1 magic") }
    count := relay_line(fd, true, false) or >>
    $n := 0
    if count.len == 0 || count.len > 8 { >> errors.new("invalid control frame length") }
    for k in 0:count.len {
        d := count[k] & 255
        if d < 48 || d > 57 { >> errors.new("invalid control frame length") }
        n = n * 10 + (d - 48)
    }
    if n == 0 || n > MAX_RECORD_BYTES { >> errors.new("invalid control frame length") }
    $body := strings.builder()
    $got := 0
    while got < n {
        $want := n - got
        if want > 4096 { want = 4096 }
        chunk := os.socket_read(fd, want) or >>
        if chunk.len == 0 { >> errors.new("truncated control frame") }
        body.write_string(&chunk)
        got += chunk.len
    }
    << body.text()
}

fn send_xacp_frame(fd int, body string) int {
    framed := "XACP/1\n" + str(body.len) + "\n" + body
    << relay_write(fd, true, framed) or >>
}

fn tcp_call_inner(fd int, port int, op string, raw_args string) int {
    os.connect4(fd, 127, 0, 0, 1, port) or >>
    nonce := "cli-" + str(os.getpid()) + "-" + str(time.now())
    token := os.getenv("XU_XACP_TOKEN")
    $hello_body := "id: !i 1\nop: xacp.hello\nargs:\n  ver: !ver 1.0.0\n  nonce: " + quote_xun(&nonce) + "\n"
    if token.len > 0 {
        hello_body = hello_body + "  token: " + quote_xun(&token) + "\n"
    }
    send_xacp_frame(fd, hello_body) or >>
    hello_res := read_frame_body(fd) or >>
    if op == "xacp.hello" {
        ok := strings.contains(&hello_res, "ok: !b true")
        _ := relay_write(1, false, hello_res) or >>
        if ok { << 0 }
        << 1
    }
    if !strings.contains(&hello_res, "ok: !b true") {
        eprintln(hello_res)
        << 1
    }
    req_body := "id: !i 2\nop: " + op + "\n" + build_args_block(&raw_args)
    send_xacp_frame(fd, req_body) or >>
    res_body := read_frame_body(fd) or >>
    ok := strings.contains(&res_body, "ok: !b true")
    _ := relay_write(1, false, res_body) or >>
    if ok { << 0 }
    << 1
}

fn tcp_call(port_text string, op string, raw_args string) int {
    port := strconv.parse(&port_text, 10) or >>
    if port < 1 || port > 65535 { >> errors.new("invalid TCP port") }
    fd := os.socket(2, 1, 0) or >>
    rc := tcp_call_inner(fd, port, op + "", raw_args + "") or (err) {
        _ := os.socket_close(fd) or (ce) { >> err }
        >> err
    }
    _ := os.socket_close(fd) or >>
    << rc
}
