@main

#errors
#os
#os/exec
#path/filepath
#strconv

fn valid_version_code(code &string) bool {
    if code.len == 0 || code.len > 10 { << false }
    for i in 0:code.len {
        c := code[i] & 255
        if c < 48 || c > 57 { << false }
    }
    v := strconv.atoi(code) >>> (err) { << false }
    << v >= 1 && v <= 2100000000
}

fn valid_orientation(value &string) bool {
    << *value == "auto" || *value == "portrait" || *value == "landscape"
}

fn valid_png_file(path &string) bool {
    if path.len == 0 || os.is_dir(*path + "") { << false }
    _ := os.stat(*path + "") >>> (err) { << false }
    data := os.read(*path + "") >>> (err) { << false }
    if data.len < 24 { << false }
    << (data[0] & 255) == 137 && (data[1] & 255) == 80 &&
       (data[2] & 255) == 78 && (data[3] & 255) == 71 &&
       (data[4] & 255) == 13 && (data[5] & 255) == 10 &&
       (data[6] & 255) == 26 && (data[7] & 255) == 10
}

fn resize_png(source string, destination string, size int) int {
    parent := filepath.dir(&destination)
    os.mkdir_all(parent) >>>
    if xu_target_os() == 0 && file_exists("/usr/bin/sips") {
        $cmd := exec.command("/usr/bin/sips", "-z", str(size), str(size), ~source, "--out", ~destination)
        _ := cmd.output() >>> (err) {
            << copy_file(source, destination) >>>
        }
        if file_exists(destination + "") { << 0 }
    }
    << copy_file(source, destination) >>>
}

fn pack_icons(icon_path &string, output &string, android bool, profile &string) int {
    if icon_path.len == 0 { << 0 }
    if !valid_png_file(icon_path) { >>> errors.new("Phone --icon must be a readable PNG file")
    }
    if !android {
        names := ["AppIcon60x60@2x.png", "AppIcon60x60@3x.png", "AppIcon76x76@2x~ipad.png", "AppIcon1024x1024.png"]
        sizes := [120, 180, 152, 1024]
        for i in 0:names.len {
            resize_png(*icon_path + "", *output + "/icons/" + names[i], sizes[i]) >>>
        }
        << 0
    }
    $res_root := *output + "/app/src/main/res"
    if *profile == "game" { res_root = *output + "/res" }
    buckets := ["mdpi", "hdpi", "xhdpi", "xxhdpi", "xxxhdpi"]
    sizes := [48, 72, 96, 144, 192]
    for i in 0:buckets.len {
        dst := res_root + "/mipmap-" + buckets[i] + "/ic_launcher.png"
        resize_png(*icon_path + "", dst, sizes[i]) >>>
    }
    << 0
}

fn ios_orientations_xml(orientation &string) string {
    if *orientation == "portrait" {
        << "<array><string>UIInterfaceOrientationPortrait</string></array>"
    }
    if *orientation == "landscape" {
        << "<array><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>"
    }
    << "<array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>"
}

fn ios_icons_xml(icon_path &string) string {
    if icon_path.len == 0 { << "" }
    << "\n<key>CFBundleIcons</key><dict><key>CFBundlePrimaryIcon</key><dict><key>CFBundleIconFiles</key><array><string>AppIcon60x60</string><string>AppIcon76x76</string></array></dict></dict>"
}

fn android_orientation_attr(orientation &string) string {
    if *orientation == "portrait" { << " android:screenOrientation=\"portrait\"" }
    if *orientation == "landscape" { << " android:screenOrientation=\"sensorLandscape\"" }
    << ""
}

fn android_icon_attr(icon_path &string) string {
    if icon_path.len == 0 { << "" }
    << " android:icon=\"@mipmap/ic_launcher\""
}
