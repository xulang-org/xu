@main

#errors
#internal/toolpath
#os
#os/exec
#path/filepath
#strings

fn help() {
    println("usage: xu-phone pack APP --target TARGET [-o DIRECTORY] [--bundle-id ID]")
    println("Generate an application project with compiled native Xu code.")
    println("Targets: ios-arm64, ios-simulator-arm64, android-arm64")
    println("Build the generated project with its build.sh script or platform IDE.")
}

fn run(program string, args []string) int {
    $cmd := exec.command(program)
    for i in 0:args.len { cmd.args.push(~args[i]) }
    cmd.run() or >>
    << 0
}

fn copy_file(source string, destination string) int {
    parent := filepath.dir(&destination)
    os.mkdir_all(parent) or >>
    body := os.read(source) or >>
    os.write(destination, body) or >>
    << 0
}

fn copy_tree(source string, destination string, depth int) int {
    if depth > 64 { >> errors.new("Phone host source directory nesting exceeds 64") }
    os.mkdir_all(~destination) or >>
    entries := os.entries(~source) or >>
    for i in 0:entries.len {
        child_source := source + "/" + entries[i].name
        child_destination := destination + "/" + entries[i].name
        if entries[i].is_dir { copy_tree(child_source, child_destination, depth + 1) or >> }
        else { copy_file(child_source, child_destination) or >> }
    }
    << 0
}

fn valid_id(id &string) bool {
    if id.len < 3 || id.len > 200 { << false }
    $segment := 0
    $dots := 0
    for i in 0:id.len {
        c := id[i]
        alpha := (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
        if c == 46 {
            if segment == 0 { << false }
            segment = 0
            dots += 1
        } else {
            if !alpha && !(segment > 0 && c >= 48 && c <= 57) { << false }
            segment += 1
        }
    }
    << segment > 0 && dots > 0
}

fn generate(source string, target string, output string, bundle string) int {
    if target != "ios-arm64" && target != "ios-simulator-arm64" && target != "android-arm64" {
        >> errors.new("unsupported Phone target: " + target)
    }
    if !valid_id(&bundle) { >> errors.new("bundle ID must contain dot-separated alphanumeric identifiers starting with letters") }
    if !os.is_dir(source + "") { >> errors.new("Phone input must be a module directory") }
    manifest := os.read(source + "/xu.xun") or >>
    if manifest.len == 0 { >> errors.new("application xu.xun is empty") }
    os.stat(output + "") or (err) {
        staging := output + ".xu-phone-" + str(os.getpid())
        os.stat(staging + "") or (missing) {
            generate_new(~source, ~target, ~staging, ~bundle) or (failure) {
                os.remove_all(~staging) or (cleanup) { eprintln(cleanup.msg()) }
                >> failure
            }
            os.rename(~staging, ~output) or (failure) {
                os.remove_all(~staging) or (cleanup) { eprintln(cleanup.msg()) }
                >> failure
            }
            println("Phone project generated: " + output)
            println("Build: " + output + "/build.sh")
            << 0
        }
        >> errors.new("staging directory already exists: " + staging)
    }
    >> errors.new("output already exists; choose a new directory: " + output)
}

fn generate_new(source string, target string, output string, bundle string) int {
    compiler_name := "xu"
    compiler := toolpath.sibling(&compiler_name) or >>
    if compiler.len == 0 { >> errors.new("missing sibling xu compiler") }
    $root := os.getenv("XU_ROOT")
    if root.len == 0 {
        bin := filepath.dir(&compiler)
        root = filepath.dir(&bin)
    }
    if !os.is_dir(root + "/src/ui/host/phone") { >> errors.new("full Phone SDK sources required; set XU_ROOT") }
    android := target == "android-arm64"
    $native_target := "macos-arm64"
    $convert := "_ios_o"
    if target == "ios-simulator-arm64" { convert = "_ios_sim_o" }
    $platform := "ios"
    if android { native_target = "linux-arm64"
        convert = "_elf_o"
        platform = "android" }
    os.mkdir_all(output + "/native") or >>
    object := output + "/native/app.xuobj"
    $compile := exec.command(~compiler, "build", ~source, "--target", native_target,
        "--_phone-object", "-o", ~object)
    if android { compile.args.push("--chip")
        compile.args.push("cortex-a53") }
    compile.run() or >>
    run(~compiler, [convert, object, output + "/native/app.o"]) or >>
    // Copy the host closure so the generated project remains independent of
    // this SDK checkout, and does not depend on absolute developer paths.
    copy_tree(root + "/src/ui/host", output + "/native/host", 0) or >>
    templates := root + "/src/cmd/phone/templates/" + platform
    copy_tree(templates, ~output, 0) or >>
    renderer := root + "/src/ui/host/phone/canvas.html"
    copy_file(renderer, output + "/canvas.html") or >>
    // Identifiers are validated before they enter XML, Gradle or shell files.
    $files := ["build.sh"]
    if android { files.push("app/build.gradle")
        files.push("app/src/main/AndroidManifest.xml") }
    else { files.push("Info.plist") }
    for i in 0:files.len {
        path := output + "/" + files[i]
        body := os.read(~path) or >>
        expanded := strings.replace_all(&body, "@BUNDLE_ID@", ~bundle)
        final := strings.replace_all(&expanded, "@TARGET@", ~target)
        os.write(path, final) or >>
    }
    if xu_target_os() != 2 { os.chmod(output + "/build.sh", 493) or >> }
    if android { copy_file(output + "/canvas.html", output + "/app/src/main/assets/canvas.html") or >> }
    << 0
}

fn main() int {
    args := os.argv()
    $source := ""
    $target := ""
    $output := ""
    $bundle := "org.xulang.phoneapp"
    $i := 1
    if args.len > 1 && args[1] == "pack" { i = 2 }
    while i < args.len {
        arg := ~args[i]
        if arg == "--help" || arg == "-h" { help()
            << 0 }
        if arg == "--target" || arg == "-o" || arg == "--output" || arg == "--bundle-id" {
            if i + 1 >= args.len { eprintln("xu-phone: missing value for " + arg)
                << 1 }
            value := ~args[i + 1]
            if arg == "--target" { target = value }
            else if arg == "--bundle-id" { bundle = value }
            else { output = value }
            i += 2
        } else {
            if strings.has_prefix(&arg, "-") || source.len > 0 { eprintln("xu-phone: unexpected argument " + arg)
                << 1 }
            source = arg
            i += 1
        }
    }
    if source.len == 0 || target.len == 0 { help()
        << 1 }
    if output.len == 0 { output = "build/phone/" + target }
    absolute_source := filepath.abs(&source) or (err) { eprintln(err.msg())
        << 1 }
    absolute_output := filepath.abs(&output) or (err) { eprintln(err.msg())
        << 1 }
    generate(absolute_source, target, absolute_output, bundle) or (err) {
        eprintln("xu-phone: " + err.msg())
        << 1
    }
    << 0
}
