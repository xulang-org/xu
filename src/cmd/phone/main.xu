@main

#errors
#internal/toolpath
#os
#os/exec
#path/filepath
#strings

struct PackConfig {
    source string
    target string
    output string
    bundle string
    profile string
    app_name string
    app_version string
    version_code string
    orientation string
    icon string
    force bool
    internet bool
}

struct PackPlaceholders {
    bundle string
    target string
    app_name string
    app_version string
    version_code string
    permissions string
    android_icon_attr string
    android_orientation_attr string
    ios_icons string
    ios_orientations string
}

fn default_pack_config() PackConfig {
    << PackConfig{
        source: "", target: "", output: "", bundle: "org.xulang.phoneapp", profile: "ui",
        app_name: "", app_version: "0.1.0", version_code: "1", orientation: "auto",
        icon: "", force: false, internet: false
    }
}

fn help() {
    println("usage: xu-phone [pack|doctor|devices|run] ...")
    println("Subcommands:")
    println("  pack APP --target TARGET [-o DIR] [--bundle-id ID] [--app-name NAME] [--version VER] [--version-code N] [--orientation auto|portrait|landscape] [--icon PNG] [--force] [--internet]")
    println("  doctor [--strict]          check iOS/Android SDK, JDK, CMake and SDL3 prerequisites")
    println("  devices                    list available iOS Simulators and ADB devices")
    println("  run APP --target TARGET    package, build and install/launch on Simulator or Android device (--build-only to stop after build)")
    println("Targets: ios-arm64, ios-simulator-arm64, android-arm64")
    println("--phone-profile ui|game selects Canvas UI (default) or native SDL GPU.")
    println("--internet enables Android INTERNET/ACCESS_NETWORK_STATE permissions and bundles CA roots on iOS.")
}

fn run(program string, args []string) int {
    $cmd := exec.command(program)
    for i in 0:args.len { cmd.args.push(~args[i]) }
    cmd.run() >>>
    << 0
}

fn copy_file(source string, destination string) int {
    parent := filepath.dir(&destination)
    os.mkdir_all(parent) >>>
    body := os.read(source) >>>
    os.write(destination, body) >>>
    << 0
}

fn copy_tree(source string, destination string, depth int) int {
    $srcs := []string{}
    $dsts := []string{}
    $depths := []int{}
    srcs.push(source)
    dsts.push(destination)
    depths.push(depth)
    $head := 0
    while head < srcs.len {
        cur_src := ~srcs[head]
        cur_dst := ~dsts[head]
        cur_depth := depths[head]
        head += 1
        if cur_depth > 64 { >> errors.new("Phone host source directory nesting exceeds 64") }
        os.mkdir_all(~cur_dst) >>>
        entries := os.entries(~cur_src) >>>
        for i in 0:entries.len {
            child_source := cur_src + "/" + entries[i].name
            child_destination := cur_dst + "/" + entries[i].name
            if entries[i].is_dir {
                srcs.push(child_source)
                dsts.push(child_destination)
                depths.push(cur_depth + 1)
            } else {
                copy_file(child_source, child_destination) >>>
            }
        }
    }
    << 0
}

fn valid_id(id &string) bool {
    if id.len < 3 || id.len > 200 { << false }
    $segment := 0
    $dots := 0
    for i in 0:id.len {
        c := id[i]
        alpha := (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
        if c == 46 {
            if segment == 0 { << false }
            segment = 0
            dots += 1
        } else {
            if !alpha && !(segment > 0 && c >= 48 && c <= 57) { << false }
            segment += 1
        }
    }
    << segment > 0 && dots > 0
}

fn valid_app_name(name &string) bool {
    if name.len == 0 || name.len > 64 { << false }
    if name[0] == 32 || name[name.len - 1] == 32 { << false }
    for i in 0:name.len {
        c := name[i] & 255
        if c < 32 || c == 127 { << false }
        if c == 60 || c == 62 || c == 38 || c == 34 || c == 39 || c == 92 || c == 36 || c == 96 || c == 59 {
            << false
        }
    }
    << true
}

fn valid_version(ver &string) bool {
    if ver.len == 0 || ver.len > 32 { << false }
    for i in 0:ver.len {
        c := ver[i] & 255
        alnum := (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
        if i == 0 || i == ver.len - 1 {
            if !alnum { << false }
        } else if !alnum && c != 46 && c != 45 {
            << false
        }
    }
    << true
}

fn replace_placeholders(path string, p &PackPlaceholders) int {
    body := os.read(~path) >>>
    $s := strings.replace_all(&body, "@BUNDLE_ID@", ~p.bundle)
    s = strings.replace_all(&s, "@TARGET@", ~p.target)
    s = strings.replace_all(&s, "@APP_NAME@", ~p.app_name)
    s = strings.replace_all(&s, "@APP_VERSION@", ~p.app_version)
    s = strings.replace_all(&s, "@VERSION_CODE@", ~p.version_code)
    s = strings.replace_all(&s, "@ANDROID_PERMISSIONS@", ~p.permissions)
    s = strings.replace_all(&s, "@ANDROID_ICON_ATTR@", ~p.android_icon_attr)
    s = strings.replace_all(&s, "@ANDROID_ORIENTATION_ATTR@", ~p.android_orientation_attr)
    s = strings.replace_all(&s, "@IOS_ICONS@", ~p.ios_icons)
    s = strings.replace_all(&s, "@IOS_ORIENTATIONS@", ~p.ios_orientations)
    os.write(path, s) >>>
    << 0
}

fn try_remove_all(path string) {
    _ := os.remove_all(~path) >>> (cleanup) {
        eprintln(cleanup.msg())
        <<
    }
}

fn try_rename(src string, dst string) {
    _ := os.rename(~src, ~dst) >>> (err) {
        eprintln(err.msg())
        <<
    }
}

fn ignore_remove_all(path string) {
    _ := os.remove_all(~path) >>> (ignored) { << }
}

fn path_exists(path string) bool {
    if os.is_dir(path + "") { << true }
    _ := os.stat(path + "") >>> (err) { << false }
    << true
}

fn file_exists(path string) bool {
    if os.is_dir(path + "") { << false }
    _ := os.stat(path + "") >>> (err) { << false }
    << true
}

fn generate(cfg &PackConfig) int {
    if cfg.profile != "ui" && cfg.profile != "game" { >> errors.new("Phone profile must be ui or game") }
    if cfg.profile == "game" && cfg.target == "ios-simulator-arm64" { >> errors.new("SDL GPU does not support iOS Simulator; use ios-arm64 for the game profile")
    }
    if cfg.target != "ios-arm64" && cfg.target != "ios-simulator-arm64" && cfg.target != "android-arm64" { >> errors.new("unsupported Phone target: " + cfg.target)
    }
    if !valid_id(&cfg.bundle) { >> errors.new("bundle ID must contain dot-separated alphanumeric identifiers starting with letters") }
    if !valid_app_name(&cfg.app_name) { >> errors.new("invalid application name") }
    if !valid_version(&cfg.app_version) { >> errors.new("invalid application version") }
    if !valid_version_code(&cfg.version_code) { >> errors.new("invalid --version-code (must be an integer 1..2100000000)") }
    if !valid_orientation(&cfg.orientation) { >> errors.new("orientation must be auto, portrait, or landscape") }
    if cfg.icon.len > 0 && !valid_png_file(&cfg.icon) { >> errors.new("Phone --icon must be a readable PNG file") }
    if !os.is_dir(cfg.source + "") { >> errors.new("Phone input must be a module directory") }
    manifest := os.read(cfg.source + "/xu.xun") >>>
    if manifest.len == 0 { >> errors.new("application xu.xun is empty") }
    exists := path_exists(cfg.output + "")
    if exists && !cfg.force { >> errors.new("output already exists; choose a new directory: " + cfg.output)
    }
    staging := cfg.output + ".xu-phone-" + str(os.getpid())
    if path_exists(staging + "") { >> errors.new("staging directory already exists: " + staging)
    }
    generate_new(cfg, &staging) >>> (failure) {
        try_remove_all(~staging)
        >> failure
    }
    if exists {
        backup := cfg.output + ".xu-phone-old-" + str(os.getpid())
        ignore_remove_all(~backup)
        os.rename(~cfg.output, ~backup) >>> (failure) {
            try_remove_all(~staging)
            >> failure
        }
        os.rename(~staging, ~cfg.output) >>> (failure) {
            try_rename(~backup, ~cfg.output)
            try_remove_all(~staging)
            >> failure
        }
        try_remove_all(~backup)
    } else {
        os.rename(~staging, ~cfg.output) >>> (failure) {
            try_remove_all(~staging)
            >> failure
        }
    }
    println("Phone project generated: " + cfg.output)
    println("Build: " + cfg.output + "/build.sh")
    << 0
}

fn generate_new(cfg &PackConfig, output &string) int {
    compiler_name := "xu"
    compiler := toolpath.sibling(&compiler_name) >>>
    if compiler.len == 0 { >> errors.new("missing sibling xu compiler") }
    $root := os.getenv("XU_ROOT")
    if root.len == 0 {
        bin := filepath.dir(&compiler)
        root = filepath.dir(&bin)
    }
    if !os.is_dir(root + "/src/ui/host/phone") { >> errors.new("full Phone SDK sources required; set XU_ROOT") }
    android := cfg.target == "android-arm64"
    $native_target := "macos-arm64"
    $convert := "_ios_o"
    if cfg.target == "ios-simulator-arm64" { convert = "_ios_sim_o" }
    $platform := "ios"
    if android { native_target = "linux-arm64"
        convert = "_elf_o"
        platform = "android" }
    os.mkdir_all(*output + "/native") >>>
    object := *output + "/native/app.xuobj"
    env_cmd := find_env_cmd()
    $compile := exec.command(~env_cmd, "XU_PHONE_NATIVE_TARGET=" + cfg.target, ~compiler, "build", ~cfg.source, "--target", native_target,
        "--_phone-object", "-o", ~object)
    if android { compile.args.push("--chip")
        compile.args.push("cortex-a53") }
    compile.run() >>>
    if cfg.profile == "ui" {
        if os.is_dir(object + ".native") { >> errors.new("Phone native imports require --phone-profile game")
        }
        obj_bytes := os.read(~object) >>>
        if strings.contains(&obj_bytes, "xu_phone_game_is_hosted") ||
           strings.contains(&obj_bytes, "xu_phone_game_next_frame") ||
           strings.contains(&obj_bytes, "xu_phone_sdl_sym") { >> errors.new("Phone game modules (#app/#window/#gpu) and native imports require --phone-profile game")
        }
    }
    run(~compiler, [convert, object, *output + "/native/app.o"]) >>>
    // Copy the host closure so the generated project remains independent of
    // this SDK checkout, and does not depend on absolute developer paths.
    copy_tree(root + "/src/ui/host", *output + "/native/host", 0) >>>
    $permissions := ""
    if cfg.internet {
        permissions = "\n<uses-permission android:name=\"android.permission.INTERNET\"/>\n<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>"
    }
    placeholders := PackPlaceholders{
        bundle: cfg.bundle + "",
        target: cfg.target + "",
        app_name: cfg.app_name + "",
        app_version: cfg.app_version + "",
        version_code: cfg.version_code + "",
        permissions: permissions,
        android_icon_attr: android_icon_attr(&cfg.icon),
        android_orientation_attr: android_orientation_attr(&cfg.orientation),
        ios_icons: ios_icons_xml(&cfg.icon),
        ios_orientations: ios_orientations_xml(&cfg.orientation)
    }
    if cfg.profile == "game" {
        generate_game(&root, cfg, output, &platform, &placeholders) >>>
        pack_icons(&cfg.icon, output, android, &cfg.profile) >>>
        pack_game_resources(&cfg.source, output) >>>
        << 0
    }
    templates := root + "/src/cmd/phone/templates/" + platform
    copy_tree(templates, ~*output, 0) >>>
    renderer := root + "/src/ui/host/phone/canvas.html"
    copy_file(renderer, *output + "/canvas.html") >>>
    if cfg.internet && !android {
        if file_exists(cfg.source + "/ca-bundle.pem") {
            copy_file(cfg.source + "/ca-bundle.pem", *output + "/ca-bundle.pem") >>>
        } else if file_exists("/etc/ssl/cert.pem") {
            copy_file("/etc/ssl/cert.pem", *output + "/ca-bundle.pem") >>>
        }
    }
    // Identifiers are validated before they enter XML, Gradle or shell files.
    $files := ["build.sh"]
    if android { files.push("app/build.gradle")
        files.push("app/src/main/AndroidManifest.xml") }
    else { files.push("Info.plist") }
    for i in 0:files.len {
        replace_placeholders(*output + "/" + files[i], &placeholders) >>>
    }
    if xu_target_os() != 2 { os.chmod(*output + "/build.sh", 493) >>> }
    pack_icons(&cfg.icon, output, android, &cfg.profile) >>>
    pack_game_resources(&cfg.source, output) >>>
    if android {
        copy_file(*output + "/canvas.html", *output + "/app/src/main/assets/canvas.html") >>>
        if os.is_dir(*output + "/resources") {
            copy_tree(*output + "/resources", *output + "/app/src/main/assets/resources", 0) >>>
        }
    }
    << 0
}

fn main() int {
    args := os.argv()
    if args.len > 1 {
        if args[1] == "doctor" { << cmd_doctor(&args) }
        if args[1] == "devices" { << cmd_devices() }
        if args[1] == "run" { << cmd_run(&args) }
    }
    $cfg := default_pack_config()
    $output := ""
    $i := 1
    if args.len > 1 && args[1] == "pack" { i = 2 }
    while i < args.len {
        arg := ~args[i]
        if arg == "--help" || arg == "-h" { help()
            << 0 }
        if arg == "--force" {
            cfg.force = true
            i += 1
        } else if arg == "--internet" {
            cfg.internet = true
            i += 1
        } else if arg == "--target" || arg == "-o" || arg == "--output" || arg == "--bundle-id" ||
                  arg == "--phone-profile" || arg == "--app-name" || arg == "--version" ||
                  arg == "--app-version" || arg == "--version-code" || arg == "--orientation" || arg == "--icon" {
            if i + 1 >= args.len { eprintln("xu-phone: missing value for " + arg)
                << 1 }
            value := ~args[i + 1]
            if arg == "--target" { cfg.target = value }
            else if arg == "--bundle-id" { cfg.bundle = value }
            else if arg == "--phone-profile" { cfg.profile = value }
            else if arg == "--app-name" { cfg.app_name = value }
            else if arg == "--version" || arg == "--app-version" { cfg.app_version = value }
            else if arg == "--version-code" { cfg.version_code = value }
            else if arg == "--orientation" { cfg.orientation = value }
            else if arg == "--icon" { cfg.icon = value }
            else { output = value }
            i += 2
        } else {
            if strings.has_prefix(&arg, "-") || cfg.source.len > 0 { eprintln("xu-phone: unexpected argument " + arg)
                << 1 }
            cfg.source = arg
            i += 1
        }
    }
    if cfg.source.len == 0 || cfg.target.len == 0 { help()
        << 1 }
    if cfg.app_name.len == 0 {
        if cfg.profile == "game" { cfg.app_name = "XuPhoneGame" }
        else { cfg.app_name = "XuPhone" }
    }
    if output.len == 0 { output = "build/phone/" + cfg.target }
    cfg.source = filepath.abs(&cfg.source) >>> (err) { eprintln(err.msg())
        << 1 }
    cfg.output = filepath.abs(&output) >>> (err) { eprintln(err.msg())
        << 1 }
    generate(&cfg) >>> (err) {
        eprintln("xu-phone: " + err.msg())
        << 1
    }
    << 0
}
