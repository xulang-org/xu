@main

#errors
#internal/toolpath
#os
#os/exec
#path/filepath
#strings

fn help() {
    println("usage: xu-phone pack APP --target TARGET [-o DIRECTORY] [--bundle-id ID]")
    println("Generate an application project with compiled native Xu code.")
    println("Targets: ios-arm64, ios-simulator-arm64, android-arm64")
    println("Build the generated project with its build.sh script or platform IDE.")
    println("--phone-profile ui|game selects Canvas UI (default) or native SDL GPU.")
}

fn run(program string, args []string) int {
    $cmd := exec.command(program)
    for i in 0:args.len { cmd.args.push(~args[i]) }
    cmd.run() >>>
    << 0
}

fn copy_file(source string, destination string) int {
    parent := filepath.dir(&destination)
    os.mkdir_all(parent) >>>
    body := os.read(source) >>>
    os.write(destination, body) >>>
    << 0
}

fn copy_tree(source string, destination string, depth int) int {
    $srcs := []string{}
    $dsts := []string{}
    $depths := []int{}
    srcs.push(source)
    dsts.push(destination)
    depths.push(depth)
    $head := 0
    while head < srcs.len {
        cur_src := ~srcs[head]
        cur_dst := ~dsts[head]
        cur_depth := depths[head]
        head += 1
        if cur_depth > 64 { >>> errors.new("Phone host source directory nesting exceeds 64") }
        os.mkdir_all(~cur_dst) >>>
        entries := os.entries(~cur_src) >>>
        for i in 0:entries.len {
            child_source := cur_src + "/" + entries[i].name
            child_destination := cur_dst + "/" + entries[i].name
            if entries[i].is_dir {
                srcs.push(child_source)
                dsts.push(child_destination)
                depths.push(cur_depth + 1)
            } else {
                copy_file(child_source, child_destination) >>>
            }
        }
    }
    << 0
}

fn valid_id(id &string) bool {
    if id.len < 3 || id.len > 200 { << false }
    $segment := 0
    $dots := 0
    for i in 0:id.len {
        c := id[i]
        alpha := (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
        if c == 46 {
            if segment == 0 { << false }
            segment = 0
            dots += 1
        } else {
            if !alpha && !(segment > 0 && c >= 48 && c <= 57) { << false }
            segment += 1
        }
    }
    << segment > 0 && dots > 0
}

fn generate(source string, target string, output string, bundle string, profile string) int {
    if profile != "ui" && profile != "game" { >>> errors.new("Phone profile must be ui or game") }
    if profile == "game" && target == "ios-simulator-arm64" {
        >>> errors.new("SDL GPU does not support iOS Simulator; use ios-arm64 for the game profile")
    }
    if target != "ios-arm64" && target != "ios-simulator-arm64" && target != "android-arm64" {
        >>> errors.new("unsupported Phone target: " + target)
    }
    if !valid_id(&bundle) { >>> errors.new("bundle ID must contain dot-separated alphanumeric identifiers starting with letters") }
    if !os.is_dir(source + "") { >>> errors.new("Phone input must be a module directory") }
    manifest := os.read(source + "/xu.xun") >>>
    if manifest.len == 0 { >>> errors.new("application xu.xun is empty") }
    os.stat(output + "") >>> (err) {
        staging := output + ".xu-phone-" + str(os.getpid())
        os.stat(staging + "") >>> (missing) {
            generate_new(~source, ~target, ~staging, ~bundle, ~profile) >>> (failure) {
                os.remove_all(~staging) >>> (cleanup) { eprintln(cleanup.msg()) }
                >>> failure
            }
            os.rename(~staging, ~output) >>> (failure) {
                os.remove_all(~staging) >>> (cleanup) { eprintln(cleanup.msg()) }
                >>> failure
            }
            println("Phone project generated: " + output)
            println("Build: " + output + "/build.sh")
            << 0
        }
        >>> errors.new("staging directory already exists: " + staging)
    }
    >>> errors.new("output already exists; choose a new directory: " + output)
}

fn generate_new(source string, target string, output string, bundle string, profile string) int {
    compiler_name := "xu"
    compiler := toolpath.sibling(&compiler_name) >>>
    if compiler.len == 0 { >>> errors.new("missing sibling xu compiler") }
    $root := os.getenv("XU_ROOT")
    if root.len == 0 {
        bin := filepath.dir(&compiler)
        root = filepath.dir(&bin)
    }
    if !os.is_dir(root + "/src/ui/host/phone") { >>> errors.new("full Phone SDK sources required; set XU_ROOT") }
    android := target == "android-arm64"
    $native_target := "macos-arm64"
    $convert := "_ios_o"
    if target == "ios-simulator-arm64" { convert = "_ios_sim_o" }
    $platform := "ios"
    if android { native_target = "linux-arm64"
        convert = "_elf_o"
        platform = "android" }
    os.mkdir_all(output + "/native") >>>
    object := output + "/native/app.xuobj"
    $env_cmd := "env"
    if xu_target_os() != 2 {
        candidates := ["/usr/bin/env", "/bin/env"]
        for ci in 0:candidates.len {
            cand := candidates[ci] + ""
            if os.is_dir(cand + "") { -> }
            os.stat(cand + "") >>> (err) { -> }
            env_cmd = ~cand
            <-
        }
    }
    $compile := exec.command(~env_cmd, "XU_PHONE_NATIVE_TARGET=" + target, ~compiler, "build", ~source, "--target", native_target,
        "--_phone-object", "-o", ~object)
    if android { compile.args.push("--chip")
        compile.args.push("cortex-a53") }
    compile.run() >>>
    if profile == "ui" && os.is_dir(object + ".native") {
        >>> errors.new("Phone native imports require --phone-profile game")
    }
    run(~compiler, [convert, object, output + "/native/app.o"]) >>>
    // Copy the host closure so the generated project remains independent of
    // this SDK checkout, and does not depend on absolute developer paths.
    copy_tree(root + "/src/ui/host", output + "/native/host", 0) >>>
    if profile == "game" {
        generate_game(&root, &platform, &target, &output, &bundle) >>>
        pack_game_resources(&source, &output) >>>
        << 0
    }
    templates := root + "/src/cmd/phone/templates/" + platform
    copy_tree(templates, ~output, 0) >>>
    renderer := root + "/src/ui/host/phone/canvas.html"
    copy_file(renderer, output + "/canvas.html") >>>
    // Identifiers are validated before they enter XML, Gradle or shell files.
    $files := ["build.sh"]
    if android { files.push("app/build.gradle")
        files.push("app/src/main/AndroidManifest.xml") }
    else { files.push("Info.plist") }
    for i in 0:files.len {
        path := output + "/" + files[i]
        body := os.read(~path) >>>
        expanded := strings.replace_all(&body, "@BUNDLE_ID@", ~bundle)
        final := strings.replace_all(&expanded, "@TARGET@", ~target)
        os.write(path, final) >>>
    }
    if xu_target_os() != 2 { os.chmod(output + "/build.sh", 493) >>> }
    if android { copy_file(output + "/canvas.html", output + "/app/src/main/assets/canvas.html") >>> }
    << 0
}

fn main() int {
    args := os.argv()
    $source := ""
    $target := ""
    $output := ""
    $bundle := "org.xulang.phoneapp"
    $profile := "ui"
    $i := 1
    if args.len > 1 && args[1] == "pack" { i = 2 }
    while i < args.len {
        arg := ~args[i]
        if arg == "--help" || arg == "-h" { help()
            << 0 }
        if arg == "--target" || arg == "-o" || arg == "--output" || arg == "--bundle-id" || arg == "--phone-profile" {
            if i + 1 >= args.len { eprintln("xu-phone: missing value for " + arg)
                << 1 }
            value := ~args[i + 1]
            if arg == "--target" { target = value }
            else if arg == "--bundle-id" { bundle = value }
            else if arg == "--phone-profile" { profile = value }
            else { output = value }
            i += 2
        } else {
            if strings.has_prefix(&arg, "-") || source.len > 0 { eprintln("xu-phone: unexpected argument " + arg)
                << 1 }
            source = arg
            i += 1
        }
    }
    if source.len == 0 || target.len == 0 { help()
        << 1 }
    if output.len == 0 { output = "build/phone/" + target }
    absolute_source := filepath.abs(&source) >>> (err) { eprintln(err.msg())
        << 1 }
    absolute_output := filepath.abs(&output) >>> (err) { eprintln(err.msg())
        << 1 }
    generate(absolute_source, target, absolute_output, bundle, profile) >>> (err) {
        eprintln("xu-phone: " + err.msg())
        << 1
    }
    << 0
}
