@main

#errors
#os
#os/exec
#strings

// Archive this exact upstream revision, never mutable worktree files or a
// network-selected dependency. The generated project builds entirely offline.
const GAME_SDL_REVISION = "147a8ee32dbf9ac02f3794964490687b6bbda1bc"

fn has_sdl_define(body &string, name string, expected string) bool {
    lines := strings.split(body, "\n")
    for line in lines {
        trimmed := strings.trim_space(&line)
        if !strings.has_prefix(&trimmed, "#define") { -> }
        rest := strings.trim_space(&trimmed[7:trimmed.len])
        if !strings.has_prefix(&rest, ~name) { -> }
        if rest.len <= name.len { -> }
        sep := rest[name.len] & 255
        if sep != 32 && sep != 9 { -> }
        val := strings.trim_space(&rest[name.len:rest.len])
        if val == expected { << true }
    }
    << false
}

fn copy_sdl_tree(source string, destination string) int {
    $srcs := []string{}
    $dsts := []string{}
    $depths := []int{}
    srcs.push(source)
    dsts.push(destination)
    depths.push(0)
    $head := 0
    while head < srcs.len {
        cur_src := ~srcs[head]
        cur_dst := ~dsts[head]
        cur_depth := depths[head]
        head += 1
        if cur_depth > 64 { >>> errors.new("SDL source directory nesting exceeds 64") }
        os.mkdir_all(~cur_dst) >>>
        entries := os.entries(~cur_src) >>>
        for i in 0:entries.len {
            name := entries[i].name + ""
            if name == ".git" || name == ".github" { -> }
            if cur_depth == 0 && name == "build" { -> }
            child_source := cur_src + "/" + name
            child_destination := cur_dst + "/" + name
            if entries[i].is_dir {
                srcs.push(child_source)
                dsts.push(child_destination)
                depths.push(cur_depth + 1)
            } else {
                copy_file(child_source, child_destination) >>>
            }
        }
    }
    << 0
}

fn is_git_source(source &string) bool {
    git_path := *source + "/.git"
    if os.is_dir(git_path + "") { << true }
    _ := os.stat(git_path + "") >>> (err) { << false }
    << true
}

fn generate_game(root &string, cfg &PackConfig, output &string, platform &string, placeholders &PackPlaceholders) int {
    source := os.getenv("XU_PHONE_SDL_SOURCE")
    if source.len == 0 { >>> errors.new("game profile requires XU_PHONE_SDL_SOURCE at SDL release-3.4.14 (" + GAME_SDL_REVISION + ")") }
    if is_git_source(&source) {
        probe := exec.command("git", "-C", source + "", "rev-parse", "HEAD")
        revision_text := probe.output() >>>
        revision := strings.trim_space(&revision_text)
        if revision != GAME_SDL_REVISION { >>> errors.new("game profile requires the locked SDL release-3.4.14 revision") }
        archive := *output + "/native/SDL.tar"
        run("git", ["-C", source + "", "archive", "--format=tar", "--output=" + archive, GAME_SDL_REVISION]) >>>
        os.mkdir_all(*output + "/native/SDL") >>>
        run("tar", ["-xf", archive + "", "-C", *output + "/native/SDL"]) >>>
        os.remove(archive) >>>
        os.write(*output + "/native/SDL.revision", GAME_SDL_REVISION + "\n") >>>
    } else {
        cm_info := os.stat(source + "/CMakeLists.txt") >>> (err) { >>> errors.new("game profile requires XU_PHONE_SDL_SOURCE at SDL release-3.4.14 (" + GAME_SDL_REVISION + ")")
        }
        if cm_info.is_dir { >>> errors.new("game profile requires XU_PHONE_SDL_SOURCE at SDL release-3.4.14 (" + GAME_SDL_REVISION + ")")
        }
        ver_hdr := os.read(source + "/include/SDL3/SDL_version.h") >>> (err) { >>> errors.new("game profile requires XU_PHONE_SDL_SOURCE at SDL release-3.4.14 (" + GAME_SDL_REVISION + ")")
        }
        if !has_sdl_define(&ver_hdr, "SDL_MAJOR_VERSION", "3") ||
           !has_sdl_define(&ver_hdr, "SDL_MINOR_VERSION", "4") ||
           !has_sdl_define(&ver_hdr, "SDL_MICRO_VERSION", "14") { >>> errors.new("game profile requires the locked SDL release-3.4.14 revision")
        }
        copy_sdl_tree(source + "", *output + "/native/SDL") >>>
        os.write(*output + "/native/SDL.revision", "release-3.4.14\n") >>>
    }
    copy_tree(*root + "/src/cmd/phone/templates/game/common", *output + "", 0) >>>
    copy_tree(*root + "/src/cmd/phone/templates/game/" + *platform, *output + "", 0) >>>
    $files := ["build.sh", "resources.h"]
    if *platform == "ios" { files.push("Info.plist") }
    else { files.push("AndroidManifest.xml") }
    for path in files {
        replace_placeholders(*output + "/" + path, placeholders) >>>
    }
    if cfg.internet && *platform == "ios" {
        if file_exists(cfg.source + "/ca-bundle.pem") {
            copy_file(cfg.source + "/ca-bundle.pem", *output + "/ca-bundle.pem") >>>
        } else if file_exists("/etc/ssl/cert.pem") {
            copy_file("/etc/ssl/cert.pem", *output + "/ca-bundle.pem") >>>
        }
    }
    if xu_target_os() != 2 { os.chmod(*output + "/build.sh", 493) >>> }
    << 0
}
