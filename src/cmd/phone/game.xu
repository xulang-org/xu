@main

#errors
#os
#os/exec
#strings

// Archive this exact upstream revision, never mutable worktree files or a
// network-selected dependency. The generated project builds entirely offline.
const GAME_SDL_REVISION = "147a8ee32dbf9ac02f3794964490687b6bbda1bc"

fn generate_game(root &string, platform &string, target &string, output &string, bundle &string) int {
    source := os.getenv("XU_PHONE_SDL_SOURCE")
    if source.len == 0 { >> errors.new("game profile requires XU_PHONE_SDL_SOURCE at SDL release-3.4.14 (" + GAME_SDL_REVISION + ")") }
    probe := exec.command("git", "-C", source + "", "rev-parse", "HEAD")
    revision_text := probe.output() or >>
    revision := strings.trim_space(&revision_text)
    if revision != GAME_SDL_REVISION { >> errors.new("game profile requires the locked SDL release-3.4.14 revision") }
    archive := output + "/native/SDL.tar"
    run("git", ["-C", source, "archive", "--format=tar", "--output=" + archive, GAME_SDL_REVISION]) or >>
    os.mkdir_all(output + "/native/SDL") or >>
    run("tar", ["-xf", archive + "", "-C", output + "/native/SDL"]) or >>
    os.remove(archive) or >>
    os.write(output + "/native/SDL.revision", GAME_SDL_REVISION + "\n") or >>
    copy_tree(root + "/src/cmd/phone/templates/game/common", output + "", 0) or >>
    copy_tree(root + "/src/cmd/phone/templates/game/" + platform, output + "", 0) or >>
    $files := ["build.sh"]
    if *platform == "ios" { files.push("Info.plist") }
    else { files.push("AndroidManifest.xml") }
    for path in files {
        file := output + "/" + path
        text := os.read(file + "") or >>
        expanded := strings.replace_all(&text, "@BUNDLE_ID@", bundle + "")
        final := strings.replace_all(&expanded, "@TARGET@", target + "")
        os.write(file, final) or >>
    }
    if xu_target_os() != 2 { os.chmod(output + "/build.sh", 493) or >> }
    << 0
}
