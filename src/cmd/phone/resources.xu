@main

#os
#strings
#path/filepath
#errors

fn read_resource(path string, limit int) string {
    $file := os.open(path) >>>
    $builder := strings.new_byte_builder(4096)
    $count := 0
    while count <= limit {
        $request := limit + 1 - count
        if request > 65536 { request = 65536 }
        chunk := file.read(request) >>>
        if chunk.len == 0 { <- }
        count += chunk.len
        if count > limit { >> errors.new("Phone resource exceeds byte limit") }
        builder.write_str(chunk)
    }
    file.close() >>>
    << builder.to_string()
}
fn resource_manifest(path string) string {
    body := read_resource(path, 65536) >>> (err) {
        if os.is_not_exist(err.msg()) { << "" }
        >> err
    }
    << body
}
// phone.resources explicitly lists files relative to the application module.
fn pack_game_resources(source &string, output &string) int {
    os.mkdir_all(output + "/resources") >>>
    $index := ""
    $total := 0
    $count := 0
    manifest := source + "/phone.resources"
    body := resource_manifest(manifest) >>>
    if body.len > 0 {
        lines := strings.split(&body, "\n")
        $seen := []string{}
        for line in lines {
            path := strings.trim_space(&line)
            if path.len == 0 { -> }
            if path.len > 240 || path == "resources.index" { >> errors.new("invalid Phone resource path") }
            for previous in seen { if previous == path { >> errors.new("duplicate Phone resource: " + path) } }
            parts := strings.split(&path, "/")
            for part in parts {
                if part.len == 0 || part == "." || part == ".." { >> errors.new("invalid Phone resource segment") }
                for i in 0:part.len {
                    c := part[i]
                    if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 95 || c == 46) {
                        >> errors.new("Phone resource path is not portable ASCII: " + path)
                    }
                }
            }
            count += 1
            if count > 256 { >> errors.new("Phone resource file limit is 256") }
            data := read_resource(source + "/" + path, 16777216) >>>
            total += data.len
            if total > 67108864 { >> errors.new("Phone resources exceed 64 MiB") }
            destination := output + "/resources/" + path
            parent := filepath.dir(&destination)
            os.mkdir_all(parent) >>>
            os.write(destination + "", data) >>>
            os.chmod(destination, 420) >>>
            index = index + path + "\n"
            seen.push(path)
        }
    }
    os.write(output + "/resources/resources.index", index) >>>
    os.chmod(output + "/resources/resources.index", 420) >>>
    << 0
}
