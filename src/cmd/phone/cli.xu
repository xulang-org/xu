@main

#errors
#internal/toolpath
#os
#os/exec
#path/filepath
#strings

fn find_env_cmd() string {
    if xu_target_os() != 2 {
        candidates := ["/usr/bin/env", "/bin/env"]
        for ci in 0:candidates.len {
            cand := candidates[ci] + ""
            if os.is_dir(cand + "") { -> }
            _ := os.stat(cand + "") >>> (err) { -> }
            << cand
        }
    }
    << "env"
}

fn detect_android_sdk() string {
    env_home := os.getenv("ANDROID_HOME")
    if env_home.len > 0 && os.is_dir(env_home + "") { << env_home }
    env_root := os.getenv("ANDROID_SDK_ROOT")
    if env_root.len > 0 && os.is_dir(env_root + "") { << env_root }
    home := os.getenv("HOME")
    if home.len > 0 {
        cands := [home + "/Library/Android/sdk", home + "/Android/Sdk"]
        for i in 0:cands.len {
            if os.is_dir(cands[i] + "") { << cands[i] + "" }
        }
    }
    << ""
}

fn detect_java_home() string {
    env_java := os.getenv("JAVA_HOME")
    if env_java.len > 0 && file_exists(env_java + "/bin/javac") { << env_java }
    cands := ["/opt/homebrew/opt/openjdk@17", "/opt/homebrew/opt/openjdk", "/usr/lib/jvm/java-17-openjdk-amd64"]
    for i in 0:cands.len {
        if file_exists(cands[i] + "/bin/javac") { << cands[i] + "" }
    }
    << ""
}

fn detect_adb(sdk &string) string {
    if sdk.len > 0 && file_exists(*sdk + "/platform-tools/adb") {
        << *sdk + "/platform-tools/adb"
    }
    << "adb"
}

fn probe_command(program string, args []string) string {
    $cmd := exec.command(program)
    for i in 0:args.len { cmd.args.push(~args[i]) }
    out := cmd.output() >>> (err) { << "" }
    << strings.trim_space(&out)
}

fn doctor_line(status string, label string, detail string) {
    println("[" + status + "] " + label + ": " + detail)
}

fn find_sibling_compiler() string {
    compiler_name := "xu"
    compiler := toolpath.sibling(&compiler_name) >>> (err) { << "" }
    << compiler
}

fn cmd_doctor(args &[]string) int {
    $strict := false
    for i in 2:args.len {
        if args[i] == "--strict" { strict = true }
        else if args[i] == "-h" || args[i] == "--help" {
            println("usage: xu phone doctor [--strict]")
            << 0
        } else {
            eprintln("xu phone doctor: unknown option " + args[i])
            << 1
        }
    }
    println("Xu Phone Toolchain Doctor")
    println("Targets: ios-arm64, ios-simulator-arm64, android-arm64 (android-x64: not yet supported; ARM64 phone runtime/codegen only)")

    $missing := 0
    compiler := find_sibling_compiler()
    $root := os.getenv("XU_ROOT")
    if root.len == 0 && compiler.len > 0 {
        bin := filepath.dir(&compiler)
        root = filepath.dir(&bin)
    }
    if compiler.len > 0 && file_exists(compiler + "") {
        doctor_line("ok", "Compiler", compiler)
    } else {
        doctor_line("missing", "Compiler", "sibling xu binary not found")
        missing += 1
    }
    if root.len > 0 && os.is_dir(root + "/src/ui/host/phone") {
        doctor_line("ok", "Phone SDK", root + "/src/ui/host/phone")
    } else {
        doctor_line("missing", "Phone SDK", "set XU_ROOT to a checkout with src/ui/host/phone")
        missing += 1
    }

    if xu_target_os() == 0 {
        ios_sdk := probe_command("xcrun", ["--sdk", "iphoneos", "--show-sdk-path"])
        if ios_sdk.len > 0 { doctor_line("ok", "iOS Device SDK", ios_sdk) }
        else {
            doctor_line("missing", "iOS Device SDK", "Xcode iphoneos SDK unavailable")
            missing += 1
        }
        sim_sdk := probe_command("xcrun", ["--sdk", "iphonesimulator", "--show-sdk-path"])
        if sim_sdk.len > 0 { doctor_line("ok", "iOS Simulator SDK", sim_sdk) }
        else {
            doctor_line("missing", "iOS Simulator SDK", "Xcode iphonesimulator SDK unavailable")
            missing += 1
        }
        if file_exists("/usr/bin/sips") {
            doctor_line("ok", "Icon Slicer", "/usr/bin/sips")
        } else {
            doctor_line("warn", "Icon Slicer", "/usr/bin/sips unavailable (icons copy raw PNG)")
        }
    } else {
        doctor_line("warn", "iOS SDK", "requires macOS + Xcode")
    }

    sdk := detect_android_sdk()
    if sdk.len > 0 {
        doctor_line("ok", "Android SDK", sdk)
        jar := sdk + "/platforms/android-35/android.jar"
        aapt2 := sdk + "/build-tools/35.0.0/aapt2"
        ndk := sdk + "/ndk/27.2.12479018/build/cmake/android.toolchain.cmake"
        cmake := sdk + "/cmake/3.22.1/bin/cmake"
        if file_exists(jar + "") && file_exists(aapt2 + "") && file_exists(ndk + "") && file_exists(cmake + "") {
            doctor_line("ok", "Android Build Stack", "platform-35, build-tools 35.0.0, NDK 27.2.12479018, CMake 3.22.1")
        } else {
            doctor_line("missing", "Android Build Stack", "need platforms;android-35, build-tools;35.0.0, ndk;27.2.12479018, cmake;3.22.1")
            missing += 1
        }
    } else {
        doctor_line("missing", "Android SDK", "set ANDROID_HOME or ANDROID_SDK_ROOT")
        missing += 1
    }

    jhome := detect_java_home()
    if jhome.len > 0 { doctor_line("ok", "JDK 17+", jhome) }
    else if probe_command("javac", ["-version"]).len > 0 { doctor_line("ok", "JDK (PATH)", "javac available on PATH") }
    else {
        doctor_line("missing", "JDK 17+", "set JAVA_HOME")
        missing += 1
    }

    sdl_src := os.getenv("XU_PHONE_SDL_SOURCE")
    if sdl_src.len > 0 && os.is_dir(sdl_src + "") {
        doctor_line("ok", "Game SDL3 Source", sdl_src)
    } else {
        doctor_line("warn", "Game SDL3 Source", "set XU_PHONE_SDL_SOURCE (required only for --phone-profile game)")
    }
    if strict && missing > 0 { << 1 }
    << 0
}

fn cmd_devices() int {
    println("Available Mobile Targets & Devices")
    if xu_target_os() == 0 {
        println("")
        println("iOS Simulators (xcrun simctl):")
        $cmd := exec.command("xcrun", "simctl", "list", "devices", "available")
        out := cmd.output() >>> (err) {
            println("  (unavailable: " + err.msg() + ")")
            << 0
        }
        lines := strings.split(&out, "\n")
        $shown := 0
        for line in lines {
            trimmed := strings.trim_space(&line)
            if trimmed.len == 0 || strings.has_prefix(&trimmed, "==") { -> }
            if strings.has_prefix(&trimmed, "-- iOS") || strings.contains(&trimmed, "iPhone") || strings.contains(&trimmed, "iPad") {
                println("  " + trimmed)
                shown += 1
            }
        }
        if shown == 0 { println("  (none)") }
    }
    println("")
    println("Android Devices (adb):")
    sdk := detect_android_sdk()
    adb := detect_adb(&sdk)
    $acmd := exec.command(~adb, "devices", "-l")
    aout := acmd.output() >>> (err) {
        println("  (adb unavailable: " + err.msg() + ")")
        << 0
    }
    println(strings.trim_space(&aout))
    << 0
}

fn run_help() {
    println("usage: xu phone run APP --target TARGET [-o DIR] [--bundle-id ID] [--app-name NAME] [--version VER] [--version-code N] [--orientation auto|portrait|landscape] [--icon PNG] [--phone-profile ui|game] [--internet] [--build-only] [--device ID]")
}

fn cmd_run(args &[]string) int {
    $cfg := default_pack_config()
    cfg.force = true
    $output := ""
    $build_only := false
    $device := ""
    $i := 2
    while i < args.len {
        arg := ~args[i]
        if arg == "--help" || arg == "-h" {
            run_help()
            << 0
        } else if arg == "--build-only" {
            build_only = true
            i += 1
        } else if arg == "--device" {
            if i + 1 >= args.len { eprintln("xu phone run: missing value for --device")
                << 1 }
            device = ~args[i + 1]
            i += 2
        } else if arg == "--force" {
            cfg.force = true
            i += 1
        } else if arg == "--internet" {
            cfg.internet = true
            i += 1
        } else if arg == "--target" || arg == "-o" || arg == "--output" || arg == "--bundle-id" ||
                  arg == "--phone-profile" || arg == "--app-name" || arg == "--version" ||
                  arg == "--app-version" || arg == "--version-code" || arg == "--orientation" || arg == "--icon" {
            if i + 1 >= args.len { eprintln("xu phone run: missing value for " + arg)
                << 1 }
            val := ~args[i + 1]
            if arg == "--target" { cfg.target = val }
            else if arg == "--bundle-id" { cfg.bundle = val }
            else if arg == "--phone-profile" { cfg.profile = val }
            else if arg == "--app-name" { cfg.app_name = val }
            else if arg == "--version" || arg == "--app-version" { cfg.app_version = val }
            else if arg == "--version-code" { cfg.version_code = val }
            else if arg == "--orientation" { cfg.orientation = val }
            else if arg == "--icon" { cfg.icon = val }
            else { output = val }
            i += 2
        } else {
            if strings.has_prefix(&arg, "-") || cfg.source.len > 0 {
                eprintln("xu phone run: unexpected argument " + arg)
                << 1
            }
            cfg.source = arg
            i += 1
        }
    }
    if cfg.source.len == 0 || cfg.target.len == 0 {
        run_help()
        << 1
    }
    if cfg.app_name.len == 0 {
        if cfg.profile == "game" { cfg.app_name = "XuPhoneGame" }
        else { cfg.app_name = "XuPhone" }
    }
    if output.len == 0 { output = "build/phone/" + cfg.target }
    cfg.source = filepath.abs(&cfg.source) >>> (err) { eprintln(err.msg())
        << 1 }
    cfg.output = filepath.abs(&output) >>> (err) { eprintln(err.msg())
        << 1 }
    generate(&cfg) >>> (err) {
        eprintln("xu phone run: " + err.msg())
        << 1
    }
    env_cmd := find_env_cmd()
    android := cfg.target == "android-arm64"
    $sdk := ""
    if android {
        sdk = detect_android_sdk()
        jhome := detect_java_home()
        $bcmd := exec.command(~env_cmd)
        if sdk.len > 0 {
            bcmd.args.push("ANDROID_HOME=" + sdk)
            bcmd.args.push("ANDROID_SDK_ROOT=" + sdk)
        }
        if jhome.len > 0 { bcmd.args.push("JAVA_HOME=" + jhome) }
        bcmd.args.push("sh")
        bcmd.args.push(cfg.output + "/build.sh")
        bcmd.run() >>> (err) { eprintln("xu phone run build failed: " + err.msg())
            << 1 }
    } else {
        run("sh", [cfg.output + "/build.sh"]) >>> (err) {
            eprintln("xu phone run build failed: " + err.msg())
            << 1
        }
    }
    if build_only {
        println("Built project at " + cfg.output)
        << 0
    }
    if cfg.target == "ios-simulator-arm64" {
        $sim := device
        if sim.len == 0 { sim = "booted" }
        app_dir := cfg.output + "/build/XuPhone.app"
        run("xcrun", ["simctl", "install", ~sim, ~app_dir]) >>> (err) {
            eprintln("xu phone run install failed (boot a Simulator or pass --build-only): " + err.msg())
            << 1
        }
        run("xcrun", ["simctl", "launch", ~sim, ~cfg.bundle]) >>> (err) {
            eprintln("xu phone run launch failed: " + err.msg())
            << 1
        }
        << 0
    }
    if android {
        adb := detect_adb(&sdk)
        $apk := cfg.output + "/build/XuPhone-debug.apk"
        $activity := "org.xulang.phone.MainActivity"
        if cfg.profile == "game" {
            apk = cfg.output + "/build/XuPhoneGame-debug.apk"
            activity = "org.xulang.game.MainActivity"
        }
        $inst_args := []string{}
        $launch_args := []string{}
        if device.len > 0 {
            inst_args.push("-s")
            inst_args.push(~device)
            launch_args.push("-s")
            launch_args.push(~device)
        }
        inst_args.push("install")
        inst_args.push("-r")
        inst_args.push(~apk)
        launch_args.push("shell")
        launch_args.push("am")
        launch_args.push("start")
        launch_args.push("-n")
        launch_args.push(cfg.bundle + "/" + activity)
        run(~adb, inst_args) >>> (err) { eprintln("xu phone run adb install failed: " + err.msg())
            << 1 }
        run(~adb, launch_args) >>> (err) { eprintln("xu phone run adb launch failed: " + err.msg())
            << 1 }
        << 0
    }
    println("Built device app in " + cfg.output + "/build; install via Xcode or `xcrun devicectl` with signing credentials.")
    << 0
}
