@image

#image/color

// Geometry + RGBA buffer aligned with Go `image` (Point / Rectangle /
// NewRGBA / Set / At). No Color / Image interface: pixels are
// color.RGBA. Pix is []int of bytes 0..255.

pub struct Point {
    pub x int
    pub y int
}

pub struct Rectangle {
    pub min Point
    pub max Point
}

pub struct RGBA {
    pub pix []int
    pub stride int
    pub rect Rectangle
}

pub fn pt(x int, y int) Point {
    << Point{x: x, y: y}
}

pub fn rect(x0 int, y0 int, x1 int, y1 int) Rectangle {
    << Rectangle{min: Point{x: x0, y: y0}, max: Point{x: x1, y: y1}}
}

pub fn (p Point) add(q Point) Point {
    << Point{x: p.x + q.x, y: p.y + q.y}
}

pub fn (p Point) sub(q Point) Point {
    << Point{x: p.x - q.x, y: p.y - q.y}
}

pub fn (p Point) eq(q Point) bool {
    << p.x == q.x && p.y == q.y
}

pub fn (p Point) in_rect(r Rectangle) bool {
    << r.min.x <= p.x && p.x < r.max.x && r.min.y <= p.y && p.y < r.max.y
}

pub fn (r Rectangle) dx() int {
    << r.max.x - r.min.x
}

pub fn (r Rectangle) dy() int {
    << r.max.y - r.min.y
}

pub fn (r Rectangle) empty() bool {
    << r.min.x >= r.max.x || r.min.y >= r.max.y
}

pub fn (r Rectangle) eq(s Rectangle) bool {
    << r.min.x == s.min.x && r.min.y == s.min.y && r.max.x == s.max.x && r.max.y == s.max.y
}

pub fn (r Rectangle) overlaps(s Rectangle) bool {
    if r.empty() || s.empty() {
        << false
    }
    << r.min.x < s.max.x && s.min.x < r.max.x && r.min.y < s.max.y && s.min.y < r.max.y
}

pub fn (r Rectangle) add(p Point) Rectangle {
    << Rectangle{min: Point{x: r.min.x + p.x, y: r.min.y + p.y}, max: Point{x: r.max.x + p.x, y: r.max.y + p.y}}
}

pub fn (r Rectangle) intersect(s Rectangle) Rectangle {
    mut x0 := r.min.x
    if x0 < s.min.x {
        x0 = s.min.x
    }
    mut y0 := r.min.y
    if y0 < s.min.y {
        y0 = s.min.y
    }
    mut x1 := r.max.x
    if x1 > s.max.x {
        x1 = s.max.x
    }
    mut y1 := r.max.y
    if y1 > s.max.y {
        y1 = s.max.y
    }
    out := Rectangle{min: Point{x: x0, y: y0}, max: Point{x: x1, y: y1}}
    if out.empty() {
        << Rectangle{min: Point{x: 0, y: 0}, max: Point{x: 0, y: 0}}
    }
    << out
}

pub fn (r Rectangle) union(s Rectangle) Rectangle {
    if r.empty() {
        << s
    }
    if s.empty() {
        << r
    }
    mut x0 := r.min.x
    if x0 > s.min.x {
        x0 = s.min.x
    }
    mut y0 := r.min.y
    if y0 > s.min.y {
        y0 = s.min.y
    }
    mut x1 := r.max.x
    if x1 < s.max.x {
        x1 = s.max.x
    }
    mut y1 := r.max.y
    if y1 < s.max.y {
        y1 = s.max.y
    }
    << Rectangle{min: Point{x: x0, y: y0}, max: Point{x: x1, y: y1}}
}

pub fn (r Rectangle) canon() Rectangle {
    mut x0 := r.min.x
    mut y0 := r.min.y
    mut x1 := r.max.x
    mut y1 := r.max.y
    if x0 > x1 {
        t := x0
        x0 = x1
        x1 = t
    }
    if y0 > y1 {
        t := y0
        y0 = y1
        y1 = t
    }
    << Rectangle{min: Point{x: x0, y: y0}, max: Point{x: x1, y: y1}}
}

pub fn new_rgba(r Rectangle) RGBA {
    mut w := r.dx()
    mut h := r.dy()
    if w < 0 {
        w = 0
    }
    if h < 0 {
        h = 0
    }
    n := w * h * 4
    mut pix := []int{}
    for i in 0:n {
        pix.push(0)
    }
    << RGBA{pix: pix, stride: w * 4, rect: r}
}

pub fn (p RGBA) pix_offset(x int, y int) int {
    << (y - p.rect.min.y) * p.stride + (x - p.rect.min.x) * 4
}

pub fn (p &mut RGBA) set_rgba(x int, y int, c color.RGBA) {
    q := Point{x: x, y: y}
    if !q.in_rect(p.rect) {
        <<
    }
    i := p.pix_offset(x, y)
    p.pix[i] = c.r & 255
    p.pix[i + 1] = c.g & 255
    p.pix[i + 2] = c.b & 255
    p.pix[i + 3] = c.a & 255
}

pub fn (p RGBA) at_rgba(x int, y int) color.RGBA {
    q := Point{x: x, y: y}
    if !q.in_rect(p.rect) {
        << color.rgba8(0, 0, 0, 0)
    }
    i := p.pix_offset(x, y)
    << color.rgba8(p.pix[i] & 255, p.pix[i + 1] & 255, p.pix[i + 2] & 255, p.pix[i + 3] & 255)
}
