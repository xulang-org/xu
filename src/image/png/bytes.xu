@image/png

#errors
#strings
#hash/crc32
#hash/adler32

fn png_word(out $&strings.ByteBuilder,value int) {
    out.write_byte((value >> 24) & 255)
    out.write_byte((value >> 16) & 255)
    out.write_byte((value >> 8) & 255)
    out.write_byte(value & 255)
}

fn png_byte_chunk(out $&strings.ByteBuilder,kind string,data &string) {
    png_word(&*out,data.len)
    out.write_str(kind + "")
    out.write_str(*data)
    $digest := crc32.new_ieee()
    digest.write(&kind)
    digest.write(data)
    png_word(&*out,digest.sum())
}

// Encode tightly packed top-left straight RGBA8 with filter None and stored
// DEFLATE. Byte buffers keep memory bounded without per-byte integer slots.
// Only IHDR/IDAT/IEND are emitted: no text, EXIF or other host metadata.
pub fn encode_rgba_bytes(pixels &string,width int,height int) string {
    if width < 1 || height < 1 || width > 16384 || height > 16384 ||
       width * height * 4 > 67108864 || pixels.len != width * height * 4 {
        >> errors.new("png: invalid RGBA byte buffer")
    }
    $scan := strings.new_byte_builder((width * 4 + 1) * height)
    for y in 0:height {
        scan.write_byte(0)
        scan.write_str(pixels[y * width * 4:(y + 1) * width * 4])
    }
    raw := scan.to_string()
    $zlib := strings.new_byte_builder(raw.len + ((raw.len + 65534) / 65535) * 5 + 6)
    zlib.write_byte(120)
    zlib.write_byte(1)
    $offset := 0
    while offset < raw.len {
        $count := raw.len - offset
        if count > 65535 { count = 65535 }
        $final := 0
        if offset + count == raw.len { final = 1 }
        zlib.write_byte(final)
        zlib.write_byte(count & 255)
        zlib.write_byte((count >> 8) & 255)
        zlib.write_byte((count ^ 65535) & 255)
        zlib.write_byte(((count ^ 65535) >> 8) & 255)
        zlib.write_str(raw[offset:offset + count])
        offset += count
    }
    png_word($&zlib,adler32.checksum(&raw))
    compressed := zlib.to_string()
    $header := strings.new_byte_builder(13)
    png_word($&header,width)
    png_word($&header,height)
    header.write_byte(8)
    header.write_byte(6)
    header.write_byte(0)
    header.write_byte(0)
    header.write_byte(0)
    ihdr := header.to_string()
    $out := strings.new_byte_builder(compressed.len + 57)
    out.write_byte(137)
    out.write_str("PNG\r\n")
    out.write_byte(26)
    out.write_byte(10)
    png_byte_chunk($&out,"IHDR",&ihdr)
    png_byte_chunk($&out,"IDAT",&compressed)
    png_byte_chunk($&out,"IEND",&"")
    << out.to_string()
}
