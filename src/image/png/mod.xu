@image/png


#errors
#compress/zlib
#hash/crc32
#image
#image/color

// PNG 8-bit RGB/RGBA decode + RGBA encode aligned with Go `image/png`
// for the non-interlaced truecolor path. Encode uses filter None and
// compress.zlib (stored deflate). Decode accepts filters None/Sub/Up/
// Average/Paeth.

fn iabs(x int) int {
    if x < 0 {
        << 0 - x
    }
    << x
}

fn paeth(a int, b int, c int) int {
    p := a + b - c
    pa := iabs(p - a)
    pb := iabs(p - b)
    pc := iabs(p - c)
    if pa <= pb && pa <= pc {
        << a
    }
    if pb <= pc {
        << b
    }
    << c
}

fn get_u32_be(data &string, i int) int {
    << ((data[i] & 255) << 24) | ((data[i + 1] & 255) << 16) | ((data[i + 2] & 255) << 8) | (data[i + 3] & 255)
}

fn put_u32_be(b &mut []int, v int) {
    b.push((v >> 24) & 255)
    b.push((v >> 16) & 255)
    b.push((v >> 8) & 255)
    b.push(v & 255)
}

// Gen1 poisons `xs[i - bpp]` in the same fn as the hot loop (even behind
// `if i >= bpp`) — same class as path.clean / lzw. Index via tiny helpers.
fn at_i(xs &[]int, i int) int {
    << xs[i]
}

fn set_i(xs &mut []int, i int, v int) {
    xs[i] = v
}

fn filter_byte(ft int, x int, a int, b int, c int) int {
    if ft == 1 {
        << (x + a) & 255
    }
    if ft == 2 {
        << (x + b) & 255
    }
    if ft == 3 {
        << (x + ((a + b) / 2)) & 255
    }
    if ft == 4 {
        << (x + paeth(a, b, c)) & 255
    }
    << x & 255
}

fn unfilter(raw &string, w int, h int, bpp int) []int {
    rowb := w * bpp
    need := (rowb + 1) * h
    if raw.len < need {
        >> errors.new("png: not enough image data")
    }
    mut out := []int{}
    mut prev := []int{}
    for i in 0:rowb {
        prev.push(0)
    }
    mut off := 0
    for y in 0:h {
        ft := raw[off] & 255
        off = off + 1
        mut recon := []int{}
        for i in 0:rowb {
            x := raw[off + i] & 255
            mut a := 0
            mut c := 0
            if i >= bpp {
                j := i - bpp
                a = at_i(&recon, j)
                c = at_i(&prev, j)
            }
            b := at_i(&prev, i)
            recon.push(filter_byte(ft, x, a, b, c))
        }
        off = off + rowb
        for i in 0:rowb {
            v := at_i(&recon, i)
            out.push(v)
            set_i(mut &prev, i, v)
        }
        _ := y
    }
    << out
}

fn chunk(typ string, data &string) string {
    mut b := []int{}
    put_u32_be(mut &b, data.len)
    mut crc_src := []int{}
    for i in 0:typ.len {
        crc_src.push(typ[i] & 255)
        b.push(typ[i] & 255)
    }
    src := data + ""
    for i in 0:src.len {
        crc_src.push(src[i] & 255)
        b.push(src[i] & 255)
    }
    raw := string_from_bytes(crc_src)
    crc := crc32.checksum_ieee(&raw)
    put_u32_be(mut &b, crc)
    << string_from_bytes(b)
}

pub fn encode_rgba(img &image.RGBA) string {
    w := img.rect.dx()
    h := img.rect.dy()
    if w < 1 || h < 1 || w > 65535 || h > 65535 {
        >> errors.new("png: invalid image size")
    }
    mut ihdr := []int{}
    put_u32_be(mut &ihdr, w)
    put_u32_be(mut &ihdr, h)
    ihdr.push(8)
    ihdr.push(6)
    ihdr.push(0)
    ihdr.push(0)
    ihdr.push(0)
    ihdr_s := string_from_bytes(ihdr)
    mut raw := []int{}
    for y in 0:h {
        raw.push(0)
        for x in 0:w {
            c := img.at_rgba(img.rect.min.x + x, img.rect.min.y + y)
            raw.push(c.r & 255)
            raw.push(c.g & 255)
            raw.push(c.b & 255)
            raw.push(c.a & 255)
        }
    }
    scan := string_from_bytes(raw)
    mut zw := zlib.new_writer()
    zw.write(&scan)
    zw.close()
    z := zw.bytes()
    mut out := []int{}
    sig := [137, 80, 78, 71, 13, 10, 26, 10]
    for i in 0:8 {
        out.push(sig[i])
    }
    ih := chunk("IHDR", &ihdr_s)
    for i in 0:ih.len {
        out.push(ih[i] & 255)
    }
    id := chunk("IDAT", &z)
    for i in 0:id.len {
        out.push(id[i] & 255)
    }
    empty := ""
    ie := chunk("IEND", &empty)
    for i in 0:ie.len {
        out.push(ie[i] & 255)
    }
    << string_from_bytes(out)
}

pub fn decode(src &string) image.RGBA {
    data := src + ""
    if data.len < 8 {
        >> errors.new("png: truncated")
    }
    if (data[0] & 255) != 137 || (data[1] & 255) != 80 || (data[2] & 255) != 78 || (data[3] & 255) != 71 {
        >> errors.new("png: invalid signature")
    }
    mut p := 8
    mut width := 0
    mut height := 0
    mut ctype := 0
    mut depth := 0
    mut idat := ""
    mut saw_ihdr := 0
    mut done := 0
    while done == 0 {
        if p + 12 > data.len {
            >> errors.new("png: truncated chunk")
        }
        n := get_u32_be(&data, p)
        if n < 0 || p + 12 + n > data.len {
            >> errors.new("png: truncated chunk")
        }
        typ := data[(p + 4):(p + 8)] + ""
        mut body := ""
        if n > 0 {
            body = data[(p + 8):(p + 8 + n)] + ""
        }
        p = p + 12 + n
        if typ == "IHDR" {
            if body.len != 13 {
                >> errors.new("png: bad IHDR")
            }
            width = get_u32_be(&body, 0)
            height = get_u32_be(&body, 4)
            depth = body[8] & 255
            ctype = body[9] & 255
            if depth != 8 {
                >> errors.new("png: bit depth not supported")
            }
            if ctype != 2 && ctype != 6 {
                >> errors.new("png: color type not supported")
            }
            if (body[12] & 255) != 0 {
                >> errors.new("png: interlaced images not supported")
            }
            saw_ihdr = 1
        } else {
            if typ == "IDAT" {
                idat = idat + body
            } else {
                if typ == "IEND" {
                    done = 1
                }
            }
        }
    }
    if saw_ihdr == 0 || idat.len == 0 {
        >> errors.new("png: missing IHDR/IDAT")
    }
    mut zr := zlib.new_reader(idat + "")
    raw := zr.read_all()
    mut bpp := 4
    if ctype == 2 {
        bpp = 3
    }
    pix := unfilter(&raw, width, height, bpp)
    mut img := image.new_rgba(image.rect(0, 0, width, height))
    mut i := 0
    for y in 0:height {
        for x in 0:width {
            r := at_i(&pix, i) & 255
            g := at_i(&pix, i + 1) & 255
            b := at_i(&pix, i + 2) & 255
            mut a := 255
            if bpp == 4 {
                a = at_i(&pix, i + 3) & 255
                i = i + 4
            } else {
                i = i + 3
            }
            img.set_rgba(x, y, color.rgba8(r, g, b, a))
        }
    }
    << img
}
