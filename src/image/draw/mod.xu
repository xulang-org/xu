@image/draw

#image
#image/color

// Porter-Duff Src/Over on image.RGBA, aligned with Go `image/draw`.
// No Image/draw.Image interface; no mask.

pub const op_over = 0
pub const op_src = 1

fn over8(d color.RGBA, s color.RGBA) color.RGBA {
    m := 65535
    sr := (s.r & 255) * 257
    sg := (s.g & 255) * 257
    sb := (s.b & 255) * 257
    sa := (s.a & 255) * 257
    a := (m - sa) * 257
    r := (((d.r & 255) * a) / m + sr) >> 8
    g := (((d.g & 255) * a) / m + sg) >> 8
    b := (((d.b & 255) * a) / m + sb) >> 8
    al := (((d.a & 255) * a) / m + sa) >> 8
    << color.rgba8(r & 255, g & 255, b & 255, al & 255)
}

pub fn draw_rgba(dst &mut image.RGBA, r0 image.Rectangle, src &image.RGBA, sp0 image.Point, op int) {
    orig := r0.min
    mut r := r0.intersect(dst.rect)
    delta := orig.sub(sp0)
    src_in_dst := src.rect.add(delta)
    r = r.intersect(src_in_dst)
    if r.empty() {
        <<
    }
    mut sp := sp0
    sp = sp.add(image.pt(r.min.x - orig.x, r.min.y - orig.y))
    dy := r.dy()
    dx := r.dx()
    for y in 0:dy {
        for x in 0:dx {
            sx := sp.x + x
            sy := sp.y + y
            px := r.min.x + x
            py := r.min.y + y
            sc := src.at_rgba(sx, sy)
            if op == op_src {
                dst.set_rgba(px, py, sc)
            } else {
                dc := dst.at_rgba(px, py)
                dst.set_rgba(px, py, over8(dc, sc))
            }
        }
    }
}
