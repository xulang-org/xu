@image/color

// Color conversions aligned with Go `image/color` (RGBA/NRGBA/Gray/Alpha
// + RGB↔YCbCr / RGB↔CMYK). No Color interface: each type has rgba()
// returning 16-bit alpha-premultiplied channels in RGBA16.

pub struct RGBA {
    pub r int
    pub g int
    pub b int
    pub a int
}

pub struct NRGBA {
    pub r int
    pub g int
    pub b int
    pub a int
}

pub struct Gray {
    pub y int
}

pub struct Alpha {
    pub a int
}

pub struct YCbCr {
    pub y int
    pub cb int
    pub cr int
}

pub struct CMYK {
    pub c int
    pub m int
    pub y int
    pub k int
}

pub struct RGBA16 {
    pub r int
    pub g int
    pub b int
    pub a int
}

pub fn rgba8(r int, g int, b int, a int) RGBA {
    << RGBA{r: r, g: g, b: b, a: a}
}

pub fn nrgba8(r int, g int, b int, a int) NRGBA {
    << NRGBA{r: r, g: g, b: b, a: a}
}

pub fn gray8(y int) Gray {
    << Gray{y: y}
}

pub fn alpha8(a int) Alpha {
    << Alpha{a: a}
}

fn expand8(v int) int {
    x := v & 255
    << x | (x * 256)
}

pub fn (c RGBA) rgba() RGBA16 {
    << RGBA16{r: expand8(c.r), g: expand8(c.g), b: expand8(c.b), a: expand8(c.a)}
}

pub fn (c NRGBA) rgba() RGBA16 {
    a := expand8(c.a)
    if a == 0 {
        << RGBA16{r: 0, g: 0, b: 0, a: 0}
    }
    r := expand8(c.r) * (c.a & 255) / 255
    g := expand8(c.g) * (c.a & 255) / 255
    b := expand8(c.b) * (c.a & 255) / 255
    << RGBA16{r: r, g: g, b: b, a: a}
}

pub fn (c Gray) rgba() RGBA16 {
    y := expand8(c.y)
    << RGBA16{r: y, g: y, b: y, a: 65535}
}

pub fn (c Alpha) rgba() RGBA16 {
    a := expand8(c.a)
    << RGBA16{r: a, g: a, b: a, a: a}
}

fn clamp8_shift16(v int) int {
    if v < 0 {
        << 0
    }
    r := v >> 16
    if r > 255 {
        << 255
    }
    << r
}

pub fn rgb_to_ycbcr(r int, g int, b int) YCbCr {
    r1 := r & 255
    g1 := g & 255
    b1 := b & 255
    yy := (19595 * r1 + 38470 * g1 + 7471 * b1 + 32768) >> 16
    cb := clamp8_shift16(0 - 11056 * r1 - 21712 * g1 + 32768 * b1 + 257 * 32768)
    cr := clamp8_shift16(32768 * r1 - 27440 * g1 - 5328 * b1 + 257 * 32768)
    << YCbCr{y: yy & 255, cb: cb, cr: cr}
}

pub fn ycbcr_to_rgb(y int, cb int, cr int) RGBA {
    yy1 := (y & 255) * 65793
    cb1 := (cb & 255) - 128
    cr1 := (cr & 255) - 128
    r := clamp8_shift16(yy1 + 91881 * cr1)
    g := clamp8_shift16(yy1 - 22554 * cb1 - 46802 * cr1)
    b := clamp8_shift16(yy1 + 116130 * cb1)
    << RGBA{r: r, g: g, b: b, a: 255}
}

pub fn rgb_to_cmyk(r int, g int, b int) CMYK {
    rr := r & 255
    gg := g & 255
    bb := b & 255
    mut w := rr
    if w < gg {
        w = gg
    }
    if w < bb {
        w = bb
    }
    if w == 0 {
        << CMYK{c: 0, m: 0, y: 0, k: 255}
    }
    c := muldiv255(w - rr, w)
    m := muldiv255(w - gg, w)
    y := muldiv255(w - bb, w)
    << CMYK{c: c, m: m, y: y, k: 255 - w}
}

fn muldiv255(num int, den int) int {
    if den < 1 {
        << 0
    }
    acc := num * 255
    mut q := 0
    mut rest := acc
    while rest >= den {
        rest = rest - den
        q = q + 1
    }
    << q
}

pub fn cmyk_to_rgb(c int, m int, y int, k int) RGBA {
    w := 65535 - (k & 255) * 257
    r := (65535 - (c & 255) * 257) * w / 65535
    g := (65535 - (m & 255) * 257) * w / 65535
    b := (65535 - (y & 255) * 257) * w / 65535
    << RGBA{r: (r >> 8) & 255, g: (g >> 8) & 255, b: (b >> 8) & 255, a: 255}
}

pub fn (c CMYK) rgba() RGBA16 {
    w := 65535 - (c.k & 255) * 257
    r := (65535 - (c.c & 255) * 257) * w / 65535
    g := (65535 - (c.m & 255) * 257) * w / 65535
    b := (65535 - (c.y & 255) * 257) * w / 65535
    << RGBA16{r: r, g: g, b: b, a: 65535}
}
