@image/jpeg

// Zigzag + integer 8x8 IDCT (nanojpeg / Arai-Agui-Nakajima style).
// M107: free helpers take &mut []int and reborrow across the loop.

fn zz_at(i int) int {
    t := [0, 1, 8, 16, 9, 2, 3, 10, 17, 24, 32, 25, 18, 11, 4, 5, 12, 19, 26, 33, 40, 48, 41, 34, 27, 20, 13, 6, 7, 14, 21, 28, 35, 42, 49, 56, 57, 50, 43, 36, 29, 22, 15, 23, 30, 37, 44, 51, 58, 59, 52, 45, 38, 31, 39, 46, 53, 60, 61, 54, 47, 55, 62, 63]
    << t[i]
}

fn clamp8(v int) int {
    if v < 0 {
        << 0
    }
    if v > 255 {
        << 255
    }
    << v
}

fn idct_row(blk &mut []int, off int) {
    mut x1 := blk[off + 4] << 11
    mut x2 := blk[off + 6]
    mut x3 := blk[off + 2]
    mut x4 := blk[off + 1]
    mut x5 := blk[off + 7]
    mut x6 := blk[off + 5]
    mut x7 := blk[off + 3]
    if (x1 | x2 | x3 | x4 | x5 | x6 | x7) == 0 {
        v := blk[off] << 3
        blk[off] = v
        blk[off + 1] = v
        blk[off + 2] = v
        blk[off + 3] = v
        blk[off + 4] = v
        blk[off + 5] = v
        blk[off + 6] = v
        blk[off + 7] = v
        <<
    }
    mut x0 := (blk[off] << 11) + 128
    mut x8 := 565 * (x4 + x5)
    x4 = x8 + (2841 - 565) * x4
    x5 = x8 - (2841 + 565) * x5
    x8 = 2408 * (x6 + x7)
    x6 = x8 - (2408 - 1609) * x6
    x7 = x8 - (2408 + 1609) * x7
    x8 = x0 + x1
    x0 = x0 - x1
    x1 = 1108 * (x3 + x2)
    x2 = x1 - (2676 + 1108) * x2
    x3 = x1 + (2676 - 1108) * x3
    x1 = x4 + x6
    x4 = x4 - x6
    x6 = x5 + x7
    x5 = x5 - x7
    x7 = x8 + x3
    x8 = x8 - x3
    x3 = x0 + x2
    x0 = x0 - x2
    x2 = (181 * (x4 + x5) + 128) >> 8
    x4 = (181 * (x4 - x5) + 128) >> 8
    blk[off] = (x7 + x1) >> 8
    blk[off + 1] = (x3 + x2) >> 8
    blk[off + 2] = (x0 + x4) >> 8
    blk[off + 3] = (x8 + x6) >> 8
    blk[off + 4] = (x8 - x6) >> 8
    blk[off + 5] = (x0 - x4) >> 8
    blk[off + 6] = (x3 - x2) >> 8
    blk[off + 7] = (x7 - x1) >> 8
}

fn idct_col(blk &mut []int, off int) {
    mut x1 := blk[off + 32] << 8
    mut x2 := blk[off + 48]
    mut x3 := blk[off + 16]
    mut x4 := blk[off + 8]
    mut x5 := blk[off + 56]
    mut x6 := blk[off + 40]
    mut x7 := blk[off + 24]
    if (x1 | x2 | x3 | x4 | x5 | x6 | x7) == 0 {
        v := (blk[off] + 32) >> 6
        blk[off] = v
        blk[off + 8] = v
        blk[off + 16] = v
        blk[off + 24] = v
        blk[off + 32] = v
        blk[off + 40] = v
        blk[off + 48] = v
        blk[off + 56] = v
        <<
    }
    mut x0 := (blk[off] << 8) + 8192
    mut x8 := 565 * (x4 + x5) + 4
    x4 = (x8 + (2841 - 565) * x4) >> 3
    x5 = (x8 - (2841 + 565) * x5) >> 3
    x8 = 2408 * (x6 + x7) + 4
    x6 = (x8 - (2408 - 1609) * x6) >> 3
    x7 = (x8 - (2408 + 1609) * x7) >> 3
    x8 = x0 + x1
    x0 = x0 - x1
    x1 = 1108 * (x3 + x2) + 4
    x2 = (x1 - (2676 + 1108) * x2) >> 3
    x3 = (x1 + (2676 - 1108) * x3) >> 3
    x1 = x4 + x6
    x4 = x4 - x6
    x6 = x5 + x7
    x5 = x5 - x7
    x7 = x8 + x3
    x8 = x8 - x3
    x3 = x0 + x2
    x0 = x0 - x2
    x2 = (181 * (x4 + x5) + 128) >> 8
    x4 = (181 * (x4 - x5) + 128) >> 8
    blk[off] = (x7 + x1) >> 14
    blk[off + 8] = (x3 + x2) >> 14
    blk[off + 16] = (x0 + x4) >> 14
    blk[off + 24] = (x8 + x6) >> 14
    blk[off + 32] = (x8 - x6) >> 14
    blk[off + 40] = (x0 - x4) >> 14
    blk[off + 48] = (x3 - x2) >> 14
    blk[off + 56] = (x7 - x1) >> 14
}

fn idct_block(blk &mut []int) {
    for r in 0:8 {
        idct_row(blk, r * 8)
    }
    for c in 0:8 {
        idct_col(blk, c)
    }
}
