@image/jpeg


#errors
// Canonical Huffman build (DHT) + JPEG magnitude extend.
// Bit reading for scans lives on Dec in mod.xu (single mut borrow).

struct Huff {
    count   []int
    symbol  []int
    max_len int
    valid   int
}

fn huff_empty() Huff {
    mut count := []int{}
    for i in 0:17 {
        count.push(0)
        _ := i
    }
    mut symbol := []int{}
    << Huff{count: count, symbol: symbol, max_len: 0, valid: 0}
}

fn build_huff(lengths &[]int, vals &[]int) Huff {
    mut count := []int{}
    for i in 0:17 {
        count.push(0)
        _ := i
    }
    mut max_l := 0
    for i in 0:lengths.len {
        l := lengths[i]
        if l < 0 || l > 16 {
            >> errors.new("jpeg: bad Huffman length")
        }
        if l != 0 {
            count[l] = count[l] + 1
            if l > max_l {
                max_l = l
            }
        }
    }
    mut offs := []int{}
    for i in 0:17 {
        offs.push(0)
        _ := i
    }
    mut sum := 0
    for len in 1:17 {
        offs[len] = sum
        sum = sum + count[len]
    }
    if sum != vals.len {
        >> errors.new("jpeg: Huffman count mismatch")
    }
    mut symbol := []int{}
    for i in 0:sum {
        symbol.push(0)
        _ := i
    }
    for sym in 0:lengths.len {
        l := lengths[sym]
        if l != 0 {
            symbol[offs[l]] = vals[sym]
            offs[l] = offs[l] + 1
        }
    }
    << Huff{count: count, symbol: symbol, max_len: max_l, valid: 1}
}

fn extend_bits(v int, t int) int {
    if t == 0 {
        << 0
    }
    vt := 1 << (t - 1)
    if v < vt {
        << v + ((0 - 1) << t) + 1
    }
    << v
}
