@image/jpeg


#errors
#image
#image/color

// Baseline JPEG (SOF0) decode → image.RGBA and encode_rgba → baseline SOF0.
// Decode: 1-component gray and 3-component YCbCr (4:4:4 / 4:2:0, H/V≤2).
// Encode: YCbCr 4:4:4, fixed quality ~75. No progressive / io.Reader.

struct TabSet {
    t0 Huff
    t1 Huff
    t2 Huff
    t3 Huff
}

struct Dec {
    data   string
    pos    int
    cur    int
    nbits  int
    width  int
    height int
    ncomp  int
    hmax   int
    vmax   int
    cid    []int
    ch     []int
    cv     []int
    ctq    []int
    ctd    []int
    cta    []int
    dcpred []int
    qt     []int
    dc     TabSet
    ac     TabSet
    err    string
}

fn tabs_empty() TabSet {
    << TabSet{t0: huff_empty(), t1: huff_empty(), t2: huff_empty(), t3: huff_empty()}
}

fn (d $&Dec) fail(msg string) {
    if d.err.len == 0 {
        d.err = msg + ""
    }
}

fn (d $&Dec) read_u8() int {
    if d.pos >= d.data.len {
        d.fail("jpeg: truncated")
        << 0
    }
    v := d.data[d.pos] & 255
    d.pos = d.pos + 1
    << v
}

fn (d $&Dec) read_u16() int {
    hi := d.read_u8()
    lo := d.read_u8()
    << (hi << 8) | lo
}

fn (d $&Dec) skip(n int) {
    if d.pos + n > d.data.len {
        d.fail("jpeg: truncated")
        <<
    }
    d.pos = d.pos + n
}

fn (d $&Dec) install_huff(tc int, th int, sym_lens &[]int, vals &[]int) {
    if th < 0 || th > 3 || tc < 0 || tc > 1 {
        d.fail("jpeg: bad Huffman id")
        <<
    }
    ht := build_huff(sym_lens, vals) or (err) {
        d.fail("jpeg: bad Huffman table")
        <<
    }
    if tc == 0 && th == 0 {
        d.dc.t0 = ht
        <<
    }
    if tc == 0 && th == 1 {
        d.dc.t1 = ht
        <<
    }
    if tc == 0 && th == 2 {
        d.dc.t2 = ht
        <<
    }
    if tc == 0 && th == 3 {
        d.dc.t3 = ht
        <<
    }
    if tc == 1 && th == 0 {
        d.ac.t0 = ht
        <<
    }
    if tc == 1 && th == 1 {
        d.ac.t1 = ht
        <<
    }
    if tc == 1 && th == 2 {
        d.ac.t2 = ht
        <<
    }
    if tc == 1 && th == 3 {
        d.ac.t3 = ht
        <<
    }
}

fn (d $&Dec) ensure_qt() {
    if d.qt.len >= 256 {
        <<
    }
    for i in 0:256 {
        d.qt.push(0)
        _ := i
    }
}

fn (d $&Dec) parse_dqt() {
    seglen := d.read_u16()
    if seglen < 2 {
        d.fail("jpeg: bad DQT length")
        <<
    }
    $left := seglen - 2
    while left > 0 {
        pq_tq := d.read_u8()
        left = left - 1
        pq := pq_tq >> 4
        tq := pq_tq & 15
        if pq != 0 || tq > 3 {
            d.fail("jpeg: DQT precision/id not supported")
            <<
        }
        if left < 64 {
            d.fail("jpeg: truncated DQT")
            <<
        }
        d.ensure_qt()
        base := tq * 64
        for i in 0:64 {
            d.qt[base + i] = d.read_u8()
            left = left - 1
        }
    }
}

fn (d $&Dec) parse_dht() {
    seglen := d.read_u16()
    if seglen < 2 {
        d.fail("jpeg: bad DHT length")
        <<
    }
    $left := seglen - 2
    while left > 0 {
        tc_th := d.read_u8()
        left = left - 1
        tc := tc_th >> 4
        th := tc_th & 15
        if tc > 1 || th > 3 {
            d.fail("jpeg: DHT class/id not supported")
            <<
        }
        if left < 16 {
            d.fail("jpeg: truncated DHT")
            <<
        }
        $lengths := []int{}
        $nsym := 0
        for i in 0:16 {
            n := d.read_u8()
            left = left - 1
            lengths.push(n)
            nsym = nsym + n
            _ := i
        }
        if left < nsym {
            d.fail("jpeg: truncated DHT values")
            <<
        }
        $vals := []int{}
        for i in 0:nsym {
            vals.push(d.read_u8())
            left = left - 1
            _ := i
        }
        $sym_lens := []int{}
        for i in 0:nsym {
            sym_lens.push(0)
            _ := i
        }
        $k := 0
        for len in 1:17 {
            n := lengths[len - 1]
            for j in 0:n {
                sym_lens[k] = len
                k = k + 1
                _ := j
            }
        }
        d.install_huff(tc, th, &sym_lens, &vals)
        if d.err.len > 0 {
            <<
        }
    }
}

fn (d $&Dec) parse_sof0() {
    seglen := d.read_u16()
    if seglen < 8 {
        d.fail("jpeg: bad SOF0 length")
        <<
    }
    p := d.read_u8()
    d.height = d.read_u16()
    d.width = d.read_u16()
    d.ncomp = d.read_u8()
    if p != 8 {
        d.fail("jpeg: only 8-bit SOF0 supported")
        <<
    }
    if d.width < 1 || d.height < 1 {
        d.fail("jpeg: invalid image size")
        <<
    }
    if d.ncomp != 1 && d.ncomp != 3 {
        d.fail("jpeg: only 1 or 3 components supported")
        <<
    }
    if seglen != 8 + 3 * d.ncomp {
        d.fail("jpeg: SOF0 length mismatch")
        <<
    }
    d.hmax = 0
    d.vmax = 0
    for i in 0:d.ncomp {
        id := d.read_u8()
        hv := d.read_u8()
        tq := d.read_u8()
        h := hv >> 4
        v := hv & 15
        if h < 1 || v < 1 || h > 2 || v > 2 || tq > 3 {
            d.fail("jpeg: bad sampling or quant id")
            <<
        }
        d.cid.push(id)
        d.ch.push(h)
        d.cv.push(v)
        d.ctq.push(tq)
        d.ctd.push(0)
        d.cta.push(0)
        d.dcpred.push(0)
        if h > d.hmax {
            d.hmax = h
        }
        if v > d.vmax {
            d.vmax = v
        }
        _ := i
    }
}

fn (d $&Dec) parse_sos() int {
    seglen := d.read_u16()
    if seglen < 6 {
        d.fail("jpeg: bad SOS length")
        << 0
    }
    ns := d.read_u8()
    if ns != d.ncomp {
        d.fail("jpeg: SOS component count mismatch")
        << 0
    }
    if seglen != 6 + 2 * ns {
        d.fail("jpeg: SOS length mismatch")
        << 0
    }
    for i in 0:ns {
        id := d.read_u8()
        tdta := d.read_u8()
        td := tdta >> 4
        ta := tdta & 15
        $found := 0
        for c in 0:d.ncomp {
            if d.cid[c] == id {
                d.ctd[c] = td
                d.cta[c] = ta
                found = 1
            }
            _ := c
        }
        if found == 0 {
            d.fail("jpeg: SOS unknown component")
            << 0
        }
        if td > 3 || ta > 3 {
            d.fail("jpeg: bad SOS table id")
            << 0
        }
        _ := i
    }
    ss := d.read_u8()
    se := d.read_u8()
    ahal := d.read_u8()
    if ss != 0 || se != 63 || ahal != 0 {
        d.fail("jpeg: progressive SOS not supported")
        << 0
    }
    << 1
}

fn (d $&Dec) next_scan_byte() int {
    if d.pos >= d.data.len {
        d.fail("jpeg: unexpected EOF in scan")
        << 0
    }
    v := d.data[d.pos] & 255
    d.pos = d.pos + 1
    if v == 255 {
        if d.pos >= d.data.len {
            d.fail("jpeg: truncated stuffed byte")
            << 0
        }
        n := d.data[d.pos] & 255
        d.pos = d.pos + 1
        if n == 0 {
            << 255
        }
        d.fail("jpeg: marker in scan")
        << 0
    }
    << v
}

fn (d $&Dec) bit1() int {
    if d.nbits == 0 {
        d.cur = d.next_scan_byte()
        if d.err.len > 0 {
            << 0
        }
        d.nbits = 8
    }
    d.nbits = d.nbits - 1
    << (d.cur >> d.nbits) & 1
}

fn (d $&Dec) bits(n int) int {
    $v := 0
    for i in 0:n {
        v = (v << 1) | d.bit1()
        if d.err.len > 0 {
            << 0
        }
        _ := i
    }
    << v
}

fn (d $&Dec) huff(is_ac int, id int) int {
    $max_len := 0
    $valid := 0
    if is_ac == 0 {
        if id == 0 {
            valid = d.dc.t0.valid
            max_len = d.dc.t0.max_len
        }
        if id == 1 {
            valid = d.dc.t1.valid
            max_len = d.dc.t1.max_len
        }
        if id == 2 {
            valid = d.dc.t2.valid
            max_len = d.dc.t2.max_len
        }
        if id == 3 {
            valid = d.dc.t3.valid
            max_len = d.dc.t3.max_len
        }
    } else {
        if id == 0 {
            valid = d.ac.t0.valid
            max_len = d.ac.t0.max_len
        }
        if id == 1 {
            valid = d.ac.t1.valid
            max_len = d.ac.t1.max_len
        }
        if id == 2 {
            valid = d.ac.t2.valid
            max_len = d.ac.t2.max_len
        }
        if id == 3 {
            valid = d.ac.t3.valid
            max_len = d.ac.t3.max_len
        }
    }
    if valid == 0 || max_len < 1 {
        d.fail("jpeg: missing Huffman table")
        << -1
    }
    $code := 0
    $first := 0
    $index := 0
    $len := 1
    while len <= max_len {
        bit := d.bit1()
        if d.err.len > 0 {
            << -1
        }
        code = (code << 1) | bit
        $count := 0
        if is_ac == 0 {
            if id == 0 {
                count = d.dc.t0.count[len]
            }
            if id == 1 {
                count = d.dc.t1.count[len]
            }
            if id == 2 {
                count = d.dc.t2.count[len]
            }
            if id == 3 {
                count = d.dc.t3.count[len]
            }
        } else {
            if id == 0 {
                count = d.ac.t0.count[len]
            }
            if id == 1 {
                count = d.ac.t1.count[len]
            }
            if id == 2 {
                count = d.ac.t2.count[len]
            }
            if id == 3 {
                count = d.ac.t3.count[len]
            }
        }
        if code - first < count {
            si := index + (code - first)
            if is_ac == 0 {
                if id == 0 {
                    << d.dc.t0.symbol[si]
                }
                if id == 1 {
                    << d.dc.t1.symbol[si]
                }
                if id == 2 {
                    << d.dc.t2.symbol[si]
                }
                << d.dc.t3.symbol[si]
            }
            if id == 0 {
                << d.ac.t0.symbol[si]
            }
            if id == 1 {
                << d.ac.t1.symbol[si]
            }
            if id == 2 {
                << d.ac.t2.symbol[si]
            }
            << d.ac.t3.symbol[si]
        }
        index = index + count
        first = first + count
        first = first << 1
        len = len + 1
    }
    d.fail("jpeg: invalid Huffman code")
    << -1
}

fn (d $&Dec) decode_block(ci int, blk $&[]int) {
    for i in 0:64 {
        blk[i] = 0
    }
    td := d.ctd[ci]
    ta := d.cta[ci]
    tq := d.ctq[ci]
    t := d.huff(0, td)
    if d.err.len > 0 {
        <<
    }
    $diff := 0
    if t > 0 {
        if t > 11 {
            d.fail("jpeg: bad DC magnitude")
            <<
        }
        diff = extend_bits(d.bits(t), t)
    }
    dc := d.dcpred[ci] + diff
    d.dcpred[ci] = dc
    qbase := tq * 64
    blk[0] = dc * d.qt[qbase]
    $k := 1
    while k < 64 {
        s := d.huff(1, ta)
        if d.err.len > 0 {
            <<
        }
        r := s >> 4
        s2 := s & 15
        if s2 == 0 {
            if r == 15 {
                k = k + 16
            } else {
                <-
            }
        } else {
            k = k + r
            if k >= 64 {
                d.fail("jpeg: AC coefficient overflow")
                <<
            }
            if s2 > 10 {
                d.fail("jpeg: bad AC magnitude")
                <<
            }
            v := extend_bits(d.bits(s2), s2)
            zi := zz_at(k)
            blk[zi] = v * d.qt[qbase + k]
            k = k + 1
        }
    }
    idct_block(blk)
}

fn ceil_div(a int, b int) int {
    if b < 1 {
        << 0
    }
    << (a + b - 1) / b
}

fn (d $&Dec) decode_scan() image.RGBA {
    d.cur = 0
    d.nbits = 0
    mcu_w := 8 * d.hmax
    mcu_h := 8 * d.vmax
    nx := ceil_div(d.width, mcu_w)
    ny := ceil_div(d.height, mcu_h)
    $planes := []int{}
    plen := d.ncomp * d.width * d.height
    for i in 0:plen {
        planes.push(0)
        _ := i
    }
    $blk := []int{}
    for i in 0:64 {
        blk.push(0)
        _ := i
    }
    for my in 0:ny {
        for mx in 0:nx {
            for ci in 0:d.ncomp {
                $hs := 1
                $vs := 1
                ch := d.ch[ci]
                cv := d.cv[ci]
                if ch > 0 {
                    hs = d.hmax / ch
                }
                if cv > 0 {
                    vs = d.vmax / cv
                }
                for by in 0:cv {
                    for bx in 0:ch {
                        d.decode_block(ci, $&blk)
                        if d.err.len > 0 {
                            >> errors.new(d.err + "")
                        }
                        off := ci * d.width * d.height
                        gbx := mx * d.ch[ci] + bx
                        gby := my * d.cv[ci] + by
                        for y in 0:8 {
                            for x in 0:8 {
                                sample := clamp8(blk[y * 8 + x] + 128)
                                for iy in 0:vs {
                                    for ix in 0:hs {
                                        dx := gbx * 8 * hs + x * hs + ix
                                        dy := gby * 8 * vs + y * vs + iy
                                        if dx < d.width && dy < d.height {
                                            planes[off + dy * d.width + dx] = sample
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    $img := image.new_rgba(image.rect(0, 0, d.width, d.height))
    if d.ncomp == 1 {
        for y in 0:d.height {
            for x in 0:d.width {
                v := planes[y * d.width + x] & 255
                rgb := color.ycbcr_to_rgb(v, 128, 128)
                img.set_rgba(x, y, rgb)
            }
        }
        << img
    }
    yoff := 0
    coff := d.width * d.height
    roff := 2 * d.width * d.height
    for y in 0:d.height {
        for x in 0:d.width {
            yy := planes[yoff + y * d.width + x]
            cb := planes[coff + y * d.width + x]
            cr := planes[roff + y * d.width + x]
            rgb := color.ycbcr_to_rgb(yy, cb, cr)
            img.set_rgba(x, y, rgb)
        }
    }
    << img
}

pub fn decode(data &string) image.RGBA {
    src := data + ""
    if src.len < 4 {
        >> errors.new("jpeg: truncated")
    }
    $d := Dec{
        data: src,
        pos: 0,
        cur: 0,
        nbits: 0,
        width: 0,
        height: 0,
        ncomp: 0,
        hmax: 0,
        vmax: 0,
        cid: []int{},
        ch: []int{},
        cv: []int{},
        ctq: []int{},
        ctd: []int{},
        cta: []int{},
        dcpred: []int{},
        qt: []int{},
        dc: tabs_empty(),
        ac: tabs_empty(),
        err: ""
    }
    if d.read_u8() != 255 || d.read_u8() != 216 {
        >> errors.new("jpeg: missing SOI")
    }
    $saw_sof := 0
    $spinning := 1
    while spinning == 1 {
        if d.err.len > 0 {
            >> errors.new(d.err + "")
        }
        if d.pos >= d.data.len {
            >> errors.new("jpeg: truncated before EOI")
        }
        if (d.data[d.pos] & 255) != 255 {
            >> errors.new("jpeg: expected marker")
        }
        d.pos = d.pos + 1
        while d.pos < d.data.len && (d.data[d.pos] & 255) == 255 {
            d.pos = d.pos + 1
        }
        if d.pos >= d.data.len {
            >> errors.new("jpeg: truncated marker")
        }
        m := d.read_u8()
        if m == 216 {
            ->
        }
        if m == 217 {
            >> errors.new("jpeg: EOI before SOS")
        }
        if m == 192 {
            if saw_sof != 0 {
                >> errors.new("jpeg: duplicate SOF0")
            }
            d.parse_sof0()
            saw_sof = 1
            ->
        }
        if m == 219 {
            d.parse_dqt()
            ->
        }
        if m == 196 {
            d.parse_dht()
            ->
        }
        if m == 218 {
            if saw_sof == 0 {
                >> errors.new("jpeg: SOS before SOF0")
            }
            if d.parse_sos() == 0 {
                >> errors.new(d.err + "")
            }
            spinning = 0
            << d.decode_scan()
        }
        if m == 221 {
            seglen := d.read_u16()
            if seglen < 4 {
                >> errors.new("jpeg: bad DRI")
            }
            d.skip(seglen - 2)
            ->
        }
        if (m >= 224 && m <= 239) || m == 254 || m == 204 {
            seglen := d.read_u16()
            if seglen < 2 {
                >> errors.new("jpeg: bad segment length")
            }
            d.skip(seglen - 2)
            ->
        }
        if m >= 193 && m <= 207 {
            >> errors.new("jpeg: only baseline SOF0 supported")
        }
        >> errors.new("jpeg: unsupported marker")
    }
    >> errors.new("jpeg: no image data")
}
