@image/gif


#errors
#compress/lzw
#image
#image/color

// GIF87a/GIF89a first-frame decode + encode aligned with Go `image/gif`
// Decode / Encode of a paletted 2-D image. No animation, no interlace,
// no Image interface: pixels land in image.RGBA.

pub struct GIF {
    pub width int
    pub height int
    pub img image.RGBA
}

fn packed_size(n int) int {
    $s := 2
    $bits := 0
    while s < n {
        s = s * 2
        bits = bits + 1
    }
    << bits
}

fn skip_sub_blocks(data &string, off int) int {
    src := data + ""
    $p := off
    while p < src.len {
        n := src[p] & 255
        p = p + 1
        if n == 0 {
            << p
        }
        if p + n > src.len {
            >> errors.new("gif: truncated block")
        }
        p = p + n
    }
    >> errors.new("gif: truncated block")
}

fn read_color_table(data &string, off int, n int) []color.RGBA {
    src := data + ""
    need := 3 * n
    if off + need > src.len {
        >> errors.new("gif: truncated color table")
    }
    $pal := []color.RGBA{}
    $j := off
    for i in 0:n {
        pal.push(color.rgba8(src[j] & 255, src[j + 1] & 255, src[j + 2] & 255, 255))
        j = j + 3
        _ := i
    }
    << pal
}

pub fn decode(src &string) GIF {
    data := src + ""
    if data.len < 13 {
        >> errors.new("gif: truncated header")
    }
    sig := data[0:6] + ""
    if sig != "GIF87a" && sig != "GIF89a" {
        >> errors.new("gif: unrecognized format")
    }
    width := (data[6] & 255) | ((data[7] & 255) * 256)
    height := (data[8] & 255) | ((data[9] & 255) * 256)
    fields := data[10] & 255
    $p := 13
    $pal := []color.RGBA{}
    if (fields & 128) != 0 {
        n := 1 << (1 + (fields & 7))
        pr := read_color_table(&data, p, n)
                pal = pr
        p = p + 3 * n
    }
    $got := 0
    $img := image.new_rgba(image.rect(0, 0, width, height))
    while p < data.len {
        b := data[p] & 255
        p = p + 1
        if b == 59 {
            <-
        }
        if b == 33 {
            if p >= data.len {
                >> errors.new("gif: truncated extension")
            }
            p = p + 1
            sr := skip_sub_blocks(&data, p)
                        p = sr
            ->
        }
        if b != 44 {
            >> errors.new("gif: unknown block")
        }
        if p + 9 > data.len {
            >> errors.new("gif: truncated image descriptor")
        }
        left := (data[p] & 255) | ((data[p + 1] & 255) * 256)
        top := (data[p + 2] & 255) | ((data[p + 3] & 255) * 256)
        iw := (data[p + 4] & 255) | ((data[p + 5] & 255) * 256)
        ih := (data[p + 6] & 255) | ((data[p + 7] & 255) * 256)
        ifields := data[p + 8] & 255
        p = p + 9
        if (ifields & 64) != 0 {
            >> errors.new("gif: interlaced images not supported")
        }
        if (ifields & 128) != 0 {
            n := 1 << (1 + (ifields & 7))
            pr := read_color_table(&data, p, n)
                        pal = pr
            p = p + 3 * n
        }
        if pal.len == 0 {
            >> errors.new("gif: no color table")
        }
        if p >= data.len {
            >> errors.new("gif: truncated image data")
        }
        lit := data[p] & 255
        p = p + 1
        if lit < 2 || lit > 8 {
            >> errors.new("gif: pixel size out of range")
        }
        $lzwb := []int{}
        $done_blk := 0
        while done_blk == 0 {
            if p >= data.len {
                >> errors.new("gif: truncated image data")
            }
            n := data[p] & 255
            p = p + 1
            if n == 0 {
                done_blk = 1
                ->
            }
            if p + n > data.len {
                >> errors.new("gif: truncated image data")
            }
            for k in 0:n {
                lzwb.push(data[p] & 255)
                p = p + 1
            }
        }
        raw := string_from_bytes(lzwb)
        pixr := lzw.decode(&raw, lzw.LSB, lit)
                pix := pixr
        need := iw * ih
        if pix.len < need {
            >> errors.new("gif: not enough image data")
        }
        $y := 0
        while y < ih {
            $x := 0
            while x < iw {
                idx := pix[y * iw + x] & 255
                if idx >= pal.len {
                    >> errors.new("gif: invalid pixel value")
                }
                c := pal[idx]
                img.set_rgba(left + x, top + y, c)
                x = x + 1
            }
            y = y + 1
        }
        got = 1
        <-
    }
    if got == 0 {
        >> errors.new("gif: missing image data")
    }
    << GIF{width: width, height: height, img: img}
}

pub fn at(g &GIF, x int, y int) color.RGBA {
    << g.img.at_rgba(x, y)
}

fn nearest(pal &[]color.RGBA, r int, g int, b int) int {
    $best := 0
    $bd := 195075
    for i in 0:pal.len {
        dr := (pal[i].r & 255) - r
        dg := (pal[i].g & 255) - g
        db := (pal[i].b & 255) - b
        d := dr * dr + dg * dg + db * db
        if d < bd {
            bd = d
            best = i
        }
    }
    << best
}

pub fn encode_rgba(img &image.RGBA, pal &[]color.RGBA) string {
    if pal.len < 1 || pal.len > 256 {
        >> errors.new("gif: palette size out of range")
    }
    w := img.rect.dx()
    h := img.rect.dy()
    if w < 1 || h < 1 || w > 65535 || h > 65535 {
        >> errors.new("gif: image size out of range")
    }
    bits := packed_size(pal.len)
    nct := 1 << (1 + bits)
    $lit := bits + 1
    if lit < 2 {
        lit = 2
    }
    $idx := []int{}
    for y in 0:h {
        for x in 0:w {
            c := img.at_rgba(img.rect.min.x + x, img.rect.min.y + y)
            idx.push(nearest(pal, c.r & 255, c.g & 255, c.b & 255))
        }
    }
    pix := string_from_bytes(idx)
    enc := lzw.encode(&pix, lzw.LSB, lit)
        lzwd := enc
    $out := []int{}
    hdr := "GIF89a"
    for i in 0:hdr.len {
        out.push(hdr[i] & 255)
    }
    out.push(w & 255)
    out.push((w / 256) & 255)
    out.push(h & 255)
    out.push((h / 256) & 255)
    out.push(128 | bits)
    out.push(0)
    out.push(0)
    for i in 0:nct {
        if i < pal.len {
            out.push(pal[i].r & 255)
            out.push(pal[i].g & 255)
            out.push(pal[i].b & 255)
        } else {
            out.push(0)
            out.push(0)
            out.push(0)
        }
    }
    out.push(44)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(w & 255)
    out.push((w / 256) & 255)
    out.push(h & 255)
    out.push((h / 256) & 255)
    out.push(0)
    out.push(lit)
    $off := 0
    while off < lzwd.len {
        $n := lzwd.len - off
        if n > 255 {
            n = 255
        }
        out.push(n)
        for k in 0:n {
            out.push(lzwd[off + k] & 255)
        }
        off = off + n
    }
    out.push(0)
    out.push(59)
    << string_from_bytes(out)
}
