@compress/flate


#errors
// RFC1951 inflate and bounded LZ77 compression with fixed Huffman codes.

const MAX_BITS = 15

struct BitReader {
    data string
    pos int
    bitbuf int
    bitcnt int
    err string
    output_limit int
}

fn br_new(data &string) BitReader {
    << BitReader{data: data + "", pos: 0, bitbuf: 0, bitcnt: 0, err: "", output_limit: 0}
}

fn (b &mut BitReader) fail(msg string) {
    if b.err.len == 0 {
        b.err = msg + ""
    }
}

fn (b &mut BitReader) need(n int) bool {
    while b.bitcnt < n {
        if b.pos >= b.data.len {
            b.fail("flate: unexpected EOF")
            << false
        }
        b.bitbuf = b.bitbuf | ((b.data[b.pos] & 255) << b.bitcnt)
        b.pos = b.pos + 1
        b.bitcnt = b.bitcnt + 8
    }
    << true
}

fn (b &mut BitReader) bits(n int) int {
    if n == 0 {
        << 0
    }
    if !b.need(n) {
        << 0
    }
    v := b.bitbuf & ((1 << n) - 1)
    b.bitbuf = b.bitbuf >> n
    b.bitcnt = b.bitcnt - n
    << v
}

fn (b &mut BitReader) bit1() int {
    << b.bits(1)
}

fn (b &mut BitReader) align() {
    b.bitbuf = 0
    b.bitcnt = 0
}

struct Huf {
    count []int
    symbol []int
    max_len int
}

fn build_huf(lengths []int) Huf {
    mut count := []int{}
    for i in 0:MAX_BITS + 1 {
        count.push(0)
        _ := i
    }
    mut max_l := 0
    for i in 0:lengths.len {
        l := lengths[i]
        if l < 0 || l > MAX_BITS {
            >> errors.new("flate: bad code length")
        }
        if l != 0 {
            count[l] = count[l] + 1
            if l > max_l {
                max_l = l
            }
        }
    }
    mut symbol := []int{}
    // offs[len] = starting index in symbol[] for that length
    mut offs := []int{}
    for i in 0:MAX_BITS + 1 {
        offs.push(0)
        _ := i
    }
    mut sum := 0
    for len in 1:MAX_BITS + 1 {
        offs[len] = sum
        sum = sum + count[len]
    }
    for i in 0:sum {
        symbol.push(0)
        _ := i
    }
    for sym in 0:lengths.len {
        l := lengths[sym]
        if l != 0 {
            symbol[offs[l]] = sym
            offs[l] = offs[l] + 1
        }
    }
    << Huf{count: count, symbol: symbol, max_len: max_l}
}

fn (b &mut BitReader) decode(h &Huf) int {
    if h.max_len == 0 {
        b.fail("flate: empty Huffman")
        << -1
    }
    mut code := 0
    mut first := 0
    mut index := 0
    mut len := 1
    while len <= h.max_len {
        bit := b.bit1()
        if b.err.len > 0 {
            << -1
        }
        code = (code << 1) | bit
        count := h.count[len]
        if code - first < count {
            << h.symbol[index + (code - first)]
        }
        index = index + count
        first = first + count
        first = first << 1
        len = len + 1
    }
    b.fail("flate: invalid Huffman code")
    << -1
}

fn length_base(code int) int {
    if code == 257 { << 3 }
    if code == 258 { << 4 }
    if code == 259 { << 5 }
    if code == 260 { << 6 }
    if code == 261 { << 7 }
    if code == 262 { << 8 }
    if code == 263 { << 9 }
    if code == 264 { << 10 }
    if code == 265 { << 11 }
    if code == 266 { << 13 }
    if code == 267 { << 15 }
    if code == 268 { << 17 }
    if code == 269 { << 19 }
    if code == 270 { << 23 }
    if code == 271 { << 27 }
    if code == 272 { << 31 }
    if code == 273 { << 35 }
    if code == 274 { << 43 }
    if code == 275 { << 51 }
    if code == 276 { << 59 }
    if code == 277 { << 67 }
    if code == 278 { << 83 }
    if code == 279 { << 99 }
    if code == 280 { << 115 }
    if code == 281 { << 131 }
    if code == 282 { << 163 }
    if code == 283 { << 195 }
    if code == 284 { << 227 }
    << 258
}

fn length_extra(code int) int {
    if code >= 257 && code <= 264 { << 0 }
    if code >= 265 && code <= 268 { << 1 }
    if code >= 269 && code <= 272 { << 2 }
    if code >= 273 && code <= 276 { << 3 }
    if code >= 277 && code <= 280 { << 4 }
    if code >= 281 && code <= 284 { << 5 }
    << 0
}

fn dist_base(code int) int {
    if code == 0 { << 1 }
    if code == 1 { << 2 }
    if code == 2 { << 3 }
    if code == 3 { << 4 }
    if code == 4 { << 5 }
    if code == 5 { << 7 }
    if code == 6 { << 9 }
    if code == 7 { << 13 }
    if code == 8 { << 17 }
    if code == 9 { << 25 }
    if code == 10 { << 33 }
    if code == 11 { << 49 }
    if code == 12 { << 65 }
    if code == 13 { << 97 }
    if code == 14 { << 129 }
    if code == 15 { << 193 }
    if code == 16 { << 257 }
    if code == 17 { << 385 }
    if code == 18 { << 513 }
    if code == 19 { << 769 }
    if code == 20 { << 1025 }
    if code == 21 { << 1537 }
    if code == 22 { << 2049 }
    if code == 23 { << 3073 }
    if code == 24 { << 4097 }
    if code == 25 { << 6145 }
    if code == 26 { << 8193 }
    if code == 27 { << 12289 }
    if code == 28 { << 16385 }
    << 24577
}

fn dist_extra(code int) int {
    if code <= 3 { << 0 }
    if code <= 5 { << 1 }
    if code <= 7 { << 2 }
    if code <= 9 { << 3 }
    if code <= 11 { << 4 }
    if code <= 13 { << 5 }
    if code <= 15 { << 6 }
    if code <= 17 { << 7 }
    if code <= 19 { << 8 }
    if code <= 21 { << 9 }
    if code <= 23 { << 10 }
    if code <= 25 { << 11 }
    if code <= 27 { << 12 }
    << 13
}

fn fixed_lit_lengths() []int {
    mut lens := []int{}
    for i in 0:144 {
        lens.push(8)
        _ := i
    }
    for i in 144:256 {
        lens.push(9)
        _ := i
    }
    for i in 256:280 {
        lens.push(7)
        _ := i
    }
    for i in 280:288 {
        lens.push(8)
        _ := i
    }
    << lens
}

fn fixed_dist_lengths() []int {
    mut lens := []int{}
    for i in 0:32 {
        lens.push(5)
        _ := i
    }
    << lens
}

fn (b &mut BitReader) inflate_codes(out0 string, lit &Huf, dist &Huf) string {
    mut out := out0
    while true {
        sym := b.decode(lit)
        if b.err.len > 0 {
            >> errors.new(b.err + "")
        }
        if sym < 256 {
            if b.output_limit > 0 && out.len >= b.output_limit { >> errors.new("flate: output exceeds limit") }
            out.push_byte(sym)
            ->
        }
        if sym == 256 {
            << out
        }
        if sym < 257 || sym > 285 {
            >> errors.new("flate: bad length symbol")
        }
        length := length_base(sym) + b.bits(length_extra(sym))
        if b.err.len > 0 {
            >> errors.new(b.err + "")
        }
        dsym := b.decode(dist)
        if b.err.len > 0 {
            >> errors.new(b.err + "")
        }
        if dsym < 0 || dsym > 29 {
            >> errors.new("flate: bad dist symbol")
        }
        distance := dist_base(dsym) + b.bits(dist_extra(dsym))
        if b.err.len > 0 {
            >> errors.new(b.err + "")
        }
        if distance <= 0 || distance > out.len {
            >> errors.new("flate: invalid distance")
        }
        if b.output_limit > 0 && length > b.output_limit - out.len { >> errors.new("flate: output exceeds limit") }
        for i in 0:length {
            value := out[out.len - distance]
            out.push_byte(value)
            _ := i
        }
    }
    << out
}

fn (b &mut BitReader) inflate_stored(out0 string) string {
    b.align()
    if b.pos + 4 > b.data.len {
        >> errors.new("flate: stored header EOF")
    }
    length := (b.data[b.pos] & 255) | ((b.data[b.pos + 1] & 255) << 8)
    nlength := (b.data[b.pos + 2] & 255) | ((b.data[b.pos + 3] & 255) << 8)
    b.pos = b.pos + 4
    if ((length ^ 65535) & 65535) != nlength {
        >> errors.new("flate: bad stored NLEN")
    }
    if b.pos + length > b.data.len {
        >> errors.new("flate: stored data EOF")
    }
    mut out := out0
    if b.output_limit > 0 && length > b.output_limit - out.len { >> errors.new("flate: output exceeds limit") }
    out.push_str(b.data[b.pos:b.pos + length])
    b.pos = b.pos + length
    << out
}

fn clen_order(i int) int {
    if i == 0 { << 16 }
    if i == 1 { << 17 }
    if i == 2 { << 18 }
    if i == 3 { << 0 }
    if i == 4 { << 8 }
    if i == 5 { << 7 }
    if i == 6 { << 9 }
    if i == 7 { << 6 }
    if i == 8 { << 10 }
    if i == 9 { << 5 }
    if i == 10 { << 11 }
    if i == 11 { << 4 }
    if i == 12 { << 12 }
    if i == 13 { << 3 }
    if i == 14 { << 13 }
    if i == 15 { << 2 }
    if i == 16 { << 14 }
    if i == 17 { << 1 }
    << 15
}

fn (b &mut BitReader) inflate_dynamic(out0 string) string {
    hlit := b.bits(5) + 257
    hdist := b.bits(5) + 1
    hclen := b.bits(4) + 4
    if b.err.len > 0 {
        >> errors.new(b.err + "")
    }
    mut clen_lens := []int{}
    for i in 0:19 {
        clen_lens.push(0)
        _ := i
    }
    for i in 0:hclen {
        clen_lens[clen_order(i)] = b.bits(3)
        if b.err.len > 0 {
            >> errors.new(b.err + "")
        }
    }
    ch_r := build_huf(clen_lens)
        ch := ch_r
    total := hlit + hdist
    mut all_lens := []int{}
    for i in 0:total {
        all_lens.push(0)
        _ := i
    }
    mut idx := 0
    while idx < total {
        sym := b.decode(&ch)
        if b.err.len > 0 {
            >> errors.new(b.err + "")
        }
        if sym < 16 {
            all_lens[idx] = sym
            idx = idx + 1
        } else if sym == 16 {
            if idx == 0 {
                >> errors.new("flate: repeat with no length")
            }
            rep := 3 + b.bits(2)
            prev := all_lens[idx - 1]
            for j in 0:rep {
                if idx >= total {
                    >> errors.new("flate: repeat overflow")
                }
                all_lens[idx] = prev
                idx = idx + 1
                _ := j
            }
        } else if sym == 17 {
            rep := 3 + b.bits(3)
            for j in 0:rep {
                if idx >= total {
                    >> errors.new("flate: zero repeat overflow")
                }
                all_lens[idx] = 0
                idx = idx + 1
                _ := j
            }
        } else if sym == 18 {
            rep := 11 + b.bits(7)
            for j in 0:rep {
                if idx >= total {
                    >> errors.new("flate: long zero overflow")
                }
                all_lens[idx] = 0
                idx = idx + 1
                _ := j
            }
        } else {
            >> errors.new("flate: bad code-length symbol")
        }
    }
    mut lit_lens := []int{}
    for i in 0:hlit {
        lit_lens.push(all_lens[i])
    }
    mut dist_lens := []int{}
    for i in 0:hdist {
        dist_lens.push(all_lens[hlit + i])
    }
    // Special case: if only one distance code, some encoders use length 0 —
    // RFC allows one dist code of length 1.
    lit_r := build_huf(lit_lens)
        dist_r := build_huf(dist_lens)
        lit := lit_r
    dist := dist_r
    << b.inflate_codes(out0, &lit, &dist)
}

pub fn inflate(src &string) string { << inflate_limit(src, 0) or >> }

// A positive limit caps bytes before appending or expanding backreferences.
pub fn inflate_limit(src &string, limit int) string {
    mut b := br_new(src)
    b.output_limit = limit
    mut out := ""
    while true {
        bfinal := b.bits(1)
        btype := b.bits(2)
        if b.err.len > 0 {
            >> errors.new(b.err + "")
        }
        if btype == 0 {
            r := b.inflate_stored(out + "")
                        out = r + ""
        } else if btype == 1 {
            lit := build_huf(fixed_lit_lengths())
            dist := build_huf(fixed_dist_lengths())
            r := b.inflate_codes(out + "", &lit, &dist)
                        out = r + ""
        } else if btype == 2 {
            r := b.inflate_dynamic(out + "")
                        out = r + ""
        } else {
            >> errors.new("flate: invalid BTYPE")
        }
        if bfinal == 1 {
            <-
        }
    }
    << out + ""
}

struct BitWriter {
    out string
    bitbuf int
    bitcnt int
}

fn bw_new() BitWriter {
    << BitWriter{out: "", bitbuf: 0, bitcnt: 0}
}

fn (w &mut BitWriter) bits(v int, n int) {
    if n <= 0 {
        <<
    }
    w.bitbuf = w.bitbuf | ((v & ((1 << n) - 1)) << w.bitcnt)
    w.bitcnt = w.bitcnt + n
    while w.bitcnt >= 8 {
        w.out = w.out + string_from_byte(w.bitbuf & 255)
        w.bitbuf = w.bitbuf >> 8
        w.bitcnt = w.bitcnt - 8
    }
}

fn (w &mut BitWriter) bit1(v int) {
    w.bits(v & 1, 1)
}

fn (w &mut BitWriter) flush() {
    if w.bitcnt > 0 {
        w.out = w.out + string_from_byte(w.bitbuf & 255)
        w.bitbuf = 0
        w.bitcnt = 0
    }
}

fn (w &mut BitWriter) huf(code int, length int) {
    // msb of code first into lsb-first bit stream (mirrors BitReader.decode)
    mut i := length - 1
    while i >= 0 {
        w.bit1((code >> i) & 1)
        i = i - 1
    }
}

fn build_encode_table(lengths []int) []int {
    // returns parallel arrays packed as code in low 16, length in high...
    // simpler: two arrays via << of codes only + reuse lengths
    mut count := []int{}
    for i in 0:MAX_BITS + 1 {
        count.push(0)
        _ := i
    }
    for i in 0:lengths.len {
        l := lengths[i]
        if l != 0 {
            count[l] = count[l] + 1
        }
    }
    mut next_code := []int{}
    for i in 0:MAX_BITS + 1 {
        next_code.push(0)
        _ := i
    }
    mut code := 0
    for bits in 1:MAX_BITS + 1 {
        code = (code + count[bits - 1]) << 1
        next_code[bits] = code
    }
    mut codes := []int{}
    for i in 0:lengths.len {
        codes.push(0)
        _ := i
    }
    for sym in 0:lengths.len {
        l := lengths[sym]
        if l != 0 {
            codes[sym] = next_code[l]
            next_code[l] = next_code[l] + 1
        }
    }
    << codes
}

fn match_hash(data &string, pos int) int {
    << (((data[pos] & 255) * 251 + (data[pos + 1] & 255)) * 251 + (data[pos + 2] & 255)) & 32767
}

fn emit_match(w &mut BitWriter, lens &[]int, codes &[]int, length int, distance int) {
    mut sym := 257
    while sym < 285 && length >= length_base(sym + 1) {
        sym += 1
    }
    w.huf(codes[sym], lens[sym])
    w.bits(length - length_base(sym), length_extra(sym))
    mut dsym := 0
    while dsym < 29 && distance >= dist_base(dsym + 1) {
        dsym += 1
    }
    w.huf(dsym, 5)
    w.bits(distance - dist_base(dsym), dist_extra(dsym))
}

fn stored_deflate(data &string) string {
    mut w := bw_new()
    mut pos := 0
    while pos < data.len {
        mut count := data.len - pos
        if count > 65535 { count = 65535 }
        mut final := 0
        if pos + count == data.len { final = 1 }
        w.bit1(final)
        w.bits(0, 2)
        w.flush()
        w.bits(count, 16)
        w.bits(count ^ 65535, 16)
        w.out = w.out + data[pos:pos + count]
        pos += count
    }
    << w.out + ""
}

pub fn deflate(src &string) string {
    data := src + ""
    // Empty: keep compact stored empty block (compatible with inflate).
    if data.len == 0 {
        mut out0 := ""
        out0 = out0 + string_from_byte(1)
        out0 = out0 + string_from_byte(0)
        out0 = out0 + string_from_byte(0)
        out0 = out0 + string_from_byte(255)
        out0 = out0 + string_from_byte(255)
        << out0
    }
    lens := fixed_lit_lengths()
    mut lens2 := []int{}
    for i in 0:lens.len {
        lens2.push(lens[i])
    }
    codes := build_encode_table(lens2)
    mut w := bw_new()
    w.bit1(1)
    w.bits(1, 2)
    // Ring links retain only the RFC's 32 KiB history. Bound each hash-chain
    // walk so incompressible/adversarial input cannot cause quadratic work.
    mut heads := []int{}
    mut previous := []int{}
    for i in 0:32768 {
        heads.push(-1)
        previous.push(-1)
    }
    mut pos := 0
    while pos < data.len {
        mut length := 0
        mut distance := 0
        if pos + 2 < data.len {
            h := match_hash(&data, pos)
            mut candidate := heads[h]
            mut remaining := 258
            if data.len - pos < remaining { remaining = data.len - pos }
            for probe in 0:64 {
                if candidate < 0 || candidate >= pos || pos - candidate > 32768 { <- }
                mut n := 0
                while n < remaining && data[candidate + n] == data[pos + n] { n += 1 }
                if n >= 3 && n > length {
                    length = n
                    distance = pos - candidate
                    if n == remaining { <- }
                }
                next := previous[candidate & 32767]
                if next >= candidate { <- }
                candidate = next
            }
        }
        mut consumed := 1
        if length >= 3 {
            emit_match(mut &w, &lens, &codes, length, distance)
            consumed = length
        } else {
            sym := data[pos] & 255
            w.huf(codes[sym], lens[sym])
        }
        for offset in 0:consumed {
            p := pos + offset
            if p + 2 < data.len {
                h := match_hash(&data, p)
                previous[p & 32767] = heads[h]
                heads[h] = p
            }
        }
        pos += consumed
    }
    w.huf(codes[256], lens[256])
    w.flush()
    // Literal Huffman codes can expand random bytes. Prefer stored blocks
    // whenever their framing costs fewer bytes than the encoded stream.
    overhead := ((data.len - 1) / 65535 + 1) * 5
    if w.out.len - data.len > overhead { << stored_deflate(&data) }
    << w.out + ""
}
