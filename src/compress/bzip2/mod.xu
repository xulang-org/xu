@compress/bzip2

#errors

// Go `compress/bzip2` Reader subset. Decode owning strings (no io.Reader).
// Go stdlib has no Writer. Bitstream is msb-first. Randomized blocks rejected.

const U32_MAX = 4294967295
const POLY = 79764919
const RUNA = 0
const RUNB = 1

pub struct Reader {
    pub data string
}

pub fn new_reader(data string) Reader {
    << Reader{data: data}
}

struct BitReader {
    data string
    pos int
    buf int
    nbits int
}

fn br_new(data &string) BitReader {
    << BitReader{data: data + "", pos: 0, buf: 0, nbits: 0}
}

fn (b &mut BitReader) bits(n int) int {
    if n <= 0 {
        << 0
    }
    while b.nbits < n {
        if b.pos >= b.data.len {
            >> errors.new("bzip2: unexpected EOF")
        }
        b.buf = (b.buf << 8) | (b.data[b.pos] & 255)
        b.pos = b.pos + 1
        b.nbits = b.nbits + 8
    }
    b.nbits = b.nbits - n
    mask := (1 << n) - 1
    << (b.buf >> b.nbits) & mask
}

// Gen1 poisons computed indices (`xs[k - 1]`, `xs[a * n + b]`) inside
// large decode fns — same class as path.clean / png unfilter / lzw.
fn at_i(xs &[]int, i int) int {
    << xs[i]
}

fn set_i(xs &mut []int, i int, v int) {
    xs[i] = v
}

fn to_front(xs &mut []int, j int) int {
    v := xs[j]
    mut k := j
    while k > 0 {
        prev := k - 1
        xs[k] = xs[prev]
        k = prev
    }
    xs[0] = v
    << v
}

fn crc_msb_set(c int) bool {
    << c > 2147483647
}

fn crc_update(crc0 int, buf &[]int) int {
    mut c := (crc0 & U32_MAX) ^ U32_MAX
    mut i := 0
    while i < buf.len {
        b := buf[i] & 255
        c = (c ^ (b << 24)) & U32_MAX
        mut k := 0
        while k < 8 {
            // Bit-31 test via tiny helper: `c & 2147483648` miscompiles
            // the 0x80000000 immediate (Gen1 / GENERIC_READ class).
            if crc_msb_set(c) {
                c = ((c << 1) ^ POLY) & U32_MAX
            } else {
                c = (c << 1) & U32_MAX
            }
            k = k + 1
        }
        i = i + 1
    }
    << (c ^ U32_MAX) & U32_MAX
}

struct Huff {
    n int
    lens []int
    codes []int
    syms []int
}

fn huff_build(lens []int) Huff {
    n := lens.len
    mut maxl := 0
    mut i := 0
    while i < n {
        li := at_i(&lens, i)
        if li > maxl {
            maxl = li
        }
        i = i + 1
    }
    mut codes := []int{}
    mut syms := []int{}
    mut ls := []int{}
    i = 0
    while i < n {
        codes.push(0)
        syms.push(i)
        ls.push(at_i(&lens, i))
        i = i + 1
    }
    mut code := 0
    mut prev := 0
    mut ln := 1
    while ln <= maxl {
        mut s := 0
        while s < n {
            if at_i(&ls, s) == ln {
                if prev != 0 {
                    code = code << (ln - prev)
                } else {
                    code = 0
                }
                set_i(mut &codes, s, code)
                code = code + 1
                prev = ln
            }
            s = s + 1
        }
        ln = ln + 1
    }
    << Huff{n: n, lens: ls, codes: codes, syms: syms}
}

fn huff_decode(h &Huff, b &mut BitReader) int {
    mut code := 0
    mut ln := 0
    while ln < 24 {
        bit := b.bits(1) or >>
        code = (code << 1) | bit
        ln = ln + 1
        mut i := 0
        while i < h.n {
            if h.lens[i] == ln && h.codes[i] == code {
                << h.syms[i]
            }
            i = i + 1
        }
    }
    >> errors.new("bzip2: invalid huffman code")
    << 0
}

fn expand_rle4(src &[]int) []int {
    mut out := []int{}
    mut last := -1
    mut run := 0
    mut i := 0
    while i < src.len {
        b := at_i(src, i)
        i = i + 1
        if run == 4 {
            mut r := 0
            while r < b {
                out.push(last)
                r = r + 1
            }
            run = 0
        } else {
            out.push(b)
            if b == last {
                run = run + 1
            } else {
                last = b
                run = 1
            }
        }
    }
    << out
}

fn inverse_bwt(tt &[]int, orig int) []int {
    n := tt.len
    mut c := []int{}
    mut i := 0
    while i < 256 {
        c.push(0)
        i = i + 1
    }
    i = 0
    while i < n {
        b := at_i(tt, i) & 255
        cur := at_i(&c, b)
        set_i(mut &c, b, cur + 1)
        i = i + 1
    }
    mut sum := 0
    i = 0
    while i < 256 {
        t := at_i(&c, i)
        set_i(mut &c, i, sum)
        sum = sum + t
        i = i + 1
    }
    mut next := []int{}
    i = 0
    while i < n {
        next.push(0)
        i = i + 1
    }
    i = 0
    while i < n {
        b := at_i(tt, i) & 255
        pos := at_i(&c, b)
        set_i(mut &next, pos, i)
        set_i(mut &c, b, pos + 1)
        i = i + 1
    }
    mut out := []int{}
    mut idx := orig
    i = 0
    while i < n {
        idx = at_i(&next, idx)
        out.push(at_i(tt, idx) & 255)
        i = i + 1
    }
    << out
}

fn decode_selectors(b &mut BitReader, ng int, nsel int) []int {
    mut mtf := []int{}
    mut i := 0
    while i < ng {
        mtf.push(i)
        i = i + 1
    }
    mut selectors := []int{}
    i = 0
    while i < nsel {
        mut j := 0
        mut bit := b.bits(1) or >>
        while bit == 1 {
            j = j + 1
            if j >= ng {
                >> errors.new("bzip2: bad selector")
            }
            bit = b.bits(1) or >>
        }
        v := to_front(mut &mtf, j)
        selectors.push(v)
        i = i + 1
    }
    << selectors
}

fn decode_huff_lens(b &mut BitReader, ng int, nsym int) []int {
    mut all_lens := []int{}
    mut g := 0
    while g < ng {
        mut cur := b.bits(5) or >>
        mut s := 0
        while s < nsym {
            mut bit := b.bits(1) or >>
            while bit == 1 {
                two := b.bits(1) or >>
                if two == 0 {
                    cur = cur + 1
                } else {
                    cur = cur - 1
                }
                if cur < 1 || cur > 20 {
                    >> errors.new("bzip2: bad huffman length")
                }
                bit = b.bits(1) or >>
            }
            all_lens.push(cur)
            s = s + 1
        }
        g = g + 1
    }
    << all_lens
}

fn lens_for_table(all_lens &[]int, tix int, nsym int) []int {
    mut lens := []int{}
    mut s2 := 0
    base := tix * nsym
    while s2 < nsym {
        lens.push(at_i(all_lens, base + s2))
        s2 = s2 + 1
    }
    << lens
}

fn push_repeat(decoded &mut []int, emit int, repeats int) {
    mut r := 0
    while r < repeats {
        decoded.push(emit)
        r = r + 1
    }
}

fn decode_mtf_stream(b &mut BitReader, yy0 &[]int, n_in int, nsym int, selectors &[]int, all_lens &[]int) []int {
    mut yy := []int{}
    mut i := 0
    while i < yy0.len {
        yy.push(at_i(yy0, i))
        i = i + 1
    }
    mut decoded := []int{}
    mut repeats := 0
    mut rpow := 0
    mut sel := 0
    mut group_pos := 50
    mut tix := 0
    mut ht := huff_build([]int{})
    mut done := 0
    while done == 0 {
        if group_pos == 50 {
            if sel >= selectors.len {
                >> errors.new("bzip2: too many selectors")
            }
            tix = at_i(selectors, sel)
            sel = sel + 1
            group_pos = 0
            lens := lens_for_table(all_lens, tix, nsym)
            ht = huff_build(lens)
        }
        group_pos = group_pos + 1
        v := huff_decode(&ht, b) or >>
        if v == n_in + 1 {
            done = 1
        } else if v == RUNA || v == RUNB {
            if repeats == 0 {
                rpow = 1
            }
            repeats = repeats + rpow
            if v == RUNB {
                repeats = repeats + rpow
            }
            rpow = rpow * 2
        } else {
            if repeats > 0 {
                push_repeat(mut &decoded, at_i(&yy, 0), repeats)
                repeats = 0
            }
            idx := v - 1
            if idx < 0 || idx >= yy.len {
                >> errors.new("bzip2: bad mtf index")
            }
            bval := to_front(mut &yy, idx)
            decoded.push(bval)
        }
    }
    if repeats > 0 {
        push_repeat(mut &decoded, at_i(&yy, 0), repeats)
    }
    << decoded
}

fn decode_block(b &mut BitReader) []int {
    crc := b.bits(32) or >>
    randb := b.bits(1) or >>
    if randb != 0 {
        >> errors.new("bzip2: randomized block not supported")
    }
    orig := b.bits(24) or >>
    umap := b.bits(16) or >>
    mut used := []int{}
    mut i := 0
    while i < 256 {
        used.push(0)
        i = i + 1
    }
    mut n_in := 0
    i = 0
    while i < 16 {
        if (umap & (32768 >> i)) != 0 {
            bits16 := b.bits(16) or >>
            mut j := 0
            while j < 16 {
                if (bits16 & (32768 >> j)) != 0 {
                    set_i(mut &used, i * 16 + j, 1)
                    n_in = n_in + 1
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    if n_in == 0 {
        >> errors.new("bzip2: empty mapping")
    }
    mut seq := []int{}
    i = 0
    while i < 256 {
        if at_i(&used, i) != 0 {
            seq.push(i)
        }
        i = i + 1
    }
    nsym := n_in + 2
    ng := b.bits(3) or >>
    if ng < 2 || ng > 6 {
        >> errors.new("bzip2: invalid huffman groups")
    }
    nsel := b.bits(15) or >>
    if nsel < 1 {
        >> errors.new("bzip2: no selectors")
    }
    selectors := decode_selectors(b, ng, nsel) or >>
    all_lens := decode_huff_lens(b, ng, nsym) or >>
    decoded := decode_mtf_stream(b, &seq, n_in, nsym, &selectors, &all_lens) or >>
    if orig < 0 || orig >= decoded.len {
        if decoded.len == 0 && orig == 0 {
            << decoded
        }
        >> errors.new("bzip2: bad origin pointer")
    }
    raw := inverse_bwt(&decoded, orig)
    out := expand_rle4(&raw)
    got := crc_update(0, &out)
    if got != (crc & U32_MAX) {
        >> errors.new("bzip2: block checksum mismatch")
    }
    << out
}

pub fn decode(src string) string {
    if src.len < 4 {
        >> errors.new("bzip2: header too short")
    }
    if (src[0] & 255) != 66 || (src[1] & 255) != 90 || (src[2] & 255) != 104 {
        >> errors.new("bzip2: invalid header")
    }
    lvl := src[3] & 255
    if lvl < 49 || lvl > 57 {
        >> errors.new("bzip2: invalid block size")
    }
    rest := src[4:src.len]
    mut b := br_new(&rest)
    mut out := []int{}
    mut stream_crc := 0
    mut more := 1
    while more == 1 {
        mag0 := b.bits(24) or >>
        mag1 := b.bits(24) or >>
        if mag0 == 3227993 && mag1 == 2511705 {
            blk := decode_block(mut &b) or >>
            mut i := 0
            while i < blk.len {
                out.push(at_i(&blk, i))
                i = i + 1
            }
            bc := crc_update(0, &blk)
            stream_crc = (((stream_crc << 1) | ((stream_crc >> 31) & 1)) ^ bc) & U32_MAX
        } else if mag0 == 1536581 && mag1 == 3690640 {
            want := b.bits(32) or >>
            if (want & U32_MAX) != stream_crc {
                >> errors.new("bzip2: stream checksum mismatch")
            }
            more = 0
        } else {
            >> errors.new("bzip2: invalid magic")
        }
    }
    << string_from_bytes(out)
}

pub fn (r &mut Reader) read_all() string {
    << decode(r.data + "")
}
