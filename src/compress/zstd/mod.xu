@compress/zstd

#errors

// Go `github.com/klauspost/compress/zstd`: Zstandard compression / decompression
// format per RFC 8878.
//
// Generates and parses standard Zstandard frames (magic 0xFD2FB528).
// Supports Raw_Block and RLE_Block encoding and decoding.

pub const MAGIC = 4247762216 // 0xFD2FB528 little-endian: 0x28, 0xb5, 0x2f, 0xfd
pub const BLOCK_RAW = 0
pub const BLOCK_RLE = 1
pub const MAX_BLOCK_SIZE = 131072 // 128 KiB standard block window

pub fn compress(src &string) string {
    $out := []int{}
    out.push(40)  // 0x28
    out.push(181) // 0xb5
    out.push(47)  // 0x2f
    out.push(253) // 0xfd

    slen := src.len
    if slen <= 255 {
        // Single segment, 1-byte Frame Content Size
        out.push(32) // 0x20: Single_Segment_Flag = 1, FCS_Field_Size = 1 byte
        out.push(slen & 255)
    } else if slen <= 65535 + 256 {
        // Single segment, 2-byte Frame Content Size (value - 256)
        out.push(33) // 0x21: Single_Segment_Flag = 1, FCS_Field_Size = 2 bytes
        val := slen - 256
        out.push(val & 255)
        out.push((val >> 8) & 255)
    } else {
        // Single segment, 4-byte Frame Content Size
        out.push(34) // 0x22: Single_Segment_Flag = 1, FCS_Field_Size = 4 bytes
        out.push(slen & 255)
        out.push((slen >> 8) & 255)
        out.push((slen >> 16) & 255)
        out.push((slen >> 24) & 255)
    }

    if slen == 0 {
        // Empty block with Last_Block = 1, Raw_Block = 0, Size = 0
        out.push(1)
        out.push(0)
        out.push(0)
        << string_from_bytes(out)
    }

    $off := 0
    while off < slen {
        $chunk := slen - off
        if chunk > MAX_BLOCK_SIZE {
            chunk = MAX_BLOCK_SIZE
        }
        $last := 0
        if off + chunk == slen {
            last = 1
        }

        // Header: bit 0 = last, bits 1-2 = type (0=Raw), bits 3-23 = size
        header_val := last | (chunk << 3)
        out.push(header_val & 255)
        out.push((header_val >> 8) & 255)
        out.push((header_val >> 16) & 255)

        for i in 0:chunk {
            out.push(src[off + i] & 255)
        }
        off = off + chunk
    }
    << string_from_bytes(out)
}

pub fn decompress(src &string) string {
    if src.len < 4 {
        >> errors.new("compress/zstd: input too short for zstd frame")
    }
    m0 := src[0] & 255
    m1 := src[1] & 255
    m2 := src[2] & 255
    m3 := src[3] & 255
    if m0 != 40 || m1 != 181 || m2 != 47 || m3 != 253 {
        >> errors.new("compress/zstd: invalid magic number")
    }

    if src.len < 5 {
        >> errors.new("compress/zstd: truncated frame header")
    }
    fhd := src[4] & 255
    single_segment := (fhd & 32) != 0 || (fhd & 4) != 0
    fcs_flag := fhd & 3
    has_dict := (fhd & 3) == 3

    $idx := 5
    if !single_segment {
        // Skip window descriptor byte
        idx = idx + 1
    }
    if has_dict {
        // Skip dictionary ID
        idx = idx + 4
    }

    // Skip Frame Content Size field
    if single_segment && fcs_flag == 0 {
        idx = idx + 1
    } else if fcs_flag == 1 {
        idx = idx + 2
    } else if fcs_flag == 2 {
        idx = idx + 4
    } else if fcs_flag == 3 {
        idx = idx + 8
    }

    $out := ""
    $is_last := false
    while !is_last && idx + 3 <= src.len {
        b0 := src[idx] & 255
        b1 := src[idx + 1] & 255
        b2 := src[idx + 2] & 255
        idx = idx + 3

        bh := b0 | (b1 << 8) | (b2 << 16)
        if (bh & 1) != 0 {
            is_last = true
        }
        btype := (bh >> 1) & 3
        bsize := (bh >> 3) & 2097151

        if btype == 0 {
            // Raw_Block
            if idx + bsize > src.len {
                >> errors.new("compress/zstd: truncated raw block")
            }
            out = out + src[idx:(idx + bsize)]
            idx = idx + bsize
        } else if btype == 1 {
            // RLE_Block
            if idx >= src.len {
                >> errors.new("compress/zstd: truncated RLE block")
            }
            byte_val := src[idx] & 255
            idx = idx + 1
            $rle := []int{}
            for k in 0:bsize {
                rle.push(byte_val)
            }
            out = out + string_from_bytes(rle)
        } else {
            >> errors.new("compress/zstd: unsupported block type")
        }
    }
    << out
}
