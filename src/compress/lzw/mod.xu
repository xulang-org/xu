@compress/lzw

#errors
// LZW as used by GIF (lsb) and PDF/TIFF-in-Go (msb), aligned with
// Go `compress/lzw`. Codes up to 12 bits; clear + eof after the
// literal alphabet. Owning strings, no io.Reader.

pub const LSB = 0
pub const MSB = 1

const MAX_WIDTH = 12
const MAX_CODE = 4095
const INVALID = 65535

// Dict walk split out of decode to keep the bit-reader hot path compact.
fn emit_dict_into(code int, last int, clear int, hi int, prefix &[]int, suffix &[]int, stack $&[]int, out $&string) int {
    $c := code
    $sp := 0
    if code == hi && last != INVALID {
        c = last
        for walk in 0:4096 {
            if c < clear {
                <-
            }
            c = prefix[c]
            _ := walk
        }
        stack[sp] = c & 255
        sp += 1
        c = last
    }
    for walk in 0:4096 {
        if c < clear {
            <-
        }
        stack[sp] = suffix[c] & 255
        sp += 1
        c = prefix[c]
        _ := walk
    }
    first := c & 255
    stack[sp] = first
    sp += 1
    while sp > 0 {
        sp -= 1
        out.push_byte(stack[sp])
    }
    << first
}

fn find_key_hash(keys &[]int, head &[]int, next &[]int, key int, h int) int {
    $cur := head[h]
    while cur > 0 {
        idx := cur - 1
        if keys[idx] == key {
            << idx
        }
        cur = next[idx]
    }
    << 0 - 1
}

pub fn encode(src &string, order int, lit_width int) string {
    if order != LSB && order != MSB {
        >> errors.new("lzw: unknown order")
    }
    if lit_width < 2 || lit_width > 8 {
        >> errors.new("lzw: litWidth out of range")
    }
    clear := 1 << lit_width
    eof := clear + 1
    $width := lit_width + 1
    $hi := eof
    $overflow := 1 << width
    $bits := 0
    $nbits := 0
    $out := ""
    $keys := make_ints(4096)
    $vals := make_ints(4096)
    $next := make_ints(4096)
    $head := make_ints(4096)
    $entry_count := 0
    max_lit := (1 << lit_width) - 1
    for i in 0:src.len {
        if (src[i] & 255) > max_lit {
            >> errors.new("lzw: input byte too large for the litWidth")
        }
    }
    $i := 0
    $saved := INVALID
    if src.len > 0 {
        // first write: emit clear, then first literal as saved
        c0 := clear
        if order == LSB {
            bits = bits | (c0 << nbits)
            nbits = nbits + width
            while nbits >= 8 {
                out.push_byte(bits & 255)
                bits = bits >> 8
                nbits = nbits - 8
            }
        } else {
            bits = bits | (c0 << (32 - width - nbits))
            bits = bits & 4294967295
            nbits = nbits + width
            while nbits >= 8 {
                out.push_byte((bits >> 24) & 255)
                bits = (bits * 256) & 4294967295
                nbits = nbits - 8
            }
        }
        saved = src[0] & 255
        i = 1
    }
    while i < src.len {
        lit := src[i] & 255
        key := saved * 256 + lit
        h := (key * 31) & 4095
        idx := find_key_hash(&keys, &head, &next, key, h)
        if idx >= 0 {
            saved = vals[idx]
            i = i + 1
            ->
        }
        c := saved
        if order == LSB {
            bits = bits | (c << nbits)
            nbits = nbits + width
            while nbits >= 8 {
                out.push_byte(bits & 255)
                bits = bits >> 8
                nbits = nbits - 8
            }
        } else {
            bits = bits | (c << (32 - width - nbits))
            bits = bits & 4294967295
            nbits = nbits + width
            while nbits >= 8 {
                out.push_byte((bits >> 24) & 255)
                bits = (bits * 256) & 4294967295
                nbits = nbits - 8
            }
        }
        saved = lit
        hi = hi + 1
        $out_of := 0
        if hi == overflow {
            width = width + 1
            overflow = overflow * 2
        }
        if hi == MAX_CODE {
            if order == LSB {
                bits = bits | (clear << nbits)
                nbits = nbits + width
                while nbits >= 8 {
                    out.push_byte(bits & 255)
                    bits = bits >> 8
                    nbits = nbits - 8
                }
            } else {
                bits = bits | (clear << (32 - width - nbits))
                bits = bits & 4294967295
                nbits = nbits + width
                while nbits >= 8 {
                    out.push_byte((bits >> 24) & 255)
                    bits = (bits * 256) & 4294967295
                    nbits = nbits - 8
                }
            }
            width = lit_width + 1
            hi = eof
            overflow = clear * 2
            for ri in 0:4096 {
                head[ri] = 0
            }
            entry_count = 0
            out_of = 1
        }
        if out_of == 0 {
            keys[entry_count] = key
            vals[entry_count] = hi
            next[entry_count] = head[h]
            entry_count += 1
            head[h] = entry_count
        }
        i = i + 1
    }
    if saved != INVALID {
        c := saved
        if order == LSB {
            bits = bits | (c << nbits)
            nbits = nbits + width
            while nbits >= 8 {
                out.push_byte(bits & 255)
                bits = bits >> 8
                nbits = nbits - 8
            }
        } else {
            bits = bits | (c << (32 - width - nbits))
            bits = bits & 4294967295
            nbits = nbits + width
            while nbits >= 8 {
                out.push_byte((bits >> 24) & 255)
                bits = (bits * 256) & 4294967295
                nbits = nbits - 8
            }
        }
        hi = hi + 1
        if hi == overflow {
            width = width + 1
            overflow = overflow * 2
        }
        if hi == MAX_CODE {
            if order == LSB {
                bits = bits | (clear << nbits)
                nbits = nbits + width
                while nbits >= 8 {
                    out.push_byte(bits & 255)
                    bits = bits >> 8
                    nbits = nbits - 8
                }
            } else {
                bits = bits | (clear << (32 - width - nbits))
                bits = bits & 4294967295
                nbits = nbits + width
                while nbits >= 8 {
                    out.push_byte((bits >> 24) & 255)
                    bits = (bits * 256) & 4294967295
                    nbits = nbits - 8
                }
            }
            width = lit_width + 1
            hi = eof
            overflow = clear * 2
        }
    } else {
        c0 := clear
        if order == LSB {
            bits = bits | (c0 << nbits)
            nbits = nbits + width
            while nbits >= 8 {
                out.push_byte(bits & 255)
                bits = bits >> 8
                nbits = nbits - 8
            }
        } else {
            bits = bits | (c0 << (32 - width - nbits))
            bits = bits & 4294967295
            nbits = nbits + width
            while nbits >= 8 {
                out.push_byte((bits >> 24) & 255)
                bits = (bits * 256) & 4294967295
                nbits = nbits - 8
            }
        }
    }
    if order == LSB {
        bits = bits | (eof << nbits)
        nbits = nbits + width
        while nbits >= 8 {
            out.push_byte(bits & 255)
            bits = bits >> 8
            nbits = nbits - 8
        }
    } else {
        bits = bits | (eof << (32 - width - nbits))
        bits = bits & 4294967295
        nbits = nbits + width
        while nbits >= 8 {
            out.push_byte((bits >> 24) & 255)
            bits = (bits * 256) & 4294967295
            nbits = nbits - 8
        }
    }
    if nbits > 0 {
        if order == MSB {
            bits = (bits >> 24) & 255
        }
        out.push_byte(bits & 255)
    }
    << out
}

pub fn decode(src &string, order int, lit_width int) string {
    if order != LSB && order != MSB {
        >> errors.new("lzw: unknown order")
    }
    if lit_width < 2 || lit_width > 8 {
        >> errors.new("lzw: litWidth out of range")
    }
    clear := 1 << lit_width
    eof := clear + 1
    $width := lit_width + 1
    $hi := eof
    $overflow := 1 << width
    $last := INVALID
    $bits := 0
    $nbits := 0
    $pos := 0
    $prefix := make_ints(4096)
    $suffix := make_ints(4096)
    $stack := make_ints(4096)
    $out := ""
    $done := 0
    while done == 0 {
        $code := 0
        if order == LSB {
            while nbits < width {
                if pos >= src.len {
                    >> errors.new("lzw: unexpected EOF")
                }
                bits = bits | ((src[pos] & 255) << nbits)
                pos = pos + 1
                nbits = nbits + 8
            }
            mask := (1 << width) - 1
            code = bits & mask
            bits = bits >> width
            nbits = nbits - width
        } else {
            while nbits < width {
                if pos >= src.len {
                    >> errors.new("lzw: unexpected EOF")
                }
                bits = bits | ((src[pos] & 255) << (24 - nbits))
                bits = bits & 4294967295
                pos = pos + 1
                nbits = nbits + 8
            }
            code = (bits >> (32 - width)) & ((1 << width) - 1)
            bits = (bits * (1 << width)) & 4294967295
            nbits = nbits - width
        }
        if code < clear {
            out.push_byte(code)
            if last != INVALID {
                suffix[hi] = code
                prefix[hi] = last
            }
        } else {
            if code == clear {
                width = lit_width + 1
                hi = eof
                overflow = 1 << width
                last = INVALID
                ->
            }
            if code == eof {
                done = 1
                ->
            }
            if code > hi {
                >> errors.new("lzw: invalid code")
            }
            first := emit_dict_into(code, last, clear, hi, &prefix, &suffix, $&stack, $&out)
            if last != INVALID {
                suffix[hi] = first
                prefix[hi] = last
            }
        }
        last = code
        hi = hi + 1
        if hi >= overflow {
            if width == MAX_WIDTH {
                last = INVALID
                hi = hi - 1
            } else {
                width = width + 1
                overflow = 1 << width
            }
        }
    }
    << out
}
