@compress/lzw


#errors
// LZW as used by GIF (lsb) and PDF/TIFF-in-Go (msb), aligned with
// Go `compress/lzw`. Codes up to 12 bits; clear + eof after the
// literal alphabet. Owning strings, no io.Reader.

pub const lsb = 0
pub const msb = 1

const max_width = 12
const max_code = 4095
const invalid = 65535

fn reverse_bytes(b &[]int) []int {
    mut out := []int{}
    mut i := b.len
    while i > 0 {
        i = i - 1
        out.push(b[i] & 255)
    }
    << out
}

// Dict walk split out of decode: Gen3 frame-poison when this lives in the
// same fn as the bit-reader hot path (see /tmp/xu_repro/min/lzw_split.xu).
fn emit_dict(code int, last int, clear int, hi int, prefix &[]int, suffix &[]int) []int {
    mut c := code
    mut tmp := []int{}
    if code == hi && last != invalid {
        c = last
        for walk in 0:4096 {
            if c < clear {
                <-
            }
            c = prefix[c]
            _ := walk
        }
        tmp.push(c & 255)
        c = last
    }
    for walk in 0:4096 {
        if c < clear {
            <-
        }
        tmp.push(suffix[c] & 255)
        c = prefix[c]
        _ := walk
    }
    tmp.push(c & 255)
    << reverse_bytes(&tmp)
}

fn find_key(keys &[]int, key int) int {
    for i in 0:keys.len {
        if keys[i] == key {
            << i
        }
    }
    << 0 - 1
}

pub fn encode(src &string, order int, lit_width int) string {
    if order != lsb && order != msb {
        >> errors.new("lzw: unknown order")
    }
    if lit_width < 2 || lit_width > 8 {
        >> errors.new("lzw: litWidth out of range")
    }
    data := src + ""
    clear := 1 << lit_width
    eof := clear + 1
    mut width := lit_width + 1
    mut hi := eof
    mut overflow := 1 << width
    mut bits := 0
    mut nbits := 0
    mut out := []int{}
    mut keys := []int{}
    mut vals := []int{}
    max_lit := (1 << lit_width) - 1
    for i in 0:data.len {
        if (data[i] & 255) > max_lit {
            >> errors.new("lzw: input byte too large for the litWidth")
        }
    }
    mut i := 0
    mut saved := invalid
    if data.len > 0 {
        // first write: emit clear, then first literal as saved
        c0 := clear
        if order == lsb {
            bits = bits | (c0 << nbits)
            nbits = nbits + width
            while nbits >= 8 {
                out.push(bits & 255)
                bits = bits >> 8
                nbits = nbits - 8
            }
        } else {
            bits = bits | (c0 << (32 - width - nbits))
            bits = bits & 4294967295
            nbits = nbits + width
            while nbits >= 8 {
                out.push((bits >> 24) & 255)
                bits = (bits * 256) & 4294967295
                nbits = nbits - 8
            }
        }
        saved = data[0] & 255
        i = 1
    }
    while i < data.len {
        lit := data[i] & 255
        key := saved * 256 + lit
        idx := find_key(&keys, key)
        if idx >= 0 {
            saved = vals[idx]
            i = i + 1
            ->
        }
        c := saved
        if order == lsb {
            bits = bits | (c << nbits)
            nbits = nbits + width
            while nbits >= 8 {
                out.push(bits & 255)
                bits = bits >> 8
                nbits = nbits - 8
            }
        } else {
            bits = bits | (c << (32 - width - nbits))
            bits = bits & 4294967295
            nbits = nbits + width
            while nbits >= 8 {
                out.push((bits >> 24) & 255)
                bits = (bits * 256) & 4294967295
                nbits = nbits - 8
            }
        }
        saved = lit
        hi = hi + 1
        mut out_of := 0
        if hi == overflow {
            width = width + 1
            overflow = overflow * 2
        }
        if hi == max_code {
            if order == lsb {
                bits = bits | (clear << nbits)
                nbits = nbits + width
                while nbits >= 8 {
                    out.push(bits & 255)
                    bits = bits >> 8
                    nbits = nbits - 8
                }
            } else {
                bits = bits | (clear << (32 - width - nbits))
                bits = bits & 4294967295
                nbits = nbits + width
                while nbits >= 8 {
                    out.push((bits >> 24) & 255)
                    bits = (bits * 256) & 4294967295
                    nbits = nbits - 8
                }
            }
            width = lit_width + 1
            hi = eof
            overflow = clear * 2
            keys = []int{}
            vals = []int{}
            out_of = 1
        }
        if out_of == 0 {
            keys.push(key)
            vals.push(hi)
        }
        i = i + 1
    }
    if saved != invalid {
        c := saved
        if order == lsb {
            bits = bits | (c << nbits)
            nbits = nbits + width
            while nbits >= 8 {
                out.push(bits & 255)
                bits = bits >> 8
                nbits = nbits - 8
            }
        } else {
            bits = bits | (c << (32 - width - nbits))
            bits = bits & 4294967295
            nbits = nbits + width
            while nbits >= 8 {
                out.push((bits >> 24) & 255)
                bits = (bits * 256) & 4294967295
                nbits = nbits - 8
            }
        }
        hi = hi + 1
        if hi == overflow {
            width = width + 1
            overflow = overflow * 2
        }
        if hi == max_code {
            if order == lsb {
                bits = bits | (clear << nbits)
                nbits = nbits + width
                while nbits >= 8 {
                    out.push(bits & 255)
                    bits = bits >> 8
                    nbits = nbits - 8
                }
            } else {
                bits = bits | (clear << (32 - width - nbits))
                bits = bits & 4294967295
                nbits = nbits + width
                while nbits >= 8 {
                    out.push((bits >> 24) & 255)
                    bits = (bits * 256) & 4294967295
                    nbits = nbits - 8
                }
            }
            width = lit_width + 1
            hi = eof
            overflow = clear * 2
        }
    } else {
        c0 := clear
        if order == lsb {
            bits = bits | (c0 << nbits)
            nbits = nbits + width
            while nbits >= 8 {
                out.push(bits & 255)
                bits = bits >> 8
                nbits = nbits - 8
            }
        } else {
            bits = bits | (c0 << (32 - width - nbits))
            bits = bits & 4294967295
            nbits = nbits + width
            while nbits >= 8 {
                out.push((bits >> 24) & 255)
                bits = (bits * 256) & 4294967295
                nbits = nbits - 8
            }
        }
    }
    if order == lsb {
        bits = bits | (eof << nbits)
        nbits = nbits + width
        while nbits >= 8 {
            out.push(bits & 255)
            bits = bits >> 8
            nbits = nbits - 8
        }
    } else {
        bits = bits | (eof << (32 - width - nbits))
        bits = bits & 4294967295
        nbits = nbits + width
        while nbits >= 8 {
            out.push((bits >> 24) & 255)
            bits = (bits * 256) & 4294967295
            nbits = nbits - 8
        }
    }
    if nbits > 0 {
        if order == msb {
            bits = (bits >> 24) & 255
        }
        out.push(bits & 255)
    }
    << string_from_bytes(out)
}

pub fn decode(src &string, order int, lit_width int) string {
    if order != lsb && order != msb {
        >> errors.new("lzw: unknown order")
    }
    if lit_width < 2 || lit_width > 8 {
        >> errors.new("lzw: litWidth out of range")
    }
    data := src + ""
    clear := 1 << lit_width
    eof := clear + 1
    mut width := lit_width + 1
    mut hi := eof
    mut overflow := 1 << width
    mut last := invalid
    mut bits := 0
    mut nbits := 0
    mut pos := 0
    mut prefix := []int{}
    mut suffix := []int{}
    for i in 0:4096 {
        prefix.push(0)
        suffix.push(0)
    }
    mut out := []int{}
    mut done := 0
    while done == 0 {
        mut code := 0
        if order == lsb {
            while nbits < width {
                if pos >= data.len {
                    >> errors.new("lzw: unexpected EOF")
                }
                bits = bits | ((data[pos] & 255) << nbits)
                pos = pos + 1
                nbits = nbits + 8
            }
            mask := (1 << width) - 1
            code = bits & mask
            bits = bits >> width
            nbits = nbits - width
        } else {
            while nbits < width {
                if pos >= data.len {
                    >> errors.new("lzw: unexpected EOF")
                }
                bits = bits | ((data[pos] & 255) << (24 - nbits))
                bits = bits & 4294967295
                pos = pos + 1
                nbits = nbits + 8
            }
            code = (bits >> (32 - width)) & ((1 << width) - 1)
            bits = (bits * (1 << width)) & 4294967295
            nbits = nbits - width
        }
        if code < clear {
            out.push(code)
            if last != invalid {
                suffix[hi] = code
                prefix[hi] = last
            }
        } else {
            if code == clear {
                width = lit_width + 1
                hi = eof
                overflow = 1 << width
                last = invalid
                ->
            }
            if code == eof {
                done = 1
                ->
            }
            if code > hi {
                >> errors.new("lzw: invalid code")
            }
            rev := emit_dict(code, last, clear, hi, &prefix, &suffix)
            for j in 0:rev.len {
                out.push(rev[j])
            }
            if last != invalid {
                suffix[hi] = rev[0] & 255
                prefix[hi] = last
            }
        }
        last = code
        hi = hi + 1
        if hi >= overflow {
            if width == max_width {
                last = invalid
                hi = hi - 1
            } else {
                width = width + 1
                overflow = 1 << width
            }
        }
    }
    << string_from_bytes(out)
}
