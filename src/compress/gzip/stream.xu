@compress/gzip

#io
#errors
#hash/crc32

// Emit a gzip member directly to dst using legal non-final stored deflate
// blocks, then an empty final block and CRC32/ISIZE trailer. No input or output
// is accumulated. Returns the uncompressed byte count and closes neither
// endpoint. Failed copies leave an incomplete member; discard it, don't retry.
pub fn copy_stream#W:StreamWriter,R:StreamReader(dst $&W, src $&R) int {
    $header := string_from_byte(ID1) + string_from_byte(ID2)
    header = header + string_from_byte(CM_DEFLATE) + string_from_byte(0)
    header = append_u32_le(header, 0)
    header = header + string_from_byte(0) + string_from_byte(host_os())
    hn := dst.write_str(header) or >>
    _ := check_stream_write(hn, 10) or >>
    $digest := crc32.new_ieee()
    $total := 0
    while true {
        chunk := src.read_n(4096) or (err) {
            if err.msg() == io.EOF {
                <-
            }
            >> err
        }
        if chunk.len > 4096 {
            >> errors.new("io: invalid read count")
        }
        if chunk.len == 0 {
            <-
        }
        n := chunk.len
        if total > 9223372036854775807 - n {
            >> errors.new("gzip: copy count overflow")
        }
        inverse := n ^ 65535
        $block := string_from_byte(0)
        block = block + string_from_byte(n & 255) + string_from_byte((n >> 8) & 255)
        block = block + string_from_byte(inverse & 255) + string_from_byte((inverse >> 8) & 255)
        block = block + chunk
        bn := dst.write_str(block) or >>
        _ := check_stream_write(bn, n + 5) or >>
        _ := digest.write(&chunk)
        total = total + n
    }
    $trailer := string_from_byte(1) + string_from_byte(0) + string_from_byte(0)
    trailer = trailer + string_from_byte(255) + string_from_byte(255)
    trailer = append_u32_le(trailer, digest.sum())
    trailer = append_u32_le(trailer, total & U32_MAX)
    tn := dst.write_str(trailer) or >>
    _ := check_stream_write(tn, 13) or >>
    << total
}

fn check_stream_write(n int, size int) int {
    if n < 0 || n > size {
        >> errors.new("io: invalid write count")
    }
    if n != size {
        >> errors.new("short write")
    }
    << n
}
