@compress/gzip


#errors
// gzip (RFC1952) Reader/Writer over compress.flate + crc32.
// Writer emits stored-block deflate (legal gzip). Reader inflates temp
// stored/fixed/dynamic deflate body and verifies ieee CRC32 + ISIZE.

#compress/flate
#hash/crc32

const id1 = 31
const id2 = 139
const cm_deflate = 8
const flg_fhcrc = 2
const flg_fextra = 4
const flg_fname = 8
const flg_fcomment = 16
const u32_max = 4294967295

pub struct Reader {
    pub data string
    pub sticky string
}

pub struct Header {
    pub mtime int
    pub name string
    pub comment string
    pub os int
}

pub struct Writer {
    pub buf string
    pub out string
    pub closed bool
    pub name string
    pub comment string
    pub mtime int
    pub os int
}

// RFC 1952 OS byte. host_os maps xu_target_os: Windows FAT/Win32=0,
// macOS/Linux Unix=3, other=255. Go gzip writes 255 by default; Xu
// records the compile target so archives are platform-honest.
pub const os_fat = 0
pub const os_unix = 3
pub const os_macintosh = 7
pub const os_ntfs = 11
pub const os_unknown = 255

pub fn host_os() int {
    t := xu_target_os()
    if t == 2 {
        << os_fat
    }
    if t == 0 || t == 1 {
        << os_unix
    }
    << os_unknown
}

pub fn new_reader(data string) Reader {
    << Reader{data: data, sticky: ""}
}

pub fn new_writer() Writer {
    << Writer{buf: "", out: "", closed: false, name: "", comment: "", mtime: 0, os: host_os()}
}

pub fn (w &mut Writer) set_name(n string) {
    w.name = n + ""
}

pub fn (w &mut Writer) set_comment(s string) {
    w.comment = s + ""
}

pub fn (w &mut Writer) set_mtime(sec int) {
    w.mtime = sec
}

pub fn (w &mut Writer) set_os(id int) {
    w.os = id & 255
}

pub fn (r &Reader) header() Header {
    data := r.data
    if data.len < 10 {
        >> errors.new("gzip: invalid header")
    }
    if (data[0] & 255) != id1 || (data[1] & 255) != id2 {
        >> errors.new("gzip: bad magic")
    }
    flg := data[3] & 255
    mt := get_u32_le(&data, 4)
    mut pos := 10
    if (flg & flg_fextra) != 0 {
        if pos + 2 > data.len {
            >> errors.new("gzip: truncated extra")
        }
        xlen := get_u16_le(&data, pos)
        pos = pos + 2 + xlen
    }
    mut name := ""
    if (flg & flg_fname) != 0 {
        start := pos
        pos = skip_cstr(&data, pos) or >>
        if pos > start + 1 {
            name = data[start:(pos - 1)] + ""
        }
    }
    mut comment := ""
    if (flg & flg_fcomment) != 0 {
        startc := pos
        pos = skip_cstr(&data, pos) or >>
        if pos > startc + 1 {
            comment = data[startc:(pos - 1)] + ""
        }
    }
    << Header{mtime: mt, name: name, comment: comment, os: data[9] & 255}
}

fn append_u32_le(out0 string, v int) string {
    mut out := out0
    out = out + string_from_byte(v & 255)
    out = out + string_from_byte((v >> 8) & 255)
    out = out + string_from_byte((v >> 16) & 255)
    out = out + string_from_byte((v >> 24) & 255)
    << out
}

fn get_u16_le(data &string, i int) int {
    << (data[i] & 255) | ((data[i + 1] & 255) << 8)
}

fn get_u32_le(data &string, i int) int {
    << (data[i] & 255) | ((data[i + 1] & 255) << 8) | ((data[i + 2] & 255) << 16) | ((data[i + 3] & 255) << 24)
}

fn skip_cstr(data &string, start int) int {
    mut pos := start
    while pos < data.len {
        if data[pos] == 0 {
            << pos + 1
        }
        pos = pos + 1
    }
    >> errors.new("gzip: truncated name/comment")
}

pub fn (r &mut Reader) read_all() string {
    if r.sticky.len > 0 {
        >> errors.new(r.sticky + "")
    }
    data := r.data
    if data.len < 18 {
        r.sticky = "gzip: invalid header"
        >> errors.new(r.sticky + "")
    }
    if (data[0] & 255) != id1 || (data[1] & 255) != id2 {
        r.sticky = "gzip: bad magic"
        >> errors.new(r.sticky + "")
    }
    if (data[2] & 255) != cm_deflate {
        r.sticky = "gzip: unsupported compression"
        >> errors.new(r.sticky + "")
    }
    flg := data[3] & 255
    mut pos := 10
    if (flg & flg_fextra) != 0 {
        if pos + 2 > data.len {
            r.sticky = "gzip: truncated extra"
            >> errors.new(r.sticky + "")
        }
        xlen := get_u16_le(&data, pos)
        pos = pos + 2
        if pos + xlen > data.len {
            r.sticky = "gzip: truncated extra"
            >> errors.new(r.sticky + "")
        }
        pos = pos + xlen
    }
    if (flg & flg_fname) != 0 {
        pos = skip_cstr(&data, pos) or (err) {
            r.sticky = "gzip: truncated name"
            >> errors.new(r.sticky + "")
        }
    }
    if (flg & flg_fcomment) != 0 {
        pos = skip_cstr(&data, pos) or (err) {
            r.sticky = "gzip: truncated comment"
            >> errors.new(r.sticky + "")
        }
    }
    if (flg & flg_fhcrc) != 0 {
        if pos + 2 > data.len {
            r.sticky = "gzip: truncated header CRC"
            >> errors.new(r.sticky + "")
        }
        pos = pos + 2
    }
    if pos + 8 > data.len {
        r.sticky = "gzip: truncated body"
        >> errors.new(r.sticky + "")
    }
    body_end := data.len - 8
    body := data[pos:body_end]
    plain := flate.inflate(&body) + ""
    want_crc := get_u32_le(&data, body_end) & u32_max
    want_size := get_u32_le(&data, body_end + 4) & u32_max
    got_crc := crc32.checksum_ieee(&plain) & u32_max
    if got_crc != want_crc {
        r.sticky = "gzip: checksum error"
        >> errors.new(r.sticky + "")
    }
    if (plain.len & u32_max) != want_size {
        r.sticky = "gzip: length mismatch"
        >> errors.new(r.sticky + "")
    }
    << plain + ""
}

pub fn (w &mut Writer) write(data &string) int {
    if w.closed {
        >> errors.new("gzip: write after close")
    }
    chunk := data + ""
    r := mut &w.buf
    r.push_str(chunk)
    << chunk.len
}

pub fn (w &mut Writer) write_string(s string) int {
    << w.write(&s)
}

pub fn (w &mut Writer) close() int {
    if w.closed {
        << 0
    }
    w.closed = true
    plain := w.buf + ""
    nm := w.name + ""
    cmt := w.comment + ""
    mt := w.mtime
    osb := w.os & 255
    mut out := ""
    out = out + string_from_byte(id1)
    out = out + string_from_byte(id2)
    out = out + string_from_byte(cm_deflate)
    mut flg := 0
    if nm.len > 0 {
        flg = flg | flg_fname
    }
    if cmt.len > 0 {
        flg = flg | flg_fcomment
    }
    out = out + string_from_byte(flg)
    out = append_u32_le(out, mt)
    out = out + string_from_byte(0)
    out = out + string_from_byte(osb)
    if nm.len > 0 {
        out = out + nm
        out = out + string_from_byte(0)
    }
    if cmt.len > 0 {
        out = out + cmt
        out = out + string_from_byte(0)
    }
    body := flate.deflate(&plain) + ""
    out = out + body
    crc := crc32.checksum_ieee(&plain) & u32_max
    out = append_u32_le(out, crc)
    out = append_u32_le(out, plain.len & u32_max)
    w.out = out + ""
    << 0
}

pub fn (w &Writer) bytes() string {
    << w.out + ""
}

pub fn (w &Writer) text() string {
    << w.out + ""
}
