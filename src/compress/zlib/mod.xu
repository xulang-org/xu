@compress/zlib


#errors
// zlib (RFC1950) Reader/Writer over compress.flate + adler32.
// Writer emits stored-block deflate. Reader accepts any flate body.

#compress/flate
#hash/adler32

const u32_max = 4294967295

pub struct Reader {
    pub data string
    pub sticky string
}

pub struct Writer {
    pub buf string
    pub out string
    pub closed bool
}

pub fn new_reader(data string) Reader {
    << Reader{data: data, sticky: ""}
}

pub fn new_writer() Writer {
    << Writer{buf: "", out: "", closed: false}
}

fn append_u32_be(out0 string, v int) string {
    mut out := out0
    out = out + string_from_byte((v >> 24) & 255)
    out = out + string_from_byte((v >> 16) & 255)
    out = out + string_from_byte((v >> 8) & 255)
    out = out + string_from_byte(v & 255)
    << out
}

fn get_u32_be(data &string, i int) int {
    << ((data[i] & 255) << 24) | ((data[i + 1] & 255) << 16) | ((data[i + 2] & 255) << 8) | (data[i + 3] & 255)
}

pub fn (r &mut Reader) read_all() string {
    if r.sticky.len > 0 {
        >> errors.new(r.sticky + "")
    }
    data := r.data + ""
    if data.len < 6 {
        r.sticky = "zlib: truncated"
        >> errors.new(r.sticky + "")
    }
    cmf := data[0] & 255
    flg := data[1] & 255
    if (cmf & 15) != 8 {
        r.sticky = "zlib: unsupported compression"
        >> errors.new(r.sticky + "")
    }
    if ((cmf << 8) + flg) % 31 != 0 {
        r.sticky = "zlib: bad header check"
        >> errors.new(r.sticky + "")
    }
    if (flg & 32) != 0 {
        r.sticky = "zlib: dictionary not supported"
        >> errors.new(r.sticky + "")
    }
    body_end := data.len - 4
    if body_end < 2 {
        r.sticky = "zlib: truncated body"
        >> errors.new(r.sticky + "")
    }
    body := data[2:body_end]
    plain := flate.inflate(&body) + ""
    want := get_u32_be(&data, body_end) & u32_max
    got := adler32.checksum(&plain) & u32_max
    if got != want {
        r.sticky = "zlib: checksum error"
        >> errors.new(r.sticky + "")
    }
    << plain + ""
}

pub fn (w &mut Writer) write(data &string) int {
    if w.closed {
        >> errors.new("zlib: write after close")
    }
    chunk := data + ""
    r := mut &w.buf
    r.push_str(chunk)
    << chunk.len
}

pub fn (w &mut Writer) write_string(s string) int {
    << w.write(&s)
}

pub fn (w &mut Writer) close() int {
    if w.closed {
        << 0
    }
    w.closed = true
    // CMF=0x78 (CM=8, CINFO=7), FLG=0x01 → (0x7801 % 31)==0, no dict, fastest.
    plain := w.buf + ""
    mut out := ""
    out = out + string_from_byte(120)
    out = out + string_from_byte(1)
    body := flate.deflate(&plain) + ""
    out = out + body
    sum := adler32.checksum(&plain) & u32_max
    out = append_u32_be(out, sum)
    w.out = out + ""
    << 0
}

pub fn (w &Writer) bytes() string {
    << w.out + ""
}

pub fn (w &Writer) text() string {
    << w.out + ""
}
