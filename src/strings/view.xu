@strings

// ByteView is a read-only window [off, off+len) into a borrowed string.
// Xu has no user-visible pointers, so the (ptr,len) pair is (`s`, view).
// Indexing past the window is loud OOB (same as `s[s.len]`).

pub struct ByteView {
    pub off int
    pub len int
}

fn view_fail(s &string) {
    c := s[s.len]
    _ := c
}

pub fn view_of(s &string) ByteView {
    << ByteView{off: 0, len: s.len}
}

pub fn view_slice(s &string, off int, n int) ByteView {
    if off < 0 || n < 0 {
        view_fail(s)
    }
    if off > s.len {
        view_fail(s)
    }
    if n > s.len - off {
        view_fail(s)
    }
    << ByteView{off: off, len: n}
}

pub fn (v &ByteView) at(s &string, i int) int {
    if i < 0 || i >= v.len {
        view_fail(s)
    }
    << s[v.off + i] & 255
}

pub fn (v &ByteView) equal(s &string, t &string, w ByteView) bool {
    if v.len != w.len {
        << false
    }
    $i := 0
    while i < v.len {
        if s[v.off + i] != t[w.off + i] {
            << false
        }
        i += 1
    }
    << true
}

pub fn (v &ByteView) compare(s &string, t &string, w ByteView) int {
    $n := v.len
    if w.len < n {
        n = w.len
    }
    $i := 0
    while i < n {
        a := s[v.off + i] & 255
        b := t[w.off + i] & 255
        if a < b {
            << -1
        }
        if a > b {
            << 1
        }
        i += 1
    }
    if v.len < w.len {
        << -1
    }
    if v.len > w.len {
        << 1
    }
    << 0
}

pub fn (v &ByteView) index_byte(s &string, c int) int {
    $i := 0
    while i < v.len {
        if s[v.off + i] == c {
            << i
        }
        i += 1
    }
    << -1
}

pub fn (v &ByteView) last_index_byte(s &string, c int) int {
    $i := v.len - 1
    while i >= 0 {
        if s[v.off + i] == c {
            << i
        }
        i -= 1
    }
    << -1
}

pub fn (v &ByteView) has_prefix(s &string, pre &string) bool {
    if pre.len > v.len {
        << false
    }
    $i := 0
    while i < pre.len {
        if s[v.off + i] != pre[i] {
            << false
        }
        i += 1
    }
    << true
}

pub fn (v &ByteView) has_suffix(s &string, suf &string) bool {
    if suf.len > v.len {
        << false
    }
    off := v.off + v.len - suf.len
    $j := 0
    while j < suf.len {
        if s[off + j] != suf[j] {
            << false
        }
        j += 1
    }
    << true
}

// Index of `sub` relative to the window. Empty needle matches at 0.
pub fn (v &ByteView) index(s &string, sub &string) int {
    m := sub.len
    n := v.len
    if m == 0 {
        << 0
    }
    if m > n {
        << -1
    }
    base := v.off
    if m == 1 {
        // A suffix window can use the bounded whole-string byte primitive.
        // Interior windows retain their scalar scan: do not scan past them.
        if base >= 0 && base <= s.len && n == s.len - base {
            p := find_byte(s, sub[0], base)
            if p < 0 { << -1 }
            << p - base
        }
        c := sub[0]
        $i := 0
        while i < n {
            if s[base + i] == c {
                << i
            }
            i += 1
        }
        << -1
    }
    last := m - 1
    $i := 0
    if n >= 48 {
        // For short needles, screen a bounded number of first-byte candidates
        // with the runtime NEON/SWAR scan before preparing the skip table.
        // Dense candidates fall back to Horspool after eight attempts, so
        // this prefilter cannot add an unbounded series of full comparisons.
        // Only suffix windows qualify; find_byte is bounded by s.len.
        if m <= 32 && base >= 0 && base <= s.len && n == s.len - base {
            first := sub[0]
            tail := sub[last]
            $pos := base
            $attempts := 0
            while attempts < 8 {
                p := find_byte(s, first, pos)
                if p < 0 { << -1 }
                if p - base > n - m { << -1 }
                if s[p + last] == tail {
                    $j := 1
                    while j < last {
                        if s[p + j] != sub[j] { <- }
                        j += 1
                    }
                    if j == last { << p - base }
                }
                pos = p + 1
                attempts += 1
            }
        }
        bc := search_skip(sub, n)
        << index_window_prepared(s, sub, base, n, &bc)
    }
    while i + m <= n {
        $j := last
        $ok := 1
        while j >= 0 {
            if s[base + i + j] != sub[j] {
                ok = 0
                <-
            }
            j -= 1
        }
        if ok == 1 {
            << i
        }
        c := s[base + i + last]
        $skip := m
        $k := last - 1
        while k >= 0 {
            if sub[k] == c {
                skip = last - k
                <-
            }
            k -= 1
        }
        i += skip
    }
    << -1
}

// A table belongs to one operation, not to each successive match. Short
// windows keep the existing no-table path. Slice storage is Primer-compatible.
fn search_skip(sub &string, n int) []int {
    _ := n
    $bc := []int{}
    for t in 0:256 { bc.push(sub.len) }
    if sub.len > 1 {
        for k in 0:(sub.len - 1) { bc[sub[k] & 255] = sub.len - 1 - k }
    }
    << bc
}

fn index_window_prepared(s &string, sub &string, base int, n int, bc &[]int) int {
    m := sub.len
    if m > n { << -1 }
    last := m - 1
    sub_last := sub[last]
    $i := 0
    // n-m avoids overflow in the loop bound; each skip is in 1..m.
    while i <= n - m {
        c_last := s[base + i + last]
        if c_last == sub_last {
            $j := last - 1
            while j >= 0 {
                if s[base + i + j] != sub[j] { <- }
                j -= 1
            }
            if j < 0 { << i }
        }
        $skip := bc[c_last & 255]
        if skip <= 0 { skip = 1 }
        i += skip
    }
    << -1
}
