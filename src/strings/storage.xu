@strings

// Private storage seams keep the ordinary Xu ABI. Hosted arm64/x64
// compilers replace their exact, checked signatures with bounded runtime
// kernels; other compilers keep the portable implementation below.
fn storage_repeat(s &string, n int) string {
    if n <= 0 {
        << ""
    }
    if s.len == 0 {
        << ""
    }
    if n == 1 {
        << s + ""
    }
    if s.len < 0 {
        eprintln("xu: out of memory")
        <<< 1
    }
    // Tiny results fit the append allocator's small buckets. Avoid concat
    // and temporary tail allocations; copy the input once before the loop.
    if n <= 8 && s.len <= 8 {
        src := s + ""
        mut out := ""
        for i in 0:n {
            out.push_str(src)
        }
        << out
    }
    // Check before multiplying the remainder's byte length or allocating.
    // Keep the runtime's fail-loud allocation error for impossible lengths.
    if n > 9223372036854775807 / s.len {
        eprintln("xu: out of memory")
        <<< 1
    }
    mut out := s + ""
    mut copies := 1
    // Concat borrows both operands and copies into fresh owned storage.
    // Doubling uses the bounded block-copy kernel, without a mutable alias
    // or an append/capacity check for every individual repetition.
    while copies <= n / 2 {
        out = out + out
        copies *= 2
    }
    if copies < n {
        tail := out[0:((n - copies) * s.len)]
        out.push_str(tail)
    }
    << out
}


// On targets without the native storage seam grow remains a capacity hint,
// as in earlier Xu versions. It never changes string contents or length.
fn storage_reserve(s &mut string, n int) {
    _ := n
}

fn storage_capacity(s &string) int {
    << s.len
}
