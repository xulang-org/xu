@strings

#errors
#unicode
#unicode/utf8

// Read-only helpers take &string so the caller keeps the source.
//
// Text cutsets and callbacks operate on Unicode runes; indexes remain byte
// offsets. Invalid UTF-8 decodes as U+FFFD, consuming one byte. Case mapping
// and comparison use Unicode simple mappings, without multi-rune expansion.

// Horspool from `start`. Empty needle matches at `start`. The scan lives
// on ByteView so fmt/strconv/bytes share one windowed implementation.
fn index_from(s &string, sub &string, start int) int {
    n := s.len
    mut off := start
    if off < 0 {
        off = 0
    }
    if off > n {
        if sub.len == 0 {
            << n
        }
        << -1
    }
    v := ByteView{off: off, len: n - off}
    rel := v.index(s, sub)
    if rel < 0 {
        << -1
    }
    << off + rel
}

// Reuse the operation's prepared table across non-overlapping matches.
fn index_from_prepared(s &string, sub &string, start int, bc &[]int) int {
    if sub.len == 0 {
        if start <= s.len { << start }
        << -1
    }
    if sub.len == 1 {
        << find_byte(s, sub[0] & 255, start)
    }
    if s.len - start < sub.len {
        << -1
    }
    p := index_window_prepared(s, sub, start, s.len - start, bc)
    if p < 0 { << -1 }
    << start + p
}

pub fn index_of(s &string, sub string) int {
    if sub.len == 0 {
        << 0
    }
    if sub.len > s.len {
        << -1
    }
    << index_from(s, &sub, 0)
}

pub fn contains(s &string, sub string) bool {
    << index_of(s, sub) >= 0
}


fn byte_is_ascii_space(c int) bool {
    if c == 32 {
        << true
    }
    << c >= 9 && c <= 13
}

fn trim_space_runes(src &string) string {
    mut i := 0
    mut end := 0
    while i < src.len {
        r := text_rune(src, i)
        w := text_width(src, i)
        if !unicode.is_space(r) {
            <-
        }
        i += w
    }
    mut j := i
    while j < src.len {
        r := text_rune(src, j)
        j += text_width(src, j)
        if !unicode.is_space(r) {
            end = j
        }
    }
    if end > i {
        << src[i:end]
    }
    << ""
}

pub fn trim_space(s &string) string {
    // Scan the borrowed text, then copy the kept window once.
    mut i := 0
    while i < s.len {
        c := s[i]
        if c >= 128 {
            << trim_space_runes(s)
        }
        if !byte_is_ascii_space(c) {
            <-
        }
        i += 1
    }
    mut end := s.len
    while end > i {
        c := s[end - 1]
        if c >= 128 {
            << trim_space_runes(s)
        }
        if !byte_is_ascii_space(c) {
            <-
        }
        end -= 1
    }
    if end > i {
        << s[i:end]
    }
    << ""
}

pub fn repeat(s &string, n int) string {
    << storage_repeat(s, n)
}

pub fn join(parts []string, sep string) string {
    // One owned buffer. Each piece is borrowed, including a shared split view.
    << join_strings(parts, sep)
}

pub fn split(s &string, sep string) []string {
    if sep.len == 0 {
        rune_src := s + ""
        << split_runes(rune_src, -1)
    }
    if sep.len == 1 {
        // One copy of the source. Each non-empty piece is a view into it.
        << split_byte(s, sep[0])
    }
    src := s + ""
    mut out := []string{}
    mut start := 0
    mut going := 1
    bc := search_skip(&sep, s.len)
    while going == 1 {
        p := index_from_prepared(&src, &sep, start, &bc)
        if p < 0 {
            going = 0
        } else {
            out.push(src[start:p])
            start = p + sep.len
        }
    }
    out.push(src[start:src.len])
    << out
}

pub fn has_prefix(s &string, pre string) bool {
    if pre.len == 1 {
        if s.len < 1 {
            << false
        }
        << (s[0] & 255) == (pre[0] & 255)
    }
    v := view_of(s)
    << v.has_prefix(s, &pre)
}

pub fn has_suffix(s &string, suf string) bool {
    v := view_of(s)
    << v.has_suffix(s, &suf)
}

// ends_with is a compatibility alias for callers using the descriptive
// spelling; keep has_suffix as the canonical implementation.
pub fn ends_with(s &string, suf string) bool {
    << has_suffix(s, suf)
}

fn replace_one_byte_all(src &string, ob int, nb int) string {
    // Equality select: `((c ^ (ob & 255)) - 1) >> 63` is -1 on a match.
    // The mask keeps the compare inside one byte, which is the 16-byte
    // NEON replace shape. The limited-count path stays branched.
    mut i := 0
    mut found := 0
    while i < src.len {
        if (src[i] & 255) == ob {
            found = 1
            <-
        }
        i += 1
    }
    if found == 0 {
        << src + ""
    }
    mut b := make_string(src.len)
    i = 0
    while i < src.len {
        c := src[i] & 255
        b[i] = (nb & (((c ^ (ob & 255)) - 1) >> 63)) | (c & ((((c ^ (ob & 255)) - 1) >> 63) ^ -1))
        i += 1
    }
    << b
}

fn replace_one_byte(src &string, oldb int, newb int, n int) string {
    ob := oldb & 255
    nb := newb & 255
    if n < 0 {
        << replace_one_byte_all(src, ob, nb)
    }
    mut i := 0
    mut found := 0
    while i < src.len {
        if (src[i] & 255) == ob {
            found = 1
            <-
        }
        i += 1
    }
    if found == 0 {
        << src + ""
    }
    mut b := make_string(src.len)
    i = 0
    mut replaced := 0
    while i < src.len {
        c := src[i] & 255
        if c == ob && replaced < n {
            b[i] = nb
            replaced += 1
        } else {
            b[i] = c
        }
        i += 1
    }
    << b
}

pub fn replace(s &string, old string, new string, n int) string {
    // Empty old inserts at UTF-8 boundaries, including before/after text.
    if n == 0 {
        << s + ""
    }
    if old.len == 0 {
        src := s + ""
        mut out := ""
        mut i := 0
        mut replaced := 0
        while i <= src.len {
            if n < 0 || replaced < n {
                out.push_str(new)
                replaced += 1
            } else {
                out.push_str(src[i:src.len])
                << out
            }
            if i == src.len {
                <-
            }
            end := i + text_width(&src, i)
            out.push_str(src[i:end])
            i = end
        }
        << out
    }
    if old == new {
        << s + ""
    }
    if old.len == 1 && new.len == 1 {
        // Borrow the source, like Rust `str::replace`. The result is a new string.
        << replace_one_byte(s, old[0], new[0], n)
    }
    if old.len == 1 {
        c := old[0] & 255
        p0 := find_byte(s, c, 0)
        if p0 < 0 {
            << s + ""
        }
        mut out := ""
        mut start := 0
        mut replaced := 0
        mut p := p0
        while p >= 0 {
            if n >= 0 && replaced >= n {
                <-
            }
            if p > start {
                out.push_str(s[start:p])
            }
            out.push_str(new)
            start = p + 1
            replaced += 1
            if start >= s.len {
                <-
            }
            p = find_byte(s, c, start)
        }
        if start < s.len {
            out.push_str(s[start:s.len])
        }
        << out
    }
    p0 := index_from(s, &old, 0)
    if p0 < 0 {
        << s + ""
    }
    mut out := ""
    mut start := 0
    mut replaced := 0
    mut p := p0
    bc := search_skip(&old, s.len)
    while p >= 0 {
        if n >= 0 && replaced >= n {
            <-
        }
        if p > start {
            out.push_str(s[start:p])
        }
        out.push_str(new)
        start = p + old.len
        replaced += 1
        if start >= s.len {
            <-
        }
        p = index_from_prepared(s, &old, start, &bc)
    }
    if start < s.len {
        out.push_str(s[start:s.len])
    }
    << out
}

pub fn fields(s &string) []string {
    // Split on Unicode whitespace; malformed bytes remain part of a field.
    src := s + ""
    mut out := []string{}
    mut i := 0
    while i < src.len {
        if unicode.is_space(text_rune(&src, i)) {
            i += text_width(&src, i)
        } else {
            start := i
            while i < src.len {
                if unicode.is_space(text_rune(&src, i)) {
                    <-
                }
                i += text_width(&src, i)
            }
            out.push(src[start:i])
        }
    }
    << out
}

// FieldsFunc: separator is any Unicode rune for which f returns true.
pub fn fields_func(s &string, f fn(int) bool) []string {
    src := s + ""
    mut out := []string{}
    mut i := 0
    while i < src.len {
        if f(text_rune(&src, i)) {
            i += text_width(&src, i)
        } else {
            start := i
            while i < src.len {
                if f(text_rune(&src, i)) {
                    <-
                }
                i += text_width(&src, i)
            }
            out.push(src[start:i] + "")
        }
    }
    << out
}

pub fn to_lower(s &string) string {
    << map_text_case(s, false)
}

pub fn to_upper(s &string) string {
    << map_text_case(s, true)
}

fn map_text_case(s &string, upper bool) string {
    // Fast path: scan for non-ASCII or need-to-convert characters.
    mut has_change := false
    if upper {
        for i in 0:s.len {
            c := s[i]
            if c >= 128 { << map_unicode_case(s, upper) }
            if c >= 97 && c <= 122 { has_change = true }
        }
    } else {
        for i in 0:s.len {
            c := s[i]
            if c >= 128 { << map_unicode_case(s, upper) }
            if c >= 65 && c <= 90 { has_change = true }
        }
    }
    if !has_change {
        << s + ""
    }
    mut out := make_string(s.len)
    if upper {
        for i in 0:s.len {
            c := s[i]
            if c >= 97 && c <= 122 {
                out[i] = c - 32
            } else {
                out[i] = c
            }
        }
    } else {
        for i in 0:s.len {
            c := s[i]
            if c >= 65 && c <= 90 {
                out[i] = c + 32
            } else {
                out[i] = c
            }
        }
    }
    << out
}

fn decode_case_rune(s &string, i int) int {
    << utf8.decode(s, i) or (err) { << -1 }
}

fn map_unicode_case(s &string, upper bool) string {
    mut out := new_byte_builder(s.len)
    mut i := 0
    while i < s.len {
        mut r := s[i]
        if r < 128 {
            i += 1
        } else {
            // Invalid UTF-8 is U+FFFD and consumes one byte, as before.
            decoded := decode_case_rune(s, i)
            if decoded < 0 {
                r = 65533
                i += 1
            } else {
                r = decoded
                if r < 2048 { i += 2 } else if r < 65536 { i += 3 } else { i += 4 }
            }
        }
        if upper { r = unicode.to_upper(r) } else { r = unicode.to_lower(r) }
        if r < 128 {
            out.write_byte(r)
        } else if r < 2048 {
            out.write_byte(192 | (r >> 6))
            out.write_byte(128 | (r & 63))
        } else if r < 65536 {
            out.write_byte(224 | (r >> 12))
            out.write_byte(128 | ((r >> 6) & 63))
            out.write_byte(128 | (r & 63))
        } else {
            out.write_byte(240 | (r >> 18))
            out.write_byte(128 | ((r >> 12) & 63))
            out.write_byte(128 | ((r >> 6) & 63))
            out.write_byte(128 | (r & 63))
        }
    }
    << string_from_bytes(out.buf, 0, out.len)
}

fn in_cutset(c int, cutset &string) bool {
    mut i := 0
    while i < cutset.len {
        if text_rune(cutset, i) == c {
            << true
        }
        i += text_width(cutset, i)
    }
    << false
}

pub fn trim_left(s &string, cutset string) string {
    src := s + ""
    mut i := 0
    while i < src.len && in_cutset(text_rune(&src, i), &cutset) {
        i += text_width(&src, i)
    }
    << src[i:src.len]
}

pub fn trim_right(s &string, cutset string) string {
    src := s + ""
    mut e := src.len
    while e > 0 {
        i := text_previous(&src, e)
        if !in_cutset(text_rune(&src, i), &cutset) {
            <-
        }
        e = i
    }
    << src[0:e]
}

pub fn trim(s &string, cutset string) string {
    // `cutset` is an owning value parameter; clone once because both helper
    // calls consume their value under the frozen primer ABI.
    src := trim_left(s, cutset + "")
    << trim_right(&src, cutset)
}

pub fn trim_prefix(s &string, pre string) string {
    src := s + ""
    pre_len := pre.len
    if has_prefix(&src, pre) {
        << src[pre_len:src.len]
    }
    << src
}

pub fn trim_suffix(s &string, suf string) string {
    src := s + ""
    suf_len := suf.len
    if has_suffix(&src, suf) {
        << src[0:src.len - suf_len]
    }
    << src
}

// Text helpers deliberately consume one byte for malformed UTF-8. The strict
// public utf8 decoder still throws; slices preserve the original input bytes.
fn text_width(s &string, i int) int {
    w := valid_text_width(s, i)
    if w == 0 {
        << 1
    }
    << w
}

fn valid_text_width(s &string, i int) int {
    if s[i] < 128 {
        << 1
    }
    << utf8.decode_width(s, i) or (err) { << 0 }
}

fn text_rune(s &string, i int) int {
    if s[i] < 128 {
        << s[i]
    }
    << utf8.decode(s, i) or (err) { << 0xFFFD }
}

// DecodeLastRune semantics: a malformed suffix consumes exactly one byte.
fn text_previous(s &string, end int) int {
    mut i := end - 1
    if s[i] < 128 {
        << i
    }
    mut start := end - 4
    if start < 0 {
        start = 0
    }
    while i > start && s[i] >= 128 && s[i] < 192 {
        i -= 1
    }
    w := valid_text_width(s, i)
    if w > 0 && i + w == end {
        << i
    }
    << end - 1
}

fn split_runes(s string, n int) []string {
    mut out := []string{}
    mut i := 0
    while i < s.len {
        if n > 0 && out.len == n - 1 {
            out.push(s[i:s.len])
            << out
        }
        end := i + text_width(&s, i)
        out.push(s[i:end])
        i = end
    }
    << out
}

pub fn compare(a &string, b &string) int {
    va := view_of(a)
    vb := view_of(b)
    << va.compare(a, b, vb)
}

pub fn index_byte(s &string, c int) int {
    v := view_of(s)
    << v.index_byte(s, c)
}

pub fn last_index(s &string, sub string) int {
    if sub.len == 0 {
        << s.len
    }
    if sub.len > s.len {
        << -1
    }
    last := sub.len - 1
    mut i := s.len - sub.len
    while i >= 0 {
        mut j := last
        mut ok := 1
        while j >= 0 {
            if s[i + j] != sub[j] {
                ok = 0
                <-
            }
            j -= 1
        }
        if ok == 1 {
            << i
        }
        i = i - 1
    }
    << -1
}

pub fn last_index_byte(s &string, c int) int {
    v := view_of(s)
    << v.last_index_byte(s, c)
}

pub fn count(s &string, sub string) int {
    if sub.len == 0 {
        mut n := 1
        mut i := 0
        while i < s.len {
            i += text_width(s, i)
            n += 1
        }
        << n
    }
    if sub.len == 1 {
        << count_byte(s, sub[0])
    }
    mut n := 0
    mut i := 0
    mut going := 1
    bc := search_skip(&sub, s.len)
    while going == 1 {
        p := index_from_prepared(s, &sub, i, &bc)
        if p < 0 {
            going = 0
        } else {
            n = n + 1
            i = p + sub.len
        }
    }
    << n
}

pub fn split_n(s &string, sep string, n int) []string {
    if n == 0 {
        << []string{}
    }
    src := s + ""
    if n < 0 {
        << split(&src, sep)
    }
    if sep.len == 0 {
        << split_runes(src, n)
    }
    mut out := []string{}
    mut start := 0
    mut left := n
    bc := search_skip(&sep, s.len)
    while left > 1 {
        p := index_from_prepared(&src, &sep, start, &bc)
        if p < 0 {
            <-
        }
        out.push(src[start:p])
        start = p + sep.len
        left = left - 1
    }
    out.push(src[start:src.len])
    << out
}

pub fn replace_all(s &string, old string, new string) string {
    << replace(s, old, new, -1)
}

pub fn equal_fold(a &string, b &string) bool {
    mut i := 0
    mut j := 0
    while i < a.len && j < b.len {
        ca := text_rune(a, i)
        cb := text_rune(b, j)
        i += text_width(a, i)
        j += text_width(b, j)
        if ca != cb {
            mut r := unicode.simple_fold(ca)
            while r != ca && r != cb {
                r = unicode.simple_fold(r)
            }
            if r != cb {
                << false
            }
        }
    }
    << i == a.len && j == b.len
}

pub struct Cut {
    pub before string
    pub after string
    pub found bool
}

pub fn cut(s &string, sep string) Cut {
    src := s + ""
    sep_len := sep.len
    i := index_of(&src, sep)
    if i < 0 {
        << Cut{before: src, after: "", found: false}
    }
    << Cut{before: src[0:i], after: src[(i + sep_len):src.len], found: true}
}

pub fn cut_prefix(s &string, pre string) Cut {
    src := s + ""
    pre_len := pre.len
    if has_prefix(&src, pre) {
        << Cut{before: src[pre_len:src.len], after: "", found: true}
    }
    << Cut{before: src, after: "", found: false}
}

pub fn cut_suffix(s &string, suf string) Cut {
    src := s + ""
    suf_len := suf.len
    if has_suffix(&src, suf) {
        << Cut{before: src[0:(src.len - suf_len)], after: "", found: true}
    }
    << Cut{before: src, after: "", found: false}
}

pub struct Builder {
    pub buf string
}

pub fn builder() Builder {
    << Builder{buf: ""}
}

pub fn (b &mut Builder) write_string(s &string) int {
    // push_str appends in place with amortized doubling; `b.buf = b.buf + s`
    // reallocated the whole prefix on every write (M191). push_str wants an
    // owned suffix, so the borrow is read out once (`s + ""`).
    r := mut &b.buf
    r.push_str(*s)
    << s.len
}

pub fn (b &mut Builder) grow(n int) {
    // Reserve n additional bytes without changing the visible string.
    storage_reserve(mut &b.buf, n)
}

pub fn (b &mut Builder) write_view(s &string, v ByteView) int {
    if v.len <= 0 {
        << 0
    }
    if v.off < 0 || v.off > s.len || v.len > s.len - v.off {
        view_fail(s)
        << 0
    }
    piece := s[v.off:v.off + v.len]
    r := mut &b.buf
    r.push_str(piece)
    << v.len
}

pub fn (b &mut Builder) write_int(n int) int {
    if n == 0 {
        r := mut &b.buf
        r.push_byte(48)
        << 1
    }
    min64 := 0 - 9223372036854775807 - 1
    if n == min64 {
        lit := "-9223372036854775808"
        << b.write_string(&lit)
    }
    mut x := n
    mut neg := false
    if x < 0 {
        neg = true
        x = 0 - x
    }
    mut tmp := []int{}
    while x > 0 {
        tmp.push(48 + (x % 10))
        x = x / 10
    }
    r := mut &b.buf
    mut nout := 0
    if neg {
        r.push_byte(45)
        nout += 1
    }
    mut i := tmp.len - 1
    while i >= 0 {
        r.push_byte(tmp[i])
        nout += 1
        i -= 1
    }
    << nout
}

pub fn (b &Builder) length() int {
    << b.buf.len
}

pub fn (b &Builder) text() string {
    << b.buf
}

pub fn (b &mut Builder) reset() {
    b.buf = ""
}

// IndexFunc callbacks receive runes; results are byte offsets. MapBytes
// deliberately keeps its byte callback and byte result contract.

pub fn index_func(s &string, f fn(int) bool) int {
    mut i := 0
    while i < s.len {
        if f(text_rune(s, i)) {
            << i
        }
        i += text_width(s, i)
    }
    << -1
}

pub fn last_index_func(s &string, f fn(int) bool) int {
    mut end := s.len
    while end > 0 {
        i := text_previous(s, end)
        if f(text_rune(s, i)) {
            << i
        }
        end = i
    }
    << -1
}

pub fn map_bytes(s &string, f fn(int) int) string {
    mut b := []int{}
    mut i := 0
    while i < s.len {
        b.push(f(s[i] & 255) & 255)
        i = i + 1
    }
    << string_from_bytes(b)
}

// M191: growable byte buffer for hot concat paths (compiler / fmt).
pub struct ByteBuilder {
    pub buf []int
    pub len int
}

pub fn new_byte_builder(cap int) ByteBuilder {
    mut b := []int{}
    mut ncap := cap
    if ncap < 16 {
        ncap = 16
    }
    for i in 0:ncap {
        b.push(0)
    }
    << ByteBuilder{buf: b, len: 0}
}

pub fn (sb &mut ByteBuilder) reserve(extra int) {
    need := sb.len + extra
    if need <= sb.buf.len {
        <<
    }
    mut cap := sb.buf.len
    if cap < 16 {
        cap = 16
    }
    while cap < need {
        cap = cap * 2
    }
    mut nb := []int{}
    for i in 0:cap {
        if i < sb.len {
            nb.push(sb.buf[i])
        } else {
            nb.push(0)
        }
    }
    sb.buf = nb
}

pub fn (sb &mut ByteBuilder) write_byte(c int) {
    sb.reserve(1)
    sb.buf[sb.len] = c & 255
    sb.len = sb.len + 1
}

pub fn (sb &mut ByteBuilder) write_str(s string) {
    sb.reserve(s.len)
    for i in 0:s.len {
        sb.buf[sb.len] = s[i] & 255
        sb.len = sb.len + 1
    }
}

pub fn (sb ByteBuilder) to_string() string {
    mut out := []int{}
    for i in 0:sb.len {
        out.push(sb.buf[i])
    }
    << string_from_bytes(out)
}

// B0a: Go strings Clone / IndexAny / SplitAfter / TrimFunc / ToValidUTF8 /
// Builder.WriteByte / WriteRune. Cutsets operate on Unicode runes.

pub fn clone(s &string) string {
    << s + ""
}

pub fn contains_func(s &string, f fn(int) bool) bool {
    << index_func(s, f) >= 0
}

pub fn index_any(s &string, chars string) int {
    if chars.len == 0 {
        << -1
    }
    mut i := 0
    while i < s.len {
        if in_cutset(text_rune(s, i), &chars) {
            << i
        }
        i += text_width(s, i)
    }
    << -1
}

pub fn last_index_any(s &string, chars string) int {
    if chars.len == 0 {
        << -1
    }
    mut end := s.len
    while end > 0 {
        i := text_previous(s, end)
        if in_cutset(text_rune(s, i), &chars) {
            << i
        }
        end = i
    }
    << -1
}

pub fn contains_any(s &string, chars string) bool {
    << index_any(s, chars) >= 0
}

pub fn index_rune(s &string, r int) int {
    if !utf8.valid_rune(r) {
        << -1
    }
    mut i := 0
    while i < s.len {
        if text_rune(s, i) == r {
            << i
        }
        i += text_width(s, i)
    }
    << -1
}

pub fn contains_rune(s &string, r int) bool {
    << index_rune(s, r) >= 0
}

pub fn split_after(s &string, sep string) []string {
    src := s + ""
    mut out := []string{}
    if sep.len == 0 {
        << split_runes(src, -1)
    }
    mut start := 0
    mut going := 1
    while going == 1 {
        p := index_from(&src, &sep, start)
        if p < 0 {
            going = 0
        } else {
            end := p + sep.len
            out.push(src[start:end])
            start = end
        }
    }
    out.push(src[start:src.len])
    << out
}

pub fn split_after_n(s &string, sep string, n int) []string {
    if n == 0 {
        << []string{}
    }
    src := s + ""
    if n < 0 {
        << split_after(&src, sep)
    }
    if sep.len == 0 {
        << split_runes(src, n)
    }
    mut out := []string{}
    mut start := 0
    mut left := n
    while left > 1 {
        p := index_from(&src, &sep, start)
        if p < 0 {
            <-
        }
        end := p + sep.len
        out.push(src[start:end])
        start = end
        left = left - 1
    }
    out.push(src[start:src.len])
    << out
}

pub fn trim_left_func(s &string, f fn(int) bool) string {
    src := s + ""
    mut i := 0
    while i < src.len {
        if !f(text_rune(&src, i)) {
            <-
        }
        i += text_width(&src, i)
    }
    << src[i:src.len]
}

pub fn trim_right_func(s &string, f fn(int) bool) string {
    src := s + ""
    mut e := src.len
    while e > 0 {
        i := text_previous(&src, e)
        if !f(text_rune(&src, i)) {
            <-
        }
        e = i
    }
    << src[0:e]
}

pub fn trim_func(s &string, f fn(int) bool) string {
    src := trim_left_func(s, f)
    << trim_right_func(&src, f)
}

pub fn to_valid_utf8(s &string, replacement string) string {
    src := s + ""
    repl := replacement
    mut out := ""
    mut i := 0
    mut invalid := false
    while i < src.len {
        w := valid_text_width(&src, i)
        if w <= 0 {
            if !invalid {
                out.push_str(repl)
            }
            invalid = true
            i = i + 1
        } else {
            invalid = false
            out.push_str(src[i:(i + w)])
            i = i + w
        }
    }
    << out
}

pub fn (b &mut Builder) write_byte(c int) int {
    r := mut &b.buf
    r.push_byte(c & 255)
    << 1
}

pub fn (b &mut Builder) write_rune(r int) int {
    if !utf8.valid_rune(r) {
        << 0
    }
    enc := utf8.encode(r) or (err) {
        << 0
    }
    << b.write_string(&enc)
}

pub fn (b &Builder) cap() int {
    << storage_capacity(&b.buf)
}

// B5: Go strings.Replacer. Pairs are old/new; earlier pair wins when several
// match at the same index (not longest-first). Empty old inserts between
// bytes and at both ends, same as Go genericReplacer. No WriteString
// (no io.Writer). Odd argument count throws.

pub struct Replacer {
    olds []string
    news []string
}

struct ReplHit {
    found int
    idx int
    keylen int
}

fn repl_match(r &Replacer, s &string, i int, skip_empty bool) ReplHit {
    mut j := 0
    while j < r.olds.len {
        ol := r.olds[j].len
        if skip_empty {
            if ol == 0 {
                j = j + 1
                ->
            }
        }
        if i + ol > s.len {
            j = j + 1
            ->
        }
        mut k := 0
        mut ok := 1
        while k < ol {
            if (s[i + k] & 255) != (r.olds[j][k] & 255) {
                ok = 0
                <-
            }
            k = k + 1
        }
        if ok == 1 {
            << ReplHit{found: 1, idx: j, keylen: ol}
        }
        j = j + 1
    }
    << ReplHit{found: 0, idx: 0, keylen: 0}
}

pub fn new_replacer(oldnew <-> string) Replacer {
    n := oldnew.len
    if n % 2 != 0 {
        >> errors.new("strings: NewReplacer odd argument count")
    }
    mut olds := []string{}
    mut news := []string{}
    mut i := 0
    while i < n {
        olds.push(oldnew[i] + "")
        news.push(oldnew[i + 1] + "")
        i = i + 2
    }
    << Replacer{olds: olds, news: news}
}

pub fn (r &Replacer) replace(s0 &string) string {
    s := s0 + ""
    n := s.len
    mut sb := new_byte_builder(n)
    mut i := 0
    mut last := 0
    mut prev_empty := false
    while i <= n {
        hit := repl_match(r, &s, i, prev_empty)
        if hit.found != 0 {
            if last < i {
                gap := s[last:i]
                sb.write_str(gap)
            }
            idx := hit.idx
            keylen := hit.keylen
            rep := r.news[idx] + ""
            sb.write_str(rep)
            i = i + keylen
            last = i
            prev_empty = keylen == 0
            ->
        }
        prev_empty = false
        i = i + 1
    }
    if last < n {
        rest := s[last:n]
        sb.write_str(rest)
    }
    << sb.to_string()
}

// B6: Go strings.Reader. read_n / read_at return owning strings (no []byte).
// read_n is empty at EOF (no throw); read_byte / read_rune throw "EOF".
// Invalid UTF-8 in read_rune is U+FFFD + 1 byte (Go DecodeRuneInString).
// seek whence: 0 start / 1 current / 2 end. No WriteTo.

pub struct Reader {
    s string
    i int
    prev_rune int
}

pub struct RuneRead {
    pub ch int
    pub size int
}

pub fn new_reader(s string) Reader {
    << Reader{s: s + "", i: 0, prev_rune: 0 - 1}
}

pub fn (r &Reader) size() int {
    << r.s.len
}

pub fn (r &Reader) length() int {
    rest := r.s.len - r.i
    if rest < 0 {
        << 0
    }
    << rest
}

pub fn (r &mut Reader) reset(s string) {
    r.s = s + ""
    r.i = 0
    r.prev_rune = 0 - 1
}

pub fn (r &mut Reader) read_n(n int) string {
    if n <= 0 {
        << ""
    }
    if r.i >= r.s.len {
        r.prev_rune = 0 - 1
        << ""
    }
    r.prev_rune = 0 - 1
    rest := r.s.len - r.i
    mut take := n
    if take > rest {
        take = rest
    }
    start := r.i
    r.i = r.i + take
    << r.s[start:r.i]
}

pub fn (r &mut Reader) read_byte() int {
    if r.i >= r.s.len {
        r.prev_rune = 0 - 1
        >> errors.new("EOF")
    }
    r.prev_rune = 0 - 1
    c := r.s[r.i] & 255
    r.i = r.i + 1
    << c
}

pub fn (r &mut Reader) unread_byte() int {
    if r.i <= 0 {
        >> errors.new("strings: UnreadByte at beginning")
    }
    r.prev_rune = 0 - 1
    r.i = r.i - 1
    << 0
}

pub fn (r &mut Reader) read_rune() RuneRead {
    if r.i >= r.s.len {
        r.prev_rune = 0 - 1
        >> errors.new("EOF")
    }
    r.prev_rune = r.i
    c0 := r.s[r.i] & 255
    if c0 < 128 {
        r.i = r.i + 1
        << RuneRead{ch: c0, size: 1}
    }
    src := r.s + ""
    off := r.i
    ch := utf8.decode(&src, off) or (err) {
        r.i = r.i + 1
        << RuneRead{ch: 65533, size: 1}
    }
    w := utf8.rune_len(ch) or (err) {
        r.i = r.i + 1
        << RuneRead{ch: 65533, size: 1}
    }
    r.i = r.i + w
    << RuneRead{ch: ch, size: w}
}

pub fn (r &mut Reader) unread_rune() int {
    if r.i <= 0 {
        >> errors.new("strings: UnreadRune at beginning")
    }
    if r.prev_rune < 0 {
        >> errors.new("strings: UnreadRune previous was not ReadRune")
    }
    r.i = r.prev_rune
    r.prev_rune = 0 - 1
    << 0
}

pub fn (r &mut Reader) seek(offset int, whence int) int {
    mut abs := 0
    if whence == 0 {
        abs = offset
    } else {
        if whence == 1 {
            abs = r.i + offset
        } else {
            if whence == 2 {
                abs = r.s.len + offset
            } else {
                >> errors.new("strings: Seek invalid whence")
            }
        }
    }
    if abs < 0 {
        >> errors.new("strings: Seek negative position")
    }
    r.i = abs
    r.prev_rune = 0 - 1
    << abs
}

pub fn (r &mut Reader) read_at(n int, off int) string {
    if off < 0 {
        >> errors.new("strings: ReadAt negative offset")
    }
    if off >= r.s.len {
        >> errors.new("EOF")
    }
    if n <= 0 {
        << ""
    }
    rest := r.s.len - off
    mut take := n
    if take > rest {
        take = rest
    }
    end := off + take
    << r.s[off:end]
}
