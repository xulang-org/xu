@xacp

#os

// Discover the compiled capabilities before dispatching to an explicit control mode.
pub fn program_preflight(port int) {
    argv := os.args()
    for i in 1:argv.len {
        if argv[i] == "--" { <- }
        if argv[i] == "--xacp-help" {
            print_discovery(port)
            <<< 0
        }
    }
    enable_output_capture()
    stdio_preflight(port)
}

fn print_discovery(port int) {
    $tcp_help := "tcp: disabled (port 0)\n"
    if port > 0 {
        tcp_help = "tcp: enabled\nbind: 127.0.0.1:" + str(port) + "\n"
    }
    help := "XACP (Xu Agent Control Protocol)\n" +
        "help_flag: --xacp-help\n" +
        "build: xu build --xacp [--xacp-port PORT] <input.xu>\n" +
        "runtime: <app> --xacp-help\n" +
        "transport: stdio; TCP via --xacp-tcp when enabled\n" +
        "capabilities: stdio\nops: xacp.hello proc.status proc.output ui.tree ui.screenshot ui.input ui.act ui.record\n" +
        "permissions: negotiated after validated xacp.hello (INFO default; token allows 15; RAW=16 requires XU_XACP_ALLOW_RAW=1)\n" +
        "attach: library xacp.attach_stdio() / attach_tcp(port); business main runs; control in xu coroutine\n" +
        "ui: requires register_screen and UI-owner poll; unregistered returns not_implemented\n" +
        "request_id: hello starts at 1; accepted requests consume ids strictly +1; responses echo ids (frame failures use 0)\n" +
        "invalid_request_id: id <= 0, duplicate, backward or skipped; request id is not monotonic; stays connected, id not consumed\n" +
        "request_order: NEW non-hello returns hello_required and closes; active request returns request_in_flight first\n" +
        "request_timeout_id: consumed; next request uses id+1\n" +
        "ui.tree: start >= 0 (default 0); max_table_rows 1..session limit (default min(512, limit)); filtered node window\n" +
        "ui.tree_data: win generation start count total truncated next_start nodes; next page uses start=next_start; final next_start=total\n" +
        "ui.tree_limits: start=total gives empty page; start>total or frame overflow returns adapter_error; invalid bounds return schema_error\n" +
        "ui.tree_generation: if generation changes between pages, restart at 0; no snapshot consistency; total capped at 512\n" +
        "ui.redaction: default true; tree text <=256 bytes; secure inputs empty and screenshot rectangles #808080; raw:true requires RAW\n" +
        "ui.screenshot: mode inline_b64 (default) or file; image/png; bytes and redacted; path argument is schema_error\n" +
        "ui.screenshot_file: relative basename only; dir_hint xacp-runtime; host xacp.screenshot_dir(); private 0700/0600; FIFO 16 files; cleanup on session close\n" +
        "ui.screenshot_errors: screenshot_too_large file_unavailable encode_error; recoverable with request id; lower scale or use file\n" +
        "ui.screenshot_limit: file <=32 MiB; XU_XACP_SCREENSHOT_MAX_BYTES may lower the limit\n" +
        "proc.output: stream stdout/stderr, since >= 0, max_bytes 1..max_frame_bytes (default min(4096,max_frame_bytes/2)); snapshot byte pagination\n" +
        "proc.output_buffer: XU_XACP_OUTPUT_BUFFER per stream, default 65536, range 4096..16777216, invalid uses default; drop-oldest\n" +
        "proc.output_data: stream since count total base dropped truncated next_since data (quoted bytes, non-UTF8/control uses hex escapes); since>total adapter_error; escape expansion shrinks page to frame limit\n" +
        "ui.record: max_bytes is a recording budget, not a cursor; invalid bounds return schema_error; over budget fails\n" +
        "request_timeout: XU_XACP_REQUEST_TIMEOUT_MS (default 5000 ms; ASCII decimal 1..600000; invalid uses default)\n" +
        "nonce_replay: auth error; successful hello nonces are shared across connections; reply then close\n" +
        "nonce_cache: XU_XACP_NONCE_CACHE (default 1024; ASCII decimal 1..65536; invalid uses default); FIFO eviction permits reuse\n" +
        "nonce_check: XU_XACP_NONCE_REPLAY=0 disables replay checks; enabled by default; failed hello never recorded\n" +
        "memory_safety: src/xacp schema and frame limits\n" +
        "default_port: " + str(port) + "\n" +
        "frame: XACP/1 length prefix: XACP/1\\n<bytes>\\n<XUN body>\n" +
        "control: --xacp-stdio (exclusive stdio; business main is not run)\n" +
        "control_tcp: --xacp-tcp (exclusive; first control flag wins; business main is not run)\n" + tcp_help
    _ := os.fd_write(1, help) or (err) {
        eprintln("xacp help: " + err.msg())
        <<< 1
    }
}
