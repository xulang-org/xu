@xacp

#os
#errors
#strings
#time
#unicode/utf8

// Explicit control modes skip business main; the first control flag wins.
// Ordinary invocations never listen or read control stdin. The -- boundary protects application arguments.
pub fn stdio_preflight(port int) {
    _ := output_control_fd()
    argv := os.args()
    for i in 1:argv.len {
        if argv[i] == "--" { << }
        if argv[i] == "--xacp-tcp" {
            code := serve_tcp(port) or (err) {
                eprintln("xacp tcp: " + err.msg())
                <<< 1
            }
            <<< code
        }
        if argv[i] == "--xacp-stdio" {
            code := serve_stdio() or (err) {
                eprintln("xacp stdio: " + err.msg())
                <<< 1
            }
            <<< code
        }
    }
}

fn control_write(fd int, tcp bool, text string) int {
    mut offset := 0
    while offset < text.len {
        mut n := 0
        if tcp {
            n = os.socket_write(fd, text[offset:text.len]) or >>
        } else {
            n = os_fd_write(fd, text[offset:text.len]) or >>
        }
        if n <= 0 { >> errors.new("xacp: output made no progress") }
        offset += n
    }
    << 0
}

pub const MAX_ERROR_MSG_BYTES = 256

// frame_text wraps a body in the XACP/1 length prefix (byte length).
fn frame_text(body string) string {
    << "XACP/1\n" + str(body.len) + "\n" + body
}

// msg is written only when non-empty; it is truncated to MAX_ERROR_MSG_BYTES
// (at a UTF-8 boundary) and always emitted as a one-line quoted string.
fn control_response(fd int, tcp bool, id int, ok bool, code string, data string, msg string) int {
    mut body := "id: !i " + str(id) + "\nok: !b " + str(ok) + "\n"
    if ok {
        if has_prefix(&data,"  redacted: !b true\n") { body = body + "redacted: !b true\n" }
        if has_prefix(&data,"  redacted: !b false\n") { body = body + "redacted: !b false\n" }
        body = body + "data:\n" + data
    } else {
        body = body + "error:\n  code: " + code + "\n"
        if msg.len > 0 {
            safe := redact_paths(&msg)
            mut end := safe.len
            if end > MAX_ERROR_MSG_BYTES {
                end = MAX_ERROR_MSG_BYTES
                while end > 0 && (safe[end] & 192) == 128 { end -= 1 }
            }
            m := safe[0:end]
            body = body + "  msg: " + control_string(&m) + "\n"
        }
    }
    control_write(fd, tcp, frame_text(body)) or >>
    << 0
}

fn control_request(fd int, tcp bool, s &mut Session, frame string, l &Limits, expected_token string, attach bool, jobs chan ControlJob, states chan ScreenRegistration, session_started int, nonces &mut NonceRegistry) int {
    d := parse_frame(frame + "") or (err) {
        close_session(mut &*s)
        control_response(fd, tcp, 0, false, "frame_error", "", err.msg()) or >>
        << 0
    }
    req := validate_request_envelope(&d, l) or (err) {
        close_session(mut &*s)
        control_response(fd, tcp, request_id_hint(&d), false, "schema_error", "", err.msg()) or >>
        << 0
    }
    _ := validate_args(&d,req.args,req.op + "",l) or (err) {
        // Argument errors in an OPEN output session neither close it nor
        // reserve an id. Keep the existing fatal policy for other schemas.
        if req.op != "proc.output" || s.state != STATE_OPEN { close_session(mut &*s) }
        control_response(fd,tcp,req.id,false,"schema_error","",err.msg()) or >>
        << 0
    }
    started := begin_request(mut &*s, &req)
    if !started.ok {
        control_response(fd, tcp, req.id, false, started.err_code, "", started.err_msg) or >>
        << 0
    }
    if request_raw(&d,&req) && (s.permissions & PERM_UI_RAW) == 0 {
        // Like other permission denials, this does not consume the id.
        cancel_request(mut &*s)
        s.next_id = req.id
        control_response(fd,tcp,req.id,false,"permission_denied","","RAW is not authorized") or >>
        << 0
    }
    marshaled := attach && (req.op == "ui.tree" || req.op == "ui.screenshot" || req.op == "ui.act" || req.op == "ui.input" || req.op == "ui.record")
    mut request_started := 0
    if marshaled { request_started = time.now() }
    if req.op == "xacp.hello" {
        if time.since(session_started) >= l.hello_timeout_ms * time.millisecond() {
            control_expired(fd, tcp, s, l) or >>
            << 0
        }
        negotiated := negotiate_hello(mut &*s, &d, &req, expected_token, mut &*nonces)
        if !negotiated.ok {
            control_response(fd, tcp, req.id, false, negotiated.err_code, "", negotiated.err_msg) or >>
            << 0
        }
    } else if marshaled {
        // Only the attach path can wait for a UI owner. Start its monotonic
        // deadline at reservation, before registration/enqueue or reply waits.
        pending := marshal_screen(jobs,states,&req,frame,s.permissions,request_started,l.request_timeout_ms)
        result := export_screenshot(mut &*s,pending,req.id,l)
        if !result.outcome.ok {
            cancel_request(mut &*s)
            control_response(fd,tcp,req.id,false,result.outcome.err_code,"",result.outcome.err_msg) or >>
            << 0
        }
        finished := finish_request(mut &*s,req.id)
        if !finished.ok {
            control_response(fd,tcp,req.id,false,finished.err_code,"",finished.err_msg) or >>
            << 0
        }
        control_response(fd,tcp,req.id,true,"",result.data,"") or >>
        << 0
    } else if req.op == "proc.output" {
        result := process_output(&d,&req,l) or (err) {
            cancel_request(mut &*s)
            control_response(fd,tcp,req.id,false,"adapter_error","",err.msg()) or >>
            << 0
        }
        if !result.outcome.ok {
            cancel_request(mut &*s)
            control_response(fd,tcp,req.id,false,result.outcome.err_code,"",result.outcome.err_msg) or >>
            << 0
        }
        finished := finish_request(mut &*s,req.id)
        control_response(fd,tcp,req.id,finished.ok,finished.err_code,result.data,finished.err_msg) or >>
        << 0
    } else if req.op != "proc.status" {
        // No Screen is registered in the startup adapter.
        // All known operations, including mutate, reach this checked path.
        cancel_request(mut &*s)
        control_response(fd, tcp, req.id, false, "not_implemented", "", "operation has no registered adapter: " + req.op) or >>
        << 0
    }
    finished := finish_request(mut &*s, req.id)
    if !finished.ok {
        control_response(fd, tcp, req.id, false, finished.err_code, "", finished.err_msg) or >>
        << 0
    }
    if req.op == "xacp.hello" {
        control_hello_response(fd, tcp, req.id, &*s) or >>
    } else {
        control_response(fd, tcp, req.id, true, "", "  pid: !i " + str(os.getpid()) + "\n  state: OPEN\n", "") or >>
    }
    << 0
}

// Always quote the nonce on one physical line: framing must not depend on its
// contents. These are the escapes accepted by XUN's quoted string parser.
fn control_string(value &string) string {
    mut out := strings.builder()
    out.write_byte(34)
    mut i := 0
    hex := "0123456789ABCDEF"
    while i < value.len {
        c := value[i] & 255
        if c >= 128 {
            width := control_utf8_width(value,i)
            if width > 0 {
                part := value[i:i + width]
                out.write_string(&part)
                i += width
                ->
            }
        }
        if c == 34 || c == 92 {
            out.write_byte(92)
            out.write_byte(c)
        } else if c == 10 {
            out.write_byte(92)
            out.write_byte(110)
        } else if c == 13 {
            out.write_byte(92)
            out.write_byte(114)
        } else if c == 9 {
            out.write_byte(92)
            out.write_byte(116)
        } else if c < 32 || c >= 127 {
            out.write_byte(92)
            out.write_byte(120)
            out.write_byte(hex[c >> 4])
            out.write_byte(hex[c & 15])
        } else {
            out.write_byte(c)
        }
        i += 1
    }
    out.write_byte(34)
    << out.text()
}

fn control_utf8_width(value &string,i int) int {
    << utf8.decode_width(value,i) or (err) { << 0 }
}

fn control_hello_response(fd int, tcp bool, id int, s &Session) int {
    mut label := "custom"
    if s.permissions == PERM_NONE { label = "none" }
    if s.permissions == PERM_INFO { label = "info" }
    if s.permissions == PERM_ALL { label = "development" }
    nonce := redact_paths(&s.nonce)
    data := "  state: OPEN\n  nonce: " + control_string(&nonce) +
        "\n  permissions: !i " + str(s.permissions) + "\n  permission_label: " + label + "\n"
    control_response(fd, tcp, id, true, "", data, "") or >>
    << 0
}

// Chunked reads and an amortized builder bound memory and copying. EOF and
// fatal frame/schema/auth errors terminate the session; complete frames may share a read.
pub fn serve_stdio() int {
    fd := output_control_fd()
    control := new_screen_control()
    limits := control_limits()
    mut nonces := new_nonce_registry(nonce_cache_from_env(), nonce_replay_from_env())
    << serve_control(0, fd, false, false, control.jobs, control.state, &limits, mut &nonces) or >>
}

fn control_limits() Limits {
    mut limits := default_limits()
    limits.request_timeout_ms = request_timeout_from_env()
    limits.hello_timeout_ms = hello_timeout_from_env()
    limits.idle_timeout_ms = idle_timeout_from_env()
    << limits
}

const FRAME_MAGIC = "XACP/1"
const FRAME_LINE_MAX = 16

fn frame_fatal(fd int, tcp bool, s &mut Session, code string, msg string) int {
    close_session(mut &*s)
    control_response(fd, tcp, 0, false, code, "", msg) or >>
    << 0
}

// Length-prefixed reader: phase 0 = magic line, 1 = length line, 2 = body.
// The body is exactly N bytes and may contain any bytes, including "\n===\n".
fn serve_control(input int, fd int, tcp bool, attach bool, jobs chan ControlJob, states chan ScreenRegistration, limits &Limits, nonces &mut NonceRegistry) int {
    started := time.now()
    mut last_frame := started
    mut session := open_session()
    expected_token := os.getenv("XU_XACP_TOKEN")
    mut line := strings.builder()
    mut body := strings.builder()
    mut phase := 0
    mut need := 0
    while true {
        remaining := control_remaining(&session, limits, started, last_frame)
        if remaining < 0 {
            control_expired(fd, tcp, mut &session, limits) or >>
            << 0
        }
        ready := control_wait(input, tcp, remaining) or (err) {
            close_session(mut &session)
            >> err
        }
        if !ready { -> }
        // Readiness may arrive at the deadline; late hello/body bytes cannot
        // revive a session. Zero remaining means idle expiry is disabled.
        if control_remaining(&session, limits, started, last_frame) < 0 {
            control_expired(fd, tcp, mut &session, limits) or >>
            << 0
        }
        chunk := control_read(input, tcp) or (err) {
            close_session(mut &session)
            >> err
        }
        received := time.now()
        if chunk.len == 0 {
            if phase != 0 || line.length() > 0 {
                frame_fatal(fd, tcp, mut &session, "truncated_frame", "EOF inside frame") or (err) {
                    close_session(mut &session)
                    >> err
                }
            }
            close_session(mut &session)
            << 0
        }
        mut i := 0
        while i < chunk.len {
            c := chunk[i] & 255
            if phase == 2 {
                mut take := chunk.len - i
                if take > need - body.length() { take = need - body.length() }
                part := chunk[i:i + take]
                body.write_string(&part)
                i += take
                if body.length() == need {
                    if control_remaining(&session, limits, started, last_frame) < 0 {
                        control_expired(fd, tcp, mut &session, limits) or >>
                        << 0
                    }
                    // Frames coalesced in one read share its arrival time,
                    // even if dispatch of an earlier frame waits for the UI.
                    last_frame = received
                    control_request(fd, tcp, mut &session, body.text(), limits, expected_token + "", attach, jobs, states, started, mut &*nonces) or (err) {
                        close_session(mut &session)
                        >> err
                    }
                    if session.state == STATE_CLOSED { << 0 }
                    body.reset()
                    phase = 0
                }
                ->
            }
            i += 1
            if c != 10 {
                if line.length() >= FRAME_LINE_MAX {
                    frame_fatal(fd, tcp, mut &session, "frame_error", "frame header line too long") or >>
                    << 0
                }
                line.write_byte(c)
                ->
            }
            text := line.text()
            line.reset()
            if phase == 0 {
                if text != FRAME_MAGIC {
                    frame_fatal(fd, tcp, mut &session, "frame_error", "expected XACP/1 magic line") or >>
                    << 0
                }
                phase = 1
                ->
            }
            mut n := 0
            mut valid := text.len > 0 && text.len <= 8
            for k in 0:text.len {
                d := text[k] & 255
                if d < 48 || d > 57 { valid = false }
                else if valid { n = n * 10 + (d - 48) }
            }
            if !valid || n == 0 {
                frame_fatal(fd, tcp, mut &session, "frame_error", "invalid frame length") or >>
                << 0
            }
            if n > MAX_FRAME_BYTES {
                frame_fatal(fd, tcp, mut &session, "frame_too_large", "frame length exceeds " + str(MAX_FRAME_BYTES)) or >>
                << 1
            }
            need = n
            phase = 2
        }
    }
    << 0
}

// The synchronous request dispatch owns active_id and its request timer.
// These deadlines are checked only between requests, using frame arrival time
// rather than dispatch completion so a slow request does not renew idle time.
fn control_remaining(s &Session, l &Limits, started int, last_frame int) int {
    mut remaining := 0
    if s.state == STATE_NEW {
        remaining = l.hello_timeout_ms * time.millisecond() - time.since(started)
    } else {
        if l.idle_timeout_ms == 0 { << 0 }
        remaining = l.idle_timeout_ms * time.millisecond() - time.since(last_frame)
    }
    if remaining <= 0 { << -1 }
    << remaining
}

fn control_expired(fd int, tcp bool, s &mut Session, l &Limits) int {
    if s.state == STATE_NEW {
        << frame_fatal(fd, tcp, s, "hello_timeout", "hello not completed within " + str(l.hello_timeout_ms) + " ms") or >>
    }
    << frame_fatal(fd, tcp, s, "session_idle", "no complete frame for " + str(l.idle_timeout_ms) + " ms") or >>
}

fn control_wait(fd int, tcp bool, timeout_ns int) bool {
    if tcp {
        ready := os.socket_wait_read(fd, timeout_ns) or >>
        << ready != 0
    }
    ready := os.fd_wait_read(fd, timeout_ns) or >>
    << ready != 0
}

fn control_read(fd int, tcp bool) string {
    if tcp { << os.socket_read(fd, 4096) or >> }
    << os_fd_read(fd, 4096) or >>
}

// Explicit exclusive control mode; loopback only, sequential connections.
// A malformed/disconnected peer ends its session, not the listener.
pub fn serve_tcp(port int) int {
    _ := output_control_fd()
    control := new_screen_control()
    << serve_tcp_control(port,false,control.jobs,control.state) or >>
}

fn serve_tcp_control(port int,attach bool,jobs chan ControlJob,states chan ScreenRegistration) int {
    if port < 1 || port > 65535 {
        >> errors.new("xacp: TCP requires a build with --xacp-port 1..65535")
    }
    limits := control_limits()
    mut nonces := new_nonce_registry(nonce_cache_from_env(), nonce_replay_from_env())
    listener := os.socket(2, 1, 0) or >>
    os.bind4(listener, 127, 0, 0, 1, port) or (err) {
        _ := os.socket_close(listener) or (close_err) { >> err }
        >> err
    }
    os.listen(listener, 16) or (err) {
        _ := os.socket_close(listener) or (close_err) { >> err }
        >> err
    }
    while true {
        peer := os.accept(listener) or (err) {
            _ := os.socket_close(listener) or (close_err) { >> err }
            >> err
        }
        _ := serve_control(peer, peer, true, attach, jobs, states, &limits, mut &nonces) or (err) {
            // Peer errors are isolated; the listener remains available.
            _ := os.socket_close(peer) or >>
            ->
        }
        _ := os.socket_close(peer) or >>
    }
    << 0
}
