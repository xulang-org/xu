@xacp

#ui
#ui/widgets
#ui/draw
#io
#errors
#strconv
#encoding/xun

// ScreenAdapter is the typed bridge between the transport-neutral XACP core
// and a live widgets.Screen. The Screen still owns all native resources; this
// package only borrows it for the duration of each checked operation.
pub const MAX_UI_EVENTS = 512

pub struct Recorder {
    pub mode string
    pub max_bytes int
    pub bytes int
    pub sequence int
    pub closed bool
    pub request_id int
    pub session_generation int
}

pub fn new_recorder(mode string,max_bytes int,l &Limits) Recorder {
    if mode != "events" && mode != "frames" { >> errors.new("xacp: invalid recorder mode") }
    if max_bytes <= 0 || max_bytes > l.max_frame_bytes { >> errors.new("xacp: recorder exceeds memory limit") }
    << Recorder{mode: mode + "",max_bytes: max_bytes,bytes: 0,sequence: 1,closed: false,request_id: 0,session_generation: 0}
}

pub fn (r &mut Recorder) close() {
    r.closed = true
}

pub fn (r &Recorder) is_open() bool { << !r.closed }

fn valid_record_kind(r &Recorder,kind string) bool {
    if kind != "event" { if kind != "frame" { << false } }
    if r.mode == "events" { if kind != "event" { << false } }
    if r.mode == "frames" { if kind != "frame" { << false } }
    << true
}

// write_record is deliberately streaming: no record is retained after the
// sink accepts it. The length prefix lets a consumer reject truncation without
// parsing untrusted payload bytes. A failed sink write does not advance the
// recorder's accounting or sequence.
pub fn write_record#W:StreamWriter(r &mut Recorder,sink &mut W,kind string,data string) int {
    if r.closed { >> errors.new("xacp: recorder is closed") }
    kind_copy := kind + ""
    kind_check := kind_copy + ""
    if !valid_record_kind(&*r,kind_check) { >> errors.new("xacp: invalid recorder record kind") }
    if kind_copy.len == 0 || kind_copy.len > 32 || data.len > r.max_bytes { >> errors.new("xacp: recorder payload exceeds memory limit") }
    header := "XAR1\t" + str(r.sequence) + "\t" + kind_copy + "\t" + str(data.len) + "\n"
    total := header.len + data.len + 1
    if total > r.max_bytes || r.bytes > r.max_bytes - total { >> errors.new("xacp: recorder byte budget exceeded") }
    dst := mut &*sink
    n := dst.write_str(header + data + "\n") or >>
    if n != total { >> errors.new("xacp: recorder short write") }
    r.bytes = r.bytes + total
    r.sequence = r.sequence + 1
    << total
}

fn event_float(v f64) string {
    text := strconv.format_float(v,103,-1) or (err) { << "0.0" }
    << text
}

pub fn input_record(event &ui.InputEvent) string {
    << "kind=" + str(event.kind) + "\twindow=" + str(event.window_id) + "\tcanvas=" + str(event.canvas_id) +
        "\tgeneration=" + str(event.generation) + "\tx=" + event_float(event.x) + "\ty=" + event_float(event.y) +
        "\tdx=" + event_float(event.dx) + "\tdy=" + event_float(event.dy) + "\tbutton=" + str(event.button) +
        "\tbuttons=" + str(event.buttons) + "\tmodifiers=" + str(event.modifiers) + "\tkey=" + str(event.key) +
        "\tscan=" + str(event.scan) + "\trepeat=" + str(event.repeat) + "\tclick_count=" + str(event.click_count) +
        "\ttime_ns=" + str(event.time_ns)
}

pub fn surface_record(surface &draw.Surface) string {
    << "width=" + event_float(surface.width) + "\theight=" + event_float(surface.height) +
        "\tpixel_width=" + str(surface.pixel_width) + "\tpixel_height=" + str(surface.pixel_height)
}

fn step_kind(ev string) int {
    if ev == "pointer_down" { << ui.EV_POINTER_DOWN }
    if ev == "pointer_up" { << ui.EV_POINTER_UP }
    if ev == "pointer_move" { << ui.EV_POINTER_MOVE }
    if ev == "pointer_enter" { << ui.EV_POINTER_ENTER }
    if ev == "pointer_leave" { << ui.EV_POINTER_LEAVE }
    if ev == "pointer_cancel" { << ui.EV_POINTER_CANCEL }
    if ev == "key_down" { << ui.EV_KEY_DOWN }
    if ev == "key_up" { << ui.EV_KEY_UP }
    if ev == "pointer_scroll" || ev == "scroll" { << ui.EV_POINTER_SCROLL }
    << 0
}

fn step_float(d &xun.Doc,step int,key string,default_value f64) f64 {
    node := d.get(step,key + "")
    if node < 0 { << default_value }
    << require_float(d,node,"steps.value") or >>
}

fn step_int(d &xun.Doc,step int,key string,default_value int) int {
    node := d.get(step,key + "")
    if node < 0 { << default_value }
    << require_int(d,node,"steps.value") or >>
}

fn request_input_events(d &xun.Doc,args int,s &widgets.Screen,l &Limits) []ui.InputEvent {
    steps := d.get(args,"steps")
    if steps < 0 || d.kind(steps) != xun.KIND_LIST { >> errors.new("xacp: steps must be a list") }
    if d.count(steps) > MAX_UI_EVENTS || d.count(steps) > l.max_fields { >> errors.new("xacp: too many input steps") }
    mut out := []ui.InputEvent{}
    for i in 0:d.count(steps) {
        step := d.at(steps,i)
        if d.kind(step) != xun.KIND_DICT { >> errors.new("xacp: input step must be a dictionary") }
        ev_node := d.get(step,"ev")
        ev := require_string(d,ev_node,"steps.ev") or >>
        kind := step_kind(ev)
        if kind == 0 { >> errors.new("xacp: unknown input event") }
        input := ui.InputEvent{kind: kind,window_id: s.xacp_window_id(),canvas_id: s.xacp_canvas_id(),generation: s.xacp_generation(),
            x: step_float(d,step,"x",0.0),y: step_float(d,step,"y",0.0),dx: step_float(d,step,"dx",0.0),dy: step_float(d,step,"dy",0.0),
            button: step_int(d,step,"button",0),buttons: step_int(d,step,"buttons",0),modifiers: step_int(d,step,"modifiers",0),
            key: step_int(d,step,"key",0),scan: step_int(d,step,"scan",0),repeat: step_int(d,step,"repeat",0),
            click_count: step_int(d,step,"click_count",0),time_ns: step_int(d,step,"time_ns",0)}
        if input.button < 0 || input.button > 3 || input.buttons < 0 || input.buttons > 7 || input.modifiers < 0 || input.modifiers > 15 ||
           input.key < 0 || input.key > 1114111 || input.scan < 0 || input.scan > 65535 || input.repeat < 0 || input.repeat > 1 || input.click_count < 0 || input.time_ns < 0 {
            >> errors.new("xacp: input step field out of range")
        }
        out.push(input)
    }
    << out
}

// Read-only tree operation. The returned nodes are copies and remain valid
// after the caller releases the Screen borrow.
pub fn screen_tree(s &mut widgets.Screen,include_hidden bool,max_rows int,l &Limits) []widgets.ScreenNodeInfo {
    if max_rows <= 0 || max_rows > l.max_table_rows { >> errors.new("xacp: ui.tree row limit exceeds safety limit") }
    << s.xacp_tree(include_hidden,max_rows) or >>
}

// The Surface is a native resource with explicit ownership. The caller must
// dispose it, including error and cancellation paths; no byte copy is staged
// in the adapter.
pub fn screen_screenshot(s &mut widgets.Screen,scale f64) draw.Surface {
    if scale < 0.1 || scale > 4.0 { >> errors.new("xacp: screenshot scale out of range") }
    << s.snapshot(scale) or >>
}

pub fn screen_screenshot_node(s &mut widgets.Screen,node int,scale f64,l &Limits) draw.Surface {
    if node <= 0 || node > l.max_node_id { >> errors.new("xacp: screenshot node exceeds safety limit") }
    if scale < 0.1 || scale > 4.0 { >> errors.new("xacp: screenshot scale out of range") }
    << s.snapshot_node(node,scale) or >>
}

pub fn screen_input(s &mut widgets.Screen,events &[]ui.InputEvent,l &Limits) []widgets.Action {
    if events.len > l.max_fields || events.len > MAX_UI_EVENTS { >> errors.new("xacp: ui.input exceeds event limit") }
    << s.xacp_input(events,MAX_UI_EVENTS) or >>
}

pub fn screen_input_request(s &mut widgets.Screen,d &xun.Doc,args int,l &Limits) []widgets.Action {
    events := request_input_events(d,args,&*s,l) or >>
    << screen_input(mut &*s,&events,l) or >>
}

pub fn screen_act(s &mut widgets.Screen,id int,act string,text string,checked bool,l &Limits) []widgets.Action {
    if id <= 0 || id > l.max_node_id { >> errors.new("xacp: ui.act node exceeds safety limit") }
    if text.len > l.max_string_bytes { >> errors.new("xacp: ui.act text exceeds memory limit") }
    << s.xacp_act(id,act,text,checked) or >>
}

pub fn start_recorder(session &mut Session,id int,mode string,max_bytes int,l &Limits) Recorder {
    begin_ui(mut &*session,id,"ui.record") or >>
    mut result := new_recorder(mode,max_bytes,l) or (err) { cancel_request(mut &*session)
        >> err }
    result.request_id = id
    result.session_generation = session.generation
    << result
}

pub fn finish_recorder(session &mut Session,r &mut Recorder) int {
    if r.closed { >> errors.new("xacp: recorder is closed") }
    if r.request_id <= 0 || r.session_generation != session.generation { >> errors.new("xacp: recorder has stale session lifetime") }
    end_ui(mut &*session,r.request_id) or >>
    r.closed = true
    << 0
}

pub fn abort_recorder(session &mut Session,r &mut Recorder) {
    if r.closed { << }
    if r.request_id > 0 && r.session_generation == session.generation { cancel_request(mut &*session) }
    r.closed = true
}

fn begin_ui(s &mut Session,id int,op string) int {
    request := Request{id: id,op: op + "",args: -1}
    result := begin_request(mut &*s,&request)
    if !result.ok { >> errors.new(result.err_code + ": " + result.err_msg) }
    << 0
}

fn end_ui(s &mut Session,id int) int {
    result := finish_request(mut &*s,id)
    if !result.ok { >> errors.new(result.err_code + ": " + result.err_msg) }
    << 0
}

fn screen_window_matches(s &widgets.Screen,d &xun.Doc,args int,required bool) bool {
    node := d.get(args,"win")
    if node < 0 {
        << !required
    }
    win := d.as_int(node)
    << win > 0 && win == s.xacp_window_id()
}

// Permission-bearing entry points. Every operation reserves a monotonic
// request id and releases it on both success and adapter failure.
pub fn ui_tree(s &mut widgets.Screen,session &mut Session,id int,include_hidden bool,max_rows int,l &Limits) []widgets.ScreenNodeInfo {
    begin_ui(mut &*session,id,"ui.tree") or >>
    result := screen_tree(mut &*s,include_hidden,max_rows,l) or (err) { cancel_request(mut &*session)
        >> err }
    end_ui(mut &*session,id) or >>
    << result
}

pub fn ui_screenshot(s &mut widgets.Screen,session &mut Session,id int,scale f64,l &Limits) draw.Surface {
    begin_ui(mut &*session,id,"ui.screenshot") or >>
    if scale < 0.1 || scale > 4.0 { cancel_request(mut &*session)
        >> errors.new("xacp: screenshot scale out of range") }
    mut result := screen_screenshot(mut &*s,scale) or (err) { cancel_request(mut &*session)
        >> err }
    end_ui(mut &*session,id) or (err) { result.dispose()
        >> err }
    << result
}

pub fn ui_screenshot_node(s &mut widgets.Screen,session &mut Session,id int,node int,scale f64,l &Limits) draw.Surface {
    begin_ui(mut &*session,id,"ui.screenshot") or >>
    mut result := screen_screenshot_node(mut &*s,node,scale,l) or (err) { cancel_request(mut &*session)
        >> err }
    end_ui(mut &*session,id) or (err) { result.dispose()
        >> err }
    << result
}

pub fn ui_input(s &mut widgets.Screen,session &mut Session,id int,events &[]ui.InputEvent,l &Limits) []widgets.Action {
    begin_ui(mut &*session,id,"ui.input") or >>
    result := screen_input(mut &*s,events,l) or (err) { cancel_request(mut &*session)
        >> err }
    end_ui(mut &*session,id) or >>
    << result
}

pub fn ui_input_request(s &mut widgets.Screen,session &mut Session,id int,d &xun.Doc,args int,l &Limits) []widgets.Action {
    begin_ui(mut &*session,id,"ui.input") or >>
    result := screen_input_request(mut &*s,d,args,l) or (err) { cancel_request(mut &*session)
        >> err }
    end_ui(mut &*session,id) or >>
    << result
}

pub fn ui_act(s &mut widgets.Screen,session &mut Session,id int,request_id int,act string,text string,checked bool,l &Limits) []widgets.Action {
    begin_ui(mut &*session,request_id,"ui.act") or >>
    result := screen_act(mut &*s,id,act,text,checked,l) or (err) { cancel_request(mut &*session)
        >> err }
    end_ui(mut &*session,request_id) or >>
    << result
}

// dispatch_screen executes the schema-approved UI operations against the
// registered Screen and serializes every successful result before releasing
// the borrow. Surface bytes are not exported yet; screenshot metadata is returned
// only after snapshot succeeds, and the native Surface is always disposed.
pub fn dispatch_screen(s &mut widgets.Screen,session &mut Session,d &xun.Doc,l &Limits) ControlReply {
    request := validate_request(d,l) or (err) { close_session(mut &*session)
        << screen_failure("schema_error",err.msg()) }
    if request.op == "xacp.hello" {
        << screen_reply(dispatch(mut &*session,d,l), "")
    }
    started := begin_request(mut &*session,&request)
    if !started.ok { << screen_reply(started, "") }
    if !s.is_open() { cancel_request(mut &*session)
        << screen_failure("stale_window","screen is closed") }
    mut data := ""
    if request.op == "ui.tree" {
        if !screen_window_matches(&*s,d,request.args,false) { cancel_request(mut &*session)
            << screen_failure("stale_window","stale or foreign screen window") }
        include_hidden := d.get(request.args,"include_hidden") >= 0 && require_bool(d,d.get(request.args,"include_hidden"),"include_hidden")
        mut max_rows := widgets.XACP_MAX_NODES
        if l.max_table_rows < max_rows { max_rows = l.max_table_rows }
        if d.get(request.args,"max_table_rows") >= 0 { max_rows = require_int(d,d.get(request.args,"max_table_rows"),"max_table_rows") }
        tree_result := screen_tree(mut &*s,include_hidden,max_rows,l) or (err) { cancel_request(mut &*session)
            >> err }
        data = serialize_tree(&*s,tree_result,l) or (err) { cancel_request(mut &*session)
            >> err }
    } else if request.op == "ui.screenshot" {
        if !screen_window_matches(&*s,d,request.args,true) { cancel_request(mut &*session)
            << screen_failure("stale_window","stale or foreign screen window") }
        mut scale := 1.0
        if d.get(request.args,"scale") >= 0 { scale = require_float(d,d.get(request.args,"scale"),"scale") }
        if d.get(request.args,"node") >= 0 {
            node := require_int(d,d.get(request.args,"node"),"node")
            mut surface := screen_screenshot_node(mut &*s,node,scale,l) or (err) { cancel_request(mut &*session)
                >> err }
            data = serialize_surface(&surface)
            surface.dispose()
        } else {
            mut surface := screen_screenshot(mut &*s,scale) or (err) { cancel_request(mut &*session)
                >> err }
            data = serialize_surface(&surface)
            surface.dispose()
        }
    } else if request.op == "ui.input" {
        if !screen_window_matches(&*s,d,request.args,true) { cancel_request(mut &*session)
            << screen_failure("stale_window","stale or foreign screen window") }
        input_result := screen_input_request(mut &*s,d,request.args,l) or (err) { cancel_request(mut &*session)
            >> err }
        data = serialize_actions(input_result,l) or (err) { cancel_request(mut &*session)
            >> err }
    } else if request.op == "ui.act" {
        if !screen_window_matches(&*s,d,request.args,true) { cancel_request(mut &*session)
            << screen_failure("stale_window","stale or foreign screen window") }
        node := require_int(d,d.get(request.args,"node"),"node")
        act := require_string(d,d.get(request.args,"act"),"act")
        mut text := ""
        if d.get(request.args,"text") >= 0 { text = require_string(d,d.get(request.args,"text"),"text") }
        mut checked := false
        if d.get(request.args,"checked") >= 0 { checked = require_bool(d,d.get(request.args,"checked"),"checked") }
        act_result := screen_act(mut &*s,node,act,text,checked,l) or (err) { cancel_request(mut &*session)
            >> err }
        data = serialize_actions(act_result,l) or (err) { cancel_request(mut &*session)
            >> err }
    } else if request.op == "ui.record" {
        if !screen_window_matches(&*s,d,request.args,true) { cancel_request(mut &*session)
            << screen_failure("stale_window","stale or foreign screen window") }
        cancel_request(mut &*session)
        << screen_failure("stream_required","use start_recorder with a StreamWriter for ui.record")
    } else {
        cancel_request(mut &*session)
        << screen_failure("not_implemented","operation has no registered Screen adapter")
    }
    << screen_reply(finish_request(mut &*session,request.id),data)
}
