@xacp

#encoding/xun
#errors
#strconv

// XACP is the safety core for Xu Agent Control Protocol adapters.  It is
// deliberately transport-free: callers must parse and validate a request
// before they are allowed to dispatch it to a process, UI, or event loop.
// No operation other than xacp.hello is enabled by default.

pub const MAX_FRAME_BYTES = 1048576
pub const MAX_STRING_BYTES = 65536
pub const MAX_FIELDS = 64
pub const MAX_TABLE_ROWS = 10000
pub const MAX_NODE_ID = 16777215

pub const STATE_NEW = 0
pub const STATE_OPEN = 1
pub const STATE_CLOSED = 2

pub const PERM_NONE = 0
pub const PERM_INFO = 1
pub const PERM_PROCESS = 2
pub const PERM_UI_READ = 4
pub const PERM_UI_MUTATE = 8
pub const PERM_ALL = 15

pub struct Limits {
    pub max_frame_bytes int
    pub max_string_bytes int
    pub max_fields int
    pub max_table_rows int
    pub max_node_id int
}

pub struct Session {
    pub state int
    pub generation int
    pub next_id int
    pub active_id int
    pub active_generation int
    pub permissions int
    pub bytes_in int
    pub bytes_out int
}

pub struct Request {
    pub id int
    pub op string
    pub args int
}

pub struct Outcome {
    pub ok bool
    pub request_id int
    pub err_code string
    pub err_msg string
}

pub fn default_limits() Limits {
    << Limits{
        max_frame_bytes: MAX_FRAME_BYTES,
        max_string_bytes: MAX_STRING_BYTES,
        max_fields: MAX_FIELDS,
        max_table_rows: MAX_TABLE_ROWS,
        max_node_id: MAX_NODE_ID
    }
}

pub fn open_session() Session {
    << Session{
        state: STATE_NEW,
        generation: 1,
        next_id: 1,
        active_id: 0,
        active_generation: 0,
        permissions: PERM_NONE,
        bytes_in: 0,
        bytes_out: 0
    }
}

pub fn close_session(s &mut Session) {
    s.state = STATE_CLOSED
    s.generation = s.generation + 1
    s.active_id = 0
    s.active_generation = 0
    s.permissions = PERM_NONE
}

pub fn cancel_request(s &mut Session) {
    if s.active_id > 0 {
        s.active_id = 0
        s.active_generation = 0
    }
}

// Permission grants are explicit host policy.  Unknown bits are rejected and
// permissions cannot be changed after a session has begun serving requests.
pub fn set_permissions(s &mut Session, permissions int) bool {
    if s.state != STATE_NEW {
        << false
    }
    if permissions < 0 || (permissions & 15) != permissions {
        << false
    }
    s.permissions = permissions
    << true
}

// Development hosts may opt into the complete permission set explicitly.
// This is policy only; schema, byte, window, and lifecycle checks still apply.
pub fn development_permissions() int {
    << PERM_ALL
}

pub fn enable_development(s &mut Session) bool {
    << set_permissions(mut &*s, PERM_ALL)
}

fn fail(code string, msg string) Outcome {
    << Outcome{ok: false, request_id: 0, err_code: code, err_msg: msg}
}

fn pass(id int) Outcome {
    << Outcome{ok: true, request_id: id, err_code: "", err_msg: ""}
}

fn valid_limits(l &Limits) bool {
    if l.max_frame_bytes <= 0 || l.max_frame_bytes > MAX_FRAME_BYTES { << false }
    if l.max_string_bytes <= 0 || l.max_string_bytes > MAX_STRING_BYTES { << false }
    if l.max_fields <= 0 || l.max_fields > MAX_FIELDS { << false }
    if l.max_table_rows <= 0 || l.max_table_rows > MAX_TABLE_ROWS { << false }
    if l.max_node_id <= 0 || l.max_node_id > MAX_NODE_ID { << false }
    << true
}

fn has_prefix(s &string, prefix string) bool {
    if prefix.len > s.len { << false }
    for i in 0:prefix.len {
        if s[i] != prefix[i] { << false }
    }
    << true
}

fn has_suffix(s &string, suffix string) bool {
    if suffix.len > s.len { << false }
    start := s.len - suffix.len
    for i in 0:suffix.len {
        if s[start + i] != suffix[i] { << false }
    }
    << true
}

fn trim_frame_body(src &string) string {
    mut start := 0
    mut end := src.len
    while start < end && ((src[start] & 255) == 10 || (src[start] & 255) == 13) {
        start += 1
    }
    while end > start && ((src[end - 1] & 255) == 10 || (src[end - 1] & 255) == 13) {
        end -= 1
    }
    << src[start:end]
}

// parse_frame enforces the XACP envelope before XUN sees any bytes.  It does
// not accept trailing data, embedded NULs, or a frame larger than the XUN
// parser's hard limit.
pub fn parse_frame(src string) xun.Doc {
    if src.len == 0 || src.len > MAX_FRAME_BYTES {
        >> errors.new("xacp: frame exceeds memory limit")
    }
    raw := trim_frame_body(&src)
    open := "--- !xacp\n"
    close := "\n==="
    if !has_prefix(&raw, open) || !has_suffix(&raw, close) {
        >> errors.new("xacp: invalid frame envelope")
    }
    body := raw[open.len:raw.len - close.len]
    if body.len == 0 {
        >> errors.new("xacp: empty frame body")
    }
    d := xun.parse(&body)
    if !d.ok() {
        >> errors.new("xacp: XUN parse error at line " + str(d.error_line()) + ": " + d.error())
    }
    << d
}

fn require_scalar(d &xun.Doc, node int, name string) string {
    if node < 0 || d.kind(node) != xun.KIND_SCALAR {
        >> errors.new("xacp: " + name + " must be a scalar")
    }
    text := d.text(node)
    if text.len > MAX_STRING_BYTES {
        >> errors.new("xacp: " + name + " exceeds memory limit")
    }
    << text
}

fn require_string(d &xun.Doc, node int, name string) string {
    label := name + ""
    text := require_scalar(d, node, label + "")
    tag := d.tag(node)
    if tag != "" && tag != "s" {
        >> errors.new("xacp: " + label + " has the wrong type tag")
    }
    if text.len == 0 {
        >> errors.new("xacp: " + label + " must not be empty")
    }
    << text
}

fn require_int(d &xun.Doc, node int, name string) int {
    label := name + ""
    text := require_scalar(d, node, label + "")
    if d.tag(node) != "i" {
        >> errors.new("xacp: " + label + " requires !i")
    }
    value := strconv.parse(&text, 10) or (err) {
        >> errors.new("xacp: " + label + " is not a valid integer")
    }
    << value
}

fn require_bool(d &xun.Doc, node int, name string) bool {
    label := name + ""
    text := require_scalar(d, node, label + "")
    if d.tag(node) != "b" || (text != "true" && text != "false") {
        >> errors.new("xacp: " + label + " requires !b true/false")
    }
    << text == "true"
}

fn require_float(d &xun.Doc, node int, name string) f64 {
    label := name + ""
    text := require_scalar(d, node, label + "")
    if d.tag(node) != "f" {
        >> errors.new("xacp: " + label + " requires !f")
    }
    value := strconv.parse_float(&text) or (err) {
        >> errors.new("xacp: " + label + " is not a valid float")
    }
    << value
}

fn require_version(d &xun.Doc, node int) int {
    text := require_scalar(d, node, "ver")
    if d.tag(node) != "ver" || text != "1.0.0" {
        >> errors.new("xacp: ver must be !ver 1.0.0")
    }
    << 0
}

fn key_allowed(op string, key string) bool {
    if op == "xacp.hello" {
        << key == "ver" || key == "token"
    }
    if op == "proc.status" { << false }
    if op == "proc.output" { << key == "stream" || key == "since" || key == "max_bytes" }
    if op == "ui.tree" { << key == "win" || key == "include_hidden" || key == "max_table_rows" }
    if op == "ui.screenshot" { << key == "win" || key == "node" || key == "scale" || key == "mode" }
    if op == "ui.input" { << key == "win" || key == "steps" }
    if op == "ui.act" { << key == "win" || key == "node" || key == "act" || key == "text" || key == "checked" }
    if op == "ui.record" { << key == "win" || key == "mode" || key == "max_bytes" }
    << false
}

fn has_field(d &xun.Doc, args int, key string) bool {
    << d.get(args, key) >= 0
}

fn validate_steps(d &xun.Doc, node int, l &Limits) int {
    if node < 0 || d.kind(node) != xun.KIND_LIST {
        >> errors.new("xacp: steps must be a list")
    }
    count := d.count(node)
    if count > l.max_fields { >> errors.new("xacp: steps exceeds field limit") }
    for i in 0:count {
        step := d.at(node, i)
        if d.kind(step) != xun.KIND_DICT || d.count(step) > l.max_fields {
            >> errors.new("xacp: each input step must be a bounded dictionary")
        }
        ev := d.get(step, "ev")
        if ev < 0 { >> errors.new("xacp: input step requires ev") }
        event_name := require_string(d, ev, "steps.ev")
        if event_name != "pointer_down" && event_name != "pointer_up" && event_name != "pointer_move" &&
           event_name != "pointer_enter" && event_name != "pointer_leave" && event_name != "pointer_cancel" &&
           event_name != "key_down" && event_name != "key_up" && event_name != "pointer_scroll" && event_name != "scroll" {
            >> errors.new("xacp: unknown input event")
        }
        for j in 0:d.count(step) {
            child := d.at(step,j)
            key := d.key(child)
            if key != "ev" && key != "x" && key != "y" && key != "dx" && key != "dy" && key != "button" &&
               key != "buttons" && key != "modifiers" && key != "key" && key != "scan" && key != "repeat" &&
               key != "click_count" && key != "time_ns" {
                >> errors.new("xacp: unknown input step field '" + key + "'")
            }
            if key == "x" || key == "y" || key == "dx" || key == "dy" {
                _ := require_float(d,child,"steps." + key)
            } else if key != "ev" {
                _ := require_int(d,child,"steps." + key)
            }
        }
    }
    << 0
}

fn validate_action(d &xun.Doc, args int) int {
    act_node := d.get(args, "act")
    act := require_string(d, act_node, "act")
    allowed := act == "focus" || act == "click" || act == "set_text" || act == "set_checked"
    if !allowed { >> errors.new("xacp: ui.act action is not enabled") }
    if act == "set_text" {
        text := d.get(args, "text")
        if text < 0 { >> errors.new("xacp: set_text requires text") }
        _ := require_string(d, text, "text")
    }
    if act == "set_checked" {
        checked := d.get(args, "checked")
        if checked < 0 { >> errors.new("xacp: set_checked requires checked") }
        _ := require_bool(d, checked, "checked")
    }
    if act != "set_text" && has_field(d,args,"text") { >> errors.new("xacp: text is only valid for set_text") }
    if act != "set_checked" && has_field(d,args,"checked") { >> errors.new("xacp: checked is only valid for set_checked") }
    << 0
}

fn validate_args(d &xun.Doc, args int, op string, l &Limits) int {
    if args < 0 || d.kind(args) != xun.KIND_DICT {
        >> errors.new("xacp: args must be a dictionary")
    }
    count := d.count(args)
    if count > l.max_fields {
        >> errors.new("xacp: args exceeds field limit")
    }
    for i in 0:count {
        child := d.at(args, i)
        key := d.key(child)
        key_copy := key + ""
        if !key_allowed(op + "", key_copy + "") {
            >> errors.new("xacp: unknown or disabled field '" + key_copy + "'")
        }
        if key_copy == "ver" {
            _ := require_version(d, child)
        } else if key_copy == "token" {
            _ := require_string(d, child, "token")
        }
    }
    if op == "xacp.hello" {
        ver := d.get(args, "ver")
        if ver < 0 { >> errors.new("xacp: missing args.ver") }
    } else if op == "proc.status" {
        if count != 0 { >> errors.new("xacp: proc.status args must be empty") }
    } else if op == "proc.output" {
        stream := d.get(args, "stream")
        if stream < 0 { >> errors.new("xacp: proc.output requires stream") }
        stream_name := require_string(d, stream, "stream")
        if stream_name != "stdout" && stream_name != "stderr" { >> errors.new("xacp: invalid output stream") }
        if has_field(d, args, "since") {
            since := require_int(d, d.get(args, "since"), "since")
            if since < 0 { >> errors.new("xacp: since must be non-negative") }
        }
        if has_field(d, args, "max_bytes") {
            max_bytes := require_int(d, d.get(args, "max_bytes"), "max_bytes")
            if max_bytes <= 0 || max_bytes > l.max_frame_bytes { >> errors.new("xacp: max_bytes exceeds limit") }
        }
    } else if op == "ui.tree" {
        if has_field(d, args, "win") {
            win := require_int(d, d.get(args, "win"), "win")
            if win < 0 { >> errors.new("xacp: win must be non-negative") }
        }
        if has_field(d, args, "include_hidden") { _ := require_bool(d, d.get(args, "include_hidden"), "include_hidden") }
        if has_field(d, args, "max_table_rows") {
            rows := require_int(d, d.get(args, "max_table_rows"), "max_table_rows")
            if rows <= 0 || rows > l.max_table_rows { >> errors.new("xacp: max_table_rows exceeds limit") }
        }
    } else if op == "ui.screenshot" {
        win := require_int(d, d.get(args, "win"), "win")
        if win <= 0 { >> errors.new("xacp: screenshot win must be positive") }
        if has_field(d, args, "node") { if !check_node(require_int(d, d.get(args, "node"), "node"), l) { >> errors.new("xacp: node exceeds limit") } }
        if has_field(d, args, "scale") {
            scale := require_float(d, d.get(args, "scale"), "scale")
            if scale < 0.1 || scale > 4.0 { >> errors.new("xacp: screenshot scale out of range") }
        }
        if has_field(d, args, "mode") {
            mode := require_string(d, d.get(args, "mode"), "mode")
            if mode != "file" && mode != "inline_b64" { >> errors.new("xacp: invalid screenshot mode") }
        }
    } else if op == "ui.input" {
        win := require_int(d, d.get(args, "win"), "win")
        if win <= 0 { >> errors.new("xacp: input win must be positive") }
        _ := validate_steps(d, d.get(args, "steps"), l)
    } else if op == "ui.act" {
        win := require_int(d, d.get(args, "win"), "win")
        node := require_int(d, d.get(args, "node"), "node")
        if win <= 0 || !check_node(node, l) { >> errors.new("xacp: ui.act target exceeds limit") }
        _ := validate_action(d, args)
    } else if op == "ui.record" {
        win := require_int(d, d.get(args, "win"), "win")
        if win <= 0 { >> errors.new("xacp: record win must be positive") }
        mode := require_string(d, d.get(args, "mode"), "mode")
        if mode != "events" && mode != "frames" { >> errors.new("xacp: invalid record mode") }
        if has_field(d, args, "max_bytes") {
            max_bytes := require_int(d, d.get(args, "max_bytes"), "max_bytes")
            if max_bytes <= 0 || max_bytes > l.max_frame_bytes { >> errors.new("xacp: record max_bytes exceeds limit") }
        }
    }
    << 0
}

// validate_request enforces the fixed top-level schema and rejects every
// operation that has not been explicitly added to this package's schema.
pub fn validate_request(d &xun.Doc, l &Limits) Request {
    if !valid_limits(l) {
        >> errors.new("xacp: invalid safety limits")
    }
    root := d.root()
    if root < 0 || d.kind(root) != xun.KIND_DICT {
        >> errors.new("xacp: request root must be a dictionary")
    }
    if d.count(root) != 3 {
        >> errors.new("xacp: request top level must contain exactly id, op, args")
    }
    id_node := d.get(root, "id")
    op_node := d.get(root, "op")
    args_node := d.get(root, "args")
    if id_node < 0 || op_node < 0 || args_node < 0 {
        >> errors.new("xacp: request requires id, op, and args")
    }
    id := require_int(d, id_node, "id")
    if id <= 0 { >> errors.new("xacp: id must be positive") }
    op := require_string(d, op_node, "op")
    known := op == "xacp.hello" || op == "proc.status" || op == "proc.output" || op == "ui.tree" || op == "ui.screenshot" || op == "ui.input" || op == "ui.act" || op == "ui.record"
    if !known { >> errors.new("xacp: unknown operation") }
    _ := validate_args(d, args_node, op + "", l)
    << Request{id: id, op: op + "", args: args_node}
}

fn operation_permission(op string) int {
    if op == "xacp.hello" { << PERM_NONE }
    if op == "proc.status" { << PERM_INFO }
    if op == "ui.tree" || op == "ui.screenshot" || op == "ui.record" { << PERM_UI_READ }
    if op == "proc.output" { << PERM_PROCESS }
    << PERM_UI_MUTATE
}

pub fn authorized(s &mut Session, r &Request) bool {
    if s.state == STATE_CLOSED { << false }
    if r.op == "xacp.hello" { << s.state == STATE_NEW }
    required := operation_permission(r.op)
    if required == PERM_NONE { << false }
    << (s.permissions & required) == required
}

pub fn begin_request(s &mut Session, r &Request) Outcome {
    if s.state == STATE_CLOSED { << fail("session_closed", "session is closed") }
    if s.active_id != 0 { << fail("request_in_flight", "one request is already active") }
    if r.id <= 0 || r.id != s.next_id { << fail("invalid_request_id", "request id is not monotonic") }
    if !authorized(s, r) { << fail("permission_denied", "operation is not authorized") }
    s.active_id = r.id
    s.active_generation = s.generation
    s.next_id = s.next_id + 1
    << pass(r.id)
}

pub fn finish_request(s &mut Session, id int) Outcome {
    if s.state == STATE_CLOSED { << fail("session_closed", "session is closed") }
    if s.active_id != id || s.active_generation != s.generation {
        << fail("stale_request", "request does not belong to the active session")
    }
    s.active_id = 0
    s.active_generation = 0
    if id == 1 { s.state = STATE_OPEN }
    << pass(id)
}

pub fn consume_input(s &mut Session, n int, l &Limits) bool {
    if n < 0 || n > l.max_frame_bytes { << false }
    if s.bytes_in > l.max_frame_bytes - n { << false }
    s.bytes_in = s.bytes_in + n
    << true
}

pub fn consume_output(s &mut Session, n int, l &Limits) bool {
    if n < 0 || n > l.max_frame_bytes { << false }
    if s.bytes_out > l.max_frame_bytes - n { << false }
    s.bytes_out = s.bytes_out + n
    << true
}

pub fn check_window(start int, count int, total int, l &Limits) bool {
    if start < 0 || count < 0 || total < 0 { << false }
    if count > l.max_table_rows { << false }
    if start > total || count > total - start { << false }
    << true
}

pub fn check_node(node int, l &Limits) bool {
    << node >= 0 && node <= l.max_node_id
}

// dispatch performs only the safe core lifecycle.  It intentionally returns
// permission_denied for every operation not yet implemented by the dispatcher.
pub fn dispatch(s &mut Session, d &xun.Doc, l &Limits) Outcome {
    req := validate_request(d, l) or (err) {
        << fail("schema_error", err.msg())
    }
    started := begin_request(mut &*s, &req)
    if !started.ok { << started }
    if req.op != "xacp.hello" {
        cancel_request(mut &*s)
        << fail("not_implemented", "operation has no registered adapter")
    }
    << finish_request(mut &*s, req.id)
}
