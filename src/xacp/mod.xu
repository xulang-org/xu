@xacp

#encoding/xun
#errors
#strconv
#crypto/subtle
#os

// XACP is the safety core for Xu Agent Control Protocol adapters.  It is
// deliberately transport-free: callers must parse and validate a request
// before they are allowed to dispatch it to a process, UI, or event loop.
// No operation other than xacp.hello is enabled by default.

pub const MAX_FRAME_BYTES = 1048576
pub const MAX_STRING_BYTES = 65536
pub const MAX_FIELDS = 64
pub const MAX_TABLE_ROWS = 10000
pub const MAX_NODE_ID = 16777215
pub const DEFAULT_REQUEST_TIMEOUT_MS = 5000
pub const MAX_REQUEST_TIMEOUT_MS = 600000
pub const DEFAULT_WRITE_TIMEOUT_MS = 10000
pub const MAX_WRITE_TIMEOUT_MS = 600000
pub const DEFAULT_HELLO_TIMEOUT_MS = 5000
pub const MAX_HELLO_TIMEOUT_MS = 600000
pub const DEFAULT_IDLE_TIMEOUT_MS = 60000
pub const MIN_IDLE_TIMEOUT_MS = 1000
pub const MAX_IDLE_TIMEOUT_MS = 3600000
pub const DEFAULT_NONCE_CACHE = 1024
pub const MAX_NONCE_CACHE = 65536

pub const STATE_NEW = 0
pub const STATE_OPEN = 1
pub const STATE_CLOSED = 2

pub const PERM_NONE = 0
pub const PERM_INFO = 1
pub const PERM_PROCESS = 2
pub const PERM_UI_READ = 4
pub const PERM_UI_MUTATE = 8
pub const PERM_UI_RAW = 16
pub const PERM_ALL = 31

pub struct Limits {
    pub max_frame_bytes int
    pub max_string_bytes int
    pub max_fields int
    pub max_table_rows int
    pub max_node_id int
    pub request_timeout_ms int
    pub write_timeout_ms int
    pub hello_timeout_ms int
    pub idle_timeout_ms int
}

pub struct Session {
    pub state int
    pub generation int
    pub next_id int
    pub active_id int
    pub active_generation int
    pub permissions int
    pub nonce string
    pub bytes_in int
    pub bytes_out int
    screenshot_files bool
}

// The host owns this bounded FIFO across sessions. Sequential listeners borrow
// it exclusively while negotiating; concurrent hosts must serialize that borrow.
pub struct NonceRegistry {
    entries []string
    capacity int
    next int
    enabled bool
}

// Invalid capacities use the default. Disabled registries retain no nonces.
pub fn new_nonce_registry(capacity int, enabled bool) NonceRegistry {
    $limit := capacity
    if limit < 1 || limit > MAX_NONCE_CACHE { limit = DEFAULT_NONCE_CACHE }
    << NonceRegistry{entries: []string{}, capacity: limit, next: 0, enabled: enabled}
}

// Called only after successful schema, authentication and permission checks.
// Replays do not refresh FIFO order; evicted nonces may be used again.
fn register_nonce(registry $&NonceRegistry, nonce &string) bool {
    if !registry.enabled { << true }
    for i in 0:registry.entries.len {
        if registry.entries[i] == *nonce { << false }
    }
    // Keep an owning copy independent of the request document and Session.
    if registry.entries.len < registry.capacity {
        registry.entries.push(*nonce + "")
    } else {
        registry.entries[registry.next] = *nonce + ""
        registry.next += 1
        if registry.next == registry.capacity { registry.next = 0 }
    }
    << true
}

pub struct Request {
    pub id int
    pub op string
    pub args int
}

pub struct Outcome {
    pub ok bool
    pub request_id int
    pub err_code string
    pub err_msg string
}

pub fn default_limits() Limits {
    << Limits{
        max_frame_bytes: MAX_FRAME_BYTES,
        max_string_bytes: MAX_STRING_BYTES,
        max_fields: MAX_FIELDS,
        max_table_rows: MAX_TABLE_ROWS,
        max_node_id: MAX_NODE_ID,
        request_timeout_ms: DEFAULT_REQUEST_TIMEOUT_MS,
        write_timeout_ms: DEFAULT_WRITE_TIMEOUT_MS,
        hello_timeout_ms: DEFAULT_HELLO_TIMEOUT_MS,
        idle_timeout_ms: DEFAULT_IDLE_TIMEOUT_MS
    }
}

// Read once when the control server initializes its limits. Only ASCII decimal
// 1..600000 is accepted; invalid values silently keep the default deadline.
pub fn request_timeout_from_env() int {
    << timeout_from_env("XU_XACP_REQUEST_TIMEOUT_MS", 1, MAX_REQUEST_TIMEOUT_MS, DEFAULT_REQUEST_TIMEOUT_MS, false)
}

// write_timeout_from_env accepts ASCII decimal 1..600000, otherwise the default.
pub fn write_timeout_from_env() int {
    << timeout_from_env("XU_XACP_WRITE_TIMEOUT_MS", 1, MAX_WRITE_TIMEOUT_MS, DEFAULT_WRITE_TIMEOUT_MS, false)
}

// hello_timeout_from_env accepts ASCII decimal 1..600000, otherwise the default.
pub fn hello_timeout_from_env() int {
    << timeout_from_env("XU_XACP_HELLO_TIMEOUT_MS", 1, MAX_HELLO_TIMEOUT_MS, DEFAULT_HELLO_TIMEOUT_MS, false)
}

// idle_timeout_from_env accepts 1000..3600000 or 0 to disable idle expiry.
// Empty, malformed, out-of-range and overflowing input keeps the default.
pub fn idle_timeout_from_env() int {
    << timeout_from_env("XU_XACP_IDLE_TIMEOUT_MS", MIN_IDLE_TIMEOUT_MS, MAX_IDLE_TIMEOUT_MS, DEFAULT_IDLE_TIMEOUT_MS, true)
}

// Hosts read nonce policy once when starting a listener/control loop.
pub fn nonce_cache_from_env() int {
    << timeout_from_env("XU_XACP_NONCE_CACHE", 1, MAX_NONCE_CACHE, DEFAULT_NONCE_CACHE, false)
}

pub fn nonce_replay_from_env() bool {
    << os.getenv("XU_XACP_NONCE_REPLAY") != "0"
}

fn timeout_from_env(name string, minimum int, maximum int, fallback int, allow_zero bool) int {
    text := os.getenv(name)
    if text.len == 0 { << fallback }
    $value := 0
    for i in 0:text.len {
        c := text[i] & 255
        if c < 48 || c > 57 { << fallback }
        digit := c - 48
        if value > (maximum - digit) / 10 { << fallback }
        value = value * 10 + digit
    }
    if value == 0 && allow_zero { << 0 }
    if value < minimum { << fallback }
    << value
}

pub fn open_session() Session {
    << Session{
        state: STATE_NEW,
        generation: screenshot_generation(),
        next_id: 1,
        active_id: 0,
        active_generation: 0,
        permissions: PERM_NONE,
        nonce: "",
        bytes_in: 0,
        bytes_out: 0,
        screenshot_files: false
    }
}

pub fn close_session(s $&Session) {
    if s.screenshot_files {
        cleanup_screenshots(s.generation)
        s.screenshot_files = false
    }
    s.state = STATE_CLOSED
    s.generation = s.generation + 1
    s.active_id = 0
    s.active_generation = 0
    s.permissions = PERM_NONE
    s.nonce = ""
}

pub fn cancel_request(s $&Session) {
    if s.active_id > 0 {
        s.active_id = 0
        s.active_generation = 0
    }
}

// Permission grants are explicit host policy.  Unknown bits are rejected and
// permissions cannot be changed after a session has begun serving requests.
pub fn set_permissions(s $&Session, permissions int) bool {
    if s.state != STATE_NEW {
        << false
    }
    if permissions < 0 || (permissions & PERM_ALL) != permissions {
        << false
    }
    s.permissions = permissions
    << true
}

// Development hosts may opt into the complete permission set explicitly.
// This is policy only; schema, byte, window, and lifecycle checks still apply.
pub fn development_permissions() int {
    << PERM_ALL
}

pub fn enable_development(s $&Session) bool {
    << set_permissions(&*s, PERM_ALL)
}

fn fail(code string, msg string) Outcome {
    << Outcome{ok: false, request_id: 0, err_code: code, err_msg: redact_paths(&msg)}
}

fn pass(id int) Outcome {
    << Outcome{ok: true, request_id: id, err_code: "", err_msg: ""}
}

fn valid_limits(l &Limits) bool {
    if l.max_frame_bytes <= 0 || l.max_frame_bytes > MAX_FRAME_BYTES { << false }
    if l.max_string_bytes <= 0 || l.max_string_bytes > MAX_STRING_BYTES { << false }
    if l.max_fields <= 0 || l.max_fields > MAX_FIELDS { << false }
    if l.max_table_rows <= 0 || l.max_table_rows > MAX_TABLE_ROWS { << false }
    if l.max_node_id <= 0 || l.max_node_id > MAX_NODE_ID { << false }
    if l.request_timeout_ms <= 0 || l.request_timeout_ms > MAX_REQUEST_TIMEOUT_MS { << false }
    if l.write_timeout_ms <= 0 || l.write_timeout_ms > MAX_WRITE_TIMEOUT_MS { << false }
    if l.hello_timeout_ms <= 0 || l.hello_timeout_ms > MAX_HELLO_TIMEOUT_MS { << false }
    if l.idle_timeout_ms != 0 && (l.idle_timeout_ms < MIN_IDLE_TIMEOUT_MS || l.idle_timeout_ms > MAX_IDLE_TIMEOUT_MS) { << false }
    << true
}

fn has_prefix(s &string, prefix string) bool {
    if prefix.len > s.len { << false }
    for i in 0:prefix.len {
        if s[i] != prefix[i] { << false }
    }
    << true
}

fn has_suffix(s &string, suffix string) bool {
    if suffix.len > s.len { << false }
    start := s.len - suffix.len
    for i in 0:suffix.len {
        if s[start + i] != suffix[i] { << false }
    }
    << true
}

fn trim_frame_body(src &string) string {
    $start := 0
    $end := src.len
    while start < end && ((src[start] & 255) == 10 || (src[start] & 255) == 13) {
        start += 1
    }
    while end > start && ((src[end - 1] & 255) == 10 || (src[end - 1] & 255) == 13) {
        end -= 1
    }
    << src[start:end]
}

// parse_frame parses one XACP/1 frame body: the transport has already
// stripped the "XACP/1\n<N>\n" length prefix and read exactly N bytes.
// The body is plain XUN with no envelope.
pub fn parse_frame(src string) xun.Doc {
    if src.len == 0 { >> errors.new("xacp: empty frame body") }
    if src.len > MAX_FRAME_BYTES { >> errors.new("xacp: frame exceeds memory limit") }
    d := xun.parse(&src)
    if !d.ok() {
        >> errors.new("xacp: XUN parse error at line " + str(d.error_line()) + ": " + d.error())
    }
    << d
}

fn require_scalar(d &xun.Doc, node int, name string) string {
    if node < 0 || d.kind(node) != xun.KIND_SCALAR {
        >> errors.new("xacp: " + name + " must be a scalar")
    }
    text := d.text(node)
    if text.len > MAX_STRING_BYTES {
        >> errors.new("xacp: " + name + " exceeds memory limit")
    }
    << text
}

fn require_string(d &xun.Doc, node int, name string) string {
    label := name + ""
    text := require_scalar(d, node, label + "")
    tag := d.tag(node)
    if tag != "" && tag != "s" {
        >> errors.new("xacp: " + label + " has the wrong type tag")
    }
    if text.len == 0 {
        >> errors.new("xacp: " + label + " must not be empty")
    }
    << text
}

fn require_int(d &xun.Doc, node int, name string) int {
    label := name + ""
    text := require_scalar(d, node, label + "")
    if d.tag(node) != "i" {
        >> errors.new("xacp: " + label + " requires !i")
    }
    value := strconv.parse(&text, 10) or (err) {
        >> errors.new("xacp: " + label + " is not a valid integer")
    }
    << value
}

fn require_bool(d &xun.Doc, node int, name string) bool {
    label := name + ""
    text := require_scalar(d, node, label + "")
    if d.tag(node) != "b" || (text != "true" && text != "false") {
        >> errors.new("xacp: " + label + " requires !b true/false")
    }
    << text == "true"
}

fn require_float(d &xun.Doc, node int, name string) f64 {
    label := name + ""
    text := require_scalar(d, node, label + "")
    if d.tag(node) != "f" {
        >> errors.new("xacp: " + label + " requires !f")
    }
    value := strconv.parse_float(&text) or (err) {
        >> errors.new("xacp: " + label + " is not a valid float")
    }
    << value
}

fn require_version(d &xun.Doc, node int) int {
    text := require_scalar(d, node, "ver")
    if d.tag(node) != "ver" || text != "1.0.0" {
        >> errors.new("xacp: ver must be !ver 1.0.0")
    }
    << 0
}

fn key_allowed(op string, key string) bool {
    if op == "xacp.hello" {
        << key == "ver" || key == "nonce" || key == "token" || key == "permissions"
    }
    if op == "proc.status" { << false }
    if op == "proc.output" { << key == "stream" || key == "since" || key == "max_bytes" }
    if op == "ui.tree" { << key == "raw" || key == "win" || key == "include_hidden" || key == "start" || key == "max_table_rows" }
    if op == "ui.screenshot" { << key == "raw" || key == "win" || key == "node" || key == "scale" || key == "mode" }
    if op == "ui.input" { << key == "win" || key == "steps" }
    if op == "ui.act" { << key == "win" || key == "node" || key == "act" || key == "text" || key == "checked" }
    if op == "ui.record" { << key == "win" || key == "mode" || key == "max_bytes" || key == "max_records" || key == "duration_ms" }
    << false
}

fn has_field(d &xun.Doc, args int, key string) bool {
    << d.get(args, key) >= 0
}

fn validate_steps(d &xun.Doc, node int, l &Limits) int {
    if node < 0 || d.kind(node) != xun.KIND_LIST {
        >> errors.new("xacp: steps must be a list")
    }
    count := d.count(node)
    if count > l.max_fields { >> errors.new("xacp: steps exceeds field limit") }
    for i in 0:count {
        step := d.at(node, i)
        if d.kind(step) != xun.KIND_DICT || d.count(step) > l.max_fields {
            >> errors.new("xacp: each input step must be a bounded dictionary")
        }
        ev := d.get(step, "ev")
        if ev < 0 { >> errors.new("xacp: input step requires ev") }
        event_name := require_string(d, ev, "steps.ev")
        if event_name != "pointer_down" && event_name != "pointer_up" && event_name != "pointer_move" &&
           event_name != "pointer_enter" && event_name != "pointer_leave" && event_name != "pointer_cancel" &&
           event_name != "key_down" && event_name != "key_up" && event_name != "pointer_scroll" && event_name != "scroll" {
            >> errors.new("xacp: unknown input event")
        }
        for j in 0:d.count(step) {
            child := d.at(step,j)
            key := d.key(child)
            if key != "ev" && key != "x" && key != "y" && key != "dx" && key != "dy" && key != "button" &&
               key != "buttons" && key != "modifiers" && key != "key" && key != "scan" && key != "repeat" &&
               key != "click_count" && key != "time_ns" {
                >> errors.new("xacp: unknown input step field '" + key + "'")
            }
            if key == "x" || key == "y" || key == "dx" || key == "dy" {
                _ := require_float(d,child,"steps." + key)
            } else if key != "ev" {
                _ := require_int(d,child,"steps." + key)
            }
        }
    }
    << 0
}

fn validate_action(d &xun.Doc, args int) int {
    act_node := d.get(args, "act")
    act := require_string(d, act_node, "act")
    allowed := act == "focus" || act == "click" || act == "set_text" || act == "set_checked"
    if !allowed { >> errors.new("xacp: ui.act action is not enabled") }
    if act == "set_text" {
        text := d.get(args, "text")
        if text < 0 { >> errors.new("xacp: set_text requires text") }
        _ := require_string(d, text, "text")
    }
    if act == "set_checked" {
        checked := d.get(args, "checked")
        if checked < 0 { >> errors.new("xacp: set_checked requires checked") }
        _ := require_bool(d, checked, "checked")
    }
    if act != "set_text" && has_field(d,args,"text") { >> errors.new("xacp: text is only valid for set_text") }
    if act != "set_checked" && has_field(d,args,"checked") { >> errors.new("xacp: checked is only valid for set_checked") }
    << 0
}

fn validate_args(d &xun.Doc, args int, op string, l &Limits) int {
    if args < 0 || d.kind(args) != xun.KIND_DICT {
        >> errors.new("xacp: args must be a dictionary")
    }
    count := d.count(args)
    if count > l.max_fields {
        >> errors.new("xacp: args exceeds field limit")
    }
    for i in 0:count {
        child := d.at(args, i)
        key := d.key(child)
        key_copy := key + ""
        if !key_allowed(op + "", key_copy + "") {
            >> errors.new("xacp: unknown or disabled field '" + key_copy + "'")
        }
        if key_copy == "raw" {
            _ := require_bool(d, child, "raw")
        } else if key_copy == "ver" {
            _ := require_version(d, child)
        } else if key_copy == "nonce" {
            nonce := require_string(d, child, "nonce")
            if nonce.len > l.max_string_bytes { >> errors.new("xacp: nonce exceeds memory limit") }
        } else if key_copy == "token" {
            // An empty token is still a string; configured hosts reject it as auth_failed.
            _ := require_scalar(d, child, "token")
            if d.tag(child) != "" && d.tag(child) != "s" { >> errors.new("xacp: token must be a string") }
        } else if key_copy == "permissions" {
            permissions := require_int(d, child, "permissions")
            if permissions < 0 || (permissions & PERM_ALL) != permissions {
                >> errors.new("xacp: unknown permission bits")
            }
        }
    }
    if op == "xacp.hello" {
        ver := d.get(args, "ver")
        if ver < 0 { >> errors.new("xacp: missing args.ver") }
        if d.get(args, "nonce") < 0 { >> errors.new("xacp: missing args.nonce") }
    } else if op == "proc.status" {
        if count != 0 { >> errors.new("xacp: proc.status args must be empty") }
    } else if op == "proc.output" {
        stream := d.get(args, "stream")
        if stream < 0 { >> errors.new("xacp: proc.output requires stream") }
        stream_name := require_string(d, stream, "stream")
        if stream_name != "stdout" && stream_name != "stderr" { >> errors.new("xacp: invalid output stream") }
        if has_field(d, args, "since") {
            since := require_int(d, d.get(args, "since"), "since")
            if since < 0 { >> errors.new("xacp: since must be non-negative") }
        }
        if has_field(d, args, "max_bytes") {
            max_bytes := require_int(d, d.get(args, "max_bytes"), "max_bytes")
            if max_bytes <= 0 || max_bytes > l.max_frame_bytes { >> errors.new("xacp: max_bytes exceeds limit") }
        }
    } else if op == "ui.tree" {
        if has_field(d, args, "win") {
            win := require_int(d, d.get(args, "win"), "win")
            if win < 0 { >> errors.new("xacp: win must be non-negative") }
        }
        if has_field(d, args, "include_hidden") { _ := require_bool(d, d.get(args, "include_hidden"), "include_hidden") }
        if has_field(d, args, "start") {
            start := require_int(d, d.get(args, "start"), "start")
            if start < 0 { >> errors.new("xacp: start must be non-negative") }
        }
        if has_field(d, args, "max_table_rows") {
            rows := require_int(d, d.get(args, "max_table_rows"), "max_table_rows")
            if rows <= 0 || rows > l.max_table_rows { >> errors.new("xacp: max_table_rows exceeds limit") }
        }
    } else if op == "ui.screenshot" {
        win := require_int(d, d.get(args, "win"), "win")
        if win <= 0 { >> errors.new("xacp: screenshot win must be positive") }
        if has_field(d, args, "node") { if !check_node(require_int(d, d.get(args, "node"), "node"), l) { >> errors.new("xacp: node exceeds limit") } }
        if has_field(d, args, "scale") {
            scale := require_float(d, d.get(args, "scale"), "scale")
            if scale < 0.1 || scale > 4.0 { >> errors.new("xacp: screenshot scale out of range") }
        }
        if has_field(d, args, "mode") {
            mode := require_string(d, d.get(args, "mode"), "mode")
            if mode != "file" && mode != "inline_b64" { >> errors.new("xacp: invalid screenshot mode") }
        }
    } else if op == "ui.input" {
        win := require_int(d, d.get(args, "win"), "win")
        if win <= 0 { >> errors.new("xacp: input win must be positive") }
        _ := validate_steps(d, d.get(args, "steps"), l)
    } else if op == "ui.act" {
        win := require_int(d, d.get(args, "win"), "win")
        node := require_int(d, d.get(args, "node"), "node")
        if win <= 0 || !check_node(node, l) { >> errors.new("xacp: ui.act target exceeds limit") }
        _ := validate_action(d, args)
    } else if op == "ui.record" {
        win := require_int(d, d.get(args, "win"), "win")
        if win <= 0 { >> errors.new("xacp: record win must be positive") }
        mode := require_string(d, d.get(args, "mode"), "mode")
        if mode != "events" && mode != "frames" { >> errors.new("xacp: invalid record mode") }
        if has_field(d, args, "max_bytes") {
            max_bytes := require_int(d, d.get(args, "max_bytes"), "max_bytes")
            if max_bytes <= 0 || max_bytes > l.max_frame_bytes { >> errors.new("xacp: record max_bytes exceeds limit") }
        }
        if has_field(d, args, "max_records") {
            max_records := require_int(d, d.get(args, "max_records"), "max_records")
            if max_records < 1 { >> errors.new("xacp: max_records must be positive") }
        }
        if has_field(d, args, "duration_ms") {
            duration_ms := require_int(d, d.get(args, "duration_ms"), "duration_ms")
            if duration_ms < 0 || duration_ms >= l.request_timeout_ms { >> errors.new("xacp: duration_ms exceeds request timeout margin") }
        }
    }
    << 0
}

// request_id_hint returns a top-level `id: !i N` if one parses,
// otherwise 0, so schema errors can still echo the caller's id.
pub fn request_id_hint(d &xun.Doc) int {
    root := d.root()
    if root < 0 || d.kind(root) != xun.KIND_DICT { << 0 }
    node := d.get(root, "id")
    if node < 0 || d.kind(node) != xun.KIND_SCALAR || d.tag(node) != "i" { << 0 }
    text := d.text(node)
    value := strconv.parse(&text, 10) or (err) { << 0 }
    << value
}

// validate_request enforces the fixed top-level schema and rejects every
// operation that has not been explicitly added to this package's schema.
pub fn validate_request(d &xun.Doc, l &Limits) Request {
    request := validate_request_envelope(d,l) or >>
    _ := validate_args(d,request.args,request.op + "",l) or >>
    << request
}

// A valid envelope identifies recoverable proc.output argument failures.
fn validate_request_envelope(d &xun.Doc, l &Limits) Request {
    if !valid_limits(l) {
        >> errors.new("xacp: invalid safety limits")
    }
    root := d.root()
    if root < 0 || d.kind(root) != xun.KIND_DICT {
        >> errors.new("xacp: request root must be a dictionary")
    }
    if d.count(root) != 3 {
        >> errors.new("xacp: request top level must contain exactly id, op, args")
    }
    id_node := d.get(root, "id")
    op_node := d.get(root, "op")
    args_node := d.get(root, "args")
    if id_node < 0 || op_node < 0 || args_node < 0 {
        >> errors.new("xacp: request requires id, op, and args")
    }
    // Value/sequence checks belong to begin_request so invalid ids stay recoverable.
    id := require_int(d, id_node, "id")
    op := require_string(d, op_node, "op")
    known := op == "xacp.hello" || op == "proc.status" || op == "proc.output" || op == "ui.tree" || op == "ui.screenshot" || op == "ui.input" || op == "ui.act" || op == "ui.record"
    if !known { >> errors.new("xacp: unknown operation") }
    << Request{id: id, op: op + "", args: args_node}
}

fn operation_permission(op string) int {
    if op == "xacp.hello" { << PERM_NONE }
    if op == "proc.status" { << PERM_INFO }
    if op == "ui.tree" || op == "ui.screenshot" || op == "ui.record" { << PERM_UI_READ }
    if op == "proc.output" { << PERM_PROCESS }
    << PERM_UI_MUTATE
}

pub fn authorized(s $&Session, r &Request) bool {
    if s.state == STATE_CLOSED { << false }
    if r.op == "xacp.hello" { << s.state == STATE_NEW }
    if s.state != STATE_OPEN { << false }
    required := operation_permission(r.op)
    if required == PERM_NONE { << false }
    << (s.permissions & required) == required
}

pub fn begin_request(s $&Session, r &Request) Outcome {
    if s.state == STATE_CLOSED { << fail("session_closed", "session is closed") }
    if s.state == STATE_NEW && r.op != "xacp.hello" {
        close_session(&*s)
        << fail("hello_required", "first request must be xacp.hello")
    }
    if s.active_id != 0 { << fail("request_in_flight", "one request is already active") }
    if r.id <= 0 || r.id != s.next_id { << fail("invalid_request_id", "request id is not monotonic") }
    if !authorized(s, r) { << fail("permission_denied", "operation is not authorized") }
    s.active_id = r.id
    s.active_generation = s.generation
    s.next_id = s.next_id + 1
    << pass(r.id)
}

pub fn finish_request(s $&Session, id int) Outcome {
    if s.state == STATE_CLOSED { << fail("session_closed", "session is closed") }
    if s.active_id != id || s.active_generation != s.generation {
        << fail("stale_request", "request does not belong to the active session")
    }
    s.active_id = 0
    s.active_generation = 0
    if s.state == STATE_NEW {
        // Only a successfully negotiated hello may open the session.
        if s.nonce.len == 0 {
            close_session(&*s)
            << fail("hello_required", "hello was not negotiated")
        }
        s.state = STATE_OPEN
    }
    << pass(id)
}

pub fn consume_input(s $&Session, n int, l &Limits) bool {
    if n < 0 || n > l.max_frame_bytes { << false }
    if s.bytes_in > l.max_frame_bytes - n { << false }
    s.bytes_in = s.bytes_in + n
    << true
}

pub fn consume_output(s $&Session, n int, l &Limits) bool {
    if n < 0 || n > l.max_frame_bytes { << false }
    if s.bytes_out > l.max_frame_bytes - n { << false }
    s.bytes_out = s.bytes_out + n
    << true
}

pub fn check_window(start int, count int, total int, l &Limits) bool {
    if start < 0 || count < 0 || total < 0 { << false }
    if count > l.max_table_rows { << false }
    if start > total || count > total - start { << false }
    << true
}

pub fn check_node(node int, l &Limits) bool {
    << node >= 0 && node <= l.max_node_id
}

// negotiate_hello consumes a schema-validated, reserved hello. The host supplies
// its expected token and shared registry; RAW additionally requires host opt-in.
// A client token alone never grants more than INFO when the host has no token.
pub fn negotiate_hello(s $&Session, d &xun.Doc, r &Request, expected_token string, nonces $&NonceRegistry) Outcome {
    if s.state != STATE_NEW || r.op != "xacp.hello" || s.active_id != r.id {
        << fail("stale_request", "hello is not active")
    }
    $allowed := PERM_INFO
    if expected_token.len > 0 {
        token_node := d.get(r.args, "token")
        token := d.text(token_node)
        if token_node < 0 || subtle.constant_time_compare(&token, &expected_token) != 1 {
            close_session(&*s)
            << fail("auth_failed", "hello authentication failed")
        }
        allowed = PERM_ALL ^ PERM_UI_RAW
        if os.getenv("XU_XACP_ALLOW_RAW") == "1" { allowed = PERM_ALL }
    }
    $requested := allowed
    permissions_node := d.get(r.args, "permissions")
    if permissions_node >= 0 { requested = d.as_int(permissions_node) }
    if !set_permissions(&*s, requested & allowed) {
        close_session(&*s)
        << fail("schema_error", "invalid hello permissions")
    }
    nonce := d.text(d.get(r.args, "nonce"))
    if !register_nonce(&*nonces, &nonce) {
        close_session(&*s)
        << Outcome{ok: false, request_id: r.id, err_code: "nonce_replay", err_msg: "hello nonce already used"}
    }
    s.nonce = nonce
    << pass(r.id)
}

// dispatch performs only the safe core lifecycle with the default INFO policy.
// Data-bearing adapters implement operations after the same checks.
pub fn dispatch(s $&Session, d &xun.Doc, l &Limits, nonces $&NonceRegistry) Outcome {
    << dispatch_with_token(&*s, d, l, "", &*nonces)
}

// Hosts with an explicit authentication policy pass the expected token here.
pub fn dispatch_with_token(s $&Session, d &xun.Doc, l &Limits, expected_token string, nonces $&NonceRegistry) Outcome {
    req := validate_request(d, l) or (err) {
        close_session(&*s)
        << fail("schema_error", err.msg())
    }
    started := begin_request(&*s, &req)
    if !started.ok { << started }
    if req.op != "xacp.hello" {
        cancel_request(&*s)
        << fail("not_implemented", "operation has no registered adapter")
    }
    negotiated := negotiate_hello(&*s, d, &req, expected_token, &*nonces)
    if !negotiated.ok { << negotiated }
    << finish_request(&*s, req.id)
}
