@flag

#errors
#strconv
#time

// flag — command-line flag parsing, same slot as Go `flag` (FlagSet
// shape). No package-level globals (Xu forbids mutable globals): every
// flag lives in an explicit Set, mirroring Go's flag.FlagSet.
// Supported forms: -name value, --name value, -name=value, --name=value;
// boolean flags may stand alone (-v sets true). '--' ends flag parsing
// and the remainder becomes positional args. '-h'/'--help'/'-help'
// >> errors.Error('flag: help requested'). Unknown flags and missing values
// >> — never a partial parse.

const T_BOOL = 0
const T_STR = 1
const T_INT = 2
const T_F64 = 3
const T_DUR = 4

pub struct Set {
    pub name string
    pub names []string
    pub kinds []int
    pub bs []bool
    pub ss []string
    pub ins []int
    pub fs []f64
    pub durs []int
    pub usages []string
    pub set_flags []bool
    pub rest []string
    pub parsed bool
    pub alias_keys []string
    pub alias_targets []string
    pub allow_slash_mode bool
}

pub fn new_set(name string) Set {
    << Set{
        name: name,
        names: []string{},
        kinds: []int{},
        bs: []bool{},
        ss: []string{},
        ins: []int{},
        fs: []f64{},
        durs: []int{},
        usages: []string{},
        set_flags: []bool{},
        rest: []string{},
        parsed: false,
        alias_keys: []string{},
        alias_targets: []string{},
        allow_slash_mode: false
    }
}

// allow_slash enables Windows-style '/' option prefix parsing (e.g. /?, /S).
pub fn (s &mut Set) allow_slash(enable bool) {
    s.allow_slash_mode = enable
}

fn (s &Set) find(name string) int {
    for i in 0:s.names.len {
        if s.names[i] == name {
            << i
        }
    }
    for i in 0:s.alias_keys.len {
        if s.alias_keys[i] == name {
            target := s.alias_targets[i]
            for j in 0:s.names.len {
                if s.names[j] == target {
                    << j
                }
            }
        }
    }
    << -1
}

// alias registers an alternative option name pointing to an existing canonical flag.
pub fn (s &mut Set) alias(short_name string, canonical_name string) {
    for i in 0:s.names.len {
        if s.names[i] == short_name {
            eprintln("flag: alias already defined as flag: " + short_name)
            <<< 2
        }
    }
    for i in 0:s.alias_keys.len {
        if s.alias_keys[i] == short_name {
            eprintln("flag: alias redefined: " + short_name)
            <<< 2
        }
    }
    mut target_found := false
    for i in 0:s.names.len {
        if s.names[i] == canonical_name {
            target_found = true
        }
    }
    if !target_found {
        eprintln("flag: alias target not found: " + canonical_name)
        <<< 2
    }
    s.alias_keys.push(short_name)
    s.alias_targets.push(canonical_name)
}

fn (s &mut Set) define(name string, kind int) {
    for i in 0:s.names.len {
        if s.names[i] == name {
            eprintln("flag: flag redefined: " + name)
            <<< 2
        }
    }
    for i in 0:s.alias_keys.len {
        if s.alias_keys[i] == name {
            eprintln("flag: flag redefined: " + name)
            <<< 2
        }
    }
    s.names.push(name)
    s.kinds.push(kind)
    s.bs.push(false)
    s.ss.push("")
    s.ins.push(0)
    s.fs.push(0.0)
    s.durs.push(0)
    s.usages.push("")
    s.set_flags.push(false)
}

pub fn (s &mut Set) define_bool(name string, def bool, usage string) {
    s.define(name, T_BOOL)
    s.bs[s.names.len - 1] = def
    s.usages[s.names.len - 1] = usage
}

pub fn (s &mut Set) define_string(name string, def string, usage string) {
    s.define(name, T_STR)
    s.ss[s.names.len - 1] = def
    s.usages[s.names.len - 1] = usage
}

pub fn (s &mut Set) define_int(name string, def int, usage string) {
    s.define(name, T_INT)
    s.ins[s.names.len - 1] = def
    s.usages[s.names.len - 1] = usage
}

pub fn (s &mut Set) define_float64(name string, def f64, usage string) {
    s.define(name, T_F64)
    s.fs[s.names.len - 1] = def
    s.usages[s.names.len - 1] = usage
}

pub fn (s &mut Set) define_duration(name string, def int, usage string) {
    s.define(name, T_DUR)
    s.durs[s.names.len - 1] = def
    s.usages[s.names.len - 1] = usage
}

// Convenience definition methods with an alias
pub fn (s &mut Set) define_bool_alias(name string, short_name string, def bool, usage string) {
    s.define_bool(name + "", def, usage)
    s.alias(short_name, name)
}

pub fn (s &mut Set) define_string_alias(name string, short_name string, def string, usage string) {
    s.define_string(name + "", def, usage)
    s.alias(short_name, name)
}

pub fn (s &mut Set) define_int_alias(name string, short_name string, def int, usage string) {
    s.define_int(name + "", def, usage)
    s.alias(short_name, name)
}

pub fn (s &Set) is_set(name string) bool {
    i := s.find(name)
    if i < 0 {
        << false
    }
    << s.set_flags[i]
}

pub fn (s &Set) get_bool(name string) bool {
    i := s.find(name)
    if i < 0 {
        << false
    }
    << s.bs[i]
}

pub fn (s &Set) get_string(name string) string {
    i := s.find(name)
    if i < 0 {
        << ""
    }
    << s.ss[i]
}

pub fn (s &Set) get_int(name string) int {
    i := s.find(name)
    if i < 0 {
        << 0
    }
    << s.ins[i]
}

pub fn (s &Set) get_float64(name string) f64 {
    i := s.find(name)
    if i < 0 {
        << 0.0
    }
    << s.fs[i]
}

pub fn (s &Set) get_duration(name string) int {
    i := s.find(name)
    if i < 0 {
        << 0
    }
    << s.durs[i]
}

// Fallback getters: return specified default value when flag was not explicitly provided on CLI
pub fn (s &Set) get_bool_or(name string, def bool) bool {
    i := s.find(name)
    if i < 0 || !s.set_flags[i] {
        << def
    }
    << s.bs[i]
}

pub fn (s &Set) get_string_or(name string, def string) string {
    i := s.find(name)
    if i < 0 || !s.set_flags[i] {
        << def
    }
    << s.ss[i]
}

pub fn (s &Set) get_int_or(name string, def int) int {
    i := s.find(name)
    if i < 0 || !s.set_flags[i] {
        << def
    }
    << s.ins[i]
}

pub fn (s &Set) get_float64_or(name string, def f64) f64 {
    i := s.find(name)
    if i < 0 || !s.set_flags[i] {
        << def
    }
    << s.fs[i]
}

pub fn (s &Set) get_duration_or(name string, def int) int {
    i := s.find(name)
    if i < 0 || !s.set_flags[i] {
        << def
    }
    << s.durs[i]
}

pub fn (s &Set) print_defaults() {
    mut max_len := 0
    for i in 0:s.names.len {
        mut prefix_len := s.names[i].len + 1
        for a in 0:s.alias_keys.len {
            if s.alias_targets[a] == s.names[i] {
                prefix_len = prefix_len + s.alias_keys[a].len + 4
            }
        }
        if prefix_len > max_len {
            max_len = prefix_len
        }
    }

    for i in 0:s.names.len {
        mut alias_name := ""
        for a in 0:s.alias_keys.len {
            if s.alias_targets[a] == s.names[i] {
                alias_name = s.alias_keys[a]
            }
        }
        mut opt_str := ""
        if alias_name.len > 0 {
            opt_str = "-" + alias_name + ", --" + s.names[i]
        } else {
            opt_str = "-" + s.names[i]
        }

        mut pad := max_len - opt_str.len + 2
        mut line := "  " + opt_str
        while pad > 0 {
            line = line + " "
            pad -= 1
        }
        line = line + s.usages[i]

        if s.kinds[i] == T_INT {
            line = line + " (default: " + str(s.ins[i]) + ")"
        } else if s.kinds[i] == T_STR && s.ss[i].len > 0 {
            line = line + " (default: \"" + s.ss[i] + "\")"
        } else if s.kinds[i] == T_BOOL && s.bs[i] {
            line = line + " (default: true)"
        }
        println(line)
    }
}

pub fn (s &Set) args() []string {
    mut out := []string{}
    for i in 0:s.rest.len {
        out.push(s.rest[i])
    }
    << out
}

// parse consumes args (Go FlagSet.Parse shape); returns 0 on success.
// Positional arguments are kept in the set. May >> errors.Error.
pub fn (s &mut Set) parse(args []string) int {
    s.parsed = true
    s.rest = []string{}
    mut i := 0
    while i < args.len {
        a := args[i]
        if a == "--" {
            for j in i + 1:args.len {
                s.rest.push(args[j])
            }
            i = args.len
            << 0
        }
        if a == "-h" || a == "--help" || a == "-help" || (s.allow_slash_mode && a == "/?") {
            >> errors.new("flag: help requested")
        }
        is_dash := a.len > 1 && a[0] == 45
        is_slash := s.allow_slash_mode && a.len > 1 && a[0] == 47
        if is_dash || is_slash {
            mut body := a[1:a.len]
            if is_dash && body.len > 0 && body[0] == 45 {
                body = body[1:body.len]
            }
            if body.len == 0 {
                >> errors.new("flag: bad flag syntax: " + a)
            }
            mut name := ""
            mut val := ""
            mut has_val := false
            for j in 0:body.len {
                if body[j] == 61 {
                    name = body[0:j]
                    val = body[j + 1:body.len]
                    has_val = true
                    <-
                }
            }
            if !has_val {
                name = body
            }
            if name.len == 0 {
                >> errors.new("flag: bad flag syntax: " + a)
            }
            idx := s.find(name + "")
            if idx < 0 {
                >> errors.new("flag: flag provided but not defined: -" + name)
            }
            if s.kinds[idx] == T_BOOL {
                if has_val {
                    b := strconv.parse_bool(&val) or (err) {
                        >> errors.new("flag: invalid boolean value for -" + name)
                    }
                    s.bs[idx] = b
                } else {
                    s.bs[idx] = true
                }
                s.set_flags[idx] = true
                i += 1
            } else if has_val {
                if s.kinds[idx] == T_INT {
                    n := strconv.parse(&val, 10) or (err) {
                        >> errors.new("flag: invalid integer value for -" + name)
                    }
                    s.ins[idx] = n
                } else if s.kinds[idx] == T_F64 {
                    f := strconv.parse_float(&val) or (err) {
                        >> errors.new("flag: invalid float value for -" + name)
                    }
                    s.fs[idx] = f
                } else if s.kinds[idx] == T_DUR {
                    d := time.parse_duration(&val) or (err) {
                        >> errors.new("flag: invalid duration value for -" + name)
                    }
                    s.durs[idx] = d
                } else {
                    s.ss[idx] = val
                }
                s.set_flags[idx] = true
                i += 1
            } else {
                if i + 1 >= args.len {
                    >> errors.new("flag: flag needs an argument: -" + name)
                }
                next := args[i + 1]
                if s.kinds[idx] == T_INT {
                    n := strconv.parse(&next, 10) or (err) {
                        >> errors.new("flag: invalid integer value for -" + name)
                    }
                    s.ins[idx] = n
                } else if s.kinds[idx] == T_F64 {
                    f := strconv.parse_float(&next) or (err) {
                        >> errors.new("flag: invalid float value for -" + name)
                    }
                    s.fs[idx] = f
                } else if s.kinds[idx] == T_DUR {
                    d := time.parse_duration(&next) or (err) {
                        >> errors.new("flag: invalid duration value for -" + name)
                    }
                    s.durs[idx] = d
                } else {
                    s.ss[idx] = next
                }
                s.set_flags[idx] = true
                i += 2
            }
        } else {
            s.rest.push(a)
            i += 1
        }
    }
    << 0
}

pub fn (s &Set) nflag() int {
    mut n := 0
    mut i := 0
    while i < s.set_flags.len {
        if s.set_flags[i] {
            n = n + 1
        }
        i = i + 1
    }
    << n
}

pub fn (s &mut Set) set(name string, value string) int {
    idx := s.find(name + "")
    if idx < 0 {
        >> errors.new("flag: no such flag -" + name)
    }
    val := value
    if s.kinds[idx] == T_BOOL {
        b := strconv.parse_bool(&val) or (err) {
            >> errors.new("flag: invalid boolean value for -" + name)
        }
        s.bs[idx] = b
    } else if s.kinds[idx] == T_INT {
        n := strconv.parse(&val, 10) or (err) {
            >> errors.new("flag: invalid integer value for -" + name)
        }
        s.ins[idx] = n
    } else if s.kinds[idx] == T_F64 {
        f := strconv.parse_float(&val) or (err) {
            >> errors.new("flag: invalid float value for -" + name)
        }
        s.fs[idx] = f
    } else if s.kinds[idx] == T_DUR {
        d := time.parse_duration(&val) or (err) {
            >> errors.new("flag: invalid duration value for -" + name)
        }
        s.durs[idx] = d
    } else {
        s.ss[idx] = val
    }
    s.set_flags[idx] = true
    << 0
}

pub fn (s &Set) visit() []string {
    mut out := []string{}
    mut i := 0
    while i < s.names.len {
        if s.set_flags[i] {
            out.push(s.names[i])
        }
        i = i + 1
    }
    << out
}

pub struct Flag {
    pub name string
    pub usage string
    pub is_set bool
    pub found bool
}

pub fn (s &Set) lookup(name string) Flag {
    i := s.find(name)
    if i < 0 {
        << Flag{name: "", usage: "", is_set: false, found: false}
    }
    << Flag{name: s.names[i], usage: s.usages[i], is_set: s.set_flags[i], found: true}
}

pub fn (s &Set) narg() int {
    << s.rest.len
}

pub fn (s &Set) parsed() bool {
    << s.parsed
}

pub fn (s &Set) arg(i int) string {
    if i < 0 || i >= s.rest.len {
        << ""
    }
    << s.rest[i]
}

pub fn (s &Set) visit_all() []string {
    mut out := []string{}
    mut i := 0
    while i < s.names.len {
        out.push(s.names[i])
        i = i + 1
    }
    << out
}
