@context

#errors

// Go `context` 最小面：Background / WithCancel / WithTimeout。
// Done 是 chan；cancel 即 close。副本共享同一条 chan（与 sync.Mutex 相同）。
// `with_cancel_parent` adds cancellation propagation without requiring a
// runtime interface value: a small watcher goroutine waits on the parent's
// done channel and closes the child exactly once.

pub struct Context {
    pub done chan int
    pub deadline_ns int
    pub keys []string
    pub vals []string
}

pub struct Cancel {
    pub ctx Context
    // A one-token guard serializes explicit cancel, parent propagation and
    // timeout expiry.  The token changes from 1 (open) to 0 (closed), so
    // repeated cancellation is idempotent instead of double-closing a chan.
    guard chan int
}

pub fn background() Context {
    ch := chan int{cap: 1}
    << Context{done: ch, deadline_ns: 0, keys: []string{}, vals: []string{}}
}

pub fn with_cancel() Cancel {
    ch := chan int{cap: 1}
    guard := chan int{cap: 1}
    guard <- 1
    << Cancel{ctx: Context{done: ch, deadline_ns: 0, keys: []string{}, vals: []string{}}, guard: guard}
}

pub fn (c &mut Cancel) cancel() {
    close_once(c.ctx.done, c.guard)
}

// close_once is shared by explicit cancellation, timeout expiry and parent
// propagation.  Guard values are intentionally channel-owned so they remain
// copyable under Xu's value/borrow model.
fn close_once(done chan int, guard chan int) {
    token := <-guard
    if token == 1 {
        close(done)
        guard <- 0
    } else {
        guard <- 0
    }
}

fn timeout_fire(ns int, done chan int, guard chan int) {
    if sys_wait_cancel(done, ns) { << }
    close_once(done, guard)
}

fn parent_watch(parent_done chan int, child_done chan int, child_guard chan int) {
    select {
        p := <-parent_done {
            _ := p
            close_once(child_done, child_guard)
        }
        c := <-child_done {
            _ := c
        }
    }
}

// with_cancel_parent is the parent-aware form of with_cancel.  The returned
// context shares the parent's deadline and is canceled when the parent's Done
// channel closes.  Parent and child Cancel values can still be canceled
// explicitly; close_once makes all three paths idempotent.
pub fn with_cancel_parent(parent &Context) Cancel {
    ch := chan int{cap: 1}
    guard := chan int{cap: 1}
    guard <- 1
    deadline := parent.deadline_ns
    mut keys := copy_kv(&parent.keys)
    mut vals := copy_kv(&parent.vals)
    mut c := Cancel{ctx: Context{done: ch, deadline_ns: deadline, keys: keys, vals: vals}, guard: guard}
    parent_done := parent.done
    xu parent_watch(parent_done, ch, guard)
    << c
}

pub fn with_timeout(timeout_ns int) Cancel {
    mut ns := timeout_ns
    if ns < 0 {
        ns = 0
    }
    mut c := with_cancel()
    now := now_ns()
    mut deadline := 9223372036854775807
    if ns <= deadline - now { deadline = now + ns }
    c.ctx.deadline_ns = deadline
    xu timeout_fire(ns, c.ctx.done, c.guard)
    << c
}

pub fn with_deadline(deadline_ns int) Cancel {
    mut c := with_cancel()
    c.ctx.deadline_ns = deadline_ns
    now := now_ns()
    mut ns := 0
    if deadline_ns > now { ns = deadline_ns - now }
    xu timeout_fire(ns, c.ctx.done, c.guard)
    << c
}

fn probe(c &Context) string {
    if c.deadline_ns > 0 {
        if now_ns() >= c.deadline_ns {
            << "context deadline exceeded"
        }
    }
    select {
        x := <-c.done {
            _ := x
            << "context canceled"
        }
        else {
            << ""
        }
    }
    << ""
}

pub fn (c Context) deadline() int {
    << c.deadline_ns
}

pub fn err(c &Context) int {
    msg := probe(c)
    if msg.len > 0 {
        >> errors.new(msg)
    }
    << 0
}

fn copy_kv(src &[]string) []string {
    mut out := []string{}
    mut i := 0
    while i < src.len {
        out.push(src[i] + "")
        i = i + 1
    }
    << out
}

// with_value attaches a string key/value (Go WithValue; v1 keys and values
// are strings, not any). Later with_value of the same key shadows earlier ones.
pub fn with_value(parent &Context, key string, val string) Context {
    mut keys := copy_kv(&parent.keys)
    mut vals := copy_kv(&parent.vals)
    keys.push(key + "")
    vals.push(val + "")
    << Context{done: parent.done, deadline_ns: parent.deadline_ns, keys: keys, vals: vals}
}

pub fn value(c &Context, key string) string {
    mut i := c.keys.len - 1
    while i >= 0 {
        if c.keys[i] == key {
            << c.vals[i] + ""
        }
        i = i - 1
    }
    >> errors.new("context: no value")
    << ""
}

// without_cancel is Go WithoutCancel: values are copied, deadline and
// cancellation are not. The new Done channel never closes.
pub fn without_cancel(parent &Context) Context {
    ch := chan int{cap: 1}
    mut keys := copy_kv(&parent.keys)
    mut vals := copy_kv(&parent.vals)
    << Context{done: ch, deadline_ns: 0, keys: keys, vals: vals}
}
