    tok_model string
    arch string
    chat_template string
}

struct LoraPair {
    rank int
    scale f32
    a []f32
    b []f32
}

struct LoraState {
    active bool
    q []LoraPair
    k []LoraPair
    v []LoraPair
    o []LoraPair
    w1 []LoraPair
    w2 []LoraPair
    w3 []LoraPair
    lm_head LoraPair
}

fn empty_lora_pair() LoraPair {
    << LoraPair{rank: 0, scale: f32(0), a: []f32{}, b: []f32{}}
}

fn empty_lora_state(n_layers int) LoraState {
    $q := []LoraPair{}
    $k := []LoraPair{}
    $v := []LoraPair{}
    $o := []LoraPair{}
    $w1 := []LoraPair{}
    $w2 := []LoraPair{}
    $w3 := []LoraPair{}
    for _ in 0:n_layers {
        q.push(empty_lora_pair())
        k.push(empty_lora_pair())
        v.push(empty_lora_pair())
        o.push(empty_lora_pair())
        w1.push(empty_lora_pair())
        w2.push(empty_lora_pair())
        w3.push(empty_lora_pair())
    }
    << LoraState{
        active: false, q: ~q, k: ~k, v: ~v, o: ~o, w1: ~w1, w2: ~w2, w3: ~w3,
        lm_head: empty_lora_pair()
    }
}

