@main

#os
#math
#time
#strconv
#errors
#encoding/json

const RMS_CAP = 2048
const KV_BLOCK_SIZE = 16
const MAX_BATCH_SLOTS = 4
const PREFILL_CHUNK = 32
const DEFAULT_CTX_LIMIT = 512
const ARCH_ARM64 = 0

const GGML_TYPE_F32 = 0
const GGML_TYPE_F16 = 1
const GGML_TYPE_Q4_0 = 2
const GGML_TYPE_Q8_0 = 8

struct ModelConfig {
    dim int
    hidden_dim int
    n_layers int
    n_heads int
    n_kv_heads int
    head_dim int
    kv_dim int
    vocab_size int
    max_seq_len int
    rope_theta f64
    rms_eps f64
    bos_token_id int
    eos_token_id int
    is_gpt2_tok bool
}

struct Model {
    cfg ModelConfig
    is_q4 bool
    embed_q4 bool
    lm_head_q4 bool
    lm_head_q8 bool
    layers_p4 bool
    embed_p4 bool
    lm_head_p4 bool
    has_qkv_bias bool
    weights []f32
    q4_qs []u8
    q4_scales []f32
    q8_qs []i8
    q8_scales []f32
    q4_p4k4_qs []u8
    q4_p4k4_scales []u16
    q8_p4k4_qs []i8
    q8_p4k4_scales []u16
    embed_off int
    lm_head_off int
    wq_off []int
    wk_off []int
    wv_off []int
    wo_off []int
    w1_off []int
    w2_off []int
    w3_off []int
    bq [][]f32
    bk [][]f32
    bv [][]f32
    attn_norms [][]f32
    ffn_norms [][]f32
    final_norm []f32
    zeros []f32
    rope_cos []f32
    rope_sin []f32
    vocab []string
}

struct PagedKvCache {
    max_slots int
    num_blocks int
    blocks_per_seq int
    block_size int
    n_layers int
    layer_stride int
    block_stride int
    kv_dim int
    k_blocks []f32
    v_blocks []f32
    free_stack []int
    free_top int
    alloc_count int
    block_tables []int
    slot_num_blocks []int
}

struct GgufTensorInfo {
    name string
    gtype int
    n_elems int
    offset int
}

struct ForwardRow {
    pos int
    kv_offset int
    table_offset int
}

struct DecodeInput {
    slot int
    token int
