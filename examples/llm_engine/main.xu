    rope_freq_scale f64
    rope_dim int
    rope_interleaved bool
    rope_scaling_type string
    rope_yarn_orig_ctx int
    rope_yarn_beta_fast f64
    rope_yarn_beta_slow f64
    rope_yarn_attn_factor f64
    sliding_window int
    attn_logit_softcap f64
    logit_softcap f64
    use_geglu bool
    expert_count int
    expert_used_count int
    expert_hidden_dim int
    shared_expert_count int
    shared_expert_hidden_dim int
    expert_gating_func int
    expert_weights_norm bool
    expert_weights_scale f64
    kv_lora_rank int
    q_lora_rank int
    qk_nope_head_dim int
    qk_rope_head_dim int
    v_head_dim int
    q_dim int
    embed_scale f32
    rms_eps f64
    bos_token_id int
    eos_token_id int
