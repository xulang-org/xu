const RMS_CAP = 2048
const KV_BLOCK_SIZE = 16
const MAX_BATCH_SLOTS = 4
const PREFILL_CHUNK = 32
const DEFAULT_CTX_LIMIT = 512
const ARCH_ARM64 = 0
const ARCH_X64 = 1

const GGML_TYPE_F32 = 0
const GGML_TYPE_F16 = 1
const GGML_TYPE_Q4_0 = 2
const GGML_TYPE_Q5_0 = 6
const GGML_TYPE_Q8_0 = 8
const GGML_TYPE_Q4_K = 12
const GGML_TYPE_Q5_K = 13
const GGML_TYPE_Q6_K = 14
const GGML_TYPE_BF16 = 30
const GGML_TYPE_F8_E4M3 = 43

const COMPACT_DENSE = 0
const COMPACT_Q5_0 = 6
const COMPACT_Q8_0 = 8
const COMPACT_Q4_K = 12
const COMPACT_Q5_K = 13
const COMPACT_Q6_K = 14

