fn bits(v f32) int { << math.float32_bits(f64(v)) }
fn from_bits(b int) f32 { << f32(math.float32_from_bits(b)) }

fn alloc_zeros(n int) []f32 {
    $v := []f32{}
    if n > 0 { v.resize_zero(n) }
    << v
}

fn alloc_i8_zeros(n int) []i8 {
    $v := []i8{}
    if n > 0 { v.resize_zero(n) }
    << v
}

fn alloc_ints(n int, val int) []int {
    $v := []int{}
    if n > 0 { v.reserve(n) }
    for _ in 0:n { v.push(val) }
    << v
}

fn fast_exp_neg(x f64) f64 {
    if x <= -708.0 { << 0.0 }
    if x >= 0.0 { << 1.0 }
    n := int(x * 1.4426950408889634 - 0.5)
    nf := f64(n)
    ln2_hi := math.float64_from_bits(0x3FE62E42FEFA39EF)
    ln2_lo := math.float64_from_bits(0x3C7ABC9E3B39803F)
    r := x - nf * ln2_hi - nf * ln2_lo
    $p := 1.0 / 3628800.0
    p = p * r + 1.0 / 362880.0
    p = p * r + 1.0 / 40320.0
    p = p * r + 1.0 / 5040.0
    p = p * r + 1.0 / 720.0
    p = p * r + 1.0 / 120.0
    p = p * r + 1.0 / 24.0
    p = p * r + 1.0 / 6.0
    p = p * r + 0.5
    p = p * r + 1.0
    p = p * r + 1.0
    << p * math.float64_from_bits((n + 1023) << 52)
}

fn read_u16_le(buf &string, off int) int {
    << buf[off] | (buf[off + 1] << 8)
}

fn read_u32_le(buf &string, off int) int {
    << buf[off] | (buf[off + 1] << 8) | (buf[off + 2] << 16) | (buf[off + 3] << 24)
}

fn append_f32_segment(data &string, start int, count int, out $&[]f32) {
    for i in 0:count {
        out.push(from_bits(read_u32_le(data, start + 4 * i)))
    }
}

fn read_u64_le(buf &string, off int) int {
    $v := 0
    for i in 0:8 {
        v = v | (buf[off + i] << (i * 8))
    }
    << v
}

fn checked_size_product(a int, b int) int {
    if a < 0 || b < 0 { >>> errors.new("negative tensor size") }
    if b > 0 && a > 9223372036854775807 / b { >>> errors.new("tensor storage size overflow") }
    << a * b
}

fn gguf_starts_with(s &string, prefix string) bool {
    if s.len < prefix.len { << false }
    for i in 0:prefix.len {
        if (*s)[i] != prefix[i] { << false }
    }
    << true
}

fn gguf_ends_with(s &string, suffix string) bool {
    if s.len < suffix.len { << false }
    start := s.len - suffix.len
    for i in 0:suffix.len {
        if (*s)[start + i] != suffix[i] { << false }
    }
    << true
}

fn str_match_at(text &string, off int, pat &string) bool {
    if pat.len <= 0 || off + pat.len > text.len { << false }
    for i in 0:pat.len {
        if (*text)[off + i] != (*pat)[i] { << false }
    }
    << true
}

fn gpt2_unicode_to_byte(cp int) int {
    if (cp >= 33 && cp <= 126) || (cp >= 161 && cp <= 172) || (cp >= 174 && cp <= 255) {
        << cp
    }
    if cp >= 256 && cp <= 288 { << cp - 256 }
    if cp >= 289 && cp <= 322 { << cp - 289 + 127 }
    if cp == 323 { << 173 }
    << -1
}

fn decode_gpt2_piece(piece &string) string {
    $raw := []int{}
    $i := 0
    n := piece.len
    while i < n {
        b0 := (*piece)[i]
        $cp := b0
        $step := 1
        if (b0 & 0x80) == 0 {
            cp = b0
            step = 1
        } else if (b0 & 0xE0) == 0xC0 && i + 1 < n {
            b1 := (*piece)[i + 1]
            cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
            step = 2
        } else if (b0 & 0xF0) == 0xE0 && i + 2 < n {
            b1 := (*piece)[i + 1]
            b2 := (*piece)[i + 2]
            cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
            step = 3
        } else if (b0 & 0xF8) == 0xF0 && i + 3 < n {
            b1 := (*piece)[i + 1]
            b2 := (*piece)[i + 2]
            b3 := (*piece)[i + 3]
            cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
            step = 4
        }
        mapped := gpt2_unicode_to_byte(cp)
        if mapped >= 0 {
            raw.push(mapped)
        } else {
            for k in 0:step { raw.push((*piece)[i + k]) }
        }
        i += step
    }
    $s := ""
    for j in 0:raw.len {
        s = s + string_from_byte(raw[j])
    }
    << s
}

fn encode_gpt2_piece(raw &string) string {
    $out := ""
    for i in 0:raw.len {
        b := (*raw)[i]
        $cp := b
        if (b >= 33 && b <= 126) || (b >= 161 && b <= 172) || (b >= 174 && b <= 255) {
            cp = b
        } else if b >= 0 && b <= 32 {
            cp = 256 + b
        } else if b >= 127 && b <= 160 {
            cp = 289 + (b - 127)
        } else {
            cp = 323
        }
        if cp < 128 {
            out = out + string_from_byte(cp)
        } else {
            b1 := 0xC0 | ((cp >> 6) & 0x1F)
            b2 := 0x80 | (cp & 0x3F)
            out = out + string_from_byte(b1) + string_from_byte(b2)
        }
    }
    << out
}

fn read_exact(f &os.File, n int) string {
    if n <= 0 { << "" }
    $out := f.read(n) >>>
    if out.len <= 0 { >>> errors.new("unexpected eof while reading file") }
    if out.len == n { << out }
    while out.len < n {
        chunk := f.read(n - out.len) >>>
        if chunk.len <= 0 { >>> errors.new("unexpected eof while reading file") }
        out.push_str(chunk)
    }
    << out
}

fn ensure_hdr(f &os.File, hdr $&string, end int) int {
    while hdr.len < end {
        $want := end - hdr.len
        if want < 1048576 { want = 1048576 }
        chunk := f.read(want) >>>
        if chunk.len <= 0 { >>> errors.new("truncated gguf header") }
        hdr.push_str(chunk)
    }
    << 0
}

fn read_gguf_str(f &os.File, hdr $&string, pos $&int) string {
    p := *pos
    _ := ensure_hdr(f, hdr, p + 8) >>>
    slen := read_u64_le(hdr, p)
    if slen < 0 { >>> errors.new("invalid gguf string length") }
    _ := ensure_hdr(f, hdr, p + 8 + slen) >>>
    *pos = p + 8 + slen
    << (*hdr)[p + 8:p + 8 + slen]
}

fn read_gguf_int(f &os.File, hdr $&string, vtype int, pos $&int) int {
    p := *pos
    if vtype == 0 {
        _ := ensure_hdr(f, hdr, p + 1) >>>
        *pos = p + 1
        << (*hdr)[p]
    } else if vtype == 1 {
        _ := ensure_hdr(f, hdr, p + 1) >>>
        *pos = p + 1
        $v := (*hdr)[p]
        if v >= 128 { v -= 256 }
        << v
    } else if vtype == 2 {
        _ := ensure_hdr(f, hdr, p + 2) >>>
        *pos = p + 2
        << read_u16_le(hdr, p)
    } else if vtype == 3 {
        _ := ensure_hdr(f, hdr, p + 2) >>>
        *pos = p + 2
        $v := read_u16_le(hdr, p)
        if v >= 32768 { v -= 65536 }
        << v
    } else if vtype == 4 {
        _ := ensure_hdr(f, hdr, p + 4) >>>
        *pos = p + 4
        << read_u32_le(hdr, p)
    } else if vtype == 5 {
        _ := ensure_hdr(f, hdr, p + 4) >>>
        *pos = p + 4
        $v := read_u32_le(hdr, p)
        if v >= 0x80000000 { v -= 0x100000000 }
        << v
    } else if vtype == 10 || vtype == 11 {
        _ := ensure_hdr(f, hdr, p + 8) >>>
        *pos = p + 8
        << read_u64_le(hdr, p)
    }
    >>> errors.new("unexpected gguf integer metadata type")
}

fn skip_gguf_val(f &os.File, hdr $&string, vtype int, pos $&int) int {
    if vtype == 0 || vtype == 1 || vtype == 7 {
        _ := ensure_hdr(f, hdr, *pos + 1) >>>
        *pos = *pos + 1
    } else if vtype == 2 || vtype == 3 {
        _ := ensure_hdr(f, hdr, *pos + 2) >>>
        *pos = *pos + 2
    } else if vtype == 4 || vtype == 5 || vtype == 6 {
        _ := ensure_hdr(f, hdr, *pos + 4) >>>
        *pos = *pos + 4
    } else if vtype == 10 || vtype == 11 || vtype == 12 {
        _ := ensure_hdr(f, hdr, *pos + 8) >>>
        *pos = *pos + 8
    } else if vtype == 8 {
        _ := read_gguf_str(f, hdr, pos) >>>
    } else if vtype == 9 {
        _ := ensure_hdr(f, hdr, *pos + 12) >>>
        etype := read_u32_le(hdr, *pos)
        cnt := read_u64_le(hdr, *pos + 4)
        *pos = *pos + 12
        for _ in 0:cnt {
            _ := skip_gguf_val(f, hdr, etype, pos) >>>
        }
    } else {
        >>> errors.new("unsupported gguf metadata value type: " + str(vtype))
    }
    << 0
}

fn find_gguf_tensor(tensors &[]GgufTensorInfo, name string) int {
    for i in 0:tensors.len {
        if tensors[i].name == name { << i }
    }
    << -1
}

fn gguf_dense_dtype(gtype int) tensor.DType {
    if gtype == GGML_TYPE_F32 { << tensor.dtype_f32() }
    if gtype == GGML_TYPE_F16 { << tensor.dtype_f16() }
    if gtype == GGML_TYPE_BF16 { << tensor.dtype_bf16() }
    if gtype == GGML_TYPE_F8_E4M3 { << tensor.dtype_fp8_e4m3fn() }
    >>> errors.new("unsupported ggml dense type: " + str(gtype))
}

fn gguf_tensor_start(data_base int, info &GgufTensorInfo) int {
    if data_base < 0 || info.offset < 0 || info.offset > 9223372036854775807 - data_base {
        >>> errors.new("gguf tensor offset out of range: " + info.name)
    }
    << data_base + info.offset
}

fn gguf_stream_f32_into(f &os.File, data_base int, info &GgufTensorInfo, expected int, out $&[]f32) int {
    if info.n_elems != expected || expected < 0 {
        >>> errors.new("gguf tensor length mismatch for " + info.name)
    }
    start := gguf_tensor_start(data_base, info) >>>
    _ := f.seek(start, os.SEEK_SET) >>>
    if info.gtype == GGML_TYPE_Q4_0 || info.gtype == GGML_TYPE_Q5_0 || info.gtype == GGML_TYPE_Q8_0 {
        if expected % tensor.GGML_BLOCK_VALUES != 0 {
            >>> errors.new("gguf length not a multiple of the quantization block: " + info.name)
        }
        blocks := expected / tensor.GGML_BLOCK_VALUES
        if info.gtype == GGML_TYPE_Q4_0 {
            length := checked_size_product(blocks, tensor.Q4_0_BYTES) >>>
            chunk := read_exact(f, length) >>>
            for i in 0:blocks {
                block := tensor.read_q4_0(&chunk, i * tensor.Q4_0_BYTES) >>>
                block.append_f32(out)
            }
        } else if info.gtype == GGML_TYPE_Q5_0 {
            length := checked_size_product(blocks, tensor.Q5_0_BYTES) >>>
            chunk := read_exact(f, length) >>>
            for i in 0:blocks {
                block := tensor.read_q5_0(&chunk, i * tensor.Q5_0_BYTES) >>>
                block.append_f32(out)
            }
        } else {
            length := checked_size_product(blocks, tensor.Q8_0_BYTES) >>>
            chunk := read_exact(f, length) >>>
            for i in 0:blocks {
                block := tensor.read_q8_0(&chunk, i * tensor.Q8_0_BYTES) >>>
                block.append_f32(out)
            }
        }
        << 0
    } else if info.gtype == GGML_TYPE_Q4_K || info.gtype == GGML_TYPE_Q5_K || info.gtype == GGML_TYPE_Q6_K {
        if expected % tensor.QK_K != 0 {
            >>> errors.new("gguf length not a multiple of K-quant super-block: " + info.name)
        }
        blocks := expected / tensor.QK_K
        if info.gtype == GGML_TYPE_Q4_K {
            length := checked_size_product(blocks, tensor.Q4_K_BYTES) >>>
            chunk := read_exact(f, length) >>>
            for i in 0:blocks {
                block := tensor.read_q4_k(&chunk, i * tensor.Q4_K_BYTES) >>>
                block.append_f32(out)
            }
        } else if info.gtype == GGML_TYPE_Q5_K {
            length := checked_size_product(blocks, tensor.Q5_K_BYTES) >>>
            chunk := read_exact(f, length) >>>
            for i in 0:blocks {
                block := tensor.read_q5_k(&chunk, i * tensor.Q5_K_BYTES) >>>
                block.append_f32(out)
            }
        } else {
            length := checked_size_product(blocks, tensor.Q6_K_BYTES) >>>
            chunk := read_exact(f, length) >>>
            for i in 0:blocks {
                block := tensor.read_q6_k(&chunk, i * tensor.Q6_K_BYTES) >>>
                block.append_f32(out)
            }
        }
        << 0
    }

    dtype := gguf_dense_dtype(info.gtype) >>>
    length := checked_size_product(expected, dtype.element_bytes()) >>>
    chunk := read_exact(f, length) >>>
    if dtype.is_f32() {
        append_f32_segment(&chunk, 0, expected, out)
        << 0
    }
    shape := [expected]
    view := tensor.contiguous_view(dtype, &shape, 0, chunk.len) >>>
    _ := view.append_f32(&chunk, out) >>>
    << 0
}

fn gguf_stream_f32_slice(f &os.File, data_base int, info &GgufTensorInfo, expected int) []f32 {
    $out := []f32{}
    if expected > 0 { out.reserve(expected) }
    _ := gguf_stream_f32_into(f, data_base, info, expected, $&out) >>>
    << out
}

fn ffn_max_hidden(cfg &ModelConfig) int {
    $h := cfg.hidden_dim
    if cfg.expert_hidden_dim > h { h = cfg.expert_hidden_dim }
    if cfg.shared_expert_hidden_dim > h { h = cfg.shared_expert_hidden_dim }
    if cfg.kv_lora_rank > 0 {
        kvb_rows := cfg.n_heads * (cfg.qk_nope_head_dim + cfg.v_head_dim)
        if kvb_rows > h { h = kvb_rows }
        if cfg.q_lora_rank > h { h = cfg.q_lora_rank }
    }
    if h < 1 { h = 1 }
    << h
}

fn max_q_buf_dim(cfg &ModelConfig) int {
    $d := cfg.dim
    if cfg.q_dim > d { d = cfg.q_dim }
    if cfg.kv_lora_rank > 0 {
        kvb_rows := cfg.n_heads * (cfg.qk_nope_head_dim + cfg.v_head_dim)
        if kvb_rows > d { d = kvb_rows }
    }
    << d
}

fn max_kv_buf_dim(cfg &ModelConfig) int {
    $d := cfg.kv_dim
    if cfg.kv_lora_rank > 0 {
        kva := cfg.kv_lora_rank + cfg.qk_rope_head_dim
        if kva > d { d = kva }
        vd := cfg.n_heads * cfg.v_head_dim
        if vd > d { d = vd }
    }
    << d
}

fn gguf_stream_quant_compact_at(f &os.File, start int, tname &string, gtype int, n_elems int,
                                rows int, cols int, slice_elems int, compact $&CompactWeights) int {
    expected := rows * cols
    $blk_elems := tensor.QK_K
    $blk_bytes := tensor.Q4_K_BYTES
    $kind := COMPACT_Q4_K
    if gtype == GGML_TYPE_Q5_K {
        blk_bytes = tensor.Q5_K_BYTES
        kind = COMPACT_Q5_K
    } else if gtype == GGML_TYPE_Q6_K {
        blk_bytes = tensor.Q6_K_BYTES
        kind = COMPACT_Q6_K
    } else if gtype == GGML_TYPE_Q5_0 {
        blk_elems = tensor.GGML_BLOCK_VALUES
        blk_bytes = tensor.Q5_0_BYTES
        kind = COMPACT_Q5_0
    } else if gtype == GGML_TYPE_Q8_0 {
        blk_elems = tensor.GGML_BLOCK_VALUES
        blk_bytes = tensor.Q8_0_BYTES
        kind = COMPACT_Q8_0
    } else if gtype != GGML_TYPE_Q4_K {
        >>> errors.new("expected quantized gguf tensor for " + (*tname))
    }
    if n_elems != slice_elems || cols <= 0 || cols % blk_elems != 0 {
        >>> errors.new("gguf quantized tensor shape mismatch for " + (*tname))
    }
    nb := cols / blk_elems
    row_bytes := checked_size_product(nb, blk_bytes) >>>
    total_bytes := checked_size_product(rows, row_bytes) >>>
    _ := f.seek(start, os.SEEK_SET) >>>
    chunk := read_exact(f, total_bytes) >>>
    arena_start := compact.data.len
    backing := $&compact.data
    backing.push_str(chunk)
    empty_shape := [0]
    dummy := tensor.contiguous_view(tensor.dtype_f32(), &empty_shape, 0, 0) >>>
    index := compact.views.len
    compact.views.push(dummy)
    compact.kinds.push(kind)
    compact.raw_starts.push(arena_start)
    compact.raw_rows.push(rows)
    compact.raw_cols.push(cols)
    << -1 - index
}

fn gguf_stream_matrix_at(f &os.File, start int, tname &string, gtype int, n_elems int,
                         rows int, cols int, slice_elems int,
                         arena $&[]f32, compact $&CompactWeights) int {
    if gtype == GGML_TYPE_Q4_K || gtype == GGML_TYPE_Q5_K || gtype == GGML_TYPE_Q6_K ||
       gtype == GGML_TYPE_Q5_0 || gtype == GGML_TYPE_Q8_0 {
        << gguf_stream_quant_compact_at(f, start, tname, gtype, n_elems, rows, cols, slice_elems, compact) >>>
    }
    expected := rows * cols
    if n_elems != slice_elems || expected < 0 {
        >>> errors.new("gguf tensor length mismatch for " + (*tname))
    }
    _ := f.seek(start, os.SEEK_SET) >>>
    if gtype == GGML_TYPE_F32 {
        offset := arena.len
        length := checked_size_product(expected, 4) >>>
        chunk := read_exact(f, length) >>>
        append_f32_segment(&chunk, 0, expected, arena)
        << offset
    }
    dtype := gguf_dense_dtype(gtype) >>>
    length := checked_size_product(expected, dtype.element_bytes()) >>>
    chunk := read_exact(f, length) >>>
    shape := [expected]
    view := tensor.contiguous_view(dtype, &shape, 0, chunk.len) >>>
    << append_compact(&view, &chunk, &shape, compact) >>>
}

fn gguf_stream_matrix(f &os.File, data_base int, info &GgufTensorInfo, rows int, cols int,
                      arena $&[]f32, compact $&CompactWeights) int {
    start := gguf_tensor_start(data_base, info) >>>
    << gguf_stream_matrix_at(f, start, &info.name, info.gtype, info.n_elems, rows, cols, rows * cols, arena, compact) >>>
}

fn gguf_stream_q4_0_at(f &os.File, start int, tname &string, gtype int, n_elems int,
                       rows int, cols int, slice_elems int,
                       qs $&[]u8, scales $&[]f32) int {
    if n_elems != slice_elems || cols % 32 != 0 {
        >>> errors.new("gguf q4_0 tensor shape mismatch for " + (*tname))
    }
    if gtype != GGML_TYPE_Q4_0 {
        >>> errors.new("expected Q4_0 gguf tensor for " + (*tname))
    }
    blk_off := scales.len
    nb := cols / 32
    _ := f.seek(start, os.SEEK_SET) >>>
    $rem := rows
    while rem > 0 {
        $cr := rem
        if cr > 1024 { cr = 1024 }
        n_blks := cr * nb
        chunk := read_exact(f, n_blks * 18) >>>
        $pos := 0
        for _ in 0:n_blks {
            block := tensor.read_q4_0(&chunk, pos) >>>
            scales.push(block.scale.to_f32())
            for j in 0:16 {
                qs.push(block.packed[j])
            }
            pos += tensor.Q4_0_BYTES
        }
        rem -= cr
    }
    << blk_off
}

fn gguf_stream_q4_0(f &os.File, data_base int, info &GgufTensorInfo, rows int, cols int,
                    qs $&[]u8, scales $&[]f32) int {
    << gguf_stream_q4_0_at(f, data_base + info.offset, &info.name, info.gtype, info.n_elems, rows, cols, rows * cols, qs, scales) >>>
}

fn gguf_stream_q8_0_at(f &os.File, start int, tname &string, gtype int, n_elems int,
                       rows int, cols int, slice_elems int,
                       qs $&[]i8, scales $&[]f32) int {
    if n_elems != slice_elems || cols % 32 != 0 {
        >>> errors.new("gguf q8_0 tensor shape mismatch for " + (*tname))
    }
    if gtype != GGML_TYPE_Q8_0 {
        >>> errors.new("expected Q8_0 gguf tensor for " + (*tname))
    }
    blk_off := scales.len
    nb := cols / 32
    _ := f.seek(start, os.SEEK_SET) >>>
    $rem := rows
    while rem > 0 {
        $cr := rem
        if cr > 1024 { cr = 1024 }
        n_blks := cr * nb
        chunk := read_exact(f, n_blks * 34) >>>
        $pos := 0
        for _ in 0:n_blks {
            block := tensor.read_q8_0(&chunk, pos) >>>
            scales.push(block.scale.to_f32())
            for j in 0:32 {
                qs.push(block.quants[j])
            }
            pos += tensor.Q8_0_BYTES
        }
        rem -= cr
    }
    << blk_off
}

fn gguf_stream_q8_0(f &os.File, data_base int, info &GgufTensorInfo, rows int, cols int,
                    qs $&[]i8, scales $&[]f32) int {
    << gguf_stream_q8_0_at(f, data_base + info.offset, &info.name, info.gtype, info.n_elems, rows, cols, rows * cols, qs, scales) >>>
}

fn gguf_stream_q4_0_p4k4_at(f &os.File, start int, tname &string, gtype int, n_elems int,
                            rows int, cols int, slice_elems int,
                            qs_p $&[]u8, ws_p $&[]u16, gb_cur $&int) int {
    if n_elems != slice_elems || rows % 4 != 0 || cols % 32 != 0 {
        >>> errors.new("gguf q4_0 p4k4 tensor shape mismatch for " + (*tname))
    }
    if gtype != GGML_TYPE_Q4_0 {
        >>> errors.new("expected Q4_0 gguf tensor for " + (*tname))
    }
    p4_blk_off := *gb_cur
    nb := cols / 32
    row_bytes := nb * 18
    _ := f.seek(start, os.SEEK_SET) >>>
    $rem := rows
    while rem > 0 {
        $cr := rem
        if cr > 1024 { cr = 1024 }
        chunk := read_exact(f, cr * row_bytes) >>>
        cg_cnt := cr / 4
        gb_start := *gb_cur
        for cg in 0:cg_cnt {
            base0 := cg * 4 * row_bytes
            g_off := gb_start + cg * nb
            for b in 0:nb {
                gb := g_off + b
                b_off := b * 18
                s_base := gb * 4
                for r4 in 0:4 {
                    p := base0 + r4 * row_bytes + b_off
                    ws_p[s_base + r4] = u16(chunk[p] | (chunk[p + 1] << 8))
                }
                // Interleave four bytes from each row and store the nibbles in two’s complement.
                q_gb := gb * 64
                for r4 in 0:4 {
                    p := base0 + r4 * row_bytes + b_off + 2
                    q_dst := q_gb + r4 * 4
                    for j in 0:16 {
                        qs_p[q_dst + (j >> 2) * 16 + (j & 3)] = u8(chunk[p + j] ^ 136)
                    }
                }
            }
        }
        *gb_cur = gb_start + cg_cnt * nb
        rem -= cr
    }
    << p4_blk_off
}

fn gguf_stream_q4_0_p4k4(f &os.File, data_base int, info &GgufTensorInfo, rows int, cols int,
                       qs_p $&[]u8, ws_p $&[]u16, gb_cur $&int) int {
    << gguf_stream_q4_0_p4k4_at(f, data_base + info.offset, &info.name, info.gtype, info.n_elems, rows, cols, rows * cols, qs_p, ws_p, gb_cur) >>>
}

fn gguf_stream_q8_0_p4k4_at(f &os.File, start int, tname &string, gtype int, n_elems int,
                            rows int, cols int, slice_elems int,
                            qs_p $&[]i8, ws_p $&[]u16, gb_cur $&int) int {
    if n_elems != slice_elems || rows % 4 != 0 || cols % 32 != 0 {
        >>> errors.new("gguf q8_0 p4k4 tensor shape mismatch for " + (*tname))
    }
    if gtype != GGML_TYPE_Q8_0 {
        >>> errors.new("expected Q8_0 gguf tensor for " + (*tname))
    }
    p4_blk_off := *gb_cur
    nb := cols / 32
    row_bytes := nb * 34
    _ := f.seek(start, os.SEEK_SET) >>>
    $rem := rows
    while rem > 0 {
        $cr := rem
        if cr > 1024 { cr = 1024 }
        chunk := read_exact(f, cr * row_bytes) >>>
        cg_cnt := cr / 4
        gb_start := *gb_cur
        for cg in 0:cg_cnt {
            base0 := cg * 4 * row_bytes
            g_off := gb_start + cg * nb
            for b in 0:nb {
                gb := g_off + b
                b_off := b * 34
                s_base := gb * 4
                for r4 in 0:4 {
                    p := base0 + r4 * row_bytes + b_off
                    ws_p[s_base + r4] = u16(chunk[p] | (chunk[p + 1] << 8))
                }
                q_gb := gb * 128
                for r4 in 0:4 {
                    p := base0 + r4 * row_bytes + b_off + 2
                    q_dst := q_gb + r4 * 4
                    for j in 0:32 {
                        qs_p[q_dst + (j >> 2) * 16 + (j & 3)] = i8(chunk[p + j])
                    }
                }
            }
        }
        *gb_cur = gb_start + cg_cnt * nb
        rem -= cr
    }
    << p4_blk_off
}

fn gguf_stream_q8_0_p4k4(f &os.File, data_base int, info &GgufTensorInfo, rows int, cols int,
                       qs_p $&[]i8, ws_p $&[]u16, gb_cur $&int) int {
    << gguf_stream_q8_0_p4k4_at(f, data_base + info.offset, &info.name, info.gtype, info.n_elems, rows, cols, rows * cols, qs_p, ws_p, gb_cur) >>>
}

fn meta_int(doc &json.Doc, meta int, key string) int {
    s := doc.as_string(doc.get(meta, key))
    << strconv.atoi(&s) >>>
}

fn safetensor_view(data &string, base int, doc &json.Doc, root int,
                   name &string, shape &[]int) tensor.TensorView {
    entry := doc.get(root, (*name) + "")
    dtype_name := doc.as_string(doc.get(entry, "dtype")) >>>
    dtype := tensor.safetensors_dtype(&dtype_name) >>> (err) {
        >>> errors.new((*name) + ": " + err.msg())
    }
    dimensions := doc.get(entry, "shape")
    if !doc.is_list(dimensions) || doc.count(dimensions) != shape.len {
        >>> errors.new("tensor rank mismatch for " + (*name))
    }
    for axis in 0:shape.len {
        dim := doc.as_int(doc.at(dimensions, axis)) >>>
        if dim != shape[axis] { >>> errors.new("tensor shape mismatch for " + (*name)) }
    }
    offs := doc.get(entry, "data_offsets")
    if !doc.is_list(offs) || doc.count(offs) != 2 { >>> errors.new("bad tensor offsets for " + (*name)) }
    start := doc.as_int(doc.at(offs, 0)) >>>
    stop := doc.as_int(doc.at(offs, 1)) >>>
    if start < 0 || stop < start || stop > data.len - base {
        >>> errors.new("tensor data outside file for " + (*name))
    }
    view := tensor.contiguous_view(dtype, shape, base + start, base + stop) >>> (err) {
        >>> errors.new((*name) + ": " + err.msg())
    }
    if view.storage_end() != base + stop { >>> errors.new("tensor byte length mismatch for " + (*name)) }
    << view
}

fn load_tensor_slice(data &string, base int, doc &json.Doc, root int, name string, expected_len int) []f32 {
    shape := [expected_len]
    view := safetensor_view(data, base, doc, root, &name, &shape) >>>
    $out := []f32{}
    out.reserve(expected_len)
    _ := view.append_f32(data, $&out) >>>
    << out
}

fn append_compact(view &tensor.TensorView, data &string, shape &[]int, arena $&CompactWeights) int {
    start := arena.data.len
    bytes := (*data)[view.storage_start():view.storage_end()]
    backing := $&arena.data
    backing.push_str(bytes)
    stored := tensor.contiguous_view(view.dtype(), shape, start, arena.data.len) >>>
    index := arena.views.len
    arena.views.push(stored)
    arena.kinds.push(COMPACT_DENSE)
    arena.raw_starts.push(start)
    arena.raw_rows.push(0)
    arena.raw_cols.push(0)
    << -1 - index
}

fn append_tensor(data &string, base int, doc &json.Doc, root int, name string,
                 rows int, columns int, arena $&[]f32, compact $&CompactWeights) int {
    shape := [rows, columns]
    view := safetensor_view(data, base, doc, root, &name, &shape) >>>
    if !view.dtype().is_f32() { << append_compact(&view, data, &shape, compact) >>> }

    offset := arena.len
    append_f32_segment(data, view.storage_start(), view.element_count(), arena)
    << offset
}

fn build_rope_tables(rope_dim int, max_seq_len int, rope_theta f64, rope_freq_scale f64,
                     scaling_type string, orig_ctx int, beta_fast f64, beta_slow f64, attn_factor f64,
                     rope_cos $&[]f32, rope_sin $&[]f32) {
    half := rope_dim / 2
    if max_seq_len * half > 0 {
        rope_cos.reserve(max_seq_len * half)
        rope_sin.reserve(max_seq_len * half)
    }
    $scale := rope_freq_scale
    if scale <= 0.0 { scale = 1.0 }
    log_theta := math.log(rope_theta)
    use_yarn := scaling_type == "yarn" && scale > 1.0 && orig_ctx > 0 && beta_fast > 0.0 && beta_slow > 0.0
    $inv_freqs := []f64{}
    $mscale := 1.0
    if use_yarn {
        two_pi := 6.283185307179586
        $low := (f64(rope_dim) * math.log(f64(orig_ctx) / (beta_fast * two_pi))) / (2.0 * log_theta)
        $high := (f64(rope_dim) * math.log(f64(orig_ctx) / (beta_slow * two_pi))) / (2.0 * log_theta)
        if low < 0.0 { low = 0.0 }
        if high > f64(half - 1) { high = f64(half - 1) }
        if high <= low { high = low + 0.001 }
        mscale = attn_factor
        if mscale <= 0.0 {
            mscale = 0.1 * math.log(scale) + 1.0
        }
        for j in 0:half {
            f_ext := math.exp(-log_theta * (f64(2 * j) / f64(rope_dim)))
            f_int := f_ext / scale
            $ramp := (f64(j) - low) / (high - low)
            if ramp < 0.0 { ramp = 0.0 }
            if ramp > 1.0 { ramp = 1.0 }
            gamma := 1.0 - ramp
            inv_freqs.push((1.0 - gamma) * f_int + gamma * f_ext)
        }
    }
    for pos in 0:max_seq_len {
        for j in 0:half {
            if use_yarn {
                angle := f64(pos) * inv_freqs[j]
                rope_cos.push(f32(math.cos(angle) * mscale))
                rope_sin.push(f32(math.sin(angle) * mscale))
            } else {
                freq := math.exp(-log_theta * (f64(2 * j) / f64(rope_dim)))
                angle := (f64(pos) / scale) * freq
                rope_cos.push(f32(math.cos(angle)))
                rope_sin.push(f32(math.sin(angle)))
            }
        }
    }
}

fn load_model_safetensors(data &string, ctx_limit int) Model {
    if data.len < 8 { >>> errors.new("truncated safetensors file") }
    header_len := read_u64_le(data, 0)
    if header_len <= 0 || header_len > data.len - 8 { >>> errors.new("invalid safetensors header length") }
    header_str := (*data)[8:8 + header_len]
    doc := json.parse(&header_str) >>>
    root := doc.root()
    meta := doc.get(root, "__metadata__")

    dim := meta_int(&doc, meta, "dim") >>>
    hidden_dim := meta_int(&doc, meta, "hidden_dim") >>>
    n_layers := meta_int(&doc, meta, "n_layers") >>>
    n_heads := meta_int(&doc, meta, "n_heads") >>>
    n_kv_heads := meta_int(&doc, meta, "n_kv_heads") >>>
    vocab_size := meta_int(&doc, meta, "vocab_size") >>>
    $max_seq_len := meta_int(&doc, meta, "max_seq_len") >>>
    if ctx_limit > 0 && max_seq_len > ctx_limit { max_seq_len = ctx_limit }
    rope_theta := f64(meta_int(&doc, meta, "rope_theta") >>>)
    if dim <= 0 || hidden_dim <= 0 || n_layers <= 0 || vocab_size <= 0 || max_seq_len <= 0 {
        >>> errors.new("invalid Safetensors model dimensions")
    }
    if n_heads <= 0 || n_kv_heads <= 0 || dim % n_heads != 0 || n_heads % n_kv_heads != 0 {
        >>> errors.new("invalid Safetensors attention head counts")
    }
    head_dim := dim / n_heads
    if head_dim % 2 != 0 { >>> errors.new("Safetensors attention head dimensions must be even") }
    kv_dim := n_kv_heads * head_dim
    cfg := ModelConfig{
        dim: dim, hidden_dim: hidden_dim, n_layers: n_layers, n_heads: n_heads,
        n_kv_heads: n_kv_heads, head_dim: head_dim, kv_dim: kv_dim,
        vocab_size: vocab_size, max_seq_len: max_seq_len, rope_theta: rope_theta,
        rope_freq_scale: 1.0, rope_dim: head_dim, rope_interleaved: false,
        rope_scaling_type: "", rope_yarn_orig_ctx: 0, rope_yarn_beta_fast: 32.0, rope_yarn_beta_slow: 1.0, rope_yarn_attn_factor: 0.0,
        sliding_window: 0, attn_logit_softcap: 0.0, logit_softcap: 0.0,
        use_geglu: false, expert_count: 0, expert_used_count: 0, expert_hidden_dim: 0,
        shared_expert_count: 0, shared_expert_hidden_dim: 0, expert_gating_func: 0,
        expert_weights_norm: false, expert_weights_scale: 1.0,
        kv_lora_rank: 0, q_lora_rank: 0, qk_nope_head_dim: 0, qk_rope_head_dim: head_dim, v_head_dim: head_dim, q_dim: dim,
        embed_scale: f32(1.0),
        rms_eps: 0.00001, bos_token_id: -1, eos_token_id: 2, is_gpt2_tok: false,
        tok_model: "", arch: "", chat_template: ""
    }

    base := 8 + header_len
    $weights := []f32{}
    $compact := empty_compact_weights()
    embed_off := append_tensor(data, base, &doc, root, "embed_tokens.weight", vocab_size, dim, $&weights, $&compact) >>>

    $wq_off := []int{}
    $wk_off := []int{}
    $wv_off := []int{}
    $wo_off := []int{}
    $w1_off := []int{}
    $w2_off := []int{}
    $w3_off := []int{}
    $attn_norms := [][]f32{}
    $ffn_norms := [][]f32{}

    for l in 0:n_layers {
        prefix := "layers." + str(l) + "."
        an := load_tensor_slice(data, base, &doc, root, prefix + "input_layernorm.weight", dim) >>>
        attn_norms.push(an)
        fnm := load_tensor_slice(data, base, &doc, root, prefix + "post_attention_layernorm.weight", dim) >>>
        ffn_norms.push(fnm)
        wq_off.push(append_tensor(data, base, &doc, root, prefix + "self_attn.q_proj.weight", dim, dim, $&weights, $&compact) >>>)
        wk_off.push(append_tensor(data, base, &doc, root, prefix + "self_attn.k_proj.weight", kv_dim, dim, $&weights, $&compact) >>>)
        wv_off.push(append_tensor(data, base, &doc, root, prefix + "self_attn.v_proj.weight", kv_dim, dim, $&weights, $&compact) >>>)
        wo_off.push(append_tensor(data, base, &doc, root, prefix + "self_attn.o_proj.weight", dim, dim, $&weights, $&compact) >>>)
        w1_off.push(append_tensor(data, base, &doc, root, prefix + "mlp.gate_proj.weight", hidden_dim, dim, $&weights, $&compact) >>>)
        w3_off.push(append_tensor(data, base, &doc, root, prefix + "mlp.up_proj.weight", hidden_dim, dim, $&weights, $&compact) >>>)
        w2_off.push(append_tensor(data, base, &doc, root, prefix + "mlp.down_proj.weight", dim, hidden_dim, $&weights, $&compact) >>>)
    }

    final_norm := load_tensor_slice(data, base, &doc, root, "norm.weight", dim) >>>
    lm_head_off := append_tensor(data, base, &doc, root, "lm_head.weight", vocab_size, dim, $&weights, $&compact) >>>

    $rope_cos := []f32{}
    $rope_sin := []f32{}
    build_rope_tables(head_dim, max_seq_len, rope_theta, cfg.rope_freq_scale, cfg.rope_scaling_type, cfg.rope_yarn_orig_ctx, cfg.rope_yarn_beta_fast, cfg.rope_yarn_beta_slow, cfg.rope_yarn_attn_factor, $&rope_cos, $&rope_sin)

    << Model{
        cfg: cfg, is_q4: false, is_q8: false, embed_q4: false, lm_head_q4: false, lm_head_q8: false,
        layers_p4: false, embed_p4: false, lm_head_p4: false, has_qkv_bias: false, has_qk_norm: false,
        has_post_norms: false, is_moe: false, is_mla: false, use_q8k_act: false, lora: empty_lora_state(n_layers),
        chat_template_kind: TEMPLATE_RAW, eos_ids: [2],
        weights: weights, compact_weights: compact, q4_qs: []u8{}, q4_scales: []f32{}, q8_qs: []i8{}, q8_scales: []f32{},
        q4_p4k4_qs: []u8{}, q4_p4k4_scales: []u16{}, q8_p4k4_qs: []i8{}, q8_p4k4_scales: []u16{},
        embed_off: embed_off, lm_head_off: lm_head_off,
        wq_off: wq_off, wk_off: wk_off, wv_off: wv_off, wo_off: wo_off,
        w1_off: w1_off, w2_off: w2_off, w3_off: w3_off,
        mla_has_qlora: []bool{}, mla_qa_off: []int{}, mla_qa_norm: [][]f32{}, mla_qb_off: []int{},
        mla_kva_off: []int{}, mla_kva_norm: [][]f32{}, mla_kvb_off: []int{},
        moe_gate_inp_off: []int{}, moe_exp_probs_bias: [][]f32{},
        moe_layer: []bool{},
        moe_w1_off: [][]int{}, moe_w2_off: [][]int{}, moe_w3_off: [][]int{},
        moe_has_shared: []bool{}, moe_sh_w1_off: []int{}, moe_sh_w2_off: []int{},
        moe_sh_w3_off: []int{}, moe_has_sh_gate: []bool{}, moe_sh_gate_inp_off: []int{},
        bq: [][]f32{}, bk: [][]f32{}, bv: [][]f32{},
        q_norms: [][]f32{}, k_norms: [][]f32{},
        post_attn_norms: [][]f32{}, post_ffn_norms: [][]f32{},
        attn_norms: attn_norms, ffn_norms: ffn_norms, final_norm: final_norm,
        zeros: alloc_zeros(dim), rope_cos: rope_cos, rope_sin: rope_sin,
        vocab: []string{}, vocab_map: map[string]int{}, bpe_merges: map[string]int{}
    }
}

fn load_model_gguf_header(f &os.File, ctx_limit int, cfg_out $&ModelConfig, vocab $&[]string, vocab_map $&map[string]int, merges $&map[string]int, tensors $&[]GgufTensorInfo) int {
    $hdr := ""
    _ := ensure_hdr(f, $&hdr, 24) >>>
    ver := read_u32_le(&hdr, 4)
    if ver != 2 && ver != 3 { >>> errors.new("unsupported gguf version: " + str(ver)) }
    tensor_count := read_u64_le(&hdr, 8)
    kv_count := read_u64_le(&hdr, 16)

    $pos := 24
    $dim := 0
    $hidden_dim := 0
    $n_layers := 0
    $n_heads := 0
    $n_kv_heads := 0
    $max_seq_len := 64
    $rope_theta := 10000.0
    $rope_freq_scale := 1.0
    $rope_dim := 0
    $rope_interleaved := false
    $rope_scaling_type := ""
    $rope_yarn_orig_ctx := 0
    $rope_yarn_beta_fast := 32.0
    $rope_yarn_beta_slow := 1.0
    $rope_yarn_attn_factor := 0.0
    $sliding_window := 0
    $attn_logit_softcap := 0.0
    $logit_softcap := 0.0
    $use_geglu := false
    $has_use_geglu := false
    $expert_count := 0
    $expert_used_count := 0
    $expert_hidden_dim := 0
    $shared_expert_count := 0
    $shared_expert_hidden_dim := 0
    $expert_gating_func := 0
    $expert_weights_norm := false
    $expert_weights_scale := 1.0
    $kv_lora_rank := 0
    $q_lora_rank := 0
    $attn_key_len := 0
    $attn_val_len := 0
    $rms_eps := 0.00001
    $alignment := 32
    $bos_token_id := -1
    $eos_token_id := 2
    $is_gpt2_tok := false
    $tok_model := ""
    $arch := ""
    $chat_template := ""

    for _ in 0:kv_count {
        key := read_gguf_str(f, $&hdr, $&pos) >>>
        _ := ensure_hdr(f, $&hdr, pos + 4) >>>
        vtype := read_u32_le(&hdr, pos)
        pos += 4

        if key == "general.architecture" && vtype == 8 {
            arch = read_gguf_str(f, $&hdr, $&pos) >>>
        } else if gguf_ends_with(&key, ".embedding_length") {
            dim = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".feed_forward_length") {
            hidden_dim = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".block_count") {
            n_layers = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".attention.head_count") {
            n_heads = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".attention.head_count_kv") {
            n_kv_heads = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".attention.kv_lora_rank") {
            kv_lora_rank = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".attention.q_lora_rank") {
            q_lora_rank = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".attention.key_length") {
            attn_key_len = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".attention.value_length") {
            attn_val_len = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".context_length") {
            max_seq_len = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".rope.dimension_count") {
            rope_dim = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".rope.interleaved") && vtype == 7 {
            _ := ensure_hdr(f, $&hdr, pos + 1) >>>
            rope_interleaved = (hdr[pos] & 255) != 0
            pos += 1
        } else if gguf_ends_with(&key, ".attention.sliding_window") {
            sliding_window = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".attn_logit_softcapping") && vtype == 6 {
            _ := ensure_hdr(f, $&hdr, pos + 4) >>>
            sc := f64(from_bits(read_u32_le(&hdr, pos)))
            if sc > 0.0 { attn_logit_softcap = sc }
            pos += 4
        } else if gguf_ends_with(&key, ".use_geglu") && vtype == 7 {
            _ := ensure_hdr(f, $&hdr, pos + 1) >>>
            use_geglu = (hdr[pos] & 255) != 0
            has_use_geglu = true
            pos += 1
        } else if gguf_ends_with(&key, ".rope.freq_base") && vtype == 6 {
            _ := ensure_hdr(f, $&hdr, pos + 4) >>>
            rope_theta = f64(from_bits(read_u32_le(&hdr, pos)))
            pos += 4
        } else if gguf_ends_with(&key, ".rope.scaling.factor") && vtype == 6 {
            _ := ensure_hdr(f, $&hdr, pos + 4) >>>
            rf := f64(from_bits(read_u32_le(&hdr, pos)))
            if rf > 0.0 { rope_freq_scale = rf }
            pos += 4
        } else if gguf_ends_with(&key, ".rope.scaling.type") && vtype == 8 {
            rope_scaling_type = read_gguf_str(f, $&hdr, $&pos) >>>
        } else if gguf_ends_with(&key, ".rope.scaling.original_context_length") || gguf_ends_with(&key, ".rope.scaling.orig_ctx_len") {
            rope_yarn_orig_ctx = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".rope.scaling.beta_fast") && vtype == 6 {
            _ := ensure_hdr(f, $&hdr, pos + 4) >>>
            bf := f64(from_bits(read_u32_le(&hdr, pos)))
            if bf > 0.0 { rope_yarn_beta_fast = bf }
            pos += 4
        } else if gguf_ends_with(&key, ".rope.scaling.beta_slow") && vtype == 6 {
            _ := ensure_hdr(f, $&hdr, pos + 4) >>>
            bs := f64(from_bits(read_u32_le(&hdr, pos)))
            if bs > 0.0 { rope_yarn_beta_slow = bs }
            pos += 4
        } else if gguf_ends_with(&key, ".rope.scaling.attn_factor") && vtype == 6 {
            _ := ensure_hdr(f, $&hdr, pos + 4) >>>
            af := f64(from_bits(read_u32_le(&hdr, pos)))
            if af > 0.0 { rope_yarn_attn_factor = af }
            pos += 4
        } else if gguf_ends_with(&key, ".expert_count") {
            expert_count = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".expert_used_count") {
            expert_used_count = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".expert_feed_forward_length") {
            expert_hidden_dim = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".expert_shared_count") {
            shared_expert_count = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".expert_shared_feed_forward_length") {
            shared_expert_hidden_dim = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if gguf_ends_with(&key, ".expert_gating_func") {
            if vtype == 8 {
                gs := read_gguf_str(f, $&hdr, $&pos) >>>
                if gs == "sigmoid" { expert_gating_func = 2 }
                else if gs == "softmax" { expert_gating_func = 1 }
            } else {
                expert_gating_func = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
            }
        } else if gguf_ends_with(&key, ".expert_weights_norm") && vtype == 7 {
            _ := ensure_hdr(f, $&hdr, pos + 1) >>>
            expert_weights_norm = (hdr[pos] & 255) != 0
            pos += 1
        } else if gguf_ends_with(&key, ".expert_weights_scale") && vtype == 6 {
            _ := ensure_hdr(f, $&hdr, pos + 4) >>>
            ws := f64(from_bits(read_u32_le(&hdr, pos)))
            if ws > 0.0 { expert_weights_scale = ws }
            pos += 4
        } else if gguf_ends_with(&key, ".final_logit_softcapping") && vtype == 6 {
            _ := ensure_hdr(f, $&hdr, pos + 4) >>>
            sc := f64(from_bits(read_u32_le(&hdr, pos)))
            if sc > 0.0 { logit_softcap = sc }
            pos += 4
        } else if gguf_ends_with(&key, ".attention.layer_norm_rms_epsilon") && vtype == 6 {
            _ := ensure_hdr(f, $&hdr, pos + 4) >>>
            rms_eps = f64(from_bits(read_u32_le(&hdr, pos)))
            pos += 4
        } else if key == "general.alignment" {
            alignment = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
            if alignment <= 0 { alignment = 32 }
        } else if key == "tokenizer.ggml.bos_token_id" {
            bos_token_id = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if key == "tokenizer.ggml.eos_token_id" {
            eos_token_id = read_gguf_int(f, $&hdr, vtype, $&pos) >>>
        } else if key == "tokenizer.ggml.model" && vtype == 8 {
            tmod := read_gguf_str(f, $&hdr, $&pos) >>>
            tok_model = tmod + ""
            if tmod == "gpt2" { is_gpt2_tok = true }
        } else if key == "tokenizer.chat_template" && vtype == 8 {
            chat_template = read_gguf_str(f, $&hdr, $&pos) >>>
        } else if key == "tokenizer.ggml.tokens" && vtype == 9 {
            _ := ensure_hdr(f, $&hdr, pos + 12) >>>
            etype := read_u32_le(&hdr, pos)
            cnt := read_u64_le(&hdr, pos + 4)
            pos += 12
            if etype != 8 { >>> errors.new("tokenizer.ggml.tokens not strings") }
            if cnt > 0 { vocab.reserve(cnt) }
            for tidx in 0:cnt {
                tok := read_gguf_str(f, $&hdr, $&pos) >>>
                if vocab_map.get_or(tok, -1) < 0 {
                    vocab_map[tok + ""] = tidx
                }
                vocab.push(tok)
            }
        } else if key == "tokenizer.ggml.merges" && vtype == 9 {
            _ := ensure_hdr(f, $&hdr, pos + 12) >>>
            etype := read_u32_le(&hdr, pos)
            cnt := read_u64_le(&hdr, pos + 4)
            pos += 12
            if etype != 8 { >>> errors.new("tokenizer.ggml.merges not strings") }
            for mrank in 0:cnt {
                mstr := read_gguf_str(f, $&hdr, $&pos) >>>
                if merges.get_or(mstr, -1) < 0 {
                    merges[mstr] = mrank
                }
            }
        } else {
            _ := skip_gguf_val(f, $&hdr, vtype, $&pos) >>>
        }
    }

    if ctx_limit > 0 && max_seq_len > ctx_limit { max_seq_len = ctx_limit }

    if tensor_count > 0 { tensors.reserve(tensor_count) }
    $vocab_size := vocab.len
    for _ in 0:tensor_count {
        tname := read_gguf_str(f, $&hdr, $&pos) >>>
        _ := ensure_hdr(f, $&hdr, pos + 4) >>>
        n_dims := read_u32_le(&hdr, pos)
        pos += 4
        $n_elems := 1
        $last_dim := 0
        for _ in 0:n_dims {
            _ := ensure_hdr(f, $&hdr, pos + 8) >>>
            dv := read_u64_le(&hdr, pos)
            pos += 8
            n_elems = n_elems * dv
            last_dim = dv
        }
        _ := ensure_hdr(f, $&hdr, pos + 12) >>>
        gtype := read_u32_le(&hdr, pos)
        toff := read_u64_le(&hdr, pos + 4)
        pos += 12
        if tname == "token_embd.weight" && last_dim > 0 {
            vocab_size = last_dim
        }
        tensors.push(GgufTensorInfo{name: tname, gtype: gtype, n_elems: n_elems, offset: toff})
    }

    pad := (alignment - (pos % alignment)) % alignment
    data_base := pos + pad
    if n_kv_heads <= 0 { n_kv_heads = n_heads }
    if expert_count > 0 && expert_used_count <= 0 { expert_used_count = 1 }
    if expert_count > 0 && expert_hidden_dim <= 0 { expert_hidden_dim = hidden_dim }
    if hidden_dim <= 0 && expert_hidden_dim > 0 { hidden_dim = expert_hidden_dim }
    if shared_expert_count > 0 && shared_expert_hidden_dim <= 0 {
        shared_expert_hidden_dim = shared_expert_count * expert_hidden_dim
    }
    if dim <= 0 || hidden_dim <= 0 || n_layers <= 0 || n_heads <= 0 || vocab_size <= 0 {
        >>> errors.new("incomplete gguf model metadata")
    }
    $head_dim := dim / n_heads
    $kv_dim := n_kv_heads * head_dim
    $qk_nope_head_dim := 0
    $qk_rope_head_dim := 0
    $v_head_dim := head_dim
    $q_dim := dim
    if kv_lora_rank > 0 {
        qk_rope_head_dim = rope_dim
        if qk_rope_head_dim <= 0 || (qk_rope_head_dim % 2) != 0 { qk_rope_head_dim = 64 }
        $qk_hd := attn_key_len
        if qk_hd <= 0 { qk_hd = head_dim }
        qk_nope_head_dim = qk_hd - qk_rope_head_dim
        if qk_nope_head_dim < 0 { qk_nope_head_dim = 0 }
        v_head_dim = attn_val_len
        if v_head_dim <= 0 { v_head_dim = qk_hd }
        head_dim = qk_hd
        if v_head_dim > head_dim { head_dim = v_head_dim }
        n_kv_heads = n_heads
        kv_dim = n_heads * head_dim
        q_dim = n_heads * qk_hd
        rope_dim = qk_rope_head_dim
    } else {
        if rope_dim <= 0 || rope_dim > head_dim || (rope_dim % 2) != 0 { rope_dim = head_dim }
        qk_rope_head_dim = rope_dim
    }
    if !has_use_geglu && (arch == "gemma" || arch == "gemma2") { use_geglu = true }
    $embed_scale := f32(1.0)
    if arch == "gemma" || arch == "gemma2" { embed_scale = f32(math.sqrt(f64(dim))) }
    cfg_out.dim = dim
    cfg_out.hidden_dim = hidden_dim
    cfg_out.n_layers = n_layers
    cfg_out.n_heads = n_heads
    cfg_out.n_kv_heads = n_kv_heads
    cfg_out.head_dim = head_dim
    cfg_out.kv_dim = kv_dim
    cfg_out.vocab_size = vocab_size
    cfg_out.max_seq_len = max_seq_len
    cfg_out.rope_theta = rope_theta
    cfg_out.rope_freq_scale = rope_freq_scale
    cfg_out.rope_dim = rope_dim
    cfg_out.rope_interleaved = rope_interleaved
    cfg_out.rope_scaling_type = rope_scaling_type
    cfg_out.rope_yarn_orig_ctx = rope_yarn_orig_ctx
    cfg_out.rope_yarn_beta_fast = rope_yarn_beta_fast
    cfg_out.rope_yarn_beta_slow = rope_yarn_beta_slow
    cfg_out.rope_yarn_attn_factor = rope_yarn_attn_factor
    cfg_out.sliding_window = sliding_window
    cfg_out.attn_logit_softcap = attn_logit_softcap
    cfg_out.logit_softcap = logit_softcap
    cfg_out.use_geglu = use_geglu
    cfg_out.expert_count = expert_count
    cfg_out.expert_used_count = expert_used_count
    cfg_out.expert_hidden_dim = expert_hidden_dim
    cfg_out.shared_expert_count = shared_expert_count
    cfg_out.shared_expert_hidden_dim = shared_expert_hidden_dim
    cfg_out.expert_gating_func = expert_gating_func
    cfg_out.expert_weights_norm = expert_weights_norm
    cfg_out.expert_weights_scale = expert_weights_scale
    cfg_out.kv_lora_rank = kv_lora_rank
    cfg_out.q_lora_rank = q_lora_rank
    cfg_out.qk_nope_head_dim = qk_nope_head_dim
    cfg_out.qk_rope_head_dim = qk_rope_head_dim
    cfg_out.v_head_dim = v_head_dim
    cfg_out.q_dim = q_dim
    cfg_out.embed_scale = embed_scale
    cfg_out.rms_eps = rms_eps
    cfg_out.bos_token_id = bos_token_id
    cfg_out.eos_token_id = eos_token_id
    cfg_out.is_gpt2_tok = is_gpt2_tok
    cfg_out.tok_model = tok_model
    cfg_out.arch = arch
    cfg_out.chat_template = chat_template
    << data_base
}

fn load_layer_matrix_at(f &os.File, start int, tname &string, gtype int, n_elems int,
                         rows int, cols int, slice_elems int,
                         is_q4 bool, is_q8 bool, layers_p4 bool,
                         q4_qs $&[]u8, q4_scales $&[]f32,
                         q4_p4k4_qs $&[]u8, q4_p4k4_scales $&[]u16, q4_p4k4_cur $&int,
                         q8_qs $&[]i8, q8_scales $&[]f32,
                         q8_p4k4_qs $&[]i8, q8_p4k4_scales $&[]u16, q8_p4k4_cur $&int,
                         weights $&[]f32, compact $&CompactWeights) int {
    if is_q4 && gtype == GGML_TYPE_Q4_0 {
        if layers_p4 {
            << gguf_stream_q4_0_p4k4_at(f, start, tname, gtype, n_elems, rows, cols, slice_elems, q4_p4k4_qs, q4_p4k4_scales, q4_p4k4_cur) >>>
        }
        << gguf_stream_q4_0_at(f, start, tname, gtype, n_elems, rows, cols, slice_elems, q4_qs, q4_scales) >>>
    }
    if is_q8 && gtype == GGML_TYPE_Q8_0 {
        if layers_p4 {
            << gguf_stream_q8_0_p4k4_at(f, start, tname, gtype, n_elems, rows, cols, slice_elems, q8_p4k4_qs, q8_p4k4_scales, q8_p4k4_cur) >>>
        }
        << gguf_stream_q8_0_at(f, start, tname, gtype, n_elems, rows, cols, slice_elems, q8_qs, q8_scales) >>>
    }
    << gguf_stream_matrix_at(f, start, tname, gtype, n_elems, rows, cols, slice_elems, weights, compact) >>>
}

fn load_layer_matrix(f &os.File, data_base int, info &GgufTensorInfo, rows int, cols int,
                     is_q4 bool, is_q8 bool, layers_p4 bool,
                     q4_qs $&[]u8, q4_scales $&[]f32,
                     q4_p4k4_qs $&[]u8, q4_p4k4_scales $&[]u16, q4_p4k4_cur $&int,
                     q8_qs $&[]i8, q8_scales $&[]f32,
                     q8_p4k4_qs $&[]i8, q8_p4k4_scales $&[]u16, q8_p4k4_cur $&int,
                     weights $&[]f32, compact $&CompactWeights) int {
    start := gguf_tensor_start(data_base, info) >>>
    << load_layer_matrix_at(f, start, &info.name, info.gtype, info.n_elems, rows, cols, rows * cols,
                            is_q4, is_q8, layers_p4, q4_qs, q4_scales, q4_p4k4_qs, q4_p4k4_scales, q4_p4k4_cur,
                            q8_qs, q8_scales, q8_p4k4_qs, q8_p4k4_scales, q8_p4k4_cur, weights, compact) >>>
}

fn gguf_slice_byte_size(gtype int, rows int, cols int) int {
    if gtype == GGML_TYPE_Q4_0 { << checked_size_product(rows, (cols / 32) * 18) >>> }
    if gtype == GGML_TYPE_Q8_0 { << checked_size_product(rows, (cols / 32) * 34) >>> }
    if gtype == GGML_TYPE_Q5_0 { << checked_size_product(rows, (cols / 32) * tensor.Q5_0_BYTES) >>> }
    if gtype == GGML_TYPE_Q4_K { << checked_size_product(rows, (cols / tensor.QK_K) * tensor.Q4_K_BYTES) >>> }
    if gtype == GGML_TYPE_Q5_K { << checked_size_product(rows, (cols / tensor.QK_K) * tensor.Q5_K_BYTES) >>> }
    if gtype == GGML_TYPE_Q6_K { << checked_size_product(rows, (cols / tensor.QK_K) * tensor.Q6_K_BYTES) >>> }
    if gtype == GGML_TYPE_F32 { << checked_size_product(rows * cols, 4) >>> }
    dtype := gguf_dense_dtype(gtype) >>>
    << checked_size_product(rows * cols, dtype.element_bytes()) >>>
}

fn load_layer_matrix_slices(f &os.File, data_base int, info &GgufTensorInfo, count int, rows int, cols int,
                            is_q4 bool, is_q8 bool, layers_p4 bool,
                            q4_qs $&[]u8, q4_scales $&[]f32,
                            q4_p4k4_qs $&[]u8, q4_p4k4_scales $&[]u16, q4_p4k4_cur $&int,
                            q8_qs $&[]i8, q8_scales $&[]f32,
                            q8_p4k4_qs $&[]i8, q8_p4k4_scales $&[]u16, q8_p4k4_cur $&int,
                            weights $&[]f32, compact $&CompactWeights) []int {
    total_elems := count * rows * cols
    base_start := gguf_tensor_start(data_base, info) >>>
    slice_bytes := gguf_slice_byte_size(info.gtype, rows, cols) >>>
    $offs := []int{}
    for e in 0:count {
        off := load_layer_matrix_at(f, base_start + e * slice_bytes, &info.name, info.gtype, info.n_elems,
                                    rows, cols, total_elems, is_q4, is_q8, layers_p4,
                                    q4_qs, q4_scales, q4_p4k4_qs, q4_p4k4_scales, q4_p4k4_cur,
                                    q8_qs, q8_scales, q8_p4k4_qs, q8_p4k4_scales, q8_p4k4_cur,
                                    weights, compact) >>>
        offs.push(off)
    }
    << offs
}

fn count_layer_quant_elems(tensors &[]GgufTensorInfo, l int, cfg &ModelConfig, gtype int) int {
    dim := cfg.dim
    kv_dim := cfg.kv_dim
    hidden_dim := cfg.hidden_dim
    expert_count := cfg.expert_count
    expert_hidden := cfg.expert_hidden_dim
    shared_hidden := cfg.shared_expert_hidden_dim
    p := "blk." + str(l) + "."
    $l_elems := 0
    if cfg.kv_lora_rank > 0 {
        qa_i := find_gguf_tensor(tensors, p + "attn_q_a.weight")
        qb_i := find_gguf_tensor(tensors, p + "attn_q_b.weight")
        q_i := find_gguf_tensor(tensors, p + "attn_q.weight")
        kva_i := find_gguf_tensor(tensors, p + "attn_kv_a_mqa.weight")
        kvb_i := find_gguf_tensor(tensors, p + "attn_kv_b.weight")
        o_i := find_gguf_tensor(tensors, p + "attn_output.weight")
        if qa_i >= 0 && tensors[qa_i].gtype == gtype { l_elems += cfg.q_lora_rank * dim }
        if qb_i >= 0 && tensors[qb_i].gtype == gtype { l_elems += cfg.q_dim * cfg.q_lora_rank }
        if qa_i < 0 && q_i >= 0 && tensors[q_i].gtype == gtype { l_elems += cfg.q_dim * dim }
        if kva_i >= 0 && tensors[kva_i].gtype == gtype { l_elems += (cfg.kv_lora_rank + cfg.qk_rope_head_dim) * dim }
        if kvb_i >= 0 && tensors[kvb_i].gtype == gtype { l_elems += cfg.n_heads * (cfg.qk_nope_head_dim + cfg.v_head_dim) * cfg.kv_lora_rank }
        if o_i >= 0 && tensors[o_i].gtype == gtype { l_elems += dim * cfg.n_heads * cfg.v_head_dim }
    } else {
        q_i := find_gguf_tensor(tensors, p + "attn_q.weight")
        k_i := find_gguf_tensor(tensors, p + "attn_k.weight")
        v_i := find_gguf_tensor(tensors, p + "attn_v.weight")
        o_i := find_gguf_tensor(tensors, p + "attn_output.weight")
        if q_i >= 0 && tensors[q_i].gtype == gtype { l_elems += dim * dim }
        if k_i >= 0 && tensors[k_i].gtype == gtype { l_elems += kv_dim * dim }
        if v_i >= 0 && tensors[v_i].gtype == gtype { l_elems += kv_dim * dim }
        if o_i >= 0 && tensors[o_i].gtype == gtype { l_elems += dim * dim }
    }
    g_i := find_gguf_tensor(tensors, p + "ffn_gate.weight")
    u_i := find_gguf_tensor(tensors, p + "ffn_up.weight")
    d_i := find_gguf_tensor(tensors, p + "ffn_down.weight")
    if g_i >= 0 && tensors[g_i].gtype == gtype { l_elems += hidden_dim * dim }
    if u_i >= 0 && tensors[u_i].gtype == gtype { l_elems += hidden_dim * dim }
    if d_i >= 0 && tensors[d_i].gtype == gtype { l_elems += dim * hidden_dim }
    if expert_count > 0 {
        gx_i := find_gguf_tensor(tensors, p + "ffn_gate_exps.weight")
        ux_i := find_gguf_tensor(tensors, p + "ffn_up_exps.weight")
        dx_i := find_gguf_tensor(tensors, p + "ffn_down_exps.weight")
        if gx_i >= 0 && tensors[gx_i].gtype == gtype { l_elems += expert_count * expert_hidden * dim }
        if ux_i >= 0 && tensors[ux_i].gtype == gtype { l_elems += expert_count * expert_hidden * dim }
        if dx_i >= 0 && tensors[dx_i].gtype == gtype { l_elems += expert_count * dim * expert_hidden }
        if gx_i < 0 {
            for e in 0:expert_count {
                es := str(e)
                ge_i := find_gguf_tensor(tensors, p + "ffn_gate." + es + ".weight")
                ue_i := find_gguf_tensor(tensors, p + "ffn_up." + es + ".weight")
                de_i := find_gguf_tensor(tensors, p + "ffn_down." + es + ".weight")
                if ge_i >= 0 && tensors[ge_i].gtype == gtype { l_elems += expert_hidden * dim }
                if ue_i >= 0 && tensors[ue_i].gtype == gtype { l_elems += expert_hidden * dim }
                if de_i >= 0 && tensors[de_i].gtype == gtype { l_elems += dim * expert_hidden }
            }
        }
        if shared_hidden > 0 {
            sg_i := find_gguf_tensor(tensors, p + "ffn_gate_shexp.weight")
            su_i := find_gguf_tensor(tensors, p + "ffn_up_shexp.weight")
            sd_i := find_gguf_tensor(tensors, p + "ffn_down_shexp.weight")
            if sg_i >= 0 && tensors[sg_i].gtype == gtype { l_elems += shared_hidden * dim }
            if su_i >= 0 && tensors[su_i].gtype == gtype { l_elems += shared_hidden * dim }
            if sd_i >= 0 && tensors[sd_i].gtype == gtype { l_elems += dim * shared_hidden }
        }
    }
    << l_elems
}

fn detect_chat_template_kind(cfg &ModelConfig, vocab_map &map[string]int) int {
    tmpl := cfg.chat_template + ""
    m_llama3 := "<|start_header_id|>"
    m_chatml := "<|im_start|>"
    m_gemma := "<start_of_turn>"
    m_mistral := "[INST]"
    if find_substr(&tmpl, &m_llama3) >= 0 ||
       (vocab_map.get_or("<|start_header_id|>", -1) >= 0 && vocab_map.get_or("<|eot_id|>", -1) >= 0) {
        << TEMPLATE_LLAMA3
    }
    if find_substr(&tmpl, &m_chatml) >= 0 ||
       (vocab_map.get_or("<|im_start|>", -1) >= 0 && vocab_map.get_or("<|im_end|>", -1) >= 0) {
        << TEMPLATE_CHATML
    }
    if find_substr(&tmpl, &m_gemma) >= 0 ||
       (vocab_map.get_or("<start_of_turn>", -1) >= 0 && vocab_map.get_or("<end_of_turn>", -1) >= 0) {
        << TEMPLATE_GEMMA
    }
    if find_substr(&tmpl, &m_mistral) >= 0 ||
       (vocab_map.get_or("[INST]", -1) >= 0 && vocab_map.get_or("[/INST]", -1) >= 0) {
        << TEMPLATE_MISTRAL
    }
    << TEMPLATE_RAW
}

fn push_unique_id(ids $&[]int, tid int) {
    if tid < 0 { << }
    for i in 0:ids.len {
        if ids[i] == tid { << }
    }
    ids.push(tid)
}

fn is_eos_token(m &Model, tok int) bool {
    for i in 0:m.eos_ids.len {
        if m.eos_ids[i] == tok { << true }
    }
    << false
}

fn load_model_gguf_file(f &os.File, ctx_limit int, use_p4 bool) Model {
    $cfg := ModelConfig{
        dim: 0, hidden_dim: 0, n_layers: 0, n_heads: 0, n_kv_heads: 0,
        head_dim: 0, kv_dim: 0, vocab_size: 0, max_seq_len: 0,
        rope_theta: 10000.0, rope_freq_scale: 1.0, rope_dim: 0, rope_interleaved: false,
        rope_scaling_type: "", rope_yarn_orig_ctx: 0, rope_yarn_beta_fast: 32.0, rope_yarn_beta_slow: 1.0, rope_yarn_attn_factor: 0.0,
        sliding_window: 0, attn_logit_softcap: 0.0, logit_softcap: 0.0,
        use_geglu: false, expert_count: 0, expert_used_count: 0, expert_hidden_dim: 0,
        shared_expert_count: 0, shared_expert_hidden_dim: 0, expert_gating_func: 0,
        expert_weights_norm: false, expert_weights_scale: 1.0,
        kv_lora_rank: 0, q_lora_rank: 0, qk_nope_head_dim: 0, qk_rope_head_dim: 0, v_head_dim: 0, q_dim: 0,
        embed_scale: f32(1.0),
        rms_eps: 0.00001, bos_token_id: -1, eos_token_id: 2, is_gpt2_tok: false,
        tok_model: "", arch: "", chat_template: ""
    }
    $vocab := []string{}
    $vocab_map := map[string]int{}
    $bpe_merges := map[string]int{}
    $tensors := []GgufTensorInfo{}
    data_base := load_model_gguf_header(f, ctx_limit, $&cfg, $&vocab, $&vocab_map, $&bpe_merges, $&tensors) >>>

    dim := cfg.dim
    hidden_dim := cfg.hidden_dim
    n_layers := cfg.n_layers
    head_dim := cfg.head_dim
    kv_dim := cfg.kv_dim
    vocab_size := cfg.vocab_size

    emb_idx := find_gguf_tensor(&tensors, "token_embd.weight")
    if emb_idx < 0 { >>> errors.new("missing token_embd.weight") }
    is_mla := cfg.kv_lora_rank > 0 && find_gguf_tensor(&tensors, "blk.0.attn_kv_a_mqa.weight") >= 0
    $q0_idx := find_gguf_tensor(&tensors, "blk.0.attn_q.weight")
    if q0_idx < 0 && is_mla { q0_idx = find_gguf_tensor(&tensors, "blk.0.attn_q_a.weight") }
    if q0_idx < 0 && is_mla { q0_idx = find_gguf_tensor(&tensors, "blk.0.attn_kv_a_mqa.weight") }
    if q0_idx < 0 { >>> errors.new("missing blk.0.attn_q.weight") }
    out_i := find_gguf_tensor(&tensors, "output.weight")

    is_q4 := tensors[q0_idx].gtype == GGML_TYPE_Q4_0
    is_q8 := tensors[q0_idx].gtype == GGML_TYPE_Q8_0
    embed_q4 := tensors[emb_idx].gtype == GGML_TYPE_Q4_0
    exp_count := cfg.expert_count
    exp_hidden := cfg.expert_hidden_dim
    sh_hidden := cfg.shared_expert_hidden_dim
    $layers_p4 := use_p4 && (is_q4 || is_q8) && (dim % 4 == 0) && (kv_dim % 4 == 0) && (hidden_dim % 4 == 0)
    if exp_count > 0 {
        layers_p4 = layers_p4 && (exp_hidden % 4 == 0) && (sh_hidden <= 0 || sh_hidden % 4 == 0)
    }
    if is_mla {
        layers_p4 = layers_p4 && (cfg.q_dim % 4 == 0) && ((cfg.n_heads * cfg.v_head_dim) % 4 == 0) &&
                    ((cfg.kv_lora_rank + cfg.qk_rope_head_dim) % 4 == 0) &&
                    ((cfg.n_heads * (cfg.qk_nope_head_dim + cfg.v_head_dim)) % 4 == 0) &&
                    (cfg.q_lora_rank == 0 || cfg.q_lora_rank % 4 == 0)
    }
    $embed_p4 := false
    $lm_head_q4 := embed_q4
    $lm_head_q8 := false
    $lm_head_p4 := false
    if out_i >= 0 {
        lm_head_q4 = tensors[out_i].gtype == GGML_TYPE_Q4_0
        lm_head_q8 = tensors[out_i].gtype == GGML_TYPE_Q8_0
        lm_head_p4 = use_p4 && (vocab_size % 4 == 0) && (lm_head_q4 || lm_head_q8)
    } else {
        embed_p4 = use_p4 && embed_q4 && (vocab_size % 4 == 0)
        lm_head_p4 = embed_p4
    }

    $need_q4_blks := 0
    $need_q8_blks := 0
    $need_p4k4_q4_gbs := 0
    $need_p4k4_q8_gbs := 0

    emb_elems := vocab_size * dim
    if embed_q4 {
        if embed_p4 { need_p4k4_q4_gbs += emb_elems / 128 }
        else { need_q4_blks += emb_elems / 32 }
    }
    if is_q4 {
        for l in 0:n_layers {
            l_elems := count_layer_quant_elems(&tensors, l, &cfg, GGML_TYPE_Q4_0)
            if layers_p4 { need_p4k4_q4_gbs += l_elems / 128 }
            else { need_q4_blks += l_elems / 32 }
        }
    }
    if is_q8 {
        for l in 0:n_layers {
            l_elems := count_layer_quant_elems(&tensors, l, &cfg, GGML_TYPE_Q8_0)
            if layers_p4 { need_p4k4_q8_gbs += l_elems / 128 }
            else { need_q8_blks += l_elems / 32 }
        }
    }
    if out_i >= 0 {
        out_elems := vocab_size * dim
        if lm_head_q4 {
            if lm_head_p4 { need_p4k4_q4_gbs += out_elems / 128 }
            else { need_q4_blks += out_elems / 32 }
        } else if lm_head_q8 {
            if lm_head_p4 { need_p4k4_q8_gbs += out_elems / 128 }
            else { need_q8_blks += out_elems / 32 }
        }
    }

    $q4_qs := []u8{}
    $q4_scales := []f32{}
    $q8_qs := []i8{}
    $q8_scales := []f32{}
    $q4_p4k4_qs := []u8{}
    $q4_p4k4_scales := []u16{}
    $q8_p4k4_qs := []i8{}
    $q8_p4k4_scales := []u16{}
    $weights := []f32{}
    $compact := empty_compact_weights()
    $q4_p4k4_cur := 0
    $q8_p4k4_cur := 0

    if need_q4_blks > 0 {
        q4_qs.reserve(need_q4_blks * 16)
        q4_scales.reserve(need_q4_blks)
    }
    if need_q8_blks > 0 {
        q8_qs.reserve(need_q8_blks * 32)
        q8_scales.reserve(need_q8_blks)
    }
    if need_p4k4_q4_gbs > 0 {
        q4_p4k4_qs.resize_zero(need_p4k4_q4_gbs * 64)
        q4_p4k4_scales.resize_zero(need_p4k4_q4_gbs * 4)
    }
    if need_p4k4_q8_gbs > 0 {
        q8_p4k4_qs.resize_zero(need_p4k4_q8_gbs * 128)
        q8_p4k4_scales.resize_zero(need_p4k4_q8_gbs * 4)
    }

    $embed_off := 0
    if embed_p4 {
        embed_off = gguf_stream_q4_0_p4k4(f, data_base, &tensors[emb_idx], vocab_size, dim, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur) >>>
    } else if embed_q4 {
        embed_off = gguf_stream_q4_0(f, data_base, &tensors[emb_idx], vocab_size, dim, $&q4_qs, $&q4_scales) >>>
    } else {
        embed_off = gguf_stream_matrix(f, data_base, &tensors[emb_idx], vocab_size, dim, $&weights, $&compact) >>>
    }

    $wq_off := []int{}
    $wk_off := []int{}
    $wv_off := []int{}
    $wo_off := []int{}
    $w1_off := []int{}
    $w2_off := []int{}
    $w3_off := []int{}
    $mla_has_qlora := []bool{}
    $mla_qa_off := []int{}
    $mla_qa_norm := [][]f32{}
    $mla_qb_off := []int{}
    $mla_kva_off := []int{}
    $mla_kva_norm := [][]f32{}
    $mla_kvb_off := []int{}
    $is_moe := exp_count > 0
    $moe_layer := []bool{}
    $moe_gate_inp_off := []int{}
    $moe_exp_probs_bias := [][]f32{}
    $moe_w1_off := [][]int{}
    $moe_w2_off := [][]int{}
    $moe_w3_off := [][]int{}
    $moe_has_shared := []bool{}
    $moe_sh_w1_off := []int{}
    $moe_sh_w2_off := []int{}
    $moe_sh_w3_off := []int{}
    $moe_has_sh_gate := []bool{}
    $moe_sh_gate_inp_off := []int{}
    $bq := [][]f32{}
    $bk := [][]f32{}
    $bv := [][]f32{}
    $q_norms := [][]f32{}
    $k_norms := [][]f32{}
    $post_attn_norms := [][]f32{}
    $post_ffn_norms := [][]f32{}
    $attn_norms := [][]f32{}
    $ffn_norms := [][]f32{}
    $has_qkv_bias := false
    $has_qk_norm := false
    $has_post_norms := false

    for l in 0:n_layers {
        prefix := "blk." + str(l) + "."
        an_i := find_gguf_tensor(&tensors, prefix + "attn_norm.weight")
        fn_i := find_gguf_tensor(&tensors, prefix + "ffn_norm.weight")
        wq_i := find_gguf_tensor(&tensors, prefix + "attn_q.weight")
        wk_i := find_gguf_tensor(&tensors, prefix + "attn_k.weight")
        wv_i := find_gguf_tensor(&tensors, prefix + "attn_v.weight")
        wo_i := find_gguf_tensor(&tensors, prefix + "attn_output.weight")
        qa_i := find_gguf_tensor(&tensors, prefix + "attn_q_a.weight")
        qan_i := find_gguf_tensor(&tensors, prefix + "attn_q_a_norm.weight")
        qb_i := find_gguf_tensor(&tensors, prefix + "attn_q_b.weight")
        kva_i := find_gguf_tensor(&tensors, prefix + "attn_kv_a_mqa.weight")
        kvan_i := find_gguf_tensor(&tensors, prefix + "attn_kv_a_norm.weight")
        kvb_i := find_gguf_tensor(&tensors, prefix + "attn_kv_b.weight")
        w1_i := find_gguf_tensor(&tensors, prefix + "ffn_gate.weight")
        w3_i := find_gguf_tensor(&tensors, prefix + "ffn_up.weight")
        w2_i := find_gguf_tensor(&tensors, prefix + "ffn_down.weight")
        gi_i := find_gguf_tensor(&tensors, prefix + "ffn_gate_inp.weight")
        layer_moe := exp_count > 0 && gi_i >= 0
        if an_i < 0 || fn_i < 0 || wo_i < 0 {
            >>> errors.new("missing gguf norm/output tensor in layer " + str(l))
        }
        if is_mla {
            if kva_i < 0 || kvan_i < 0 || kvb_i < 0 || (wq_i < 0 && (qa_i < 0 || qan_i < 0 || qb_i < 0)) {
                >>> errors.new("missing gguf MLA attention tensor in layer " + str(l))
            }
        } else if wq_i < 0 || wk_i < 0 || wv_i < 0 {
            >>> errors.new("missing gguf attention tensor in layer " + str(l))
        }
        if !layer_moe && (w1_i < 0 || w3_i < 0 || w2_i < 0) {
            >>> errors.new("missing gguf ffn tensor in layer " + str(l))
        }
        an := gguf_stream_f32_slice(f, data_base, &tensors[an_i], dim) >>>
        attn_norms.push(an)
        fnm := gguf_stream_f32_slice(f, data_base, &tensors[fn_i], dim) >>>
        ffn_norms.push(fnm)

        bq_i := find_gguf_tensor(&tensors, prefix + "attn_q.bias")
        bk_i := find_gguf_tensor(&tensors, prefix + "attn_k.bias")
        bv_i := find_gguf_tensor(&tensors, prefix + "attn_v.bias")
        if bq_i >= 0 && bk_i >= 0 && bv_i >= 0 {
            has_qkv_bias = true
            qbv := gguf_stream_f32_slice(f, data_base, &tensors[bq_i], dim) >>>
            kbv := gguf_stream_f32_slice(f, data_base, &tensors[bk_i], kv_dim) >>>
            vbv := gguf_stream_f32_slice(f, data_base, &tensors[bv_i], kv_dim) >>>
            bq.push(qbv)
            bk.push(kbv)
            bv.push(vbv)
        } else if has_qkv_bias {
            bq.push(alloc_zeros(dim))
            bk.push(alloc_zeros(kv_dim))
            bv.push(alloc_zeros(kv_dim))
        }

        qn_i := find_gguf_tensor(&tensors, prefix + "attn_q_norm.weight")
        kn_i := find_gguf_tensor(&tensors, prefix + "attn_k_norm.weight")
        if qn_i >= 0 && kn_i >= 0 {
            if !has_qk_norm {
                has_qk_norm = true
                for _ in 0:l {
                    $ones := []f32{}
                    for _ in 0:head_dim { ones.push(f32(1.0)) }
                    q_norms.push(~ones)
                    $ones_k := []f32{}
                    for _ in 0:head_dim { ones_k.push(f32(1.0)) }
                    k_norms.push(~ones_k)
                }
            }
            qnv := gguf_stream_f32_slice(f, data_base, &tensors[qn_i], head_dim) >>>
            knv := gguf_stream_f32_slice(f, data_base, &tensors[kn_i], head_dim) >>>
            q_norms.push(qnv)
            k_norms.push(knv)
        } else if has_qk_norm {
            $ones := []f32{}
            for _ in 0:head_dim { ones.push(f32(1.0)) }
            q_norms.push(~ones)
            $ones_k := []f32{}
            for _ in 0:head_dim { ones_k.push(f32(1.0)) }
            k_norms.push(~ones_k)
        }

        pan_i := find_gguf_tensor(&tensors, prefix + "post_attention_norm.weight")
        $pfn_i := find_gguf_tensor(&tensors, prefix + "ffn_post_norm.weight")
        if pfn_i < 0 { pfn_i = find_gguf_tensor(&tensors, prefix + "post_ffw_norm.weight") }
        if pan_i >= 0 || pfn_i >= 0 {
            if !has_post_norms {
                has_post_norms = true
                for _ in 0:l {
                    $o1 := []f32{}
                    for _ in 0:dim { o1.push(f32(1.0)) }
                    post_attn_norms.push(~o1)
                    $o2 := []f32{}
                    for _ in 0:dim { o2.push(f32(1.0)) }
                    post_ffn_norms.push(~o2)
                }
            }
            if pan_i >= 0 {
                post_attn_norms.push(gguf_stream_f32_slice(f, data_base, &tensors[pan_i], dim) >>>)
            } else {
                $o1 := []f32{}
                for _ in 0:dim { o1.push(f32(1.0)) }
                post_attn_norms.push(~o1)
            }
            if pfn_i >= 0 {
                post_ffn_norms.push(gguf_stream_f32_slice(f, data_base, &tensors[pfn_i], dim) >>>)
            } else {
                $o2 := []f32{}
                for _ in 0:dim { o2.push(f32(1.0)) }
                post_ffn_norms.push(~o2)
            }
        } else if has_post_norms {
            $o1 := []f32{}
            for _ in 0:dim { o1.push(f32(1.0)) }
            post_attn_norms.push(~o1)
            $o2 := []f32{}
            for _ in 0:dim { o2.push(f32(1.0)) }
            post_ffn_norms.push(~o2)
        }

        if is_mla {
            if qa_i >= 0 {
                mla_has_qlora.push(true)
                mla_qa_off.push(load_layer_matrix(f, data_base, &tensors[qa_i], cfg.q_lora_rank, dim, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
                mla_qa_norm.push(gguf_stream_f32_slice(f, data_base, &tensors[qan_i], cfg.q_lora_rank) >>>)
                mla_qb_off.push(load_layer_matrix(f, data_base, &tensors[qb_i], cfg.q_dim, cfg.q_lora_rank, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
                wq_off.push(0)
            } else {
                mla_has_qlora.push(false)
                mla_qa_off.push(0)
                mla_qa_norm.push([]f32{})
                mla_qb_off.push(0)
                wq_off.push(load_layer_matrix(f, data_base, &tensors[wq_i], cfg.q_dim, dim, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
            }
            mla_kva_off.push(load_layer_matrix(f, data_base, &tensors[kva_i], cfg.kv_lora_rank + cfg.qk_rope_head_dim, dim, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
            mla_kva_norm.push(gguf_stream_f32_slice(f, data_base, &tensors[kvan_i], cfg.kv_lora_rank) >>>)
            mla_kvb_off.push(load_layer_matrix(f, data_base, &tensors[kvb_i], cfg.n_heads * (cfg.qk_nope_head_dim + cfg.v_head_dim), cfg.kv_lora_rank, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
            wk_off.push(0)
            wv_off.push(0)
            wo_off.push(load_layer_matrix(f, data_base, &tensors[wo_i], dim, cfg.n_heads * cfg.v_head_dim, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
        } else {
            wq_off.push(load_layer_matrix(f, data_base, &tensors[wq_i], dim, dim, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
            wk_off.push(load_layer_matrix(f, data_base, &tensors[wk_i], kv_dim, dim, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
            wv_off.push(load_layer_matrix(f, data_base, &tensors[wv_i], kv_dim, dim, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
            wo_off.push(load_layer_matrix(f, data_base, &tensors[wo_i], dim, dim, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
        }
        if layer_moe {
            w1_off.push(0)
            w3_off.push(0)
            w2_off.push(0)
            moe_layer.push(true)
            moe_gate_inp_off.push(gguf_stream_matrix(f, data_base, &tensors[gi_i], exp_count, dim, $&weights, $&compact) >>>)
            $epb_i := find_gguf_tensor(&tensors, prefix + "ffn_exp_probs_b.bias")
            if epb_i < 0 { epb_i = find_gguf_tensor(&tensors, prefix + "ffn_exp_probs_b") }
            if epb_i >= 0 {
                moe_exp_probs_bias.push(gguf_stream_f32_slice(f, data_base, &tensors[epb_i], exp_count) >>>)
            } else {
                moe_exp_probs_bias.push([]f32{})
            }
            gx_i := find_gguf_tensor(&tensors, prefix + "ffn_gate_exps.weight")
            ux_i := find_gguf_tensor(&tensors, prefix + "ffn_up_exps.weight")
            dx_i := find_gguf_tensor(&tensors, prefix + "ffn_down_exps.weight")
            if gx_i >= 0 && ux_i >= 0 && dx_i >= 0 {
                moe_w1_off.push(load_layer_matrix_slices(f, data_base, &tensors[gx_i], exp_count, exp_hidden, dim, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
                moe_w3_off.push(load_layer_matrix_slices(f, data_base, &tensors[ux_i], exp_count, exp_hidden, dim, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
                moe_w2_off.push(load_layer_matrix_slices(f, data_base, &tensors[dx_i], exp_count, dim, exp_hidden, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
            } else {
                $ew1 := []int{}
                $ew3 := []int{}
                $ew2 := []int{}
                for e in 0:exp_count {
                    es := str(e)
                    ge_i := find_gguf_tensor(&tensors, prefix + "ffn_gate." + es + ".weight")
                    ue_i := find_gguf_tensor(&tensors, prefix + "ffn_up." + es + ".weight")
                    de_i := find_gguf_tensor(&tensors, prefix + "ffn_down." + es + ".weight")
                    if ge_i < 0 || ue_i < 0 || de_i < 0 {
                        >>> errors.new("missing gguf expert tensor in layer " + str(l) + " expert " + es)
                    }
                    ew1.push(load_layer_matrix(f, data_base, &tensors[ge_i], exp_hidden, dim, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
                    ew3.push(load_layer_matrix(f, data_base, &tensors[ue_i], exp_hidden, dim, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
                    ew2.push(load_layer_matrix(f, data_base, &tensors[de_i], dim, exp_hidden, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
                }
                moe_w1_off.push(~ew1)
                moe_w3_off.push(~ew3)
                moe_w2_off.push(~ew2)
            }
            sg_i := find_gguf_tensor(&tensors, prefix + "ffn_gate_shexp.weight")
            su_i := find_gguf_tensor(&tensors, prefix + "ffn_up_shexp.weight")
            sd_i := find_gguf_tensor(&tensors, prefix + "ffn_down_shexp.weight")
            if sh_hidden > 0 && sg_i >= 0 && su_i >= 0 && sd_i >= 0 {
                moe_has_shared.push(true)
                moe_sh_w1_off.push(load_layer_matrix(f, data_base, &tensors[sg_i], sh_hidden, dim, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
                moe_sh_w3_off.push(load_layer_matrix(f, data_base, &tensors[su_i], sh_hidden, dim, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
                moe_sh_w2_off.push(load_layer_matrix(f, data_base, &tensors[sd_i], dim, sh_hidden, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
                sgi_i := find_gguf_tensor(&tensors, prefix + "ffn_gate_inp_shexp.weight")
                if sgi_i >= 0 {
                    moe_has_sh_gate.push(true)
                    moe_sh_gate_inp_off.push(gguf_stream_matrix(f, data_base, &tensors[sgi_i], 1, dim, $&weights, $&compact) >>>)
                } else {
                    moe_has_sh_gate.push(false)
                    moe_sh_gate_inp_off.push(0)
                }
            } else {
                moe_has_shared.push(false)
                moe_sh_w1_off.push(0)
                moe_sh_w2_off.push(0)
                moe_sh_w3_off.push(0)
                moe_has_sh_gate.push(false)
                moe_sh_gate_inp_off.push(0)
            }
        } else {
            w1_off.push(load_layer_matrix(f, data_base, &tensors[w1_i], hidden_dim, dim, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
            w3_off.push(load_layer_matrix(f, data_base, &tensors[w3_i], hidden_dim, dim, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
            w2_off.push(load_layer_matrix(f, data_base, &tensors[w2_i], dim, hidden_dim, is_q4, is_q8, layers_p4, $&q4_qs, $&q4_scales, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur, $&q8_qs, $&q8_scales, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur, $&weights, $&compact) >>>)
            if is_moe {
                moe_layer.push(false)
                moe_gate_inp_off.push(0)
                moe_exp_probs_bias.push([]f32{})
                moe_w1_off.push([]int{})
                moe_w2_off.push([]int{})
                moe_w3_off.push([]int{})
                moe_has_shared.push(false)
                moe_sh_w1_off.push(0)
                moe_sh_w2_off.push(0)
                moe_sh_w3_off.push(0)
                moe_has_sh_gate.push(false)
                moe_sh_gate_inp_off.push(0)
            }
        }
    }

    onorm_i := find_gguf_tensor(&tensors, "output_norm.weight")
    if onorm_i < 0 { >>> errors.new("missing output_norm.weight") }
    final_norm := gguf_stream_f32_slice(f, data_base, &tensors[onorm_i], dim) >>>

    $lm_head_off := embed_off
    if out_i >= 0 {
        if lm_head_q4 {
            if lm_head_p4 {
                lm_head_off = gguf_stream_q4_0_p4k4(f, data_base, &tensors[out_i], vocab_size, dim, $&q4_p4k4_qs, $&q4_p4k4_scales, $&q4_p4k4_cur) >>>
            } else {
                lm_head_off = gguf_stream_q4_0(f, data_base, &tensors[out_i], vocab_size, dim, $&q4_qs, $&q4_scales) >>>
            }
        } else if lm_head_q8 {
            if lm_head_p4 {
                lm_head_off = gguf_stream_q8_0_p4k4(f, data_base, &tensors[out_i], vocab_size, dim, $&q8_p4k4_qs, $&q8_p4k4_scales, $&q8_p4k4_cur) >>>
            } else {
                lm_head_off = gguf_stream_q8_0(f, data_base, &tensors[out_i], vocab_size, dim, $&q8_qs, $&q8_scales) >>>
            }
        } else {
            lm_head_off = gguf_stream_matrix(f, data_base, &tensors[out_i], vocab_size, dim, $&weights, $&compact) >>>
        }
    }

    $rope_cos := []f32{}
    $rope_sin := []f32{}
    build_rope_tables(cfg.rope_dim, cfg.max_seq_len, cfg.rope_theta, cfg.rope_freq_scale, cfg.rope_scaling_type, cfg.rope_yarn_orig_ctx, cfg.rope_yarn_beta_fast, cfg.rope_yarn_beta_slow, cfg.rope_yarn_attn_factor, $&rope_cos, $&rope_sin)

    $eos_ids := []int{}
    push_unique_id($&eos_ids, cfg.eos_token_id)
    push_unique_id($&eos_ids, vocab_map.get_or("<|im_end|>", -1))
    push_unique_id($&eos_ids, vocab_map.get_or("<|eot_id|>", -1))
    push_unique_id($&eos_ids, vocab_map.get_or("<end_of_turn>", -1))
    tmpl_kind := detect_chat_template_kind(&cfg, &vocab_map)
    lora_nl := cfg.n_layers

    << Model{
        cfg: cfg, is_q4: is_q4, is_q8: is_q8, embed_q4: embed_q4, lm_head_q4: lm_head_q4, lm_head_q8: lm_head_q8,
        layers_p4: layers_p4, embed_p4: embed_p4, lm_head_p4: lm_head_p4,
        has_qkv_bias: has_qkv_bias, has_qk_norm: has_qk_norm, has_post_norms: has_post_norms,
        is_moe: is_moe, is_mla: is_mla, use_q8k_act: false, lora: empty_lora_state(lora_nl),
        chat_template_kind: tmpl_kind, eos_ids: eos_ids,
        weights: weights, compact_weights: compact,
        q4_qs: q4_qs, q4_scales: q4_scales, q8_qs: q8_qs, q8_scales: q8_scales,
        q4_p4k4_qs: q4_p4k4_qs, q4_p4k4_scales: q4_p4k4_scales, q8_p4k4_qs: q8_p4k4_qs, q8_p4k4_scales: q8_p4k4_scales,
        embed_off: embed_off, lm_head_off: lm_head_off,
        wq_off: wq_off, wk_off: wk_off, wv_off: wv_off, wo_off: wo_off,
        w1_off: w1_off, w2_off: w2_off, w3_off: w3_off,
        mla_has_qlora: mla_has_qlora, mla_qa_off: mla_qa_off, mla_qa_norm: mla_qa_norm,
        mla_qb_off: mla_qb_off, mla_kva_off: mla_kva_off, mla_kva_norm: mla_kva_norm, mla_kvb_off: mla_kvb_off,
        moe_layer: moe_layer,
        moe_gate_inp_off: moe_gate_inp_off, moe_exp_probs_bias: moe_exp_probs_bias,
        moe_w1_off: moe_w1_off, moe_w2_off: moe_w2_off, moe_w3_off: moe_w3_off,
        moe_has_shared: moe_has_shared, moe_sh_w1_off: moe_sh_w1_off,
        moe_sh_w2_off: moe_sh_w2_off, moe_sh_w3_off: moe_sh_w3_off,
        moe_has_sh_gate: moe_has_sh_gate,
        moe_sh_gate_inp_off: moe_sh_gate_inp_off,
        bq: bq, bk: bk, bv: bv, q_norms: q_norms, k_norms: k_norms,
        post_attn_norms: post_attn_norms, post_ffn_norms: post_ffn_norms,
        attn_norms: attn_norms, ffn_norms: ffn_norms, final_norm: final_norm,
        zeros: alloc_zeros(dim), rope_cos: rope_cos, rope_sin: rope_sin,
        vocab: vocab, vocab_map: vocab_map, bpe_merges: bpe_merges
    }
}

struct HfShard {
    path string
    data string
    base int
    doc json.Doc
    root int
}

fn try_read_file(path string) string {
    << os.read(path) >>> (_) { << "" }
}

fn hf_int_or(doc &json.Doc, obj int, key string, def int) int {
    if obj < 0 || !doc.is_dict(obj) || !doc.has(obj, key) { << def }
    n := doc.get(obj, key) >>> (_) { << def }
    if doc.is_number(n) { << doc.as_int(n) >>> (_) { << def } }
    << def
}

fn hf_f64_or(doc &json.Doc, obj int, key string, def f64) f64 {
    if obj < 0 || !doc.is_dict(obj) || !doc.has(obj, key) { << def }
    n := doc.get(obj, key) >>> (_) { << def }
    if doc.is_number(n) { << doc.as_f64(n) >>> (_) { << def } }
    << def
}

fn hf_str_or(doc &json.Doc, obj int, key string, def string) string {
    if obj < 0 || !doc.is_dict(obj) || !doc.has(obj, key) { << def }
    n := doc.get(obj, key) >>> (_) { << def }
    if doc.is_string(n) { << doc.as_string(n) >>> (_) { << def } }
    << def
}

fn hf_bool_or(doc &json.Doc, obj int, key string, def bool) bool {
    if obj < 0 || !doc.is_dict(obj) || !doc.has(obj, key) { << def }
    n := doc.get(obj, key) >>> (_) { << def }
    if doc.is_bool(n) { << doc.as_bool(n) >>> (_) { << def } }
    << def
}

fn open_hf_shard(path &string) HfShard {
    data := os.read((*path) + "") >>>
    if data.len < 8 { >>> errors.new("truncated safetensors shard: " + (*path)) }
    hlen := read_u64_le(&data, 0)
    if hlen <= 0 || hlen > data.len - 8 { >>> errors.new("invalid safetensors shard header: " + (*path)) }
    hstr := data[8:8 + hlen]
    doc := json.parse(&hstr)
    if !doc.ok() || !doc.is_dict(doc.root()) { >>> errors.new("invalid safetensors JSON: " + (*path)) }
    root := doc.root()
    << HfShard{path: (*path) + "", data: ~data, base: 8 + hlen, doc: ~doc, root: root}
}

fn hf_ensure_shard_loaded(dir &string, shard_name &string,
                          shards $&[]HfShard, file_to_idx $&map[string]int) int {
    existing := file_to_idx.get_or(*shard_name, -1)
    if existing >= 0 { << existing }
    full_path := (*dir) + "/" + (*shard_name)
    sh := open_hf_shard(&full_path) >>>
    idx := shards.len
    shards.push(~sh)
    file_to_idx[(*shard_name) + ""] = idx
    << idx
}

fn hf_find_tensor(dir &string, has_index bool, weight_map &map[string]string,
                  shards $&[]HfShard, file_to_idx $&map[string]int,
                  cands &[]string, resolved_name $&string) int {
    for ci in 0:cands.len {
        cname := &cands[ci]
        if has_index {
            sf := weight_map.get_or(*cname, "")
            if sf.len > 0 {
                si := hf_ensure_shard_loaded(dir, &sf, shards, file_to_idx) >>> (_) { << -1 }
                if si >= 0 {
                    *resolved_name = (*cname) + ""
                    << si
                }
            }
        } else {
            for si in 0:shards.len {
                if shards[si].doc.has(shards[si].root, *cname) {
                    *resolved_name = (*cname) + ""
                    << si
                }
            }
        }
    }
    << -1
}

fn hf_find_required_tensor(dir &string, has_index bool, weight_map &map[string]string,
                           shards $&[]HfShard, file_to_idx $&map[string]int,
                           cands &[]string, resolved_name $&string) int {
    si := hf_find_tensor(dir, has_index, weight_map, shards, file_to_idx, cands, resolved_name)
    if si < 0 {
        $label := "unknown"
        if cands.len > 0 { label = cands[0] }
        >>> errors.new("missing HF safetensors tensor: " + label)
    }
    << si
}

fn hf_load_1d(shards &[]HfShard, si int, name &string, expected_len int) []f32 {
    << load_tensor_slice(&shards[si].data, shards[si].base, &shards[si].doc, shards[si].root, (*name) + "", expected_len) >>>
}

fn hf_load_2d(shards &[]HfShard, si int, name &string, rows int, cols int,
              weights $&[]f32, compact $&CompactWeights) int {
    << append_tensor(&shards[si].data, shards[si].base, &shards[si].doc, shards[si].root, (*name) + "", rows, cols, weights, compact) >>>
}

fn load_hf_tokenizer(dir &string, vocab_cap int, vocab $&[]string,
                     vocab_map $&map[string]int, merges $&map[string]int,
                     is_gpt2_tok $&bool, cfg $&ModelConfig, eos_ids $&[]int) {
    tc_raw := try_read_file((*dir) + "/tokenizer_config.json")
    if tc_raw.len > 0 {
        tcdoc := json.parse(&tc_raw)
        if tcdoc.ok() && tcdoc.is_dict(tcdoc.root()) {
            tcr := tcdoc.root()
            ct := hf_str_or(&tcdoc, tcr, "chat_template", "")
            if ct.len > 0 { cfg.chat_template = ct }
        }
    }
    tok_raw := try_read_file((*dir) + "/tokenizer.json")
    if tok_raw.len == 0 { << }
    doc := json.parse(&tok_raw)
    if !doc.ok() || !doc.is_dict(doc.root()) { << }
    root := doc.root()
    $entries_p := []string{}
    $entries_id := []int{}
    $max_id := vocab_cap - 1

    if doc.has(root, "model") {
        mn := doc.get(root, "model") >>> (_) { << }
        if doc.is_dict(mn) && doc.has(mn, "vocab") {
            vn := doc.get(mn, "vocab") >>> (_) { << }
            if doc.is_dict(vn) {
                vkeys := doc.dict_keys(vn)
                for ki in 0:vkeys.len {
                    k := vkeys[ki]
                    tid := hf_int_or(&doc, vn, k + "", -1)
                    if tid >= 0 {
                        entries_p.push(k + "")
                        entries_id.push(tid)
                        if tid > max_id { max_id = tid }
                    }
                }
            }
        }
        if doc.is_dict(mn) && doc.has(mn, "merges") {
            mg := doc.get(mn, "merges") >>> (_) { << }
            if doc.is_list(mg) {
                mc := doc.count(mg)
                for mi in 0:mc {
                    item := doc.at(mg, mi) >>> (_) { -> }
                    $mstr := ""
                    if doc.is_string(item) {
                        mstr = doc.as_string(item) >>> (_) { -> }
                    } else if doc.is_list(item) && doc.count(item) == 2 {
                        p0n := doc.at(item, 0) >>> (_) { -> }
                        p1n := doc.at(item, 1) >>> (_) { -> }
                        if doc.is_string(p0n) && doc.is_string(p1n) {
                            a := doc.as_string(p0n) >>> (_) { -> }
                            b := doc.as_string(p1n) >>> (_) { -> }
                            mstr = a + " " + b
                        }
                    }
                    if mstr.len > 0 && merges.get_or(mstr, -1) < 0 {
                        merges[mstr] = mi
                    }
                }
            }
        }
    }
    if doc.has(root, "added_tokens") {
        at := doc.get(root, "added_tokens") >>> (_) { << }
        if doc.is_list(at) {
            ac := doc.count(at)
            for ai in 0:ac {
                item := doc.at(at, ai) >>> (_) { -> }
                if !doc.is_dict(item) { -> }
                tid := hf_int_or(&doc, item, "id", -1)
                cstr := hf_str_or(&doc, item, "content", "")
                if tid >= 0 && cstr.len > 0 {
                    entries_p.push(cstr)
                    entries_id.push(tid)
                    if tid > max_id { max_id = tid }
                }
            }
        }
    }
    need_len := max_id + 1
    if need_len > 0 {
        vocab.reserve(need_len)
        for _ in 0:need_len { vocab.push("") }
        for ei in 0:entries_p.len {
            tid := entries_id[ei]
            piece := &entries_p[ei]
            if tid >= 0 && tid < need_len {
                vocab[tid] = (*piece) + ""
                if vocab_map.get_or(*piece, -1) < 0 {
                    vocab_map[(*piece) + ""] = tid
                }
                if piece.len >= 2 && (piece[0] & 255) == 196 && (piece[1] & 255) == 160 {
                    *is_gpt2_tok = true
                }
            }
        }
    }
    _ := eos_ids
}

fn hf_parse_eos_ids(cdoc &json.Doc, cr int, eos_id $&int, eos_ids $&[]int) {
    if !cdoc.has(cr, "eos_token_id") { << }
    en := cdoc.get(cr, "eos_token_id") >>> (_) { << }
    if cdoc.is_number(en) {
        ev := cdoc.as_int(en) >>> (_) { << }
        *eos_id = ev
        push_unique_id(eos_ids, ev)
    } else if cdoc.is_list(en) {
        for ei in 0:cdoc.count(en) {
            it := cdoc.at(en, ei) >>> (_) { -> }
            if cdoc.is_number(it) {
                ev := cdoc.as_int(it) >>> (_) { -> }
                if ei == 0 { *eos_id = ev }
                push_unique_id(eos_ids, ev)
            }
        }
    }
}

fn hf_parse_rope_scaling(cdoc &json.Doc, cr int, rope_st $&string, rope_scale $&f64,
                         rope_orig $&int, rope_bf $&f64, rope_bs $&f64, rope_af $&f64) {
    if !cdoc.has(cr, "rope_scaling") { << }
    rs := cdoc.get(cr, "rope_scaling") >>> (_) { << }
    if !cdoc.is_dict(rs) { << }
    $rt := hf_str_or(cdoc, rs, "rope_type", "")
    if rt.len == 0 { rt = hf_str_or(cdoc, rs, "type", "") }
    *rope_st = rt
    *rope_scale = hf_f64_or(cdoc, rs, "factor", 1.0)
    *rope_orig = hf_int_or(cdoc, rs, "original_max_position_embeddings", 0)
    *rope_bf = hf_f64_or(cdoc, rs, "beta_fast", 32.0)
    *rope_bs = hf_f64_or(cdoc, rs, "beta_slow", 1.0)
    $af := hf_f64_or(cdoc, rs, "attention_factor", 0.0)
    if af <= 0.0 { af = hf_f64_or(cdoc, rs, "mscale", 0.0) }
    *rope_af = af
}

fn load_model_hf_dir(dir &string, cfg_text &string, ctx_limit int) Model {
    cdoc := json.parse(cfg_text)
    if !cdoc.ok() || !cdoc.is_dict(cdoc.root()) {
        >>> errors.new("invalid HuggingFace config.json")
    }
    cr := cdoc.root()
    dim := hf_int_or(&cdoc, cr, "hidden_size", 0)
    $hidden_dim := hf_int_or(&cdoc, cr, "intermediate_size", 0)
    n_layers := hf_int_or(&cdoc, cr, "num_hidden_layers", 0)
    n_heads := hf_int_or(&cdoc, cr, "num_attention_heads", 0)
    n_kv_heads := hf_int_or(&cdoc, cr, "num_key_value_heads", n_heads)
    head_dim_raw := hf_int_or(&cdoc, cr, "head_dim", 0)
    $head_dim := head_dim_raw
    if head_dim <= 0 && n_heads > 0 { head_dim = dim / n_heads }
    vocab_size := hf_int_or(&cdoc, cr, "vocab_size", 0)
    $max_seq_len := hf_int_or(&cdoc, cr, "max_position_embeddings", 2048)
    if ctx_limit > 0 && max_seq_len > ctx_limit { max_seq_len = ctx_limit }
    rope_theta := hf_f64_or(&cdoc, cr, "rope_theta", 10000.0)
    rms_eps := hf_f64_or(&cdoc, cr, "rms_norm_eps", 0.00001)
    tie_emb := hf_bool_or(&cdoc, cr, "tie_word_embeddings", false)
    arch := hf_str_or(&cdoc, cr, "model_type", "")
    bos_id := hf_int_or(&cdoc, cr, "bos_token_id", -1)
    $eos_id := 2
    $eos_ids := []int{}
    hf_parse_eos_ids(&cdoc, cr, $&eos_id, $&eos_ids)
    if eos_ids.len == 0 { eos_ids.push(2) }
    sliding_window := hf_int_or(&cdoc, cr, "sliding_window", 0)
    attn_softcap := hf_f64_or(&cdoc, cr, "attn_logit_softcapping", 0.0)
    final_softcap := hf_f64_or(&cdoc, cr, "final_logit_softcapping", 0.0)
    hact := hf_str_or(&cdoc, cr, "hidden_act", "")
    use_geglu := hact == "gelu_pytorch_tanh" || hact == "gelu"

    $expert_count := hf_int_or(&cdoc, cr, "num_local_experts", 0)
    if expert_count <= 0 { expert_count = hf_int_or(&cdoc, cr, "n_routed_experts", 0) }
    $expert_used := hf_int_or(&cdoc, cr, "num_experts_per_tok", 0)
    if expert_count > 0 && expert_used <= 0 { expert_used = 1 }
    $exp_hidden := hf_int_or(&cdoc, cr, "moe_intermediate_size", 0)
    if expert_count > 0 && exp_hidden <= 0 { exp_hidden = hidden_dim }
    if hidden_dim <= 0 && exp_hidden > 0 { hidden_dim = exp_hidden }
    sh_count := hf_int_or(&cdoc, cr, "n_shared_experts", 0)
    $sh_hidden := 0
    if sh_count > 0 { sh_hidden = sh_count * exp_hidden }
    sf_str := hf_str_or(&cdoc, cr, "scoring_func", "softmax")
    $exp_gating := 1
    if sf_str == "sigmoid" { exp_gating = 2 }
    $exp_norm := hf_bool_or(&cdoc, cr, "norm_topk_prob", true)
    exp_scale := hf_f64_or(&cdoc, cr, "routed_scaling_factor", 1.0)

    $rope_scale := 1.0
    $rope_st := ""
    $rope_orig := 0
    $rope_bf := 32.0
    $rope_bs := 1.0
    $rope_af := 0.0
    hf_parse_rope_scaling(&cdoc, cr, $&rope_st, $&rope_scale, $&rope_orig, $&rope_bf, $&rope_bs, $&rope_af)

    if dim <= 0 || hidden_dim <= 0 || n_layers <= 0 || n_heads <= 0 || vocab_size <= 0 {
        >>> errors.new("incomplete HF config.json dimensions")
    }
    kv_dim := n_kv_heads * head_dim
    $embed_scale := f32(1.0)
    if arch == "gemma" || arch == "gemma2" { embed_scale = f32(math.sqrt(f64(dim))) }

    $has_index := false
    $weight_map := map[string]string{}
    $shards := []HfShard{}
    $file_to_idx := map[string]int{}
    idx_raw := try_read_file((*dir) + "/model.safetensors.index.json")
    if idx_raw.len > 0 {
        idoc := json.parse(&idx_raw)
        if !idoc.ok() || !idoc.is_dict(idoc.root()) { >>> errors.new("invalid model.safetensors.index.json") }
        ir := idoc.root()
        if idoc.has(ir, "weight_map") {
            wn := idoc.get(ir, "weight_map") >>>
            if idoc.is_dict(wn) {
                has_index = true
                wkeys := idoc.dict_keys(wn)
                for ki in 0:wkeys.len {
                    tk := wkeys[ki]
                    sv := hf_str_or(&idoc, wn, tk + "", "")
                    if sv.len > 0 { weight_map[tk + ""] = sv }
                }
            }
        }
    }
    if !has_index {
        single_path := (*dir) + "/model.safetensors"
        sh0 := open_hf_shard(&single_path) >>>
        shards.push(~sh0)
        file_to_idx["model.safetensors"] = 0
    }

    $weights := []f32{}
    $compact := empty_compact_weights()
    $rname := ""
    emb_si := hf_find_required_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &["model.embed_tokens.weight", "embed_tokens.weight"], $&rname) >>>
    embed_off := hf_load_2d(&shards, emb_si, &rname, vocab_size, dim, $&weights, $&compact) >>>

    $wq_off := []int{}
    $wk_off := []int{}
    $wv_off := []int{}
    $wo_off := []int{}
    $w1_off := []int{}
    $w2_off := []int{}
    $w3_off := []int{}
    $is_moe := expert_count > 0
    $moe_layer := []bool{}
    $moe_gate_inp_off := []int{}
    $moe_exp_probs_bias := [][]f32{}
    $moe_w1_off := [][]int{}
    $moe_w2_off := [][]int{}
    $moe_w3_off := [][]int{}
    $moe_has_shared := []bool{}
    $moe_sh_w1_off := []int{}
    $moe_sh_w2_off := []int{}
    $moe_sh_w3_off := []int{}
    $moe_has_sh_gate := []bool{}
    $moe_sh_gate_inp_off := []int{}
    $bq := [][]f32{}
    $bk := [][]f32{}
    $bv := [][]f32{}
    $q_norms := [][]f32{}
    $k_norms := [][]f32{}
    $post_attn_norms := [][]f32{}
    $post_ffn_norms := [][]f32{}
    $attn_norms := [][]f32{}
    $ffn_norms := [][]f32{}
    $has_qkv_bias := false
    $has_qk_norm := false
    $has_post_norms := false

    for l in 0:n_layers {
        mp := "model.layers." + str(l) + "."
        lp := "layers." + str(l) + "."
        an_si := hf_find_required_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "input_layernorm.weight", lp + "input_layernorm.weight"], $&rname) >>>
        attn_norms.push(hf_load_1d(&shards, an_si, &rname, dim) >>>)
        fn_si := hf_find_required_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "post_attention_layernorm.weight", lp + "post_attention_layernorm.weight"], $&rname) >>>
        ffn_norms.push(hf_load_1d(&shards, fn_si, &rname, dim) >>>)

        q_si := hf_find_required_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "self_attn.q_proj.weight", lp + "self_attn.q_proj.weight"], $&rname) >>>
        wq_off.push(hf_load_2d(&shards, q_si, &rname, n_heads * head_dim, dim, $&weights, $&compact) >>>)
        k_si := hf_find_required_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "self_attn.k_proj.weight", lp + "self_attn.k_proj.weight"], $&rname) >>>
        wk_off.push(hf_load_2d(&shards, k_si, &rname, kv_dim, dim, $&weights, $&compact) >>>)
        v_si := hf_find_required_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "self_attn.v_proj.weight", lp + "self_attn.v_proj.weight"], $&rname) >>>
        wv_off.push(hf_load_2d(&shards, v_si, &rname, kv_dim, dim, $&weights, $&compact) >>>)
        o_si := hf_find_required_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "self_attn.o_proj.weight", lp + "self_attn.o_proj.weight"], $&rname) >>>
        wo_off.push(hf_load_2d(&shards, o_si, &rname, dim, n_heads * head_dim, $&weights, $&compact) >>>)

        $qbn := ""
        $kbn := ""
        $vbn := ""
        qbsi := hf_find_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "self_attn.q_proj.bias", lp + "self_attn.q_proj.bias"], $&qbn)
        kbsi := hf_find_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "self_attn.k_proj.bias", lp + "self_attn.k_proj.bias"], $&kbn)
        vbsi := hf_find_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "self_attn.v_proj.bias", lp + "self_attn.v_proj.bias"], $&vbn)
        if qbsi >= 0 && kbsi >= 0 && vbsi >= 0 {
            if !has_qkv_bias {
                has_qkv_bias = true
                for _ in 0:l {
                    bq.push(alloc_zeros(dim))
                    bk.push(alloc_zeros(kv_dim))
                    bv.push(alloc_zeros(kv_dim))
                }
            }
            bq.push(hf_load_1d(&shards, qbsi, &qbn, dim) >>>)
            bk.push(hf_load_1d(&shards, kbsi, &kbn, kv_dim) >>>)
            bv.push(hf_load_1d(&shards, vbsi, &vbn, kv_dim) >>>)
        } else if has_qkv_bias {
            bq.push(alloc_zeros(dim))
            bk.push(alloc_zeros(kv_dim))
            bv.push(alloc_zeros(kv_dim))
        }

        $qnn := ""
        $knn := ""
        qnsi := hf_find_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "self_attn.q_norm.weight", lp + "self_attn.q_norm.weight"], $&qnn)
        knsi := hf_find_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "self_attn.k_norm.weight", lp + "self_attn.k_norm.weight"], $&knn)
        if qnsi >= 0 && knsi >= 0 {
            if !has_qk_norm {
                has_qk_norm = true
                for _ in 0:l {
                    $o := []f32{}
                    for _ in 0:head_dim { o.push(f32(1.0)) }
                    q_norms.push(~o)
                    $ok := []f32{}
                    for _ in 0:head_dim { ok.push(f32(1.0)) }
                    k_norms.push(~ok)
                }
            }
            q_norms.push(hf_load_1d(&shards, qnsi, &qnn, head_dim) >>>)
            k_norms.push(hf_load_1d(&shards, knsi, &knn, head_dim) >>>)
        } else if has_qk_norm {
            $o := []f32{}
            for _ in 0:head_dim { o.push(f32(1.0)) }
            q_norms.push(~o)
            $ok := []f32{}
            for _ in 0:head_dim { ok.push(f32(1.0)) }
            k_norms.push(~ok)
        }

        $pan_n := ""
        $pfn_n := ""
        pan_si := hf_find_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "post_attention_layernorm.weight", lp + "post_attention_layernorm.weight"], $&pan_n)
        pfn_si := hf_find_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "post_feedforward_layernorm.weight", lp + "post_feedforward_layernorm.weight"], $&pfn_n)
        if pfn_si >= 0 {
            if !has_post_norms {
                has_post_norms = true
                for _ in 0:l {
                    $o1 := []f32{}
                    $o2 := []f32{}
                    for _ in 0:dim {
                        o1.push(f32(1.0))
                        o2.push(f32(1.0))
                    }
                    post_attn_norms.push(~o1)
                    post_ffn_norms.push(~o2)
                }
            }
            post_attn_norms.push(hf_load_1d(&shards, pan_si, &pan_n, dim) >>>)
            post_ffn_norms.push(hf_load_1d(&shards, pfn_si, &pfn_n, dim) >>>)
        } else if has_post_norms {
            $o1 := []f32{}
            $o2 := []f32{}
            for _ in 0:dim {
                o1.push(f32(1.0))
                o2.push(f32(1.0))
            }
            post_attn_norms.push(~o1)
            post_ffn_norms.push(~o2)
        }

        $rn := ""
        gate_si := hf_find_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "mlp.gate.weight", lp + "mlp.gate.weight", mp + "block_sparse_moe.gate.weight", lp + "block_sparse_moe.gate.weight"], $&rn)
        if expert_count > 0 && gate_si >= 0 {
            moe_layer.push(true)
            moe_gate_inp_off.push(hf_load_2d(&shards, gate_si, &rn, expert_count, dim, $&weights, $&compact) >>>)
            $bn := ""
            bsi := hf_find_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "mlp.gate.e_score_correction_bias", lp + "mlp.gate.e_score_correction_bias"], $&bn)
            if bsi >= 0 { moe_exp_probs_bias.push(hf_load_1d(&shards, bsi, &bn, expert_count) >>>) }
            else { moe_exp_probs_bias.push([]f32{}) }
            $ew1 := []int{}
            $ew2 := []int{}
            $ew3 := []int{}
            for e in 0:expert_count {
                es := str(e)
                e1_si := hf_find_required_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "mlp.experts." + es + ".gate_proj.weight", mp + "block_sparse_moe.experts." + es + ".w1.weight", lp + "mlp.experts." + es + ".gate_proj.weight"], $&rn) >>>
                ew1.push(hf_load_2d(&shards, e1_si, &rn, exp_hidden, dim, $&weights, $&compact) >>>)
                e3_si := hf_find_required_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "mlp.experts." + es + ".up_proj.weight", mp + "block_sparse_moe.experts." + es + ".w3.weight", lp + "mlp.experts." + es + ".up_proj.weight"], $&rn) >>>
                ew3.push(hf_load_2d(&shards, e3_si, &rn, exp_hidden, dim, $&weights, $&compact) >>>)
                e2_si := hf_find_required_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "mlp.experts." + es + ".down_proj.weight", mp + "block_sparse_moe.experts." + es + ".w2.weight", lp + "mlp.experts." + es + ".down_proj.weight"], $&rn) >>>
                ew2.push(hf_load_2d(&shards, e2_si, &rn, dim, exp_hidden, $&weights, $&compact) >>>)
            }
            moe_w1_off.push(~ew1)
            moe_w3_off.push(~ew3)
            moe_w2_off.push(~ew2)
            $sn1 := ""
            $sn2 := ""
            $sn3 := ""
            s1 := hf_find_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "mlp.shared_expert.gate_proj.weight", mp + "mlp.shared_experts.gate_proj.weight"], $&sn1)
            s3 := hf_find_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "mlp.shared_expert.up_proj.weight", mp + "mlp.shared_experts.up_proj.weight"], $&sn3)
            s2 := hf_find_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "mlp.shared_expert.down_proj.weight", mp + "mlp.shared_experts.down_proj.weight"], $&sn2)
            if sh_hidden > 0 && s1 >= 0 && s3 >= 0 && s2 >= 0 {
                moe_has_shared.push(true)
                moe_sh_w1_off.push(hf_load_2d(&shards, s1, &sn1, sh_hidden, dim, $&weights, $&compact) >>>)
                moe_sh_w3_off.push(hf_load_2d(&shards, s3, &sn3, sh_hidden, dim, $&weights, $&compact) >>>)
                moe_sh_w2_off.push(hf_load_2d(&shards, s2, &sn2, dim, sh_hidden, $&weights, $&compact) >>>)
                $sgn := ""
                sgs := hf_find_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "mlp.shared_expert_gate.weight"], $&sgn)
                if sgs >= 0 {
                    moe_has_sh_gate.push(true)
                    moe_sh_gate_inp_off.push(hf_load_2d(&shards, sgs, &sgn, 1, dim, $&weights, $&compact) >>>)
                } else {
                    moe_has_sh_gate.push(false)
                    moe_sh_gate_inp_off.push(0)
                }
            } else {
                moe_has_shared.push(false)
                moe_sh_w1_off.push(0)
                moe_sh_w2_off.push(0)
                moe_sh_w3_off.push(0)
                moe_has_sh_gate.push(false)
                moe_sh_gate_inp_off.push(0)
            }
            w1_off.push(0)
            w2_off.push(0)
            w3_off.push(0)
        } else {
            g_si := hf_find_required_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "mlp.gate_proj.weight", lp + "mlp.gate_proj.weight"], $&rn) >>>
            w1_off.push(hf_load_2d(&shards, g_si, &rn, hidden_dim, dim, $&weights, $&compact) >>>)
            u_si := hf_find_required_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "mlp.up_proj.weight", lp + "mlp.up_proj.weight"], $&rn) >>>
            w3_off.push(hf_load_2d(&shards, u_si, &rn, hidden_dim, dim, $&weights, $&compact) >>>)
            d_si := hf_find_required_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &[mp + "mlp.down_proj.weight", lp + "mlp.down_proj.weight"], $&rn) >>>
            w2_off.push(hf_load_2d(&shards, d_si, &rn, dim, hidden_dim, $&weights, $&compact) >>>)
            if is_moe {
                moe_layer.push(false)
                moe_gate_inp_off.push(0)
                moe_exp_probs_bias.push([]f32{})
                moe_w1_off.push([]int{})
                moe_w2_off.push([]int{})
                moe_w3_off.push([]int{})
                moe_has_shared.push(false)
                moe_sh_w1_off.push(0)
                moe_sh_w2_off.push(0)
                moe_sh_w3_off.push(0)
                moe_has_sh_gate.push(false)
                moe_sh_gate_inp_off.push(0)
            }
        }
    }

    fn_si := hf_find_required_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &["model.norm.weight", "norm.weight"], $&rname) >>>
    final_norm := hf_load_1d(&shards, fn_si, &rname, dim) >>>
    $lm_head_off := embed_off
    if !tie_emb {
        $lmn := ""
        lm_si := hf_find_tensor(dir, has_index, &weight_map, $&shards, $&file_to_idx, &["lm_head.weight"], $&lmn)
        if lm_si >= 0 {
            lm_head_off = hf_load_2d(&shards, lm_si, &lmn, vocab_size, dim, $&weights, $&compact) >>>
        }
    }

    $cfg := ModelConfig{
        dim: dim, hidden_dim: hidden_dim, n_layers: n_layers, n_heads: n_heads,
        n_kv_heads: n_kv_heads, head_dim: head_dim, kv_dim: kv_dim,
        vocab_size: vocab_size, max_seq_len: max_seq_len, rope_theta: rope_theta,
        rope_freq_scale: rope_scale, rope_dim: head_dim, rope_interleaved: false,
        rope_scaling_type: rope_st, rope_yarn_orig_ctx: rope_orig, rope_yarn_beta_fast: rope_bf,
        rope_yarn_beta_slow: rope_bs, rope_yarn_attn_factor: rope_af,
        sliding_window: sliding_window, attn_logit_softcap: attn_softcap, logit_softcap: final_softcap,
        use_geglu: use_geglu, expert_count: expert_count, expert_used_count: expert_used,
        expert_hidden_dim: exp_hidden, shared_expert_count: sh_count,
        shared_expert_hidden_dim: sh_hidden, expert_gating_func: exp_gating,
        expert_weights_norm: exp_norm, expert_weights_scale: exp_scale,
        kv_lora_rank: 0, q_lora_rank: 0, qk_nope_head_dim: 0, qk_rope_head_dim: head_dim, v_head_dim: head_dim, q_dim: dim,
        embed_scale: embed_scale, rms_eps: rms_eps, bos_token_id: bos_id, eos_token_id: eos_id,
        is_gpt2_tok: false, tok_model: "", arch: arch, chat_template: ""
    }
    $vocab := []string{}
    $vocab_map := map[string]int{}
    $bpe_merges := map[string]int{}
    $is_gpt2 := false
    load_hf_tokenizer(dir, vocab_size, $&vocab, $&vocab_map, $&bpe_merges, $&is_gpt2, $&cfg, $&eos_ids)
    cfg.is_gpt2_tok = is_gpt2
    push_unique_id($&eos_ids, vocab_map.get_or("<|im_end|>", -1))
    push_unique_id($&eos_ids, vocab_map.get_or("<|eot_id|>", -1))
    push_unique_id($&eos_ids, vocab_map.get_or("<end_of_turn>", -1))
    tmpl_kind := detect_chat_template_kind(&cfg, &vocab_map)

    $rope_cos := []f32{}
    $rope_sin := []f32{}
    build_rope_tables(cfg.rope_dim, cfg.max_seq_len, cfg.rope_theta, cfg.rope_freq_scale, cfg.rope_scaling_type, cfg.rope_yarn_orig_ctx, cfg.rope_yarn_beta_fast, cfg.rope_yarn_beta_slow, cfg.rope_yarn_attn_factor, $&rope_cos, $&rope_sin)
    lora_nl := cfg.n_layers

    << Model{
        cfg: cfg, is_q4: false, is_q8: false, embed_q4: false, lm_head_q4: false, lm_head_q8: false,
        layers_p4: false, embed_p4: false, lm_head_p4: false,
        has_qkv_bias: has_qkv_bias, has_qk_norm: has_qk_norm, has_post_norms: has_post_norms,
        is_moe: is_moe, is_mla: false, use_q8k_act: false, lora: empty_lora_state(lora_nl),
        chat_template_kind: tmpl_kind, eos_ids: eos_ids,
        weights: weights, compact_weights: compact,
        q4_qs: []u8{}, q4_scales: []f32{}, q8_qs: []i8{}, q8_scales: []f32{},
        q4_p4k4_qs: []u8{}, q4_p4k4_scales: []u16{}, q8_p4k4_qs: []i8{}, q8_p4k4_scales: []u16{},
        embed_off: embed_off, lm_head_off: lm_head_off,
        wq_off: wq_off, wk_off: wk_off, wv_off: wv_off, wo_off: wo_off,
        w1_off: w1_off, w2_off: w2_off, w3_off: w3_off,
        mla_has_qlora: []bool{}, mla_qa_off: []int{}, mla_qa_norm: [][]f32{},
        mla_qb_off: []int{}, mla_kva_off: []int{}, mla_kva_norm: [][]f32{}, mla_kvb_off: []int{},
        moe_layer: moe_layer,
        moe_gate_inp_off: moe_gate_inp_off, moe_exp_probs_bias: moe_exp_probs_bias,
        moe_w1_off: moe_w1_off, moe_w2_off: moe_w2_off, moe_w3_off: moe_w3_off,
        moe_has_shared: moe_has_shared, moe_sh_w1_off: moe_sh_w1_off,
        moe_sh_w2_off: moe_sh_w2_off, moe_sh_w3_off: moe_sh_w3_off,
        moe_has_sh_gate: moe_has_sh_gate, moe_sh_gate_inp_off: moe_sh_gate_inp_off,
        bq: bq, bk: bk, bv: bv, q_norms: q_norms, k_norms: k_norms,
        post_attn_norms: post_attn_norms, post_ffn_norms: post_ffn_norms,
        attn_norms: attn_norms, ffn_norms: ffn_norms, final_norm: final_norm,
        zeros: alloc_zeros(dim), rope_cos: rope_cos, rope_sin: rope_sin,
        vocab: vocab, vocab_map: vocab_map, bpe_merges: bpe_merges
    }
}

fn load_model(path string, ctx_limit int, use_p4 bool) Model {
    cfg_raw := try_read_file(path + "/config.json")
    if cfg_raw.len > 0 {
        << load_model_hf_dir(&path, &cfg_raw, ctx_limit) >>>
    }
    path_copy := path + ""
    $f := os.open(path) >>>
    head := f.read(4) >>> (err) {
        _ := f.close() >>>
        >>> err
    }
    if head.len == 4 && head[0] == 71 && head[1] == 71 && head[2] == 85 && head[3] == 70 {
        _ := f.seek(0, os.SEEK_SET) >>> (err) {
            _ := f.close() >>>
            >>> err
        }
        m := load_model_gguf_file(&f, ctx_limit, use_p4) >>> (err) {
            _ := f.close() >>>
            >>> err
        }
        _ := f.close() >>>
        << m
    }
    _ := f.close() >>>
    data := os.read(path_copy) >>>
    << load_model_safetensors(&data, ctx_limit) >>>
}

fn new_paged_kv_cache(cfg &ModelConfig, max_slots int, dtype tensor.DType) PagedKvCache {
    if cfg.max_seq_len <= 0 { >>> errors.new("KV cache requires a positive context length") }
    blocks_per_seq := 1 + (cfg.max_seq_len - 1) / KV_BLOCK_SIZE
    num_blocks := checked_size_product(max_slots, blocks_per_seq) >>>
    layer_stride := checked_size_product(KV_BLOCK_SIZE, cfg.kv_dim) >>>
    block_stride := checked_size_product(cfg.n_layers, layer_stride) >>>
    pool_elems := checked_size_product(num_blocks, block_stride) >>>
    width := dtype.element_bytes()
    storage_bytes := checked_size_product(pool_elems, 2 * width) >>>
    $f32_keys := []f32{}
    $f32_values := []f32{}
    $keys16 := []u16{}
    $values16 := []u16{}
    $keys8 := []u8{}
    $values8 := []u8{}
    if width == 4 {
        f32_keys.resize_zero(pool_elems)
        f32_values.resize_zero(pool_elems)
    } else if width == 2 {
        keys16.resize_zero(pool_elems)
        values16.resize_zero(pool_elems)
    } else {
        keys8.resize_zero(pool_elems)
        values8.resize_zero(pool_elems)
    }

    $free_stack := []int{}
    $b := num_blocks - 1
    while b >= 0 {
        free_stack.push(b)
        b -= 1
    }
    $block_tables := []int{}
    for _ in 0:num_blocks { block_tables.push(-1) }
    $slot_num_blocks := []int{}
    for _ in 0:max_slots { slot_num_blocks.push(0) }

    << PagedKvCache{
        max_slots: max_slots,
        num_blocks: num_blocks,
        blocks_per_seq: blocks_per_seq,
        block_size: KV_BLOCK_SIZE,
        n_layers: cfg.n_layers,
        layer_stride: layer_stride,
        block_stride: block_stride,
        kv_dim: cfg.kv_dim,
        dtype: dtype, storage_width: width, storage_bytes: storage_bytes,
        k_blocks: f32_keys, v_blocks: f32_values,
        compact_k16: keys16, compact_v16: values16,
        compact_k8: keys8, compact_v8: values8,
        free_stack: free_stack,
        free_top: num_blocks,
        alloc_count: 0,
        block_tables: block_tables,
        slot_num_blocks: slot_num_blocks
    }
}

fn kv_ensure_block(kv $&PagedKvCache, slot int, pos int) int {
    logical := pos / kv.block_size
    if logical < 0 || logical >= kv.blocks_per_seq {
        >>> errors.new("kv sequence length exceeds max_seq_len")
    }
    t_idx := slot * kv.blocks_per_seq + logical
    pb := kv.block_tables[t_idx]
    if pb >= 0 { << pb }
    if kv.free_top <= 0 {
        >>> errors.new("paged kv block pool exhausted")
    }
    kv.free_top -= 1
    alloc_pb := kv.free_stack[kv.free_top]
    kv.block_tables[t_idx] = alloc_pb
    kv.slot_num_blocks[slot] += 1
    kv.alloc_count += 1
    << alloc_pb
}

fn kv_free_slot(kv $&PagedKvCache, slot int) {
    base := slot * kv.blocks_per_seq
    for lb in 0:kv.blocks_per_seq {
        pb := kv.block_tables[base + lb]
        if pb >= 0 {
            kv.block_tables[base + lb] = -1
            kv.free_stack[kv.free_top] = pb
            kv.free_top += 1
        }
    }
    kv.slot_num_blocks[slot] = 0
}

fn kv_truncate_slot(kv $&PagedKvCache, slot int, keep_tokens int) {
    $keep_blocks := 0
    if keep_tokens > 0 { keep_blocks = 1 + (keep_tokens - 1) / kv.block_size }
    if keep_blocks > kv.blocks_per_seq { keep_blocks = kv.blocks_per_seq }
    base := slot * kv.blocks_per_seq
    for lb in keep_blocks:kv.blocks_per_seq {
        pb := kv.block_tables[base + lb]
        if pb >= 0 {
            kv.block_tables[base + lb] = -1
            kv.free_stack[kv.free_top] = pb
            kv.free_top += 1
            kv.slot_num_blocks[slot] -= 1
        }
    }
}

fn load_embed_raw_row(m &Model, token int, dst $&[]f32, dst_off int) int {
    dim := m.cfg.dim
    if m.embed_off < 0 {
        index := -1 - m.embed_off
        kind := m.compact_weights.kinds[index]
        if kind == COMPACT_Q4_K || kind == COMPACT_Q5_K || kind == COMPACT_Q6_K {
            if dim % tensor.QK_K != 0 { >>> errors.new("K-quant embedding dim must be divisible by 256") }
            start := m.compact_weights.raw_starts[index]
            nb := dim / tensor.QK_K
            $blk_bytes := tensor.Q4_K_BYTES
            if kind == COMPACT_Q5_K { blk_bytes = tensor.Q5_K_BYTES }
            else if kind == COMPACT_Q6_K { blk_bytes = tensor.Q6_K_BYTES }
            row_start := start + token * nb * blk_bytes
            $tmp := []f32{}
            tmp.reserve(dim)
            for b in 0:nb {
                boff := row_start + b * blk_bytes
                if kind == COMPACT_Q4_K {
                    blk := tensor.read_q4_k(&m.compact_weights.data, boff) >>>
                    blk.append_f32($&tmp)
                } else if kind == COMPACT_Q5_K {
                    blk := tensor.read_q5_k(&m.compact_weights.data, boff) >>>
                    blk.append_f32($&tmp)
                } else {
                    blk := tensor.read_q6_k(&m.compact_weights.data, boff) >>>
                    blk.append_f32($&tmp)
                }
            }
            for i in 0:dim { dst[dst_off + i] = tmp[i] }
            << 0
        }
        if kind == COMPACT_Q5_0 || kind == COMPACT_Q8_0 {
            if dim % tensor.GGML_BLOCK_VALUES != 0 { >>> errors.new("quantized embedding dim must be divisible by 32") }
            start := m.compact_weights.raw_starts[index]
            nb := dim / tensor.GGML_BLOCK_VALUES
            $blk_bytes := tensor.Q5_0_BYTES
            if kind == COMPACT_Q8_0 { blk_bytes = tensor.Q8_0_BYTES }
            row_start := start + token * nb * blk_bytes
            $tmp := []f32{}
            tmp.reserve(dim)
            for b in 0:nb {
                boff := row_start + b * blk_bytes
                if kind == COMPACT_Q5_0 {
                    blk := tensor.read_q5_0(&m.compact_weights.data, boff) >>>
                    blk.append_f32($&tmp)
                } else {
                    blk := tensor.read_q8_0(&m.compact_weights.data, boff) >>>
                    blk.append_f32($&tmp)
                }
            }
            for i in 0:dim { dst[dst_off + i] = tmp[i] }
            << 0
        }
        view := &m.compact_weights.views[index]
        _ := view.copy_f32(&m.compact_weights.data, token * dim, dim, dst, dst_off) >>>
        << 0
    }
    if m.embed_p4 {
        nb := dim / 32
        rg := token / 4
        r4 := token % 4
        g_off := m.embed_off + rg * nb
        for b in 0:nb {
            gb := g_off + b
            d := math.float16_to_f32(int(m.q4_p4k4_scales[gb * 4 + r4]))
            qb := gb * 64 + r4 * 4
            ob := dst_off + b * 32
            for j in 0:16 {
                bv := int(m.q4_p4k4_qs[qb + (j >> 2) * 16 + (j & 3)]) ^ 136
                q0 := (bv & 15) - 8
                q1 := (bv >> 4) - 8
                dst[ob + j] = f32(q0) * d
                dst[ob + 16 + j] = f32(q1) * d
            }
        }
        << 0
    }
    if m.embed_q4 {
        nb := dim / 32
        blk_off := m.embed_off + token * nb
        q_off := blk_off * 16
        for b in 0:nb {
            d := m.q4_scales[blk_off + b]
            qb := q_off + b * 16
            ob := dst_off + b * 32
            for j in 0:16 {
                bv := int(m.q4_qs[qb + j])
                q0 := (bv & 15) - 8
                q1 := (bv >> 4) - 8
                dst[ob + j] = f32(q0) * d
                dst[ob + 16 + j] = f32(q1) * d
            }
        }
        << 0
    }
    emb_off := m.embed_off + token * dim
    for i in 0:dim {
        dst[dst_off + i] = m.weights[emb_off + i]
    }
    << 0
}

fn load_embed_row(m &Model, token int, dst $&[]f32, dst_off int) int {
    _ := load_embed_raw_row(m, token, dst, dst_off) >>>
    s := m.cfg.embed_scale
    if s != f32(1.0) {
        dim := m.cfg.dim
        for i in 0:dim {
            dst[dst_off + i] = dst[dst_off + i] * s
        }
    }
    << 0
}

// Canonical ResidualAdd + Weighted RMSNorm triggering MIR dynamic output reuse + NEON SIMD.
fn rmsnorm_add_fused(n int, x &[]f32, skip &[]f32, weight &[]f32, out $&[]f32, eps f64) {
    if n > RMS_CAP {
        $sum := f32(0)
        for i in 0:n {
            v := x[i] + skip[i]
            out[i] = v
            sum += v * v
        }
        inv := f32(1.0 / math.sqrt(f64(sum) / f64(n) + eps))
        for k in 0:n {
            out[k] = (out[k] * inv) * weight[k]
        }
        <<
    }
    $sum := f32(0)
    $tmp := [2048]f32{}
    for i in 0:n { tmp[i] = x[i] + skip[i] }
    for j in 0:n { sum += tmp[j] * tmp[j] }
    inv := f32(1.0 / math.sqrt(f64(sum) / f64(n) + eps))
    for k in 0:n { out[k] = (tmp[k] * inv) * weight[k] }
}

fn rmsnorm_batch(n int, m_cnt int, x &[]f32, weight &[]f32, out $&[]f32, eps f64) {
    for t in 0:m_cnt {
        base := t * n
        $sum := f32(0)
        for j in 0:n {
            v := x[base + j]
            sum += v * v
        }
        inv := f32(1.0 / math.sqrt(f64(sum) / f64(n) + eps))
        for k in 0:n {
            out[base + k] = (x[base + k] * inv) * weight[k]
        }
    }
}

// Canonical 2D row-offset F32 GEMV triggering MIR 4-row register-tiled NEON SIMD lowering.
fn matvec(out $&[]f32, x &[]f32, weights &[]f32, w_off int, rows int, cols int) {
    for r in 0:rows {
        row_off := w_off + r * cols
        $acc := f32(0)
        for c in 0:cols {
            acc += weights[row_off + c] * x[c]
        }
        out[r] = acc
    }
}

// Canonical 3D F32 GEMM triggering MIR 4x4 register-tiled NEON SIMD lowering for batched prefill.
fn matmat_f32(out $&[]f32, x &[]f32, weights &[]f32, w_off int, m_cnt int, rows int, cols int) {
    for m in 0:m_cnt {
        x_off := m * cols
        out_off := m * rows
        for r in 0:rows {
            row_off := w_off + r * cols
            $acc := f32(0)
            for c in 0:cols {
                acc += weights[row_off + c] * x[x_off + c]
            }
            out[out_off + r] = acc
        }
    }
}

// Canonical row-offset Q4_0 x F32 GEMV triggering MIR interleaved dequantize+dot NEON SIMD lowering.
fn matvec_q4_0(out $&[]f32, x &[]f32, qs &[]u8, scales &[]f32, blk_off int, rows int, cols int) {
    n_blocks := cols / 32
    for r in 0:rows {
        s_off := blk_off + r * n_blocks
        q_off := s_off * 16
        $acc := f32(0)
        for b in 0:n_blocks {
            $bsum := f32(0)
            q_base := q_off + b * 16
            x_base := b * 32
            for j in 0:16 {
                bv := int(qs[q_base + j])
                q0 := (bv & 15) - 8
                q1 := (bv >> 4) - 8
                bsum += f32(q0) * x[x_base + j] + f32(q1) * x[x_base + 16 + j]
            }
            acc += bsum * scales[s_off + b]
        }
        out[r] = acc
    }
}

fn matmat_q4_0(out $&[]f32, x &[]f32, qs &[]u8, scales &[]f32, blk_off int, m_cnt int, rows int, cols int) {
    n_blocks := cols / 32
    for m in 0:m_cnt {
        xm_off := m * cols
        out_off := m * rows
        for r in 0:rows {
            s_off := blk_off + r * n_blocks
            q_off := s_off * 16
            $acc := f32(0)
            for b in 0:n_blocks {
                $bsum := f32(0)
                q_base := q_off + b * 16
                x_base := xm_off + b * 32
                for j in 0:16 {
                    bv := int(qs[q_base + j])
                    q0 := (bv & 15) - 8
                    q1 := (bv >> 4) - 8
                    bsum += f32(q0) * x[x_base + j] + f32(q1) * x[x_base + 16 + j]
                }
                acc += bsum * scales[s_off + b]
            }
            out[out_off + r] = acc
        }
    }
}

// Symmetric block-32 Q8_0 activation quantizer lowered to native NEON/SSE2 stub.
fn quantize_q8_0(x &[]f32, xq $&[]i8, x_scales $&[]f32, n int) {
    nb := n / 32
    for b in 0:nb {
        base := b * 32
        $amax := 0.0
        for i in 0:32 {
            $v := f64(x[base + i])
            if v < 0.0 { v = -v }
            if v > amax { amax = v }
        }
        scale := f32(amax / 127.0)
        x_scales[b] = scale
        $inv := 0.0
        if f64(scale) != 0.0 { inv = 1.0 / f64(scale) }
        for i in 0:32 {
            vf := f64(x[base + i]) * inv
            $q := 0
            if vf >= 0.0 { q = int(vf + 0.5) } else { q = -int(0.5 - vf) }
            if q > 127 { q = 127 }
            if q < -127 { q = -127 }
            xq[base + i] = i8(q)
        }
    }
}

// Canonical 2D Q4_0 x Q8_0 GEMV triggering ARM64 SDOT / x64 PMADDWD 4-row microkernel.
fn matvec_q4_0_q8_0(out $&[]f32, qs &[]u8, w_scales &[]f32, xq &[]i8, x_scales &[]f32,
                    blk_off int, rows int, cols int) {
    n_blocks := cols / 32
    for r in 0:rows {
        s_off := blk_off + r * n_blocks
        q_off := s_off * 16
        $acc := f32(0)
        for b in 0:n_blocks {
            $isum := 0
            q_base := q_off + b * 16
            x_base := b * 32
            for j in 0:16 {
                bv := int(qs[q_base + j])
                q0 := (bv & 15) - 8
                q1 := (bv >> 4) - 8
                isum += q0 * int(xq[x_base + j]) + q1 * int(xq[x_base + 16 + j])
            }
            acc += f32(isum) * (w_scales[s_off + b] * x_scales[b])
        }
        out[r] = acc
    }
}

// Canonical 3D Q4_0 x Q8_0 GEMM triggering ARM64 SDOT / x64 PMADDWD 4x4 prefill microkernel.
fn matmat_q4_0_q8_0(out $&[]f32, qs &[]u8, w_scales &[]f32, xq &[]i8, x_scales &[]f32,
                    blk_off int, m_cnt int, rows int, cols int) {
    n_blocks := cols / 32
    for m in 0:m_cnt {
        xm_s := m * n_blocks
        xm_q := xm_s * 32
        out_off := m * rows
        for r in 0:rows {
            s_off := blk_off + r * n_blocks
            q_off := s_off * 16
            $acc := f32(0)
            for b in 0:n_blocks {
                $isum := 0
                q_base := q_off + b * 16
                x_base := xm_q + b * 32
                for j in 0:16 {
                    bv := int(qs[q_base + j])
                    q0 := (bv & 15) - 8
                    q1 := (bv >> 4) - 8
                    isum += q0 * int(xq[x_base + j]) + q1 * int(xq[x_base + 16 + j])
                }
                acc += f32(isum) * (w_scales[s_off + b] * x_scales[xm_s + b])
            }
            out[out_off + r] = acc
        }
    }
}

// Canonical 2D Q8_0 x Q8_0 GEMV triggering ARM64 SDOT / x64 PMADDWD 4-row microkernel (used for Q8_0 output.weight).
fn matvec_q8_0_q8_0(out $&[]f32, w_qs &[]i8, w_scales &[]f32, xq &[]i8, x_scales &[]f32,
                    blk_off int, rows int, cols int) {
    n_blocks := cols / 32
    for r in 0:rows {
        s_off := blk_off + r * n_blocks
        q_off := s_off * 32
        $acc := f32(0)
        for b in 0:n_blocks {
            $isum := 0
            q_base := q_off + b * 32
            x_base := b * 32
            for j in 0:32 {
                isum += int(w_qs[q_base + j]) * int(xq[x_base + j])
            }
            acc += f32(isum) * (w_scales[s_off + b] * x_scales[b])
        }
        out[r] = acc
    }
}

fn matvec_q8_0_f32(out $&[]f32, x &[]f32, w_qs &[]i8, w_scales &[]f32, blk_off int, rows int, cols int) {
    n_blocks := cols / 32
    for r in 0:rows {
        s_off := blk_off + r * n_blocks
        q_off := s_off * 32
        $acc := f32(0)
        for b in 0:n_blocks {
            $bsum := f32(0)
            q_base := q_off + b * 32
            x_base := b * 32
            for j in 0:32 {
                bsum += f32(int(w_qs[q_base + j])) * x[x_base + j]
            }
            acc += bsum * w_scales[s_off + b]
        }
        out[r] = acc
    }
}

fn matmat_q8_0_q8_0(out $&[]f32, w_qs &[]i8, w_scales &[]f32, xq &[]i8, x_scales &[]f32,
                    blk_off int, m_cnt int, rows int, cols int) {
    n_blocks := cols / 32
    for m in 0:m_cnt {
        xm_s := m * n_blocks
        xm_q := xm_s * 32
        out_off := m * rows
        for r in 0:rows {
            s_off := blk_off + r * n_blocks
            q_off := s_off * 32
            $acc := f32(0)
            for b in 0:n_blocks {
                $isum := 0
                q_base := q_off + b * 32
                x_base := xm_q + b * 32
                for j in 0:32 {
                    isum += int(w_qs[q_base + j]) * int(xq[x_base + j])
                }
                acc += f32(isum) * (w_scales[s_off + b] * x_scales[xm_s + b])
            }
            out[out_off + r] = acc
        }
    }
}

fn matmat_q8_0_f32(out $&[]f32, x &[]f32, w_qs &[]i8, w_scales &[]f32, blk_off int, m_cnt int, rows int, cols int) {
    n_blocks := cols / 32
    for m in 0:m_cnt {
        xm_off := m * cols
        out_off := m * rows
        for r in 0:rows {
            s_off := blk_off + r * n_blocks
            q_off := s_off * 32
            $acc := f32(0)
            for b in 0:n_blocks {
                $bsum := f32(0)
                q_base := q_off + b * 32
                x_base := xm_off + b * 32
                for j in 0:32 {
                    bsum += f32(int(w_qs[q_base + j])) * x[x_base + j]
                }
                acc += bsum * w_scales[s_off + b]
            }
            out[out_off + r] = acc
        }
    }
}

// Q4_0 x Q8_0 GEMV over four-row groups with four packed bytes per row and lane.
fn matvec_q4_0_p4k4_q8_0(out $&[]f32, qs_p &[]u8, ws_p &[]u16, p4_blk_off int,
                       xq &[]i8, xs &[]f32, rows int, cols int) {
    rg_cnt := rows / 4
    nb := cols / 32
    for rg in 0:rg_cnt {
        g_off := p4_blk_off + rg * nb
        out_off := rg * 4
        for r4 in 0:4 {
            $acc := f32(0)
            for b in 0:nb {
                gb := g_off + b
                q_base := gb * 64 + r4 * 4
                x_base := b * 32
                $isum := 0
                for j in 0:16 {
                    bv := int(qs_p[q_base + (j >> 2) * 16 + (j & 3)]) ^ 136
                    q0 := (bv & 15) - 8
                    q1 := (bv >> 4) - 8
                    isum += q0 * int(xq[x_base + j]) + q1 * int(xq[x_base + 16 + j])
                }
                acc += f32(isum) * (math.float16_to_f32(int(ws_p[gb * 4 + r4])) * xs[b])
            }
            out[out_off + r4] = acc
        }
    }
}

// Canonical 4-row pre-packed Q8_0 x Q8_0 GEMV triggering linear-scan SDOT microkernel.
fn matvec_q8_0_p4k4_q8_0(out $&[]f32, qs_p &[]i8, ws_p &[]u16, p4_blk_off int,
                       xq &[]i8, xs &[]f32, rows int, cols int) {
    rg_cnt := rows / 4
    nb := cols / 32
    for rg in 0:rg_cnt {
        g_off := p4_blk_off + rg * nb
        out_off := rg * 4
        for r4 in 0:4 {
            $acc := f32(0)
            for b in 0:nb {
                gb := g_off + b
                q_base := gb * 128 + r4 * 4
                x_base := b * 32
                $isum := 0
                for j in 0:32 {
                    isum += int(qs_p[q_base + (j >> 2) * 16 + (j & 3)]) * int(xq[x_base + j])
                }
                acc += f32(isum) * (math.float16_to_f32(int(ws_p[gb * 4 + r4])) * xs[b])
            }
            out[out_off + r4] = acc
        }
    }
}

// Each row of the batch has an independent Q8 activation and output.
fn matmat_q8_0_p4k4_q8_0(out $&[]f32, qs_p &[]i8, ws_p &[]u16, p4_blk_off int,
                       xq &[]i8, xs &[]f32, m_cnt int, rows int, cols int) {
    rg_cnt := rows / 4
    nb := cols / 32
    for m in 0:m_cnt {
        xm_s := m * nb
        xm_q := xm_s * 32
        m_out := m * rows
        for rg in 0:rg_cnt {
            g_off := p4_blk_off + rg * nb
            out_off := m_out + rg * 4
            for r4 in 0:4 {
                $acc := f32(0)
                for b in 0:nb {
                    gb := g_off + b
                    q_base := gb * 128 + r4 * 4
                    x_base := xm_q + b * 32
                    $isum := 0
                    for j in 0:32 {
                        isum += int(qs_p[q_base + (j >> 2) * 16 + (j & 3)]) * int(xq[x_base + j])
                    }
                    acc += f32(isum) * (math.float16_to_f32(int(ws_p[gb * 4 + r4])) * xs[xm_s + b])
                }
                out[out_off + r4] = acc
            }
        }
    }
}

// Q4_0 x Q8_0 prefill GEMM sharing the same packed weights as GEMV.
fn matmat_q4_0_p4k4_q8_0(out $&[]f32, qs_p &[]u8, ws_p &[]u16, p4_blk_off int,
                       xq &[]i8, xs &[]f32, m_cnt int, rows int, cols int) {
    rg_cnt := rows / 4
    nb := cols / 32
    for m in 0:m_cnt {
        xm_s := m * nb
        xm_q := xm_s * 32
        m_out := m * rows
        for rg in 0:rg_cnt {
            g_off := p4_blk_off + rg * nb
            out_off := m_out + rg * 4
            for r4 in 0:4 {
                $acc := f32(0)
                for b in 0:nb {
                    gb := g_off + b
                    q_base := gb * 64 + r4 * 4
                    x_base := xm_q + b * 32
                    $isum := 0
                    for j in 0:16 {
                        bv := int(qs_p[q_base + (j >> 2) * 16 + (j & 3)]) ^ 136
                        q0 := (bv & 15) - 8
                        q1 := (bv >> 4) - 8
                        isum += q0 * int(xq[x_base + j]) + q1 * int(xq[x_base + 16 + j])
                    }
                    acc += f32(isum) * (math.float16_to_f32(int(ws_p[gb * 4 + r4])) * xs[xm_s + b])
                }
                out[out_off + r4] = acc
            }
        }
    }
}

// Decode one compact weight row at a time across the batch via #tensor zero-copy row dots.
fn matmat_compact(weights &CompactWeights, index int, out $&[]f32, x &[]f32,
                  batch int, rows int, cols int, use_q8k_act bool) int {
    kind := weights.kinds[index]
    if kind == COMPACT_Q4_K || kind == COMPACT_Q5_K || kind == COMPACT_Q6_K {
        if cols <= 0 || cols % tensor.QK_K != 0 {
            >>> errors.new("K-quant columns must be divisible by 256")
        }
        start := weights.raw_starts[index]
        nb := cols / tensor.QK_K
        $blk_bytes := tensor.Q4_K_BYTES
        if kind == COMPACT_Q5_K { blk_bytes = tensor.Q5_K_BYTES }
        else if kind == COMPACT_Q6_K { blk_bytes = tensor.Q6_K_BYTES }
        if use_q8k_act {
            $q8k_qs := alloc_i8_zeros(cols)
            $q8k_d := alloc_zeros(nb)
            $q8k_bsums := alloc_ints(nb * 16, 0)
            for m in 0:batch {
                x_off := m * cols
                base := m * rows
                _ := tensor.quantize_q8_k_row(x, x_off, $&q8k_qs, $&q8k_d, $&q8k_bsums, nb) >>>
                for r in 0:rows {
                    row_start := start + r * nb * blk_bytes
                    if kind == COMPACT_Q4_K {
                        out[base + r] = tensor.dot_q4_k_q8_k_row_f32(&weights.data, row_start, &q8k_qs, &q8k_d, &q8k_bsums, nb) >>>
                    } else if kind == COMPACT_Q5_K {
                        out[base + r] = tensor.dot_q5_k_q8_k_row_f32(&weights.data, row_start, &q8k_qs, &q8k_d, &q8k_bsums, nb) >>>
                    } else {
                        out[base + r] = tensor.dot_q6_k_q8_k_row_f32(&weights.data, row_start, &q8k_qs, &q8k_d, nb) >>>
                    }
                }
            }
        } else {
            for m in 0:batch {
                x_off := m * cols
                base := m * rows
                for r in 0:rows {
                    row_start := start + r * nb * blk_bytes
                    if kind == COMPACT_Q4_K {
                        out[base + r] = tensor.dot_q4_k_row_f32(&weights.data, row_start, x, x_off, nb) >>>
                    } else if kind == COMPACT_Q5_K {
                        out[base + r] = tensor.dot_q5_k_row_f32(&weights.data, row_start, x, x_off, nb) >>>
                    } else {
                        out[base + r] = tensor.dot_q6_k_row_f32(&weights.data, row_start, x, x_off, nb) >>>
                    }
                }
            }
        }
        << 0
    }
    if kind == COMPACT_Q5_0 || kind == COMPACT_Q8_0 {
        if cols <= 0 || cols % tensor.GGML_BLOCK_VALUES != 0 {
            >>> errors.new("quantized columns must be divisible by 32")
        }
        start := weights.raw_starts[index]
        nb := cols / tensor.GGML_BLOCK_VALUES
        $blk_bytes := tensor.Q5_0_BYTES
        if kind == COMPACT_Q8_0 { blk_bytes = tensor.Q8_0_BYTES }
        for m in 0:batch {
            x_off := m * cols
            base := m * rows
            for r in 0:rows {
                row_start := start + r * nb * blk_bytes
                if kind == COMPACT_Q5_0 {
                    out[base + r] = tensor.dot_q5_0_row_f32(&weights.data, row_start, x, x_off, nb) >>>
                } else {
                    out[base + r] = tensor.dot_q8_0_row_f32(&weights.data, row_start, x, x_off, nb) >>>
                }
            }
        }
        << 0
    }
    view := &weights.views[index]
    $row := alloc_zeros(cols)
    for r in 0:rows {
        _ := view.copy_f32(&weights.data, r * cols, cols, $&row, 0) >>>
        for b in 0:batch {
            out[b * rows + r] = dot_offset(x, b * cols, &row, 0, cols)
        }
    }
    << 0
}

fn matvec_dispatch(m &Model, use_q4 bool, use_q8 bool, use_p4 bool, use_q8_act bool,
                   out $&[]f32, x &[]f32, xq &[]i8, xs &[]f32,
                   off int, rows int, cols int) int {
    if off < 0 {
        _ := matmat_compact(&m.compact_weights, -1 - off, out, x, 1, rows, cols, m.use_q8k_act) >>>
    } else if use_q8 {
        if use_q8_act {
            if use_p4 {
                matvec_q8_0_p4k4_q8_0(out, &m.q8_p4k4_qs, &m.q8_p4k4_scales, off, xq, xs, rows, cols)
            } else {
                matvec_q8_0_q8_0(out, &m.q8_qs, &m.q8_scales, xq, xs, off, rows, cols)
            }
        } else {
            matvec_q8_0_f32(out, x, &m.q8_qs, &m.q8_scales, off, rows, cols)
        }
    } else if use_q4 {
        if use_q8_act {
            if use_p4 {
                matvec_q4_0_p4k4_q8_0(out, &m.q4_p4k4_qs, &m.q4_p4k4_scales, off, xq, xs, rows, cols)
            } else {
                matvec_q4_0_q8_0(out, &m.q4_qs, &m.q4_scales, xq, xs, off, rows, cols)
            }
        } else {
            matvec_q4_0(out, x, &m.q4_qs, &m.q4_scales, off, rows, cols)
        }
    } else {
        matvec(out, x, &m.weights, off, rows, cols)
    }
    << 0
}

fn matmat_dispatch(m &Model, use_q4 bool, use_q8 bool, use_p4 bool, use_q8_act bool,
                   out $&[]f32, x &[]f32, xq &[]i8, xs &[]f32,
                   off int, m_cnt int, rows int, cols int) int {
    if off < 0 {
        _ := matmat_compact(&m.compact_weights, -1 - off, out, x, m_cnt, rows, cols, m.use_q8k_act) >>>
    } else if use_q8 {
        if use_q8_act {
            if use_p4 {
                matmat_q8_0_p4k4_q8_0(out, &m.q8_p4k4_qs, &m.q8_p4k4_scales, off, xq, xs, m_cnt, rows, cols)
            } else {
                matmat_q8_0_q8_0(out, &m.q8_qs, &m.q8_scales, xq, xs, off, m_cnt, rows, cols)
            }
        } else {
            matmat_q8_0_f32(out, x, &m.q8_qs, &m.q8_scales, off, m_cnt, rows, cols)
        }
    } else if use_q4 {
        if use_q8_act {
            if use_p4 {
                matmat_q4_0_p4k4_q8_0(out, &m.q4_p4k4_qs, &m.q4_p4k4_scales, off, xq, xs, m_cnt, rows, cols)
            } else {
                matmat_q4_0_q8_0(out, &m.q4_qs, &m.q4_scales, xq, xs, off, m_cnt, rows, cols)
            }
        } else {
            matmat_q4_0(out, x, &m.q4_qs, &m.q4_scales, off, m_cnt, rows, cols)
        }
    } else {
        matmat_f32(out, x, &m.weights, off, m_cnt, rows, cols)
    }
    << 0
}

fn dot_offset(a &[]f32, off_a int, b &[]f32, off_b int, n int) f32 {
    $acc := f32(0)
    for i in 0:n {
        acc += a[off_a + i] * b[off_b + i]
    }
    << acc
}

fn axpy_offset(dst $&[]f32, off_d int, src &[]f32, off_s int, alpha f32, n int) {
    for i in 0:n {
        dst[off_d + i] += alpha * src[off_s + i]
    }
}

fn vadd_inplace(dst $&[]f32, src &[]f32, n int) {
    for i in 0:n {
        dst[i] += src[i]
    }
}

fn apply_head_rmsnorm(vec $&[]f32, vec_base int, n_heads int, head_dim int,
                      weight &[]f32, eps f64) {
    for h in 0:n_heads {
        off := vec_base + h * head_dim
        $sum := f32(0)
        for j in 0:head_dim {
            v := vec[off + j]
            sum += v * v
        }
        inv := f32(1.0 / math.sqrt(f64(sum) / f64(head_dim) + eps))
        for j in 0:head_dim {
            vec[off + j] = (vec[off + j] * inv) * weight[j]
        }
    }
}

fn apply_rope_offset(vec $&[]f32, vec_base int, n_heads int, head_dim int, rope_dim int,
                     interleaved bool, pos int, rope_theta f64, rope_freq_scale f64,
                     cos_tbl &[]f32, sin_tbl &[]f32, rope_off int) {
    half := rope_dim / 2
    if interleaved {
        if vec_base == 0 && rope_dim == head_dim && rope_freq_scale == 1.0 {
            tensor.rope_interleaved_f32(vec, n_heads, head_dim, pos, rope_theta)
            <<
        }
        for h in 0:n_heads {
            h_off := vec_base + h * head_dim
            for j in 0:half {
                c := cos_tbl[rope_off + j]
                s := sin_tbl[rope_off + j]
                i0 := h_off + 2 * j
                v0 := vec[i0]
                v1 := vec[i0 + 1]
                vec[i0] = f32(v0 * c - v1 * s)
                vec[i0 + 1] = f32(v0 * s + v1 * c)
            }
        }
        <<
    }
    for h in 0:n_heads {
        h_off := vec_base + h * head_dim
        h_off1 := h_off + half
        for j in 0:half {
            c := cos_tbl[rope_off + j]
            s := sin_tbl[rope_off + j]
            v0 := vec[h_off + j]
            v1 := vec[h_off1 + j]
            vec[h_off + j] = f32(v0 * c - v1 * s)
            vec[h_off1 + j] = f32(v0 * s + v1 * c)
        }
    }
}

fn argmax_at(logits &[]f32, off int, n int) int {
    $best_i := 0
    $best_v := logits[off]
    for i in 1:n {
        v := logits[off + i]
        if v > best_v {
            best_v = v
            best_i = i
        }
    }
    << best_i
}

fn argmax(logits &[]f32, n int) int {
    << argmax_at(logits, 0, n)
}

fn apply_logit_softcap(logits $&[]f32, off int, n int, cap f64) {
    if cap <= 0.0 { << }
    for i in 0:n {
        logits[off + i] = f32(cap * math.tanh(f64(logits[off + i]) / cap))
    }
}

fn sample_token_at(logits $&[]f32, log_off int, n int, history &[]int, temp_milli int, top_k int,
                   top_p_milli int, min_p_milli int, repeat_penalty_milli int,
                   presence_penalty_milli int, frequency_penalty_milli int, rng $&int) int {
    if (repeat_penalty_milli > 1000 || presence_penalty_milli != 0 || frequency_penalty_milli != 0) && history.len > 0 {
        $counts := map[int]int{}
        $unique := []int{}
        for i in 0:history.len {
            tok := history[i]
            if tok < 0 || tok >= n { -> }
            prev := counts.get_or(tok, 0)
            if prev == 0 { unique.push(tok) }
            counts[tok] = prev + 1
        }
        penalty := f32(f64(repeat_penalty_milli) / 1000.0)
        pres := f64(presence_penalty_milli) / 1000.0
        freq := f64(frequency_penalty_milli) / 1000.0
        for ui in 0:unique.len {
            tok := unique[ui]
            idx := log_off + tok
            cnt := counts.get_or(tok, 0)
            if repeat_penalty_milli > 1000 {
                if logits[idx] > f32(0) {
                    logits[idx] = logits[idx] / penalty
                } else {
                    logits[idx] = logits[idx] * penalty
                }
            }
            if presence_penalty_milli != 0 {
                logits[idx] = f32(f64(logits[idx]) - pres)
            }
            if frequency_penalty_milli != 0 {
                logits[idx] = f32(f64(logits[idx]) - freq * f64(cnt))
            }
        }
    }
    if temp_milli <= 0 || top_k == 1 {
        << argmax_at(logits, log_off, n)
    }
    $k := top_k
    if k <= 0 || k > n { k = n }
    $top_idx := []int{}
    $top_val := []f32{}
    if k < n {
        top_idx.reserve(k)
        top_val.reserve(k)
        for _ in 0:k {
            top_idx.push(-1)
            top_val.push(f32(-1e30))
        }
        for i in 0:n {
            v := logits[log_off + i]
            if v > top_val[k - 1] {
                $pos := k - 1
                while pos > 0 && v > top_val[pos - 1] {
                    top_val[pos] = top_val[pos - 1]
                    top_idx[pos] = top_idx[pos - 1]
                    pos -= 1
                }
                top_val[pos] = v
                top_idx[pos] = i
            }
        }
    } else {
        top_idx.reserve(n)
        top_val.reserve(n)
        $best_i := 0
        $best_v := logits[log_off]
        for i in 0:n {
            v := logits[log_off + i]
            top_idx.push(i)
            top_val.push(v)
            if v > best_v {
                best_v = v
                best_i = i
            }
        }
        if best_i != 0 {
            top_idx[0] = best_i
            top_val[0] = best_v
            top_idx[best_i] = 0
            top_val[best_i] = logits[log_off]
        }
    }
    t_scale := f64(temp_milli) / 1000.0
    max_v := f64(top_val[0])
    $probs := []f64{}
    probs.reserve(k)
    $sum_p := 0.0
    for j in 0:k {
        if top_idx[j] < 0 {
            probs.push(0.0)
        } else {
            p := math.exp((f64(top_val[j]) - max_v) / t_scale)
            probs.push(p)
            sum_p += p
        }
    }
    if min_p_milli > 0 && sum_p > 0.0 {
        min_thresh := probs[0] * (f64(min_p_milli) / 1000.0)
        $kept_min := 0.0
        for j in 0:k {
            if j > 0 && probs[j] < min_thresh {
                probs[j] = 0.0
            } else {
                kept_min += probs[j]
            }
        }
        sum_p = kept_min
    }
    if top_p_milli > 0 && top_p_milli < 1000 && sum_p > 0.0 {
        if k == n {
            // Ensure descending order when evaluating nucleus over the full vocabulary.
            for i in 1:k {
                kv := probs[i]
                ki := top_idx[i]
                $j := i - 1
                while j >= 0 && probs[j] < kv {
                    probs[j + 1] = probs[j]
                    top_idx[j + 1] = top_idx[j]
                    j -= 1
                }
                probs[j + 1] = kv
                top_idx[j + 1] = ki
            }
        }
        p_cut := f64(top_p_milli) / 1000.0
        $cum := 0.0
        $kept_sum := 0.0
        $cutoff := k
        for j in 0:k {
            if top_idx[j] < 0 || probs[j] <= 0.0 { <- }
            cum += probs[j] / sum_p
            kept_sum += probs[j]
            if cum >= p_cut {
                cutoff = j + 1
                <-
            }
        }
        for j in cutoff:k { probs[j] = 0.0 }
        sum_p = kept_sum
    }
    $s := (*rng * 6364136223846793005 + 1442695040888963407) & 0x7fffffffffffffff
    *rng = s
    u := f64((s >> 16) & 0xffffffff) / 4294967296.0
    target := u * sum_p
    $cdf := 0.0
    for j in 0:k {
        if top_idx[j] >= 0 && probs[j] > 0.0 {
            cdf += probs[j]
            if cdf >= target { << top_idx[j] }
        }
    }
    << top_idx[0]
}

fn sample_token(logits $&[]f32, n int, history &[]int, temp_milli int, top_k int,
                top_p_milli int, min_p_milli int, repeat_penalty_milli int,
                presence_penalty_milli int, frequency_penalty_milli int, rng $&int) int {
    << sample_token_at(logits, 0, n, history, temp_milli, top_k, top_p_milli, min_p_milli, repeat_penalty_milli, presence_penalty_milli, frequency_penalty_milli, rng)
}

fn attention_scores_paged(q &[]f32, keys &[]f32, bt &[]int, scores $&[]f32,
                          q_off int, bt_off int, block_stride int, kv_base int, kv_dim int,
                          head_dim int, seq_len int) {
    for t in 0:seq_len {
        pb := bt[bt_off + (t >> 4)]
        k_off := pb * block_stride + kv_base + (t & 15) * kv_dim
        $sum := f32(0)
        for j in 0:head_dim {
            sum += q[q_off + j] * keys[k_off + j]
        }
        scores[t] = sum
    }
}

fn softmax_scaled(scores $&[]f32, seq_len int, scale f32) {
    $max_v := scores[0] * scale
    scores[0] = max_v
    for t in 1:seq_len {
        v := scores[t] * scale
        scores[t] = v
        if v > max_v { max_v = v }
    }
    $sum_v := 0.0
    for t in 0:seq_len {
        ew := f32(math.exp(f64(scores[t] - max_v)))
        scores[t] = ew
        sum_v += f64(ew)
    }
    inv := f32(1.0 / sum_v)
    for t in 0:seq_len {
        scores[t] = scores[t] * inv
    }
}

fn attn_vsum_paged(out $&[]f32, scores &[]f32, v_blocks &[]f32, bt &[]int,
                   out_off int, bt_off int, block_stride int, kv_base_off int, kv_dim int,
                   head_dim int, seq_len int) {
    for d in 0:head_dim { out[out_off + d] = f32(0) }
    for t in 0:seq_len {
        w := scores[t]
        t_pb := bt[bt_off + (t >> 4)]
        v_off := t_pb * block_stride + kv_base_off + (t & 15) * kv_dim
        for d in 0:head_dim {
            out[out_off + d] += w * v_blocks[v_off + d]
        }
    }
}

fn kv_write(kv $&PagedKvCache, destination int, keys &[]f32, values &[]f32, source int, count int) {
    if kv.storage_width == 4 {
        for i in 0:count {
            kv.k_blocks[destination + i] = keys[source + i]
            kv.v_blocks[destination + i] = values[source + i]
        }
    } else if kv.storage_width == 2 {
        for i in 0:count {
            kv.compact_k16[destination + i] = u16(kv.dtype.encode_bits(keys[source + i]))
            kv.compact_v16[destination + i] = u16(kv.dtype.encode_bits(values[source + i]))
        }
    } else {
        for i in 0:count {
            kv.compact_k8[destination + i] = u8(kv.dtype.encode_bits(keys[source + i]))
            kv.compact_v8[destination + i] = u8(kv.dtype.encode_bits(values[source + i]))
        }
    }
}

fn kv_key_dot(kv &PagedKvCache, keys_offset int, q &[]f32, q_offset int, count int) f32 {
    if kv.storage_width == 4 { << dot_offset(q, q_offset, &kv.k_blocks, keys_offset, count) }
    $acc := f32(0)
    if kv.storage_width == 2 {
        for i in 0:count {
            key := kv.dtype.decode_bits(int(kv.compact_k16[keys_offset + i]))
            acc += q[q_offset + i] * key
        }
    } else {
        for i in 0:count {
            key := kv.dtype.decode_bits(int(kv.compact_k8[keys_offset + i]))
            acc += q[q_offset + i] * key
        }
    }
    << acc
}

fn kv_value_at(kv &PagedKvCache, index int) f32 {
    if kv.storage_width == 4 { << kv.v_blocks[index] }
    if kv.storage_width == 2 { << kv.dtype.decode_bits(int(kv.compact_v16[index])) }
    << kv.dtype.decode_bits(int(kv.compact_v8[index]))
}

fn kv_add_values(kv &PagedKvCache, off int, out $&[]f32, out_off int, weight f32, count int) {
    if kv.storage_width == 4 {
        axpy_offset(out, out_off, &kv.v_blocks, off, weight, count)
        <<
    }
    for i in 0:count {
        out[out_off + i] += weight * kv_value_at(kv, off + i)
    }
}

fn softcap_attn_score(raw f32, inv_sqrt_d f32, cap f64) f64 {
    s := f64(raw * inv_sqrt_d)
    if cap > 0.0 {
        << cap * math.tanh(s / cap)
    }
    << s
}

// Reuse the feed-forward scratch for attention scores until the FFN starts.
fn attention_head(kv &PagedKvCache, q &[]f32, xb $&[]f32, scores $&[]f32, q_off int, kv_head_off int,
                  bt_slot_off int, layer_off int, t0_pb int, pos int, head_dim int, inv_sqrt_d f32,
                  sliding_window int, attn_softcap f64) {
    one_f32 := f32(1.0)
    $win_start := 0
    if sliding_window > 0 && pos >= sliding_window {
        win_start = pos - sliding_window + 1
    }
    arch := xu_target_arch()
    if win_start == 0 && attn_softcap <= 0.0 && kv.storage_width == 4 && (arch == ARCH_ARM64 || arch == ARCH_X64) &&
       head_dim > 0 && (head_dim % 4) == 0 && pos >= 4 && pos < scores.len {
        attention_scores_paged(q, &kv.k_blocks, &kv.block_tables, scores, q_off,
                               bt_slot_off, kv.block_stride, layer_off + kv_head_off, kv.kv_dim, head_dim, pos + 1)
        softmax_scaled(scores, pos + 1, inv_sqrt_d)
        attn_vsum_paged(xb, scores, &kv.v_blocks, &kv.block_tables, q_off,
                        bt_slot_off, kv.block_stride, layer_off + kv_head_off, kv.kv_dim, head_dim, pos + 1)
        <<
    }
    $w0_pb := t0_pb
    $w0_in := 0
    if win_start > 0 {
        w0_pb = kv.block_tables[bt_slot_off + (win_start / KV_BLOCK_SIZE)]
        w0_in = win_start % KV_BLOCK_SIZE
    }
    k0_off := w0_pb * kv.block_stride + layer_off + kv_head_off + w0_in * kv.kv_dim
    score0 := kv_key_dot(kv, k0_off, q, q_off, head_dim)
    $m_val := softcap_attn_score(score0, inv_sqrt_d, attn_softcap)
    $l_val := 1.0
    for d in 0:head_dim {
        xb[q_off + d] = kv_value_at(kv, k0_off + d)
    }
    // Initial window token seeds the online softmax. Visit remaining keys in order.
    $first := win_start + 1
    while first <= pos {
        page := first / KV_BLOCK_SIZE
        in_page := first % KV_BLOCK_SIZE
        $count := KV_BLOCK_SIZE - in_page
        remaining := pos - first + 1
        if count > remaining { count = remaining }
        pb := kv.block_tables[bt_slot_off + page]
        base := pb * kv.block_stride + layer_off + kv_head_off + in_page * kv.kv_dim
        for i in 0:count {
            kv_t_off := base + i * kv.kv_dim
            raw_score := kv_key_dot(kv, kv_t_off, q, q_off, head_dim)
            score := softcap_attn_score(raw_score, inv_sqrt_d, attn_softcap)
            if score > m_val {
                alpha := f32(fast_exp_neg(m_val - score))
                for d in 0:head_dim {
                    xb[q_off + d] = xb[q_off + d] * alpha
                }
                l_val = l_val * f64(alpha) + 1.0
                m_val = score
                kv_add_values(kv, kv_t_off, xb, q_off, one_f32, head_dim)
            } else {
                w := f32(fast_exp_neg(score - m_val))
                l_val = l_val + f64(w)
                kv_add_values(kv, kv_t_off, xb, q_off, w, head_dim)
            }
        }
        first += count
    }
    inv_l := f32(1.0 / l_val)
    for d in 0:head_dim {
        xb[q_off + d] = xb[q_off + d] * inv_l
    }
}

fn apply_ffn_activation(hb $&[]f32, hb2 &[]f32, n int, use_geglu bool) {
    if use_geglu {
        $tmp := alloc_zeros(n)
        tensor.geglu_f32($&tmp, hb, hb2, n)
        for i in 0:n { hb[i] = tmp[i] }
        <<
    }
    for i in 0:n {
        g := hb[i]
        silu := f32(f64(g) / (1.0 + math.exp(f64(-g))))
        hb[i] = silu * hb2[i]
    }
}

fn forward_moe_ffn_row(m &Model, l int, x_src &[]f32, src_off int, out_dst $&[]f32, dst_off int,
                       hb $&[]f32, hb2 $&[]f32, e_out $&[]f32,
                       xq $&[]i8, xs $&[]f32, use_q8_act bool) int {
    cfg := &m.cfg
    dim := cfg.dim
    n_exp := cfg.expert_count
    k_used := cfg.expert_used_count
    exp_h := cfg.expert_hidden_dim
    sh_h := cfg.shared_expert_hidden_dim
    use_q4 := m.is_q4
    use_q8 := m.is_q8

    $x_row := []f32{}
    x_row.reserve(dim)
    for i in 0:dim {
        x_row.push(x_src[src_off + i])
        out_dst[dst_off + i] = f32(0)
    }

    $router_logits := alloc_zeros(n_exp)
    _ := matvec_dispatch(m, false, false, false, false, $&router_logits, &x_row, xq, xs, m.moe_gate_inp_off[l], n_exp, dim) >>>
    use_sigmoid := cfg.expert_gating_func == 2
    $top_idx := []int{}
    $top_w := []f32{}
    for _ in 0:k_used {
        top_idx.push(0)
        top_w.push(f32(0))
    }
    picked := tensor.moe_router_f32(&router_logits, n_exp, k_used, use_sigmoid, cfg.expert_weights_norm, cfg.expert_weights_scale, &m.moe_exp_probs_bias[l], $&top_idx, $&top_w)

    if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(&x_row, xq, xs, dim) }
    w1_exps := &m.moe_w1_off[l]
    w2_exps := &m.moe_w2_off[l]
    w3_exps := &m.moe_w3_off[l]
    for ei in 0:picked {
        if ei > 0 && (use_q4 || use_q8) && use_q8_act { quantize_q8_0(&x_row, xq, xs, dim) }
        e := top_idx[ei]
        ew := top_w[ei]
        _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, hb, &x_row, xq, xs, w1_exps[e], exp_h, dim) >>>
        _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, hb2, &x_row, xq, xs, w3_exps[e], exp_h, dim) >>>
        apply_ffn_activation(hb, hb2, exp_h, cfg.use_geglu)
        if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(hb, xq, xs, exp_h) }
        _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, e_out, hb, xq, xs, w2_exps[e], dim, exp_h) >>>
        axpy_offset(out_dst, dst_off, e_out, 0, ew, dim)
    }

    if m.moe_has_shared[l] {
        if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(&x_row, xq, xs, dim) }
        _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, hb, &x_row, xq, xs, m.moe_sh_w1_off[l], sh_h, dim) >>>
        _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, hb2, &x_row, xq, xs, m.moe_sh_w3_off[l], sh_h, dim) >>>
        apply_ffn_activation(hb, hb2, sh_h, cfg.use_geglu)
        if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(hb, xq, xs, sh_h) }
        _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, e_out, hb, xq, xs, m.moe_sh_w2_off[l], dim, sh_h) >>>
        $sh_scale := f32(1.0)
        if m.moe_has_sh_gate[l] {
            $sg := [f32(0)]
            _ := matvec_dispatch(m, false, false, false, false, $&sg, &x_row, xq, xs, m.moe_sh_gate_inp_off[l], 1, dim) >>>
            sh_scale = f32(1.0 / (1.0 + math.exp(-f64(sg[0]))))
        }
        axpy_offset(out_dst, dst_off, e_out, 0, sh_scale, dim)
    }
    << 0
}

fn apply_lora_rows(out $&[]f32, x &[]f32, x_off int, out_off int, m_cnt int,
                   out_dim int, in_dim int, lp &LoraPair) {
    if lp.rank <= 0 || m_cnt <= 0 || out_dim <= 0 || in_dim <= 0 { << }
    if m_cnt == 1 && x_off == 0 && out_off == 0 && out.len >= out_dim && x.len >= in_dim {
        tensor.lora_add_f32(out, x, &lp.a, &lp.b, out_dim, in_dim, lp.rank, lp.scale)
        <<
    }
    $xr := alloc_zeros(in_dim)
    $yr := alloc_zeros(out_dim)
    for m in 0:m_cnt {
        xb := x_off + m * in_dim
        ob := out_off + m * out_dim
        for j in 0:in_dim { xr[j] = x[xb + j] }
        for i in 0:out_dim { yr[i] = out[ob + i] }
        tensor.lora_add_f32($&yr, &xr, &lp.a, &lp.b, out_dim, in_dim, lp.rank, lp.scale)
        for i in 0:out_dim { out[ob + i] = yr[i] }
    }
}

fn project_next_token(m &Model, x &[]f32, xb $&[]f32, xb2 &[]f32,
                      xq $&[]i8, xs $&[]f32, logits $&[]f32, use_q8_act bool) int {
    cfg := &m.cfg
    dim := cfg.dim
    eps := cfg.rms_eps
    rmsnorm_add_fused(dim, x, xb2, &m.final_norm, xb, eps)
    if (m.lm_head_q4 || m.lm_head_q8) && use_q8_act { quantize_q8_0(xb, xq, xs, dim) }
    _ := matvec_dispatch(m, m.lm_head_q4, m.lm_head_q8, m.lm_head_p4, use_q8_act, logits, xb, xq, xs, m.lm_head_off, cfg.vocab_size, dim) >>>
    if m.lora.active { apply_lora_rows(logits, xb, 0, 0, 1, cfg.vocab_size, dim, &m.lora.lm_head) }
    apply_logit_softcap(logits, 0, cfg.vocab_size, cfg.logit_softcap)
    << argmax(logits, cfg.vocab_size)
}

fn forward_mla_compute_q_row(m &Model, l int, x_row &[]f32, q_out $&[]f32, q_off int,
                              pos int, use_q8_act bool, xq $&[]i8, xs $&[]f32) int {
    cfg := &m.cfg
    dim := cfg.dim
    n_heads := cfg.n_heads
    qk_nope := cfg.qk_nope_head_dim
    qk_rope := cfg.qk_rope_head_dim
    qk_hd := qk_nope + qk_rope
    head_dim := cfg.head_dim
    q_dim := cfg.q_dim
    use_q4 := m.is_q4
    use_q8 := m.is_q8
    $q_tmp := alloc_zeros(q_dim)
    if m.mla_has_qlora[l] {
        q_rank := cfg.q_lora_rank
        $q_lat := alloc_zeros(q_rank)
        $q_lat_n := alloc_zeros(q_rank)
        $z_rank := alloc_zeros(q_rank)
        if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(x_row, xq, xs, dim) }
        _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, $&q_lat, x_row, xq, xs, m.mla_qa_off[l], q_rank, dim) >>>
        rmsnorm_add_fused(q_rank, &q_lat, &z_rank, &m.mla_qa_norm[l], $&q_lat_n, cfg.rms_eps)
        if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(&q_lat_n, xq, xs, q_rank) }
        _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, $&q_tmp, &q_lat_n, xq, xs, m.mla_qb_off[l], q_dim, q_rank) >>>
    } else {
        if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(x_row, xq, xs, dim) }
        _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, $&q_tmp, x_row, xq, xs, m.wq_off[l], q_dim, dim) >>>
    }
    rope_off := pos * (qk_rope / 2)
    for h in 0:n_heads {
        src_h := h * qk_hd
        dst_h := q_off + h * head_dim
        apply_rope_offset($&q_tmp, src_h + qk_nope, 1, qk_rope, qk_rope, cfg.rope_interleaved, pos, cfg.rope_theta, cfg.rope_freq_scale, &m.rope_cos, &m.rope_sin, rope_off)
        for j in 0:qk_hd {
            q_out[dst_h + j] = q_tmp[src_h + j]
        }
        for j in qk_hd:head_dim {
            q_out[dst_h + j] = f32(0)
        }
    }
    << 0
}

fn forward_mla_qkv_row(m &Model, l int, x_src &[]f32, src_off int,
                       q_out $&[]f32, q_off int, k_out $&[]f32, k_off int, v_out $&[]f32, v_off int,
                       pos int, compute_q bool, use_q8_act bool, xq $&[]i8, xs $&[]f32) int {
    cfg := &m.cfg
    dim := cfg.dim
    n_heads := cfg.n_heads
    head_dim := cfg.head_dim
    kv_rank := cfg.kv_lora_rank
    qk_nope := cfg.qk_nope_head_dim
    qk_rope := cfg.qk_rope_head_dim
    qk_hd := qk_nope + qk_rope
    v_hd := cfg.v_head_dim
    use_q4 := m.is_q4
    use_q8 := m.is_q8

    $x_row := []f32{}
    x_row.reserve(dim)
    for i in 0:dim { x_row.push(x_src[src_off + i]) }
    if compute_q {
        _ := forward_mla_compute_q_row(m, l, &x_row, q_out, q_off, pos, use_q8_act, xq, xs) >>>
    }
    kva_dim := kv_rank + qk_rope
    $kv_a := alloc_zeros(kva_dim)
    if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(&x_row, xq, xs, dim) }
    _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, $&kv_a, &x_row, xq, xs, m.mla_kva_off[l], kva_dim, dim) >>>

    $c_kv := alloc_zeros(kv_rank)
    $c_kv_n := alloc_zeros(kv_rank)
    $z_kv := alloc_zeros(kv_rank)
    for i in 0:kv_rank { c_kv[i] = kv_a[i] }
    rmsnorm_add_fused(kv_rank, &c_kv, &z_kv, &m.mla_kva_norm[l], $&c_kv_n, cfg.rms_eps)

    $k_rope := alloc_zeros(qk_rope)
    for i in 0:qk_rope { k_rope[i] = kv_a[kv_rank + i] }
    rope_off := pos * (qk_rope / 2)
    apply_rope_offset($&k_rope, 0, 1, qk_rope, qk_rope, cfg.rope_interleaved, pos, cfg.rope_theta, cfg.rope_freq_scale, &m.rope_cos, &m.rope_sin, rope_off)

    kvb_dim := n_heads * (qk_nope + v_hd)
    $kv_b := alloc_zeros(kvb_dim)
    if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(&c_kv_n, xq, xs, kv_rank) }
    _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, $&kv_b, &c_kv_n, xq, xs, m.mla_kvb_off[l], kvb_dim, kv_rank) >>>

    for h in 0:n_heads {
        sb := h * (qk_nope + v_hd)
        db := h * head_dim
        for j in 0:qk_nope { k_out[k_off + db + j] = kv_b[sb + j] }
        for j in 0:qk_rope { k_out[k_off + db + qk_nope + j] = k_rope[j] }
        for j in qk_hd:head_dim { k_out[k_off + db + j] = f32(0) }
        for j in 0:v_hd { v_out[v_off + db + j] = kv_b[sb + qk_nope + j] }
        for j in v_hd:head_dim { v_out[v_off + db + j] = f32(0) }
    }
    << 0
}

fn compact_mla_attn_rows(xb $&[]f32, row_cnt int, n_heads int, head_dim int, v_hd int) {
    if v_hd == head_dim { << }
    v_row := n_heads * v_hd
    h_row := n_heads * head_dim
    for t in 0:row_cnt {
        src_row := t * h_row
        dst_row := t * v_row
        for h in 0:n_heads {
            sh := src_row + h * head_dim
            dh := dst_row + h * v_hd
            for j in 0:v_hd {
                xb[dh + j] = xb[sh + j]
            }
        }
    }
}

fn forward_token_hidden(m &Model, kv $&PagedKvCache,
                        x $&[]f32, xb $&[]f32, xb2 $&[]f32,
                        q $&[]f32, k $&[]f32, v $&[]f32,
                        hb $&[]f32, hb2 $&[]f32,
                        xq $&[]i8, xs $&[]f32,
                        slot int, token int, pos int, use_q8_act bool) int {
    cfg := &m.cfg
    dim := cfg.dim
    hidden := cfg.hidden_dim
    head_dim := cfg.head_dim
    kv_dim := cfg.kv_dim
    n_heads := cfg.n_heads
    kv_mul := n_heads / cfg.n_kv_heads
    half := cfg.rope_dim / 2
    rope_off := pos * half
    eps := cfg.rms_eps
    use_q4 := m.is_q4
    use_q8 := m.is_q8
    $wo_cols := dim
    $scale_d := head_dim
    if m.is_mla {
        wo_cols = n_heads * cfg.v_head_dim
        scale_d = cfg.qk_nope_head_dim + cfg.qk_rope_head_dim
    }

    pb := kv_ensure_block(kv, slot, pos) >>>
    in_blk := pos & 15
    pb_base := pb * kv.block_stride + in_blk * kv.kv_dim
    bt_slot_off := slot * kv.blocks_per_seq

    _ := load_embed_row(m, token, x, 0) >>>
    inv_sqrt_d := f32(1.0 / math.sqrt(f64(scale_d)))

    for l in 0:cfg.n_layers {
        rmsnorm_add_fused(dim, x, &m.zeros, &m.attn_norms[l], xb, eps)

        if m.is_mla {
            _ := forward_mla_qkv_row(m, l, xb, 0, q, 0, k, 0, v, 0, pos, true, use_q8_act, xq, xs) >>>
        } else {
            if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(xb, xq, xs, dim) }
            _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, q, xb, xq, xs, m.wq_off[l], dim, dim) >>>
            _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, k, xb, xq, xs, m.wk_off[l], kv_dim, dim) >>>
            _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, v, xb, xq, xs, m.wv_off[l], kv_dim, dim) >>>
            if m.lora.active {
                apply_lora_rows(q, xb, 0, 0, 1, dim, dim, &m.lora.q[l])
                apply_lora_rows(k, xb, 0, 0, 1, kv_dim, dim, &m.lora.k[l])
                apply_lora_rows(v, xb, 0, 0, 1, kv_dim, dim, &m.lora.v[l])
            }
            if m.has_qkv_bias {
                vadd_inplace(q, &m.bq[l], dim)
                vadd_inplace(k, &m.bk[l], kv_dim)
                vadd_inplace(v, &m.bv[l], kv_dim)
            }
            if m.has_qk_norm {
                apply_head_rmsnorm(q, 0, n_heads, head_dim, &m.q_norms[l], eps)
                apply_head_rmsnorm(k, 0, cfg.n_kv_heads, head_dim, &m.k_norms[l], eps)
            }

            apply_rope_offset(q, 0, n_heads, head_dim, cfg.rope_dim, cfg.rope_interleaved, pos, cfg.rope_theta, cfg.rope_freq_scale, &m.rope_cos, &m.rope_sin, rope_off)
            apply_rope_offset(k, 0, cfg.n_kv_heads, head_dim, cfg.rope_dim, cfg.rope_interleaved, pos, cfg.rope_theta, cfg.rope_freq_scale, &m.rope_cos, &m.rope_sin, rope_off)
        }

        kv_write_off := pb_base + l * kv.layer_stride
        kv_write(kv, kv_write_off, k, v, 0, kv_dim)

        layer_off := l * kv.layer_stride
        t0_pb := kv.block_tables[bt_slot_off]
        for h in 0:n_heads {
            q_off := h * head_dim
            kv_head_off := (h / kv_mul) * head_dim
            attention_head(kv, q, xb, hb, q_off, kv_head_off, bt_slot_off, layer_off, t0_pb, pos, head_dim, inv_sqrt_d, cfg.sliding_window, cfg.attn_logit_softcap)
        }
        if m.is_mla {
            compact_mla_attn_rows(xb, 1, n_heads, head_dim, cfg.v_head_dim)
        }

        if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(xb, xq, xs, wo_cols) }
        _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, xb2, xb, xq, xs, m.wo_off[l], dim, wo_cols) >>>
        if m.lora.active { apply_lora_rows(xb2, xb, 0, 0, 1, dim, wo_cols, &m.lora.o[l]) }
        if m.has_post_norms {
            rmsnorm_add_fused(dim, xb2, &m.zeros, &m.post_attn_norms[l], xb, eps)
            for i in 0:dim { xb2[i] = xb[i] }
        }
        vadd_inplace(x, xb2, dim)

        rmsnorm_add_fused(dim, x, &m.zeros, &m.ffn_norms[l], xb, eps)
        if m.is_moe && m.moe_layer[l] {
            _ := forward_moe_ffn_row(m, l, xb, 0, xb2, 0, hb, hb2, q, xq, xs, use_q8_act) >>>
        } else {
            if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(xb, xq, xs, dim) }
            _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, hb, xb, xq, xs, m.w1_off[l], hidden, dim) >>>
            _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, hb2, xb, xq, xs, m.w3_off[l], hidden, dim) >>>
            if m.lora.active {
                apply_lora_rows(hb, xb, 0, 0, 1, hidden, dim, &m.lora.w1[l])
                apply_lora_rows(hb2, xb, 0, 0, 1, hidden, dim, &m.lora.w3[l])
            }
            apply_ffn_activation(hb, hb2, hidden, cfg.use_geglu)
            if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(hb, xq, xs, hidden) }
            _ := matvec_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, xb2, hb, xq, xs, m.w2_off[l], dim, hidden) >>>
            if m.lora.active { apply_lora_rows(xb2, hb, 0, 0, 1, dim, hidden, &m.lora.w2[l]) }
        }
        if m.has_post_norms {
            rmsnorm_add_fused(dim, xb2, &m.zeros, &m.post_ffn_norms[l], xb, eps)
            for i in 0:dim { xb2[i] = xb[i] }
        }
        if l + 1 < cfg.n_layers {
            vadd_inplace(x, xb2, dim)
        }
    }

    rmsnorm_add_fused(dim, x, xb2, &m.final_norm, xb, eps)
    << 0
}

fn forward_token(m &Model, kv $&PagedKvCache,
                 x $&[]f32, xb $&[]f32, xb2 $&[]f32,
                 q $&[]f32, k $&[]f32, v $&[]f32,
                 hb $&[]f32, hb2 $&[]f32, logits $&[]f32,
                 xq $&[]i8, xs $&[]f32,
                 slot int, token int, pos int, use_q8_act bool) int {
    _ := forward_token_hidden(m, kv, x, xb, xb2, q, k, v, hb, hb2, xq, xs, slot, token, pos, use_q8_act) >>>
    dim := m.cfg.dim
    if (m.lm_head_q4 || m.lm_head_q8) && use_q8_act { quantize_q8_0(xb, xq, xs, dim) }
    _ := matvec_dispatch(m, m.lm_head_q4, m.lm_head_q8, m.lm_head_p4, use_q8_act, logits, xb, xq, xs, m.lm_head_off, m.cfg.vocab_size, dim) >>>
    if m.lora.active { apply_lora_rows(logits, xb, 0, 0, 1, m.cfg.vocab_size, dim, &m.lora.lm_head) }
    apply_logit_softcap(logits, 0, m.cfg.vocab_size, m.cfg.logit_softcap)
    << argmax(logits, m.cfg.vocab_size)
}

fn compute_embedding_slot(m &Model, kv $&PagedKvCache,
                          x $&[]f32, xb $&[]f32, xb2 $&[]f32,
                          q $&[]f32, k $&[]f32, v $&[]f32,
                          hb $&[]f32, hb2 $&[]f32,
                          xq $&[]i8, xs $&[]f32,
                          slot int, prompt_ids &[]int) []f32 {
    dim := m.cfg.dim
    $sum_vec := alloc_zeros(dim)
    $count := 0
    for pos in 0:prompt_ids.len {
        if pos >= m.cfg.max_seq_len { <- }
        _ := forward_token_hidden(m, kv, x, xb, xb2, q, k, v, hb, hb2, xq, xs, slot, prompt_ids[pos], pos, true) >>> (err) {
            kv_free_slot(kv, slot)
            >>> err
        }
        for i in 0:dim {
            sum_vec[i] += xb[i]
        }
        count += 1
    }
    kv_free_slot(kv, slot)
    if count > 0 {
        inv_cnt := f32(1.0 / f64(count))
        for i in 0:dim {
            sum_vec[i] = sum_vec[i] * inv_cnt
        }
    }
    $out := alloc_zeros(dim)
    tensor.l2_normalize_f32($&out, &sum_vec, dim, 1e-12)
    << out
}

fn prepare_forward_row(kv $&PagedKvCache, slot int, pos int) ForwardRow {
    block := kv_ensure_block(kv, slot, pos) >>>
    << ForwardRow{
        pos: pos,
        kv_offset: block * kv.block_stride + (pos % KV_BLOCK_SIZE) * kv.kv_dim,
        table_offset: slot * kv.blocks_per_seq
    }
}

fn rmsnorm_forward_rows(m &Model, count int, x &[]f32, weight &[]f32, out $&[]f32,
                       input_row $&[]f32, output_row $&[]f32, decoding bool) {
    dim := m.cfg.dim
    eps := m.cfg.rms_eps
    if !decoding {
        rmsnorm_batch(dim, count, x, weight, out, eps)
        <<
    }
    // Match the single-token norm's floating-point reduction order.
    for t in 0:count {
        offset := t * dim
        for i in 0:dim { input_row[i] = x[offset + i] }
        rmsnorm_add_fused(dim, input_row, &m.zeros, weight, output_row, eps)
        for i in 0:dim { out[offset + i] = output_row[i] }
    }
}

// Each row has its own causal position and KV table. Prefill may consume
// only its final row, while a decode batch consumes every row.
fn forward_rows(m &Model, kv $&PagedKvCache, rows &[]ForwardRow, m_cnt int,
                final_start int, final_count int, use_q8_act bool, decoding bool,
                x $&[]f32, xb $&[]f32, xb2 $&[]f32, q $&[]f32, k $&[]f32, v $&[]f32,
                hb $&[]f32, hb2 $&[]f32, xq $&[]i8, xs $&[]f32) int {
    cfg := &m.cfg
    dim := cfg.dim
    hidden := cfg.hidden_dim
    head_dim := cfg.head_dim
    kv_dim := cfg.kv_dim
    n_heads := cfg.n_heads
    kv_mul := n_heads / cfg.n_kv_heads
    half := cfg.rope_dim / 2
    use_q4 := m.is_q4
    use_q8 := m.is_q8
    $wo_cols := dim
    $scale_d := head_dim
    $q_row_stride := dim
    if m.is_mla {
        wo_cols = n_heads * cfg.v_head_dim
        scale_d = cfg.qk_nope_head_dim + cfg.qk_rope_head_dim
        q_row_stride = kv_dim
    }
    inv_sqrt_d := f32(1.0 / math.sqrt(f64(scale_d)))
    one_f32 := f32(1.0)
    for l in 0:cfg.n_layers {
        final_layer := l + 1 == cfg.n_layers
        all_queries := !final_layer || final_count == m_cnt
        // Q and the residual scratch are free at both norm calls.
        rmsnorm_forward_rows(m, m_cnt, x, &m.attn_norms[l], xb, q, xb2, decoding)
        layer_off := l * kv.layer_stride
        if m.is_mla {
            for t in 0:m_cnt {
                _ := forward_mla_qkv_row(m, l, xb, t * dim, q, t * q_row_stride, k, t * kv_dim, v, t * kv_dim, rows[t].pos, all_queries, use_q8_act, xq, xs) >>>
                kv_woff := rows[t].kv_offset + layer_off
                kv_write(kv, kv_woff, k, v, t * kv_dim, kv_dim)
            }
        } else {
            if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(xb, xq, xs, m_cnt * dim) }
            if all_queries {
                _ := matmat_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, q, xb, xq, xs, m.wq_off[l], m_cnt, dim, dim) >>>
            }
            _ := matmat_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, k, xb, xq, xs, m.wk_off[l], m_cnt, kv_dim, dim) >>>
            _ := matmat_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, v, xb, xq, xs, m.wv_off[l], m_cnt, kv_dim, dim) >>>
            if m.lora.active {
                if all_queries { apply_lora_rows(q, xb, 0, 0, m_cnt, dim, dim, &m.lora.q[l]) }
                apply_lora_rows(k, xb, 0, 0, m_cnt, kv_dim, dim, &m.lora.k[l])
                apply_lora_rows(v, xb, 0, 0, m_cnt, kv_dim, dim, &m.lora.v[l])
            }

            for t in 0:m_cnt {
                q_base := t * dim
                kv_base := t * kv_dim
                if m.has_qkv_bias {
                    if all_queries {
                        axpy_offset(q, q_base, &m.bq[l], 0, one_f32, dim)
                    }
                    axpy_offset(k, kv_base, &m.bk[l], 0, one_f32, kv_dim)
                    axpy_offset(v, kv_base, &m.bv[l], 0, one_f32, kv_dim)
                }
                if m.has_qk_norm {
                    if all_queries {
                        apply_head_rmsnorm(q, q_base, n_heads, head_dim, &m.q_norms[l], cfg.rms_eps)
                    }
                    apply_head_rmsnorm(k, kv_base, cfg.n_kv_heads, head_dim, &m.k_norms[l], cfg.rms_eps)
                }
                pos_t := rows[t].pos
                rope_off := pos_t * half
                if all_queries {
                    apply_rope_offset(q, q_base, n_heads, head_dim, cfg.rope_dim, cfg.rope_interleaved, pos_t, cfg.rope_theta, cfg.rope_freq_scale, &m.rope_cos, &m.rope_sin, rope_off)
                }
                apply_rope_offset(k, kv_base, cfg.n_kv_heads, head_dim, cfg.rope_dim, cfg.rope_interleaved, pos_t, cfg.rope_theta, cfg.rope_freq_scale, &m.rope_cos, &m.rope_sin, rope_off)
                kv_woff := rows[t].kv_offset + layer_off
                kv_write(kv, kv_woff, k, v, kv_base, kv_dim)
            }
        }

        // Later chunks need the final layer's K/V, and only the final
        // token feeds the output projection.
        if final_layer && final_count == 0 { <- }
        $output_start := 0
        $output_count := m_cnt
        if !all_queries {
            output_start = final_start
            output_count = final_count
            if output_start > 0 {
                last_off := output_start * dim
                for i in 0:dim {
                    xb[i] = xb[last_off + i]
                    x[i] = x[last_off + i]
                }
            }
            if m.is_mla {
                $x_last := []f32{}
                x_last.reserve(dim)
                for i in 0:dim { x_last.push(xb[i]) }
                _ := forward_mla_compute_q_row(m, l, &x_last, q, 0, rows[output_start].pos, use_q8_act, xq, xs) >>>
            } else {
                if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(xb, xq, xs, dim) }
                _ := matmat_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, q, xb, xq, xs, m.wq_off[l], 1, dim, dim) >>>
                if m.lora.active { apply_lora_rows(q, xb, 0, 0, 1, dim, dim, &m.lora.q[l]) }
                if m.has_qkv_bias {
                    axpy_offset(q, 0, &m.bq[l], 0, one_f32, dim)
                }
                if m.has_qk_norm {
                    apply_head_rmsnorm(q, 0, n_heads, head_dim, &m.q_norms[l], cfg.rms_eps)
                }
                pos_out := rows[output_start].pos
                rope_off := pos_out * half
                apply_rope_offset(q, 0, n_heads, head_dim, cfg.rope_dim, cfg.rope_interleaved, pos_out, cfg.rope_theta, cfg.rope_freq_scale, &m.rope_cos, &m.rope_sin, rope_off)
            }
        }

        for t in 0:output_count {
            row_index := output_start + t
            row := &rows[row_index]
            bt_slot_off := row.table_offset
            t0_pb := kv.block_tables[bt_slot_off]
            pos_t := row.pos
            tok_q_base := t * q_row_stride
            for h in 0:n_heads {
                q_off := tok_q_base + h * head_dim
                kv_head_off := (h / kv_mul) * head_dim
                attention_head(kv, q, xb, hb, q_off, kv_head_off, bt_slot_off, layer_off, t0_pb, pos_t, head_dim, inv_sqrt_d, cfg.sliding_window, cfg.attn_logit_softcap)
            }
        }
        if m.is_mla {
            compact_mla_attn_rows(xb, output_count, n_heads, head_dim, cfg.v_head_dim)
        }

        if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(xb, xq, xs, output_count * wo_cols) }
        _ := matmat_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, xb2, xb, xq, xs, m.wo_off[l], output_count, dim, wo_cols) >>>
        if m.lora.active { apply_lora_rows(xb2, xb, 0, 0, output_count, dim, wo_cols, &m.lora.o[l]) }
        if m.has_post_norms {
            rmsnorm_forward_rows(m, output_count, xb2, &m.post_attn_norms[l], xb, q, hb, decoding)
            for i in 0:(output_count * dim) { xb2[i] = xb[i] }
        }
        vadd_inplace(x, xb2, output_count * dim)

        rmsnorm_forward_rows(m, output_count, x, &m.ffn_norms[l], xb, q, xb2, decoding)
        if m.is_moe && m.moe_layer[l] {
            for t in 0:output_count {
                _ := forward_moe_ffn_row(m, l, xb, t * dim, xb2, t * dim, hb, hb2, q, xq, xs, use_q8_act) >>>
            }
        } else {
            if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(xb, xq, xs, output_count * dim) }
            _ := matmat_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, hb, xb, xq, xs, m.w1_off[l], output_count, hidden, dim) >>>
            _ := matmat_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, hb2, xb, xq, xs, m.w3_off[l], output_count, hidden, dim) >>>
            if m.lora.active {
                apply_lora_rows(hb, xb, 0, 0, output_count, hidden, dim, &m.lora.w1[l])
                apply_lora_rows(hb2, xb, 0, 0, output_count, hidden, dim, &m.lora.w3[l])
            }
            total_h := output_count * hidden
            apply_ffn_activation(hb, hb2, total_h, cfg.use_geglu)
            if (use_q4 || use_q8) && use_q8_act { quantize_q8_0(hb, xq, xs, total_h) }
            _ := matmat_dispatch(m, use_q4, use_q8, m.layers_p4, use_q8_act, xb2, hb, xq, xs, m.w2_off[l], output_count, dim, hidden) >>>
            if m.lora.active { apply_lora_rows(xb2, hb, 0, 0, output_count, dim, hidden, &m.lora.w2[l]) }
        }
        if m.has_post_norms {
            rmsnorm_forward_rows(m, output_count, xb2, &m.post_ffn_norms[l], xb, q, hb, decoding)
            for i in 0:(output_count * dim) { xb2[i] = xb[i] }
        }
        if !final_layer {
            vadd_inplace(x, xb2, output_count * dim)
        }
    }
    << 0
}

fn forward_prefill_batch(m &Model, kv $&PagedKvCache, row_cache $&[]ForwardRow,
                         x $&[]f32, xb $&[]f32, xb2 $&[]f32,
                         q $&[]f32, k $&[]f32, v $&[]f32,
                         hb $&[]f32, hb2 $&[]f32, logits $&[]f32,
                         xq $&[]i8, xs $&[]f32,
                         slot int, tokens &[]int, pos_base int, use_q8_act bool, compute_logits bool) int {
    if tokens.len <= 0 { << 0 }
    cfg := &m.cfg
    $last_tok := 0
    $off := 0
    while off < tokens.len {
        $count := tokens.len - off
        if count > row_cache.len { count = row_cache.len }
        is_last := off + count == tokens.len
        for t in 0:count {
            _ := load_embed_row(m, tokens[off + t], x, t * cfg.dim) >>>
            row := prepare_forward_row(kv, slot, pos_base + off + t) >>>
            row_cache[t] = row
        }
        $final_count := 0
        if is_last && compute_logits { final_count = 1 }
        _ := forward_rows(m, kv, row_cache, count, count - 1, final_count, use_q8_act, false, x, xb, xb2, q, k, v, hb, hb2, xq, xs) >>>
        if final_count > 0 {
            last_tok = project_next_token(m, x, xb, xb2, xq, xs, logits, use_q8_act) >>>
        }
        off += count
    }
    << last_tok
}

fn run_single_request(m &Model, kv $&PagedKvCache, row_cache $&[]ForwardRow,
                      x $&[]f32, xb $&[]f32, xb2 $&[]f32,
                      q $&[]f32, k $&[]f32, v $&[]f32,
                      hb $&[]f32, hb2 $&[]f32, logits $&[]f32,
                      xq $&[]i8, xs $&[]f32,
                      prompt &[]int, max_gen int, use_q8_act bool) ClientResult {
    $tokens := []int{}
    $lbits := []int{}
    if prompt.len <= 0 || max_gen <= 0 {
        << ClientResult{req_id: 0, tokens: tokens, logit_bits: lbits}
    }
    first_tok := forward_prefill_batch(m, kv, row_cache, x, xb, xb2, q, k, v, hb, hb2, logits, xq, xs, 0, prompt, 0, use_q8_act, true) >>> (err) {
        kv_free_slot(kv, 0)
        >>> err
    }
    tokens.push(first_tok)
    lbits.push(bits(logits[first_tok]))
    $cur_tok := first_tok
    $pos := prompt.len
    for _ in 1:max_gen {
        next_tok := forward_token(m, kv, x, xb, xb2, q, k, v, hb, hb2, logits, xq, xs, 0, cur_tok, pos, use_q8_act) >>> (err) {
            kv_free_slot(kv, 0)
            >>> err
        }
        pos += 1
        tokens.push(next_tok)
        lbits.push(bits(logits[next_tok]))
        cur_tok = next_tok
    }
    kv_free_slot(kv, 0)
    << ClientResult{req_id: 0, tokens: tokens, logit_bits: lbits}
}

fn client_worker(req_id int, prompt []int, max_gen int, gate chan int, need_gate bool,
                 req_ch chan InferRequest, done_ch chan ClientResult) {
    if need_gate {
        _ := <-gate
    }
    out_ch := chan TokenChunk{cap: 64}
    req_ch <- InferRequest{req_id: req_id, prompt: ~prompt, max_gen: max_gen, out_ch: out_ch}
    $tokens := []int{}
    $lbits := []int{}
    while true {
        chunk := <-out_ch
        tokens.push(chunk.token)
        lbits.push(chunk.top_logit_bits)
        if chunk.done { <- }
    }
    done_ch <- ClientResult{req_id: req_id, tokens: tokens, logit_bits: lbits}
}

fn forward_decode_batch(m &Model, kv $&PagedKvCache, row_cache $&[]ForwardRow,
                        inputs &[]DecodeInput, count int, predictions $&[]DecodePrediction,
                        x $&[]f32, xb $&[]f32, xb2 $&[]f32,
                        q $&[]f32, k $&[]f32, v $&[]f32, hb $&[]f32, hb2 $&[]f32,
                        logits $&[]f32, xq $&[]i8, xs $&[]f32) bool {
    dim := m.cfg.dim
    vocab := m.cfg.vocab_size
    batch_head := m.lm_head_q8 && m.lm_head_p4 && logits.len >= count * vocab
    for t in 0:count {
        input := &inputs[t]
        _ := load_embed_row(m, input.token, x, t * dim) >>>
        row := prepare_forward_row(kv, input.slot, input.pos) >>>
        row_cache[t] = row
    }
    _ := forward_rows(m, kv, row_cache, count, 0, count, true, true, x, xb, xb2, q, k, v, hb, hb2, xq, xs) >>>
    if batch_head {
        for t in 0:count {
            if t > 0 {
                offset := t * dim
                for i in 0:dim {
                    x[i] = x[offset + i]
                    xb2[i] = xb2[offset + i]
                }
            }
            rmsnorm_add_fused(dim, x, xb2, &m.final_norm, xb, m.cfg.rms_eps)
            base := t * dim
            for i in 0:dim { q[base + i] = xb[i] }
        }
        quantize_q8_0(q, xq, xs, count * dim)
        matmat_q8_0_p4k4_q8_0(logits, &m.q8_p4k4_qs, &m.q8_p4k4_scales, m.lm_head_off, xq, xs, count, vocab, dim)
        for t in 0:count {
            base := t * vocab
            if m.lora.active { apply_lora_rows(logits, q, t * dim, base, 1, vocab, dim, &m.lora.lm_head) }
            apply_logit_softcap(logits, base, vocab, m.cfg.logit_softcap)
            token := argmax_at(logits, base, vocab)
            predictions[inputs[t].slot] = DecodePrediction{token: token, logit_bits: bits(logits[base + token])}
        }
    } else if count > 1 && logits.len >= count * vocab && q.len >= 2 * dim {
        for i in 0:dim {
            q[i] = x[i]
            q[dim + i] = xb2[i]
        }
        $rev := count - 1
        while rev >= 1 {
            offset := rev * dim
            for i in 0:dim {
                x[i] = x[offset + i]
                xb2[i] = xb2[offset + i]
            }
            token := project_next_token(m, x, xb, xb2, xq, xs, logits, true) >>>
            base := rev * vocab
            for i in 0:vocab { logits[base + i] = logits[i] }
            predictions[inputs[rev].slot] = DecodePrediction{token: token, logit_bits: bits(logits[base + token])}
            rev -= 1
        }
        for i in 0:dim {
            x[i] = q[i]
            xb2[i] = q[dim + i]
        }
        token0 := project_next_token(m, x, xb, xb2, xq, xs, logits, true) >>>
        predictions[inputs[0].slot] = DecodePrediction{token: token0, logit_bits: bits(logits[token0])}
    } else {
        for t in 0:count {
            if t > 0 {
                offset := t * dim
                for i in 0:dim {
                    x[i] = x[offset + i]
                    xb2[i] = xb2[offset + i]
                }
            }
            token := project_next_token(m, x, xb, xb2, xq, xs, logits, true) >>>
            predictions[inputs[t].slot] = DecodePrediction{token: token, logit_bits: bits(logits[token])}
        }
    }
    << true
}

fn run_continuous_batch(m &Model, kv $&PagedKvCache, row_cache $&[]ForwardRow,
                        x $&[]f32, xb $&[]f32, xb2 $&[]f32,
                        q $&[]f32, k $&[]f32, v $&[]f32,
                        hb $&[]f32, hb2 $&[]f32, logits $&[]f32,
                        xq $&[]i8, xs $&[]f32,
                        prompts &[][]int, gens &[]int, use_q8_act bool) []ClientResult {
    total_reqs := prompts.len
    active_limit := kv.max_slots
    batch_decode := xu_target_arch() == ARCH_ARM64 && m.layers_p4 && use_q8_act
    req_ch := chan InferRequest{cap: 16}
    done_ch := chan ClientResult{cap: 16}
    gate2 := chan int{cap: 1}
    gate3 := chan int{cap: 1}

    for r in 0:total_reqs {
        $p := []int{}
        for t in 0:prompts[r].len { p.push(prompts[r][t]) }
        if r == 2 {
            xu client_worker(r, ~p, gens[r], gate2, true, req_ch, done_ch)
        } else if r == 3 {
            xu client_worker(r, ~p, gens[r], gate3, true, req_ch, done_ch)
        } else {
            xu client_worker(r, ~p, gens[r], gate2, false, req_ch, done_ch)
        }
    }

    $slot_active := []bool{}
    $slot_req_id := []int{}
    $slot_pos := []int{}
    $slot_gen := []int{}
    $slot_max_gen := []int{}
    $slot_cur_tok := []int{}
    $slot_prompts := [][]int{}
    $slot_outs := []chan TokenChunk{}
    dummy_ch := chan TokenChunk{cap: 1}
    $decode_inputs := []DecodeInput{}
    $predictions := []DecodePrediction{}
    for _ in 0:active_limit {
        slot_active.push(false)
        slot_req_id.push(-1)
        slot_pos.push(0)
        slot_gen.push(0)
        slot_max_gen.push(0)
        slot_cur_tok.push(0)
        slot_prompts.push([]int{})
        slot_outs.push(dummy_ch)
        decode_inputs.push(DecodeInput{slot: 0, token: 0, pos: 0})
        predictions.push(DecodePrediction{token: 0, logit_bits: 0})
    }

    $admitted := 0
    $completed := 0
    $ticks := 0
    $active_count := 0
    $released_gate2 := false
    $released_gate3 := false

    while completed < total_reqs {
        // Let clients submit requests and receive tokens between forward steps.
        time.sleep(0)
        while admitted < total_reqs && active_count < active_limit {
            $got := false
            if active_count == 0 {
                req := <-req_ch
                got = true
                for s in 0:active_limit {
                    if !slot_active[s] {
                        slot_active[s] = true
                        slot_req_id[s] = req.req_id
                        slot_pos[s] = 0
                        slot_gen[s] = 0
                        slot_max_gen[s] = req.max_gen
                        slot_cur_tok[s] = req.prompt[0]
                        slot_prompts[s] = ~req.prompt
                        slot_outs[s] = req.out_ch
                        active_count += 1
                        admitted += 1
                        <-
                    }
                }
            } else {
                select {
                    req := <-req_ch {
                        got = true
                        for s in 0:active_limit {
                            if !slot_active[s] {
                                slot_active[s] = true
                                slot_req_id[s] = req.req_id
                                slot_pos[s] = 0
                                slot_gen[s] = 0
                                slot_max_gen[s] = req.max_gen
                                slot_cur_tok[s] = req.prompt[0]
                                slot_prompts[s] = ~req.prompt
                                slot_outs[s] = req.out_ch
                                active_count += 1
                                admitted += 1
                                <-
                            }
                        }
                    }
                    else {
                        got = false
                    }
                }
            }
            if !got { <- }
        }

        $decode_count := 0
        if batch_decode {
            for s in 0:active_limit {
                if slot_active[s] && slot_pos[s] > 0 {
                    decode_inputs[decode_count] = DecodeInput{slot: s, token: slot_cur_tok[s], pos: slot_pos[s]}
                    decode_count += 1
                }
            }
        }
        use_decode_batch := decode_count > 1
        if use_decode_batch {
            _ := forward_decode_batch(m, kv, row_cache, &decode_inputs, decode_count, $&predictions,
                                      x, xb, xb2, q, k, v, hb, hb2, logits, xq, xs) >>> (err) {
                for fs in 0:active_limit { kv_free_slot(kv, fs) }
                >>> err
            }
        }

        for s in 0:active_limit {
            if !slot_active[s] { -> }
            pos := slot_pos[s]
            plen := slot_prompts[s].len
            $token := 0
            $logit_bits := 0
            if pos == 0 {
                token = forward_prefill_batch(m, kv, row_cache, x, xb, xb2, q, k, v, hb, hb2, logits, xq, xs, s, &slot_prompts[s], 0, use_q8_act, true) >>> (err) {
                    for fs in 0:active_limit { kv_free_slot(kv, fs) }
                    >>> err
                }
                slot_pos[s] = plen
                logit_bits = bits(logits[token])
            } else if use_decode_batch {
                token = predictions[s].token
                logit_bits = predictions[s].logit_bits
                slot_pos[s] = pos + 1
            } else {
                token = forward_token(m, kv, x, xb, xb2, q, k, v, hb, hb2, logits, xq, xs, s, slot_cur_tok[s], pos, use_q8_act) >>> (err) {
                    for fs in 0:active_limit { kv_free_slot(kv, fs) }
                    >>> err
                }
                slot_pos[s] = pos + 1
                logit_bits = bits(logits[token])
            }

            step_idx := slot_gen[s]
            slot_gen[s] = step_idx + 1
            is_done := slot_gen[s] >= slot_max_gen[s]
            ch := slot_outs[s]
            ch <- TokenChunk{req_id: slot_req_id[s], step: step_idx, token: token, top_logit_bits: logit_bits, done: is_done}
            if is_done {
                kv_free_slot(kv, s)
                slot_active[s] = false
                active_count -= 1
                completed += 1
            } else {
                slot_cur_tok[s] = token
            }
        }

        ticks += 1
        if total_reqs > 2 && !released_gate2 && (ticks >= 2 || active_count == 0) {
            released_gate2 = true
            gate2 <- 1
        }
        if total_reqs > 3 && !released_gate3 && (ticks >= 4 || active_count == 0) {
            released_gate3 = true
            gate3 <- 1
        }
    }

    $results := []ClientResult{}
    for _ in 0:total_reqs {
        results.push(ClientResult{req_id: -1, tokens: []int{}, logit_bits: []int{}})
    }
    for _ in 0:total_reqs {
        res := <-done_ch
        id := res.req_id
        results[id] = ~res
    }
    << results
}

fn utf8_char_step(s &string, off int) int {
    b0 := (*s)[off]
    if (b0 & 0x80) == 0 { << 1 }
    if (b0 & 0xE0) == 0xC0 && off + 1 < s.len { << 2 }
    if (b0 & 0xF0) == 0xE0 && off + 2 < s.len { << 3 }
    if (b0 & 0xF8) == 0xF0 && off + 3 < s.len { << 4 }
    << 1
}

fn hex_digit_val(c int) int {
    if c >= 48 && c <= 57 { << c - 48 }
    if c >= 65 && c <= 70 { << c - 55 }
    if c >= 97 && c <= 102 { << c - 87 }
    << -1
}

fn hex_byte_token(b int) string {
    hex := "0123456789ABCDEF"
    hi := (b >> 4) & 15
    lo := b & 15
    << "<0x" + hex[hi:hi + 1] + hex[lo:lo + 1] + ">"
}

fn is_spm_tok(m &Model) bool {
    << m.cfg.tok_model == "llama" || m.cfg.tok_model == "spm"
}

fn spm_escape_spaces(s &string) string {
    $out := ""
    for i in 0:s.len {
        if (*s)[i] == 32 {
            out = out + "▁"
        } else {
            out = out + (*s)[i:i + 1]
        }
    }
    << out
}

fn spm_unescape_spaces(s &string) string {
    if s.len == 6 && (*s)[0] == 60 && (*s)[1] == 48 && (*s)[2] == 120 && (*s)[5] == 62 {
        hi := hex_digit_val((*s)[3])
        lo := hex_digit_val((*s)[4])
        if hi >= 0 && lo >= 0 {
            << string_from_byte((hi << 4) | lo)
        }
    }
    $out := ""
    $i := 0
    while i < s.len {
        if i + 2 < s.len && ((*s)[i] & 255) == 0xe2 && ((*s)[i + 1] & 255) == 0x96 && ((*s)[i + 2] & 255) == 0x81 {
            out = out + " "
            i += 3
        } else {
            out = out + (*s)[i:i + 1]
            i += 1
        }
    }
    << out
}

fn is_ascii_letter(c int) bool {
    << (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

fn is_ascii_digit(c int) bool {
    << c >= 48 && c <= 57
}

fn pretokenize_gpt2_chunks(s &string) []string {
    $chunks := []string{}
    $i := 0
    n := s.len
    while i < n {
        c := (*s)[i] & 255
        if c == 10 || c == 13 {
            $j := i + 1
            while j < n && (((*s)[j] & 255) == 10 || ((*s)[j] & 255) == 13) { j += 1 }
            chunks.push((*s)[i:j])
            i = j
        } else if c == 32 && i + 1 < n && is_ascii_letter((*s)[i + 1] & 255) {
            $j := i + 2
            while j < n && is_ascii_letter((*s)[j] & 255) { j += 1 }
            chunks.push((*s)[i:j])
            i = j
        } else if is_ascii_letter(c) {
            $j := i + 1
            while j < n && is_ascii_letter((*s)[j] & 255) { j += 1 }
            chunks.push((*s)[i:j])
            i = j
        } else if is_ascii_digit(c) {
            $j := i + 1
            while j < n && is_ascii_digit((*s)[j] & 255) { j += 1 }
            chunks.push((*s)[i:j])
            i = j
        } else if c == 32 {
            $j := i + 1
            while j < n && ((*s)[j] & 255) == 32 { j += 1 }
            chunks.push((*s)[i:j])
            i = j
        } else {
            step := utf8_char_step(s, i)
            chunks.push((*s)[i:i + step])
            i += step
        }
    }
    << chunks
}

fn push_greedy_vocab(m &Model, src &string, ids $&[]int) {
    spm := is_spm_tok(m)
    $p := 0
    while p < src.len {
        $best_id := -1
        $best_len := 0
        for tid in 0:m.vocab.len {
            if str_match_at(src, p, &m.vocab[tid]) {
                if m.vocab[tid].len > best_len {
                    best_len = m.vocab[tid].len
                    best_id = tid
                }
            }
        }
        if best_id >= 0 {
            ids.push(best_id)
            p += best_len
        } else {
            if spm {
                bt := hex_byte_token((*src)[p] & 255)
                bid := m.vocab_map.get_or(bt, -1)
                if bid >= 0 { ids.push(bid) }
            }
            p += 1
        }
    }
}

fn bpe_merge_chunk(m &Model, src &string, ids $&[]int) {
    if src.len <= 0 { << }
    if m.bpe_merges.len() > 0 {
        $pieces := []string{}
        $off := 0
        while off < src.len {
            step := utf8_char_step(src, off)
            pieces.push((*src)[off:off + step])
            off += step
        }
        while pieces.len >= 2 {
            $best_i := -1
            $best_rank := 1000000000
            for i in 0:(pieces.len - 1) {
                pair := pieces[i] + " " + pieces[i + 1]
                rank := m.bpe_merges.get_or(pair, -1)
                if rank >= 0 && rank < best_rank {
                    best_rank = rank
                    best_i = i
                }
            }
            if best_i < 0 { <- }
            $next_pieces := []string{}
            for i in 0:best_i { next_pieces.push(pieces[i]) }
            next_pieces.push(pieces[best_i] + pieces[best_i + 1])
            for i in (best_i + 2):pieces.len { next_pieces.push(pieces[i]) }
            pieces = ~next_pieces
        }
        for i in 0:pieces.len {
            tid := m.vocab_map.get_or(pieces[i], -1)
            if tid >= 0 {
                ids.push(tid)
            } else {
                push_greedy_vocab(m, &pieces[i], ids)
            }
        }
    } else {
        push_greedy_vocab(m, src, ids)
    }
}

fn encode_text_segment(m &Model, seg &string, ids $&[]int, is_first bool) {
    if seg.len <= 0 || m.vocab.len <= 0 { << }
    if m.cfg.is_gpt2_tok {
        if m.bpe_merges.len() > 0 {
            chunks := pretokenize_gpt2_chunks(seg)
            for ci in 0:chunks.len {
                enc := encode_gpt2_piece(&chunks[ci])
                bpe_merge_chunk(m, &enc, ids)
            }
        } else {
            enc := encode_gpt2_piece(seg)
            push_greedy_vocab(m, &enc, ids)
        }
        <<
    }
    if is_spm_tok(m) {
        $norm := spm_escape_spaces(seg)
        if is_first && !gguf_starts_with(&norm, "▁") {
            norm = "▁" + norm
        }
        bpe_merge_chunk(m, &norm, ids)
        <<
    }
    bpe_merge_chunk(m, seg, ids)
}

fn encode_prompt(m &Model, input &string) []int {
    $ids := []int{}
    if gguf_starts_with(input, "ids:") {
        $start := 4
        for i in 4:input.len + 1 {
            if i == input.len || (*input)[i] == 44 {
                if i > start {
                    part := (*input)[start:i]
                    v := strconv.atoi(&part) >>> (err) {
                        eprintln("invalid prompt token id: " + err.msg())
                        << ids
                    }
                    ids.push(v)
                }
                start = i + 1
            }
        }
        if ids.len == 0 { ids.push(0) }
        << ids
    }

    candidates := ["<|im_start|>", "<|im_end|>", "<|begin_of_text|>", "<|start_header_id|>", "<|end_header_id|>", "<|eot_id|>", "<|end_of_text|>", "<start_of_turn>", "<end_of_turn>", "[INST]", "[/INST]", "[TOOL_RESULTS]", "</s>", "<|endoftext|>", "<tool_call>", "</tool_call>", "<tool_response>", "</tool_response>"]
    $spec_toks := []string{}
    $spec_ids := []int{}
    for ci in 0:candidates.len {
        tid := m.vocab_map.get_or(candidates[ci], -1)
        if tid >= 0 {
            spec_toks.push(candidates[ci])
            spec_ids.push(tid)
        }
    }

    if spec_toks.len > 0 {
        $seg_start := 0
        $p := 0
        $first_seg := true
        while p < input.len {
            $matched := -1
            for si in 0:spec_toks.len {
                if str_match_at(input, p, &spec_toks[si]) {
                    matched = si
                    <-
                }
            }
            if matched >= 0 {
                if p > seg_start {
                    seg := (*input)[seg_start:p]
                    encode_text_segment(m, &seg, $&ids, first_seg)
                    first_seg = false
                }
                ids.push(spec_ids[matched])
                p += spec_toks[matched].len
                seg_start = p
                first_seg = false
            } else {
                p += 1
            }
        }
        if seg_start < input.len {
            tail := (*input)[seg_start:input.len]
            encode_text_segment(m, &tail, $&ids, first_seg)
        }
    } else {
        encode_text_segment(m, input, $&ids, true)
    }
    if ids.len == 0 { ids.push(0) }
    << ids
}

fn format_piece(m &Model, tok int) string {
    if tok < 0 || tok >= m.vocab.len {
        << "<" + str(tok) + ">"
    }
    if m.cfg.is_gpt2_tok {
        << decode_gpt2_piece(&m.vocab[tok])
    }
    if is_spm_tok(m) {
        << spm_unescape_spaces(&m.vocab[tok])
    }
    << m.vocab[tok]
}

fn format_result(prefix string, r &ClientResult) string {
    $s := prefix + ":" + str(r.req_id) + ":"
    for i in 0:r.tokens.len {
        if i > 0 { s = s + "," }
        s = s + str(r.tokens[i]) + "@" + str(r.logit_bits[i])
    }
    << s
}

fn join_ints(vals &[]int) string {
    $s := ""
    for i in 0:vals.len {
        if i > 0 { s = s + "," }
        s = s + str(vals[i])
    }
    << s
}

struct ServeResponse {
    status int
    body string
    is_stream bool
}

struct ServeRequest {
    method string
    path string
    body string
    reply chan ServeResponse
    stream_ch chan string
    cancel_ch chan int
}

struct GenOutput {
    ids []int
    text string
    finish_reason string
    prefill_ns int
    decode_ns int
}

fn write_all_fd(fd int, data &string) int {
    $off := 0
    while off < data.len {
        chunk := (*data)[off:data.len]
        n := net.conn_write(fd, &chunk) >>>
        if n <= 0 { >>> errors.new("short socket write") }
        off += n
    }
    << off
}

fn try_signal_cancel(cancel chan int) {
    select {
        cancel <- 1 {}
        else {}
    }
}

fn check_cancelled(cancel chan int) bool {
    select {
        _ := <-cancel { << true }
        else { << false }
    }
}

fn send_stream_msg(ch chan string, cancel chan int, msg string) bool {
    select {
        _ := <-cancel { << false }
        ch <- msg { << true }
    }
}

fn try_send_stream(ch chan string, msg string) {
    select {
        ch <- msg {}
        else {}
    }
}

fn http_status_reason(status int) string {
    if status == 200 { << "OK" }
    if status == 204 { << "No Content" }
    if status == 400 { << "Bad Request" }
    if status == 401 { << "Unauthorized" }
    if status == 404 { << "Not Found" }
    if status == 500 { << "Internal Server Error" }
    << "OK"
}

fn write_cors_json(fd int, status int, body &string) int {
    head := "HTTP/1.1 " + str(status) + " " + http_status_reason(status) +
            "\r\nContent-Type: application/json\r\n" +
            "Access-Control-Allow-Origin: *\r\n" +
            "Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n" +
            "Access-Control-Allow-Headers: Content-Type, Authorization\r\n" +
            "Content-Length: " + str(body.len) + "\r\nConnection: close\r\n\r\n"
    _ := write_all_fd(fd, &head) >>>
    if body.len > 0 {
        _ := write_all_fd(fd, body) >>>
    }
    << 0
}

fn enable_nosigpipe(fd int) int {
    // Darwin: SOL_SOCKET = 0xffff (65535), SO_NOSIGPIPE = 0x1022 (4130).
    if xu_target_os() == 0 {
        _ := os.setsockopt_int(fd, 65535, 4130, 1) >>> (_) { << 0 }
    }
    << 0
}

fn peer_disconnected(fd int) bool {
    ready := os.socket_poll(fd, 1) >>> (_) { << true }
    if ready != 0 {
        probe := net.conn_read(fd, 1) >>> (_) { << true }
        if probe.len == 0 { << true }
    }
    << false
}

fn serve_conn_worker(fd int, req_ch chan ServeRequest, api_key string) {
    _ := enable_nosigpipe(fd)
    $hreq := http.new_request()
    _ := hreq.read(fd) >>> (_) {
        _ := net.conn_close(fd) >>> (_) { << }
        <<
    }
    method := hreq.method()
    path := hreq.path()
    if method == "OPTIONS" {
        preflight := "HTTP/1.1 204 No Content\r\n" +
                     "Access-Control-Allow-Origin: *\r\n" +
                     "Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n" +
                     "Access-Control-Allow-Headers: Content-Type, Authorization, x-api-key, anthropic-version\r\n" +
                     "Content-Length: 0\r\nConnection: close\r\n\r\n"
        _ := write_all_fd(fd, &preflight) >>> (_) {
            _ := net.conn_close(fd) >>> (_) { << }
            <<
        }
        _ := net.conn_close(fd) >>> (_) { << }
        <<
    }
    if api_key.len > 0 && path != "/health" {
        expected := "Bearer " + api_key
        if hreq.header("Authorization") != expected && hreq.header("x-api-key") != api_key {
            err_body := json_error_body("unauthorized")
            _ := write_cors_json(fd, 401, &err_body) >>> (_) {
                _ := net.conn_close(fd) >>> (_) { << }
                <<
            }
            _ := net.conn_close(fd) >>> (_) { << }
            <<
        }
    }
    rch := chan ServeResponse{cap: 1}
    sch := chan string{cap: 64}
    cch := chan int{cap: 1}
    req_ch <- ServeRequest{method: method, path: path, body: hreq.body(), reply: rch, stream_ch: sch, cancel_ch: cch}
    resp := <-rch
    if resp.is_stream {
        hdr := "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream; charset=utf-8\r\n" +
               "Cache-Control: no-cache\r\n" +
               "Access-Control-Allow-Origin: *\r\n" +
               "Access-Control-Allow-Headers: Content-Type, Authorization, x-api-key, anthropic-version\r\n" +
               "Connection: close\r\n\r\n"
        _ := write_all_fd(fd, &hdr) >>> (_) {
            try_signal_cancel(cch)
            _ := net.conn_close(fd) >>> (_) { << }
            <<
        }
        for {
            chunk := <-sch
            if chunk.len == 0 { <- }
            if peer_disconnected(fd) {
                try_signal_cancel(cch)
                _ := net.conn_close(fd) >>> (_) { << }
                <<
            }
            _ := write_all_fd(fd, &chunk) >>> (_) {
                try_signal_cancel(cch)
                _ := net.conn_close(fd) >>> (_) { << }
                <<
            }
        }
        _ := net.conn_close(fd) >>> (_) { << }
        <<
    }
    _ := write_cors_json(fd, resp.status, &resp.body) >>> (_) {
        _ := net.conn_close(fd) >>> (_) { << }
        <<
    }
    _ := net.conn_close(fd) >>> (_) { << }
}

fn serve_http_loop(srv http.Server, req_ch chan ServeRequest, api_key string) {
    for {
        fd := srv.accept() >>> (_) { << }
        xu serve_conn_worker(fd, req_ch, api_key)
    }
}

fn find_substr(s &string, pat &string) int {
    if pat.len <= 0 || pat.len > s.len { << -1 }
    limit := s.len - pat.len + 1
    for i in 0:limit {
        if str_match_at(s, i, pat) { << i }
    }
    << -1
}

fn trim_stop_sequence(text $&string, stops &[]string) bool {
    $best_idx := -1
    for k in 0:stops.len {
        idx := find_substr(text, &stops[k])
        if idx >= 0 && (best_idx < 0 || idx < best_idx) {
            best_idx = idx
        }
    }
    if best_idx >= 0 {
        *text = (*text)[0:best_idx]
        << true
    }
    << false
}

fn format_sse_chunk(is_chat bool, req_id &string, created int, model_id &string, text &string, finish_reason string, lp_json &string) string {
    $fr_json := "null"
    if finish_reason.len > 0 {
        fr_json = json.quote(&finish_reason)
    }
    $lp_part := ""
    if lp_json.len > 0 {
        lp_part = ",\"logprobs\":" + (*lp_json)
    }
    if is_chat {
        if finish_reason.len > 0 && text.len == 0 {
            << "data: {\"id\":" + json.quote(req_id) + ",\"object\":\"chat.completion.chunk\",\"created\":" + str(created) +
               ",\"model\":" + json.quote(model_id) + ",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":" + fr_json + lp_part + "}]}\n\n"
        }
        << "data: {\"id\":" + json.quote(req_id) + ",\"object\":\"chat.completion.chunk\",\"created\":" + str(created) +
           ",\"model\":" + json.quote(model_id) + ",\"choices\":[{\"index\":0,\"delta\":{\"content\":" + json.quote(text) +
           "},\"finish_reason\":" + fr_json + lp_part + "}]}\n\n"
    }
    << "data: {\"id\":" + json.quote(req_id) + ",\"object\":\"text_completion\",\"created\":" + str(created) +
       ",\"model\":" + json.quote(model_id) + ",\"choices\":[{\"index\":0,\"text\":" + json.quote(text) +
       ",\"finish_reason\":" + fr_json + lp_part + "}]}\n\n"
}

fn format_sse_usage_chunk(is_chat bool, req_id &string, created int, model_id &string, ptoks int, ctoks int) string {
    $obj := "text_completion"
    if is_chat {
        obj = "chat.completion.chunk"
    }
    ttoks := ptoks + ctoks
    << "data: {\"id\":" + json.quote(req_id) + ",\"object\":" + json.quote(&obj) + ",\"created\":" + str(created) +
       ",\"model\":" + json.quote(model_id) + ",\"choices\":[],\"usage\":{\"prompt_tokens\":" + str(ptoks) +
       ",\"completion_tokens\":" + str(ctoks) + ",\"total_tokens\":" + str(ttoks) + "}}\n\n"
}

fn format_sse_reasoning_chunk(req_id &string, created int, model_id &string, text &string) string {
    << "data: {\"id\":" + json.quote(req_id) + ",\"object\":\"chat.completion.chunk\",\"created\":" + str(created) +
       ",\"model\":" + json.quote(model_id) + ",\"choices\":[{\"index\":0,\"delta\":{\"reasoning_content\":" + json.quote(text) +
       "},\"finish_reason\":null}]}\n\n"
}

fn format_sse_tool_calls_chunk(req_id &string, created int, model_id &string, tc_delta_json &string) string {
    << "data: {\"id\":" + json.quote(req_id) + ",\"object\":\"chat.completion.chunk\",\"created\":" + str(created) +
       ",\"model\":" + json.quote(model_id) + ",\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":" + (*tc_delta_json) +
       "},\"finish_reason\":null}]}\n\n"
}

fn format_ant_sse_event(ev &string, data_json &string) string {
    << "event: " + (*ev) + "\ndata: " + (*data_json) + "\n\n"
}

fn run_generation_core(m &Model, kv $&PagedKvCache, row_cache $&[]ForwardRow,
                       sx $&[]f32, sxb $&[]f32, sxb2 $&[]f32,
                       sq $&[]f32, sk $&[]f32, sv $&[]f32,
                       shb $&[]f32, shb2 $&[]f32, slogits $&[]f32,
                       sxq $&[]i8, sxs $&[]f32,
                       prompt_ids &[]int, max_tokens int, temp_milli int, top_k int,
                       top_p_milli int, min_p_milli int, repeat_penalty_milli int,
                       presence_penalty_milli int, frequency_penalty_milli int,
                       seed int, ignore_eos bool, verbose bool, stops &[]string,
                       is_stream bool, is_chat bool, model_id &string,
                       reply_ch chan ServeResponse, stream_ch chan string) GenOutput {
    $rng := seed
    $history := []int{}
    for i in 0:prompt_ids.len { history.push(prompt_ids[i]) }
    $out_ids := []int{}
    $out_text := ""
    $emitted_len := 0
    $max_stop_len := 0
    for k in 0:stops.len {
        if stops[k].len > max_stop_len { max_stop_len = stops[k].len }
    }
    $stop_pad := 0
    if max_stop_len > 1 { stop_pad = max_stop_len - 1 }
    $finish_reason := "length"
    $decode_ns := 0
    t_pref := time.now()
    _ := forward_prefill_batch(m, kv, row_cache, sx, sxb, sxb2, sq, sk, sv, shb, shb2, slogits, sxq, sxs, 0, prompt_ids, 0, true, true) >>> (err) {
        kv_free_slot(kv, 0)
        >>> err
    }
    pref_ns := time.since(t_pref)
    if is_stream {
        reply_ch <- ServeResponse{status: 200, body: "", is_stream: true}
    }
    $pos := prompt_ids.len
    $gen_id := "cmpl-xu"
    if is_chat { gen_id = "chatcmpl-xu" }
    empty_lp := ""

    if max_tokens > 0 {
        next0 := sample_token(slogits, m.cfg.vocab_size, &history, temp_milli, top_k, top_p_milli, min_p_milli, repeat_penalty_milli, presence_penalty_milli, frequency_penalty_milli, $&rng)
        if !ignore_eos && is_eos_token(m, next0) {
            finish_reason = "stop"
        } else {
            piece0 := format_piece(m, next0)
            history.push(next0)
            out_ids.push(next0)
            out_text = out_text + piece0
            $stopped := trim_stop_sequence($&out_text, stops)
            if stopped {
                finish_reason = "stop"
            } else if verbose {
                println("token:0:" + str(next0) + ":" + piece0)
            }
            if is_stream && !stopped {
                safe_end := out_text.len - stop_pad
                if safe_end > emitted_len {
                    delta := out_text[emitted_len:safe_end]
                    emitted_len = safe_end
                    stream_ch <- format_sse_chunk(is_chat, &gen_id, 0, model_id, &delta, "", &empty_lp)
                }
            }
            if !stopped {
                $cur_tok := next0
                t_dec := time.now()
                for g in 1:max_tokens {
                    if pos >= m.cfg.max_seq_len {
                        finish_reason = "length"
                        <-
                    }
                    _ := forward_token(m, kv, sx, sxb, sxb2, sq, sk, sv, shb, shb2, slogits, sxq, sxs, 0, cur_tok, pos, true) >>> (err) {
                        kv_free_slot(kv, 0)
                        if is_stream {
                            stream_ch <- "data: [DONE]\n\n"
                            stream_ch <- ""
                        }
                        >>> err
                    }
                    pos += 1
                    next_tok := sample_token(slogits, m.cfg.vocab_size, &history, temp_milli, top_k, top_p_milli, min_p_milli, repeat_penalty_milli, presence_penalty_milli, frequency_penalty_milli, $&rng)
                    if !ignore_eos && is_eos_token(m, next_tok) {
                        finish_reason = "stop"
                        <-
                    }
                    piece := format_piece(m, next_tok)
                    history.push(next_tok)
                    out_ids.push(next_tok)
                    out_text = out_text + piece
                    if trim_stop_sequence($&out_text, stops) {
                        finish_reason = "stop"
                        <-
                    }
                    if verbose { println("token:" + str(g) + ":" + str(next_tok) + ":" + piece) }
                    if is_stream {
                        safe_end := out_text.len - stop_pad
                        if safe_end > emitted_len {
                            delta := out_text[emitted_len:safe_end]
                            emitted_len = safe_end
                            stream_ch <- format_sse_chunk(is_chat, &gen_id, 0, model_id, &delta, "", &empty_lp)
                        }
                    }
                    cur_tok = next_tok
                }
                decode_ns = time.since(t_dec)
            }
        }
    }
    kv_free_slot(kv, 0)
    if is_stream {
        if out_text.len > emitted_len {
            tail := out_text[emitted_len:out_text.len]
            stream_ch <- format_sse_chunk(is_chat, &gen_id, 0, model_id, &tail, "", &empty_lp)
        }
        empty := ""
        stream_ch <- format_sse_chunk(is_chat, &gen_id, 0, model_id, &empty, finish_reason, &empty_lp)
        stream_ch <- "data: [DONE]\n\n"
        stream_ch <- ""
    }
    << GenOutput{ids: ~out_ids, text: out_text, finish_reason: finish_reason, prefill_ns: pref_ns, decode_ns: decode_ns}
}

fn run_generation_seq(m &Model, kv $&PagedKvCache, row_cache $&[]ForwardRow,
                      sx $&[]f32, sxb $&[]f32, sxb2 $&[]f32,
                      sq $&[]f32, sk $&[]f32, sv $&[]f32,
                      shb $&[]f32, shb2 $&[]f32, slogits $&[]f32,
                      sxq $&[]i8, sxs $&[]f32,
                      prompt_ids &[]int, max_tokens int, temp_milli int, top_k int,
                      top_p_milli int, min_p_milli int, repeat_penalty_milli int,
                      presence_penalty_milli int, frequency_penalty_milli int,
                      seed int, ignore_eos bool, verbose bool) GenOutput {
    no_stops := []string{}
    dummy_id := ""
    dummy_reply := chan ServeResponse{cap: 1}
    dummy_stream := chan string{cap: 1}
    << run_generation_core(m, kv, row_cache, sx, sxb, sxb2, sq, sk, sv, shb, shb2, slogits, sxq, sxs,
                           prompt_ids, max_tokens, temp_milli, top_k, top_p_milli, min_p_milli,
                           repeat_penalty_milli, presence_penalty_milli, frequency_penalty_milli,
                           seed, ignore_eos, verbose, &no_stops, false, false, &dummy_id,
                           dummy_reply, dummy_stream) >>>
}

struct ParsedServeReq {
    prompt_text string
    embed_texts []string
    max_tokens int
    temp_milli int
    top_k int
    top_p_milli int
    min_p_milli int
    repeat_penalty_milli int
    presence_penalty_milli int
    frequency_penalty_milli int
    seed int
    ignore_eos bool
    stream bool
    include_usage bool
    want_logprobs bool
    top_logprobs int
    json_mode bool
    has_tools bool
    is_anthropic bool
    is_responses bool
    prev_resp_id string
    resp_prefix string
    stops []string
    bias_ids []int
    bias_vals []f32
}

struct TokenLogprobRecord {
    token string
    logprob string
    tops_dict string
    tops_arr string
}

fn find_substr_from(hay &string, needle &string, start int) int {
    if needle.len == 0 { << start }
    if start < 0 || needle.len > hay.len - start { << -1 }
    limit := hay.len - needle.len + 1
    for i in start:limit {
        $ok := true
        for j in 0:needle.len {
            if (*hay)[i + j] != (*needle)[j] {
                ok = false
                <-
            }
        }
        if ok { << i }
    }
    << -1
}

fn trim_ascii_ws(s &string) string {
    $l := 0
    $r := s.len
    while l < r {
        c := (*s)[l] & 255
        if c != 32 && c != 9 && c != 10 && c != 13 { <- }
        l += 1
    }
    while r > l {
        c := (*s)[r - 1] & 255
        if c != 32 && c != 9 && c != 10 && c != 13 { <- }
        r -= 1
    }
    << (*s)[l:r]
}

fn format_lp_float(v f32) string {
    << strconv.format_float(f64(v), 102, 6) >>> (_) { << "0.0" }
}

fn compute_logprobs_vec(logits &[]f32, off int, vocab int) []f32 {
    $lp := alloc_zeros(vocab)
    for i in 0:vocab { lp[i] = logits[off + i] }
    tensor.log_softmax_f32($&lp, vocab)
    << lp
}

fn record_token_logprob(model &Model, lp &[]f32, chosen int, top_k int) TokenLogprobRecord {
    piece := format_piece(model, chosen)
    chosen_lp := format_lp_float(lp[chosen])
    $k := top_k
    if k < 0 { k = 0 }
    if k > 20 { k = 20 }
    if k > model.cfg.vocab_size { k = model.cfg.vocab_size }
    if k == 0 {
        << TokenLogprobRecord{token: piece, logprob: chosen_lp, tops_dict: "{}", tops_arr: "[]"}
    }
    $best_i := []int{}
    $best_v := []f32{}
    for _ in 0:k {
        best_i.push(-1)
        best_v.push(f32(-1e30))
    }
    for i in 0:model.cfg.vocab_size {
        v := lp[i]
        if v > best_v[k - 1] {
            $pos := k - 1
            while pos > 0 && v > best_v[pos - 1] {
                best_v[pos] = best_v[pos - 1]
                best_i[pos] = best_i[pos - 1]
                pos -= 1
            }
            best_v[pos] = v
            best_i[pos] = i
        }
    }
    $td := "{"
    $ta := "["
    $cnt := 0
    for j in 0:k {
        ti := best_i[j]
        if ti < 0 { <- }
        tp := format_piece(model, ti)
        tv := format_lp_float(best_v[j])
        if cnt > 0 {
            td = td + ","
            ta = ta + ","
        }
        td = td + json.quote(&tp) + ":" + tv
        ta = ta + "{\"token\":" + json.quote(&tp) + ",\"logprob\":" + tv + "}"
        cnt += 1
    }
    td = td + "}"
    ta = ta + "]"
    << TokenLogprobRecord{token: piece, logprob: chosen_lp, tops_dict: td, tops_arr: ta}
}

fn format_chat_lp_item(rec &TokenLogprobRecord) string {
    << "{\"token\":" + json.quote(&rec.token) + ",\"logprob\":" + rec.logprob + ",\"top_logprobs\":" + rec.tops_arr + "}"
}

fn format_slot_logprobs_json(is_chat bool, recs &[]TokenLogprobRecord) string {
    if is_chat {
        $s := "{\"content\":["
        for i in 0:recs.len {
            if i > 0 { s = s + "," }
            s = s + format_chat_lp_item(&recs[i])
        }
        << s + "]}"
    }
    $toks := "["
    $lps := "["
    $tops := "["
    for i in 0:recs.len {
        if i > 0 {
            toks = toks + ","
            lps = lps + ","
            tops = tops + ","
        }
        toks = toks + json.quote(&recs[i].token)
        lps = lps + recs[i].logprob
        tops = tops + recs[i].tops_dict
    }
    << "{\"tokens\":" + toks + "],\"token_logprobs\":" + lps + "],\"top_logprobs\":" + tops + "]}"
}

fn apply_json_logit_mask(logits $&[]f32, off int, model &Model, started bool) {
    if started { << }
    vocab := model.cfg.vocab_size
    $has_open := false
    for i in 0:vocab {
        p := format_piece(model, i)
        tp := trim_ascii_ws(&p)
        if tp.len > 0 && (tp[0] == 123 || tp[0] == 91) {
            has_open = true
            <-
        }
    }
    if !has_open { << }
    for i in 0:vocab {
        p := format_piece(model, i)
        tp := trim_ascii_ws(&p)
        if tp.len == 0 || (tp[0] != 123 && tp[0] != 91) {
            logits[off + i] = f32(-1e9)
        }
    }
}

fn advance_json_state(piece &string, depth $&int, started $&bool, in_str $&bool, esc $&bool) int {
    for i in 0:piece.len {
        ch := (*piece)[i] & 255
        if *in_str {
            if *esc {
                *esc = false
            } else if ch == 92 {
                *esc = true
            } else if ch == 34 {
                *in_str = false
            }
        } else {
            if ch == 34 {
                *in_str = true
            } else if ch == 123 || ch == 91 {
                *started = true
                *depth += 1
            } else if ch == 125 || ch == 93 {
                if *depth > 0 { *depth -= 1 }
                if *started && *depth == 0 {
                    << i + 1
                }
            }
        }
    }
    << -1
}

fn llm_doc_get(doc &json.Doc, obj int, key string, def int) int {
    << doc.get(obj, key) >>> (_) { << def }
}

fn llm_doc_str(doc &json.Doc, node int, def string) string {
    << doc.as_string(node) >>> (_) { << def }
}

fn llm_doc_encode(doc &json.Doc, node int, def string) string {
    << doc.encode(node) >>> (_) { << def }
}

fn llm_parse_int_or(s &string, def int) int {
    << strconv.atoi(s) >>> (_) { << def }
}

fn format_tools_prompt(doc &json.Doc, tools int) string {
    cnt := doc.count(tools)
    if cnt <= 0 { << "" }
    $out := "You have access to tools. When calling a tool, emit <tool_call>{\"name\":\"...\",\"arguments\":{...}}</tool_call>.\nTools:"
    for i in 0:cnt {
        item := doc.at(tools, i) >>> (_) { -> }
        if !doc.is_dict(item) { -> }
        $fnode := item
        if doc.has(item, "function") {
            fnode = llm_doc_get(doc, item, "function", item)
        }
        if !doc.is_dict(fnode) || !doc.has(fnode, "name") { -> }
        nnode := doc.get(fnode, "name") >>> (_) { -> }
        if !doc.is_string(nnode) { -> }
        tname := doc.as_string(nnode) >>> (_) { -> }
        out = out + "\n- " + tname
        if doc.has(fnode, "description") {
            dn := llm_doc_get(doc, fnode, "description", -1)
            if dn >= 0 && doc.is_string(dn) {
                dstr := llm_doc_str(doc, dn, "")
                if dstr.len > 0 { out = out + ": " + dstr }
            }
        }
        if doc.has(fnode, "parameters") {
            pn := llm_doc_get(doc, fnode, "parameters", -1)
            if pn >= 0 {
                pstr := llm_doc_encode(doc, pn, "{}")
                out = out + " parameters=" + pstr
            }
        } else if doc.has(fnode, "input_schema") {
            pn := llm_doc_get(doc, fnode, "input_schema", -1)
            if pn >= 0 {
                pstr := llm_doc_encode(doc, pn, "{}")
                out = out + " parameters=" + pstr
            }
        }
    }
    << out
}

struct ParsedToolCall {
    id string
    name string
    arguments string
}

struct ThinkSplit {
    reasoning string
    content string
}

struct ServeStreamState {
    is_anthropic bool
    is_responses bool
    ant_started bool
    ant_block_open bool
    ant_block_kind int
    ant_block_idx int
    think_mode int
    in_tool bool
}

fn new_serve_stream_state(is_ant bool, is_resp bool) ServeStreamState {
    << ServeStreamState{
        is_anthropic: is_ant,
        is_responses: is_resp,
        ant_started: false,
        ant_block_open: false,
        ant_block_kind: 0,
        ant_block_idx: 0,
        think_mode: 0,
        in_tool: false
    }
}

fn extract_tool_calls(text &string) []ParsedToolCall {
    open_tag := "<tool_call>"
    close_tag := "</tool_call>"
    $pos := 0
    $out := []ParsedToolCall{}
    $cnt := 0
    for {
        s_idx := find_substr_from(text, &open_tag, pos)
        if s_idx < 0 { <- }
        body_start := s_idx + open_tag.len
        e_idx := find_substr_from(text, &close_tag, body_start)
        if e_idx < 0 { <- }
        raw := (*text)[body_start:e_idx]
        trimmed := trim_ascii_ws(&raw)
        td := json.parse(&trimmed)
        if td.ok() && td.is_dict(td.root()) && td.has(td.root(), "name") {
            nn := llm_doc_get(&td, td.root(), "name", -1)
            if nn >= 0 && td.is_string(nn) {
                tname := llm_doc_str(&td, nn, "")
                $targs := "{}"
                if td.has(td.root(), "arguments") {
                    an := llm_doc_get(&td, td.root(), "arguments", -1)
                    if an >= 0 {
                        if td.is_string(an) { targs = llm_doc_str(&td, an, "{}") }
                        else { targs = llm_doc_encode(&td, an, "{}") }
                    }
                } else if td.has(td.root(), "input") {
                    an := llm_doc_get(&td, td.root(), "input", -1)
                    if an >= 0 {
                        if td.is_string(an) { targs = llm_doc_str(&td, an, "{}") }
                        else { targs = llm_doc_encode(&td, an, "{}") }
                    }
                }
                cid := "call_" + str(cnt)
                out.push(ParsedToolCall{id: cid, name: tname, arguments: targs})
                cnt += 1
            }
        }
        pos = e_idx + close_tag.len
    }
    << out
}

fn format_tool_calls_array(tcs &[]ParsedToolCall, for_delta bool) string {
    if tcs.len == 0 { << "" }
    $arr := "["
    for i in 0:tcs.len {
        if i > 0 { arr = arr + "," }
        tc := &tcs[i]
        $idx_part := ""
        if for_delta { idx_part = "\"index\":" + str(i) + "," }
        arr = arr + "{" + idx_part + "\"id\":" + json.quote(&tc.id) + ",\"type\":\"function\",\"function\":{\"name\":" +
              json.quote(&tc.name) + ",\"arguments\":" + json.quote(&tc.arguments) + "}}"
    }
    << arr + "]"
}

fn parse_tool_calls_json(text &string) string {
    tcs := extract_tool_calls(text)
    << format_tool_calls_array(&tcs, false)
}

fn strip_tool_call_blocks(text &string) string {
    open_tag := "<tool_call>"
    close_tag := "</tool_call>"
    $pos := 0
    $out := ""
    for {
        s_idx := find_substr_from(text, &open_tag, pos)
        if s_idx < 0 {
            if pos < text.len { out = out + (*text)[pos:text.len] }
            <-
        }
        if s_idx > pos { out = out + (*text)[pos:s_idx] }
        e_idx := find_substr_from(text, &close_tag, s_idx + open_tag.len)
        if e_idx < 0 {
            out = out + (*text)[s_idx:text.len]
            <-
        }
        pos = e_idx + close_tag.len
    }
    << trim_ascii_ws(&out)
}

fn split_think_text(text &string) ThinkSplit {
    open_tag := "<think>"
    close_tag := "</think>"
    oi := find_substr_from(text, &open_tag, 0)
    if oi < 0 {
        << ThinkSplit{reasoning: "", content: (*text) + ""}
    }
    prefix := (*text)[0:oi]
    r_start := oi + open_tag.len
    ci := find_substr_from(text, &close_tag, r_start)
    if ci < 0 {
        << ThinkSplit{reasoning: (*text)[r_start:text.len], content: prefix}
    }
    reason := (*text)[r_start:ci]
    $c_start := ci + close_tag.len
    if c_start < text.len && (*text)[c_start] == 10 {
        c_start += 1
    }
    rest := (*text)[c_start:text.len]
    << ThinkSplit{reasoning: reason, content: prefix + rest}
}

fn match_tag_suffix_len(text &string, start int, end int, pat &string) int {
    avail := end - start
    if avail <= 0 || pat.len <= 1 { << 0 }
    $max_k := pat.len - 1
    if avail < max_k { max_k = avail }
    $k := max_k
    while k > 0 {
        off := end - k
        $eq := true
        for j in 0:k {
            if (*text)[off + j] != (*pat)[j] {
                eq = false
                <-
            }
        }
        if eq { << k }
        k -= 1
    }
    << 0
}

fn tag_holdback_len(text &string, start int, end int, check_open_think bool, check_close_think bool, check_tool bool) int {
    $best := 0
    if check_open_think {
        p1 := "<think>"
        h1 := match_tag_suffix_len(text, start, end, &p1)
        if h1 > best { best = h1 }
    }
    if check_close_think {
        p2 := "</think>"
        h2 := match_tag_suffix_len(text, start, end, &p2)
        if h2 > best { best = h2 }
    }
    if check_tool {
        p3 := "<tool_call>"
        h3 := match_tag_suffix_len(text, start, end, &p3)
        if h3 > best { best = h3 }
    }
    << best
}

fn format_chat_messages(doc &json.Doc, msgs int, tmpl_kind int, tools_sys &string) string {
    $out := ""
    $sys_buf := ""
    $has_content := false
    count := doc.count(msgs)
    if tmpl_kind == TEMPLATE_LLAMA3 {
        out = "<|begin_of_text|>"
    }
    if tools_sys.len > 0 {
        if tmpl_kind == TEMPLATE_CHATML {
            out = out + "<|im_start|>system\n" + (*tools_sys) + "<|im_end|>\n"
        } else if tmpl_kind == TEMPLATE_LLAMA3 {
            out = out + "<|start_header_id|>system<|end_header_id|>\n\n" + (*tools_sys) + "<|eot_id|>"
        } else if tmpl_kind == TEMPLATE_GEMMA {
            out = out + "<start_of_turn>user\n" + (*tools_sys) + "<end_of_turn>\n"
        } else if tmpl_kind == TEMPLATE_MISTRAL {
            sys_buf = (*tools_sys) + ""
        } else {
            out = (*tools_sys) + ""
        }
    }
    for mi in 0:count {
        mnode := doc.at(msgs, mi) >>>
        if doc.is_dict(mnode) {
            $role := "user"
            if doc.has(mnode, "role") {
                rnode := doc.get(mnode, "role") >>>
                if doc.is_string(rnode) { role = doc.as_string(rnode) >>> }
            }
            $cstr := ""
            if doc.has(mnode, "content") {
                cnode := doc.get(mnode, "content") >>>
                if doc.is_string(cnode) {
                    cstr = doc.as_string(cnode) >>>
                } else if doc.is_list(cnode) {
                    parts_cnt := doc.count(cnode)
                    for pi in 0:parts_cnt {
                        pnode := doc.at(cnode, pi) >>>
                        if doc.is_dict(pnode) && doc.has(pnode, "text") {
                            ptn := doc.get(pnode, "text") >>>
                            if doc.is_string(ptn) {
                                tpart := doc.as_string(ptn) >>>
                                cstr = cstr + tpart
                            }
                        }
                    }
                }
            }
            if role == "assistant" && doc.has(mnode, "tool_calls") {
                tcnode := doc.get(mnode, "tool_calls") >>>
                if doc.is_list(tcnode) {
                    tcnt := doc.count(tcnode)
                    for ti in 0:tcnt {
                        titem := doc.at(tcnode, ti) >>>
                        if !doc.is_dict(titem) { -> }
                        $fobj := titem
                        if doc.has(titem, "function") {
                            fobj = llm_doc_get(doc, titem, "function", titem)
                        }
                        if !doc.is_dict(fobj) || !doc.has(fobj, "name") { -> }
                        fn_node := llm_doc_get(doc, fobj, "name", -1)
                        if fn_node < 0 || !doc.is_string(fn_node) { -> }
                        fn_name := llm_doc_str(doc, fn_node, "")
                        $fn_args := "{}"
                        if doc.has(fobj, "arguments") {
                            an := llm_doc_get(doc, fobj, "arguments", -1)
                            if an >= 0 {
                                if doc.is_string(an) { fn_args = llm_doc_str(doc, an, "{}") }
                                else { fn_args = llm_doc_encode(doc, an, "{}") }
                            }
                        }
                        if cstr.len > 0 { cstr = cstr + "\n" }
                        cstr = cstr + "<tool_call>{\"name\":" + json.quote(&fn_name) + ",\"arguments\":" + json.quote(&fn_args) + "}</tool_call>"
                    }
                }
            }
            if cstr.len > 0 { has_content = true }
            if tmpl_kind == TEMPLATE_CHATML {
                if role == "tool" {
                    out = out + "<|im_start|>user\n<tool_response>\n" + cstr + "\n</tool_response><|im_end|>\n"
                } else {
                    out = out + "<|im_start|>" + role + "\n" + cstr + "<|im_end|>\n"
                }
            } else if tmpl_kind == TEMPLATE_LLAMA3 {
                $rlabel := role
                if role == "tool" { rlabel = "ipython" }
                out = out + "<|start_header_id|>" + rlabel + "<|end_header_id|>\n\n" + cstr + "<|eot_id|>"
            } else if tmpl_kind == TEMPLATE_GEMMA {
                $grole := role
                if role == "assistant" { grole = "model" }
                else if role == "system" || role == "tool" { grole = "user" }
                out = out + "<start_of_turn>" + grole + "\n" + cstr + "<end_of_turn>\n"
            } else if tmpl_kind == TEMPLATE_MISTRAL {
                if role == "system" {
                    if sys_buf.len > 0 { sys_buf = sys_buf + "\n\n" + cstr }
                    else { sys_buf = cstr }
                } else if role == "tool" {
                    out = out + "[TOOL_RESULTS] " + cstr + " [/TOOL_RESULTS]"
                } else if role == "user" {
                    $u := cstr
                    if sys_buf.len > 0 {
                        u = sys_buf + "\n\n" + u
                        sys_buf = ""
                    }
                    out = out + "[INST] " + u + " [/INST]"
                } else {
                    out = out + " " + cstr + "</s>"
                }
            } else {
                if out.len > 0 { out = out + "\n" }
                if role == "tool" { out = out + "Tool result: " + cstr }
                else { out = out + cstr }
            }
        }
    }
    if !has_content || (out.len == 0 && sys_buf.len == 0) {
        >>> errors.new("messages content is empty")
    }
    if tmpl_kind == TEMPLATE_CHATML {
        out = out + "<|im_start|>assistant\n"
    } else if tmpl_kind == TEMPLATE_LLAMA3 {
        out = out + "<|start_header_id|>assistant<|end_header_id|>\n\n"
    } else if tmpl_kind == TEMPLATE_GEMMA {
        out = out + "<start_of_turn>model\n"
    }
    << out
}

fn extract_anth_text_blocks(doc &json.Doc, node int) string {
    if doc.is_string(node) { << llm_doc_str(doc, node, "") }
    if !doc.is_list(node) { << "" }
    $out := ""
    cnt := doc.count(node)
    for pi in 0:cnt {
        pnode := doc.at(node, pi) >>> (_) { -> }
        if doc.is_string(pnode) {
            out = out + llm_doc_str(doc, pnode, "")
        } else if doc.is_dict(pnode) && doc.has(pnode, "text") {
            out = out + llm_doc_str(doc, llm_doc_get(doc, pnode, "text", -1), "")
        }
    }
    << out
}

fn format_anthropic_messages(doc &json.Doc, root int, msgs int, tmpl_kind int, tools_sys &string) string {
    $sys_buf := ""
    if doc.has(root, "system") {
        snode := doc.get(root, "system") >>>
        sys_buf = extract_anth_text_blocks(doc, snode)
    }
    if tools_sys.len > 0 {
        if sys_buf.len > 0 { sys_buf = sys_buf + "\n\n" + (*tools_sys) }
        else { sys_buf = (*tools_sys) + "" }
    }
    $out := ""
    if tmpl_kind == TEMPLATE_LLAMA3 { out = "<|begin_of_text|>" }
    if sys_buf.len > 0 && tmpl_kind != TEMPLATE_MISTRAL {
        if tmpl_kind == TEMPLATE_CHATML {
            out = out + "<|im_start|>system\n" + sys_buf + "<|im_end|>\n"
        } else if tmpl_kind == TEMPLATE_LLAMA3 {
            out = out + "<|start_header_id|>system<|end_header_id|>\n\n" + sys_buf + "<|eot_id|>"
        } else if tmpl_kind == TEMPLATE_GEMMA {
            out = out + "<start_of_turn>user\n" + sys_buf + "<end_of_turn>\n"
        } else {
            out = sys_buf + ""
        }
        sys_buf = ""
    }
    $has_content := false
    count := doc.count(msgs)
    for mi in 0:count {
        mnode := doc.at(msgs, mi) >>>
        if !doc.is_dict(mnode) { -> }
        $role := "user"
        if doc.has(mnode, "role") {
            rnode := doc.get(mnode, "role") >>>
            if doc.is_string(rnode) { role = doc.as_string(rnode) >>> }
        }
        $eff_role := role
        $cstr := ""
        $has_tool_result := false
        if doc.has(mnode, "content") {
            cnode := doc.get(mnode, "content") >>>
            if doc.is_string(cnode) {
                cstr = doc.as_string(cnode) >>>
            } else if doc.is_list(cnode) {
                pcnt := doc.count(cnode)
                for pi in 0:pcnt {
                    pnode := doc.at(cnode, pi) >>>
                    if !doc.is_dict(pnode) { -> }
                    $ptype := "text"
                    if doc.has(pnode, "type") {
                        ptn := doc.get(pnode, "type") >>>
                        if doc.is_string(ptn) { ptype = doc.as_string(ptn) >>> }
                    }
                    if ptype == "text" && doc.has(pnode, "text") {
                        cstr = cstr + llm_doc_str(doc, llm_doc_get(doc, pnode, "text", -1), "")
                    } else if ptype == "tool_use" {
                        fn_name := llm_doc_str(doc, llm_doc_get(doc, pnode, "name", -1), "")
                        $fn_args := "{}"
                        if doc.has(pnode, "input") {
                            fn_args = llm_doc_encode(doc, llm_doc_get(doc, pnode, "input", -1), "{}")
                        }
                        if cstr.len > 0 { cstr = cstr + "\n" }
                        cstr = cstr + "<tool_call>{\"name\":" + json.quote(&fn_name) + ",\"arguments\":" + json.quote(&fn_args) + "}</tool_call>"
                    } else if ptype == "tool_result" {
                        has_tool_result = true
                        eff_role = "tool"
                        $tres := ""
                        if doc.has(pnode, "content") {
                            tres = extract_anth_text_blocks(doc, llm_doc_get(doc, pnode, "content", -1))
                        }
                        if cstr.len > 0 { cstr = cstr + "\n" }
                        cstr = cstr + tres
                    }
                }
            }
        }
        if cstr.len > 0 || has_tool_result { has_content = true }
        if tmpl_kind == TEMPLATE_CHATML {
            if eff_role == "tool" {
                out = out + "<|im_start|>user\n<tool_response>\n" + cstr + "\n</tool_response><|im_end|>\n"
            } else {
                out = out + "<|im_start|>" + eff_role + "\n" + cstr + "<|im_end|>\n"
            }
        } else if tmpl_kind == TEMPLATE_LLAMA3 {
            $rlabel := eff_role
            if eff_role == "tool" { rlabel = "ipython" }
            out = out + "<|start_header_id|>" + rlabel + "<|end_header_id|>\n\n" + cstr + "<|eot_id|>"
        } else if tmpl_kind == TEMPLATE_GEMMA {
            $grole := eff_role
            if eff_role == "assistant" { grole = "model" }
            else if eff_role == "tool" { grole = "user" }
            out = out + "<start_of_turn>" + grole + "\n" + cstr + "<end_of_turn>\n"
        } else if tmpl_kind == TEMPLATE_MISTRAL {
            if eff_role == "tool" {
                out = out + "[TOOL_RESULTS] " + cstr + " [/TOOL_RESULTS]"
            } else if eff_role == "user" {
                $u := cstr
                if sys_buf.len > 0 {
                    u = sys_buf + "\n\n" + u
                    sys_buf = ""
                }
                out = out + "[INST] " + u + " [/INST]"
            } else {
                out = out + " " + cstr + "</s>"
            }
        } else {
            if out.len > 0 { out = out + "\n" }
            if eff_role == "tool" { out = out + "Tool result: " + cstr }
            else { out = out + cstr }
        }
    }
    if !has_content || (out.len == 0 && sys_buf.len == 0) {
        >>> errors.new("messages content is empty")
    }
    if tmpl_kind == TEMPLATE_CHATML {
        out = out + "<|im_start|>assistant\n"
    } else if tmpl_kind == TEMPLATE_LLAMA3 {
        out = out + "<|start_header_id|>assistant<|end_header_id|>\n\n"
    } else if tmpl_kind == TEMPLATE_GEMMA {
        out = out + "<start_of_turn>model\n"
    }
    << out
}

fn resp_gen_trigger(tmpl_kind int) string {
    if tmpl_kind == TEMPLATE_CHATML { << "<|im_start|>assistant\n" }
    if tmpl_kind == TEMPLATE_LLAMA3 { << "<|start_header_id|>assistant<|end_header_id|>\n\n" }
    if tmpl_kind == TEMPLATE_GEMMA { << "<start_of_turn>model\n" }
    << ""
}

fn resp_turn_end(tmpl_kind int) string {
    if tmpl_kind == TEMPLATE_CHATML { << "<|im_end|>\n" }
    if tmpl_kind == TEMPLATE_LLAMA3 { << "<|eot_id|>" }
    if tmpl_kind == TEMPLATE_GEMMA { << "<end_of_turn>\n" }
    if tmpl_kind == TEMPLATE_MISTRAL { << "</s>" }
    << ""
}

fn append_resp_turn(out $&string, sys_buf $&string, tmpl_kind int, role &string, cstr &string) {
    if tmpl_kind == TEMPLATE_CHATML {
        if *role == "tool" {
            *out = *out + "<|im_start|>user\n<tool_response>\n" + (*cstr) + "\n</tool_response><|im_end|>\n"
        } else {
            *out = *out + "<|im_start|>" + (*role) + "\n" + (*cstr) + "<|im_end|>\n"
        }
    } else if tmpl_kind == TEMPLATE_LLAMA3 {
        $rlabel := (*role) + ""
        if *role == "tool" { rlabel = "ipython" }
        *out = *out + "<|start_header_id|>" + rlabel + "<|end_header_id|>\n\n" + (*cstr) + "<|eot_id|>"
    } else if tmpl_kind == TEMPLATE_GEMMA {
        $grole := (*role) + ""
        if *role == "assistant" { grole = "model" }
        else if *role == "system" || *role == "tool" { grole = "user" }
        *out = *out + "<start_of_turn>" + grole + "\n" + (*cstr) + "<end_of_turn>\n"
    } else if tmpl_kind == TEMPLATE_MISTRAL {
        if *role == "system" {
            if sys_buf.len > 0 { *sys_buf = *sys_buf + "\n\n" + (*cstr) }
            else { *sys_buf = (*cstr) + "" }
        } else if *role == "tool" {
            *out = *out + "[TOOL_RESULTS] " + (*cstr) + " [/TOOL_RESULTS]"
        } else if *role == "user" {
            $u := (*cstr) + ""
            if sys_buf.len > 0 {
                u = (*sys_buf) + "\n\n" + u
                *sys_buf = ""
            }
            *out = *out + "[INST] " + u + " [/INST]"
        } else {
            *out = *out + " " + (*cstr) + "</s>"
        }
    } else {
        if out.len > 0 { *out = *out + "\n" }
        if *role == "tool" { *out = *out + "Tool result: " + (*cstr) }
        else { *out = *out + (*cstr) }
    }
}

fn format_responses_messages(doc &json.Doc, root int, tmpl_kind int, tools_sys &string,
                             prev_ctx &string, prefix_out $&string) string {
    $out := ""
    $sys_buf := ""
    if prev_ctx.len > 0 {
        out = (*prev_ctx) + ""
    } else {
        if doc.has(root, "instructions") {
            in_n := doc.get(root, "instructions") >>>
            if doc.is_string(in_n) {
                sys_buf = doc.as_string(in_n) >>>
            }
        }
        if tools_sys.len > 0 {
            if sys_buf.len > 0 { sys_buf = sys_buf + "\n\n" + (*tools_sys) }
            else { sys_buf = (*tools_sys) + "" }
        }
        if tmpl_kind == TEMPLATE_LLAMA3 { out = "<|begin_of_text|>" }
        if sys_buf.len > 0 && tmpl_kind != TEMPLATE_MISTRAL {
            srole := "system"
            sys_copy := sys_buf + ""
            append_resp_turn($&out, $&sys_buf, tmpl_kind, &srole, &sys_copy)
            sys_buf = ""
        }
    }
    if !doc.has(root, "input") { >>> errors.new("missing input") }
    inode := doc.get(root, "input") >>>
    $has_content := prev_ctx.len > 0
    if doc.is_string(inode) {
        s := doc.as_string(inode) >>>
        if s.len > 0 { has_content = true }
        urole := "user"
        append_resp_turn($&out, $&sys_buf, tmpl_kind, &urole, &s)
    } else if doc.is_list(inode) {
        cnt := doc.count(inode)
        if cnt == 0 { >>> errors.new("input array must be non-empty") }
        for ii in 0:cnt {
            item := doc.at(inode, ii) >>>
            if doc.is_string(item) {
                s := doc.as_string(item) >>>
                if s.len > 0 { has_content = true }
                urole := "user"
                append_resp_turn($&out, $&sys_buf, tmpl_kind, &urole, &s)
            } else if doc.is_dict(item) {
                $itype := ""
                if doc.has(item, "type") {
                    tn := doc.get(item, "type") >>>
                    if doc.is_string(tn) { itype = doc.as_string(tn) >>> }
                }
                if itype == "function_call" {
                    fn_name := llm_doc_str(doc, llm_doc_get(doc, item, "name", -1), "")
                    $fn_args := "{}"
                    if doc.has(item, "arguments") {
                        an := llm_doc_get(doc, item, "arguments", -1)
                        if an >= 0 {
                            if doc.is_string(an) { fn_args = llm_doc_str(doc, an, "{}") }
                            else { fn_args = llm_doc_encode(doc, an, "{}") }
                        }
                    }
                    cstr := "<tool_call>{\"name\":" + json.quote(&fn_name) + ",\"arguments\":" + json.quote(&fn_args) + "}</tool_call>"
                    has_content = true
                    arole := "assistant"
                    append_resp_turn($&out, $&sys_buf, tmpl_kind, &arole, &cstr)
                } else if itype == "function_call_output" {
                    $cstr := ""
                    if doc.has(item, "output") {
                        on := llm_doc_get(doc, item, "output", -1)
                        if on >= 0 {
                            if doc.is_string(on) { cstr = llm_doc_str(doc, on, "") }
                            else { cstr = llm_doc_encode(doc, on, "") }
                        }
                    }
                    has_content = true
                    trole := "tool"
                    append_resp_turn($&out, $&sys_buf, tmpl_kind, &trole, &cstr)
                } else {
                    $role := "user"
                    if doc.has(item, "role") {
                        rn := doc.get(item, "role") >>>
                        if doc.is_string(rn) { role = doc.as_string(rn) >>> }
                    }
                    $cstr := ""
                    if doc.has(item, "content") {
                        cn := doc.get(item, "content") >>>
                        cstr = extract_anth_text_blocks(doc, cn)
                    } else if doc.has(item, "text") {
                        cstr = llm_doc_str(doc, llm_doc_get(doc, item, "text", -1), "")
                    }
                    if cstr.len > 0 { has_content = true }
                    append_resp_turn($&out, $&sys_buf, tmpl_kind, &role, &cstr)
                }
            }
        }
    } else {
        >>> errors.new("input must be string or array")
    }
    if !has_content || (out.len == 0 && sys_buf.len == 0) {
        >>> errors.new("responses input is empty")
    }
    *prefix_out = out + ""
    << out + resp_gen_trigger(tmpl_kind)
}

fn format_responses_sync_body(rid &string, created int, model_id &string, out_text &string,
                              has_tools bool, ptoks int, ctoks int) string {
    sp := split_think_text(out_text)
    $vis_text := sp.content + ""
    $tcs := []ParsedToolCall{}
    if has_tools {
        tcs = extract_tool_calls(&sp.content)
        if tcs.len > 0 {
            vis_text = strip_tool_call_blocks(&sp.content)
        }
    }
    $out_arr := "["
    $ocnt := 0
    if vis_text.len > 0 || tcs.len == 0 {
        out_arr = out_arr + "{\"type\":\"message\",\"id\":\"msg_0\",\"role\":\"assistant\",\"status\":\"completed\",\"content\":[{\"type\":\"output_text\",\"text\":" + json.quote(&vis_text) + "}]}"
        ocnt += 1
    }
    for ti in 0:tcs.len {
        tc := &tcs[ti]
        if ocnt > 0 { out_arr = out_arr + "," }
        out_arr = out_arr + "{\"type\":\"function_call\",\"id\":\"fc_" + str(ti) +
                  "\",\"call_id\":" + json.quote(&tc.id) +
                  ",\"name\":" + json.quote(&tc.name) +
                  ",\"arguments\":" + json.quote(&tc.arguments) + "}"
        ocnt += 1
    }
    out_arr = out_arr + "]"
    ttoks := ptoks + ctoks
    << "{\"id\":" + json.quote(rid) + ",\"object\":\"response\",\"created_at\":" + str(created) +
       ",\"status\":\"completed\",\"model\":" + json.quote(model_id) +
       ",\"output\":" + out_arr +
       ",\"output_text\":" + json.quote(&vis_text) +
       ",\"usage\":{\"input_tokens\":" + str(ptoks) +
       ",\"output_tokens\":" + str(ctoks) + ",\"total_tokens\":" + str(ttoks) + "}}"
}

fn parse_serve_request(path &string, body &string, def_topp int, def_minp int, def_rep int,
                       def_pres int, def_freq int, def_seed int, def_ignore_eos bool,
                       tmpl_kind int, resp_hist_ids &[]string, resp_hist_ctx &[]string) ParsedServeReq {
    doc := json.parse(body)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >>> errors.new("invalid json object")
    }
    root := doc.root()
    $prompt_text := ""
    $embed_texts := []string{}
    $r_has_tools := false
    $r_is_anthropic := false
    $r_is_responses := false
    $r_prev_resp_id := ""
    $r_resp_prefix := ""
    if *path == "/v1/completions" {
        if !doc.has(root, "prompt") { >>> errors.new("missing prompt") }
        pnode := doc.get(root, "prompt") >>>
        if !doc.is_string(pnode) { >>> errors.new("prompt must be string") }
        prompt_text = doc.as_string(pnode) >>>
    } else if *path == "/v1/embeddings" {
        if !doc.has(root, "input") { >>> errors.new("missing input") }
        inode := doc.get(root, "input") >>>
        if doc.is_string(inode) {
            s := doc.as_string(inode) >>>
            embed_texts.push(s)
        } else if doc.is_list(inode) {
            cnt := doc.count(inode)
            if cnt == 0 { >>> errors.new("input array must be non-empty") }
            for ei in 0:cnt {
                enode := doc.at(inode, ei) >>>
                if !doc.is_string(enode) { >>> errors.new("input elements must be strings") }
                es := doc.as_string(enode) >>>
                embed_texts.push(es)
            }
        } else {
            >>> errors.new("input must be string or string array")
        }
    } else if *path == "/v1/messages" {
        r_is_anthropic = true
        if !doc.has(root, "messages") { >>> errors.new("missing messages") }
        msgs := doc.get(root, "messages") >>>
        if !doc.is_list(msgs) || doc.count(msgs) == 0 {
            >>> errors.new("messages must be non-empty array")
        }
        $tools_sys := ""
        if doc.has(root, "tools") {
            tnode := doc.get(root, "tools") >>>
            if doc.is_list(tnode) && doc.count(tnode) > 0 {
                r_has_tools = true
                tools_sys = format_tools_prompt(&doc, tnode)
            }
        }
        prompt_text = format_anthropic_messages(&doc, root, msgs, tmpl_kind, &tools_sys) >>>
    } else if *path == "/v1/responses" {
        r_is_responses = true
        $prev_ctx := ""
        if doc.has(root, "previous_response_id") {
            prn := doc.get(root, "previous_response_id") >>>
            if doc.is_string(prn) {
                r_prev_resp_id = doc.as_string(prn) >>>
                if r_prev_resp_id.len > 0 {
                    $found := false
                    for ri in 0:resp_hist_ids.len {
                        if resp_hist_ids[ri] == r_prev_resp_id {
                            prev_ctx = resp_hist_ctx[ri] + ""
                            found = true
                        }
                    }
                    if !found {
                        >>> errors.new("unknown previous_response_id: " + r_prev_resp_id)
                    }
                }
            }
        }
        $tools_sys := ""
        if doc.has(root, "tools") {
            tnode := doc.get(root, "tools") >>>
            if doc.is_list(tnode) && doc.count(tnode) > 0 {
                r_has_tools = true
                tools_sys = format_tools_prompt(&doc, tnode)
            }
        }
        prompt_text = format_responses_messages(&doc, root, tmpl_kind, &tools_sys, &prev_ctx, $&r_resp_prefix) >>>
    } else {
        if !doc.has(root, "messages") { >>> errors.new("missing messages") }
        msgs := doc.get(root, "messages") >>>
        if !doc.is_list(msgs) || doc.count(msgs) == 0 {
            >>> errors.new("messages must be non-empty array")
        }
        $tools_sys := ""
        if doc.has(root, "tools") {
            tnode := doc.get(root, "tools") >>>
            if doc.is_list(tnode) && doc.count(tnode) > 0 {
                r_has_tools = true
                tools_sys = format_tools_prompt(&doc, tnode)
            }
        }
        prompt_text = format_chat_messages(&doc, msgs, tmpl_kind, &tools_sys) >>>
    }

    $r_max := 16
    $r_temp := 0
    $r_topk := 40
    $r_topp := def_topp
    $r_minp := def_minp
    $r_rep := def_rep
    $r_pres := def_pres
    $r_freq := def_freq
    $r_seed := def_seed
    $r_ignore_eos := def_ignore_eos
    $r_stream := false
    $r_include_usage := false
    $r_want_lp := false
    $r_top_lp := 0
    $r_json_mode := false
    $r_stops := []string{}
    $r_bias_ids := []int{}
    $r_bias_vals := []f32{}
    if doc.has(root, "max_tokens") {
        n := doc.get(root, "max_tokens") >>>
        if doc.is_number(n) { r_max = doc.as_int(n) >>> }
    }
    if doc.has(root, "max_completion_tokens") {
        n := doc.get(root, "max_completion_tokens") >>>
        if doc.is_number(n) { r_max = doc.as_int(n) >>> }
    }
    if doc.has(root, "max_output_tokens") {
        n := doc.get(root, "max_output_tokens") >>>
        if doc.is_number(n) { r_max = doc.as_int(n) >>> }
    }
    if r_max < 0 { r_max = 0 }
    if doc.has(root, "temperature") {
        n := doc.get(root, "temperature") >>>
        if doc.is_number(n) {
            tf := doc.as_f64(n) >>>
            r_temp = int(tf * 1000.0 + 0.5)
        }
    }
    if doc.has(root, "top_k") {
        n := doc.get(root, "top_k") >>>
        if doc.is_number(n) { r_topk = doc.as_int(n) >>> }
    }
    if doc.has(root, "top_p") {
        n := doc.get(root, "top_p") >>>
        if doc.is_number(n) {
            pf := doc.as_f64(n) >>>
            r_topp = int(pf * 1000.0 + 0.5)
        }
    }
    if doc.has(root, "min_p") {
        n := doc.get(root, "min_p") >>>
        if doc.is_number(n) {
            mf := doc.as_f64(n) >>>
            r_minp = int(mf * 1000.0 + 0.5)
        }
    }
    if doc.has(root, "repeat_penalty") {
        n := doc.get(root, "repeat_penalty") >>>
        if doc.is_number(n) {
            rf := doc.as_f64(n) >>>
            r_rep = int(rf * 1000.0 + 0.5)
        }
    }
    if doc.has(root, "presence_penalty") {
        n := doc.get(root, "presence_penalty") >>>
        if doc.is_number(n) {
            pf := doc.as_f64(n) >>>
            r_pres = int(pf * 1000.0)
        }
    }
    if doc.has(root, "frequency_penalty") {
        n := doc.get(root, "frequency_penalty") >>>
        if doc.is_number(n) {
            ff := doc.as_f64(n) >>>
            r_freq = int(ff * 1000.0)
        }
    }
    if doc.has(root, "seed") {
        n := doc.get(root, "seed") >>>
        if doc.is_number(n) { r_seed = doc.as_int(n) >>> }
    }
    if doc.has(root, "ignore_eos") {
        n := doc.get(root, "ignore_eos") >>>
        if doc.is_bool(n) { r_ignore_eos = doc.as_bool(n) >>> }
    }
    if doc.has(root, "stream") {
        n := doc.get(root, "stream") >>>
        if doc.is_bool(n) { r_stream = doc.as_bool(n) >>> }
    }
    if doc.has(root, "stream_options") {
        so := doc.get(root, "stream_options") >>>
        if doc.is_dict(so) && doc.has(so, "include_usage") {
            iu := doc.get(so, "include_usage") >>>
            if doc.is_bool(iu) { r_include_usage = doc.as_bool(iu) >>> }
        }
    }
    if doc.has(root, "logprobs") {
        ln := doc.get(root, "logprobs") >>>
        if doc.is_bool(ln) {
            r_want_lp = doc.as_bool(ln) >>>
        } else if doc.is_number(ln) {
            k := doc.as_int(ln) >>>
            r_want_lp = true
            r_top_lp = k
        }
    }
    if doc.has(root, "top_logprobs") {
        tn := doc.get(root, "top_logprobs") >>>
        if doc.is_number(tn) { r_top_lp = doc.as_int(tn) >>> }
    }
    if r_top_lp < 0 { r_top_lp = 0 }
    if r_top_lp > 20 { r_top_lp = 20 }
    if doc.has(root, "response_format") {
        rfn := doc.get(root, "response_format") >>>
        if doc.is_dict(rfn) && doc.has(rfn, "type") {
            tn := doc.get(rfn, "type") >>>
            if doc.is_string(tn) {
                tstr := doc.as_string(tn) >>>
                if tstr == "json_object" || tstr == "json_schema" { r_json_mode = true }
            }
        }
    } else if doc.has(root, "text") {
        txn := doc.get(root, "text") >>>
        if doc.is_dict(txn) && doc.has(txn, "format") {
            fmtn := doc.get(txn, "format") >>>
            if doc.is_dict(fmtn) && doc.has(fmtn, "type") {
                tn := doc.get(fmtn, "type") >>>
                if doc.is_string(tn) {
                    tstr := doc.as_string(tn) >>>
                    if tstr == "json_object" || tstr == "json_schema" { r_json_mode = true }
                }
            }
        }
    }
    if doc.has(root, "logit_bias") {
        lbn := doc.get(root, "logit_bias") >>>
        if doc.is_dict(lbn) {
            lb_keys := doc.dict_keys(lbn)
            for ki in 0:lb_keys.len {
                ks := lb_keys[ki]
                tid := llm_parse_int_or(&ks, -1)
                if tid >= 0 {
                    vn := doc.get(lbn, ks) >>>
                    if doc.is_number(vn) {
                        vf := doc.as_f64(vn) >>>
                        r_bias_ids.push(tid)
                        r_bias_vals.push(f32(vf))
                    }
                }
            }
        }
    }
    if doc.has(root, "stop") {
        sn := doc.get(root, "stop") >>>
        if doc.is_string(sn) {
            sv := doc.as_string(sn) >>>
            if sv.len > 0 { r_stops.push(sv) }
        } else if doc.is_list(sn) {
            for si in 0:doc.count(sn) {
                item := doc.at(sn, si) >>>
                if doc.is_string(item) {
                    sv := doc.as_string(item) >>>
                    if sv.len > 0 { r_stops.push(sv) }
                }
            }
        }
    } else if doc.has(root, "stop_sequences") {
        sn := doc.get(root, "stop_sequences") >>>
        if doc.is_list(sn) {
            for si in 0:doc.count(sn) {
                item := doc.at(sn, si) >>>
                if doc.is_string(item) {
                    sv := doc.as_string(item) >>>
                    if sv.len > 0 { r_stops.push(sv) }
                }
            }
        }
    }
    << ParsedServeReq{
        prompt_text: prompt_text, embed_texts: ~embed_texts, max_tokens: r_max,
        temp_milli: r_temp, top_k: r_topk, top_p_milli: r_topp, min_p_milli: r_minp,
        repeat_penalty_milli: r_rep, presence_penalty_milli: r_pres,
        frequency_penalty_milli: r_freq, seed: r_seed,
        ignore_eos: r_ignore_eos, stream: r_stream, include_usage: r_include_usage,
        want_logprobs: r_want_lp, top_logprobs: r_top_lp,
        json_mode: r_json_mode, has_tools: r_has_tools, is_anthropic: r_is_anthropic,
        is_responses: r_is_responses, prev_resp_id: r_prev_resp_id, resp_prefix: r_resp_prefix,
        stops: ~r_stops, bias_ids: ~r_bias_ids, bias_vals: ~r_bias_vals
    }
}

fn format_embedding_json(emb &[]f32) string {
    $s := "["
    for i in 0:emb.len {
        if i > 0 { s = s + "," }
        num := strconv.format_float(f64(emb[i]), 102, 6) >>> (err) {
            << "0.0"
        }
        s = s + num
    }
    << s + "]"
}

struct QueuedServeItem {
    is_embed bool
    is_chat bool
    is_anthropic bool
    is_responses bool
    resp_prefix string
    req_id string
    created int
    prompt_ids []int
    embed_pids [][]int
    parsed ParsedServeReq
    reply chan ServeResponse
    stream_ch chan string
    cancel_ch chan int
}

fn serve_embed_response(model &Model, model_id &string, kv $&PagedKvCache,
                        sx $&[]f32, sxb $&[]f32, sxb2 $&[]f32,
                        sq $&[]f32, sk $&[]f32, sv $&[]f32, shb $&[]f32, shb2 $&[]f32,
                        sxq $&[]i8, sxs $&[]f32, slot int, prompt_ids_list &[][]int) ServeResponse {
    $data_json := "["
    $ptoks := 0
    for ei in 0:prompt_ids_list.len {
        pids := &prompt_ids_list[ei]
        kv_free_slot(kv, slot)
        emb := compute_embedding_slot(model, kv, sx, sxb, sxb2, sq, sk, sv, shb, shb2, sxq, sxs, slot, pids) >>> (err) {
            kv_free_slot(kv, slot)
            << ServeResponse{status: 500, body: json_error_body(err.msg()), is_stream: false}
        }
        if ei > 0 { data_json = data_json + "," }
        data_json = data_json + "{\"object\":\"embedding\",\"index\":" + str(ei) + ",\"embedding\":" +
                    format_embedding_json(&emb) + "}"
        ptoks += pids.len
    }
    kv_free_slot(kv, slot)
    data_json = data_json + "]"
    resp_body := "{\"object\":\"list\",\"data\":" + data_json +
                 ",\"model\":" + json.quote(model_id) +
                 ",\"usage\":{\"prompt_tokens\":" + str(ptoks) + ",\"total_tokens\":" + str(ptoks) + "}}"
    << ServeResponse{status: 200, body: resp_body, is_stream: false}
}

fn ant_ensure_start(sstate $&ServeStreamState, req_id &string, model_id &string, ptoks int,
                    stream_ch chan string, cancel_ch chan int) bool {
    if sstate.ant_started { << true }
    sstate.ant_started = true
    ev := "message_start"
    payload := "{\"type\":\"message_start\",\"message\":{\"id\":" + json.quote(req_id) +
               ",\"type\":\"message\",\"role\":\"assistant\",\"model\":" + json.quote(model_id) +
               ",\"content\":[],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":" +
               str(ptoks) + ",\"output_tokens\":0}}}"
    << send_stream_msg(stream_ch, cancel_ch, format_ant_sse_event(&ev, &payload))
}

fn ant_close_open_block(sstate $&ServeStreamState, stream_ch chan string, cancel_ch chan int) bool {
    if !sstate.ant_block_open { << true }
    ev := "content_block_stop"
    payload := "{\"type\":\"content_block_stop\",\"index\":" + str(sstate.ant_block_idx) + "}"
    sstate.ant_block_open = false
    sstate.ant_block_kind = 0
    sstate.ant_block_idx += 1
    << send_stream_msg(stream_ch, cancel_ch, format_ant_sse_event(&ev, &payload))
}

fn ant_emit_delta(sstate $&ServeStreamState, kind int, delta &string, req_id &string, model_id &string,
                  ptoks int, stream_ch chan string, cancel_ch chan int) bool {
    if !ant_ensure_start(sstate, req_id, model_id, ptoks, stream_ch, cancel_ch) { << false }
    if sstate.ant_block_open && sstate.ant_block_kind != kind {
        if !ant_close_open_block(sstate, stream_ch, cancel_ch) { << false }
    }
    if !sstate.ant_block_open {
        ev_s := "content_block_start"
        $blk := "{\"type\":\"text\",\"text\":\"\"}"
        if kind == 1 { blk = "{\"type\":\"thinking\",\"thinking\":\"\"}" }
        p_s := "{\"type\":\"content_block_start\",\"index\":" + str(sstate.ant_block_idx) + ",\"content_block\":" + blk + "}"
        if !send_stream_msg(stream_ch, cancel_ch, format_ant_sse_event(&ev_s, &p_s)) { << false }
        sstate.ant_block_open = true
        sstate.ant_block_kind = kind
    }
    ev_d := "content_block_delta"
    $d_json := "{\"type\":\"text_delta\",\"text\":" + json.quote(delta) + "}"
    if kind == 1 { d_json = "{\"type\":\"thinking_delta\",\"thinking\":" + json.quote(delta) + "}" }
    p_d := "{\"type\":\"content_block_delta\",\"index\":" + str(sstate.ant_block_idx) + ",\"delta\":" + d_json + "}"
    << send_stream_msg(stream_ch, cancel_ch, format_ant_sse_event(&ev_d, &p_d))
}

fn emit_chat_or_ant_chunk(sstate $&ServeStreamState, delta &string, req_id &string, created int,
                          model_id &string, ptoks int, lp_json &string,
                          stream_ch chan string, cancel_ch chan int) bool {
    if sstate.is_anthropic {
        $kind := 2
        if sstate.think_mode == 1 { kind = 1 }
        << ant_emit_delta(sstate, kind, delta, req_id, model_id, ptoks, stream_ch, cancel_ch)
    }
    if sstate.is_responses {
        if sstate.think_mode == 1 { << true }
        ev_d := "response.output_text.delta"
        p_d := "{\"type\":\"response.output_text.delta\",\"delta\":" + json.quote(delta) + "}"
        << send_stream_msg(stream_ch, cancel_ch, format_ant_sse_event(&ev_d, &p_d))
    }
    if sstate.think_mode == 1 {
        << send_stream_msg(stream_ch, cancel_ch, format_sse_reasoning_chunk(req_id, created, model_id, delta))
    }
    << send_stream_msg(stream_ch, cancel_ch, format_sse_chunk(true, req_id, created, model_id, delta, "", lp_json))
}

fn stream_emit_visible_range(is_chat bool, has_tools bool, req_id &string, created int, model_id &string,
                             ptoks int, out_text &string, emitted_len $&int, max_end int, allow_hold bool,
                             lp_json &string, sstate $&ServeStreamState,
                             stream_ch chan string, cancel_ch chan int) bool {
    if max_end <= *emitted_len { << true }
    if !is_chat && !sstate.is_anthropic && !sstate.is_responses {
        delta := (*out_text)[*emitted_len:max_end]
        *emitted_len = max_end
        << send_stream_msg(stream_ch, cancel_ch, format_sse_chunk(false, req_id, created, model_id, &delta, "", lp_json))
    }
    $vis_end := max_end
    if allow_hold && !sstate.in_tool {
        hold := tag_holdback_len(out_text, *emitted_len, max_end, sstate.think_mode == 0, sstate.think_mode == 1, has_tools)
        vis_end = max_end - hold
    }
    while *emitted_len < vis_end {
        if sstate.in_tool {
            *emitted_len = vis_end
            <-
        }
        if has_tools {
            tc_tag := "<tool_call>"
            tc_idx := find_substr_from(out_text, &tc_tag, *emitted_len)
            if tc_idx >= 0 && tc_idx < vis_end {
                if tc_idx > *emitted_len {
                    chunk := (*out_text)[*emitted_len:tc_idx]
                    if !emit_chat_or_ant_chunk(sstate, &chunk, req_id, created, model_id, ptoks, lp_json, stream_ch, cancel_ch) { << false }
                }
                sstate.in_tool = true
                *emitted_len = vis_end
                <-
            }
        }
        if sstate.think_mode == 0 {
            open_th := "<think>"
            oi := find_substr_from(out_text, &open_th, *emitted_len)
            if oi >= 0 && oi < vis_end {
                if oi > *emitted_len {
                    chunk := (*out_text)[*emitted_len:oi]
                    if !emit_chat_or_ant_chunk(sstate, &chunk, req_id, created, model_id, ptoks, lp_json, stream_ch, cancel_ch) { << false }
                }
                sstate.think_mode = 1
                *emitted_len = oi + open_th.len
                ->
            }
        } else if sstate.think_mode == 1 {
            close_th := "</think>"
            ci := find_substr_from(out_text, &close_th, *emitted_len)
            if ci >= 0 && ci < vis_end {
                if ci > *emitted_len {
                    chunk := (*out_text)[*emitted_len:ci]
                    if !emit_chat_or_ant_chunk(sstate, &chunk, req_id, created, model_id, ptoks, lp_json, stream_ch, cancel_ch) { << false }
                }
                sstate.think_mode = 2
                *emitted_len = ci + close_th.len
                if *emitted_len < vis_end && (*out_text)[*emitted_len] == 10 {
                    *emitted_len += 1
                }
                ->
            }
        }
        chunk := (*out_text)[*emitted_len:vis_end]
        *emitted_len = vis_end
        if chunk.len > 0 {
            if !emit_chat_or_ant_chunk(sstate, &chunk, req_id, created, model_id, ptoks, lp_json, stream_ch, cancel_ch) { << false }
        }
    }
    << true
}

fn sanitize_json_obj_str(raw &string) string {
    td := json.parse(raw)
    if td.ok() && td.is_dict(td.root()) {
        << llm_doc_encode(&td, td.root(), "{}")
    }
    << "{}"
}

fn accept_generated_piece(model &Model, req_id &string, created int, model_id &string, is_stream bool, is_chat bool,
                          has_tools bool, ptoks int,
                          ignore_eos bool, stops &[]string, stop_pad int,
                          json_mode bool, json_depth $&int, json_started $&bool, json_in_str $&bool, json_esc $&bool,
                          want_lp bool, top_lp int, lp_vec &[]f32, lp_recs $&[]TokenLogprobRecord,
                          sstate $&ServeStreamState,
                          stream_ch chan string, cancel_ch chan int, nxt int,
                          history $&[]int, out_ids $&[]int, out_text $&string,
                          emitted_len $&int, cur_tok $&int, gen $&int, max_gen int,
                          finish_reason $&string, cancelled $&bool) bool {
    if !ignore_eos && is_eos_token(model, nxt) {
        *finish_reason = "stop"
        << true
    }
    piece := format_piece(model, nxt)
    $chunk_lp := ""
    if want_lp {
        rec := record_token_logprob(model, lp_vec, nxt, top_lp)
        if is_stream {
            if is_chat {
                chunk_lp = "{\"content\":[" + format_chat_lp_item(&rec) + "]}"
            } else {
                chunk_lp = "{\"tokens\":[" + json.quote(&rec.token) + "],\"token_logprobs\":[" + rec.logprob + "],\"top_logprobs\":[" + rec.tops_dict + "]}"
            }
        }
        lp_recs.push(rec)
    }
    $append_piece := piece + ""
    $json_done := false
    if json_mode {
        cpos := advance_json_state(&piece, json_depth, json_started, json_in_str, json_esc)
        if cpos > 0 {
            append_piece = piece[0:cpos]
            json_done = true
        }
    }
    history.push(nxt)
    out_ids.push(nxt)
    *out_text = *out_text + append_piece
    stopped := trim_stop_sequence(out_text, stops)
    *gen += 1
    *cur_tok = nxt
    if stopped || json_done {
        *finish_reason = "stop"
        << true
    }
    if is_stream {
        safe_end := out_text.len - stop_pad
        if safe_end > *emitted_len {
            if !stream_emit_visible_range(is_chat, has_tools, req_id, created, model_id, ptoks, out_text, emitted_len, safe_end, true, &chunk_lp, sstate, stream_ch, cancel_ch) {
                *cancelled = true
                << true
            }
        }
    }
    if *gen >= max_gen {
        *finish_reason = "length"
        << true
    }
    << false
}

fn finalize_serve_slot(model_id &string, kv $&PagedKvCache, s int, finish_reason string,
                       tmpl_kind int, slot_req_ids &[]string, slot_created &[]int,
                       slot_active $&[]bool, active_count $&int,
                       slot_is_stream &[]bool, slot_is_chat &[]bool,
                       slot_include_usage &[]bool, slot_want_lp &[]bool, slot_lp_recs &[][]TokenLogprobRecord,
                       slot_has_tools &[]bool, slot_sstate $&[]ServeStreamState, slot_resp_prefix &[]string,
                       slot_prompts $&[][]int,
                       slot_out_ids &[]int, slot_out_text &[]string,
                       slot_emitted_len $&[]int, slot_replies &[]chan ServeResponse,
                       slot_streams &[]chan string, slot_cancels &[]chan int,
                       slot_cached_tokens $&[][]int, slot_cached_len $&[]int,
                       resp_hist_ids $&[]string, resp_hist_ctx $&[]string) {
    rid := &slot_req_ids[s]
    ts := slot_created[s]
    ptoks := slot_prompts[s].len
    ctoks := slot_out_ids.len
    ttoks := ptoks + ctoks
    empty_lp := ""
    ss := $&slot_sstate[s]
    if slot_is_stream[s] {
        ch := slot_streams[s]
        cch := slot_cancels[s]
        $alive := !check_cancelled(cch)
        $em_l := slot_emitted_len[s]
        if alive && slot_out_text[s].len > em_l {
            alive = stream_emit_visible_range(slot_is_chat[s], slot_has_tools[s], rid, ts, model_id, ptoks, &slot_out_text[s], $&em_l, slot_out_text[s].len, false, &empty_lp, ss, ch, cch)
            slot_emitted_len[s] = em_l
        }
        if ss.is_anthropic {
            if alive { alive = ant_ensure_start(ss, rid, model_id, ptoks, ch, cch) }
            if alive { alive = ant_close_open_block(ss, ch, cch) }
            $ant_stop := "end_turn"
            if finish_reason == "length" { ant_stop = "max_tokens" }
            if slot_has_tools[s] {
                tcs := extract_tool_calls(&slot_out_text[s])
                if tcs.len > 0 {
                    ant_stop = "tool_use"
                    for ti in 0:tcs.len {
                        if !alive { <- }
                        tc := &tcs[ti]
                        ev_s := "content_block_start"
                        p_s := "{\"type\":\"content_block_start\",\"index\":" + str(ss.ant_block_idx) +
                               ",\"content_block\":{\"type\":\"tool_use\",\"id\":" + json.quote(&tc.id) +
                               ",\"name\":" + json.quote(&tc.name) + ",\"input\":{}}}"
                        alive = send_stream_msg(ch, cch, format_ant_sse_event(&ev_s, &p_s))
                        if alive {
                            args_clean := sanitize_json_obj_str(&tc.arguments)
                            ev_d := "content_block_delta"
                            p_d := "{\"type\":\"content_block_delta\",\"index\":" + str(ss.ant_block_idx) +
                                   ",\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":" + json.quote(&args_clean) + "}}"
                            alive = send_stream_msg(ch, cch, format_ant_sse_event(&ev_d, &p_d))
                        }
                        if alive {
                            ev_e := "content_block_stop"
                            p_e := "{\"type\":\"content_block_stop\",\"index\":" + str(ss.ant_block_idx) + "}"
                            alive = send_stream_msg(ch, cch, format_ant_sse_event(&ev_e, &p_e))
                            ss.ant_block_idx += 1
                        }
                    }
                }
            }
            if alive {
                ev_md := "message_delta"
                p_md := "{\"type\":\"message_delta\",\"delta\":{\"stop_reason\":" + json.quote(&ant_stop) +
                        ",\"stop_sequence\":null},\"usage\":{\"output_tokens\":" + str(ctoks) + "}}"
                alive = send_stream_msg(ch, cch, format_ant_sse_event(&ev_md, &p_md))
            }
            if alive {
                ev_ms := "message_stop"
                p_ms := "{\"type\":\"message_stop\"}"
                _ := send_stream_msg(ch, cch, format_ant_sse_event(&ev_ms, &p_ms))
                _ := send_stream_msg(ch, cch, "")
            }
        } else if ss.is_responses {
            if alive && slot_has_tools[s] {
                sp_tc := split_think_text(&slot_out_text[s])
                tcs := extract_tool_calls(&sp_tc.content)
                for ti in 0:tcs.len {
                    if !alive { <- }
                    tc := &tcs[ti]
                    ev_oi := "response.output_item.done"
                    p_oi := "{\"type\":\"response.output_item.done\",\"item\":{\"type\":\"function_call\",\"id\":\"fc_" +
                            str(ti) + "\",\"call_id\":" + json.quote(&tc.id) + ",\"name\":" +
                            json.quote(&tc.name) + ",\"arguments\":" + json.quote(&tc.arguments) + "}}"
                    alive = send_stream_msg(ch, cch, format_ant_sse_event(&ev_oi, &p_oi))
                }
            }
            if alive {
                sync_resp := format_responses_sync_body(rid, ts, model_id, &slot_out_text[s], slot_has_tools[s], ptoks, ctoks)
                ev_rc := "response.completed"
                p_rc := "{\"type\":\"response.completed\",\"response\":" + sync_resp + "}"
                _ := send_stream_msg(ch, cch, format_ant_sse_event(&ev_rc, &p_rc))
                _ := send_stream_msg(ch, cch, "")
            }
        } else {
            $eff_finish := finish_reason + ""
            if alive && slot_is_chat[s] && slot_has_tools[s] {
                tcs := extract_tool_calls(&slot_out_text[s])
                if tcs.len > 0 {
                    eff_finish = "tool_calls"
                    tc_delta := format_tool_calls_array(&tcs, true)
                    alive = send_stream_msg(ch, cch, format_sse_tool_calls_chunk(rid, ts, model_id, &tc_delta))
                }
            }
            if alive {
                empty := ""
                alive = send_stream_msg(ch, cch, format_sse_chunk(slot_is_chat[s], rid, ts, model_id, &empty, eff_finish, &empty_lp))
            }
            if alive && slot_include_usage[s] {
                alive = send_stream_msg(ch, cch, format_sse_usage_chunk(slot_is_chat[s], rid, ts, model_id, ptoks, ctoks))
            }
            if alive {
                _ := send_stream_msg(ch, cch, "data: [DONE]\n\n")
                _ := send_stream_msg(ch, cch, "")
            }
        }
    } else {
        usage := "\"usage\":{\"prompt_tokens\":" + str(ptoks) + ",\"completion_tokens\":" + str(ctoks) + ",\"total_tokens\":" + str(ttoks) + "}"
        $lp_field := ""
        if slot_want_lp[s] {
            lp_field = ",\"logprobs\":" + format_slot_logprobs_json(slot_is_chat[s], &slot_lp_recs[s])
        }
        if ss.is_anthropic {
            sp := split_think_text(&slot_out_text[s])
            $vis_text := sp.content + ""
            $tcs := []ParsedToolCall{}
            if slot_has_tools[s] {
                tcs = extract_tool_calls(&sp.content)
                if tcs.len > 0 {
                    vis_text = strip_tool_call_blocks(&sp.content)
                }
            }
            $ant_stop := "end_turn"
            if finish_reason == "length" { ant_stop = "max_tokens" }
            if tcs.len > 0 { ant_stop = "tool_use" }
            $blocks := "["
            $bcnt := 0
            if sp.reasoning.len > 0 {
                blocks = blocks + "{\"type\":\"thinking\",\"thinking\":" + json.quote(&sp.reasoning) + "}"
                bcnt += 1
            }
            if vis_text.len > 0 || (sp.reasoning.len == 0 && tcs.len == 0) {
                if bcnt > 0 { blocks = blocks + "," }
                blocks = blocks + "{\"type\":\"text\",\"text\":" + json.quote(&vis_text) + "}"
                bcnt += 1
            }
            for ti in 0:tcs.len {
                tc := &tcs[ti]
                args_clean := sanitize_json_obj_str(&tc.arguments)
                if bcnt > 0 { blocks = blocks + "," }
                blocks = blocks + "{\"type\":\"tool_use\",\"id\":" + json.quote(&tc.id) +
                         ",\"name\":" + json.quote(&tc.name) + ",\"input\":" + args_clean + "}"
                bcnt += 1
            }
            blocks = blocks + "]"
            resp_body := "{\"id\":" + json.quote(rid) + ",\"type\":\"message\",\"role\":\"assistant\",\"model\":" +
                         json.quote(model_id) + ",\"content\":" + blocks + ",\"stop_reason\":" + json.quote(&ant_stop) +
                         ",\"stop_sequence\":null,\"usage\":{\"input_tokens\":" + str(ptoks) +
                         ",\"output_tokens\":" + str(ctoks) + "}}"
            slot_replies[s] <- ServeResponse{status: 200, body: resp_body, is_stream: false}
        } else if ss.is_responses {
            resp_body := format_responses_sync_body(rid, ts, model_id, &slot_out_text[s], slot_has_tools[s], ptoks, ctoks)
            slot_replies[s] <- ServeResponse{status: 200, body: resp_body, is_stream: false}
        } else if !slot_is_chat[s] {
            resp_body := "{\"id\":" + json.quote(rid) + ",\"object\":\"text_completion\",\"created\":" + str(ts) +
                         ",\"model\":" + json.quote(model_id) +
                         ",\"choices\":[{\"index\":0,\"text\":" + json.quote(&slot_out_text[s]) + lp_field +
                         ",\"finish_reason\":" + json.quote(&finish_reason) + "}]," + usage + "}"
            slot_replies[s] <- ServeResponse{status: 200, body: resp_body, is_stream: false}
        } else {
            sp := split_think_text(&slot_out_text[s])
            $eff_finish := finish_reason + ""
            $r_field := ""
            if sp.reasoning.len > 0 {
                r_field = ",\"reasoning_content\":" + json.quote(&sp.reasoning)
            }
            $vis_text := sp.content + ""
            $msg_json := "\"message\":{\"role\":\"assistant\",\"content\":" + json.quote(&vis_text) + r_field + "}"
            if slot_has_tools[s] {
                tc_json := parse_tool_calls_json(&sp.content)
                if tc_json.len > 0 {
                    eff_finish = "tool_calls"
                    vis_stripped := strip_tool_call_blocks(&sp.content)
                    $c_val := "null"
                    if vis_stripped.len > 0 { c_val = json.quote(&vis_stripped) }
                    msg_json = "\"message\":{\"role\":\"assistant\",\"content\":" + c_val + r_field + ",\"tool_calls\":" + tc_json + "}"
                }
            }
            resp_body := "{\"id\":" + json.quote(rid) + ",\"object\":\"chat.completion\",\"created\":" + str(ts) +
                         ",\"model\":" + json.quote(model_id) +
                         ",\"choices\":[{\"index\":0," + msg_json + lp_field + ",\"finish_reason\":" + json.quote(&eff_finish) + "}]," + usage + "}"
            slot_replies[s] <- ServeResponse{status: 200, body: resp_body, is_stream: false}
        }
    }
    if ss.is_responses {
        full_ctx := slot_resp_prefix[s] + resp_gen_trigger(tmpl_kind) + slot_out_text[s] + resp_turn_end(tmpl_kind)
        if resp_hist_ids.len >= 64 {
            for ri in 0:(resp_hist_ids.len - 1) {
                resp_hist_ids[ri] = resp_hist_ids[ri + 1] + ""
                resp_hist_ctx[ri] = resp_hist_ctx[ri + 1] + ""
            }
            resp_hist_ids[resp_hist_ids.len - 1] = (*rid) + ""
            resp_hist_ctx[resp_hist_ctx.len - 1] = full_ctx
        } else {
            resp_hist_ids.push((*rid) + "")
            resp_hist_ctx.push(full_ctx)
        }
    }
    keep := slot_prompts[s].len
    kv_truncate_slot(kv, s, keep)
    slot_cached_tokens[s] = ~slot_prompts[s]
    slot_cached_len[s] = keep
    slot_active[s] = false
    *active_count -= 1
}

fn cancel_serve_slot(kv $&PagedKvCache, s int, slot_active $&[]bool, active_count $&int,
                     slot_cached_len $&[]int) {
    kv_free_slot(kv, s)
    slot_cached_len[s] = 0
    slot_active[s] = false
    *active_count -= 1
}

fn apply_logit_bias(logits $&[]f32, off int, vocab int, bias_ids &[]int, bias_vals &[]f32) {
    for i in 0:bias_ids.len {
        tid := bias_ids[i]
        if tid >= 0 && tid < vocab {
            logits[off + tid] += bias_vals[i]
        }
    }
}

fn try_serve_decode_batch(model &Model, kv $&PagedKvCache, row_cache $&[]ForwardRow,
                          decode_slots &[]int, decode_inputs &[]DecodeInput,
                          predictions $&[]DecodePrediction,
                          sx $&[]f32, sxb $&[]f32, sxb2 $&[]f32,
                          sq $&[]f32, sk $&[]f32, sv $&[]f32,
                          shb $&[]f32, shb2 $&[]f32, slogits $&[]f32,
                          sxq $&[]i8, sxs $&[]f32,
                          slot_active $&[]bool, active_count $&int,
                          slot_cached_len $&[]int, slot_is_stream &[]bool,
                          slot_streams &[]chan string, slot_replies &[]chan ServeResponse) bool {
    _ := forward_decode_batch(model, kv, row_cache, decode_inputs, decode_slots.len, predictions, sx, sxb, sxb2, sq, sk, sv, shb, shb2, slogits, sxq, sxs) >>> (err) {
        for ti in 0:decode_slots.len {
            bs := decode_slots[ti]
            cancel_serve_slot(kv, bs, slot_active, active_count, slot_cached_len)
            if slot_is_stream[bs] {
                try_send_stream(slot_streams[bs], "data: [DONE]\n\n")
                try_send_stream(slot_streams[bs], "")
            } else {
                slot_replies[bs] <- ServeResponse{status: 500, body: json_error_body(err.msg()), is_stream: false}
            }
        }
        << false
    }
    << true
}

fn run_serve_scheduler(req_ch chan ServeRequest, model &Model, model_id &string, kv $&PagedKvCache,
                       row_cache $&[]ForwardRow, sx $&[]f32, sxb $&[]f32, sxb2 $&[]f32,
                       sq $&[]f32, sk $&[]f32, sv $&[]f32, shb $&[]f32, shb2 $&[]f32,
                       slogits $&[]f32, sxq $&[]i8, sxs $&[]f32,
                       top_p_milli int, min_p_milli int, repeat_penalty_milli int,
                       presence_penalty_milli int, frequency_penalty_milli int,
                       seed int, ignore_eos bool) {
    active_limit := kv.max_slots
    tmpl_kind := model.chat_template_kind
    vocab := model.cfg.vocab_size
    dummy_reply := chan ServeResponse{cap: 1}
    dummy_stream := chan string{cap: 1}
    dummy_cancel := chan int{cap: 1}

    $slot_active := []bool{}
    $slot_prompts := [][]int{}
    $slot_pos := []int{}
    $slot_gen := []int{}
    $slot_max_gen := []int{}
    $slot_cur_tok := []int{}
    $slot_shared := []int{}
    $slot_prefilled := []bool{}
    $was_prefilled := []bool{}
    $slot_temp := []int{}
    $slot_topk := []int{}
    $slot_topp := []int{}
    $slot_minp := []int{}
    $slot_rep := []int{}
    $slot_pres := []int{}
    $slot_freq := []int{}
    $slot_rng := []int{}
    $slot_ignore_eos := []bool{}
    $slot_is_stream := []bool{}
    $slot_is_chat := []bool{}
    $slot_include_usage := []bool{}
    $slot_req_ids := []string{}
    $slot_created := []int{}
    $slot_want_lp := []bool{}
    $slot_top_lp := []int{}
    $slot_lp_recs := [][]TokenLogprobRecord{}
    $slot_json_mode := []bool{}
    $slot_json_depth := []int{}
    $slot_json_started := []bool{}
    $slot_json_in_str := []bool{}
    $slot_json_esc := []bool{}
    $slot_has_tools := []bool{}
    $slot_sstate := []ServeStreamState{}
    $slot_resp_prefix := []string{}
    $slot_stops := [][]string{}
    $slot_bias_ids := [][]int{}
    $slot_bias_vals := [][]f32{}
    $slot_history := [][]int{}
    $slot_out_ids := [][]int{}
    $slot_out_text := []string{}
    $slot_emitted_len := []int{}
    $slot_stop_pad := []int{}
    $slot_replies := []chan ServeResponse{}
    $slot_streams := []chan string{}
    $slot_cancels := []chan int{}
    $slot_cached_tokens := [][]int{}
    $slot_cached_len := []int{}
    $predictions := []DecodePrediction{}

    for _ in 0:active_limit {
        slot_active.push(false)
        slot_prompts.push([]int{})
        slot_pos.push(0)
        slot_gen.push(0)
        slot_max_gen.push(0)
        slot_cur_tok.push(0)
        slot_shared.push(0)
        slot_prefilled.push(false)
        was_prefilled.push(false)
        slot_temp.push(0)
        slot_topk.push(40)
        slot_topp.push(1000)
        slot_minp.push(0)
        slot_rep.push(1000)
        slot_pres.push(0)
        slot_freq.push(0)
        slot_rng.push(seed)
        slot_ignore_eos.push(false)
        slot_is_stream.push(false)
        slot_is_chat.push(false)
        slot_include_usage.push(false)
        slot_req_ids.push("")
        slot_created.push(0)
        slot_want_lp.push(false)
        slot_top_lp.push(0)
        slot_lp_recs.push([]TokenLogprobRecord{})
        slot_json_mode.push(false)
        slot_json_depth.push(0)
        slot_json_started.push(false)
        slot_json_in_str.push(false)
        slot_json_esc.push(false)
        slot_has_tools.push(false)
        slot_sstate.push(new_serve_stream_state(false, false))
        slot_resp_prefix.push("")
        slot_stops.push([]string{})
        slot_bias_ids.push([]int{})
        slot_bias_vals.push([]f32{})
        slot_history.push([]int{})
        slot_out_ids.push([]int{})
        slot_out_text.push("")
        slot_emitted_len.push(0)
        slot_stop_pad.push(0)
        slot_replies.push(dummy_reply)
        slot_streams.push(dummy_stream)
        slot_cancels.push(dummy_cancel)
        slot_cached_tokens.push([]int{})
        slot_cached_len.push(0)
        predictions.push(DecodePrediction{token: 0, logit_bits: 0})
    }

    $pending := []QueuedServeItem{}
    $pending_head := 0
    $active_count := 0
    $prefix_cache_hits := 0
    $prefix_cache_tokens := 0
    $req_seq := 0
    $resp_hist_ids := []string{}
    $resp_hist_ctx := []string{}

    for {
        time.sleep(0)
        for {
            $has_req := false
            $req := ServeRequest{method: "", path: "", body: "", reply: dummy_reply, stream_ch: dummy_stream, cancel_ch: dummy_cancel}
            if active_count == 0 && pending_head >= pending.len {
                req = <-req_ch
                has_req = true
            } else {
                select {
                    r := <-req_ch {
                        req = r
                        has_req = true
                    }
                    else {
                        has_req = false
                    }
                }
            }
            if !has_req { <- }

            if req.method == "GET" && req.path == "/health" {
                queued_cnt := pending.len - pending_head
                hbody := "{\"status\":\"ok\",\"active_slots\":" + str(active_count) +
                         ",\"max_slots\":" + str(active_limit) +
                         ",\"queued_requests\":" + str(queued_cnt) +
                         ",\"prefix_cache_hits\":" + str(prefix_cache_hits) +
                         ",\"prefix_cache_tokens\":" + str(prefix_cache_tokens) +
                         ",\"kv_free_blocks\":" + str(kv.free_top) +
                         ",\"kv_total_blocks\":" + str(kv.num_blocks) + "}"
                req.reply <- ServeResponse{status: 200, body: hbody, is_stream: false}
            } else if req.method == "GET" && req.path == "/v1/models" {
                m_json := "{\"object\":\"list\",\"data\":[{\"id\":" + json.quote(model_id) + ",\"object\":\"model\"}]}"
                req.reply <- ServeResponse{status: 200, body: m_json, is_stream: false}
            } else if req.method == "POST" && req.path == "/v1/embeddings" {
                parsed := parse_serve_request(&req.path, &req.body, top_p_milli, min_p_milli, repeat_penalty_milli, presence_penalty_milli, frequency_penalty_milli, seed, ignore_eos, TEMPLATE_RAW, &resp_hist_ids, &resp_hist_ctx) >>> (err) {
                    req.reply <- ServeResponse{status: 400, body: json_error_body(err.msg()), is_stream: false}
                    ->
                }
                $epids := [][]int{}
                for ei in 0:parsed.embed_texts.len {
                    epids.push(encode_prompt(model, &parsed.embed_texts[ei]))
                }
                $eslot := -1
                for s in 0:active_limit {
                    if !slot_active[s] && slot_cached_len[s] == 0 {
                        eslot = s
                        <-
                    }
                }
                if eslot < 0 {
                    for s in 0:active_limit {
                        if !slot_active[s] {
                            eslot = s
                            <-
                        }
                    }
                }
                if eslot >= 0 {
                    kv_free_slot(kv, eslot)
                    slot_cached_len[eslot] = 0
                    req.reply <- serve_embed_response(model, model_id, kv, sx, sxb, sxb2, sq, sk, sv, shb, shb2, sxq, sxs, eslot, &epids)
                } else {
                    pending.push(QueuedServeItem{
                        is_embed: true, is_chat: false, is_anthropic: false, is_responses: false, resp_prefix: "",
                        req_id: "", created: 0,
                        prompt_ids: []int{}, embed_pids: ~epids,
                        parsed: ~parsed, reply: req.reply, stream_ch: req.stream_ch, cancel_ch: req.cancel_ch
                    })
                }
            } else if req.method == "POST" && (req.path == "/v1/completions" || req.path == "/v1/chat/completions" || req.path == "/v1/messages" || req.path == "/v1/responses") {
                is_chat := req.path == "/v1/chat/completions"
                is_ant := req.path == "/v1/messages"
                is_resp := req.path == "/v1/responses"
                $req_tmpl := TEMPLATE_RAW
                if is_chat || is_ant || is_resp { req_tmpl = tmpl_kind }
                parsed := parse_serve_request(&req.path, &req.body, top_p_milli, min_p_milli, repeat_penalty_milli, presence_penalty_milli, frequency_penalty_milli, seed, ignore_eos, req_tmpl, &resp_hist_ids, &resp_hist_ctx) >>> (err) {
                    req.reply <- ServeResponse{status: 400, body: json_error_body(err.msg()), is_stream: false}
                    ->
                }
                req_seq += 1
                created_ts := time.now_time().unix()
                $prefix := "cmpl-"
                if is_chat { prefix = "chatcmpl-" }
                else if is_ant { prefix = "msg_" }
                else if is_resp { prefix = "resp_" }
                rid := prefix + str(created_ts) + "-" + str(req_seq)
                pids := encode_prompt(model, &parsed.prompt_text)
                rpref := parsed.resp_prefix + ""
                pending.push(QueuedServeItem{
                    is_embed: false, is_chat: is_chat, is_anthropic: is_ant, is_responses: is_resp, resp_prefix: rpref,
                    req_id: rid, created: created_ts,
                    prompt_ids: ~pids, embed_pids: [][]int{},
                    parsed: ~parsed, reply: req.reply, stream_ch: req.stream_ch, cancel_ch: req.cancel_ch
                })
            } else {
                req.reply <- ServeResponse{status: 404, body: json_error_body("not found"), is_stream: false}
            }
        }

        while pending_head < pending.len && active_count < active_limit {
            item := &pending[pending_head]
            if item.is_embed {
                $eslot := -1
                for s in 0:active_limit {
                    if !slot_active[s] && slot_cached_len[s] == 0 {
                        eslot = s
                        <-
                    }
                }
                if eslot < 0 {
                    for s in 0:active_limit {
                        if !slot_active[s] {
                            eslot = s
                            <-
                        }
                    }
                }
                kv_free_slot(kv, eslot)
                slot_cached_len[eslot] = 0
                item.reply <- serve_embed_response(model, model_id, kv, sx, sxb, sxb2, sq, sk, sv, shb, shb2, sxq, sxs, eslot, &item.embed_pids)
                pending_head += 1
                ->
            }

            $best_slot := -1
            $best_lcp := -1
            plen := item.prompt_ids.len
            max_keep := plen - 1
            for s in 0:active_limit {
                if slot_active[s] { -> }
                clen := slot_cached_len[s]
                $limit := clen
                if max_keep < limit { limit = max_keep }
                $lcp := 0
                while lcp < limit && slot_cached_tokens[s][lcp] == item.prompt_ids[lcp] {
                    lcp += 1
                }
                if lcp > best_lcp || (lcp == 0 && best_lcp == 0 && best_slot >= 0 && slot_cached_len[best_slot] > 0 && clen == 0) {
                    best_lcp = lcp
                    best_slot = s
                }
            }
            if best_slot < 0 { <- }
            if best_lcp > 0 {
                kv_truncate_slot(kv, best_slot, best_lcp)
                prefix_cache_hits += 1
                prefix_cache_tokens += best_lcp
            } else {
                kv_free_slot(kv, best_slot)
                slot_cached_len[best_slot] = 0
            }

            $hist := []int{}
            $pcopy := []int{}
            for i in 0:plen {
                tok := item.prompt_ids[i]
                hist.push(tok)
                pcopy.push(tok)
            }
            $stops_copy := []string{}
            $max_stop_len := 0
            for k in 0:item.parsed.stops.len {
                st := item.parsed.stops[k] + ""
                if st.len > max_stop_len { max_stop_len = st.len }
                stops_copy.push(st)
            }
            $stop_pad := 0
            if max_stop_len > 1 { stop_pad = max_stop_len - 1 }

            slot_active[best_slot] = true
            slot_prompts[best_slot] = ~pcopy
            slot_pos[best_slot] = best_lcp
            slot_gen[best_slot] = 0
            slot_max_gen[best_slot] = item.parsed.max_tokens
            slot_cur_tok[best_slot] = 0
            slot_shared[best_slot] = best_lcp
            slot_prefilled[best_slot] = false
            slot_temp[best_slot] = item.parsed.temp_milli
            slot_topk[best_slot] = item.parsed.top_k
            slot_topp[best_slot] = item.parsed.top_p_milli
            slot_minp[best_slot] = item.parsed.min_p_milli
            slot_rep[best_slot] = item.parsed.repeat_penalty_milli
            slot_pres[best_slot] = item.parsed.presence_penalty_milli
            slot_freq[best_slot] = item.parsed.frequency_penalty_milli
            slot_rng[best_slot] = item.parsed.seed
            slot_ignore_eos[best_slot] = item.parsed.ignore_eos
            slot_is_stream[best_slot] = item.parsed.stream
            slot_is_chat[best_slot] = item.is_chat
            slot_include_usage[best_slot] = item.parsed.include_usage
            slot_req_ids[best_slot] = item.req_id + ""
            slot_created[best_slot] = item.created
            slot_want_lp[best_slot] = item.parsed.want_logprobs
            slot_top_lp[best_slot] = item.parsed.top_logprobs
            slot_lp_recs[best_slot] = []TokenLogprobRecord{}
            slot_json_mode[best_slot] = item.parsed.json_mode
            slot_json_depth[best_slot] = 0
            slot_json_started[best_slot] = false
            slot_json_in_str[best_slot] = false
            slot_json_esc[best_slot] = false
            slot_has_tools[best_slot] = item.parsed.has_tools
            slot_sstate[best_slot] = new_serve_stream_state(item.is_anthropic, item.is_responses)
            slot_resp_prefix[best_slot] = item.resp_prefix + ""
            slot_stops[best_slot] = ~stops_copy
            $b_ids := []int{}
            $b_vals := []f32{}
            for bi in 0:item.parsed.bias_ids.len {
                b_ids.push(item.parsed.bias_ids[bi])
                b_vals.push(item.parsed.bias_vals[bi])
            }
            slot_bias_ids[best_slot] = ~b_ids
            slot_bias_vals[best_slot] = ~b_vals
            slot_history[best_slot] = ~hist
            slot_out_ids[best_slot] = []int{}
            slot_out_text[best_slot] = ""
            slot_emitted_len[best_slot] = 0
            slot_stop_pad[best_slot] = stop_pad
            slot_replies[best_slot] = item.reply
            slot_streams[best_slot] = item.stream_ch
            slot_cancels[best_slot] = item.cancel_ch
            active_count += 1
            pending_head += 1
        }
        if pending_head > 0 && pending_head == pending.len {
            pending = []QueuedServeItem{}
            pending_head = 0
        }

        for s in 0:active_limit {
            was_prefilled[s] = slot_active[s] && slot_prefilled[s]
            if slot_active[s] && slot_is_stream[s] && check_cancelled(slot_cancels[s]) {
                cancel_serve_slot(kv, s, $&slot_active, $&active_count, $&slot_cached_len)
                was_prefilled[s] = false
            }
        }

        for s in 0:active_limit {
            if !slot_active[s] || slot_prefilled[s] { -> }
            $finished := false
            $cancelled := false
            $finish_reason := "length"
            plen := slot_prompts[s].len
            shared := slot_shared[s]
            $suffix := []int{}
            for k in shared:plen { suffix.push(slot_prompts[s][k]) }
            _ := forward_prefill_batch(model, kv, row_cache, sx, sxb, sxb2, sq, sk, sv, shb, shb2, slogits, sxq, sxs, s, &suffix, shared, true, true) >>> (err) {
                cancel_serve_slot(kv, s, $&slot_active, $&active_count, $&slot_cached_len)
                slot_replies[s] <- ServeResponse{status: 500, body: json_error_body(err.msg()), is_stream: false}
                ->
            }
            slot_prefilled[s] = true
            slot_pos[s] = plen
            if slot_is_stream[s] {
                slot_replies[s] <- ServeResponse{status: 200, body: "", is_stream: true}
            }
            if slot_max_gen[s] <= 0 {
                finished = true
                finish_reason = "length"
            } else {
                if slot_bias_ids[s].len > 0 { apply_logit_bias(slogits, 0, vocab, &slot_bias_ids[s], &slot_bias_vals[s]) }
                if slot_json_mode[s] { apply_json_logit_mask(slogits, 0, model, slot_json_started[s]) }
                $lp_vec := []f32{}
                if slot_want_lp[s] { lp_vec = compute_logprobs_vec(slogits, 0, vocab) }
                $rng := slot_rng[s]
                nxt := sample_token(slogits, vocab, &slot_history[s], slot_temp[s], slot_topk[s], slot_topp[s], slot_minp[s], slot_rep[s], slot_pres[s], slot_freq[s], $&rng)
                slot_rng[s] = rng
                $cur_t := slot_cur_tok[s]
                $gcnt := slot_gen[s]
                $em_len := slot_emitted_len[s]
                $jdepth := slot_json_depth[s]
                $jstarted := slot_json_started[s]
                $jin_str := slot_json_in_str[s]
                $jesc := slot_json_esc[s]
                $lp_s := ~slot_lp_recs[s]
                $hist_s := ~slot_history[s]
                $ids_s := ~slot_out_ids[s]
                $txt_s := slot_out_text[s]
                $ss_s := slot_sstate[s]
                pt_s := slot_prompts[s].len
                finished = accept_generated_piece(model, &slot_req_ids[s], slot_created[s], model_id, slot_is_stream[s], slot_is_chat[s],
                                                  slot_has_tools[s], pt_s,
                                                  slot_ignore_eos[s], &slot_stops[s], slot_stop_pad[s],
                                                  slot_json_mode[s], $&jdepth, $&jstarted, $&jin_str, $&jesc,
                                                  slot_want_lp[s], slot_top_lp[s], &lp_vec, $&lp_s,
                                                  $&ss_s,
                                                  slot_streams[s], slot_cancels[s], nxt,
                                                  $&hist_s, $&ids_s, $&txt_s, $&em_len, $&cur_t, $&gcnt,
                                                  slot_max_gen[s], $&finish_reason, $&cancelled)
                slot_sstate[s] = ss_s
                slot_json_depth[s] = jdepth
                slot_json_started[s] = jstarted
                slot_json_in_str[s] = jin_str
                slot_json_esc[s] = jesc
                slot_lp_recs[s] = ~lp_s
                slot_history[s] = ~hist_s
                slot_out_ids[s] = ~ids_s
                slot_out_text[s] = txt_s
                slot_emitted_len[s] = em_len
                slot_cur_tok[s] = cur_t
                slot_gen[s] = gcnt
            }
            if cancelled {
                cancel_serve_slot(kv, s, $&slot_active, $&active_count, $&slot_cached_len)
            } else if finished {
                $dummy_ids := ~slot_out_ids[s]
                finalize_serve_slot(model_id, kv, s, finish_reason, tmpl_kind, &slot_req_ids, &slot_created,
                                    $&slot_active, $&active_count,
                                    &slot_is_stream, &slot_is_chat, &slot_include_usage,
                                    &slot_want_lp, &slot_lp_recs, &slot_has_tools, $&slot_sstate, &slot_resp_prefix,
                                    $&slot_prompts, &dummy_ids, &slot_out_text, $&slot_emitted_len,
                                    &slot_replies, &slot_streams, &slot_cancels,
                                    $&slot_cached_tokens, $&slot_cached_len, $&resp_hist_ids, $&resp_hist_ctx)
                slot_out_ids[s] = ~dummy_ids
            }
        }

        $decode_slots := []int{}
        $decode_inputs := []DecodeInput{}
        for s in 0:active_limit {
            if !was_prefilled[s] || !slot_active[s] { -> }
            pos := slot_pos[s]
            if pos >= model.cfg.max_seq_len {
                $dummy_ids := ~slot_out_ids[s]
                finalize_serve_slot(model_id, kv, s, "length", tmpl_kind, &slot_req_ids, &slot_created,
                                    $&slot_active, $&active_count,
                                    &slot_is_stream, &slot_is_chat, &slot_include_usage,
                                    &slot_want_lp, &slot_lp_recs, &slot_has_tools, $&slot_sstate, &slot_resp_prefix,
                                    $&slot_prompts, &dummy_ids, &slot_out_text, $&slot_emitted_len,
                                    &slot_replies, &slot_streams, &slot_cancels,
                                    $&slot_cached_tokens, $&slot_cached_len, $&resp_hist_ids, $&resp_hist_ctx)
                slot_out_ids[s] = ~dummy_ids
            } else {
                decode_slots.push(s)
                decode_inputs.push(DecodeInput{slot: s, token: slot_cur_tok[s], pos: pos})
            }
        }

        if decode_slots.len > 1 && xu_target_arch() == ARCH_ARM64 && model.layers_p4 && slogits.len >= decode_slots.len * vocab {
            batch_ok := try_serve_decode_batch(model, kv, row_cache, &decode_slots, &decode_inputs,
                                               $&predictions, sx, sxb, sxb2, sq, sk, sv, shb, shb2,
                                               slogits, sxq, sxs, $&slot_active, $&active_count,
                                               $&slot_cached_len, &slot_is_stream, &slot_streams,
                                               &slot_replies)
            if batch_ok {
                for ti in 0:decode_slots.len {
                    s := decode_slots[ti]
                    slot_pos[s] += 1
                    log_off := ti * vocab
                    if slot_bias_ids[s].len > 0 { apply_logit_bias(slogits, log_off, vocab, &slot_bias_ids[s], &slot_bias_vals[s]) }
                    if slot_json_mode[s] { apply_json_logit_mask(slogits, log_off, model, slot_json_started[s]) }
                    $lp_vec := []f32{}
                    if slot_want_lp[s] { lp_vec = compute_logprobs_vec(slogits, log_off, vocab) }
                    $rng := slot_rng[s]
                    nxt := sample_token_at(slogits, log_off, vocab, &slot_history[s], slot_temp[s], slot_topk[s], slot_topp[s], slot_minp[s], slot_rep[s], slot_pres[s], slot_freq[s], $&rng)
                    slot_rng[s] = rng
                    $cur_t := slot_cur_tok[s]
                    $gcnt := slot_gen[s]
                    $em_len := slot_emitted_len[s]
                    $finish_reason := "length"
                    $cancelled := false
                    $jdepth := slot_json_depth[s]
                    $jstarted := slot_json_started[s]
                    $jin_str := slot_json_in_str[s]
                    $jesc := slot_json_esc[s]
                    $lp_s := ~slot_lp_recs[s]
                    $hist_s := ~slot_history[s]
                    $ids_s := ~slot_out_ids[s]
                    $txt_s := slot_out_text[s]
                    $ss_s := slot_sstate[s]
                    pt_s := slot_prompts[s].len
                    finished := accept_generated_piece(model, &slot_req_ids[s], slot_created[s], model_id, slot_is_stream[s], slot_is_chat[s],
                                                      slot_has_tools[s], pt_s,
                                                      slot_ignore_eos[s], &slot_stops[s], slot_stop_pad[s],
                                                      slot_json_mode[s], $&jdepth, $&jstarted, $&jin_str, $&jesc,
                                                      slot_want_lp[s], slot_top_lp[s], &lp_vec, $&lp_s,
                                                      $&ss_s,
                                                      slot_streams[s], slot_cancels[s], nxt,
                                                      $&hist_s, $&ids_s, $&txt_s, $&em_len, $&cur_t, $&gcnt,
                                                      slot_max_gen[s], $&finish_reason, $&cancelled)
                    slot_sstate[s] = ss_s
                    slot_json_depth[s] = jdepth
                    slot_json_started[s] = jstarted
                    slot_json_in_str[s] = jin_str
                    slot_json_esc[s] = jesc
                    slot_lp_recs[s] = ~lp_s
                    slot_history[s] = ~hist_s
                    slot_out_ids[s] = ~ids_s
                    slot_out_text[s] = txt_s
                    slot_emitted_len[s] = em_len
                    slot_cur_tok[s] = cur_t
                    slot_gen[s] = gcnt
                    if cancelled {
                        cancel_serve_slot(kv, s, $&slot_active, $&active_count, $&slot_cached_len)
                    } else if finished {
                        $dummy_ids := ~slot_out_ids[s]
                        finalize_serve_slot(model_id, kv, s, finish_reason, tmpl_kind, &slot_req_ids, &slot_created,
                                            $&slot_active, $&active_count,
                                            &slot_is_stream, &slot_is_chat, &slot_include_usage,
                                            &slot_want_lp, &slot_lp_recs, &slot_has_tools, $&slot_sstate, &slot_resp_prefix,
                                            $&slot_prompts, &dummy_ids, &slot_out_text, $&slot_emitted_len,
                                            &slot_replies, &slot_streams, &slot_cancels,
                                            $&slot_cached_tokens, $&slot_cached_len, $&resp_hist_ids, $&resp_hist_ctx)
                        slot_out_ids[s] = ~dummy_ids
                    }
                }
            }
        } else {
            for ti in 0:decode_slots.len {
                s := decode_slots[ti]
                pos := slot_pos[s]
                _ := forward_token(model, kv, sx, sxb, sxb2, sq, sk, sv, shb, shb2, slogits, sxq, sxs, s, slot_cur_tok[s], pos, true) >>> (err) {
                    cancel_serve_slot(kv, s, $&slot_active, $&active_count, $&slot_cached_len)
                    if slot_is_stream[s] {
                        try_send_stream(slot_streams[s], "data: [DONE]\n\n")
                        try_send_stream(slot_streams[s], "")
                    } else {
                        slot_replies[s] <- ServeResponse{status: 500, body: json_error_body(err.msg()), is_stream: false}
                    }
                    ->
                }
                slot_pos[s] = pos + 1
                if slot_bias_ids[s].len > 0 { apply_logit_bias(slogits, 0, vocab, &slot_bias_ids[s], &slot_bias_vals[s]) }
                if slot_json_mode[s] { apply_json_logit_mask(slogits, 0, model, slot_json_started[s]) }
                $lp_vec := []f32{}
                if slot_want_lp[s] { lp_vec = compute_logprobs_vec(slogits, 0, vocab) }
                $rng := slot_rng[s]
                nxt := sample_token(slogits, vocab, &slot_history[s], slot_temp[s], slot_topk[s], slot_topp[s], slot_minp[s], slot_rep[s], slot_pres[s], slot_freq[s], $&rng)
                slot_rng[s] = rng
                $cur_t := slot_cur_tok[s]
                $gcnt := slot_gen[s]
                $em_len := slot_emitted_len[s]
                $finish_reason := "length"
                $cancelled := false
                $jdepth := slot_json_depth[s]
                $jstarted := slot_json_started[s]
                $jin_str := slot_json_in_str[s]
                $jesc := slot_json_esc[s]
                $lp_s := ~slot_lp_recs[s]
                $hist_s := ~slot_history[s]
                $ids_s := ~slot_out_ids[s]
                $txt_s := slot_out_text[s]
                $ss_s := slot_sstate[s]
                pt_s := slot_prompts[s].len
                finished := accept_generated_piece(model, &slot_req_ids[s], slot_created[s], model_id, slot_is_stream[s], slot_is_chat[s],
                                                  slot_has_tools[s], pt_s,
                                                  slot_ignore_eos[s], &slot_stops[s], slot_stop_pad[s],
                                                  slot_json_mode[s], $&jdepth, $&jstarted, $&jin_str, $&jesc,
                                                  slot_want_lp[s], slot_top_lp[s], &lp_vec, $&lp_s,
                                                  $&ss_s,
                                                  slot_streams[s], slot_cancels[s], nxt,
                                                  $&hist_s, $&ids_s, $&txt_s, $&em_len, $&cur_t, $&gcnt,
                                                  slot_max_gen[s], $&finish_reason, $&cancelled)
                slot_sstate[s] = ss_s
                slot_json_depth[s] = jdepth
                slot_json_started[s] = jstarted
                slot_json_in_str[s] = jin_str
                slot_json_esc[s] = jesc
                slot_lp_recs[s] = ~lp_s
                slot_history[s] = ~hist_s
                slot_out_ids[s] = ~ids_s
                slot_out_text[s] = txt_s
                slot_emitted_len[s] = em_len
                slot_cur_tok[s] = cur_t
                slot_gen[s] = gcnt
                if cancelled {
                    cancel_serve_slot(kv, s, $&slot_active, $&active_count, $&slot_cached_len)
                } else if finished {
                    $dummy_ids := ~slot_out_ids[s]
                    finalize_serve_slot(model_id, kv, s, finish_reason, tmpl_kind, &slot_req_ids, &slot_created,
                                        $&slot_active, $&active_count,
                                        &slot_is_stream, &slot_is_chat, &slot_include_usage,
                                        &slot_want_lp, &slot_lp_recs, &slot_has_tools, $&slot_sstate, &slot_resp_prefix,
                                        $&slot_prompts, &dummy_ids, &slot_out_text, $&slot_emitted_len,
                                        &slot_replies, &slot_streams, &slot_cancels,
                                        $&slot_cached_tokens, $&slot_cached_len, $&resp_hist_ids, $&resp_hist_ctx)
                    slot_out_ids[s] = ~dummy_ids
                }
            }
        }
    }
}

fn json_error_body(msg string) string {
    << "{\"error\":{\"message\":" + json.quote(&msg) + "}}"
}

fn parse_f64_str(s &string) f64 {
    doc := json.parse(s)
    if !doc.ok() || !doc.is_number(doc.root()) {
        >>> errors.new("invalid float value: " + (*s))
    }
    << doc.as_f64(doc.root()) >>>
}

fn try_parse_int_or(s &string, def int) int {
    << strconv.atoi(s) >>> (_) { << def }
}

fn try_parse_f64_or(s &string, def f64) f64 {
    << parse_f64_str(s) >>> (_) { << def }
}

fn push_u32_le(buf $&string, val int) {
    buf.push_str(string_from_byte(val & 255))
    buf.push_str(string_from_byte((val >> 8) & 255))
    buf.push_str(string_from_byte((val >> 16) & 255))
    buf.push_str(string_from_byte((val >> 24) & 255))
}

fn push_u64_le(buf $&string, val int) {
    for i in 0:8 {
        buf.push_str(string_from_byte((val >> (i * 8)) & 255))
    }
}

fn push_f32_array_le(buf $&string, arr &[]f32) {
    for i in 0:arr.len {
        push_u32_le(buf, bits(arr[i]))
    }
}

fn parse_lora_layer_idx(key &string, prefix &string) int {
    pos := find_substr(key, prefix)
    if pos < 0 { << -1 }
    $i := pos + prefix.len
    if i >= key.len { << -1 }
    $val := 0
    $digits := 0
    while i < key.len {
        ch := (*key)[i]
        if ch < 48 || ch > 57 { <- }
        val = val * 10 + (ch - 48)
        digits += 1
        i += 1
    }
    if digits == 0 { << -1 }
    << val
}

fn parse_lora_key(key &string, n_layers int, slot_out $&int, layer_out $&int, side_out $&int) bool {
    $side := -1
    if find_substr(key, &"lora_A") >= 0 || find_substr(key, &"lora_a") >= 0 {
        side = 0
    } else if find_substr(key, &"lora_B") >= 0 || find_substr(key, &"lora_b") >= 0 {
        side = 1
    } else {
        << false
    }
    $slot := -1
    $layer := 0
    if find_substr(key, &"lm_head") >= 0 || find_substr(key, &"output.lora") >= 0 {
        slot = 7
    } else {
        layer = parse_lora_layer_idx(key, &"layers.")
        if layer < 0 { layer = parse_lora_layer_idx(key, &"blk.") }
        if layer < 0 || layer >= n_layers { << false }
        if find_substr(key, &"q_proj") >= 0 || find_substr(key, &"attn_q.") >= 0 { slot = 0 }
        else if find_substr(key, &"k_proj") >= 0 || find_substr(key, &"attn_k.") >= 0 { slot = 1 }
        else if find_substr(key, &"v_proj") >= 0 || find_substr(key, &"attn_v.") >= 0 { slot = 2 }
        else if find_substr(key, &"o_proj") >= 0 || find_substr(key, &"attn_output") >= 0 || find_substr(key, &"attn_o.") >= 0 { slot = 3 }
        else if find_substr(key, &"gate_proj") >= 0 || find_substr(key, &"ffn_gate") >= 0 { slot = 4 }
        else if find_substr(key, &"up_proj") >= 0 || find_substr(key, &"ffn_up") >= 0 { slot = 5 }
        else if find_substr(key, &"down_proj") >= 0 || find_substr(key, &"ffn_down") >= 0 { slot = 6 }
    }
    if slot < 0 { << false }
    *slot_out = slot
    *layer_out = layer
    *side_out = side
    << true
}

fn read_safetensor_2d(data &string, base int, doc &json.Doc, root int, name &string,
                      expected_out int, expected_in int, expect_rank_first bool, rank_io $&int) []f32 {
    entry := doc.get(root, (*name) + "")
    dtype_name := doc.as_string(doc.get(entry, "dtype")) >>>
    dtype := tensor.safetensors_dtype(&dtype_name) >>> (err) {
        >>> errors.new((*name) + ": " + err.msg())
    }
    dims := doc.get(entry, "shape")
    if !doc.is_list(dims) || doc.count(dims) != 2 {
        >>> errors.new("lora tensor must be 2D: " + (*name))
    }
    d0 := doc.as_int(doc.at(dims, 0)) >>>
    d1 := doc.as_int(doc.at(dims, 1)) >>>
    $rank := *rank_io
    if expect_rank_first {
        if rank <= 0 { rank = d0 }
        if d0 != rank || d1 != expected_in {
            >>> errors.new("lora_A shape mismatch for " + (*name))
        }
        *rank_io = rank
    } else {
        if rank <= 0 { rank = d1 }
        if d0 != expected_out || d1 != rank {
            >>> errors.new("lora_B shape mismatch for " + (*name))
        }
        *rank_io = rank
    }
    shape := [d0, d1]
    offs := doc.get(entry, "data_offsets")
    if !doc.is_list(offs) || doc.count(offs) != 2 {
        >>> errors.new("bad data_offsets for " + (*name))
    }
    start := doc.as_int(doc.at(offs, 0)) >>>
    stop := doc.as_int(doc.at(offs, 1)) >>>
    if start < 0 || stop < start || stop > data.len - base {
        >>> errors.new("lora tensor data out of range: " + (*name))
    }
    view := tensor.contiguous_view(dtype, &shape, base + start, base + stop) >>> (err) {
        >>> errors.new((*name) + ": " + err.msg())
    }
    if view.storage_end() != base + stop {
        >>> errors.new("lora tensor byte size mismatch: " + (*name))
    }
    $out := []f32{}
    out.reserve(d0 * d1)
    _ := view.append_f32(data, $&out) >>>
    << out
}

fn load_lora_adapter(m $&Model, path string, override_scale f64) int {
    $sf_path := path + ""
    $cfg_alpha := 0.0
    $cfg_r := 0
    if os.is_dir(path + "") {
        sf_path = path + "/adapter_model.safetensors"
        cfg_raw := try_read_file(path + "/adapter_config.json")
        if cfg_raw.len > 0 {
            cdoc := json.parse(&cfg_raw) >>>
            if cdoc.ok() && cdoc.is_dict(cdoc.root()) {
                croot := cdoc.root()
                cfg_r = hf_int_or(&cdoc, croot, "r", 0)
                cfg_alpha = hf_f64_or(&cdoc, croot, "lora_alpha", 0.0)
            }
        }
    }
    data := os.read(sf_path + "") >>>
    if data.len < 8 { >>> errors.new("truncated lora safetensors file") }
    hlen := read_u64_le(&data, 0)
    if hlen <= 0 || hlen > data.len - 8 { >>> errors.new("invalid lora safetensors header length") }
    base := 8 + hlen
    hstr := data[8:base]
    doc := json.parse(&hstr) >>>
    root := doc.root()
    if !doc.is_dict(root) { >>> errors.new("invalid lora safetensors header json") }
    if cfg_alpha <= 0.0 && doc.has(root, "__metadata__") {
        meta := doc.get(root, "__metadata__")
        if meta >= 0 && doc.is_dict(meta) {
            rs := hf_str_or(&doc, meta, "r", "")
            if rs.len > 0 { cfg_r = try_parse_int_or(&rs, 0) }
            alpha_s := hf_str_or(&doc, meta, "lora_alpha", "")
            if alpha_s.len > 0 { cfg_alpha = try_parse_f64_or(&alpha_s, 0.0) }
        }
    }

    nl := m.cfg.n_layers
    $stride := nl
    if stride < 1 { stride = 1 }
    $a_names := []string{}
    $b_names := []string{}
    for _ in 0:(8 * stride) {
        a_names.push("")
        b_names.push("")
    }
    keys := doc.dict_keys(root)
    for ki in 0:keys.len {
        k := keys[ki]
        if k == "__metadata__" { -> }
        $slot := -1
        $layer := 0
        $side := -1
        if !parse_lora_key(&k, nl, $&slot, $&layer, $&side) { -> }
        idx := slot * stride + layer
        if side == 0 {
            a_names[idx] = k + ""
        } else {
            b_names[idx] = k + ""
        }
    }

    dim := m.cfg.dim
    hidden := m.cfg.hidden_dim
    kv_dim := m.cfg.kv_dim
    $wo_cols := dim
    if m.is_mla { wo_cols = m.cfg.n_heads * m.cfg.v_head_dim }
    vocab := m.cfg.vocab_size
    $loaded := 0
    for slot in 0:8 {
        $lmax := nl
        if slot == 7 { lmax = 1 }
        for l in 0:lmax {
            idx := slot * stride + l
            ak := &a_names[idx]
            bk := &b_names[idx]
            if ak.len == 0 && bk.len == 0 { -> }
            if ak.len == 0 || bk.len == 0 {
                >>> errors.new("unpaired lora_A/lora_B tensor in adapter")
            }
            $out_dim := dim
            $in_dim := dim
            if slot == 1 || slot == 2 {
                out_dim = kv_dim
                in_dim = dim
            } else if slot == 3 {
                out_dim = dim
                in_dim = wo_cols
            } else if slot == 4 || slot == 5 {
                out_dim = hidden
                in_dim = dim
            } else if slot == 6 {
                out_dim = dim
                in_dim = hidden
            } else if slot == 7 {
                out_dim = vocab
                in_dim = dim
            }
            $rank := cfg_r
            a_vals := read_safetensor_2d(&data, base, &doc, root, ak, out_dim, in_dim, true, $&rank) >>>
            b_vals := read_safetensor_2d(&data, base, &doc, root, bk, out_dim, in_dim, false, $&rank) >>>
            $eff_scale := 1.0
            if override_scale > 0.0 {
                eff_scale = override_scale
            } else if cfg_alpha > 0.0 && rank > 0 {
                eff_scale = cfg_alpha / f64(rank)
            }
            pair := LoraPair{rank: rank, scale: f32(eff_scale), a: ~a_vals, b: ~b_vals}
            if slot == 0 { m.lora.q[l] = ~pair }
            else if slot == 1 { m.lora.k[l] = ~pair }
            else if slot == 2 { m.lora.v[l] = ~pair }
            else if slot == 3 { m.lora.o[l] = ~pair }
            else if slot == 4 { m.lora.w1[l] = ~pair }
            else if slot == 5 { m.lora.w3[l] = ~pair }
            else if slot == 6 { m.lora.w2[l] = ~pair }
            else if slot == 7 { m.lora.lm_head = ~pair }
            loaded += 1
        }
    }
    if loaded == 0 { >>> errors.new("no matching lora weights found in " + sf_path) }
    m.lora.active = true
    << loaded
}

fn write_lora_safetensors(out_path &string, a_mat &[]f32, b_mat &[]f32,
                          vocab int, dim int, rank int, alpha f64) int {
    a_bytes := rank * dim * 4
    b_bytes := vocab * rank * 4
    r_str := str(rank)
    alpha_str := strconv.append_float("", alpha, 102, 4)
    hdr_json := "{\"__metadata__\":{\"r\":" + json.quote(&r_str) +
                ",\"lora_alpha\":" + json.quote(&alpha_str) +
                "},\"base_model.model.lm_head.lora_A.weight\":{\"dtype\":\"F32\",\"shape\":[" +
                str(rank) + "," + str(dim) + "],\"data_offsets\":[0," + str(a_bytes) +
                "]},\"base_model.model.lm_head.lora_B.weight\":{\"dtype\":\"F32\",\"shape\":[" +
                str(vocab) + "," + str(rank) + "],\"data_offsets\":[" + str(a_bytes) + "," +
                str(a_bytes + b_bytes) + "]}}"
    $out := ""
    push_u64_le($&out, hdr_json.len)
    out.push_str(hdr_json)
    push_f32_array_le($&out, a_mat)
    push_f32_array_le($&out, b_mat)
    _ := os.write(*out_path, out) >>>
    << 0
}

fn run_train_lora(m &Model, kv $&PagedKvCache,
                  sx $&[]f32, sxb $&[]f32, sxb2 $&[]f32,
                  sq $&[]f32, sk $&[]f32, sv $&[]f32,
                  shb $&[]f32, shb2 $&[]f32, slogits $&[]f32,
                  sxq $&[]i8, sxs $&[]f32,
                  tokens &[]int, out_path &string, rank int, alpha f64, steps int, lr f64, max_grad_norm f64) int {
    if tokens.len < 2 { >>> errors.new("train-lora needs at least 2 tokens") }
    if rank <= 0 || steps <= 0 { >>> errors.new("invalid train-lora rank or steps") }
    dim := m.cfg.dim
    vocab := m.cfg.vocab_size
    n_pairs := tokens.len - 1
    $h_cache := alloc_zeros(n_pairs * dim)
    $b_cache := alloc_zeros(n_pairs * vocab)
    for t in 0:n_pairs {
        _ := forward_token_hidden(m, kv, sx, sxb, sxb2, sq, sk, sv, shb, shb2, sxq, sxs, 0, tokens[t], t, true) >>> (err) {
            kv_free_slot(kv, 0)
            >>> err
        }
        if (m.lm_head_q4 || m.lm_head_q8) { quantize_q8_0(sxb, sxq, sxs, dim) }
        _ := matvec_dispatch(m, m.lm_head_q4, m.lm_head_q8, m.lm_head_p4, true, slogits, sxb, sxq, sxs, m.lm_head_off, vocab, dim) >>> (err) {
            kv_free_slot(kv, 0)
            >>> err
        }
        h_base := t * dim
        for i in 0:dim { h_cache[h_base + i] = sxb[i] }
        b_base := t * vocab
        for i in 0:vocab { b_cache[b_base + i] = slogits[i] }
    }
    kv_free_slot(kv, 0)

    $a_mat := alloc_zeros(rank * dim)
    $rng := 1337
    for i in 0:(rank * dim) {
        rng = (rng * 1103515245 + 12345) & 0x7fffffff
        a_mat[i] = f32(((f64(rng % 2001) / 1000.0) - 1.0) * 0.05)
    }
    $b_mat := alloc_zeros(vocab * rank)
    $m_a := alloc_zeros(rank * dim)
    $v_a := alloc_zeros(rank * dim)
    $m_b := alloc_zeros(vocab * rank)
    $v_b := alloc_zeros(vocab * rank)
    $d_a := alloc_zeros(rank * dim)
    $d_b := alloc_zeros(vocab * rank)
    $h_row := alloc_zeros(dim)
    $lrow := alloc_zeros(vocab)
    $dlogits := alloc_zeros(vocab)
    $empty_dx := []f32{}

    scale := alpha / f64(rank)
    inv_pairs := f32(1.0 / f64(n_pairs))
    for step in 1:(steps + 1) {
        for i in 0:(rank * dim) { d_a[i] = f32(0) }
        for i in 0:(vocab * rank) { d_b[i] = f32(0) }
        $total_loss := 0.0
        for t in 0:n_pairs {
            h_base := t * dim
            for i in 0:dim { h_row[i] = h_cache[h_base + i] }
            b_base := t * vocab
            for i in 0:vocab { lrow[i] = b_cache[b_base + i] }
            tensor.lora_add_f32($&lrow, &h_row, &a_mat, &b_mat, vocab, dim, rank, f32(scale))
            loss := tensor.cross_entropy_grad_f32($&dlogits, &lrow, tokens[t + 1], vocab)
            total_loss += f64(loss)
            tensor.lora_backward_f32($&empty_dx, $&d_a, $&d_b, &dlogits, &h_row, &a_mat, &b_mat, vocab, dim, rank, scale)
        }
        for i in 0:(rank * dim) { d_a[i] = d_a[i] * inv_pairs }
        for i in 0:(vocab * rank) { d_b[i] = d_b[i] * inv_pairs }
        if max_grad_norm > 0.0 {
            _ := tensor.grad_clip_norm_f32($&d_a, rank * dim, f32(max_grad_norm))
            _ := tensor.grad_clip_norm_f32($&d_b, vocab * rank, f32(max_grad_norm))
        }
        tensor.adamw_step_f32($&a_mat, &d_a, $&m_a, $&v_a, rank * dim, f32(lr), f32(0.9), f32(0.999), f32(1e-8), f32(0.0), step)
        tensor.adamw_step_f32($&b_mat, &d_b, $&m_b, $&v_b, vocab * rank, f32(lr), f32(0.9), f32(0.999), f32(1e-8), f32(0.0), step)
        avg_loss := total_loss / f64(n_pairs)
        println("step:" + str(step) + " loss:" + strconv.append_float("", avg_loss, 102, 6))
    }
    _ := write_lora_safetensors(out_path, &a_mat, &b_mat, vocab, dim, rank, alpha) >>>
    println("saved_adapter:" + (*out_path))
    println("kv_free_after:" + str(kv.free_top) + "/" + str(kv.num_blocks))
    << 0
}

fn spec_copy_ints(src &[]int) []int {
    $out := []int{}
    out.reserve(src.len)
    for i in 0:src.len { out.push(src[i]) }
    << out
}

fn spec_lcg_u01(rng $&int) f64 {
    s := (*rng * 6364136223846793005 + 1442695040888963407) & 0x7fffffffffffffff
    *rng = s
    << f64((s >> 16) & 0xffffffff) / 4294967296.0
}

fn spec_softmax_temp(logits &[]f32, vocab int, temp_milli int) []f64 {
    $mx := f64(logits[0])
    for i in 1:vocab {
        v := f64(logits[i])
        if v > mx { mx = v }
    }
    t_scale := f64(temp_milli) / 1000.0
    $probs := []f64{}
    probs.reserve(vocab)
    $sum_p := 0.0
    for i in 0:vocab {
        p := math.exp((f64(logits[i]) - mx) / t_scale)
        probs.push(p)
        sum_p += p
    }
    if sum_p > 0.0 {
        for i in 0:vocab { probs[i] = probs[i] / sum_p }
    } else if vocab > 0 {
        probs[0] = 1.0
    }
    << probs
}

fn spec_sample_probs(probs &[]f64, u f64) int {
    $cdf := 0.0
    for i in 0:probs.len {
        cdf += probs[i]
        if cdf >= u { << i }
    }
    << 0
}

fn spec_project_row_logits(m &Model, x &[]f32, xb $&[]f32, xb2 &[]f32,
                           row_x $&[]f32, row_xb2 $&[]f32,
                           xq $&[]i8, xs $&[]f32, logits $&[]f32, row_idx int) int {
    dim := m.cfg.dim
    off := row_idx * dim
    for i in 0:dim {
        row_x[i] = x[off + i]
        row_xb2[i] = xb2[off + i]
    }
    rmsnorm_add_fused(dim, row_x, row_xb2, &m.final_norm, xb, m.cfg.rms_eps)
    if (m.lm_head_q4 || m.lm_head_q8) { quantize_q8_0(xb, xq, xs, dim) }
    _ := matvec_dispatch(m, m.lm_head_q4, m.lm_head_q8, m.lm_head_p4, true, logits, xb, xq, xs, m.lm_head_off, m.cfg.vocab_size, dim) >>>
    if m.lora.active { apply_lora_rows(logits, xb, 0, 0, 1, m.cfg.vocab_size, dim, &m.lora.lm_head) }
    apply_logit_softcap(logits, 0, m.cfg.vocab_size, m.cfg.logit_softcap)
    << 0
}

struct SpecGenResult {
    out GenOutput
    drafted int
    accepted int
}

fn run_speculative_generation(m &Model, kv $&PagedKvCache, row_cache $&[]ForwardRow,
                              sx $&[]f32, sxb $&[]f32, sxb2 $&[]f32,
                              sq $&[]f32, sk $&[]f32, sv $&[]f32,
                              shb $&[]f32, shb2 $&[]f32, slogits $&[]f32,
                              sxq $&[]i8, sxs $&[]f32,
                              d &Model, dkv $&PagedKvCache, drow_cache $&[]ForwardRow,
                              dx $&[]f32, dxb $&[]f32, dxb2 $&[]f32,
                              dq $&[]f32, dk $&[]f32, dv $&[]f32,
                              dhb $&[]f32, dhb2 $&[]f32, dlogits $&[]f32,
                              dxq $&[]i8, dxs $&[]f32,
                              prompt_ids &[]int, max_tokens int, temp_milli int, top_k int,
                              top_p_milli int, min_p_milli int, repeat_penalty_milli int,
                              presence_penalty_milli int, frequency_penalty_milli int,
                              seed int, ignore_eos bool, draft_k int) SpecGenResult {
    if d.cfg.vocab_size != m.cfg.vocab_size {
        >>> errors.new("draft model vocab_size does not match target model")
    }
    $rng := seed
    $history := spec_copy_ints(prompt_ids)
    $out_ids := []int{}
    $out_text := ""
    $finish_reason := "length"
    $decode_ns := 0
    $spec_drafted := 0
    $spec_accepted := 0
    no_stops := []string{}
    t_vocab := m.cfg.vocab_size
    t_dim := m.cfg.dim
    $row_x := alloc_zeros(t_dim)
    $row_xb2 := alloc_zeros(t_dim)

    t_pref := time.now()
    _ := forward_prefill_batch(m, kv, row_cache, sx, sxb, sxb2, sq, sk, sv, shb, shb2, slogits, sxq, sxs, 0, prompt_ids, 0, true, true) >>> (err) {
        kv_free_slot(kv, 0)
        kv_free_slot(dkv, 0)
        >>> err
    }
    _ := forward_prefill_batch(d, dkv, drow_cache, dx, dxb, dxb2, dq, dk, dv, dhb, dhb2, dlogits, dxq, dxs, 0, prompt_ids, 0, true, false) >>> (err) {
        kv_free_slot(kv, 0)
        kv_free_slot(dkv, 0)
        >>> err
    }
    pref_ns := time.since(t_pref)

    $pos := prompt_ids.len
    $max_ctx := m.cfg.max_seq_len
    if d.cfg.max_seq_len < max_ctx { max_ctx = d.cfg.max_seq_len }
    if max_tokens > 0 {
        $next0 := 0
        if temp_milli > 0 {
            tp0 := spec_softmax_temp(slogits, t_vocab, temp_milli)
            next0 = spec_sample_probs(&tp0, spec_lcg_u01($&rng))
        } else {
            next0 = sample_token(slogits, t_vocab, &history, temp_milli, top_k, top_p_milli, min_p_milli, repeat_penalty_milli, presence_penalty_milli, frequency_penalty_milli, $&rng)
        }
        if !ignore_eos && is_eos_token(m, next0) {
            finish_reason = "stop"
        } else {
            p0 := format_piece(m, next0)
            history.push(next0)
            out_ids.push(next0)
            out_text = out_text + p0
            if trim_stop_sequence($&out_text, &no_stops) {
                finish_reason = "stop"
            } else {
                println("token:0:" + str(next0) + ":" + p0)
                $cur_tok := next0
                $stopped := false
                t_dec := time.now()
                while !stopped && out_ids.len < max_tokens && pos < max_ctx {
                    $k_rem := max_tokens - out_ids.len
                    $k := draft_k
                    if k < 1 { k = 1 }
                    if k > k_rem { k = k_rem }
                    if k > PREFILL_CHUNK - 1 { k = PREFILL_CHUNK - 1 }
                    if pos + k + 1 > max_ctx { k = max_ctx - pos - 1 }
                    if k <= 0 {
                        _ := forward_token(m, kv, sx, sxb, sxb2, sq, sk, sv, shb, shb2, slogits, sxq, sxs, 0, cur_tok, pos, true) >>> (err) {
                            kv_free_slot(kv, 0)
                            kv_free_slot(dkv, 0)
                            >>> err
                        }
                        $nt := 0
                        if temp_milli > 0 {
                            tp := spec_softmax_temp(slogits, t_vocab, temp_milli)
                            nt = spec_sample_probs(&tp, spec_lcg_u01($&rng))
                        } else {
                            nt = sample_token(slogits, t_vocab, &history, temp_milli, top_k, top_p_milli, min_p_milli, repeat_penalty_milli, presence_penalty_milli, frequency_penalty_milli, $&rng)
                        }
                        if !ignore_eos && is_eos_token(m, nt) {
                            finish_reason = "stop"
                        } else {
                            pc := format_piece(m, nt)
                            println("token:" + str(out_ids.len) + ":" + str(nt) + ":" + pc)
                            history.push(nt)
                            out_ids.push(nt)
                            out_text = out_text + pc
                        }
                        <-
                    }

                    // 1. Draft k tokens
                    $cands := []int{}
                    $d_probs := [][]f64{}
                    $d_cur := cur_tok
                    $d_hist := spec_copy_ints(&history)
                    for step in 0:k {
                        _ := forward_token(d, dkv, dx, dxb, dxb2, dq, dk, dv, dhb, dhb2, dlogits, dxq, dxs, 0, d_cur, pos + step, true) >>> (err) {
                            kv_free_slot(kv, 0)
                            kv_free_slot(dkv, 0)
                            >>> err
                        }
                        $ct := 0
                        if temp_milli > 0 {
                            dp := spec_softmax_temp(dlogits, t_vocab, temp_milli)
                            ct = spec_sample_probs(&dp, spec_lcg_u01($&rng))
                            d_probs.push(~dp)
                        } else {
                            ct = sample_token(dlogits, t_vocab, &d_hist, temp_milli, top_k, top_p_milli, min_p_milli, repeat_penalty_milli, presence_penalty_milli, frequency_penalty_milli, $&rng)
                        }
                        cands.push(ct)
                        d_hist.push(ct)
                        d_cur = ct
                        spec_drafted += 1
                    }

                    // 2. Target parallel verification over [cur_tok, cands...]
                    vcnt := k + 1
                    _ := load_embed_row(m, cur_tok, sx, 0) >>>
                    row_cache[0] = prepare_forward_row(kv, 0, pos) >>> (err) {
                        kv_free_slot(kv, 0)
                        kv_free_slot(dkv, 0)
                        >>> err
                    }
                    for j in 0:k {
                        _ := load_embed_row(m, cands[j], sx, (j + 1) * t_dim) >>>
                        row_cache[j + 1] = prepare_forward_row(kv, 0, pos + j + 1) >>> (err) {
                            kv_free_slot(kv, 0)
                            kv_free_slot(dkv, 0)
                            >>> err
                        }
                    }
                    _ := forward_rows(m, kv, row_cache, vcnt, 0, vcnt, true, true, sx, sxb, sxb2, sq, sk, sv, shb, shb2, sxq, sxs) >>> (err) {
                        kv_free_slot(kv, 0)
                        kv_free_slot(dkv, 0)
                        >>> err
                    }

                    // 3. Accept/reject token-by-token
                    $accepted := 0
                    $rejected := false
                    $next_cur := cur_tok
                    for j in 0:k {
                        _ := spec_project_row_logits(m, sx, sxb, sxb2, $&row_x, $&row_xb2, sxq, sxs, slogits, j) >>>
                        $emit_tok := cands[j]
                        $acc_ok := false
                        if temp_milli > 0 {
                            tp := spec_softmax_temp(slogits, t_vocab, temp_milli)
                            pt_c := tp[emit_tok]
                            pd_c := d_probs[j][emit_tok]
                            if pd_c <= 0.0 || spec_lcg_u01($&rng) * pd_c >= pt_c {
                                $res := []f64{}
                                res.reserve(t_vocab)
                                $rsum := 0.0
                                for vi in 0:t_vocab {
                                    $df := tp[vi] - d_probs[j][vi]
                                    if df < 0.0 { df = 0.0 }
                                    res.push(df)
                                    rsum += df
                                }
                                if rsum > 0.0 {
                                    for vi in 0:t_vocab { res[vi] = res[vi] / rsum }
                                    emit_tok = spec_sample_probs(&res, spec_lcg_u01($&rng))
                                } else {
                                    emit_tok = argmax(slogits, t_vocab)
                                }
                                rejected = true
                            } else {
                                acc_ok = true
                            }
                        } else {
                            t_tok := sample_token(slogits, t_vocab, &history, temp_milli, top_k, top_p_milli, min_p_milli, repeat_penalty_milli, presence_penalty_milli, frequency_penalty_milli, $&rng)
                            if t_tok == emit_tok {
                                acc_ok = true
                            } else {
                                emit_tok = t_tok
                                rejected = true
                            }
                        }
                        if acc_ok {
                            accepted += 1
                            spec_accepted += 1
                        }
                        if !ignore_eos && is_eos_token(m, emit_tok) {
                            finish_reason = "stop"
                            stopped = true
                            <-
                        }
                        pc := format_piece(m, emit_tok)
                        println("token:" + str(out_ids.len) + ":" + str(emit_tok) + ":" + pc)
                        history.push(emit_tok)
                        out_ids.push(emit_tok)
                        out_text = out_text + pc
                        next_cur = emit_tok
                        if out_ids.len >= max_tokens {
                            finish_reason = "length"
                            stopped = true
                            <-
                        }
                        if rejected { <- }
                    }

                    // 4. Optional bonus token if all k drafted tokens were accepted
                    if !rejected && !stopped && accepted == k && out_ids.len < max_tokens {
                        _ := spec_project_row_logits(m, sx, sxb, sxb2, $&row_x, $&row_xb2, sxq, sxs, slogits, k) >>>
                        $bt := 0
                        if temp_milli > 0 {
                            tp_b := spec_softmax_temp(slogits, t_vocab, temp_milli)
                            bt = spec_sample_probs(&tp_b, spec_lcg_u01($&rng))
                        } else {
                            bt = sample_token(slogits, t_vocab, &history, temp_milli, top_k, top_p_milli, min_p_milli, repeat_penalty_milli, presence_penalty_milli, frequency_penalty_milli, $&rng)
                        }
                        if !ignore_eos && is_eos_token(m, bt) {
                            finish_reason = "stop"
                            stopped = true
                        } else {
                            pc := format_piece(m, bt)
                            println("token:" + str(out_ids.len) + ":" + str(bt) + ":" + pc)
                            history.push(bt)
                            out_ids.push(bt)
                            out_text = out_text + pc
                            next_cur = bt
                            if out_ids.len >= max_tokens {
                                finish_reason = "length"
                                stopped = true
                            }
                        }
                    }

                    // 5. Synchronize target & draft KV caches to new_pos = pos + accepted + 1
                    new_pos := pos + accepted + 1
                    if new_pos < pos + vcnt {
                        kv_truncate_slot(kv, 0, new_pos)
                    }
                    if !stopped {
                        if accepted < k {
                            if new_pos < pos + k {
                                kv_truncate_slot(dkv, 0, new_pos)
                            }
                        } else {
                            // Draft has processed pos..pos+k-1; ingest cands[k-1] at pos+k so dkv matches pos+k+1
                            _ := forward_token(d, dkv, dx, dxb, dxb2, dq, dk, dv, dhb, dhb2, dlogits, dxq, dxs, 0, cands[k - 1], pos + k, true) >>> (err) {
                                kv_free_slot(kv, 0)
                                kv_free_slot(dkv, 0)
                                >>> err
                            }
                        }
                    }
                    pos = new_pos
                    cur_tok = next_cur
                }
                decode_ns = time.since(t_dec)
            }
        }
    }
    kv_free_slot(kv, 0)
    kv_free_slot(dkv, 0)
    << SpecGenResult{
        out: GenOutput{ids: ~out_ids, text: out_text, finish_reason: finish_reason, prefill_ns: pref_ns, decode_ns: decode_ns},
        drafted: spec_drafted,
        accepted: spec_accepted
    }
}

fn main() int {
    raw_args := os.argv()
    $args := []string{}
    $ctx_limit := DEFAULT_CTX_LIMIT
    $kv_dtype := tensor.dtype_f32()
    $top_p_milli := 1000
    $min_p_milli := 0
    $repeat_penalty_milli := 1000
    $presence_penalty_milli := 0
    $frequency_penalty_milli := 0
    $max_slots_arg := MAX_BATCH_SLOTS
    $api_key := ""
    $seed := 20261124
    $ignore_eos := false
    $use_q8k_act := false
    $rope_type_arg := "auto"
    $lora_arg := ""
    $lora_scale := 0.0
    $draft_arg := ""
    $draft_k := 4
    $lora_rank := 4
    $lora_alpha := 8.0
    $train_steps := 20
    $train_lr := 0.05
    $train_max_grad_norm := 0.0
    $ai := 1
    while ai < raw_args.len {
        arg := raw_args[ai]
        if arg == "--ctx" && ai + 1 < raw_args.len {
            ns := raw_args[ai + 1]
            ctx_limit = strconv.atoi(&ns) >>> (err) {
                eprintln("invalid --ctx: " + err.msg())
                << 1
            }
            ai += 2
        } else if arg == "--kv-dtype" && ai + 1 < raw_args.len {
            ds := raw_args[ai + 1]
            kv_dtype = tensor.dtype_named(&ds) >>> (err) {
                eprintln("invalid --kv-dtype: " + err.msg())
                << 1
            }
            ai += 2
        } else if arg == "--top-p" && ai + 1 < raw_args.len {
            ps := raw_args[ai + 1]
            top_p_milli = strconv.atoi(&ps) >>> (err) {
                eprintln("invalid --top-p: " + err.msg())
                << 1
            }
            ai += 2
        } else if arg == "--min-p" && ai + 1 < raw_args.len {
            ms := raw_args[ai + 1]
            min_p_milli = strconv.atoi(&ms) >>> (err) {
                eprintln("invalid --min-p: " + err.msg())
                << 1
            }
            ai += 2
        } else if arg == "--repeat-penalty" && ai + 1 < raw_args.len {
            rs := raw_args[ai + 1]
            repeat_penalty_milli = strconv.atoi(&rs) >>> (err) {
                eprintln("invalid --repeat-penalty: " + err.msg())
                << 1
            }
            ai += 2
        } else if arg == "--presence-penalty" && ai + 1 < raw_args.len {
            ps := raw_args[ai + 1]
            presence_penalty_milli = strconv.atoi(&ps) >>> (err) {
                eprintln("invalid --presence-penalty: " + err.msg())
                << 1
            }
            ai += 2
        } else if arg == "--frequency-penalty" && ai + 1 < raw_args.len {
            fs := raw_args[ai + 1]
            frequency_penalty_milli = strconv.atoi(&fs) >>> (err) {
                eprintln("invalid --frequency-penalty: " + err.msg())
                << 1
            }
            ai += 2
        } else if arg == "--max-slots" && ai + 1 < raw_args.len {
            ss := raw_args[ai + 1]
            max_slots_arg = strconv.atoi(&ss) >>> (err) {
                eprintln("invalid --max-slots: " + err.msg())
                << 1
            }
            if max_slots_arg < 1 { max_slots_arg = 1 }
            ai += 2
        } else if arg == "--api-key" && ai + 1 < raw_args.len {
            api_key = raw_args[ai + 1] + ""
            ai += 2
        } else if arg == "--seed" && ai + 1 < raw_args.len {
            ss := raw_args[ai + 1]
            seed = strconv.atoi(&ss) >>> (err) {
                eprintln("invalid --seed: " + err.msg())
                << 1
            }
            ai += 2
        } else if arg == "--ignore-eos" {
            ignore_eos = true
            ai += 1
        } else if arg == "--q8k-act" {
            use_q8k_act = true
            ai += 1
        } else if arg == "--rope-type" && ai + 1 < raw_args.len {
            rt := raw_args[ai + 1]
            if rt != "auto" && rt != "norm" && rt != "neox" {
                eprintln("invalid --rope-type (expected auto|norm|neox): " + rt)
                << 1
            }
            rope_type_arg = rt + ""
            ai += 2
        } else if arg == "--lora" && ai + 1 < raw_args.len {
            lora_arg = raw_args[ai + 1] + ""
            ai += 2
        } else if arg == "--lora-scale" && ai + 1 < raw_args.len {
            ls := raw_args[ai + 1]
            lora_scale = parse_f64_str(&ls) >>> (err) {
                eprintln("invalid --lora-scale: " + err.msg())
                << 1
            }
            ai += 2
        } else if arg == "--draft" && ai + 1 < raw_args.len {
            draft_arg = raw_args[ai + 1] + ""
            ai += 2
        } else if arg == "--draft-k" && ai + 1 < raw_args.len {
            ks := raw_args[ai + 1]
            draft_k = strconv.atoi(&ks) >>> (err) {
                eprintln("invalid --draft-k: " + err.msg())
                << 1
            }
            if draft_k < 1 { draft_k = 1 }
            ai += 2
        } else if arg == "--lora-rank" && ai + 1 < raw_args.len {
            rs := raw_args[ai + 1]
            lora_rank = strconv.atoi(&rs) >>> (err) {
                eprintln("invalid --lora-rank: " + err.msg())
                << 1
            }
            ai += 2
        } else if arg == "--lora-alpha" && ai + 1 < raw_args.len {
            alpha_s := raw_args[ai + 1]
            lora_alpha = parse_f64_str(&alpha_s) >>> (err) {
                eprintln("invalid --lora-alpha: " + err.msg())
                << 1
            }
            ai += 2
        } else if arg == "--steps" && ai + 1 < raw_args.len {
            ss := raw_args[ai + 1]
            train_steps = strconv.atoi(&ss) >>> (err) {
                eprintln("invalid --steps: " + err.msg())
                << 1
            }
            ai += 2
        } else if arg == "--lr" && ai + 1 < raw_args.len {
            ls := raw_args[ai + 1]
            train_lr = parse_f64_str(&ls) >>> (err) {
                eprintln("invalid --lr: " + err.msg())
                << 1
            }
            ai += 2
        } else if arg == "--max-grad-norm" && ai + 1 < raw_args.len {
            gs := raw_args[ai + 1]
            train_max_grad_norm = parse_f64_str(&gs) >>> (err) {
                eprintln("invalid --max-grad-norm: " + err.msg())
                << 1
            }
            ai += 2
        } else {
            args.push(~arg)
            ai += 1
        }
    }

    if args.len < 2 {
        eprintln("usage: llm_engine <verify|verify-f32act|bench|bench-f32act|generate|serve|train-lora> <model> ... [--ctx N] [--kv-dtype D] [--rope-type auto|norm|neox] [--lora PATH] [--lora-scale F] [--draft PATH] [--draft-k N]")
        << 1
    }
    mode := args[0]
    model_path := args[1]
    model_id := model_path + ""
    use_p4 := mode != "verify-f32act" && mode != "bench-f32act"
    t_load := time.now()
    $model := load_model(model_path, ctx_limit, use_p4) >>> (err) {
        eprintln("load error: " + err.msg())
        << 1
    }
    model.use_q8k_act = use_q8k_act
    if lora_arg.len > 0 {
        _ := load_lora_adapter($&model, lora_arg, lora_scale) >>> (err) {
            eprintln("lora error: " + err.msg())
            << 1
        }
    }
    if rope_type_arg == "norm" {
        model.cfg.rope_interleaved = true
    } else if rope_type_arg == "neox" {
        model.cfg.rope_interleaved = false
    }
    load_ns := time.since(t_load)

    $kv_slots := MAX_BATCH_SLOTS
    if mode == "serve" {
        kv_slots = max_slots_arg
    } else if mode == "generate" || mode == "train-lora" || ((mode == "bench" || mode == "bench-f32act") && args.len > 3 && args[3] == "single") {
        kv_slots = 1
    }
    $kv := new_paged_kv_cache(&model.cfg, kv_slots, kv_dtype) >>> (err) {
        eprintln("kv error: " + err.msg())
        << 1
    }
    $batch_cap := PREFILL_CHUNK
    if kv_slots > batch_cap { batch_cap = kv_slots }
    $row_cache := []ForwardRow{}
    for _ in 0:batch_cap {
        row_cache.push(ForwardRow{pos: 0, kv_offset: 0, table_offset: 0})
    }
    $sx := alloc_zeros(batch_cap * model.cfg.dim)
    $sxb := alloc_zeros(batch_cap * max_kv_buf_dim(&model.cfg))
    if sxb.len < batch_cap * model.cfg.dim { sxb = alloc_zeros(batch_cap * model.cfg.dim) }
    $sxb2 := alloc_zeros(batch_cap * model.cfg.dim)
    $sq := alloc_zeros(batch_cap * max_q_buf_dim(&model.cfg))
    $sk := alloc_zeros(batch_cap * max_kv_buf_dim(&model.cfg))
    $sv := alloc_zeros(batch_cap * max_kv_buf_dim(&model.cfg))
    $shb := alloc_zeros(batch_cap * ffn_max_hidden(&model.cfg))
    $shb2 := alloc_zeros(batch_cap * ffn_max_hidden(&model.cfg))
    $logit_rows := 1
    if kv_slots > 1 {
        logit_rows = kv_slots
    }
    $slogits := alloc_zeros(logit_rows * model.cfg.vocab_size)
    $q_cap := max_q_buf_dim(&model.cfg)
    $kvd := max_kv_buf_dim(&model.cfg)
    if kvd > q_cap { q_cap = kvd }
    mh := ffn_max_hidden(&model.cfg)
    if mh > q_cap { q_cap = mh }
    $sxq := alloc_i8_zeros(batch_cap * q_cap)
    $sxs := alloc_zeros(batch_cap * ((q_cap + 31) / 32))

    $prompts := [][]int{}
    prompts.push([1, 7, 42])
    prompts.push([3, 19])
    prompts.push([5, 11, 23, 37])
    prompts.push([9])
    gens := [3, 5, 2, 3]

    if mode == "verify" || mode == "verify-f32act" {
        use_q8 := mode == "verify"
        $fmt := "f32"
        if model.is_q4 {
            fmt = "q4_0"
        } else if model.is_q8 {
            fmt = "q8_0"
        } else if model.wq_off.len > 0 && model.wq_off[0] < 0 {
            wkind := model.compact_weights.kinds[-1 - model.wq_off[0]]
            if wkind == COMPACT_Q4_K { fmt = "q4_k" }
            else if wkind == COMPACT_Q5_K { fmt = "q5_k" }
            else if wkind == COMPACT_Q6_K { fmt = "q6_k" }
            else if wkind == COMPACT_Q5_0 { fmt = "q5_0" }
            else if wkind == COMPACT_Q8_0 { fmt = "q8_0" }
        }
        $act := "f32"
        if (model.is_q4 || model.is_q8 || model.lm_head_q8) && use_q8 { act = "q8_0" }
        println("format:" + fmt)
        println("act_mode:" + act)
        println("vocab_size:" + str(model.vocab.len))
        if model.is_moe { println("expert_count:" + str(model.cfg.expert_count)) }
        if model.cfg.rope_scaling_type.len > 0 { println("rope_scaling:" + model.cfg.rope_scaling_type) }

        $seq_results := []ClientResult{}
        for r in 0:prompts.len {
            $res := run_single_request(&model, $&kv, $&row_cache, $&sx, $&sxb, $&sxb2, $&sq, $&sk, $&sv, $&shb, $&shb2, $&slogits, $&sxq, $&sxs, &prompts[r], gens[r], use_q8) >>> (err) {
                eprintln("verify error: " + err.msg())
                << 1
            }
            res.req_id = r
            println(format_result("seq", &res))
            seq_results.push(~res)
        }

        batch_results := run_continuous_batch(&model, $&kv, $&row_cache, $&sx, $&sxb, $&sxb2, $&sq, $&sk, $&sv, $&shb, $&shb2, $&slogits, $&sxq, $&sxs, &prompts, &gens, use_q8) >>> (err) {
            eprintln("cb error: " + err.msg())
            << 1
        }
        for r in 0:batch_results.len {
            println(format_result("cb", &batch_results[r]))
            if batch_results[r].tokens.len != seq_results[r].tokens.len { << 2 }
            for i in 0:batch_results[r].tokens.len {
                if batch_results[r].tokens[i] != seq_results[r].tokens[i] ||
                   batch_results[r].logit_bits[i] != seq_results[r].logit_bits[i] {
                    << 3
                }
            }
        }
        println("kv_free_after:" + str(kv.free_top) + "/" + str(kv.num_blocks))
        println("kv_allocs:" + str(kv.alloc_count))
        println("kv_storage_bytes:" + str(kv.storage_bytes))
        println("compact_weight_bytes:" + str(model.compact_weights.data.len))
        if kv.free_top != kv.num_blocks { << 4 }
        << 0
    }

    if mode == "bench" || mode == "bench-f32act" {
        use_q8 := mode == "bench"
        $steps := 32
        $prompt_len := 1
        if args.len > 2 {
            s := args[2]
            steps = strconv.atoi(&s) >>> (err) {
                eprintln("invalid steps: " + err.msg())
                << 1
            }
        }
        if args.len > 4 {
            ps := args[4]
            prompt_len = strconv.atoi(&ps) >>> (err) {
                eprintln("invalid prompt_len: " + err.msg())
                << 1
            }
        }

        $bench_prompt := []int{}
        if prompt_len > 1 {
            for pi in 0:prompt_len {
                tid := (pi * 17 + 1) % model.cfg.vocab_size
                bench_prompt.push(tid)
            }
            _ := forward_prefill_batch(&model, $&kv, $&row_cache, $&sx, $&sxb, $&sxb2, $&sq, $&sk, $&sv, $&shb, $&shb2, $&slogits, $&sxq, $&sxs, 0, &bench_prompt, 0, use_q8, true) >>> (err) {
                eprintln("warmup error: " + err.msg())
                << 1
            }
            kv_free_slot($&kv, 0)
        } else {
            _ := run_single_request(&model, $&kv, $&row_cache, $&sx, $&sxb, $&sxb2, $&sq, $&sk, $&sv, $&shb, $&shb2, $&slogits, $&sxq, $&sxs, &prompts[0], 4, use_q8) >>> (err) {
                eprintln("warmup error: " + err.msg())
                << 1
            }
        }

        ttft_start := time.now()
        $first_tok := 0
        if prompt_len > 1 {
            first_tok = forward_prefill_batch(&model, $&kv, $&row_cache, $&sx, $&sxb, $&sxb2, $&sq, $&sk, $&sv, $&shb, $&shb2, $&slogits, $&sxq, $&sxs, 0, &bench_prompt, 0, use_q8, true) >>> (err) {
                eprintln("bench prefill error: " + err.msg())
                << 1
            }
        } else {
            first_tok = forward_token(&model, $&kv, $&sx, $&sxb, $&sxb2, $&sq, $&sk, $&sv, $&shb, $&shb2, $&slogits, $&sxq, $&sxs, 0, prompts[0][0], 0, use_q8) >>> (err) {
                eprintln("bench error: " + err.msg())
                << 1
            }
        }
        ttft_ns := time.since(ttft_start)

        $decode_ns := []int{}
        $gen_toks := []int{}
        gen_toks.push(first_tok)
        $tok := first_tok
        $checksum := first_tok
        $pos := prompt_len
        if prompt_len <= 1 { pos = 1 }
        total_start := time.now()
        for step in 1:steps + 1 {
            t0 := time.now()
            if pos >= model.cfg.max_seq_len {
                kv_free_slot($&kv, 0)
                pos = 0
            }
            tok = forward_token(&model, $&kv, $&sx, $&sxb, $&sxb2, $&sq, $&sk, $&sv, $&shb, $&shb2, $&slogits, $&sxq, $&sxs, 0, tok, pos, use_q8) >>> (err) {
                eprintln("bench error: " + err.msg())
                << 1
            }
            pos += 1
            decode_ns.push(time.since(t0))
            gen_toks.push(tok)
            checksum += tok
        }
        total_ns := time.since(total_start)
        kv_free_slot($&kv, 0)

        $cb_ns := 0
        $cb_steps := 0
        if args.len <= 3 || args[3] != "single" {
            cb_start := time.now()
            cb_res := run_continuous_batch(&model, $&kv, $&row_cache, $&sx, $&sxb, $&sxb2, $&sq, $&sk, $&sv, $&shb, $&shb2, $&slogits, $&sxq, $&sxs, &prompts, &gens, use_q8) >>> (err) {
                eprintln("cb bench error: " + err.msg())
                << 1
            }
            cb_ns = time.since(cb_start)
            for r in 0:cb_res.len {
                cb_steps += prompts[r].len + gens[r] - 1
                for k in 0:cb_res[r].tokens.len { checksum += cb_res[r].tokens[k] }
            }
        }

        for i in 1:decode_ns.len {
            key := decode_ns[i]
            $j := i - 1
            while j >= 0 && decode_ns[j] > key {
                decode_ns[j + 1] = decode_ns[j]
                j -= 1
            }
            decode_ns[j + 1] = key
        }
        $p50 := 0
        $p99 := 0
        if decode_ns.len > 0 {
            p50 = decode_ns[decode_ns.len / 2]
            p99 = decode_ns[(decode_ns.len * 99) / 100]
        }
        $pref_toks := 1
        if prompt_len > 1 { pref_toks = prompt_len }
        println("load_ms:" + str(load_ns / 1000000))
        println("prefill_tokens:" + str(pref_toks))
        println("prefill_ns:" + str(ttft_ns))
        println("checksum:" + str(checksum))
        println("ttft_ns:" + str(ttft_ns))
        println("decode_p50_ns:" + str(p50))
        println("decode_p99_ns:" + str(p99))
        println("decode_total_ns:" + str(total_ns))
        println("decode_steps:" + str(steps))
        println("cb_total_ns:" + str(cb_ns))
        println("cb_steps:" + str(cb_steps))
        println("tokens:" + join_ints(&gen_toks))
        << 0
    }

    if mode == "train-lora" {
        if args.len < 4 {
            eprintln("usage: llm_engine train-lora <base_model> <prompt|ids:...> <out_adapter.safetensors> [--lora-rank R] [--lora-alpha A] [--steps N] [--lr F] [--max-grad-norm G]")
            << 1
        }
        train_ids := encode_prompt(&model, &args[2])
        out_path := args[3]
        println("load_ms:" + str(load_ns / 1000000))
        println("prompt_ids:" + join_ints(&train_ids))
        _ := run_train_lora(&model, $&kv, $&sx, $&sxb, $&sxb2, $&sq, $&sk, $&sv,
                            $&shb, $&shb2, $&slogits, $&sxq, $&sxs,
                            &train_ids, &out_path, lora_rank, lora_alpha, train_steps, train_lr, train_max_grad_norm) >>> (err) {
            eprintln("train-lora error: " + err.msg())
            << 1
        }
        if kv.free_top != kv.num_blocks { << 4 }
        << 0
    }

    if mode == "generate" {
        if args.len < 3 {
            eprintln("usage: llm_engine generate <model> <prompt|ids:...> [max_tokens] [temp_milli] [top_k]")
            << 1
        }
        prompt_ids := encode_prompt(&model, &args[2])
        $max_tokens := 16
        $temp_milli := 0
        $top_k := 40
        if args.len > 3 {
            s := args[3]
            max_tokens = strconv.atoi(&s) >>> (err) {
                eprintln("invalid max_tokens: " + err.msg())
                << 1
            }
        }
        if args.len > 4 {
            s := args[4]
            temp_milli = strconv.atoi(&s) >>> (err) {
                eprintln("invalid temp_milli: " + err.msg())
                << 1
            }
        }
        if args.len > 5 {
            s := args[5]
            top_k = strconv.atoi(&s) >>> (err) {
                eprintln("invalid top_k: " + err.msg())
                << 1
            }
        }
        println("load_ms:" + str(load_ns / 1000000))
        println("prompt_ids:" + join_ints(&prompt_ids))

        if draft_arg.len > 0 {
            $draft := load_model(draft_arg, ctx_limit, use_p4) >>> (err) {
                eprintln("draft load error: " + err.msg())
                << 1
            }
            $dkv := new_paged_kv_cache(&draft.cfg, 1, kv_dtype) >>> (err) {
                eprintln("draft kv error: " + err.msg())
                << 1
            }
            $drow_cache := []ForwardRow{}
            for _ in 0:PREFILL_CHUNK {
                drow_cache.push(ForwardRow{pos: 0, kv_offset: 0, table_offset: 0})
            }
            $dx := alloc_zeros(PREFILL_CHUNK * draft.cfg.dim)
            $dxb := alloc_zeros(PREFILL_CHUNK * max_kv_buf_dim(&draft.cfg))
            if dxb.len < PREFILL_CHUNK * draft.cfg.dim { dxb = alloc_zeros(PREFILL_CHUNK * draft.cfg.dim) }
            $dxb2 := alloc_zeros(PREFILL_CHUNK * draft.cfg.dim)
            $dq := alloc_zeros(PREFILL_CHUNK * max_q_buf_dim(&draft.cfg))
            $dk := alloc_zeros(PREFILL_CHUNK * max_kv_buf_dim(&draft.cfg))
            $dv := alloc_zeros(PREFILL_CHUNK * max_kv_buf_dim(&draft.cfg))
            $dhb := alloc_zeros(PREFILL_CHUNK * ffn_max_hidden(&draft.cfg))
            $dhb2 := alloc_zeros(PREFILL_CHUNK * ffn_max_hidden(&draft.cfg))
            $dlogits := alloc_zeros(draft.cfg.vocab_size)
            $dq_cap := max_q_buf_dim(&draft.cfg)
            $dkvd := max_kv_buf_dim(&draft.cfg)
            if dkvd > dq_cap { dq_cap = dkvd }
            dmh := ffn_max_hidden(&draft.cfg)
            if dmh > dq_cap { dq_cap = dmh }
            $dxq := alloc_i8_zeros(PREFILL_CHUNK * dq_cap)
            $dxs := alloc_zeros(PREFILL_CHUNK * ((dq_cap + 31) / 32))

            sres := run_speculative_generation(&model, $&kv, $&row_cache,
                                               $&sx, $&sxb, $&sxb2, $&sq, $&sk, $&sv,
                                               $&shb, $&shb2, $&slogits, $&sxq, $&sxs,
                                               &draft, $&dkv, $&drow_cache,
                                               $&dx, $&dxb, $&dxb2, $&dq, $&dk, $&dv,
                                               $&dhb, $&dhb2, $&dlogits, $&dxq, $&dxs,
                                               &prompt_ids, max_tokens, temp_milli, top_k,
                                               top_p_milli, min_p_milli, repeat_penalty_milli,
                                               presence_penalty_milli, frequency_penalty_milli,
                                               seed, ignore_eos, draft_k) >>> (err) {
                eprintln("speculative error: " + err.msg())
                << 1
            }
            println("prefill_ns:" + str(sres.out.prefill_ns))
            println("decode_total_ns:" + str(sres.out.decode_ns))
            println("generated_ids:" + join_ints(&sres.out.ids))
            println("generated_text:" + sres.out.text)
            println("spec_drafted:" + str(sres.drafted))
            println("spec_accepted:" + str(sres.accepted))
            println("kv_free_after:" + str(kv.free_top) + "/" + str(kv.num_blocks))
            if kv.free_top != kv.num_blocks || dkv.free_top != dkv.num_blocks { << 4 }
            << 0
        }

        gen := run_generation_seq(&model, $&kv, $&row_cache, $&sx, $&sxb, $&sxb2,
                                  $&sq, $&sk, $&sv, $&shb, $&shb2, $&slogits, $&sxq, $&sxs,
                                  &prompt_ids, max_tokens, temp_milli, top_k,
                                  top_p_milli, min_p_milli, repeat_penalty_milli,
                                  presence_penalty_milli, frequency_penalty_milli,
                                  seed, ignore_eos, true) >>> (err) {
            eprintln("generate error: " + err.msg())
            << 1
        }
        println("prefill_ns:" + str(gen.prefill_ns))
        println("decode_total_ns:" + str(gen.decode_ns))
        println("generated_ids:" + join_ints(&gen.ids))
        println("generated_text:" + gen.text)
        println("kv_free_after:" + str(kv.free_top) + "/" + str(kv.num_blocks))
        if kv.free_top != kv.num_blocks { << 4 }
        << 0
    }

    if mode == "serve" {
        _ := signal.ignore(signal.SIGPIPE) >>> (err) {
            eprintln("signal ignore error: " + err.msg())
            << 1
        }
        $listen_addr := "127.0.0.1:8080"
        if args.len > 2 { listen_addr = args[2] }
        $srv := http.new_server()
        _ := srv.listen(listen_addr) >>> (err) {
            eprintln("listen error: " + err.msg())
            << 1
        }
        bound_addr := srv.addr()
        println("serving:http://" + bound_addr)
        req_ch := chan ServeRequest{cap: 16}
        xu serve_http_loop(srv, req_ch, api_key)
        run_serve_scheduler(req_ch, &model, &model_id, $&kv, $&row_cache,
                            $&sx, $&sxb, $&sxb2, $&sq, $&sk, $&sv,
                            $&shb, $&shb2, $&slogits, $&sxq, $&sxs,
                            top_p_milli, min_p_milli, repeat_penalty_milli,
                            presence_penalty_milli, frequency_penalty_milli,
                            seed, ignore_eos)
    }

    eprintln("unknown mode: " + mode)
    << 1
}
