@quantize

#os
#math
#strconv
#errors
#encoding/json
#tensor

const GGML_TYPE_F32 = 0
const GGML_TYPE_F16 = 1
const GGML_TYPE_Q4_0 = 2
const GGML_TYPE_Q5_0 = 6
const GGML_TYPE_Q8_0 = 8
const GGML_TYPE_Q4_K = 12
const GGML_TYPE_Q5_K = 13
const GGML_TYPE_Q6_K = 14
const GGML_TYPE_BF16 = 30
const GGML_TYPE_F8_E4M3 = 43

struct QuantGgufSpec {
    name string
    dims []int
    gtype int
    offset int
    data string
}

struct QuantSrcTensor {
    name string
    dims []int
    vals []f32
}

struct GgufSrcTensorInfo {
    name string
    dims []int
    gtype int
    n_elems int
    offset int
}

struct HfShard {
    path string
    data string
    base int
    doc json.Doc
    root int
}

fn bits(v f32) int { << math.float32_bits(f64(v)) }
fn from_bits(b int) f32 { << f32(math.float32_from_bits(b)) }

fn read_u16_le(buf &string, off int) int {
    << buf[off] | (buf[off + 1] << 8)
}

fn read_u32_le(buf &string, off int) int {
    << buf[off] | (buf[off + 1] << 8) | (buf[off + 2] << 16) | (buf[off + 3] << 24)
}

fn read_u64_le(buf &string, off int) int {
    $v := 0
    for i in 0:8 {
        v = v | (buf[off + i] << (i * 8))
    }
    << v
}

fn push_u16_le(buf $&string, val int) {
    buf.push_str(string_from_byte(val & 255))
    buf.push_str(string_from_byte((val >> 8) & 255))
}

fn push_u32_le(buf $&string, val int) {
    buf.push_str(string_from_byte(val & 255))
    buf.push_str(string_from_byte((val >> 8) & 255))
    buf.push_str(string_from_byte((val >> 16) & 255))
    buf.push_str(string_from_byte((val >> 24) & 255))
}

fn push_u64_le(buf $&string, val int) {
    for i in 0:8 {
        buf.push_str(string_from_byte((val >> (i * 8)) & 255))
    }
}

fn push_gguf_str(buf $&string, s &string) {
    push_u64_le(buf, s.len)
    if s.len > 0 { buf.push_str((*s) + "") }
}

fn push_gguf_kv_str(buf $&string, k string, v string, cnt $&int) {
    push_gguf_str(buf, &k)
    push_u32_le(buf, 8)
    push_gguf_str(buf, &v)
    *cnt += 1
}

fn push_gguf_kv_u32(buf $&string, k string, v int, cnt $&int) {
    push_gguf_str(buf, &k)
    push_u32_le(buf, 4)
    push_u32_le(buf, v)
    *cnt += 1
}

fn push_gguf_kv_f32(buf $&string, k string, v f32, cnt $&int) {
    push_gguf_str(buf, &k)
    push_u32_le(buf, 6)
    push_u32_le(buf, bits(v))
    *cnt += 1
}

fn push_gguf_kv_str_arr(buf $&string, k string, xs &[]string, cnt $&int) {
    push_gguf_str(buf, &k)
    push_u32_le(buf, 9)
    push_u32_le(buf, 8)
    push_u64_le(buf, xs.len)
    for i in 0:xs.len {
        s := xs[i] + ""
        push_gguf_str(buf, &s)
    }
    *cnt += 1
}

fn quant_round_i(v f64) int {
    if v >= 0.0 { << int(v + 0.5) }
    << -int(0.5 - v)
}

fn starts_with(s &string, prefix string) bool {
    if s.len < prefix.len { << false }
    for i in 0:prefix.len {
        if (*s)[i] != prefix[i] { << false }
    }
    << true
}

fn ends_with(s &string, suffix string) bool {
    if s.len < suffix.len { << false }
    start := s.len - suffix.len
    for i in 0:suffix.len {
        if (*s)[start + i] != suffix[i] { << false }
    }
    << true
}

fn checked_size_product(a int, b int) int {
    if a < 0 || b < 0 { >>> errors.new("negative tensor size") }
    if b > 0 && a > 9223372036854775807 / b { >>> errors.new("tensor storage size overflow") }
    << a * b
}

fn trim_ws(s &string) string {
    $l := 0
    $r := s.len
    while l < r {
        c := (*s)[l] & 255
        if c == 32 || c == 9 || c == 10 || c == 13 { l += 1 } else { <- }
    }
    while r > l {
        c := (*s)[r - 1] & 255
        if c == 32 || c == 9 || c == 10 || c == 13 { r -= 1 } else { <- }
    }
    << (*s)[l:r]
}

fn try_parse_f64_or(s &string, def f64) f64 {
    t := trim_ws(s)
    doc := json.parse(&t)
    if doc.ok() && doc.is_number(doc.root()) {
        << doc.as_f64(doc.root()) >>> (_) { << def }
    }
    << def
}

fn doc_get_or(doc &json.Doc, obj int, key string, def int) int {
    << doc.get(obj, key) >>> (_) { << def }
}

fn doc_str_or(doc &json.Doc, obj int, key string, def string) string {
    if obj < 0 || !doc.is_dict(obj) || !doc.has(obj, key) { << def }
    n := doc.get(obj, key) >>> (_) { << def }
    if doc.is_string(n) { << doc.as_string(n) >>> (_) { << def } }
    << def
}

fn doc_int_or(doc &json.Doc, obj int, key string, def int) int {
    if obj < 0 || !doc.is_dict(obj) || !doc.has(obj, key) { << def }
    n := doc.get(obj, key) >>> (_) { << def }
    if doc.is_number(n) { << doc.as_int(n) >>> (_) { << def } }
    << def
}

fn doc_f64_or(doc &json.Doc, obj int, key string, def f64) f64 {
    if obj < 0 || !doc.is_dict(obj) || !doc.has(obj, key) { << def }
    n := doc.get(obj, key) >>> (_) { << def }
    if doc.is_number(n) { << doc.as_f64(n) >>> (_) { << def } }
    << def
}

fn meta_int(doc &json.Doc, meta int, key string) int {
    s := doc.as_string(doc.get(meta, key))
    << strconv.atoi(&s) >>>
}

fn try_read_file(path string) string {
    << os.read(path) >>> (_) { << "" }
}

fn parse_layer_idx(key &string, prefix &string) int {
    if !starts_with(key, (*prefix) + "") { << -1 }
    $pos := prefix.len
    if pos >= key.len { << -1 }
    $val := 0
    $digits := 0
    while pos < key.len {
        ch := (*key)[pos] & 255
        if ch >= 48 && ch <= 57 {
            val = val * 10 + (ch - 48)
            digits += 1
            pos += 1
        } else {
            <-
        }
    }
    if digits == 0 || pos >= key.len || ((*key)[pos] & 255) != 46 { << -1 }
    << val
}

fn sf_to_gguf_name(sfk &string) string {
    $k := (*sfk) + ""
    if starts_with(&k, "model.") {
        k = k[6:k.len]
    }
    if k == "embed_tokens.weight" { << "token_embd.weight" }
    if k == "norm.weight" { << "output_norm.weight" }
    if k == "lm_head.weight" { << "output.weight" }
    if starts_with(&k, "layers.") {
        lidx := parse_layer_idx(&k, &"layers.")
        if lidx >= 0 {
            lp := "blk." + str(lidx) + "."
            if ends_with(&k, ".input_layernorm.weight") { << lp + "attn_norm.weight" }
            if ends_with(&k, ".post_attention_layernorm.weight") { << lp + "ffn_norm.weight" }
            if ends_with(&k, ".post_feedforward_layernorm.weight") { << lp + "ffn_post_norm.weight" }
            if ends_with(&k, ".self_attn.q_proj.weight") { << lp + "attn_q.weight" }
            if ends_with(&k, ".self_attn.k_proj.weight") { << lp + "attn_k.weight" }
            if ends_with(&k, ".self_attn.v_proj.weight") { << lp + "attn_v.weight" }
            if ends_with(&k, ".self_attn.o_proj.weight") { << lp + "attn_output.weight" }
            if ends_with(&k, ".self_attn.q_proj.bias") { << lp + "attn_q.bias" }
            if ends_with(&k, ".self_attn.k_proj.bias") { << lp + "attn_k.bias" }
            if ends_with(&k, ".self_attn.v_proj.bias") { << lp + "attn_v.bias" }
            if ends_with(&k, ".self_attn.q_norm.weight") { << lp + "attn_q_norm.weight" }
            if ends_with(&k, ".self_attn.k_norm.weight") { << lp + "attn_k_norm.weight" }
            if ends_with(&k, ".mlp.gate_proj.weight") { << lp + "ffn_gate.weight" }
            if ends_with(&k, ".mlp.up_proj.weight") { << lp + "ffn_up.weight" }
            if ends_with(&k, ".mlp.down_proj.weight") { << lp + "ffn_down.weight" }
        }
    }
    << k
}

pub fn quantize_f32_to_q4_0(src &[]f32) string {
    nb := src.len / 32
    $out := ""
    for b in 0:nb {
        base := b * 32
        $amax := 0.0
        for i in 0:32 {
            $av := f64(src[base + i])
            if av < 0.0 { av = -av }
            if av > amax { amax = av }
        }
        $d := 0.0
        if amax > 0.0 { d = amax / 7.0 }
        f16d := tensor.f16(f32(d))
        push_u16_le($&out, int(f16d.bits))
        d16 := f64(f16d.to_f32())
        $inv_d := 0.0
        if d16 != 0.0 { inv_d = 1.0 / d16 }
        for j in 0:16 {
            $q0 := quant_round_i(f64(src[base + j]) * inv_d) + 8
            if q0 < 0 { q0 = 0 } else if q0 > 15 { q0 = 15 }
            $q1 := quant_round_i(f64(src[base + 16 + j]) * inv_d) + 8
            if q1 < 0 { q1 = 0 } else if q1 > 15 { q1 = 15 }
            out.push_str(string_from_byte((q0 & 15) | ((q1 & 15) << 4)))
        }
    }
    << out
}

pub fn quantize_f32_to_q8_0(src &[]f32) string {
    nb := src.len / 32
    $out := ""
    for b in 0:nb {
        base := b * 32
        $amax := 0.0
        for i in 0:32 {
            $av := f64(src[base + i])
            if av < 0.0 { av = -av }
            if av > amax { amax = av }
        }
        $d := 0.0
        if amax > 0.0 { d = amax / 127.0 }
        f16d := tensor.f16(f32(d))
        push_u16_le($&out, int(f16d.bits))
        d16 := f64(f16d.to_f32())
        $inv_d := 0.0
        if d16 != 0.0 { inv_d = 1.0 / d16 }
        for i in 0:32 {
            $q := quant_round_i(f64(src[base + i]) * inv_d)
            if q > 127 { q = 127 } else if q < -127 { q = -127 }
            out.push_str(string_from_byte(q & 255))
        }
    }
    << out
}

fn pack_k_scales_q4_q5(src &[]f32, base int, qmax f64, out $&string,
                       d_eff_out $&f64, dm_eff_out $&f64,
                       qsc $&[]int, qmn $&[]int) {
    $sc_f := []f64{}
    $mn_f := []f64{}
    $max_sc := 0.0
    $max_mn := 0.0
    for j in 0:8 {
        $vmin := f64(src[base + j * 32])
        $vmax := vmin
        for l in 1:32 {
            v := f64(src[base + j * 32 + l])
            if v < vmin { vmin = v }
            if v > vmax { vmax = v }
        }
        $mneg := 0.0
        if vmin < 0.0 { mneg = -vmin }
        sc := (vmax + mneg) / qmax
        sc_f.push(sc)
        mn_f.push(mneg)
        if sc > max_sc { max_sc = sc }
        if mneg > max_mn { max_mn = mneg }
    }
    $df := 0.0
    if max_sc > 0.0 { df = max_sc / 63.0 }
    $dmf := 0.0
    if max_mn > 0.0 { dmf = max_mn / 63.0 }
    f16d := tensor.f16(f32(df))
    f16dm := tensor.f16(f32(dmf))
    push_u16_le(out, int(f16d.bits))
    push_u16_le(out, int(f16dm.bits))
    d_eff := f64(f16d.to_f32())
    dm_eff := f64(f16dm.to_f32())
    *d_eff_out = d_eff
    *dm_eff_out = dm_eff
    $inv_d := 0.0
    if d_eff > 0.0 { inv_d = 1.0 / d_eff }
    $inv_dm := 0.0
    if dm_eff > 0.0 { inv_dm = 1.0 / dm_eff }
    for j in 0:8 {
        $qs := 0
        if d_eff > 0.0 { qs = quant_round_i(sc_f[j] * inv_d) }
        if qs < 0 { qs = 0 } else if qs > 63 { qs = 63 }
        $qm := 0
        if dm_eff > 0.0 { qm = quant_round_i(mn_f[j] * inv_dm) }
        if qm < 0 { qm = 0 } else if qm > 63 { qm = 63 }
        qsc.push(qs)
        qmn.push(qm)
    }
    $scales := []int{}
    for _ in 0:12 { scales.push(0) }
    for j in 0:4 {
        scales[j] = qsc[j] & 63
        scales[j + 4] = qmn[j] & 63
    }
    for j in 4:8 {
        scales[j + 4] = (qsc[j] & 15) | ((qmn[j] & 15) << 4)
        scales[j - 4] = scales[j - 4] | ((qsc[j] >> 4) << 6)
        scales[j] = scales[j] | ((qmn[j] >> 4) << 6)
    }
    for si in 0:12 {
        out.push_str(string_from_byte(scales[si] & 255))
    }
}

pub fn quantize_f32_to_q4_k(src &[]f32) string {
    nb := src.len / tensor.QK_K
    $out := ""
    for b in 0:nb {
        base := b * tensor.QK_K
        $d_eff := 0.0
        $dm_eff := 0.0
        $qsc := []int{}
        $qmn := []int{}
        pack_k_scales_q4_q5(src, base, 15.0, $&out, $&d_eff, $&dm_eff, $&qsc, $&qmn)
        for chunk in 0:4 {
            j0 := chunk * 2
            j1 := j0 + 1
            eff_s0 := d_eff * f64(qsc[j0])
            eff_m0 := dm_eff * f64(qmn[j0])
            eff_s1 := d_eff * f64(qsc[j1])
            eff_m1 := dm_eff * f64(qmn[j1])
            $inv_s0 := 0.0
            if eff_s0 > 0.0 { inv_s0 = 1.0 / eff_s0 }
            $inv_s1 := 0.0
            if eff_s1 > 0.0 { inv_s1 = 1.0 / eff_s1 }
            b0 := base + j0 * 32
            b1 := base + j1 * 32
            for l in 0:32 {
                $q0 := 0
                if eff_s0 > 0.0 { q0 = quant_round_i((f64(src[b0 + l]) + eff_m0) * inv_s0) }
                if q0 < 0 { q0 = 0 } else if q0 > 15 { q0 = 15 }
                $q1 := 0
                if eff_s1 > 0.0 { q1 = quant_round_i((f64(src[b1 + l]) + eff_m1) * inv_s1) }
                if q1 < 0 { q1 = 0 } else if q1 > 15 { q1 = 15 }
                out.push_str(string_from_byte((q0 & 15) | ((q1 & 15) << 4)))
            }
        }
    }
    << out
}

pub fn quantize_f32_to_q5_k(src &[]f32) string {
    nb := src.len / tensor.QK_K
    $out := ""
    for b in 0:nb {
        base := b * tensor.QK_K
        $d_eff := 0.0
        $dm_eff := 0.0
        $qsc := []int{}
        $qmn := []int{}
        pack_k_scales_q4_q5(src, base, 31.0, $&out, $&d_eff, $&dm_eff, $&qsc, $&qmn)
        $qh := []int{}
        for _ in 0:32 { qh.push(0) }
        $qs := []int{}
        for _ in 0:128 { qs.push(0) }
        for chunk in 0:4 {
            j0 := chunk * 2
            j1 := j0 + 1
            eff_s0 := d_eff * f64(qsc[j0])
            eff_m0 := dm_eff * f64(qmn[j0])
            eff_s1 := d_eff * f64(qsc[j1])
            eff_m1 := dm_eff * f64(qmn[j1])
            $inv_s0 := 0.0
            if eff_s0 > 0.0 { inv_s0 = 1.0 / eff_s0 }
            $inv_s1 := 0.0
            if eff_s1 > 0.0 { inv_s1 = 1.0 / eff_s1 }
            b0 := base + j0 * 32
            b1 := base + j1 * 32
            sh_lo := chunk * 2
            sh_hi := sh_lo + 1
            for l in 0:32 {
                $q0 := 0
                if eff_s0 > 0.0 { q0 = quant_round_i((f64(src[b0 + l]) + eff_m0) * inv_s0) }
                if q0 < 0 { q0 = 0 } else if q0 > 31 { q0 = 31 }
                $q1 := 0
                if eff_s1 > 0.0 { q1 = quant_round_i((f64(src[b1 + l]) + eff_m1) * inv_s1) }
                if q1 < 0 { q1 = 0 } else if q1 > 31 { q1 = 31 }
                qs[chunk * 32 + l] = (q0 & 15) | ((q1 & 15) << 4)
                if (q0 & 16) != 0 { qh[l] = qh[l] | (1 << sh_lo) }
                if (q1 & 16) != 0 { qh[l] = qh[l] | (1 << sh_hi) }
            }
        }
        for i in 0:32 { out.push_str(string_from_byte(qh[i] & 255)) }
        for i in 0:128 { out.push_str(string_from_byte(qs[i] & 255)) }
    }
    << out
}

pub fn quantize_f32_to_q6_k(src &[]f32) string {
    nb := src.len / tensor.QK_K
    $out := ""
    for b in 0:nb {
        base := b * tensor.QK_K
        $amax_subs := []f64{}
        $max_sub := 0.0
        for s in 0:16 {
            $amax := 0.0
            sb := base + s * 16
            for i in 0:16 {
                $av := f64(src[sb + i])
                if av < 0.0 { av = -av }
                if av > amax { amax = av }
            }
            amax_subs.push(amax)
            if amax > max_sub { max_sub = amax }
        }
        $d := 0.0
        if max_sub > 0.0 { d = max_sub / (31.0 * 127.0) }
        f16d := tensor.f16(f32(d))
        d16 := f64(f16d.to_f32())
        $sc_q := []int{}
        for s in 0:16 {
            $qsc := 0
            if d16 > 0.0 && amax_subs[s] > 0.0 {
                qsc = quant_round_i(amax_subs[s] / (31.0 * d16))
                if qsc < 1 { qsc = 1 } else if qsc > 127 { qsc = 127 }
            }
            sc_q.push(qsc)
        }
        $ql := []int{}
        for _ in 0:128 { ql.push(0) }
        $qh := []int{}
        for _ in 0:64 { qh.push(0) }
        for h in 0:2 {
            y_off := base + h * 128
            ql_off := h * 64
            qh_off := h * 32
            sc_off := h * 8
            for l in 0:32 {
                is_idx := l / 16
                sc1 := d16 * f64(sc_q[sc_off + is_idx])
                sc2 := d16 * f64(sc_q[sc_off + is_idx + 2])
                sc3 := d16 * f64(sc_q[sc_off + is_idx + 4])
                sc4 := d16 * f64(sc_q[sc_off + is_idx + 6])
                $q1 := 0
                if sc1 != 0.0 { q1 = quant_round_i(f64(src[y_off + l]) / sc1) }
                if q1 < -32 { q1 = -32 } else if q1 > 31 { q1 = 31 }
                $q2 := 0
                if sc2 != 0.0 { q2 = quant_round_i(f64(src[y_off + l + 32]) / sc2) }
                if q2 < -32 { q2 = -32 } else if q2 > 31 { q2 = 31 }
                $q3 := 0
                if sc3 != 0.0 { q3 = quant_round_i(f64(src[y_off + l + 64]) / sc3) }
                if q3 < -32 { q3 = -32 } else if q3 > 31 { q3 = 31 }
                $q4 := 0
                if sc4 != 0.0 { q4 = quant_round_i(f64(src[y_off + l + 96]) / sc4) }
                if q4 < -32 { q4 = -32 } else if q4 > 31 { q4 = 31 }
                u1 := q1 + 32
                u2 := q2 + 32
                u3 := q3 + 32
                u4 := q4 + 32
                ql[ql_off + l] = (u1 & 15) | ((u3 & 15) << 4)
                ql[ql_off + l + 32] = (u2 & 15) | ((u4 & 15) << 4)
                qh[qh_off + l] = ((u1 >> 4) & 3) | (((u2 >> 4) & 3) << 2) |
                                 (((u3 >> 4) & 3) << 4) | (((u4 >> 4) & 3) << 6)
            }
        }
        for i in 0:128 { out.push_str(string_from_byte(ql[i] & 255)) }
        for i in 0:64 { out.push_str(string_from_byte(qh[i] & 255)) }
        for s in 0:16 { out.push_str(string_from_byte(sc_q[s] & 255)) }
        push_u16_le($&out, int(f16d.bits))
    }
    << out
}

fn encode_f32_bytes(src &[]f32) string {
    $out := ""
    for i in 0:src.len {
        push_u32_le($&out, bits(src[i]))
    }
    << out
}

fn decode_safetensor_f32(raw &string, base int, entry int, doc &json.Doc, dims_ggml $&[]int) []f32 {
    dt_s := doc_str_or(doc, entry, "dtype", "")
    dtype := tensor.safetensors_dtype(&dt_s) >>>
    sh_n := doc_get_or(doc, entry, "shape", -1)
    if sh_n < 0 || !doc.is_list(sh_n) { >>> errors.new("quantize: invalid safetensors shape") }
    nd := doc.count(sh_n)
    $pt_shape := []int{}
    $n_elems := 1
    for i in 0:nd {
        dv := doc.as_int(doc.at(sh_n, i) >>>) >>>
        pt_shape.push(dv)
        n_elems = checked_size_product(n_elems, dv) >>>
    }
    $di := nd - 1
    while di >= 0 {
        dims_ggml.push(pt_shape[di])
        di -= 1
    }
    offs := doc_get_or(doc, entry, "data_offsets", -1)
    if offs < 0 || !doc.is_list(offs) || doc.count(offs) != 2 {
        >>> errors.new("quantize: invalid data_offsets")
    }
    start := base + (doc.as_int(doc.at(offs, 0) >>>) >>>)
    stop := base + (doc.as_int(doc.at(offs, 1) >>>) >>>)
    if start < base || stop < start || stop > raw.len {
        >>> errors.new("quantize: tensor offsets out of range")
    }
    view := tensor.contiguous_view(dtype, &pt_shape, start, stop) >>>
    if view.storage_end() != stop {
        >>> errors.new("quantize: tensor byte length mismatch")
    }
    $vals := []f32{}
    if n_elems > 0 { vals.reserve(n_elems) }
    if dtype.is_f32() {
        for i in 0:n_elems {
            vals.push(from_bits(read_u32_le(raw, start + i * 4)))
        }
    } else {
        _ := view.append_f32(raw, $&vals) >>>
    }
    << vals
}

fn open_hf_shard(path &string) HfShard {
    data := os.read((*path) + "") >>>
    if data.len < 8 { >>> errors.new("quantize: truncated safetensors shard: " + (*path)) }
    hlen := read_u64_le(&data, 0)
    if hlen <= 0 || hlen > data.len - 8 { >>> errors.new("quantize: invalid safetensors header: " + (*path)) }
    hstr := data[8:(8 + hlen)]
    doc := json.parse(&hstr)
    if !doc.ok() || !doc.is_dict(doc.root()) { >>> errors.new("quantize: invalid safetensors JSON: " + (*path)) }
    << HfShard{path: (*path) + "", data: ~data, base: 8 + hlen, doc: ~doc, root: doc.root()}
}

fn ensure_hf_shard(dir &string, shard_name &string, shards $&[]HfShard, file_to_idx $&map[string]int) int {
    existing := file_to_idx.get_or(*shard_name, -1)
    if existing >= 0 { << existing }
    fp := (*dir) + "/" + (*shard_name)
    sh := open_hf_shard(&fp) >>>
    idx := shards.len
    shards.push(~sh)
    file_to_idx[(*shard_name) + ""] = idx
    << idx
}

fn load_hf_vocab(dir &string, vocab_cap int, vocab $&[]string, merges $&[]string,
                 tok_model $&string, chat_tmpl $&string) {
    tc_raw := try_read_file((*dir) + "/tokenizer_config.json")
    if tc_raw.len > 0 {
        tcdoc := json.parse(&tc_raw)
        if tcdoc.ok() && tcdoc.is_dict(tcdoc.root()) {
            ct := doc_str_or(&tcdoc, tcdoc.root(), "chat_template", "")
            if ct.len > 0 { *chat_tmpl = ct }
        }
    }
    tok_raw := try_read_file((*dir) + "/tokenizer.json")
    if tok_raw.len == 0 {
        for vi in 0:vocab_cap {
            $piece := "t" + str(vi)
            if vi == 0 { piece = "<unk>" }
            else if vi == 1 { piece = "<s>" }
            else if vi == 2 { piece = "</s>" }
            vocab.push(piece)
        }
        <<
    }
    doc := json.parse(&tok_raw)
    if !doc.ok() || !doc.is_dict(doc.root()) { << }
    root := doc.root()
    $ep := []string{}
    $eid := []int{}
    $max_id := vocab_cap - 1
    if doc.has(root, "model") {
        mn := doc.get(root, "model") >>> (_) { << }
        if doc.is_dict(mn) && doc.has(mn, "vocab") {
            vn := doc.get(mn, "vocab") >>> (_) { << }
            if doc.is_dict(vn) {
                vkeys := doc.dict_keys(vn)
                for ki in 0:vkeys.len {
                    k := vkeys[ki]
                    tid := doc_int_or(&doc, vn, k + "", -1)
                    if tid >= 0 {
                        ep.push(k + "")
                        eid.push(tid)
                        if tid > max_id { max_id = tid }
                    }
                }
            }
        }
        if doc.is_dict(mn) && doc.has(mn, "merges") {
            mg := doc.get(mn, "merges") >>> (_) { << }
            if doc.is_list(mg) {
                mc := doc.count(mg)
                for mi in 0:mc {
                    item := doc.at(mg, mi) >>> (_) { -> }
                    $mstr := ""
                    if doc.is_string(item) {
                        mstr = doc.as_string(item) >>> (_) { -> }
                    } else if doc.is_list(item) && doc.count(item) == 2 {
                        p0n := doc.at(item, 0) >>> (_) { -> }
                        p1n := doc.at(item, 1) >>> (_) { -> }
                        if doc.is_string(p0n) && doc.is_string(p1n) {
                            a := doc.as_string(p0n) >>> (_) { -> }
                            b := doc.as_string(p1n) >>> (_) { -> }
                            mstr = a + " " + b
                        }
                    }
                    if mstr.len > 0 { merges.push(mstr) }
                }
            }
        }
    }
    if doc.has(root, "added_tokens") {
        at := doc.get(root, "added_tokens") >>> (_) { << }
        if doc.is_list(at) {
            ac := doc.count(at)
            for ai in 0:ac {
                item := doc.at(at, ai) >>> (_) { -> }
                if !doc.is_dict(item) { -> }
                tid := doc_int_or(&doc, item, "id", -1)
                cstr := doc_str_or(&doc, item, "content", "")
                if tid >= 0 && cstr.len > 0 {
                    ep.push(cstr)
                    eid.push(tid)
                    if tid > max_id { max_id = tid }
                }
            }
        }
    }
    need_len := max_id + 1
    for _ in 0:need_len { vocab.push("") }
    for i in 0:ep.len {
        tid := eid[i]
        piece := &ep[i]
        if tid >= 0 && tid < need_len {
            vocab[tid] = (*piece) + ""
            if piece.len >= 2 && (piece[0] & 255) == 196 && (piece[1] & 255) == 160 {
                *tok_model = "gpt2"
            }
        }
    }
}

fn ensure_hdr(f &os.File, hdr $&string, end int) int {
    while hdr.len < end {
        $want := end - hdr.len
        if want < 1048576 { want = 1048576 }
        chunk := f.read(want) >>>
        if chunk.len <= 0 { >>> errors.new("quantize: truncated GGUF header") }
        hdr.push_str(chunk)
    }
    << 0
}

fn read_gguf_str(f &os.File, hdr $&string, pos $&int) string {
    p := *pos
    _ := ensure_hdr(f, hdr, p + 8) >>>
    slen := read_u64_le(hdr, p)
    if slen < 0 { >>> errors.new("quantize: invalid GGUF string length") }
    _ := ensure_hdr(f, hdr, p + 8 + slen) >>>
    *pos = p + 8 + slen
    << (*hdr)[p + 8:p + 8 + slen]
}

fn read_gguf_int(f &os.File, hdr $&string, vtype int, pos $&int) int {
    p := *pos
    if vtype == 0 {
        _ := ensure_hdr(f, hdr, p + 1) >>>
        *pos = p + 1
        << (*hdr)[p] & 255
    } else if vtype == 1 {
        _ := ensure_hdr(f, hdr, p + 1) >>>
        *pos = p + 1
        $v := (*hdr)[p] & 255
        if v >= 128 { v -= 256 }
        << v
    } else if vtype == 2 {
        _ := ensure_hdr(f, hdr, p + 2) >>>
        *pos = p + 2
        << read_u16_le(hdr, p)
    } else if vtype == 3 {
        _ := ensure_hdr(f, hdr, p + 2) >>>
        *pos = p + 2
        $v := read_u16_le(hdr, p)
        if v >= 32768 { v -= 65536 }
        << v
    } else if vtype == 4 {
        _ := ensure_hdr(f, hdr, p + 4) >>>
        *pos = p + 4
        << read_u32_le(hdr, p)
    } else if vtype == 5 {
        _ := ensure_hdr(f, hdr, p + 4) >>>
        *pos = p + 4
        $v := read_u32_le(hdr, p)
        if v >= 0x80000000 { v -= 0x100000000 }
        << v
    } else if vtype == 10 || vtype == 11 {
        _ := ensure_hdr(f, hdr, p + 8) >>>
        *pos = p + 8
        << read_u64_le(hdr, p)
    }
    >>> errors.new("quantize: unexpected GGUF integer metadata type")
}

fn skip_gguf_val(f &os.File, hdr $&string, vtype int, pos $&int) int {
    if vtype == 0 || vtype == 1 || vtype == 7 {
        _ := ensure_hdr(f, hdr, *pos + 1) >>>
        *pos = *pos + 1
    } else if vtype == 2 || vtype == 3 {
        _ := ensure_hdr(f, hdr, *pos + 2) >>>
        *pos = *pos + 2
    } else if vtype == 4 || vtype == 5 || vtype == 6 {
        _ := ensure_hdr(f, hdr, *pos + 4) >>>
        *pos = *pos + 4
    } else if vtype == 10 || vtype == 11 || vtype == 12 {
        _ := ensure_hdr(f, hdr, *pos + 8) >>>
        *pos = *pos + 8
    } else if vtype == 8 {
        _ := read_gguf_str(f, hdr, pos) >>>
    } else if vtype == 9 {
        _ := ensure_hdr(f, hdr, *pos + 12) >>>
        etype := read_u32_le(hdr, *pos)
        cnt := read_u64_le(hdr, *pos + 4)
        *pos = *pos + 12
        for _ in 0:cnt {
            _ := skip_gguf_val(f, hdr, etype, pos) >>>
        }
    } else {
        >>> errors.new("quantize: unsupported GGUF metadata type: " + str(vtype))
    }
    << 0
}

fn read_exact(f &os.File, n int) string {
    if n <= 0 { << "" }
    $out := f.read(n) >>>
    if out.len <= 0 { >>> errors.new("quantize: unexpected EOF reading GGUF") }
    while out.len < n {
        ch := f.read(n - out.len) >>>
        if ch.len <= 0 { >>> errors.new("quantize: unexpected EOF reading GGUF") }
        out.push_str(ch)
    }
    << out
}

fn read_gguf_tensor_as_f32(f &os.File, data_base int, info &GgufSrcTensorInfo) []f32 {
    expected := info.n_elems
    _ := f.seek(data_base + info.offset, os.SEEK_SET) >>>
    $out := []f32{}
    if expected > 0 { out.reserve(expected) }
    gt := info.gtype
    if gt == GGML_TYPE_Q4_0 || gt == GGML_TYPE_Q5_0 || gt == GGML_TYPE_Q8_0 {
        blocks := expected / tensor.GGML_BLOCK_VALUES
        if gt == GGML_TYPE_Q4_0 {
            chunk := read_exact(f, checked_size_product(blocks, tensor.Q4_0_BYTES) >>>) >>>
            for i in 0:blocks {
                blk := tensor.read_q4_0(&chunk, i * tensor.Q4_0_BYTES) >>>
                blk.append_f32($&out)
            }
        } else if gt == GGML_TYPE_Q5_0 {
            chunk := read_exact(f, checked_size_product(blocks, tensor.Q5_0_BYTES) >>>) >>>
            for i in 0:blocks {
                blk := tensor.read_q5_0(&chunk, i * tensor.Q5_0_BYTES) >>>
                blk.append_f32($&out)
            }
        } else {
            chunk := read_exact(f, checked_size_product(blocks, tensor.Q8_0_BYTES) >>>) >>>
            for i in 0:blocks {
                blk := tensor.read_q8_0(&chunk, i * tensor.Q8_0_BYTES) >>>
                blk.append_f32($&out)
            }
        }
        << out
    }
    if gt == GGML_TYPE_Q4_K || gt == GGML_TYPE_Q5_K || gt == GGML_TYPE_Q6_K {
        blocks := expected / tensor.QK_K
        if gt == GGML_TYPE_Q4_K {
            chunk := read_exact(f, checked_size_product(blocks, tensor.Q4_K_BYTES) >>>) >>>
            for i in 0:blocks {
                blk := tensor.read_q4_k(&chunk, i * tensor.Q4_K_BYTES) >>>
                blk.append_f32($&out)
            }
        } else if gt == GGML_TYPE_Q5_K {
            chunk := read_exact(f, checked_size_product(blocks, tensor.Q5_K_BYTES) >>>) >>>
            for i in 0:blocks {
                blk := tensor.read_q5_k(&chunk, i * tensor.Q5_K_BYTES) >>>
                blk.append_f32($&out)
            }
        } else {
            chunk := read_exact(f, checked_size_product(blocks, tensor.Q6_K_BYTES) >>>) >>>
            for i in 0:blocks {
                blk := tensor.read_q6_k(&chunk, i * tensor.Q6_K_BYTES) >>>
                blk.append_f32($&out)
            }
        }
        << out
    }
    $dtype := tensor.dtype_f32()
    if gt == GGML_TYPE_F16 { dtype = tensor.dtype_f16() }
    else if gt == GGML_TYPE_BF16 { dtype = tensor.dtype_bf16() }
    else if gt == GGML_TYPE_F8_E4M3 { dtype = tensor.dtype_fp8_e4m3fn() }
    else if gt != GGML_TYPE_F32 { >>> errors.new("quantize: unsupported GGUF tensor type " + str(gt)) }
    chunk := read_exact(f, checked_size_product(expected, dtype.element_bytes()) >>>) >>>
    if dtype.is_f32() {
        for i in 0:expected { out.push(from_bits(read_u32_le(&chunk, i * 4))) }
    } else {
        sh := [expected]
        view := tensor.contiguous_view(dtype, &sh, 0, chunk.len) >>>
        _ := view.append_f32(&chunk, $&out) >>>
    }
    << out
}

fn ascii_lower(s &string) string {
    $out := ""
    for i in 0:s.len {
        ch := (*s)[i] & 255
        if ch >= 65 && ch <= 90 { out.push_str(string_from_byte(ch + 32)) }
        else { out.push_str(string_from_byte(ch)) }
    }
    << out
}

fn choose_tensor_qtype(gname &string, nd int, cols int, mode &string) int {
    if nd != 2 || *gname == "token_embd.weight" { << GGML_TYPE_F32 }
    if *mode == "q4_0" {
        if cols % 32 == 0 { << GGML_TYPE_Q4_0 }
        << GGML_TYPE_F32
    }
    if *mode == "q8_0" {
        if cols % 32 == 0 { << GGML_TYPE_Q8_0 }
        << GGML_TYPE_F32
    }
    if *mode == "q4_k" || *mode == "q5_k" || *mode == "q6_k" {
        if cols % 256 == 0 {
            if *mode == "q4_k" { << GGML_TYPE_Q4_K }
            if *mode == "q5_k" { << GGML_TYPE_Q5_K }
            << GGML_TYPE_Q6_K
        }
        if cols % 32 == 0 { << GGML_TYPE_Q8_0 }
        << GGML_TYPE_F32
    }
    if *mode == "q4_k_m" || *mode == "q5_k_m" {
        if cols % 256 == 0 {
            is_hi := *gname == "output.weight" ||
                     ends_with(gname, "attn_v.weight") ||
                     ends_with(gname, "ffn_down.weight") ||
                     ends_with(gname, "ffn_down_exps.weight") ||
                     ends_with(gname, "ffn_down_shexp.weight")
            if is_hi { << GGML_TYPE_Q6_K }
            if *mode == "q5_k_m" { << GGML_TYPE_Q5_K }
            << GGML_TYPE_Q4_K
        }
        if cols % 32 == 0 { << GGML_TYPE_Q8_0 }
        << GGML_TYPE_F32
    }
    << GGML_TYPE_F32
}

fn encode_tensor_for_qtype(vals &[]f32, qtype int) string {
    if qtype == GGML_TYPE_Q4_0 { << quantize_f32_to_q4_0(vals) }
    if qtype == GGML_TYPE_Q8_0 { << quantize_f32_to_q8_0(vals) }
    if qtype == GGML_TYPE_Q4_K { << quantize_f32_to_q4_k(vals) }
    if qtype == GGML_TYPE_Q5_K { << quantize_f32_to_q5_k(vals) }
    if qtype == GGML_TYPE_Q6_K { << quantize_f32_to_q6_k(vals) }
    << encode_f32_bytes(vals)
}

pub fn run_quantize_cmd(in_path &string, out_path &string, qtype_str &string) int {
    $qmode := ascii_lower(qtype_str)
    if qmode.len == 0 { qmode = "q4_0" }
    if qmode != "q4_0" && qmode != "q8_0" && qmode != "q4_k" && qmode != "q5_k" &&
       qmode != "q6_k" && qmode != "q4_k_m" && qmode != "q5_k_m" {
        >>> errors.new("quantize supports --type q4_0|q8_0|q4_k|q5_k|q6_k|q4_k_m|q5_k_m (got: " + (*qtype_str) + ")")
    }

    $arch := "llama"
    $dim := 0
    $hidden_dim := 0
    $n_layers := 0
    $n_heads := 0
    $n_kv_heads := 0
    $vocab_size := 0
    $max_seq_len := 2048
    $rope_theta := 10000.0
    $rms_eps := 0.00001
    $bos_id := 1
    $eos_id := 2
    $tok_model := ""
    $chat_tmpl := ""
    $vocab := []string{}
    $merges := []string{}
    $src_tensors := []QuantSrcTensor{}
    $src_fmt := "safetensors"

    if os.is_dir((*in_path) + "") {
        src_fmt = "hf_dir"
        cfg_raw := os.read((*in_path) + "/config.json") >>>
        cdoc := json.parse(&cfg_raw)
        if !cdoc.ok() || !cdoc.is_dict(cdoc.root()) {
            >>> errors.new("quantize: invalid HF config.json")
        }
        cr := cdoc.root()
        $mtype := doc_str_or(&cdoc, cr, "model_type", "llama")
        if mtype.len > 0 { arch = mtype }
        dim = doc_int_or(&cdoc, cr, "hidden_size", 0)
        hidden_dim = doc_int_or(&cdoc, cr, "intermediate_size", 0)
        n_layers = doc_int_or(&cdoc, cr, "num_hidden_layers", 0)
        n_heads = doc_int_or(&cdoc, cr, "num_attention_heads", 0)
        n_kv_heads = doc_int_or(&cdoc, cr, "num_key_value_heads", n_heads)
        vocab_size = doc_int_or(&cdoc, cr, "vocab_size", 0)
        max_seq_len = doc_int_or(&cdoc, cr, "max_position_embeddings", 2048)
        rope_theta = doc_f64_or(&cdoc, cr, "rope_theta", 10000.0)
        rms_eps = doc_f64_or(&cdoc, cr, "rms_norm_eps", 0.00001)
        bos_id = doc_int_or(&cdoc, cr, "bos_token_id", 1)
        if cdoc.has(cr, "eos_token_id") {
            en := cdoc.get(cr, "eos_token_id") >>>
            if cdoc.is_number(en) { eos_id = cdoc.as_int(en) >>> }
            else if cdoc.is_list(en) && cdoc.count(en) > 0 {
                e0 := cdoc.at(en, 0) >>>
                if cdoc.is_number(e0) { eos_id = cdoc.as_int(e0) >>> }
            }
        }
        if dim <= 0 || hidden_dim <= 0 || n_layers <= 0 || n_heads <= 0 || vocab_size <= 0 {
            >>> errors.new("quantize: incomplete HF config.json dimensions")
        }
        load_hf_vocab(in_path, vocab_size, $&vocab, $&merges, $&tok_model, $&chat_tmpl)

        $shards := []HfShard{}
        $file_to_idx := map[string]int{}
        idx_raw := try_read_file((*in_path) + "/model.safetensors.index.json")
        if idx_raw.len > 0 {
            idoc := json.parse(&idx_raw)
            if !idoc.ok() || !idoc.is_dict(idoc.root()) { >>> errors.new("quantize: invalid model.safetensors.index.json") }
            wn := doc_get_or(&idoc, idoc.root(), "weight_map", -1)
            if wn < 0 || !idoc.is_dict(wn) { >>> errors.new("quantize: index missing weight_map") }
            wkeys := idoc.dict_keys(wn)
            for ki in 0:wkeys.len {
                tk := wkeys[ki] + ""
                sf := doc_str_or(&idoc, wn, tk + "", "")
                if sf.len == 0 { -> }
                si := ensure_hf_shard(in_path, &sf, $&shards, $&file_to_idx) >>>
                sh := &shards[si]
                if !sh.doc.has(sh.root, tk + "") {
                    >>> errors.new("quantize: shard missing tensor " + tk)
                }
                entry := sh.doc.get(sh.root, tk + "")
                $dims_g := []int{}
                vals := decode_safetensor_f32(&sh.data, sh.base, entry, &sh.doc, $&dims_g) >>>
                src_tensors.push(QuantSrcTensor{name: sf_to_gguf_name(&tk), dims: ~dims_g, vals: ~vals})
            }
        } else {
            s0 := open_hf_shard(&((*in_path) + "/model.safetensors")) >>>
            keys := s0.doc.dict_keys(s0.root)
            for ki in 0:keys.len {
                k := keys[ki] + ""
                if k == "__metadata__" { -> }
                entry := s0.doc.get(s0.root, k + "")
                $dims_g := []int{}
                vals := decode_safetensor_f32(&s0.data, s0.base, entry, &s0.doc, $&dims_g) >>>
                src_tensors.push(QuantSrcTensor{name: sf_to_gguf_name(&k), dims: ~dims_g, vals: ~vals})
            }
        }
    } else {
        $f := os.open((*in_path) + "") >>>
        head4 := f.read(4) >>>
        is_gguf := head4 == "GGUF"
        if is_gguf {
            src_fmt = "gguf"
            _ := f.seek(0, os.SEEK_SET) >>>
            $hdr := ""
            _ := ensure_hdr(&f, $&hdr, 24) >>>
            ver := read_u32_le(&hdr, 4)
            if ver != 2 && ver != 3 { >>> errors.new("quantize: unsupported GGUF version " + str(ver)) }
            tensor_count := read_u64_le(&hdr, 8)
            kv_count := read_u64_le(&hdr, 16)
            $pos := 24
            $alignment := 32
            for _ in 0:kv_count {
                key := read_gguf_str(&f, $&hdr, $&pos) >>>
                _ := ensure_hdr(&f, $&hdr, pos + 4) >>>
                vtype := read_u32_le(&hdr, pos)
                pos += 4
                if key == "general.architecture" && vtype == 8 {
                    arch = read_gguf_str(&f, $&hdr, $&pos) >>>
                } else if ends_with(&key, ".embedding_length") {
                    dim = read_gguf_int(&f, $&hdr, vtype, $&pos) >>>
                } else if ends_with(&key, ".feed_forward_length") {
                    hidden_dim = read_gguf_int(&f, $&hdr, vtype, $&pos) >>>
                } else if ends_with(&key, ".block_count") {
                    n_layers = read_gguf_int(&f, $&hdr, vtype, $&pos) >>>
                } else if ends_with(&key, ".attention.head_count") {
                    n_heads = read_gguf_int(&f, $&hdr, vtype, $&pos) >>>
                } else if ends_with(&key, ".attention.head_count_kv") {
                    n_kv_heads = read_gguf_int(&f, $&hdr, vtype, $&pos) >>>
                } else if ends_with(&key, ".context_length") {
                    max_seq_len = read_gguf_int(&f, $&hdr, vtype, $&pos) >>>
                } else if ends_with(&key, ".rope.freq_base") && vtype == 6 {
                    _ := ensure_hdr(&f, $&hdr, pos + 4) >>>
                    rope_theta = f64(from_bits(read_u32_le(&hdr, pos)))
                    pos += 4
                } else if ends_with(&key, ".attention.layer_norm_rms_epsilon") && vtype == 6 {
                    _ := ensure_hdr(&f, $&hdr, pos + 4) >>>
                    rms_eps = f64(from_bits(read_u32_le(&hdr, pos)))
                    pos += 4
                } else if key == "general.alignment" {
                    alignment = read_gguf_int(&f, $&hdr, vtype, $&pos) >>>
                    if alignment <= 0 { alignment = 32 }
                } else if key == "tokenizer.ggml.bos_token_id" {
                    bos_id = read_gguf_int(&f, $&hdr, vtype, $&pos) >>>
                } else if key == "tokenizer.ggml.eos_token_id" {
                    eos_id = read_gguf_int(&f, $&hdr, vtype, $&pos) >>>
                } else if key == "tokenizer.ggml.model" && vtype == 8 {
                    tok_model = read_gguf_str(&f, $&hdr, $&pos) >>>
                } else if key == "tokenizer.chat_template" && vtype == 8 {
                    chat_tmpl = read_gguf_str(&f, $&hdr, $&pos) >>>
                } else if key == "tokenizer.ggml.tokens" && vtype == 9 {
                    _ := ensure_hdr(&f, $&hdr, pos + 12) >>>
                    et := read_u32_le(&hdr, pos)
                    cnt := read_u64_le(&hdr, pos + 4)
                    pos += 12
                    if et != 8 { >>> errors.new("quantize: tokens array not strings") }
                    for _ in 0:cnt { vocab.push(read_gguf_str(&f, $&hdr, $&pos) >>>) }
                } else if key == "tokenizer.ggml.merges" && vtype == 9 {
                    _ := ensure_hdr(&f, $&hdr, pos + 12) >>>
                    et := read_u32_le(&hdr, pos)
                    cnt := read_u64_le(&hdr, pos + 4)
                    pos += 12
                    if et != 8 { >>> errors.new("quantize: merges array not strings") }
                    for _ in 0:cnt { merges.push(read_gguf_str(&f, $&hdr, $&pos) >>>) }
                } else {
                    _ := skip_gguf_val(&f, $&hdr, vtype, $&pos) >>>
                }
            }
            $tinfos := []GgufSrcTensorInfo{}
            for _ in 0:tensor_count {
                tname := read_gguf_str(&f, $&hdr, $&pos) >>>
                _ := ensure_hdr(&f, $&hdr, pos + 4) >>>
                n_dims := read_u32_le(&hdr, pos)
                pos += 4
                $dims_g := []int{}
                $n_elems := 1
                $last_d := 0
                for _ in 0:n_dims {
                    _ := ensure_hdr(&f, $&hdr, pos + 8) >>>
                    dv := read_u64_le(&hdr, pos)
                    pos += 8
                    dims_g.push(dv)
                    n_elems = checked_size_product(n_elems, dv) >>>
                    last_d = dv
                }
                _ := ensure_hdr(&f, $&hdr, pos + 12) >>>
                gt := read_u32_le(&hdr, pos)
                toff := read_u64_le(&hdr, pos + 4)
                pos += 12
                if tname == "token_embd.weight" && last_d > 0 { vocab_size = last_d }
                tinfos.push(GgufSrcTensorInfo{name: tname, dims: ~dims_g, gtype: gt, n_elems: n_elems, offset: toff})
            }
            if vocab_size <= 0 { vocab_size = vocab.len }
            if n_kv_heads <= 0 { n_kv_heads = n_heads }
            pad := (alignment - (pos % alignment)) % alignment
            data_base := pos + pad
            for ti in 0:tinfos.len {
                vals := read_gguf_tensor_as_f32(&f, data_base, &tinfos[ti]) >>>
                $dcopy := []int{}
                for di in 0:tinfos[ti].dims.len { dcopy.push(tinfos[ti].dims[di]) }
                src_tensors.push(QuantSrcTensor{name: tinfos[ti].name + "", dims: ~dcopy, vals: ~vals})
            }
            _ := f.close() >>>
        } else {
            _ := f.close() >>>
            raw := os.read((*in_path) + "") >>>
            if raw.len < 8 { >>> errors.new("quantize: invalid safetensors file") }
            hlen := read_u64_le(&raw, 0)
            if hlen <= 0 || hlen > raw.len - 8 { >>> errors.new("quantize: invalid safetensors header") }
            base := 8 + hlen
            hstr := raw[8:base]
            doc := json.parse(&hstr) >>>
            root := doc.root()
            if !doc.is_dict(root) { >>> errors.new("quantize: invalid safetensors JSON header") }
            meta := doc_get_or(&doc, root, "__metadata__", -1)
            if meta < 0 || !doc.is_dict(meta) { >>> errors.new("quantize: safetensors missing __metadata__") }
            dim = meta_int(&doc, meta, "dim") >>>
            hidden_dim = meta_int(&doc, meta, "hidden_dim") >>>
            n_layers = meta_int(&doc, meta, "n_layers") >>>
            n_heads = meta_int(&doc, meta, "n_heads") >>>
            n_kv_heads = meta_int(&doc, meta, "n_kv_heads") >>>
            vocab_size = meta_int(&doc, meta, "vocab_size") >>>
            max_seq_len = meta_int(&doc, meta, "max_seq_len") >>>
            rope_theta = try_parse_f64_or(&doc_str_or(&doc, meta, "rope_theta", "10000"), 10000.0)
            for vi in 0:vocab_size {
                $piece := "t" + str(vi)
                if vi == 0 { piece = "<unk>" }
                else if vi == 1 { piece = "<s>" }
                else if vi == 2 { piece = "</s>" }
                vocab.push(piece)
            }
            keys := doc.dict_keys(root)
            for ki in 0:keys.len {
                k := keys[ki] + ""
                if k == "__metadata__" { -> }
                entry := doc.get(root, k + "")
                $dims_g := []int{}
                vals := decode_safetensor_f32(&raw, base, entry, &doc, $&dims_g) >>>
                src_tensors.push(QuantSrcTensor{name: sf_to_gguf_name(&k), dims: ~dims_g, vals: ~vals})
            }
        }
    }

    if vocab.len == 0 && vocab_size > 0 {
        for vi in 0:vocab_size { vocab.push("t" + str(vi)) }
    }

    $specs := []QuantGgufSpec{}
    $cur_data_off := 0
    for ti in 0:src_tensors.len {
        st := &src_tensors[ti]
        nd := st.dims.len
        $cols := 0
        if nd >= 1 { cols = st.dims[0] }
        gtype := choose_tensor_qtype(&st.name, nd, cols, &qmode)
        tdata := encode_tensor_for_qtype(&st.vals, gtype)
        pad := (32 - (cur_data_off % 32)) % 32
        cur_data_off += pad
        toff := cur_data_off
        cur_data_off += tdata.len
        $dcopy := []int{}
        for di in 0:nd { dcopy.push(st.dims[di]) }
        specs.push(QuantGgufSpec{name: st.name + "", dims: ~dcopy, gtype: gtype, offset: toff, data: ~tdata})
    }

    $kv_buf := ""
    $kv_cnt := 0
    push_gguf_kv_str($&kv_buf, "general.architecture", arch + "", $&kv_cnt)
    push_gguf_kv_u32($&kv_buf, arch + ".embedding_length", dim, $&kv_cnt)
    push_gguf_kv_u32($&kv_buf, arch + ".feed_forward_length", hidden_dim, $&kv_cnt)
    push_gguf_kv_u32($&kv_buf, arch + ".block_count", n_layers, $&kv_cnt)
    push_gguf_kv_u32($&kv_buf, arch + ".attention.head_count", n_heads, $&kv_cnt)
    push_gguf_kv_u32($&kv_buf, arch + ".attention.head_count_kv", n_kv_heads, $&kv_cnt)
    push_gguf_kv_u32($&kv_buf, arch + ".context_length", max_seq_len, $&kv_cnt)
    push_gguf_kv_f32($&kv_buf, arch + ".rope.freq_base", f32(rope_theta), $&kv_cnt)
    push_gguf_kv_f32($&kv_buf, arch + ".attention.layer_norm_rms_epsilon", f32(rms_eps), $&kv_cnt)
    push_gguf_kv_u32($&kv_buf, "tokenizer.ggml.bos_token_id", bos_id, $&kv_cnt)
    push_gguf_kv_u32($&kv_buf, "tokenizer.ggml.eos_token_id", eos_id, $&kv_cnt)
    if tok_model.len > 0 {
        push_gguf_kv_str($&kv_buf, "tokenizer.ggml.model", tok_model + "", $&kv_cnt)
    }
    if chat_tmpl.len > 0 {
        push_gguf_kv_str($&kv_buf, "tokenizer.chat_template", chat_tmpl + "", $&kv_cnt)
    }
    push_gguf_kv_str_arr($&kv_buf, "tokenizer.ggml.tokens", &vocab, $&kv_cnt)
    if merges.len > 0 {
        push_gguf_kv_str_arr($&kv_buf, "tokenizer.ggml.merges", &merges, $&kv_cnt)
    }

    $hdr := ""
    hdr.push_str("GGUF")
    push_u32_le($&hdr, 3)
    push_u64_le($&hdr, specs.len)
    push_u64_le($&hdr, kv_cnt)
    hdr.push_str(kv_buf)

    for si in 0:specs.len {
        sp := &specs[si]
        push_gguf_str($&hdr, &sp.name)
        push_u32_le($&hdr, sp.dims.len)
        for di in 0:sp.dims.len {
            push_u64_le($&hdr, sp.dims[di])
        }
        push_u32_le($&hdr, sp.gtype)
        push_u64_le($&hdr, sp.offset)
    }

    hpad := (32 - (hdr.len % 32)) % 32
    for _ in 0:hpad { hdr.push_str(string_from_byte(0)) }

    $written_data := 0
    for si in 0:specs.len {
        sp := &specs[si]
        while written_data < sp.offset {
            hdr.push_str(string_from_byte(0))
            written_data += 1
        }
        hdr.push_str(sp.data)
        written_data += sp.data.len
    }

    total_bytes := hdr.len
    _ := os.write((*out_path) + "", ~hdr) >>>
    println("source_format:" + src_fmt)
    println("quantized_tensors:" + str(specs.len))
    println("quant_type:" + qmode)
    println("saved_gguf:" + (*out_path))
    println("bytes:" + str(total_bytes))
    << 0
}
