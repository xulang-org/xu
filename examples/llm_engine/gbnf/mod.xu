@gbnf

#os
#errors
#encoding/json

pub struct GbnfElem {
    pub kind int
    pub lit string
    pub lo []int
    pub hi []int
    pub negated bool
    pub ref_idx int
}

pub struct GbnfAlt {
    pub elems []GbnfElem
}

pub struct GbnfRule {
    pub name string
    pub alts []GbnfAlt
}

pub struct GbnfGrammar {
    pub active bool
    pub rules []GbnfRule
    pub root_idx int
}

pub struct GbnfFrame {
    pub rule_idx int
    pub alt_idx int
    pub elem_pos int
    pub lit_off int
}

pub struct GbnfBranch {
    pub frames []GbnfFrame
}

pub struct GbnfState {
    pub branches []GbnfBranch
}

pub struct VocabIndex {
    pub vocab_size int
    pub pieces []string
    pub is_eos []bool
    pub eos_tokens []int
    pub by_first_byte [][]int
}

pub fn empty_grammar() GbnfGrammar {
    << GbnfGrammar{active: false, rules: []GbnfRule{}, root_idx: 0}
}

pub fn empty_vocab_index() VocabIndex {
    << VocabIndex{
        vocab_size: 0, pieces: []string{}, is_eos: []bool{},
        eos_tokens: []int{}, by_first_byte: [][]int{}
    }
}

pub fn build_vocab_index(pieces &[]string, eos_ids &[]int) VocabIndex {
    vsize := pieces.len
    $ps := []string{}
    ps.reserve(vsize)
    $eos_flags := []bool{}
    eos_flags.reserve(vsize)
    $eos_toks := []int{}
    $buckets := [][]int{}
    buckets.reserve(256)
    for _ in 0:256 { buckets.push([]int{}) }
    for i in 0:vsize {
        $is_e := false
        for ei in 0:eos_ids.len {
            if eos_ids[ei] == i {
                is_e = true
                <-
            }
        }
        p := pieces[i] + ""
        p_nonempty := p.len > 0
        $first_b := 0
        if p_nonempty { first_b = p[0] & 255 }
        ps.push(~p)
        eos_flags.push(is_e)
        if is_e {
            eos_toks.push(i)
        } else if p_nonempty {
            buckets[first_b].push(i)
        }
    }
    << VocabIndex{
        vocab_size: vsize,
        pieces: ~ps,
        is_eos: ~eos_flags,
        eos_tokens: ~eos_toks,
        by_first_byte: ~buckets
    }
}

fn find_substr(hay &string, needle &string) int {
    if needle.len == 0 { << 0 }
    if needle.len > hay.len { << -1 }
    limit := hay.len - needle.len + 1
    for i in 0:limit {
        $ok := true
        for j in 0:needle.len {
            if (*hay)[i + j] != (*needle)[j] {
                ok = false
                <-
            }
        }
        if ok { << i }
    }
    << -1
}

fn trim_ws(s &string) string {
    $l := 0
    $r := s.len
    while l < r {
        c := (*s)[l] & 255
        if c == 32 || c == 9 || c == 10 || c == 13 { l += 1 } else { <- }
    }
    while r > l {
        c := (*s)[r - 1] & 255
        if c == 32 || c == 9 || c == 10 || c == 13 { r -= 1 } else { <- }
    }
    << (*s)[l:r]
}

fn split_lines_trim(text &string) []string {
    $out := []string{}
    $start := 0
    for i in 0:(text.len + 1) {
        $is_nl := i == text.len
        if !is_nl { is_nl = ((*text)[i] & 255) == 10 }
        if is_nl {
            ln := trim_ws(&(*text)[start:i])
            if ln.len > 0 { out.push(ln) }
            start = i + 1
        }
    }
    << out
}

fn gbnf_copy_ints(src &[]int) []int {
    $out := []int{}
    out.reserve(src.len)
    for i in 0:src.len { out.push(src[i]) }
    << out
}

fn gbnf_copy_elem(e &GbnfElem) GbnfElem {
    << GbnfElem{
        kind: e.kind,
        lit: e.lit + "",
        lo: gbnf_copy_ints(&e.lo),
        hi: gbnf_copy_ints(&e.hi),
        negated: e.negated,
        ref_idx: e.ref_idx
    }
}

fn gbnf_copy_alt(a &GbnfAlt) GbnfAlt {
    $es := []GbnfElem{}
    for i in 0:a.elems.len { es.push(gbnf_copy_elem(&a.elems[i])) }
    << GbnfAlt{elems: es}
}

fn gbnf_copy_rule(r &GbnfRule) GbnfRule {
    $alts := []GbnfAlt{}
    for i in 0:r.alts.len { alts.push(gbnf_copy_alt(&r.alts[i])) }
    << GbnfRule{name: r.name + "", alts: alts}
}

pub fn copy_grammar(g &GbnfGrammar) GbnfGrammar {
    $rs := []GbnfRule{}
    for i in 0:g.rules.len { rs.push(gbnf_copy_rule(&g.rules[i])) }
    << GbnfGrammar{active: g.active, rules: rs, root_idx: g.root_idx}
}

fn gbnf_copy_frame(f &GbnfFrame) GbnfFrame {
    << GbnfFrame{rule_idx: f.rule_idx, alt_idx: f.alt_idx, elem_pos: f.elem_pos, lit_off: f.lit_off}
}

fn gbnf_copy_elems(xs &[]GbnfElem) []GbnfElem {
    $out := []GbnfElem{}
    for i in 0:xs.len { out.push(gbnf_copy_elem(&xs[i])) }
    << out
}

fn gbnf_copy_branch(b &GbnfBranch) GbnfBranch {
    $fs := []GbnfFrame{}
    for i in 0:b.frames.len { fs.push(gbnf_copy_frame(&b.frames[i])) }
    << GbnfBranch{frames: fs}
}

fn gbnf_copy_state(s &GbnfState) GbnfState {
    $bs := []GbnfBranch{}
    for i in 0:s.branches.len { bs.push(gbnf_copy_branch(&s.branches[i])) }
    << GbnfState{branches: bs}
}

fn gbnf_find_rule(rnames &[]string, name &string) int {
    for i in 0:rnames.len {
        if rnames[i] == *name { << i }
    }
    << -1
}

fn gbnf_ensure_rule(rules $&[]GbnfRule, rnames $&[]string, name string) int {
    idx := gbnf_find_rule(rnames, &name)
    if idx >= 0 { << idx }
    nidx := rules.len
    rnames.push(name + "")
    rules.push(GbnfRule{name: name + "", alts: []GbnfAlt{}})
    << nidx
}

fn gbnf_is_ident_start(ch int) bool {
    << (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95
}

fn gbnf_is_ident_cont(ch int) bool {
    << gbnf_is_ident_start(ch) || (ch >= 48 && ch <= 57) || ch == 45
}

fn gbnf_skip_ws(src &string, pos $&int) {
    while *pos < src.len {
        ch := (*src)[*pos] & 255
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
            *pos += 1
        } else if ch == 35 {
            while *pos < src.len && ((*src)[*pos] & 255) != 10 { *pos += 1 }
        } else {
            <-
        }
    }
}

fn gbnf_parse_escape(src &string, pos $&int) int {
    if *pos >= src.len { << 92 }
    c := (*src)[*pos] & 255
    *pos += 1
    if c == 110 { << 10 }
    if c == 114 { << 13 }
    if c == 116 { << 9 }
    << c
}

fn gbnf_parse_string(src &string, pos $&int) string {
    *pos += 1
    $out := ""
    while *pos < src.len {
        c := (*src)[*pos] & 255
        if c == 34 {
            *pos += 1
            << out
        }
        if c == 92 {
            *pos += 1
            ev := gbnf_parse_escape(src, pos)
            out.push_str(string_from_byte(ev))
        } else {
            out.push_str(string_from_byte(c))
            *pos += 1
        }
    }
    >>> errors.new("gbnf: unterminated string literal")
}

fn gbnf_parse_class(src &string, pos $&int) GbnfElem {
    *pos += 1
    $neg := false
    if *pos < src.len && ((*src)[*pos] & 255) == 94 {
        neg = true
        *pos += 1
    }
    $lo := []int{}
    $hi := []int{}
    $closed := false
    while *pos < src.len {
        c := (*src)[*pos] & 255
        if c == 93 {
            *pos += 1
            closed = true
            <-
        }
        $start_c := c
        *pos += 1
        if start_c == 92 { start_c = gbnf_parse_escape(src, pos) }
        if *pos + 1 < src.len && ((*src)[*pos] & 255) == 45 && ((*src)[*pos + 1] & 255) != 93 {
            *pos += 1
            $end_c := (*src)[*pos] & 255
            *pos += 1
            if end_c == 92 { end_c = gbnf_parse_escape(src, pos) }
            lo.push(start_c)
            hi.push(end_c)
        } else {
            lo.push(start_c)
            hi.push(start_c)
        }
    }
    if !closed {
        >>> errors.new("gbnf: unterminated character class")
    }
    << GbnfElem{kind: 1, lit: "", lo: lo, hi: hi, negated: neg, ref_idx: -1}
}

fn gbnf_parse_alts(src &string, pos $&int, stop_ch int, rules $&[]GbnfRule, rnames $&[]string) []GbnfAlt {
    $alts := []GbnfAlt{}
    $cur := []GbnfElem{}
    for {
        gbnf_skip_ws(src, pos)
        if *pos >= src.len {
            alts.push(GbnfAlt{elems: gbnf_copy_elems(&cur)})
            << alts
        }
        ch := (*src)[*pos] & 255
        if stop_ch > 0 && ch == stop_ch {
            *pos += 1
            alts.push(GbnfAlt{elems: gbnf_copy_elems(&cur)})
            << alts
        }
        if ch == 124 {
            *pos += 1
            alts.push(GbnfAlt{elems: gbnf_copy_elems(&cur)})
            cur = []GbnfElem{}
            ->
        }
        $has_atom := false
        $atom := GbnfElem{kind: 0, lit: "", lo: []int{}, hi: []int{}, negated: false, ref_idx: -1}
        if ch == 34 {
            lit := gbnf_parse_string(src, pos) >>>
            atom = GbnfElem{kind: 0, lit: lit, lo: []int{}, hi: []int{}, negated: false, ref_idx: -1}
            has_atom = true
        } else if ch == 91 {
            atom = gbnf_parse_class(src, pos) >>>
            has_atom = true
        } else if ch == 40 {
            *pos += 1
            gidx := gbnf_ensure_rule(rules, rnames, "_grp_" + str(rules.len))
            sub_alts := gbnf_parse_alts(src, pos, 41, rules, rnames) >>>
            rules[gidx] = GbnfRule{name: rnames[gidx] + "", alts: sub_alts}
            atom = GbnfElem{kind: 2, lit: "", lo: []int{}, hi: []int{}, negated: false, ref_idx: gidx}
            has_atom = true
        } else if gbnf_is_ident_start(ch) {
            st := *pos
            *pos += 1
            while *pos < src.len && gbnf_is_ident_cont((*src)[*pos] & 255) { *pos += 1 }
            rname := (*src)[st:*pos]
            ridx := gbnf_ensure_rule(rules, rnames, rname)
            atom = GbnfElem{kind: 2, lit: "", lo: []int{}, hi: []int{}, negated: false, ref_idx: ridx}
            has_atom = true
        } else {
            alts.push(GbnfAlt{elems: gbnf_copy_elems(&cur)})
            << alts
        }
        if has_atom {
            gbnf_skip_ws(src, pos)
            if *pos < src.len {
                q := (*src)[*pos] & 255
                if q == 42 || q == 43 || q == 63 {
                    *pos += 1
                    hidx := gbnf_ensure_rule(rules, rnames, "_q_" + str(rules.len))
                    $halts := []GbnfAlt{}
                    if q == 63 {
                        $a1 := []GbnfElem{}
                        a1.push(gbnf_copy_elem(&atom))
                        halts.push(GbnfAlt{elems: a1})
                        halts.push(GbnfAlt{elems: []GbnfElem{}})
                    } else if q == 42 {
                        $a1 := []GbnfElem{}
                        a1.push(gbnf_copy_elem(&atom))
                        a1.push(GbnfElem{kind: 2, lit: "", lo: []int{}, hi: []int{}, negated: false, ref_idx: hidx})
                        halts.push(GbnfAlt{elems: a1})
                        halts.push(GbnfAlt{elems: []GbnfElem{}})
                    } else {
                        $a1 := []GbnfElem{}
                        a1.push(gbnf_copy_elem(&atom))
                        a1.push(GbnfElem{kind: 2, lit: "", lo: []int{}, hi: []int{}, negated: false, ref_idx: hidx})
                        $a2 := []GbnfElem{}
                        a2.push(gbnf_copy_elem(&atom))
                        halts.push(GbnfAlt{elems: a1})
                        halts.push(GbnfAlt{elems: a2})
                    }
                    rules[hidx] = GbnfRule{name: rnames[hidx] + "", alts: halts}
                    atom = GbnfElem{kind: 2, lit: "", lo: []int{}, hi: []int{}, negated: false, ref_idx: hidx}
                }
            }
            cur.push(gbnf_copy_elem(&atom))
        }
    }
    << alts
}

fn gbnf_strip_comments(raw &string) string {
    $out := ""
    $in_str := false
    $in_cls := false
    $esc := false
    $in_cmt := false
    for i in 0:raw.len {
        c := (*raw)[i] & 255
        if in_cmt {
            if c == 10 {
                in_cmt = false
                out.push_str("\n")
            }
            ->
        }
        if esc {
            esc = false
            out.push_str(string_from_byte(c))
            ->
        }
        if in_str {
            if c == 92 { esc = true } else if c == 34 { in_str = false }
            out.push_str(string_from_byte(c))
            ->
        }
        if in_cls {
            if c == 92 { esc = true } else if c == 93 { in_cls = false }
            out.push_str(string_from_byte(c))
            ->
        }
        if c == 35 {
            in_cmt = true
            ->
        }
        if c == 34 { in_str = true } else if c == 91 { in_cls = true }
        out.push_str(string_from_byte(c))
    }
    << out
}

pub fn compile(raw &string) GbnfGrammar {
    clean := gbnf_strip_comments(raw)
    lines := split_lines_trim(&clean)
    $logical := []string{}
    for i in 0:lines.len {
        ln := &lines[i]
        if find_substr(ln, &"::=") >= 0 {
            logical.push((*ln) + "")
        } else if logical.len > 0 {
            logical[logical.len - 1] = logical[logical.len - 1] + " " + (*ln)
        }
    }
    if logical.len == 0 {
        >>> errors.new("gbnf: no rule definitions found")
    }
    $rules := []GbnfRule{}
    $rnames := []string{}
    $rhs_list := []string{}
    $lhs_list := []string{}
    for i in 0:logical.len {
        ln := &logical[i]
        sep := find_substr(ln, &"::=")
        if sep <= 0 { >>> errors.new("gbnf: invalid rule definition") }
        lhs := trim_ws(&(*ln)[0:sep])
        rhs := (*ln)[(sep + 3):ln.len]
        _ := gbnf_ensure_rule($&rules, $&rnames, lhs + "")
        lhs_list.push(lhs)
        rhs_list.push(rhs)
    }
    for i in 0:lhs_list.len {
        ridx := gbnf_find_rule(&rnames, &lhs_list[i])
        $p := 0
        alts := gbnf_parse_alts(&rhs_list[i], $&p, 0, $&rules, $&rnames) >>>
        rules[ridx] = GbnfRule{name: lhs_list[i] + "", alts: alts}
    }
    $root_idx := gbnf_find_rule(&rnames, &"root")
    if root_idx < 0 { root_idx = 0 }
    if rules[root_idx].alts.len == 0 {
        >>> errors.new("gbnf: root rule has no alternatives")
    }
    << GbnfGrammar{active: true, rules: rules, root_idx: root_idx}
}

fn gbnf_branch_key(b &GbnfBranch) string {
    if b.frames.len == 0 { << "FIN" }
    $s := ""
    for i in 0:b.frames.len {
        f := &b.frames[i]
        if i > 0 { s = s + ";" }
        s = s + str(f.rule_idx) + ":" + str(f.alt_idx) + ":" + str(f.elem_pos) + ":" + str(f.lit_off)
    }
    << s
}

fn gbnf_has_str(xs &[]string, target &string) bool {
    for i in 0:xs.len {
        if xs[i] == *target { << true }
    }
    << false
}

fn gbnf_normalize(g &GbnfGrammar, in_branches $&[]GbnfBranch) GbnfState {
    $work := []GbnfBranch{}
    for i in 0:in_branches.len { work.push(gbnf_copy_branch(&in_branches[i])) }
    $kept := []GbnfBranch{}
    $seen_kept := []string{}
    $seen_work := []string{}
    $wi := 0
    while wi < work.len && kept.len < 64 && wi < 512 {
        $br := gbnf_copy_branch(&work[wi])
        wi += 1
        while br.frames.len > 0 {
            top_i := br.frames.len - 1
            fr := &br.frames[top_i]
            ri := fr.rule_idx
            ai := fr.alt_idx
            r := &g.rules[ri]
            alt := &r.alts[ai]
            if fr.elem_pos >= alt.elems.len {
                $nfs := []GbnfFrame{}
                for fi in 0:top_i { nfs.push(gbnf_copy_frame(&br.frames[fi])) }
                br.frames = nfs
            } else {
                <-
            }
        }
        if br.frames.len == 0 {
            if !gbnf_has_str(&seen_kept, &"FIN") {
                seen_kept.push("FIN")
                kept.push(gbnf_copy_branch(&br))
            }
            ->
        }
        bk := gbnf_branch_key(&br)
        if gbnf_has_str(&seen_work, &bk) { -> }
        seen_work.push(bk + "")

        top_i := br.frames.len - 1
        top_f := &br.frames[top_i]
        tri := top_f.rule_idx
        tai := top_f.alt_idx
        tep := top_f.elem_pos
        toff := top_f.lit_off
        tr := &g.rules[tri]
        talt := &tr.alts[tai]
        el := &talt.elems[tep]
        if el.kind == 0 && toff >= el.lit.len {
            br.frames[top_i].elem_pos += 1
            br.frames[top_i].lit_off = 0
            work.push(gbnf_copy_branch(&br))
        } else if el.kind == 2 {
            ref_id := el.ref_idx
            br.frames[top_i].elem_pos += 1
            br.frames[top_i].lit_off = 0
            if br.frames.len < 48 {
                ref_rule := &g.rules[ref_id]
                nalts := ref_rule.alts.len
                for ai in 0:nalts {
                    $nb := gbnf_copy_branch(&br)
                    nb.frames.push(GbnfFrame{rule_idx: ref_id, alt_idx: ai, elem_pos: 0, lit_off: 0})
                    work.push(nb)
                }
            }
        } else {
            if !gbnf_has_str(&seen_kept, &bk) {
                seen_kept.push(bk)
                kept.push(gbnf_copy_branch(&br))
            }
        }
    }
    << GbnfState{branches: kept}
}

pub fn init_state(g &GbnfGrammar) GbnfState {
    if !g.active || g.rules.len == 0 { << GbnfState{branches: []GbnfBranch{}} }
    $init_bs := []GbnfBranch{}
    root_i := g.root_idx
    root := &g.rules[root_i]
    for ai in 0:root.alts.len {
        $fs := []GbnfFrame{}
        fs.push(GbnfFrame{rule_idx: root_i, alt_idx: ai, elem_pos: 0, lit_off: 0})
        init_bs.push(GbnfBranch{frames: fs})
    }
    << gbnf_normalize(g, $&init_bs)
}

pub fn can_finish(st &GbnfState) bool {
    for i in 0:st.branches.len {
        if st.branches[i].frames.len == 0 { << true }
    }
    << false
}

fn gbnf_elem_matches_byte(el &GbnfElem, lit_off int, b int) bool {
    if el.kind == 0 {
        if lit_off < el.lit.len {
            << (el.lit[lit_off] & 255) == b
        }
        << false
    }
    if el.kind == 1 {
        $hit := false
        for i in 0:el.lo.len {
            if b >= el.lo[i] && b <= el.hi[i] {
                hit = true
                <-
            }
        }
        if el.negated { << !hit }
        << hit
    }
    << false
}

fn gbnf_fill_allowed_bytes(g &GbnfGrammar, st &GbnfState, allowed $&[]bool) {
    for i in 0:st.branches.len {
        b := &st.branches[i]
        if b.frames.len == 0 { -> }
        last_f := b.frames.len - 1
        fr := &b.frames[last_f]
        ri := fr.rule_idx
        ai := fr.alt_idx
        epos := fr.elem_pos
        r := &g.rules[ri]
        alt := &r.alts[ai]
        el := &alt.elems[epos]
        if el.kind == 0 {
            if fr.lit_off < el.lit.len {
                allowed[el.lit[fr.lit_off] & 255] = true
            }
        } else if el.kind == 1 {
            if !el.negated {
                for r in 0:el.lo.len {
                    $lo_v := el.lo[r]
                    $hi_v := el.hi[r]
                    if lo_v < 0 { lo_v = 0 }
                    if hi_v > 255 { hi_v = 255 }
                    for ch in lo_v:(hi_v + 1) { allowed[ch] = true }
                }
            } else {
                for ch in 0:256 {
                    if gbnf_elem_matches_byte(el, 0, ch) { allowed[ch] = true }
                }
            }
        }
    }
}

fn gbnf_step_byte(g &GbnfGrammar, st &GbnfState, b int) GbnfState {
    $next_bs := []GbnfBranch{}
    for i in 0:st.branches.len {
        br := &st.branches[i]
        if br.frames.len == 0 { -> }
        last_f := br.frames.len - 1
        fr := &br.frames[last_f]
        ri := fr.rule_idx
        ai := fr.alt_idx
        epos := fr.elem_pos
        loff := fr.lit_off
        r := &g.rules[ri]
        alt := &r.alts[ai]
        el := &alt.elems[epos]
        if gbnf_elem_matches_byte(el, loff, b) {
            $nb := gbnf_copy_branch(br)
            if el.kind == 0 {
                if loff + 1 < el.lit.len {
                    nb.frames[last_f].lit_off = loff + 1
                } else {
                    nb.frames[last_f].elem_pos = epos + 1
                    nb.frames[last_f].lit_off = 0
                }
            } else {
                nb.frames[last_f].elem_pos = epos + 1
                nb.frames[last_f].lit_off = 0
            }
            next_bs.push(nb)
        }
    }
    << gbnf_normalize(g, $&next_bs)
}

pub fn advance_piece(g &GbnfGrammar, st &GbnfState, piece &string) GbnfState {
    $cur := gbnf_copy_state(st)
    for i in 0:piece.len {
        cur = gbnf_step_byte(g, &cur, (*piece)[i] & 255)
        if cur.branches.len == 0 { << cur }
    }
    << cur
}

pub fn apply_logit_mask(logits $&[]f32, off int, vidx &VocabIndex, g &GbnfGrammar, st &GbnfState) {
    if !g.active { << }
    vocab := vidx.vocab_size
    if vocab <= 0 { << }
    $allowed_b := []bool{}
    allowed_b.reserve(256)
    for _ in 0:256 { allowed_b.push(false) }
    gbnf_fill_allowed_bytes(g, st, $&allowed_b)
    can_fin := can_finish(st)

    $keep := []bool{}
    keep.reserve(vocab)
    for _ in 0:vocab { keep.push(false) }
    $kept := 0

    if can_fin {
        for ei in 0:vidx.eos_tokens.len {
            tid := vidx.eos_tokens[ei]
            if logits[off + tid] > f32(-1e8) {
                keep[tid] = true
                kept += 1
            }
        }
    }

    for b in 0:256 {
        if !allowed_b[b] { -> }
        bucket := &vidx.by_first_byte[b]
        for bi in 0:bucket.len {
            tid := bucket[bi]
            if logits[off + tid] <= f32(-1e8) { -> }
            piece := &vidx.pieces[tid]
            if piece.len == 1 {
                keep[tid] = true
                kept += 1
            } else {
                nxt_st := advance_piece(g, st, piece)
                if nxt_st.branches.len > 0 {
                    keep[tid] = true
                    kept += 1
                }
            }
        }
    }

    if kept > 0 {
        for i in 0:vocab {
            if !keep[i] && logits[off + i] > f32(-1e8) {
                logits[off + i] = f32(-1e9)
            }
        }
    }
}

pub fn read_grammar_arg(arg &string) string {
    << os.read((*arg) + "") >>> (_) { << (*arg) + "" }
}

fn escape_gbnf_lit(s &string) string {
    $out := "\""
    for i in 0:s.len {
        c := (*s)[i] & 255
        if c == 34 {
            out.push_str("\\\"")
        } else if c == 92 {
            out.push_str("\\\\")
        } else if c == 10 {
            out.push_str("\\n")
        } else if c == 13 {
            out.push_str("\\r")
        } else if c == 9 {
            out.push_str("\\t")
        } else {
            out.push_str(string_from_byte(c))
        }
    }
    out.push_str("\"")
    << out
}

fn schema_str_or(doc &json.Doc, obj int, key string, def string) string {
    if obj < 0 || !doc.is_dict(obj) || !doc.has(obj, key) { << def }
    n := doc.get(obj, key) >>> (_) { << def }
    if doc.is_string(n) { << doc.as_string(n) >>> (_) { << def } }
    << def
}

fn emit_optional_prop_chain(rules_out $&string, keys &[]string, rrefs &[]string, idx int, next_id $&int) string {
    rname := "jopt_" + str(*next_id)
    *next_id += 1
    kjson := json.quote(&keys[idx])
    kv_pat := escape_gbnf_lit(&kjson) + " ws \":\" ws " + rrefs[idx]
    if idx + 1 >= keys.len {
        *rules_out = *rules_out + rname + " ::= " + kv_pat + "\n"
        << rname
    }
    tail_ref := emit_optional_prop_chain(rules_out, keys, rrefs, idx + 1, next_id)
    *rules_out = *rules_out + rname + " ::= ( " + kv_pat + " ( ws \",\" ws " + tail_ref + " )? ) | " + tail_ref + "\n"
    << rname
}

fn emit_schema_rule(doc &json.Doc, node int, rname string, rules_out $&string, next_id $&int) string {
    if node < 0 || !doc.is_dict(node) {
        *rules_out = *rules_out + rname + " ::= jvalue\n"
        << rname
    }
    if doc.has(node, "const") {
        cn := doc.get(node, "const") >>>
        cjson := doc.encode(cn) >>>
        *rules_out = *rules_out + rname + " ::= " + escape_gbnf_lit(&cjson) + "\n"
        << rname
    }
    if doc.has(node, "enum") {
        en := doc.get(node, "enum") >>>
        if doc.is_list(en) && doc.count(en) > 0 {
            $rhs := ""
            cnt := doc.count(en)
            for i in 0:cnt {
                if i > 0 { rhs = rhs + " | " }
                item := doc.at(en, i) >>>
                ijson := doc.encode(item) >>>
                rhs = rhs + escape_gbnf_lit(&ijson)
            }
            *rules_out = *rules_out + rname + " ::= " + rhs + "\n"
            << rname
        }
    }
    if doc.has(node, "anyOf") || doc.has(node, "oneOf") {
        $key := "anyOf"
        if !doc.has(node, "anyOf") { key = "oneOf" }
        an := doc.get(node, key) >>>
        if doc.is_list(an) && doc.count(an) > 0 {
            $rhs := ""
            cnt := doc.count(an)
            for i in 0:cnt {
                if i > 0 { rhs = rhs + " | " }
                sub := doc.at(an, i) >>>
                sub_name := "jsub_" + str(*next_id)
                *next_id += 1
                _ := emit_schema_rule(doc, sub, sub_name + "", rules_out, next_id) >>>
                rhs = rhs + sub_name
            }
            *rules_out = *rules_out + rname + " ::= " + rhs + "\n"
            << rname
        }
    }

    $typ := schema_str_or(doc, node, "type", "")
    if typ.len == 0 && doc.has(node, "properties") { typ = "object" }
    if typ.len == 0 && doc.has(node, "items") { typ = "array" }

    if typ == "string" {
        *rules_out = *rules_out + rname + " ::= jstring\n"
        << rname
    }
    if typ == "integer" {
        *rules_out = *rules_out + rname + " ::= jinteger\n"
        << rname
    }
    if typ == "number" {
        *rules_out = *rules_out + rname + " ::= jnumber\n"
        << rname
    }
    if typ == "boolean" {
        *rules_out = *rules_out + rname + " ::= jboolean\n"
        << rname
    }
    if typ == "null" {
        *rules_out = *rules_out + rname + " ::= jnull\n"
        << rname
    }
    if typ == "array" {
        if doc.has(node, "items") {
            it_node := doc.get(node, "items") >>>
            if doc.is_dict(it_node) {
                it_name := "jit_" + str(*next_id)
                *next_id += 1
                _ := emit_schema_rule(doc, it_node, it_name + "", rules_out, next_id) >>>
                *rules_out = *rules_out + rname + " ::= \"[\" ws ( " + it_name + " ( ws \",\" ws " + it_name + " )* )? ws \"]\"\n"
                << rname
            }
        }
        *rules_out = *rules_out + rname + " ::= jarray\n"
        << rname
    }
    if typ == "object" {
        if doc.has(node, "properties") {
            props := doc.get(node, "properties") >>>
            if doc.is_dict(props) {
                pkeys := doc.dict_keys(props)
                if pkeys.len > 0 {
                    $req_names := []string{}
                    if doc.has(node, "required") {
                        rn := doc.get(node, "required") >>>
                        if doc.is_list(rn) {
                            rc := doc.count(rn)
                            for ri in 0:rc {
                                item := doc.at(rn, ri) >>>
                                if doc.is_string(item) {
                                    req_names.push(doc.as_string(item) >>>)
                                }
                            }
                        }
                    }
                    $req_keys := []string{}
                    $req_refs := []string{}
                    $opt_keys := []string{}
                    $opt_refs := []string{}
                    for ki in 0:pkeys.len {
                        pk := pkeys[ki] + ""
                        pnode := doc.get(props, pk + "") >>>
                        pr_name := "jprop_" + str(*next_id)
                        *next_id += 1
                        _ := emit_schema_rule(doc, pnode, pr_name + "", rules_out, next_id) >>>
                        $is_req := false
                        for ri in 0:req_names.len {
                            if req_names[ri] == pk {
                                is_req = true
                                <-
                            }
                        }
                        if is_req {
                            req_keys.push(pk)
                            req_refs.push(pr_name)
                        } else {
                            opt_keys.push(pk)
                            opt_refs.push(pr_name)
                        }
                    }
                    $body := "\"{\" ws "
                    for i in 0:req_keys.len {
                        if i > 0 { body = body + " ws \",\" ws " }
                        kjson := json.quote(&req_keys[i])
                        body = body + escape_gbnf_lit(&kjson) + " ws \":\" ws " + req_refs[i]
                    }
                    if opt_keys.len > 0 {
                        chain_ref := emit_optional_prop_chain(rules_out, &opt_keys, &opt_refs, 0, next_id)
                        if req_keys.len > 0 {
                            body = body + " ( ws \",\" ws " + chain_ref + " )?"
                        } else {
                            body = body + " ( " + chain_ref + " )?"
                        }
                    }
                    body = body + " ws \"}\""
                    *rules_out = *rules_out + rname + " ::= " + body + "\n"
                    << rname
                }
            }
        }
        *rules_out = *rules_out + rname + " ::= jobject\n"
        << rname
    }
    *rules_out = *rules_out + rname + " ::= jvalue\n"
    << rname
}

pub fn json_schema_to_gbnf(schema_json &string) string {
    doc := json.parse(schema_json)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >>> errors.new("json_schema: expected JSON Schema object")
    }
    $rules := ""
    $next_id := 0
    _ := emit_schema_rule(&doc, doc.root(), "root", $&rules, $&next_id) >>>
    base := "ws ::= [ \\t\\n\\r]*\n" +
            "jchar ::= [^\"\\\\\\n\\r] | \"\\\\\" ( \"\\\"\" | \"\\\\\" | \"/\" | \"b\" | \"f\" | \"n\" | \"r\" | \"t\" )\n" +
            "jstring ::= \"\\\"\" jchar* \"\\\"\"\n" +
            "jinteger ::= \"-\"? ( \"0\" | [1-9] [0-9]* )\n" +
            "jnumber ::= \"-\"? ( \"0\" | [1-9] [0-9]* ) ( \".\" [0-9]+ )? ( [eE] [+-]? [0-9]+ )?\n" +
            "jboolean ::= \"true\" | \"false\"\n" +
            "jnull ::= \"null\"\n" +
            "jvalue ::= jobject | jarray | jstring | jnumber | jboolean | jnull\n" +
            "jpair ::= jstring ws \":\" ws jvalue\n" +
            "jobject ::= \"{\" ws ( jpair ( ws \",\" ws jpair )* )? ws \"}\"\n" +
            "jarray ::= \"[\" ws ( jvalue ( ws \",\" ws jvalue )* )? ws \"]\"\n"
    << rules + base
}

pub fn compile_json_schema(schema_json &string) GbnfGrammar {
    gtxt := json_schema_to_gbnf(schema_json) >>>
    << compile(&gtxt) >>>
}
