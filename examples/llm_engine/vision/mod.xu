@vision

#os
#math
#strconv
#errors
#encoding/base64
#encoding/json
#image
#image/png
#image/jpeg
#net/http
#tensor

pub struct VisionConfig {
    pub image_size int
    pub patch_size int
    pub in_channels int
    pub hidden_size int
    pub num_layers int
    pub num_heads int
    pub ffn_dim int
    pub proj_dim int
    pub ln_eps f32
    pub image_mean []f32
    pub image_std []f32
}

pub struct VisionLayer {
    pub ln1_w []f32
    pub ln1_b []f32
    pub wq []f32
    pub bq []f32
    pub wk []f32
    pub bk []f32
    pub wv []f32
    pub bv []f32
    pub wo []f32
    pub bo []f32
    pub ln2_w []f32
    pub ln2_b []f32
    pub w1 []f32
    pub b1 []f32
    pub w2 []f32
    pub b2 []f32
}

pub struct VisionEncoder {
    pub active bool
    pub cfg VisionConfig
    pub patch_w []f32
    pub patch_b []f32
    pub class_embd []f32
    pub pos_emb []f32
    pub pre_ln_w []f32
    pub pre_ln_b []f32
    pub has_pre_ln bool
    pub layers []VisionLayer
    pub post_ln_w []f32
    pub post_ln_b []f32
    pub mm0_w []f32
    pub mm0_b []f32
    pub mm2_w []f32
    pub mm2_b []f32
    pub proj_hidden int
    pub has_mlp2 bool
}

fn alloc_zeros(n int) []f32 {
    $v := []f32{}
    if n > 0 { v.resize_zero(n) }
    << v
}

fn from_bits(b int) f32 { << f32(math.float32_from_bits(b)) }

fn read_u16_le(buf &string, off int) int {
    << buf[off] | (buf[off + 1] << 8)
}

fn read_u32_le(buf &string, off int) int {
    << buf[off] | (buf[off + 1] << 8) | (buf[off + 2] << 16) | (buf[off + 3] << 24)
}

fn read_u64_le(buf &string, off int) int {
    $v := 0
    for i in 0:8 {
        v = v | (buf[off + i] << (i * 8))
    }
    << v
}

fn starts_with(s &string, prefix string) bool {
    if s.len < prefix.len { << false }
    for i in 0:prefix.len {
        if (*s)[i] != prefix[i] { << false }
    }
    << true
}

fn trim_ws(s &string) string {
    $l := 0
    $r := s.len
    while l < r {
        c := (*s)[l] & 255
        if c == 32 || c == 9 || c == 10 || c == 13 { l += 1 } else { <- }
    }
    while r > l {
        c := (*s)[r - 1] & 255
        if c == 32 || c == 9 || c == 10 || c == 13 { r -= 1 } else { <- }
    }
    << (*s)[l:r]
}

fn parse_f64_str(s &string) f64 {
    t := trim_ws(s)
    doc := json.parse(&t)
    if doc.ok() && doc.is_number(doc.root()) {
        << doc.as_f64(doc.root()) >>>
    }
    >>> errors.new("vision: invalid float: " + (*s))
}

fn try_parse_f64_or(s &string, def f64) f64 {
    << parse_f64_str(s) >>> (_) { << def }
}

fn doc_get_or(doc &json.Doc, obj int, key string, def int) int {
    << doc.get(obj, key) >>> (_) { << def }
}

fn doc_str_or(doc &json.Doc, obj int, key string, def string) string {
    if obj < 0 || !doc.is_dict(obj) || !doc.has(obj, key) { << def }
    n := doc.get(obj, key) >>> (_) { << def }
    if doc.is_string(n) { << doc.as_string(n) >>> (_) { << def } }
    << def
}

fn meta_int(doc &json.Doc, meta int, key string) int {
    s := doc.as_string(doc.get(meta, key))
    << strconv.atoi(&s) >>>
}

fn parse_f32_csv(raw &string, count int, default_val f32) []f32 {
    $out := []f32{}
    for _ in 0:count { out.push(default_val) }
    if raw.len == 0 { << out }
    $st := 0
    $idx := 0
    for i in 0:(raw.len + 1) {
        $sep := i == raw.len
        if !sep { sep = ((*raw)[i] & 255) == 44 }
        if sep {
            part := trim_ws(&(*raw)[st:i])
            if part.len > 0 && idx < count {
                fv := parse_f64_str(&part) >>>
                out[idx] = f32(fv)
                idx += 1
            }
            st = i + 1
        }
    }
    << out
}

pub fn empty_encoder() VisionEncoder {
    << VisionEncoder{
        active: false,
        cfg: VisionConfig{
            image_size: 0, patch_size: 0, in_channels: 0, hidden_size: 0,
            num_layers: 0, num_heads: 0, ffn_dim: 0, proj_dim: 0, ln_eps: f32(1e-5),
            image_mean: [f32(0), f32(0), f32(0)],
            image_std: [f32(1), f32(1), f32(1)]
        },
        patch_w: []f32{}, patch_b: []f32{}, class_embd: []f32{}, pos_emb: []f32{},
        pre_ln_w: []f32{}, pre_ln_b: []f32{}, has_pre_ln: false,
        layers: []VisionLayer{}, post_ln_w: []f32{}, post_ln_b: []f32{},
        mm0_w: []f32{}, mm0_b: []f32{}, mm2_w: []f32{}, mm2_b: []f32{},
        proj_hidden: 0, has_mlp2: true
    }
}

fn load_f32_safetensor_flat(data &string, base int, doc &json.Doc, root int, name string, expected_len int) []f32 {
    if !doc.has(root, name + "") {
        >>> errors.new("mmproj missing tensor: " + name)
    }
    entry := doc.get(root, name + "")
    dt := doc.as_string(doc.get(entry, "dtype")) >>>
    if dt != "F32" {
        >>> errors.new("mmproj expects F32 tensor: " + name)
    }
    offs := doc.get(entry, "data_offsets")
    if !doc.is_list(offs) || doc.count(offs) != 2 {
        >>> errors.new("mmproj bad data_offsets for " + name)
    }
    start := doc.as_int(doc.at(offs, 0)) >>>
    stop := doc.as_int(doc.at(offs, 1)) >>>
    if start < 0 || stop < start || stop > data.len - base || (stop - start) != expected_len * 4 {
        >>> errors.new("mmproj byte length mismatch for " + name)
    }
    $out := []f32{}
    out.reserve(expected_len)
    pos_b := base + start
    for i in 0:expected_len {
        out.push(from_bits(read_u32_le(data, pos_b + i * 4)))
    }
    << out
}

fn load_f32_safetensor_opt(data &string, base int, doc &json.Doc, root int, name string, expected_len int) []f32 {
    if !doc.has(root, name + "") {
        << alloc_zeros(expected_len)
    }
    << load_f32_safetensor_flat(data, base, doc, root, name + "", expected_len) >>>
}

struct GgufVisTensor {
    name string
    dims []int
    gtype int
    n_elems int
    offset int
}

fn vis_gguf_read_str(raw &string, pos $&int) string {
    if *pos + 8 > raw.len { >>> errors.new("mmproj.gguf: truncated string length") }
    slen := read_u64_le(raw, *pos)
    *pos += 8
    if slen < 0 || slen > raw.len - *pos { >>> errors.new("mmproj.gguf: truncated string payload") }
    s := (*raw)[(*pos):((*pos) + slen)]
    *pos += slen
    << s
}

fn vis_gguf_scalar_bytes(vtype int) int {
    if vtype == 0 || vtype == 1 || vtype == 7 { << 1 }
    if vtype == 2 || vtype == 3 { << 2 }
    if vtype == 4 || vtype == 5 || vtype == 6 { << 4 }
    if vtype == 10 || vtype == 11 || vtype == 12 { << 8 }
    << -1
}

fn vis_gguf_read_int(raw &string, pos $&int, vtype int) int {
    if vtype == 0 {
        v := (*raw)[*pos] & 255
        *pos += 1
        << v
    }
    if vtype == 1 {
        v := int(i8((*raw)[*pos]))
        *pos += 1
        << v
    }
    if vtype == 2 {
        v := read_u16_le(raw, *pos)
        *pos += 2
        << v
    }
    if vtype == 3 {
        u := read_u16_le(raw, *pos)
        *pos += 2
        if u >= 32768 { << u - 65536 }
        << u
    }
    if vtype == 4 {
        v := read_u32_le(raw, *pos)
        *pos += 4
        << v
    }
    if vtype == 5 {
        u := read_u32_le(raw, *pos)
        *pos += 4
        if u > 0x7fffffff { << u - 0x100000000 }
        << u
    }
    if vtype == 10 || vtype == 11 {
        v := read_u64_le(raw, *pos)
        *pos += 8
        << v
    }
    if vtype == 7 {
        v := (*raw)[*pos] & 255
        *pos += 1
        << v
    }
    >>> errors.new("mmproj.gguf: unexpected int value type " + str(vtype))
}

fn vis_gguf_read_f32(raw &string, pos $&int, vtype int) f32 {
    if vtype == 6 {
        v := from_bits(read_u32_le(raw, *pos))
        *pos += 4
        << v
    }
    if vtype == 12 {
        bits := read_u64_le(raw, *pos)
        *pos += 8
        << f32(math.float64_from_bits(bits))
    }
    iv := vis_gguf_read_int(raw, pos, vtype) >>>
    << f32(iv)
}

fn vis_gguf_skip_val(raw &string, pos $&int, vtype int) int {
    if vtype == 8 {
        _ := vis_gguf_read_str(raw, pos) >>>
        << 0
    }
    if vtype == 9 {
        if *pos + 12 > raw.len { >>> errors.new("mmproj.gguf: truncated array header") }
        etype := read_u32_le(raw, *pos)
        *pos += 4
        cnt := read_u64_le(raw, *pos)
        *pos += 8
        if cnt < 0 { >>> errors.new("mmproj.gguf: negative array length") }
        sb := vis_gguf_scalar_bytes(etype)
        if sb > 0 {
            if cnt > (raw.len - *pos) / sb { >>> errors.new("mmproj.gguf: truncated array") }
            *pos += cnt * sb
            << 0
        }
        for _ in 0:cnt {
            vis_gguf_skip_val(raw, pos, etype) >>>
        }
        << 0
    }
    sb := vis_gguf_scalar_bytes(vtype)
    if sb <= 0 || *pos + sb > raw.len { >>> errors.new("mmproj.gguf: unsupported/truncated metadata value") }
    *pos += sb
    << 0
}

fn vis_gguf_find_tensor(ts &[]GgufVisTensor, name string) int {
    for i in 0:ts.len {
        if ts[i].name == name { << i }
    }
    << -1
}

fn vis_gguf_decode_tensor(raw &string, data_base int, info &GgufVisTensor) []f32 {
    n := info.n_elems
    $out := []f32{}
    if n <= 0 { << out }
    out.reserve(n)
    start := data_base + info.offset
    if info.gtype == 0 {
        if start < 0 || n * 4 > raw.len - start {
            >>> errors.new("mmproj.gguf: truncated F32 tensor " + info.name)
        }
        for i in 0:n {
            out.push(from_bits(read_u32_le(raw, start + i * 4)))
        }
        << out
    }
    if info.gtype == 1 {
        if start < 0 || n * 2 > raw.len - start {
            >>> errors.new("mmproj.gguf: truncated F16 tensor " + info.name)
        }
        for i in 0:n {
            bits := u16(read_u16_le(raw, start + i * 2))
            out.push((tensor.F16{bits: bits}).to_f32())
        }
        << out
    }
    if info.gtype == 30 {
        if start < 0 || n * 2 > raw.len - start {
            >>> errors.new("mmproj.gguf: truncated BF16 tensor " + info.name)
        }
        for i in 0:n {
            bits := u16(read_u16_le(raw, start + i * 2))
            out.push((tensor.BF16{bits: bits}).to_f32())
        }
        << out
    }
    >>> errors.new("mmproj.gguf: unsupported tensor dtype " + str(info.gtype) + " for " + info.name + " (supported: F32/F16/BF16)")
}

fn vis_gguf_load_req(raw &string, data_base int, ts &[]GgufVisTensor, name string, expected_len int) []f32 {
    idx := vis_gguf_find_tensor(ts, "" + name)
    if idx < 0 { >>> errors.new("mmproj.gguf: missing tensor " + name) }
    t := &ts[idx]
    if expected_len > 0 && t.n_elems != expected_len {
        >>> errors.new("mmproj.gguf: tensor length mismatch for " + name + " (got " + str(t.n_elems) + ", expected " + str(expected_len) + ")")
    }
    << vis_gguf_decode_tensor(raw, data_base, t) >>>
}

fn vis_gguf_load_opt(raw &string, data_base int, ts &[]GgufVisTensor, name string, expected_len int, default_val f32) []f32 {
    idx := vis_gguf_find_tensor(ts, "" + name)
    if idx < 0 {
        $v := []f32{}
        if expected_len > 0 { v.reserve(expected_len) }
        for _ in 0:expected_len { v.push(default_val) }
        << v
    }
    t := &ts[idx]
    if expected_len > 0 && t.n_elems != expected_len {
        >>> errors.new("mmproj.gguf: tensor length mismatch for " + name + " (got " + str(t.n_elems) + ", expected " + str(expected_len) + ")")
    }
    << vis_gguf_decode_tensor(raw, data_base, t) >>>
}

fn vis_slice_f32(src &[]f32, off int, n int) []f32 {
    $out := []f32{}
    if n > 0 { out.reserve(n) }
    for i in 0:n { out.push(src[off + i]) }
    << out
}

fn load_mmproj_gguf(raw &string, expected_proj_dim int) VisionEncoder {
    if raw.len < 24 { >>> errors.new("mmproj.gguf: truncated header") }
    ver := read_u32_le(raw, 4)
    if ver < 2 || ver > 3 { >>> errors.new("mmproj.gguf: unsupported version " + str(ver)) }
    n_tensors := read_u64_le(raw, 8)
    n_kv := read_u64_le(raw, 16)
    if n_tensors <= 0 || n_kv < 0 { >>> errors.new("mmproj.gguf: invalid tensor/kv counts") }
    $pos := 24
    $align := 32
    $img_sz := 0
    $patch_sz := 0
    $in_c := 3
    $hid := 0
    $nl := 0
    $nh := 0
    $ffn_d := 0
    $proj_d := 0
    $ln_eps := f32(1e-5)
    $img_mean := [f32(0), f32(0), f32(0)]
    $img_std := [f32(1), f32(1), f32(1)]

    for _ in 0:n_kv {
        k := vis_gguf_read_str(raw, $&pos) >>>
        if pos + 4 > raw.len { >>> errors.new("mmproj.gguf: truncated kv value type") }
        vt := read_u32_le(raw, pos)
        pos += 4
        if k == "general.alignment" {
            a := vis_gguf_read_int(raw, $&pos, vt) >>>
            if a > 0 { align = a }
        } else if k == "clip.vision.image_size" || k == "vision.image_size" {
            img_sz = vis_gguf_read_int(raw, $&pos, vt) >>>
        } else if k == "clip.vision.patch_size" || k == "vision.patch_size" {
            patch_sz = vis_gguf_read_int(raw, $&pos, vt) >>>
        } else if k == "clip.vision.embedding_length" || k == "vision.hidden_size" {
            hid = vis_gguf_read_int(raw, $&pos, vt) >>>
        } else if k == "clip.vision.block_count" || k == "vision.num_layers" {
            nl = vis_gguf_read_int(raw, $&pos, vt) >>>
        } else if k == "clip.vision.attention.head_count" || k == "vision.num_heads" {
            nh = vis_gguf_read_int(raw, $&pos, vt) >>>
        } else if k == "clip.vision.feed_forward_length" || k == "vision.ffn_dim" {
            ffn_d = vis_gguf_read_int(raw, $&pos, vt) >>>
        } else if k == "clip.vision.projection_dim" || k == "vision.proj_dim" {
            proj_d = vis_gguf_read_int(raw, $&pos, vt) >>>
        } else if k == "clip.vision.attention.layer_norm_epsilon" || k == "vision.ln_eps" {
            ln_eps = vis_gguf_read_f32(raw, $&pos, vt) >>>
        } else if (k == "clip.vision.image_mean" || k == "clip.vision.image_std") && vt == 9 {
            etype := read_u32_le(raw, pos)
            pos += 4
            cnt := read_u64_le(raw, pos)
            pos += 8
            $vals := []f32{}
            for _ in 0:cnt {
                fv := vis_gguf_read_f32(raw, $&pos, etype) >>>
                vals.push(fv)
            }
            if k == "clip.vision.image_mean" { img_mean = ~vals }
            else { img_std = ~vals }
        } else {
            vis_gguf_skip_val(raw, $&pos, vt) >>>
        }
    }

    $ts := []GgufVisTensor{}
    ts.reserve(n_tensors)
    for _ in 0:n_tensors {
        tname := vis_gguf_read_str(raw, $&pos) >>>
        if pos + 4 > raw.len { >>> errors.new("mmproj.gguf: truncated tensor ndims") }
        nd := read_u32_le(raw, pos)
        pos += 4
        if nd <= 0 || nd > 4 { >>> errors.new("mmproj.gguf: invalid tensor ndims for " + tname) }
        $dims := []int{}
        $nelems := 1
        for _ in 0:nd {
            if pos + 8 > raw.len { >>> errors.new("mmproj.gguf: truncated tensor dim") }
            d := read_u64_le(raw, pos)
            pos += 8
            dims.push(d)
            nelems = nelems * d
        }
        if pos + 12 > raw.len { >>> errors.new("mmproj.gguf: truncated tensor header") }
        gt := read_u32_le(raw, pos)
        off := read_u64_le(raw, pos + 4)
        pos += 12
        ts.push(GgufVisTensor{name: ~tname, dims: ~dims, gtype: gt, n_elems: nelems, offset: off})
    }
    data_base := ((pos + align - 1) / align) * align
    if data_base > raw.len { >>> errors.new("mmproj.gguf: truncated data section") }

    // Infer dimensions from tensors if metadata omitted them
    pw_i := vis_gguf_find_tensor(&ts, "v.patch_embd.weight")
    if pw_i >= 0 && ts[pw_i].dims.len == 4 {
        if patch_sz <= 0 { patch_sz = ts[pw_i].dims[0] }
        in_c = ts[pw_i].dims[2]
        if hid <= 0 { hid = ts[pw_i].dims[3] }
    }
    if hid <= 0 && pw_i >= 0 && patch_sz > 0 && in_c > 0 {
        hid = ts[pw_i].n_elems / (in_c * patch_sz * patch_sz)
    }
    if nl <= 0 {
        $cnt_l := 0
        while vis_gguf_find_tensor(&ts, "v.blk." + str(cnt_l) + ".ln1.weight") >= 0 { cnt_l += 1 }
        nl = cnt_l
    }
    if ffn_d <= 0 && nl > 0 {
        fu_i := vis_gguf_find_tensor(&ts, "v.blk.0.ffn_up.weight")
        if fu_i >= 0 && hid > 0 { ffn_d = ts[fu_i].n_elems / hid }
    }
    $mm0_i := vis_gguf_find_tensor(&ts, "mm.0.weight")
    $mm0_name := "mm.0.weight"
    $mm0_bname := "mm.0.bias"
    $mm2_name := "mm.2.weight"
    $mm2_bname := "mm.2.bias"
    if mm0_i < 0 {
        mm0_i = vis_gguf_find_tensor(&ts, "mm.a.0.weight")
        if mm0_i >= 0 {
            mm0_name = "mm.a.0.weight"
            mm0_bname = "mm.a.0.bias"
            mm2_name = "mm.a.2.weight"
            mm2_bname = "mm.a.2.bias"
        }
    }
    if mm0_i < 0 { >>> errors.new("mmproj.gguf: missing mm.0.weight projector tensor") }
    $proj_hid := 0
    if ts[mm0_i].dims.len >= 2 { proj_hid = ts[mm0_i].dims[1] }
    else if hid > 0 { proj_hid = ts[mm0_i].n_elems / hid }
    mm2_i := vis_gguf_find_tensor(&ts, "" + mm2_name)
    has_mlp2 := mm2_i >= 0
    if proj_d <= 0 {
        if has_mlp2 && ts[mm2_i].dims.len >= 2 { proj_d = ts[mm2_i].dims[1] }
        else if has_mlp2 && proj_hid > 0 { proj_d = ts[mm2_i].n_elems / proj_hid }
        else { proj_d = proj_hid }
    }
    if img_sz <= 0 && patch_sz > 0 {
        pe_i := vis_gguf_find_tensor(&ts, "v.position_embd.weight")
        if pe_i >= 0 && hid > 0 {
            npos := ts[pe_i].n_elems / hid
            $g := 1
            while g * g < npos - 1 { g += 1 }
            if g * g == npos || g * g == npos - 1 { img_sz = g * patch_sz }
        }
    }
    if img_sz <= 0 || patch_sz <= 0 || img_sz % patch_sz != 0 || in_c <= 0 || hid <= 0 || nl <= 0 || nh <= 0 || hid % nh != 0 || ffn_d <= 0 || proj_hid <= 0 {
        >>> errors.new("mmproj.gguf: invalid or incomplete vision dimensions")
    }
    if expected_proj_dim > 0 && proj_d != expected_proj_dim {
        >>> errors.new("mmproj proj_dim (" + str(proj_d) + ") != model dim (" + str(expected_proj_dim) + ")")
    }
    for ci in 0:img_std.len {
        if f64(img_std[ci]) == 0.0 {
            >>> errors.new("mmproj.gguf: image_std cannot contain 0")
        }
    }

    grid := img_sz / patch_sz
    n_patches := grid * grid
    patch_w := vis_gguf_load_req(raw, data_base, &ts, "v.patch_embd.weight", hid * in_c * patch_sz * patch_sz) >>>
    patch_b := vis_gguf_load_opt(raw, data_base, &ts, "v.patch_embd.bias", hid, f32(0)) >>>
    cls_i := vis_gguf_find_tensor(&ts, "v.class_embd")
    $class_embd := []f32{}
    if cls_i >= 0 {
        class_embd = vis_gguf_load_req(raw, data_base, &ts, "v.class_embd", hid) >>>
    }
    $pos_cnt := n_patches
    pe_idx := vis_gguf_find_tensor(&ts, "v.position_embd.weight")
    if pe_idx >= 0 && hid > 0 && ts[pe_idx].n_elems == (n_patches + 1) * hid {
        pos_cnt = n_patches + 1
        if class_embd.len == 0 { class_embd = alloc_zeros(hid) }
    }
    pos_emb := vis_gguf_load_req(raw, data_base, &ts, "v.position_embd.weight", pos_cnt * hid) >>>
    has_pre_ln := vis_gguf_find_tensor(&ts, "v.pre_ln.weight") >= 0
    pre_ln_w := vis_gguf_load_opt(raw, data_base, &ts, "v.pre_ln.weight", hid, f32(1)) >>>
    pre_ln_b := vis_gguf_load_opt(raw, data_base, &ts, "v.pre_ln.bias", hid, f32(0)) >>>

    $layers := []VisionLayer{}
    for l in 0:nl {
        lp := "v.blk." + str(l) + "."
        ln1_w := vis_gguf_load_req(raw, data_base, &ts, lp + "ln1.weight", hid) >>>
        ln1_b := vis_gguf_load_opt(raw, data_base, &ts, lp + "ln1.bias", hid, f32(0)) >>>
        $wq := []f32{}
        $bq := []f32{}
        $wk := []f32{}
        $bk := []f32{}
        $wv := []f32{}
        $bv := []f32{}
        if vis_gguf_find_tensor(&ts, lp + "attn_q.weight") >= 0 {
            wq = vis_gguf_load_req(raw, data_base, &ts, lp + "attn_q.weight", hid * hid) >>>
            bq = vis_gguf_load_opt(raw, data_base, &ts, lp + "attn_q.bias", hid, f32(0)) >>>
            wk = vis_gguf_load_req(raw, data_base, &ts, lp + "attn_k.weight", hid * hid) >>>
            bk = vis_gguf_load_opt(raw, data_base, &ts, lp + "attn_k.bias", hid, f32(0)) >>>
            wv = vis_gguf_load_req(raw, data_base, &ts, lp + "attn_v.weight", hid * hid) >>>
            bv = vis_gguf_load_opt(raw, data_base, &ts, lp + "attn_v.bias", hid, f32(0)) >>>
        } else if vis_gguf_find_tensor(&ts, lp + "attn_qkv.weight") >= 0 {
            qkv_w := vis_gguf_load_req(raw, data_base, &ts, lp + "attn_qkv.weight", 3 * hid * hid) >>>
            qkv_b := vis_gguf_load_opt(raw, data_base, &ts, lp + "attn_qkv.bias", 3 * hid, f32(0)) >>>
            wq = vis_slice_f32(&qkv_w, 0, hid * hid)
            wk = vis_slice_f32(&qkv_w, hid * hid, hid * hid)
            wv = vis_slice_f32(&qkv_w, 2 * hid * hid, hid * hid)
            bq = vis_slice_f32(&qkv_b, 0, hid)
            bk = vis_slice_f32(&qkv_b, hid, hid)
            bv = vis_slice_f32(&qkv_b, 2 * hid, hid)
        } else {
            >>> errors.new("mmproj.gguf: missing attn_q/attn_qkv weight in layer " + str(l))
        }
        $wo_name := lp + "attn_out.weight"
        $bo_name := lp + "attn_out.bias"
        if vis_gguf_find_tensor(&ts, "" + wo_name) < 0 {
            wo_name = lp + "attn_o.weight"
            bo_name = lp + "attn_o.bias"
        }
        wo := vis_gguf_load_req(raw, data_base, &ts, wo_name, hid * hid) >>>
        bo := vis_gguf_load_opt(raw, data_base, &ts, bo_name, hid, f32(0)) >>>
        ln2_w := vis_gguf_load_req(raw, data_base, &ts, lp + "ln2.weight", hid) >>>
        ln2_b := vis_gguf_load_opt(raw, data_base, &ts, lp + "ln2.bias", hid, f32(0)) >>>

        // Detect llama.cpp CLIP swapped naming vs standard naming by ne[0]/ne[1]:
        // fc1 maps hid -> ffn_d (GGML dims [hid, ffn_d]); fc2 maps ffn_d -> hid (GGML dims [ffn_d, hid]).
        $fc1_wname := lp + "ffn_up.weight"
        $fc1_bname := lp + "ffn_up.bias"
        $fc2_wname := lp + "ffn_down.weight"
        $fc2_bname := lp + "ffn_down.bias"
        down_i := vis_gguf_find_tensor(&ts, lp + "ffn_down.weight")
        if down_i >= 0 && ts[down_i].dims.len >= 2 && ts[down_i].dims[0] == hid && ts[down_i].dims[1] == ffn_d {
            fc1_wname = lp + "ffn_down.weight"
            fc1_bname = lp + "ffn_down.bias"
            fc2_wname = lp + "ffn_up.weight"
            fc2_bname = lp + "ffn_up.bias"
        }
        w1 := vis_gguf_load_req(raw, data_base, &ts, fc1_wname, ffn_d * hid) >>>
        b1 := vis_gguf_load_opt(raw, data_base, &ts, fc1_bname, ffn_d, f32(0)) >>>
        w2 := vis_gguf_load_req(raw, data_base, &ts, fc2_wname, hid * ffn_d) >>>
        b2 := vis_gguf_load_opt(raw, data_base, &ts, fc2_bname, hid, f32(0)) >>>
        layers.push(VisionLayer{
            ln1_w: ~ln1_w, ln1_b: ~ln1_b, wq: ~wq, bq: ~bq, wk: ~wk, bk: ~bk,
            wv: ~wv, bv: ~bv, wo: ~wo, bo: ~bo, ln2_w: ~ln2_w, ln2_b: ~ln2_b,
            w1: ~w1, b1: ~b1, w2: ~w2, b2: ~b2
        })
    }
    post_ln_w := vis_gguf_load_opt(raw, data_base, &ts, "v.post_ln.weight", hid, f32(1)) >>>
    post_ln_b := vis_gguf_load_opt(raw, data_base, &ts, "v.post_ln.bias", hid, f32(0)) >>>
    mm0_w := vis_gguf_load_req(raw, data_base, &ts, mm0_name, proj_hid * hid) >>>
    mm0_b := vis_gguf_load_opt(raw, data_base, &ts, mm0_bname, proj_hid, f32(0)) >>>
    $mm2_w := []f32{}
    $mm2_b := []f32{}
    if has_mlp2 {
        mm2_w = vis_gguf_load_req(raw, data_base, &ts, mm2_name, proj_d * proj_hid) >>>
        mm2_b = vis_gguf_load_opt(raw, data_base, &ts, mm2_bname, proj_d, f32(0)) >>>
    }
    << VisionEncoder{
        active: true,
        cfg: VisionConfig{
            image_size: img_sz, patch_size: patch_sz, in_channels: in_c, hidden_size: hid,
            num_layers: nl, num_heads: nh, ffn_dim: ffn_d, proj_dim: proj_d, ln_eps: ln_eps,
            image_mean: ~img_mean, image_std: ~img_std
        },
        patch_w: ~patch_w, patch_b: ~patch_b, class_embd: ~class_embd, pos_emb: ~pos_emb,
        pre_ln_w: ~pre_ln_w, pre_ln_b: ~pre_ln_b, has_pre_ln: has_pre_ln,
        layers: ~layers, post_ln_w: ~post_ln_w, post_ln_b: ~post_ln_b,
        mm0_w: ~mm0_w, mm0_b: ~mm0_b, mm2_w: ~mm2_w, mm2_b: ~mm2_b,
        proj_hidden: proj_hid, has_mlp2: has_mlp2
    }
}

pub fn load_mmproj(path string, expected_proj_dim int) VisionEncoder {
    raw := os.read(path + "") >>>
    if raw.len >= 4 && (raw[0] & 255) == 71 && (raw[1] & 255) == 71 && (raw[2] & 255) == 85 && (raw[3] & 255) == 70 {
        << load_mmproj_gguf(&raw, expected_proj_dim) >>>
    }
    if raw.len < 8 { >>> errors.new("mmproj: invalid safetensors file") }
    hlen := read_u64_le(&raw, 0)
    if hlen <= 0 || hlen > raw.len - 8 { >>> errors.new("mmproj: invalid safetensors header") }
    base := 8 + hlen
    hstr := raw[8:base]
    doc := json.parse(&hstr) >>>
    root := doc.root()
    if !doc.is_dict(root) { >>> errors.new("mmproj: invalid safetensors JSON") }
    meta := doc_get_or(&doc, root, "__metadata__", -1)
    if meta < 0 || !doc.is_dict(meta) { >>> errors.new("mmproj: missing __metadata__") }
    img_sz := meta_int(&doc, meta, "vision.image_size") >>>
    patch_sz := meta_int(&doc, meta, "vision.patch_size") >>>
    in_c := meta_int(&doc, meta, "vision.in_channels") >>>
    hid := meta_int(&doc, meta, "vision.hidden_size") >>>
    nl := meta_int(&doc, meta, "vision.num_layers") >>>
    nh := meta_int(&doc, meta, "vision.num_heads") >>>
    ffn_d := meta_int(&doc, meta, "vision.ffn_dim") >>>
    proj_d := meta_int(&doc, meta, "vision.proj_dim") >>>
    ln_eps_f := f32(try_parse_f64_or(&doc_str_or(&doc, meta, "vision.ln_eps", "1e-5"), 0.00001))
    if img_sz <= 0 || patch_sz <= 0 || img_sz % patch_sz != 0 || in_c <= 0 || hid <= 0 || nl <= 0 || nh <= 0 || hid % nh != 0 || ffn_d <= 0 {
        >>> errors.new("mmproj: invalid vision dimensions in metadata")
    }
    if expected_proj_dim > 0 && proj_d != expected_proj_dim {
        >>> errors.new("mmproj proj_dim (" + str(proj_d) + ") != model dim (" + str(expected_proj_dim) + ")")
    }
    mean_s := doc_str_or(&doc, meta, "vision.image_mean", "")
    std_s := doc_str_or(&doc, meta, "vision.image_std", "")
    img_mean := parse_f32_csv(&mean_s, in_c, f32(0.0)) >>>
    img_std := parse_f32_csv(&std_s, in_c, f32(1.0)) >>>
    for ci in 0:img_std.len {
        if f64(img_std[ci]) == 0.0 {
            >>> errors.new("mmproj: vision.image_std cannot contain 0")
        }
    }

    grid := img_sz / patch_sz
    n_patches := grid * grid
    patch_w := load_f32_safetensor_flat(&raw, base, &doc, root, "v.patch_embd.weight", hid * in_c * patch_sz * patch_sz) >>>
    patch_b := load_f32_safetensor_opt(&raw, base, &doc, root, "v.patch_embd.bias", hid) >>>
    pos_emb := load_f32_safetensor_flat(&raw, base, &doc, root, "v.position_embd.weight", n_patches * hid) >>>
    $layers := []VisionLayer{}
    for l in 0:nl {
        lp := "v.blk." + str(l) + "."
        layers.push(VisionLayer{
            ln1_w: load_f32_safetensor_flat(&raw, base, &doc, root, lp + "ln1_w", hid) >>>,
            ln1_b: load_f32_safetensor_opt(&raw, base, &doc, root, lp + "ln1_b", hid) >>>,
            wq: load_f32_safetensor_flat(&raw, base, &doc, root, lp + "wq", hid * hid) >>>,
            bq: load_f32_safetensor_opt(&raw, base, &doc, root, lp + "bq", hid) >>>,
            wk: load_f32_safetensor_flat(&raw, base, &doc, root, lp + "wk", hid * hid) >>>,
            bk: load_f32_safetensor_opt(&raw, base, &doc, root, lp + "bk", hid) >>>,
            wv: load_f32_safetensor_flat(&raw, base, &doc, root, lp + "wv", hid * hid) >>>,
            bv: load_f32_safetensor_opt(&raw, base, &doc, root, lp + "bv", hid) >>>,
            wo: load_f32_safetensor_flat(&raw, base, &doc, root, lp + "wo", hid * hid) >>>,
            bo: load_f32_safetensor_opt(&raw, base, &doc, root, lp + "bo", hid) >>>,
            ln2_w: load_f32_safetensor_flat(&raw, base, &doc, root, lp + "ln2_w", hid) >>>,
            ln2_b: load_f32_safetensor_opt(&raw, base, &doc, root, lp + "ln2_b", hid) >>>,
            w1: load_f32_safetensor_flat(&raw, base, &doc, root, lp + "w1", ffn_d * hid) >>>,
            b1: load_f32_safetensor_opt(&raw, base, &doc, root, lp + "b1", ffn_d) >>>,
            w2: load_f32_safetensor_flat(&raw, base, &doc, root, lp + "w2", hid * ffn_d) >>>,
            b2: load_f32_safetensor_opt(&raw, base, &doc, root, lp + "b2", hid) >>>
        })
    }
    post_ln_w := load_f32_safetensor_opt(&raw, base, &doc, root, "v.post_ln_w", hid) >>>
    post_ln_b := load_f32_safetensor_opt(&raw, base, &doc, root, "v.post_ln_b", hid) >>>
    mm0_w := load_f32_safetensor_flat(&raw, base, &doc, root, "mm.0.weight", proj_d * hid) >>>
    mm0_b := load_f32_safetensor_opt(&raw, base, &doc, root, "mm.0.bias", proj_d) >>>
    mm2_w := load_f32_safetensor_flat(&raw, base, &doc, root, "mm.2.weight", proj_d * proj_d) >>>
    mm2_b := load_f32_safetensor_opt(&raw, base, &doc, root, "mm.2.bias", proj_d) >>>
    << VisionEncoder{
        active: true,
        cfg: VisionConfig{
            image_size: img_sz, patch_size: patch_sz, in_channels: in_c, hidden_size: hid,
            num_layers: nl, num_heads: nh, ffn_dim: ffn_d, proj_dim: proj_d, ln_eps: ln_eps_f,
            image_mean: ~img_mean, image_std: ~img_std
        },
        patch_w: ~patch_w, patch_b: ~patch_b, class_embd: []f32{}, pos_emb: ~pos_emb,
        pre_ln_w: []f32{}, pre_ln_b: []f32{}, has_pre_ln: false,
        layers: ~layers, post_ln_w: ~post_ln_w, post_ln_b: ~post_ln_b,
        mm0_w: ~mm0_w, mm0_b: ~mm0_b, mm2_w: ~mm2_w, mm2_b: ~mm2_b,
        proj_hidden: proj_d, has_mlp2: true
    }
}

fn resize_chw_bilinear(src &[]f32, src_c int, src_h int, src_w int, dst_c int, dst_h int, dst_w int) []f32 {
    if src_c == dst_c && src_h == dst_h && src_w == dst_w && src.len == dst_c * dst_h * dst_w {
        $cp := alloc_zeros(src.len)
        for i in 0:src.len { cp[i] = src[i] }
        << cp
    }
    $out := alloc_zeros(dst_c * dst_h * dst_w)
    src_hw := src_h * src_w
    dst_hw := dst_h * dst_w
    for c in 0:dst_c {
        $sc := c
        if sc >= src_c { sc = src_c - 1 }
        if sc < 0 { sc = 0 }
        sbase := sc * src_hw
        dbase := c * dst_hw
        for y in 0:dst_h {
            $sy := ((f64(y) + 0.5) * f64(src_h) / f64(dst_h)) - 0.5
            if sy < 0.0 { sy = 0.0 }
            $max_y := f64(src_h - 1)
            if sy > max_y { sy = max_y }
            y0 := int(sy)
            $y1 := y0 + 1
            if y1 >= src_h { y1 = src_h - 1 }
            wy := sy - f64(y0)
            wy0 := 1.0 - wy
            for x in 0:dst_w {
                $sx := ((f64(x) + 0.5) * f64(src_w) / f64(dst_w)) - 0.5
                if sx < 0.0 { sx = 0.0 }
                $max_x := f64(src_w - 1)
                if sx > max_x { sx = max_x }
                x0 := int(sx)
                $x1 := x0 + 1
                if x1 >= src_w { x1 = src_w - 1 }
                wx := sx - f64(x0)
                wx0 := 1.0 - wx
                p00 := f64(src[sbase + y0 * src_w + x0])
                p01 := f64(src[sbase + y0 * src_w + x1])
                p10 := f64(src[sbase + y1 * src_w + x0])
                p11 := f64(src[sbase + y1 * src_w + x1])
                top := p00 * wx0 + p01 * wx
                bot := p10 * wx0 + p11 * wx
                out[dbase + y * dst_w + x] = f32(top * wy0 + bot * wy)
            }
        }
    }
    << out
}

fn rgba_to_chw(img &image.RGBA) []f32 {
    w := img.rect.dx()
    h := img.rect.dy()
    if w <= 0 || h <= 0 {
        >>> errors.new("vision: decoded empty image dimensions")
    }
    hw := w * h
    $chw := alloc_zeros(3 * hw)
    inv_255 := 1.0 / 255.0
    for y in 0:h {
        for x in 0:w {
            c := img.at_rgba(img.rect.min.x + x, img.rect.min.y + y)
            idx := y * w + x
            chw[idx] = f32(f64(c.r & 255) * inv_255)
            chw[hw + idx] = f32(f64(c.g & 255) * inv_255)
            chw[2 * hw + idx] = f32(f64(c.b & 255) * inv_255)
        }
    }
    << chw
}

fn normalize_chw_inplace(chw $&[]f32, channels int, hw int, mean &[]f32, std &[]f32) {
    $is_ident := true
    for c in 0:channels {
        $mv := 0.0
        $sv := 1.0
        if c < mean.len { mv = f64(mean[c]) }
        if c < std.len { sv = f64(std[c]) }
        if mv != 0.0 || sv != 1.0 { is_ident = false }
    }
    if is_ident { << }
    for c in 0:channels {
        $mv := 0.0
        $sv := 1.0
        if c < mean.len { mv = f64(mean[c]) }
        if c < std.len { sv = f64(std[c]) }
        inv_s := 1.0 / sv
        base := c * hw
        for i in 0:hw {
            chw[base + i] = f32((f64(chw[base + i]) - mv) * inv_s)
        }
    }
}

fn ppm_next_token(raw &string, pos $&int) string {
    for {
        while *pos < raw.len {
            ch := (*raw)[*pos] & 255
            if ch == 35 {
                while *pos < raw.len && ((*raw)[*pos] & 255) != 10 { *pos += 1 }
            } else if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                *pos += 1
            } else {
                <-
            }
        }
        <-
    }
    start := *pos
    while *pos < raw.len {
        ch := (*raw)[*pos] & 255
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 || ch == 35 { <- }
        *pos += 1
    }
    << (*raw)[start:(*pos)]
}

fn decode_image_bytes(raw &string, target_c int, target_h int, target_w int) []f32 {
    if raw.len >= 8 && (raw[0] & 255) == 137 && (raw[1] & 255) == 80 && (raw[2] & 255) == 78 && (raw[3] & 255) == 71 {
        img := png.decode(raw) >>>
        chw := rgba_to_chw(&img) >>>
        << resize_chw_bilinear(&chw, 3, img.rect.dy(), img.rect.dx(), target_c, target_h, target_w)
    }
    if raw.len >= 4 && (raw[0] & 255) == 255 && (raw[1] & 255) == 216 {
        img := jpeg.decode(raw) >>>
        chw := rgba_to_chw(&img) >>>
        << resize_chw_bilinear(&chw, 3, img.rect.dy(), img.rect.dx(), target_c, target_h, target_w)
    }
    if raw.len >= 3 && (raw[0] & 255) == 80 && ((raw[1] & 255) == 54 || (raw[1] & 255) == 51) {
        is_p6 := (raw[1] & 255) == 54
        $pos := 2
        ws := ppm_next_token(raw, $&pos)
        hs := ppm_next_token(raw, $&pos)
        ms := ppm_next_token(raw, $&pos)
        w := strconv.atoi(&ws) >>>
        h := strconv.atoi(&hs) >>>
        maxv := strconv.atoi(&ms) >>>
        if w <= 0 || h <= 0 || maxv <= 0 {
            >>> errors.new("image: invalid PPM dimensions")
        }
        $chw := alloc_zeros(3 * w * h)
        hw := w * h
        inv_m := 1.0 / f64(maxv)
        if is_p6 {
            if pos < raw.len { pos += 1 }
            if pos + hw * 3 > raw.len {
                >>> errors.new("image: truncated P6 PPM pixel payload")
            }
            for i in 0:hw {
                p := pos + i * 3
                chw[i] = f32(f64((*raw)[p] & 255) * inv_m)
                chw[hw + i] = f32(f64((*raw)[p + 1] & 255) * inv_m)
                chw[2 * hw + i] = f32(f64((*raw)[p + 2] & 255) * inv_m)
            }
        } else {
            for i in 0:hw {
                rs := ppm_next_token(raw, $&pos)
                gs := ppm_next_token(raw, $&pos)
                bs := ppm_next_token(raw, $&pos)
                rv := strconv.atoi(&rs) >>>
                gv := strconv.atoi(&gs) >>>
                bv := strconv.atoi(&bs) >>>
                chw[i] = f32(f64(rv) * inv_m)
                chw[hw + i] = f32(f64(gv) * inv_m)
                chw[2 * hw + i] = f32(f64(bv) * inv_m)
            }
        }
        << resize_chw_bilinear(&chw, 3, h, w, target_c, target_h, target_w)
    }
    if raw.len >= 54 && (raw[0] & 255) == 66 && (raw[1] & 255) == 77 {
        pix_off := read_u32_le(raw, 10)
        w := read_u32_le(raw, 18)
        raw_h := read_u32_le(raw, 22)
        $h := raw_h
        $top_down := false
        if raw_h > 0x7fffffff {
            h = (0x100000000 - raw_h) & 0x7fffffff
            top_down = true
        }
        bpp := read_u16_le(raw, 28)
        comp := read_u32_le(raw, 30)
        if w <= 0 || h <= 0 || bpp != 24 || comp != 0 {
            >>> errors.new("image: BMP requires uncompressed 24-bit RGB")
        }
        stride := ((w * 3 + 3) / 4) * 4
        if pix_off < 0 || pix_off + stride * h > raw.len {
            >>> errors.new("image: truncated BMP payload")
        }
        $chw := alloc_zeros(3 * w * h)
        hw := w * h
        inv_255 := 1.0 / 255.0
        for row in 0:h {
            $src_row := row
            if !top_down { src_row = (h - 1) - row }
            r_off := pix_off + src_row * stride
            for col in 0:w {
                p := r_off + col * 3
                b := (*raw)[p] & 255
                g := (*raw)[p + 1] & 255
                r := (*raw)[p + 2] & 255
                idx := row * w + col
                chw[idx] = f32(f64(r) * inv_255)
                chw[hw + idx] = f32(f64(g) * inv_255)
                chw[2 * hw + idx] = f32(f64(b) * inv_255)
            }
        }
        << resize_chw_bilinear(&chw, 3, h, w, target_c, target_h, target_w)
    }
    >>> errors.new("image: unsupported format (expected PNG, JPEG, PPM P6/P3, uncompressed 24-bit BMP, data: URI, http(s):// URL, or rgb:)")
}

fn load_image_rgb_chw(spec &string, cfg &VisionConfig) []f32 {
    target_c := cfg.in_channels
    target_h := cfg.image_size
    target_w := cfg.image_size
    $chw := []f32{}
    if starts_with(spec, "rgb:") {
        rest := (*spec)[4:spec.len]
        $parts := []string{}
        $st := 0
        for i in 0:(rest.len + 1) {
            if i == rest.len || (rest[i] & 255) == 44 {
                parts.push(rest[st:i])
                st = i + 1
            }
        }
        if parts.len < 3 { >>> errors.new("image rgb: spec requires rgb:W,H,v0,...") }
        w := strconv.atoi(&parts[0]) >>>
        h := strconv.atoi(&parts[1]) >>>
        expected := target_c * h * w
        if w <= 0 || h <= 0 || parts.len - 2 != expected {
            >>> errors.new("image rgb: pixel count mismatch")
        }
        $raw_chw := []f32{}
        raw_chw.reserve(expected)
        for pi in 2:parts.len {
            v := parse_f64_str(&parts[pi]) >>>
            raw_chw.push(f32(v))
        }
        chw = resize_chw_bilinear(&raw_chw, target_c, h, w, target_c, target_h, target_w)
    } else if starts_with(spec, "data:") {
        $comma := -1
        for i in 0:spec.len {
            if ((*spec)[i] & 255) == 44 {
                comma = i
                <-
            }
        }
        if comma < 0 { >>> errors.new("image data URI missing comma") }
        b64 := (*spec)[(comma + 1):spec.len]
        decoded := base64.decode_string(b64) >>>
        chw = decode_image_bytes(&decoded, target_c, target_h, target_w) >>>
    } else if starts_with(spec, "http://") || starts_with(spec, "https://") {
        $hc := http.new_client()
        resp := hc.get((*spec) + "") >>>
        if resp.status_code != 200 {
            >>> errors.new("image HTTP " + str(resp.status_code) + ": " + (*spec))
        }
        body := resp.body()
        chw = decode_image_bytes(&body, target_c, target_h, target_w) >>>
    } else {
        bytes := os.read((*spec) + "") >>>
        chw = decode_image_bytes(&bytes, target_c, target_h, target_w) >>>
    }
    normalize_chw_inplace($&chw, target_c, target_h * target_w, &cfg.image_mean, &cfg.image_std)
    << chw
}

fn vision_layernorm_rows(out $&[]f32, x &[]f32, w &[]f32, b &[]f32, rows int, dim int, eps f64) {
    $in_row := alloc_zeros(dim)
    $out_row := alloc_zeros(dim)
    for r in 0:rows {
        off := r * dim
        for i in 0:dim { in_row[i] = x[off + i] }
        tensor.layernorm_f32($&out_row, &in_row, w, b, dim, eps)
        for i in 0:dim { out[off + i] = out_row[i] }
    }
}

fn vision_linear_rows(out $&[]f32, x &[]f32, w &[]f32, b &[]f32, rows int, out_d int, in_d int) {
    for r in 0:rows {
        x_off := r * in_d
        o_off := r * out_d
        for oi in 0:out_d {
            w_off := oi * in_d
            $acc := f64(b[oi])
            for ii in 0:in_d {
                acc += f64(x[x_off + ii]) * f64(w[w_off + ii])
            }
            out[o_off + oi] = f32(acc)
        }
    }
}

pub fn encode_image(ve &VisionEncoder, img_chw &[]f32) []f32 {
    cfg := &ve.cfg
    grid := cfg.image_size / cfg.patch_size
    n_patches := grid * grid
    hid := cfg.hidden_size
    ffn_d := cfg.ffn_dim
    proj_d := cfg.proj_dim
    $proj_hid := ve.proj_hidden
    if proj_hid <= 0 { proj_hid = proj_d }
    head_dim := hid / cfg.num_heads
    eps := f64(cfg.ln_eps)

    $patch_out := alloc_zeros(n_patches * hid)
    tensor.conv2d_patch_embed_f32($&patch_out, img_chw, &ve.patch_w, &ve.patch_b, cfg.in_channels, cfg.image_size, cfg.image_size, hid, cfg.patch_size)
    has_cls := ve.class_embd.len == hid && ve.pos_emb.len == (n_patches + 1) * hid
    $n_seq := n_patches
    if has_cls { n_seq = n_patches + 1 }
    $h := alloc_zeros(n_seq * hid)
    if has_cls {
        for i in 0:hid { h[i] = ve.class_embd[i] + ve.pos_emb[i] }
        for i in 0:(n_patches * hid) { h[hid + i] = patch_out[i] + ve.pos_emb[hid + i] }
    } else {
        for i in 0:(n_patches * hid) { h[i] = patch_out[i] + ve.pos_emb[i] }
    }

    $norm_buf := alloc_zeros(n_seq * hid)
    if ve.has_pre_ln {
        vision_layernorm_rows($&norm_buf, &h, &ve.pre_ln_w, &ve.pre_ln_b, n_seq, hid, eps)
        for i in 0:(n_seq * hid) { h[i] = norm_buf[i] }
    }
    $q := alloc_zeros(n_seq * hid)
    $k := alloc_zeros(n_seq * hid)
    $v := alloc_zeros(n_seq * hid)
    $attn := alloc_zeros(n_seq * hid)
    $proj := alloc_zeros(n_seq * hid)
    $fc1 := alloc_zeros(n_seq * ffn_d)
    $fc1_act := alloc_zeros(n_seq * ffn_d)

    for l in 0:ve.layers.len {
        vl := &ve.layers[l]
        vision_layernorm_rows($&norm_buf, &h, &vl.ln1_w, &vl.ln1_b, n_seq, hid, eps)
        vision_linear_rows($&q, &norm_buf, &vl.wq, &vl.bq, n_seq, hid, hid)
        vision_linear_rows($&k, &norm_buf, &vl.wk, &vl.bk, n_seq, hid, hid)
        vision_linear_rows($&v, &norm_buf, &vl.wv, &vl.bv, n_seq, hid, hid)
        tensor.mha_sdpa_f32($&attn, &q, &k, &v, n_seq, n_seq, cfg.num_heads, head_dim, false)
        vision_linear_rows($&proj, &attn, &vl.wo, &vl.bo, n_seq, hid, hid)
        for i in 0:(n_seq * hid) { h[i] = h[i] + proj[i] }

        vision_layernorm_rows($&norm_buf, &h, &vl.ln2_w, &vl.ln2_b, n_seq, hid, eps)
        vision_linear_rows($&fc1, &norm_buf, &vl.w1, &vl.b1, n_seq, ffn_d, hid)
        tensor.gelu_f32($&fc1_act, &fc1, n_seq * ffn_d)
        vision_linear_rows($&proj, &fc1_act, &vl.w2, &vl.b2, n_seq, hid, ffn_d)
        for i in 0:(n_seq * hid) { h[i] = h[i] + proj[i] }
    }

    vision_layernorm_rows($&norm_buf, &h, &ve.post_ln_w, &ve.post_ln_b, n_seq, hid, eps)
    $post_patches := alloc_zeros(n_patches * hid)
    $cls_off := 0
    if has_cls { cls_off = hid }
    for i in 0:(n_patches * hid) { post_patches[i] = norm_buf[cls_off + i] }

    $mm1 := alloc_zeros(n_patches * proj_hid)
    vision_linear_rows($&mm1, &post_patches, &ve.mm0_w, &ve.mm0_b, n_patches, proj_hid, hid)
    if !ve.has_mlp2 {
        << mm1
    }
    $mm1_act := alloc_zeros(n_patches * proj_hid)
    $out := alloc_zeros(n_patches * proj_d)
    tensor.gelu_f32($&mm1_act, &mm1, n_patches * proj_hid)
    vision_linear_rows($&out, &mm1_act, &ve.mm2_w, &ve.mm2_b, n_patches, proj_d, proj_hid)
    << out
}

pub fn encode_spec_list(ve &VisionEncoder, specs &[]string) [][]f32 {
    if !ve.active { >>> errors.new("vision encoder not loaded (pass --mmproj)") }
    $out := [][]f32{}
    out.reserve(specs.len)
    for i in 0:specs.len {
        img := load_image_rgb_chw(&specs[i], &ve.cfg) >>>
        emb := encode_image(ve, &img)
        out.push(~emb)
    }
    << out
}

pub fn encode_specs(ve &VisionEncoder, specs &[]string) []f32 {
    parts := encode_spec_list(ve, specs) >>>
    $all := []f32{}
    for pi in 0:parts.len {
        p := &parts[pi]
        for j in 0:p.len { all.push(p[j]) }
    }
    << all
}
