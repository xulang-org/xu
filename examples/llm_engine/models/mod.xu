@models

#os
#errors
#net/http

fn starts_with(s &string, prefix string) bool {
    if s.len < prefix.len { << false }
    for i in 0:prefix.len {
        if (*s)[i] != prefix[i] { << false }
    }
    << true
}

fn is_safe_model_name(name &string) bool {
    if name.len == 0 { << false }
    for i in 0:name.len {
        ch := (*name)[i] & 255
        if ch == 47 || ch == 92 || ch == 0 { << false }
    }
    if *name == "." || *name == ".." { << false }
    << true
}

fn split_lines_trim(text &string) []string {
    $out := []string{}
    $start := 0
    for i in 0:(text.len + 1) {
        $is_nl := i == text.len
        if !is_nl { is_nl = ((*text)[i] & 255) == 10 }
        if is_nl {
            $end := i
            while end > start && ((*text)[end - 1] & 255) == 13 { end -= 1 }
            while start < end && (((*text)[start] & 255) == 32 || ((*text)[start] & 255) == 9) { start += 1 }
            while end > start && (((*text)[end - 1] & 255) == 32 || ((*text)[end - 1] & 255) == 9) { end -= 1 }
            if end > start {
                out.push((*text)[start:end])
            }
            start = i + 1
        }
    }
    << out
}

pub fn default_models_dir(override_dir &string) string {
    if override_dir.len > 0 { << (*override_dir) + "" }
    env_dir := os.getenv("XU_MODELS_DIR")
    if env_dir.len > 0 { << env_dir }
    home := os.getenv("HOME")
    if home.len > 0 { << home + "/.xu/models" }
    << ".xu/models"
}

pub fn resolve_pull_url(src &string) string {
    if !starts_with(src, "hf://") { << (*src) + "" }
    rest := (*src)[5:src.len]
    $s1 := -1
    $s2 := -1
    for i in 0:rest.len {
        if (rest[i] & 255) == 47 {
            if s1 < 0 {
                s1 = i
            } else if s2 < 0 {
                s2 = i
                <-
            }
        }
    }
    if s1 <= 0 || s2 <= s1 + 1 || s2 + 1 >= rest.len { << (*src) + "" }
    repo := rest[0:s2]
    fpath := rest[(s2 + 1):rest.len]
    $base := os.getenv("XU_HF_BASE_URL")
    if base.len == 0 { base = "https://huggingface.co" }
    while base.len > 0 && (base[base.len - 1] & 255) == 47 {
        base = base[0:(base.len - 1)]
    }
    << base + "/" + repo + "/resolve/main/" + fpath
}

pub fn run_models_cmd(args &[]string, models_dir_arg &string) int {
    if args.len < 2 {
        eprintln("usage: llm_engine models <list|rm|pull> ... [--models-dir DIR]")
        << 1
    }
    sub := args[1] + ""
    mdir := default_models_dir(models_dir_arg)
    if sub == "list" {
        if !os.is_dir(mdir + "") {
            println("models_dir:" + mdir)
            println("count:0")
            << 0
        }
        listing := os.read_dir(mdir + "") >>> (err) {
            eprintln("models list error: " + err.msg())
            << 1
        }
        entries := split_lines_trim(&listing)
        println("models_dir:" + mdir)
        $cnt := 0
        for i in 0:entries.len {
            en := &entries[i]
            if *en == "." || *en == ".." || en.len == 0 { -> }
            fp := mdir + "/" + (*en)
            info := os.stat(fp + "") >>> (err) { -> }
            if info.is_dir {
                println("model:" + (*en) + " kind:dir")
            } else {
                println("model:" + (*en) + " bytes:" + str(info.size))
            }
            cnt += 1
        }
        println("count:" + str(cnt))
        << 0
    }
    if sub == "rm" {
        if args.len < 3 {
            eprintln("usage: llm_engine models rm <name> [--models-dir DIR]")
            << 1
        }
        mname := args[2] + ""
        if !is_safe_model_name(&mname) {
            eprintln("invalid model name: " + mname)
            << 1
        }
        fp := mdir + "/" + mname
        _ := os.remove(fp) >>> (err) {
            eprintln("models rm error: " + err.msg())
            << 1
        }
        println("removed:" + mname)
        << 0
    }
    if sub == "pull" {
        if args.len < 4 {
            eprintln("usage: llm_engine models pull <url|hf://org/repo/file> <local_name> [--models-dir DIR]")
            << 1
        }
        src_spec := args[2] + ""
        mname := args[3] + ""
        if !is_safe_model_name(&mname) {
            eprintln("invalid model name: " + mname)
            << 1
        }
        url := resolve_pull_url(&src_spec)
        _ := os.mkdir_all(mdir + "") >>> (err) {
            eprintln("mkdir error: " + err.msg())
            << 1
        }
        $hc := http.new_client()
        resp := hc.get(url) >>> (err) {
            eprintln("models pull error: " + err.msg())
            << 1
        }
        if resp.status_code != 200 {
            eprintln("models pull HTTP " + str(resp.status_code))
            << 1
        }
        dest := mdir + "/" + mname
        body := resp.body()
        _ := os.write(dest + "", body + "") >>> (err) {
            eprintln("models write error: " + err.msg())
            << 1
        }
        println("pulled:" + dest + " bytes:" + str(body.len))
        << 0
    }
    eprintln("unknown models subcommand: " + sub)
    << 1
}
