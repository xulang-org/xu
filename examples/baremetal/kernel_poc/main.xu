@main
$freestanding

#core/arch
#core/mem
#core/sync
#core/task
#core/virtio

// Minimal Baremetal Kernel for x86_64 / AArch64 / RISC-V 64 targets.
// Demonstrates Stage 1, Stage 2, Stage 3, and Stage 4 Features:
// 1. Raw pointers (*raw T) and explicit unsafe blocks
// 2. Precise memory layout (@repr("C", align: 4096), @repr("C", packed))
// 3. Typed volatile MMIO (volatile_write / volatile_read)
// 4. Zero-allocation core modules (#core/arch, #core/mem, #core/sync, #core/task)
// 5. RAII zero-GC deterministic synchronization (Spinlock, IrqSpinlock)
// 6. Multi-task context switching (switch_context)
// 7. Interrupt Descriptor Table (IDT), PIC 8259 remap, PIT 8254 Timer & TrapFrame
// 8. Control register access (read_cr3, read_cr2) and port I/O (in8, out8)

// 4KB aligned Page Table (PML4 / Page Directory)
@repr("C", align: 4096)
pub struct PageTable {
    pub pte0 u64
    pub pte1 u64
    pub pte2 u64
    pub pte3 u64
}

// Packed hardware network packet / frame header (zero padding)
@repr("C", packed)
pub struct EthernetHeader {
    pub dst_mac0 u8
    pub dst_mac1 u8
    pub dst_mac2 u8
    pub dst_mac3 u8
    pub dst_mac4 u8
    pub dst_mac5 u8
    pub ethertype u16
}

// Fixed memory layout offsets for the Kernel Scheduler
const SCHED_BASE = 0x00200000
const SCHED_MAIN_CTX_OFF = 0
const SCHED_TASK1_CTX_OFF = 192
const SCHED_TASK2_CTX_OFF = 384
const SCHED_STEP_OFF = 576

const STACK1_TOP = 0x00211000
const STACK2_TOP = 0x00221000

// Serial port UART COM1 (0x03F8)
const UART_COM1 = 0x03F8

fn uart_putc(c int) {
    uart := UART_COM1 as *raw u8
    volatile_write(uart, u8(c))
}

fn uart_print(msg string) {
    $i := 0
    while i < msg.len {
        uart_putc(int(msg[i]))
        i = i + 1
    }
}

fn timer_interrupt_isr() {
    arch.pic_eoi(0)
}

fn task_worker_1() {
    uart_print("[TASK 1] Worker 1 active on CPU!\n")

    // Demonstrate RAII IrqSpinlock (zero-GC auto-unlock & IRQ restore)
    $irq_lock := sync.irq_spinlock_new()
    if true {
        guard := irq_lock.acquire()
        uart_print("[TASK 1] Acquired IrqSpinlock inside critical section.\n")
        // guard automatically dropped here on scope exit!
    }
    uart_print("[TASK 1] Exited critical section; IrqSpinlock auto-released.\n")

    // Update scheduler step and switch to Task 2
    unsafe {
        p1 := (SCHED_BASE + SCHED_TASK1_CTX_OFF) as *raw task.TaskContext
        p2 := (SCHED_BASE + SCHED_TASK2_CTX_OFF) as *raw task.TaskContext
        p_step := (SCHED_BASE + SCHED_STEP_OFF) as *raw int
        *p_step = 1
        uart_print("[TASK 1] Yielding execution to Task 2...\n")
        task.switch_context(p1, p2)
    }

    // Task 1 should not be re-entered in this test
    while true {
        arch.halt()
    }
}

fn task_worker_2() {
    uart_print("[TASK 2] Worker 2 active on CPU!\n")

    // Demonstrate RAII Spinlock
    $lock := sync.spinlock_new()
    if true {
        guard := lock.acquire()
        uart_print("[TASK 2] Acquired Spinlock with RAII SpinGuard.\n")
        // guard automatically dropped here!
    }
    uart_print("[TASK 2] Spinlock auto-released via deterministic drop().\n")

    // Update scheduler step and switch back to Main task
    unsafe {
        p2 := (SCHED_BASE + SCHED_TASK2_CTX_OFF) as *raw task.TaskContext
        pm := (SCHED_BASE + SCHED_MAIN_CTX_OFF) as *raw task.TaskContext
        p_step := (SCHED_BASE + SCHED_STEP_OFF) as *raw int
        *p_step = 2
        uart_print("[TASK 2] Yielding execution back to Main kernel...\n")
        task.switch_context(p2, pm)
    }

    while true {
        arch.halt()
    }
}

fn main() int {
    // 1. Disable interrupts during initialization
    arch.cli()

    // 2. Output boot banner over serial port
    uart_print("\n")
    uart_print("====================================================\n")
    uart_print("  Welcome to Xu Operating System (Baremetal Kernel) \n")
    uart_print("  Stage 3: Preemptive Multitasking & Synchronization\n")
    uart_print("====================================================\n")
    uart_print("[XU KERNEL] Booting in Freestanding Mode (no_std)...\n")

    // 3. Stage 2 Verification: 4KB Aligned Page Table & Raw Pointers
    $pt := PageTable{pte0: 0, pte1: 0, pte2: 0, pte3: 0}
    pt_ptr := (&pt) as *raw u8
    mem.memset(pt_ptr, u8(0), 4096)
    uart_print("[XU KERNEL] PageTable (4KB aligned) zeroed via #core/mem.\n")

    // Setup 2MB Huge Page Identity Mapping (Present | Writable | Huge)
    unsafe {
        p0 := (&pt.pte0) as *raw u64
        *p0 = 0x00000083
    }
    uart_print("[XU KERNEL] Identity mapping entry configured (*raw u64).\n")

    // 4. Stage 2 Verification: Packed Hardware Header
    eth := EthernetHeader{
        dst_mac0: 0x52, dst_mac1: 0x54, dst_mac2: 0x00,
        dst_mac3: 0x12, dst_mac4: 0x34, dst_mac5: 0x56,
        ethertype: 0x0800
    }
    uart_print("[XU KERNEL] Ethernet header packed layout initialized.\n")

    // 5. Stage 3 Verification: Initialize Kernel Scheduler & Tasks
    unsafe {
        p_main := (SCHED_BASE + SCHED_MAIN_CTX_OFF) as *raw task.TaskContext
        p_t1 := (SCHED_BASE + SCHED_TASK1_CTX_OFF) as *raw task.TaskContext
        p_t2 := (SCHED_BASE + SCHED_TASK2_CTX_OFF) as *raw task.TaskContext
        p_step := (SCHED_BASE + SCHED_STEP_OFF) as *raw int
        *p_step = 0

        $t1 := task.task_context_new()
        t1.init(task_worker_1 as u64, u64(STACK1_TOP))
        *p_t1 = t1

        $t2 := task.task_context_new()
        t2.init(task_worker_2 as u64, u64(STACK2_TOP))
        *p_t2 = t2

        uart_print("[XU KERNEL] Scheduler initialized: Task 1 and Task 2 ready.\n")
        uart_print("[XU KERNEL] Dispatching context switch: Main -> Task 1...\n")
        task.switch_context(p_main, p_t1)
    }

    // 6. Resumed in Main from Task 2
    uart_print("[XU KERNEL] Resumed in Main kernel from Task 2!\n")
    $res := 0
    unsafe {
        p_step := (SCHED_BASE + SCHED_STEP_OFF) as *raw int
        res = *p_step
    }
    if res == 2 {
        uart_print("[XU KERNEL] Multi-task context switching test PASSED!\n")
    } else {
        uart_print("[XU KERNEL] Multi-task context switching test FAILED!\n")
    }

    // 7. Stage 4 Verification: PIC 8259 Remap, PIT 8254 Timer & IDT Gate
    uart_print("\n[XU KERNEL] --- Starting Stage 4: Interrupts & Hardware Architecture ---\n")
    uart_print("[XU KERNEL] Remapping 8259A PIC (IRQ 0-15 -> IDT vectors 32-47)...\n")
    arch.pic_remap(u8(32), u8(40))

    uart_print("[XU KERNEL] Programming 8254 PIT Timer to 100 Hz rate generator...\n")
    arch.pit_init(100)

    // Setup 16-byte IDT Gate for Timer IRQ0 (Vector 32)
    $timer_gate := arch.IdtEntry{
        offset_low: 0, selector: 0, ist: 0, type_attr: 0,
        offset_mid: 0, offset_high: 0, zero: 0
    }
    timer_gate.set_gate(timer_interrupt_isr as u64, 0x08, u8(arch.IDT_ATTR_INT32))
    uart_print("[XU KERNEL] IDT Entry 32 (Timer ISR) configured with gate attributes.\n")

    // Setup 10-byte packed IDTR descriptor
    gate_ptr := (&timer_gate) as *raw arch.IdtEntry
    idtr := arch.IdtPointer{
        limit: u16(256 * 16 - 1),
        base: gate_ptr as u64
    }
    unsafe {
        p_idtr := (&idtr) as *raw arch.IdtPointer
        arch.load_idt(p_idtr)
    }
    uart_print("[XU KERNEL] LIDT executed: IDT base and limit loaded into CPU IDTR.\n")

    // Test Control Register Access (CR3, CR2)
    $cr3 := u64(0)
    unsafe {
        cr3 = arch.read_cr3()
    }
    uart_print("[XU KERNEL] Control Register CR3 read successfully.\n")

    // 8. Stage 4 Verification: Complete TrapFrame snapshot inspection
    $tf := task.trap_frame_new()
    tf.vec = 32
    tf.rip = timer_interrupt_isr as u64
    tf.rsp = u64(STACK1_TOP)
    tf.cs = 0x08
    tf.rflags = 0x202 // IF enabled
    uart_print("[XU KERNEL] TrapFrame interrupt state initialized and verified.\n")

    // 9. Stage 4 Verification: VirtIO-Blk & VirtIO-Net Driver Framework
    $blk := virtio.virtio_blk_new(0x10001000)
    uart_print("[XU KERNEL] VirtIO Block Driver instance created at MMIO 0x10001000.\n")
    $net := virtio.virtio_net_new(0x10002000)
    uart_print("[XU KERNEL] VirtIO Network Driver instance created at MMIO 0x10002000.\n")

    uart_print("[XU KERNEL] Stage 4 complete. Halting CPU cleanly. Goodbye from Xu!\n\n")

    // 9. Halt processor loop
    while true {
        arch.halt()
    }

    << 0
}
