@main
$freestanding

#core/arch
#core/mem
#core/sync
#core/task
#core/virtio
#core/mmio
#core/addr
#core/alloc
#core/ds
#core/fmt

// Minimal Baremetal Kernel for x86_64 / AArch64 / RISC-V 64 targets.
// Demonstrates Stage 1, Stage 2, Stage 3, and Stage 4 Features:
// 1. Raw pointers (*raw T) and explicit unsafe blocks
// 2. Precise memory layout (@repr("C", align: 4096), @repr("C", packed))
// 3. Typed volatile MMIO (volatile_write / volatile_read)
// 4. Zero-allocation core modules (#core/arch, #core/mem, #core/sync, #core/task)
// 5. RAII zero-GC deterministic synchronization (Spinlock, IrqSpinlock)
// 6. Multi-task context switching (switch_context)
// 7. Interrupt Descriptor Table (IDT), PIC 8259 remap, PIT 8254 Timer & TrapFrame
// 8. Control register access (read_cr3, read_cr2) and port I/O (in8, out8)

// 4KB aligned Page Table (PML4 / Page Directory)
@repr("C", align: 4096)
pub struct PageTable {
    pub pte0 u64
    pub pte1 u64
    pub pte2 u64
    pub pte3 u64
}

// Packed hardware network packet / frame header (zero padding)
@repr("C", packed)
pub struct EthernetHeader {
    pub dst_mac0 u8
    pub dst_mac1 u8
    pub dst_mac2 u8
    pub dst_mac3 u8
    pub dst_mac4 u8
    pub dst_mac5 u8
    pub ethertype u16
}

// Fixed memory layout offsets for the Kernel Scheduler (per-arch physical RAM base)
const HIGH_HALF_BASE = 0xFFFF800000000000u64
const NX_BIT = 0x8000000000000000u64
const ALL_ONES = 0xFFFFFFFFFFFFFFFFu64

const SCHED_MAIN_CTX_OFF = 0
const SCHED_TASK1_CTX_OFF = 192
const SCHED_TASK2_CTX_OFF = 384
const SCHED_STEP_OFF = 576
const SCHED_ATOM32_OFF = 584
const SCHED_ATOM64_OFF = 592

fn sched_base() u64 {
    arch_id := xu_target_arch()
    if arch_id == 1 {
        << u64(0x00200000)
    } else if arch_id == 0 {
        << u64(0x40200000)
    }
    << u64(0x80400000)
}

fn stack1_top() u64 {
    << sched_base() + u64(0x11000)
}

fn stack2_top() u64 {
    << sched_base() + u64(0x21000)
}

// Serial UART: x86_64 COM1 is port I/O (0x03F8); AArch64 / RISC-V QEMU
// virt boards expose MMIO UARTs.
const UART_COM1 = 0x03F8
const UART_PL011 = 0x09000000
const UART_NS16550 = 0x10000000

fn uart_putc(c int) {
    arch_id := xu_target_arch()
    if arch_id == 1 {
        unsafe { arch.out8(u16(UART_COM1), u8(c)) }
    } else if arch_id == 0 {
        volatile_write(UART_PL011 as *raw u8, u8(c))
    } else {
        volatile_write(UART_NS16550 as *raw u8, u8(c))
    }
}

fn uart_print(msg string) {
    $i := 0
    while i < msg.len {
        uart_putc(int(msg[i]))
        i = i + 1
    }
}

fn timer_interrupt_isr() {
    arch.pic_eoi(0)
}

fn task_worker_1() {
    uart_print("[TASK 1] Worker 1 active on CPU!\n")

    // Demonstrate RAII IrqSpinlock (zero-GC auto-unlock & IRQ restore)
    $irq_lock := sync.irq_spinlock_new()
    if true {
        guard := irq_lock.acquire()
        uart_print("[TASK 1] Acquired IrqSpinlock inside critical section.\n")
        // guard automatically dropped here on scope exit!
    }
    uart_print("[TASK 1] Exited critical section; IrqSpinlock auto-released.\n")

    // Update scheduler step and switch to Task 2
    unsafe {
        sb := sched_base()
        p1 := (sb + u64(SCHED_TASK1_CTX_OFF)) as *raw task.TaskContext
        p2 := (sb + u64(SCHED_TASK2_CTX_OFF)) as *raw task.TaskContext
        p_step := (sb + u64(SCHED_STEP_OFF)) as *raw int
        *p_step = 1
        uart_print("[TASK 1] Yielding execution to Task 2...\n")
        task.switch_context(p1, p2)
    }

    // Task 1 should not be re-entered in this test
    while true {
        arch.halt()
    }
}

fn task_worker_2() {
    uart_print("[TASK 2] Worker 2 active on CPU!\n")

    // Demonstrate RAII Spinlock
    $lock := sync.spinlock_new()
    if true {
        guard := lock.acquire()
        uart_print("[TASK 2] Acquired Spinlock with RAII SpinGuard.\n")
        // guard automatically dropped here!
    }
    uart_print("[TASK 2] Spinlock auto-released via deterministic drop().\n")

    // Update scheduler step and switch back to Main task
    unsafe {
        sb := sched_base()
        p2 := (sb + u64(SCHED_TASK2_CTX_OFF)) as *raw task.TaskContext
        pm := (sb + u64(SCHED_MAIN_CTX_OFF)) as *raw task.TaskContext
        p_step := (sb + u64(SCHED_STEP_OFF)) as *raw int
        *p_step = 2
        uart_print("[TASK 2] Yielding execution back to Main kernel...\n")
        task.switch_context(p2, pm)
    }

    while true {
        arch.halt()
    }
}

fn main() int {
    // 1. Disable interrupts during initialization
    arch.cli()

    // 2. Output boot banner over serial port
    uart_print("\n")
    uart_print("====================================================\n")
    uart_print("  Welcome to Xu Operating System (Baremetal Kernel) \n")
    uart_print("  Stage 3: Preemptive Multitasking & Synchronization\n")
    uart_print("====================================================\n")
    uart_print("[XU KERNEL] Booting in Freestanding Mode (no_std)...\n")

    // 3. Stage 2 Verification: 4KB Aligned Page Table & Raw Pointers
    $pt := PageTable{pte0: 0, pte1: 0, pte2: 0, pte3: 0}
    pt_ptr := (&pt) as *raw u8
    mem.memset(pt_ptr, u8(0), 4096)
    uart_print("[XU KERNEL] PageTable (4KB aligned) zeroed via #core/mem.\n")

    // Setup 2MB Huge Page Identity Mapping (Present | Writable | Huge)
    unsafe {
        p0 := (&pt.pte0) as *raw u64
        *p0 = 0x00000083
    }
    uart_print("[XU KERNEL] Identity mapping entry configured (*raw u64).\n")

    // 4. Stage 2 Verification: Packed Hardware Header
    eth := EthernetHeader{
        dst_mac0: 0x52, dst_mac1: 0x54, dst_mac2: 0x00,
        dst_mac3: 0x12, dst_mac4: 0x34, dst_mac5: 0x56,
        ethertype: 0x0800
    }
    uart_print("[XU KERNEL] Ethernet header packed layout initialized.\n")

    // 5. Stage 3 Verification: Initialize Kernel Scheduler & Tasks
    unsafe {
        sb := sched_base()
        p_main := (sb + u64(SCHED_MAIN_CTX_OFF)) as *raw task.TaskContext
        p_t1 := (sb + u64(SCHED_TASK1_CTX_OFF)) as *raw task.TaskContext
        p_t2 := (sb + u64(SCHED_TASK2_CTX_OFF)) as *raw task.TaskContext
        p_step := (sb + u64(SCHED_STEP_OFF)) as *raw int
        *p_step = 0

        $t1 := task.task_context_new()
        t1.init(task_worker_1 as u64, stack1_top())
        *p_t1 = t1

        $t2 := task.task_context_new()
        t2.init(task_worker_2 as u64, stack2_top())
        *p_t2 = t2

        uart_print("[XU KERNEL] Scheduler initialized: Task 1 and Task 2 ready.\n")
        uart_print("[XU KERNEL] Dispatching context switch: Main -> Task 1...\n")
        task.switch_context(p_main, p_t1)
    }

    // 6. Resumed in Main from Task 2
    uart_print("[XU KERNEL] Resumed in Main kernel from Task 2!\n")
    $res := 0
    unsafe {
        p_step := (sched_base() + u64(SCHED_STEP_OFF)) as *raw int
        res = *p_step
    }
    if res == 2 {
        uart_print("[XU KERNEL] Multi-task context switching test PASSED!\n")
    } else {
        uart_print("[XU KERNEL] Multi-task context switching test FAILED!\n")
    }

    // 6b. Stage 3b Verification: Hardware Atomics (32/64-bit) & String Equality
    $atom_ok := true
    unsafe {
        sb := sched_base()
        a32 := (sb + u64(SCHED_ATOM32_OFF)) as *raw u32
        a64 := (sb + u64(SCHED_ATOM64_OFF)) as *raw u64
        arch.atomic_store_u32(a32, u32(0x80000001))
        if arch.atomic_load_u32(a32) != u32(0x80000001) { atom_ok = false }
        if arch.atomic_cas_u32(a32, u32(0x12345678), u32(99)) != u32(0x80000001) { atom_ok = false }
        if arch.atomic_load_u32(a32) != u32(0x80000001) { atom_ok = false }
        if arch.atomic_cas_u32(a32, u32(0x80000001), u32(10)) != u32(0x80000001) { atom_ok = false }
        if arch.atomic_fetch_add_u32(a32, u32(5)) != u32(10) { atom_ok = false }
        if arch.atomic_xchg_u32(a32, u32(42)) != u32(15) { atom_ok = false }
        if arch.atomic_load_u32(a32) != u32(42) { atom_ok = false }

        arch.atomic_store_u64(a64, u64(0x100000001))
        if arch.atomic_load_u64(a64) != u64(0x100000001) { atom_ok = false }
        if arch.atomic_cas_u64(a64, u64(7), u64(8)) != u64(0x100000001) { atom_ok = false }
        if arch.atomic_cas_u64(a64, u64(0x100000001), u64(100)) != u64(0x100000001) { atom_ok = false }
        if arch.atomic_fetch_add_u64(a64, u64(0x100000000)) != u64(100) { atom_ok = false }
        if arch.atomic_xchg_u64(a64, u64(55)) != u64(0x100000064) { atom_ok = false }
        if arch.atomic_load_u64(a64) != u64(55) { atom_ok = false }
    }
    s_a := "xu-baremetal"
    s_b := "xu-baremetal"
    s_c := "xu-other"
    if !(s_a == s_b) || (s_a == s_c) { atom_ok = false }
    if atom_ok {
        uart_print("[XU KERNEL] Hardware atomics & string eq test PASSED!\n")
    } else {
        uart_print("[XU KERNEL] Hardware atomics & string eq test FAILED!\n")
    }

    // 6c. Stage 3c Verification: Core OS Data Types (usize/isize/i64, sync, mmio, addr, ds, mem)
    if test_core_datatypes() {
        uart_print("[XU KERNEL] Core OS datatypes test PASSED!\n")
    } else {
        uart_print("[XU KERNEL] Core OS datatypes test FAILED!\n")
    }

    // 6d. Stage 3d Verification: P1 u64 Literals & CPU System Registers
    if test_p1_sys_and_literals() {
        uart_print("[XU KERNEL] P1 u64 literals & CPU sysregs test PASSED!\n")
    } else {
        uart_print("[XU KERNEL] P1 u64 literals & CPU sysregs test FAILED!\n")
    }

    // 6e. Stage 3e Verification: P2.2 #core/alloc & #core/fmt
    if test_p2_alloc_and_fmt() {
        uart_print("[XU KERNEL] P2.2 #core/alloc & #core/fmt test PASSED!\n")
    } else {
        uart_print("[XU KERNEL] P2.2 #core/alloc & #core/fmt test FAILED!\n")
    }

    // 6f. Stage 3f Verification: Optional VirtIO-Blk MMIO v2 DMA
    vres := test_p24_virtio_mmio()
    if vres > 0 {
        uart_print("[XU KERNEL] P2.4 VirtIO-Blk MMIO DMA test PASSED!\n")
    } else if vres < 0 {
        uart_print("[XU KERNEL] P2.4 VirtIO-Blk MMIO DMA test FAILED!\n")
    }

    // 7. Stage 4 Verification: PIC 8259 Remap, PIT 8254 Timer & IDT Gate (x86_64)
    uart_print("\n[XU KERNEL] --- Starting Stage 4: Interrupts & Hardware Architecture ---\n")
    if xu_target_arch() == 1 {
        uart_print("[XU KERNEL] Remapping 8259A PIC (IRQ 0-15 -> IDT vectors 32-47)...\n")
        arch.pic_remap(u8(32), u8(40))

        uart_print("[XU KERNEL] Programming 8254 PIT Timer to 100 Hz rate generator...\n")
        arch.pit_init(100)

        // Setup 16-byte IDT Gate for Timer IRQ0 (Vector 32)
        $timer_gate := arch.IdtEntry{
            offset_low: 0, selector: 0, ist: 0, type_attr: 0,
            offset_mid: 0, offset_high: 0, zero: 0
        }
        timer_gate.set_gate(timer_interrupt_isr as u64, 0x08, u8(arch.IDT_ATTR_INT32))
        uart_print("[XU KERNEL] IDT Entry 32 (Timer ISR) configured with gate attributes.\n")

        // Setup 10-byte packed IDTR descriptor
        gate_ptr := (&timer_gate) as *raw arch.IdtEntry
        idtr := arch.IdtPointer{
            limit: u16(256 * 16 - 1),
            base: gate_ptr as u64
        }
        unsafe {
            p_idtr := (&idtr) as *raw arch.IdtPointer
            arch.load_idt(p_idtr)
        }
        uart_print("[XU KERNEL] LIDT executed: IDT base and limit loaded into CPU IDTR.\n")

        // Test Control Register Access (CR3)
        unsafe {
            _cr3 := arch.read_cr3()
        }
        uart_print("[XU KERNEL] Control Register CR3 read successfully.\n")
    } else {
        arch.fence()
        unsafe {
            fl := arch.irq_save()
            arch.irq_restore(fl)
        }
        uart_print("[XU KERNEL] Non-x86 barrier and IRQ save/restore verified.\n")
    }

    // 8. Stage 4 Verification: Complete TrapFrame snapshot inspection
    $tf := task.trap_frame_new()
    tf.vec = 32
    tf.rip = timer_interrupt_isr as u64
    tf.rsp = stack1_top()
    tf.cs = 0x08
    tf.rflags = 0x202 // IF enabled
    uart_print("[XU KERNEL] TrapFrame interrupt state initialized and verified.\n")

    // 9. Stage 4 Verification: VirtIO-Blk & VirtIO-Net Driver Framework
    $blk := virtio.virtio_blk_new(0x10001000)
    uart_print("[XU KERNEL] VirtIO Block Driver instance created at MMIO 0x10001000.\n")
    $net := virtio.virtio_net_new(0x10002000)
    uart_print("[XU KERNEL] VirtIO Network Driver instance created at MMIO 0x10002000.\n")

    uart_print("[XU KERNEL] Stage 4 complete. Halting CPU cleanly. Goodbye from Xu!\n\n")

    // 9. Halt processor loop
    while true {
        arch.halt()
    }

    << 0
}

@repr("C")
struct ScratchRegs {
    ctrl mmio.VolatileU32
    stat mmio.ReadOnlyU32
    kick mmio.WriteOnlyU32
}

@repr("C")
struct DemoListNode {
    link ds.ListHead
    id int
}

fn test_core_datatypes() bool {
    $ok := true

    // 1. i64 / isize / usize scalars & casts
    a64 := i64(-42)
    off := isize(-16)
    sz := usize(4096)
    if a64 + i64(50) != i64(8) { ok = false }
    if off + isize(20) != isize(4) { ok = false }
    if sz + usize(128) != usize(4224) { ok = false }
    if u64(sz) != u64(4096) { ok = false }

    // 2. Typed atomics, RwSpinlock, SeqLock, Once
    $ab := sync.atomic_bool_new(false)
    if ab.load() { ok = false }
    if ab.swap(true) { ok = false }
    if !ab.load() { ok = false }
    if !ab.compare_exchange(true, false) { ok = false }
    if ab.load() { ok = false }

    $au32 := sync.atomic_u32_new(u32(10))
    if au32.fetch_add(u32(5)) != u32(10) { ok = false }
    if au32.fetch_sub(u32(3)) != u32(15) { ok = false }
    if au32.load() != u32(12) { ok = false }

    $au64 := sync.atomic_u64_new(u64(100))
    if au64.fetch_add(u64(50)) != u64(100) { ok = false }
    if au64.fetch_sub(u64(25)) != u64(150) { ok = false }
    if au64.load() != u64(125) { ok = false }

    $ap := sync.atomic_ptr_new(0 as *raw u8)
    p_sentinel := u64(0x1234) as *raw u8
    if ap.compare_exchange(0 as *raw u8, p_sentinel) != (0 as *raw u8) { ok = false }
    if ap.load() != p_sentinel { ok = false }

    $rw := sync.rw_spinlock_new()
    if true {
        rg := rw.read()
        // nested read allowed while writer bit clear
        rw.read_lock()
        rw.read_unlock()
    }
    if true {
        wg := rw.write()
    }

    $sl := sync.seqlock_new()
    sl.write_begin()
    sl.write_end()
    s0 := sl.read_begin()
    if sl.read_retry(s0) { ok = false }

    $once := sync.once_new()
    if once.is_completed() { ok = false }
    if !once.try_begin() { ok = false }
    once.finish()
    if !once.is_completed() { ok = false }
    if once.try_begin() { ok = false }

    // 3. MMIO typed wrappers over scratch RAM
    base := sched_base() + u64(0x3000)
    unsafe {
        regs := base as *raw ScratchRegs
        (*regs).ctrl.write(u32(0x05))
        (*regs).ctrl.set_bits(u32(0x08))
        (*regs).ctrl.clear_bits(u32(0x01))
        if (*regs).ctrl.read() != u32(0x0C) { ok = false }
        if (*regs).stat.read() != u32(0x0C) {
            // stat is a separate field initialized to 0 unless written via offset helper
        }
        mmio.write32(base, u64(4), u32(0xDEAD))
        if (*regs).stat.read() != u32(0xDEAD) { ok = false }
        (*regs).kick.write(u32(1))
        if mmio.read32(base, u64(8)) != u32(1) { ok = false }
    }

    // 4. PhysAddr, VirtAddr, PhysFrame, Page, Endianness, ByteSlice / MutByteSlice
    pa := addr.phys_addr(u64(0x1005))
    if pa.is_aligned(u64(addr.PAGE_SIZE)) { ok = false }
    if pa.align_down(u64(addr.PAGE_SIZE)).as_u64() != u64(0x1000) { ok = false }
    if pa.align_up(u64(addr.PAGE_SIZE)).as_u64() != u64(0x2000) { ok = false }
    if addr.phys_frame_containing(pa).index() != u64(1) { ok = false }

    va := addr.virt_addr(u64(0x00401234))
    if !va.is_canonical_x64() { ok = false }
    if va.p2_index() != 2 || va.p1_index() != 1 || va.page_offset() != u64(0x234) { ok = false }
    if addr.page_containing(va).start_addr().as_u64() != u64(0x00401000) { ok = false }

    be16 := addr.be16_new(u16(0x1234))
    if be16.raw_bits() != u16(0x3412) || be16.to_native() != u16(0x1234) { ok = false }
    be32 := addr.be32_new(u32(0x12345678))
    if be32.raw_bits() != u32(0x78563412) || be32.to_native() != u32(0x12345678) { ok = false }
    be64 := addr.be64_new(u64(0x0102030405060708))
    if be64.raw_bits() != u64(0x0807060504030201) || be64.to_native() != u64(0x0102030405060708) { ok = false }
    le32 := addr.le32_new(u32(0xAABBCCDD))
    if le32.to_native() != u32(0xAABBCCDD) { ok = false }

    buf_a := (sched_base() + u64(0x4000)) as *raw u8
    buf_b := (sched_base() + u64(0x4100)) as *raw u8
    $ms := addr.mut_byte_slice(buf_a, usize(16))
    ms.fill(u8(0xAA))
    if !ms.set(usize(5), u8(0x55)) { ok = false }
    if ms.set(usize(16), u8(0x11)) { ok = false }
    ro := ms.as_readonly()
    sub := ro.subslice(usize(4), usize(7))
    if sub.len != usize(3) || sub.get(usize(1)) != u8(0x55) || sub.get(usize(99)) != u8(0) { ok = false }
    $ms_b := addr.mut_byte_slice(buf_b, usize(8))
    if ms_b.copy_from(&sub) != usize(3) { ok = false }
    if ms_b.get(usize(1)) != u8(0x55) { ok = false }

    // 5. memmove (overlapping forward & backward) + word-aligned memcpy/memset + bitnot
    mem.memset(buf_a, u8(0), 32)
    unsafe {
        *(((buf_a as usize) + usize(0)) as *raw u8) = u8(1)
        *(((buf_a as usize) + usize(1)) as *raw u8) = u8(2)
        *(((buf_a as usize) + usize(2)) as *raw u8) = u8(3)
        *(((buf_a as usize) + usize(3)) as *raw u8) = u8(4)
        mem.memmove(((buf_a as usize) + usize(2)) as *raw u8, buf_a, 4)
        if *(((buf_a as usize) + usize(2)) as *raw u8) != u8(1) || *(((buf_a as usize) + usize(5)) as *raw u8) != u8(4) {
            ok = false
        }
        mem.memmove(buf_a, ((buf_a as usize) + usize(2)) as *raw u8, 4)
        if *(((buf_a as usize) + usize(0)) as *raw u8) != u8(1) || *(((buf_a as usize) + usize(3)) as *raw u8) != u8(4) {
            ok = false
        }
    }
    if mem.bitnot_u8(u8(0x0F)) != u8(0xF0) || mem.bitnot_u16(u16(0x00FF)) != u16(0xFF00) { ok = false }
    if mem.bitnot_u32(u32(0)) != u32(0xFFFFFFFF) { ok = false }

    // 6. Intrusive ListHead, BitMap, RingBufU8
    unsafe {
        lh := (sched_base() + u64(0x5000)) as *raw ds.ListHead
        n1 := (sched_base() + u64(0x5040)) as *raw DemoListNode
        n2 := (sched_base() + u64(0x5080)) as *raw DemoListNode
        n3 := (sched_base() + u64(0x50C0)) as *raw DemoListNode
        (*n1).id = 1
        (*n2).id = 2
        (*n3).id = 3
        ds.list_init(lh)
        if !ds.list_is_empty(lh) { ok = false }
        ds.list_push_back(lh, (&(*n1).link) as *raw ds.ListHead)
        ds.list_push_back(lh, (&(*n2).link) as *raw ds.ListHead)
        ds.list_push_front(lh, (&(*n3).link) as *raw ds.ListHead)
        p1 := ds.list_pop_front(lh) as *raw DemoListNode
        p2 := ds.list_pop_front(lh) as *raw DemoListNode
        p3 := ds.list_pop_front(lh) as *raw DemoListNode
        if p1 != n3 || p2 != n1 || p3 != n2 || !ds.list_is_empty(lh) { ok = false }
    }

    unsafe {
        bm := (sched_base() + u64(0x5100)) as *raw ds.BitMap
        bm_words := (sched_base() + u64(0x5120)) as *raw u64
        ds.bitmap_init(bm, bm_words, usize(128))
        if (*bm).alloc_bit() != isize(0) || (*bm).alloc_bit() != isize(1) { ok = false }
        if !(*bm).test(usize(1)) || (*bm).test(usize(2)) { ok = false }
        (*bm).free_bit(usize(0))
        if (*bm).alloc_bit() != isize(0) { ok = false }
    }

    unsafe {
        rb := (sched_base() + u64(0x5200)) as *raw ds.RingBufU8
        rb_buf := (sched_base() + u64(0x5240)) as *raw u8
        ds.ringbuf_u8_init(rb, rb_buf, usize(4))
        if !(*rb).is_empty() { ok = false }
        if !(*rb).push(u8(10)) || !(*rb).push(u8(20)) || !(*rb).push(u8(30)) || !(*rb).push(u8(40)) { ok = false }
        if (*rb).push(u8(50)) || !(*rb).is_full() { ok = false }
        if (*rb).pop() != 10 || (*rb).pop() != 20 || !(*rb).push(u8(50)) { ok = false }
        if (*rb).pop() != 30 || (*rb).pop() != 40 || (*rb).pop() != 50 || (*rb).pop() != -1 { ok = false }
    }

    << ok
}

fn test_p1_sys_and_literals() bool {
    $ok := true
    if !addr.virt_addr(HIGH_HALF_BASE).is_canonical_x64() { ok = false }
    if NX_BIT != (u64(1) << u64(63)) { ok = false }
    if ALL_ONES != (u64(0) - u64(1)) { ok = false }
    bin_hi := 0b10000000_00000000_00000000_00000000_00000000_00000000_00000000_00000001u64
    if bin_hi != (NX_BIT | u64(1)) { ok = false }
    if 18446744073709551615u64 != ALL_ONES { ok = false }

    unsafe {
        _ts := arch.rdtsc()
        if xu_target_arch() == 1 {
            cr0 := arch.read_cr0()
            cr4 := arch.read_cr4()
            efer := arch.rdmsr(u32(arch.MSR_IA32_EFER))
            if (cr0 & u64(0x80000001)) != u64(0x80000001) { ok = false }
            if (cr4 & u64(0x220)) != u64(0x220) { ok = false }
            if (efer & u64(0x100)) == u64(0) { ok = false }
        }
    }
    << ok
}

fn test_p2_alloc_and_fmt() bool {
    $ok := true
    sb := sched_base()

    // 1. BumpAllocator
    unsafe {
        ba := (sb + u64(0x30000)) as *raw alloc.BumpAllocator
        arena := (sb + u64(0x30100)) as *raw u8
        alloc.bump_init(ba, arena, usize(1024))
        p1 := (*ba).alloc_raw(usize(17), usize(16))
        p2 := (*ba).alloc_raw(usize(32), usize(64))
        p3 := (*ba).alloc_zeroed(usize(48), usize(16))
        if p1 == 0 as *raw u8 || p2 == 0 as *raw u8 || p3 == 0 as *raw u8 { ok = false }
        if ((p2 as usize) & usize(63)) != usize(0) { ok = false }
        if *(((p3 as usize) + usize(47)) as *raw u8) != u8(0) { ok = false }
        if (*ba).alloc_raw(usize(2048), usize(16)) != 0 as *raw u8 { ok = false }
        if (*ba).used() == usize(0) || (*ba).remaining() >= usize(1024) { ok = false }
        (*ba).reset()
        if (*ba).used() != usize(0) || (*ba).remaining() != usize(1024) { ok = false }
        p4 := (*ba).alloc(alloc.layout_new(64, 16))
        if p4 != arena { ok = false }
    }

    // 2. FixedPoolAllocator
    unsafe {
        fp := (sb + u64(0x31000)) as *raw alloc.FixedPoolAllocator
        pool_mem := (sb + u64(0x31100)) as *raw u8
        cap := alloc.fixed_pool_init(fp, pool_mem, usize(512), usize(32), usize(16))
        if cap != usize(16) || (*fp).available() != usize(16) { ok = false }
        $first := 0 as *raw u8
        $second := 0 as *raw u8
        for idx in 0:16 {
            s := (*fp).alloc_slot()
            if s == 0 as *raw u8 { ok = false }
            if idx == 0 { first = s }
            if idx == 1 { second = s }
        }
        if (*fp).alloc_slot() != 0 as *raw u8 { ok = false }
        if (*fp).in_use() != usize(16) || (*fp).available() != usize(0) { ok = false }
        if (*fp).free_slot(0 as *raw u8) { ok = false }
        if (*fp).free_slot(((first as usize) + usize(1)) as *raw u8) { ok = false }
        if !(*fp).free_slot(first) || !(*fp).free_slot(second) { ok = false }
        if (*fp).available() != usize(2) { ok = false }
        r1 := (*fp).alloc_slot()
        r2 := (*fp).alloc_slot()
        if r1 == 0 as *raw u8 || r2 == 0 as *raw u8 || (*fp).available() != usize(0) { ok = false }
    }

    // 3. LinkedListAllocator (alignment front-gap split + bidirectional coalesce)
    unsafe {
        ll := (sb + u64(0x32000)) as *raw alloc.LinkedListAllocator
        heap_mem := (sb + u64(0x32100)) as *raw u8
        if !alloc.linked_list_init(ll, heap_mem, usize(16384)) { ok = false }
        a1 := (*ll).alloc_raw(usize(64), usize(16))
        a2 := (*ll).alloc_raw(usize(128), usize(64))
        a3 := (*ll).alloc_raw(usize(256), usize(4096))
        a4 := (*ll).alloc(alloc.layout_new(32, 16))
        if a1 == 0 as *raw u8 || a2 == 0 as *raw u8 || a3 == 0 as *raw u8 || a4 == 0 as *raw u8 { ok = false }
        if ((a2 as usize) & usize(63)) != usize(0) { ok = false }
        if ((a3 as usize) & usize(4095)) != usize(0) { ok = false }
        *a1 = u8(0x11)
        *a2 = u8(0x22)
        *a3 = u8(0x33)
        *a4 = u8(0x44)
        if *a1 != u8(0x11) || *a2 != u8(0x22) || *a3 != u8(0x33) || *a4 != u8(0x44) { ok = false }
        if !(*ll).dealloc_raw(a2) || !(*ll).dealloc_raw(a3) || !(*ll).dealloc_raw(a1) { ok = false }
        (*ll).dealloc(a4, alloc.layout_new(32, 16))
        if (*ll).dealloc_raw(a1) { ok = false }
        if (*ll).used() != usize(0) || (*ll).blocks() != usize(1) { ok = false }
    }

    // 4. FmtBuf zero-heap formatting & truncation
    unsafe {
        fmem := (sb + u64(0x37000)) as *raw u8
        $fb := fmt.fmt_buf_new(fmem, usize(128))
        fb.write_str("u=")
        fb.write_u64(u64(0))
        fb.write_byte(u8(44))
        fb.write_u64(18446744073709551615u64)
        if !fb.eq_str("u=0,18446744073709551615") || fb.is_truncated() { ok = false }

        fb.reset()
        fb.write_i64(i64(-42))
        fb.write_byte(u8(44))
        fb.write_i64(i64(-9223372036854775807) - i64(1))
        if !fb.eq_str("-42,-9223372036854775808") || fb.is_truncated() { ok = false }

        fb.reset()
        fb.write_hex_prefixed(u64(0xdead))
        fb.write_byte(u8(32))
        fb.write_hex_padded(u64(0x2A), usize(4), true)
        fb.write_byte(u8(32))
        fb.write_bin_u64(u64(0x16), usize(8))
        fb.write_byte(u8(32))
        fb.write_bool(true)
        if !fb.eq_str("0xdead 002A 00010110 true") || !fb.nul_terminate() { ok = false }

        $small := fmt.fmt_buf_new((sb + u64(0x37100)) as *raw u8, usize(5))
        small.write_str("hello world")
        if !small.is_truncated() || small.len != usize(5) || !small.eq_str("hello") { ok = false }
    }

    << ok
}

fn test_p24_virtio_mmio() int {
    arch_id := xu_target_arch()
    $mmio_base := u64(0)
    if arch_id == 0 {
        mmio_base = virtio.virtio_mmio_find_blk(u64(0x0A000000), u64(0x200), 32)
    } else if arch_id == 4 {
        mmio_base = virtio.virtio_mmio_find_blk(u64(0x10001000), u64(0x1000), 8)
    }
    if mmio_base == u64(0) {
        << 0
    }

    sb := sched_base()
    dma_base := sb + u64(0x40000)
    s0_buf := (sb + u64(0x43000)) as *raw u8
    wr_buf := (sb + u64(0x43400)) as *raw u8
    rd_buf := (sb + u64(0x43800)) as *raw u8

    $drv := virtio.virtio_blk_new(mmio_base)
    if !drv.init_with_dma(dma_base, u64(8192)) {
        << -1
    }
    if drv.capacity_sectors < u64(2) {
        << -1
    }

    mem.memset(s0_buf, u8(0), 512)
    if !drv.read_sector(u64(0), s0_buf) {
        << -1
    }
    seed := "XUMM"
    for i in 0:4 {
        unsafe {
            p := ((s0_buf as usize) + usize(i)) as *raw u8
            if int(*p) != (seed[i] & 255) {
                << -1
            }
        }
    }

    marker := "XU-MMIO-DMA-OK!"
    for i in 0:512 {
        $v := u8((i * 5 + 11) & 0xFF)
        if i < marker.len {
            v = u8(marker[i])
        }
        unsafe {
            p := ((wr_buf as usize) + usize(i)) as *raw u8
            *p = v
        }
    }
    if !drv.write_sector(u64(1), wr_buf) {
        << -1
    }
    mem.memset(rd_buf, u8(0), 512)
    if !drv.read_sector(u64(1), rd_buf) {
        << -1
    }
    if mem.memcmp(wr_buf, rd_buf, 512) != 0 {
        << -1
    }
    << 1
}
