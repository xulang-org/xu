@main
$freestanding

#core/uefi

pub fn main() {
    st := uefi.system_table()
    unsafe {
        if (st as u64) == u64(0) {
            <<
        }
    }
    uefi.con_out_clear(st)
    uefi.con_out_puts(st, "[XU-UEFI] Hello from pure-Xu UEFI PE32+ application!\n")

    unsafe {
        if (*st).hdr.signature != uefi.EFI_SYSTEM_TABLE_SIGNATURE {
            uefi.con_out_puts(st, "[XU-UEFI] FAIL: bad EFI_SYSTEM_TABLE signature\n")
            uefi.shutdown(st)
            <<
        }
        uefi.con_out_puts(st, "[XU-UEFI] FirmwareRevision=")
        uefi.con_out_put_u64(st, u64((*st).firmware_revision))
        uefi.con_out_puts(st, " TableEntries=")
        uefi.con_out_put_u64(st, (*st).number_of_table_entries)
        uefi.con_out_puts(st, "\n")

        rsdp := uefi.find_acpi_rsdp(st)
        uefi.con_out_puts(st, "[XU-UEFI] ACPI RSDP=")
        uefi.con_out_put_hex(st, rsdp)

        $map_sz := u64(0)
        $map_key := u64(0)
        $desc_sz := u64(0)
        $desc_ver := u32(0)
        uefi.get_memory_map(st, (&map_sz) as *raw u64, u64(0) as *raw u8, (&map_key) as *raw u64, (&desc_sz) as *raw u64, (&desc_ver) as *raw u32)
        $entries := u64(0)
        if map_sz > u64(0) && desc_sz > u64(0) {
            alloc_sz := map_sz + desc_sz * u64(8)
            $pool_ptr := u64(0)
            if uefi.allocate_pool(st, u32(uefi.EFI_LOADER_DATA), alloc_sz, (&pool_ptr) as *raw u64) == u64(0) && pool_ptr != u64(0) {
                $cur_sz := alloc_sz
                if uefi.get_memory_map(st, (&cur_sz) as *raw u64, pool_ptr as *raw u8, (&map_key) as *raw u64, (&desc_sz) as *raw u64, (&desc_ver) as *raw u32) == u64(0) {
                    d := desc_sz
                    if d > u64(0) {
                        $rem := cur_sz
                        while rem >= d {
                            rem -= d
                            entries += u64(1)
                        }
                    }
                }
                uefi.free_pool(st, pool_ptr)
            }
        }
        uefi.con_out_puts(st, " MemMapEntries=")
        uefi.con_out_put_u64(st, entries)
        uefi.con_out_puts(st, " DescSize=")
        uefi.con_out_put_u64(st, desc_sz)
        gop := uefi.locate_gop(st)
        if (gop as u64) != u64(0) && ((*gop).mode as u64) != u64(0) && ((*(*gop).mode).info as u64) != u64(0) {
            gi := (*(*gop).mode).info
            uefi.con_out_puts(st, " GOP=")
            uefi.con_out_put_u64(st, u64((*gi).horizontal_resolution))
            uefi.con_out_puts(st, "x")
            uefi.con_out_put_u64(st, u64((*gi).vertical_resolution))
        } else {
            uefi.con_out_puts(st, " GOP=none")
        }
        uefi.con_out_puts(st, "\n")
    }

    uefi.con_out_puts(st, "[XU-UEFI] VERIFICATION PASSED\n")
    uefi.stall(st, u64(100000))
    uefi.shutdown(st)
}
