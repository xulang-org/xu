@main

#os
#time
#strings
#strconv
#embedded/mqtt
#embedded/bluetooth/control

fn send_all(fd int, bytes string) bool {
    $at := 0
    while at < bytes.len {
        written := os.fd_write(fd,bytes[at:bytes.len]) or(err) { << false }
        if written < 1 { << false }
        at += written
    }
    << true
}
fn run(fd int, root &string, message &string, command &control.Command) int {
    identity := "XuAgent-" + strconv.itoa(os.getpid())
    $client := mqtt.create(identity,*root + "/result",*root + "/agent/state",0)
    began := time.now()
    $sent := false
    while time.since(began) < 15000000000 {
        now := time.since(began) / 1000000
        if client.ready() && !sent {
            topic := *root + "/cmd"
            if !client.publish(&topic,message,false) { << 2 }
            sent = true
        }
        out := client.poll(now)
        if out.len > 0 && !send_all(fd,out) { << 2 }
        ready := os.socket_wait(fd,1,20000000) or(err) { << 2 }
        if ready > 0 {
            bytes := os.fd_read(fd,2048) or(err) { << 2 }
            if bytes.len == 0 || !client.feed(&bytes,now) { << 2 }
        }
        reply := client.read()
        if reply.valid {
            ack := client.poll(now)
            if ack.len > 0 && !send_all(fd,ack) { << 2 }
            pattern := "\"id\":\"" + command.id + "\""
            if strings.contains(&reply.payload,pattern) {
                println(reply.payload)
                $bye := make_string(2)
                bye[0] = 0xE0
                send_all(fd,bye)
                if strings.contains(&reply.payload,"\"result\":\"ok\"") ||
                    strings.contains(&reply.payload,"\"result\":\"queued\"") ||
                    strings.contains(&reply.payload,"\"result\":\"already_disconnected\"") { << 0 }
                << 3
            }
        }
        if client.failed() { << 2 }
    }
    eprintln("MQTT command timed out")
    << 2
}
fn main() int {
    args := os.args()
    if args.len < 4 || args.len > 5 {
        eprintln("usage: mqtt_agent BROKER_IPV4 TOPIC_ROOT JSON_COMMAND [PORT]")
        << 1
    }
    parts := strings.split(&args[1],".")
    if parts.len != 4 { eprintln("broker must be an IPv4 address")
        << 1 }
    $ip := []int{}
    for i in 0:4 {
        n := strconv.atoi(&parts[i]) or(err) { << 1 }
        if n < 0 || n > 255 { << 1 }
        ip.push(n)
    }
    $port := 1883
    if args.len == 5 { port = strconv.atoi(&args[4]) or(err) { << 1 } }
    if port < 1 || port > 65535 { << 1 }
    command := control.parse(&args[3])
    if !command.valid { eprintln("invalid BLE command envelope or HID report")
        << 1 }
    fd := os.socket(2,1,0) or(err) { << 2 }
    os.set_sock_timeout(fd,3000000000) or(err) {
        os.socket_close(fd) or(ignored) { << 2 }
        << 2 }
    os.connect4(fd,ip[0],ip[1],ip[2],ip[3],port) or(err) {
        eprintln(err.msg())
        os.socket_close(fd) or(ignored) { << 2 }
        << 2 }
    result := run(fd,&args[2],&args[3],&command)
    os.socket_close(fd) or(ignored) { << 2 }
    << result
}
