@main

#embedded/chips/esp32

// UART console for a board with the standard ESP32 bootloader/partition table.
// This example does not enable a radio or modify flash storage.
fn main() int {
    esp32.init()
    esp32.uart_println("Xu ESP32 UART console")
    esp32.uart_print("CPU MHz: ")
    esp32.uart_print_hex(esp32.rom_cpu_mhz())
    esp32.uart_println("")
    while true {
        if esp32.uart_rx_available() {
            esp32.uart_write_char(esp32.uart_read_char())
        }
        esp32.rom_delay_us(100)
    }
    << 0
}
