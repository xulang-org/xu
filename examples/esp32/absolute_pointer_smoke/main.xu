@main

#embedded/bluetooth/control

// Host smoke for the absolute-mouse MQTT envelope. HOGP builders stay in the
// embedded bluetooth package (not hosted); scripts/test_esp32_absolute_pointer.py
// checks the Report Map and release-at-last-point contracts in source.
fn fail(label string) int {
    eprintln(label)
    << 1
}

fn main() int {
    // Absolute center: buttons=1, X=16383, Y=16383 → [1,255,63,255,63]
    body := "{\"id\":\"tap-1\",\"op\":\"hid.mouse\",\"report\":[1,255,63,255,63]}"
    command := control.parse(&body)
    if !command.valid { << fail("parse absolute mouse") }
    if command.op != control.MOUSE { << fail("mouse op") }
    if command.report.len != 5 { << fail("five-byte report") }
    if command.report[0] != 1 { << fail("button") }
    x := command.report[1] | (command.report[2] << 8)
    y := command.report[3] | (command.report[4] << 8)
    if x != 16383 || y != 16383 { << fail("absolute center") }

    old := "{\"id\":\"tap-old\",\"op\":\"hid.mouse\",\"report\":[0,1,0,0]}"
    if control.parse(&old).valid { << fail("reject relative four-byte mouse") }
    over := "{\"id\":\"tap-over\",\"op\":\"hid.mouse\",\"report\":[0,0,128,0,0]}"
    if control.parse(&over).valid { << fail("reject X above 32767") }
    println("absolute pointer smoke passed")
    << 0
}
