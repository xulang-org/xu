# Classic ESP32 CYD delivery profile: official BTDM + Wi-Fi static libs.
CONFIG_IDF_TARGET="esp32"

# Flash: keep factory app at 0x10000 / 3 MiB compatible with existing boards.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Free heap for MQTT + HID; avoid large SPIRAM requirement on stock CYD.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Wi-Fi station
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Bluetooth classic stack with BLE HID device (official libbtdm*)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_HID_DEVICE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_HCI_MODE_VHCI=y

# Shrink unused Bluedroid pieces where possible
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=n
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y

# Status LCD: Wi-Fi and BTDM already fill IRAM, so keep the SPI ISR in flash.
CONFIG_SPI_MASTER_ISR_IN_IRAM=n

# MQTT over plain TCP for the LAN test profile (no TLS in this delivery)
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
