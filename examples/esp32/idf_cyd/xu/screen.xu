@main
#embedded/display
#embedded/display/geometry

// The status_demo dashboard (ui.xu over #embedded/display), drawn on the CYD
// panel through C's esp_lcd primitives. Field layout and wording follow the
// C screen it replaces.

struct Lcd { ok bool }

fn lcd_fill(lcd $&Lcd, area &geometry.Rect, color int) bool {
    << c_call6("xu_host_lcd_fill",area.x,area.y,area.width,area.height,color,0) != 0
}
fn lcd_write(lcd $&Lcd, span &geometry.Span, pixels &[]int) bool {
    << c_call6("xu_host_lcd_write",span.x,span.y,pixels,span.offset,span.count,0) != 0
}

fn screen_fields(dash $&Dashboard, app &App) {
    wifi := c_call6("xu_host_wifi_state",0,0,0,0,0,0)
    connected := c_call6("xu_host_hid_state",1,0,0,0,0,0) != 0
    paired := c_call6("xu_host_hid_state",7,0,0,0,0,0) != 0
    advertising := c_call6("xu_host_hid_state",6,0,0,0,0,0) != 0
    if connected && paired {
        ui_set(dash,0,"已配对",UI_GREEN)
        ui_set(dash,2,"HID READY",UI_MUTED)
    } else if connected {
        ui_set(dash,0,"已连接",UI_AMBER)
        ui_set(dash,2,"等待配对",UI_MUTED)
    } else if advertising {
        ui_set(dash,0,"广播中",UI_BLUE)
        ui_set(dash,2,"等待连接",UI_MUTED)
    } else if wifi == 2 {
        ui_set(dash,0,"待命",UI_MUTED)
        ui_set(dash,2,"等待连接",UI_MUTED)
    } else {
        ui_set(dash,0,"准备中",UI_AMBER)
        ui_set(dash,2,"等待连接",UI_MUTED)
    }
    ui_set(dash,1,config(1),UI_TEXT)
    if app.last_id.len > 0 {
        $color := UI_RED
        if app.last_result == "queued" || app.last_result == "ok" { color = UI_GREEN }
        ui_set(dash,3,copy(&app.last_id) + " " + copy(&app.last_result),color)
    } else {
        ui_set(dash,3,"MQTT: WAIT FOR HOST",UI_AMBER)
    }
    if wifi == 1 { ui_set(dash,4,"已连接",UI_GREEN) }
    else if wifi == 2 { ui_set(dash,4,"失败",UI_RED) }
    else { ui_set(dash,4,"连接中",UI_AMBER) }
    ui_set(dash,5,config(2),UI_TEXT)
    if wifi == 1 { ui_set(dash,6,config(3),UI_GREEN) }
    else { ui_set(dash,6,"--",UI_GREEN) }
    rssi := c_call6("xu_host_wifi_rssi",0,0,0,0,0,0)
    $mqtt := "--"
    if app.announced { mqtt = "OK" }
    if rssi < 0 { ui_set(dash,7,str(rssi) + " dBm / MQTT " + mqtt,UI_MUTED) }
    else { ui_set(dash,7,"-- dBm / MQTT " + mqtt,UI_MUTED) }
    ui_set(dash,8,"BOTH",UI_BLUE)
}

fn screen_surface() display.Surface#Lcd {
    << display.create(320,240,Lcd{ok: true},lcd_fill,lcd_write)
}

fn screen_start(dash $&Dashboard, app &App, surface $&display.Surface#Lcd) {
    screen_fields(dash,app)
    if !ui_frame(dash,surface) { log("screen: panel unavailable") }
    c_call6("xu_host_lcd_flush",0,0,0,0,0,0)
}

// Poll state every 200 ms; draw at most 64 sixteen-pixel spans per call so
// MQTT handling in the same loop stays responsive.
fn screen_tick(dash $&Dashboard, app $&App, now int, surface $&display.Surface#Lcd) {
    if elapsed(now,app.polled_at) >= 200 {
        app.polled_at = now
        screen_fields(dash,&*app)
    }
    for k in 0:64 {
        if !ui_tick(dash,surface) { <- }
    }
    c_call6("xu_host_lcd_flush",0,0,0,0,0,0)
}
