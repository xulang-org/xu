fn request_f24(host &bt.PeripheralHost, probe $&HidProbe) bool {
    if (probe.step != 4 && probe.step != 5) || !host.hid_notifications_enabled(bt.ATT_HANDLE_KEYBOARD_REPORT) {
        esp32.uart_println("[BLE]")
        << false
    }
    probe.step = 0
    esp32.uart_println("[BLE]")
    << true
}

fn select_irq_placement(mode int) bool {
    old := lock_interrupts()
    $bb := volatile_load(0x3FFD7E88)
    $ll := volatile_load(0x3FFD7E8C)
    if mode > 0 { bb = IRAM_BB_ENTRY }
    if mode > 1 { ll = IRAM_LL_ENTRY }
    if bb < 0x40080000 || bb >= 0x40400000 || bb % 4 != 0 ||
        ll < 0x40080000 || ll >= 0x40400000 || ll % 4 != 0 {
        restore_interrupts(old)
        << false
    }
    volatile_store(0x3FFE0710,bb)
    volatile_store(0x3FFE0730,ll)
    volatile_store(0x3FFD77AC,0)
    volatile_store(0x3FFD77A4,0)
    volatile_store(0x3FFD7798,0)
    ok := volatile_load(0x3FFE0710) == bb && volatile_load(0x3FFE0730) == ll
    restore_interrupts(old)
    esp32.uart_print("[BLE]")
    esp32.uart_print_hex(bb)
    esp32.uart_print_hex(ll)
    esp32.uart_print_hex(volatile_load(0x3FF510F8))
    esp32.uart_println("")
    << ok
}

fn install_ll_capture() bool {
    saved := lock_interrupts()
    if rom_call6(0x40043F64,0,0,0,0,0,0) != 0x3FFAF7BC ||
        volatile_load(0x3FFAE70C) != 0x3FFAE710 ||
        volatile_load(0x3FFAE7F0) != 0x40015894 ||
        volatile_load(0x3FFAF7BC) != 0x400426F0 ||
        volatile_load(0x3FFAF7C4) != 0x4004291C ||
        volatile_load(0x3FFAEFC4) != 0x400476A8 || volatile_load(0x3FFAEFF0) != 0x400483E8 || volatile_load(0x3FFAF07C) != 0x4004B4D4 || volatile_load(0x3FFAEFBC) != 0x40046D50 ||
        volatile_load(0x3FFAF7C0) != 1 || volatile_load(0x3FFAF7C8) != 1 {
        restore_interrupts(saved)
        << false
    }
    rom_call6(esp32.ROM_MEMSET,0x3FFD7E40,0,64,0,0,0)
    rom_call6(esp32.ROM_MEMSET,0x3FFD7ED0,0,36,0,0,0)
    volatile_store(0x3FFD7ED8,1)
    rom_call6(esp32.ROM_MEMSET,0x3FFD7D00,0,256,0,0,0)
    volatile_store(0x3FFAF7BC,0x40094c54)
    volatile_store(0x3FFAF7C4,0x40094cc8)
    volatile_store(0x3FFAEFC4,0x40094d38)
    volatile_store(0x3FFAEFF0,0x40094da8)
    volatile_store(0x3FFAEFBC,0x400950cc)
    if volatile_load(0x3FFAF7BC) != 0x40094c54 || volatile_load(0x3FFAF7C4) != 0x40094cc8 ||
        volatile_load(0x3FFAEFC4) != 0x40094d38 || volatile_load(0x3FFAEFF0) != 0x40094da8 || volatile_load(0x3FFAEFBC) != 0x400950cc {
        volatile_store(0x3FFAF7BC,0x400426F0)
        volatile_store(0x3FFAF7C4,0x4004291C)
        volatile_store(0x3FFAEFC4,0x400476A8)
        volatile_store(0x3FFAEFF0,0x400483E8)
        volatile_store(0x3FFAEFBC,0x40046D50)
        restore_interrupts(saved)
        << false
    }
    restore_interrupts(saved)
    esp32.uart_println("[BLE]")
    << true
}

fn initialize_auth_patch() bool {
    rom_call6(esp32.ROM_MEMSET,0x3FFD7E00,0,64,0,0,0)
    if !esp32.llc_auth_rom_install(true) { << false }
    if !esp32.llc_auth_rom_install(false) { << false }
    if !esp32.llc_auth_rom_install(true) { << false }
    << install_ll_capture()
}

fn inspect_auth_frame(frame &[]int) {
    if frame.len == 11 && frame[0] == 4 && frame[1] == 0x0E &&
        frame[4] == 0x7B && frame[5] == 0x0C && frame[6] == 0 {
        volatile_store(0x3FFD7E34,frame[9] | (frame[10] << 8))
    }
    if frame.len == 5 && frame[0] == 4 && frame[1] == 0x57 {
        volatile_store(0x3FFD7E30,volatile_load(0x3FFD7E30) + 1)
        esp32.uart_println("[BLE]")
    }
}

fn request_other_reports(host $&bt.PeripheralHost, command int) {
    if !host.connected || !host.encrypted || host.closing { << }
    if command == 109 && host.hid_notifications_enabled(bt.ATT_HANDLE_MOUSE_REPORT) {
        // Absolute center probe: move, then stay. No relative nudge that drifts.
        center := bt.HID_MOUSE_ABS_MAX / 2
        if !host.queue_hid_notification(bt.ATT_HANDLE_MOUSE_REPORT,bt.hogp_build_mouse(0,center,center)) { << }
        if !host.queue_hid_notification(bt.ATT_HANDLE_MOUSE_REPORT,bt.hogp_build_mouse(0,center,center)) { << }
    }
    if command == 99 && host.hid_notifications_enabled(bt.ATT_HANDLE_CONSUMER_REPORT) {
        if !host.queue_hid_notification(bt.ATT_HANDLE_CONSUMER_REPORT,bt.hogp_build_consumer(bt.HID_CC_MENU)) { << }
        if !host.queue_hid_notification(bt.ATT_HANDLE_CONSUMER_REPORT,bt.hogp_build_consumer(0)) { << }
    }
}

fn bond_stage_wipe() { rom_call6(esp32.ROM_MEMSET,0x3FFD7D00,0,80,0,0,0) }

fn bond_flash_read(slot int) []int {
    result := rom_call6(0x40095a28,0,slot,0,0,0,0)
    if result != 0 { esp32.uart_print("[BOND] read error: ")
        esp32.uart_print_hex(result)
        esp32.uart_println("")
        bond_stage_wipe()
        << []int{} }
    $record := bt.hci_zeros(64)
    for word in 0:16 {
        rom_call6(esp32.ROM_MEMCPY,0x3FFD7D48,0x3FFD7D00 + word * 4,4,0,0,0)
        value := volatile_load(0x3FFD7D48)
        for octet in 0:4 { record[word * 4 + octet] = (value >> (octet * 8)) & 255 }
    }
    bond_stage_wipe()
    << record
}

fn bond_store_load(host $&bt.PeripheralHost) BondStore {
    // Scratch was RX diagnostic shadow in HID13; no controller has started.
    bond_stage_wipe()
    $store := BondStore{current: bt.hci_zeros(64), slot: -1, generation: 0, error: 0, pending_ms: -1, next_check: 0}
    $first := bond_flash_read(0)
    $second := bond_flash_read(1)
    if first.len != 64 || second.len != 64 { store.error = 1 }
    else {
        selection := bt.bond_record_select(&first,&second)
        if selection == -2 { store.error = 2 }
        if selection == 0 {
            if host.restore_bond_snapshot(&first) { for i in 0:64 { store.current[i] = first[i] }
                store.slot = 0
                store.generation = bt.bond_record_generation(&store.current) }
            else { store.error = 3 }
        }
        if selection == 1 {
            if host.restore_bond_snapshot(&second) { for i in 0:64 { store.current[i] = second[i] }
                store.slot = 1
                store.generation = bt.bond_record_generation(&store.current) }
            else { store.error = 3 }
        }
    }
    wipe($&first)
    wipe($&second)
    esp32.uart_print("[BOND] boot restored/generation/error: ")
    if host.bond_available { esp32.uart_print_hex(1) } else { esp32.uart_print_hex(0) }
    esp32.uart_print_hex(store.generation)
    esp32.uart_print_hex(store.error)
    esp32.uart_println("")
    << store
}

fn bond_flash_write(slot int, record &[]int) int {
    if !bt.bond_record_valid(record) { << 20 }
    bond_stage_wipe()
    for word in 0:16 {
        i := word * 4
        value := record[i] | (record[i + 1] << 8) | (record[i + 2] << 16) | (record[i + 3] << 24)
        volatile_store(0x3FFD7D48,value)
        rom_call6(esp32.ROM_MEMCPY,0x3FFD7D00 + i,0x3FFD7D48,4,0,0,0)
    }
    result := rom_call6(0x40095a28,2,slot,0,0,0,0)
    bond_stage_wipe()
    << result
}

fn bond_store_save(host &bt.PeripheralHost, store $&BondStore) bool {
    if host.connected || host.closing || store.error != 0 { << false }
    if !host.bond_available { << true }
    next := bt.bond_record_next_generation(store.generation)
    $record := host.bond_snapshot(next)
    if !bt.bond_record_valid(&record) { wipe($&record)
        store.error = 4
        << false }
    if bt.bond_record_same_payload(&record,&store.current) { wipe($&record)
        << true }
    $target := 0
    if store.slot == 0 { target = 1 }
    result := bond_flash_write(target,&record)
    if result != 0 { store.error = result
        wipe($&record)
        << false }
    $readback := bond_flash_read(target)
    if !bt.bond_record_valid(&readback) || !bt.bond_record_same_payload(&readback,&record) ||
        bt.bond_record_generation(&readback) != next {
        store.error = 5
        wipe($&record)
        wipe($&readback)
        << false
    }
    wipe($&store.current)
    store.current = readback
    store.slot = target
    store.generation = next
    wipe($&record)
    esp32.uart_print("[BOND] durable generation: ")
    esp32.uart_print_hex(next)
    esp32.uart_println("")
    << true
}

fn maybe_persist_new_bond(host $&bt.PeripheralHost, store $&BondStore, now int) {
    if !host.connected || !host.encrypted || host.closing || !host.bond_available || store.error != 0 {
        store.pending_ms = -1
        <<
    }
    if now < store.next_check { << }
    store.next_check = now + 500
    $snapshot := host.bond_snapshot(bt.bond_record_next_generation(store.generation))
    changed := bt.bond_record_valid(&snapshot) && !bt.bond_record_same_payload(&snapshot,&store.current)
    wipe($&snapshot)
    if !changed { store.pending_ms = -1
        << }
    if store.pending_ms < 0 { store.pending_ms = now }
    // Wait for key distribution to leave the controller and the central
    // to finish its pairing work. Flash is written only after actual disconnect.
    if now - store.pending_ms < 2000 || host.acl_outstanding != 0 { << }
    $disconnect := host.request_disconnect(0)
    wipe($&disconnect)
}
