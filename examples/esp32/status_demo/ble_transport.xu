fn stack_unmodified_bytes() int {
    for i in 64:4096 {
        // Foreground Wi-Fi scratch is separate from all LL/BB IRQ workers.
        rom_call6(0x4000C2C8,0x3FFECC00,0x3FFD8000 + i * 4,4,0,0,0)
        if volatile_load(0x3FFECC00) != 0xA5A5A5A5 { << i * 4 }
    }
    << 16384
}

