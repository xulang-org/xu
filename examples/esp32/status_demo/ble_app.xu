@main

#embedded/chips/esp32
#embedded/bluetooth as bt

fn ble_display(ui $&Dashboard, host &bt.PeripheralHost, advertising bool) {
    if host.connected {
        if host.closing { ui_ble(ui,3,"DISCONNECTING") }
        else if host.encrypted && host.bond_available {
            if host.hid_notifications_enabled(bt.ATT_HANDLE_KEYBOARD_REPORT) { ui_ble(ui,4,"ENC ON / HID READY") }
            else { ui_ble(ui,4,"ENC ON / HID WAIT") }
        }
        else if host.encrypted { ui_ble(ui,3,"ENC ON / KEY EXCHANGE") }
        else { ui_ble(ui,3,"ENC OFF / PAIRING") }
    } else if advertising { ui_ble(ui,2,"等待连接") }
    else { ui_ble(ui,1,"准备中") }
}
fn run_ble(panel &Panel, ui $&Dashboard) {
    ui_ble(ui,1,"准备中")
    ui_set(ui,3,"F24: WAIT FOR HOST",UI_MUTED)
    ui_flush(panel,ui)
    esp32.irq_rom_set_level(15)
    esp32.irq_rom_mask(0 - 1)
    if !esp32.radio_controller_memory_init() { ui_ble(ui,5,"BLE ERROR")
        ui_flush(panel,ui)
        << }
    $host := bt.peripheral_host_create([0x52,0x55,0x58,0x32,0x10,0xC2],esp32.smp_aes128_le,rf_entropy)
    $bonds := bond_store_load($&host)
    if bonds.error != 0 || !bind_platform() || !calibrate_radio() || !controller_init() {
        ui_ble(ui,5,"BLE ERROR")
        stop_radio()
        ui_flush(panel,ui)
        << }
    $clock := clock_create()
    // HID reports are sent only after an explicit touch/UART command.
    $probe := HidProbe{step: 5,pressed_at: 0}
    stack_guard_init()
    if !host.set_device_name("XU-PURE-HID14") || !configure_advertising($&host,$&clock,$&probe) ||
        !initialize_auth_patch() { ui_ble(ui,5,"BLE ERROR")
        stop_radio()
        ui_flush(panel,ui)
        << }
    host.accept_connection_parameters = true
    volatile_store(0x3FFD7EFC,0)
    volatile_store(0x3FF7100C,(volatile_load(0x3FF7100C) & 0xFFFEFFFF) | 0x10000)
    volatile_store(0x3FF7100C,volatile_load(0x3FF7100C) | 0x400)
    if !esp32.bt_irq_rom_enable() || !esp32.bt_irq_rom_bb_enable() { ui_ble(ui,5,"BLE ERROR")
        stop_radio()
        ui_flush(panel,ui)
        << }
    volatile_store(0x3FFD7E88,volatile_load(0x3FFE0710))
    volatile_store(0x3FFD7E8C,volatile_load(0x3FFE0730))
    if !select_irq_placement(2) { ui_ble(ui,5,"BLE ERROR")
        stop_radio()
        ui_flush(panel,ui)
        << }
    esp32.irq_rom_set_level(0)
    volatile_store(0x3FFD7174,0x524E4731)
    if !boot_command($&host,$&clock,$&probe,0x200A,[1],7) { ui_ble(ui,5,"BLE ERROR")
        stop_radio()
        ui_flush(panel,ui)
        << }
    host.needs_advertising = false
    $advertising := true
    $touch := touch_state_create()
    $want_wifi := false
    $closing_started := -1
    $last_health := clock_now($&clock)
    $painted := false
    while true {
        rom_call6(0x40019CDC,0,0,0,0,0,0)
        now := clock_now($&clock)
        if !stack_guard_ok() || clock.failed || !host.ready || volatile_load(0x3FFD7160) != 0 ||
            esp32.bt_irq_rom_recovery_error() != 0 || esp32.bt_irq_rom_bb_error() != 0 ||
            esp32.phy_tracking_error() != 0 || esp32.llc_auth_rom_error() != 0 {
            ui_ble(ui,5,"BLE ERROR")
            stop_radio()
            ui_flush(panel,ui)
            esp32.uart_println("[FAIL] UI BLE controller")
            << }
        for packet in 0:32 {
            $incoming := take_controller_frame()
            if incoming.len == 0 { <- }
            feed_host($&host,&incoming,$&clock,$&probe)
            wipe($&incoming)
        }
        if host.connected { advertising = false }
        $action := touch_action($&touch,2)
        if esp32.uart_rx_available() {
            command := esp32.uart_read_char()
            if command == 119 { action = 1 }
            if command == 107 { action = 4 }
            if command == 109 || command == 99 { request_other_reports($&host,command) }
        }
        if action == 1 { want_wifi = true }
        if action == 4 && request_f24(&host,$&probe) {
            ui_set(ui,3,"F24: REQUESTED",UI_AMBER)
        }
        if want_wifi && host.connected && !host.closing {
            $disconnect := host.request_disconnect(0)
            wipe($&disconnect)
        }
        if host.closing {
            if closing_started < 0 { closing_started = now }
            if now - closing_started >= 5000 {
                ui_ble(ui,5,"BLE ERROR")
                stop_radio()
                ui_flush(panel,ui)
                << }
        } else { closing_started = -1 }
        maybe_persist_new_bond($&host,$&bonds,now)
        maybe_queue_f24($&host,now,$&probe)
        $out := host.poll(clock_now($&clock))
        if commit_host_output($&host,$&out,$&clock,$&probe) < 0 {
            ui_ble(ui,5,"BLE ERROR")
            stop_radio()
            ui_flush(panel,ui)
            << }
        if !host.connected && (host.needs_advertising || want_wifi) && host.command_credits > 0 {
            if advertising {
                if !boot_command($&host,$&clock,$&probe,0x200A,[0],7) { << }
                advertising = false
            }
            if !bond_store_save(&host,$&bonds) { ui_ble(ui,5,"BLE ERROR")
                stop_radio()
                ui_flush(panel,ui)
                << }
            if want_wifi { stop_radio()
                restart_mode(1) }
            if !boot_command($&host,$&clock,$&probe,0x200A,[1],7) { << }
            host.needs_advertising = false
            advertising = true
        }
        ble_display(ui,&host,advertising)
        if host.hid_notifications_enabled(bt.ATT_HANDLE_KEYBOARD_REPORT) && probe.step == 5 {
            ui_set(ui,3,"TAP HERE: F24 TEST",UI_BLUE)
        } else if probe.step == 5 { ui_set(ui,3,"F24: WAIT FOR HOST",UI_MUTED)
        } else if probe.step == 4 { ui_set(ui,3,"F24: PRESS/RELEASE SENT",UI_GREEN) }
        ui_tick(panel,ui)
        if !painted && ui.job < 0 && ui.dirty == 0 {
            painted = true
            esp32.uart_println("[READY] Xu LCD BLE status")
        }
        if now - last_health >= 5000 {
            last_health = now
            esp32.uart_print("[STATE] BLE connected/encrypted/bond: ")
            if host.connected { esp32.uart_print_hex(1) } else { esp32.uart_print_hex(0) }
            if host.encrypted { esp32.uart_print_hex(1) } else { esp32.uart_print_hex(0) }
            if host.bond_available { esp32.uart_print_hex(1) } else { esp32.uart_print_hex(0) }
            esp32.uart_println("")
        }
        esp32.rom_delay_us(1000)
    }
}
