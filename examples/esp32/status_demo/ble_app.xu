@main

#embedded/chips/esp32
#embedded/bluetooth as bt
#embedded/chips/esp32/wifi_radio

fn ble_display(ui $&Dashboard, host &bt.PeripheralHost, advertising bool) {
    if host.connected {
        if host.closing { ui_ble(ui,3,"DISCONNECTING") }
        else if host.encrypted && host.bond_available {
            if host.hid_notifications_enabled(bt.ATT_HANDLE_KEYBOARD_REPORT) { ui_ble(ui,4,"ENC ON / HID READY") }
            else { ui_ble(ui,4,"ENC ON / HID WAIT") }
        }
        else if host.encrypted { ui_ble(ui,3,"ENC ON / KEY EXCHANGE") }
        else { ui_ble(ui,3,"ENC OFF / PAIRING") }
    } else if advertising { ui_ble(ui,2,"等待连接") }
    else { ui_ble(ui,1,"准备中") }
}


fn wifi_boot(device $&esp32.WifiDevice, panel &Panel, ui $&Dashboard) bool {
    ui_wifi(ui,1,"--")
    ui_flush(panel,ui)
    if !device.install_backend(wifi_radio.backend()) || !device.init() { << false }
    ui_set(ui,5,configured_ssid(),UI_TEXT)
    ui_wifi(ui,2,"--")
    ui_flush(panel,ui)
    if !device.connect(configured_ssid(),configured_password()) { << false }
    ui_wifi(ui,3,device.get_ip())
    if !device.ping_gateway(5000) { << false }
    ui_set(ui,7,"-- dBm / GW OK",UI_GREEN)
    esp32.uart_println("[READY] coex Wi-Fi baseline")
    << true
}
fn ble_boot(host $&bt.PeripheralHost, clock $&CycleClock, probe $&HidProbe, channel int) bool {
    if !bind_platform() || !controller_init() { << false }
    stack_guard_init()
    if !host.set_device_name("XU-PURE-HID14") ||
        !configure_advertising(host,clock,probe) || !initialize_auth_patch() { << false }
    host.accept_connection_parameters = true
    if !esp32.wifi_phy_coexist_enable(channel) { << false }
    volatile_store(0x3FFD7EFC,0)
    volatile_store(0x3FF7100C,(volatile_load(0x3FF7100C) & 0xFFFEFFFF) | 0x10400)
    if !esp32.bt_irq_rom_enable() || !esp32.bt_irq_rom_bb_enable() { << false }
    volatile_store(0x3FFD7E88,volatile_load(0x3FFE0710))
    volatile_store(0x3FFD7E8C,volatile_load(0x3FFE0730))
    if !select_irq_placement(2) { << false }
    esp32.irq_rom_set_level(0)
    volatile_store(0x3FFD7174,0x524E4731)
    if !boot_command(host,clock,probe,0x200A,[1],7) { << false }
    host.needs_advertising = false
    << true
}
fn coex_health(device &esp32.WifiDevice, host &bt.PeripheralHost) {
    esp32.uart_print("[STATE] BOTH wifi/ble/enc/sub/echo: ")
    if device.is_connected() { esp32.uart_print_hex(1) } else { esp32.uart_print_hex(0) }
    if host.connected { esp32.uart_print_hex(1) } else { esp32.uart_print_hex(0) }
    if host.encrypted { esp32.uart_print_hex(1) } else { esp32.uart_print_hex(0) }
    if host.hid_notifications_enabled(bt.ATT_HANDLE_KEYBOARD_REPORT) { esp32.uart_print_hex(1) } else { esp32.uart_print_hex(0) }
    esp32.uart_print_hex(wifi_radio.gateway_replies(&device.session))
    esp32.uart_println("")
}
fn coex_guard_ok() bool {
    << volatile_load(0x3FFECFF0) == 0x58435731 && volatile_load(0x3FFECFF4) == 0x58435732 &&
        (volatile_load(0x3FF000A8) & 0x60) == 0
}
fn coex_save_bond(host &bt.PeripheralHost, bonds $&BondStore) bool {
    if host.connected || host.closing || bonds.error != 0 { << false }
    if !host.bond_available { << true }
    $snapshot := host.bond_snapshot(bt.bond_record_next_generation(bonds.generation))
    changed := bt.bond_record_valid(&snapshot) && !bt.bond_record_same_payload(&snapshot,&bonds.current)
    wipe($&snapshot)
    if !changed { << true }
    level := esp32.irq_rom_set_level(15)
    mask := esp32.irq_rom_mask(0 - 1)
    saved := esp32.wifi_coexist_pause_receive()
    $ok := false
    if saved >= 0 {
        ok = bond_store_save(host,bonds)
        if !esp32.wifi_coexist_resume_receive(saved) { ok = false }
    }
    esp32.irq_rom_unmask(mask)
    esp32.irq_rom_set_level(level)
    << ok
}
fn coex_loop(device $&esp32.WifiDevice, host $&bt.PeripheralHost, bonds $&BondStore, clock $&CycleClock, probe $&HidProbe, panel &Panel, ui $&Dashboard) {
    $touch := touch_state_create()
    $advertising := true
    $painted := false
    $last_health := clock_now(clock)
    $last_probe := last_health
    $last_replies := wifi_radio.gateway_replies(&device.session)
    while true {
        rom_call6(0x40019CDC,0,0,0,0,0,0)
        now := clock_now(clock)
        if !stack_guard_ok() || !coex_guard_ok() || clock.failed || !host.ready ||
            volatile_load(0x3FFD7160) != 0 || esp32.bt_irq_rom_recovery_error() != 0 ||
            esp32.bt_irq_rom_bb_error() != 0 || esp32.phy_tracking_error() != 0 || esp32.llc_auth_rom_error() != 0 {
            esp32.uart_print("[FAIL] coex controller ")
            esp32.uart_print_hex(volatile_load(0x3FFD7160))
            esp32.uart_print_hex(esp32.bt_irq_rom_recovery_error())
            esp32.uart_print_hex(esp32.bt_irq_rom_bb_error())
            esp32.uart_print_hex(esp32.phy_tracking_error())
            esp32.uart_print_hex(esp32.llc_auth_rom_error())
            esp32.uart_println("")
            << }
        for packet in 0:32 {
            $incoming := take_controller_frame()
            if incoming.len == 0 { <- }
            feed_host(host,&incoming,clock,probe)
            wipe($&incoming)
        }
        if host.connected { advertising = false }
        $action := touch_action($&touch)
        if esp32.uart_rx_available() {
            command := esp32.uart_read_char()
            if command == 107 { action = 4 }
            if command == 112 { last_probe = now - 2000 }
            if command == 113 { coex_health(device,host) }
        }
        if action == 1 { last_probe = now - 2000 }
        if action == 4 && request_f24(host,probe) {
            ui_set(ui,3,"F24: REQUESTED",UI_AMBER) }
        maybe_persist_new_bond(host,bonds,now)
        maybe_queue_f24(host,now,probe)
        $out := host.poll(clock_now(clock))
        if commit_host_output(host,$&out,clock,probe) < 0 {
            esp32.uart_println("[FAIL] coex H4")
            << }
        if !device.poll(0) { ui_wifi(ui,4,"--")
            ui_set(ui,7,"-- dBm / GW WAIT",UI_MUTED) }
        else { ui_wifi(ui,3,device.get_ip()) }
        if now - last_probe >= 2000 && device.is_connected() {
            last_probe = now
            if !wifi_radio.probe_gateway($&device.session) {
                esp32.uart_println("[FAIL] coex gateway submit")
                << }
        }
        if wifi_radio.gateway_replies(&device.session) != last_replies {
            last_replies = wifi_radio.gateway_replies(&device.session)
            esp32.uart_print("[STATE] coex gateway reply ")
            esp32.uart_print_hex(last_replies)
            esp32.uart_println("")
            ui_set(ui,7,"-- dBm / GW OK",UI_GREEN)
        }
        if !host.connected && host.needs_advertising && host.command_credits > 0 {
            if advertising {
                if !boot_command(host,clock,probe,0x200A,[0],7) { << }
                advertising = false
            }
            if !coex_save_bond(host,bonds) {
                esp32.uart_println("[FAIL] coex bond save")
                << }
            if !boot_command(host,clock,probe,0x200A,[1],7) { << }
            host.needs_advertising = false
            advertising = true
        }
        ble_display(ui,host,advertising)
        if host.hid_notifications_enabled(bt.ATT_HANDLE_KEYBOARD_REPORT) && probe.step == 5 {
            ui_set(ui,3,"TAP HERE: F24 TEST",UI_BLUE)
        } else if probe.step == 5 { ui_set(ui,3,"F24: WAIT FOR HOST",UI_MUTED)
        } else if probe.step == 4 { ui_set(ui,3,"F24: PRESS/RELEASE SENT",UI_GREEN) }
        ui_tick(panel,ui)
        if !painted && ui.job < 0 && ui.dirty == 0 {
            painted = true
            esp32.uart_println("[READY] Xu LCD coexistence status") }
        if now - last_health >= 5000 { last_health = now
            coex_health(device,host) }
        esp32.rom_delay_us(1000)
    }
}
fn run_device(device $&esp32.WifiDevice, host $&bt.PeripheralHost, bonds $&BondStore, panel &Panel, ui $&Dashboard) {
    if !wifi_boot(device,panel,ui) { ui_wifi(ui,4,"--")
        ui_flush(panel,ui)
        esp32.uart_println("[FAIL] coex Wi-Fi boot")
        << }
    $clock := clock_create()
    $probe := HidProbe{step: 5,pressed_at: 0}
    ui_ble(ui,1,"准备中")
    ui_flush(panel,ui)
    volatile_store(0x3FFECFF0,0x58435731)
    volatile_store(0x3FFECFF4,0x58435732)
    if !ble_boot(host,$&clock,$&probe,device.channel) { esp32.uart_println("[FAIL] coex BLE boot")
        ui_ble(ui,5,"BLE ERROR")
        device.disconnect()
        stop_radio()
        ui_flush(panel,ui)
        << }
    coex_loop(device,host,bonds,$&clock,$&probe,panel,ui)
    device.disconnect()
    stop_radio()
    ui_wifi(ui,4,"--")
    ui_ble(ui,5,"BLE ERROR")
    ui_flush(panel,ui)
}
fn run_both(panel &Panel, ui $&Dashboard) {
    $host := bt.peripheral_host_create([0x52,0x55,0x58,0x32,0x10,0xC2],esp32.smp_aes128_le,rf_entropy)
    $bonds := bond_store_load($&host)
    $device := esp32.wifi_create()
    if bonds.error == 0 { run_device($&device,$&host,$&bonds,panel,ui) }
}
