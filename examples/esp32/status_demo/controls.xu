@main

#embedded/chips/esp32

struct TouchState {
    sensor XPT2046
    down bool
    x int
    y int
}
fn touch_state_create() TouchState {
    $sensor := touch_create(25,32,39,33,36,320,240)
    sensor.init()
    << TouchState{sensor: sensor,down: false,x: 0,y: 0}
}
fn touch_action(t $&TouchState) int {
    pen := esp32.gpio_get(36) == 0
    if pen && !t.down {
        $x := 0
        $y := 0
        $rawx := 0
        $rawy := 0
        $z := 0
        if t.sensor.get_touch_raw($&x,$&y,$&rawx,$&rawy,$&z) {
            t.x = x
            t.y = y
            t.down = true
        }
    } else if !pen && t.down {
        t.down = false
        if t.y >= 33 && t.y <= 130 {
            if t.y >= 99 { << 4 }
        }
        if t.y >= 135 && t.y <= 232 {
            << 1
        }
    }
    << 0
}
