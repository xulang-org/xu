@main

#embedded/chips/esp32
#embedded/display
#embedded/display/geometry

// St7789 LCD Controller Driver for ESP32 and Embedded Systems

pub const LCD_SWRESET = 0x01
pub const LCD_SLPOUT  = 0x11
pub const LCD_NORON   = 0x13
pub const LCD_INVOFF  = 0x20
pub const LCD_INVON   = 0x21
pub const LCD_DISPOFF = 0x28
pub const LCD_DISPON  = 0x29
pub const LCD_CASET   = 0x2A
pub const LCD_RASET   = 0x2B
pub const LCD_RAMWR   = 0x2C
pub const LCD_MADCTL  = 0x36
pub const LCD_COLMOD  = 0x3A

pub struct St7789 {
    pub spi esp32.SpiBus
    pub dc_pin int
    pub dc_mask int
    pub bl_pin int
    pub bl_mask int
    pub width int
    pub height int
}

fn st7789_create(sck int, mosi int, cs int, dc int, bl int, width int, height int) St7789 {
    bus := esp32.spi_init(sck, mosi, -1, cs)
    esp32.gpio_init(dc, esp32.PIN_OUTPUT)
    dc_m := esp32.gpio_pin_mask(dc)

    $bl_m := 0
    if bl >= 0 {
        esp32.gpio_init(bl, esp32.PIN_OUTPUT)
        bl_m = esp32.gpio_pin_mask(bl)
    }

    << St7789{
        spi: bus,
        dc_pin: dc,
        dc_mask: dc_m,
        bl_pin: bl,
        bl_mask: bl_m,
        width: width,
        height: height
    }
}

fn st7789_alias(sck int, mosi int, cs int, dc int, bl int, width int, height int) St7789 {
    << st7789_create(sck, mosi, cs, dc, bl, width, height)
}

pub const LEDC_CONF_REG         = 0x3FF59000
pub const LEDC_DUTY_REG         = 0x3FF59008
pub const LEDC_START_REG        = 0x3FF5900C
pub const LEDC_TIMER_REG        = 0x3FF59140
pub const DPORT_PERIP_CLK_REG   = 0x3FF000C0
pub const GPIO21_OUT_SEL_REG    = 0x3FF44584

pub fn (dev &St7789) set_brightness(percent int) {
    if dev.bl_mask == 0 {
        <<
    }
    $p := percent
    if p < 0 { p = 0 }
    if p > 100 { p = 100 }

    // Ensure GPIO 21 uses simple GPIO output mode (signal 256)
    volatile_store(GPIO21_OUT_SEL_REG, 256)

    if p == 0 {
        esp32.gpio_set_low_mask(dev.bl_mask)
    } else {
        esp32.gpio_set_high_mask(dev.bl_mask)
    }
}

pub fn (dev &St7789) backlight(on bool) {
    if dev.bl_mask != 0 {
        volatile_store(GPIO21_OUT_SEL_REG, 256)
        if on {
            esp32.gpio_set_high_mask(dev.bl_mask)
        } else {
            esp32.gpio_set_low_mask(dev.bl_mask)
        }
    }
}

pub fn (dev &St7789) send_cmd(cmd int) {
    esp32.gpio_set_low_mask(dev.dc_mask) // DC = 0 (Command)
    dev.spi.cs_low()
    dev.spi.write_byte(cmd)
    dev.spi.cs_high()
}

pub fn (dev &St7789) send_data(data int) {
    esp32.gpio_set_high_mask(dev.dc_mask) // DC = 1 (Data)
    dev.spi.cs_low()
    dev.spi.write_byte(data)
    dev.spi.cs_high()
}

pub fn (dev &St7789) send_data16(data int) {
    esp32.gpio_set_high_mask(dev.dc_mask) // DC = 1 (Data)
    dev.spi.cs_low()
    dev.spi.write_word(data)
    dev.spi.cs_high()
}

pub fn (dev &St7789) init() {
    // Ensure backlight pin is routed to GPIO and turned on immediately
    volatile_store(GPIO21_OUT_SEL_REG, 256)
    dev.backlight(true)

    // Software reset
    dev.send_cmd(LCD_SWRESET)
    esp32.rom_delay_us(150000)

    // Sleep out
    dev.send_cmd(LCD_SLPOUT)
    esp32.rom_delay_us(120000)

    // Color mode: 16-bit RGB565 (0x55)
    dev.send_cmd(LCD_COLMOD)
    dev.send_data(0x55)
    esp32.rom_delay_us(10000)

    // Orientation: Landscape 320x240, RGB order (0x70)
    dev.send_cmd(LCD_MADCTL)
    dev.send_data(0x70)
    esp32.rom_delay_us(10000)

    // Display inversion off
    dev.send_cmd(LCD_INVOFF)
    esp32.rom_delay_us(10000)

    // Normal display on
    dev.send_cmd(LCD_NORON)
    esp32.rom_delay_us(10000)

    // Display on
    dev.send_cmd(LCD_DISPON)
    esp32.rom_delay_us(100000)

    // Backlight on
    dev.backlight(true)
}

fn (dev &St7789) send_range(cmd int, v0 int, v1 int) {
    dev.send_cmd(cmd)
    esp32.gpio_set_high_mask(dev.dc_mask)
    dev.spi.cs_low()
    dev.spi.write_byte((v0 >> 8) & 0xFF)
    dev.spi.write_byte(v0 & 0xFF)
    dev.spi.write_byte((v1 >> 8) & 0xFF)
    dev.spi.write_byte(v1 & 0xFF)
    dev.spi.cs_high()
}

pub fn (dev &St7789) set_window(x0 int, y0 int, x1 int, y1 int) {
    dev.send_range(LCD_CASET, x0, x1)
    dev.send_range(LCD_RASET, y0, y1)
    dev.send_cmd(LCD_RAMWR)
}

pub fn (dev &St7789) fill_rect(x int, y int, w int, h int, color_rgb565 int) {
    if w <= 0 || h <= 0 {
        <<
    }
    x0 := x
    y0 := y
    x1 := x + w - 1
    y1 := y + h - 1
    dev.set_window(x0, y0, x1, y1)

    // Write pixel buffer
    esp32.gpio_set_high_mask(dev.dc_mask)
    dev.spi.cs_low()
    dev.spi.write_fill(color_rgb565, w * h)
    dev.spi.cs_high()
}

pub fn (dev &St7789) clear(color_rgb565 int) {
    dev.fill_rect(0, 0, dev.width, dev.height, color_rgb565)
}

pub fn (dev &St7789) draw_pixel(x int, y int, color_rgb565 int) {
    if x >= 0 && x < dev.width && y >= 0 && y < dev.height {
        dev.set_window(x, y, x, y)
        esp32.gpio_set_high_mask(dev.dc_mask)
        dev.spi.cs_low()
        dev.spi.write_word(color_rgb565)
        dev.spi.cs_high()
    }
}

// Controller/bus details stop at this adapter boundary. Widgets only see Surface.
fn st7789_fill(dev $&St7789, area &geometry.Rect, color int) bool {
    dev.fill_rect(area.x,area.y,area.width,area.height,color)
    << true
}
fn st7789_write(dev $&St7789, span &geometry.Span, pixels &[]int) bool {
    dev.set_window(span.x,span.y,span.x + span.count - 1,span.y)
    esp32.gpio_set_high_mask(dev.dc_mask)
    dev.spi.cs_low()
    for i in 0:span.count { dev.spi.write_word(pixels[span.offset + i]) }
    dev.spi.cs_high()
    << true
}
fn st7789_surface_create(sck int, mosi int, cs int, dc int, bl int, width int, height int) display.Surface#St7789 {
    $dev := st7789_create(sck,mosi,cs,dc,bl,width,height)
    dev.init()
    << display.create(width,height,dev,st7789_fill,st7789_write)
}
