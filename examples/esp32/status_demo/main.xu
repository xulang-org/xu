@main
#embedded/chips/esp32
fn configured_ssid() string { << "" }
fn configured_password() string { << "" }
fn main() int {
    esp32.init()
    $surface := st7789_surface_create(14,13,15,2,21,320,240)
    $ui := ui_create()
    ui.on_change = board_ui_field
    if !ui_frame($&ui,$&surface) { esp32.uart_println("[FAIL] display surface")
        << 1 }
    esp32.uart_println("[DISPLAY] status cards rendered")
    esp32.irq_rom_set_level(15)
    esp32.irq_rom_mask(0 - 1)
    run_both($&ui,$&surface)
    while true { esp32.rom_delay_us(1000) }
    << 0
}
