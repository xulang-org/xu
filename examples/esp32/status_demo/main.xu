@main

#embedded/chips/esp32
#embedded/chips/esp32/wifi_radio

// Filled only in the private build copy; deployment credentials stay local.
fn configured_ssid() string { << "" }
fn configured_password() string { << "" }

fn run_wifi(panel &Panel, ui $&Dashboard) {
    $device := esp32.wifi_create()
    ui_wifi(ui,1,"--")
    ui_flush(panel,ui)
    if !device.install_backend(wifi_radio.backend()) || !device.init() {
        ui_wifi(ui,4,"--")
        ui_flush(panel,ui)
        esp32.uart_println("[FAIL] Wi-Fi")
        <<
    }
    ssid := configured_ssid()
    password := configured_password()
    ui_set(ui,5,configured_ssid(),UI_TEXT)
    ui_set(ui,7,"-- dBm / GW WAIT",UI_MUTED)
    ui_wifi(ui,2,"--")
    ui_flush(panel,ui)
    if ssid.len == 0 || !device.connect(ssid,password) {
        ui_wifi(ui,4,"--")
        ui_flush(panel,ui)
        esp32.uart_println("[FAIL] Wi-Fi")
        <<
    }
    ui_wifi(ui,3,device.get_ip())
    if device.ping_gateway(5000) { ui_set(ui,7,"-- dBm / GW OK",UI_GREEN) }
    else { ui_set(ui,7,"-- dBm / GW FAIL",UI_AMBER) }
    $touch := touch_state_create()
    $painted := false
    $requested_off := false
    while true {
        if !requested_off {
            if !device.poll(1) {
                ui_wifi(ui,4,"--")
                ui_set(ui,7,"-- dBm / GW WAIT",UI_MUTED)
            } else { ui_wifi(ui,3,device.get_ip()) }
        }
        ui_tick(panel,ui)
        if !painted && ui.job < 0 && ui.dirty == 0 {
            esp32.uart_println("[READY] Xu LCD Wi-Fi status")
            painted = true
        }
        $action := touch_action($&touch,1)
        if esp32.uart_rx_available() {
            command := esp32.uart_read_char()
            if command == 98 { action = 2 }
            if command == 114 || command == 112 { action = 3 }
            if command == 120 { device.disconnect()
                requested_off = true
                ui_wifi(ui,0,"--")
                ui_set(ui,7,"TAP CARD: CONNECT",UI_MUTED) }
            if command == 113 { esp32.uart_print("[STATE] actual IP=")
                esp32.uart_println(device.get_ip()) }
        }
        if action == 2 {
            device.disconnect()
            ui_wifi(ui,0,"--")
            ui_set(ui,3,"SWITCHING TO BLE",UI_AMBER)
            ui_flush(panel,ui)
            restart_mode(2)
        }
        if action == 3 {
            if device.is_connected() {
                if device.ping_gateway(5000) { ui_set(ui,7,"-- dBm / GW OK",UI_GREEN) }
                else { ui_set(ui,7,"-- dBm / GW FAIL",UI_AMBER) }
            } else { restart_mode(1) }
        }
    }
}
fn main() int {
    esp32.init()
    mode := selected_mode()
    $panel := panel_create(14,13,15,2,21,320,240)
    panel.init()
    $ui := ui_create(mode)
    ui_frame(&panel,$&ui)
    esp32.uart_print("[MODE] active ")
    esp32.uart_print_hex(mode)
    esp32.uart_println("")
    if mode == 1 { run_wifi(&panel,$&ui) }
    else { run_ble(&panel,$&ui) }
    $touch := touch_state_create()
    while true {
        $action := touch_action($&touch,mode)
        if esp32.uart_rx_available() {
            command := esp32.uart_read_char()
            if command == 98 { action = 2 }
            if command == 119 { action = 1 }
        }
        if action == 3 { action = 1 }
        if action == 1 || action == 2 { restart_mode(action) }
        esp32.rom_delay_us(1000)
    }
    << 0
}
