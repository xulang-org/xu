@main

#embedded/chips/esp32
#embedded/wifi/session

const UI_BG = 0x0842
const UI_SURFACE = 0x18E3
const UI_BORDER = 0x2965
const UI_TEXT = 0xFFFF
const UI_MUTED = 0x9CD3
const UI_BLUE = 0x2BD9
const UI_GREEN = 0x2DE5
const UI_AMBER = 0xFD20
const UI_RED = 0xF980

struct Dashboard {
    lines []string
    colors []int
    dirty int
    job int
    column int
    row int
    mode int
    ble_state int
    wifi_state int
}

fn ui_create(mode int) Dashboard {
    << Dashboard{lines: ["待命", "XU-PURE-HID14", "等待连接", "TAP CARD: BLE MODE",
        "待命", "--", "--", "TAP CARD: WIFI MODE", "WIFI"],
        colors: [UI_MUTED,UI_TEXT,UI_MUTED,UI_AMBER,UI_MUTED,UI_TEXT,UI_GREEN,UI_MUTED,UI_BLUE],
        dirty: 511, job: -1, column: 0, row: 0, mode: mode, ble_state: 0, wifi_state: 0}
}

fn ui_set(ui $&Dashboard, index int, text string, color int) {
    if index < 0 || index > 8 { << }
    if ui.lines[index] == text && ui.colors[index] == color { << }
    ui.lines[index] = text
    ui.colors[index] = color
    ui.dirty = ui.dirty | (1 << index)
    if ui.job == index { ui.job = -1 }
    if index != 5 {
        esp32.uart_print("[FIELD] ")
        esp32.uart_print_hex(index)
        esp32.uart_print(" ")
        esp32.uart_println(session.copy(&ui.lines[index]))
    }
}

fn ui_x(index int) int {
    if index == 0 { << 234 }
    if index == 4 { << 244 }
    if index == 8 { << 234 }
    << 64
}
fn ui_y(index int) int {
    if index == 0 { << 39 }
    if index == 1 { << 66 }
    if index == 2 { << 83 }
    if index == 3 { << 103 }
    if index == 4 { << 141 }
    if index == 5 { << 168 }
    if index == 6 { << 185 }
    if index == 7 { << 202 }
    << 6
}
fn ui_width(index int) int {
    if index == 0 { << 68 }
    if index == 4 { << 58 }
    if index == 8 { << 78 }
    << 238
}

// Sixteen pixels per call. The radio event loop runs between chunks.
fn text_chunk(panel &Panel, text &string, color int, bg int,
    x int, y int, width int, column int, row int) {
    $count := 16
    if width - column < count { count = width - column }
    if count < 1 { << }
    $at := 0
    $left := 0
    $code := text_code(text,at)
    $glyph_width := 8
    if code >= 128 { glyph_width = 16 }
    while at < text.len && left + glyph_width <= column {
        left += glyph_width
        at += text_step(text,at)
        code = text_code(text,at)
        glyph_width = 8
        if code >= 128 { glyph_width = 16 }
    }
    $bits := font_bits(code,row)
    panel.set_window(x + column,y + row,x + column + count - 1,y + row)
    esp32.gpio_set_high_mask(panel.dc_mask)
    panel.spi.cs_low()
    for j in 0:count {
        pixel := column + j
        if pixel >= left + glyph_width {
            left += glyph_width
            at += text_step(text,at)
            code = text_code(text,at)
            glyph_width = 8
            if code >= 128 { glyph_width = 16 }
            bits = font_bits(code,row)
        }
        $value := bg
        if at < text.len && (bits & (1 << (15 - (pixel - left)))) != 0 { value = color }
        panel.spi.write_word(value)
    }
    panel.spi.cs_high()
}

fn ui_tick(panel &Panel, ui $&Dashboard) bool {
    if ui.job < 0 {
        for i in 0:9 {
            if (ui.dirty & (1 << i)) != 0 {
                ui.job = i
                ui.dirty = ui.dirty & (0 - 1 - (1 << i))
                ui.column = 0
                ui.row = 0
                <-
            }
        }
    }
    if ui.job < 0 { << false }
    job := ui.job
    text_chunk(panel,&ui.lines[job],ui.colors[job],UI_SURFACE,
        ui_x(job),ui_y(job),ui_width(job),ui.column,ui.row)
    ui.column += 16
    if ui.column >= ui_width(job) { ui.column = 0
        ui.row += 1 }
    if ui.row >= 16 { ui.job = -1 }
    << true
}
fn ui_flush(panel &Panel, ui $&Dashboard) {
    while ui_tick(panel,ui) {}
}
fn ui_label(panel &Panel, x int, y int, text string, color int, width int) {
    for row in 0:16 {
        $column := 0
        while column < width {
            text_chunk(panel,&text,color,UI_SURFACE,x,y,width,column,row)
            column += 16
        }
    }
}
fn ui_frame(panel &Panel, ui $&Dashboard) {
    panel.clear(UI_BG)
    panel.fill_rect(0,0,320,29,UI_SURFACE)
    ui_label(panel,10,6,"XU WIRELESS",UI_TEXT,160)
    panel.fill_rect(8,33,304,97,UI_SURFACE)
    panel.fill_rect(8,135,304,97,UI_SURFACE)
    panel.fill_rect(14,61,292,1,UI_BORDER)
    panel.fill_rect(14,163,292,1,UI_BORDER)
    ui_label(panel,16,39,"蓝牙键鼠",UI_TEXT,96)
    ui_label(panel,128,39,"BLE HID",UI_MUTED,96)
    ui_label(panel,16,66,"广播:",UI_MUTED,48)
    ui_label(panel,16,83,"状态:",UI_MUTED,48)
    ui_label(panel,16,103,"控制:",UI_MUTED,48)
    ui_label(panel,16,141,"无线网络",UI_TEXT,112)
    ui_label(panel,144,141,"WI-FI",UI_MUTED,80)
    ui_label(panel,16,168,"网络:",UI_MUTED,48)
    ui_label(panel,16,185,"IP:",UI_MUTED,48)
    ui_label(panel,16,202,"信号:",UI_MUTED,48)
    if ui.mode == 2 { ui_set(ui,8,"BLE",UI_BLUE) }
    ui_flush(panel,ui)
    esp32.uart_println("[DISPLAY] status cards rendered")
}
fn ui_wifi(ui $&Dashboard, state int, ip string) {
    if state == ui.wifi_state && ui.lines[6] == ip { << }
    ui.wifi_state = state
    if state == 1 { ui_set(ui,4,"准备中",UI_AMBER) }
    else if state == 2 { ui_set(ui,4,"连接中",UI_AMBER) }
    else if state == 3 { ui_set(ui,4,"已连接",UI_GREEN) }
    else if state == 4 { ui_set(ui,4,"失败",UI_RED) }
    else { ui_set(ui,4,"待命",UI_MUTED) }
    esp32.uart_print("[DISPLAY] WIFI state=")
    esp32.uart_print_hex(state)
    esp32.uart_print(" IP=")
    esp32.uart_println(session.copy(&ip))
    ui_set(ui,6,ip,UI_GREEN)
}
fn ui_ble(ui $&Dashboard, state int, detail string) {
    if state == ui.ble_state && ui.lines[2] == detail { << }
    ui.ble_state = state
    if state == 1 { ui_set(ui,0,"准备中",UI_AMBER) }
    else if state == 2 { ui_set(ui,0,"广播中",UI_BLUE) }
    else if state == 3 { ui_set(ui,0,"已连接",UI_AMBER) }
    else if state == 4 { ui_set(ui,0,"已配对",UI_GREEN) }
    else if state == 5 { ui_set(ui,0,"错误",UI_RED) }
    else { ui_set(ui,0,"待命",UI_MUTED) }
    ui_set(ui,2,detail,UI_MUTED)
    esp32.uart_print("[DISPLAY] BLE state=")
    esp32.uart_print_hex(state)
    esp32.uart_println("")
}
