@main

#embedded/chips/esp32

// Last 16 bytes of RTC slow RAM are owned by this demo. No ULP program runs.
// The complementary word and final commit reject uninitialized/power-loss RAM.
fn mode_read(address int) int {
    if address < 0x50001FF0 || address > 0x50001FFC || address % 4 != 0 { << -1 }
    rom_call6(esp32.ROM_MEMCPY,0x3FFD7DF0,address,4,0,0,0)
    << volatile_load(0x3FFD7DF0)
}
fn mode_write(address int, value int) {
    if address < 0x50001FF0 || address > 0x50001FFC || address % 4 != 0 { << }
    volatile_store(0x3FFD7DF0,value)
    rom_call6(esp32.ROM_MEMCPY,address,0x3FFD7DF0,4,0,0,0)
}
fn selected_mode() int {
    if mode_read(0x50001FF0) == 0x58555354 && mode_read(0x50001FFC) == 0x4D4F4445 {
        mode := mode_read(0x50001FF4)
        if (mode == 1 || mode == 2) && mode_read(0x50001FF8) == (mode ^ 0xFFFFFFFF) { << mode }
    }
    << 1
}
fn restart_mode(mode int) {
    if mode != 1 && mode != 2 { << }
    mode_write(0x50001FFC,0)
    mode_write(0x50001FF0,0x58555354)
    mode_write(0x50001FF4,mode)
    mode_write(0x50001FF8,mode ^ 0xFFFFFFFF)
    mode_write(0x50001FFC,0x4D4F4445)
    esp32.uart_print("[MODE] restarting into ")
    esp32.uart_print_hex(mode)
    esp32.uart_println("")
    esp32.rom_delay_us(10000)
    esp32.irq_rom_set_level(15)
    volatile_store(0x3FF48000,volatile_load(0x3FF48000) | 0x80000000)
    while true {}
}

struct TouchState {
    sensor XPT2046
    down bool
    x int
    y int
}
fn touch_state_create() TouchState {
    $sensor := touch_create(25,32,39,33,36,320,240)
    sensor.init()
    << TouchState{sensor: sensor,down: false,x: 0,y: 0}
}
fn touch_action(t $&TouchState, mode int) int {
    pen := esp32.gpio_get(36) == 0
    if pen && !t.down {
        $x := 0
        $y := 0
        $rawx := 0
        $rawy := 0
        $z := 0
        if t.sensor.get_touch_raw($&x,$&y,$&rawx,$&rawy,$&z) {
            t.x = x
            t.y = y
            t.down = true
        }
    } else if !pen && t.down {
        t.down = false
        if t.y >= 33 && t.y <= 130 {
            if mode == 1 { << 2 }
            if t.y >= 99 { << 4 }
        }
        if t.y >= 135 && t.y <= 232 {
            if mode == 2 { << 1 }
            << 3
        }
    }
    << 0
}
