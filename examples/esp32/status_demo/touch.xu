@main

#embedded/chips/esp32

// XPT2046 4-Wire Resistive Touch Screen Controller Driver
// Commonly used on ESP32 CYD (ESP32-2432S028) and TFT display modules

pub const XPT2046_CMD_X  = 0xD0 // Read X position (12-bit differential, PD=00)
pub const XPT2046_CMD_Y  = 0x90 // Read Y position (12-bit differential, PD=00)
pub const XPT2046_CMD_Z1 = 0xB0 // Read Pressure Z1 (12-bit differential, PD=00)
pub const XPT2046_CMD_Z2 = 0xC0 // Read Pressure Z2 (12-bit differential, PD=00)

pub struct XPT2046 {
    pub clk_pin int
    pub mosi_pin int
    pub miso_pin int
    pub cs_pin int
    pub irq_pin int
    pub width int
    pub height int
    pub min_x int
    pub max_x int
    pub min_y int
    pub max_y int
    pub swap_xy bool
    pub invert_x bool
    pub invert_y bool
    pub z_threshold int
}

fn touch_create(clk int, mosi int, miso int, cs int, irq int, width int, height int) XPT2046 {
    << XPT2046{
        clk_pin: clk,
        mosi_pin: mosi,
        miso_pin: miso,
        cs_pin: cs,
        irq_pin: irq,
        width: width,
        height: height,
        min_x: 200,
        max_x: 3700,
        min_y: 240,
        max_y: 3800,
        swap_xy: true,
        invert_x: false,
        invert_y: false,
        z_threshold: 150
    }
}

pub fn xpt2046_create(clk int, mosi int, miso int, cs int, irq int, width int, height int) XPT2046 {
    << touch_create(clk, mosi, miso, cs, irq, width, height)
}

pub fn (dev $&XPT2046) init() {
    esp32.gpio_init(dev.clk_pin, esp32.PIN_OUTPUT)
    esp32.gpio_set_low(dev.clk_pin)

    esp32.gpio_init(dev.mosi_pin, esp32.PIN_OUTPUT)
    esp32.gpio_set_low(dev.mosi_pin)

    if dev.cs_pin >= 0 {
        esp32.gpio_init(dev.cs_pin, esp32.PIN_OUTPUT)
        esp32.gpio_set_high(dev.cs_pin) // CS inactive (HIGH)
    }

    esp32.gpio_init(dev.miso_pin, esp32.PIN_INPUT)

    if dev.irq_pin >= 0 {
        esp32.gpio_init(dev.irq_pin, esp32.PIN_INPUT)
    }

    // Initial dummy conversion to arm XPT2046 into power-down state
    dev.read_adc(XPT2046_CMD_X)
}

pub fn (dev $&XPT2046) set_calibration(min_x int, max_x int, min_y int, max_y int, swap bool, inv_x bool, inv_y bool) {
    dev.min_x = min_x
    dev.max_x = max_x
    dev.min_y = min_y
    dev.max_y = max_y
    dev.swap_xy = swap
    dev.invert_x = inv_x
    dev.invert_y = inv_y
}

// Check if pen is currently touching the screen via pressure Z1
pub fn (dev &XPT2046) is_touched() bool {
    z := dev.read_adc(XPT2046_CMD_Z1)
    << z > dev.z_threshold
}

pub fn (dev &XPT2046) get_pressure() int {
    << dev.read_adc(XPT2046_CMD_Z1)
}

fn (dev &XPT2046) spi_transfer_byte(val int) int {
    $out_byte := 0
    $v := val
    $mask := 0x80

    while mask > 0 {
        if (v & mask) != 0 {
            esp32.gpio_set_high(dev.mosi_pin)
        } else {
            esp32.gpio_set_low(dev.mosi_pin)
        }
        esp32.delay_cycles(60)
        esp32.gpio_set_high(dev.clk_pin)
        esp32.delay_cycles(60)
        // Read MISO bit on rising/high clock
        bit := esp32.gpio_get(dev.miso_pin)
        out_byte = (out_byte << 1) | bit
        esp32.gpio_set_low(dev.clk_pin)
        esp32.delay_cycles(30)
        mask = mask >> 1
    }
    << out_byte
}

pub fn (dev &XPT2046) read_adc(cmd int) int {
    esp32.gpio_set_low(dev.clk_pin)
    esp32.gpio_set_low(dev.cs_pin)

    // Send command byte
    dev.spi_transfer_byte(cmd)

    // Read 16-bit conversion result
    msb := dev.spi_transfer_byte(0x00)
    lsb := dev.spi_transfer_byte(0x00)

    esp32.gpio_set_high(dev.cs_pin)
    esp32.gpio_set_low(dev.mosi_pin)

    // 12-bit ADC data is in bits [14:3]
    raw := ((msb << 8) | lsb) >> 3
    << raw & 0x0FFF
}

// Read filtered/averaged sample for an axis
fn (dev &XPT2046) read_axis_filtered(cmd int) int {
    $sum := 0
    $samples := 3
    for i in 0:samples {
        val := dev.read_adc(cmd)
        sum = sum + val
    }
    << sum / samples
}

fn map_coord(val int, min_val int, max_val int, max_res int, invert bool) int {
    range := max_val - min_val
    $mapped := 0
    if range > 0 {
        mapped = ((val - min_val) * max_res) / range
    }
    if invert {
        mapped = max_res - 1 - mapped
    }
    if mapped < 0 { mapped = 0 }
    if mapped >= max_res { mapped = max_res - 1 }
    << mapped
}

// Read raw coordinates, map to screen pixels, and optionally return raw ADC values
pub fn (dev &XPT2046) get_touch_raw(p_x $&int, p_y $&int, p_raw_x $&int, p_raw_y $&int, p_z $&int) bool {
    z := dev.read_adc(XPT2046_CMD_Z1)
    if z <= dev.z_threshold {
        << false
    }

    raw_x := dev.read_axis_filtered(XPT2046_CMD_X)
    raw_y := dev.read_axis_filtered(XPT2046_CMD_Y)

    if raw_x == 0 && raw_y == 0 {
        << false
    }

    *p_z = z
    *p_raw_x = raw_x
    *p_raw_y = raw_y

    $sx := raw_x
    $sy := raw_y
    if dev.swap_xy {
        sx = raw_y
        sy = raw_x
    }

    *p_x = map_coord(sx, dev.min_x, dev.max_x, dev.width, dev.invert_x)
    *p_y = map_coord(sy, dev.min_y, dev.max_y, dev.height, dev.invert_y)
    << true
}

pub fn (dev &XPT2046) get_touch(p_x $&int, p_y $&int) bool {
    $dummy_raw_x := 0
    $dummy_raw_y := 0
    $dummy_z := 0
    << dev.get_touch_raw(p_x, p_y, $&dummy_raw_x, $&dummy_raw_y, $&dummy_z)
}
