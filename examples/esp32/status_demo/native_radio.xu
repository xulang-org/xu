@main
#embedded/chips/esp32
#embedded/chips/esp32/flash

// Observation only; fixed ROM handlers, PDU status, and results are unchanged.
// E40 copy, E44 error/active bit8, E48 count, E4C kind/pre/handle,
// E50 instant/counter-before, E54 skip/counter-after, E58 skip/latency,
// E5C scheduled-before, E60 rounded halfslot, E64 anchor, E68 status/flags/role,
// E6C freeze, E70 interval16/queued count8/same-CS type1 count8, E74 event, E78 scheduled-after,
// E7C unpacked PDU. Only prepass samples; no retired postpass dereferences.
fn capture_read(address int, width int) int {
    native := address >= 0x3FFD2000 && address <= 0x3FFE0000 - width
    exchange := address >= 0x3FFB0000 && address <= 0x3FFB8000 - width
    table := width == 4 && address >= 0x3FFB96D0 && address <= 0x3FFB96F4
    if (width != 1 && width != 2 && width != 4) || (!native && !exchange && !table) {
        volatile_store(0x3FFD7E44,volatile_load(0x3FFD7E44) | 1)
        << 0
    }
    // All callers mask metadata transactions. Never share auth/IRQ scratch.
    volatile_store(0x3FFD7E40,0)
    rom_call6(0x4000C2C8,0x3FFD7E40,address,width,0,0,0)
    << volatile_load(0x3FFD7E40)
}
fn capture_event(handle int) int {
    if handle < 0 || handle >= 10 { << 0 }
    environment := capture_read(0x3FFB96D0 + handle * 4,4)
    if environment < 0x3FFD2000 || environment > 0x3FFD7000 - 0xA6 || environment % 4 != 0 { << 0 }
    event := capture_read(environment + 0x10,4)
    if event < 0x3FFD2000 || event > 0x3FFD7000 - 0x9C || event % 4 != 0 { << 0 }
    << event
}
fn capture_before(kind int, handle int, phase int, pdu int) int {
    if phase == 0 || volatile_load(0x3FFD7E6C) != 0 { << 0 }
    if (volatile_load(0x3FFD7E44) & 256) != 0 {
        volatile_store(0x3FFD7E44,volatile_load(0x3FFD7E44) | 16)
        << 0
    }
    native_pdu := pdu >= 0x3FFD2002 && pdu <= 0x3FFE0000 - 12
    exchange_pdu := pdu >= 0x3FFB0002 && pdu <= 0x3FFB8000 - 12
    if !native_pdu && !exchange_pdu {
        volatile_store(0x3FFD7E44,volatile_load(0x3FFD7E44) | 2)
        << 0
    }
    if capture_read(pdu,1) != kind {
        volatile_store(0x3FFD7E44,volatile_load(0x3FFD7E44) | 4)
        << 0
    }
    event := capture_event(handle)
    if event == 0 {
        volatile_store(0x3FFD7E44,volatile_load(0x3FFD7E44) | 8)
        << 0
    }
    $offset := 6
    if kind == 0 { offset = 10 }
    volatile_store(0x3FFD7E48,volatile_load(0x3FFD7E48) + 1)
    volatile_store(0x3FFD7E4C,kind | ((phase & 255) << 8) | (handle << 16))
    volatile_store(0x3FFD7E50,capture_read(pdu + offset,2) << 16)
    volatile_store(0x3FFD7E54,0)
    volatile_store(0x3FFD7E58,0)
    volatile_store(0x3FFD7E5C,0)
    volatile_store(0x3FFD7E60,0)
    volatile_store(0x3FFD7E64,0)
    volatile_store(0x3FFD7E68,0)
    volatile_store(0x3FFD7E70,0)
    volatile_store(0x3FFD7E74,event)
    volatile_store(0x3FFD7E78,0)
    volatile_store(0x3FFD7E7C,pdu)
    rx_index := volatile_load8(0x3FFB933C)
    volatile_store(0x3FFD7DE0,rx_index)
    volatile_store(0x3FFD7DE4,rx_control_word(rx_index))
    volatile_store(0x3FFD7DE8,rx_air_word(rx_index))
    volatile_store(0x3FFD7DEC,volatile_load(0x3FFD7DFC))
    volatile_store(0x3FFD7DF0,volatile_load(0x3FFD7D80))
    volatile_store(0x3FFD7DF4,volatile_load(0x3FFD7DF8))
    volatile_store(0x3FFD7E44,volatile_load(0x3FFD7E44) | 256)
    << 1
}
fn capture_queue(handle int) {
    $node := volatile_load(0x3FFB972C)
    $count := 0
    $same := 0
    while node != 0 && count < 32 {
        if node < 0x3FFD2000 || node > 0x3FFD7000 - 12 || node % 4 != 0 {
            volatile_store(0x3FFD7E44,volatile_load(0x3FFD7E44) | 32)
            <-
        }
        event := capture_read(node + 4,4)
        if event >= 0x3FFD2000 && event <= 0x3FFD7000 - 0x9C && event % 4 == 0 {
            if capture_read(node + 8,1) == 1 && capture_read(event + 0x90,2) == handle { same += 1 }
        }
        count += 1
        node = capture_read(node,4)
    }
    if node != 0 && count == 32 { volatile_store(0x3FFD7E44,volatile_load(0x3FFD7E44) | 32) }
    volatile_store(0x3FFD7E70,(volatile_load(0x3FFD7E70) & 0xFFFF0000) | count | (same << 8))
}
fn capture_after(pdu int, active int) {
    if active == 0 { << }
    status := capture_read(pdu - 1,1)
    volatile_store(0x3FFD7E68,(volatile_load(0x3FFD7E68) & 0xFFFF) | (status << 16))
    volatile_store(0x3FFD7E44,volatile_load(0x3FFD7E44) & 0xFFFFFEFF)
    if status == 1 && (volatile_load(0x3FFD7E4C) & 255) == 1 {
        volatile_store(0x3FFD7EDC,(volatile_load(0x3FFD7E50) & 0xFFFF0000) | (volatile_load(0x3FFD7E54) & 0xFFFF))
        volatile_store(0x3FFD7EE0,capture_read(pdu + 1,4))
        volatile_store(0x3FFD7EE4,capture_read(pdu + 5,1))
        volatile_store(0x3FFD7EE8,volatile_load(0x3FFD7E48))
        volatile_store(0x3FFD7EEC,volatile_load(0x3FFD7E10) & 0xFFFF)
        volatile_store(0x3FFD7EF0,0)
        volatile_store(0x3FFD7DFC,volatile_load(0x3FFD7D80))
    }
    if status == 3 {
        if (volatile_load(0x3FFD7E4C) & 255) == 1 {
            map_low := capture_read(pdu + 1,4)
            map_high := capture_read(pdu + 5,1)
            previous_high := volatile_load(0x3FFD7EE4) & 255
            $same := 0
            if map_low == volatile_load(0x3FFD7EE0) && map_high == previous_high &&
                (volatile_load(0x3FFD7EDC) >> 16) == (volatile_load(0x3FFD7E50) >> 16) &&
                volatile_load(0x3FFD7EE8) > 0 &&
                (volatile_load(0x3FFD7EEC) & 0xFFFF) == (volatile_load(0x3FFD7E10) & 0xFFFF) { same = 1 }
            volatile_store(0x3FFD7EE4,previous_high | (map_high << 8) | (same << 16))
            volatile_store(0x3FFD7EF0,map_low)
            volatile_store(0x3FFD7EEC,(volatile_load(0x3FFD7EEC) & 0xFFFF) | ((volatile_load(0x3FFD7E10) & 0xFFFF) << 16))
        }
        volatile_store(0x3FFD7E6C,1)
        capture_queue(volatile_load(0x3FFD7E4C) >> 16)
    }
}
fn update_entry(handle int, task int, phase int, pdu int) int {
    saved := esp32.irq_rom_mask(0 - 1)
    active := capture_before(0,handle & 0xFFFF,phase & 255,pdu)
    esp32.irq_rom_unmask(saved)
    result := rom_call6(0x400426F0,handle,task,phase,pdu,0,0)
    finished := esp32.irq_rom_mask(0 - 1)
    capture_after(pdu,active)
    esp32.irq_rom_unmask(finished)
    << result
}
fn channel_entry(handle int, task int, phase int, pdu int) int {
    saved := esp32.irq_rom_mask(0 - 1)
    active := capture_before(1,handle & 0xFFFF,phase & 255,pdu)
    esp32.irq_rom_unmask(saved)
    result := rom_call6(0x4004291C,handle,task,phase,pdu,0,0)
    finished := esp32.irq_rom_mask(0 - 1)
    capture_after(pdu,active)
    esp32.irq_rom_unmask(finished)
    << result
}
fn instant_entry(event int) int {
    saved := esp32.irq_rom_mask(0 - 1)
    active := (volatile_load(0x3FFD7E44) & 256) != 0 &&
        volatile_load(0x3FFD7E6C) == 0 && event == volatile_load(0x3FFD7E74)
    if active {
        volatile_store(0x3FFD7E50,(volatile_load(0x3FFD7E50) & 0xFFFF0000) | capture_read(event + 0x7C,2))
        volatile_store(0x3FFD7E58,capture_read(event + 0x7A,2) | (capture_read(event + 0x7E,2) << 16))
        volatile_store(0x3FFD7E5C,capture_read(event + 8,4))
        rounded := rom_call6(0x40015894,0,0,0,0,0,0)
        volatile_store(0x3FFD7E60,(rounded + capture_read(event + 0x19,1)) & 0x07FFFFFF)
        volatile_store(0x3FFD7E70,capture_read(event + 0x94,2) << 16)
        volatile_store(0x3FFD7E64,capture_read(event + 0x28,4))
        volatile_store(0x3FFD7E68,capture_read(event + 0x97,1) | (capture_read(event + 0x9A,1) << 8))
    }
    esp32.irq_rom_unmask(saved)
    result := rom_call6(0x400476A8,event,0,0,0,0,0)
    finished := esp32.irq_rom_mask(0 - 1)
    if active {
        volatile_store(0x3FFD7E54,capture_read(event + 0x7C,2) | (capture_read(event + 0x7E,2) << 16))
        volatile_store(0x3FFD7E78,capture_read(event + 8,4))
    }
    esp32.irq_rom_unmask(finished)
    << result
}
// Native END40085694 bit14 experiment for the current singleCS0 link only.
// OtherCSs retain ROM behavior; memcpy2 on oddCSs is not a trueu16 access.
// No queue changes.
// ED0 previousbit bitmap(CS0..8), ED4 forcewrites, ED8 enabled1/original0.
// EDC..EF0 last successfulCHM remains intact when the next prepass freezes.
fn end_entry(event int) int {
    saved := esp32.irq_rom_mask(0 - 1)
    volatile_store(0x3FFD7DF8,1)
    esp32.irq_rom_unmask(saved)
    result := rom_call6(0x400483E8,event,0,0,0,0,0)
    finished := esp32.irq_rom_mask(0 - 1)
    volatile_store(0x3FFD7DF8,0)
    esp32.irq_rom_unmask(finished)
    << result
}
// Current singleCS0 RX count/ring snapshot; no clamping or acceptance change.
// Private diagnostic D80..DF7, shadowD00..D77, ENDactiveflagDF8,
// lastsuccessfulCHM RXbatchseqDFC. GlobalRXhead updates only at batchend;
// prepass head/control/header can refer to first alreadyfreed batchitem.
// Use suppliedcount and batchseq, never equate globalhead to failingitem.
fn rx_control_word(index int) int {
    if index == 0 { << volatile_load(0x3ffb0948) }
    if index == 1 { << volatile_load(0x3ffb0954) }
    if index == 2 { << volatile_load(0x3ffb0960) }
    if index == 3 { << volatile_load(0x3ffb096c) }
    if index == 4 { << volatile_load(0x3ffb0978) }
    if index == 5 { << volatile_load(0x3ffb0984) }
    if index == 6 { << volatile_load(0x3ffb0990) }
    if index == 7 { << volatile_load(0x3ffb099c) }
    << 0
}
fn rx_air_word(index int) int {
    if index == 0 { << volatile_load(0x3ffb094c) }
    if index == 1 { << volatile_load(0x3ffb0958) }
    if index == 2 { << volatile_load(0x3ffb0964) }
    if index == 3 { << volatile_load(0x3ffb0970) }
    if index == 4 { << volatile_load(0x3ffb097c) }
    if index == 5 { << volatile_load(0x3ffb0988) }
    if index == 6 { << volatile_load(0x3ffb0994) }
    if index == 7 { << volatile_load(0x3ffb09a0) }
    << 0
}
fn ll_entry() int { << esp32.bt_irq_rom_service() }
fn bb_entry() int { << esp32.bt_irq_rom_bb_service() }
fn timer_entry(context int) int {
    now := esp32.irq_rom_cycle_count()
    if context != 0x6A10 { volatile_store(0x3FFD7E84,1) }
    if (esp32.irq_rom_pending() & 64) == 0 { volatile_store(0x3FFD7E84,2) }
    esp32.irq_rom_timer0_arm(now + 80000)
    count := volatile_load(0x3FFD7E80) + 1
    volatile_store(0x3FFD7E80,count)
    if count >= 128 { esp32.irq_rom_mask(64) }
    << 0
}
// Bounded policy for ordinary CS0 slave events only. BLE slave latency is
// a maximum: the peripheral may attend every interval. The negotiated7A
// remains unchanged. Pending procedures, companion events, cancellations,
// no-RX/error paths always delegate original ROM; GPIO tracing is preserved.
// This is a stability policy; the cause of first-late CHM is still unproved.
fn listen_write(address int, value int, width int) {
    volatile_store(0x3FFD7E40,value)
    rom_call6(0x4000C2C8,address,0x3FFD7E40,width,0,0,0)
}
fn listen_policy(event int, forced int) int {
    if volatile_load(0x3FFD7ED8) != 1 || (forced & 255) != 0 ||
        (volatile_load(0x3FFD7E44) & 256) != 0 ||
        event < 0x3FFD2000 || event > 0x3FFD7000 - 0x9C || event % 4 != 0 { << -1 }
    if capture_read(event + 0x97,1) != 4 || capture_read(event + 0x90,2) != 0 { << -1 }
    linked := capture_read(event + 4,4)
    pending := capture_read(event + 0x89,1)
    flags := capture_read(event + 0x9A,1)
    trace := volatile_load8(0x3FFB8D46)
    rx_status := volatile_load(0x3FFB0108) & 65535
    // Keyless task-readable guard telemetry, in the retired RX diagnostic area.
    volatile_store(0x3FFD7D80,linked)
    volatile_store(0x3FFD7D84,pending | (flags << 8))
    volatile_store(0x3FFD7D88,trace)
    volatile_store(0x3FFD7D8C,rx_status)
    if linked != 0 || pending != 0 || (flags & 0x18) != 0 || (rx_status & 0x8000) == 0 { << -1 }
    // Preserve the original optional GPIO trace prologue/epilogue too.
    if trace != 255 {
        mask := 8 << ((trace & 3) * 8)
        volatile_store(0x3FF71064,volatile_load(0x3FF71064) | mask)
    }
    // ROM40047079: valid RX, CS0. Select its existing no-skip decision
    // at400470B4 instead of maximum-latency skip at400470C1.
    listen_write(0x3FFB00CA,14,2)
    listen_write(event + 0x7E,0,2)
    listen_write(event + 0x28,volatile_load(0x3FFB0104),4)
    listen_write(event + 0x2C,624 - (volatile_load(0x3FFB0108) & 1023),2)
    // All the original RX window and timing computations stay in place.
    // Never substitute latency1 into the negotiated field used by them.
    interval := capture_read(event + 0x94,2)
    rom_call6(0x400467C8,event,0,0,0,0,0)
    rom_call6(0x40046818,event,interval,0,0,0,0)
    listen_write(event + 0x7C,(capture_read(event + 0x7C,2) + 1) & 65535,2)
    listen_write(event + 0x7E,0,2)
    // param2(skip)=0, hence original IP898 channel_next is not called.
    // Original final comparison observes skip0; its only true case is
    // latencyPlus1==1 (the450cap cannot change a nonzero value tozero).
    if capture_read(event + 0x7A,2) == 1 {
        listen_write(event + 0x9A,capture_read(event + 0x9A,1) | 2,1)
    }
    trace_after := volatile_load8(0x3FFB8D46)
    if trace_after != 255 {
        mask := 8 << ((trace_after & 3) * 8)
        volatile_store(0x3FF71064,volatile_load(0x3FF71064) & (0xFFFFFFFF ^ mask))
    }
    volatile_store(0x3FFD7ED0,volatile_load(0x3FFD7ED0) + 1)
    << 1 ^ ((capture_read(event + 0x9A,1) >> 4) & 1)
}
fn restart_entry(event int, forced int) int {
    saved := esp32.irq_rom_mask(0 - 1)
    chosen := listen_policy(event,forced)
    esp32.irq_rom_unmask(saved)
    if chosen >= 0 { << chosen }
    volatile_store(0x3FFD7ED4,volatile_load(0x3FFD7ED4) + 1)
    << rom_call6(0x40046D50,event,forced,0,0,0,0)
}
fn main() int {
    v0 := rom_callback(ll_entry)
    v1 := rom_callback(bb_entry)
    v2 := rom_callback(timer_entry)
    v3 := rom_callback(update_entry)
    v4 := rom_callback(channel_entry)
    v5 := rom_callback(instant_entry)
    v6 := rom_callback(end_entry)
    v7 := flash.bond_worker_entry()
    v8 := rom_callback(restart_entry)
    << v0+v1+v2+v3+v4+v5+v6+v7+v8
}
