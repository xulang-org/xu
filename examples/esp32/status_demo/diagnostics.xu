@main

#embedded/chips/esp32
#embedded/wifi/session

// Board instrumentation is outside the controller-independent UI renderer.
fn board_ui_field(index int, text &string) {
    if index == 5 { << } // The deployment SSID remains private in UART logs.
    esp32.uart_print("[FIELD] ")
    esp32.uart_print_hex(index)
    esp32.uart_print(" ")
    esp32.uart_println(session.copy(text))
}
