@main

#xacp
#os
#strconv
#errors

fn hello_args(nonce string, extra string) string {
    << "id: !i 1\nop: xacp.hello\nargs:\n  ver: !ver 1.0.0\n  nonce: " + nonce + "\n" + extra
}

// Drop both the document and Session between attempts, as a listener does.
fn nonce_attempt(nonces &mut xacp.NonceRegistry, nonce string, token string, permissions int, expected_token string) xacp.Outcome {
    limits := xacp.default_limits()
    doc := xacp.parse_frame(hello_args(nonce, "  token: " + token + "\n  permissions: !i " + str(permissions) + "\n")) or >>
    mut session := xacp.open_session()
    result := xacp.dispatch_with_token(mut &session, &doc, &limits, expected_token, mut &*nonces)
    if result.ok {
        if session.state != xacp.STATE_OPEN { >> errors.new("nonce hello did not open") }
        xacp.close_session(mut &session)
    } else {
        if session.state != xacp.STATE_CLOSED || session.nonce != "" || session.permissions != 0 {
            >> errors.new("failed nonce hello did not close")
        }
        if result.err_code == "nonce_replay" && result.request_id != 1 {
            >> errors.new("nonce replay lost request id")
        }
    }
    << result
}

fn check_nonce_registry() int {
    mut nonces := xacp.new_nonce_registry(2, true)
    if !(nonce_attempt(mut &nonces, "first", "token", 15, "token") or >>).ok { << 40 }
    if !(nonce_attempt(mut &nonces, "second", "token", 15, "token") or >>).ok { << 41 }
    if (nonce_attempt(mut &nonces, "first", "token", 15, "token") or >>).err_code != "nonce_replay" { << 42 }
    if (nonce_attempt(mut &nonces, "third", "wrong", 15, "token") or >>).err_code != "auth_failed" { << 43 }
    if (nonce_attempt(mut &nonces, "third", "token", 32, "token") or >>).err_code != "schema_error" { << 44 }
    // Failed hello and rejected replays neither evict entries nor refresh order.
    if (nonce_attempt(mut &nonces, "second", "token", 15, "token") or >>).err_code != "nonce_replay" { << 45 }
    if !(nonce_attempt(mut &nonces, "third", "token", 15, "token") or >>).ok { << 46 }
    if (nonce_attempt(mut &nonces, "second", "token", 15, "token") or >>).err_code != "nonce_replay" { << 47 }
    if !(nonce_attempt(mut &nonces, "first", "token", 15, "token") or >>).ok { << 48 }
    if (nonce_attempt(mut &nonces, "third", "token", 15, "token") or >>).err_code != "nonce_replay" { << 49 }
    if !(nonce_attempt(mut &nonces, "second", "token", 15, "token") or >>).ok { << 50 }

    mut one := xacp.new_nonce_registry(1, true)
    for nonce in ["Case", "case", "Case"] {
        if !(nonce_attempt(mut &one, nonce, "token", 15, "token") or >>).ok { << 51 }
    }
    if (nonce_attempt(mut &one, "Case", "token", 15, "token") or >>).err_code != "nonce_replay" { << 52 }
    mut disabled := xacp.new_nonce_registry(2, false)
    for i in 0:3 {
        if !(nonce_attempt(mut &disabled, "same", "token", 15, "token") or >>).ok { << 53 }
    }
    mut exact := xacp.new_nonce_registry(2, true)
    for nonce in ["Case", "case"] {
        if !(nonce_attempt(mut &exact, nonce, "token", 15, "token") or >>).ok { << 54 }
    }
    if (nonce_attempt(mut &exact, "Case", "token", 15, "token") or >>).err_code != "nonce_replay" { << 55 }
    cache_text := os.getenv("XACP_EXPECT_NONCE_CACHE")
    if cache_text.len > 0 {
        expected := strconv.parse(&cache_text, 10) or >>
        if xacp.nonce_cache_from_env() != expected { << 56 }
    }
    replay_text := os.getenv("XACP_EXPECT_NONCE_REPLAY")
    if replay_text.len > 0 {
        if xacp.nonce_replay_from_env() != (replay_text == "1") { << 57 }
    }
    << 0
}

fn check_core() int {
    nonce_code := check_nonce_registry() or >>
    if nonce_code != 0 { << nonce_code }
    if xacp.PERM_UI_RAW != 16 || xacp.PERM_ALL != 31 || xacp.development_permissions() != 31 { << 58 }
    limits := xacp.default_limits()
    mut nonces := xacp.new_nonce_registry(xacp.DEFAULT_NONCE_CACHE, true)
    hello := xacp.parse_frame(hello_args("core-nonce", "")) or >>
    status := xacp.parse_frame("id: !i 2\nop: proc.status\nargs: {}\n") or >>
    mut session := xacp.open_session()
    opened := xacp.dispatch(mut &session, &hello, &limits, mut &nonces)
    if !opened.ok || session.state != xacp.STATE_OPEN { << 1 }
    if session.permissions != xacp.PERM_INFO || session.nonce != "core-nonce" { << 2 }
    unimplemented := xacp.dispatch(mut &session, &status, &limits, mut &nonces)
    if unimplemented.ok || unimplemented.err_code != "not_implemented" { << 3 }
    if session.state != xacp.STATE_OPEN || session.active_id != 0 { << 4 }
    if xacp.set_permissions(mut &session, xacp.PERM_ALL) { << 5 }
    xacp.close_session(mut &session)
    if session.nonce != "" || session.permissions != xacp.PERM_NONE { << 6 }
    closed := xacp.dispatch(mut &session, &status, &limits, mut &nonces)
    if closed.ok || closed.err_code != "session_closed" { << 7 }

    // Host pre-grants cannot bypass the mandatory first hello.
    mut fresh := xacp.open_session()
    if !xacp.set_permissions(mut &fresh, xacp.PERM_ALL) { << 8 }
    premature := xacp.dispatch(mut &fresh, &status, &limits, mut &nonces)
    if premature.ok || premature.err_code != "hello_required" || fresh.state != xacp.STATE_CLOSED { << 9 }

    // Request/allowed intersection for every known bit combination.
    for requested in 0:32 {
        doc := xacp.parse_frame(hello_args("core-policy-" + str(requested), "  token: core-token\n  permissions: !i " + str(requested) + "\n")) or >>
        mut info := xacp.open_session()
        result := xacp.dispatch(mut &info, &doc, &limits, mut &nonces)
        if !result.ok || info.permissions != (requested & xacp.PERM_INFO) { << 10 }
        authenticated_doc := xacp.parse_frame(hello_args("core-auth-policy-" + str(requested),
            "  token: core-token\n  permissions: !i " + str(requested) + "\n")) or >>
        mut authenticated := xacp.open_session()
        granted := xacp.dispatch_with_token(mut &authenticated, &authenticated_doc, &limits, "core-token", mut &nonces)
        if !granted.ok || authenticated.permissions != (requested & 15) { << 11 }
    }
    token_hello := xacp.parse_frame(hello_args("core-token-nonce", "  token: core-token\n")) or >>
    mut development := xacp.open_session()
    granted_all := xacp.dispatch_with_token(mut &development, &token_hello, &limits, "core-token", mut &nonces)
    if !granted_all.ok || development.permissions != 15 { << 12 }
    mut bad_token := xacp.open_session()
    rejected := xacp.dispatch_with_token(mut &bad_token, &token_hello, &limits, "different-token", mut &nonces)
    if rejected.ok || rejected.err_code != "auth_failed" || bad_token.state != xacp.STATE_CLOSED { << 13 }
    if bad_token.nonce != "" || bad_token.permissions != xacp.PERM_NONE { << 14 }
    mut missing_token := xacp.open_session()
    missing := xacp.dispatch_with_token(mut &missing_token, &hello, &limits, "core-token", mut &nonces)
    if missing.ok || missing.err_code != "auth_failed" || missing_token.state != xacp.STATE_CLOSED { << 15 }
    invalid := xacp.parse_frame(hello_args("core-invalid", "  permissions: !i 32\n")) or >>
    mut malformed := xacp.open_session()
    schema := xacp.dispatch(mut &malformed, &invalid, &limits, mut &nonces)
    if schema.ok || schema.err_code != "schema_error" || malformed.state != xacp.STATE_CLOSED { << 16 }

    // Lifecycle errors keep OPEN, preserve the active request, and allow recovery.
    request := xacp.validate_request(&status, &limits) or >>
    started := xacp.begin_request(mut &development, &request)
    if !started.ok { << 17 }
    busy := xacp.begin_request(mut &development, &request)
    if busy.ok || busy.err_code != "request_in_flight" { << 18 }
    stale := xacp.finish_request(mut &development, 3)
    if stale.ok || stale.err_code != "stale_request" || development.active_id != 2 { << 19 }
    finished := xacp.finish_request(mut &development, 2)
    if !finished.ok || development.state != xacp.STATE_OPEN { << 20 }
    repeated := xacp.begin_request(mut &development, &request)
    if repeated.ok || repeated.err_code != "invalid_request_id" || development.state != xacp.STATE_OPEN { << 21 }
    // Reserving hello alone is insufficient to enter OPEN.
    mut unfinished := xacp.open_session()
    hello_request := xacp.validate_request(&hello, &limits) or >>
    reserved := xacp.begin_request(mut &unfinished, &hello_request)
    if !reserved.ok { << 22 }
    unnegotiated := xacp.finish_request(mut &unfinished, 1)
    if unnegotiated.ok || unfinished.state != xacp.STATE_CLOSED { << 23 }
    if limits.request_timeout_ms != 5000 { << 24 }
    expected_text := os.getenv("XACP_EXPECT_TIMEOUT_MS")
    if expected_text.len > 0 {
        expected := strconv.parse(&expected_text,10) or >>
        if xacp.request_timeout_from_env() != expected { << 25 }
    }
    // Timeout cancellation invalidates late finishes, even during a new request.
    canceled := xacp.Request{id: 3,op: "proc.status",args: 0}
    if !xacp.begin_request(mut &development,&canceled).ok { << 26 }
    xacp.cancel_request(mut &development)
    if development.active_id != 0 || development.active_generation != 0 { << 27 }
    late := xacp.finish_request(mut &development,3)
    if late.ok || late.err_code != "stale_request" { << 28 }
    next := xacp.Request{id: 4,op: "proc.status",args: 0}
    if !xacp.begin_request(mut &development,&next).ok { << 29 }
    stale_again := xacp.finish_request(mut &development,3)
    if stale_again.ok || development.active_id != 4 { << 30 }
    next_finished := xacp.finish_request(mut &development,4)
    if !next_finished.ok || development.state != xacp.STATE_OPEN { << 31 }
    if limits.hello_timeout_ms != 5000 || limits.idle_timeout_ms != 60000 { << 32 }
    hello_text := os.getenv("XACP_EXPECT_HELLO_TIMEOUT_MS")
    if hello_text.len > 0 {
        expected := strconv.parse(&hello_text, 10) or >>
        if xacp.hello_timeout_from_env() != expected { << 33 }
    }
    idle_text := os.getenv("XACP_EXPECT_IDLE_TIMEOUT_MS")
    if idle_text.len > 0 {
        expected := strconv.parse(&idle_text, 10) or >>
        if xacp.idle_timeout_from_env() != expected { << 34 }
    }
    println("XACP core: PASS")
    << 0
}

fn main() int {
    << check_core() or (err) {
        eprintln(err.msg())
        << 100
    }
}
