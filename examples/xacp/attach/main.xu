@main

#xacp
#ui
#ui/widgets
#os
#strconv
#time

// Headless retained-Screen example. XU_UI_SIM=1 uses the UI simulation path;
// canvas_ready below is the same checked identity shape supplied by a UI host.
// A native application creates Screen from its actual canvas_ready event and
// services xacp.poll between nonblocking UI event iterations instead.
fn main() int {
    if os.getenv("XU_UI_SIM") != "1" {
        eprintln("xacp attach example requires XU_UI_SIM=1")
        << 1
    }
    ready := ui.Event{kind: ui.EV_CANVAS_READY,window_id: 1,menu_id: "canvas_ready\t1\t1\t1",width: 640,height: 480}
    $screen := widgets.screen(&ready) or (err) { eprintln(err.msg())
        << 1 }
    screen.resize(400.0,240.0) or (err) { eprintln(err.msg())
        << 1 }
    label := screen.label("business-main: attached Screen",16.0,false) or (err) { eprintln(err.msg())
        << 1 }
    screen.place(label,12.0,24.0,320.0,32.0) or (err) { eprintln(err.msg())
        << 1 }
    button := screen.button("Control button") or (err) { eprintln(err.msg())
        << 1 }
    screen.place(button,12.0,64.0,160.0,40.0) or (err) { eprintln(err.msg())
        << 1 }
    secret := screen.secret_input("xacp-smoke-secret") or (err) { eprintln(err.msg())
        << 1 }
    screen.place(secret,12.0,120.0,240.0,40.0) or (err) { eprintln(err.msg())
        << 1 }
    $control := start_control() or (err) { eprintln(err.msg())
        << 1 }
    mode := os.getenv("XACP_EXAMPLE_LIFECYCLE")
    no_poll := os.getenv("XACP_EXAMPLE_NO_POLL") == "1"
    if mode != "unregistered" {
        xacp.register_screen($&control,&screen) or (err) { eprintln(err.msg())
            << 1 }
        // Reject duplicates rather than replacing a live registration.
        if !duplicate_rejected($&control,&screen) {
            eprintln("duplicate registration was accepted")
            << 1
        }
    }
    eprintln("business-main: Screen ready")
    if mode == "pending-unregister" || mode == "pending-dispose" {
        // Let the smoke peer enqueue a request while this owner is busy.
        time.sleep(time.second())
        if mode == "pending-unregister" { xacp.unregister_screen($&control) }
        else { screen.dispose() }
    }
    $serviced := false
    while true {
        if !no_poll && screen.is_open() && xacp.poll($&control,$&screen) && !serviced {
            serviced = true
            if mode == "unregister" { xacp.unregister_screen($&control) }
            if mode == "close" { screen.close() or (err) { eprintln(err.msg())
                << 1 } }
            if mode == "dispose" { screen.dispose() }
            if mode == "reregister" {
                xacp.unregister_screen($&control)
                xacp.register_screen($&control,&screen) or (err) { eprintln(err.msg())
                    << 1 }
            }
        }
        select {
            code := <-control.done {
                xacp.unregister_screen($&control)
                screen.dispose()
                eprintln("business-main: control finished")
                << code
            }
            else {}
        }
        time.sleep(time.millisecond())
    }
    << 0
}

fn start_control() xacp.ScreenControl {
    port_text := os.getenv("XACP_EXAMPLE_TCP")
    if port_text.len == 0 { << xacp.attach_stdio() }
    port := strconv.parse(&port_text,10) or >>
    << xacp.attach_tcp(port) or >>
}

fn duplicate_rejected(control $&xacp.ScreenControl,screen &widgets.Screen) bool {
    xacp.register_screen(&*control,&*screen) or (err) { << true }
    << false
}
