@main

#os
#strconv
#strings
#ui/phone

const RECORD = 10
const HEADER_ACTION = 11
const CHOOSE_CATEGORY = 12
const POP_ROUTE = 13
const CATEGORY_BASE = 20
const TOGGLE_THEME = 30
const CHOOSE_GOAL = 31
const RESET = 32
const UNDO = 33
const NOTE_FIELD = 34
const NOTE_CLEAR = 35
const SAVE_NOTE = 36
const REFRESH_ACTION = 37
const COPY_NOTE = 38
const PASTE_NOTE = 39
const DISMISS = 40
const CONFIRM_RESET = 41
const GOAL_BASE = 50
const SNACKBAR_UNDO = 60
const DELETE_RECORD = 61
const FILTER_BASE = 70
const RECORD_MENU = 75
const ROW_BASE = 1000

const ROUTE_ROOT = 1
const ROUTE_DETAIL = 2

struct Model {
    tab int
    category int
    filter_cat int
    goal int
    dark bool
    theme_override bool
    sheet int
    records []int
    removed_value int
    removed_index int
    saved_note string
    sync_count int
}
fn model() Model {
    << Model{
        tab: 1,category: 0,filter_cat: -1,goal: 12,dark: phone.system_dark(),theme_override: false,
        sheet: 0,records: []int{},removed_value: -1,removed_index: -1,saved_note: "",sync_count: 0
    }
}
fn gallery_state_path() string {
    dir := phone.data_dir()
    if dir.len == 0 { << "" }
    << dir + "/gallery_state.txt"
}
fn sanitize_single_line(s &string) string {
    $out := strings.replace_all(s,"\r"," ")
    out = strings.replace_all(&out,"\n"," ")
    << out
}
fn (m &Model) save_persisted() {
    path := gallery_state_path()
    if path.len == 0 { << }
    $dark_v := "0"
    if m.dark { dark_v = "1" }
    $ov_v := "0"
    if m.theme_override { ov_v = "1" }
    $recs := ""
    for i in 0:m.records.len {
        if i > 0 { recs = recs + "," }
        recs = recs + str(m.records[i])
    }
    body := "goal=" + str(m.goal) + "\ncategory=" + str(m.category) +
        "\ndark=" + dark_v + "\ntheme_override=" + ov_v +
        "\nnote=" + sanitize_single_line(&m.saved_note) +
        "\nrecords=" + recs + "\n"
    _ := os.write(path,body) >>> (err) { << }
}
fn parse_int_or(s &string,fallback int) int {
    trimmed := trim_ascii_space(s)
    if trimmed.len == 0 { << fallback }
    v := strconv.atoi(&trimmed) >>> (err) { << fallback }
    << v
}
fn (m $&Model) load_persisted() {
    path := gallery_state_path()
    if path.len == 0 { << }
    raw := os.read(path) >>> (err) { << }
    lines := strings.split(&raw,"\n")
    for line in lines {
        $eq := -1
        for i in 0:line.len {
            if (line[i] & 255) == 61 { eq = i
                <- }
        }
        if eq <= 0 { -> }
        key := line[0:eq]
        val := line[eq + 1:line.len]
        if key == "goal" {
            g := parse_int_or(&val,m.goal)
            if g == 6 || g == 12 || g == 24 { m.goal = g }
        } else if key == "category" {
            cat := parse_int_or(&val,m.category)
            if cat >= 0 && cat <= 2 { m.category = cat }
        } else if key == "theme_override" {
            m.theme_override = parse_int_or(&val,0) != 0
        } else if key == "dark" && m.theme_override {
            m.dark = parse_int_or(&val,0) != 0
        } else if key == "note" {
            m.saved_note = sanitize_single_line(&val)
        } else if key == "records" {
            m.records = []int{}
            if val.len > 0 {
                parts := strings.split(&val,",")
                for part in parts {
                    if m.records.len >= 256 { <- }
                    r := parse_int_or(&part,-1)
                    if r >= 0 && r <= 2 { m.records.push(r) }
                }
            }
        }
    }
    if !m.theme_override { m.dark = phone.system_dark() }
}
fn trim_ascii_space(s &string) string {
    $start := 0
    while start < s.len {
        b := s[start] & 255
        if b == 32 || b == 9 || b == 10 || b == 13 { start += 1 }
        else { <- }
    }
    $end := s.len
    while end > start {
        b := s[end - 1] & 255
        if b == 32 || b == 9 || b == 10 || b == 13 { end -= 1 }
        else { <- }
    }
    << s[start:end]
}
fn utf8_char_count(s &string) int {
    $count := 0
    for i in 0:s.len {
        if (s[i] & 192) != 128 { count += 1 }
    }
    << count
}
fn (m $&Model) save_note(raw string,snack $&phone.Snackbar) string {
    trimmed := trim_ascii_space(&raw)
    n := utf8_char_count(&trimmed)
    if n < 2 {
        phone.haptic(phone.HAPTIC_ERROR)
        << "请输入 2 至 40 个字符的备注"
    }
    if n > 40 {
        phone.haptic(phone.HAPTIC_ERROR)
        << "备注请控制在 40 个字符以内"
    }
    m.saved_note = trimmed
    m.save_persisted()
    phone.haptic(phone.HAPTIC_SUCCESS)
    snack.show("已保存备注：" + m.saved_note,0,"",2800)
    << ""
}
fn (m $&Model) sync_session(snack $&phone.Snackbar) {
    m.sync_count += 1
    phone.haptic(phone.HAPTIC_SUCCESS)
    snack.show("已同步当前会话 #" + str(m.sync_count),0,"",2400)
}
fn category_name(category int) string {
    if category == 1 { << "阅读" }
    if category == 2 { << "运动" }
    << "专注"
}
fn category_icon(category int) int {
    if category == 1 { << phone.ICON_BOOK }
    if category == 2 { << phone.ICON_ACTIVITY }
    << phone.ICON_FOCUS
}
fn (m $&Model) delete_at(index int) {
    if index < 0 || index >= m.records.len { << }
    m.removed_value = m.records[index]
    m.removed_index = index
    $next := []int{}
    for i in 0:m.records.len {
        if i != index { next.push(m.records[i]) }
    }
    m.records = next
}
fn (m $&Model) restore_removed() bool {
    if m.removed_value < 0 || m.records.len >= 256 { << false }
    $pos := m.removed_index
    if pos < 0 { pos = 0 }
    if pos > m.records.len { pos = m.records.len }
    $next := []int{}
    for i in 0:m.records.len {
        if i == pos { next.push(m.removed_value) }
        next.push(m.records[i])
    }
    if pos == m.records.len { next.push(m.removed_value) }
    m.records = next
    m.removed_value = -1
    m.removed_index = -1
    << true
}
fn (m $&Model) activate(action int,nav $&phone.RouteStack,snack $&phone.Snackbar) {
    if action >= 1 && action <= 3 {
        m.tab = action
        nav.reset(ROUTE_ROOT,"今日")
        <<
    }
    if action == POP_ROUTE {
        nav.pop()
        <<
    }
    if action >= ROW_BASE {
        idx := action - ROW_BASE
        if idx >= 0 && idx < m.records.len {
            nav.push(ROUTE_DETAIL,idx,"记录详情")
        }
        <<
    }
    if action == REFRESH_ACTION {
        m.sync_session(snack)
        <<
    }
    if action >= FILTER_BASE && action < FILTER_BASE + 4 {
        m.filter_cat = action - FILTER_BASE - 1
        phone.haptic(phone.HAPTIC_SELECTION)
        <<
    }
    if action == RECORD_MENU {
        m.sheet = 4
        <<
    }
    if action == RECORD {
        if m.tab == 3 { m.tab = 1
            nav.reset(ROUTE_ROOT,"今日") }
        else if nav.can_pop() { nav.pop() }
        else if m.records.len < 256 {
            m.records.push(m.category)
            m.save_persisted()
            if m.records.len == m.goal {
                phone.haptic(phone.HAPTIC_SUCCESS)
                snack.show("已完成今日 " + str(m.goal) + " 次目标",0,"",3200)
            } else {
                phone.haptic(phone.HAPTIC_IMPACT)
            }
        }
    } else if action == HEADER_ACTION {
        if nav.can_pop() { nav.pop() }
        else if m.tab == 3 { m.tab = 1 }
        else { m.tab = 3 }
    } else if action >= CATEGORY_BASE && action < CATEGORY_BASE + 3 {
        m.category = action - CATEGORY_BASE
        m.sheet = 0
        m.save_persisted()
        phone.haptic(phone.HAPTIC_SELECTION)
    } else if action == TOGGLE_THEME {
        m.dark = !m.dark
        m.theme_override = true
        m.save_persisted()
        phone.haptic(phone.HAPTIC_SELECTION)
    }
    else if action == CHOOSE_GOAL { m.sheet = 1 }
    else if action == RESET { m.sheet = 2 }
    else if action == CHOOSE_CATEGORY { m.sheet = 3 }
    else if action == DISMISS { m.sheet = 0 }
    else if action == CONFIRM_RESET {
        m.records = []int{}
        nav.pop_to_root()
        m.sheet = 0
        m.removed_value = -1
        m.removed_index = -1
        m.save_persisted()
        phone.haptic(phone.HAPTIC_IMPACT)
        snack.show("已清空本次会话记录",0,"",2800)
    } else if action == DELETE_RECORD && nav.can_pop() {
        idx := nav.top().arg
        if idx >= 0 && idx < m.records.len {
            m.delete_at(idx)
            nav.pop()
            m.save_persisted()
            phone.haptic(phone.HAPTIC_IMPACT)
            snack.show("已删除第 " + str(idx + 1) + " 条记录",SNACKBAR_UNDO,"撤销",3800)
        }
    } else if action == UNDO && m.records.len > 0 {
        last_idx := m.records.len - 1
        m.delete_at(last_idx)
        m.sheet = 0
        m.save_persisted()
        phone.haptic(phone.HAPTIC_IMPACT)
        snack.show("已撤销最近一条记录",SNACKBAR_UNDO,"恢复",3800)
    } else if action == SNACKBAR_UNDO {
        if m.restore_removed() {
            m.save_persisted()
            phone.haptic(phone.HAPTIC_SUCCESS)
            snack.show("已恢复记录",0,"",2000)
        } else {
            snack.dismiss()
        }
    } else if action >= GOAL_BASE && action < GOAL_BASE + 3 {
        options := [6,12,24]
        m.goal = options[action - GOAL_BASE]
        m.sheet = 0
        m.save_persisted()
        phone.haptic(phone.HAPTIC_SUCCESS)
        snack.show("每日目标已设为 " + str(m.goal) + " 次",0,"",2400)
    }
}
