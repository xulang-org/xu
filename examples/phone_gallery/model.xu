@main

#ui/phone

const RECORD = 10
const HEADER_ACTION = 11
const CHOOSE_CATEGORY = 12
const POP_ROUTE = 13
const CATEGORY_BASE = 20
const TOGGLE_THEME = 30
const CHOOSE_GOAL = 31
const RESET = 32
const UNDO = 33
const DISMISS = 40
const CONFIRM_RESET = 41
const GOAL_BASE = 50
const SNACKBAR_UNDO = 60
const DELETE_RECORD = 61
const ROW_BASE = 1000

const ROUTE_ROOT = 1
const ROUTE_DETAIL = 2

struct Model {
    tab int
    category int
    goal int
    dark bool
    sheet int
    records []int
    removed_value int
    removed_index int
}
fn model() Model {
    << Model{
        tab: 1,category: 0,goal: 12,dark: false,sheet: 0,records: []int{},
        removed_value: -1,removed_index: -1
    }
}
fn category_name(category int) string {
    if category == 1 { << "阅读" }
    if category == 2 { << "运动" }
    << "专注"
}
fn category_icon(category int) int {
    if category == 1 { << phone.ICON_BOOK }
    if category == 2 { << phone.ICON_ACTIVITY }
    << phone.ICON_FOCUS
}
fn (m $&Model) delete_at(index int) {
    if index < 0 || index >= m.records.len { << }
    m.removed_value = m.records[index]
    m.removed_index = index
    $next := []int{}
    for i in 0:m.records.len {
        if i != index { next.push(m.records[i]) }
    }
    m.records = next
}
fn (m $&Model) restore_removed() bool {
    if m.removed_value < 0 || m.records.len >= 256 { << false }
    $pos := m.removed_index
    if pos < 0 { pos = 0 }
    if pos > m.records.len { pos = m.records.len }
    $next := []int{}
    for i in 0:m.records.len {
        if i == pos { next.push(m.removed_value) }
        next.push(m.records[i])
    }
    if pos == m.records.len { next.push(m.removed_value) }
    m.records = next
    m.removed_value = -1
    m.removed_index = -1
    << true
}
fn (m $&Model) activate(action int,nav $&phone.RouteStack,snack $&phone.Snackbar) {
    if action >= 1 && action <= 3 {
        m.tab = action
        nav.reset(ROUTE_ROOT,"今日")
        <<
    }
    if action == POP_ROUTE {
        nav.pop()
        <<
    }
    if action >= ROW_BASE {
        idx := action - ROW_BASE
        if idx >= 0 && idx < m.records.len {
            nav.push(ROUTE_DETAIL,idx,"记录详情")
        }
        <<
    }
    if action == RECORD {
        if m.tab == 3 { m.tab = 1
            nav.reset(ROUTE_ROOT,"今日") }
        else if nav.can_pop() { nav.pop() }
        else if m.records.len < 256 {
            m.records.push(m.category)
            if m.records.len == m.goal {
                snack.show("已完成今日 " + str(m.goal) + " 次目标",0,"",3200)
            }
        }
    } else if action == HEADER_ACTION {
        if nav.can_pop() { nav.pop() }
        else if m.tab == 3 { m.tab = 1 }
        else { m.tab = 3 }
    } else if action >= CATEGORY_BASE && action < CATEGORY_BASE + 3 {
        m.category = action - CATEGORY_BASE
        m.sheet = 0
    } else if action == TOGGLE_THEME { m.dark = !m.dark }
    else if action == CHOOSE_GOAL { m.sheet = 1 }
    else if action == RESET { m.sheet = 2 }
    else if action == CHOOSE_CATEGORY { m.sheet = 3 }
    else if action == DISMISS { m.sheet = 0 }
    else if action == CONFIRM_RESET {
        m.records = []int{}
        nav.pop_to_root()
        m.sheet = 0
        m.removed_value = -1
        m.removed_index = -1
        snack.show("已清空本次会话记录",0,"",2800)
    } else if action == DELETE_RECORD && nav.can_pop() {
        idx := nav.top().arg
        if idx >= 0 && idx < m.records.len {
            m.delete_at(idx)
            nav.pop()
            snack.show("已删除第 " + str(idx + 1) + " 条记录",SNACKBAR_UNDO,"撤销",3800)
        }
    } else if action == UNDO && m.records.len > 0 {
        last_idx := m.records.len - 1
        m.delete_at(last_idx)
        snack.show("已撤销最近一条记录",SNACKBAR_UNDO,"恢复",3800)
    } else if action == SNACKBAR_UNDO {
        if m.restore_removed() {
            snack.show("已恢复记录",0,"",2000)
        } else {
            snack.dismiss()
        }
    } else if action >= GOAL_BASE && action < GOAL_BASE + 3 {
        options := [6,12,24]
        m.goal = options[action - GOAL_BASE]
        m.sheet = 0
        snack.show("每日目标已设为 " + str(m.goal) + " 次",0,"",2400)
    }
}
