@main

#ui/draw
#ui/layout
#ui/phone
#math

fn header(c $&phone.Canvas,t $&phone.Touch,m &Model,nav &phone.RouteStack,s &phone.Scaffold,theme &phone.Theme) int {
    bounds := s.header
    if nav.can_pop() {
        top := nav.top()
        back_btn := phone.rect(bounds.x,bounds.y + 4.0,48.0,48.0)
        $fill := theme.surface
        if t.pressed(POP_ROUTE) { fill = theme.subtle_pressed }
        c.fill_round_rect(back_btn.x,back_btn.y,48.0,48.0,16.0,fill) or >>
        c.stroke_round_rect(back_btn.x,back_btn.y,48.0,48.0,16.0,theme.border,1.0) or >>
        c.icon(back_btn,phone.ICON_BACK,theme.ink) or >>
        t.target(POP_ROUTE,back_btn) or >>
        $title_align := draw.TEXT_LEFT
        $title_x := bounds.x + 60.0
        $title_w := math.max(80.0,bounds.width - 72.0)
        if phone.platform() == phone.IOS {
            title_align = draw.TEXT_CENTER
            title_x = bounds.x + 60.0
            title_w = math.max(80.0,bounds.width - 120.0)
        }
        $title_size := 24.0
        if s.wide { title_size = 20.0 }
        c.label(phone.rect(title_x,bounds.y + 4.0,title_w,32.0),top.title,title_size,700,theme.ink,title_align) or >>
        c.label(phone.rect(title_x,bounds.y + 36.0,title_w,22.0),"左边缘向右轻滑或点按返回",12.0,400,theme.muted,title_align) or >>
        << 0
    }
    titles := ["今日","记录","设置"]
    details := ["每一小步，都值得被看见。","留住每一次认真开始。","按自己的节奏来。"]
    $title_size := 30.0
    $title_height := 38.0
    if s.wide { title_size = 24.0
        title_height = 30.0 }
    c.label(phone.rect(bounds.x,bounds.y + 2.0,bounds.width - 64.0,title_height),titles[m.tab - 1] + "",title_size,700,theme.ink,draw.TEXT_LEFT) or >>
    c.label(phone.rect(bounds.x,bounds.y + title_height + 4.0,bounds.width - 64.0,22.0),details[m.tab - 1] + "",13.0,400,theme.muted,draw.TEXT_LEFT) or >>
    button := phone.rect(bounds.x + bounds.width - 48.0,bounds.y + 8.0,48.0,48.0)
    $fill := theme.surface
    if t.pressed(HEADER_ACTION) { fill = theme.subtle_pressed }
    c.fill_round_rect(button.x,button.y,48.0,48.0,16.0,fill) or >>
    c.stroke_round_rect(button.x,button.y,48.0,48.0,16.0,theme.border,1.0) or >>
    $icon := phone.ICON_SETTINGS
    if m.tab == 3 { icon = phone.ICON_HOME }
    c.icon(button,icon,theme.ink) or >>
    t.target(HEADER_ACTION,button) or >>
    << 0
}

fn hero(c $&phone.Canvas,t $&phone.Touch,m &Model,b layout.Rect,clip &layout.Rect,theme &phone.Theme) int {
    c.card(b,theme) or >>
    c.label(phone.rect(b.x + 24.0,b.y + 14.0,b.width - 90.0,30.0),category_name(m.category) + " · 今日记录",14.0,500,theme.muted,draw.TEXT_LEFT) or >>
    choice := phone.rect(b.x + b.width - 64.0,b.y + 6.0,48.0,48.0)
    c.icon(choice,category_icon(m.category),theme.accent) or >>
    t.target(CHOOSE_CATEGORY,phone.intersection(&choice,clip)) or >>
    $size := 64.0
    if b.height < 180.0 { size = 48.0 }
    $number_height := 80.0
    $number_y := b.y + 48.0
    if b.height < 180.0 { number_height = 56.0
        number_y = b.y + 36.0 }
    c.label(phone.rect(b.x + 22.0,number_y,b.width - 48.0,number_height),str(m.records.len),size,600,theme.ink,draw.TEXT_LEFT) or >>
    if b.height >= 200.0 {
        $message := "再记录 " + str(m.goal - m.records.len) + " 次，完成今日目标"
        if m.records.len >= m.goal { message = "今日目标已完成，继续保持自己的节奏" }
        c.label(phone.rect(b.x + 24.0,b.y + 126.0,b.width - 48.0,26.0),message,12.0,400,theme.muted,draw.TEXT_LEFT) or >>
    }
    progress := math.min(1.0,f64(m.records.len) / f64(m.goal))
    $y := b.y + b.height - 38.0
    if b.height < 180.0 { y = b.y + b.height - 20.0 }
    c.fill_round_rect(b.x + 24.0,y,b.width - 48.0,5.0,2.5,theme.subtle) or >>
    if progress > 0.0 { c.fill_round_rect(b.x + 24.0,y,(b.width - 48.0) * progress,5.0,2.5,theme.accent) or >> }
    if b.height >= 180.0 { c.label(phone.rect(b.x + 24.0,y + 8.0,b.width - 48.0,20.0),"每日目标 " + str(m.goal) + " 次",11.0,400,theme.muted,draw.TEXT_LEFT) or >> }
    << 0
}

fn history(c $&phone.Canvas,t $&phone.Touch,m &Model,b layout.Rect,clip &layout.Rect,theme &phone.Theme) int {
    if m.records.len == 0 {
        c.card(b,theme) or >>
        c.icon(phone.rect(b.x + 12.0,b.y + 20.0,48.0,48.0),phone.ICON_HISTORY,theme.muted) or >>
        c.label(phone.rect(b.x + 72.0,b.y + 16.0,b.width - 88.0,28.0),"还没有记录",16.0,500,theme.ink,draw.TEXT_LEFT) or >>
        c.label(phone.rect(b.x + 72.0,b.y + 44.0,b.width - 88.0,24.0),"从下方的「记录一次」开始",12.0,400,theme.muted,draw.TEXT_LEFT) or >>
        << 0
    }
    c.card(b,theme) or >>
    for i in 0:m.records.len {
        y := b.y + f64(i) * 72.0
        if y + 72.0 < clip.y || y > clip.y + clip.height { -> }
        rec_idx := m.records.len - 1 - i
        record := m.records[rec_idx]
        row_rect := phone.rect(b.x,y,b.width,72.0)
        label := "完成一次" + category_name(record)
        detail := "第 " + str(rec_idx + 1) + " 次 · 点按查看详情"
        c.row(row_rect,theme,label,detail,category_icon(record),t.pressed(ROW_BASE + rec_idx)) or >>
        c.icon(phone.rect(b.x + b.width - 44.0,y + 12.0,32.0,48.0),phone.ICON_CHEVRON,theme.muted) or >>
        t.target(ROW_BASE + rec_idx,phone.intersection(&row_rect,clip)) or >>
        if i + 1 < m.records.len { c.line(b.x + 64.0,y + 72.0,b.x + b.width - 16.0,y + 72.0,theme.border,1.0) or >> }
    }
    << 0
}

fn detail_page(c $&phone.Canvas,t $&phone.Touch,m &Model,nav &phone.RouteStack,s &phone.Scaffold,theme &phone.Theme) int {
    top := nav.top()
    idx := top.arg
    $cat := 0
    if idx >= 0 && idx < m.records.len { cat = m.records[idx] }
    body := s.body
    t.scroll_region(body,240.0) or >>
    card_h := math.min(220.0,math.max(168.0,body.height - 72.0))
    card_rect := phone.rect(body.x,body.y,body.width,card_h)
    c.card(card_rect,theme) or >>
    badge := phone.rect(card_rect.x + 20.0,card_rect.y + 20.0,48.0,48.0)
    c.fill_round_rect(badge.x,badge.y,48.0,48.0,16.0,theme.accent_tint) or >>
    c.icon(badge,category_icon(cat),theme.accent) or >>
    c.label(phone.rect(card_rect.x + 80.0,card_rect.y + 20.0,card_rect.width - 100.0,28.0),"完成一次" + category_name(cat),20.0,600,theme.ink,draw.TEXT_LEFT) or >>
    c.label(phone.rect(card_rect.x + 80.0,card_rect.y + 50.0,card_rect.width - 100.0,22.0),"第 " + str(idx + 1) + " 条记录 · 共 " + str(m.records.len) + " 条",13.0,400,theme.muted,draw.TEXT_LEFT) or >>
    c.line(card_rect.x + 20.0,card_rect.y + 88.0,card_rect.x + card_rect.width - 20.0,card_rect.y + 88.0,theme.border,1.0) or >>
    c.label(phone.rect(card_rect.x + 20.0,card_rect.y + 100.0,card_rect.width - 40.0,24.0),"当前记录仅保存在本进程会话中。",14.0,400,theme.muted,draw.TEXT_LEFT) or >>
    c.label(phone.rect(card_rect.x + 20.0,card_rect.y + 128.0,card_rect.width - 40.0,22.0),"每日目标 " + str(m.goal) + " 次 · 类别：" + category_name(cat),12.0,400,theme.muted,draw.TEXT_LEFT) or >>
    del_btn := phone.rect(body.x,card_rect.y + card_h + 16.0,body.width,52.0)
    c.button_tone(del_btn,theme,"删除这条记录",phone.TONE_DANGER,t.pressed(DELETE_RECORD)) or >>
    t.target(DELETE_RECORD,del_btn) or >>
    << 0
}

fn today(c $&phone.Canvas,t $&phone.Touch,m &Model,s &phone.Scaffold,theme &phone.Theme) int {
    body := s.body
    if s.wide {
        left := s.action.width
        hero(c,t,m,phone.rect(body.x,body.y,left,math.max(128.0,body.height - 72.0)),&body,theme) or >>
        list := phone.rect(body.x + left + 20.0,body.y,body.width - left - 20.0,body.height)
        h := math.max(88.0,f64(m.records.len) * 72.0)
        clip := phone.rect(list.x,list.y + 40.0,list.width,math.max(0.0,list.height - 40.0))
        t.scroll_region(clip,h) or >>
        c.label(phone.rect(list.x,list.y,list.width,28.0),"最近记录",16.0,600,theme.ink,draw.TEXT_LEFT) or >>
        c.push() or >>
        c.clip_rect(clip.x,clip.y,clip.width,clip.height) or >>
        history(c,t,m,phone.rect(list.x,list.y + 40.0 - t.offset(),list.width,h),&clip,theme) or >>
        c.pop() or >>
        c.scrollbar(&clip,theme,t.scroll_offset(),t.scroll_maximum(),h) or >>
        << 0
    }
    h := math.max(88.0,f64(m.records.len) * 72.0)
    total_h := 344.0 + h
    t.scroll_region(body,total_h) or >>
    offset := t.offset()
    c.push() or >>
    c.clip_rect(body.x,body.y,body.width,body.height) or >>
    hero(c,t,m,phone.rect(body.x,body.y - offset,body.width,208.0),&body,theme) or >>
    for i in 0:3 {
        w := (body.width - 16.0) / 3.0
        bounds := phone.rect(body.x + f64(i) * (w + 8.0),body.y + 224.0 - offset,w,48.0)
        c.chip(bounds,theme,category_name(i),m.category == i,t.pressed(CATEGORY_BASE + i)) or >>
        clipped := phone.intersection(&bounds,&body)
        t.target(CATEGORY_BASE + i,clipped) or >>
    }
    c.label(phone.rect(body.x,body.y + 292.0 - offset,body.width,28.0),"最近记录",16.0,600,theme.ink,draw.TEXT_LEFT) or >>
    history(c,t,m,phone.rect(body.x,body.y + 332.0 - offset,body.width,h),&body,theme) or >>
    c.pop() or >>
    c.scrollbar(&body,theme,t.scroll_offset(),t.scroll_maximum(),total_h) or >>
    << 0
}

fn records(c $&phone.Canvas,t $&phone.Touch,m &Model,s &phone.Scaffold,theme &phone.Theme) int {
    body := s.body
    h := math.max(88.0,f64(m.records.len) * 72.0)
    total_h := h + 76.0
    t.scroll_region(body,total_h) or >>
    c.push() or >>
    c.clip_rect(body.x,body.y,body.width,body.height) or >>
    history(c,t,m,phone.rect(body.x,body.y - t.offset(),body.width,h),&body,theme) or >>
    if m.records.len > 0 {
        button := phone.rect(body.x,body.y + h + 16.0 - t.offset(),body.width,56.0)
        c.button(button,theme,"撤销最近一次",false,t.pressed(UNDO)) or >>
        t.target(UNDO,phone.intersection(&button,&body)) or >>
    }
    c.pop() or >>
    c.scrollbar(&body,theme,t.scroll_offset(),t.scroll_maximum(),total_h) or >>
    << 0
}

fn settings(c $&phone.Canvas,t $&phone.Touch,m &Model,s &phone.Scaffold,theme &phone.Theme) int {
    body := s.body
    t.scroll_region(body,340.0) or >>
    y := body.y - t.offset()
    c.push() or >>
    c.clip_rect(body.x,body.y,body.width,body.height) or >>
    c.card(phone.rect(body.x,y,body.width,216.0),theme) or >>
    labels := ["深色外观","每日目标","清空本次记录"]
    details := ["切换适合你的阅读背景",str(m.goal) + " 次 · 点按调整","清空前会再次确认"]
    ids := [TOGGLE_THEME,CHOOSE_GOAL,RESET]
    icons := [phone.ICON_SETTINGS,phone.ICON_FOCUS,phone.ICON_HISTORY]
    for i in 0:3 {
        row := phone.rect(body.x,y + f64(i) * 72.0,body.width,72.0)
        c.row(row,theme,labels[i] + "",details[i] + "",icons[i],t.pressed(ids[i])) or >>
        t.target(ids[i],phone.intersection(&row,&body)) or >>
        if i == 0 {
            $fill := theme.border
            if m.dark { fill = theme.accent }
            xx := body.x + body.width - 68.0
            c.fill_round_rect(xx,row.y + 22.0,48.0,28.0,14.0,fill) or >>
            $knob := xx + 4.0
            if m.dark { knob += 20.0 }
            c.fill_circle(knob + 10.0,row.y + 36.0,10.0,theme.surface) or >>
        } else { c.icon(phone.rect(body.x + body.width - 44.0,row.y + 12.0,32.0,48.0),phone.ICON_CHEVRON,theme.muted) or >> }
        if i < 2 { c.line(body.x + 64.0,row.y + 72.0,body.x + body.width - 16.0,row.y + 72.0,theme.border,1.0) or >> }
    }
    c.label(phone.rect(body.x + 4.0,y + 240.0,body.width - 8.0,28.0),"小计 · 每一小步，都有分量。",14.0,500,theme.muted,draw.TEXT_CENTER) or >>
    c.label(phone.rect(body.x + 4.0,y + 274.0,body.width - 8.0,24.0),"记录仅保留在本次会话中",12.0,400,theme.muted,draw.TEXT_CENTER) or >>
    c.pop() or >>
    << 0
}

fn modal(c $&phone.Canvas,t $&phone.Touch,m &Model,s &phone.Scaffold,theme &phone.Theme) int {
    bounds := phone.sheet_bounds_with(s,312.0)
    $inner_h := bounds.height
    if s.safe.ime_bottom <= s.safe.bottom && bounds.height > s.safe.bottom {
        inner_h = bounds.height - s.safe.bottom
    }
    t.begin()
    t.block_scroll()
    t.target(DISMISS,phone.rect(0.0,0.0,s.width,s.height)) or >>
    t.target(0,bounds) or >>
    $title := "每日目标"
    if m.sheet == 2 { title = "清空本次记录？" }
    if m.sheet == 3 { title = "这一次，记录什么" }
    c.sheet(s,theme,bounds,title) or >>
    t.target(DISMISS,phone.rect(bounds.x + bounds.width - 64.0,bounds.y + 22.0,48.0,48.0)) or >>
    if m.sheet == 2 {
        $message := "专注、阅读和运动的记录都会清空。"
        if inner_h < 288.0 { message = "清空后无法撤销，请确认。" }
        c.label(phone.rect(bounds.x + 24.0,bounds.y + 82.0,bounds.width - 48.0,28.0),message,15.0,400,theme.muted,draw.TEXT_LEFT) or >>
        if inner_h >= 288.0 { c.label(phone.rect(bounds.x + 24.0,bounds.y + 112.0,bounds.width - 48.0,28.0),"这个操作无法撤销。",15.0,400,theme.muted,draw.TEXT_LEFT) or >> }
        $first := phone.rect(bounds.x + 20.0,bounds.y + inner_h - 144.0,bounds.width - 40.0,56.0)
        $second := phone.rect(first.x,first.y + 72.0,first.width,56.0)
        if inner_h < 288.0 {
            first = phone.rect(bounds.x + 20.0,bounds.y + inner_h - 112.0,bounds.width - 40.0,48.0)
            second = phone.rect(first.x,first.y + 56.0,first.width,48.0)
        }
        c.button_tone(first,theme,"保留记录",phone.TONE_SECONDARY,t.pressed(DISMISS)) or >>
        c.button_tone(second,theme,"确认清空",phone.TONE_DANGER,t.pressed(CONFIRM_RESET)) or >>
        t.target(DISMISS,first) or >>
        t.target(CONFIRM_RESET,second) or >>
    } else {
        goals := [6,12,24]
        for i in 0:3 {
            $row := phone.rect(bounds.x + 16.0,bounds.y + 76.0 + f64(i) * 72.0,bounds.width - 32.0,64.0)
            if inner_h < 280.0 {
                w := (bounds.width - 48.0) / 3.0
                row = phone.rect(bounds.x + 16.0 + f64(i) * (w + 8.0),bounds.y + 92.0,w,64.0)
            }
            $label := str(goals[i]) + " 次"
            $selected := m.goal == goals[i]
            $id := GOAL_BASE + i
            if m.sheet == 3 { label = category_name(i)
                selected = m.category == i
                id = CATEGORY_BASE + i }
            c.chip(row,theme,label,selected,t.pressed(id)) or >>
            if selected && inner_h >= 280.0 { c.icon(phone.rect(row.x + row.width - 48.0,row.y + 8.0,48.0,48.0),phone.ICON_CHECK,theme.accent) or >> }
            t.target(id,row) or >>
        }
    }
    << 0
}

fn paint(c $&phone.Canvas,t $&phone.Touch,m &Model,nav &phone.RouteStack,snack &phone.Snackbar,width f64,height f64) int {
    if width < 240.0 || height < 240.0 { << 0 }
    safe := phone.host_insets()
    shell := phone.scaffold_with(width,height,safe) or >>
    $theme := phone.light_theme()
    if m.dark { theme = phone.dark_theme() }
    c.begin(&theme) or >>
    t.begin()
    t.set_edge_back(m.sheet == 0 && nav.can_pop(),safe.left)
    header(c,t,m,nav,&shell,&theme) or >>
    if nav.can_pop() {
        detail_page(c,t,m,nav,&shell,&theme) or >>
    } else {
        if m.tab == 1 { today(c,t,m,&shell,&theme) or >> }
        else if m.tab == 2 { records(c,t,m,&shell,&theme) or >> }
        else { settings(c,t,m,&shell,&theme) or >> }
    }
    c.navigation(&shell,&theme,m.tab,&*t) or >>
    for i in 0:3 { t.target(i + 1,phone.tab_bounds(&shell,i)) or >> }
    $label := "记录一次 · " + category_name(m.category)
    if nav.can_pop() { label = "返回列表" }
    else if m.tab == 3 { label = "完成设置" }
    else if m.records.len >= 256 { label = "已达本次会话记录上限" }
    c.button(shell.action,&theme,label,true,t.pressed(RECORD)) or >>
    if nav.can_pop() || m.tab == 3 || m.records.len < 256 { t.target(RECORD,shell.action) or >> }
    if snack.active && m.sheet == 0 {
        sb := phone.snackbar_bounds(&shell)
        c.snackbar(&sb,&theme,~snack.message,~snack.action_label,t.pressed(SNACKBAR_UNDO)) or >>
        t.target(0,sb) or >>
        if snack.action_label.len > 0 {
            act := phone.snackbar_action_bounds(&sb,true)
            t.target(SNACKBAR_UNDO,act) or >>
        }
    }
    if m.sheet == 0 && nav.can_pop() {
        swipe := t.edge_swipe_progress(width)
        if swipe > 0.01 {
            c.fill_rect(safe.left,safe.top + 80.0,4.0 + swipe * 8.0,math.max(48.0,height - safe.top - safe.bottom - 160.0),theme.accent) or >>
        }
    }
    if m.sheet > 0 { modal(c,t,m,&shell,&theme) or >> }
    phone.set_back_enabled(m.sheet > 0 || nav.can_pop()) or >>
    phone.set_overlay(m.sheet > 0) or >>
    c.present() or >>
    << 0
}
