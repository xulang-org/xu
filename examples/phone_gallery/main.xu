@main

#time
#ui
#ui/draw
#ui/phone

fn empty_request() ui.Request {
    << ui.Request{id: 0,window_id: 0,canvas_id: 0,generation: 0,kind: 0}
}

fn try_clipboard_write(identity &ui.CanvasEvent,text &string) ui.Request {
    req := ui.clipboard_write_async(identity,text,&ui.RequestOptions{timeout_ms: 2000}) >>> (err) {
        << empty_request()
    }
    << req
}

fn try_clipboard_read(identity &ui.CanvasEvent) ui.Request {
    req := ui.clipboard_read_async(identity,&ui.RequestOptions{timeout_ms: 2000}) >>> (err) {
        << empty_request()
    }
    << req
}

fn try_decode_request(event &ui.Event) ui.RequestResult {
    res := ui.request_of(event) >>> (err) {
        << ui.RequestResult{request: empty_request(),status: ui.REQUEST_FAILED,value: ""}
    }
    << res
}

fn try_apply_note(field $&phone.TextField,value string) bool {
    _ := field.set_value(value) >>> (err) { << false }
    << true
}

fn scene(events chan ui.Event) int {
    $state := model()
    while true {
        event := <- events
        if event.kind == ui.EV_EXIT { << 0 }
        if event.kind != ui.EV_CANVAS_READY { -> }
        identity := ui.canvas_of(&event) >>>
        context := draw.context_of(&event) >>>
        draw.set_input_enabled(1)
        $canvas := phone.canvas(&context)
        $touches := phone.touch(&identity)
        $nav := phone.route_stack(ROUTE_ROOT,"今日")
        $snack := phone.snackbar_empty()
        $note_field := phone.text_field(&context,&identity,NOTE_FIELD,NOTE_CLEAR,"写一句今天的小记（2-40字）")
        $clip_req := ui.Request{id: 0,window_id: 0,canvas_id: 0,generation: 0,kind: 0}
        $width := 390.0
        $height := 700.0
        paint($&canvas,$&touches,&state,&nav,&snack,$&note_field,width,height) >>>
        while true {
            $has_event := true
            $next := ui.Event{kind: ui.EV_NONE,window_id: 0,menu_id: "",width: 0,height: 0}
            if snack.active || touches.animating() {
                select {
                    ev := <- events { next = ev }
                    else { has_event = false }
                }
                if !has_event {
                    time.sleep(16000000)
                    now_ns := time.now()
                    $ticked := touches.step_at(now_ns)
                    if snack.tick(now_ns) { ticked = true }
                    if ticked { paint($&canvas,$&touches,&state,&nav,&snack,$&note_field,width,height) >>> }
                    ->
                }
            } else {
                next = <- events
            }
            if next.kind == ui.EV_EXIT || next.kind == ui.EV_CANVAS_CLOSED {
                note_field.blur()
                canvas.dispose()
                << 0
            }
            if next.kind == ui.EV_CANVAS_METRICS {
                metrics := ui.metrics_of(&next) >>>
                if metrics.canvas_id != identity.canvas_id || metrics.generation != identity.generation { -> }
                width = metrics.width
                height = metrics.height
            }
            $dismissed := false
            if state.sheet > 0 {
                safe := phone.host_insets()
                shell := phone.scaffold_with(width,height,safe) >>>
                sheet := phone.sheet_bounds_with(&shell,312.0)
                dismissed = touches.swipe_down(&next,phone.rect(sheet.x,sheet.y,sheet.width,70.0))
            }
            $swiped_back := false
            if state.sheet == 0 && nav.can_pop() {
                swiped_back = touches.swipe_back(&next,width)
            }
            action := touches.event(&next) >>>
            if touches.take_refresh_haptic() {
                phone.haptic(phone.HAPTIC_SELECTION)
            }
            refreshed := touches.take_refresh()
            if refreshed {
                state.sync_session($&snack)
            }
            field_res := note_field.handle_event(&next,&touches,action)
            if field_res.changed { note_field.set_error("") }
            if dismissed {
                state.sheet = 0
                touches.cancel()
            } else if swiped_back {
                nav.pop()
                touches.reset_scroll()
            }
            if action > 0 {
                previous := state.tab
                prev_depth := nav.depth()
                if action == SAVE_NOTE {
                    err_msg := state.save_note(note_field.value,$&snack)
                    note_field.set_error(err_msg)
                    if note_field.error.len == 0 {
                        note_field.blur()
                    }
                } else if action == COPY_NOTE {
                    $src := trim_ascii_space(&note_field.value)
                    if src.len == 0 { src = state.saved_note + "" }
                    if src.len == 0 {
                        phone.haptic(phone.HAPTIC_ERROR)
                        note_field.set_error("请先输入或保存备注后再复制")
                    } else {
                        if clip_req.id > 0 { _ := clip_req.cancel() }
                        req := try_clipboard_write(&identity,&src)
                        if req.id > 0 { clip_req = req }
                        else {
                            phone.haptic(phone.HAPTIC_ERROR)
                            note_field.select_all()
                            note_field.set_error("剪贴板请求发起失败，已选中内容")
                        }
                    }
                } else if action == PASTE_NOTE {
                    if clip_req.id > 0 { _ := clip_req.cancel() }
                    req := try_clipboard_read(&identity)
                    if req.id > 0 { clip_req = req }
                    else {
                        phone.haptic(phone.HAPTIC_ERROR)
                        note_field.set_error("无法发起剪贴板读取请求")
                    }
                } else {
                    state.activate(action,$&nav,$&snack)
                }
                if state.sheet > 0 || state.tab != 3 || nav.can_pop() {
                    note_field.blur()
                }
                if previous != state.tab || prev_depth != nav.depth() || action == CONFIRM_RESET { touches.reset_scroll() }
                println("phone-design: page=" + str(state.tab) + " depth=" + str(nav.depth()) + " count=" + str(state.records.len) + " sheet=" + str(state.sheet) + " note=" + state.saved_note)
            }
            if field_res.submitted {
                err_msg := state.save_note(note_field.value,$&snack)
                note_field.set_error(err_msg)
                if note_field.error.len == 0 {
                    note_field.blur()
                }
            }
            $clip_done := false
            if next.kind == ui.EV_REQUEST {
                res := try_decode_request(&next)
                if res.request.id > 0 && clip_req.id > 0 && res.matches(&clip_req) {
                    clip_req.id = 0
                    clip_done = true
                    if res.status == ui.REQUEST_COMPLETED {
                        if res.request.kind == ui.REQUEST_CLIPBOARD_WRITE {
                            note_field.set_error("")
                            phone.haptic(phone.HAPTIC_SUCCESS)
                            snack.show("已复制到系统剪贴板",0,"",2400)
                        } else if res.request.kind == ui.REQUEST_CLIPBOARD_READ {
                            if res.value.len == 0 {
                                phone.haptic(phone.HAPTIC_SELECTION)
                                snack.show("系统剪贴板为空",0,"",2200)
                            } else if try_apply_note($&note_field,res.value + "") {
                                note_field.set_error("")
                                phone.haptic(phone.HAPTIC_SUCCESS)
                                snack.show("已从剪贴板填入草稿",0,"",2400)
                            } else {
                                phone.haptic(phone.HAPTIC_ERROR)
                                note_field.set_error("剪贴板内容超出输入框限制")
                                snack.show("剪贴板内容超出长度限制",0,"",2400)
                            }
                        }
                    } else {
                        phone.haptic(phone.HAPTIC_ERROR)
                        if res.request.kind == ui.REQUEST_CLIPBOARD_WRITE {
                            note_field.select_all()
                            note_field.set_error("系统剪贴板写入失败，已选中文本请手动复制")
                        } else {
                            note_field.set_error("读取系统剪贴板失败或暂不可用")
                        }
                        snack.show("剪贴板操作未成功",0,"",2400)
                    }
                }
            }
            if next.kind == ui.EV_NAVIGATE_BACK {
                if note_field.is_focused() {
                    note_field.blur()
                } else if state.sheet > 0 {
                    state.sheet = 0
                    touches.cancel()
                } else if nav.can_pop() {
                    nav.pop()
                    touches.reset_scroll()
                }
            }
            if ui.is_input_event(next.kind) || next.kind == ui.EV_CANVAS_METRICS ||
               next.kind == ui.EV_BLURRED || next.kind == ui.EV_NAVIGATE_BACK ||
               next.kind == ui.EV_CANVAS_PREFERENCES || dismissed || swiped_back || refreshed || clip_done || field_res.needs_paint {
                paint($&canvas,$&touches,&state,&nav,&snack,$&note_field,width,height) >>>
            }
        }
    }
    << 0
}
fn worker(events chan ui.Event) { scene(events) >>> (err) { eprintln(err.msg())
    << } }
fn launch() int {
    $app := ui.new_app()
    $window := app.open_window(ui.WindowOpts{title: "小计",width: 390,height: 700}) >>>
    draw.attach($&window)
    xu worker(app.event_ch)
    << app.run() >>>
}
fn main() int { << launch() >>> (err) { eprintln(err.msg())
    << 1 } }
