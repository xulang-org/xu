@main

#time
#ui
#ui/draw
#ui/phone

fn scene(events chan ui.Event) int {
    $state := model()
    while true {
        event := <- events
        if event.kind == ui.EV_EXIT { << 0 }
        if event.kind != ui.EV_CANVAS_READY { -> }
        identity := ui.canvas_of(&event) or >>
        context := draw.context_of(&event) or >>
        draw.set_input_enabled(1)
        $canvas := phone.canvas(&context)
        $touches := phone.touch(&identity)
        $nav := phone.route_stack(ROUTE_ROOT,"今日")
        $snack := phone.snackbar_empty()
        $width := 390.0
        $height := 700.0
        paint($&canvas,$&touches,&state,&nav,&snack,width,height) or >>
        while true {
            $has_event := true
            $next := ui.Event{kind: ui.EV_NONE,window_id: 0,menu_id: "",width: 0,height: 0}
            if snack.active || touches.animating() {
                select {
                    ev := <- events { next = ev }
                    else { has_event = false }
                }
                if !has_event {
                    time.sleep(16000000)
                    now_ns := time.now()
                    $ticked := touches.step_at(now_ns)
                    if snack.tick(now_ns) { ticked = true }
                    if ticked { paint($&canvas,$&touches,&state,&nav,&snack,width,height) or >> }
                    ->
                }
            } else {
                next = <- events
            }
            if next.kind == ui.EV_EXIT || next.kind == ui.EV_CANVAS_CLOSED { canvas.dispose()
                << 0 }
            if next.kind == ui.EV_CANVAS_METRICS {
                metrics := ui.metrics_of(&next) or >>
                if metrics.canvas_id != identity.canvas_id || metrics.generation != identity.generation { -> }
                width = metrics.width
                height = metrics.height
            }
            $dismissed := false
            if state.sheet > 0 {
                safe := phone.host_insets()
                shell := phone.scaffold_with(width,height,safe) or >>
                sheet := phone.sheet_bounds_with(&shell,312.0)
                dismissed = touches.swipe_down(&next,phone.rect(sheet.x,sheet.y,sheet.width,70.0))
            }
            $swiped_back := false
            if state.sheet == 0 && nav.can_pop() {
                swiped_back = touches.swipe_back(&next,width)
            }
            action := touches.event(&next) or >>
            if dismissed {
                state.sheet = 0
                touches.cancel()
            } else if swiped_back {
                nav.pop()
                touches.reset_scroll()
            }
            if action > 0 {
                previous := state.tab
                prev_depth := nav.depth()
                state.activate(action,$&nav,$&snack)
                if previous != state.tab || prev_depth != nav.depth() || action == CONFIRM_RESET { touches.reset_scroll() }
                println("phone-design: page=" + str(state.tab) + " depth=" + str(nav.depth()) + " count=" + str(state.records.len) + " sheet=" + str(state.sheet))
            }
            if next.kind == ui.EV_NAVIGATE_BACK {
                if state.sheet > 0 {
                    state.sheet = 0
                    touches.cancel()
                } else if nav.can_pop() {
                    nav.pop()
                    touches.reset_scroll()
                }
            }
            if ui.is_input_event(next.kind) || next.kind == ui.EV_CANVAS_METRICS ||
               next.kind == ui.EV_BLURRED || next.kind == ui.EV_NAVIGATE_BACK ||
               next.kind == ui.EV_CANVAS_PREFERENCES || dismissed || swiped_back {
                paint($&canvas,$&touches,&state,&nav,&snack,width,height) or >>
            }
        }
    }
    << 0
}
fn worker(events chan ui.Event) { scene(events) or (err) { eprintln(err.msg())
    << } }
fn launch() int {
    $app := ui.new_app()
    $window := app.open_window(ui.WindowOpts{title: "小计",width: 390,height: 700}) or >>
    draw.attach($&window)
    xu worker(app.event_ch)
    << app.run() or >>
}
fn main() int { << launch() or (err) { eprintln(err.msg())
    << 1 } }
