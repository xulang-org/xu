@main
#ui
#ui/draw
#ui/phone

fn paint(frame $&draw.Frame, count int) int {
    frame.begin() or >>
    frame.set_bg(draw.rgb(246,244,238)) or >>
    title := "Xu Phone / " + str(phone.platform())
    frame.text(28.0,42.0,24.0,draw.rgb(30,38,44),&title) or >>
    frame.fill_round_rect(28.0,126.0,280.0,120.0,24.0,draw.rgb(209,67,41)) or >>
    label := "Tap count: " + str(count)
    frame.text(52.0,172.0,28.0,draw.rgb(255,255,255),&label) or >>
    frame.present() or >>
    println("phone-counter=" + str(count))
    << 0
}
fn scene(events chan ui.Event) int {
    $count := 0
    while true {
        event := <- events
        if event.kind == ui.EV_EXIT { << 0 }
        if event.kind != ui.EV_CANVAS_READY { -> }
        context := draw.context_of(&event) or >>
        $frame := context.new_frame(4096)
        draw.set_input_enabled(1)
        paint($&frame,count) or >>
        while true {
            input_event := <- events
            if input_event.kind == ui.EV_EXIT { frame.dispose()
                << 0 }
            if input_event.kind == ui.EV_POINTER_UP {
                input := ui.input_of(&input_event) or >>
                if input.x >= 28.0 && input.x <= 308.0 && input.y >= 126.0 && input.y <= 246.0 {
                    count += 1
                    paint($&frame,count) or >>
                }
            }
        }
    }
    << 0
}
fn worker(events chan ui.Event) {
    scene(events) or (err) { eprintln(err.msg())
        << }
}
fn launch() int {
    $app := ui.new_app()
    $window := app.open_window(ui.WindowOpts{title: "Xu Phone",width: 390,height: 700}) or >>
    draw.attach($&window)
    xu worker(app.event_ch)
    << app.run() or >>
}
fn main() int { << launch() or (err) { eprintln(err.msg())
    << 1 } }
