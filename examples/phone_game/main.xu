@main

#app
#gpu
#window
#window/events

// Native GPU presentation probe. The system owns frame scheduling; this loop
// and its typed owners stay alive on the host's suspended application stack.
fn run_game() int {
    options := window.Options{title: "Xu Phone GPU", width: 640, height: 360,
        resizable: true, high_pixel_density: true, hidden: false}
    $target := window.open(&options) or >>
    $device := gpu.open(gpu.DeviceOptions{backend: gpu.AUTO, debug: false,
        shader_formats: gpu.SHADER_MSL | gpu.SHADER_SPIRV}) or >>
    $surface := device.surface(&target, gpu.SurfaceOptions{present_mode: gpu.PRESENT_VSYNC}) or >>
    $frames := 0
    while true {
        ready := app.next_frame() or >>
        if !ready { <- }
        window.pump() or >>
        $quit := false
        for i in 0:events.QUEUE_CAPACITY {
            event := target.poll() or >>
            if event.kind == events.EVENT_NONE { <- }
            if event.kind == events.EVENT_CLOSE_REQUESTED { quit = true }
        }
        if quit { <- }
        $frame := surface.acquire() or >>
        if !frame.has_image() { -> }
        color := gpu.Color{r: 0.08, g: 0.18 + f64(frames % 120) / 240.0, b: 0.38, a: 1.0}
        $pass := frame.begin_render(gpu.CLEAR, color, gpu.no_depth()) or >>
        pass.end() or >>
        $fence := frame.present() or >>
        fence.close() or >>
        frames += 1
    }
    surface.close() or >>
    device.close() or >>
    target.close() or >>
    << 0
}

fn main() int {
    << run_game() or (err) {
        eprintln(err.msg())
        << 1
    }
}
