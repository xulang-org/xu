@main

#sort

// LCG fill + heap sort of 50k ints; checksum samples sorted positions.
fn main() int {
    mut a := []int{}
    mut i := 0
    mut x := 12345
    while i < 100000 {
        x = (x * 1103515245 + 12345) & 0x7FFFFFFF
        a.push(x)
        i += 1
    }
    sort.ints(mut &a)
    println(a[0] + a[50000] * 2 + a[99999] * 3)
    << 0
}
