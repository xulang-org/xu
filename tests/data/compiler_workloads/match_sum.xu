@main

// Dense 8-way match in a counted loop (jump table / branch).
fn main() int {
    mut s := 0
    mut i := 0
    while i < 24000000 {
        k := i & 7
        match k {
            0 {
                s += 1
            }
            1 {
                s += 3
            }
            2 {
                s += 5
            }
            3 {
                s += 7
            }
            4 {
                s += 11
            }
            5 {
                s += 13
            }
            6 {
                s += 17
            }
            else {
                s += 19
            }
        }
        i += 1
    }
    println(s)
    // Keep i live: 8-way match loops currently collapse to 112 trips if i is dead.
    println(i)
    << 0
}
