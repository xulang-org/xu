@main

#math/bits

// Hot stdlib bit operations. The recurrence keeps every result live so the
// compiler cannot replace the loop with a constant checksum.
fn main() int {
    mut x := 0x123456789abcdef0
    mut sum := 0
    mut i := 0
    while i < 5000000 {
        x = bits.rotate_left(x ^ i, 13)
        sum += bits.len(x)
        sum += bits.leading_zeros(x)
        sum += bits.trailing_zeros(x)
        sum += bits.ones_count(x)
        x = bits.reverse_bytes(x)
        sum = sum ^ bits.reverse(x)
        i += 1
    }
    println(sum)
    << 0
}
