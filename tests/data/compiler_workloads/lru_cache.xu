@main

struct Node {
    pub key int
    pub val int
    pub prev int
    pub next int
}

struct LRU {
    pub nodes []Node
    pub head int
    pub tail int
    pub cap int
    pub count int
    pub table []int
}

fn new_lru(capacity int, table_size int) LRU {
    mut nodes := []Node{}
    mut i := 0
    while i < capacity {
        nodes.push(Node{key: -1, val: 0, prev: -1, next: -1})
        i += 1
    }
    mut table := []int{}
    i = 0
    while i < table_size {
        table.push(-1)
        i += 1
    }
    << LRU{
        nodes: nodes,
        head: -1,
        tail: -1,
        cap: capacity,
        count: 0,
        table: table
    }
}

fn (l &mut LRU) remove_node(idx int) {
    p := l.nodes[idx].prev
    n := l.nodes[idx].next
    if p >= 0 {
        l.nodes[p].next = n
    } else {
        l.head = n
    }
    if n >= 0 {
        l.nodes[n].prev = p
    } else {
        l.tail = p
    }
}

fn (l &mut LRU) push_front(idx int) {
    l.nodes[idx].prev = -1
    l.nodes[idx].next = l.head
    if l.head >= 0 {
        l.nodes[l.head].prev = idx
    }
    l.head = idx
    if l.tail < 0 {
        l.tail = idx
    }
}

fn (l &mut LRU) put(key int, val int) int {
    old_idx := l.table[key]
    if old_idx >= 0 {
        l.nodes[old_idx].val = val
        l.remove_node(old_idx)
        l.push_front(old_idx)
        << val
    }
    mut idx := 0
    if l.count < l.cap {
        idx = l.count
        l.count += 1
    } else {
        idx = l.tail
        old_key := l.nodes[idx].key
        l.table[old_key] = -1
        l.remove_node(idx)
    }
    l.nodes[idx].key = key
    l.nodes[idx].val = val
    l.table[key] = idx
    l.push_front(idx)
    << val
}

fn (l &mut LRU) get(key int) int {
    idx := l.table[key]
    if idx < 0 {
        << -1
    }
    l.remove_node(idx)
    l.push_front(idx)
    << l.nodes[idx].val
}

fn main() int {
    mut lru := new_lru(1000, 3000)
    mut seed := 123456789
    mut checksum := 0
    mut i := 0
    while i < 2500000 {
        seed = (seed * 1664525 + 1013904223) % 2147483647
        key := seed % 3000
        val := seed % 1000000
        if (seed & 1) == 0 {
            res := lru.put(key, val)
            checksum = (checksum * 33 + res) % 1000000007
        } else {
            res := lru.get(key)
            checksum = (checksum * 33 + res) % 1000000007
        }
        i += 1
    }
    println(checksum)
    << 0
}
