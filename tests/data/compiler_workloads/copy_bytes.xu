@main

// Indexed bulk copy of a 1Mi-element buffer, 80 passes.
// Probes descriptor addressing + StoreIndex/LoadIndex, not a memcpy intrinsic.
fn fill(n int) []int {
    mut a := []int{}
    mut i := 0
    while i < n {
        a.push(i & 1023)
        i += 1
    }
    << a
}

fn main() int {
    n := 1048576
    src := fill(n)
    mut dst := fill(n)
    mut t := 0
    while t < 80 {
        mut i := 0
        while i < n {
            dst[i] = src[i]
            i += 1
        }
        t += 1
    }
    mut s := 0
    mut j := 0
    while j < n {
        s += dst[j]
        j += 1
    }
    println(s)
    << 0
}
