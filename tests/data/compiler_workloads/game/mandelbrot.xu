@main

#errors

// Benchmarks Game mandelbrot P4 (single-thread classic). Default N = 4000.
// verify N=200 vs golden/mandelbrot-output.txt
// Loop shape matches cross/mandelbrot.rs: fused `i < 50 && tr+ti <= 4`.
// Kernel lives in render (no Call) so hosted RA can pin f64. Pixels are
// written in 64KiB chunks like fwrite, not copied into a second string.

fn arg_n() int {
    a := args()
    if a.len > 1 {
        mut n := 0
        mut i := 0
        s := a[1]
        while i < s.len {
            c := s[i] & 255
            if c < 48 {
                << 4000
            }
            if c > 57 {
                << 4000
            }
            n = n * 10 + (c - 48)
            i += 1
        }
        << n
    }
    << 4000
}

fn render(pixels &mut []u8, w int) {
    mut y := 0
    while y < w {
        ci := 2.0 * f64(y) / f64(w) - 1.0
        mut x := 0
        while x < w {
            cr := 2.0 * f64(x) / f64(w) - 1.5
            mut zr := 0.0
            mut zi := 0.0
            mut tr := 0.0
            mut ti := 0.0
            mut iter := 0
            while iter < 50 && tr + ti <= 4.0 {
                zi = 2.0 * zr * zi + ci
                zr = tr - ti + cr
                tr = zr * zr
                ti = zi * zi
                iter += 1
            }
            if tr + ti <= 4.0 {
                bit := 128 >> (x & 7)
                idx := y * (w >> 3) + (x >> 3)
                pixels[idx] = pixels[idx] | u8(bit)
            }
            x += 1
        }
        y += 1
    }
}

fn write_pixels(pixels &[]u8) {
    n := pixels.len
    mut off := 0
    mut chunk := ""
    while off < n {
        chunk = ""
        mut end := off + 65536
        if end > n {
            end = n
        }
        while off < end {
            chunk.push_byte(int(pixels[off]))
            off += 1
        }
        os_fd_write(1, chunk) or (err) {
            <<< 1
        }
    }
}

fn main() int {
    size := arg_n()
    w := (size + 7) / 8 * 8
    nbytes := w * w / 8
    mut pixels := []u8{}
    for i in 0:nbytes {
        pixels.push(u8(0))
    }
    render(mut &pixels, w)
    header := "P4\n" + str(w) + " " + str(w) + "\n"
    os_fd_write(1, header) or (err) { << 1 }
    write_pixels(&pixels)
    << 0
}
