@main

// Benchmarks Game binary-trees (single-thread). Default N = 18.
// verify N=10 vs golden/binarytrees-output.txt
// Algorithm matches cross/binarytrees.rs: Box tree, count walks nodes,
// stretch dropped, long-lived kept until the end, per-iteration trees dropped.
// Xu has no Box; Forest is a bump arena (indices, -1 = None). Reset `used`
// is the drop; cap is kept so pages are reused like malloc/free.

struct Forest {
    left []int
    right []int
    used int
}

fn alloc(t &mut Forest, l int, r int) int {
    id := t.used
    if id >= t.left.len {
        t.left.push(l)
        t.right.push(r)
    } else {
        t.left[id] = l
        t.right[id] = r
    }
    t.used = id + 1
    << id
}

fn make(t &mut Forest, depth int) int {
    if depth <= 0 {
        << alloc(t, -1, -1)
    }
    l := make(t, depth - 1)
    r := make(t, depth - 1)
    << alloc(t, l, r)
}

fn count(t &Forest, id int) int {
    l := t.left[id]
    if l < 0 {
        << 1
    }
    << 1 + count(t, l) + count(t, t.right[id])
}

fn parse_n() int {
    av := args()
    if av.len <= 1 {
        << 18
    }
    mut v := 0
    mut i := 0
    s := av[1]
    while i < s.len {
        c := s[i] & 255
        if c < 48 {
            << 18
        }
        if c > 57 {
            << 18
        }
        v = v * 10 + (c - 48)
        i += 1
    }
    if v < 1 {
        << 18
    }
    << v
}

fn main() int {
    mut v := parse_n()
    min_depth := 4
    if v < min_depth + 2 {
        v = min_depth + 2
    }
    md := v
    mut scratch := Forest{left: []int{}, right: []int{}, used: 0}
    mut long_f := Forest{left: []int{}, right: []int{}, used: 0}
    sid := make(mut &scratch, md + 1)
    println("stretch tree of depth " + str(md + 1) + "\t check: " + str(count(&scratch, sid)))
    scratch.used = 0
    lid := make(mut &long_f, md)
    mut depth := min_depth
    while depth <= md {
        mut iterations := 1
        mut s := 0
        while s < md - depth + min_depth {
            iterations = iterations * 2
            s += 1
        }
        mut check := 0
        mut i := 0
        while i < iterations {
            scratch.used = 0
            tid := make(mut &scratch, depth)
            check += count(&scratch, tid)
            i += 1
        }
        println(str(iterations) + "\t trees of depth " + str(depth) + "\t check: " + str(check))
        depth += 2
    }
    println("long lived tree of depth " + str(md) + "\t check: " + str(count(&long_f, lid)))
    << 0
}
