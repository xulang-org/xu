@main

#io
#strings

fn main() int {
    seed := "alpha,beta,gamma,delta;omega,phi,chi;lambda,mu,nu"
    base := strings.repeat(&seed, 384)
    mut total := 0
    mut i := 0
    while i < 2500 {
        s := strings.replace(&base, "a", "A", -1)
        total += s.len
        parts := strings.split(&s, ";")
        total += parts.len
        mut j := 0
        while j < parts.len {
            p := parts[j]
            total += p.len
            if strings.has_prefix(&p, "A") {
                total += 1
            }
            total += strings.count(&p, "a")
            j += 1
        }
        line := strings.join(parts, "|")
        total += line.len

        mut c := io.cursor(strings.trim_space(&line))
        got := c.read_n(256)
        total += got.len
        if c.remaining() > 0 {
            total += c.remaining()
        }
        i += 1
    }

    println(total)
    << 0
}
