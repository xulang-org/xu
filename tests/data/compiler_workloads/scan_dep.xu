@main

// Carried integer dependence: 4096-wide prefix add, 20000 rounds.
// Probes skip-store / load-after-store vs Clang's scalar chain.
fn fill() []int {
    mut a := []int{}
    mut i := 0
    while i < 4096 {
        a.push(i & 1023)
        i += 1
    }
    << a
}

fn main() int {
    mut a := fill()
    n := a.len
    mut t := 0
    while t < 20000 {
        mut i := 1
        while i < n {
            a[i] = a[i] + (a[i - 1] & 1023)
            i += 1
        }
        t += 1
    }
    println(a[n - 1])
    << 0
}
