@main
struct Box { value int }
fn kernel(n int, unused &[]int) f64 {
    mut x := 0.0
    mut i := 0
    while i < n {
        x += f64(i & 7) * 0.125
        i += 1
    }
    << x
}
fn main() int {
    mut vals := [1,2,3]
    value := 7
    b := Box{value: 9}
    println(int(kernel(40000, &vals)))
    println(vals[0])
    << 0
}
