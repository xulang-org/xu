@main
struct Box { value int }
fn kernel(v &[]int, n int) f64 {
    alias := v
    mut x := 0.0
    mut i := 0
    while i < n {
        x += f64(alias[i & 1]) * 0.125
        i += 1
    }
    << x
}
fn main() int {
    mut vals := [1,2,3]
    value := 7
    b := Box{value: 9}
    println(int(kernel(&vals, 40000)))
    println(vals[0])
    << 0
}
