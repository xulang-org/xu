@main
struct Box { value int }
fn kernel(v &mut []int, n int) f64 {
    mut x := 0.0
    mut i := 0
    while i < n {
        x += f64(i & 7) * 0.125
        v[0] += 1
        i += 1
    }
    << x
}
fn main() int {
    mut vals := [1,2,3]
    value := 7
    b := Box{value: 9}
    println(int(kernel(mut &vals, 40000)))
    println(vals[0])
    << 0
}
