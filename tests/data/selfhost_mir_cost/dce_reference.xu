@xu/types
// Frozen independent scan-based oracle for the DCE occurrence-count rewrite.
fn mir_dce_reference(f &mut MFn) bool {
    mut changed := false
    nt := f.temps.len
    for _ in 0:16 {
        mut round := false
        for bi in 0:f.blocks.len {
            mut ids := []int{}
            mut ii := f.blocks[bi].head
            for _ in 0:f.instrs.len {
                if ii < 0 { <- }
                ids.push(ii)
                ii = f.instrs[ii].next
            }
            mut live := []bool{}
            for _t in 0:nt {
                live.push(false)
            }
            tk := f.blocks[bi].tkind
            if tk == 2 || tk == 3 {
                ta := f.blocks[bi].ta
                if ta >= 0 && ta < nt {
                    live[ta] = true
                }
            }
            for t in 0:nt {
                if live[t] {
                    ->
                }
                if f.temp_used_outside(t, bi) {
                    live[t] = true
                }
            }
            mut kill := []int{}
            mut k := ids.len - 1
            while k >= 0 {
                ii = ids[k]
                mut dest := f.pure_int_dest(ii)
                if dest < 0 && f.instrs[ii].kind == 1 {
                    a := f.instrs[ii].a
                    if a >= 0 && a < nt {
                        if a < f.temps_nslots.len && f.temps_nslots[a] == 1 {
                            dest = a
                        }
                    }
                }
                mut id_copy := false
                if f.instrs[ii].kind == 1 && f.instrs[ii].a >= 0 && f.instrs[ii].a == f.instrs[ii].b {
                    id_copy = true
                }
                mut dead := false
                if dest >= 0 {
                    dest_live := dest < nt && live[dest]
                    if !dest_live || id_copy {
                        dead = true
                    }
                }
                if dead {
                    kill.push(ii)
                    k -= 1
                    ->
                }
                if dest >= 0 && dest < nt {
                    live[dest] = false
                }
                for t in 0:nt {
                    if f.instr_uses_temp(ii, t) {
                        live[t] = true
                    }
                }
                k -= 1
            }
            for ki in 0:kill.len {
                mir_delete_instr(f, bi, kill[ki])
                round = true
            }
        }
        if !round {
            <-
        }
        changed = true
    }
    << changed
}
