@main
#xu/types
fn main() int {
    if !types.dce_test_operands() { << 1 }
    for seed in 0:512 { if !types.dce_test_reference(seed) { << 2 } }
    for loc in [0, 61, 62, 63, 123, 124, 129] {
        if types.borrow_test_word(loc, false) != 1 { << 3 }
        if types.borrow_test_word(loc, true) != 0 { << 4 }
    }
    for mode in 0:3 { if !types.ssa_test_cfg(mode) { eprintln("SSA case=" + str(mode))
            << 5 } }
    println("DCE reference and borrow words ok")
    << 0
}
