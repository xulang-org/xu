@xu/types

fn dce_test_same(a &MFn, b &MFn) bool {
    for i in 0:a.instrs.len {
        if mfn_ikind(&a.instrs, i) != mfn_ikind(&b.instrs, i) { << false }
        if mfn_ia(&a.instrs, i) != mfn_ia(&b.instrs, i) { << false }
        if mfn_ib(&a.instrs, i) != mfn_ib(&b.instrs, i) { << false }
        if mfn_ic(&a.instrs, i) != mfn_ic(&b.instrs, i) { << false }
        if mfn_id(&a.instrs, i) != mfn_id(&b.instrs, i) { << false }
        if mfn_inext(&a.instrs, i) != mfn_inext(&b.instrs, i) { << false }
    }
    for bi in 0:a.blocks.len {
        if a.blocks[bi].head != b.blocks[bi].head || a.blocks[bi].tail != b.blocks[bi].tail || a.blocks[bi].tkind != b.blocks[bi].tkind || a.blocks[bi].ta != b.blocks[bi].ta || a.blocks[bi].tb != b.blocks[bi].tb || a.blocks[bi].tc != b.blocks[bi].tc { << false }
    }
    << true
}

pub fn dce_test_operands() bool {
    mut f := mir_fn_blank()
    for i in 0:4 { f.temps.push(1)
        f.temps_nslots.push(1) }
    f.margs.push(MArg{v: 0, next: 1})
    f.margs.push(MArg{v: 1, next: 2})
    f.margs.push(MArg{v: 0, next: -1})
    f.instrs.push(mkinstr(0))
    for kind in 0:60 {
        for cval in [-2, -1, 0, 1, 2] {
            mut x := mkinstr(kind)
            x.a = 0
            x.b = 1
            x.c = cval
            x.d = 3
            mfn_set_instr(mut &f.instrs, 0, x)
            mut counts := []int{}
            for i in 0:4 { counts.push(0) }
            mir_dce_instr_uses(&f, 0, mut &counts, 1)
            for ti in 0:4 {
                if (counts[ti] > 0) != f.instr_uses_temp(0, ti) {
                    eprintln("operand mismatch kind=" + str(kind) + " temp=" + str(ti))
                    << false
                }
            }
        }
    }
    << true
}

pub fn dce_test_reference(seed int) bool {
    mut f := mir_fn_blank()
    mut rng := seed + 1
    for i in 0:16 { f.temps.push(1)
        f.temps_nslots.push(1) }
    for i in 0:3 { f.locals.push(1)
        f.locals_nslots.push(1)
        f.locals_owning.push(false) }
    f.consts.push(0)
    for bi in 0:6 {
        f.blocks.push(MBlock{head: -1, tail: -1, tkind: 2, ta: bi, tb: (bi + 1) % 6, tc: (bi + 2) % 6, line: 0})
        for j in 0:12 {
            rng = (rng * 1103515245 + 12345) & 2147483647
            k := 1 + rng % 5
            mut x := mkinstr(k)
            x.a = (rng >> 4) % 16
            x.b = (rng >> 8) % 16
            x.c = (rng >> 12) % 16
            x.d = (rng >> 16) % 16
            if k == 2 { x.b = rng % 3 }
            if k == 3 { x.a = rng % 3 }
            mir_cfg_append(mut &f, bi, x)
        }
    }
    mut m := empty_mir()
    m.fns.push(f)
    m.superseded.push(0)
    mut a := mir_cfg_clone_fn(&m, 0, false)
    mut b := mir_cfg_clone_fn(&m, 0, false)
    ca := mir_dce_reference(mut &a)
    cb := mir_dce_pure(mut &b)
    if ca != cb || !dce_test_same(&a, &b) {
        eprintln("DCE mismatch seed=" + str(seed))
        << false
    }
    << true
}

pub fn borrow_test_word(loc int, reinit bool) int {
    mut f := mir_fn_blank()
    for i in 0:130 { f.locals.push(3)
        f.locals_nslots.push(3)
        f.locals_owning.push(true) }
    f.temps.push(3)
    f.temps_nslots.push(3)
    for bi in 0:2 {
        f.blocks.push(MBlock{head: -1, tail: -1, tkind: 3, ta: -1, tb: -1, tc: -1, line: 0})
    }
    mut entry := f.blocks[0]
    entry.tkind = 1
    entry.ta = 1
    mfn_set_block(mut &f.blocks, 0, entry)
    mut x := mkinstr(8)
    x.a = loc
    mir_cfg_append(mut &f, 0, x)
    if reinit {
        mut st := mkinstr(3)
        st.a = loc
        st.b = 0
        mir_cfg_append(mut &f, 1, st)
    }
    mut ld := mkinstr(2)
    ld.a = 0
    ld.b = loc
    mir_cfg_append(mut &f, 1, ld)
    << mir_borrow_check_fn(&f)
}

// Exercise the extracted must-store solver through real promotion and its
// strict verifier: a straight edge, a diamond Phi and a self-loop Phi.
pub fn ssa_test_cfg(mode int) bool {
    mut f := mir_fn_blank()
    f.label = "_ssa_cost_test"
    f.ret = 1
    f.ret_nslots = 1
    f.locals.push(1)
    f.locals_nslots.push(1)
    f.locals_owning.push(false)
    f.consts.push(10)
    f.consts.push(20)
    mut nb := 2
    mut nt := 1
    if mode == 1 { nb = 4 }
    if mode == 2 { nb = 3
        nt = 3 }
    for i in 0:nt { f.temps.push(1)
        f.temps_nslots.push(1) }
    for bi in 0:nb {
        f.blocks.push(MBlock{head: -1, tail: -1, tkind: 1, ta: bi + 1, tb: -1, tc: -1, line: 0})
    }
    mut retb := f.blocks[nb - 1]
    retb.tkind = 3
    retb.ta = nt - 1
    mfn_set_block(mut &f.blocks, nb - 1, retb)
    if mode == 1 {
        mut entry := f.blocks[0]
        entry.tkind = 2
        entry.ta = -2
        entry.tb = 1
        entry.tc = 2
        mfn_set_block(mut &f.blocks, 0, entry)
        for bi in 1:3 {
            mut branch := f.blocks[bi]
            branch.ta = 3
            mfn_set_block(mut &f.blocks, bi, branch)
            mut st := mkinstr(3)
            st.a = 0
            st.b = 0 - bi - 1
            mir_cfg_append(mut &f, bi, st)
        }
    } else {
        mut st := mkinstr(3)
        st.a = 0
        st.b = -2
        mir_cfg_append(mut &f, 0, st)
    }
    mut ld := mkinstr(2)
    ld.a = nt - 1
    ld.b = 0
    mir_cfg_append(mut &f, nb - 1, ld)
    if mode == 2 {
        mut loop := f.blocks[1]
        loop.tkind = 2
        loop.ta = -2
        loop.tb = 1
        loop.tc = 2
        mfn_set_block(mut &f.blocks, 1, loop)
        mut ld := mkinstr(2)
        ld.a = 0
        ld.b = 0
        mir_cfg_append(mut &f, 1, ld)
        mut add := mkinstr(4)
        add.a = 1
        add.b = 1
        add.c = 0
        add.d = -3
        mir_cfg_append(mut &f, 1, add)
        mut st := mkinstr(3)
        st.a = 0
        st.b = 1
        mir_cfg_append(mut &f, 1, st)
    }
    np := mir_promote_scalar_locals_ssa_f(mut &f)
    if np != 1 || mir_verify_mfn_f(&f, true) != 0 { << false }
    if mode == 0 { << f.phis.len == 0 }
    << f.phis.len == 1 && f.phi_args.len == 2
}
