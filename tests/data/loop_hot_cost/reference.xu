fn loop_hot_reference(m &Mir, fi int) []int {
    // Clone: `m.fns[fi].blocks[bi].tkind` through the live slice misreads
    // on a grown post-inline MFn (inlined search_ints), so the SCC walk
    // saw no back-edges and product_rc_mir_safe rejected the kernel.
    // Keep the clone local: MFn is private to xu.
    mut f := mir_cfg_clone_fn(m, fi, false)
    nblk := f.blocks.len
    mut hot := []int{}
    for _ in 0:nblk { hot.push(0) }
    if nblk < 2 { << hot }
    for latch in 0:nblk {
        mut targets := []int{}
        tk := f.blocks[latch].tkind
        if tk == 1 {
            targets.push(f.blocks[latch].ta)
        } else if tk == 2 {
            targets.push(f.blocks[latch].tb)
            targets.push(f.blocks[latch].tc)
        }
        for ti in 0:targets.len {
            header := targets[ti]
            if header < 0 || header >= latch { -> }
            mut from_header := []int{}
            mut to_latch := []int{}
            for _ in 0:nblk {
                from_header.push(0)
                to_latch.push(0)
            }
            from_header[header] = 1
            to_latch[latch] = 1
            for _ in 0:nblk {
                mut changed := false
                for bi in 0:nblk {
                    if from_header[bi] == 0 { -> }
                    bk := f.blocks[bi].tkind
                    mut x := -1
                    mut y := -1
                    if bk == 1 { x = f.blocks[bi].ta }
                    if bk == 2 {
                        x = f.blocks[bi].tb
                        y = f.blocks[bi].tc
                    }
                    if x >= 0 && x < nblk && from_header[x] == 0 {
                        from_header[x] = 1
                        changed = true
                    }
                    if y >= 0 && y < nblk && from_header[y] == 0 {
                        from_header[y] = 1
                        changed = true
                    }
                }
                for bi in 0:nblk {
                    if to_latch[bi] == 1 { -> }
                    bk := f.blocks[bi].tkind
                    mut reaches := false
                    if bk == 1 {
                        x := f.blocks[bi].ta
                        if x >= 0 && x < nblk && to_latch[x] == 1 { reaches = true }
                    } else if bk == 2 {
                        x := f.blocks[bi].tb
                        y := f.blocks[bi].tc
                        if x >= 0 && x < nblk && to_latch[x] == 1 { reaches = true }
                        if y >= 0 && y < nblk && to_latch[y] == 1 { reaches = true }
                    }
                    if reaches {
                        to_latch[bi] = 1
                        changed = true
                    }
                }
                if !changed { <- }
            }
            mut count := 0
            for bi in 0:nblk {
                if from_header[bi] == 1 && to_latch[bi] == 1 { count += 1 }
            }
            if count > 1 {
                for bi in 0:nblk {
                    if from_header[bi] == 1 && to_latch[bi] == 1 { hot[bi] += 1 }
                }
            }
        }
    }
    << hot
}

// Give every block in a multi-block loop the same four scalar homes.  Uniform
// layouts are the small but important SSA/phi substitute here: values remain
// in registers across branches while cold entries still reload frame state.