@main
#xu/types
fn main() int {
    argv := args()
    if argv.len > 1 && argv[1] == "baseline" {
        println("loop hotspot reference ok")
        << 0
    }
    for seed in 0:1024 {
        if !types.loop_hot_test(seed, seed % 65) { << 1 }
    }
    sizes := [0,1,2,3,8,32,64,128]
    seeds := [0,1,7,11,37,63]
    for n in sizes {
        for seed in seeds {
            if !types.loop_hot_test(seed, n) { << 2 }
        }
    }
    println("loop hotspot reference ok")
    << 0
}
