@xu/types
pub fn loop_hot_test(seed int, n int) bool {
    mut f := mir_fn_blank()
    mut rng := seed + 1
    for bi in 0:n {
        rng = (rng * 1103515245 + 12345) & 2147483647
        tk := rng % 4
        // Include invalid targets, unreachable cycles, duplicate edges,
        // forward-only paths, self-loops and arbitrary irreducible graphs.
        ta := (rng >> 4) % (n + 3) - 1
        tb := (rng >> 9) % (n + 3) - 1
        mut tc := (rng >> 14) % (n + 3) - 1
        if seed % 7 == 0 { tc = tb }
        if seed % 11 == 0 { tc = bi }
        f.blocks.push(MBlock{head: -1, tail: -1, tkind: tk, ta: ta, tb: tb, tc: tc, line: 0})
    }
    mut m := empty_mir()
    m.fns.push(f)
    m.superseded.push(0)
    before := loop_hot_reference(&m, 0)
    after := loop_hot_current(&m, 0)
    if before.len != after.len { << false }
    for i in 0:before.len {
        if before[i] != after[i] {
            eprintln("hot mismatch seed=" + str(seed) + " n=" + str(n) + " block=" + str(i))
            << false
        }
    }
    << true
}
