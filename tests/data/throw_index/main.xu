@main
#xu/types
#xu/parser
#xu/ast
fn main() int {
    argv := args()
    if argv.len > 1 && argv[1] == "baseline" {
        println("throw index reference ok")
        << 0
    }
    mut c := types.Checker{}
    mut p := parser.new_parser([]ast.Token{})
    for mode in 0:8 {
        if !types.throw_index_reference_test(mut &c, mut &p, mode, 0) { << 1 }
        if !types.throw_index_reference_test(mut &c, mut &p, mode, 1) { << 1 }
        if !types.throw_index_reference_test(mut &c, mut &p, mode, 2) { << 1 }
        if !types.throw_index_reference_test(mut &c, mut &p, mode, 17) { << 1 }
        if !types.throw_index_reference_test(mut &c, mut &p, mode, 64) { << 1 }
        if !types.throw_index_reference_test(mut &c, mut &p, mode, 129) { << 1 }
    }
    println("throw index reference ok")
    << 0
}
