@xu/types
#xu/ast
#xu/parser

pub fn throw_index_reference_test(c &mut Checker, p &mut parser.Parser, mode int, count int) bool {
    c.fns = []CFn{}
    c.fndecl = []int{}
    c.fn_safe_name = []string{}
    c.fn_safe_mod = []string{}
    c.fn_may_throw = []int{}
    c.fn_throw_ty = []int{}
    p.nodes = []ast.Node{}
    for i in 0:count {
        mut name := "leaf" + str(i)
        mut mid := "main"
        if mode == 1 { name = "key_" + str(i % 5)
            mid = "mod" + str(i % 3) }
        if mode == 2 { name = "_xu_ab"
            if i % 2 == 1 { name = "_xu_bA" } }
        if mode == 7 { name = "b" + str(i % 3)
            mid = "a"
            if i % 2 == 1 { name = str(i % 3)
                mid = "a" + string_from_byte(31) + "b" } }
        c.fn_safe_name.push(name + "")
        if mode != 6 || i < count / 2 { c.fn_safe_mod.push(mid + "") }
        mut recv := -1
        if mode == 1 && i % 2 == 1 { recv = 1 }
        c.fns.push(CFn{name: name, label: "", mod_id: mid, ret: 0, recv: recv, params: []int{}, recv_mut: false, is_pub: false, is_extern: false, is_template: false, recv_name: "", variadic: false, lt_params: []string{}})
        d := p.nodes.len
        c.fndecl.push(d)
        mut decl := ast.mknode(40, 1, 1)
        decl.c = d + 1
        p.nodes.push(decl)
        mut stmt_kind := 22
        if i == count - 1 && mode != 3 && mode != 5 { stmt_kind = 70 }
        mut stmt := ast.mknode(stmt_kind, 1, 1)
        stmt.a = d + 2
        p.nodes.push(stmt)
        mut call_name := "leaf" + str(i + 1)
        mut expr_kind := 5
        if mode == 1 { call_name = "key_" + str(i % 5)
            expr_kind = 8 }
        if mode == 2 { call_name = "_xu_ab"
            if i % 2 == 1 { call_name = "_xu_bA" } }
        if mode == 3 { call_name = "read_file" }
        if mode == 4 { expr_kind = 71 }
        if mode == 5 { call_name = "unknown" }
        if mode == 7 { call_name = "b" + str(i % 3)
            expr_kind = 8 }
        mut expr := ast.mknode(expr_kind, 1, 1)
        expr.sval = call_name
        p.nodes.push(expr)
    }
    mut index := ThrowCallIndex{first: StrMap{keys: []string{}, vals: []int{}, used: []int{}, n: 0, cap: 0}, heads: StrMap{keys: []string{}, vals: []int{}, used: []int{}, n: 0, cap: 0}, next: []int{}, queries: 0, ready: false}
    zero_strmap(mut &index.first)
    zero_strmap(mut &index.heads)
    build_throw_call_index(&*c, mut &index)
    index.ready = true
    for i in 0:c.fn_safe_mod.len {
        name := c.fn_safe_name[i] + ""
        mid := c.fn_safe_mod[i] + ""
        if c.find_fn_in_mod_safe(name + "", mid + "", mut &index) != c.reference_find_fn_in_mod_safe(name + "", mid + "") { << false }
        qualified := mid + "." + name
        if c.resolve_throw_callee(qualified + "", "other", mut &index) != c.reference_resolve_throw_callee(qualified, "other") { << false }
    }
    c.setup_throw_metadata(&*p)
    mut actual := []int{}
    mut actual_ty := []int{}
    for i in 0:count { actual.push(c.fn_may_throw[i])
        actual_ty.push(c.fn_throw_ty[i]) }
    c.reference_setup_throw_metadata(&*p)
    for i in 0:count {
        if actual[i] != c.fn_may_throw[i] || actual_ty[i] != c.fn_throw_ty[i] { << false }
    }
    << true
}
