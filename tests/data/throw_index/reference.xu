@xu/types

#xu/parser

fn (c &Checker) reference_resolve_throw_callee(name string, caller_mod string) int {
    mut nm := name + ""
    mut mod := caller_mod + ""
    mut dot := -1
    for i in 0:nm.len {
        if nm[i] == 46 {
            dot = i
        }
    }
    if dot >= 0 {
        << c.reference_find_fn_in_mod_safe(nm[dot + 1:nm.len], nm[0:dot])
    }
    << c.reference_find_fn_in_mod_safe(nm + "", mod + "")
}

// Prefer fn_safe_* tables — do not read c.fns[i].name/mod_id.
fn (c &Checker) reference_find_fn_in_mod_safe(name string, mod string) int {
    nm := name + ""
    mid := mod + ""
    mut n := c.fn_safe_name.len
    if c.fn_safe_mod.len < n {
        n = c.fn_safe_mod.len
    }
    for i in 0:n {
        if c.fn_safe_name[i] == nm && c.fn_safe_mod[i] == mid {
            << i
        }
    }
    << -1
}

fn (c &Checker) reference_ast_method_call_propagates_throw(p &parser.Parser, e int, caller_mod string) bool {
    if e < 0 || p.nodes[e].kind != 8 {
        << false
    }
    mname := p.nodes[e].sval + ""
    mod := caller_mod + ""
    mut n := c.fn_safe_name.len
    if c.fn_safe_mod.len < n {
        n = c.fn_safe_mod.len
    }
    // Match by name + module. Do not read c.fns[i].recv: that field is
    // scrambled after CFn push, same class as mod_id. A same-module free
    // function with the same name is rare and still a throwing callee.
    for i in 0:n {
        if c.fn_safe_mod[i] != mod {
            ->
        }
        if c.fn_safe_name[i] != mname {
            ->
        }
        if i < c.fn_may_throw.len && c.fn_may_throw[i] != 0 {
            << true
        }
    }
    << false
}

fn (c &Checker) reference_ast_expr_propagates_throw(p &parser.Parser, e int, caller_mod string) bool {
    if e < 0 {
        << false
    }
    k := p.nodes[e].kind
    if k == 71 {
        << c.reference_ast_stmts_propagate_throw(p, p.nodes[e].c, caller_mod)
    }
    if k == 5 {
        name := p.nodes[e].sval + ""
        fi := c.reference_resolve_throw_callee(name + "", caller_mod + "")
        if fi >= 0 && fi < c.fn_may_throw.len {
            << c.fn_may_throw[fi] != 0
        }
        if name == "parse_int" || name == "read_file" || name == "read_dir" || name == "write_file" || name == "os_stat" || name == "os_mkdir" || name == "os_rename" || name == "os_remove" || name == "os_open" || name == "os_fd_read" || name == "os_fd_write" || name == "os_fd_close" || name == "os_chmod" || name == "os_chdir" || name == "os_symlink" || name == "os_readlink" || name == "os_fd_seek" || name == "os_pipe" || name == "sys_random_fill" || name == "sys_security_store" || name == "sys_interface_data" || name == "sys_socket" || name == "sys_bind4" || name == "sys_connect4" || name == "sys_bind6" || name == "sys_connect6" || name == "sys_bind_unix" || name == "sys_connect_unix" || name == "sys_listen" || name == "sys_accept" || name == "sys_sendto" || name == "sys_recvfrom" || name == "sys_setsockopt_timeo" {
            << true
        }
    }
    if k == 8 {
        obj := p.nodes[e].a
        if obj >= 0 {
            ok := p.nodes[obj].kind
            if ok == 7 || ok == 13 {
                << false
            }
        }
        << c.reference_ast_method_call_propagates_throw(p, e, caller_mod)
    }
    << false
}

fn (c &Checker) reference_ast_stmt_has_throw(p &parser.Parser, s int) bool {
    if s < 0 {
        << false
    }
    k := p.nodes[s].kind
    if k == 70 {
        << true
    }
    if k == 24 {
        mut br := p.nodes[s].a
        while br >= 0 {
            if c.reference_ast_stmts_has_throw(p, p.nodes[br].b) {
                << true
            }
            br = p.nodes[br].next
        }
        if p.nodes[s].b >= 0 && c.reference_ast_stmts_has_throw(p, p.nodes[s].b) {
            << true
        }
        << false
    }
    if k == 27 {
        // A for-in iterable is evaluated before entering the body. An
        // explicit rethrow in that expression makes this function throwing.
        ec := p.nodes[s].a
        if ec >= 0 && p.nodes[ec].kind == 71 {
            if c.reference_ast_stmts_has_throw(p, p.nodes[ec].c) { << true }
        }
        << c.reference_ast_stmts_has_throw(p, p.nodes[s].c)
    }
    if k == 26 || k == 32 {
        << c.reference_ast_stmts_has_throw(p, p.nodes[s].c)
    }
    if k == 28 {
        mut arm := p.nodes[s].b
        while arm >= 0 {
            if c.reference_ast_stmts_has_throw(p, p.nodes[arm].c) {
                << true
            }
            arm = p.nodes[arm].next
        }
        << false
    }
    if k == 60 {
        mut arm := p.nodes[s].a
        while arm >= 0 {
            if c.reference_ast_stmts_has_throw(p, p.nodes[arm].c) {
                << true
            }
            arm = p.nodes[arm].next
        }
        if p.nodes[s].b >= 0 && c.reference_ast_stmts_has_throw(p, p.nodes[s].b) {
            << true
        }
        << false
    }
    if k == 22 {
        ec := p.nodes[s].a
        if ec >= 0 {
            ek := p.nodes[ec].kind
            if ek == 70 {
                << true
            }
            if ek == 71 {
                << c.reference_ast_stmts_has_throw(p, p.nodes[ec].c)
            }
        }
        << false
    }
    // << expr / let x := expr — throw may sit inside `or (err) { >> … }`.
    if k == 23 || k == 20 {
        ec := p.nodes[s].a
        if ec >= 0 {
            ek := p.nodes[ec].kind
            if ek == 70 {
                << true
            }
            if ek == 71 {
                << c.reference_ast_stmts_has_throw(p, p.nodes[ec].c)
            }
        }
        << false
    }
    << false
}

fn (c &Checker) reference_ast_stmts_has_throw(p &parser.Parser, head int) bool {
    mut s := head
    while s >= 0 {
        if c.reference_ast_stmt_has_throw(p, s) {
            << true
        }
        s = p.nodes[s].next
    }
    << false
}

fn (c &Checker) reference_ast_stmt_propagates_throw(p &parser.Parser, s int, caller_mod string) bool {
    if s < 0 {
        << false
    }
    k := p.nodes[s].kind
    if k == 22 {
        << c.reference_ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod)
    }
    if k == 20 {
        << c.reference_ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod)
    }
    if k == 23 && p.nodes[s].a >= 0 {
        << c.reference_ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod)
    }
    if k == 24 {
        mut br := p.nodes[s].a
        while br >= 0 {
            if c.reference_ast_stmts_propagate_throw(p, p.nodes[br].b, caller_mod) {
                << true
            }
            br = p.nodes[br].next
        }
        if p.nodes[s].b >= 0 && c.reference_ast_stmts_propagate_throw(p, p.nodes[s].b, caller_mod) {
            << true
        }
        << false
    }
    if k == 27 {
        // Include the once-evaluated iterable in the throw fixed point.
        // reference_ast_expr_propagates_throw preserves handled-or semantics.
        if c.reference_ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod) {
            << true
        }
        << c.reference_ast_stmts_propagate_throw(p, p.nodes[s].c, caller_mod)
    }
    if k == 26 || k == 32 {
        << c.reference_ast_stmts_propagate_throw(p, p.nodes[s].c, caller_mod)
    }
    if k == 28 {
        if c.reference_ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod) { << true }
        mut arm := p.nodes[s].b
        while arm >= 0 {
            if c.reference_ast_stmts_propagate_throw(p, p.nodes[arm].c, caller_mod) {
                << true
            }
            arm = p.nodes[arm].next
        }
        << false
    }
    if k == 22 {
        << c.reference_ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod)
    }
    << false
}

fn (c &Checker) reference_ast_stmts_propagate_throw(p &parser.Parser, head int, caller_mod string) bool {
    mut s := head
    while s >= 0 {
        if c.reference_ast_stmt_propagates_throw(p, s, caller_mod) {
            << true
        }
        s = p.nodes[s].next
    }
    << false
}

fn (c &mut Checker) reference_setup_throw_metadata(p &parser.Parser) {
    n := c.fns.len
    // Grow in place — do not `= []int{}` (drop of a corrupt boot descriptor OOMs).
    while c.fn_may_throw.len < n {
        c.fn_may_throw.push(0)
    }
    while c.fn_throw_ty.len < n {
        c.fn_throw_ty.push(0)
    }
    for i in 0:n {
        checker_set_i(mut &c.fn_may_throw, i, 0)
        checker_set_i(mut &c.fn_throw_ty, i, 0)
    }
    for i in 0:n {
        d := c.fndecl[i]
        if c.reference_ast_stmts_has_throw(p, p.nodes[d].c) {
            checker_set_i(mut &c.fn_may_throw, i, 1)
        }
    }
    mut changed := true
    while changed {
        changed = false
        for i in 0:n {
            if c.fn_may_throw[i] != 0 {
                ->
            }
            d := c.fndecl[i]
            // Use fn_safe_mod — never c.fns[i].mod_id (scrambled after CFn push).
            mut mod := ""
            if i < c.fn_safe_mod.len {
                mod = c.fn_safe_mod[i] + ""
            }
            if c.reference_ast_stmts_propagate_throw(p, p.nodes[d].c, mod + "") {
                checker_set_i(mut &c.fn_may_throw, i, 1)
                changed = true
            }
        }
    }
    // Resolve errors.Error only when some non-main fn actually throws.
    // find_iface_global → map_key/strmap on WoA x64 OOMs for hello (no throw).
    mut need_err := false
    for i in 0:n {
        mut nm0 := ""
        if i < c.fn_safe_name.len {
            nm0 = c.fn_safe_name[i] + ""
        }
        if c.fn_may_throw[i] != 0 && c.fns[i].ret != 0 && nm0 != "main" {
            need_err = true
        }
    }
    if need_err {
        c.errors_iface = c.find_iface_global("Error", "errors")
    } else {
        c.errors_iface = -1
    }
    err_ty := iface_ty(c.errors_iface)
    for i in 0:n {
        mut nm := ""
        if i < c.fn_safe_name.len {
            nm = c.fn_safe_name[i] + ""
        }
        if c.fn_may_throw[i] != 0 && c.fns[i].ret != 0 && nm != "main" {
            si1003 := c.intern_throw_type(c.fns[i].ret, err_ty)
            checker_set_i(mut &c.fn_throw_ty, i, si1003)
        }
    }
}
