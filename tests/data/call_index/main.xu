@main
#xu/types
fn main() int {
    argv := args()
    if argv.len > 1 && argv[1] == "baseline" {
        println("call signature index reference ok")
        << 0
    }
    for mode in 0:28 {
        if !types.call_index_test(mode, 4) { << 1 }
    }
    for seed in 0:256 {
        if !types.call_index_test(seed % 13, 2 + seed % 31) { << 2 }
    }
    if !types.call_index_corrupt_chain() { << 3 }
    println("call signature index reference ok")
    << 0
}
