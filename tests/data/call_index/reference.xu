fn call_index_reference_direct_call(m &Mir, fi int, ii int, head int) bool {
    lab_len := mir_isval_len(m, fi, ii)
    if lab_len <= 0 || lab_len > mir_verify_max_arg_chain { << false }
    lab := mir_isval(m, fi, ii)
    mut matched := false
    mut arity_ok := false
    nf := m.fns.len
    for j in 0:nf {
        if mir_fn_is_extern(m, j) { -> }
        if mir_fn_label_len(m, j) != lab_len { -> }
        if mir_fn_label(m, j) != lab { -> }
        matched = true
        np := mir_fn_nparams(m, j)
        if np < 0 || np > mir_verify_max_arg_chain { << false }
        if mir_verify_emission_arg_count(m, fi, head, np, np) { arity_ok = true }
    }
    // Runtime/native symbols are intentionally absent from m.fns.  A known
    // Xu function, in contrast, must have an exact ABI argument count.
    << !matched || arity_ok
}

// Validate the scalar shape consumed by the legacy emitter without borrowing
// a pointer into `m.fns[fi]`.  The latter is a known Gen1 large-struct hazard
// (a pointer to an MFn/MInstr slice can be mis-lowered), so this helper uses
// only the tiny MIR accessors above.  `vreg_mir_shape_ok` proves list ownership
// and slot-vector widths; this pass adds the per-kind checks that protect
// `fr.temp_slot[...]`, `fr.local_slot[...]`, const-pool decodes and raw layout
// arithmetic immediately before Frame.layout/emission.

fn call_index_reference_calls(m &Mir, fi int) bool {
    if fi < 0 || fi >= m.fns.len { << false }
    nins := mir_nins(m, fi)
    nblk := mir_nblocks(m, fi)
    nf := m.fns.len
    if nins < 0 || nins > mir_verify_max_items || nblk <= 0 || nblk > mir_verify_max_blocks || nf < 0 || nf > mir_verify_max_items {
        << false
    }
    if m.fns[fi].temps_nslots.len != mir_ntemps(m, fi) || m.fns[fi].locals_nslots.len != mir_nlocals(m, fi) {
        << false
    }
    // Emission consumes the post-Phi linked stream.  A leftover persistent
    // Phi/argument pool is therefore never safe to hand to Frame.layout (the
    // emitter has no Phi materialization path); reject it here while the
    // commit seam remains responsible for detailed Phi validation.
    if m.fns[fi].phis.len != 0 || m.fns[fi].phi_args.len != 0 {
        << false
    }

    // Validate the terminator metadata even for an empty/tombstoned block:
    // emit_function_emit_blocks emits a terminator for every block, so an
    // unchecked edge/value would still become an out-of-range read.  Only an
    // empty block's stale tail is tolerated (the linked walker keys off head).
    for bi in 0:nblk {
        head := mir_bhead(m, fi, bi)
        tail := mir_btail(m, fi, bi)
        if head < -1 || head >= nins || tail < -1 || tail >= nins {
            << false
        }
        if head >= 0 && tail < 0 {
            << false
        }
        tk := mir_btkind(m, fi, bi)
        if tk < 0 || tk > 3 {
            << false
        }
        if tk == 0 {
            if head >= 0 || mir_bta(m, fi, bi) != -1 || mir_btb(m, fi, bi) != -1 || mir_btc(m, fi, bi) != -1 {
                << false
            }
        } else if tk == 1 {
            to := mir_bta(m, fi, bi)
            // Only `ta` is consumed by Jump; legacy CFG rewrites may leave
            // the non-applicable tb/tc words stale on tombstones.
            if to < 0 || to >= nblk {
                << false
            }
        } else if tk == 2 {
            cond := mir_bta(m, fi, bi)
            tb := mir_btb(m, fi, bi)
            tc := mir_btc(m, fi, bi)
            if !mir_verify_emission_value(m, fi, cond) || tb < 0 || tb >= nblk || tc < 0 || tc >= nblk {
                << false
            }
        } else {
            result := mir_bta(m, fi, bi)
            if result != -1 && !mir_verify_emission_value(m, fi, result) {
                << false
            }
        }
    }

    // First count calls and bound the potentially quadratic label lookup.  A
    // zero-function unit cannot have a valid direct target, but does not make
    // the division below reachable.  The same walk validates every linked
    // instruction's scalar operands before any emitter indexes a frame slot.
    // Track ownership while walking the chains. The emitter emits each
    // linked instruction at most once; without this bitmap, malformed MIR
    // could point two blocks at the same node and execute a call/drop twice
    // (or make one node's `next` chain cross into another block). The vector
    // is bounded by the item cap above and is discarded before emission.
    mut owner := []int{}
    for _ in 0:nins { owner.push(-1) }
    mut ncalls := 0
    // Only direct user calls perform the O(nf) label/signature scan below.
    // Counting fixed builtins and indirect calls in this quotient admission
    // used to reject valid large functions (for example, 4097 builtin calls
    // in a unit with 4096 function records) even though they do not touch the
    // function table. Keep the absolute call cap for all calls, but charge
    // the quadratic budget only to kind=1.
    mut direct_calls := 0
    mut walked := 0
    for bi in 0:nblk {
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:nins + 1 {
            if ii < 0 { <- }
            if ii >= nins { << false }
            if owner[ii] >= 0 { << false }
            owner[ii] = bi
            if walked >= mir_verify_max_use_work {
                << false
            }
            walked += 1
            if !mir_verify_emission_instr_shape(m, fi, ii) {
                << false
            }
            if mir_ikind(m, fi, ii) == 7 {
                ncalls += 1
                if ncalls > mir_verify_max_call_work { << false }
                if mir_ib(m, fi, ii) == 1 {
                    direct_calls += 1
                    if direct_calls > mir_verify_max_call_work { << false }
                }
            }
            nxt := mir_inext(m, fi, ii)
            if nxt < -1 || nxt >= nins {
                << false
            }
            ii = nxt
        }
        if ii >= 0 { << false }
    }
    // `nf` is bounded above and the product is below signed-int range, so use
    // a checked-domain multiplication instead of a quotient with a variable
    // denominator.  This keeps the same admission condition while making the
    // non-zero proof explicit to both Gen1 and the Rust oracle.
    if direct_calls > 0 && nf > 0 && direct_calls * nf > mir_verify_max_call_work {
        << false
    }

    for bi in 0:nblk {
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:nins + 1 {
            if ii < 0 { <- }
            if ii >= nins { << false }
            if mir_ikind(m, fi, ii) != 7 {
                nxt0 := mir_inext(m, fi, ii)
                if nxt0 < -1 || nxt0 >= nins {
                    << false
                }
                ii = nxt0
                ->
            }
            kind := mir_ib(m, fi, ii)
            if !mir_verify_call_kind(kind) {
                << false
            }
            head := mir_ic(m, fi, ii)
            arity := mir_verify_emission_call_kind_arity(kind)
            if arity == -4 {
                << false
            }
            if arity == -1 {
                if !mir_verify_emission_arg_count(m, fi, head, 0, mir_verify_max_arg_chain) {
                    << false
                }
                if !call_index_reference_direct_call(m, fi, ii, head) {
                    << false
                }
            } else if arity == -2 {
                if !mir_verify_emission_arg_count(m, fi, head, 1, 2) {
                    << false
                }
            } else if arity == -5 {
                if !mir_verify_emission_arg_count(m, fi, head, 1, 1) && !mir_verify_emission_arg_count(m, fi, head, 3, 3) {
                    << false
                }
            } else if arity == -3 {
                // One fat-pointer value plus at most four user arguments;
                // A0 is reserved for the closure environment.
                if !mir_verify_emission_arg_count(m, fi, head, 1, 5) {
                    << false
                }
            } else {
                if !mir_verify_emission_arg_count(m, fi, head, arity, arity) {
                    << false
                }
            }
            nxt := mir_inext(m, fi, ii)
            if nxt < -1 || nxt >= nins {
                << false
            }
            ii = nxt
        }
        if ii >= 0 { << false }
    }
    << true
}

// Validate the numeric fields whose meaning depends on an instruction kind.
// Keep this local to MFn so it can run in both the cheap commit gate and the
// full verifier without widening the MFn ABI or copying large records.
