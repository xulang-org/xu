@xu/types

fn call_index_fixture(mode int, count int) Mir {
    mut m := empty_mir()
    mut f := mir_fn_blank()
    f.label = "_caller"
    f.consts.push(0)
    f.temps.push(1)
    if mode != 20 { f.temps_nslots.push(1) }
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 3, ta: -1, tb: -1, tc: -1, line: 0})
    mut nargs := 1
    if mode == 1 || mode == 4 { nargs = 0 }
    if mode == 3 || mode == 26 || mode == 27 { nargs = 2 }
    mut head := -1
    for j in 0:nargs {
        mut nx := j + 1
        if j == nargs - 1 { nx = -1 }
        if mode == 14 { nx = 0 }
        if mode == 15 { nx = 999 }
        mut value := 0
        if mode == 16 { value = 999 }
        f.margs.push(MArg{v: value, next: nx})
    }
    if nargs > 0 { head = 0 }
    if mode == 17 { head = -2 }
    mut nc := 1
    if mode == 21 || mode == 22 { nc = 4097 }
    for _ in 0:nc {
        mut call := mkinstr(7)
        call.a = -1
        call.b = 1
        call.c = head
        call.sval = "_xu_ab"
        if mode == 27 { call.sval = "_xu_bA" }
        if mode == 11 { call.sval = "_native_absent" }
        if mode == 12 { call.sval = "_rt_guard" }
        if mode == 13 { call.sval = "" }
        if mode == 21 || mode == 22 { call.sval = "_unknown"
            call.c = -1 }
        if mode == 22 { call.b = 14 }
        if mode == 24 { call.sval = "_oversized"
            for _ in 0:4096 { call.sval = call.sval + "x" } }
        mir_cfg_append(mut &f, 0, call)
    }
    if mode == 18 {
        mut block := f.blocks[0]
        block.tail = 999
        mfn_set_block(mut &f.blocks, 0, block)
    }
    if mode == 19 {
        mut block := f.blocks[0]
        block.ta = 999
        mfn_set_block(mut &f.blocks, 0, block)
    }
    m.fns.push(f)
    m.superseded.push(0)
    mut nf := count
    if mode == 21 || mode == 22 { nf = 4095 }
    if mode == 23 { nf = mir_call_index_fn_cap }
    mut long_label := ""
    if mode == 25 {
        nf = 4098
        for _ in 0:4096 { long_label = long_label + "x" }
    }
    for j in 0:nf {
        mut callee := mir_fn_blank()
        if mode == 25 {
            callee.label = long_label
            if j == nf - 1 { callee.label = "_xu_ab"
                callee.nparams = 2 }
        } else if mode == 23 {
            // Blank labels cost no hashing and force the real capacity
            // fallback. The final matching target still rejects wrong arity.
            if j == nf - 1 { callee.label = "_xu_ab"
                callee.nparams = 2 }
        } else {
            callee.label = "_irrelevant_" + str(j)
            if j == 0 { callee.label = "_xu_ab"
                callee.nparams = 1 }
            if j == 1 { callee.label = "_xu_bA"
                callee.nparams = 2 }
            if mode == 2 && j == 1 { callee.label = "_xu_ab"
                callee.nparams = 0 }
            if mode == 3 && j == 1 { callee.label = "_xu_ab" }
            if mode == 5 && j == 1 { callee.label = "_xu_ab"
                callee.nparams = -1 }
            if mode == 6 && j == 1 { callee.label = "_xu_ab"
                callee.nparams = 4097 }
            if (mode == 7 || mode == 8) && j == 0 { callee.is_extern = true }
            if (mode == 9 || mode == 10) && j == 0 { callee.nparams = -1 }
            if mode == 12 && j == 0 { callee.label = "_rt_guard" }
        }
        m.fns.push(callee)
        mut skip := 0
        if mode == 9 && j == 0 { skip = 1 }
        m.superseded.push(skip)
    }
    << m
}

pub fn call_index_test(mode int, count int) bool {
    m := call_index_fixture(mode, count)
    before := call_index_reference_calls(&m, 0)
    mut idx := new_mir_call_index(&m)
    after := mir_verify_emission_calls_indexed(&m, 0, &idx)
    if before != after {
        eprintln("call index mismatch mode=" + str(mode) + " count=" + str(count))
        << false
    }
    mut expected := mode == 0 || mode == 2 || mode == 3 || mode == 7 || mode == 8 || mode == 9 || mode == 11 || mode == 12 || mode == 22 || mode == 27
    if mode == 1 || mode == 4 { expected = false }
    if before != expected {
        eprintln("call reference unexpected mode=" + str(mode))
        << false
    }
    // An unavailable/foreign-capacity cache must retain exact old validation.
    idx.nf = -1
    if mir_verify_emission_calls_indexed(&m, 0, &idx) != before { << false }
    if (mode == 23 || mode == 25) && idx.buckets.len != 0 { << false }
    << true
}

pub fn call_index_corrupt_chain() bool {
    m := call_index_fixture(0, 4)
    mut idx := new_mir_call_index(&m)
    h := mir_call_index_instr_hash(&m, 0, 0, mir_isval_len(&m, 0, 0))
    at := idx.buckets[h & (idx.buckets.len - 1)]
    if at < 0 { << false }
    idx.next[at] = at
    if mir_verify_emission_calls_indexed(&m, 0, &idx) { << false }
    idx.next[at] = -2
    if mir_verify_emission_calls_indexed(&m, 0, &idx) { << false }
    idx.next[at] = m.fns.len
    << !mir_verify_emission_calls_indexed(&m, 0, &idx)
}
