@xu/types

fn strmap_test_key(i int, mode int) string {
    if i == 0 { << "" }
    if i == 1 { << "_xu_ab" }
    if i == 2 { << "_xu_bA" }
    if i == 3 { << "中文🙂" }
    if i == 4 { << string_from_bytes([97, 0, 98]) }
    if mode == 1 { << "_xu_compile_shared_" + str(i / 64) + "_bb" + str(i % 64) + "_ht" }
    if mode == 2 { << "long_common_prefix_long_common_prefix_" + str(i % 29) }
    << "key_" + str(i)
}

pub fn strmap_reference_test(mode int, cap int, count int) bool {
    mut m := strmap_with_cap(cap)
    mut r := reference_strmap_with_cap(cap)
    if mode == 3 { zero_strmap(mut &m)
        reference_zero_strmap(mut &r) }
    // Bad descriptors must preserve lookup rejection and put's reset policy.
    if mode == 4 { m.cap = -1
        r.cap = -1 }
    if mode == 5 { m.cap = 1048577
        r.cap = 1048577 }
    if mode == 6 { m.n = -1
        r.n = -1 }
    if mode == 7 { m.n = m.cap + 1
        r.n = r.cap + 1 }
    if mode == 8 { m.cap = m.cap + 1
        r.cap = r.cap + 1 }
    q := "absent"
    if m.lookup(&q) != r.lookup(&q) { << false }
    for i in 0:count {
        key := strmap_test_key(i, mode)
        value := i * 17 - 3
        strmap_put(mut &m, key + "", value)
        r.put(key, value)
        if m.n != r.n || m.cap != r.cap { << false }
    }
    for i in 0:count {
        key := strmap_test_key(i, mode)
        if strmap_get(&m, &key) != r.lookup(&key) { << false }
        h := strmap_hash(&key)
        slot := m.find_ref(h, &key)
        if slot < 0 || m.keys[slot] != key { << false }
    }
    // Update is deliberately performed before lookup; growth at 75% is
    // still allowed for an existing key by the original put contract.
    for i in 0:count {
        key := strmap_test_key(i, mode)
        m.put(key + "", -i - 100)
        r.put(key, -i - 100)
    }
    if m.n != r.n || m.cap != r.cap { << false }
    for i in 0:count {
        key := strmap_test_key(i, mode)
        if m.lookup(&key) != r.lookup(&key) { << false }
    }
    if m.lookup(&q) != r.lookup(&q) { << false }
    << true
}

pub fn strmap_full_table_test() bool {
    mut m := strmap_with_cap(16)
    mut r := reference_strmap_with_cap(16)
    // Hand-built, physically full table: bounded miss, reserved used flags,
    // then put growth. Keep the same bytes in both tables; no bucket choice
    // is involved until grow rehashes the live entry.
    for i in 0:16 { m.used[i] = 2
        r.used[i] = 2 }
    m.n = 16
    r.n = 16
    q := "missing"
    if m.lookup(&q) != -1 || r.lookup(&q) != -1 { << false }
    if m.find_insert(strmap_hash(&q), q + "") != -1 { << false }
    if r.find_insert(reference_strmap_hash(&q), q + "") != -1 { << false }
    m.put(q + "", 77)
    r.put(q + "", 77)
    if m.n != r.n || m.cap != r.cap { << false }
    << m.lookup(&q) == 77 && r.lookup(&q) == 77
}

pub fn strmap_lookup_churn(count int) bool {
    mut m := new_strmap()
    for i in 0:256 { m.put("shared_prefix_" + str(i), i) }
    mut hit := "_xu_ab"
    mut collision := "_xu_bA"
    mut miss := "absent_key"
    mut empty := ""
    m.put(hit + "", 11)
    m.put(collision + "", 22)
    m.put(empty + "", 33)
    for _ in 0:count {
        if strmap_get(&m, &hit) != 11 { << false }
        if strmap_get(&m, &collision) != 22 { << false }
        if strmap_get(&m, &miss) != -1 { << false }
        if strmap_get(&m, &empty) != 33 { << false }
    }
    << true
}
