@main
#xu/types

fn main() int {
    argv := args()
    if argv.len > 1 && argv[1] == "baseline" {
        println("strmap reference ok")
        << 0
    }
    if argv.len > 1 && argv[1][0] == 108 {
        mut count := 0
        if argv[1][6] == 78 { count = 4096 }
        if !types.strmap_lookup_churn(count) { << 3 }
        println("strmap reference ok")
        << 0
    }
    for mode in 0:9 {
        if !types.strmap_reference_test(mode, 16, 300) { << 1 }
        if !types.strmap_reference_test(mode, 17, 65) { << 1 }
        if !types.strmap_reference_test(mode, 31, 99) { << 1 }
    }
    for seed in 0:128 {
        if !types.strmap_reference_test(seed % 3, 16 + seed % 49, 1 + seed % 179) { << 1 }
    }
    if !types.strmap_reference_test(1, 16, 2048) { << 1 }
    if !types.strmap_full_table_test() { << 2 }
    println("strmap reference ok")
    << 0
}
