@xu/types
// M189: open-addressing string → int map (compiler-internal; not a language map type).

pub struct ReferenceStrMap {
    pub keys []string
    pub vals []int
    pub used []int
    pub n int
    pub cap int
}

fn reference_empty_strmap() ReferenceStrMap {
    << ReferenceStrMap{keys: []string{}, vals: []int{}, used: []int{}, n: 0, cap: 0}
}

// Zero in place — avoids relying on reference_empty_strmap() sret into Checker fields
// (WoA x64 can leave garbage cap/n on untouched maps like fn_map).
fn reference_zero_strmap(m &mut ReferenceStrMap) {
    m.keys = []string{}
    m.vals = []int{}
    m.used = []int{}
    m.n = 0
    m.cap = 0
}

fn reference_strmap_sane(m &ReferenceStrMap) bool {
    // cap==0: lazy empty shell (OK but not a live table).
    if m.cap <= 0 {
        << false
    }
    // Corrupt descriptors look like huge positive caps after bad sret.
    if m.cap > 1048576 {
        << false
    }
    if m.n < 0 || m.n > m.cap {
        << false
    }
    if m.keys.len < m.cap || m.vals.len < m.cap || m.used.len < m.cap {
        << false
    }
    << true
}

pub fn reference_new_strmap() ReferenceStrMap {
    << reference_strmap_with_cap(16)
}

fn reference_strmap_with_cap(cap int) ReferenceStrMap {
    mut ncap := cap
    if ncap < 16 {
        ncap = 16
    }
    mut m := ReferenceStrMap{keys: []string{}, vals: []int{}, used: []int{}, n: 0, cap: ncap}
    for i in 0:ncap {
        m.keys.push("")
        m.vals.push(0)
        m.used.push(0)
    }
    << m
}

fn reference_strmap_hash(s &string) int {
    mut h := 5381
    for i in 0:s.len {
        h = ((h << 5) + h) + (s[i] & 255)
        h = h & 2147483647
    }
    << h
}

fn (m &mut ReferenceStrMap) init_empty(ncap int) {
    m.keys = []string{}
    m.vals = []int{}
    m.used = []int{}
    m.n = 0
    m.cap = ncap
    for i in 0:ncap {
        m.keys.push("")
        m.vals.push(0)
        m.used.push(0)
    }
}

// Free-fn form: field receivers like `c.fn_map.get` cannot take &ReferenceStrMap
// (Xu requires a variable). Prefer reference_strmap_get(&c.fn_map, &k).
fn reference_strmap_find_ref(m &ReferenceStrMap, h int, k &string) int {
    if m.cap <= 0 {
        << -1
    }
    ks := k + ""
    mut i := h % m.cap
    start := i
    while true {
        if m.used[i] == 0 {
            << -1
        }
        if m.used[i] == 1 && m.keys[i] == ks {
            << i
        }
        i = (i + 1) % m.cap
        if i == start {
            << -1
        }
    }
    << -1
}

fn reference_strmap_get(m &ReferenceStrMap, k &string) int {
    if m.n <= 0 || !reference_strmap_sane(m) {
        << -1
    }
    h := reference_strmap_hash(k)
    slot := reference_strmap_find_ref(m, h, k)
    if slot < 0 {
        << -1
    }
    << m.vals[slot]
}

// Free-function form for mutable fields. Xu can pass `mut &c.fn_map` to a
// function, while a mutating method receiver requires a local variable.
// Keeping this adapter here avoids one identical wrapper per Checker map.
fn reference_strmap_put(m &mut ReferenceStrMap, k string, v int) {
    m.put(k, v)
}

// Local-variable receivers (e.g. loaded_map) may use methods.
fn (m &ReferenceStrMap) find_ref(h int, k &string) int {
    << reference_strmap_find_ref(m, h, k)
}

fn (m &ReferenceStrMap) get(k &string) int {
    << reference_strmap_get(m, k)
}

pub fn (m &ReferenceStrMap) lookup(k &string) int {
    << reference_strmap_get(m, k)
}

fn (m &mut ReferenceStrMap) find_insert(h int, k string) int {
    if m.cap <= 0 {
        << -1
    }
    mut i := h % m.cap
    start := i
    mut first_empty := -1
    while true {
        if m.used[i] == 0 {
            if first_empty < 0 {
                first_empty = i
            }
            << first_empty
        }
        if m.used[i] == 1 && m.keys[i] == k {
            << i
        }
        i = (i + 1) % m.cap
        if i == start {
            if first_empty >= 0 {
                << first_empty
            }
            << -1
        }
    }
    << -1
}

fn (m &mut ReferenceStrMap) insert_at(slot int, k string, v int) {
    if m.used[slot] == 1 {
        m.vals[slot] = v
        <<
    }
    m.keys[slot] = k
    m.vals[slot] = v
    m.used[slot] = 1
    m.n += 1
}

fn (m &mut ReferenceStrMap) grow() {
    old_cap := m.cap
    if old_cap <= 0 {
        m.init_empty(16)
        <<
    }
    ncap := old_cap * 2
    if ncap <= 0 {
        <<
    }
    mut new_keys := []string{}
    mut new_vals := []int{}
    mut new_used := []int{}
    for i in 0:ncap {
        new_keys.push("")
        new_vals.push(0)
        new_used.push(0)
    }
    mut new_n := 0
    for i in 0:old_cap {
        if m.used[i] == 1 {
            key := m.keys[i] + ""
            h := reference_strmap_hash(&key)
            mut j := h % ncap
            start := j
            while true {
                if new_used[j] == 0 {
                    new_keys[j] = key
                    new_vals[j] = m.vals[i]
                    new_used[j] = 1
                    new_n += 1
                    <-
                }
                j = (j + 1) % ncap
                if j == start {
                    <-
                }
            }
        }
    }
    m.keys = new_keys
    m.vals = new_vals
    m.used = new_used
    m.cap = ncap
    m.n = new_n
}

pub fn (m &mut ReferenceStrMap) put(k string, v int) {
    key := k + ""
    mut bad := m.cap <= 0
    if !bad {
        if m.cap > 1048576 {
            bad = true
        }
        if m.n < 0 || m.n > m.cap {
            bad = true
        }
        if m.keys.len < m.cap || m.vals.len < m.cap || m.used.len < m.cap {
            bad = true
        }
    }
    if bad {
        // Never inited, or sret left garbage — start clean.
        m.init_empty(16)
    }
    if m.n * 4 >= m.cap * 3 {
        m.grow()
    }
    mut h := reference_strmap_hash(&key)
    mut slot := m.find_insert(h, key + "")
    if slot < 0 {
        m.grow()
        h = reference_strmap_hash(&key)
        slot = m.find_insert(h, key + "")
    }
    if slot < 0 {
        <<
    }
    if m.used[slot] == 1 {
        m.vals[slot] = v
        <<
    }
    m.insert_at(slot, key, v)
}
