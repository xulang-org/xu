@main

#testing
#fmt

fn cleaned_b() {
    println("b")
}

fn cleaned_a() {
    println("a")
}

fn test_cleanup() {
    mut t := testing.t()
    t.cleanup(cleaned_a)
    t.cleanup(cleaned_b)
    t.run_cleanup()
}

fn test_logf() {
    mut t := testing.t()
    t.logf("n=%d", fmt.i(7))
    assert(true)
}
