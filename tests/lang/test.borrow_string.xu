@main

fn len_of(s &string) int {
    << s.len
}

fn cat(a &string, b &string) string {
    << a + b
}

fn echo(s &string) &string {
    << s
}

fn append_bang(s &mut string) {
    s.push_str("!")
}

fn test_borrow_len() {
    s := "hello"
    r := &s
    assert(r.len == 5)
    assert(len_of(&s) == 5)
    assert(s.len == 5)
    assert(s == "hello")
}

fn test_borrow_index() {
    s := "abc"
    r := &s
    assert(r[0] == 97)
    assert(r[1] == 98)
    assert(r[2] == 99)
    assert(s[0] == 97)
}

fn test_borrow_concat() {
    a := "left"
    b := "right"
    assert((&a + "right") == "leftright")
    assert(("left" + &b) == "leftright")
    assert((&a + &b) == "leftright")
    assert(cat(&a, &b) == "leftright")
    assert(a == "left")
    assert(b == "right")
}

fn test_borrow_materialize() {
    s := "abcdef"
    owned := &s + ""
    assert(owned == "abcdef")
    assert(owned[1:3] == "bc")
    assert(s == "abcdef")
}

fn test_borrow_shared_multi() {
    s := "xyz"
    r1 := &s
    r2 := &s
    assert(r1.len == 3)
    assert(r2.len == 3)
    assert(len_of(r1) == 3)
    assert(s == "xyz")
}

fn test_borrow_return() {
    s := "hello"
    r := echo(&s)
    assert(r.len == 5)
    assert((r + "") == "hello")
    assert(s == "hello")
}

fn test_borrow_str() {
    s := "hi"
    assert(str(&s) == "hi")
    assert(s == "hi")
}

fn test_borrow_mut() {
    mut s := "hi"
    append_bang(mut &s)
    assert(s == "hi!")
}

fn test_borrow_then_own() {
    mut s := "ab"
    n := len_of(&s)
    assert(n == 2)
    s = s + "c"
    assert(s == "abc")
}
