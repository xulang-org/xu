@xu/types

// Test-only constructors. The production promotion, strict SSA verifier,
// simplifier and Phi destruction run unchanged in an isolated source tree.
fn ssa_test_temp(f &mut MFn, ty int) int {
    t := f.temps.len
    f.temps.push(ty)
    f.temps_nslots.push(1)
    << t
}
fn ssa_test_copy(f &mut MFn, bi int, d int, s int) {
    mut cp := mkinstr(1)
    cp.a = d
    cp.b = s
    mir_cfg_append(f, bi, cp)
}
fn ssa_test_block(f &mut MFn, k int, a int, b int, c int) {
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: k, ta: a, tb: b, tc: c, line: 0})
}
fn ssa_test_live_copies(f &MFn) int {
    mut n := 0
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            if mfn_ikind(&f.instrs, ii) == 1 { n += 1 }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    << n
}

pub fn ssa_test_diamond(distinct bool) bool {
    mut f := mir_fn_blank()
    f.nparams = 1
    f.ret = 1
    f.ret_nslots = 1
    f.locals.push(2)
    f.locals_nslots.push(1)
    f.locals_owning.push(false)
    f.locals.push(1)
    f.locals_nslots.push(1)
    f.locals_owning.push(false)
    cond := ssa_test_temp(mut &f, 2)
    d := ssa_test_temp(mut &f, 1)
    f.consts.push(37)
    if distinct { f.consts.push(41) } else { f.consts.push(37) }
    ssa_test_block(mut &f, 2, cond, 1, 2)
    ssa_test_block(mut &f, 1, 3, -1, -1)
    ssa_test_block(mut &f, 1, 3, -1, -1)
    ssa_test_block(mut &f, 3, d, -1, -1)
    mut load := mkinstr(2)
    load.a = cond
    load.b = 0
    mir_cfg_append(mut &f, 0, load)
    for arm in 1:3 {
        mut store := mkinstr(3)
        store.a = 1
        store.b = -1 - arm
        mir_cfg_append(mut &f, arm, store)
    }
    mut result := mkinstr(2)
    result.a = d
    result.b = 1
    mir_cfg_append(mut &f, 3, result)
    promoted := mir_promote_scalar_locals_ssa_f(mut &f)
    if promoted != 1 || f.phis.len != 1 { << false }
    simplified := mir_ssa_simplify_f(mut &f)
    if simplified < 0 || mir_verify_mfn_f(&f, true) != 0 { << false }
    if distinct {
        if f.phis.len != 1 { << false }
    } else {
        if f.phis.len != 0 || f.blocks[3].ta > -2 || f.val_const(f.blocks[3].ta) != 37 { << false }
        if ssa_test_live_copies(&f) != 0 { << false }
    }
    if !mir_phi_elim_f(mut &f) { << false }
    << mir_verify_mfn_f(&f, false) == 0
}

pub fn ssa_test_loop(changing bool) bool {
    mut f := mir_fn_blank()
    f.nparams = 1
    f.ret = 1
    f.ret_nslots = 1
    f.locals.push(2)
    f.locals_nslots.push(1)
    f.locals_owning.push(false)
    f.locals.push(1)
    f.locals_nslots.push(1)
    f.locals_owning.push(false)
    d0 := ssa_test_temp(mut &f, 1)
    dp := ssa_test_temp(mut &f, 1)
    dc := ssa_test_temp(mut &f, 1)
    cond := ssa_test_temp(mut &f, 2)
    f.consts.push(37)
    f.consts.push(1)
    ssa_test_block(mut &f, 1, 1, -1, -1)
    ssa_test_block(mut &f, 2, cond, 2, 3)
    ssa_test_block(mut &f, 1, 1, -1, -1)
    ssa_test_block(mut &f, 3, dp, -1, -1)
    ssa_test_copy(mut &f, 0, d0, -2)
    mut load := mkinstr(2)
    load.a = cond
    load.b = 0
    mir_cfg_append(mut &f, 1, load)
    mut cp := mkinstr(1)
    cp.a = dc
    cp.b = dp
    if changing {
        cp.kind = 4
        cp.b = 1
        cp.c = dp
        cp.d = -3
    }
    mir_cfg_append(mut &f, 2, cp)
    f.phi_args.push(MPhiArg{pred: 0, value: d0})
    f.phi_args.push(MPhiArg{pred: 2, value: dc})
    f.phis.push(MPhi{block: 1, local: 1, dest: dp, ty: 1, arg_head: 0, arg_count: 2})
    if mir_verify_mfn_f(&f, true) != 0 { << false }
    simplified := mir_ssa_simplify_f(mut &f)
    if simplified < 0 || mir_verify_mfn_f(&f, true) != 0 { << false }
    if changing {
        if f.phis.len != 1 { << false }
    } else {
        if f.phis.len != 0 || f.blocks[3].ta > -2 || f.val_const(f.blocks[3].ta) != 37 { << false }
        if ssa_test_live_copies(&f) != 0 { << false }
    }
    eliminated := mir_phi_elim_f(mut &f)
    << eliminated && mir_verify_mfn_f(&f, false) == 0
}

pub fn ssa_test_storage_and_calls(mode int) bool {
    mut f := mir_fn_blank()
    f.ret = 1
    f.ret_nslots = 1
    a := ssa_test_temp(mut &f, 1)
    b := ssa_test_temp(mut &f, 1)
    f.consts.push(37)
    ssa_test_block(mut &f, 3, b, -1, -1)
    ssa_test_copy(mut &f, 0, a, -2)
    ssa_test_copy(mut &f, 0, b, a)
    if mode == 1 || mode == 5 {
        ptr := ssa_test_temp(mut &f, 1)
        mut addr := mkinstr(16)
        addr.a = ptr
        addr.b = b
        if mode == 5 { addr.b = a }
        addr.c = 1
        mir_cfg_append(mut &f, 0, addr)
        if mode == 5 {
            f.consts.push(41)
            mut store := mkinstr(18)
            store.a = -3
            store.b = ptr
            store.c = 0
            store.d = 1
            mir_cfg_append(mut &f, 0, store)
        }
    }
    if mode == 2 {
        f.margs.push(MArg{v: b, next: -1})
        mut call := mkinstr(7)
        call.a = -1
        call.b = 2
        call.c = 0
        mir_cfg_append(mut &f, 0, call)
    }
    if mode == 3 {
        // An opaque call can mutate memory between two local reads.
        f.nparams = 1
        f.locals.push(1)
        f.locals_nslots.push(1)
        f.locals_owning.push(false)
        f.margs.push(MArg{v: a, next: -1})
        mut call := mkinstr(7)
        call.a = -1
        call.b = 2
        call.c = 0
        mir_cfg_append(mut &f, 0, call)
        mut x := mkinstr(2)
        x.a = a
        x.b = 0
        x.next = 2
        mfn_set_instr(mut &f.instrs, 0, x)
        mut y := mkinstr(2)
        y.a = b
        y.b = 0
        mfn_set_instr(mut &f.instrs, 1, y)
        mfn_set_inext(mut &f.instrs, 2, 1)
        mut block := f.blocks[0]
        block.tail = 1
        mfn_set_block(mut &f.blocks, 0, block)
    }
    if mode == 6 { mir_cfg_append(mut &f, 0, mkinstr(49)) }
    if mode == 6 {
        s := mir_ssa_simplify_f(mut &f)
        << s == -1 && ssa_test_live_copies(&f) == 2
    }
    if mode == 4 { ssa_test_copy(mut &f, 0, a, -2) }
    if mode == 4 {
        if mir_verify_mfn_f(&f, true) == 0 { << false }
        s := mir_ssa_simplify_f(mut &f)
        << s == -1 && ssa_test_live_copies(&f) == 3
    }
    if mir_verify_mfn_f(&f, true) != 0 { << false }
    simplified := mir_ssa_simplify_f(mut &f)
    if simplified < 0 || mir_verify_mfn_f(&f, true) != 0 { << false }
    if mode == 1 {
        if f.blocks[0].ta != b || mfn_ib(&f.instrs, 2) != b { << false }
        << ssa_test_live_copies(&f) == 1
    }
    if mode == 3 { << f.blocks[0].ta == b && ssa_test_live_copies(&f) == 0 }
    if mode == 5 {
        << f.blocks[0].ta == b && mfn_ib(&f.instrs, 1) == a && ssa_test_live_copies(&f) == 2
    }
    if mode == 2 && mfn_marg_v(&f.margs, 0) != -2 { << false }
    << f.blocks[0].ta == -2 && ssa_test_live_copies(&f) == 0
}

pub fn ssa_test_float_and_budget(mode int) bool {
    mut f := mir_fn_blank()
    f.ret = 4
    f.ret_nslots = 1
    a := ssa_test_temp(mut &f, 4)
    f.consts.push(9221120237041090560)
    ssa_test_block(mut &f, 3, a, -1, -1)
    ssa_test_copy(mut &f, 0, a, -2)
    if mode == 1 { for _ in 0:513 { ssa_test_temp(mut &f, 1) } }
    if mode == 1 {
        s := mir_ssa_simplify_f(mut &f)
        << s == -1 && ssa_test_live_copies(&f) == 1
    }
    s := mir_ssa_simplify_f(mut &f)
    << s >= 0 && f.blocks[0].ta == a && ssa_test_live_copies(&f) == 1
}

pub fn ssa_test_narrow(mode int) bool {
    mut f := mir_fn_blank()
    mut ty := 10
    mut value := 300
    if mode == 1 { ty = 9
        value = 4294967297 }
    if mode == 2 { ty = 8
        value = 2147483648 }
    f.ret = ty
    f.ret_nslots = 1
    a := ssa_test_temp(mut &f, ty)
    ssa_test_temp(mut &f, ty)
    f.consts.push(value)
    ssa_test_block(mut &f, 3, a, -1, -1)
    ssa_test_copy(mut &f, 0, a, -2)
    simplified := mir_ssa_simplify_f(mut &f)
    // Typed Copy performs width conversion in the emitter. It cannot be
    // replaced by its raw constant word without modelling that conversion.
    << simplified >= 0 && f.blocks[0].ta == a && ssa_test_live_copies(&f) == 1
}

pub fn ssa_test_single_temp() bool {
    mut f := mir_fn_blank()
    f.ret = 1
    f.ret_nslots = 1
    a := ssa_test_temp(mut &f, 1)
    f.consts.push(37)
    ssa_test_block(mut &f, 3, a, -1, -1)
    ssa_test_copy(mut &f, 0, a, -2)
    simplified := mir_ssa_simplify_f(mut &f)
    << simplified == 1 && f.blocks[0].ta == -2 && ssa_test_live_copies(&f) == 0
}
