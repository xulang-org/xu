@xu/types

// A single pooled raw word with perturbations of its container and pool.
pub fn constant_store_contract_mir(mode int) Mir {
    mut m := empty_mir()
    mut ety := 1
    mut width := 8
    mut fixed := 0
    if mode == 1 { ety = 4 }
    if mode == 2 { ety = 8
        width = 1 }
    if mode == 3 { fixed = 4 }
    if mode != 4 { m.arrays.push(CArray{elem_ty: ety, elem_bytes: width, fixed_len: fixed}) }
    mut f := mir_fn_blank()
    f.temps.push(200)
    f.temps_nslots.push(3)
    f.temps.push(1)
    f.temps_nslots.push(1)
    if mode != 5 { f.consts.push(0) }
    m.fns.push(f)
    << m
}
