@xu/types

// Test-only support is injected into a temporary types package.  Production
// has no public deletion/movement entry point for this gate.
pub fn delete_move_apply(f &mut MFn, op int, bi int, ii int, other int) bool {
    if op == 0 { << mir_detach_instr(f, bi, ii) }
    if op == 1 { << mir_delete_instr(f, bi, ii) }
    if op == 2 {
        if !mir_detach_instr(f, bi, ii) { << false }
        mir_append_instr(f, other, ii)
        << true
    }
    if op == 3 {
        payload := mfn_instr_snap(mut &f.instrs, ii)
        mir_prepend_instr(f, bi, payload)
        << true
    }
    if op == 4 { << mir_dce_pure(f) }
    if op == 5 { << mir_forward_f64_copies(f) }
    if op == 6 { << mir_dse(f) }
    if op == 7 { << mir_merge_jump_blocks(f) }
    if op == 8 { << mir_hoist_common_branch(f) }
    if op == 9 { mir_licm_self_loops(f)
        << true }
    if op == 10 { << mir_zap_unreachable(f) }
    if op == 12 {
        if !mir_delete_instr(f, bi, ii) { << false }
        << mir_delete_instr(f, bi, ii)
    }
    if op == 13 || op == 14 {
        empty := []int{}
        if op == 13 {
            mir_sroa_rewrite(f, &empty, &empty, &empty, &empty, &empty, &empty, &empty, &empty, &empty)
        } else {
            mir_sroa_array_rewrite(f, &empty, &empty, &empty, &empty, &empty, &empty, &empty, &empty, &empty, &empty, &empty, &empty)
        }
        << true
    }
    if op == 15 {
        mut callee := mir_fn_blank()
        callee.ret = 1
        callee.ret_nslots = 1
        callee.consts.push(7)
        callee.temps.push(1)
        callee.temps_nslots.push(1)
        callee.blocks.push(MBlock{head: 0, tail: 0, tkind: 3, ta: 0, tb: -1, tc: -1, line: 700})
        mut value := mkinstr(1)
        value.a = 0
        value.b = -2
        value.sval = "cloned-owned-value-label"
        value.line = 701
        value.col = 702
        value.file = 2
        callee.instrs.push(value)
        dest := mfn_ia(&f.instrs, ii)
        reachable := [true]
        arguments := []int{}
        mir_inline_cfg_apply(f, &callee, &reachable, dest, &arguments, bi, ii)
        << true
    }
    << false
}

pub fn delete_move_dump(f &MFn) {
    println(f.instrs.len)
    println(f.blocks.len)
    for ii in 0:f.instrs.len {
        println(mfn_ikind(&f.instrs, ii))
        println(mfn_ia(&f.instrs, ii))
        println(mfn_ib(&f.instrs, ii))
        println(mfn_ic(&f.instrs, ii))
        println(mfn_id(&f.instrs, ii))
        println(mfn_isval(&f.instrs, ii))
        println(mfn_inext(&f.instrs, ii))
        println(mfn_iline(&f.instrs, ii))
        println(mfn_icol(&f.instrs, ii))
        println(mfn_ifile(&f.instrs, ii))
    }
    for bi in 0:f.blocks.len {
        println(f.blocks[bi].head)
        println(f.blocks[bi].tail)
        println(f.blocks[bi].tkind)
        println(f.blocks[bi].ta)
        println(f.blocks[bi].tb)
        println(f.blocks[bi].tc)
        println(f.blocks[bi].line)
    }
}

fn delete_move_value(f &MFn, state &[]int, v int) int {
    if v >= 0 { << state[f.locals.len + v] }
    if v <= -2 { << f.consts[0 - (v + 2)] }
    << 0
}

// Deliberately independent of planner/optimizer logic: linked execution of
// scalar values, explicit observable Call/StorePtr events, and checked Index
// and division failure. Call/Index are model events, not host calls/memory.
pub fn delete_move_execute(f &MFn, input &[]int) []int {
    mut state := []int{}
    for cell in 0:f.locals.len + f.temps.len {
        mut v := 0
        if cell < input.len { v = input[cell] }
        state.push(v)
    }
    nl := f.locals.len
    mut trace := 0
    mut bi := 0
    for _ in 0:64 {
        mut ii := f.blocks[bi].head
        for _j in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            a := mfn_ia(&f.instrs, ii)
            b := mfn_ib(&f.instrs, ii)
            c := mfn_ic(&f.instrs, ii)
            d := mfn_id(&f.instrs, ii)
            if k == 1 { state[nl + a] = delete_move_value(f, &state, b) }
            else if k == 2 { state[nl + a] = state[b] }
            else if k == 3 { state[a] = delete_move_value(f, &state, b) }
            else if k == 4 {
                x := delete_move_value(f, &state, c)
                y := delete_move_value(f, &state, d)
                mut value := 0
                if b == 1 { value = x + y }
                else if b == 2 { value = x - y }
                else if b == 3 { value = x * y }
                else if b == 4 || b == 5 {
                    if y == 0 { << [2, 0, trace] }
                    if b == 4 { value = x / y }
                    else { value = x % y }
                } else if b == 8 { if x < y { value = 1 } }
                else { << [9, 0, trace] }
                state[nl + a] = value
            } else if k == 5 && b == 1 {
                state[nl + a] = 0 - delete_move_value(f, &state, c)
            } else if k == 7 {
                // This fixture target has the separately constructed pure
                // callee above; opaque targets remain observable events.
                if b == 200 {
                    if a >= 0 { state[nl + a] = 7 }
                } else {
                    trace = trace * 131 + 1000 + b
                    if a >= 0 { state[nl + a] = 100 + b }
                }
            } else if k == 14 {
                idx := delete_move_value(f, &state, c)
                trace = trace * 131 + 2000 + idx
                if idx < 0 || idx >= 4 { << [1, 0, trace] }
                state[nl + a] = delete_move_value(f, &state, b) + idx * 7
            } else if k == 18 {
                trace = trace * 131 + 3000 + delete_move_value(f, &state, a)
            } else if k != 0 { << [9, 0, trace] }
            ii = mfn_inext(&f.instrs, ii)
        }
        tk := f.blocks[bi].tkind
        if tk == 3 { << [0, delete_move_value(f, &state, f.blocks[bi].ta), trace] }
        if tk == 1 { bi = f.blocks[bi].ta }
        else if tk == 2 {
            cond := delete_move_value(f, &state, f.blocks[bi].ta)
            mut next := f.blocks[bi].tc
            if cond != 0 { next = f.blocks[bi].tb }
            bi = next
        } else { << [8, 0, trace] }
    }
    << [7, 0, trace]
}

pub fn delete_move_facts(f MFn) int {
    mut m := empty_mir()
    m.fns.push(f)
    m.superseded.push(0)
    facts := new_mir_value_facts(&m, 0)
    << facts.reason
}
