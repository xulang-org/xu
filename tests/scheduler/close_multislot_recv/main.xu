@main

// Closing a channel with a parked string receiver exercises the multi-slot
// zeroing path in the hosted channel runtime.  The receiver is deliberately
// given time to enqueue before close; a watchdog catches an index-reset loop.
fn reader(ch chan string, done chan int) {
    _ := <-ch
    done <- 1
}

fn main() int {
    ch := chan string{cap: 0}
    done := chan int{cap: 1}
    xu reader(ch, done)
    sleep_ns(5000000)
    close(ch)
    println(<-done)
    << 0
}
