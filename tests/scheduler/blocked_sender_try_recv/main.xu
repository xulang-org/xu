@main

// A select receive lowers to chan_try_recv.  Once the sender is parked on a
// full buffered channel, try-recv must consume the older buffered value,
// promote the sender into the newly free slot, and wake it before the caller
// observes the sender's completion signal.
fn worker(ch chan int, started chan int, done chan int) {
    ch <- 1
    started <- 1
    sleep_ns(5000000)
    ch <- 2
    done <- 1
}

fn main() int {
    ch := chan int{cap: 1}
    started := chan int{cap: 1}
    done := chan int{cap: 1}
    xu worker(ch, started, done)
    _ := <-started
    sleep_ns(10000000)
    mut got := false
    while !got {
        select {
            x := <-ch {
                println(x)
                got = true
            }
            else {
                sleep_ns(1000000)
            }
        }
    }
    println(<-done)
    println(<-ch)
    << 0
}
