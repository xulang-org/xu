@main

// Scheduler quadrant: one worker, no explicit sleep.  The select has a
// permanently empty receive arm and a buffered send arm, so the worker must
// make progress without relying on a timer wake-up.
fn worker(out chan int, stop chan int) {
    out <- 10
    select {
        x := <-stop {
            _ := x
            out <- 19
            <<
        }
        out <- 11 {
        }
    }
    out <- 12
}

fn main() int {
    out := chan int{cap: 8}
    stop := chan int{cap: 1}
    xu worker(out, stop)

    mut sum := 0
    mut i := 0
    while i < 3 {
        sum = sum + (<-out)
        i = i + 1
    }
    select {
        x := <-out {
            println("extra:" + str(x))
            << 1
        }
        else {
            println(sum)
            println("ok")
            << 0
        }
    }
    << 0
}
