@main

// A buffered receive must promote the oldest sender that was parked when the
// channel was full.  The sender's completion signal comes before the second
// receive; without promotion this blocks forever after the first value is
// consumed.
fn worker(ch chan int, started chan int, done chan int) {
    ch <- 1
    started <- 1
    // Give the receiver a stable window to observe a parked sender.  The
    // channel is still full, so the following send must enter the wait queue.
    sleep_ns(5000000)
    ch <- 2
    done <- 1
}

fn main() int {
    ch := chan int{cap: 1}
    started := chan int{cap: 1}
    done := chan int{cap: 1}
    xu worker(ch, started, done)
    _ := <-started
    sleep_ns(10000000)
    println(<-ch)
    println(<-done)
    println(<-ch)
    << 0
}
