@main

fn wait(parent chan int, child chan int, out chan int) {
    select {
        p := <-parent {
            _ := p
            out <- 1
        }
        c := <-child {
            _ := c
            out <- 2
        }
    }
}

fn main() int {
    parent := chan int{cap: 1}
    child := chan int{cap: 1}
    out := chan int{cap: 1}
    xu wait(parent, child, out)
    sleep_ns(20000000)
    close(child)
    println(<-out)
    << 0
}
