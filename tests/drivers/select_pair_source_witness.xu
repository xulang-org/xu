@main
fn witness_two(a &[]int,k int,choose bool) int {
    p := a[k]
    q := a[k+1]
    mut x := p
    mut y := p
    if choose { x = p + 1
        y = p
    } else { x = q
        y = q + 1
    }
    << x * 31 + y
}
fn witness_three(a &[]int,k int,choose bool) int {
    p := a[k]
    q := a[k+1]
    r := a[k+2]
    mut x := p
    mut y := p
    if choose { x = p + 1
        y = r
    } else { x = q
        y = q + 1
    }
    << x * 31 + y
}
fn main() int {
 values := [11,22,33,44,55,66,77,88]
 for k in 0:5 {
  println(witness_two(&values,k,true))
  println(witness_two(&values,k,false))
  println(witness_three(&values,k,true))
  println(witness_three(&values,k,false))
 }
 << 0
}
