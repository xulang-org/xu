@main

// Read-only checked loads stay before the diamond. The selected interface
// chooses two word results; neither arm moves/deletes an array check.
fn select_index_pair(a &[]int, k int, choose bool) int {
    p := a[k]
    q := a[k + 1]
    r := a[k + 2]
    s := a[k + 3]
    mut x := p
    mut y := q
    if choose {
        x = p + 1
        y = r
    } else {
        x = q
        y = s + 1
    }
    << x * 31 + y
}

fn main() int {
    values := [11, 22, 33, 44, 55, 66, 77, 88]
    for k in 0:5 {
        println(select_index_pair(&values, k, true))
        println(select_index_pair(&values, k, false))
    }
    << 0
}
