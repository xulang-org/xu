@main
#os
#io
#net
#compress/gzip

fn run(mode string, input string, output string) int {
    if mode == "recv" {
        fd := net.dial(input) or >>
        mut conn := net.file_conn(fd)
        conn.set_read_deadline(now_ns() + 10000000000) or >>
        mut file := os.create(output) or >>
        count := io.copy_stream(mut &file,mut &conn) or (err) {
            _ := file.close() or >>
            _ := conn.close() or >>
            >> err
        }
        _ := file.close() or >>
        _ := conn.close() or >>
        << count
    }
    mut file := os.open(input) or >>
    if mode == "tcp" || mode == "gzip-tcp" {
        fd := net.dial(output) or >>
        mut conn := net.file_conn(fd)
        conn.set_write_deadline(now_ns() + 10000000000) or >>
        mut count := 0
        if mode == "tcp" {
            count = io.copy_stream(mut &conn,mut &file) or (err) {
                _ := file.close() or >>
                _ := conn.close() or >>
                >> err
            }
        } else {
            count = gzip.copy_stream(mut &conn,mut &file) or (err) {
                _ := file.close() or >>
                _ := conn.close() or >>
                >> err
            }
        }
        _ := file.close() or >>
        _ := conn.close() or >>
        << count
    }
    mut dst := os.create(output) or >>
    mut count := 0
    if mode == "gzip" {
        count = gzip.copy_stream(mut &dst,mut &file) or (err) {
            _ := dst.close() or >>
            _ := file.close() or >>
            >> err
        }
    } else {
        count = io.copy_stream(mut &dst,mut &file) or (err) {
            _ := dst.close() or >>
            _ := file.close() or >>
            >> err
        }
    }
    _ := dst.close() or >>
    _ := file.close() or >>
    << count
}
fn main() int {
    args := os.args()
    if args.len != 4 { << 2 }
    count := run(args[1],args[2],args[3]) or (err) {
        println(err.msg())
        << 1
    }
    println(count)
    << 0
}
