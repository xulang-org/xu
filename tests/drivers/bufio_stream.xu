@main
#os
#io
#net
#bufio
#compress/gzip

fn close_input(r &mut bufio.BufferedReader#os.File) int {
    f := mut &r.src
    << f.close() or >>
}
fn close_output(w &mut bufio.BufferedWriter#os.File) int {
    f := mut &w.dst
    << f.close() or >>
}
fn close_sender(w &mut bufio.BufferedWriter#net.Conn) int {
    c := mut &w.dst
    << c.close() or >>
}
fn close_receiver(r &mut bufio.BufferedReader#net.Conn) int {
    c := mut &r.src
    << c.close() or >>
}
fn transfer(mode string, input string, output string) int {
    if mode == "recv" {
        fd := net.dial(input) or >>
        mut conn := net.file_conn(fd)
        conn.set_read_deadline(now_ns() + 10000000000) or >>
        mut reader := bufio.new_stream_reader_size(conn, 257)
        file := os.create(output) or >>
        mut writer := bufio.new_stream_writer_size(file, 509)
        count := io.copy_stream(mut &writer,mut &reader) or (err) {
            close_output(mut &writer) or >>
            close_receiver(mut &reader) or >>
            >> err
        }
        writer.flush() or (err) {
            close_output(mut &writer) or >>
            close_receiver(mut &reader) or >>
            >> err
        }
        close_output(mut &writer) or >>
        close_receiver(mut &reader) or >>
        << count
    }
    file := os.open(input) or >>
    mut reader := bufio.new_stream_reader_size(file, 257)
    if mode == "tcp" || mode == "gzip-tcp" {
        fd := net.dial(output) or >>
        mut conn := net.file_conn(fd)
        conn.set_write_deadline(now_ns() + 10000000000) or >>
        mut writer := bufio.new_stream_writer_size(conn, 509)
        mut count := 0
        if mode == "tcp" {
            count = io.copy_stream(mut &writer,mut &reader) or (err) {
                close_sender(mut &writer) or >>
                close_input(mut &reader) or >>
                >> err
            }
        } else {
            count = gzip.copy_stream(mut &writer,mut &reader) or (err) {
                close_sender(mut &writer) or >>
                close_input(mut &reader) or >>
                >> err
            }
        }
        writer.flush() or (err) {
            close_sender(mut &writer) or >>
            close_input(mut &reader) or >>
            >> err
        }
        close_sender(mut &writer) or >>
        close_input(mut &reader) or >>
        << count
    }
    file_out := os.create(output) or >>
    mut writer := bufio.new_stream_writer_size(file_out, 509)
    mut count := 0
    if mode == "gzip" {
        count = gzip.copy_stream(mut &writer,mut &reader) or (err) {
            close_output(mut &writer) or >>
            close_input(mut &reader) or >>
            >> err
        }
    } else {
        count = io.copy_stream(mut &writer,mut &reader) or (err) {
            close_output(mut &writer) or >>
            close_input(mut &reader) or >>
            >> err
        }
    }
    writer.flush() or (err) {
        close_output(mut &writer) or >>
        close_input(mut &reader) or >>
        >> err
    }
    close_output(mut &writer) or >>
    close_input(mut &reader) or >>
    << count
}
fn main() int {
    args := os.args()
    if args.len != 4 { << 2 }
    count := transfer(args[1],args[2],args[3]) or (err) {
        println(err.msg())
        << 1
    }
    println(count)
    << 0
}
