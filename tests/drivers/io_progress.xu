@main
#io
#bufio
#bytes
#os
#net
#errors

struct Source {
    data string
    off int
    mode int
    calls int
}
struct Sink {
    data string
    cap int
    mode int
    calls int
}
fn source(mode int) Source { << Source{data:"abcdef", off:0, mode:mode, calls:0} }
fn sink(mode int, cap int) Sink { << Sink{data:"", cap:cap, mode:mode, calls:0} }
fn (r &mut Source) read_result(n int) io.ReadResult {
    r.calls += 1
    if r.mode == 4 { << io.ReadResult.Data("") }
    if r.mode == 5 { << io.ReadResult.End("abcdefg") }
    if r.mode == 6 { >> errors.code(414,"read throw") }
    mut take := r.data.len - r.off
    if take > n { take = n }
    start := r.off
    r.off += take
    data := r.data[start:r.off] + ""
    if r.off >= r.data.len {
        if r.mode == 1 { << io.ReadResult.End(data) }
        if r.mode == 2 { << io.ReadResult.Failed(data,errors.code(411,"read failure")) }
        if r.mode == 3 { << io.ReadResult.Failed(data,errors.code(413,"")) }
        if data.len == 0 { << io.ReadResult.End("") }
    }
    << io.ReadResult.Data(data)
}
fn (w &mut Sink) write_result(data string) io.WriteResult {
    w.calls += 1
    mut n := data.len
    if w.mode != 0 && n > w.cap { n = w.cap }
    w.data = w.data + data[0:n]
    if w.mode == 1 { << io.WriteResult.Written(n) }
    if w.mode == 2 { << io.WriteResult.Failed(n,errors.code(422,"write failure")) }
    if w.mode == 3 { << io.WriteResult.Unknown(errors.code(423,"unknown write")) }
    if w.mode == 4 { >> errors.code(424,"write throw") }
    if w.mode == 5 { << io.WriteResult.Written(0 - 1) }
    if w.mode == 6 { << io.WriteResult.Written(data.len + 1) }
    << io.WriteResult.Written(n)
}
fn error_text(err errors.Error) string {
    text := err.msg()
    mut code := 0
    if err is errors.CodeErr {
        value := err as errors.CodeErr
        code = value.code
    }
    << text + ":" + str(code)
}
fn throw_form(kind int) int {
    if kind == 0 { >> errors.code(431,"factory") }
    if kind == 1 { >> errors.CodeErr{code:432,text:"literal"} }
    if kind == 2 { value := errors.code(433,"local")
        >> value }
    if kind == 3 { value := errors.Error(errors.code(434,"boxed"))
        >> value }
    if kind == 4 {
        value := io.ReadResult.End("x")
        match value { io.ReadResult.End(data) { >> errors.code(435,"arm") }
            else {} }
    }
    if kind == 5 {
        match throw_form(0) { else {} }
    }
    << 0
}
fn show_copy(result io.CopyResult) {
    match result {
        io.CopyResult.Copied(n) { println("C:" + str(n)) }
        io.CopyResult.Failed(n,err) { println("F:" + str(n) + ":" + error_text(err)) }
        io.CopyResult.Uncertain(n,err) { println("U:" + str(n) + ":" + error_text(err)) }
    }
}
fn show_read(result io.ReadResult) {
    match result {
        io.ReadResult.Data(data) { println("D:" + data) }
        io.ReadResult.End(data) { println("E:" + data) }
        io.ReadResult.Failed(data,err) { println("F:" + data + ":" + error_text(err)) }
    }
}
fn show_write(result io.WriteResult) {
    match result {
        io.WriteResult.Written(n) { println("W:" + str(n)) }
        io.WriteResult.Failed(n,err) { println("F:" + str(n) + ":" + error_text(err)) }
        io.WriteResult.Unknown(err) { println("U:" + error_text(err)) }
    }
}
struct OldSink { data string }
fn (w &mut OldSink) write_str(data string) int {
    w.data = w.data + data[0:2]
    >> errors.code(425,"legacy partial")
}
fn exercise(k int) int {
    mut r := bufio.new_result_reader_size(source(2),4)
    mut w := bufio.new_result_writer_size(sink(2,1),3)
    result := io.copy_result(mut &w,mut &r)
    match result {
        CopyResult.Copied(n) { << 1 }
        CopyResult.Failed(n,err) { _ := err.msg() }
        CopyResult.Uncertain(n,err) { << 2 }
    }
    // Dispose a pending typed read error without first emitting it.
    mut pending := bufio.new_result_reader_size(source(2),8)
    first := pending.read_result(1) or (err) { << 3 }
    match first { io.ReadResult.Data(data) { _ := data.len }
        else { << 4 } }
    mut outer := bufio.new_result_reader_size(pending,2)
    got := outer.read_result(1) or (err) { << 5 }
    match got { io.ReadResult.Data(data) { _ := data.len }
        else { << 6 } }
    if k % 2 == 1 { >> errors.code(499,"unwind") }
    << 0
}
fn main() int {
    argv := args()
    mode := argv[1]
    if mode == "copy" {
        mut r := source(parse_int(argv[2]) or (err) { << 1 })
        mut w := sink(parse_int(argv[3]) or (err) { << 2 },2)
        size := parse_int(argv[4]) or (err) { << 3 }
        limit := parse_int(argv[5]) or (err) { << 4 }
        if limit == -1 { show_copy(io.copy_result_buffer(mut &w,mut &r,size)) }
        else if limit == -2 { show_copy(io.copy_result(mut &w,mut &r)) }
        else { show_copy(io.copy_result_n(mut &w,mut &r,limit)) }
        println("data:" + w.data)
        println("state:" + str(r.off) + ":" + str(r.calls) + ":" + str(w.calls))
    } else if mode == "reader" {
        mut r := bufio.new_result_reader_size(source(2),8)
        show_read(r.read_result(0) or (err) { << 5 })
        show_read(r.read_result(0 - 1) or (err) { << 6 })
        show_read(r.read_result(1) or (err) { << 7 })
        println(r.buffered())
        show_read(r.read_result(2) or (err) { << 8 })
        show_read(r.read_result(9) or (err) { << 9 })
        show_read(r.read_result(1) or (err) { << 10 })
        println(r.src.calls)
        r.reset(source(1))
        show_read(r.read_result(9) or (err) { << 11 })
    } else if mode == "reader-throw" {
        mut r := bufio.new_result_reader_size(source(6),8)
        show_read(r.read_result(1) or (err) { << 30 })
        show_read(r.read_result(1) or (err) { << 31 })
        println(r.src.calls)
    } else if mode == "throws" {
        for i in 0:6 {
            throw_form(i) or (err) { println(error_text(err))
                -> }
        }
    } else if mode == "nested" {
        mut r0 := bufio.new_result_reader_size(source(2),8)
        mut r := bufio.new_result_reader_size(r0,2)
        mut w := io.buffer()
        show_copy(io.copy_result(mut &w,mut &r))
        println(w.data)
    } else if mode == "writer" {
        wm := parse_int(argv[2]) or (err) { << 12 }
        mut w := bufio.new_result_writer_size(sink(wm,2),4)
        show_write(w.write_result("abcdef") or (err) { << 13 })
        println("pending:" + w.pending())
        println("data:" + w.dst.data)
        show_write(w.flush_result() or (err) { << 14 })
        show_write(w.write_result("X") or (err) { << 15 })
        show_write(w.write_result("") or (err) { << 16 })
        println(w.dst.calls)
        w.reset(sink(0,2))
        show_write(w.write_result("xy") or (err) { << 17 })
        show_write(w.flush_result() or (err) { << 18 })
        println(w.dst.data)
    } else if mode == "flush" {
        mut w := bufio.new_result_writer_size(sink(2,2),8)
        show_write(w.write_result("abc") or (err) { << 19 })
        show_write(w.flush_result() or (err) { << 20 })
        println("pending:" + w.pending())
        println(w.dst.data)
    } else if mode == "legacy" {
        mut r := io.progress_reader(io.cursor("abcdef"))
        mut w := io.progress_writer(OldSink{data:""})
        show_copy(io.copy_result(mut &w,mut &r))
        println(w.dst.data)
    } else if mode == "bytes" {
        mut r := bytes.new_reader("abc")
        mut w := bytes.buffer()
        show_copy(io.copy_result(mut &w,mut &r))
        println(w.bytes())
        mut b := bytes.buffer_from("def")
        show_read(b.read_result(10))
    } else if mode == "file" {
        path := argv[2]
        mut f := os.create(path + "") or (err) { << 21 }
        show_write(f.write_result("file payload"))
        f.close() or (err) { << 22 }
        show_write(f.write_result("X"))
        mut r := os.open(path + "") or (err) { << 23 }
        mut w := io.buffer()
        show_copy(io.copy_result_buffer(mut &w,mut &r,3))
        println(w.data)
        r.close() or (err) { << 24 }
        show_read(r.read_result(1))
        os.remove(path) or (err) { << 25 }
    } else if mode == "tcp" {
        fd := net.dial(argv[2]) or (err) { << 26 }
        mut c := net.file_conn(fd) or (err) { << 29 }
        show_write(c.write_result("request"))
        mut w := io.buffer()
        show_copy(io.copy_result_buffer(mut &w,mut &c,3))
        println(w.data)
        c.close() or (err) { << 27 }
    } else if mode == "ledger" {
        count := parse_int(argv[2]) or (err) { << 28 }
        mut hits := 0
        for i in 0:count {
            exercise(i) or (err) { hits += 1
                -> }
        }
        println(hits)
    }
    << 0
}
