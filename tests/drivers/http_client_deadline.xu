@main

#net/http
#os
#strconv
#strings

fn attempt(c &mut http.Client, raw_url string, post bool, large bool) {
    mut body := "payload"
    if large {
        unit := "x"
        body = strings.repeat(&unit, 8388608)
    }
    mut method := "GET"
    if post { method = "POST" }
    r := c.do(method, raw_url, &body) or (err) {
        println("error:" + err.msg())
        println("idle:" + str(c.has_idle_connection()))
        <<
    }
    println("ok:" + str(r.status_code()) + ":" + r.body())
}

fn main() int {
    a := os.args()
    if a.len != 4 { << 2 }
    ns := strconv.atoi(&a[2]) or (err) { << 3 }
    mut c := http.new_client()
    c.set_timeout(ns)
    mode := a[3] + ""
    if mode == "reuse" || mode == "stale" || mode == "post-stale" {
        attempt(mut &c, a[1] + "/warm", false, false)
        if mode == "reuse" { c.set_timeout(0) }
        sleep_ns(50000000)
        attempt(mut &c, a[1] + "/next", mode == "post-stale", false)
    } else {
        attempt(mut &c, a[1] + "", mode == "post" || mode == "write", mode == "write")
    }
    // Keep the process alive so the host gate can distinguish explicit
    // socket cleanup from descriptors being reclaimed at process exit.
    sleep_ns(300000000)
    c.close_idle()
    << 0
}
