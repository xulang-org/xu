@main

fn check(name string, val int, exp int) {
    if val != exp {
        println(name)
        println(val)
        println(exp)
        assert(false)
    }
}

fn op_div3(x int) int { << x / 3 }
fn op_mod3(x int) int { << x % 3 }

fn op_div7(x int) int { << x / 7 }
fn op_mod7(x int) int { << x % 7 }

fn op_div10(x int) int { << x / 10 }
fn op_mod10(x int) int { << x % 10 }

fn op_div3000(x int) int { << x / 3000 }
fn op_mod3000(x int) int { << x % 3000 }

fn op_div1m(x int) int { << x / 1000000 }
fn op_mod1m(x int) int { << x % 1000000 }

fn op_div_prime(x int) int { << x / 1000000007 }
fn op_mod_prime(x int) int { << x % 1000000007 }

fn op_div_lcg(x int) int { << x / 2147483647 }
fn op_mod_lcg(x int) int { << x % 2147483647 }

fn main() {
    int_min := -9223372036854775807 - 1
    int_max := 9223372036854775807

    // / 3 and % 3
    check("div3(0)", op_div3(0), 0)
    check("mod3(0)", op_mod3(0), 0)
    check("div3(7)", op_div3(7), 2)
    check("mod3(7)", op_mod3(7), 1)
    check("div3(-7)", op_div3(-7), -2)
    check("mod3(-7)", op_mod3(-7), -1)
    check("div3(int_max)", op_div3(int_max), 3074457345618258602)
    check("mod3(int_max)", op_mod3(int_max), 1)
    check("div3(int_min)", op_div3(int_min), -3074457345618258602)
    check("mod3(int_min)", op_mod3(int_min), -2)

    // / 7 and % 7
    check("div7(15)", op_div7(15), 2)
    check("mod7(15)", op_mod7(15), 1)
    check("div7(-15)", op_div7(-15), -2)
    check("mod7(-15)", op_mod7(-15), -1)

    // / 10 and % 10
    check("div10(12345)", op_div10(12345), 1234)
    check("mod10(12345)", op_mod10(12345), 5)
    check("div10(-12345)", op_div10(-12345), -1234)
    check("mod10(-12345)", op_mod10(-12345), -5)

    // / 3000 and % 3000 (lru_cache)
    check("div3000(6000005)", op_div3000(6000005), 2000)
    check("mod3000(6000005)", op_mod3000(6000005), 5)
    check("div3000(-6000005)", op_div3000(-6000005), -2000)
    check("mod3000(-6000005)", op_mod3000(-6000005), -5)
    check("div3000(int_max)", op_div3000(int_max), 3074457345618258)
    check("mod3000(int_max)", op_mod3000(int_max), 1807)
    check("div3000(int_min)", op_div3000(int_min), -3074457345618258)
    check("mod3000(int_min)", op_mod3000(int_min), -1808)

    // / 1000000 and % 1000000 (bloom_filter)
    check("div1m(123456789)", op_div1m(123456789), 123)
    check("mod1m(123456789)", op_mod1m(123456789), 456789)
    check("div1m(-123456789)", op_div1m(-123456789), -123)
    check("mod1m(-123456789)", op_mod1m(-123456789), -456789)

    // / 1000000007 and % 1000000007 (prime)
    check("div_prime(2000000015)", op_div_prime(2000000015), 2)
    check("mod_prime(2000000015)", op_mod_prime(2000000015), 1)
    check("div_prime(-2000000015)", op_div_prime(-2000000015), -2)
    check("mod_prime(-2000000015)", op_mod_prime(-2000000015), -1)

    // / 2147483647 and % 2147483647 (sort_lcg)
    check("div_lcg(2147483648)", op_div_lcg(2147483648), 1)
    check("mod_lcg(2147483648)", op_mod_lcg(2147483648), 1)
    check("div_lcg(-2147483648)", op_div_lcg(-2147483648), -1)
    check("mod_lcg(-2147483648)", op_mod_lcg(-2147483648), -1)
    check("div_lcg(int_max)", op_div_lcg(int_max), 4294967298)
    check("mod_lcg(int_max)", op_mod_lcg(int_max), 1)
    check("div_lcg(int_min)", op_div_lcg(int_min), -4294967298)
    check("mod_lcg(int_min)", op_mod_lcg(int_min), -2)

    println("ALL LITERAL CONSTANT DIV/MOD TESTS PASSED!")
}
