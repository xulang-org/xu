@main

#sort

struct Item {
    k int
    name string
}

fn item_less(a Item, b Item) bool {
    << a.k < b.k
}

fn wrap#T(a &mut []T, less fn(T, T) bool) {
    sort.slice_func(a, less)
}

fn main() int {
    mut a := []Item{}
    a.push(Item{k: 3, name: "c"})
    a.push(Item{k: 1, name: "a"})
    a.push(Item{k: 2, name: "b"})
    wrap(mut &a, item_less)
    println(a[0].k)
    println(a[1].k)
    println(a[2].k)
    println(a[0].name)
    println(a[1].name)
    println(a[2].name)
    << 0
}
