@xu/types

// The same local contributes an address and a scalar snapshot live across
// a call. Its address and the snapshot must occupy distinct frame storage.
pub fn local_borrow_contract_mir(mode int) Mir {
    mut m := refcall_contract_mir(0)
    mut f := mir_clone_fn(mut &m, 0, true)
    f.locals[0] = 1
    mut snapshot := mfn_instr_snap(mut &f.instrs, 0)
    snapshot.kind = 2
    snapshot.b = 0
    snapshot.c = 1
    mfn_set_instr(mut &f.instrs, 0, snapshot)
    mut address := mfn_instr_snap(mut &f.instrs, 3)
    address.kind = 16
    address.b = 0
    address.c = 0
    if mode == 1 { f.locals[0] = 2 }
    if mode == 2 { f.temps_nslots[3] = 2 }
    if mode == 3 { f.temps[3] = 1 }
    if mode == 4 { address.b = -1 }
    if mode == 5 { address.b = f.locals.len }
    if mode == 6 { address.c = 2 }
    if mode == 7 { f.locals_nslots[0] = 2 }
    mfn_set_instr(mut &f.instrs, 3, address)
    m.fns[0] = f
    << m
}
