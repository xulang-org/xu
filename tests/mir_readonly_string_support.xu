@xu/types

// Mutate the actual MIR input to the admission and both target planners.
pub fn readonly_string_test_mir(mode int) Mir {
    mut m := mir_readonly_i64_fixture(3)
    mut f := mir_clone_fn(mut &m, 0, true)
    f.locals[0] = 1003
    f.temps[0] = 1003
    f.temps[6] = 1003
    f.temps[1] = 3
    f.temps[7] = 3
    mut index := mfn_instr_snap(mut &f.instrs, 3)
    index.d = 1
    if mode == 1 {
        f.locals[0] = 2003
        f.temps[0] = 2003
        f.temps[6] = 2003
    }
    if mode == 2 {
        f.locals[0] = 3
        f.locals_nslots[0] = 3
        f.temps[0] = 3
        f.temps_nslots[0] = 3
        mut load := mfn_instr_snap(mut &f.instrs, 1)
        load.kind = 1
        load.b = 0
        load.c = 0
        load.d = 0
        mfn_set_instr(mut &f.instrs, 1, load)
        index.b = 0
    }
    if mode == 3 { f.locals[0] = 3003
        f.temps[0] = 3003 }
    if mode == 4 { f.temps_nslots[1] = 2 }
    if mode == 5 { f.temps_nslots[0] = 2 }
    if mode == 6 { index.d = 8 }
    if mode == 7 { index.d = -1 }
    if mode == 8 { f.temps[4] = 2 }
    if mode == 9 { index.col = 4 }
    if mode == 33 { index.d = -8 }
    mfn_set_instr(mut &f.instrs, 3, index)
    mut header := mkinstr(17)
    header.a = 8
    header.b = 0
    header.c = 8
    header.d = 1
    if mode == 10 { header.c = 24 }
    if mode == 11 { header.c = 16 }
    if mode == 12 { header.c = 7 }
    if mode == 13 { f.temps[8] = 2 }
    if mode == 14 { header.d = 2
        f.temps_nslots[8] = 2 }
    if mode == 2 { header.kind = 1
        header.b = 4
        header.c = 0
        header.d = 0 }
    mir_cfg_append(mut &f, 0, header)
    if mode == 15 { mir_reduce_safety_instr(mut &f, 0, 7, -1, 2, -1, 0) }
    if mode == 16 { mir_reduce_safety_instr(mut &f, 0, 18, 8, 0, 8, 1) }
    if mode == 17 { mir_reduce_safety_instr(mut &f, 0, 8, 0, 0, 0, 0) }
    if mode == 18 {
        f.locals[0] = 3
        f.locals_nslots[0] = 3
        f.locals_owning[0] = true
        mir_reduce_safety_instr(mut &f, 0, 3, 0, 1, 0, 0)
    }
    if mode == 19 { f.locals_owning[2] = true }
    if mode >= 20 {
        m.arrays[0].fixed_len = 256
        f.locals.push(1200)
        f.locals_nslots.push(1)
        f.locals_owning.push(false)
        f.nparams = 4
        f.temps[6] = 1200
        if mode == 21 { f.locals[3] = 2200
            f.temps[6] = 2200 }
        if mode == 22 { m.arrays[0].elem_ty = 2 }
        if mode == 26 { f.temps_nslots[6] = 3 }
        if mode == 27 { f.locals[3] = 1001
            f.temps[6] = 1001 }
        if mode == 30 { m.arrays[0].fixed_len = 0 }
        if mode == 31 { m.arrays[0].fixed_len = 257 }
        if mode == 32 { m.arrays[0].elem_bytes = 4 }
        mir_reduce_safety_instr(mut &f, 0, 2, 6, 3, 0, 0)
        mut lookup := mkinstr(14)
        lookup.a = 9
        lookup.b = 6
        lookup.c = 2
        lookup.d = 8
        lookup.col = 256
        if mode == 23 { lookup.d = 1 }
        if mode == 24 { lookup.col = 255 }
        if mode == 25 { lookup.c = 5 }
        if mode == 28 { lookup.d = -8 }
        if mode == 29 { lookup.d = -1 }
        mir_cfg_append(mut &f, 0, lookup)
    }
    m.fns[0] = f
    << m
}
