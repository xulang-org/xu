@main

#xu/types

fn select_backend_clone(values &[]int) []int {
    mut out := []int{}
    for at in 0:values.len { out.push(values[at]) }
    << out
}

fn select_backend_frame(m &types.Mir, fixed bool, large bool) Frame {
    mut fr := Frame{local_slot: []int{}, temp_slot: []int{}, fp_split: []int{}, select_pairs: select_pair_collect(m, 0), sret_slot: -1, size: 0}
    fr.layout(m, 0, 0, 0, fixed)
    if large {
        for at in 0:fr.local_slot.len {
            if is_frame_slot(fr.local_slot[at]) { fr.local_slot[at] += 1000 }
        }
        for at in 0:fr.temp_slot.len {
            if is_frame_slot(fr.temp_slot[at]) { fr.temp_slot[at] += 1000 }
        }
        fr.size += 8000
    }
    << fr
}

fn select_backend_copy_frame(fr &Frame) Frame {
    << Frame{local_slot: select_backend_clone(&fr.local_slot), temp_slot: select_backend_clone(&fr.temp_slot), fp_split: select_backend_clone(&fr.fp_split), select_pairs: select_backend_clone(&fr.select_pairs), sret_slot: fr.sret_slot, size: fr.size}
}

fn select_backend_mutations(m &types.Mir, fr &Frame, liveout bool) []int {
    mut answers := []int{}
    at := select_pair_header
    // Dying sources, point-local scratch, condition, outputs and unrelated
    // ranges are separately tested; no planner success bit is trusted.
    for mutation in 0:23 {
        mut bad := select_backend_copy_frame(fr)
        if mutation == 0 { bad.temp_slot[1] = vreg_slot(6) }
        if mutation == 1 { bad.temp_slot[1] = vreg_slot(7) }
        if mutation == 2 { bad.temp_slot[2] = bad.temp_slot[1] }
        if mutation == 3 { bad.temp_slot[0] = bad.temp_slot[1] }
        if mutation == 4 { bad.temp_slot[7] = vreg_slot(6) }
        if mutation == 5 { bad.temp_slot[1] = synth_slot(1) }
        if mutation == 6 {
            kind := bad.select_pairs[at + 3]
            id := bad.select_pairs[at + 4]
            if kind == 1 { bad.local_slot[id] = unused_slot() }
            else { bad.temp_slot[id] = unused_slot() }
        }
        if mutation == 7 {
            off0 := at + 3
            off1 := at + 6
            slot := select_pair_slot(&bad, bad.select_pairs[off0], bad.select_pairs[off0 + 1])
            if bad.select_pairs[off1] == 1 { bad.local_slot[bad.select_pairs[off1 + 1]] = slot }
            else { bad.temp_slot[bad.select_pairs[off1 + 1]] = slot }
        }
        if mutation == 8 { bad.select_pairs[0] = 1 }
        if mutation == 9 { bad.select_pairs[4] = 2 }
        if mutation == 10 { bad.select_pairs[at + 10] = 23 }
        if mutation == 11 { bad.select_pairs[at + 25] = 0 }
        if mutation == 12 { bad.select_pairs[at + 2] = 1 }
        if mutation == 13 { bad.temp_slot[1] = bad.local_slot[1] }
        if mutation == 14 { bad.temp_slot[1] = bad.local_slot[5] }
        if mutation == 15 { bad.local_slot[2] = bad.local_slot[1] }
        if mutation == 16 { bad.temp_slot[1] = bad.size / 8 }
        if mutation == 17 { bad.local_slot[1] = bad.size / 8 }
        if mutation == 18 {
            bad.temp_slot[7] = vreg_slot(7)
            if liveout { bad.temp_slot[16] = vreg_slot(7) }
        }
        if mutation == 19 { bad.temp_slot[14] = vreg_slot(6) }
        if mutation == 20 { bad.temp_slot[14] = vreg_slot(7) }
        if mutation == 21 || mutation == 22 {
            kind := bad.select_pairs[at + 3]
            id := bad.select_pairs[at + 4]
            home := mutation - 15
            if kind == 1 { bad.local_slot[id] = vreg_slot(home) }
            else { bad.temp_slot[id] = vreg_slot(home) }
        }
        mut result := 0
        if select_pair_verify_frame(&bad, m, 0, 0) { result = 1 }
        answers.push(result)
    }
    << answers
}

fn select_backend_dump(m &types.Mir, case int, mode int, from int) {
    mut fr := select_backend_frame(m, mode == 1 || mode == 3, mode == 2)
    if mode == 3 {
        // One repeated Local source loses its witness home. Its first
        // snapshot reads the frame and its later snapshot copies that base;
        // either original arm has the same one-cell memory lower bound.
        fr.temp_slot[2] = fr.size / 8
        fr.size += 16
    }
    if mode == 4 {
        // These real ranges either died before the branch or are defined
        // only after join. Distinct scratch homes are safe at this point.
        fr.temp_slot[7] = vreg_slot(6)
        fr.temp_slot[8] = vreg_slot(7)
    }
    if mode == 5 || mode == 6 {
        // A genuine dying Bool is sampled before VM6/7 snapshot writes.
        // The independent Python CFG/data-role oracle proves it is dying.
        fr.temp_slot[fr.select_pairs[select_pair_header + 2]] = vreg_slot(mode + 1)
    }
    if mode == 7 || mode == 8 {
        // Both Temp1 and Temp7 are legitimate same-block Local1 witnesses.
        // The first snapshot chooses Temp1, the remaining three choose
        // Temp7. Only the first canonical read determines materialization.
        for pos in 1:4 { fr.select_pairs[select_pair_header + 26 + pos] = 7 }
        if mode == 7 { fr.temp_slot[7] = vreg_slot(2) }
        else { fr.temp_slot[1] = vreg_slot(2) }
    }
    println("CASE")
    println(case)
    println(mode)
    println(fr.select_pairs.len)
    if fr.select_pairs.len == 0 { println("MISSING")
        << }
    println(fr.select_pairs[4])
    for at in 0:fr.select_pairs.len { println(fr.select_pairs[at]) }
    mut valid := 0
    if select_pair_verify_frame(&fr, m, 0, 0) { valid = 1 }
    println(valid)
    // Resource legality and production profitability are separate contracts.
    // Direct emission below still executes every valid action, including a
    // frame-heavy action the normal function path will decline for cost.
    mut profitable := 0
    if valid == 1 && select_pair_profitable(&fr) { profitable = 1 }
    println(profitable)
    mut fixed := 0
    if frame_has_vregs(&fr) { fixed = 1 }
    println(fixed)
    println(fr.size)
    println(fr.local_slot.len)
    for at in 0:fr.local_slot.len { println(fr.local_slot[at]) }
    println(fr.temp_slot.len)
    for at in 0:fr.temp_slot.len { println(fr.temp_slot[at]) }
    mut a := Assembler{}
    init_assembler(mut &a, 0, 0)
    a.rc_on = false
    a.rc_fused_cc = 0
    mut emitted := 0
    if emit_select_pair_term(mut &a, m, 0, &fr, from) { emitted = 1 }
    println(emitted)
    println(a.rc_fused_cc)
    println(a.code.len / 4)
    for at in 0:a.code.len / 4 {
        word := a.code[at * 4] | (a.code[at * 4 + 1] << 8) | (a.code[at * 4 + 2] << 16) | (a.code[at * 4 + 3] << 24)
        println(word)
    }
    if case < 4 || case == 23 {
        rejected := select_backend_mutations(m, &fr, case == 3)
        println(rejected.len)
        for at in 0:rejected.len { println(rejected[at]) }
    } else { println(0) }
    mut invalid := []int{}
    for pos in 0:4 {
        off := select_pair_header + 9 + pos * 4
        for corruption in 0:3 {
            mut bad := select_backend_copy_frame(&fr)
            mut witness := -2
            if corruption == 1 { witness = types.mir_ntemps(m, 0) }
            if corruption == 2 { witness = 23 }
            bad.select_pairs[select_pair_header + 26 + pos] = witness
            mut result := 0
            if select_pair_verify_frame(&bad, m, 0, 0) { result = 1 }
            invalid.push(result)
        }
    }
    println(invalid.len)
    for k in 0:invalid.len { println(invalid[k]) }
    mut pressure := []int{}
    if mode == 1 {
        mut ordinary := select_backend_copy_frame(&fr)
        // Isolate each policy with actual Frame records, independently of
        // the selected allocation success flag. Temp0 is a Bool result.
        ordinary.temp_slot[0] = vreg_slot(8)
        for t in 1:ordinary.temp_slot.len {
            if is_vreg_slot(ordinary.temp_slot[t]) { ordinary.temp_slot[t] = vreg_slot(2) }
        }
        for corruption in 0:5 {
            mut bad := select_backend_copy_frame(&ordinary)
            if corruption == 1 { bad.size += 16 }
            if corruption == 2 { bad.temp_slot[0] = vreg_slot(10) }
            if corruption == 3 { bad.temp_slot[0] = 0 }
            if corruption == 4 {
                bad.temp_slot[0] = 0
                // Another frame Temp gaining a home does not excuse the
                // newly spilled, previously fixed Bool.
                bad.temp_slot[4] = vreg_slot(8)
            }
            mut result := 0
            if select_pair_pressure_ok(&bad, &ordinary, m, 0, 0) { result = 1 }
            pressure.push(result)
        }
    }
    println(pressure.len)
    for k in 0:pressure.len { println(pressure[k]) }
    println(2)
    for home in 6:8 {
        mut bad := select_backend_copy_frame(&fr)
        bad.temp_slot[bad.select_pairs[select_pair_header + 2]] = vreg_slot(home)
        mut result := 0
        if select_pair_verify_frame(&bad, m, 0, 0) { result = 1 }
        println(result)
    }
    println("END")
}

fn select_backend_scratch_dump() {
    // These records exercise the real whole-pool classifier independently of
    // selected emission. A retired NoOp has no scratch; an unknown nonzero
    // record remains conservative even when its ownership is unproven.
    for case in 0:8 {
        m := types.select_scratch_fixture(case)
        mut kind := -1
        mut linked := 0
        if case > 0 {
            kind = 0
            if case == 3 || case == 4 { kind = 99 }
            if case == 5 { kind = 14 }
            if case == 6 { kind = 8 }
            if case == 7 { kind = 7 }
            if case == 1 || case == 3 || case == 5 || case == 6 {
                linked = 1
            }
        }
        println("SCRATCH")
        println(case)
        println(kind)
        println(linked)
        println(fn_uses_s_scratch(&m, 0))
        println(fn_ncalls(&m, 0))
        println("ENDSCRATCH")
    }
}
