@main
// B3a: math.pow_f64 / log2 / cbrt
#math

fn main() int {
    p := math.pow_f64(2.0, 8.0)
    println(p > 255.9 && p < 256.1)
    l2 := math.log2(8.0)
    println(l2 > 2.999 && l2 < 3.001)
    c := math.cbrt(8.0)
    println(c > 1.999 && c < 2.001)
    println(math.signbit(0.0 - 1.0))
    << 0
}
