@main
// Go-parity stdlib wave 33: image.color conversions
#image/color

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    c := color.rgba8(10, 20, 30, 255)
    p := c.rgba()
    println(p.r)
    println(p.g)
    println(p.b)
    println(p.a)
    yc := color.rgb_to_ycbcr(255, 0, 0)
    println(yc.y)
    println(yc.cb)
    println(yc.cr)
    rgb := color.ycbcr_to_rgb(yc.y, yc.cb, yc.cr)
    println(rgb.r)
    println(rgb.g)
    println(rgb.b)
    show_bool(p.a == 65535)
    << 0
}
