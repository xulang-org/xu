@main
// B2b: context.with_deadline / iotest.err_reader
#context
#testing/iotest

fn deadline_msg(c &context.Context) string {
    context.err(c) or (err) {
        << err.msg()
    }
    << ""
}

fn read_err(r iotest.ErrReader) string {
    r.read_n(1) or (err) {
        << err.msg()
    }
    << ""
}

fn main() int {
    mut d := context.with_deadline(now_ns() - 1000)
    println(deadline_msg(&d.ctx))
    println(read_err(iotest.err_reader("boom")))
    << 0
}
