@main
// B0a: strings clone / split_after / Builder.write_byte
#strings

fn main() int {
    s := "hello"
    println(strings.clone(&s))
    csv := "a,b"
    sa := strings.split_after(&csv, ",")
    println(sa[0])
    println(sa[1])
    mut bd := strings.builder()
    println(bd.write_byte(65))
    println(bd.text())
    << 0
}
