@main
// Go-parity stdlib wave 61: encoding.base32 Std/Hex/Raw/RawHex smoke
#encoding/base32

fn main() int {
    println(base32.encode_to_string("foo"))
    println(base32.hex_encode_to_string("foo"))
    println(base32.raw_encode_to_string("foo"))
    println(base32.raw_hex_encode_to_string("foo"))
    << 0
}
