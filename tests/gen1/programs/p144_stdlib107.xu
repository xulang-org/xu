@main
// Go-parity stdlib wave 107: sync.Cond
#sync

fn worker(mu sync.Mutex, c sync.Cond, done chan int) {
    mut m := mu
    mut cv := c
    m.lock()
    cv.signal()
    m.unlock()
    done <- 1
}

fn main() int {
    mut mu := sync.mutex()
    mut c := sync.cond()
    done := chan int{cap: 1}
    mu.lock()
    xu worker(mu, c, done)
    c.wait(mut &mu)
    mu.unlock()
    _ := <-done
    println(1)
    << 0
}
