@main
// Go-parity stdlib wave 15: bytes + time + container.list
#bytes
#time
#container/list

fn main() int {
    mut b := bytes.buffer()
    s := "Xu"
    b.write(&s)
    b.write_byte(33) or (err) { << 1 }
    println(b.text())
    a := "abc"
    b2 := "abd"
    println(bytes.equal(&a, &a))
    println(bytes.compare(&a, &b2))
    println(bytes.has_prefix(&a, "ab"))
    println(bytes.index_byte(&a, 98))

    t0 := time.now()
    time.sleep(time.millisecond())
    println(time.since(t0) > 0)
    println(time.millisecond())

    mut l := list.new()
    l.push_back("a")
    l.push_back("b")
    l.push_front("z")
    println(list.len(&l))
    mut e := list.front(&l)
    while e != 0 {
        println(list.value(&l, e))
        e = list.next(&l, e)
    }
    << 0
}
