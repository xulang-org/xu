@main
// Go-parity stdlib wave 3 (crypto/sha256 + math/rand + slices 深化).
#crypto/sha256
#math/rand
#slices

fn main() int {
    println(sha256.sum256("abc"))
    mut d := sha256.new()
    p := "hello"
    d.write(&p)
    println(d.sum())
    d.reset()
    println(d.sum())
    mut r := rand.new_source(7)
    println(r.intn(1000))
    mut r2 := rand.new_source(7)
    println(r2.intn(1000))
    mut rev := [3, 1, 2]
    slices.reverse_ints(mut &rev)
    println(rev[0])
    xs := [3, 1, 2]
    println(slices.equal_ints(&xs, &rev))
    ws := ["a", "b", "c"]
    println(slices.index_of_str(ws, "b"))
    << 0
}
