@main
// G4: crypto/sm2 GM/T 0003.5 recommended-curve public key
#crypto/sm2
#encoding/hex

fn main() int {
    d := hex.decode_string("3945208f7b2144b13f36e38ac6d39f95889393692860b51a42fb81ef4df7c5b8") or (err) {
        << 1
    }
    pubk := sm2.public(&d) or (err) {
        << 1
    }
    println(hex.encode_to_string(pubk + ""))
    << 0
}
