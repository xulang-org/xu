@main
// Go-parity stdlib wave 5 (encoding/json + net/url + flag).
#encoding/json
#net/url
#flag

fn main() int {
    src := "{\"a\":[1,true,null],\"b\":\"x\\ny\"}"
    d := json.parse(&src)
    println(d.ok())
    a := d.get(d.root(), "a")
    println(d.count(a))
    println(d.number_int(d.at(a, 0)) or (err) { << 1 })
    b := d.get(d.root(), "b")
    println(d.text(b).len)
    println(d.to_json())
    mut u := url.new_url()
    u.parse("https://example.com/p?q=1#f") or (err) { << 1 }
    println(u.scheme())
    println(u.host())
    println(u.to_string())
    u2 := url.parse_url("https://ex.com/z") or (err) { << 1 }
    println(u2.host())
    qs := "a b&c"
    println(url.query_escape(&qs))
    mut qq := url.new_query()
    qq.parse("x=1&y=a+b") or (err) { << 1 }
    println(qq.len())
    println(qq.at(1))
    mut fs := flag.new_set("p")
    fs.define_bool("v", false, "")
    fs.define_string("name", "", "")
    fs.define_int("n", 0, "")
    fs.parse(["-v", "--name=Xu", "-n=3", "tail"]) or (err) { << 1 }
    println(fs.get_bool("v"))
    println(fs.get_string("name"))
    println(fs.get_int("n"))
    println(fs.args()[0])
    << 0
}
