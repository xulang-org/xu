@main
// Go-parity stdlib wave 97: unicode.utf16 encode/decode
#unicode/utf16

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    show_bool(utf16.is_surrogate(0xD800))
    s := "Xu"
    u := utf16.encode(&s) or (err) { << 1 }
    println(u.len)
    println(utf16.decode(&u) or (err) { << 1 })
    << 0
}
