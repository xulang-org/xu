@main
// Go-parity stdlib wave 75: crypto.cipher PKCS7 pad/unpad
#crypto/cipher

fn main() int {
    hi := "hi"
    p := cipher.pad_pkcs7(&hi, 16) or (err) { << 1 }
    println(p.len)
    println(p[p.len - 1] & 255)
    println(cipher.unpad_pkcs7(&p) or (err) { << 1 })
    empty := ""
    e := cipher.pad_pkcs7(&empty, 16) or (err) { << 1 }
    println(e.len)
    println((cipher.unpad_pkcs7(&e) or (err) { << 1 }).len)
    << 0
}
