@main
// Go-parity stdlib wave 19: image.jpeg baseline SOF0 decode
#encoding/hex
#image/jpeg

fn main() int {
    gray_hex := ""
    gray_raw := hex.decode_string(gray_hex + "") or (err) { << 1 }
    g := jpeg.decode(&gray_raw) or (err) { << 1 }
    println(g.rect.dx())
    println(g.rect.dy())
    a := g.at_rgba(0, 0)
    println(a.r)
    println(a.g)
    println(a.b)
    println(a.a)
    b := g.at_rgba(7, 7)
    println(b.r)
    << 0
}
