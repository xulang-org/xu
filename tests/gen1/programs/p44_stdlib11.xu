@main
// Go-parity stdlib wave 11: path.filepath + log.
fp #path/filepath
#log
#fmt

fn main() int {
    a := "/x/y/../z//"
    println(fp.clean(&a))
    parts := ["p", "q", "..", "r"]
    println(fp.join(parts))
    mut lg := log.new_logger()
    lg.set_output_stdout(true)
    lg.set_prefix("L: ")
    lg.printf("%d", fmt.i(9))
    << 0
}
