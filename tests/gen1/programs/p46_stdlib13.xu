@main
// Go-parity stdlib wave 13: compress.gzip + regexp
#compress/gzip
#regexp

fn main() int {
    mut w := gzip.new_writer()
    s := "Xu"
    w.write(&s) or (err) { << 1 }
    w.close()
    mut r := gzip.new_reader(w.bytes())
    println(r.read_all() or (err) { << 1 })
    re := regexp.compile("X.") or (err) { << 1 }
    t := "aXu"
    println(re.find(&t))
    << 0
}
