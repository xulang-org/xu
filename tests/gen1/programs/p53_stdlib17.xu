@main
// Go-parity stdlib wave 17: mime.multipart + mime.quotedprintable
#mime/multipart
#mime/quotedprintable

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn next_part_eof(r multipart.Reader) bool {
    mut rr := r
    rr.next_part() or (err) { << true }
    << false
}

fn main() int {
    b0 := "----XuB"
    mut w := multipart.new_writer_with_boundary(&b0)
    println(w.form_data_content_type())
    n1 := "title"
    v1 := "Hello"
    w.write_field(&n1, &v1)
    w.close()
    raw := w.bytes()
    b := w.boundary()
    mut r := multipart.new_reader(&raw, &b)
    p1 := r.next_part() or (err) { << 1 }
    println(p1.form_name())
    println(p1.body())
    if next_part_eof(r) {
        println("EOF")
    }

    hi := "Hi"
    println(quotedprintable.encode_to_string(&hi))
    eq := "Hello=World"
    enc := quotedprintable.encode_to_string(&eq)
    println(quotedprintable.decode_string(&enc) or (err) { << 1 })
    src := "eq=ok and space"
    round := quotedprintable.encode_to_string(&src)
    back := quotedprintable.decode_string(&round) or (err) { << 1 }
    show_bool(back == src)
    << 0
}
