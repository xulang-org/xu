@main
// Go-parity stdlib wave 82: text.template {{with}} + execute_list
#text/template

fn main() int {
    mut d := template.new_dict()
    d.set("Name", "Ada")
    t := template.new("{{with .Name}}hi {{.}}{{else}}anon{{end}}")
    println(template.execute(&t, &d) or (err) { << 1 })
    mut d2 := template.new_dict()
    println(template.execute(&t, &d2) or (err) { << 1 })
    t2 := template.new("{{range .}}-{{.}}-{{end}}")
    mut items := []string{}
    items.push("x")
    items.push("y")
    println(template.execute_list(&t2, items) or (err) { << 1 })
    << 0
}
