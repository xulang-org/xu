@main
// Go-parity stdlib wave 23: text.tabwriter + text.scanner
#text/tabwriter
#text/scanner

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    tab := "\t"
    nl := "\n"
    mut w := tabwriter.new_writer(5, 0, 1, 32, tabwriter.align_right)
    s1 := "a" + tab + "b" + tab + "c" + tab + "d" + tab + "." + nl + "123" + tab + "12345" + tab + "1234567" + tab + "123456789" + tab + "." + nl
    w.write(&s1)
    o1 := w.flush()
    println(o1)
    want1 := "    a     b       c         d." + nl + "  123 12345 1234567 123456789." + nl
    show_bool(o1 == want1)

    src := "if a > 10 {"
    mut s := scanner.new(&src)
    mut tok := s.scan()
    mut n := 0
    while tok != scanner.eof && n < 5 {
        println(s.token_text())
        tok = s.scan()
        n = n + 1
    }
    println(n)
    << 0
}
