@main
// Go-parity stdlib wave 50: image.draw Over + Src (image_draw fixture core)
#image
#image/color
#image/draw

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    mut dst := image.new_rgba(image.rect(0, 0, 2, 2))
    red := color.rgba8(255, 0, 0, 255)
    dst.set_rgba(0, 0, red)
    dst.set_rgba(1, 0, red)
    dst.set_rgba(0, 1, red)
    dst.set_rgba(1, 1, red)
    mut src := image.new_rgba(image.rect(0, 0, 2, 2))
    src.set_rgba(0, 0, color.rgba8(0, 0, 128, 128))
    src.set_rgba(1, 0, color.rgba8(0, 255, 0, 255))
    draw.draw_rgba(mut &dst, image.rect(0, 0, 2, 1), &src, image.pt(0, 0), draw.op_over)
    a := dst.at_rgba(0, 0)
    println(a.r)
    mut dst2 := image.new_rgba(image.rect(0, 0, 2, 2))
    dst2.set_rgba(0, 0, red)
    dst2.set_rgba(1, 1, red)
    draw.draw_rgba(mut &dst2, image.rect(0, 0, 1, 1), &src, image.pt(1, 0), draw.op_src)
    s0 := dst2.at_rgba(0, 0)
    println(s0.g)
    show_bool(a.r == 127)
    << 0
}
