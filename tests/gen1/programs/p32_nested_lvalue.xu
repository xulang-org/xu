@main
// Nested lvalue writes (M??): field-of-field and field-of-index targets,
// including owning string fields and compound ops, on both compilers.
struct Inner {
    v int
    s string
}
struct Mid {
    inner Inner
}
struct Item {
    next int
    s    string
}

fn main() int {
    mut p := Mid{inner: Inner{v: 1, s: "a"}}
    p.inner.v = 7
    p.inner.v += 2
    p.inner.s = "z"
    println(p.inner.v)
    println(p.inner.s)

    mut a := []Item{}
    a.push(Item{next: -1, s: "old"})
    a.push(Item{next: 5, s: "x"})
    a[0].next = 42
    a[1].next += 10
    a[1].s = "newer"
    println(a[0].next)
    println(a[1].next)
    println(a[0].s)
    println(a[1].s)
    << 0
}
