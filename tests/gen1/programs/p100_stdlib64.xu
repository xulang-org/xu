@main
// Go-parity stdlib wave 64: encoding.base32 四路 decode smoke
#encoding/base32

fn main() int {
    println(base32.decode_string("MZXW6===") or (err) { << 1 })
    println(base32.hex_decode_string("CPNMU===") or (err) { << 1 })
    println(base32.raw_decode_string("MZXW6") or (err) { << 1 })
    println(base32.raw_hex_decode_string("CPNMU") or (err) { << 1 })
    << 0
}
