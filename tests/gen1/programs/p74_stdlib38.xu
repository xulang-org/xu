@main
// Go-parity stdlib wave 38: image.color NRGBA/Gray/Alpha/CMYK
#image/color

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    n := color.nrgba8(10, 20, 30, 128)
    np := n.rgba()
    println(np.r)
    println(np.g)
    println(np.b)
    println(np.a)
    gy := color.gray8(128)
    gp := gy.rgba()
    println(gp.r)
    println(gp.a)
    al := color.alpha8(128)
    ap := al.rgba()
    println(ap.a)
    ck := color.rgb_to_cmyk(10, 20, 30)
    println(ck.c)
    println(ck.m)
    println(ck.y)
    println(ck.k)
    show_bool(np.a == 32896)
    << 0
}
