@main
// Gen1 qualified struct literal: pkg.sub.Type{…} (M137)
#image/color

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    c := color.RGBA{r: 10, g: 20, b: 30, a: 255}
    println(c.r)
    println(c.g)
    println(c.b)
    println(c.a)
    n := color.NRGBA{r: 10, g: 20, b: 30, a: 128}
    println(n.a)
    gy := color.Gray{y: 128}
    println(gy.y)
    show_bool(c.a == 255)
    << 0
}
