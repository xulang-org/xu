@main
// Go-parity stdlib wave 55: encoding.base32 RawHex encode + decode Err
#encoding/base32

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn raw_hex_decode_fails(s string) bool {
    base32.raw_hex_decode_string(s) or (err) { << true }
    << false
}

fn main() int {
    println(base32.raw_hex_encode_to_string("foo"))
    println(base32.raw_hex_decode_string("CPNMU") or (err) { << 1 })
    show_bool(raw_hex_decode_fails("CPNMU="))
    << 0
}
