@main
// B1b: bufio.unread_byte / read_slice / available
#bufio
#io

fn main() int {
    mut r := bufio.new_reader(io.buffer_from("XY"))
    println(r.read_byte() or (err) { << 1 })
    println(r.unread_byte() or (err) { << 1 })
    println(r.read_byte() or (err) { << 1 })
    mut s := bufio.new_reader(io.buffer_from("a,b"))
    println(s.read_slice(44) or (err) { << 1 })
    mut w := bufio.new_writer_size(io.buffer(), 8)
    println(w.available())
    << 0
}
