@main
// Nested xu first-start (not resume of a zero jmpbuf).
fn inner(s string, n int) {
    println(s)
    println(n)
}

fn outer() {
    r := "nested"
    xu inner(r + "", 9)
    mut i := 0
    while i < 20000000 {
        i = i + 1
    }
}

fn main() int {
    xu outer()
    mut i := 0
    while i < 40000000 {
        i = i + 1
    }
    << 0
}
