@main
// B0c: cmp.compare_int / slices.binary_search / sort.reverse_ints
#cmp
#slices
#sort

fn main() int {
    println(cmp.compare_int(1, 2))
    a := [1, 3, 5]
    r := slices.binary_search_ints(&a, 3)
    println(r.index)
    println(r.found)
    mut b := []int{}
    b.push(1)
    b.push(3)
    b.push(2)
    sort.reverse_ints(mut &b)
    println(b[0])
    << 0
}
