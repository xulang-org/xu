@main
// Go-parity stdlib wave 2 (hash/fnv + encoding/base64 + strings/math 深化).
#hash/fnv
#encoding/base64
#strings
#math

fn main() int {
    hello := "hello"
    println(fnv.fnv32a(&hello))
    println(fnv.fnv64a(&hello))
    println(base64.encode_to_string("Xu"))
    println(base64.decode_string("aGVsbG8=") or (err) { << 1 })
    banana := "banana"
    println(strings.replace(&banana, "an", "X", 1))
    abc := "AbC"
    println(strings.to_lower(&abc))
    println(strings.has_prefix(&hello, "he"))
    println(strings.trim(&banana, "ba"))
    e := math.exp(1.0)
    println(e > 2.71828 && e < 2.71829)
    println(math.hypot(3.0, 4.0))
    << 0
}
