@main
// Gen1 parse_int builtin: checked accumulate + INT_MIN asymmetric bound.
// Dual-table: bootstrap ≡ Gen1 stdout (mirrors tests/fixtures/parse_int_range).

#errors

fn parse_fails(s string) bool {
    parse_int(s) or (err) {
        << true
    }
    << false
}

fn main() int {
    println(parse_int("42") or (err) { << 1 })
    println(parse_int("-42") or (err) { << 1 })
    println(parse_int("0") or (err) { << 1 })
    println(parse_int("9223372036854775807") or (err) { << 1 })
    println(parse_int("-9223372036854775808") or (err) { << 1 })
    println(parse_fails("9223372036854775808"))
    println(parse_fails("-9223372036854775809"))
    println(parse_fails(""))
    println(parse_fails("-"))
    println(parse_fails("+5"))
    println(parse_fails("12a"))
    << 0
}
