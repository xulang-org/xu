@main
// Go-parity stdlib wave 45: encoding.base32 StdEncoding
#encoding/base32

fn main() int {
    println(base32.encode_to_string("foo"))
    println(base32.decode_string("MZXW6===") or (err) { << 1 })
    round := base32.encode_to_string("Hello, Xu!")
    println(base32.decode_string(round) or (err) { << 1 })
    << 0
}
