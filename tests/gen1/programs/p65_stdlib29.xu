@main
// Go-parity stdlib wave 29: encoding.json quote/unquote + round-trip
#encoding/json

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    src := "{\"a\":[1,true,null,\"x\"],\"b\":{\"c\":-2.5e3},\"d\":\"\"}"
    d := json.parse(&src)
    rt := d.to_json()
    d3 := json.parse(&rt)
    show_bool(d3.ok())
    show_bool(d3.to_json() == rt)

    nl := string_from_byte(10)
    tab := string_from_byte(9)
    q := "a" + nl + "b" + tab + "c" + "\"" + "d"
    println(json.quote(&q))
    q2 := "\"a\\nb\\u0041\""
    u := json.unquote(&q2) or (err) { << 1 }
    show_bool(true)
    show_bool(u == "a" + nl + "bA")
    << 0
}
