@main
// Go-parity stdlib wave 91: crypto.subtle constant-time compare
#crypto/subtle

fn main() int {
    a := "abcd"
    b := "abcd"
    c := "abce"
    println(subtle.constant_time_compare(&a, &b))
    println(subtle.constant_time_compare(&a, &c))
    println(subtle.constant_time_byte_eq(7, 7))
    println(subtle.constant_time_select(1, 9, 3))
    << 0
}
