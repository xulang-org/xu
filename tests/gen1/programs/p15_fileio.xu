@main
#errors
fn main() int {
    argv := args()
    if argv.len < 2 {
        println("missing-output-path")
        << 3
    }
    text := read_file("tests/gen1/programs/p1_hello.xu") or (err) {
        println("read-err")
        << 1
    }
    println(text[0])
    println(text.len)
    write_file(argv[1], text) or (err) {
        println("write-err")
        << 2
    }
    << 0
}
