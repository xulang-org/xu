@main

// M154: bootstrap ≡ gen1 for mut / through-& method values.

struct Counter {
    n int
}

struct Point {
    x int
}

fn (c &mut Counter) incr() {
    c.n += 1
}

fn (p Point) get() int {
    << p.x
}

fn main() int {
    mut c := Counter{n: 0}
    f := c.incr
    f()
    println(c.n)

    p := Point{x: 7}
    r := &p
    g := r.get
    println(g())
    << 0
}
