@main
// Go-parity stdlib wave 69: crypto.cipher PKCS7 + CBC
#crypto/aes
#crypto/cipher

fn main() int {
    key := "0123456789abcdef"
    iv := "0123456789abcdef"
    c := aes.new_cipher(&key) or (err) { << 1 }
    msg := "hi"
    ct := cipher.encrypt_cbc_pkcs7(&c, &iv, &msg) or (err) { << 1 }
    println(cipher.decrypt_cbc_pkcs7(&c, &iv, &ct) or (err) { << 1 })
    << 0
}
