@main
// Go-parity stdlib wave 94: compress.lzw encode/decode
#compress/lzw

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    hw := "hello world"
    enc := lzw.encode(&hw, lzw.lsb, 8) or (err) { << 1 }
    back := lzw.decode(&enc, lzw.lsb, 8) or (err) { << 1 }
    show_bool(back == hw)
    << 0
}
