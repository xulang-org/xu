@main
// Go-parity stdlib wave 103: bufio.Scanner split_func
#bufio
#io

fn split_semi(data string, at_eof int) bufio.SplitResult {
    if data.len == 0 {
        << bufio.split_ok(0, "")
    }
    mut i := 0
    while i < data.len {
        if (data[i] & 255) == 59 {
            mut tok := ""
            if i > 0 {
                tok = data[0:i] + ""
            }
            << bufio.split_ok(i + 1, tok)
        }
        i = i + 1
    }
    if at_eof != 0 {
        << bufio.split_ok(data.len, data + "")
    }
    << bufio.split_ok(0, "")
}

fn main() int {
    mut s := bufio.new_scanner(io.buffer_from("a;b"))
    s.split_func(split_semi)
    while s.scan() {
        println(s.text())
    }
    << 0
}
