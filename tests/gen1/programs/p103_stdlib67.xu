@main
// Go-parity stdlib wave 67: encoding.base32 Hello, Xu! 四路往返
#encoding/base32

fn main() int {
    round := base32.encode_to_string("Hello, Xu!")
    println(base32.decode_string(round) or (err) { << 1 })
    round2 := base32.hex_encode_to_string("Hello, Xu!")
    println(base32.hex_decode_string(round2) or (err) { << 1 })
    round3 := base32.raw_encode_to_string("Hello, Xu!")
    println(base32.raw_decode_string(round3) or (err) { << 1 })
    round4 := base32.raw_hex_encode_to_string("Hello, Xu!")
    println(base32.raw_hex_decode_string(round4) or (err) { << 1 })
    << 0
}
