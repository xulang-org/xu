@main
// Go-parity stdlib wave 68: html.template {{else if}} only
#html/template

fn main() int {
    ht := template.new("{{if .A}}x{{else if .B}}<b>{{.B}}</b>{{end}}")
    mut hd := template.new_dict()
    hd.set("B", "<em>")
    println(template.execute(&ht, &hd))
    mut hd2 := template.new_dict()
    hd2.set("A", "1")
    println(template.execute(&ht, &hd2))
    << 0
}
