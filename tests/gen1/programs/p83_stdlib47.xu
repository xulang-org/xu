@main
// Go-parity stdlib wave 47: text.template nested if in else-if branch
#text/template

fn main() int {
    t := template.new("{{if .A}}a{{else if .B}}{{if .C}}bc{{else}}b{{end}}{{else}}z{{end}}")
    mut d := template.new_dict()
    d.set("A", "")
    d.set("B", "1")
    d.set("C", "1")
    println(template.execute(&t, &d) or (err) { << 1 })
    mut d2 := template.new_dict()
    println(template.execute(&t, &d2) or (err) { << 1 })
    << 0
}
