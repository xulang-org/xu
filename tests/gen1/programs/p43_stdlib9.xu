@main
#fmt

fn sum_ints(xs <-> int) int {
    mut t := 0
    for x in xs {
        t = t + x
    }
    << t
}

fn main() int {
    println(sum_ints(1, 2, 3, 4))
    println(sum_ints())
    println(fmt.sprintf("s=%d s=%s", fmt.i(42), fmt.s("hi")) or (err) { << 1 })
    println(fmt.sprintf("%f", fmt.f(3.14)) or (err) { << 1 })
    println(fmt.sprintf("%%") or (err) { << 1 })
    println(fmt.sprint(fmt.i(1), fmt.i(2), fmt.i(3)))
    println(fmt.sprintln(fmt.i(7)))
    println(sum_ints())
    << 0
}
