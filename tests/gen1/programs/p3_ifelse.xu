@main
fn classify(x int) int {
    if x < 0 {
        << -1
    }
    if x == 0 {
        << 0
    }
    << 1
}
fn main() int {
    println(classify(-5))
    println(classify(0))
    println(classify(9))
    if 1 < 2 && 2 < 3 {
        println("and")
    }
    if 1 > 2 || 3 > 2 {
        println("or")
    }
    if !(1 == 2) {
        println("not")
    }
    mut x := 5
    if x >= 5 {
        println("ge")
    } else if x >= 3 {
        println("ge3")
    } else {
        println("small")
    }
    << 0
}
