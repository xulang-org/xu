@main
// Go-parity stdlib wave 74: crypto.cipher AES-CBC PKCS7 round-trip
#crypto/aes
#crypto/cipher
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    key := hex.decode_string("2b7e151628aed2a6abf7158809cf4f3c") or (err) { << 1 }
    iv := hex.decode_string("000102030405060708090a0b0c0d0e0f") or (err) { << 1 }
    pt := "Hello, Xu!"
    c := aes.new_cipher(&key) or (err) { << 1 }
    ct := cipher.encrypt_cbc_pkcs7(&c, &iv, &pt) or (err) { << 1 }
    back := cipher.decrypt_cbc_pkcs7(&c, &iv, &ct) or (err) { << 1 }
    show_bool(back == pt)
    << 0
}
