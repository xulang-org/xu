@main

// M148: bootstrap ≡ gen1 for >6 direct-call args (regs + stack).

fn sum8(a int, b int, c int, d int, e int, f int, g int, h int) int {
    << a + b + c + d + e + f + g + h
}

fn tag8(a int, b int, c int, d int, e int, f int, g int, s string) string {
    << str(a + b + c + d + e + f + g) + ":" + s
}

fn main() int {
    println(str(sum8(1, 2, 3, 4, 5, 6, 7, 8)))
    println(tag8(1, 2, 3, 4, 5, 6, 7, "ok"))
    << 0
}
