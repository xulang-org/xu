@main
// Go-parity stdlib wave 43: image.color CMYK rgba() + cmyk_to_rgb
#image/color

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    ck := color.rgb_to_cmyk(255, 0, 0)
    cp := ck.rgba()
    println(cp.r)
    println(cp.g)
    println(cp.b)
    println(cp.a)
    rgb := color.cmyk_to_rgb(ck.c, ck.m, ck.y, ck.k)
    println(rgb.r)
    show_bool(cp.r == 65535)
    << 0
}
