@main
// Go-parity stdlib wave 24: encoding.xml
#encoding/xml

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn xml_token_fails(d xml.Decoder) bool {
    mut dd := d
    dd.token() or (err) { << true }
    << false
}

fn main() int {
    raw := "a<b>&\"'"
    esc := xml.escape_text(&raw)
    println(esc)
    println(xml.unescape_string(&esc))
    src := "<root a=\"1\"><item>x&amp;y</item></root>"
    mut d := xml.new_decoder(&src)
    t0 := d.token() or (err) { << 1 }
    println(t0.kind)
    println(t0.name)
    t1 := d.token() or (err) { << 1 }
    println(t1.kind)
    println(t1.name)
    t2 := d.token() or (err) { << 1 }
    println(t2.kind)
    println(t2.text)
    show_bool(xml_token_fails(d))
    << 0
}
