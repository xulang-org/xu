@main

// M151: bootstrap ≡ gen1 for reference field rebind.

struct Holder {
    r &mut string
}

fn main() int {
    mut first := "a" + "b"
    mut second := "c" + "d"
    mut h := Holder{r: mut &first}
    h.r = mut &second
    h.r.push_str("x")
    println(second)
    first = "z"
    println(first)
    << 0
}
