@main
// F4: multi-slot xu args — a two-field struct AND a string arrive intact
// (regression for go arguments being treated as single-slot words).
// Gen1 ≡ bootstrap observable behavior (§6 dual-table compare).
struct Pair {
    a int
    b int
}

fn worker(p Pair, s string) {
    println(p.a + p.b)
    println(s.len)
    println(s)
}

fn main() int {
    xu worker(Pair{a: 20, b: 22}, "hello")
    // Keep main alive until the goroutine's preamble has copied the args
    // (MC mode runs `go` on a pthread).
    mut i := 0
    while i < 20000000 {
        i = i + 1
    }
    << 0
}
