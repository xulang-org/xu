@main
// Go-parity stdlib wave 48: encoding.base32 len helpers + decode errors
#encoding/base32

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn decode_fails(s string) bool {
    base32.decode_string(s) or (err) { << true }
    << false
}

fn main() int {
    show_bool(decode_fails("MZXW6=="))
    show_bool(decode_fails("!!!!===="))
    println(base32.encoded_len(3))
    println(base32.decoded_len(8))
    << 0
}
