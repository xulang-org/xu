@main

#errors

// Field store whose RHS mutates the same struct (Gen1 used a scratch
// copy; the stale write-back lost the RHS's pushes). Also covers `or`
// after a may-throw call in let position.
struct D {
    kinds []int
    root_idx int
    s string
}

fn (d &mut D) mk() int {
    d.kinds.push(9)
    d.s = "via-rhs"
    << d.kinds.len - 1
}

fn half(n int) int {
    if n == 0 {
        >> errors.new("zero")
    }
    << n / 2
}

fn use_try(n int) int {
    x := half(n)
    << x + 100
}

fn main() int {
    mut d := D{kinds: []int{}, root_idx: -1, s: ""}
    d.root_idx = d.mk()
    println(d.kinds.len)
    println(d.root_idx)
    println(d.s)
    t := use_try(8) or (err) {
        << 1
    }
    println(true)
    println(t)
    << 0
}
