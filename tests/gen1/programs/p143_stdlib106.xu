@main
// Go-parity stdlib wave 106: index.suffixarray find_all_index
#index/suffixarray

fn main() int {
    data := "banana"
    ix := suffixarray.new(&data)
    q := "ana"
    all := 0 - 1
    ms := suffixarray.find_all_index(&ix, &q, all)
    println(ms.len)
    println(ms[0].from)
    println(ms[0].to)
    << 0
}
