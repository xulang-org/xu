@main
// Go-parity stdlib wave 9 (os fs ops + sync/atomic + Once/RWMutex +
// strconv stable output). Five segments combined.
#os
#sync
#strconv

fn drop_quiet(p string) {
    os.remove(p) or (err) {
        <<
    }
}

fn stat_fails(path string) bool {
    os.stat(path) or (err) {
        << true
    }
    << false
}

fn main() int {
    // 1. os fs chain. Self-cleaning: gen1_test runs the program twice
    // (bootstrap then gen1) in the same cwd, so the leading removes make the
    // second run start from a clean state and the trailing removes restore it.
    drop_quiet("p42_m35_b.txt")
    drop_quiet("p42_m35_a.txt")
    drop_quiet("p42_m35_dir")
    os.mkdir("p42_m35_dir") or (err) {
        println(false)
        << 0
    }
    println(true)
    println(os.is_dir("p42_m35_dir"))
    os.write("p42_m35_dir/a.txt", "hello") or (err) {
        println(false)
        << 0
    }
    println(true)
    os.stat("p42_m35_dir/a.txt") or (err) {
        println(false)
        << 0
    }
    println(true)
    fi := os.stat("p42_m35_dir/a.txt") or (err) { << 1 }
    println(fi.size == 5)
    println(fi.is_dir == false)
    os.rename("p42_m35_dir/a.txt", "p42_m35_dir/b.txt") or (err) {
        println(false)
        << 0
    }
    println(true)
    println(stat_fails("p42_m35_dir/a.txt"))
    os.remove("p42_m35_dir/b.txt") or (err) {
        println(false)
        << 0
    }
    println(true)
    os.remove("p42_m35_dir") or (err) {
        println(false)
        << 0
    }
    println(true)
    println(stat_fails("p42_m35_dir"))

    // 2. sync/atomic.
    mut a := 0
    sync.store_int(mut &a, 10)
    println(sync.load_int(mut &a))
    println(sync.add_int(mut &a, 5))
    println(sync.load_int(mut &a))
    println(sync.compare_and_swap_int(mut &a, 15, 200))
    println(sync.load_int(mut &a))

    // 3. sync.Once.
    mut o := sync.once()
    println(o.first_time())
    println(o.first_time())

    // 4. sync.RWMutex.
    mut m := sync.rw_mutex()
    mut v := 0
    m.write_lock()
    v = 42
    m.write_unlock()
    m.read_lock()
    println(v)
    m.read_unlock()

    // 5. Existing package (strconv stable output).
    println(strconv.itoa(-42))
    s := "12345"
    println((strconv.atoi(&s) or (err) { << 1 }) + 1)
    << 0
}
