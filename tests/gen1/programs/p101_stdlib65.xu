@main
// Go-parity stdlib wave 65: html.template execute_str + dict 同程序
#html/template

fn main() int {
    t2 := template.new("Hi {{.}}!")
    println(template.execute_str(&t2, "a&b\"c"))
    t := template.new("<p>{{.Name}}</p>")
    mut d := template.new_dict()
    d.set("Name", "<script>")
    println(template.execute(&t, &d))
    << 0
}
