@main
// Go-parity stdlib wave 105: crypto.cipher AES-GCM
#crypto/aes
#crypto/cipher
#encoding/hex

fn main() int {
    key := hex.decode_string("feffe9928665731c6d6a8f9467308308") or (err) { << 1 }
    nonce := hex.decode_string("cafebabefacedbaddecaf888") or (err) { << 1 }
    empty := ""
    msg := "hi"
    c := aes.new_cipher(&key) or (err) { << 1 }
    sealed := cipher.seal_gcm(&c, &nonce, &msg, &empty) or (err) { << 1 }
    println(cipher.open_gcm(&c, &nonce, &sealed, &empty) or (err) { << 1 })
    << 0
}
