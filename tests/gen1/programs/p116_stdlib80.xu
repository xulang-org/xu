@main
// Go-parity stdlib wave 80: html.template execute + execute_list facade
#html/template

fn main() int {
    t := template.new("<p>{{.Name}}</p>")
    mut d := template.new_dict()
    d.set("Name", "<script>")
    println(template.execute(&t, &d))
    t2 := template.new("{{range .}}<li>{{.}}</li>{{end}}")
    mut items := []string{}
    items.push("<a>")
    items.push("b")
    println(template.execute_list(&t2, items))
    << 0
}
