@main
// Go-parity stdlib wave 59: html.template {{if}} + {{range}} execute_list
#html/template

fn main() int {
    t := template.new("{{if .Ok}}yes {{.Ok}}{{else}}no{{end}}")
    mut d := template.new_dict()
    d.set("Ok", "<x>")
    println(template.execute(&t, &d))
    mut d2 := template.new_dict()
    println(template.execute(&t, &d2))
    t2 := template.new("{{range .}}<li>{{.}}</li>{{end}}")
    mut items := []string{}
    items.push("<a>")
    items.push("b")
    println(template.execute_list(&t2, items))
    << 0
}
