@main
// Go-parity stdlib wave 8 (encoding/binary + math/bits + strconv 浮点 +
// unicode 分类表 + bufio).
#encoding/binary
#math/bits
#strconv
#unicode
#bufio
#io

fn main() int {
    // encoding/binary: roundtrip via little/big endian.
    mut buf := []int{}
    for i in 0:8 {
        buf.push(0)
    }
    be := binary.big_endian()
    le := binary.little_endian()
    be.put_u64(mut &buf, 0, 0x0102030405060708) or (err) { << 1 }
    println(be.get_u64(&buf, 0) or (err) { << 1 })
    le.put_u32(mut &buf, 4, 305419896) or (err) { << 1 }
    println(le.get_u32(&buf, 4) or (err) { << 1 })
    println(be.get_u16(&buf, 0) or (err) { << 1 })

    // math/bits: boundary + rotate behaviour.
    println(bits.len(0))
    println(bits.leading_zeros(1))
    println(bits.trailing_zeros(1 << 12))
    println(bits.ones_count(-1))
    println(bits.rotate_left(1, 63))
    println(bits.rotate_right(1, 1))
    println(bits.reverse_bytes(0x0102030405060708))
    println(bits.reverse(1))

    // strconv: parse + shortest 'g' formatting (round-trip).
    pi := "3.14159"
    f1 := strconv.parse_float(&pi) or (err) { << 1 }
    println(strconv.format_float(f1, 103, -1) or (err) { << 1 })
    e21 := "1e21"
    f2 := strconv.parse_float(&e21) or (err) { << 1 }
    println(strconv.format_float(f2, 102, 2) or (err) { << 1 })
    neg0 := "-0"
    f3 := strconv.parse_float(&neg0) or (err) { << 1 }
    println(strconv.format_float(f3, 101, 2) or (err) { << 1 })

    // unicode: category lookups + case mapping.
    println(unicode.is_letter(0x4E8C))
    println(unicode.is_digit(0x0039))
    println(unicode.is_upper(0x03A3))
    println(unicode.is_lower(0x03C3))
    println(unicode.is_space(0x00A0))
    println(unicode.to_upper(0x00DF))
    println(unicode.to_lower(0x0130))

    // bufio: writer buffering + reader lines over io.Buffer.
    mut dst := io.buffer()
    mut w := bufio.new_writer(dst)
    w.write_string("hello\nworld\n") or (err) { << 1 }
    w.flush() or (err) { << 1 }
    println(w.bytes())
    mut src := io.buffer_from("abc\ndef\nxyz")
    mut r := bufio.new_reader(src)
    println(r.read_line() or (err) { << 1 })
    println(r.peek(3) or (err) { << 1 })
    println(r.read_string(10) or (err) { << 1 })
    << 0
}
