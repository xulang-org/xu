@main
// Go-parity stdlib wave 31: log ldate/ltime flags (UTC)
#log
#fmt

fn main() int {
    mut l := log.new_logger()
    l.set_output_buffer()
    l.set_flags(log.lstd_flags)
    l.print(fmt.s("ok"))
    b := l.buffer_text()
    if (b[4] & 255) == 47 && (b[13] & 255) == 58 {
        println("true")
    } else {
        println("false")
    }
    println(log.lstd_flags)
    << 0
}
