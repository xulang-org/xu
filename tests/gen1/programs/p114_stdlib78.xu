@main
// Go-parity stdlib wave 78: crypto.cipher AES-CBC NIST vector
#crypto/aes
#crypto/cipher
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    key := hex.decode_string("2b7e151628aed2a6abf7158809cf4f3c") or (err) { << 1 }
    iv := hex.decode_string("000102030405060708090a0b0c0d0e0f") or (err) { << 1 }
    pt := hex.decode_string("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e51") or (err) { << 1 }
    want := "7649abac8119b246cee98e9b12e9197d5086cb9b507219ee95db113a917678b2"
    c := aes.new_cipher(&key) or (err) { << 1 }
    ct := cipher.encrypt_cbc(&c, &iv, &pt) or (err) { << 1 }
    println(hex.encode_to_string(ct + ""))
    show_bool(hex.encode_to_string(ct + "") == want)
    back := cipher.decrypt_cbc(&c, &iv, &ct) or (err) { << 1 }
    show_bool(back == pt)
    << 0
}
