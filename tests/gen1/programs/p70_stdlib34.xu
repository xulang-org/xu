@main
// Go-parity stdlib wave 34: image rect/point ops
#image
#image/color

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    r := image.rect(0, 0, 2, 2)
    println(r.dx())
    println(r.dy())
    show_bool(r.empty() == false)
    show_bool(image.pt(1, 1).in_rect(r))
    inter := r.intersect(image.rect(1, 0, 3, 2))
    println(inter.min.x)
    println(inter.dx())
    mut img := image.new_rgba(r)
    img.set_rgba(0, 0, color.rgba8(10, 20, 30, 255))
    got := img.at_rgba(0, 0)
    println(got.r)
    println(got.g)
    println(got.b)
    println(got.a)
    println(img.pix_offset(1, 1))
    << 0
}
