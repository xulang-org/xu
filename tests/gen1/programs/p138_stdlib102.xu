@main
// Go-parity stdlib wave 102: html.template {{with}} + execute_list
#html/template

fn main() int {
    t := template.new("{{with .X}}<b>{{.}}</b>{{else}}none{{end}}")
    mut d := template.new_dict()
    d.set("X", "<em>")
    println(template.execute(&t, &d))
    mut d2 := template.new_dict()
    println(template.execute(&t, &d2))
    t2 := template.new("{{range .}}<li>{{.}}</li>{{end}}")
    mut items := []string{}
    items.push("<a>")
    items.push("b")
    println(template.execute_list(&t2, items))
    << 0
}
