@main
// Go-parity stdlib wave 87: crypto.cipher AES-CTR
#crypto/aes
#crypto/cipher
#encoding/hex

fn main() int {
    key := hex.decode_string("2b7e151628aed2a6abf7158809cf4f3c") or (err) { << 1 }
    iv := hex.decode_string("f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff") or (err) { << 1 }
    msg := "Hi"
    c := aes.new_cipher(&key) or (err) { << 1 }
    ct := cipher.encrypt_ctr(&c, &iv, &msg) or (err) { << 1 }
    println(cipher.decrypt_ctr(&c, &iv, &ct) or (err) { << 1 })
    << 0
}
