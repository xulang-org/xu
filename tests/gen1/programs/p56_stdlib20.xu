@main
// Go-parity stdlib wave 20: image.png + container.ring
#encoding/hex
#image/png
#container/ring

fn main() int {
    gohex := "89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a730000001b49444154789c62facfc0c0f09f818591e1ff7f060640000000ffff1d2f0404f0915d150000000049454e44ae426082"
    raw := hex.decode_string(gohex + "") or (err) { << 1 }
    img := png.decode(&raw) or (err) { << 1 }
    a := img.at_rgba(0, 0)
    println(a.r)
    println(a.g)
    println(a.b)
    println(a.a)
    b := img.at_rgba(1, 0)
    println(b.g)
    c := img.at_rgba(0, 1)
    println(c.b)
    d := img.at_rgba(1, 1)
    println(d.r)
    println(d.g)
    println(d.b)

    mut r := ring.new(5)
    println(ring.len(&r))
    mut e := ring.cur(&r)
    mut i := 0
    while i < 5 {
        r.set_value(e, string_from_byte(65 + i))
        e = ring.next(&r, e)
        i = i + 1
    }
    vals := ring.values(&r)
    println(vals.len)
    for j in 0:vals.len {
        println(vals[j])
    }
    e = ring.cur(&r)
    e2 := ring.move(&r, e, 2)
    println(ring.value(&r, e2))
    << 0
}
