@main
// Go-parity stdlib wave 89: crypto.rc4 xor round-trip
#crypto/rc4
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    k := "Key"
    p := "Plaintext"
    mut c := rc4.new_cipher(&k) or (err) { << 1 }
    ct := c.xor_key_stream(&p)
    show_bool(hex.encode_to_string(ct + "") == "bbf316e8d940af0ad3")
    mut d := rc4.new_cipher(&k) or (err) { << 1 }
    back := d.xor_key_stream(&ct)
    show_bool(back == p)
    << 0
}
