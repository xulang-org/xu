@main
// M102/M103/M104: Ord.less (op_lt), bare fn value args, slice_func + f64s.
#sort

fn int_less(a int, b int) bool {
    << a < b
}

fn main() int {
    mut a := []int{}
    a.push(3)
    a.push(1)
    a.push(2)
    sort.slice_func(mut &a, int_less)
    println(a[0])
    println(a[2])

    mut f := []f64{}
    f.push(2.5)
    f.push(-1.0)
    f.push(3.75)
    if f[0].less(f[2]) {
        println(0)
    } else {
        println(1)
    }
    sort.f64s(mut &f)
    println(f[0])
    println(f[2])
    << 0
}
