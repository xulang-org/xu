@main
// Go-parity stdlib wave 99: crypto.hmac sum256
#crypto/hmac

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    k := "key"
    fox := "The quick brown fox jumps over the lazy dog"
    h1 := hmac.sum256(&k, &fox)
    h2 := hmac.sum256(&k, &fox)
    show_bool(hmac.equal(&h1, &h2))
    println(h1.len)
    << 0
}
