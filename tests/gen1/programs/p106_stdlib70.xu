@main
// Go-parity stdlib wave 70: encoding.base32 四路 decode Err 对称
#encoding/base32

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn decode_fails(s string) bool {
    base32.decode_string(s) or (err) { << true }
    << false
}

fn hex_decode_fails(s string) bool {
    base32.hex_decode_string(s) or (err) { << true }
    << false
}

fn raw_decode_fails(s string) bool {
    base32.raw_decode_string(s) or (err) { << true }
    << false
}

fn raw_hex_decode_fails(s string) bool {
    base32.raw_hex_decode_string(s) or (err) { << true }
    << false
}

fn main() int {
    show_bool(decode_fails("MZXW6=="))
    show_bool(hex_decode_fails("CPNMU=="))
    show_bool(raw_decode_fails("MZXW6="))
    show_bool(raw_hex_decode_fails("CPNMU="))
    << 0
}
