@main
// M108 positive: string field partial move in `select` clones; struct stays usable.
struct Pair {
    a string
    b int
}

fn take(s string) {
    println(s.len)
}

fn main() int {
    p := Pair{a: "x" + "z", b: 7}
    ch := chan int{cap: 1}
    ch <- 1
    select {
        x := <-ch {
            take(p.a)
            println(p.b)
            println(x)
        }
    }
    << 0
}
