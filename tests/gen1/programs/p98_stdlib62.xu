@main
// Go-parity stdlib wave 62: html.template {{if}} + {{with}} 同程序
#html/template

fn main() int {
    t := template.new("{{if .Ok}}yes {{.Ok}}{{else}}no{{end}}")
    mut d := template.new_dict()
    d.set("Ok", "<x>")
    println(template.execute(&t, &d))
    mut d2 := template.new_dict()
    println(template.execute(&t, &d2))
    t2 := template.new("{{with .X}}<b>{{.}}</b>{{else}}none{{end}}")
    mut d3 := template.new_dict()
    d3.set("X", "<em>")
    println(template.execute(&t2, &d3))
    mut d4 := template.new_dict()
    println(template.execute(&t2, &d4))
    << 0
}
