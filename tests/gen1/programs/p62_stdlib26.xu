@main
// Go-parity stdlib wave 26: encoding.json
#encoding/json

fn main() int {
    src := "{\"a\":[1,true,null,\"x\"],\"b\":{\"c\":-2.5e3},\"d\":\"\"}"
    d := json.parse(&src)
    println(d.ok())
    r := d.root()
    println(d.is_dict(r))
    println(d.count(r))
    a := d.get(r, "a")
    println(d.is_list(a))
    println(d.count(a))
    println(d.number_int(d.at(a, 0)) or (err) { << 1 })
    println(d.is_bool(d.at(a, 1)))
    println(d.is_null(d.at(a, 2)))
    println(d.text(d.at(a, 3)))
    b := d.get(r, "b")
    c := d.get(b, "c")
    println(d.is_number(c))
    println(d.text(c))
    println(d.to_json())
    bad := "{\"a\":1,}"
    e1 := json.parse(&bad)
    if e1.ok() {
        println("false")
    } else {
        println("true")
    }
    << 0
}
