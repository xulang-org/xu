@main
// Go-parity stdlib wave 21: image.gif decode
#encoding/hex
#image/gif

fn decode_gif_fails(raw &string) bool {
    gif.decode(raw) or (err) { << true }
    << false
}

fn main() int {
    gohex := "47494638396102000200800000000000ff00002c0000000002000200000203440205003b"
    raw := hex.decode_string(gohex + "") or (err) { << 1 }
    g := gif.decode(&raw) or (err) { << 1 }
    println(g.width)
    println(g.height)
    a := gif.at(&g, 0, 0)
    println(a.r)
    println(a.g)
    println(a.a)
    b := gif.at(&g, 1, 0)
    println(b.r)
    println(b.g)
    c := gif.at(&g, 0, 1)
    println(c.r)
    d := gif.at(&g, 1, 1)
    println(d.r)
    bad := "notgif"
    if decode_gif_fails(&bad) {
        println("true")
    } else {
        println("false")
    }
    << 0
}
