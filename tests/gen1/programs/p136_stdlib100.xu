@main
// Go-parity stdlib wave 100: crypto.cipher PKCS7 unpad Err
#crypto/cipher

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn unpad_pkcs7_fails(s &string) bool {
    cipher.unpad_pkcs7(s) or (err) { << true }
    << false
}

fn pad_pkcs7_fails(s &string, block int) bool {
    cipher.pad_pkcs7(s, block) or (err) { << true }
    << false
}

fn main() int {
    bad := "x"
    show_bool(unpad_pkcs7_fails(&bad))
    hi := "hi"
    show_bool(pad_pkcs7_fails(&hi, 0))
    << 0
}
