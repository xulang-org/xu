@main
// Go-parity stdlib wave 56: html.template dict/get + parse error
#html/template

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    t := template.new("<p>{{.Name}}</p>")
    mut d := template.new_dict()
    d.set("Name", "<script>")
    println(template.execute(&t, &d))
    show_bool(template.get(&d, "Name") == "<script>")
    bad := template.new("{{.X")
    // template.execute_str swallows errors as ''; empty means parse/exec fail.
    show_bool(template.execute_str(&bad, "z") == "")
    << 0
}
