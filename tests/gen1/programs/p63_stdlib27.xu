@main
// Go-parity stdlib wave 27: html.template (escape at interpolation)
#html/template

fn main() int {
    t := template.new("<b>{{.}}</b>")
    println(template.execute_str(&t, "<em>"))
    mut d := template.new_dict()
    d.set("X", "a&b")
    t2 := template.new("{{.X}}")
    println(template.execute(&t2, &d))
    << 0
}
