@main
// Gen2 smoke canary: named struct + field read/write must keep
// identifiers intact under Drop free (empty name class regression).
struct Point {
    x int
    y int
}

fn main() int {
    mut p := Point{x: 3, y: 4}
    println(p.x)
    println(p.y)
    p.x = 30
    p.y = 40
    println(p.x)
    println(p.y)
    << 0
}
