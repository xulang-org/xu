@main
// Go-parity stdlib wave 25: text.template + bufio.Scanner
#bufio
#io
#text/template

fn main() int {
    t1 := template.new("Hello, {{.}}!")
    println(template.execute_str(&t1, "Xu") or (err) { << 1 })

    mut d := template.new_dict()
    d.set("Name", "Ada")
    d.set("Lang", "Xu")
    t2 := template.new("{{.Name}} writes {{.Lang}}")
    println(template.execute(&t2, &d) or (err) { << 1 })

    mut s := bufio.new_scanner(io.buffer_from("a\nb\nc"))
    mut n := 0
    while s.scan() {
        println(s.text())
        n = n + 1
    }
    println(n)
    << 0
}
