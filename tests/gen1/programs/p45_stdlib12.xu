@main
// Go-parity stdlib wave 12: hash.crc32 + encoding.csv
#hash/crc32
#encoding/csv

fn main() int {
    s := "Xu"
    println(crc32.checksum_ieee(&s))
    mut w := csv.new_writer()
    row := ["a", "b,c"]
    w.write(&row)
    println(w.text())
    mut r := csv.new_reader(w.text())
    rec := r.read() or (err) { << 1 }
    println(rec.len)
    println(rec[1])
    << 0
}
