@main
// Go-parity stdlib wave 14: net IP + zlib + html
#net
#compress/zlib
#html

fn main() int {
    a := "127.0.0.1"
    ip := net.parse_ip(&a)
    println(net.ip_string(&ip))
    s := "Xu"
    mut w := zlib.new_writer()
    w.write(&s) or (err) { << 1 }
    w.close()
    mut r := zlib.new_reader(w.bytes())
    println(r.read_all() or (err) { << 1 })
    sp := "a<b"
    println(html.escape_string(&sp))
    << 0
}
