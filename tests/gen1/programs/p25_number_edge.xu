@main
// F3: str() at the integer boundaries. INT_MIN is written as
// -9223372036854775807 - 1 (the literal itself stays out of source).
// G7: the digit loop folds the sign per digit instead of negating first,
// so str(INT_MIN) == "-9223372036854775808" and str(INT_MAX) round-trips.
// Gen1 ≡ bootstrap observable behavior (§6 dual-table compare).
fn main() int {
    println(str(-9223372036854775807 - 1))
    println(str(9223372036854775807))
    println(str(-123456789))
    println(str(-1))
    println(str(0))
    << 0
}
