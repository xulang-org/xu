@main
// Go-parity stdlib wave 54: text.template {{range}} + execute_list
#text/template

fn main() int {
    t := template.new("{{range .}}-{{.}}-{{end}}")
    mut items := []string{}
    items.push("a")
    items.push("b")
    items.push("c")
    println(template.execute_list(&t, items) or (err) { << 1 })
    << 0
}
