@main
fn main() int {
    mut sum := 0
    for i in 0:10 {
        sum += i
    }
    println(sum)
    mut prod := 1
    for i in 1:6 {
        prod = prod * i
    }
    println(prod)
    mut total := 0
    for i in 0:4 {
        for j in 0:3 {
            total += i * j
        }
    }
    println(total)
    << 0
}
