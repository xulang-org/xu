@main
// Go-parity stdlib wave 76: text.template execute_html + execute_list_html
#text/template

fn main() int {
    mut d := template.new_dict()
    d.set("X", "<script>")
    t := template.new("{{.X}}")
    println(template.execute_html(&t, &d) or (err) { << 1 })
    t2 := template.new("{{range .}}|{{.}}|{{end}}")
    mut items := []string{}
    items.push("<a>")
    items.push("b")
    println(template.execute_list_html(&t2, items) or (err) { << 1 })
    << 0
}
