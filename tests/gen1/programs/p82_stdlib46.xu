@main
// Go-parity stdlib wave 46: html.template range + with
#html/template

fn main() int {
    t := template.new("{{range .}}<li>{{with .}}<b>{{.}}</b>{{else}}e{{end}}</li>{{end}}")
    mut items := []string{}
    items.push("<a>")
    items.push("")
    println(template.execute_list(&t, items))
    << 0
}
