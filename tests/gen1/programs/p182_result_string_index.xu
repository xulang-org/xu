@main
// m34: returning array[i] must heap-clone the string element
// (not alias freed storage). Formerly exercised via Result Ok(...).
fn via_index() string {
    a := ["ab" + "c"]
    << a[0]
}

fn via_local() string {
    a := ["xy" + "z"]
    out := a[0]
    << out
}

fn main() int {
    s := via_index()
    println(s.len)
    println(s)
    t := via_local()
    println(t.len)
    println(t)
    << 0
}
