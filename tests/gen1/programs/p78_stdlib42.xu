@main
// Go-parity stdlib wave 42: html.template else-if + with
#html/template

fn main() int {
    ht := template.new("{{if .A}}x{{else if .B}}<b>{{.B}}</b>{{end}}")
    mut hd := template.new_dict()
    hd.set("B", "<em>")
    println(template.execute(&ht, &hd))
    t := template.new("{{with .X}}<b>{{.}}</b>{{else}}none{{end}}")
    mut d := template.new_dict()
    d.set("X", "<em>")
    println(template.execute(&t, &d))
    mut d2 := template.new_dict()
    println(template.execute(&t, &d2))
    << 0
}
