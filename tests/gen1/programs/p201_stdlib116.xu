@main
// B2a: time.date / weekday / truncate
#time

fn main() int {
    t := time.date(2000, 1, 2, 3, 4, 5, 0)
    println(t.year())
    println(t.month())
    println(t.day())
    println(t.weekday())
    u := time.unix(1, 500000000)
    tr := u.truncate(time.second())
    println(tr.nsec)
    << 0
}
