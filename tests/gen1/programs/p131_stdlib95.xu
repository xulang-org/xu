@main
// Go-parity stdlib wave 95: hash.maphash bytes + of_string
#hash/maphash

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    hello := "hello"
    h1 := maphash.bytes(1, &hello)
    h1b := maphash.of_string(1, &hello)
    show_bool(h1 == h1b)
    h2 := maphash.bytes(2, &hello)
    show_bool(h1 != h2)
    << 0
}
