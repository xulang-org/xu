@main
// Go-parity stdlib wave 81: crypto.cipher CBC empty + Err paths
#crypto/aes
#crypto/cipher
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn encrypt_cbc_fails(c &aes.Cipher, iv &string, pt &string) bool {
    cipher.encrypt_cbc(c, iv, pt) or (err) { << true }
    << false
}

fn main() int {
    key := hex.decode_string("2b7e151628aed2a6abf7158809cf4f3c") or (err) { << 1 }
    iv := hex.decode_string("000102030405060708090a0b0c0d0e0f") or (err) { << 1 }
    pt := hex.decode_string("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e51") or (err) { << 1 }
    c := aes.new_cipher(&key) or (err) { << 1 }
    empty := ""
    z := cipher.encrypt_cbc(&c, &iv, &empty) or (err) { << 1 }
    println(z.len)
    short := "nope"
    show_bool(encrypt_cbc_fails(&c, &iv, &short))
    badiv := "short"
    show_bool(encrypt_cbc_fails(&c, &badiv, &pt))
    << 0
}
