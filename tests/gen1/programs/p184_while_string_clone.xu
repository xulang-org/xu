@main
// M108 positive: string field partial move in `while` clones; struct stays usable.
struct Pair {
    a string
    b int
}

fn take(s string) {
    println(s.len)
}

fn main() int {
    p := Pair{a: "x" + "z", b: 7}
    mut i := 0
    while i < 1 {
        take(p.a)
        println(p.b)
        i = i + 1
    }
    << 0
}
