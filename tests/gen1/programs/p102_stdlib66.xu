@main
// Go-parity stdlib wave 66: text.template execute_*_html escape
#text/template

fn main() int {
    t := template.new("<b>{{.}}</b>")
    println(template.execute_str_html(&t, "<em>") or (err) { << 1 })
    mut d := template.new_dict()
    d.set("X", "<script>")
    t2 := template.new("{{.X}}")
    println(template.execute_html(&t2, &d) or (err) { << 1 })
    << 0
}
