@main
// G2: crypto/sm4 GB/T 32907 example 1
#crypto/sm4
#encoding/hex

fn main() int {
    key := hex.decode_string("0123456789abcdeffedcba9876543210") or (err) { << 1 }
    c := sm4.new_cipher(&key) or (err) { << 1 }
    ct := c.encrypt(&key) or (err) { << 1 }
    println(hex.encode_to_string(ct + ""))
    << 0
}
