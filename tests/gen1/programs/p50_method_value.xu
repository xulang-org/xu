@main
// M110: value-receiver method value (p.less) + indirect call through fn param.
struct Point {
    x int
}

fn (p Point) less(other Point) bool {
    << p.x < other.x
}

fn apply(f fn(Point) bool, q Point) bool {
    << f(q)
}

fn main() int {
    p := Point{x: 1}
    q := Point{x: 2}
    r := Point{x: 0}
    f1 := p.less
    if apply(f1, q) {
        println(1)
    } else {
        println(0)
    }
    f2 := p.less
    if apply(f2, r) {
        println(1)
    } else {
        println(0)
    }
    << 0
}
