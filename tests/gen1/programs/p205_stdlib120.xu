@main
// B3b: math/big.Rat + math/rand.perm
#math/big
#math/rand

fn main() int {
    mut r := big.new_rat(1, 2)
    mut s := big.new_rat(1, 3)
    mut z := big.new_rat(0, 1)
    z.add(&r, &s)
    n := z.num()
    d := z.denom()
    println(n.text())
    println(d.text())
    mut src := rand.new_source(1)
    p := src.perm(3)
    println(p.len)
    println(p[0] + p[1] + p[2] == 3)
    << 0
}
