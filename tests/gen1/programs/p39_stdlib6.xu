@main
// Go-parity wave 6: import 别名（alias path 形状）。
js #encoding/json
sc #strconv

fn main() int {
    src := "{\"a\":[1,true]}"
    d := js.parse(&src)
    println(d.ok())
    a := d.get(d.root(), "a")
    println(d.count(a))
    seven := "7"
    println(sc.parse(&seven, 10) or (err) { << 1 })
    println(sc.itoa(99))
    es := "q"
    println(js.quote(&es))
    << 0
}
