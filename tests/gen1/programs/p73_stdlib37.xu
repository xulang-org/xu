@main
// Go-parity stdlib wave 37: image.draw op_src (matches image_draw fixture tail)
#image
#image/color
#image/draw

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    mut dst := image.new_rgba(image.rect(0, 0, 2, 2))
    red := color.rgba8(255, 0, 0, 255)
    dst.set_rgba(0, 0, red)
    dst.set_rgba(1, 1, red)
    mut src := image.new_rgba(image.rect(0, 0, 2, 2))
    src.set_rgba(0, 0, color.rgba8(0, 0, 128, 128))
    src.set_rgba(1, 0, color.rgba8(0, 255, 0, 255))
    draw.draw_rgba(mut &dst, image.rect(0, 0, 1, 1), &src, image.pt(1, 0), draw.op_src)
    s0 := dst.at_rgba(0, 0)
    println(s0.r)
    println(s0.g)
    println(s0.b)
    println(s0.a)
    s1 := dst.at_rgba(1, 1)
    println(s1.r)
    println(s1.a)
    show_bool(s0.g == 255)
    show_bool(s1.r == 255)
    << 0
}
