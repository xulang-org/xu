@main
// Go-parity stdlib wave 18: archive.tar + archive.zip
#archive/tar
#archive/zip

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn tar_next_eof(r tar.Reader) bool {
    mut rr := r
    rr.next() or (err) { << true }
    << false
}

fn zip_next_err(r zip.Reader) bool {
    mut rr := r
    rr.next() or (err) { << true }
    << false
}

fn main() int {
    mut tw := tar.new_writer()
    n1 := "hello.txt"
    b1 := "hello"
    tw.write_file(&n1, &b1, 420) or (err) { << 1 }
    tw.close()
    traw := tw.bytes()
    mut tr := tar.new_reader(&traw)
    f1 := tr.next() or (err) { << 1 }
    println(f1.name)
    println(f1.size)
    println(f1.body)
    show_bool(tar_next_eof(tr))

    mut zw := zip.new_writer()
    zw.write_file(&n1, &b1) or (err) { << 1 }
    n3 := "fox.txt"
    b3 := "The quick brown fox"
    zw.write_file_deflate(&n3, &b3) or (err) { << 1 }
    zw.close() or (err) { << 1 }
    zraw := zw.bytes()
    mut zr := zip.new_reader(&zraw)
    z1 := zr.next() or (err) { << 1 }
    println(z1.name)
    println(z1.body)
    z3 := zr.next() or (err) { << 1 }
    println(z3.name)
    println(z3.method)
    show_bool(z3.uncompressed_size == 19)
    show_bool(zip_next_err(zr))
    << 0
}
