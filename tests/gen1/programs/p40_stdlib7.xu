@main
// Go-parity stdlib wave 7 (crypto 哈希族：md5/sha1/sha512).
#crypto/md5
#crypto/sha1
#crypto/sha512

fn main() int {
    println(md5.sum("abc"))
    println(sha1.sum("abc"))
    println(sha512.sum("abc"))
    mut d := sha512.new()
    p1 := "ab"
    d.write(&p1)
    p2 := "c"
    d.write(&p2)
    println(d.sum())
    println(d.size())
    a := "a"
    println(md5.sum(strings_repeat(&a, 64)))
    << 0
}

fn strings_repeat(s &string, n int) string {
    mut out := ""
    for i in 0:n {
        out = out + s
    }
    << out
}
