@main
// Go-parity stdlib wave 84: strings.fields_func + index_func
#strings

fn is_comma(c int) bool {
    << c == 44
}

fn is_digit(c int) bool {
    << c >= 48 && c <= 57
}

fn main() int {
    s := "a,b"
    fs := strings.fields_func(&s, is_comma)
    println(fs[0])
    println(fs[1])
    t := "x9"
    println(strings.index_func(&t, is_digit))
    << 0
}
