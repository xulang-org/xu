@main
// Go-parity stdlib wave 4 (os 系统信息：pid/uid/主机名/环境/目录/页大小).
#os

fn main() int {
    println(os.getpid() > 0)
    println(os.getppid() >= 0)
    println(os.getuid() >= -1)
    println(os.geteuid() >= -1)
    println(os.getgid() >= -1)
    println(os.getegid() >= -1)
    ps := os.getpagesize()
    println(ps >= 4096 && ps % 4096 == 0)
    println(os.hostname().len > 0)
    println(os.getwd().len > 0)
    println(os.getenv("PATH").len > 0)
    println(os.getenv("XU_NO_SUCH_VAR_7") == "")
    println(os.environ().len > 0)
    println(os.temp_dir().len > 0)
    println(os.home_dir().len > 0)
    << 0
}
