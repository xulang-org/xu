@main

#errors

fn main() int {
    // 单次写入：let 初始化
    e := errors.Error(errors.new("hi"))
    println(e.msg())
    println(e is errors.StrErr)

    // 只读：方法 / is 不消耗
    println(e.msg())

    // 按值传参：调用结束销毁
    errors.wrap("outer", e)

    // 二次写入 / use-after-move 均编译错误（见 tests/gen1/safety/any_*.xu）：
    //   e = errors.Error(...)     — struct@ 只能写一次
    //   e.msg()                   — use after move
    //   let r := e as errors.StrErr — use after move（as 须在 move 之前）

    e2 := errors.Error(errors.new("alias"))
    s := e2 as errors.StrErr
    println(s.msg())
    << 0
}
