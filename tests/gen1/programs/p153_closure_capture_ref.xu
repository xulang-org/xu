@main

// M153: bootstrap ≡ gen1 for reference captures in function literals.

fn main() int {
    msg := "hello"
    r := &msg
    len_of := fn() int { << r.len }
    println(len_of())

    mut buf := "ab"
    w := mut &buf
    append_x := fn() { w.push_str("x") }
    append_x()
    println(buf)
    << 0
}
