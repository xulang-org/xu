@main
// Go-parity stdlib wave 16: mime + container.heap + index.suffixarray
#mime
#container/heap
#index/suffixarray

fn main() int {
    s := "text/plain; charset=UTF-8"
    mt := mime.parse_media_type(&s) or (err) { << 1 }
    println(mt.typ)
    println(mt.keys[0])
    println(mt.vals[0])
    ext := ".html"
    println(mime.type_by_extension(&ext))

    mut h := heap.new_ints()
    h.push(5)
    h.push(3)
    h.push(7)
    println(h.pop() or (err) { << 1 })
    println(h.pop() or (err) { << 1 })
    println(h.pop() or (err) { << 1 })

    data := "banana"
    ix := suffixarray.new(&data)
    println(ix.len())
    needle := "ana"
    hits := suffixarray.lookup(&ix, &needle, 0 - 1)
    println(hits.len)
    println(hits[0])
    << 0
}
