@main
// Go-parity stdlib (std/sort + std/hex + std/math) — dual compiler.
#sort
#encoding/hex
#math

fn main() int {
    mut a := []int{}
    a.push(3)
    a.push(1)
    a.push(2)
    sort.ints(mut &a)
    println(a[0])
    println(a[2])

    mut s := []string{}
    s.push("z")
    s.push("a")
    s.push("m")
    sort.strings(mut &s)
    println(s[0])
    println(s[1])
    println(s[2])

    mut f := []f64{}
    f.push(2.5)
    f.push(-1.0)
    f.push(3.75)
    sort.f64s(mut &f)
    println(f[0])
    println(f[2])

    println(hex.encode_to_string("AB"))
    decoded := hex.decode_string("4142") or (err) { << 1 }
    println(true)
    println(decoded)

    println(math.sqrt(9.0))
    println(math.pow(2.0, 8))
    println(math.floor(2.75))
    println(math.abs(-7.5))
    << 0
}
