@main
// Go-parity stdlib wave 10 (fmt + language variadics). fmt verbs
// (%d %s %v %t %%) combined with direct variadic calls, deterministic output
// for bootstrap/gen1 parity.
#fmt

fn sum(xs <-> int) int {
    mut t := 0
    for x in xs {
        t = t + x
    }
    << t
}

fn show(f string, errtext string, args []fmt.Arg) {
    s := fmt.sprintf_args(f, args) or (err) {
        println(errtext)
        <<
    }
    println(s)
}

fn main() int {
    // fmt sprintf success.
    show("%d", "", [fmt.i(42)])
    show("%s=%d", "", [fmt.s("n"), fmt.i(7)])
    show("%v %v %v %v", "", [fmt.i(1), fmt.s("two"), fmt.b(true), fmt.f(2.5)])
    show("100%% %t", "", [fmt.b(false)])
    show("%d", "", [fmt.i(1), fmt.s("x")])
    // mismatch -> throw marker.
    show("%d", "%!d(string=x)", [fmt.s("x")])
    // direct variadic calls.
    println(sum())
    println(sum(1, 2, 3, 4))
    println(sum(10, 20, 30, 40, 50))
    << 0
}
