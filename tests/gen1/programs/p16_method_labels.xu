@main
struct Entry {
    name string
    offset int
    is_data bool
}

struct Table {
    entries []Entry
    base int
}

fn new_table() Table {
    << Table{entries: []Entry{}, base: 100}
}

fn (t &mut Table) add(name string, offset int, is_data bool) {
    t.entries.push(Entry{name: name, offset: offset, is_data: is_data})
}

fn (t Table) find(name string) int {
    for i in 0:t.entries.len {
        candidate := t.entries[i].name
        if candidate == name {
            flag := t.entries[i].is_data
            off := t.entries[i].offset
            if flag { << t.base + off }
            << off
        }
    }
    << -1
}

fn main() int {
    mut t := new_table()
    t.add("first", 3, false)
    t.add("second", 7, true)
    println(t.find("first"))
    println(t.find("second"))
    << 0
}
