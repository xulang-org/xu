@main
// M108 positive: string field partial move in match clones; struct stays usable.
enum Tag {
    A,
    B,
}

struct Pair {
    a string
    b int
}

fn take(s string) {
    println(s.len)
}

fn main() int {
    p := Pair{a: "x" + "z", b: 7}
    t := Tag.A
    match t {
        Tag.A {
            take(p.a)
            println(p.b)
        }
        Tag.B {
            println(0)
        }
    }
    << 0
}
