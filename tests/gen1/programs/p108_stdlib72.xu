@main
// Go-parity stdlib wave 72: text.template execute_list vs execute_list_html
#text/template

fn main() int {
    t := template.new("{{range .}}|{{.}}|{{end}}")
    mut items := []string{}
    items.push("<a>")
    items.push("b")
    println(template.execute_list(&t, items) or (err) { << 1 })
    mut items2 := []string{}
    items2.push("<a>")
    items2.push("b")
    println(template.execute_list_html(&t, items2) or (err) { << 1 })
    << 0
}
