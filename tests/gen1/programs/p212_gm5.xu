@main
// G5: crypto/x509 SM2-with-SM3 OID (GM/T 0006)
#crypto/x509
#encoding/pem

fn main() int {
    pem_text := "-----BEGIN CERTIFICATE-----\nMIIB1jCCAXygAwIBAgIUQtBQVL0QyM9L9/e9GEyCrac/7SAwCgYIKoEcz1UBg3Uw\nMzELMAkGA1UEBhMCQ04xCzAJBgNVBAoMAlh1MRcwFQYDVQQDDA54dS1zbTIuZXhh\nbXBsZTAeFw0yNjA4MjUwNzQyNDJaFw0zNjA4MjIwNzQyNDJaMDMxCzAJBgNVBAYT\nAkNOMQswCQYDVQQKDAJYdTEXMBUGA1UEAwwOeHUtc20yLmV4YW1wbGUwWTATBgcq\nhkjOPQIBBggqgRzPVQGCLQNCAARHTjqZXSu7neAtKwWgJuPTeCdpvcHyWbmaYIbP\nZkzovgR2kfo4xmPw7oDDWHEq+O8fs2x1B/4UfgTPZd0EcN64o24wbDAdBgNVHQ4E\nFgQU6oICQvDp3wAyRBH9a/SqNpiFgJcwHwYDVR0jBBgwFoAU6oICQvDp3wAyRBH9\na/SqNpiFgJcwGQYDVR0RBBIwEIIOeHUtc20yLmV4YW1wbGUwDwYDVR0TAQH/BAUw\nAwEB/zAKBggqgRzPVQGDdQNIADBFAiEA6trv0VBg6nT0N+CW8chOE++vU6fecVVQ\n3iHHWK4WR7oCIHN4ylOVgvlF9OfB5UmwZgOATA8v5AUqQon2F64CgvQj\n-----END CERTIFICATE-----\n"
    b := pem.decode(&pem_text)
    mut c := x509.parse_certificate(b.bytes) or (err) {
        << 1
    }
    println(c.subject.common_name)
    println(c.signature_algorithm)
    << 0
}
