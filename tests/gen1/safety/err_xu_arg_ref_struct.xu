@main
// G4 (S6): a struct wrapping a reference must not be passed to `xu` —

// the goroutine would unsynchronized access the referenced local (data race).
// Bootstrap and Gen1 must both reject this program.
struct Holder {
    s &string
}

fn reader(h Holder) int {
    << h.s.len
}

fn main() int {
    s := "hello"
    xu reader(Holder{s: &s})
    println(s)
    << 0
}
