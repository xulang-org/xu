@main
// M2b: partial move after matching on a tag that still names an owning struct.
enum Slot {
    Full,
    Empty,
}

struct Box {
    a []int
    b string
}

fn take(a []int) {
    println(a.len)
}

fn main() int {
    v := Box{a: [1, 2], b: "y"}
    t := Slot.Full
    match t {
        Slot.Full {
            take(v.a)
            println(v.b.len)
        }
        Slot.Empty {
            println(0)
        }
    }
    << 0
}
