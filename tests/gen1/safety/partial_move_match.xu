@main
// M2b: partial move of a non-string owning field inside a match arm must fail.
enum Tag {
    A,
    B,
}

struct Pair {
    a []int
    b string
}

fn take(a []int) {
    println(a.len)
}

fn main() int {
    p := Pair{a: [1, 2], b: "y"}
    t := Tag.A
    match t {
        Tag.A {
            take(p.a)
            println(p.b.len)
        }
        Tag.B {
            println(0)
        }
    }
    << 0
}
