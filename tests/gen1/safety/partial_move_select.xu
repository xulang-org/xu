@main
// M2b: partial move inside a select receive arm must fail.
struct Pair {
    a []int
    b string
}

fn take(a []int) {
    println(a.len)
}

fn main() int {
    ch := chan Pair{cap: 1}
    p := Pair{a: [1], b: "y"}
    ch <- p
    select {
        x := <-ch {
            take(x.a)
            println(x.b.len)
        }
    }
    << 0
}
