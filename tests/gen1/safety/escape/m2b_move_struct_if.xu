@main
// S1/M2b: owning struct (string field) must not move out of a conditional scope.
struct Pair {
    label string
    n int
}

fn take(p Pair) {
    println(p.label)
}

fn main() int {
    pair := Pair{label: "a" + "b", n: 1}
    if true {
        take(pair)
    }
    println(pair.n)
    << 0
}
