@main
// MS-enum: match binding of an owning struct payload is a move of that
// slot; partial-moving a non-string field of the binding stays illegal.
struct Pair {
    a []int
    b string
}

enum Wrap {
    V(Pair)
}

fn take(a []int) {
    println(a.len)
}

fn main() int {
    e := Wrap.V(Pair{a: [1, 2], b: "y"})
    match e {
        Wrap.V(p) {
            take(p.a)
            println(p.b.len)
        }
    }
    << 0
}
