@main
// M2b: partial move after `or` success binding must fail.
#errors

struct Box {
    a []int
    b string
}

fn take(a []int) {
    println(a.len)
}

fn make(flag int) Box {
    if flag == 0 {
        >> errors.new("err")
    }
    << Box{a: [1, 2], b: "y"}
}

fn main() int {
    v := make(1) or (err) {
        << 0
    }
    take(v.a)
    println(v.b.len)
    << 0
}
