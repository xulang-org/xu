@main
// M2b: partial move after `or` on a may-throw binding must fail.
#errors

struct Box {
    a []int
    b string
}

fn take(a []int) {
    println(a.len)
}

fn make() Box {
    if false {
        >> errors.new("x")
    }
    << Box{a: [1, 2], b: "y"}
}

fn step() int {
    v := make() or >>
    take(v.a)
    println(v.b.len)
    << 0
}

fn main() int {
    << step() or (err) { << 1 }
}
