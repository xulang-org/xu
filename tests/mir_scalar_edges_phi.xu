@xu/types

// Test-only constructor: actual strict SSA verifier and production Phi
// destruction, including its critical edge split and scratch schedule.
pub fn scalar_phi_loop_fixture(mode int) Mir {
    mut m := empty_mir()
    mut f := mir_fn_blank()
    for _ in 0:2 {
        f.locals.push(1)
        f.locals_nslots.push(1)
        f.locals_owning.push(false)
    }
    for _ in 0:4 { f.temps.push(1)
        f.temps_nslots.push(1) }
    f.temps.push(2)
    f.temps_nslots.push(1)
    f.consts.push(11)
    f.consts.push(22)
    f.consts.push(1)
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 1, ta: 1, tb: -1, tc: -1, line: 0})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 1, ta: 2, tb: -1, tc: -1, line: 0})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 2, ta: 4, tb: 1, tc: 3, line: 0})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 3, ta: -1, tb: -1, tc: -1, line: 0})
    for t in 0:2 {
        mut init := mkinstr(1)
        init.a = t
        init.b = -2 - t
        mir_cfg_append(mut &f, 0, init)
        if mode == 0 {
            mut store := mkinstr(3)
            store.a = t
            store.b = t
            mir_cfg_append(mut &f, 0, store)
        }
    }
    mut cond := mkinstr(1)
    cond.a = 4
    cond.b = -4
    mir_cfg_append(mut &f, 0, cond)
    if mode == 0 {
        f.blocks.push(MBlock{head: -1, tail: -1, tkind: 1, ta: 1, tb: -1, tc: -1, line: 0})
        mut q := f.blocks[2]
        q.tb = 4
        mfn_set_block(mut &f.blocks, 2, q)
        for t in 0:2 {
            mut load := mkinstr(2)
            load.a = t
            load.b = t
            mir_cfg_append(mut &f, 4, load)
        }
        for t in 0:2 {
            mut store := mkinstr(3)
            store.a = t
            store.b = 1 - t
            mir_cfg_append(mut &f, 4, store)
        }
        if mir_verify_mfn_f(&f, false) != 0 { << m }
    } else {
        f.phi_args.push(MPhiArg{pred: 0, value: 0})
        f.phi_args.push(MPhiArg{pred: 2, value: 3})
        f.phi_args.push(MPhiArg{pred: 0, value: 1})
        f.phi_args.push(MPhiArg{pred: 2, value: 2})
        f.phis.push(MPhi{block: 1, local: 0, dest: 2, ty: 1, arg_head: 0, arg_count: 2})
        f.phis.push(MPhi{block: 1, local: 1, dest: 3, ty: 1, arg_head: 2, arg_count: 2})
        if mir_verify_mfn_f(&f, true) != 0 { << m }
        if !mir_phi_elim_f(mut &f) { << m }
        if f.phis.len != 0 || f.phi_args.len != 0 || mir_verify_mfn_f(&f, false) != 0 { << m }
    }
    m.fns.push(f)
    m.superseded.push(0)
    << m
}

pub fn scalar_phi_diamond_fixture(mode int) Mir {
    mut m := empty_mir()
    mut f := mir_fn_blank()
    f.nparams = 2
    f.ret = 1
    f.ret_nslots = 1
    for _ in 0:3 { f.locals.push(1)
        f.locals_nslots.push(1)
        f.locals_owning.push(false) }
    for _ in 0:5 { f.temps.push(1)
        f.temps_nslots.push(1) }
    f.consts.push(1)
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 2, ta: -2, tb: 1, tc: 2, line: 0})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 1, ta: 3, tb: -1, tc: -1, line: 0})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 1, ta: 3, tb: -1, tc: -1, line: 0})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 3, ta: 4, tb: -1, tc: -1, line: 0})
    for t in 0:2 {
        mut load := mkinstr(2)
        load.a = t
        load.b = t
        mir_cfg_append(mut &f, 0, load)
    }
    mut add := mkinstr(4)
    add.a = 2
    add.b = 1
    add.c = 0
    add.d = -2
    mir_cfg_append(mut &f, 1, add)
    if mode == 0 {
        for arm in 1:3 {
            mut store := mkinstr(3)
            store.a = 2
            store.b = 2
            if arm == 2 { store.b = 1 }
            mir_cfg_append(mut &f, arm, store)
        }
        mut load := mkinstr(2)
        load.a = 4
        load.b = 2
        mir_cfg_append(mut &f, 3, load)
        if mir_verify_mfn_f(&f, false) != 0 { << m }
    } else {
        mut cp := mkinstr(1)
        cp.a = 3
        cp.b = 1
        mir_cfg_append(mut &f, 2, cp)
        f.phi_args.push(MPhiArg{pred: 1, value: 2})
        f.phi_args.push(MPhiArg{pred: 2, value: 3})
        f.phis.push(MPhi{block: 3, local: 2, dest: 4, ty: 1, arg_head: 0, arg_count: 2})
        if mir_verify_mfn_f(&f, true) != 0 { << m }
        if !mir_phi_elim_f(mut &f) { << m }
        if mir_verify_mfn_f(&f, false) != 0 { << m }
    }
    m.fns.push(f)
    m.superseded.push(0)
    << m
}
