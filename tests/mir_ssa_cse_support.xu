@xu/types

// Test-only graph constructors; expectations are independent of the CSE
// table and dominator implementation. Every positive input is strict SSA.
fn cse_test_bin(f &mut MFn, bi int, dest int, op int, lhs int, rhs int) {
    mut ins := mkinstr(4)
    ins.a = dest
    ins.b = op
    ins.c = lhs
    ins.d = rhs
    mir_cfg_append(f, bi, ins)
}
fn cse_test_bin_count(f &MFn) int {
    mut n := 0
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            if mfn_ikind(&f.instrs, ii) == 4 { n += 1 }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    << n
}
fn cse_test_term(f &mut MFn, bi int, k int, a int, b int, c int) {
    mut block := f.blocks[bi]
    block.tkind = k
    block.ta = a
    block.tb = b
    block.tc = c
    mfn_set_block(mut &f.blocks, bi, block)
}
fn cse_test_params(f &mut MFn, ty int) {
    f.nparams = 2
    for loc in 0:2 {
        f.locals.push(ty)
        f.locals_nslots.push(1)
        f.locals_owning.push(false)
        t := ssa_test_temp(f, ty)
        mut load := mkinstr(2)
        load.a = t
        load.b = loc
        mir_cfg_append(f, 0, load)
    }
}
fn cse_test_run(f &mut MFn, trusted bool) bool {
    if mir_verify_mfn_f(&*f, true) != 0 { << false }
    mut result := -1
    if trusted { result = mir_ssa_simplify_verified_f(f) }
    else { result = mir_ssa_simplify_f(f) }
    << result >= 0 && mir_verify_mfn_f(&*f, true) == 0
}

// 0: dominating predecessor; 1: same block; 2: commutative;
// 3: noncommutative; 4: call between immutable snapshots; 5: pinned operand;
// 6: pinned destination; 7: unpinned snapshot of mutable source;
// 8/9: distinct/equal constants; 10/11/12: Div/f64/narrow;
// 13: repeated expressions feed a Phi; 14: siblings do not dominate merge;
// 15: one arm does not dominate merge; 16: backward CFG IDs;
// 17: bit 63; 18: dead tombstone; 19/20: 128/129 expression budget.
pub fn cse_test_case(mode int, trusted bool) bool {
    mut f := mir_fn_blank()
    f.ret = 1
    f.ret_nslots = 1
    mut ty := 1
    if mode == 11 { ty = 4 }
    if mode == 12 { ty = 13 }
    f.ret = ty
    mut nb := 2
    if mode >= 1 && mode <= 12 { nb = 1 }
    if mode >= 13 && mode <= 15 { nb = 4 }
    if mode == 16 || mode == 18 { nb = 3 }
    if mode == 17 { nb = 64 }
    if mode >= 19 { nb = 1 }
    for bi in 0:nb {
        if bi + 1 < nb { ssa_test_block(mut &f, 1, bi + 1, -1, -1) }
        else { ssa_test_block(mut &f, 3, -1, -1, -1) }
    }
    cse_test_params(mut &f, ty)
    first := ssa_test_temp(mut &f, ty)
    again := ssa_test_temp(mut &f, ty)
    mut x := 0
    y := 1
    mut op := 3
    if mode == 3 { op = 2 }
    if mode == 10 { op = 4 }
    mut a := x
    mut b := y
    mut c := x
    mut d := y
    if mode == 2 || mode == 3 { c = y
        d = x }
    if mode == 8 || mode == 9 {
        f.consts.push(17)
        if mode == 8 { f.consts.push(19) } else { f.consts.push(17) }
        b = -2
        d = -3
    }
    if mode == 7 {
        // Taking x's address makes it mutable; the Copy remains a snapshot.
        snap := ssa_test_temp(mut &f, ty)
        ssa_test_copy(mut &f, 0, snap, x)
        x = snap
        a = x
        c = x
    }
    mut first_block := 0
    mut again_block := nb - 1
    if mode == 16 {
        first_block = 2
        again_block = 1
        cse_test_term(mut &f, 0, 1, 2, -1, -1)
        cse_test_term(mut &f, 2, 1, 1, -1, -1)
        cse_test_term(mut &f, 1, 3, again, -1, -1)
    }
    if mode == 18 { cse_test_term(mut &f, 0, 1, 2, -1, -1)
        mfn_set_block(mut &f.blocks, 1, MBlock{head: -1, tail: -1, tkind: 0, ta: -1, tb: -1, tc: -1, line: 0}) }
    if mode >= 13 && mode <= 15 {
        cse_test_term(mut &f, 0, 2, 0, 1, 2)
        cse_test_term(mut &f, 1, 1, 3, -1, -1)
        cse_test_term(mut &f, 2, 1, 3, -1, -1)
        if mode == 14 || mode == 15 { first_block = 1 }
        if mode == 14 { again_block = 2 }
    }
    cse_test_bin(mut &f, first_block, first, op, a, b)
    if mode >= 4 && mode <= 7 {
        if mode == 4 {
            f.margs.push(MArg{v: 0, next: -1})
            mut call := mkinstr(7)
            call.a = -1
            call.b = 2
            call.c = 0
            mir_cfg_append(mut &f, 0, call)
        } else {
            ptr := ssa_test_temp(mut &f, 1)
            mut addr := mkinstr(16)
            addr.a = ptr
            addr.b = 0
            if mode == 6 { addr.b = first }
            addr.c = 1
            mir_cfg_append(mut &f, 0, addr)
            f.consts.push(41)
            mut store := mkinstr(18)
            store.a = -2
            store.b = ptr
            store.c = 0
            store.d = 1
            mir_cfg_append(mut &f, 0, store)
        }
    }
    cse_test_bin(mut &f, again_block, again, op, c, d)
    mut ret_block := nb - 1
    if mode == 16 { ret_block = 1 }
    cse_test_term(mut &f, ret_block, 3, again, -1, -1)
    mut expect := 1
    if mode == 3 || mode == 5 || mode == 6 || mode == 8 || mode == 10 || mode == 11 || mode == 12 || mode == 14 || mode == 15 { expect = 2 }
    if mode == 13 || mode == 14 {
        right := again
        mut left := first
        if mode == 13 {
            left = ssa_test_temp(mut &f, ty)
            cse_test_bin(mut &f, 1, left, op, a, b)
            // Both arms carry equal expressions originating at entry.
            mut duplicate := mkinstr(4)
            duplicate.a = again
            duplicate.b = op
            duplicate.c = c
            duplicate.d = d
            // The earlier merge expression is retired and relocated into arm2.
            retired := f.blocks[3].head
            mir_delete_instr(mut &f, 3, retired)
            mir_cfg_append(mut &f, 2, duplicate)
        }
        merge := ssa_test_temp(mut &f, ty)
        f.locals.push(ty)
        f.locals_nslots.push(1)
        f.locals_owning.push(false)
        f.phi_args.push(MPhiArg{pred: 1, value: left})
        f.phi_args.push(MPhiArg{pred: 2, value: right})
        f.phis.push(MPhi{block: 3, local: 2, dest: merge, ty: ty, arg_head: 0, arg_count: 2})
        cse_test_term(mut &f, 3, 3, merge, -1, -1)
    }
    if mode >= 19 {
        mut count := 128
        if mode == 20 { count = 129
            expect = count }
        for _ in 2:count {
            t := ssa_test_temp(mut &f, ty)
            cse_test_bin(mut &f, 0, t, op, a, b)
        }
    }
    if !cse_test_run(mut &f, trusted) { << false }
    if cse_test_bin_count(&f) != expect { << false }
    if mode == 13 && f.phis.len != 0 { << false }
    if mode == 14 && f.phis.len != 1 { << false }
    if mode == 15 && f.blocks[3].ta != again { << false }
    if mode == 16 && f.blocks[1].ta != first { << false }
    if !mir_phi_elim_f(mut &f) { << false }
    << mir_verify_mfn_f(&f, false) == 0
}

// Phi values denote this iteration, not a value available on the backedge.
pub fn cse_test_loop(trusted bool) bool {
    mut f := mir_fn_blank()
    f.ret = 1
    f.ret_nslots = 1
    f.consts.push(1)
    f.consts.push(17)
    ssa_test_block(mut &f, 1, 1, -1, -1)
    ssa_test_block(mut &f, 2, 0, 2, 3)
    ssa_test_block(mut &f, 1, 1, -1, -1)
    ssa_test_block(mut &f, 3, -1, -1, -1)
    cse_test_params(mut &f, 1)
    seed := ssa_test_temp(mut &f, 1)
    phi := ssa_test_temp(mut &f, 1)
    next := ssa_test_temp(mut &f, 1)
    first := ssa_test_temp(mut &f, 1)
    again := ssa_test_temp(mut &f, 1)
    ssa_test_copy(mut &f, 0, seed, -2)
    f.locals.push(1)
    f.locals_nslots.push(1)
    f.locals_owning.push(false)
    f.phi_args.push(MPhiArg{pred: 0, value: seed})
    f.phi_args.push(MPhiArg{pred: 2, value: next})
    f.phis.push(MPhi{block: 1, local: 2, dest: phi, ty: 1, arg_head: 0, arg_count: 2})
    cse_test_bin(mut &f, 1, first, 3, phi, -3)
    cse_test_bin(mut &f, 2, again, 3, phi, -3)
    cse_test_bin(mut &f, 2, next, 1, phi, -2)
    cse_test_term(mut &f, 3, 3, first, -1, -1)
    if !cse_test_run(mut &f, trusted) { << false }
    if cse_test_bin_count(&f) != 2 || f.phis.len != 1 { << false }
    if !mir_phi_elim_f(mut &f) { << false }
    << mir_verify_mfn_f(&f, false) == 0
}

pub fn cse_test_bad_input() bool {
    mut f := mir_fn_blank()
    f.ret = 1
    f.ret_nslots = 1
    ssa_test_block(mut &f, 3, -1, -1, -1)
    cse_test_params(mut &f, 1)
    d := ssa_test_temp(mut &f, 1)
    cse_test_bin(mut &f, 0, d, 3, 0, 1)
    cse_test_bin(mut &f, 0, d, 3, 0, 1)
    cse_test_term(mut &f, 0, 3, d, -1, -1)
    result := mir_ssa_simplify_f(mut &f)
    << result == -1 && cse_test_bin_count(&f) == 2
}
