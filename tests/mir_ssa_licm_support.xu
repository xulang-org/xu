@xu/types
#xu/scanner
#xu/parser
#xu/ast

// Exercise real parsing, lowering, central promotion and SSA commit. The
// expectation is a semantic invariant, independent of the LICM implementation.
pub fn licm_test_central(c &mut Checker) bool {
    mut tokens := []ast.Token{}
    scanner.lex("@main\nfn worker(seed int, salt int, n int) int {\n factor := seed\n bias := salt\n mut sum := 0\n mut i := 0\n while i < n {\n mixed := (factor * 17) ^ bias\n sum += mixed + i\n i += 1\n }\n << sum\n}\nfn main() int { << worker(23,19,97) }\n", mut &tokens, "loop.xu")
    mut p := parser.new_parser(tokens)
    p.parse_module()
    mut m := empty_mir()
    m.opt_level = 0
    mut functions := []CFn{}
    run_checker(c, &p, 0, 0, 0, []string{}, []string{}, 1, mut &m, []string{}, "", false, false, 1, false, mut &functions)
    mir_each_promote_scalar_locals(mut &m, false)
    mut fi := -1
    for j in 0:m.fns.len { if m.fns[j].name == "worker" { fi = j } }
    if fi < 0 { << false }
    mut f := mir_clone_fn(mut &m, fi, true)
    if mir_verify_mfn_f(&f, true) != 0 { << false }
    mut outside := 0
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            op := mfn_ib(&f.instrs, ii)
            if k == 4 && (op == 3 || op == 16) {
                if f.is_self_loop(bi) { << false }
                outside += 1
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    if outside != 2 || !mir_phi_elim_f(mut &f) { << false }
    << mir_verify_mfn_f(&f, false) == 0
}

// Exact stable instruction IDs are checked on independently constructed SSA
// graphs. Also preserve CFG/Phi, memory order and source payload on movement.
pub fn licm_test_graph(mode int) bool {
    mut f := mir_fn_blank()
    f.ret = 1
    f.ret_nslots = 1
    f.consts.push(1)
    f.consts.push(17)
    mut ty := 1
    if mode == 5 { ty = 4 }
    if mode == 6 { ty = 13 }
    f.ret = ty
    mut body := 1
    mut exit_bi := 2
    if mode == 1 || mode == 14 { body = 2
        exit_bi = 3 }
    for bi in 0:exit_bi + 1 { ssa_test_block(mut &f, 3, 0, -1, -1) }
    cse_test_term(mut &f, 0, 1, 1, -1, -1)
    cse_test_term(mut &f, 1, 2, -2, 1, exit_bi)
    if body != 1 {
        cse_test_term(mut &f, 1, 2, -2, body, exit_bi)
        cse_test_term(mut &f, body, 1, 1, -1, -1)
    }
    cse_test_params(mut &f, ty)
    mut lhs := 0
    if mode == 14 {
        // A changing Phi must never become an invariant operand.
        next := ssa_test_temp(mut &f, ty)
        phi := ssa_test_temp(mut &f, ty)
        f.locals.push(ty)
        f.locals_nslots.push(1)
        f.locals_owning.push(false)
        f.phi_args.push(MPhiArg{pred: 0, value: 0})
        f.phi_args.push(MPhiArg{pred: body, value: next})
        f.phis.push(MPhi{block: 1, local: 2, dest: phi, ty: ty, arg_head: 0, arg_count: 2})
        cse_test_bin(mut &f, body, next, 1, phi, -2)
        lhs = phi
    }
    first := ssa_test_temp(mut &f, ty)
    second := ssa_test_temp(mut &f, ty)
    mut op := 3
    if mode == 2 { op = 4 }
    if mode == 3 { op = 5 }
    if mode == 4 { op = 17 }
    cse_test_bin(mut &f, body, first, op, lhs, -3)
    first_id := f.blocks[body].tail
    mut second_op := 16
    if mode == 5 { second_op = 1 }
    cse_test_bin(mut &f, body, second, second_op, first, 1)
    second_id := f.blocks[body].tail
    mut ret := second
    if body != 1 { ret = 0 }
    cse_test_term(mut &f, exit_bi, 3, ret, -1, -1)
    mut expect := 2
    if mode >= 2 && mode <= 9 { expect = 0 }
    if mode == 7 || mode == 8 || mode == 10 {
        ptr := ssa_test_temp(mut &f, 1)
        mut addr := mkinstr(16)
        addr.a = ptr
        addr.b = 0
        if mode == 7 { addr.b = first }
        addr.c = 1
        if mode == 10 { addr.c = 0 }
        mir_cfg_append(mut &f, body, addr)
        mut store := mkinstr(18)
        store.a = -3
        store.b = ptr
        store.c = 0
        store.d = 1
        mir_cfg_append(mut &f, body, store)
        mut load := mkinstr(17)
        load.a = ssa_test_temp(mut &f, 1)
        load.b = ptr
        load.c = 0
        load.d = 1
        mir_cfg_append(mut &f, body, load)
    }
    if mode == 9 {
        f.margs.push(MArg{v: 0, next: -1})
        mut call := mkinstr(7)
        call.a = -1
        call.b = 2
        call.c = 0
        mir_cfg_append(mut &f, body, call)
    }
    if mode == 11 {
        // Five independent candidates: move only the bounded first four.
        expect = 4
        for _ in 0:3 {
            t := ssa_test_temp(mut &f, ty)
            cse_test_bin(mut &f, body, t, 3, 0, 1)
        }
    }
    if mode == 12 {
        // Six other entry-defined values plus two operands fill the budget.
        expect = 0
        for _ in 0:6 {
            t := ssa_test_temp(mut &f, ty)
            ssa_test_copy(mut &f, 0, t, -3)
            use := ssa_test_temp(mut &f, ty)
            cse_test_bin(mut &f, body, use, 1, t, first)
        }
    }
    if mode == 13 {
        // Two external entry paths make a preheader ambiguous.
        expect = 0
        other := f.blocks.len
        ssa_test_block(mut &f, 1, 1, -1, -1)
        cse_test_term(mut &f, 0, 2, -2, 1, other)
    }
    if mode == 14 { expect = 0 }
    if mode == 15 {
        // Signed block-ID bits and different block order are irrelevant.
        other := f.blocks.len
        ssa_test_block(mut &f, 2, -2, 1, exit_bi)
        cse_test_term(mut &f, 0, 1, other, -1, -1)
        cse_test_term(mut &f, exit_bi, 3, 0, -1, -1)
    }
    if mode == 16 { expect = 0
        while f.temps.len < 129 { ssa_test_temp(mut &f, 1) } }
    if mode == 17 { expect = 0
        while f.blocks.len < 33 { ssa_test_block(mut &f, 0, -1, -1, -1) } }
    if mode == 18 { expect = 0
        while f.instrs.len < 513 { f.instrs.push(mkinstr(0)) } }
    if mir_verify_mfn_f(&f, true) != 0 { << false }
    // Fingerprint every effectful instruction in execution order.
    mut old_mem := []int{}
    mut ii := f.blocks[body].head
    for _ in 0:f.instrs.len {
        if ii < 0 { <- }
        if mfn_ikind(&f.instrs, ii) != 4 { old_mem.push(ii) }
        ii = mfn_inext(&f.instrs, ii)
    }
    phi_count := f.phis.len
    n := mir_ssa_licm_verified_f(mut &f)
    if n != expect || mir_verify_mfn_f(&f, true) != 0 || f.phis.len != phi_count { << false }
    mut mem_at := 0
    mut inside_first := false
    mut inside_second := false
    ii = f.blocks[body].head
    for _ in 0:f.instrs.len {
        if ii < 0 { <- }
        if ii == first_id { inside_first = true }
        if ii == second_id { inside_second = true }
        if mfn_ikind(&f.instrs, ii) != 4 {
            if mem_at >= old_mem.len || old_mem[mem_at] != ii { << false }
            mem_at += 1
        }
        ii = mfn_inext(&f.instrs, ii)
    }
    if mem_at != old_mem.len { << false }
    if expect == 0 && (!inside_first || !inside_second) { << false }
    if expect >= 2 && (inside_first || inside_second) { << false }
    if mfn_ikind(&f.instrs, first_id) != 4 || mfn_ib(&f.instrs, first_id) != op || mfn_ic(&f.instrs, first_id) != lhs { << false }
    if !mir_phi_elim_f(mut &f) { << false }
    << mir_verify_mfn_f(&f, false) == 0
}
