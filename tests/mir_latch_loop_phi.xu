@xu/types

pub fn latch_add_phi(f &mut MFn, block int, local int, dest int, pairs &[]int) {
    head := f.phi_args.len
    for j in 0:pairs.len / 2 {
        f.phi_args.push(MPhiArg{pred: pairs[j * 2], value: pairs[j * 2 + 1]})
    }
    f.phis.push(MPhi{block: block, local: local, dest: dest, ty: 1, arg_head: head, arg_count: pairs.len / 2})
}

pub fn latch_finish_phi(f &mut MFn) bool {
    if mir_verify_mfn_f(&*f, true) != 0 { << false }
    if !mir_phi_elim_f(f) { << false }
    << mir_verify_mfn_f(&*f, false) == 0 && f.phis.len == 0 && f.phi_args.len == 0
}
