@xu/types

// Complete lower-bound input graph in Local and genuine strict SSA forms.
// This fixture exercises descriptor/must-def facts, not LoopPlan matching.
pub fn readonly_lower_bound_fixture(ssa bool) Mir {
    mut m := empty_mir()
    m.arrays.push(CArray{elem_ty: 1, elem_bytes: 8, fixed_len: 0})
    mut f := mir_fn_blank()
    f.nparams = 4
    f.ret = 1
    f.ret_nslots = 1
    for l in 0:5 {
        mut ty := 1
        if l == 0 { ty = 1200 }
        f.locals.push(ty)
        f.locals_nslots.push(1)
        f.locals_owning.push(false)
    }
    for t in 0:17 {
        mut ty := 1
        mut slots := 1
        if t == 0 { ty = 1200 }
        if t == 1 { ty = 200
            slots = 3 }
        if t == 6 || t == 13 { ty = 2 }
        f.temps.push(ty)
        f.temps_nslots.push(slots)
    }
    f.consts.push(1)
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 1, ta: 1, tb: -1, tc: -1, line: 0})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 2, ta: 6, tb: 2, tc: 5, line: 0})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 2, ta: 13, tb: 3, tc: 4, line: 0})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 1, ta: 1, tb: -1, tc: -1, line: 0})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 1, ta: 1, tb: -1, tc: -1, line: 0})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 3, ta: 16, tb: -1, tc: -1, line: 0})
    for i in 0:3 {
        mut q := mkinstr(2)
        q.a = i + 2
        q.b = i + 1
        mir_cfg_append(mut &f, 0, q)
    }
    mut ref := mkinstr(2)
    ref.a = 0
    ref.b = 0
    mir_cfg_append(mut &f, 0, ref)
    // Header length is an observed read; no range/trap proof is inferred.
    mut len := mkinstr(26)
    len.a = 15
    len.b = 0
    len.c = 8
    len.d = 1
    mir_cfg_append(mut &f, 0, len)
    if !ssa {
        for t in 4:6 {
            mut q := mkinstr(2)
            q.a = t
            q.b = t - 2
            mir_cfg_append(mut &f, 1, q)
        }
    }
    mut cmp := mkinstr(4)
    cmp.a = 6
    cmp.b = 8
    cmp.c = 4
    cmp.d = 5
    mir_cfg_append(mut &f, 1, cmp)
    for t in 7:10 {
        mut q := mkinstr(4)
        q.a = t
        if t == 7 { q.b = 2
            q.c = 5
            q.d = 4 }
        if t == 8 { q.b = 18
            q.c = 7
            q.d = -2 }
        if t == 9 { q.b = 1
            q.c = 4
            q.d = 8 }
        mir_cfg_append(mut &f, 2, q)
    }
    if !ssa {
        mut store := mkinstr(3)
        store.a = 4
        store.b = 9
        mir_cfg_append(mut &f, 2, store)
    }
    mut desc := mkinstr(26)
    desc.a = 1
    desc.b = 0
    desc.c = 0
    desc.d = 3
    mir_cfg_append(mut &f, 2, desc)
    mut load := mkinstr(14)
    load.a = 10
    load.b = 1
    load.c = 9
    load.d = 8
    mir_cfg_append(mut &f, 2, load)
    mut pred := mkinstr(4)
    pred.a = 13
    pred.b = 8
    pred.c = 10
    pred.d = 2
    mir_cfg_append(mut &f, 2, pred)
    mut inc := mkinstr(4)
    inc.a = 14
    inc.b = 1
    inc.c = 9
    inc.d = -2
    mir_cfg_append(mut &f, 3, inc)
    if !ssa {
        for arm in 3:5 {
            mut q := mkinstr(3)
            q.a = arm - 1
            q.b = 14
            if arm == 4 { q.b = 9 }
            mir_cfg_append(mut &f, arm, q)
        }
    }
    mut result := mkinstr(2)
    result.a = 16
    result.b = 2
    if ssa { result.kind = 1
        result.b = 4 }
    mir_cfg_append(mut &f, 5, result)
    if ssa {
        f.phi_args.push(MPhiArg{pred: 0, value: 3})
        f.phi_args.push(MPhiArg{pred: 3, value: 14})
        f.phi_args.push(MPhiArg{pred: 4, value: 4})
        f.phi_args.push(MPhiArg{pred: 0, value: 4})
        // t4 is a Phi destination; use a separate entry high value.
        mut init := mkinstr(2)
        init.a = 11
        init.b = 3
        mir_cfg_append(mut &f, 0, init)
        f.phi_args[3] = MPhiArg{pred: 0, value: 11}
        f.phi_args.push(MPhiArg{pred: 3, value: 5})
        f.phi_args.push(MPhiArg{pred: 4, value: 9})
        f.phis.push(MPhi{block: 1, local: 2, dest: 4, ty: 1, arg_head: 0, arg_count: 3})
        f.phis.push(MPhi{block: 1, local: 3, dest: 5, ty: 1, arg_head: 3, arg_count: 3})
        // Remove the redundant entry definition of the Phi destination.
        mut ii := f.blocks[0].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            if mfn_ikind(&f.instrs, ii) == 2 && mfn_ia(&f.instrs, ii) == 4 { mir_nop_mfni(mut &f.instrs, ii) }
            ii = mfn_inext(&f.instrs, ii)
        }
        if mir_verify_mfn_f(&f, true) != 0 { << m }
        if !mir_phi_elim_f(mut &f) { << m }
        if mir_verify_mfn_f(&f, false) != 0 { << m }
    } else if mir_verify_mfn_f(&f, false) != 0 { << m }
    m.fns.push(f)
    m.superseded.push(0)
    << m
}
