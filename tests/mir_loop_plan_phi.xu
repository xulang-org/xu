@xu/types

// The test graph starts as strict SSA. Use production destruction rather than
// manufacture the resulting Copies in the independent oracle.
pub fn loop_plan_finish_phi(f &mut MFn, ids &[]int, bs &[]int) bool {
    f.phi_args.push(MPhiArg{pred: bs[0], value: ids[2]})
    f.phi_args.push(MPhiArg{pred: bs[2], value: ids[4]})
    f.phi_args.push(MPhiArg{pred: bs[3], value: ids[0]})
    f.phi_args.push(MPhiArg{pred: bs[0], value: ids[3]})
    f.phi_args.push(MPhiArg{pred: bs[2], value: ids[1]})
    f.phi_args.push(MPhiArg{pred: bs[3], value: ids[5]})
    f.phis.push(MPhi{block: bs[1], local: ids[6], dest: ids[0], ty: 1, arg_head: 0, arg_count: 3})
    f.phis.push(MPhi{block: bs[1], local: ids[7], dest: ids[1], ty: 1, arg_head: 3, arg_count: 3})
    if mir_verify_mfn_f(&*f, true) != 0 { << false }
    if !mir_phi_elim_f(f) { << false }
    << mir_verify_mfn_f(&*f, false) == 0 && f.phis.len == 0 && f.phi_args.len == 0
}

fn loop_plan_interpret_value(m &Mir, fi int, temps &[]int, value int) int {
    if value >= 0 { << temps[value] }
    if value <= -2 { << mir_const_at(m, fi, 0 - value - 2) }
    << 0 - 9223372036854775807 - 1
}

// An executable test-only interpreter. It consumes the actual resulting MIR,
// including production Phi copies, and has no access to the LoopPlan matcher.
// Read-only array headers carry a token; checked element reads use input.
pub fn loop_plan_interpret(m &Mir, fi int, input &[]int, needle int) int {
    mut locals := []int{}
    mut temps := []int{}
    for l in 0:mir_nlocals(m, fi) { locals.push(0) }
    for t in 0:mir_ntemps(m, fi) { temps.push(0) }
    for l in 0:mir_fn_nparams(m, fi) {
        if mir_local_ty(m, fi, l) == 1 { locals[l] = needle }
    }
    mut bi := 0
    for _ in 0:8192 {
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:mir_nins(m, fi) {
            if ii < 0 { <- }
            k := mir_ikind(m, fi, ii)
            a := mir_ia(m, fi, ii)
            b := mir_ib(m, fi, ii)
            c := mir_ic(m, fi, ii)
            d := mir_id(m, fi, ii)
            if k == 1 { temps[a] = loop_plan_interpret_value(m, fi, &temps, b) }
            else if k == 2 { temps[a] = locals[b] }
            else if k == 3 { locals[a] = loop_plan_interpret_value(m, fi, &temps, b) }
            else if k == 4 {
                x := loop_plan_interpret_value(m, fi, &temps, c)
                y := loop_plan_interpret_value(m, fi, &temps, d)
                if b == 1 { temps[a] = x + y }
                else if b == 2 { temps[a] = x - y }
                else if b == 18 { temps[a] = x >> y }
                else if b == 8 { temps[a] = 0
                    if x < y { temps[a] = 1 } }
                else { << 0 - 9223372036854775807 - 1 }
            } else if k == 17 || k == 26 {
                temps[a] = 0
                if c == 8 { temps[a] = input.len }
            } else if k == 14 {
                index := loop_plan_interpret_value(m, fi, &temps, c)
                if index < 0 || index >= input.len { << 0 - 9223372036854775807 - 1 }
                temps[a] = input[index]
            } else if k != 0 { << 0 - 9223372036854775807 - 1 }
            ii = mir_inext(m, fi, ii)
        }
        tk := mir_btkind(m, fi, bi)
        if tk == 1 { bi = mir_bta(m, fi, bi) }
        else if tk == 2 {
            value := loop_plan_interpret_value(m, fi, &temps, mir_bta(m, fi, bi))
            if value != 0 { bi = mir_btb(m, fi, bi) }
            else { bi = mir_btc(m, fi, bi) }
        } else if tk == 3 { << loop_plan_interpret_value(m, fi, &temps, mir_bta(m, fi, bi)) }
        else { << 0 - 9223372036854775807 - 1 }
    }
    << 0 - 9223372036854775807 - 1
}
