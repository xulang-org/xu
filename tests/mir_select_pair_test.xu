@xu/types

// Test-only SSA construction/destruction and two independent execution paths.
pub fn select_add_phi(f &mut MFn, block int, local int, dest int, pairs &[]int) {
    head := f.phi_args.len
    for j in 0:pairs.len / 2 {
        f.phi_args.push(MPhiArg{pred: pairs[j * 2], value: pairs[j * 2 + 1]})
    }
    f.phis.push(MPhi{block: block, local: local, dest: dest, ty: 1, arg_head: head, arg_count: pairs.len / 2})
}

pub fn select_finish_phi(f &mut MFn) bool {
    if mir_verify_mfn_f(&*f, true) != 0 { << false }
    if !mir_phi_elim_f(f) { << false }
    << mir_verify_mfn_f(&*f, false) == 0 && f.phis.len == 0 && f.phi_args.len == 0
}

fn select_test_initial(m &Mir, fi int, input &[]int) []int {
    mut state := []int{}
    for cell in 0:mir_nlocals(m, fi) + mir_ntemps(m, fi) {
        mut value := 0
        if cell < input.len { value = input[cell] }
        state.push(value)
    }
    << state
}

fn select_test_value(m &Mir, fi int, state &[]int, value int) int {
    if value >= 0 { << state[mir_nlocals(m, fi) + value] }
    << mir_const_at(m, fi, 0 - (value + 2))
}

fn select_test_block(m &Mir, fi int, bi int, state &mut []int) bool {
    nl := mir_nlocals(m, fi)
    mut ii := mir_bhead(m, fi, bi)
    for _ in 0:mir_nins(m, fi) {
        if ii < 0 { <- }
        k := mir_ikind(m, fi, ii)
        a := mir_ia(m, fi, ii)
        b := mir_ib(m, fi, ii)
        c := mir_ic(m, fi, ii)
        d := mir_id(m, fi, ii)
        if k == 1 { state[nl + a] = select_test_value(m, fi, &*state, b) }
        else if k == 2 { state[nl + a] = state[b] }
        else if k == 3 { state[a] = select_test_value(m, fi, &*state, b) }
        else if k == 4 && b == 1 {
            x := select_test_value(m, fi, &*state, c)
            y := select_test_value(m, fi, &*state, d)
            state[nl + a] = x + y
        } else if k != 0 { << false }
        ii = mir_inext(m, fi, ii)
    }
    << true
}

fn select_test_finish(m &Mir, fi int, state &mut []int, start int, kind0 int, id0 int, kind1 int, id1 int) []int {
    mut bi := start
    for _ in 0:128 {
        if !select_test_block(m, fi, bi, state) { << []int{} }
        tk := mir_btkind(m, fi, bi)
        if tk == 3 {
            mut cell0 := id0
            mut cell1 := id1
            if kind0 == 2 { cell0 += mir_nlocals(m, fi) }
            if kind1 == 2 { cell1 += mir_nlocals(m, fi) }
            ret := select_test_value(m, fi, &*state, mir_bta(m, fi, bi))
            << [state[cell0], state[cell1], ret]
        }
        if tk == 1 { bi = mir_bta(m, fi, bi) }
        else if tk == 2 {
            cond := select_test_value(m, fi, &*state, mir_bta(m, fi, bi))
            mut next := mir_btc(m, fi, bi)
            if cond != 0 { next = mir_btb(m, fi, bi) }
            bi = next
        } else { << []int{} }
    }
    << []int{}
}

// This path has no plan argument and executes the actual production PhiElim
// result in linked MIR order, including intermediate/scratch definitions.
pub fn select_execute_actual(m &Mir, fi int, input &[]int, kind0 int, id0 int, kind1 int, id1 int) []int {
    mut state := select_test_initial(m, fi, input)
    << select_test_finish(m, fi, mut &state, 0, kind0, id0, kind1, id1)
}

// This consumer snapshots all four expressions before committing either
// destination. It then executes the original common suffix independently.
pub fn select_execute_plan(m &Mir, fi int, p &MirSelectPairPlan, input &[]int) []int {
    mut state := select_test_initial(m, fi, input)
    from := mir_select_pair_field(p, 0)
    join := mir_select_pair_field(p, 1)
    mut bi := 0
    mut found := false
    for _ in 0:128 {
        if !select_test_block(m, fi, bi, mut &state) { << []int{} }
        if bi == from { found = true
            <- }
        if mir_btkind(m, fi, bi) != 1 { << []int{} }
        bi = mir_bta(m, fi, bi)
    }
    if !found { << []int{} }
    cond := select_test_value(m, fi, &state, mir_select_pair_field(p, 2))
    mut snapshots := []int{}
    for output in 0:2 {
        for arm in 0:2 {
            kind := mir_select_pair_source(p, output, arm, 0)
            id := mir_select_pair_source(p, output, arm, 1)
            mut value := id
            if kind == 1 { value = state[id] }
            if kind == 2 { value = state[mir_nlocals(m, fi) + id] }
            value += mir_select_pair_source(p, output, arm, 3)
            snapshots.push(value)
        }
    }
    mut arm := 1
    if cond != 0 { arm = 0 }
    for output in 0:2 {
        kind := mir_select_pair_output(p, output, 0)
        id := mir_select_pair_output(p, output, 1)
        mut cell := id
        if kind == 2 { cell += mir_nlocals(m, fi) }
        state[cell] = snapshots[output * 2 + arm]
    }
    << select_test_finish(m, fi, mut &state, join,
        mir_select_pair_output(p, 0, 0), mir_select_pair_output(p, 0, 1),
        mir_select_pair_output(p, 1, 0), mir_select_pair_output(p, 1, 1))
}
