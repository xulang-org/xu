@xu/types
// Seven live scalars exceed the Arm64 callee-saved pool. Exercise the actual
// whole-function planner, not a stand-alone coloring toy.
pub fn call_split_pressure_mir(uses int) Mir {
    mut m := mir_vreg_gate_fixture(3)
    mut f := mir_fn_blank()
    f.name = "call_split_pressure"
    f.label = "_call_split_pressure"
    f.ret = 1
    f.ret_nslots = 1
    f.consts.push(3)
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 3, ta: 8, tb: -1, tc: -1, line: 0})
    for _ in 0:9 { f.temps.push(1)
        f.temps_nslots.push(1) }
    for t in 0:7 {
        mut init := mkinstr(1)
        init.a = t
        init.b = -2
        mir_cfg_append(mut &f, 0, init)
    }
    mut call := mkinstr(7)
    call.a = 7
    call.b = 1
    call.c = -1
    call.sval = "_mir_vreg_gate_callee"
    mir_cfg_append(mut &f, 0, call)
    mut start := mkinstr(1)
    start.a = 8
    start.b = 7
    mir_cfg_append(mut &f, 0, start)
    for _ in 0:uses {
        for t in 0:7 {
            mut add := mkinstr(4)
            add.a = 8
            add.b = 1
            add.c = 8
            add.d = t
            mir_cfg_append(mut &f, 0, add)
        }
    }
    m.fns[0] = f
    << m
}

pub fn call_split_case_mir(mode int) Mir {
    mut uses := 4
    if mode == 1 { uses = 1 }
    mut m := call_split_pressure_mir(uses)
    mut f := mir_clone_fn(mut &m, 0, true)
    tail := f.blocks[0].tail
    if mode == 2 || mode == 3 || mode == 4 || mode == 8 || mode == 10 {
        mut extra := mkinstr(7)
        extra.a = 7
        extra.b = 1
        extra.c = -1
        extra.sval = "_mir_vreg_gate_callee"
        if mode == 3 {
            m.arrays.push(CArray{elem_ty: 1, elem_bytes: 8, fixed_len: 0})
            f.locals.push(200)
            f.locals_nslots.push(3)
            f.locals_owning.push(true)
            extra.kind = 8
            extra.a = 0
        }
        if mode == 4 { extra.b = 22 }
        if mode == 10 {
            f.temps.push(4)
            f.temps_nslots.push(1)
            f.temps.push(4)
            f.temps_nslots.push(1)
            extra.kind = 1
            extra.a = 9
            extra.b = -2
            extra.c = -1
        }
        id := f.instrs.len
        mir_cfg_append(mut &f, 0, extra)
        if mode != 8 {
            mut call := mfn_instr_snap(mut &f.instrs, 7)
            mut insert := mfn_instr_snap(mut &f.instrs, id)
            insert.next = call.next
            call.next = id
            mfn_set_instr(mut &f.instrs, 7, call)
            mfn_set_instr(mut &f.instrs, id, insert)
            mut last := mfn_instr_snap(mut &f.instrs, tail)
            last.next = -1
            mfn_set_instr(mut &f.instrs, tail, last)
            f.blocks[0].tail = tail
        }
        if mode == 10 {
            // Load and Store of a frame FP local makes one independent FP
            // range live through the same call as the rescued integers.
            mut call := mfn_instr_snap(mut &f.instrs, 7)
            call.next = 8
            mfn_set_instr(mut &f.instrs, 7, call)
            mut before := mfn_instr_snap(mut &f.instrs, 6)
            before.next = id
            mfn_set_instr(mut &f.instrs, 6, before)
            mut load := mfn_instr_snap(mut &f.instrs, id)
            load.next = 7
            mfn_set_instr(mut &f.instrs, id, load)
            mut store := mkinstr(4)
            store.a = 10
            store.b = 1
            store.c = 9
            store.d = 9
            mir_cfg_append(mut &f, 0, store)
        }
    }
    if mode == 5 || mode == 6 || mode == 7 {
        // Split after definitions and before the call. An incoming value for
        // t7 makes the branch bypass well-defined in the legacy de-SSA view.
        mut init := mkinstr(1)
        init.a = 7
        init.b = -2
        id := f.instrs.len
        mir_cfg_append(mut &f, 0, init)
        mut first := mfn_instr_snap(mut &f.instrs, 6)
        first.next = id
        mfn_set_instr(mut &f.instrs, 6, first)
        mut last := mfn_instr_snap(mut &f.instrs, tail)
        last.next = -1
        mfn_set_instr(mut &f.instrs, tail, last)
        f.blocks[0].tail = id
        f.blocks[0].tkind = 2
        f.blocks[0].ta = -2
        f.blocks[0].tb = 1
        f.blocks[0].tc = 2
        f.blocks.push(MBlock{head: 7, tail: 7, tkind: 1, ta: 2, tb: -1, tc: -1, line: 0})
        f.blocks.push(MBlock{head: 8, tail: tail, tkind: 3, ta: 8, tb: -1, tc: -1, line: 0})
        mut call := mfn_instr_snap(mut &f.instrs, 7)
        call.next = -1
        mfn_set_instr(mut &f.instrs, 7, call)
        if mode == 6 {
            nextid := f.instrs.len
            f.blocks.push(MBlock{head: -1, tail: -1, tkind: 1, ta: 2, tb: -1, tc: -1, line: 0})
            armcall := mfn_instr_snap(mut &f.instrs, 7)
            mir_cfg_append(mut &f, 3, armcall)
            f.blocks[3].head = nextid
            f.blocks[0].tc = 3
        }
        if mode == 7 {
            f.blocks[0].tkind = 1
            f.blocks[0].ta = 1
            f.blocks[1].tail = tail
            f.blocks[1].tkind = 2
            f.blocks[1].ta = -2
            f.blocks[1].tb = 1
            f.blocks[1].tc = 2
            mut loopcall := mfn_instr_snap(mut &f.instrs, 7)
            loopcall.next = 8
            mfn_set_instr(mut &f.instrs, 7, loopcall)
            f.blocks[2].head = -1
            f.blocks[2].tail = -1
        }
    }
    if mode == 9 {
        for _ in 9:513 { f.temps.push(1)
            f.temps_nslots.push(1) }
    }
    if mode >= 11 && mode <= 13 {
        mut ty := 9
        if mode == 12 { ty = 8 }
        if mode == 13 { ty = 10 }
        f.ret = ty
        for t in 0:f.temps.len { f.temps[t] = ty }
        mut callee := mir_clone_fn(mut &m, 1, true)
        callee.ret = ty
        for t in 0:callee.temps.len { callee.temps[t] = ty }
        m.fns[1] = callee
    }
    m.fns[0] = f
    << m
}

pub fn call_split_empty_admission() bool {
    mut m := empty_mir()
    f := mir_fn_blank()
    m.fns.push(f)
    m.superseded.push(0)
    << !mir_promote_unit_admit(&m, 0, false)
}
