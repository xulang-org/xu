@xu/types
#xu/scanner
#xu/parser
#xu/ast
pub fn record_test(c &mut Checker, mode int) bool {
    mut tokens := []ast.Token{}
    scanner.lex("@main\nstruct Record { bias int, stride int }\nfn worker(h Record, n int) int {\n    mut sum := 0\n    mut i := 0\n    while i < n {\n        sum += i * h.stride + h.bias\n        i += 1\n    }\n    << sum\n}\nfn main() int { h := Record{bias: 3, stride: 17}\n    << worker(h, 97)\n}\n", mut &tokens, "record.xu")
    mut p := parser.new_parser(tokens)
    p.parse_module()
    mut m := empty_mir()
    m.opt_level = 0
    mut functions := []CFn{}
    run_checker(c, &p, 0, 0, 0, []string{}, []string{}, 1, mut &m, []string{}, "", false, false, 1, false, mut &functions)
    mut fi := -1
    for i in 0:m.fns.len { if m.fns[i].name == "worker" { fi = i } }
    if fi < 0 { << false }
    mut f := mir_clone_fn(mut &m, fi, true)
    if mir_verify_mfn_f(&f, false) != 0 { << false }
    mut field := -1
    mut addr := -1
    for ii in 0:f.instrs.len {
        if mfn_ikind(&f.instrs, ii) == 17 { field = ii }
        if mfn_ikind(&f.instrs, ii) == 16 { addr = ii }
    }
    if field < 0 || addr < 0 { << false }
    if mode == 1 {
        t := f.temps.len
        f.temps.push(1)
        f.temps_nslots.push(1)
        mut ad := mkinstr(16)
        ad.a = t
        ad.b = 3 // address-taken index stays in its home; sum still promotes.
        ad.c = 0
        mir_cfg_append(mut &f, 0, ad)
    }
    if mode == 2 { f.locals_owning[0] = true }
    if mode == 3 { f.locals_nslots[0] = 0 }
    if mode == 4 { f.temps_nslots[0] = 2 }
    mut ins := mfn_instr_snap(mut &f.instrs, field)
    if mode == 5 { ins.c = 16 }
    if mode == 6 { ins.b = 0 }
    if mode == 8 { ins.d = 2 }
    if mode == 9 { ins.c = -8 }
    if mode == 10 { ins.kind = 18 }
    mfn_set_instr(mut &f.instrs, field, ins)
    if mode == 7 {
        mut ad := mfn_instr_snap(mut &f.instrs, addr)
        ad.c = 1
        mfn_set_instr(mut &f.instrs, addr, ad)
    }
    if mode == 11 { mir_cfg_append(mut &f, 0, mkinstr(7)) }
    if mode == 12 { f.ret = f.locals[0] }
    if mode == 15 { while f.blocks.len < 65 {
        f.blocks.push(MBlock{head: -1, tail: -1, tkind: 0, ta: -1, tb: -1, tc: -1, line: 0}) } }
    if mode == 16 { while f.locals.len < 49 { f.locals.push(1)
        f.locals_nslots.push(1)
        f.locals_owning.push(false) } }
    if mode == 17 { while f.temps.len < 513 { f.temps.push(1)
        f.temps_nslots.push(1) } }
    if mode == 18 { while f.instrs.len < 1025 { f.instrs.push(mkinstr(0)) } }
    if mode == 19 {
        mut cp := mkinstr(1)
        cp.a = mfn_ia(&f.instrs, addr)
        cp.b = -2
        mir_cfg_append(mut &f, 0, cp)
    }
    if mode == 20 { f.temps[0] = 4 }
    if mode == 21 { f.temps_nslots = []int{} }
    if mode == 22 { f.nparams = 7 }
    if mode == 23 { f.temps[mfn_ia(&f.instrs, addr)] = 1001 }
    if mode == 24 { f.temps[mfn_ia(&f.instrs, addr)] = 2000 + f.locals[0] }
    if mode == 25 { f.temps[mfn_ia(&f.instrs, addr)] = 1 }
    si := struct_index(f.locals[0])
    if mode == 13 { m.structs[si].drop_label = "_drop_resource" }
    if mode == 14 { m.structs[si].fields[0].ty = 3 }
    // Real central admission and commit, forced large-unit mode. Check both
    // verifier domains around the actual SSA window and its destruction.
    object_ty := f.locals[0]
    object_ns := f.locals_nslots[0]
    target := m.fns.len
    m.fns.push(f)
    m.superseded.push(0)
    admitted := mir_promote_unit_admit(&m, target, false)
    if mode >= 2 { << !admitted && !mir_fn_may_promote_scalar(&m, target) }
    if !admitted || !mir_fn_may_promote_scalar(&m, target) { << false }
    before := m.fns.len
    mir_each_promote_scalar_locals(mut &m, false)
    if m.fns.len <= before { << false }
    last := m.fns.len - 1
    mut out := mir_clone_fn(mut &m, last, true)
    if mir_verify_mfn_f(&out, true) != 0 { << false }
    mut old_mem := []int{}
    mut new_mem := []int{}
    for pass in 0:2 {
        mut x := mir_clone_fn(mut &m, target, true)
        if pass == 1 { x = mir_clone_fn(mut &m, last, true) }
        for bi in 0:x.blocks.len {
            mut ii := x.blocks[bi].head
            for _ in 0:x.instrs.len {
                if ii < 0 { <- }
                k := mfn_ikind(&x.instrs, ii)
                if k == 16 || k == 17 {
                    mut arg := mfn_ic(&x.instrs, ii)
                    if k == 16 { arg = mfn_ib(&x.instrs, ii) }
                    if pass == 0 { old_mem.push(k)
                        old_mem.push(arg)
                        old_mem.push(mfn_id(&x.instrs, ii))
                    } else { new_mem.push(k)
                        new_mem.push(arg)
                        new_mem.push(mfn_id(&x.instrs, ii)) }
                }
                ii = mfn_inext(&x.instrs, ii)
            }
        }
    }
    if old_mem.len != new_mem.len { << false }
    for i in 0:old_mem.len { if old_mem[i] != new_mem[i] { << false } }
    if out.locals[0] != object_ty || out.locals_nslots[0] != object_ns { << false }
    if mode == 1 {
        for i in 0:out.phis.len { if out.phis[i].local == 3 { << false } }
    }
    if !mir_phi_elim_f(mut &out) { << false }
    << mir_verify_mfn_f(&out, false) == 0
}
