@xu/types

fn scope_test_local(f &mut MFn, ty int) {
    f.locals.push(ty)
    f.locals_nslots.push(1)
    f.locals_owning.push(false)
}
fn scope_test_fn(mode int) MFn {
    mut f := mir_fn_blank()
    f.ret = 1
    f.ret_nslots = 1
    f.nparams = 1
    scope_test_local(mut &f, 2)
    scope_test_local(mut &f, 1)
    cond := ssa_test_temp(mut &f, 2)
    cur := ssa_test_temp(mut &f, 1)
    next := ssa_test_temp(mut &f, 1)
    f.consts.push(37)
    f.consts.push(1)
    f.consts.push(41)
    if mode == 0 {
        ssa_test_block(mut &f, 1, 1, -1, -1)
        ssa_test_block(mut &f, 2, cond, 2, 3)
        ssa_test_block(mut &f, 1, 1, -1, -1)
        ssa_test_block(mut &f, 3, cur, -1, -1)
        mut initial := mkinstr(3)
        initial.a = 1
        initial.b = -2
        mir_cfg_append(mut &f, 0, initial)
        mut load := mkinstr(2)
        load.a = cond
        load.b = 0
        mir_cfg_append(mut &f, 1, load)
        mut result := mkinstr(2)
        result.a = cur
        result.b = 1
        mir_cfg_append(mut &f, 1, result)
        mut bin := mkinstr(4)
        bin.a = next
        bin.b = 1
        bin.c = cur
        bin.d = -3
        mir_cfg_append(mut &f, 2, bin)
        mut store := mkinstr(3)
        store.a = 1
        store.b = next
        mir_cfg_append(mut &f, 2, store)
    } else {
        ssa_test_block(mut &f, 2, cond, 1, 2)
        ssa_test_block(mut &f, 1, 3, -1, -1)
        ssa_test_block(mut &f, 1, 3, -1, -1)
        ssa_test_block(mut &f, 3, cur, -1, -1)
        mut load := mkinstr(2)
        load.a = cond
        load.b = 0
        mir_cfg_append(mut &f, 0, load)
        for arm in 1:3 {
            mut store := mkinstr(3)
            store.a = 1
            store.b = -2
            if arm == 2 { store.b = -4 }
            mir_cfg_append(mut &f, arm, store)
        }
        mut result := mkinstr(2)
        result.a = cur
        result.b = 1
        mir_cfg_append(mut &f, 3, result)
    }
    << f
}

pub fn scope_test_promote(mode int) bool {
    mut f := scope_test_fn(mode)
    if mir_verify_mfn_f(&f, false) != 0 { << false }
    mut m := empty_mir()
    m.fns.push(f)
    m.superseded.push(0)
    if !mir_promote_unit_admit(&m, 0, false) { << false }
    mir_each_promote_scalar_locals(mut &m, false)
    if m.fns.len != 2 { << false }
    mut promoted := mir_clone_fn(mut &m, 1, true)
    << promoted.phis.len == 1 && mir_verify_mfn_f(&promoted, true) == 0
}

// Query the real consumer, including all established fallback predicates.
pub fn scope_test_boundary(mode int) bool {
    mut f := scope_test_fn(1)
    if mode == 1 { f.locals[1] = 4
        f.temps[1] = 4 }
    if mode == 2 { f.locals[1] = 13
        f.temps[1] = 13 }
    if mode == 3 { f.locals_nslots[1] = 2 }
    if mode == 4 {
        mut call := mkinstr(7)
        call.a = 2
        call.b = 1
        call.c = 0
        call.d = -1
        call.sval = "_ordinary_call"
        mir_cfg_append(mut &f, 0, call)
    }
    if mode == 5 {
        mut addr := mkinstr(16)
        addr.a = 2
        addr.b = 1
        addr.c = 0
        mir_cfg_append(mut &f, 0, addr)
    }
    if mode == 6 {
        mut load := mkinstr(14)
        load.a = 2
        load.b = 1
        load.c = -2
        mir_cfg_append(mut &f, 0, load)
    }
    if mode >= 7 && mode <= 9 {
        mut bin := mkinstr(4)
        bin.a = 2
        bin.b = 4
        if mode == 8 { bin.b = 17 }
        if mode == 9 { bin.b = 99 }
        bin.c = -2
        bin.d = -3
        mir_cfg_append(mut &f, 0, bin)
    }
    if mode == 10 {
        head := f.blocks[0].head
        mut ins := mfn_instr_snap(mut &f.instrs, head)
        ins.next = head
        mfn_set_instr(mut &f.instrs, head, ins)
    }
    if mode == 11 || mode == 19 {
        mut count := 65
        if mode == 19 { count = 64 }
        while f.blocks.len < count { ssa_test_block(mut &f, 0, -1, -1, -1) }
    }
    if mode == 12 || mode == 20 {
        mut count := 513
        if mode == 20 { count = 512 }
        while f.temps.len < count { ssa_test_temp(mut &f, 1) }
    }
    if mode == 13 { while f.locals.len < 49 { scope_test_local(mut &f, 1) } }
    if mode == 14 || mode == 21 {
        mut count := 1025
        if mode == 21 { count = 1024 }
        while f.instrs.len < count { f.instrs.push(mkinstr(0)) }
    }
    if mode == 15 { f.locals_owning[1] = true }
    if mode == 16 { while f.locals.len < 7 { scope_test_local(mut &f, 1) }
        f.nparams = 7 }
    if mode == 17 {
        mut b := f.blocks[0]
        b.tc = 99
        mfn_set_block(mut &f.blocks, 0, b)
    }
    if mode == 18 {
        mut ins := mkinstr(5)
        ins.a = 2
        ins.b = 3
        ins.c = -2
        mir_cfg_append(mut &f, 0, ins)
    }
    mut m := empty_mir()
    m.fns.push(f)
    m.superseded.push(0)
    admitted := mir_promote_unit_admit(&m, 0, false)
    << admitted == (mode >= 19)
}

// Shape admission must never substitute for the fresh structural proof.
pub fn scope_test_bad_operand(mode int) bool {
    mut f := scope_test_fn(1)
    ii := f.blocks[1].head
    mut store := mfn_instr_snap(mut &f.instrs, ii)
    if mode == 0 { store.b = 99 }
    if mode == 1 { store.a = 99 }
    if mode == 2 { store.b = -99 }
    mfn_set_instr(mut &f.instrs, ii, store)
    if mir_verify_mfn_f(&f, false) == 0 { << false }
    mut m := empty_mir()
    m.fns.push(f)
    m.superseded.push(0)
    if mir_promote_unit_admit(&m, 0, false) { << false }
    mir_each_promote_scalar_locals(mut &m, false)
    << m.fns.len == 1
}

// Semantic roles: LocalIds and argument heads are not Temp reads; every
// actual direct/argument read must still have a dominating definition.
pub fn scope_test_strict_reads(mode int) bool {
    mut f := mir_fn_blank()
    f.ret = 1
    f.ret_nslots = 1
    f.nparams = 3
    for _ in 0:3 { scope_test_local(mut &f, 1)
        ssa_test_temp(mut &f, 1) }
    f.consts.push(37)
    ssa_test_block(mut &f, 3, -2, -1, -1)
    mut initial := mkinstr(1)
    initial.a = 0
    initial.b = -2
    mir_cfg_append(mut &f, 0, initial)
    mut ins := mkinstr(4)
    ins.a = 1
    ins.b = 1
    ins.c = 0
    ins.d = -2
    if mode == 1 { ins.c = 2 }
    if mode == 2 || mode == 10 { ins.kind = 1
        ins.b = 2
        if mode == 10 { ins.b = -2 } }
    if mode == 3 { ins.kind = 3
        ins.a = 0
        ins.b = 2 }
    if mode == 4 { ins.kind = 5
        ins.c = 2 }
    if mode == 5 { ins.kind = 2
        ins.b = 2 }
    if (mode >= 6 && mode <= 9) || mode == 12 {
        ins.kind = 7
        ins.c = 0
        ins.d = -1
        ins.sval = "_ordinary_call"
        mut v := 2
        if mode == 7 || mode == 9 || mode == 12 { v = 0 }
        f.margs.push(MArg{v: v, next: -1})
        if mode == 7 || mode == 8 || mode == 12 {
            mfn_set_marg(mut &f.margs, 0, MArg{v: v, next: 1})
            mut second := v
            if mode == 12 { second = 2 }
            f.margs.push(MArg{v: second, next: -1})
        }
        if mode == 9 { ins.c = 1
            f.margs.push(MArg{v: 0, next: -1}) }
    }
    if mode == 11 { ins.d = 2 }
    if mode == 13 { ins.kind = 27 }
    mir_cfg_append(mut &f, 0, ins)
    result := mir_verify_mfn_f(&f, true)
    if mode == 13 { << result == 5 }
    if mode == 0 || mode == 5 || mode == 7 || mode == 9 || mode == 10 { << result == 0 }
    << result == 9
}
