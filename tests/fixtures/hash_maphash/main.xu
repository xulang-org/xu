@main

#hash/maphash

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    e := ""
    hello := "hello"
    h0 := maphash.bytes(1, &e)
    h1 := maphash.bytes(1, &hello)
    h1b := maphash.of_string(1, &hello)
    h2 := maphash.bytes(2, &hello)
    println(h0)
    println(h1)
    show_bool(h1 == h1b)
    show_bool(h1 != h2)
    mut d := maphash.new(1)
    d.write(&hello)
    show_bool(d.sum64() == h1)
    p1 := "he"
    p2 := "llo"
    mut d2 := maphash.new(1)
    d2.write(&p1)
    d2.write(&p2)
    show_bool(d2.sum64() == h1)
    d2.reset()
    show_bool(d2.sum64() == h0)
    println(d.seed())
    << 0
}
