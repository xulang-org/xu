@main
#net/http
fn get_fails(client &mut http.Client) bool {
    client.get("file:///invalid") or (err) {
        << err.msg() == "net/http: unsupported scheme"
    }
    << false
}
fn post_fails(client &mut http.Client) bool {
    body := "payload"
    client.post("file:///invalid", &body) or (err) {
        << err.msg() == "net/http: unsupported scheme"
    }
    << false
}
fn main() int {
    mut client := http.new_client()
    mut failures := 0
    if get_fails(mut &client) { failures += 1 }
    if post_fails(mut &client) { failures += 1 }
    println(failures)
    << 0
}
