@main
struct Duo {
    left []int
    stamp int
    right []int
}
fn touch(t &mut Duo, i int) int {
    t.left[0] = t.left[0] + 1
    t.right[i] = t.left[0] + t.right[0]
    << t.right[0]
}
fn main() int {
    mut a := []int{}
    mut b := []int{}
    a.push(3)
    b.push(7)
    mut t := Duo{left: a, stamp: 5, right: b}
    println(touch(mut &t, 1))
    << 0
}
