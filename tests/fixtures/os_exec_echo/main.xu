@main

#os/exec

fn trim_nl(s string) string {
    mut n := s.len
    while n > 0 {
        c := s[n - 1] & 255
        if c != 10 && c != 13 && c != 32 && c != 9 {
            <-
        }
        n = n - 1
    }
    << s[0:n]
}

fn main() int {
    p := exec.look_path("echo") or (err) {
        println(err.msg())
        << 1
    }
    if p.len == 0 {
        << 1
    }
    mut c := exec.command("echo", "hello-exec")
    out := c.output() or (err) {
        println(err.msg())
        << 1
    }
    t := trim_nl(out)
    println(t)
    mut tcmd := exec.command("true")
    tcmd.run() or (err) {
        println(err.msg())
        << 1
    }
    println("ran")
    << 0
}
