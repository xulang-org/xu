@main

#math

struct Body {
    x f64
    y f64
    vx f64
    mass f64
}

fn step(sys &mut [2]Body, dt f64, n int) {
    mut k := 0
    while k < n {
        dx := sys[0].x - sys[1].x
        dy := sys[0].y - sys[1].y
        d2 := dx * dx + dy * dy
        dist := math.sqrt(d2)
        mag := dt / (d2 * dist)
        mj := sys[1].mass
        mi := sys[0].mass
        sys[0].vx -= dx * mj * mag
        sys[1].vx += dx * mi * mag
        k += 1
    }
}

fn main() int {
    mut sys := [2]Body{
        Body{x: 1.0, y: 0.0, vx: 0.0, mass: 2.0},
        Body{x: 0.0, y: 0.0, vx: 0.0, mass: 1.0}
    }
    step(mut &sys, 0.01, 8)
    println(sys[0].vx < 0.0)
    println(sys[1].vx > 0.0)
    << 0
}
