@main
struct Wide {
    pad0 []int
    pad1 []int
    pad2 []int
    pad3 []int
    pad4 []int
    pad5 []int
    pad6 []int
    pad7 []int
    pad8 []int
    pad9 []int
    pad10 []int
    pad11 []int
    tag int
    tail []int
}
fn touch(w &mut Wide, p int) int {
    w.pad0[p] = w.pad0[p] + 1
    w.tail[p] = w.pad0[p] + w.tail[0]
    << w.tail[p]
}
fn main() int {
    mut a := []int{}
    mut b := []int{}
    a.push(3)
    a.push(5)
    b.push(7)
    mut w := Wide{pad0: a, pad1: []int{}, pad2: []int{}, pad3: []int{}, pad4: []int{}, pad5: []int{}, pad6: []int{}, pad7: []int{}, pad8: []int{}, pad9: []int{}, pad10: []int{}, pad11: []int{}, tag: 97, tail: b}
    println(touch(mut &w, 1))
    << 0
}
