@main
struct@ Shape { fn area() int }
struct Circle { r int }
fn (c Circle) area() int { << c.r * c.r }
struct Rect { w int h int }
fn (r Rect) area() int { << r.w * r.h }
fn main() int {
    c := Shape(Circle{r: 3})
    r := Shape(Rect{w: 2, h: 4})
    println(c.area())
    println(r.area())
    mut xs := []Shape{}
    xs.push(c)
    xs.push(r)
    println(xs.len)
    << 0
}
