@main

#mime

fn main() int {
    src := "Text/Plain; Charset=utf-8"
    mt := mime.parse_media_type(&src) or (err) { << 1 }
    println(mime.format_media_type(&mt))
    q := "text/plain; title=\"hello world\""
    mt2 := mime.parse_media_type(&q) or (err) { << 1 }
    println(mime.format_media_type(&mt2))
    << 0
}
