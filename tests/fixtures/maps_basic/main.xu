@main

#maps

fn main() int {
    mut mi := maps.new_str_int()
    mi.set("a", 1)
    mi.set("b", 2)
    mi.set("a", 3)
    println(mi.len())
    println(mi.has("a"))
    println(mi.has("z"))
    va := mi.get("a") or (err) {
        println(-1)
        << 1
    }
    println(va)
    mi.del("b")
    println(mi.has("b"))
    println(mi.len())
    if mi.has("b") {
        println(1)
    } else {
        println(-1)
    }

    mut ms := maps.new_str_str()
    ms.set("k", "v")
    ms.set("k", "w")
    gw := ms.get("k") or (err) {
        println("no")
        << 1
    }
    println(gw)
    println(ms.len())
    << 0
}
