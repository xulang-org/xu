@main

// Keep more buffers live than the cache retains, then reuse every boundary
// class. Fresh make_string results must still be zero and independent.
fn check_size(n int) bool {
    mut round := 0
    while round < 8 {
        mut buffers := []string{}
        mut j := 0
        while j < 8 {
            mut b := make_string(n)
            mut i := 0
            while i < n {
                if b[i] != 0 { << false }
                i += 1
            }
            b[0] = j + 1
            b[n - 1] = 200 + j
            buffers.push(b)
            j += 1
        }
        j = 0
        while j < buffers.len {
            b := &buffers[j]
            if b.len != n || b[0] != j + 1 || b[n - 1] != 200 + j { << false }
            j += 1
        }
        round += 1
    }
    << true
}

fn main() int {
    sizes := [11]int{2047, 2048, 2049, 4095, 4096, 4097, 8192, 8193, 32768, 65536, 65537}
    mut i := 0
    while i < 11 {
        if !check_size(sizes[i]) { << 1 }
        i += 1
    }
    println("medium buffer reuse OK")
    << 0
}
