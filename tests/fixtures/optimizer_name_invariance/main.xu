@main

// Identical source shapes must behave identically for ordinary API names,
// including names previously intercepted by a benchmark-specific MIR pass.
fn energy(dst &mut []u8, source &[]int, count int) f64 {
    mut z := 0.5
    for i in 0:count {
        z += f64(source[i]) * 0.25
        if z < 4.0 { dst[i] = u8(i + 1) }
    }
    << z
}

fn offset_momentum(dst &mut []u8, source &[]int, count int) f64 {
    mut z := 0.5
    for i in 0:count {
        z += f64(source[i]) * 0.25
        if z < 4.0 { dst[i] = u8(i + 1) }
    }
    << z
}

fn stamp(dst &mut []u8, source &[]int, count int) f64 {
    mut z := 0.5
    for i in 0:count {
        z += f64(source[i]) * 0.25
        if z < 4.0 { dst[i] = u8(i + 1) }
    }
    << z
}

fn main() int {
    mut source := []int{}
    source.push(1)
    source.push(2)
    source.push(3)
    mut dst := []u8{}
    for _ in 0:3 { dst.push(u8(0)) }
    println(energy(mut &dst, &source, 3) == 2.0)
    println(int(dst[0]) == 1 && int(dst[1]) == 2 && int(dst[2]) == 3)
    println(offset_momentum(mut &dst, &source, 3) == 2.0)
    println(int(dst[0]) == 1 && int(dst[1]) == 2 && int(dst[2]) == 3)
    println(stamp(mut &dst, &source, 3) == 2.0)
    println(int(dst[0]) == 1 && int(dst[1]) == 2 && int(dst[2]) == 3)
    << 0
}
