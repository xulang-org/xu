@main

struct Box {
    pub e temp
    pub n int
}

fn main() int {
    b := Box{e: 1, n: 9}
    if true {
        v := b.e as int
        println(v)
    } else {
        println("no")
    }
    println(b.n)
    mut xs := []temp{}
    xs.push(2)
    if true {
        w := xs[0] as int
        println(w)
    }
    << 0
}
