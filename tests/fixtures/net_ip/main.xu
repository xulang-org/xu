@main

#net

fn split_fails(s string) bool {
    mut hp := net.new_host_port()
    hp.split(s) or (err) {
        << true
    }
    << false
}

fn main() int {
    a := "127.0.0.1"
    ip := net.parse_ip(&a)
    println(ip.len)
    println(net.ip_string(&ip))
    println(net.ip_is_loopback(&ip))

    b := "::1"
    ip6 := net.parse_ip(&b)
    println(ip6.len)
    println(net.ip_string(&ip6))
    println(net.ip_is_loopback(&ip6))

    c := "2001:db8::1"
    ip7 := net.parse_ip(&c)
    println(net.ip_string(&ip7))

    d := "::ffff:192.0.2.1"
    ip8 := net.parse_ip(&d)
    println(net.ip_string(&ip8))

    h := "example.com"
    p := "80"
    println(net.join_host_port(&h, &p))
    h6 := "::1"
    println(net.join_host_port(&h6, &p))
    mut hp := net.new_host_port()
    hp.split("127.0.0.1:8080") or (err) { << 1 }
    println(hp.host())
    println(hp.port())
    hp.split("[::1]:443") or (err) { << 1 }
    println(hp.host())
    println(hp.port())
    println(split_fails("bad"))

    priv := "192.168.1.1"
    pip := net.parse_ip(&priv)
    println(net.ip_is_private(&pip))
    << 0
}
