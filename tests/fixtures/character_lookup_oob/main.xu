@main
fn lookup(src &string, table &string) string {
    mut dst := make_string(src.len)
    n := src.len
    mut i := 0
    while i < n {
        dst[i] = table[src[i] & 255]
        i += 1
    }
    << dst
}
fn main() int {
    mut src := make_string(3)
    src[0] = 0
    src[1] = 2
    src[2] = 1
    table := "x"
    println(lookup(&src, &table))
    << 0
}
