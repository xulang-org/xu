@main

#time

fn main() int {
    t := time.now_time()
    println(t.year() >= 2020)
    println(t.unix() >= 1600000000)
    wall_sec := wall_time_ns() / time.second()
    delta := wall_sec - t.unix()
    println(delta >= 0 && delta <= 2)
    future := t.add(time.second())
    println(time.until(future) > 0)
    << 0
}
