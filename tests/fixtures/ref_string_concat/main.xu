@main
fn cat_left(a &string, b string) string {
    << a + b
}
fn cat_right(a string, b &string) string {
    << a + b
}
fn cat_both(a &string, b &string) string {
    << a + b
}
fn materialize(s &string) string {
    << s + ""
}
fn main() int {
    l := "left"
    r := "right"
    println(cat_left(&l, "right"))
    println(cat_right("left", &r))
    println(cat_both(&l, &r))
    println(l)
    println(r)
    s := "abcdef"
    owned := materialize(&s)
    println(owned[1:3])
    println(s)
    << 0
}
