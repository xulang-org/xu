@main

#index/suffixarray

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn dump(a []int) {
    println(a.len)
    for i in 0:a.len {
        println(a[i])
    }
}

fn main() int {
    data := "banana"
    ix := suffixarray.new(&data)
    println(ix.len())
    ana := "ana"
    dump(suffixarray.lookup(&ix, &ana, 0 - 1))
    na := "na"
    dump(suffixarray.lookup(&ix, &na, 0 - 1))
    z := "z"
    dump(suffixarray.lookup(&ix, &z, 0 - 1))
    e := ""
    dump(suffixarray.lookup(&ix, &e, 0 - 1))
    a := "a"
    dump(suffixarray.lookup(&ix, &a, 1))
    show_bool(ix.len() == 6)
    ms := "mississippi"
    ix2 := suffixarray.new(&ms)
    iss := "iss"
    dump(suffixarray.lookup(&ix2, &iss, 0 - 1))
    si := "si"
    dump(suffixarray.lookup(&ix2, &si, 0 - 1))
    << 0
}
