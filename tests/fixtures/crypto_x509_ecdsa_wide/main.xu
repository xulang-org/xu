@main

#crypto/x509
#encoding/pem
#time

fn verify_name(c &x509.Certificate, name string) bool {
    now := c.not_before.add(time.hour())
    opts := x509.VerifyOptions{dns_name: name, current_time: now, roots: x509.new_cert_pool(), intermediates: x509.new_cert_pool(), key_usages: []int{}, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    c.verify(opts) or (err) {
        << false
    }
    << true
}

fn parse(pem_text &string) x509.Certificate {
    block := pem.decode(pem_text)
    << x509.parse_certificate(block.bytes) or >>
}

fn curve_oid_mismatch_fails(pem_text &string, from int, to int) bool {
    block := pem.decode(pem_text)
    mut b := []int{}
    for i in 0:block.bytes.len {
        b.push(block.bytes[i] & 255)
    }
    mut changed := false
    mut i := 0
    while i + 6 < b.len {
        if b[i] == 6 && b[i + 1] == 5 && b[i + 2] == 43 && b[i + 3] == 129 && b[i + 4] == 4 && b[i + 5] == 0 && b[i + 6] == from {
            b[i + 6] = to
            changed = true
            <-
        }
        i = i + 1
    }
    if !changed {
        << false
    }
    bad := string_from_bytes(b)
    x509.parse_certificate(bad) or (err) {
        << true
    }
    << false
}

fn main() int {
    p384_pem := "-----BEGIN CERTIFICATE-----\nMIIB2TCCAV+gAwIBAgIUEp7Hu2C4iZeGOpFsAVPFHA5bgagwCgYIKoZIzj0EAwMw\nFzEVMBMGA1UEAwwMcDM4NC5leGFtcGxlMB4XDTI2MDgzMTAyNDQxMFoXDTM2MDgy\nODAyNDQxMFowFzEVMBMGA1UEAwwMcDM4NC5leGFtcGxlMHYwEAYHKoZIzj0CAQYF\nK4EEACIDYgAEjZ4292hL500vPI4/1T1rr9UMXVyaCKKMYc0w/CnXdlETcjlHKarK\nl+vpwsgbChB1DHIhpW8mevrYjk2QUSOXfx4yZKBs6iJ+6chWL6MtnrKEdxm93mwV\n7BcVbtnkqvfWo2wwajAdBgNVHQ4EFgQUQ7zp/h/NBEiBflpKfhOYjF7m0mIwHwYD\nVR0jBBgwFoAUQ7zp/h/NBEiBflpKfhOYjF7m0mIwFwYDVR0RBBAwDoIMcDM4NC5l\neGFtcGxlMA8GA1UdEwEB/wQFMAMBAf8wCgYIKoZIzj0EAwMDaAAwZQIwJ6EDESHS\nF63SebV6yEXIZvtuQufAWc3GYMUtBVxVVCUvaajkjxbyYz4+aqPGyAgVAjEAusQW\ncyoZH4Ro24bZvBWAv9CoQXce4fiXXyXkxXTBs6MiVQESkkF44kaQMyf/BskZ\n-----END CERTIFICATE-----\n"
    p521_pem := "-----BEGIN CERTIFICATE-----\nMIICIzCCAYWgAwIBAgIUG7kh83gSYAeVdwT2E+MxcGxVe4QwCgYIKoZIzj0EAwQw\nFzEVMBMGA1UEAwwMcDUyMS5leGFtcGxlMB4XDTI2MDgzMTAyNDQxMFoXDTM2MDgy\nODAyNDQxMFowFzEVMBMGA1UEAwwMcDUyMS5leGFtcGxlMIGbMBAGByqGSM49AgEG\nBSuBBAAjA4GGAAQAzORHP9HKUZjUOztdGkjEz6br/tbscB0XZC7CLUlKB0DDqKi5\nuJ9AnVueo1M4UFQjp2y4JV5nHWh33MHz/C9HlKsAWKp1ReQ3oJtbsMn2Ju1ryyqg\nLoiWCIRU/jr3FObMvkHgqUGp8ogWotvm+jHJ9NisRhx7ZWyDioYNUbVIRoGzUg6j\nbDBqMB0GA1UdDgQWBBT+NyBIVEQNbwPWtSMjR42XD6JC/DAfBgNVHSMEGDAWgBT+\nNyBIVEQNbwPWtSMjR42XD6JC/DAXBgNVHREEEDAOggxwNTIxLmV4YW1wbGUwDwYD\nVR0TAQH/BAUwAwEB/zAKBggqhkjOPQQDBAOBiwAwgYcCQQcE66chIAzduug1CK7Q\n9B/lJi2zTgSAoA95nQR38USZvYcWpW15UVq8b7wu1+BrRkzw6HGVwl8Ts9azyP4o\n2hOIAkIBMvgSIwc3TzSRu4F7v9ipm7ol2uI3btkUYuP2SgAk81kSRz2WlSIaKOXe\n7aKSwmv1q6fzzD0XKpbBWyc6o8VUGMU=\n-----END CERTIFICATE-----\n"

    c384 := parse(&p384_pem) or (err) {
        println(err.msg())
        << 1
    }
    println(c384.public_key_algorithm)
    println(c384.signature_algorithm)
    println(c384.public_key.len)
    println(verify_name(&c384, "p384.example"))
    println(verify_name(&c384, "wrong.example"))
    println(curve_oid_mismatch_fails(&p384_pem, 34, 35))

    c521 := parse(&p521_pem) or (err) {
        println(err.msg())
        << 1
    }
    println(c521.public_key_algorithm)
    println(c521.signature_algorithm)
    println(c521.public_key.len)
    println(verify_name(&c521, "p521.example"))
    println(verify_name(&c521, "wrong.example"))
    println(curve_oid_mismatch_fails(&p521_pem, 35, 34))
    << 0
}
