@main

#regexp

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    s := "a+b"
    q := regexp.quote_meta(&s)
    println(q)
    re := regexp.compile(q) or (err) { << 1 }
    show_bool(re.match_string(&s))
    plus := "+"
    show_bool(re.match_string(&plus))
    << 0
}
