@main

fn main() int {
    mut mi := map[string]int{}
    mi["a"] = 1
    mi["b"] = 2
    mi["a"] = 3
    println(mi.len())
    println(mi.has("a"))
    println(mi.has("z"))
    va := mi["a"]
    println(va)
    mi.delete("b")
    println(mi.has("b"))
    println(mi.len())

    mut ms := map[string]string{}
    ms["k"] = "v"
    ms["k"] = "w"
    gw := ms["k"]
    println(gw)
    println(ms.len())
    << 0
}
