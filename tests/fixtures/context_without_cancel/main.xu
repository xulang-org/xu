@main

#context

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    mut c := context.with_cancel()
    v := context.with_value(&c.ctx, "k", "v")
    u := context.without_cancel(&v)
    println(context.value(&u, "k") or (err) { << 1 })
    println(u.deadline())
    c.cancel()
    context.err(&u) or (err) {
        println("canceled")
        << 0
    }
    println("open")
    << 0
}
