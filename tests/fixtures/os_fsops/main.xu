@main
#os

fn drop_quiet(p string) {
    os.remove(p) or (err) {
        <<
    }
}

fn stat_fails(path string) bool {
    os.stat(path) or (err) {
        << true
    }
    << false
}

fn mkdir_ok(path string) bool {
    os.mkdir(path) or (err) {
        << false
    }
    << true
}

fn main() int {
    drop_quiet("m35_tmp2/f.txt")
    drop_quiet("m35_tmp2")
    drop_quiet("m35_tmp/f.txt")
    drop_quiet("m35_tmp")
    os.mkdir("m35_tmp") or (err) {
        println(false)
        << 0
    }
    println(true)

    di := os.stat("m35_tmp") or (err) {
        println(false)
        << 0
    }
    println(true)
    println(di.is_dir)
    println((di.mode & 0xF000) == 0x4000)
    os.write("m35_tmp/f.txt", "hello m35") or (err) {
        println(false)
        << 0
    }
    println(true)

    fi := os.stat("m35_tmp/f.txt") or (err) {
        println(false)
        << 0
    }
    println(true)
    println(fi.size == 9)
    println(fi.is_dir == false)
    os.rename("m35_tmp", "m35_tmp2") or (err) {
        println(false)
        << 0
    }
    println(true)
    os.stat("m35_tmp2/f.txt") or (err) {
        println(false)
        << 0
    }
    println(true)
    println(stat_fails("m35_tmp"))
    os.remove("m35_tmp2/f.txt") or (err) {
        println(false)
        << 0
    }
    println(true)
    os.remove("m35_tmp2") or (err) {
        println(false)
        << 0
    }
    println(true)
    println(stat_fails("m35_tmp2/f.txt"))
    os.mkdir("m35_tmp2") or (err) {
        println(false)
        << 0
    }
    println(true)
    println(mkdir_ok("m35_tmp2"))
    println(!mkdir_ok("m35_tmp2"))

    drop_quiet("m35_tmp2")
    << 0
}
