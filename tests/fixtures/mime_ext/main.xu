@main

#mime

fn main() int {
    html := "text/html; charset=utf-8"
    e := mime.extensions_by_type(&html)
    println(e.len)
    println(e[0])
    println(e[1])
    png := "image/png"
    p := mime.extensions_by_type(&png)
    println(p.len)
    println(p[0])
    nope := "application/octet-stream"
    n := mime.extensions_by_type(&nope)
    println(n.len)
    << 0
}
