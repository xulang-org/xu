@main

#net/http
#net/http/httptest

fn app(c http.Context) {
    p := c.path()
    if p == "/a" {
        extra := "Location: /b\r\n"
        c.text_extra(302, extra, "") or (err) { << }
        <<
    }
    if p == "/b" {
        c.text(200, "landed") or (err) { << }
        <<
    }
    if p == "/loop" {
        extra := "Location: /loop\r\n"
        c.text_extra(302, extra, "") or (err) { << }
        <<
    }
    c.text(404, "no") or (err) { << }
}

fn loop_stops(cli &mut http.Client, u string) bool {
    cli.get(u) or (err) { << true }
    << false
}

fn main() int {
    mut srv := httptest.new_server(app) or (err) {
        println(err.msg())
        << 1
    }
    sleep_ns(50000000)
    mut cli := http.new_client()
    u1 := srv.url + "/a"
    r1 := cli.get(u1) or (err) {
        println(err.msg())
        srv.close()
        << 1
    }
    println(r1.status_code())
    println(r1.body())
    u2 := srv.url + "/loop"
    show := loop_stops(mut &cli, u2)
    if show {
        println("stopped")
    } else {
        println("followed")
    }
    srv.close()
    << 0
}
