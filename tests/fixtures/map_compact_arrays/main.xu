@main
fn main() int {
 mut m := map[int][]int{}
 for i in 0:32 {
  mut x := []int{}
  x.push(i + 1)
  m[i] = x
 }
 mut start := 12
 mut total := 0
 for round in 0:8 {
  for j in 0:20 { m.delete(start + j) }
  start = 32 + round * 20
  for j in 0:20 {
   mut x := []int{}
   x.push(j + 1)
   m[start + j] = x
  }
  for j in 0:20 {
   idx := start + j
   r := &m[idx]
   total += r[0]
  }
 }
 t := m.take(start)
 m.delete(0 - 1)
 println(total)
 println(t[0])
 println(m.len())
 << 0
}
