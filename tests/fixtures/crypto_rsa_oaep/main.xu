@main

#crypto/rsa
#crypto/rsa/oaep
#crypto/sha1
#encoding/hex

fn main() int {
    priv := rsa.generate_key(512) or (err) {
        println(err.msg())
        << 1
    }
    msg := "oaep-hi"
    lab := ""
    enc := oaep.encrypt_oaep(&priv.public, rsa.sha1, &msg, &lab) or (err) {
        println(err.msg())
        << 1
    }
    back := oaep.decrypt_oaep(&priv, rsa.sha1, &enc, &lab) or (err) {
        println(err.msg())
        << 1
    }
    println(back)

    hx := sha1.sum("pss payload")
    hashed := hex.decode_string(hx) or (err) { << 1 }
    sig := oaep.sign_pss(&priv, rsa.sha1, &hashed) or (err) {
        println(err.msg())
        << 1
    }
    oaep.verify_pss(&priv.public, rsa.sha1, &hashed, &sig) or (err) {
        println(err.msg())
        << 1
    }
    println("pss_ok")
    << 0
}
