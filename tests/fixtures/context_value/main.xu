@main

#context

fn main() int {
    bg := context.background()
    c1 := context.with_value(&bg, "user", "ada")
    c2 := context.with_value(&c1, "req", "42")
    c3 := context.with_value(&c2, "user", "bob")
    u := context.value(&c3, "user") or (err) { << 1 }
    r := context.value(&c3, "req") or (err) { << 1 }
    println(u)
    println(r)
    context.value(&c3, "missing") or (err) {
        println("missing")
        << 0
    }
    << 1
}
