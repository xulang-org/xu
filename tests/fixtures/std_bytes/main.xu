@main

#bytes

fn buf_truncate_fails(t bytes.Buffer, n int) bool {
    mut tt := t
    tt.truncate(n) or (err) { << true }
    << false
}

fn buf_write_byte_fails(b bytes.Buffer, c int) bool {
    mut bb := b
    bb.write_byte(c) or (err) { << true }
    << false
}

fn main() int {
    mut b := bytes.buffer()
    hi := "hi"
    println(b.write(&hi))
    println(b.write_byte(33) or (err) { << 1 })
    println(b.length())
    println(b.text())
    println(b.read_n(2))
    println(b.text())
    b.reset()
    println(b.length())
    msg := "abcdef"
    mut t := bytes.buffer_from(msg)
    println(t.truncate(3) or (err) { << 1 })
    println(t.text())
    println(buf_truncate_fails(t, 9))
    a := "abc"
    b2 := "abc"
    c := "abd"
    d := "ab"
    println(bytes.equal(&a, &b2))
    println(bytes.compare(&a, &c))
    println(bytes.compare(&d, &a))
    println(bytes.has_prefix(&a, "ab"))
    println(bytes.has_suffix(&a, "bc"))
    println(bytes.index_byte(&a, 98))
    s := "ababa"
    println(bytes.last_index(&s, "ba"))
    println(bytes.count(&s, "ba"))
    println(bytes.count(&s, ""))
    src := "foo foo"
    println(bytes.replace(&src, "foo", "bar", 1))
    println(bytes.replace(&src, "foo", "bar", 0 - 1))
    println(buf_write_byte_fails(b, 256))
    << 0
}
