@main

#slices

fn repeat_neg() bool {
    a := [1]
    slices.repeat_ints(&a, 0 - 1) or (err) { << true }
    << false
}

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    a := [1, 2]
    r := slices.repeat_ints(&a, 3) or (err) { << 1 }
    println(r.len)
    println(r[0])
    println(r[5])
    z := slices.repeat_ints(&a, 0) or (err) { << 1 }
    println(z.len)
    s := ["x"]
    t := slices.repeat_strs(&s, 2) or (err) { << 1 }
    println(t.len)
    println(t[1])
    show_bool(repeat_neg())
    << 0
}
