@main

// Indexed copy whose hot loop lives in `main`, with `[]int` setup in
// another function so the empty ArrayLit does not dump the copy body.
fn fill(n int) []int {
    mut a := []int{}
    mut i := 0
    while i < n {
        a.push(i * 3)
        i += 1
    }
    << a
}

fn main() int {
    n := 8
    src := fill(n)
    mut dst := fill(n)
    mut i := 0
    while i < n {
        dst[i] = src[i]
        i += 1
    }
    mut s := 0
    i = 0
    while i < n {
        s += dst[i]
        i += 1
    }
    println(s)
    << 0
}
