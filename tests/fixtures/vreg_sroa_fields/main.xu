@main

// Non-owning numeric structs must go through SROA into synthetic scalar
// locals, then formal SSA/Phi. `Pair` exercises whole-init split plus a
// diamond merge on the f64 piece; `BoxI32` covers a padded one-slot i32.
struct Pair {
    a int
    b f64
}

struct BoxI32 {
    n i32
}

fn choose(c bool) f64 {
    mut p := Pair{a: 1, b: 1.5}
    if c {
        p.b = 2.5
    } else {
        p.b = 3.5
    }
    << p.b
}

fn bump_i32() int {
    mut x := BoxI32{n: 41}
    x.n = x.n + 1
    << int(x.n)
}

fn main() int {
    println(choose(true))
    println(choose(false))
    println(bump_i32())
    << 0
}
