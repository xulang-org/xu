@main

#crypto/sm4
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn encrypt_cbc_fails(c &sm4.Cipher, iv &string, pt &string) bool {
    sm4.encrypt_cbc(c, iv, pt) or (err) { << true }
    << false
}

fn seal_gcm_fails(c &sm4.Cipher, nonce &string, pt &string, aad &string) bool {
    sm4.seal_gcm(c, nonce, pt, aad) or (err) { << true }
    << false
}

fn open_gcm_fails(c &sm4.Cipher, nonce &string, sealed &string, aad &string) bool {
    sm4.open_gcm(c, nonce, sealed, aad) or (err) { << true }
    << false
}

fn main() int {
    key := hex.decode_string("0123456789abcdeffedcba9876543210") or (err) { << 1 }
    iv := hex.decode_string("000102030405060708090a0b0c0d0e0f") or (err) { << 1 }
    pt_cbc := hex.decode_string("aaaaaaaabbbbbbbbccccccccddddddddeeeeeeeeffffffffaaaaaaaabbbbbbbb") or (err) { << 1 }
    c := sm4.new_cipher(&key) or (err) { << 1 }
    ct_cbc := sm4.encrypt_cbc(&c, &iv, &pt_cbc) or (err) { << 1 }
    println(hex.encode_to_string(ct_cbc + ""))
    show_bool(hex.encode_to_string(ct_cbc + "") == "78ebb11cc40b0a48312aaeb2040244cb4cb7016951909226979b0d15dc6a8f6d")
    back_cbc := sm4.decrypt_cbc(&c, &iv, &ct_cbc) or (err) { << 1 }
    show_bool(back_cbc == pt_cbc)
    hello := "hello"
    ct_p := sm4.encrypt_cbc_pkcs7(&c, &iv, &hello) or (err) { << 1 }
    back_p := sm4.decrypt_cbc_pkcs7(&c, &iv, &ct_p) or (err) { << 1 }
    show_bool(back_p == hello)
    short := "nope"
    show_bool(encrypt_cbc_fails(&c, &iv, &short))
    pt_ctr := hex.decode_string("aaaaaaaaaaaaaaaabbbbbbbbbbbbbbbbccccccccccccccccddddddddddddddddeeeeeeeeeeeeeeeeffffffffffffffffaaaaaaaaaaaaaaaabbbbbbbbbbbbbbbb") or (err) { << 1 }
    ct_ctr := sm4.encrypt_ctr(&c, &iv, &pt_ctr) or (err) { << 1 }
    println(hex.encode_to_string(ct_ctr + ""))
    show_bool(hex.encode_to_string(ct_ctr + "") == "ac3236cb970cc20791364c395a1342d1a3cbc1878c6f30cd074cce385cdd70c7f234bc0e24c11980fd1286310ce37b926e02fcd0faa0baf38b2933851d824514")
    back_ctr := sm4.decrypt_ctr(&c, &iv, &ct_ctr) or (err) { << 1 }
    show_bool(back_ctr == pt_ctr)
    msg := "Hello, Xu!"
    ct2 := sm4.encrypt_ctr(&c, &iv, &msg) or (err) { << 1 }
    println(sm4.decrypt_ctr(&c, &iv, &ct2) or (err) { << 1 })
    nonce := hex.decode_string("00001234567800000000abcd") or (err) { << 1 }
    aad := hex.decode_string("feedfacedeadbeeffeedfacedeadbeefabaddad2") or (err) { << 1 }
    pt_g := hex.decode_string("aaaaaaaaaaaaaaaabbbbbbbbbbbbbbbbccccccccccccccccddddddddddddddddeeeeeeeeeeeeeeeeffffffffffffffffeeeeeeeeeeeeeeeeaaaaaaaaaaaaaaaa") or (err) { << 1 }
    want_g := "17f399f08c67d5ee19d0dc9969c4bb7d5fd46fd3756489069157b282bb200735d82710ca5c22f0ccfa7cbf93d496ac15a56834cbcf98c397b4024a2691233b8d83de3541e4c2b58177e065a9bf7b62ec"
    sealed := sm4.seal_gcm(&c, &nonce, &pt_g, &aad) or (err) { << 1 }
    println(hex.encode_to_string(sealed + ""))
    show_bool(hex.encode_to_string(sealed + "") == want_g)
    back_g := sm4.open_gcm(&c, &nonce, &sealed, &aad) or (err) { << 1 }
    show_bool(back_g == pt_g)
    empty := ""
    s0 := sm4.seal_gcm(&c, &nonce, &empty, &empty) or (err) { << 1 }
    back0 := sm4.open_gcm(&c, &nonce, &s0, &empty) or (err) { << 1 }
    show_bool(back0 == empty)
    badiv := "short"
    show_bool(seal_gcm_fails(&c, &badiv, &pt_g, &aad))
    mut bad := []int{}
    mut i := 0
    while i < sealed.len {
        bad.push(sealed[i] & 255)
        i = i + 1
    }
    bad[bad.len - 1] = (bad[bad.len - 1] ^ 1) & 255
    bad_s := string_from_bytes(bad)
    show_bool(open_gcm_fails(&c, &nonce, &bad_s, &aad))
    << 0
}
