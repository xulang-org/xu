@main
// Keep more live objects than the optional hosted ledger can represent.  The
// default runtime path must continue normally; XU_HEAP_STATS=1 is expected to
// fail closed with the ledger-capacity diagnostic.
fn main() int {
    mut values := []string{}
    for i in 0:5000 {
        values.push(str(i))
    }
    println(values.len)
    << 0
}
