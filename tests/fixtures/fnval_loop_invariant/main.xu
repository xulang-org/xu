@main

fn plus1(x int) int { << x + 1 }
fn plus2(x int) int { << x + 2 }

fn stable(x int, n int) int {
    f := plus1
    mut sum := 0
    mut i := 0
    while i < n {
        if (i & 3) == 0 {
            sum += f(x + i)
        } else {
            sum -= f(x - i)
        }
        i += 1
    }
    << sum
}

fn changing(n int) int {
    mut f := plus1
    mut sum := 0
    mut i := 0
    while i < n {
        if (i & 1) == 0 { f = plus1 } else { f = plus2 }
        sum += f(i)
        i += 1
    }
    << sum
}

fn choose(x int) fn(int) int {
    if (x & 1) == 0 { << plus1 }
    << plus2
}

fn dynamic(x int, n int) int {
    f := choose(x)
    mut sum := 0
    for i in 0:n { sum += f(i) }
    << sum
}

fn captured(x int, n int) int {
    f := fn(a int) int { << a + x }
    mut sum := 0
    for i in 0:n { sum += f(i) }
    << sum
}

fn apply(f fn(int) int, x int) int { << f(x) }

fn exposed(n int) int {
    f := plus2
    mut sum := 0
    for i in 0:n {
        sum += apply(f, i)
        sum += f(i)
    }
    << sum
}

fn main() int {
    for n in 0:9 {
        println(stable(-7, n))
        println(stable(13, n))
        println(changing(n))
        println(dynamic(n, n))
        println(captured(-17, n))
        println(exposed(n))
    }
    << 0
}
