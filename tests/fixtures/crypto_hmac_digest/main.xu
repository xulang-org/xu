@main
// G23: crypto/hmac Digest (new256 / new_sm3 write/sum/reset).

#crypto/hmac

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    k := "key"
    fox := "The quick brown fox jumps over the lazy dog"
    want := hmac.sum256(&k, &fox)
    mut h := hmac.new256(&k)
    h.write(&fox)
    got := h.sum()
    println(got)
    show_bool(got == want)
    again := h.sum()
    show_bool(again == want)
    p1 := "The quick brown "
    p2 := "fox jumps over the lazy dog"
    mut h2 := hmac.new256(&k)
    h2.write(&p1)
    h2.write(&p2)
    show_bool(h2.sum() == want)
    h.reset()
    h.write(&fox)
    show_bool(h.sum() == want)
    println(h.size())
    println(h.blocksize())

    jefe := "Jefe"
    nothing := "what do ya want for nothing?"
    want_sm := hmac.sum_sm3(&jefe, &nothing)
    mut hs := hmac.new_sm3(&jefe)
    hs.write(&nothing)
    println(hs.sum())
    show_bool(hs.sum() == want_sm)
    hs.reset()
    hs.write(&nothing)
    show_bool(hs.sum() == want_sm)
    << 0
}
