@main
fn main() int {
    // Moving an owned local into a struct field must mark it moved, so it
    // is not freed at scope end while the struct still references it
    // (M6b2-s2 regression: StructInit lowering missed mark_move_of).
    mut l := "hello world"
    s := l[0:5]
    mut w := Wrap{txt: s}
    println(w.txt)
    println(w.txt.len)
    mut arr := []Wrap{}
    arr.push(w)
    println(arr[0].txt)
    << 0
}
    struct Wrap { txt string }
