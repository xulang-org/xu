@main

#crypto/x509
#encoding/pem
#time

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn check_fails(c &x509.Certificate, algo int, signed &string, sig &string) bool {
    c.check_signature(algo, signed, sig) or (err) { << true }
    << false
}

fn main() int {
    gmt := "-----BEGIN CERTIFICATE-----\nMIIB1jCCAXygAwIBAgIUQtBQVL0QyM9L9/e9GEyCrac/7SAwCgYIKoEcz1UBg3Uw\nMzELMAkGA1UEBhMCQ04xCzAJBgNVBAoMAlh1MRcwFQYDVQQDDA54dS1zbTIuZXhh\nbXBsZTAeFw0yNjA4MjUwNzQyNDJaFw0zNjA4MjIwNzQyNDJaMDMxCzAJBgNVBAYT\nAkNOMQswCQYDVQQKDAJYdTEXMBUGA1UEAwwOeHUtc20yLmV4YW1wbGUwWTATBgcq\nhkjOPQIBBggqgRzPVQGCLQNCAARHTjqZXSu7neAtKwWgJuPTeCdpvcHyWbmaYIbP\nZkzovgR2kfo4xmPw7oDDWHEq+O8fs2x1B/4UfgTPZd0EcN64o24wbDAdBgNVHQ4E\nFgQU6oICQvDp3wAyRBH9a/SqNpiFgJcwHwYDVR0jBBgwFoAU6oICQvDp3wAyRBH9\na/SqNpiFgJcwGQYDVR0RBBIwEIIOeHUtc20yLmV4YW1wbGUwDwYDVR0TAQH/BAUw\nAwEB/zAKBggqgRzPVQGDdQNIADBFAiEA6trv0VBg6nT0N+CW8chOE++vU6fecVVQ\n3iHHWK4WR7oCIHN4ylOVgvlF9OfB5UmwZgOATA8v5AUqQon2F64CgvQj\n-----END CERTIFICATE-----\n"
    b := pem.decode(&gmt)
    if b.typ != "CERTIFICATE" {
        << 1
    }
    mut c := x509.parse_certificate(b.bytes) or (err) {
        println(err.msg())
        << 1
    }
    println(c.subject.common_name)
    println(c.public_key_algorithm)
    println(c.signature_algorithm)
    println(c.public_key.len)
    show_bool(c.public_key_algorithm == x509.sm2)
    show_bool(c.signature_algorithm == x509.sm2_with_sm3)

    c.check_signature_from(&c) or (err) {
        println(err.msg())
        << 1
    }
    now := c.not_before.add(time.hour() * 24)
    opts := x509.VerifyOptions{dns_name: "xu-sm2.example", current_time: now, roots: x509.new_cert_pool(), intermediates: x509.new_cert_pool(), key_usages: []int{}, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    c.verify(opts) or (err) {
        println(err.msg())
        << 1
    }
    println("gmt_ok")

    empty_pem := "-----BEGIN CERTIFICATE-----\nMIIB1jCCAXygAwIBAgIUafATogcb9O7T7EHDQaYV9XlDYYEwCgYIKoEcz1UBg3Uw\nMzELMAkGA1UEBhMCQ04xCzAJBgNVBAoMAlh1MRcwFQYDVQQDDA54dS1zbTIuZXhh\nbXBsZTAeFw0yNjA4MjUwNzM3MDdaFw0zNjA4MjIwNzM3MDdaMDMxCzAJBgNVBAYT\nAkNOMQswCQYDVQQKDAJYdTEXMBUGA1UEAwwOeHUtc20yLmV4YW1wbGUwWTATBgcq\nhkjOPQIBBggqgRzPVQGCLQNCAARHTjqZXSu7neAtKwWgJuPTeCdpvcHyWbmaYIbP\nZkzovgR2kfo4xmPw7oDDWHEq+O8fs2x1B/4UfgTPZd0EcN64o24wbDAdBgNVHQ4E\nFgQU6oICQvDp3wAyRBH9a/SqNpiFgJcwHwYDVR0jBBgwFoAU6oICQvDp3wAyRBH9\na/SqNpiFgJcwGQYDVR0RBBIwEIIOeHUtc20yLmV4YW1wbGUwDwYDVR0TAQH/BAUw\nAwEB/zAKBggqgRzPVQGDdQNIADBFAiBKg370b3hDWajmVqWmz4Kg7E8IxCyKIMaa\nxd1hAhnQ8QIhAKdfaMuNGJ/PVFzkw1FRbAPVj73s2Hm9VlccqSpjs0D9\n-----END CERTIFICATE-----\n"
    be := pem.decode(&empty_pem)
    mut ce := x509.parse_certificate(be.bytes) or (err) {
        println(err.msg())
        << 1
    }
    ce.check_signature_from(&ce) or (err) {
        println(err.msg())
        << 1
    }
    println("empty_ok")

    tbs := c.raw_tbs_certificate + ""
    sig := c.signature + ""
    mut bad := []int{}
    mut i := 0
    while i < sig.len {
        bad.push(sig[i] & 255)
        i = i + 1
    }
    bad[bad.len - 1] = bad[bad.len - 1] ^ 1
    bads := string_from_bytes(bad)
    algo := c.signature_algorithm
    show_bool(check_fails(&c, algo, &tbs, &bads))
    << 0
}
