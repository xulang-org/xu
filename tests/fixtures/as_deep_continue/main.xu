@main

struct Cell {
    pub e temp
    pub x int
}

struct Inner {
    pub cell Cell
    pub n int
}

struct Wrap {
    pub inner Inner
    pub m int
}

fn main() int {
    b := Wrap{inner: Inner{cell: Cell{e: 1, x: 8}, n: 7}, m: 9}
    if true {
        v := b.inner.cell.e as int
        println(v)
    } else {
        println("no")
    }
    println(b.inner.cell.x)
    println(b.inner.n)
    println(b.m)
    << 0
}
