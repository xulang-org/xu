@main

struct Item {
    n int
    s string
}

fn main() int {
    mut m := map[int]Item{}
    m[1] = Item{n: 7, s: "ada"}
    m[2] = Item{n: 8, s: "bob"}
    r := &m[1]
    println(r.n)
    println(r.s)
    m[1] = Item{n: 9, s: "cal"}
    r2 := &m[1]
    println(r2.n)
    println(r2.s)
    t := m.take(2)
    println(t.n)
    println(t.s)
    println(m.has(2))
    println(m.len())
    m.delete(1)
    println(m.len())
    << 0
}
