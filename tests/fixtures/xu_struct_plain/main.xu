@main
// G4 insurance: a plain struct (no references inside) is still a legal `go`
// argument — only refs and ref-wrapping types are rejected (S6).
struct Payload {
    x int
}

fn worker(p Payload, done chan int) {
    done <- p.x
}

fn main() int {
    done := chan int{cap: 1}
    xu worker(Payload{x: 42}, done)
    r := <-done
    println(r)
    << 0
}
