@main

#net/http

fn main() int {
    println(http.status_text(201))
    println(http.status_text(204))
    println(http.status_text(401))
    println(http.status_text(418))
    mut r := http.new_request()
    r.headers = "User-Agent: Xu\r\nHost: h\r\n"
    println(r.user_agent())
    println(r.host())
    << 0
}
