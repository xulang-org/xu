@main
#runtime
struct Box { n int
 value string }
fn main() int {
 mut m := map[int]Box{}
 m[1] = Box{n: 40, value: "heap" + "string"}
 for j in 0:4 {
  idx := 1
  r := &m[idx]
  alias := r
  println(alias.n)
  println(alias.value.len)
 }
 for once in 0:1 {
  idx := 1
  r := mut &m[idx]
  r.n += 2
  r.value = "new" + "value"
  println(r.n)
  println(r.value.len)
 }
 mut arrays := map[int][]int{}
 arrays[1] = [10, 20]
 for j in 0:2 {
  idx := 1
  r := mut &arrays[idx]
  r.push(30 + j)
  println(r.len)
  println(r[j + 2])
 }
 mut words := map[int]string{}
 words[1] = "heap" + "word"
 for j in 0:2 {
  idx := 1
  r := &words[idx]
  prefix := "heap"
  println(runtime.starts_with(r, &prefix))
  println(r.len)
 }
 fixed := [1]Box{Box{n: 7, value: "fixed" + "field"}}
 for j in 0:2 {
  idx := 0
  r := &fixed[idx]
  println(r.n)
  println(r.value.len)
 }
 local := Box{n: 5, value: "local" + "field"}
 println(frame_len(&local))
 << 0
}
// Checker visits this function last; its locals must not determine main's
// reference layout. Its ordinary reference parameter uses the frame ABI.
fn frame_len(b &Box) int { << b.value.len }
