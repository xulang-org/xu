@main

#net
#net/http

fn echo_once(lfd int) {
    mut s := http.Server{lfd: lfd}
    cfd := s.accept() or (err) { << }
    mut req := http.new_request()
    req.read(cfd) or (err) { << }
    println(true)
    println(req.method())
    println(req.path())
    b := req.body()
    w := http.write_response(cfd, 200, &b) or (err) { << }
    println(w > 0)
    c := net.conn_close(cfd) or (err) { << }
    println(c == 0)
}

fn main() int {
    mut s := http.new_server()
    s.listen("127.0.0.1:19881") or (err) { << 1 }
    xu echo_once(s.lfd)
    mut r := http.new_response()
    payload := "ping-body"
    r.post("http://127.0.0.1:19881/echo", &payload) or (err) { << 1 }
    println(true)
    println(r.status_code())
    println(r.body())
    s.close()
    << 0
}
