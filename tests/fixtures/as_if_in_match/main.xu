@main

fn main() int {
    let e: temp = 1
    match 0 {
        0 {
            if true {
                v := e as int
                println(v)
            } else {
                println("no")
            }
        }
        else {
            println("mno")
        }
    }
    let f: temp = 2
    match 1 {
        0 {
            w := f as int
            println(w)
        }
        else {
            if false {
                x := f as int
                println(x)
            } else {
                println("no")
            }
        }
    }
    << 0
}
