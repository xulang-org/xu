@main

#net/http
#os

fn serve() {
    http.listen_and_serve("127.0.0.1:19890", "xu_fs_www") or (err) { << }
}

fn ensure_dir(path string) int {
    os.mkdir(path) or (err) {
        << 0
    }
    << 0
}

fn main() int {
    ensure_dir("xu_fs_www")
    os.write("xu_fs_www/hello.txt", "static-ok") or (err) { << 1 }
    os.write("xu_fs_www/index.html", "<h1>idx</h1>") or (err) { << 1 }
    xu serve()
    sleep_ns(50000000)
    mut r := http.new_response()
    r.get("http://127.0.0.1:19890/hello.txt") or (err) { << 1 }
    println(r.status_code())
    println(r.body())
    mut r2 := http.new_response()
    r2.get("http://127.0.0.1:19890/") or (err) { << 1 }
    println(r2.status_code())
    println(r2.body())
    mut r3 := http.new_response()
    r3.get("http://127.0.0.1:19890/nope") or (err) { << 1 }
    println(r3.status_code())
    << 0
}
