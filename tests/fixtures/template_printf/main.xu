@main

#text/template

fn execute_str_fails(t &template.Template, root string) bool {
    template.execute_str(t, root) or (err) { << true }
    << false
}

fn main() int {
    t1 := template.new("{{printf \"%s\" .}}")
    println(template.execute_str(&t1, "hi") or (err) { << 1 })
    t2 := template.new("{{. | printf \"%q\"}}")
    println(template.execute_str(&t2, "hi") or (err) { << 1 })
    mut d := template.new_dict()
    d.set("Name", "Xu")
    t3 := template.new("{{printf \"%s\" .Name}}")
    println(template.execute(&t3, &d) or (err) { << 1 })
    bad := template.new("{{printf \"%d\" .}}")
    if execute_str_fails(&bad, "x") {
        println("true")
    } else {
        println("false")
    }
    << 0
}
