@main

#errors

fn main() int {
    w := write_file("fixture_io.txt", "hello from xu\nline two\n") or (err) {
        println("write failed")
        << 1
    }
    content := read_file("fixture_io.txt") or (err) {
        println("read failed")
        << 1
    }
    println(content.len)
    println(content == "hello from xu\nline two\n")
    println(w)
    << 0
}
