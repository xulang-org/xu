@main

fn scan(start int) int {
    mut sum := 100
    mut i := start
    while i < 35 {
        sum += i & 15
        i += 1
    }
    << sum * 1000 + i
}

fn extra(start int) int {
    mut sum := 100
    mut other := 7
    mut i := start
    while i < 35 {
        sum += i & 15
        other += 3
        i += 1
    }
    << sum * 1000 + other
}

fn biased(start int, seed int) int {
    mut sum := seed
    mut i := start
    while i < 41 {
        sum += (i & 63) + (0 - 9)
        i += 1
    }
    << sum
}

fn swapped(start int) int {
    mut sum := 37
    mut i := start
    while i < 29 {
        sum = ((0 - 9) + (15 & i)) + sum
        i += 1
    }
    << sum
}

fn wrapping(start int) int {
    mut sum := 9223372036854775807
    mut i := start
    while i < 33 {
        sum += (i & 15) + 9223372036854775807
        i += 1
    }
    << sum
}

fn high(start int) int {
    mut sum := 9223372036854775807
    mut i := start
    while i < 9223372036854775807 {
        sum += (i & (0 - 1)) + (0 - 17)
        i += 1
    }
    << sum ^ i
}

fn main() int {
    for n in 0:58 {
        start := n - 11
        println(scan(start))
        println(extra(start))
        println(biased(start, 101))
        println(swapped(start))
        println(wrapping(start))
    }
    for n in 0:34 {
        println(high(9223372036854775807 - n))
    }
    << 0
}
