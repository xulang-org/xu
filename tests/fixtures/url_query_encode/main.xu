@main

#net/url

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    mut q := url.new_query()
    q.parse("b=2&a=1") or (err) { << 1 }
    println(q.encode())
    show_bool(q.has("a"))
    show_bool(q.has("z"))
    q.set("a", "x y")
    println(q.encode())
    << 0
}
