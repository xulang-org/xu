@main

#bytes

fn is_digit(c int) bool {
    << c >= 48 && c <= 57
}

fn is_comma(c int) bool {
    << c == 44
}

fn to_upper_byte(c int) int {
    if c >= 97 && c <= 122 {
        << c - 32
    }
    << c
}

fn main() int {
    s := "ab12cd"
    println(bytes.index_func(&s, is_digit))
    println(bytes.last_index_func(&s, is_digit))
    t := "hello"
    println(bytes.map_bytes(&t, to_upper_byte))
    u := "a,,b,"
    fs := bytes.fields_func(&u, is_comma)
    println(fs.len)
    println(fs[0])
    println(fs[1])
    << 0
}
