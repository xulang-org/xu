@main

#encoding/json

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn compact_fails(src &string) bool {
    _ := json.compact(src) or (err) {
        << true
    }
    << false
}

fn main() int {
    pretty := "{ \"a\" : [ 1 , 2 ] , \"b\" : true }"
    show_bool(json.valid(&pretty))
    println(json.compact(&pretty) or (err) { << 1 })
    src := "{\"a\":[1,2],\"b\":true,\"c\":{}}"
    pre := ""
    gap := "  "
    println(json.indent(&src, &pre, &gap) or (err) { << 1 })
    bad := "{\"a\":1,}"
    show_bool(json.valid(&bad))
    show_bool(compact_fails(&bad))
    empty := ""
    show_bool(json.valid(&empty))
    n := "  42  "
    println(json.compact(&n) or (err) { << 1 })
    << 0
}
