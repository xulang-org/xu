@main

#strconv

fn ppf(s string, rng bool) {
    v := strconv.parse_float(&s) or (err) {
        if rng {
            println("parse_float: value out of range")
        } else {
            println("parse_float: invalid syntax")
        }
        <<
    }
    println(strconv.format_float(v, 103, -1) or (err) { << })
}

fn ff(v f64, verb int, prec int) {
    println(strconv.format_float(v, verb, prec) or (err) { << })
}

fn ff_all(v f64) {
    ff(v, 102, -1)
    ff(v, 102, 0)
    ff(v, 102, 2)
    ff(v, 102, 3)
    ff(v, 102, 6)
    ff(v, 102, 17)
    ff(v, 101, -1)
    ff(v, 101, 0)
    ff(v, 101, 2)
    ff(v, 101, 3)
    ff(v, 101, 6)
    ff(v, 101, 17)
    ff(v, 103, -1)
    ff(v, 103, 0)
    ff(v, 103, 2)
    ff(v, 103, 3)
    ff(v, 103, 6)
    ff(v, 103, 17)
}

fn main() int {
    ppf("0", false)
    ppf("-0", false)
    ppf("0.1", false)
    ppf("0.5", false)
    ppf("1.0", false)
    ppf("3.14159", false)
    ppf("1e21", false)
    ppf("1e-5", false)
    ppf("123456789.123", false)
    ppf("0.000001", false)
    ppf("9.223372036854776e18", false)
    ppf("+Inf", false)
    ppf("-Inf", false)
    ppf("Inf", false)
    ppf("NaN", false)
    ppf("Infinity", false)
    ppf("infinity", false)
    ppf("nan", false)
    ppf("NAN", false)
    ppf("1e-999", false)
    ppf("abc", false)
    ppf("", false)
    ppf("1.2.3", false)
    ppf("1e", false)
    ppf("e5", false)
    ppf("1e999", true)
    ppf("1e400", true)
    ppf("+", false)
    ppf("--1", false)
    ppf(" 1", false)
    ppf("+NaN", false)
    ppf("1.5e", false)
    ppf("1e+", false)
    ppf("1e-", false)
    ppf(".", false)
    ppf("-", false)
    ppf("1..2", false)
    ppf("0.1.2", false)

    neg0s := "-0"
    pinf_s := "Inf"
    ninf_s := "-Inf"
    nan_s := "NaN"
    ff_all(0.0)
    ff_all(strconv.parse_float(&neg0s) or (err) { << 1 })
    ff_all(0.1)
    ff_all(0.5)
    ff_all(1.0)
    ff_all(3.14159)
    ff_all(1e21)
    ff_all(1e-5)
    ff_all(123456789.123)
    ff_all(0.000001)
    ff_all(strconv.parse_float(&pinf_s) or (err) { << 1 })
    ff_all(strconv.parse_float(&ninf_s) or (err) { << 1 })
    ff_all(strconv.parse_float(&nan_s) or (err) { << 1 })
    ff_all(9.223372036854776e18)
    ff_all(0.3)
    ff_all(1.0 / 3.0)
    ff_all(2.5)
    ff_all(1.5)
    ff_all(0.05)
    ff_all(0.15)
    ff_all(0.25)
    ff_all(1.005)
    ff_all(2.675)
    ff_all(123.456)
    ff_all(6.02214076e23)
    << 0
}
