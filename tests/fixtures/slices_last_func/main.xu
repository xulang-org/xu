@main

#slices

fn odd(x int) bool {
    << x % 2 == 1
}

fn even(x int) bool {
    << x % 2 == 0
}

fn is_a(s string) bool {
    << s == "a"
}

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    a := [2, 3, 4, 5]
    println(slices.last_index_func_ints(&a, odd))
    println(slices.last_index_func_ints(&a, even))
    s := ["b", "a", "c", "a"]
    println(slices.last_index_func_strs(&s, is_a))
    println(slices.min_str(&s) or (err) { << 1 })
    println(slices.max_str(&s) or (err) { << 1 })
    o := [1, 2, 3]
    show_bool(slices.is_sorted_ints(&o))
    n := [1, 3, 2]
    show_bool(slices.is_sorted_ints(&n))
    so := ["a", "b", "c"]
    show_bool(slices.is_sorted_strs(&so))
    << 0
}
