@main

#regexp

fn main() int {
    re := regexp.compile(",") or (err) { << 1 }
    s := "a,b,c"
    all := re.split(&s, 0 - 1)
    println(all.len)
    println(all[0])
    println(all[1])
    println(all[2])
    two := re.split(&s, 2)
    println(two.len)
    println(two[0])
    println(two[1])
    one := re.split(&s, 1)
    println(one.len)
    println(one[0])
    z := re.split(&s, 0)
    println(z.len)
    << 0
}
