@main

#encoding/base32

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn decode_fails(s string) bool {
    base32.decode_string(s) or (err) { << true }
    << false
}

fn main() int {
    println(base32.encode_to_string("foo"))
    println(base32.encode_to_string("f"))
    println(base32.encode_to_string("fo"))
    println(base32.encode_to_string("foob"))
    println(base32.encode_to_string("fooba"))
    println(base32.encode_to_string("foobar"))
    println(base32.decode_string("MZXW6===") or (err) { << 1 })
    println(base32.decode_string("MZXW6YTB") or (err) { << 1 })
    round := base32.encode_to_string("Hello, Xu!")
    println(base32.decode_string(round) or (err) { << 1 })
    show_bool(decode_fails("MZXW6=="))
    show_bool(decode_fails("!!!!===="))
    println(base32.encoded_len(3))
    println(base32.decoded_len(8))
    << 0
}
