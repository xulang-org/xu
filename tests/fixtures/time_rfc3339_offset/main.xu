@main

#time

fn show_parse_error(s &string) {
    time.parse_rfc3339(s) or (err) {
        println(err.msg())
        <<
    }
    println("unexpected parse success")
}

fn main() int {
    east := "1970-01-01T08:00:00+08:00"
    t := time.parse_rfc3339(&east) or (err) {
        println(err.msg())
        << 1
    }
    println(t.unix())

    west := "1969-12-31T19:00:00-05:00"
    t2 := time.parse_rfc3339(&west) or (err) {
        println(err.msg())
        << 1
    }
    println(t2.unix())

    fraction := "1970-01-01T00:00:00.123456789Z"
    t3 := time.parse_rfc3339(&fraction) or (err) {
        println(err.msg())
        << 1
    }
    println(t3.nsec)

    bad := "1970-02-30T00:00:00Z"
    show_parse_error(&bad)

    bad_zone := "1970-01-01T00:00:00+24:00"
    show_parse_error(&bad_zone)

    trailing := "1970-01-01T00:00:00Ztail"
    show_parse_error(&trailing)
    << 0
}
