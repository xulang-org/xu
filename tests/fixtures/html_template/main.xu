@main

#html/template

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn execute_str_failed(t &template.Template, root string) bool {
    << template.execute_str(t, root) == ""
}

fn main() int {
    t := template.new("<p>{{.Name}}</p>")
    mut d := template.new_dict()
    d.set("Name", "<script>")
    println(template.execute(&t, &d))

    t2 := template.new("Hi {{.}}!")
    println(template.execute_str(&t2, "a&b\"c"))

    t3 := template.new("{{if .Ok}}yes {{.Ok}}{{else}}no{{end}}")
    mut d2 := template.new_dict()
    d2.set("Ok", "<x>")
    println(template.execute(&t3, &d2))
    mut d3 := template.new_dict()
    println(template.execute(&t3, &d3))

    t4 := template.new("{{range .}}<li>{{.}}</li>{{end}}")
    mut items := []string{}
    items.push("<a>")
    items.push("b")
    println(template.execute_list(&t4, items))

    t5 := template.new("{{with .X}}<b>{{.}}</b>{{else}}none{{end}}")
    mut d4 := template.new_dict()
    d4.set("X", "<em>")
    println(template.execute(&t5, &d4))
    mut d5 := template.new_dict()
    println(template.execute(&t5, &d5))

    show_bool(template.get(&d, "Name") == "<script>")
    bad := template.new("{{.X")
    show_bool(execute_str_failed(&bad, "z"))
    << 0
}
