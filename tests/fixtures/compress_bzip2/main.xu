@main

#compress/bzip2

fn from_hex(h string) string {
    mut out := ""
    mut i := 0
    while i + 1 < h.len {
        mut v := 0
        for k in 0:2 {
            c := h[i + k]
            mut d := 0
            if c >= 48 && c <= 57 {
                d = c - 48
            } else if c >= 97 && c <= 102 {
                d = c - 87
            }
            v = v * 16 + d
        }
        out = out + string_from_byte(v)
        i = i + 2
    }
    << out
}

fn bzip2_read_fails(r bzip2.Reader) bool {
    mut rr := r
    rr.read_all() or (err) { << true }
    << false
}

fn main() int {
    empty := from_hex("425a683917724538509000000000")
    mut r0 := bzip2.new_reader(empty)
    back0 := r0.read_all() or (err) { << 1 }
    println(back0.len)

    hello := from_hex("425a6839314159265359555a44f70000021980400010001264c0102000220069ea100305d3b62183c5dc914e14241556913dc0")
    mut rh := bzip2.new_reader(hello + "")
    println(rh.read_all() or (err) { << 1 })

    a100 := from_hex("425a68393141592653598a5721bd0000020100600020002100820b1772453850908a5721bd")
    mut ra := bzip2.new_reader(a100)
    sa := ra.read_all() or (err) { << 1 }
    println(sa.len)

    pangram := from_hex("425a6839314159265359459dee610000041380400004003ffffff0200031468680000031e9a9a64c8611b46d4762620849ed7aa1536565b125e3e260b1f89839dd4c096f9ce85dc914e142411677b984")
    mut rp := bzip2.new_reader(pangram)
    println(rp.read_all() or (err) { << 1 })

    if bzip2_read_fails(bzip2.new_reader("notbz")) {
        println("bad_magic")
    }
    if bzip2_read_fails(bzip2.new_reader(hello[0:hello.len - 1])) {
        println("trunc_err")
    }
    << 0
}
