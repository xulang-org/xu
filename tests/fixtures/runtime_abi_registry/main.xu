@main
#xu/types
fn main() int {
    mut names := []string{}
    names.push("starts_with")
    names.push("itoa")
    names.push("parse_int")
    names.push("str_bytes")
    names.push("str_runes")
    names.push("is_digit")
    names.push("is_alpha")
    names.push("is_alnum")
    names.push("is_space")
    names.push("map_mix64")
    names.push("map_hash_int")
    names.push("map_hash_string")
    names.push("map_insert_action")

    for i in 0:names.len {
        name := names[i]
        id := types.runtime_abi_id(&name)
        println(id)
        println(types.runtime_abi_nparams(id))
        println(types.runtime_abi_param_shape(id, 0))
        println(types.runtime_abi_result_shape(id))
        println(types.runtime_abi_throws(id))
    }
    unknown := "not_registered"
    println(types.runtime_abi_id(&unknown))
    println(types.runtime_abi_nparams(0))
    println(types.runtime_abi_declared_effects(0))
    println(types.runtime_abi_param_shape(1, 2))
    << 0
}
