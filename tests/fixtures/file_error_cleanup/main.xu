@main

#errors
#os

// Exercise the two failure paths that allocate temporary buffers before the
// syscall: read_file on a directory (open succeeds, read fails) and read_dir
// on a regular file (open/readdir fails).  Repeating each failure path keeps
// the regression deterministic while still making a leaked temporary visible
// to an external RSS/allocator-balance stress run.
fn read_file_fails(path string) bool {
    read_file(path) or (err) {
        << true
    }
    << false
}

fn read_dir_fails(path string) bool {
    read_dir(path) or (err) {
        << true
    }
    << false
}

fn remove_quiet(path string) {
    os.remove(path) or (err) {
        <<
    }
}

fn main() int {
    dir := "xu_cleanup_probe_dir"
    file := dir + "/file"
    remove_quiet(file + "")
    remove_quiet(dir + "")
    os.mkdir(dir + "") or (err) { << 1 }
    os.write(file + "", "x") or (err) { << 1 }

    mut read_fail := 0
    mut dir_fail := 0
    for i in 0:64 {
        if read_file_fails(dir + "") { read_fail += 1 }
        if read_dir_fails(file + "") { dir_fail += 1 }
    }

    os.remove(file + "") or (err) { << 1 }
    os.remove(dir + "") or (err) { << 1 }
    println(read_fail)
    println(dir_fail)
    << 0
}
