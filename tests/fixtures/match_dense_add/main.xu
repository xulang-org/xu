@main

// User-shaped dense match inside a counted loop (select-add / jump table).
fn main() int {
    mut total := 0
    mut i := 0
    while i < 8000 {
        k := i & 7
        match k {
            0 { total += 1 }
            1 { total += 3 }
            2 { total += 5 }
            3 { total += 7 }
            4 { total += 11 }
            5 { total += 13 }
            6 { total += 17 }
            else { total += 19 }
        }
        i += 1
    }
    println(total)
    << 0
}
