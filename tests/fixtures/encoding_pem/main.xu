@main

#encoding/pem

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    nl := string_from_byte(10)
    msg := "-----BEGIN MESSAGE-----" + nl + "aGk=" + nl + "-----END MESSAGE-----" + nl + "tail"
    b := pem.decode(&msg)
    println(b.typ)
    println(b.bytes)
    println(b.rest)
    println(b.keys.len)
    enc := pem.encode_to_memory(&b)
    b2 := pem.decode(&enc)
    println(b2.typ)
    println(b2.bytes)
    hdr := "-----BEGIN FOO-----" + nl + "X-A: 1" + nl + nl + "aGk=" + nl + "-----END FOO-----" + nl
    h := pem.decode(&hdr)
    println(h.typ)
    println(h.keys.len)
    println(h.keys[0])
    println(h.vals[0])
    println(h.bytes)
    none := "not pem"
    n := pem.decode(&none)
    show_bool(n.typ == "")
    println(n.rest)
    << 0
}
