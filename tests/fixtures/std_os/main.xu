@main

#os

fn read_fails(path string) bool {
    os.read(path) or (err) {
        << true
    }
    << false
}

fn main() int {
    println(os.args().len > 0)
    n := os.write("xu_std_os.txt", "hello os\n") or (err) {
        println(false)
        << 0
    }
    println(true)
    body := os.read("xu_std_os.txt") or (err) {
        << 1
    }
    println(body == "hello os\n")
    println(n)
    println(read_fails("no_such_xu_std_os.txt"))
    os.read_dir(".") or (err) {
        println(false)
        << 0
    }
    println(true)
    println(os.getpid() > 0)
    println(os.getppid() >= 0)
    println(os.getuid() >= -1)
    println(os.geteuid() >= -1)
    println(os.getgid() >= -1)
    println(os.getegid() >= -1)
    ps := os.getpagesize()
    println(ps >= 4096 && ps % 4096 == 0)
    println(os.hostname().len > 0)
    println(os.getwd().len > 0)
    println(os.getenv("PATH").len > 0)
    println(os.getenv("XU_NO_SUCH_VAR_42") == "")
    println(os.environ().len > 0)
    println(os.temp_dir().len > 0)
    println(os.home_dir().len > 0)
    << 0
}
