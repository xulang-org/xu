@main

#container/list

fn main() int {
    mut l := list.new()
    a := l.push_back("a")
    b := l.push_back("b")
    c := l.push_back("c")
    l.move_after(a, b)
    println(list.value(&l, list.front(&l)))
    println(list.value(&l, list.next(&l, list.front(&l))))
    l.move_before(c, b)
    println(list.value(&l, list.front(&l)))
    println(list.value(&l, list.next(&l, list.front(&l))))
    << 0
}
