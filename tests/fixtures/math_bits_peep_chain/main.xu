@main
// Emitter bit peeps (ror/rev/clz fusion) under fixed register homes:
// 1. a peep result consumed by the next peep through a skipped Copy chain
//    (`x = rotate_left(..); x = reverse_bytes(x)` read stale x before
//    2026-09-11);
// 2. `acc += len(a); acc += leading_zeros(b)` with a != b must not fuse to
//    +64 (two dead-disjoint temps legally share one home register).
#math/bits

fn main() int {
    mut x := 0x123456789abcdef0
    mut sum := 0
    mut i := 0
    while i < 1000 {
        x = bits.rotate_left(x ^ i, 13)
        x = bits.reverse_bytes(x)
        sum = sum ^ x
        i += 1
    }
    println(sum)

    mut x0 := 1804940083585522366
    mut x1 := -1280803141121722431
    mut s2 := 0
    mut k := 0
    while k < 39 {
        s2 += bits.len(x0)
        s2 += bits.leading_zeros(x1)
        x1 = bits.rotate_left(x0 ^ k, 63)
        k += 1
    }
    println(s2)
    println(x1)

    mut y := 0x0f0f_1234_5678_9abc
    mut s3 := 0
    mut j := 0
    while j < 200 {
        y = bits.rotate_right(y ^ j, 7)
        s3 += bits.trailing_zeros(y)
        y = bits.reverse(y)
        s3 += bits.ones_count(y)
        s3 = s3 ^ bits.reverse_bytes(y)
        j += 1
    }
    println(s3)
    << 0
}
