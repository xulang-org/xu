@main

#runtime

fn leaf(a int) int {
    << a + 1
}

fn leaf2(a int) int {
    << a * 2
}

fn main() int {
    // Regression for O1 + #runtime: CFG-leaf inline runs at O1 and must
    // fail closed when mir_fn_commit refuses (never hand back a live fn
    // index that is out of range). Smoke the import + several leaf calls.
    fr := runtime.caller(0)
    println(fr.ok)
    x := 20
    y := leaf(x)
    z := leaf2(y)
    println(z)
    println(leaf(leaf(leaf(1))))
    << 0
}
