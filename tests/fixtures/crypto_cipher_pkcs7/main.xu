@main

#crypto/aes
#crypto/cipher
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn unpad_fails(data &string) bool {
    cipher.unpad_pkcs7(data) or (err) { << true }
    << false
}

fn pad_fails(data &string, size int) bool {
    cipher.pad_pkcs7(data, size) or (err) { << true }
    << false
}

fn encrypt_cbc_fails(c &aes.Cipher, iv &string, pt &string) bool {
    cipher.encrypt_cbc(c, iv, pt) or (err) { << true }
    << false
}

fn main() int {
    hi := "hi"
    p := cipher.pad_pkcs7(&hi, 16) or (err) { << 1 }
    println(p.len)
    println(p[p.len - 1] & 255)
    println(cipher.unpad_pkcs7(&p) or (err) { << 1 })

    empty := ""
    e := cipher.pad_pkcs7(&empty, 16) or (err) { << 1 }
    println(e.len)
    eu := cipher.unpad_pkcs7(&e) or (err) { << 1 }
    println(eu.len)

    full := "0123456789abcdef"
    f := cipher.pad_pkcs7(&full, 16) or (err) { << 1 }
    println(f.len)
    println(f[f.len - 1] & 255)

    key := hex.decode_string("2b7e151628aed2a6abf7158809cf4f3c") or (err) { << 1 }
    iv := hex.decode_string("000102030405060708090a0b0c0d0e0f") or (err) { << 1 }
    c := aes.new_cipher(&key) or (err) { << 1 }
    msg := "Hello, Xu!"
    ct := cipher.encrypt_cbc_pkcs7(&c, &iv, &msg) or (err) { << 1 }
    println(hex.encode_to_string(ct + ""))
    back := cipher.decrypt_cbc_pkcs7(&c, &iv, &ct) or (err) { << 1 }
    println(back)

    bad := "x"
    show_bool(unpad_fails(&bad))
    show_bool(pad_fails(&hi, 0))
    short := "nope"
    show_bool(encrypt_cbc_fails(&c, &iv, &short))
    << 0
}
