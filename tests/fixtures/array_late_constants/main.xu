@main
fn mingle(v int, k int) int {
    y := v & 4294967295
    << ((y << k) & 4294967295) | (y >> (32 - k))
}
fn bend(v int, k int) int {
    c := k + 9223372036854775800
    << (v + c) ^ (c * 31)
}
fn mix0(a &mut []int, p int, q int) int {
    a[p] = mingle(a[p], 7)
    a[q] = mingle(a[q] ^ a[p], 16)
    << a[p] ^ a[q]
}
fn mix1(a &mut []int, p int, q int) int {
    a[p] = mingle(a[p], 0)
    a[q] = mingle(a[q] ^ a[p], 32)
    << a[p] ^ a[q]
}
fn mix2(a &mut []int, p int, q int) int {
    a[p] = mingle(a[p], 63)
    a[q] = mingle(a[q] ^ a[p], 64)
    << a[p] ^ a[q]
}
fn mix3(a &mut []int, p int, q int) int {
    a[p] = mingle(a[p], -1)
    a[q] = mingle(a[q] ^ a[p], 31)
    << a[p] ^ a[q]
}
fn overflow(a &mut []int, p int, q int) int {
    a[p] = bend(a[p], 17)
    a[q] = bend(a[q], -31)
    << a[p] + a[q]
}
fn main() int {
    for k in 0:32 {
        mut a := []int{}
        for j in 0:8 { a.push((j * 17 - k * 31) ^ (j << 57) ^ (k << 54)) }
        p := k & 7
        q := (k * 3) & 7
        println(mix0(mut &a, p, q))
        println(mix1(mut &a, p, q))
        println(mix2(mut &a, p, q))
        println(mix3(mut &a, p, q))
        println(overflow(mut &a, p, q))
        for j in 0:8 { println(a[j]) }
    }
    << 0
}
