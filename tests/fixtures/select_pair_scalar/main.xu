@main
fn pair(a int, b int, c int, d int, flag bool) int {
    mut x := 0
    mut y := 0
    if flag {
        x = a + 1
        y = c
    } else {
        x = b
        y = d + 1
    }
    << x * 31 + y
}
fn main() int {
    for i in 0:9 {
        println(pair(i, i + 3, i + 7, i + 11, i % 2 == 0))
    }
    << 0
}
