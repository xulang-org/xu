@main

#errors

struct Part {
    name string
    n    int
}

struct Buffer {
    data string
    off  int
}

struct URL {
    scheme string
    host   string
    path   string
}

fn make_inline() Part {
    << Part{name: "hello", n: 7}
}

fn make_local() Part {
    p := Part{name: "world", n: 9}
    << p
}

fn make_derived() Part {
    base := "ab"
    out := base + "c"
    p := Part{name: out, n: 3}
    << p
}

fn via_q() Part {
    p := make_local()
    << p
}

fn early_err(flag int) Part {
    p := Part{name: "tmp", n: 1}
    if flag == 0 {
        >> errors.new("nope")
    }
    << p
}

fn make_buf() Buffer {
    mut b := Buffer{data: "hi", off: 0}
    b.data = b.data + "x"
    << b
}

fn make_url() URL {
    u := URL{scheme: "https", host: "ex.com", path: "/a"}
    << u
}

fn make_strs() []string {
    mut a := []string{}
    a.push("x")
    a.push("y")
    << a
}

fn show_early_fail() {
    early_err(0) or (err) {
        println(err.msg())
        <<
    }
}

fn main() int {
    a := make_inline()
    println(a.name)
    println(a.n)
    b := make_local()
    println(b.name)
    println(b.n)
    c := make_derived()
    println(c.name)
    println(c.n)
    d := via_q()
    println(d.name)
    println(d.n)
    e := early_err(1) or (err) {
        << 1
    }
    println(e.name)
    show_early_fail()
    buf := make_buf()
    println(buf.data)
    println(buf.off)
    u := make_url()
    println(u.scheme)
    println(u.host)
    println(u.path)
    ss := make_strs()
    println(ss.len)
    println(ss[0])
    println(ss[1])
    << 0
}
