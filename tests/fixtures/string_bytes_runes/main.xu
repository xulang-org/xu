@main
fn main() int {
    b := "abc".bytes()
    println(b.len)
    println(b[0])
    println(b[1])
    println(b[2])
    s := "café"
    r := s.runes()
    println(s.len)
    println(r.len)
    println(r[0])
    println(r[1])
    println(r[2])
    println(r[3])
    e := "".bytes()
    println(e.len)
    er := "".runes()
    println(er.len)
    t := "Hi"
    b2 := t.bytes()
    println(t.len)
    println(string_from_bytes(b2))
    han := "你".runes()
    println(han.len)
    println(han[0])
    << 0
}
