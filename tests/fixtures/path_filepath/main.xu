@main

fp #path/filepath

fn main() int {
    a := "/a/b/../c/./d//"
    println(fp.clean(&a))
    b := "a/b/../../c"
    println(fp.clean(&b))
    empty := ""
    println(fp.clean(&empty))
    root := "/"
    println(fp.clean(&root))
    parts := ["a", "b", "..", "c"]
    println(fp.join(parts))
    win := "a\\b\\c.txt"
    println(fp.to_slash(&win))
    println(fp.base(&win))
    println(fp.dir(&win))
    println(fp.ext(&win))
    abs := "/usr/bin"
    println(fp.is_abs(&abs))
    relp := "usr/bin"
    println(fp.is_abs(&relp))
    sp := fp.split(&abs)
    println(sp[0])
    println(sp[1])
    base := "/a/b/c"
    targ := "/a/b/c/d/e"
    println(fp.rel(&base, &targ) or (err) { << 1 })
    up := "/a/x"
    println(fp.rel(&base, &up) or (err) { << 1 })
    << 0
}
