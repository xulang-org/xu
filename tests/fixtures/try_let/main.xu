@main

#errors

fn fail_if_zero(n int) int {
    if n == 0 {
        >> errors.new("zero")
    }
    << n * 2
}

fn double(n int) int {
    x := fail_if_zero(n)
    << x + 1
}

fn main() int {
    d := double(21) or (err) {
        << 1
    }
    println(true)
    println(d)
    _ := double(0) or (err) {
        println(false)
        << 0
    }
    << 0
}
