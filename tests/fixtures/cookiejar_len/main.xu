@main

#net/http/cookiejar
#net/url

fn main() int {
    mut j := cookiejar.new_jar()
    println(j.len())
    mut u := url.parse_url("http://ex.com/x") or (err) { << 1 }
    c := cookiejar.Cookie{name: "a", value: "1", path: "/", domain: "", secure: false, http_only: false, max_age: 0}
    j.set_cookie(&u, c)
    println(j.len())
    << 0
}
