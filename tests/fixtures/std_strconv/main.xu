@main

#strconv

fn atoi_fails(s &string) bool {
    strconv.atoi(s) or (err) {
        << true
    }
    << false
}

fn parse_fails(s &string, base int) bool {
    strconv.parse(s, base) or (err) {
        << true
    }
    << false
}

fn parse_bool_fails(s &string) bool {
    strconv.parse_bool(s) or (err) {
        << true
    }
    << false
}

fn main() int {
    a := "42"
    println(strconv.atoi(&a) or (err) { << 1 })
    b := "-17"
    println(strconv.atoi(&b) or (err) { << 1 })
    z := "0"
    println(strconv.atoi(&z) or (err) { << 1 })
    mx := "9223372036854775807"
    println(strconv.atoi(&mx) or (err) { << 1 })
    mn := "-9223372036854775808"
    println(strconv.atoi(&mn) or (err) { << 1 })
    ov := "9223372036854775808"
    println(atoi_fails(&ov))
    un := "-9223372036854775809"
    println(atoi_fails(&un))
    plus := "+5"
    println(atoi_fails(&plus))
    println(strconv.itoa(42))
    println(strconv.itoa(0))
    println(strconv.itoa(0 - 999))
    println(strconv.itoa(strconv.atoi(&mn) or (err) { << 1 }))
    t := "true"
    println(strconv.parse_bool(&t) or (err) { << 1 })
    f := "False"
    println(strconv.parse_bool(&f) or (err) { << 1 })
    badb := "yes"
    println(parse_bool_fails(&badb))
    println(strconv.format_bool(true))
    println(strconv.format_bool(false))
    println(strconv.format_int(255, 16) or (err) { << 1 })
    println(strconv.format_int(8, 2) or (err) { << 1 })
    println(strconv.format_int(0 - 10, 16) or (err) { << 1 })
    hex := "ff"
    println(strconv.parse(&hex, 16) or (err) { << 1 })
    hex2 := "FF"
    println(strconv.parse(&hex2, 16) or (err) { << 1 })
    bin := "-10"
    println(strconv.parse(&bin, 2) or (err) { << 1 })
    himin := "-8000000000000000"
    println(strconv.parse(&himin, 16) or (err) { << 1 })
    himax := "7fffffffffffffff"
    println(strconv.parse(&himax, 16) or (err) { << 1 })
    bighex := "8000000000000000"
    println(parse_fails(&bighex, 16))
    println(parse_fails(&a, 3))
    gg := "gg"
    println(parse_fails(&gg, 16))
    println(strconv.quote_rune(97))
    println(strconv.quote_rune(10))
    println(strconv.quote_rune(0x4E16))
    println(strconv.quote_rune(7))
    pre := "pre"
    println(strconv.append_int(pre + "", 0 - 9, 10) or (err) { << 1 })
    println(strconv.append_uint("", 255, 16) or (err) { << 1 })
    println(strconv.append_bool("", true))
    ab := "a\"b"
    println(strconv.append_quote("", &ab))
    << 0
}
