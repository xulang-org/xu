@main

#crypto/rand

fn main() int {
    a := rand.read(16) or (err) { << 1 }
    b := rand.read(16) or (err) { << 1 }
    if a.len != 16 {
        << 1
    }
    if b.len != 16 {
        << 1
    }
    if a == b {
        << 1
    }
    println(a.len)
    z := rand.read(0) or (err) { << 1 }
    println(z.len)
    << 0
}
