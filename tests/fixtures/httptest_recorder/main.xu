@main

#net/http/httptest

fn main() int {
    mut rec := httptest.new_recorder()
    rec.header_set("content-type", "text/plain")
    rec.write_header(201)
    rec.write_header(500)
    body := "ok"
    rec.write(&body)
    rec.header_set("X-Too-Late", "no")
    println(rec.result_code())
    println(rec.result_body())
    println(rec.result_header("Content-Type"))
    miss := rec.result_header("X-Too-Late")
    if miss.len == 0 {
        println("late")
    }
    req := httptest.new_request("GET", "/x", "")
    println(req.method())
    println(req.path())
    post := httptest.new_request("POST", "http://example.com/y", "hi")
    println(post.method())
    println(post.path())
    println(post.body())
    mut rec2 := httptest.new_recorder()
    hello := "hello"
    rec2.write(&hello)
    println(rec2.result_code())
    empty := httptest.new_request("GET", "", "")
    println(empty.path())
    << 0
}
