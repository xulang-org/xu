@main

struct Inner {
    pub e temp
    pub x int
}

struct Wrap {
    pub inner Inner
    pub n int
}

fn main() int {
    b := Wrap{inner: Inner{e: 1, x: 8}, n: 9}
    if true {
        v := b.inner.e as int
        println(v)
    } else {
        println("no")
    }
    println(b.inner.e)
    << 0
}
