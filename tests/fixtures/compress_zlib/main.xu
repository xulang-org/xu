@main

#compress/zlib

fn from_hex(h string) string {
    mut out := ""
    mut i := 0
    while i + 1 < h.len {
        mut v := 0
        for k in 0:2 {
            c := h[i + k]
            mut d := 0
            if c >= 48 && c <= 57 {
                d = c - 48
            } else if c >= 97 && c <= 102 {
                d = c - 87
            }
            v = v * 16 + d
        }
        out = out + string_from_byte(v)
        i = i + 2
    }
    << out
}

fn zlib_read_fails(r zlib.Reader) bool {
    mut rr := r
    rr.read_all() or (err) { << true }
    << false
}

fn main() int {
    hw := "hello world"
    mut w := zlib.new_writer()
    w.write(&hw) or (err) { << 1 }
    w.close()
    g := w.bytes()
    mut r := zlib.new_reader(g + "")
    println(r.read_all() or (err) { << 1 })

    empty := ""
    mut w0 := zlib.new_writer()
    w0.write(&empty) or (err) { << 1 }
    w0.close()
    mut r0 := zlib.new_reader(w0.bytes())
    back0 := r0.read_all() or (err) { << 1 }
    println(back0.len)

    mut rp := zlib.new_reader(from_hex("789c8b280500012700ce"))
    println(rp.read_all() or (err) { << 1 })

    short := g[0:g.len - 1]
    if zlib_read_fails(zlib.new_reader(short)) {
        println("trunc_err")
    }
    << 0
}
