@main

#sort

fn main() int {
    mut a := []int{}
    a.push(3)
    a.push(1)
    a.push(2)
    a.push(1)
    sort.ints(mut &a)
    println(a[0])
    println(a[1])
    println(a[2])
    println(a[3])
    mut s := []string{}
    s.push("banana")
    s.push("apple")
    s.push("cherry")
    s.push("apricot")
    sort.strings(mut &s)
    println(s[0])
    println(s[1])
    println(s[2])
    println(s[3])
    mut f := []f64{}
    f.push(2.5)
    f.push(-1.0)
    f.push(3.75)
    sort.f64s(mut &f)
    println(f[0])
    println(f[1])
    println(f[2])
    mut one := []int{}
    one.push(7)
    sort.ints(mut &one)
    println(one[0])
    mut empty := []int{}
    sort.ints(mut &empty)
    println(empty.len)
    mut r := []int{}
    r.push(1)
    r.push(3)
    r.push(2)
    sort.reverse_ints(mut &r)
    println(r[0])
    println(r[1])
    println(r[2])
    mut rs := []string{}
    rs.push("b")
    rs.push("c")
    rs.push("a")
    sort.reverse_strings(mut &rs)
    println(rs[0])
    println(rs[2])
    mut rf := []f64{}
    rf.push(1.0)
    rf.push(3.0)
    rf.push(2.0)
    sort.reverse_f64s(mut &rf)
    println(rf[0])
    println(rf[2])
    << 0
}
