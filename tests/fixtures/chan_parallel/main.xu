@main
// two OS threads send concurrently; main receives both values.
fn worker(id int, ch chan int) {
    ch <- id
}

fn main() int {
    ch := chan int{cap: 2}
    xu worker(1, ch)
    xu worker(2, ch)
    mut a := <-ch
    mut b := <-ch
    // Order is nondeterministic; normalize so expected.txt is stable.
    if a > b {
        t := a
        a = b
        b = t
    }
    println(a)
    println(b)
    << 0
}
