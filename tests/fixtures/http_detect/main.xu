@main

#net/http

fn main() int {
    empty := ""
    println(http.detect_content_type(&empty))
    pdf := "%PDF-1.4"
    println(http.detect_content_type(&pdf))
    html := "<html>"
    println(http.detect_content_type(&html))
    xml := "<?xml version=\"1.0\"?>"
    println(http.detect_content_type(&xml))
    bin := string_from_byte(0)
    println(http.detect_content_type(&bin))
    << 0
}
