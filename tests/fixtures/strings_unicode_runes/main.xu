@main

#strings
#bytes
#encoding/hex

fn separator(r int) bool {
    << r == 0x4e2d || r == 0x1f642 || r == 0xfffd || r == 0 || r == 44
}

fn mask_byte(c int) int {
    << c & 127
}

fn dump(a []string) {
    println(a.len)
    for i in 0:a.len {
        println(hex.encode_to_string(a[i] + ""))
    }
}

fn check(s string, cuts &[]string) {
    println(hex.encode_to_string(strings.to_lower(&s)))
    println(hex.encode_to_string(strings.to_upper(&s)))
    println(hex.encode_to_string(bytes.to_lower(&s)))
    println(hex.encode_to_string(bytes.to_upper(&s)))
    println(strings.index_byte(&s, 128))
    println(strings.last_index_byte(&s, 128))
    println(bytes.index_byte(&s, 128))
    println(bytes.last_index_byte(&s, 128))
    println(hex.encode_to_string(strings.map_bytes(&s, mask_byte)))
    println(hex.encode_to_string(bytes.map_bytes(&s, mask_byte)))
    for i in 0:cuts.len {
        c := cuts[i] + ""
        println(strings.index_any(&s, c + ""))
        println(strings.last_index_any(&s, c + ""))
        println(strings.contains_any(&s, c + ""))
        println(hex.encode_to_string(strings.trim_left(&s, c + "")))
        println(hex.encode_to_string(strings.trim_right(&s, c + "")))
        println(hex.encode_to_string(strings.trim(&s, c + "")))
        println(bytes.index_any(&s, c + ""))
        println(bytes.last_index_any(&s, c + ""))
        println(bytes.contains_any(&s, c + ""))
        println(hex.encode_to_string(bytes.trim_left(&s, c + "")))
        println(hex.encode_to_string(bytes.trim_right(&s, c + "")))
        println(hex.encode_to_string(bytes.trim(&s, c + "")))
    }
    println(strings.index_func(&s, separator))
    println(strings.last_index_func(&s, separator))
    println(strings.contains_func(&s, separator))
    println(hex.encode_to_string(strings.trim_left_func(&s, separator)))
    println(hex.encode_to_string(strings.trim_right_func(&s, separator)))
    println(hex.encode_to_string(strings.trim_func(&s, separator)))
    dump(strings.fields_func(&s, separator))
    println(bytes.index_func(&s, separator))
    println(bytes.last_index_func(&s, separator))
    println(bytes.contains_func(&s, separator))
    println(hex.encode_to_string(bytes.trim_left_func(&s, separator)))
    println(hex.encode_to_string(bytes.trim_right_func(&s, separator)))
    println(hex.encode_to_string(bytes.trim_func(&s, separator)))
    dump(bytes.fields_func(&s, separator))
    runes := [-1, 0, 0x4e2d, 0x1f642, 0xfffd, 0xd800, 0x110000]
    for i in 0:runes.len {
        println(strings.index_rune(&s, runes[i]))
        println(strings.contains_rune(&s, runes[i]))
        println(bytes.index_rune(&s, runes[i]))
        println(bytes.contains_rune(&s, runes[i]))
    }
}

fn main() int {
    mut cuts := []string{}
    cuts.push(hex.decode_string("") or (err) { << 1 })
    cuts.push(hex.decode_string("e6b189") or (err) { << 1 })
