@main
#strings
#encoding/hex
fn check(h string, needle string, pos int, n int, replaced string, limited string, pieces int, pieces3 int) int {
    if strings.index_of(&h, needle + "") != pos { << 1 }
    if strings.count(&h, needle + "") != n { << 2 }
    if strings.replace(&h, needle + "", "!", -1) != replaced { << 3 }
    if strings.replace(&h, needle + "", "!", 2) != limited { << 4 }
    parts := strings.split(&h, needle + "")
    if parts.len != pieces { << 5 }
    if strings.join(parts, needle + "") != h { << 6 }
    parts3 := strings.split_n(&h, needle + "", 3)
    if parts3.len != pieces3 { << 7 }
    if strings.join(parts3, needle + "") != h { << 8 }
    padded := "x" + h + "y"
    v := strings.view_slice(&padded, 1, h.len)
    if v.index(&padded, &needle) != pos { << 9 }
    << 0
}
