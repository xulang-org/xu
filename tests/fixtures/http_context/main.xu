@main

#net/http

fn app(c http.Context) {
    p := c.path()
    if p == "/hello" {
        c.text(200, "ctx-ok") or (err) { << }
        <<
    }
    c.text(404, "no") or (err) { << }
}

fn serve() {
    http.listen_and_serve_handler("127.0.0.1:19891", app) or (err) { << }
}

fn main() int {
    xu serve()
    sleep_ns(50000000)
    mut r := http.new_response()
    r.get("http://127.0.0.1:19891/hello") or (err) { << 1 }
    println(r.status_code())
    println(r.body())
    mut r2 := http.new_response()
    r2.get("http://127.0.0.1:19891/nope") or (err) { << 1 }
    println(r2.status_code())
    << 0
}
