@main

#os

fn argv_count() int {
    local := os.argv()
    << local.len
}

fn argv_heap_churn() int {
    mut junk := []string{}
    for i in 0:96 {
        junk.push("argv-churn-" + str(i))
    }
    mut total := 0
    for i in 0:junk.len {
        total += junk[i].len
    }
    << total
}

fn argv_prog_len() int {
    local := os.argv()
    mut prog := "xu"
    if local.len > 0 {
        prog = local[0]
    }
    << prog.len
}

fn main() int {
    before := argv_count()
    churned := argv_heap_churn()
    prog_len := argv_prog_len()
    first := os.argv()
    second := os.argv()
    third := os.argv()
    println(before > 0)
    println(churned > 0)
    println(prog_len > 0)
    println(first.len == before)
    println(second.len == first.len)
    println(third.len == second.len)
    println(first[0] == second[0])
    println(second[0] == third[0])
    << 0
}
