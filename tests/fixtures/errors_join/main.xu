@main

#errors

fn main() int {
    a := errors.Error(errors.new("one"))
    b := errors.Error(errors.new("two"))
    j := errors.join(a, b)
    println(j.msg())
    empty := errors.Error(errors.new(""))
    b2 := errors.Error(errors.new("two"))
    k := errors.join(empty, b2)
    println(k.msg())
    << 0
}
