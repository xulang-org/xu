@main

#encoding/pem

fn main() int {
    nl := string_from_byte(10)
    hdr := "-----BEGIN FOO-----" + nl + "Proc-Type: 4,ENCRYPTED" + nl + "DEK-Info: AES-256-CBC" + nl + nl + "aGk=" + nl + "-----END FOO-----" + nl
    h := pem.decode(&hdr)
    println(h.typ)
    println(h.header("Proc-Type"))
    println(h.header("DEK-Info"))
    println(h.header("Missing").len)
    println(h.bytes)
    << 0
}
