@main

#errors

fn main() int {
    mut s := "A"
    for i in 0:20 {
        s = s + s
    }
    s.push_str("Z")
    want := 1048577
    if s.len != want {
        println("build len")
        println(s.len)
        << 1
    }
    wn := write_file("large_roundtrip.bin", s) or (err) {
        println("write failed")
        << 1
    }
    if wn != want {
        println("write n")
        println(wn)
        << 1
    }
    content := read_file("large_roundtrip.bin") or (err) {
        println("read failed")
        << 1
    }
    if content.len != want {
        println("read len")
        println(content.len)
        << 1
    }
    if content[0] != 65 {
        println("first")
        << 1
    }
    if content[524288] != 65 {
        println("mid")
        << 1
    }
    if content[want - 1] != 90 {
        println("last")
        << 1
    }
    if content != s {
        println("neq")
        << 1
    }

    mut sum := 0
    for i in 0:256 {
        sum = sum + content[i]
    }
    for i in 0:256 {
        sum = sum + content[want - 256 + i]
    }
    if sum != 33305 {
        println("sum")
        println(sum)
        << 1
    }
    println("ok")
    println(content.len)
    << 0
}
