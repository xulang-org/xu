@main

#slices

fn main() int {
    // Two separate arrays so by-value []int args do not move a shared local.
    // Exercises the indexed-kernel / sole-ref CSE path formerly gated by
    // nfn≥64 (Universal opt P3).
    a := [1, 3, 5, 7, 9]
    println(slices.index_of_int(a, 5))
    b := [1, 3, 5, 7, 9]
    println(slices.contains_int(b, 9))
    << 0
}
