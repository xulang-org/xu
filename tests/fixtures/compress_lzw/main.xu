@main

#compress/lzw
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn encode_fails(data &string, order int, lit int) bool {
    lzw.encode(data, order, lit) or (err) { << true }
    << false
}

fn main() int {
    empty := ""
    enc0 := lzw.encode(&empty, lzw.lsb, 8) or (err) { << 1 }
    println(hex.encode_to_string(enc0 + ""))
    show_bool(hex.encode_to_string(enc0 + "") == "000302")
    back0 := lzw.decode(&enc0, lzw.lsb, 8) or (err) { << 1 }
    println(back0.len)
    hw := "hello world"
    enc := lzw.encode(&hw, lzw.lsb, 8) or (err) { << 1 }
    println(hex.encode_to_string(enc + ""))
    show_bool(hex.encode_to_string(enc + "") == "00d19461c3e60d883b6fe4b0211310")
    back := lzw.decode(&enc, lzw.lsb, 8) or (err) { << 1 }
    show_bool(back == hw)
    gohex := hex.decode_string("00d19461c3e60d883b6fe4b0211310") or (err) { << 1 }
    fromgo := lzw.decode(&gohex, lzw.lsb, 8) or (err) { << 1 }
    show_bool(fromgo == hw)
    tb := "TOBEORNOTTOBEORTOBEORNOT"
    enc2 := lzw.encode(&tb, lzw.lsb, 8) or (err) { << 1 }
    show_bool(hex.encode_to_string(enc2 + "") == "00a93c1152e48914274fa80824687061c183090302")
    back2 := lzw.decode(&enc2, lzw.lsb, 8) or (err) { << 1 }
    show_bool(back2 == tb)
    hello := "hello"
    encm := lzw.encode(&hello, lzw.msb, 8) or (err) { << 1 }
    println(hex.encode_to_string(encm + ""))
    show_bool(hex.encode_to_string(encm + "") == "801a0ca6c361be02")
    backm := lzw.decode(&encm, lzw.msb, 8) or (err) { << 1 }
    show_bool(backm == hello)
    show_bool(encode_fails(&hw, 9, 8))
    << 0
}
