@main

#errors

fn fails(s string) bool {
    parse_int(s) or (err) {
        << true
    }
    << false
}

fn main() int {
    // INT_MIN-2 and INT_MIN-1 must overflow; INT_MIN is the only special case.
    println(fails("-9223372036854775810"))
    println(fails("-9223372036854775809"))
    println(parse_int("-9223372036854775808") or (err) { << 0 })
    println(parse_int("9223372036854775807") or (err) { << 0 })
    println(fails("9223372036854775808"))
    println(parse_int("00042") or (err) { << 0 })
    println(parse_int("-00042") or (err) { << 0 })
    println(parse_int("-0") or (err) { << 0 })
    << 0
}
