@main

#context

fn child_error(c &context.Context) string {
    context.err(c) or (err) {
        << err.msg()
    }
    << ""
}

fn main() int {
    mut parent := context.with_cancel()
    mut child := context.with_cancel_parent(&parent.ctx)
    parent.cancel()
    // Give the parent watcher a scheduling point before probing the child.
    sleep_ns(10000000)
    msg := child_error(&child.ctx)
    if msg.len > 0 {
        println(msg)
    }
    // Explicit cancellation after parent propagation, and a repeated call,
    // must both be harmless (the guard makes close idempotent).
    child.cancel()
    child.cancel()
    println("done")

    // A child canceled before its parent must retire the watcher; canceling
    // the parent afterward must remain harmless and non-blocking.
    mut parent2 := context.with_cancel()
    mut child2 := context.with_cancel_parent(&parent2.ctx)
    child2.cancel()
    parent2.cancel()
    println("child-first done")
    << 0
}
