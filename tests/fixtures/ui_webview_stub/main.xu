@main

#ui
#ui/webview

fn main() int {
    mut app := ui.new_app()
    mut win := app.new_window(ui.WindowOpts{title: "Hello", width: 640, height: 480})
    println(win.title)
    println(win.width)
    println(win.content_slot_kind())
    mut items := []ui.MenuItem{}
    items.push(ui.menu_item("quit", "Quit"))
    win.set_menu(ui.menu(items))
    mut items2 := []ui.MenuItem{}
    items2.push(ui.menu_item("quit", "Quit"))
    tray := app.new_tray(ui.TrayOpts{tip: "xu", icon: ui.icon_default(), menu: ui.menu(items2)})
    println(tray.id)
    r := mut &win
    mut wv := webview.attach(r)
    println(win.content_slot_kind())
    println(wv.window_id)
    wv.load_html("<html></html>") or (err) {
        << 1
    }
    << 1
}
