@main
fn fib(n int) int {
    if n < 2 {
        << n
    }
    << fib(n - 1) + fib(n - 2)
}

fn ping(n int) int {
    if n == 0 {
        << 0
    }
    << pong(n - 1)
}

fn pong(n int) int {
    if n == 0 {
        << 0
    }
    << ping(n - 1)
}

fn main() int {
    println(fib(10))
    println(ping(4))
    << 0
}
