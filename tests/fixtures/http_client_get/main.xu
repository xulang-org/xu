@main

#net
#net/http

fn serve_once(lfd int) {
    cfd := net.accept(lfd) or (err) { << }
    junk := net.conn_read(cfd, 4096) or (err) { << }
    println(junk.len >= 0)
    resp := "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello"
    w := net.conn_write(cfd, &resp) or (err) { << }
    println(w > 0)
    c := net.conn_close(cfd) or (err) { << }
    println(c == 0)
}

fn get_fails(url string) bool {
    mut r := http.new_response()
    r.get(url) or (err) { << true }
    << false
}

fn main() int {
    lfd := net.listen("127.0.0.1:19880") or (err) { << 1 }
    xu serve_once(lfd)
    mut r := http.new_response()
    r.get("http://127.0.0.1:19880/hi") or (err) { << 1 }
    println(true)
    println(r.status_code())
    println(r.body())
    ct := "Content-Type"
    println(r.header(ct))
    lc := net.conn_close(lfd) or (err) { << 1 }
    println(lc == 0)
    println(get_fails("https://127.0.0.1:19880/"))
    << 0
}
