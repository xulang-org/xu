@main

fn fill(v &mut []f64, u &[]f64) {
    n := v.len
    for i in 0:n {
        mut s := 0.0
        for j in 0:n {
            s += u[j] / f64(j + 1)
        }
        v[i] = s
    }
}

fn main() int {
    mut u := []f64{}
    mut v := []f64{}
    u.push(2.0)
    u.push(4.0)
    u.push(6.0)
    v.push(0.0)
    v.push(0.0)
    v.push(0.0)
    fill(mut &v, &u)
    println(int(v[0] * 100.0))
    println(int(v[1] * 100.0))
    println(int(v[2] * 100.0))
    << 0
}
