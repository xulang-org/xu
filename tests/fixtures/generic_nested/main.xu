@main
struct Box#T { v T }

fn take(b Box#Box#int) int { << b.v.v }

fn main() int {
    // Nested generic type arguments use glued `#` (Box#Box#int).
    b := Box#Box#int{v: Box#int{v: 3}}
    println(b.v.v)
    println(take(b))
    // a comparison that only looks like type arguments still parses as one.
    x := 1
    y := 2
    println(x < y)
    << 0
}
