@main

struct Stats {
    count int
    sum int
    acc f64
}

fn run_stats() int {
    mut s := Stats{count: 0, sum: 0, acc: 0.0}
    for i in 0:100 {
        s.count += 1
        s.sum += i
        s.acc += 0.5
    }
    println(s.count)
    println(s.sum)
    println(int(s.acc))
    << 0
}

fn main() int {
    run_stats()
    << 0
}
