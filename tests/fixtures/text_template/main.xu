@main

#text/template

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn execute_str_fails(t &template.Template, root string) bool {
    template.execute_str(t, root) or (err) { << true }
    << false
}

fn main() int {
    t1 := template.new("Hello, {{.}}!")
    println(template.execute_str(&t1, "Xu") or (err) { << 1 })
    mut d := template.new_dict()
    d.set("Name", "Ada")
    d.set("Lang", "Xu")
    t2 := template.new("{{.Name}} writes {{.Lang}}")
    println(template.execute(&t2, &d) or (err) { << 1 })

    t3 := template.new("{{if .Name}}hi {{.Name}}{{else}}anon{{end}}")
    println(template.execute(&t3, &d) or (err) { << 1 })
    mut d2 := template.new_dict()
    println(template.execute(&t3, &d2) or (err) { << 1 })

    t4 := template.new("{{range .}}-{{.}}-{{end}}")
    mut items := []string{}
    items.push("a")
    items.push("b")
    items.push("c")
    println(template.execute_list(&t4, items) or (err) { << 1 })

    t5 := template.new("{{with .Name}}hi {{.}}{{else}}anon{{end}}")
    println(template.execute(&t5, &d) or (err) { << 1 })
    println(template.execute(&t5, &d2) or (err) { << 1 })

    bad := template.new("{{.X")
    show_bool(execute_str_fails(&bad, "z"))
    show_bool(template.get(&d, "Name") == "Ada")
    << 0
}
