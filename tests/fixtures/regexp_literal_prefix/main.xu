@main

#regexp

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    re := regexp.compile("hello") or (err) { << 1 }
    p := re.literal_prefix()
    println(p.prefix)
    show_bool(p.complete)
    re2 := regexp.compile("hello.*") or (err) { << 1 }
    p2 := re2.literal_prefix()
    println(p2.prefix)
    show_bool(p2.complete)
    re3 := regexp.compile(".*") or (err) { << 1 }
    p3 := re3.literal_prefix()
    println(p3.prefix.len)
    show_bool(p3.complete)
    << 0
}
