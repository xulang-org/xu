@main

#mime

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn parse_media_fails(s &string) bool {
    mime.parse_media_type(s) or (err) { << true }
    << false
}

fn main() int {
    s1 := "text/html; charset=UTF-8"
    mt := mime.parse_media_type(&s1) or (err) { << 1 }
    println(mt.typ)
    println(mt.keys.len)
    println(mt.keys[0])
    println(mt.vals[0])
    s2 := "TEXT/PLAIN"
    mt2 := mime.parse_media_type(&s2) or (err) { << 1 }
    println(mt2.typ)
    println(mt2.keys.len)
    s3 := "application/json; charset=\"utf-8\"; v=1"
    mt3 := mime.parse_media_type(&s3) or (err) { << 1 }
    println(mt3.typ)
    println(mt3.keys[0])
    println(mt3.vals[0])
    println(mt3.keys[1])
    println(mt3.vals[1])
    bad := "html"
    show_bool(parse_media_fails(&bad))
    html := ".html"
    println(mime.type_by_extension(&html))
    html_upper := ".HTML"
    println(mime.type_by_extension(&html_upper))
    png := ".png"
    println(mime.type_by_extension(&png))
    json := ".json"
    println(mime.type_by_extension(&json))
    unknown := ".nope"
    println(mime.type_by_extension(&unknown))
    nodot := "html"
    println(mime.type_by_extension(&nodot))
    << 0
}
