@main

struct Reading { value f64 }

fn relations(x f64, y f64) int {
    mut mask := 0
    if x == y { mask += 1 }
    if x != y { mask += 2 }
    if x < y { mask += 4 }
    if x <= y { mask += 8 }
    if x > y { mask += 16 }
    if x >= y { mask += 32 }
    << mask
}

fn self_relations(x f64) int {
    mut mask := 0
    if x == x { mask += 1 }
    if x != x { mask += 2 }
    if x < x { mask += 4 }
    if x <= x { mask += 8 }
    if x > x { mask += 16 }
    if x >= x { mask += 32 }
    << mask
}

// Pointer reads admit the fixed FP homes as well as the stack fallback.
fn field_relations(p &Reading, y f64) int {
    x := p.value
    mut mask := 0
    if x == y { mask += 1 }
    if x != y { mask += 2 }
    if x < y { mask += 4 }
    if x <= y { mask += 8 }
    if x > y { mask += 16 }
    if x >= y { mask += 32 }
    << mask
}

fn values(x f64, y f64) {
    println(x == y)
    println(x != y)
    println(x < y)
    println(x <= y)
    println(x > y)
    println(x >= y)
}

fn main() int {
    nan := 0.0 / 0.0
    inf := 1.0 / 0.0
    println(relations(nan, 1.0) == 2)
    println(relations(1.0, nan) == 2)
    println(self_relations(nan) == 2)
    println(self_relations(inf) == 41)
    println(self_relations(-inf) == 41)
    println(self_relations(0.0) == 41)
    println(relations(-0.0, 0.0) == 41)
    println(relations(1.0, 2.0) == 14)
    println(relations(2.0, 1.0) == 50)
    println(relations(-inf, inf) == 14)
    r := Reading{value: nan}
    println(field_relations(&r, 1.0) == 2)
    println(field_relations(&r, nan) == 2)
    values(nan, nan)
    // Local copy propagation must preserve NaN-sensitive identities.
    println(nan == nan)
    println(nan != nan)
    println(nan <= nan)
    println(nan >= nan)
    i := 7
    println(i == i && i <= i && i >= i && !(i != i))
    << 0
}
