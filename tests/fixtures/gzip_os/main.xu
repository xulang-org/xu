@main

#compress/gzip

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    h0 := gzip.host_os()
    t := xu_target_os()
    if t == 2 {
        show_bool(h0 == gzip.os_fat)
    } else if t == 0 || t == 1 {
        show_bool(h0 == gzip.os_unix)
    } else {
        show_bool(h0 == gzip.os_unknown)
    }
    mut w := gzip.new_writer()
    body := "ok"
    w.write(&body) or (err) { << 1 }
    w.close()
    mut r := gzip.new_reader(w.bytes())
    h := r.header() or (err) { << 1 }
    show_bool(h.os == gzip.host_os())
    mut w2 := gzip.new_writer()
    w2.set_os(3)
    w2.write(&body) or (err) { << 1 }
    w2.close()
    mut r2 := gzip.new_reader(w2.bytes())
    h2 := r2.header() or (err) { << 1 }
    println(h2.os)
    << 0
}
