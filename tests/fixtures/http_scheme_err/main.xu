@main

#net/http

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn unsupported_scheme() bool {
    mut c := http.new_client()
    empty := ""
    c.do("GET", "ftp://example.com/", &empty) or (err) {
        println(err.msg())
        << true
    }
    << false
}

fn missing_host() bool {
    mut c := http.new_client()
    empty := ""
    c.do("GET", "http://", &empty) or (err) {
        println(err.msg())
        << true
    }
    << false
}

fn bad_response_fd() bool {
    body := "x"
    http.write(-1, 200, "text/plain", &body) or (err) {
        println(err.msg())
        << true
    }
    << false
}

fn main() int {
    show_bool(unsupported_scheme())
    show_bool(missing_host())
    show_bool(bad_response_fd())
    << 0
}
