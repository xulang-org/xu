@main

#encoding/csv

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    mut w := csv.new_writer()
    w.set_use_crlf(true)
    row := ["a", "b"]
    w.write(&row)
    t := w.text()
    show_bool(t.len >= 2)
    show_bool((t[t.len - 2] & 255) == 13)
    show_bool((t[t.len - 1] & 255) == 10)
    show_bool(csv.host_crlf() == (xu_target_os() == 2))
    mut w2 := csv.new_writer()
    w2.write(&row)
    u := w2.text()
    show_bool((u[u.len - 1] & 255) == 10)
    if u.len >= 2 {
        show_bool((u[u.len - 2] & 255) != 13)
    } else {
        show_bool(false)
    }
    << 0
}
