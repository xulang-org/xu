@main

#slices

fn int_desc(a int, b int) bool {
    << a > b
}

fn str_short(a string, b string) bool {
    << a.len < b.len
}

fn main() int {
    mut xs := [3, 1, 2]
    slices.sort_ints_func(mut &xs, int_desc)
    println(xs[0])
    println(xs[1])
    println(xs[2])
    mut ys := [1]
    slices.sort_ints_func(mut &ys, int_desc)
    println(ys[0])
    mut names := []string{}
    names.push("bbb")
    names.push("a")
    names.push("cc")
    slices.sort_strs_func(mut &names, str_short)
    println(names[0])
    println(names[1])
    println(names[2])
    << 0
}
