@main

#bufio
#io

fn read_line_fails(br bufio.Reader) bool {
    mut r := br
    r.read_line() or (err) {
        << true
    }
    << false
}

fn read_string_fails(br bufio.Reader) bool {
    mut r := br
    r.read_string(44) or (err) {
        << true
    }
    << false
}

fn read_byte_fails(br bufio.Reader) bool {
    mut r := br
    r.read_byte() or (err) {
        << true
    }
    << false
}

fn peek_fails(br bufio.Reader, n int) bool {
    mut r := br
    r.peek(n) or (err) {
        << true
    }
    << false
}

fn main() int {
    // Writer: buffer small writes, flush, round-trip through a Reader.
    mut sink := io.buffer()
    mut bw := bufio.new_writer(sink)
    println(bw.write_string("hello ") or (err) { << 1 })
    println(bw.write_string("world") or (err) { << 1 })
    println(bw.write_string("\n") or (err) { << 1 })
    println(bw.flush() or (err) { << 1 })
    data := bw.bytes()
    println(data.len)
    mut br := bufio.new_reader(io.buffer_from(data))
    println(br.read_line() or (err) { << 1 })
    println(read_line_fails(br))

    // read_string keeps the delimiter; eof returns the remainder, then throws.
    mut br2 := bufio.new_reader(io.buffer_from("a,b,c"))
    println(br2.read_string(44) or (err) { << 1 })
    println(br2.read_string(44) or (err) { << 1 })
    println(br2.read_string(44) or (err) { << 1 })
    println(read_string_fails(br2))

    // read_byte.
    mut br3 := bufio.new_reader(io.buffer_from("XY"))
    println(br3.read_byte() or (err) { << 1 })
    println(br3.read_byte() or (err) { << 1 })
    println(read_byte_fails(br3))

    // peek does not consume; boundary error shapes.
    mut br4 := bufio.new_reader(io.buffer_from("peek me"))
    println(br4.peek(4) or (err) { << 1 })
    println(br4.read_byte() or (err) { << 1 })
    println(br4.peek(6) or (err) { << 1 })
    println(peek_fails(bufio.new_reader(io.buffer_from("peek me")), 4097))
    println(peek_fails(bufio.new_reader(io.buffer_from("peek me")), 0))

    // read_line strips LF and CRLF.
    mut br5 := bufio.new_reader(io.buffer_from("one\r\ntwo\n"))
    println(br5.read_line() or (err) { << 1 })
    println(br5.read_line() or (err) { << 1 })
    println(read_line_fails(br5))

    // Cross-4096 boundary: a single 5000-byte line then a short line.
    mut big := ""
    for i in 0:5000 {
        big = big + "a"
    }
    big = big + "\n" + "tail"
    mut br6 := bufio.new_reader(io.buffer_from(big))
    l := br6.read_line() or (err) { << 1 }
    println(l.len)
    println(br6.read_line() or (err) { << 1 })
    println(read_line_fails(br6))

    // Writer auto-flush once the buffer reaches 4096 bytes.
    mut chunk := ""
    for i in 0:3000 {
        chunk = chunk + "b"
    }
    chunk_copy := chunk + ""
    mut sink2 := io.buffer()
    mut bw2 := bufio.new_writer(sink2)
    println(bw2.write_string(chunk) or (err) { << 1 })
    println(bw2.write_string(chunk_copy) or (err) { << 1 })
    println(bw2.flush() or (err) { << 1 })
    println(bw2.bytes().len)

    << 0
}
