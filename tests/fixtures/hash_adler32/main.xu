@main

#hash/adler32

fn main() int {
    empty := ""
    println(adler32.checksum(&empty))
    s1 := "Xu"
    println(adler32.checksum(&s1))
    hw := "hello world"
    println(adler32.checksum(&hw))
    s64 := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    println(adler32.checksum(&s64))
    println(adler32.update(1, &s1))
    << 0
}
