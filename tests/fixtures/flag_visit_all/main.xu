@main

#flag

fn main() int {
    mut fs := flag.new_set("t")
    fs.define_bool("v", false, "verbose")
    fs.define_int("n", 0, "count")
    all := fs.visit_all()
    println(all.len)
    println(all[0])
    println(all[1])
    mut args := []string{}
    args.push("--n")
    args.push("3")
    args.push("pos")
    args.push("more")
    fs.parse(args) or (err) { << 1 }
    println(fs.narg())
    println(fs.arg(0))
    println(fs.arg(1))
    println(fs.arg(2).len)
    << 0
}
