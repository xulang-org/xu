@main
struct Box {
    data [3]int
}
fn make() [3]int {
    << [3]int{65, 66, 67}
}
fn convert(b [3]int) string {
    << string_from_bytes(b)
}
fn dynamic() []int {
    << "returned".bytes()
}
fn main() int {
    one := [1]int{90}
    println(string_from_bytes(one))
    mut b := [3]int{65, 66, 67}
    println(string_from_bytes(b))
    println(convert(b))
    println(string_from_bytes(make()))
    bx := Box{data: b}
    println(string_from_bytes(bx.data))
    mut boxes := []Box{}
    boxes.push(bx)
    println(string_from_bytes(boxes[0].data))
    wide := [20]int{65, 66, 67, 68, 69, 70, 71, 72, 73, 74, 75, 76, 77, 78, 79, 80, 81, 82, 83, 84}
    println(string_from_bytes(wide))
    truncated := string_from_bytes([3]int{-1, 256, 321}).bytes()
    println(truncated[0])
    println(truncated[1])
    println(truncated[2])
    b[1] = 90
    println(string_from_bytes(b))
    println(string_from_bytes("dynamic".bytes()))
    d := "borrowed".bytes()
    println(string_from_bytes(d))
    println(d.len)
    println(string_from_bytes(d[1:4]))
    println(d.len)
    println(string_from_bytes(dynamic()))
    println(string_from_bytes([]int{}).len)
    << 0
}
