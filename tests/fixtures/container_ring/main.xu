@main

#container/ring

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn dump(a []string) {
    println(a.len)
    for i in 0:a.len {
        println(a[i])
    }
}

fn main() int {
    mut r := ring.new(5)
    println(ring.len(&r))
    mut e := ring.cur(&r)
    mut i := 0
    while i < 5 {
        r.set_value(e, string_from_byte(65 + i))
        e = ring.next(&r, e)
        i = i + 1
    }
    dump(ring.values(&r))
    e = ring.cur(&r)
    e2 := ring.move(&r, e, 2)
    println(ring.value(&r, e2))
    e3 := ring.move(&r, e, 0 - 1)
    println(ring.value(&r, e3))
    mut s := ring.new(2)
    s.set_value(ring.cur(&s), "X")
    s.set_value(ring.next(&s, ring.cur(&s)), "Y")
    old := r.link(ring.cur(&r), mut &s)
    _ := old
    dump(ring.values(&r))
    show_bool(ring.len(&s) == 0)
    mut u := r.unlink(ring.cur(&r), 2)
    dump(ring.values(&r))
    dump(ring.values(&u))
    empty := ring.new(0)
    show_bool(ring.cur(&empty) == 0 - 1)
    << 0
}
