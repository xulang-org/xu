@main
// Canary: by-value call with a []string element must clone.
// After take(ss[i]), the container elements remain readable.
fn take(s string) {
    println(s)
}

fn main() int {
    // Heap strings so free would matter under Drop free.
    ss := ["a" + "b", "x" + "y"]
    take(ss[0])
    take(ss[1])
    println(ss[0])
    println(ss[1])
    println(ss.len)
    << 0
}
