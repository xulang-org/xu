@main

struct Twin {
    left []int
    stamp int
    right []int
}

fn stir(v int, salt int) int {
    mut x := v
    x = (x * 31 + salt) ^ (x >> 5)
    x = (x * 31 + salt) ^ (x >> 5)
    x = (x * 31 + salt) ^ (x >> 5)
    x = (x * 31 + salt) ^ (x >> 5)
    x = (x * 31 + salt) ^ (x >> 5)
    x = (x * 31 + salt) ^ (x >> 5)
    x = (x * 31 + salt) ^ (x >> 5)
    x = (x * 31 + salt) ^ (x >> 5)
    x = (x * 31 + salt) ^ (x >> 5)
    x = (x * 31 + salt) ^ (x >> 5)
    << x
}

fn combine(a int, b int, c int, d int, e int, f int) int {
    << ((a + b) ^ (c + d)) + (e ^ f)
}

fn update(t &mut Twin, p int, q int, r int, s int) int {
    t.left[p] = t.left[p] + t.left[q]
    t.right[r] = stir(t.right[r] ^ t.left[p], 7)
    t.left[q] = t.left[q] - t.right[r]
    t.right[s] = stir(t.left[q] + t.right[s], 11)
    t.left[p] = t.right[s] ^ t.left[p]
    << t.left[p] + t.left[q] + t.right[r] + t.right[s]
}

fn pressure(t &mut Twin, p int, q int) int {
    t.left[p] = combine(stir(t.left[p], 1), stir(t.right[q], 2),
        stir(t.left[(p + 1) & 15], 3), stir(t.right[(q + 1) & 15], 4),
        stir(t.left[(p + 2) & 15], 5), stir(t.right[(q + 2) & 15], 6))
    t.right[q] = t.left[p] + t.right[q]
    << t.left[p] ^ t.right[q]
}

fn main() int {
    for k in 0:32 {
        mut a := []int{}
        mut b := []int{}
        for j in 0:16 {
            a.push((j * 17 - k * 31) ^ (k << 51))
            b.push((k * 23 - j * 11) ^ (j << 57))
        }
        mut twin := Twin{left: a, stamp: 97, right: b}
        p := k & 15
        q := (k * 7) & 15
        r := (k * 3) & 15
        s := (k * 11) & 15
        println(update(mut &twin, p, q, r, s))
        println(pressure(mut &twin, p, r))
        println(update(mut &twin, q, p, s, r))
        println(twin.stamp)
        for j in 0:16 {
            println(twin.left[j])
            println(twin.right[j])
        }
    }
    << 0
}
