@main

#os/exec

fn trim_nl(s string) string {
    mut n := s.len
    while n > 0 {
        c := s[n - 1] & 255
        if c != 10 && c != 13 && c != 32 && c != 9 {
            <-
        }
        n = n - 1
    }
    << s[0:n]
}

fn pipe_after_start() bool {
    mut c := exec.command("true")
    c.start() or (err) { << false }
    c.stdin_pipe() or (err) { << true }
    << false
}

fn main() int {
    mut c := exec.command("cat")
    mut w := c.stdin_pipe() or (err) {
        println(err.msg())
        << 1
    }
    mut r := c.stdout_pipe() or (err) {
        println(err.msg())
        << 1
    }
    w.write("hello-stdin") or (err) {
        println(err.msg())
        << 1
    }
    w.close() or (err) {
        println(err.msg())
        << 1
    }
    c.start() or (err) {
        println(err.msg())
        << 1
    }
    s := r.read(64) or (err) {
        println(err.msg())
        << 1
    }
    c.wait() or (err) {
        println(err.msg())
        << 1
    }
    println(trim_nl(s))
    if !pipe_after_start() {
        << 1
    }
    println("pipe")
    << 0
}
