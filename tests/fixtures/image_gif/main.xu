@main

#encoding/hex
#image
#image/color
#image/gif

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn decode_gif_fails(raw &string) bool {
    gif.decode(raw) or (err) { << true }
    << false
}

fn main() int {
    gohex := "47494638396102000200800000000000ff00002c0000000002000200000203440205003b"
    raw := hex.decode_string(gohex + "") or (err) { << 1 }
    g := gif.decode(&raw) or (err) { << 1 }
    println(g.width)
    println(g.height)
    a := gif.at(&g, 0, 0)
    println(a.r)
    println(a.g)
    println(a.a)
    b := gif.at(&g, 1, 0)
    println(b.r)
    println(b.g)
    c := gif.at(&g, 0, 1)
    println(c.r)
    d := gif.at(&g, 1, 1)
    println(d.r)
    mut pal := []color.RGBA{}
    pal.push(color.RGBA{r: 0, g: 0, b: 0, a: 255})
    pal.push(color.RGBA{r: 255, g: 0, b: 0, a: 255})
    mut img := image.new_rgba(image.rect(0, 0, 2, 2))
    img.set_rgba(0, 0, pal[0])
    img.set_rgba(1, 0, pal[1])
    img.set_rgba(0, 1, pal[1])
    img.set_rgba(1, 1, pal[0])
    enc := gif.encode_rgba(&img, &pal) or (err) { << 1 }
    println(hex.encode_to_string(enc + ""))
    show_bool(hex.encode_to_string(enc + "") == (gohex + ""))
    back := gif.decode(&enc) or (err) { << 1 }
    e := gif.at(&back, 1, 0)
    show_bool(e.r == 255)
    bad := "notgif"
    show_bool(decode_gif_fails(&bad))
    << 0
}
