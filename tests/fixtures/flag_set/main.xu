@main

#flag

fn set_fails(name string, val string) bool {
    mut fs := flag.new_set("t")
    fs.define_int("n", 0, "")
    fs.set(name, val) or (err) { << true }
    << false
}

fn main() int {
    mut fs := flag.new_set("t")
    fs.define_bool("v", false, "")
    fs.define_string("name", "def", "")
    fs.define_int("n", 1, "")
    println(fs.nflag())
    fs.set("v", "true") or (err) { << 1 }
    fs.set("name", "Xu") or (err) { << 1 }
    fs.set("n", "8") or (err) { << 1 }
    println(fs.nflag())
    println(fs.get_bool("v"))
    println(fs.get_string("name"))
    println(fs.get_int("n"))
    println(fs.is_set("n"))
    show := set_fails("missing", "1")
    if show {
        println("true")
    } else {
        println("false")
    }
    show2 := set_fails("n", "zz")
    if show2 {
        println("true")
    } else {
        println("false")
    }
    << 0
}
