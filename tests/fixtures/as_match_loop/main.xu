@main

fn main() int {
    mut n := 0
    for i in 0:10000 {
        let e: temp = 1
        match i % 2 {
            0 {
                v := e as int
                n += v
            }
            else {
                n += 1
            }
        }
    }
    println(n)
    println("ok")
    << 0
}
