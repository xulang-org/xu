@main
// B7: log/slog JSON handler (new_json_logger).

#log/slog

fn main() int {
    mut l := slog.new_json_logger()
    l.add_time = 0
    l.use_stdout = true
    l.min_level = slog.level_debug
    l.info("hello")
    l = l.with("k", "v")
    l.warn("w")
    l.debug("d")
    l.error("e")

    mut quiet := slog.new_json_logger()
    quiet.min_level = slog.level_error
    quiet.add_time = 0
    quiet.use_stdout = true
    quiet.info("hidden")
    quiet.error("shown")

    mut multi := slog.new_json_logger()
    multi.add_time = 0
    multi.use_stdout = true
    multi = multi.with("a", "1", "b", "2")
    multi.info("m")

    mut bad := slog.new_json_logger()
    bad.add_time = 0
    bad.use_stdout = true
    bad = bad.with("solo")
    bad.info("x")

    mut q := slog.new_json_logger()
    q.add_time = 0
    q.use_stdout = true
    q.info("a\"b")

    mut t := slog.new_logger()
    t.add_time = 0
    t.use_stdout = true
    t.info("text")
    << 0
}
