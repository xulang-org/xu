@main

#math

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    show_bool(math.log1p(0.0) == 0.0)
    show_bool(math.expm1(0.0) == 0.0)
    l := math.log1p(1.0)
    show_bool(l > 0.69 && l < 0.70)
    e := math.expm1(1.0)
    show_bool(e > 1.7 && e < 1.8)
    show_bool(math.is_inf(math.log1p(0.0 - 1.0)))
    show_bool(math.signbit(math.log1p(0.0 - 1.0)))
    show_bool(math.is_nan(math.log1p(0.0 - 2.0)))
    << 0
}
