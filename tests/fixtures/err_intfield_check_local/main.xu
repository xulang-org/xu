@main
struct Pair { left []int
    tag int
    right []int
}
fn touch(t &mut Pair, p int) int {
    mut i := p
    t.right[i] = t.right[i] + 1
    i += 1
    t.right[i] = t.right[0] + 2
    << t.right[0]
}
fn main() int {
    mut a := []int{}
    mut b := []int{}
    a.push(3)
    a.push(5)
    b.push(7)
    mut t := Pair{left: a, tag: 97, right: b}
    println(touch(mut &t, 0))
    << 0
}
