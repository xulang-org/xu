@main

// `x` and `i` are non-escaping scalar stack locals. O1 promotes them through
// transient SSA versions, lowers the joins back to copies, then the whole-CFG
// allocator gives those values fixed homes across the diamond and loop edge.
fn choose_and_loop(flag int) int {
    mut x := 1
    if flag > 0 {
        x = 20
    } else {
        x = 30
    }
    mut i := 0
    while i < 3 {
        x += i
        i += 1
    }
    << x
}

fn main() int {
    println(choose_and_loop(1))
    println(choose_and_loop(0))
    << 0
}
