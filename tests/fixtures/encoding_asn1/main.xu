@main

#encoding/asn1
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn unmarshal_rejected(raw string) bool {
    asn1.unmarshal(&raw) or (err) {
        << true
    }
    << false
}

fn parse_at_rejected(raw string, off int) bool {
    asn1.parse_at(&raw, off) or (err) {
        << true
    }
    << false
}

fn main() int {
    tb := asn1.marshal_bool(true)
    println(hex.encode_to_string(tb + ""))
    println(hex.encode_to_string(asn1.marshal_bool(false) + ""))
    i42 := asn1.marshal_int(42)
    println(hex.encode_to_string(i42 + ""))
    n1 := asn1.marshal_int(0 - 1)
    println(hex.encode_to_string(n1 + ""))
    i128 := asn1.marshal_int(128)
    println(hex.encode_to_string(i128 + ""))
    oct := hex.decode_string("010203") or (err) { << 1 }
    os := asn1.marshal_octet(&oct)
    println(hex.encode_to_string(os + ""))
    mut arcs := []int{}
    arcs.push(1)
    arcs.push(2)
    arcs.push(840)
    arcs.push(113549)
    arcs.push(1)
    arcs.push(1)
    arcs.push(1)
    oid := asn1.marshal_oid(&arcs) or (err) { << 1 }
    println(hex.encode_to_string(oid + ""))
    a := asn1.marshal_int(7)
    b := asn1.marshal_bool(true)
    mut elems := []string{}
    elems.push(a + "")
    elems.push(b + "")
    seq := asn1.marshal_seq(&elems)
    println(hex.encode_to_string(seq + ""))
    v := asn1.unmarshal(&tb) or (err) { << 1 }
    show_bool(v.as_bool() or (err) { << 1 })
    vi := asn1.unmarshal(&i42) or (err) { << 1 }
    println(vi.as_int() or (err) { << 1 })
    vo := asn1.unmarshal(&oid) or (err) { << 1 }
    got := vo.as_oid() or (err) { << 1 }
    println(got.len)
    println(got[0])
    println(got[2])
    nn := asn1.marshal_null()
    println(hex.encode_to_string(nn + ""))
    seqv := asn1.unmarshal(&seq) or (err) { << 1 }
    show_bool(seqv.tag == asn1.tag_sequence)
    // DER error propagation: unmarshal/parse_at must reject malformed input
    // instead of returning an empty Value or panicking in a caller.
    show_bool(unmarshal_rejected(""))
    show_bool(unmarshal_rejected(string_from_bytes([2])))
    show_bool(unmarshal_rejected(string_from_bytes([2, 128])))
    show_bool(unmarshal_rejected(string_from_bytes([2, 129, 127])))
    show_bool(unmarshal_rejected(string_from_bytes([2, 2, 1])))
    show_bool(parse_at_rejected(i42 + "", i42.len))
    << 0
}
