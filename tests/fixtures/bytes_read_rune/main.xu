@main

#bytes

fn main() int {
    mut b := bytes.buffer_from("Aβ")
    r := b.read_rune() or (err) { << 1 }
    println(r.ch)
    println(r.size)
    r2 := b.read_rune() or (err) { << 1 }
    println(r2.size)
    b.unread_rune() or (err) { << 1 }
    r3 := b.read_rune() or (err) { << 1 }
    println(r3.size)
    << 0
}
