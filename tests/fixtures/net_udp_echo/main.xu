@main

#net

fn main() int {
    mut srv := net.listen_packet("udp", "127.0.0.1:19111") or (err) { << 1 }
    mut cli := net.listen_packet("udp", "127.0.0.1:19112") or (err) { << 1 }
    dest := net.UDPAddr{ip: net.ipv4(127, 0, 0, 1), port: 19111, zone: ""}
    msg := "ping"
    n := cli.write_to(&msg, &dest) or (err) { << 1 }
    println(n)
    pkt := srv.read_from(64) or (err) { << 1 }
    println(pkt.data)
    data := pkt.data + ""
    srv.write_to(&data, &pkt.addr) or (err) { << 1 }
    echo := cli.read_from(64) or (err) { << 1 }
    println(echo.data)
    << 0
}
