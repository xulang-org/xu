@main

#crypto/aes
#crypto/cipher
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn seal_gcm_fails(c &aes.Cipher, nonce &string, pt &string, aad &string) bool {
    cipher.seal_gcm(c, nonce, pt, aad) or (err) { << true }
    << false
}

fn open_gcm_fails(c &aes.Cipher, nonce &string, sealed &string, aad &string) bool {
    cipher.open_gcm(c, nonce, sealed, aad) or (err) { << true }
    << false
}

fn main() int {
    key := hex.decode_string("feffe9928665731c6d6a8f9467308308") or (err) { << 1 }
    nonce := hex.decode_string("cafebabefacedbaddecaf888") or (err) { << 1 }
    aad := hex.decode_string("feedfacedeadbeeffeedfacedeadbeefabaddad2") or (err) { << 1 }
    pt := hex.decode_string("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39") or (err) { << 1 }
    want := "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e0915bc94fbc3221a5db94fae95ae7121a47"
    c := aes.new_cipher(&key) or (err) { << 1 }
    sealed := cipher.seal_gcm(&c, &nonce, &pt, &aad) or (err) { << 1 }
    println(hex.encode_to_string(sealed + ""))
    show_bool(hex.encode_to_string(sealed + "") == want)
    back := cipher.open_gcm(&c, &nonce, &sealed, &aad) or (err) { << 1 }
    show_bool(hex.encode_to_string(back + "") == hex.encode_to_string(pt + ""))
    empty := ""
    s0 := cipher.seal_gcm(&c, &nonce, &empty, &empty) or (err) { << 1 }
    println(hex.encode_to_string(s0 + ""))
    show_bool(hex.encode_to_string(s0 + "") == "3247184b3c4f69a44dbcd22887bbb418")
    badiv := "short"
    show_bool(seal_gcm_fails(&c, &badiv, &pt, &aad))
    mut bad := []int{}
    mut i := 0
    while i < sealed.len {
        bad.push(sealed[i] & 255)
        i = i + 1
    }
    bad[bad.len - 1] = (bad[bad.len - 1] ^ 1) & 255
    bad_s := string_from_bytes(bad)
    show_bool(open_gcm_fails(&c, &nonce, &bad_s, &aad))
    << 0
}
