@main

#slices
#sort

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    a := [1, 3, 5, 7]
    println(sort.search_ints(&a, 5))
    println(sort.search_ints(&a, 4))
    show_bool(sort.is_sorted_ints(&a))
    bad := [3, 1]
    show_bool(sort.is_sorted_ints(&bad))
    names := ["a", "c", "e"]
    println(sort.search_strings(&names, "c"))
    show_bool(sort.is_sorted_strings(&names))
    fs := [1.0, 2.5, 3.0]
    println(sort.search_f64s(&fs, 2.5))
    show_bool(sort.is_sorted_f64s(&fs))

    b := [1, 2]
    c := [1, 3]
    println(slices.compare_ints(&b, &c))
    dups := [1, 1, 2, 2, 2, 3]
    cp := slices.compact_ints(&dups)
    println(cp.len)
    println(cp[0])
    println(cp[2])
    ins := slices.insert_int(&b, 1, 9)
    println(ins[1])
    del := slices.delete_ints(&a, 1, 3)
    println(del.len)
    println(del[1])
    println(slices.min_int(&a) or (err) { << 1 })
    println(slices.max_int(&a) or (err) { << 1 })
    show_bool(slices.contains_f64(&fs, 2.5))
    println(slices.index_of_f64(&fs, 3.0))
    println(slices.min_f64(&fs) or (err) { << 1 })
    << 0
}
