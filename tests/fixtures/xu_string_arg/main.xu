@main
// F4: a string passed to `go` must arrive with its full descriptor
// (ptr/len/cap) — regression for multi-slot go arguments.
fn worker(s string) {
    println(s.len)
    println(s)
}

fn main() int {
    xu worker("hello")
    // Keep main alive until the goroutine's preamble has copied the arg
    // (MC mode runs `go` on a pthread).
    mut i := 0
    while i < 20000000 {
        i = i + 1
    }
    << 0
}
