@main

#text/template
ht #html/template

fn main() int {
    t := template.new("{{block \"g\"}}hi {{.}}{{end}}")
    println(template.execute_str(&t, "Ada") or (err) { << 1 })

    t2 := template.new("{{define \"g\"}}A{{end}}{{block \"g\"}}B{{end}}")
    println(template.execute_str(&t2, "x") or (err) { << 1 })

    t3 := template.new("{{block \"g\"}}B{{end}}{{define \"g\"}}A{{end}}")
    println(template.execute_str(&t3, "x") or (err) { << 1 })

    ht2 := ht.new("{{block \"x\"}}<b>{{.}}</b>{{end}}")
    println(ht.execute_str(&ht2, "<em>"))
    << 0
}
