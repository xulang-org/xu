@main

#text/template

fn execute_str_fails(t &template.Template, root string) bool {
    template.execute_str(t, root) or (err) { << true }
    << false
}

fn main() int {
    t1 := template.new("{{. | upper}}")
    println(template.execute_str(&t1, "hi") or (err) { << 1 })
    mut d := template.new_dict()
    d.set("Name", "a<b")
    t2 := template.new("{{.Name | html}}/{{.Name | len}}/{{.Name | lower}}")
    println(template.execute(&t2, &d) or (err) { << 1 })

    t3 := template.new("{{.Name | html}}")
    println(template.execute_html(&t3, &d) or (err) { << 1 })

    t4 := template.new("{{.Name}}")
    println(template.execute_html(&t4, &d) or (err) { << 1 })

    t5 := template.new("{{. | upper | len}}")
    println(template.execute_str(&t5, "ab") or (err) { << 1 })

    bad := template.new("{{. | nope}}")
    if execute_str_fails(&bad, "x") {
        println("true")
    } else {
        println("false")
    }
    << 0
}
