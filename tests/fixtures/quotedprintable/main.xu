@main

#mime/quotedprintable

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn decode_fails(s &string) bool {
    quotedprintable.decode_string(s) or (err) { << true }
    << false
}

fn main() int {
    hi := "Hi"
    println(quotedprintable.encode_to_string(&hi))
    eq := "Hello=World"
    println(quotedprintable.encode_to_string(&eq))
    enc := quotedprintable.encode_to_string(&eq)
    println(quotedprintable.decode_string(&enc) or (err) { << 1 })
    d1 := "Hello=3DWorld"
    println(quotedprintable.decode_string(&d1) or (err) { << 1 })
    cr := string_from_byte(13)
    lf := string_from_byte(10)
    soft := "Hello=" + cr + lf + "World"
    println(quotedprintable.decode_string(&soft) or (err) { << 1 })
    src := "eq=ok and space"
    round := quotedprintable.encode_to_string(&src)
    back := quotedprintable.decode_string(&round) or (err) { << 1 }
    show_bool(back == src)
    bad := "=ZZ"
    show_bool(decode_fails(&bad))
    << 0
}
