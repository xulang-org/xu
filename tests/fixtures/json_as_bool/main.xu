@main

#encoding/json

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    src := "[true,false,1]"
    d := json.parse(&src)
    r := d.root()
    show_bool(d.as_bool(d.at(r, 0)) or (err) { << 1 })
    show_bool(d.as_bool(d.at(r, 1)) or (err) { << 1 })
    d.as_bool(d.at(r, 2)) or (err) {
        println("notbool")
        << 0
    }
    println("ok")
    << 1
}
