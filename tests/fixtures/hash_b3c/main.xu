@main

#hash/fnv
#hash/adler32

fn main() int {
    e := ""
    hello := "hello"
    xus := "Xu"
    println(fnv.fnv32(&e))
    println(fnv.fnv32(&hello))
    println(fnv.fnv32(&xus))
    println(fnv.fnv64(&e))
    println(fnv.fnv64(&hello))
    println(fnv.fnv64(&xus))

    mut d32a := fnv.new32a()
    he := "he"
    llo := "llo"
    d32a.write(&he)
    d32a.write(&llo)
    println(d32a.sum() == fnv.fnv32a(&hello))
    d32a.reset()
    println(d32a.sum() == fnv.fnv32a(&e))
    d32a.write(&hello)
    println(d32a.sum())

    mut d32 := fnv.new32()
    d32.write(&hello)
    println(d32.sum() == fnv.fnv32(&hello))
    mut d64 := fnv.new64()
    d64.write(&xus)
    println(d64.sum() == fnv.fnv64(&xus))
    mut d64a := fnv.new64a()
    d64a.write(&hello)
    println(d64a.sum() == fnv.fnv64a(&hello))

    hw := "hello world"
    mut ad := adler32.new()
    h := "hello"
    w := " world"
    ad.write(&h)
    ad.write(&w)
    println(ad.sum() == adler32.checksum(&hw))
    ad.reset()
    println(ad.sum())
    ad.write(&xus)
    println(ad.sum() == adler32.checksum(&xus))
    << 0
}
