@main
struct Ledger { cells []int
    links []int
    salt int
    enabled bool }
fn scan(book &Ledger, begin int, end int, bias int) int {
    mut acc := bias
    mut i := begin
    while i < end {
        v := book.cells[i]
        if (v & 1) == 0 { acc = (acc + v * 17) ^ (v >> 9) }
        else { acc = (acc ^ (v << 7)) - v * 3 }
        i += 1
    }
    if book.enabled { << acc ^ book.salt }
    << acc + book.salt
}
fn follow(book &Ledger, node int, limit int) int {
    mut cursor := node
    mut count := 0
    mut result := book.salt
    while cursor >= 0 && count < limit {
        result = (result * 31) ^ book.cells[cursor]
        cursor = book.links[cursor]
        count += 1
    }
    << result
}
fn contains(book &Ledger, target int) bool {
    mut i := 0
    while i < book.cells.len {
        if book.cells[i] == target { << true }
        i += 1
    }
    << false
}
fn digest(values &[]int, scalar &int, begin int, end int) int {
    mut acc := *scalar
    for i in begin:end { acc = (acc + values[i]) ^ (values[i] >> 13) }
    << acc
}
fn two(values &[]int, other &[]int, pos int) int {
    << (values[pos] + other[pos]) ^ (values[pos] - other[pos])
}
fn blocked_write(book &mut Ledger, pos int) int {
    book.cells[pos] = book.cells[pos] ^ book.salt
    << book.cells[pos]
}
fn mix(v int) int { << (v * 19) ^ (v >> 17) }
fn blocked_call(book &Ledger, pos int) int { << mix(book.cells[pos]) + book.salt }
fn fixed_read(data &[4]int, pos int) int { << data[pos] }
fn pressure(data &[]int) int {
    v0 := data[0]
    v1 := data[1]
    v2 := data[2]
    v3 := data[3]
    v4 := data[4]
    v5 := data[5]
    v6 := data[6]
    v7 := data[7]
    v8 := data[8]
    v9 := data[9]
    v10 := data[10]
    v11 := data[11]
    v12 := data[12]
    v13 := data[13]
    v14 := data[14]
    v15 := data[15]
    << (v0 ^ (v15 << 0)) + (v1 ^ (v14 << 1)) + (v2 ^ (v13 << 2)) + (v3 ^ (v12 << 3)) + (v4 ^ (v11 << 4)) + (v5 ^ (v10 << 5)) + (v6 ^ (v9 << 6)) + (v7 ^ (v8 << 7)) + (v8 ^ (v7 << 8)) + (v9 ^ (v6 << 9)) + (v10 ^ (v5 << 10)) + (v11 ^ (v4 << 11)) + (v12 ^ (v3 << 12)) + (v13 ^ (v2 << 13)) + (v14 ^ (v1 << 14)) + (v15 ^ (v0 << 15))
}
