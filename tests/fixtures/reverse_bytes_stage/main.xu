@main

#math/bits

fn swap8(x int) int {
    << ((x >> 8) & 0x00ff00ff00ff00ff) | ((x & 0x00ff00ff00ff00ff) << 8)
}

fn swap16(x int) int {
    << ((x >> 16) & 0x0000ffff0000ffff) | ((x & 0x0000ffff0000ffff) << 16)
}

fn swap32(x int) int {
    << ((x >> 32) & 0x00000000ffffffff) | ((x & 0x00000000ffffffff) << 32)
}

fn near_miss(x int) int {
    << ((x >> 8) & 0x00ff00ff00ff00fe) | ((x & 0x00ff00ff00ff00ff) << 8)
}

fn main() int {
    vals := [0, 1, -1, -9223372036854775807 - 1, 0x0123456789abcdef]
    for i in 0:vals.len {
        x := vals[i]
        println(str(swap8(x)))
        println(str(swap16(x)))
        println(str(swap32(x)))
        println(str(near_miss(x)))
        println(str(bits.reverse_bytes(x)))
    }
    << 0
}
