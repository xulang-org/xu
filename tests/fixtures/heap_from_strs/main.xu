@main

#container/heap

fn main() int {
    mut raw := []string{}
    raw.push("c")
    raw.push("a")
    raw.push("b")
    mut h := heap.from_strs(raw)
    println(h.pop() or (err) { << 1 })
    println(h.pop() or (err) { << 1 })
    println(h.pop() or (err) { << 1 })
    println(heap.len_strs(&h))
    << 0
}
