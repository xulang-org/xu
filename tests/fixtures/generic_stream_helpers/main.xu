@main
#io
#bufio
struct Wrapper#R:StreamReader { src R }
fn (r &mut Wrapper#R) chunk(n int) string {
    s := mut &r.src
    << s.read_n(n) or >>
}
fn (r &mut Wrapper#R) read_n(n int) string { << r.chunk(n) or >> }
fn (r &mut Wrapper#R) reset(src R) { r.src = src }
fn make#R:StreamReader(src R) Wrapper#R {
    << Wrapper#R{src:src}
}
fn make_again#R:StreamReader(src R) Wrapper#R { << make(src) }
fn transfer#W:StreamWriter,R:StreamReader(dst &mut W, src &mut R) int {
    << io.copy_stream_buffer(dst,src,2) or >>
}
fn layered#R:StreamReader(src R) int {
    mut first := bufio.new_stream_reader_size(src, 2)
    mut second := bufio.new_stream_reader_size(first, 3)
    println(second.read_n(3) or (err) { << 1 })
    println(second.read_n(3) or (err) { << 2 })
    << 0
}
fn main() int {
    mut r := make_again(io.cursor("abcdef"))
    println(r.read_n(2) or (err) { << 1 })
    println(r.read_n(2) or (err) { << 2 })
    r.reset(io.cursor("xyz"))
    mut out := io.buffer()
    println(transfer(mut &out,mut &r) or (err) { << 3 })
    println(out.bytes())
    mut second := make_again(io.multi_cursor("one", "two"))
    println(transfer(mut &out,mut &second) or (err) { << 4 })
    println(out.bytes())
    if layered(io.cursor("layer")) != 0 { << 5 }
    << 0
}
