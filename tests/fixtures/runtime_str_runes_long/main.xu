@main

#runtime

fn mk_ascii(n int) string {
    mut b := []int{}
    for i in 0:n {
        b.push(65)
    }
    << string_from_bytes(b)
}

fn main() int {
    // Regression: str_runes must not clone the whole buffer per rune
    // (helpers take &string). A 256 KiB heap string is instant when borrowed
    // and quadratic-timeout when every utf8_next/utf8_advance copies by value.
    s := mk_ascii(262144)
    n := s.len
    r := runtime.str_runes(&s)
    println(n)
    println(r.len)
    println(r[0])
    println(r[262143])

    // Mixed multi-byte still decodes correctly on a heap string.
    mut b := []int{}
    b.push(65)
    b.push(228)
    b.push(184)
    b.push(173)
    b.push(240)
    b.push(159)
    b.push(153)
    b.push(130)
    t := string_from_bytes(b)
    tn := t.len
    tr := runtime.str_runes(&t)
    println(tn)
    println(tr.len)
    println(tr[0])
    println(tr[1])
    println(tr[2])
    << 0
}
