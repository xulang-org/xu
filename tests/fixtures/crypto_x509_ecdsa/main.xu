@main

#crypto/x509
#encoding/pem
#time

fn signature_fails(c &x509.Certificate, sig &string) bool {
    tbs := c.raw_tbs_certificate + ""
    algo := c.signature_algorithm
    c.check_signature(algo, &tbs, sig) or (err) { << true }
    << false
}

fn main() int {
    pem_text := "-----BEGIN CERTIFICATE-----\nMIIB6DCCAY2gAwIBAgIUZsahSJ/YQx83HrY5/lDWpUESCT4wCgYIKoZIzj0EAwIw\nNTELMAkGA1UEBhMCVVMxCzAJBgNVBAoMAlh1MRkwFwYDVQQDDBB4dS1lY2RzYS5l\neGFtcGxlMB4XDTI2MDgzMDIwNTQ1OVoXDTM2MDgyNzIwNTQ1OVowNTELMAkGA1UE\nBhMCVVMxCzAJBgNVBAoMAlh1MRkwFwYDVQQDDBB4dS1lY2RzYS5leGFtcGxlMFkw\nEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEAjOR39Mb9F0+By5cP6L8ntMlhfW8lpoy\nvYBvSlT1jgAOAgmDDZPo0qUvg18nD71uExJu7TZwcIU6WGSqWBHrgaN7MHkwHQYD\nVR0OBBYEFPrDeQwFvSfzQx9zP4prhhXCo2FxMB8GA1UdIwQYMBaAFPrDeQwFvSfz\nQx9zP4prhhXCo2FxMCYGA1UdEQQfMB2CEHh1LWVjZHNhLmV4YW1wbGWCCWxvY2Fs\naG9zdDAPBgNVHRMBAf8EBTADAQH/MAoGCCqGSM49BAMCA0kAMEYCIQDgwjfxk6Ip\nm9tzNTIiIXJSMnsgyorP2VVOjmTjK03gIQIhANnJq3dyYJf14By8uF98Vl3y+2L4\n+MUlUAvxCbwbVaA8\n-----END CERTIFICATE-----\n"
    b := pem.decode(&pem_text)
    if b.typ != "CERTIFICATE" {
        << 1
    }
    mut c := x509.parse_certificate(b.bytes) or (err) {
        println(err.msg())
        << 1
    }
    println(c.subject.common_name)
    println(c.public_key_algorithm)
    println(c.signature_algorithm)
    println(c.public_key.len)
    println(c.is_ca)

    c.check_signature_from(&c) or (err) {
        println(err.msg())
        << 1
    }
    now := c.not_before.add(time.hour() * 24)
    opts := x509.VerifyOptions{dns_name: "xu-ecdsa.example", current_time: now, roots: x509.new_cert_pool(), intermediates: x509.new_cert_pool(), key_usages: []int{}, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    c.verify(opts) or (err) {
        println(err.msg())
        << 1
    }
    println("ok")

    sig := c.signature + ""
    mut bad := []int{}
    for i in 0:sig.len {
        bad.push(sig[i] & 255)
    }
    bad[bad.len - 1] = bad[bad.len - 1] ^ 1
    bad_sig := string_from_bytes(bad)
    println(signature_fails(&c, &bad_sig))
    << 0
}
