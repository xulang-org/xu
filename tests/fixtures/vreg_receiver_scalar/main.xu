@main

struct Token {
    n int
}

// The receiver remains frame-backed and is deliberately unused. Its mere
// presence must not disable fixed homes for independent scalar temporaries.
fn (t Token) pressure(a int, b int, c int, d int) int {
    x0 := a + b
    x1 := a - b
    x2 := b + c
    x3 := b - c
    x4 := c + d
    x5 := c - d
    x6 := a ^ d
    x7 := b | c
    << x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7
}

fn main() int {
    t := Token{n: 99}
    println(t.pressure(31, 7, 11, 3))
    << 0
}
