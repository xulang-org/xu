@main

#net

// IPv6 loopback vertical slice: TCP listener/accept plus connected UDP.
// The fixture deliberately uses only ::1 so it is deterministic and does
// not depend on external DNS or non-loopback interface configuration.
fn main() int {
    mut ln := net.listen_on("tcp6", "[::1]:19131") or (err) { << 1 }
    mut c := net.dial_to("tcp6", "[::1]:19131") or (err) { << 1 }
    msg := "ping"
    println(c.write(&msg) or (err) { << 1 })
    mut ac := ln.accept() or (err) { << 1 }
    println(ac.read(64) or (err) { << 1 })
    ac.close() or (err) { << 1 }
    c.close() or (err) { << 1 }
    ln.close() or (err) { << 1 }

    server_local := net.UDPAddr{ip: net.ipv6_loopback(), port: 19132, zone: ""}
    client_local := net.UDPAddr{ip: net.ipv6_loopback(), port: 19133, zone: ""}
    mut srv := net.dial_udp("udp6", server_local.clone(), client_local.clone()) or (err) { << 1 }
    mut cli := net.dial_udp("udp6", client_local, server_local) or (err) { << 1 }
    msg2 := "v6"
    println(cli.write(&msg2) or (err) { << 1 })
    println(srv.read(64) or (err) { << 1 })
    cli.close() or (err) { << 1 }
    srv.close() or (err) { << 1 }
    << 0
}
