@main

#crypto/ecdsa
#encoding/hex

fn flip_last(s &string) string {
    mut out := []int{}
    for i in 0:s.len {
        out.push(s[i] & 255)
    }
    out[out.len - 1] = out[out.len - 1] ^ 1
    << string_from_bytes(out)
}

fn main() int {
    pubkey := hex.decode_string("04023391dfd31bf45d3e072e5c3fa2fc9ed32585f5bc969a32bd806f4a54f58e000e0209830d93e8d2a52f835f270fbd6e13126eed367070853a5864aa5811eb81") or (err) { << 1 }
    hash := hex.decode_string("aabf12503c9916508936b35ea67e636b2852b77fd4016a1d4122670d0998e76e") or (err) { << 1 }
    sig := hex.decode_string("304602210085580de6f7a84dc877338962efaa07c07aa279545724de50ae7d893af545501c022100855a6a8b9e8ee2d28c6d5b4f42e666d00f3c142912752b6a27e717922f413f03") or (err) { << 1 }
    println(ecdsa.verify_asn1(&pubkey, &hash, &sig))

    bad_sig := flip_last(&sig)
    println(ecdsa.verify_asn1(&pubkey, &hash, &bad_sig))
    bad_pub := flip_last(&pubkey)
    println(ecdsa.verify_asn1(&bad_pub, &hash, &sig))
    empty := ""
    println(ecdsa.verify_asn1(&pubkey, &hash, &empty))
    << 0
}
