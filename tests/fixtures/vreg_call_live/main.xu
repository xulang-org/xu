@main

fn leaf(x int) int {
    << x + 1
}

// The multiplication result remains live across the call to leaf, so Arm64
// must place it in a saved S home (or spill it) rather than a caller-clobbered
// V home. Keeping the expression in one return avoids hiding the value in a
// local frame slot.
fn inner(a int) int {
    << a * 3 + leaf(a)
}

// The same shape one level higher makes inner both a user of its own saved
// home and the callee responsible for preserving outer's live value.
fn outer(a int) int {
    << a * 2 + inner(a)
}

fn main() int {
    println(outer(7))
    << 0
}
