@main

#crypto/sm3

fn main() int {
    println(sm3.sum("abc"))
    long := "abcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcd"
    println(sm3.sum(long))
    println(sm3.sum(""))
    mut d := sm3.new()
    p1 := "ab"
    d.write(&p1)
    p2 := "c"
    d.write(&p2)
    println(d.sum())
    d.reset()
    println(d.sum())
    println(d.size())
    println(d.blocksize())
    << 0
}
