@main

#mime/multipart

fn main() int {
    b0 := "----XuB"
    mut w := multipart.new_writer_with_boundary(&b0)
    println(w.form_data_content_type())
    n1 := "title"
    v1 := "Hello"
    w.write_field(&n1, &v1)
    n2 := "file"
    fnm := "a.txt"
    ct := "text/plain"
    body := "abc"
    w.write_file(&n2, &fnm, &ct, &body)
    w.close()
    raw := w.bytes()
    b := w.boundary()
    mut r := multipart.new_reader(&raw, &b)
    p1 := r.next_part() or (err) { << 1 }
    println(p1.form_name())
    println(p1.body())
    p2 := r.next_part() or (err) { << 1 }
    println(p2.form_name())
    println(p2.file_name())
    println(p2.header("Content-Type"))
    println(p2.body())
    r.next_part() or (err) {
        println("EOF")
        << 0
    }
    << 0
}
