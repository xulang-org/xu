@main

#net/url

fn main() int {
    u := url.parse_url("http://example.com:8080/a?b=1") or (err) { << 1 }
    println(u.hostname())
    println(u.port())
    println(u.request_uri())
    v := url.parse_url("http://h/p") or (err) { << 1 }
    println(v.hostname())
    println(v.port().len)
    println(v.request_uri())
    w := url.parse_url("http://[::1]:80/") or (err) { << 1 }
    println(w.hostname())
    println(w.port())
    << 0
}
