@main

#encoding/json

fn unquote_ok(s &string) bool {
    _ := json.unquote(s) or (err) {
        << false
    }
    << true
}

fn unquote_val(s &string) string {
    << json.unquote(s) or (err) { << "" }
}

fn compact_fails(src &string) bool {
    _ := json.compact(src) or (err) {
        << true
    }
    << false
}

fn main() int {
    src := "{\"a\":[1,true,null,\"x\"],\"b\":{\"c\":-2.5e3},\"d\":\"\"}"
    d := json.parse(&src)
    println(d.ok())
    r := d.root()
    println(d.is_dict(r))
    println(d.count(r))
    a := d.get(r, "a")
    println(d.is_list(a))
    println(d.count(a))
    println(d.number_int(d.at(a, 0)) or (err) { << 1 })
    println(d.is_bool(d.at(a, 1)))
    println(d.is_null(d.at(a, 2)))
    println(d.text(d.at(a, 3)))
    b := d.get(r, "b")
    println(d.count(b))
    c := d.get(b, "c")
    println(d.is_number(c))
    println(d.text(c))
    dd := d.get(r, "d")
    println(d.text(dd) == "")
    println(d.to_json())
    // escapes: quote/escape/unquote round-trip, surrogate pair, \u escapes
    nl := string_from_byte(10)
    tab := string_from_byte(9)
    q := "a" + nl + "b" + tab + "c" + "\"" + "d"
    println(json.quote(&q))
    q2 := "\"a\\nb\\u0041\""
    println(unquote_ok(&q2))
    println(unquote_val(&q2) == "a" + nl + "bA")
    em := "\"\\ud83d\\ude00\""
    d2 := json.parse(&em)
    t := d2.text(d2.root())
    println(t.len)
    println(t[0])
    println(t[1])
    println(t[2])
    println(t[3])
    // errors: never partial documents
    bad1 := "{\"a\":1,}"
    e1 := json.parse(&bad1)
    println(!e1.ok())
    bad2 := "[1,2"
    e2 := json.parse(&bad2)
    println(!e2.ok())
    bad3 := "{\"a\":1} x"
    e3 := json.parse(&bad3)
    println(!e3.ok())
    bad4 := "{\"a\":\"\\q\"}"
    e4 := json.parse(&bad4)
    println(!e4.ok())
    bad5 := "01"
    e5 := json.parse(&bad5)
    println(!e5.ok())
    bad6 := "{\"a\":1,\"a\":2}"
    e6 := json.parse(&bad6)
    println(!e6.ok())
    bad7 := "\"\\ud800\""
    e7 := json.parse(&bad7)
    println(!e7.ok())
    // round-trip: to_json output re-parses to the same document
    rt := d.to_json()
    d3 := json.parse(&rt)
    println(d3.ok())
    println(d3.to_json() == rt)
    << 0
}
