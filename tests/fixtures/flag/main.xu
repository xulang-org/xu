@main

#flag

fn parse_ok(args []string) bool {
    mut fs := flag.new_set("t")
    fs.define_bool("v", false, "")
    fs.define_string("name", "", "")
    fs.define_int("n", 0, "")
    fs.parse(args) or (err) {
        << false
    }
    << true
}

fn parse_err(args []string) bool {
    mut fs := flag.new_set("t")
    fs.define_int("n", 0, "")
    fs.parse(args) or (err) {
        << true
    }
    << false
}

fn main() int {
    mut fs := flag.new_set("prog")
    fs.define_bool("v", false, "verbose")
    fs.define_string("name", "", "name to greet")
    fs.define_int("n", 0, "repeat count")
    args := ["-v", "--name=Xu", "-n", "7", "rest1", "rest2"]
    fs.parse(args) or (err) {
        << 1
    }
    println(true)
    println(fs.get_bool("v"))
    println(fs.is_set("v"))
    println(fs.get_string("name"))
    println(fs.get_int("n"))
    println(fs.args().len)
    println(fs.args()[0])
    println(fs.args()[1])
    mut fs2 := flag.new_set("p2")
    fs2.define_bool("v", false, "")
    fs2.define_int("n", 5, "")
    fs2.parse(["x", "-v=false", "-n=9", "--", "-not_a_flag"]) or (err) {
        << 1
    }
    println(true)
    println(fs2.get_bool("v"))
    println(fs2.get_int("n"))
    println(fs2.args().len)
    println(fs2.args()[0])
    println(fs2.args()[1])
    println(fs2.is_set("n"))
    println(parse_err(["-missing"]))
    println(parse_err(["-n"]))
    println(parse_err(["-n", "zz"]))
    println(parse_err(["-h"]))
    println(parse_ok(["--"]))
    << 0
}
