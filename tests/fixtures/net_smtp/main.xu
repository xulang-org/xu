@main

#net
#net/smtp
#strings

struct Acc {
    fd  int
    buf string
}

fn crlf() string {
    << string_from_byte(13) + string_from_byte(10)
}

fn (a &mut Acc) line() string {
    for round in 0:1024 {
        mut i := 0
        while i < a.buf.len {
            if (a.buf[i] & 255) == 10 {
                mut end := i
                if end > 0 && (a.buf[end - 1] & 255) == 13 {
                    end = end - 1
                }
                mut line := ""
                if end > 0 {
                    line = a.buf[0:end] + ""
                }
                rest := a.buf[(i + 1):a.buf.len] + ""
                a.buf = rest
                << line
            }
            i = i + 1
        }
        chunk := net.conn_read(a.fd, 4096) or (err) { << "" }
        a.buf = a.buf + chunk
    }
    << ""
}

fn (a &mut Acc) read_data() string {
    mut out := ""
    nl := crlf()
    for round in 0:1024 {
        line := a.line()
        if line == "." {
            << out
        }
        out = out + line + nl
    }
    << out
}

fn serve_one(lfd int) {
    cfd := net.accept(lfd) or (err) { << }
    nl := crlf()
    g := "220 localhost ESMTP" + nl
    net.conn_write(cfd, &g) or (err) { << }
    mut acc := Acc{fd: cfd, buf: ""}
    mut done := 0
    for round in 0:32 {
        if done != 0 {
            <-
        }
        line := acc.line()
        if strings.has_prefix(&line, "EHLO ") {
            r := "250 localhost" + nl
            net.conn_write(cfd, &r) or (err) { << }
        } else {
            if strings.has_prefix(&line, "HELO ") {
                r := "250 localhost" + nl
                net.conn_write(cfd, &r) or (err) { << }
            } else {
                if strings.has_prefix(&line, "MAIL FROM:") {
                    println(line)
                    r := "250 OK" + nl
                    net.conn_write(cfd, &r) or (err) { << }
                } else {
                    if strings.has_prefix(&line, "RCPT TO:") {
                        println(line)
                        r := "250 OK" + nl
                        net.conn_write(cfd, &r) or (err) { << }
                    } else {
                        if line == "DATA" {
                            r := "354 go" + nl
                            net.conn_write(cfd, &r) or (err) { << }
                            body := acc.read_data()
                            println(body)
                            r2 := "250 OK" + nl
                            net.conn_write(cfd, &r2) or (err) { << }
                        } else {
                            if line == "QUIT" {
                                r := "221 Bye" + nl
                                net.conn_write(cfd, &r) or (err) { << }
                                done = 1
                            }
                        }
                    }
                }
            }
        }
    }
    net.conn_close(cfd) or (err) { << }
}

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    lfd := net.listen("127.0.0.1:19882") or (err) { << 1 }
    xu serve_one(lfd)
    mut c := smtp.new_client()
    c.dial("127.0.0.1:19882") or (err) { << 1 }
    from := "a@b.com"
    to := "c@d.com"
    nl := crlf()
    body := "Subject: hi" + nl + nl + "hello"
    c.send_mail(&from, &to, &body) or (err) { << 1 }
    c.quit() or (err) { << 1 }
    c.close() or (err) { << 1 }
    net.conn_close(lfd) or (err) { << 1 }
    show_bool(true)
    show_bool(true)
    show_bool(true)
    << 0
}
