@main
#xu/types

fn main() int {
    mut symbols := types.new_strmap()
    for i in 0:100 {
        key := "symbol_" + str(i)
        symbols.put(key, i)
    }
    mut count := 0
    for i in 0:100 {
        key := "symbol_" + str(i)
        if symbols.lookup(&key) != i {
            eprintln("symbol lookup mismatch")
            << 1
        }
        count += 1
    }
    println(count)
    << 0
}
