@main

#maps

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn has_key(ks &[]string, want string) bool {
    mut i := 0
    while i < ks.len {
        if ks[i] == want {
            << true
        }
        i = i + 1
    }
    << false
}

fn main() int {
    mut a := maps.new_str_int()
    a.set("x", 1)
    a.set("y", 2)
    ks := a.keys()
    println(ks.len)
    show_bool(has_key(&ks, "x"))
    show_bool(has_key(&ks, "y"))
    mut b := a.clone()
    show_bool(a.equal(&b))
    a.set("x", 9)
    show_bool(a.equal(&b))
    println(b.get("x") or (err) { << 1 })
    mut c := maps.new_str_int()
    maps.copy_str_int(mut &c, &b)
    println(c.get("y") or (err) { << 1 })
    mut s := maps.new_str_str()
    s.set("k", "v")
    mut t := s.clone()
    show_bool(s.equal(&t))
    println(t.keys().len)
    << 0
}
