@main

#strconv

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    a := "A"
    println(strconv.quote_to_ascii(&a))
    nl := "\n"
    println(strconv.quote_to_ascii(&nl))
    println(strconv.quote_rune_to_ascii(65))
    println(strconv.quote_rune_to_ascii(233))
    show_bool(strconv.is_graphic(32))
    show_bool(strconv.is_graphic(127))
    p := "x="
    t := strconv.append_quote_to_ascii(p, &a)
    println(t)
    << 0
}
