@main

postgres #github.com/xulang-org/packages/postgres

fn main() {
    a := postgres.parse_dsn("postgres://alice:s%40cret@db.example:5544/app?sslmode=disable") or(err) {
        println(err.msg())
        <<
    }
    println(a.host)
    println(a.port)
    println(a.user)
    println(a.password)
    println(a.database)
    b := postgres.parse_dsn("host=localhost port=5433 user=bob password='hello world' dbname=demo sslmode=disable") or(err) {
        println(err.msg())
        <<
    }
    println(b.host)
    println(b.port)
    println(b.user)
    println(b.password)
    println(b.database)
    _ := postgres.parse_dsn("postgres://alice@localhost/db?sslmode=require") or(err) {
        println(err.msg())
        <<
    }
}
