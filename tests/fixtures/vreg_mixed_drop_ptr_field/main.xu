@main

// DropPtrField in the same function as a scalar hot loop: the drop is an
// opaque barrier; the scalar accumulator must still get a non-empty plan
// (and the correct sum).

struct Box {
    n int
    s string
}

fn work(n int) int {
    mut b := Box{n: n, s: "drop-me"}
    mut acc := 0
    mut i := 0
    while i < b.n {
        acc = acc + i
        i += 1
    }
    // End of scope drops owning fields (DropField / DropPtrField path).
    << acc
}

fn main() int {
    println(work(10))
    println(work(5))
    << 0
}
