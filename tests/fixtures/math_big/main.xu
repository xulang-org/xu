@main

#math/big
#encoding/hex

fn main() int {
    mut a := big.new_int(123)
    mut b := big.new_int(456)
    mut z := big.new_int(0)
    z.add(&a, &b)
    println(z.text())

    mut c := big.new_int(100)
    mut d := big.new_int(7)
    z.sub(&c, &d)
    println(z.text())

    mut e := big.new_int(12)
    mut f := big.new_int(13)
    z.mul(&e, &f)
    println(z.text())

    z.quo(&c, &d) or (err) {
        << 1
    }
    println(z.text())
    z.rem(&c, &d) or (err) {
        << 1
    }
    println(z.text())

    mut g := big.new_int(2)
    z.lsh(&g, 10)
    println(z.text())

    mut h := big.new_int(0)
    h.set_string("65535", 10) or (err) {
        << 1
    }
    println(h.text())
    hx := h.bytes()
    println(hex.encode_to_string(hx))

    mut k := big.new_int(0)
    raw := hex.decode_string("0100") or (err) {
        << 1
    }
    k.set_bytes(raw)
    println(k.text())

    println(a.cmp(&b))
    println(a.sign())
    mut neg := big.new_int(0 - 5)
    println(neg.text())
    println(neg.sign())

    mut m3 := big.new_int(3)
    mut m7 := big.new_int(0 - 7)
    z.mod(&m7, &m3) or (err) {
        << 1
    }
    println(z.text())
    z.rem(&m7, &m3) or (err) {
        << 1
    }
    println(z.text())

    mut two := big.new_int(2)
    mut ten := big.new_int(10)
    mut none := big.new_int(0)
    z.exp(&two, &ten, &none) or (err) {
        << 1
    }
    println(z.text())

    mut p := big.new_int(0)
    p.set_string("100000000000000000000", 10) or (err) {
        << 1
    }
    println(p.text())

    mut aa := big.new_int(48)
    mut bb := big.new_int(18)
    mut g2 := big.new_int(0)
    g2.gcd(&aa, &bb)
    println(g2.text())
    mut inv := big.new_int(0)
    mut three := big.new_int(3)
    mut eleven := big.new_int(11)
    inv.mod_inverse(&three, &eleven) or (err) {
        << 1
    }
    println(inv.text())
    mut p17 := big.new_int(17)
    println(p17.probably_prime(8))
    mut n15 := big.new_int(15)
    println(n15.probably_prime(8))

    mut wu := big.new_int(0)
    wu.set_string("123456789abcdef0123456789abcdef0123456789abcdef", 16) or (err) {
        << 1
    }
    mut wv := big.new_int(0)
    wv.set_string("fedcba9876543210fedcba98", 16) or (err) {
        << 1
    }
    z.quo(&wu, &wv) or (err) {
        << 1
    }
    println(z.text())
    z.rem(&wu, &wv) or (err) {
        << 1
    }
    println(z.text())

    wu.set_string("ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff", 16) or (err) {
        << 1
    }
    wv.set_string("100000000000000000000000000000001", 16) or (err) {
        << 1
    }
    z.quo(&wu, &wv) or (err) {
        << 1
    }
    println(z.text())
    z.rem(&wu, &wv) or (err) {
        << 1
    }
    println(z.text())

    wu.set_string("100000000000000000000000000000000000000000000000000", 16) or (err) {
        << 1
    }
    wv.set_string("1000000000000000000000000007b", 16) or (err) {
        << 1
    }
    z.quo(&wu, &wv) or (err) {
        << 1
    }
    println(z.text())
    z.rem(&wu, &wv) or (err) {
        << 1
    }
    println(z.text())

    // Multi-limb division boundaries for the normalized Knuth path.
    // u < v and u == v exercise the two early exits without falling back to
    // the single-limb helper.
    wu.set_string("2147483648", 10) or (err) {
        << 1
    }
    wv.set_string("4611686018427387904", 10) or (err) {
        << 1
    }
    z.quo(&wu, &wv) or (err) {
        << 1
    }
    println(z.text())
    z.rem(&wu, &wv) or (err) {
        << 1
    }
    println(z.text())

    wu.set_string("4611686018427388027", 10) or (err) {
        << 1
    }
    wv.set_string("4611686018427388027", 10) or (err) {
        << 1
    }
    z.quo(&wu, &wv) or (err) {
        << 1
    }
    println(z.text())
    z.rem(&wu, &wv) or (err) {
        << 1
    }
    println(z.text())

    // The divisor's top base-2^31 limb is 1, forcing the maximum
    // normalization shift (30 bits).
    wu.set_string("9903520314283042199192993799", 10) or (err) {
        << 1
    }
    wv.set_string("2147483648", 10) or (err) {
        << 1
    }
    z.quo(&wu, &wv) or (err) {
        << 1
    }
    println(z.text())
    z.rem(&wu, &wv) or (err) {
        << 1
    }
    println(z.text())

    // Deterministic Algorithm-D qhat correction case.
    wu.set_string("1233637800320728265319492187630235341", 10) or (err) {
        << 1
    }
    wv.set_string("3533776986615286802", 10) or (err) {
        << 1
    }
    z.quo(&wu, &wv) or (err) {
        << 1
    }
    println(z.text())
    z.rem(&wu, &wv) or (err) {
        << 1
    }
    println(z.text())

    // qhat >= base clamp boundary (the initial estimate is BASE and must be
    // reduced to BASE-1 before the correction test).
    wu.set_string("4951760161753207113728917504", 10) or (err) {
        << 1
    }
    wv.set_string("2305843011361177599", 10) or (err) {
        << 1
    }
    z.quo(&wu, &wv) or (err) {
        << 1
    }
    println(z.text())
    z.rem(&wu, &wv) or (err) {
        << 1
    }
    println(z.text())
    << 0
}
