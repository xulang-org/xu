@main

#unicode/utf16
#unicode/utf8

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    show_bool(utf16.is_surrogate(0xD800))
    show_bool(utf16.is_surrogate(0xDFFF))
    show_bool(utf16.is_surrogate(65))
    println(utf16.decode_rune(0xD83D, 0xDE00))
    println(utf16.decode_rune(65, 66))
    p := utf16.encode_rune(0x1F600)
    println(p.r1)
    println(p.r2)
    bmp := utf16.encode_rune(65)
    println(bmp.r1)
    s := "Xu中"
    u := utf16.encode(&s) or (err) { << 1 }
    println(u.len)
    println(u[0])
    println(u[1])
    println(u[2])
    back := utf16.decode(&u) or (err) { << 1 }
    println(back)
    smile := utf8.encode(0x1F600) or (err) { << 1 }
    u2 := utf16.encode(&smile) or (err) { << 1 }
    println(u2.len)
    println(u2[0])
    println(u2[1])
    back2 := utf16.decode(&u2) or (err) { << 1 }
    println(back2.len)
    mut lone := []int{}
    lone.push(0xD800)
    d := utf16.decode(&lone) or (err) { << 1 }
    println(d.len)
    << 0
}
