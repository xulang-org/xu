@main

#net

fn main() int {
    mut ln := net.listen_on("tcp", "127.0.0.1:19888") or (err) { << 1 }
    mut c := net.dial_to("tcp", "127.0.0.1:19888") or (err) { << 1 }
    msg := "ping"
    println(c.write(&msg) or (err) { << 1 })
    mut ac := ln.accept() or (err) { << 1 }
    back := ac.read(64) or (err) { << 1 }
    println(back)
    println(ac.close() or (err) { << 1 })
    println(c.close() or (err) { << 1 })
    println(ln.close() or (err) { << 1 })
    << 0
}
