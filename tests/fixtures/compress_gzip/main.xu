@main

#compress/gzip

fn from_hex(h string) string {
    mut out := ""
    mut i := 0
    while i + 1 < h.len {
        mut v := 0
        for k in 0:2 {
            c := h[i + k]
            mut d := 0
            if c >= 48 && c <= 57 {
                d = c - 48
            } else if c >= 97 && c <= 102 {
                d = c - 87
            }
            v = v * 16 + d
        }
        out = out + string_from_byte(v)
        i = i + 2
    }
    << out
}

fn gzip_read_fails(r gzip.Reader) bool {
    mut rr := r
    rr.read_all() or (err) { << true }
    << false
}

fn main() int {
    mut w := gzip.new_writer()
    s := "hello world"
    w.write(&s) or (err) { << 1 }
    w.close()
    g := w.bytes()
    mut r := gzip.new_reader(g + "")
    println(r.read_all() or (err) { << 1 })

    empty := ""
    mut w0 := gzip.new_writer()
    w0.write(&empty) or (err) { << 1 }
    w0.close()
    mut r0 := gzip.new_reader(w0.bytes())
    back0 := r0.read_all() or (err) { << 1 }
    println(back0.len)

    ghex := "1f8b08000000000000ff8b2805001040d41302000000"
    mut rp := gzip.new_reader(from_hex(ghex))
    println(rp.read_all() or (err) { << 1 })

    short := g[0:g.len - 1]
    if gzip_read_fails(gzip.new_reader(short)) {
        println("trunc_err")
    }

    mut corrupt := ""
    for i in 0:(g.len - 8) {
        corrupt = corrupt + string_from_byte(g[i])
    }
    corrupt = corrupt + string_from_byte((g[g.len - 8] ^ 1) & 255)
    for i in (g.len - 7):g.len {
        corrupt = corrupt + string_from_byte(g[i])
    }
    if gzip_read_fails(gzip.new_reader(corrupt)) {
        println("crc_err")
    }
    << 0
}
