@main
fn main() int {
    match 7 {
        0 { println("zero") }
        1:6 { println("low") }
        6:11 { println("mid") }
        else { println("high") }
    }
    match 100 {
        0 { println("zero") }
        1:100 { println("small") }
    }
    match -3 {
        -5:0 { println("neg") }
        else { println("other") }
    }
    << 0
}
