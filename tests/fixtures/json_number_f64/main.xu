@main

#encoding/json

fn main() int {
    src := "{\"n\":-2.5e1,\"i\":7}"
    d := json.parse(&src)
    r := d.root()
    n := d.get(r, "n")
    println(d.number_f64(n) or (err) { << 1 })
    i := d.get(r, "i")
    println(d.number_int(i) or (err) { << 1 })
    println(d.number_f64(i) or (err) { << 1 })
    << 0
}
