@main

#log/slog

fn main() int {
    mut l := slog.new_logger()
    l.add_time = 0
    l.use_stdout = true
    l.min_level = slog.level_debug
    l.info("hello")
    l = l.with("k", "v")
    l.warn("w")
    l.debug("d")
    if l.enabled(slog.level_error) {
        l.error("e")
    }
    mut quiet := slog.new_logger()
    quiet.min_level = slog.level_error
    quiet.add_time = 0
    quiet.use_stdout = true
    quiet.info("hidden")
    quiet.error("shown")
    println(slog.level_debug)
    println(slog.level_info)
    println(slog.level_warn)
    println(slog.level_error)
    mut multi := slog.new_logger()
    multi.add_time = 0
    multi.use_stdout = true
    multi = multi.with("a", "1", "b", "2")
    multi.info("m")
    mut bad := slog.new_logger()
    bad.add_time = 0
    bad.use_stdout = true
    bad = bad.with("solo")
    bad.info("x")
    mut call := slog.new_logger()
    call.add_time = 0
    call.use_stdout = true
    call.info("c", "x", "1", "y", "2")
    << 0
}
