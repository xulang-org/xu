@main

// Cross both packed promotion-word boundaries. many_locals has more than 62
// frame locals; many_blocks lowers to more than 62 reachable scalar CFG
// blocks. Every promoted value remains non-address-taken and definitely
// stored before use.
fn many_locals(seed int) int {
    mut acc := seed
    mut v0 := 0
    acc += v0
    mut v1 := 1
    acc += v1
    mut v2 := 2
    acc += v2
    mut v3 := 3
    acc += v3
    mut v4 := 4
    acc += v4
    mut v5 := 5
    acc += v5
    mut v6 := 6
    acc += v6
    mut v7 := 7
    acc += v7
    mut v8 := 8
    acc += v8
    mut v9 := 9
    acc += v9
    mut v10 := 10
    acc += v10
    mut v11 := 11
    acc += v11
    mut v12 := 12
    acc += v12
    mut v13 := 13
    acc += v13
    mut v14 := 14
    acc += v14
    mut v15 := 15
    acc += v15
    mut v16 := 16
    acc += v16
    mut v17 := 17
    acc += v17
    mut v18 := 18
    acc += v18
    mut v19 := 19
    acc += v19
    mut v20 := 20
    acc += v20
    mut v21 := 21
    acc += v21
    mut v22 := 22
    acc += v22
    mut v23 := 23
    acc += v23
    mut v24 := 24
    acc += v24
    mut v25 := 25
    acc += v25
    mut v26 := 26
    acc += v26
    mut v27 := 27
    acc += v27
    mut v28 := 28
    acc += v28
    mut v29 := 29
    acc += v29
    mut v30 := 30
    acc += v30
    mut v31 := 31
    acc += v31
    mut v32 := 32
    acc += v32
    mut v33 := 33
    acc += v33
    mut v34 := 34
    acc += v34
    mut v35 := 35
    acc += v35
    mut v36 := 36
    acc += v36
    mut v37 := 37
    acc += v37
    mut v38 := 38
    acc += v38
    mut v39 := 39
    acc += v39
    mut v40 := 40
    acc += v40
    mut v41 := 41
    acc += v41
    mut v42 := 42
    acc += v42
    mut v43 := 43
    acc += v43
    mut v44 := 44
    acc += v44
    mut v45 := 45
    acc += v45
    mut v46 := 46
    acc += v46
    mut v47 := 47
    acc += v47
    mut v48 := 48
    acc += v48
    mut v49 := 49
    acc += v49
    mut v50 := 50
    acc += v50
    mut v51 := 51
    acc += v51
    mut v52 := 52
    acc += v52
    mut v53 := 53
    acc += v53
    mut v54 := 54
    acc += v54
    mut v55 := 55
    acc += v55
    mut v56 := 56
    acc += v56
    mut v57 := 57
    acc += v57
    mut v58 := 58
    acc += v58
    mut v59 := 59
    acc += v59
    mut v60 := 60
    acc += v60
    mut v61 := 61
    acc += v61
    mut v62 := 62
    acc += v62
    mut v63 := 63
    acc += v63
    << acc
}

fn many_blocks(flag int) int {
    mut x := 1
    mut y := 2
    if flag > 0 {
        x += 1
    } else {
        y += 1
    }
    if flag > 1 {
        x += 1
    } else {
        y += 1
    }
    if flag > 2 {
        x += 1
    } else {
        y += 1
    }
    if flag > 3 {
        x += 1
    } else {
        y += 1
    }
    if flag > 4 {
        x += 1
    } else {
        y += 1
    }
    if flag > 5 {
        x += 1
    } else {
        y += 1
    }
    if flag > 6 {
        x += 1
    } else {
        y += 1
    }
    if flag > 7 {
        x += 1
    } else {
        y += 1
    }
    if flag > 8 {
        x += 1
    } else {
        y += 1
    }
    if flag > 9 {
        x += 1
    } else {
        y += 1
    }
    if flag > 10 {
        x += 1
    } else {
        y += 1
    }
    if flag > 11 {
        x += 1
    } else {
        y += 1
    }
    if flag > 12 {
        x += 1
    } else {
        y += 1
    }
    if flag > 13 {
        x += 1
    } else {
        y += 1
    }
    if flag > 14 {
        x += 1
    } else {
        y += 1
    }
    if flag > 15 {
        x += 1
    } else {
        y += 1
    }
    if flag > 16 {
        x += 1
    } else {
        y += 1
    }
    if flag > 17 {
        x += 1
    } else {
        y += 1
    }
    if flag > 18 {
        x += 1
    } else {
        y += 1
    }
    if flag > 19 {
        x += 1
    } else {
        y += 1
    }
    if flag > 20 {
        x += 1
    } else {
        y += 1
    }
    if flag > 21 {
        x += 1
    } else {
        y += 1
    }
    if flag > 22 {
        x += 1
    } else {
        y += 1
    }
    if flag > 23 {
        x += 1
    } else {
        y += 1
    }
    << x + y
}

fn main() int {
    println(many_locals(1))
    println(many_blocks(100))
    << 0
}
