@main
#runtime
struct Box {
    pad int
    value string
}
fn main() int {
    boxes := [Box{pad: 42, value: "heap" + "string"}]
    p := "heap"
    println(starts_with(boxes[0].value, p))
    println(runtime.starts_with(&boxes[0].value, &p))
    f := runtime.starts_with
    println(f(&boxes[0].value, &p))
    value_ref := &boxes[0].value
    println(runtime.starts_with(value_ref, &p))
    mut same_ref := &boxes[0].value
    bs := runtime.str_bytes(same_ref)
    rs := runtime.str_runes(same_ref)
    println(bs.len)
    println(rs.len)
    println(boxes[0].value.len)
    println(boxes[0].pad)
    << 0
}
