@main

#encoding/ascii85

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn decode_fails(s &string) bool {
    ascii85.decode_string(s) or (err) { << true }
    << false
}

fn main() int {
    empty := ""
    println(ascii85.encode_to_string(&empty))
    println(ascii85.max_encoded_len(1))
    xus := "Xu"
    println(ascii85.encode_to_string(&xus))
    hello := "hello"
    e := ascii85.encode_to_string(&hello)
    println(e)
    println(ascii85.decode_string(&e) or (err) { << 1 })
    z := string_from_byte(0) + string_from_byte(0) + string_from_byte(0) + string_from_byte(0)
    println(ascii85.encode_to_string(&z))
    man := "Man "
    println(ascii85.encode_to_string(&man))
    ws := "BOu! rDZ"
    println(ascii85.decode_string(&ws) or (err) { << 1 })
    bad := "~~~~"
    show_bool(decode_fails(&bad))
    << 0
}
