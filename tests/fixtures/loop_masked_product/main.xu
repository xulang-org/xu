fn reduce_9(start int, factor int, initial int) int {
    mut acc := initial
    mut i := start
    while i < 49 {
        acc += (factor * i) & 1099511627775
        i += 1
    }
    println(i)
    << acc
}
fn extra_store(start int, factor int, initial int) int {
    mut acc := initial
    mut side := 0
    mut i := start
    while i < 49 {
        acc += (factor * i) & 31
        side += i ^ 7
        i += 1
    }
    println(side)
    println(i)
    << acc
}
fn changed_factor(start int, factor int, initial int) int {
    mut acc := initial
    mut f := factor
    mut i := start
    while i < 49 {
        acc += (f * i) & 31
        f += 7
        i += 1
    }
    println(f)
    println(i)
    << acc
}
