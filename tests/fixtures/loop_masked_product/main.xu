@main
#math
#strings
fn reduce_0(start int, factor int, initial int) int {
    mut acc := initial
    mut i := start
    while i < 40 {
        acc += (factor * i) & 0
        i += 1
    }
    println(i)
    << acc
}
fn reduce_1(start int, factor int, initial int) int {
    mut acc := initial
    mut i := start
    while i < 41 {
        acc += (factor * i) & 1
        i += 1
    }
    println(i)
    << acc
}
fn reduce_2(start int, factor int, initial int) int {
    mut acc := initial
    mut i := start
    while i < 48 {
        acc += (factor * i) & 7
        i += 1
    }
    println(i)
    << acc
}
