@main

#archive/tar

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn empty_name_fails() bool {
    mut w := tar.new_writer()
    nm := ""
    body := "x"
    w.write_file(&nm, &body, 420) or (err) { << true }
    << false
}

fn write_after_close_fails() bool {
    mut w := tar.new_writer()
    nm := "a.txt"
    body := "ok"
    w.write_file(&nm, &body, 420) or (err) { << false }
    w.close()
    w.write_file(&nm, &body, 420) or (err) { << true }
    << false
}

fn truncated_archive_fails() bool {
    mut w := tar.new_writer()
    nm := "a.txt"
    body := "hello"
    w.write_file(&nm, &body, 420) or (err) { << false }
    raw := w.bytes()
    if raw.len < 512 {
        << false
    }
    hdr := raw[0:512] + ""
    mut r := tar.new_reader(&hdr)
    r.next() or (err) { << true }
    << false
}

fn name_too_long_fails() bool {
    mut nm := ""
    mut i := 0
    while i < 101 {
        nm = nm + "a"
        i = i + 1
    }
    h := tar.Header{
        name: nm,
        size: 0,
        mode: 0,
        typeflag: tar.type_reg,
        linkname: "",
        uname: "",
        gname: "",
        mtime: 0
    }
    tar.encode_header(&h) or (err) { << true }
    << false
}

fn main() int {
    show_bool(empty_name_fails())
    show_bool(write_after_close_fails())
    show_bool(truncated_archive_fails())
    show_bool(name_too_long_fails())
    << 0
}
