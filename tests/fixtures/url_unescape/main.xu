@main

#net/url

fn main() int {
    a := "a+b"
    println(url.query_unescape(&a) or (err) { << 1 })
    println(url.path_unescape(&a) or (err) { << 1 })
    b := "a%20b"
    println(url.query_unescape(&b) or (err) { << 1 })
    mut q := url.new_query()
    q.parse("x=1&y=2") or (err) { << 1 }
    println(q.get("x"))
    println(q.get("z").len)
    q.set("x", "9")
    println(q.get("x"))
    q.del("y")
    println(q.len())
    << 0
}
