@main

struct Inner {
    pub e temp
    pub x int
}

struct Wrap {
    pub inner Inner
    pub n int
}

fn main() int {
    mut n := 0
    for i in 0:10000 {
        b := Wrap{inner: Inner{e: 1, x: 8}, n: 9}
        if i % 2 == 0 {
            v := b.inner.e as int
            n += v
            n += b.inner.x
        } else {
            n += b.inner.x
        }
    }
    println(n)
    println("ok")
    << 0
}
