@main
#bufio
#bufio/file
#io
#os

fn negative_discard() bool {
    mut r := bufio.new_reader(io.buffer_from("A"))
    r.discard(0 - 1) or (err) { << true }
    << false
}

fn write_fails(w &mut file.FileWriter, data string) bool {
    w.write(data) or (err) { << true }
    << false
}

fn flush_fails(w &mut file.FileWriter) bool {
    w.flush() or (err) { << true }
    << false
}

fn read_eof(r &mut file.FileReader) bool {
    r.read_string(10) or (err) { << err.msg() == "EOF" }
    << false
}

fn main() int {
    println(negative_discard())
    // Tiny capacity must decode a complete rune and then return bounded slices.
    mut r := bufio.new_reader_size(io.buffer_from("😀abcdef"), 1)
    x := r.read_rune() or (err) { << 1 }
    println(x.ch == 128512 && x.size == 4)
    println(r.read_slice(10) or (err) { << 2 })
    println(r.buf.len <= 4)
    // Long lines accumulate in the returned string, not the staging buffer.
    mut data := ""
    for i in 0:1025 { data = data + "x" }
    mut mem := bufio.new_reader_size(io.buffer_from(data + "\nend"), 3)
    line := mem.read_line() or (err) { << 3 }
    println(line.len == 1025)
    println(mem.buf.len <= 3)
    println(mem.read_line() or (err) { << 4 })
    mem.unread_byte() or (err) { << 5 }
    println(mem.read_byte() or (err) { << 6 })
    mut writer := bufio.new_writer_size(io.buffer(), 4)
    println(writer.write_string(data + "") or (err) { << 7 })
    println(writer.buf.len <= 4)
    writer.flush() or (err) { << 8 }
    println(writer.bytes() == data)
    writer.err = "injected"
    writer.reset(io.buffer())
    println(writer.err == "")

    // A real descriptor error must throw, retain bounded pending bytes, and
    // remain sticky even if the caller swaps in a healthy descriptor.
    mut broken := file.new_writer_size(os.closed_file(), 4)
    println(write_fails(mut &broken, data + ""))
    println(broken.buf.len == 4)
    println(broken.err.len > 0)
    path := "bufio_file_errors.tmp"
    mut f := os.create(path + "") or (err) { << 9 }
    broken.dst = f
    println(flush_fails(mut &broken))
    println(write_fails(mut &broken, "Z"))
    dst := mut &broken.dst
    dst.close() or (err) { << 10 }
    println((os.read(path + "") or (err) { << 11 }).len == 0)
    os.remove(path + "") or (err) { << 12 }

    mut good := os.create(path + "") or (err) { << 13 }
    mut out := file.new_writer_size(good, 4)
    println(out.write("ab") or (err) { << 14 })
    println(out.write(data + "") or (err) { << 15 })
    println(out.buf.len <= 4)
    out.flush() or (err) { << 16 }
    out_dst := mut &out.dst
    out_dst.close() or (err) { << 17 }
    println((os.read(path + "") or (err) { << 18 }) == "ab" + data)
    mut input := os.open(path + "") or (err) { << 19 }
    mut reader := file.new_reader_size(input, 3)
    println((reader.read_string(10) or (err) { << 20 }) == "ab" + data)
    println(reader.buf.len <= 3)
    println(read_eof(mut &reader))
    reader_src := mut &reader.src
    reader_src.close() or (err) { << 21 }
    os.remove(path + "") or (err) { << 22 }
    << 0
}
