@main
struct User {
    name string
    age  int
}
fn main() int {
    mut users := []User{}
    users.push(User{name: "ada", age: 36})
    users.push(User{name: "grace" + " hopper", age: 85})
    println(users.len)
    println(users[0].name)
    println(users[1].age)
    println(users[1].name)
    << 0
}
