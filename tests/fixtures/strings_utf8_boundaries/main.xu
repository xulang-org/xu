@main

#strings
#bytes
#encoding/hex

fn dump(parts []string) {
    println(parts.len)
    for i in 0:parts.len {
        println(hex.encode_to_string(parts[i] + ""))
    }
}

fn main() int {
    s0 := ""
    println(strings.count(&s0, ""))
    dump(strings.split(&s0, ""))
    dump(strings.split_after(&s0, ""))
    dump(strings.split_n(&s0, "", -1))
    dump(strings.split_after_n(&s0, "", -1))
    println(hex.encode_to_string(strings.replace(&s0, "", "|", -1)))
    dump(strings.split_n(&s0, "", 0))
    dump(strings.split_after_n(&s0, "", 0))
