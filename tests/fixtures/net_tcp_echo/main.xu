@main

#net

fn main() int {
    lfd := net.listen("127.0.0.1:19878") or (err) { << 1 }
    dfd := net.dial("127.0.0.1:19878") or (err) { << 1 }
    msg := "ping"
    println(net.conn_write(dfd, &msg) or (err) { << 1 })
    cfd := net.accept(lfd) or (err) { << 1 }
    back := net.conn_read(cfd, 64) or (err) { << 1 }
    println(back)
    println(net.conn_close(cfd) or (err) { << 1 })
    println(net.conn_close(dfd) or (err) { << 1 })
    println(net.conn_close(lfd) or (err) { << 1 })
    << 0
}
