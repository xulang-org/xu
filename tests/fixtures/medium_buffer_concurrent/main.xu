@main

// Keep more buffers live than the cache retains, then reuse every boundary
// class. Fresh make_string results must still be zero and independent.
fn check_size(n int) bool {
    mut round := 0
    while round < 8 {
        mut buffers := []string{}
        mut j := 0
        while j < 8 {
            mut b := make_string(n)
            mut i := 0
            while i < n {
                if b[i] != 0 { << false }
                i += 1
            }
            b[0] = j + 1
            b[n - 1] = 200 + j
            buffers.push(b)
            j += 1
        }
        j = 0
        while j < buffers.len {
            b := &buffers[j]
            if b.len != n || b[0] != j + 1 || b[n - 1] != 200 + j { << false }
            j += 1
        }
        round += 1
    }
    << true
}

fn worker(n int, out chan int) {
    if check_size(n) { out <- 1 } else { out <- 0 }
}

fn main() int {
    out := chan int{cap: 0}
    sizes := [5]int{2049, 4097, 8193, 32769, 65536}
    for i in 0:32 { xu worker(sizes[i % 5], out) }
    mut total := 0
    for i in 0:32 { total += <-out }
    if total != 32 { << 1 }
    println("medium buffer concurrent OK")
    << 0
}
