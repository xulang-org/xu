@main

fn normalize(x f64) f64 {
    ln2 := 0.6931471805599453
    mut v := x
    mut exponent := 0
    while v >= 2.0 {
        v = v * 0.5
        exponent += 1
    }
    while v < 1.0 {
        v = v * 2.0
        exponent -= 1
    }
    f := (v - 1.0) / (v + 1.0)
    f2 := f * f
    mut term := f
    mut sum := f
    mut n := 1
    while n < 12 {
        term = term * f2
        sum = sum + term / f64(2 * n + 1)
        n += 1
    }
    << sum + sum + f64(exponent) * ln2
}

fn main() int {
    value := normalize(4.0)
    println(value > 1.3862 && value < 1.3864)
    << 0
}
