-----END X509 CRL-----
`

    argv := os.args()
    mut scenario := "require_complete_crls"
    if argv.len > 1 {
        scenario = argv[1] + ""
    }

    mut root := cert(&root_pem) or (err) { << 1 }
    leaf := cert(&leaf_pem) or (err) { << 1 }
    if scenario == "issuer_without_crl_sign" {
        root.key_usage = x509.key_usage_cert_sign
    }
    mut roots := x509.new_cert_pool()
    roots.add(root)
    intermediates := x509.new_cert_pool()
    mut lists := []string{}
    mut mode := x509.revocation_if_present
    if scenario == "off_without_crl" {
        mode = x509.revocation_off
    } else if scenario == "require_without_crl" || scenario == "require_complete_crls" || scenario == "revoked_leaf" {
        mode = x509.revocation_require
    } else if scenario == "invalid_mode" {
        mode = 99
    }
    if scenario != "off_without_crl" && scenario != "if_present_without_crl" && scenario != "require_without_crl" && scenario != "invalid_mode" {
        mut leaf_list := crl(&root_crl_pem) or (err) { << 1 }
        if scenario == "revoked_leaf" {
            leaf_list = crl(&revoked_crl_pem) or (err) { << 1 }
        } else if scenario == "bad_signature" {
            raw := leaf_list.raw + ""
            leaf_list.raw = raw[0:raw.len - 1] + string_from_byte((raw[raw.len - 1] & 255) ^ 1)
        } else if scenario == "expired_crl" {
            leaf_list = crl(&expired_crl_pem) or (err) { << 1 }
        } else if scenario == "missing_next_update" {
            leaf_list = crl(&missing_next_crl_pem) or (err) { << 1 }
        } else if scenario == "unknown_critical_crl" {
            leaf_list = crl(&unknown_critical_crl_pem) or (err) { << 1 }
        }
        lists.push(leaf_list.raw)
    }
    mut opts := x509.VerifyOptions{
        dns_name: "crl.example",
        current_time: leaf.not_before.add(time.hour()),
        roots: roots,
        intermediates: intermediates,
        key_usages: []int{},
        certificate_policies: []string{},
        revocation_lists: lists,
        revocation_mode: mode
    }
    println(scenario + "=" + bool_word(verify_result(&leaf, &opts)))
    << 0
}
