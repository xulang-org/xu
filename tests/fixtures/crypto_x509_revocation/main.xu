@main

#crypto/x509
#encoding/pem
#os
#time

fn cert(text &string) x509.Certificate {
    block := pem.decode(text)
    << x509.parse_certificate(block.bytes) or >>
}

fn crl(text &string) x509.RevocationList {
    block := pem.decode(text)
    << x509.parse_revocation_list(block.bytes) or >>
}

fn bool_word(v bool) string {
    if v {
        << "true"
    }
    << "false"
}

fn verify_result(leaf &x509.Certificate, opts &x509.VerifyOptions) bool {
    leaf.verify_options(opts) or (err) { << false }
    << true
}

