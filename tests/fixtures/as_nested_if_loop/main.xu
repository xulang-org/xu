@main

fn main() int {
    mut n := 0
    for i in 0:10000 {
        let e: temp = 1
        if i < 5000 {
            if i % 2 == 0 {
                v := e as int
                n += v
            } else {
                n += 1
            }
        } else {
            n += 1
        }
    }
    println(n)
    println("ok")
    << 0
}
