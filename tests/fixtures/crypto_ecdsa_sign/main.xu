@main

#crypto/ecdsa
#crypto/sha256
#crypto/sha512
#encoding/hex

fn scalar_one(size int) string {
    mut b := []int{}
    for _ in 0:size {
        b.push(0)
    }
    b[size - 1] = 1
    << string_from_bytes(b)
}

fn scalar_zero(size int) string {
    mut b := []int{}
    for _ in 0:size {
        b.push(0)
    }
    << string_from_bytes(b)
}

fn flip_last(s &string) string {
    mut b := []int{}
    for i in 0:s.len {
        b.push(s[i] & 255)
    }
    b[b.len - 1] = b[b.len - 1] ^ 1
    << string_from_bytes(b)
}

fn exercise(private_key &string, hash &string) int {
    public_key := ecdsa.public(private_key) or (err) {
        println(err.msg())
        << 1
    }
    signature := ecdsa.sign_asn1(private_key, hash) or (err) {
        println(err.msg())
        << 1
    }
    println(private_key.len)
    println(public_key.len)
    println(ecdsa.verify_asn1(&public_key, hash, &signature))
    bad_hash := flip_last(hash)
    println(ecdsa.verify_asn1(&public_key, &bad_hash, &signature))
    bad_signature := flip_last(&signature)
    println(ecdsa.verify_asn1(&public_key, hash, &bad_signature))
    << 0
}

fn generated(curve int, private_size int, public_size int, hash &string) int {
    private_key := ecdsa.generate_key(curve) or (err) {
        println(err.msg())
        << 1
    }
    public_key := ecdsa.public(&private_key) or (err) {
        println(err.msg())
        << 1
    }
    signature := ecdsa.sign_asn1(&private_key, hash) or (err) {
        println(err.msg())
        << 1
    }
    println(private_key.len == private_size)
    println(public_key.len == public_size)
    println(ecdsa.verify_asn1(&public_key, hash, &signature))
    << 0
}

fn public_matches(private_key &string, want_hex string) bool {
    public_key := ecdsa.public(private_key) or (err) { << false }
    want := hex.decode_string(want_hex) or (err) { << false }
    << public_key == want
}

fn public_fails(private_key &string) bool {
    ecdsa.public(private_key) or (err) { << true }
    << false
}

fn sign_fails(private_key &string, hash &string) bool {
    ecdsa.sign_asn1(private_key, hash) or (err) { << true }
    << false
}

fn generate_fails(curve int) bool {
    ecdsa.generate_key(curve) or (err) { << true }
    << false
}

fn main() int {
    msg256 := "xu-ecdsa-sign-p256"
    h256hex := sha256.sum256(msg256)
    h256 := hex.decode_string(h256hex) or (err) { << 1 }
    d256 := scalar_one(ecdsa.private_key_size_p256)
    println(public_matches(&d256, "046b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c2964fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5"))
    if exercise(&d256, &h256) != 0 { << 1 }

    msg384 := "xu-ecdsa-sign-p384"
    h384 := sha512.sum384(msg384)
    d384 := scalar_one(ecdsa.private_key_size_p384)
    println(public_matches(&d384, "04aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab73617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f"))
    if exercise(&d384, &h384) != 0 { << 1 }

    msg521 := "xu-ecdsa-sign-p521"
    h521 := sha512.sum512(msg521)
    d521 := scalar_one(ecdsa.private_key_size_p521)
    println(public_matches(&d521, "0400c6858e06b70404e9cd9e3ecb662395b4429c648139053fb521f828af606b4d3dbaa14b5e77efe75928fe1dc127a2ffa8de3348b3c1856a429bf97e7e31c2e5bd66011839296a789a3bc0045c8a5fb42c7d1bd998f54449579b446817afbd17273e662c97ee72995ef42640c550b9013fad0761353c7086a272c24088be94769fd16650"))
    if exercise(&d521, &h521) != 0 { << 1 }

    if generated(ecdsa.p256, ecdsa.private_key_size_p256, ecdsa.public_key_size_p256, &h256) != 0 { << 1 }
    if generated(ecdsa.p384, ecdsa.private_key_size_p384, ecdsa.public_key_size_p384, &h384) != 0 { << 1 }
    if generated(ecdsa.p521, ecdsa.private_key_size_p521, ecdsa.public_key_size_p521, &h521) != 0 { << 1 }

    z256 := scalar_zero(ecdsa.private_key_size_p256)
    empty := ""
    println(public_fails(&z256))
    println(sign_fails(&d256, &empty))
    println(generate_fails(255))
    << 0
}
