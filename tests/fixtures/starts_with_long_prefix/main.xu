@main

#runtime

fn mk(n int) string {
    mut b := []int{}
    for i in 0:n {
        b.push(120)
    }
    << string_from_bytes(b)
}

fn main() int {
    // Regression: no artificial 1 MiB prefix cap. A runtime-built 2 MiB
    // prefix must compare normally (false when longer than s, true when equal).
    p := mk(2097152)
    println(p.len)
    xp := "x"
    println(starts_with("x", p))
    q := mk(2097152)
    xq := "x"
    println(runtime.starts_with(&xq, &q))
    a := mk(64)
    b := mk(64)
    println(starts_with(a, b))
    c := mk(64)
    d := mk(64)
    println(runtime.starts_with(&c, &d))
    << 0
}
