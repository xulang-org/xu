@main
#io
#errors

struct Source {
    data string
    off int
    step int
    calls int
    fail int
}
fn (s &mut Source) read_n(n int) string {
    s.calls = s.calls + 1
    if s.fail != 0 && s.off >= 2 {
        if s.fail == 1 { >> errors.new(io.eof) }
        >> errors.new("source failed")
    }
    mut take := n
    if take > s.step { take = s.step }
    if take > s.data.len - s.off { take = s.data.len - s.off }
    start := s.off
    s.off = s.off + take
    << s.data[start:s.off]
}
struct Sink {
    data string
    calls int
    mode int
}
fn (s &mut Sink) write_str(data string) int {
    s.calls = s.calls + 1
    if s.mode == 1 {
        s.data = s.data + data[0:1]
        << 1
    }
    if s.mode == 2 { << -1 }
    if s.mode == 3 { << data.len + 1 }
    if s.mode == 4 { >> errors.new("sink failed") }
    s.data = s.data + data
    << data.len
}
struct BadSource { calls int }
fn (s &mut BadSource) read_n(n int) string {
    s.calls = s.calls + 1
    << "oversized"
}
fn attempt(s &mut Source, d &mut Sink, mode int) string {
    if mode == 0 {
        _ := io.copy_stream(d,s) or (err) { << err.msg() }
    } else if mode == 1 {
        _ := io.copy_stream_buffer(d,s,3) or (err) { << err.msg() }
    } else {
        _ := io.copy_stream_n(d,s,9) or (err) { << err.msg() }
    }
    << "ok"
}
fn edge(c &mut io.Cursor, b &mut io.Buffer, n int) string {
    io.copy_stream_n(b,c,n) or (err) { << err.msg() }
    << "ok"
}
fn invalid_read(s &mut BadSource, b &mut io.Buffer, size int) string {
    io.copy_stream_buffer(b,s,size) or (err) { << err.msg() }
    << "ok"
}
struct StreamingSource { ready chan int
    off int
}
struct StreamingSink { ready chan int
    n int
}
fn (s &mut StreamingSource) read_n(n int) string {
    if s.off == 3 { << "" }
    token := <-s.ready
    if token != 1 || n <= 0 { >> errors.new("ordering failed") }
    s.off = s.off + 1
    << "x"
}
fn (s &mut StreamingSink) write_str(data string) int {
    s.n = s.n + data.len
    s.ready <- 1
    << data.len
}
fn main() int {
    mut c := io.cursor("hello")
    mut b := io.buffer_from("prefix:")
    println(io.copy_stream(mut &b,mut &c) or (err) { << 1 })
    println(c.off)
    println(b.bytes())
    mut s := Source{data:"abcdef",off:0,step:2,calls:0,fail:0}
    mut d := Sink{data:"",calls:0,mode:0}
    println(io.copy_stream_buffer(mut &d,mut &s,3) or (err) { << 1 })
    println(s.calls)
    println(d.calls)
    println(d.data)
    for mode in 0:3 {
        for fail in 1:3 {
            mut e := Source{data:"abcdef",off:0,step:2,calls:0,fail:fail}
            mut o := Sink{data:"",calls:0,mode:0}
            println(attempt(mut &e,mut &o,mode))
            println(e.off)
            println(o.data)
        }
        for bad in 1:5 {
            mut e2 := Source{data:"abcdef",off:0,step:2,calls:0,fail:0}
            mut o2 := Sink{data:"",calls:0,mode:bad}
            println(attempt(mut &e2,mut &o2,mode))
            println(e2.off)
            println(e2.calls)
            println(o2.calls)
            println(o2.data)
        }
    }
    mut limited := io.cursor("abcdef")
    mut target := io.buffer()
    println(io.copy_stream_n(mut &target,mut &limited,3) or (err) { << 1 })
    println(limited.read_n(3))
    println(target.bytes())
    mut empty := io.cursor("")
    println(io.copy_stream_n(mut &target,mut &empty,0) or (err) { << 1 })
    println(empty.off)
    println(edge(mut &empty,mut &target,1))
    println(edge(mut &empty,mut &target,-1))
    mut invalid := BadSource{calls:0}
    println(invalid_read(mut &invalid,mut &target,2))
    println(invalid.calls)
    println(invalid_read(mut &invalid,mut &target,0))
    println(invalid.calls)
    mut multi := io.multi_cursor("a","","bc")
    mut discard := io.discard()
    println(io.copy_stream(mut &discard,mut &multi) or (err) { << 1 })
    println(discard.written())
    ready := chan int{cap:1}
    ready <- 1
    mut live := StreamingSource{ready:ready,off:0}
    mut sink := StreamingSink{ready:ready,n:0}
    println(io.copy_stream(mut &sink,mut &live) or (err) { << 1 })
    println(sink.n)
    << 0
}
