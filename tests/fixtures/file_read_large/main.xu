@main

#errors

fn main() int {
    mut s := ""
    chunk := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    for i in 0:20000 {
        s.push_str(chunk)
    }
    println(s.len)
    write_file("large_io.txt", s) or (err) {
        println("write failed")
        << 1
    }
    content := read_file("large_io.txt") or (err) {
        println("read failed")
        << 1
    }
    println(content.len)
    println(content == s)
    << 0
}
