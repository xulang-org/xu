@main
#math
#strings
struct Packet { tag int, a f64, b f64, c f64 }
fn sum_fields(data &[]Packet, start int, count int) f64 {
    mut total := 0.0
    for i in start:count {
        total += data[i].a + data[i].b * 2.0 + f64(data[i].tag) - data[i].c * 0.5
    }
    << total
}
fn update(data &mut []Packet, delta f64) {
    for i in 0:data.len {
        data[i].a += delta
        data[i].c -= data[i].b * 0.25
    }
}
fn selected(first &[]Packet, second &[]Packet, flip bool) f64 {
    mut chosen := first
    if flip { chosen = second }
    << sum_fields(chosen, 0, 4)
}
fn grow(data &mut []Packet, value f64) {
    data.push(Packet{tag: 97, a: value, b: 0.5, c: -0.25})
}
fn main() int {
    for seed in -32:32 {
        mut a := []Packet{}
        mut b := []Packet{}
        for j in 0:4 {
            a.push(Packet{tag: seed + j * 7, a: f64(seed * 3 + j) * 0.25, b: f64(j - seed) * 0.5, c: f64(seed + j * 5)})
            b.push(Packet{tag: seed - j, a: f64(seed - j * 3), b: f64(j) * 0.25, c: -0.5})
        }
        println(int(sum_fields(&a, 0, 4) * 8.0))
        update(mut &a, f64(seed) * 0.125)
        println(int(sum_fields(&a, 1, 4) * 8.0))
        println(int(selected(&a, &b, seed < 0) * 8.0))
        grow(mut &a, f64(seed))
        println(int(sum_fields(&a, 3, 5) * 8.0))
        update(mut &a, 0.5)
        println(int(sum_fields(&a, 0, 5) * 8.0))
    }
    println(math.sqrt(9.0))
    println("abc".len)
    << 0
}
