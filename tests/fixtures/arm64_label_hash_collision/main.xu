@main
// weohjrvxjgxo and bbtplmxsqwul have the same djb2 hash. Their forward block labels must
// remain distinct, even when both functions are emitted in the same unit.
fn weohjrvxjgxo(x int) int {
    if x > 0 { << 11 }
    << 12
}
fn bbtplmxsqwul(x int) int {
    if x > 0 { << 22 }
    << 23
}
fn main() int {
    println(weohjrvxjgxo(1))
    println(weohjrvxjgxo(0))
    println(bbtplmxsqwul(1))
    println(bbtplmxsqwul(0))
    << 0
}
