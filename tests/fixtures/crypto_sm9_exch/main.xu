@main

#crypto/sm9
#encoding/hex

fn main() int {
    ke := hex.decode_string("02e65b0762d042f51f0d23542b13ed8cfa2e9a0e7206361e013a283905e31f") or (err) {
        << 1
    }
    mpk := sm9.enc_master_public(&ke) or (err) {
        println(err.msg())
        << 1
    }
    alice := "Alice"
    bob := "Bob"
    da := sm9.exch_user_key(&ke, &alice) or (err) {
        println(err.msg())
        << 1
    }
    db := sm9.exch_user_key(&ke, &bob) or (err) {
        println(err.msg())
        << 1
    }
    mut a := sm9.exch_new(&da, &mpk, &alice, &bob, 16, true) or (err) {
        println(err.msg())
        << 1
    }
    mut b := sm9.exch_new(&db, &mpk, &bob, &alice, 16, true) or (err) {
        println(err.msg())
        << 1
    }
    ra := hex.decode_string("5879dd1d51e175946f23b1b41e93ba31c584ae59a426ec1046a4d03b06c8") or (err) {
        << 1
    }
    raw := a.init_r(&ra) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(raw + ""))
    rb := hex.decode_string("018b98c44bef9f8537fb7d071b2c928b3bc65bd3d69e1eee213564905634fe") or (err) {
        << 1
    }
    capb := b.respond_r(&rb, &raw) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(capb.mac + ""))
    ptb := capb.point + ""
    macb := capb.mac + ""
    capa := a.confirm_responder(&ptb, &macb) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(capa.mac + ""))
    println(hex.encode_to_string(capa.key + ""))
    key2 := b.confirm_initiator(&capa.mac) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(key2 + ""))
    << 0
}
