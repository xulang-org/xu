@main

#crypto/x509
#encoding/pem
#time

fn cert(text &string) x509.Certificate {
    block := pem.decode(text)
    << x509.parse_certificate(block.bytes) or >>
}

fn verify_case(root_text &string, intermediate_text &string, leaf_text &string, variant int, requested []string) bool {
    root := cert(root_text) or (err) { << false }
    mut intermediate := cert(intermediate_text) or (err) { << false }
    mut leaf := cert(leaf_text) or (err) { << false }
    if variant == 1 {
        intermediate.inhibit_policy_mapping = 0
    } else if variant == 2 {
        intermediate.require_explicit_policy = 0
        leaf.certificate_policies = []string{}
        leaf.certificate_policies_present = false
    } else if variant == 3 {
        leaf.certificate_policies = ["1.2.3.9"]
        leaf.certificate_policies_present = true
    } else if variant == 4 {
        intermediate.policy_mapping_subjects = ["1.2.3.9"]
    } else if variant == 5 {
        leaf.certificate_policies = ["2.5.29.32.0"]
        leaf.certificate_policies_present = true
        intermediate.inhibit_any_policy = 0
        intermediate.inhibit_any_policy_present = true
    }
    mut roots := x509.new_cert_pool()
    roots.add(root)
    mut intermediates := x509.new_cert_pool()
    intermediates.add(intermediate)
    now := leaf.not_before.add(time.hour())
    opts := x509.VerifyOptions{dns_name: "policy.example", current_time: now, roots: roots, intermediates: intermediates, key_usages: []int{}, certificate_policies: requested, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    leaf.verify(opts) or (err) { << false }
    << true
}

