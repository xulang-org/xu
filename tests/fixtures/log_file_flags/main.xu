@main

#log
#fmt

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    mut l := log.new_logger()
    l.set_output_buffer()
    l.set_flags(log.lshortfile)
    l.println_at("/tmp/dir/x.xu", 9, fmt.s("m"))
    show_bool(l.buffer_text() == "x.xu:9: m\n")
    mut l2 := log.new_logger()
    l2.set_output_buffer()
    l2.set_flags(log.llongfile)
    l2.println_at("/tmp/dir/x.xu", 3, fmt.s("z"))
    show_bool(l2.buffer_text() == "/tmp/dir/x.xu:3: z\n")
    mut l3 := log.new_logger()
    l3.set_output_buffer()
    l3.set_prefix("P:")
    l3.set_flags(log.lmsgprefix | log.lshortfile)
    l3.println_at("a.xu", 1, fmt.s("q"))
    show_bool(l3.buffer_text() == "a.xu:1: P:q\n")
    mut l4 := log.new_logger()
    l4.set_output_buffer()
    l4.set_flags(log.lshortfile)
    l4.println(fmt.s("nopath"))
    show_bool(l4.buffer_text() == "main.xu:34: nopath\n")
    << 0
}
