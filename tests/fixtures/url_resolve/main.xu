@main

#net/url

fn main() int {
    base := url.parse_url("http://ex.com/dir/page") or (err) {
        println(err.msg())
        << 1
    }
    a := base.resolve_reference("/x") or (err) {
        println(err.msg())
        << 1
    }
    println(a.to_string())
    b := base.resolve_reference("q") or (err) {
        println(err.msg())
        << 1
    }
    println(b.to_string())
    c := base.resolve_reference("http://other/z") or (err) {
        println(err.msg())
        << 1
    }
    println(c.to_string())
    d := base.resolve_reference("?k=1") or (err) {
        println(err.msg())
        << 1
    }
    println(d.to_string())
    << 0
}
