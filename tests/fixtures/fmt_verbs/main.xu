@main

#fmt

fn expect_err(f string, args []fmt.Arg) {
    fmt.sprintf_args(f, args) or (err) {
        println(err.msg())
        <<
    }
}

fn main() int {
    // ---- success: %d %s %v %t %% (and leftover EXTRA args) ----
    println(fmt.sprintf("%d", fmt.i(42)) or (err) { << 1 })
    println(fmt.sprintf("%d", fmt.i(-7)) or (err) { << 1 })
    println(fmt.sprintf("%d", fmt.i(0)) or (err) { << 1 })
    println(fmt.sprintf("%s", fmt.s("hi")) or (err) { << 1 })
    println(fmt.sprintf("%s", fmt.s("")) or (err) { << 1 })
    println(fmt.sprintf("%v", fmt.i(42)) or (err) { << 1 })
    println(fmt.sprintf("%v", fmt.s("hi")) or (err) { << 1 })
    println(fmt.sprintf("%v", fmt.b(true)) or (err) { << 1 })
    println(fmt.sprintf("%v", fmt.f(3.14)) or (err) { << 1 })
    println(fmt.sprintf("%t", fmt.b(true)) or (err) { << 1 })
    println(fmt.sprintf("%t", fmt.b(false)) or (err) { << 1 })
    println(fmt.sprintf("100%%") or (err) { << 1 })
    println(fmt.sprintf("%%") or (err) { << 1 })
    println(fmt.sprintf("") or (err) { << 1 })
    println(fmt.sprintf("a%sb", fmt.s("x")) or (err) { << 1 })
    println(fmt.sprintf("%s=%d", fmt.s("n"), fmt.i(7)) or (err) { << 1 })
    println(fmt.sprintf("%d %s %t %v", fmt.i(1), fmt.s("two"), fmt.b(true), fmt.f(2.5)) or (err) { << 1 })
    println(fmt.sprintf("%d", fmt.i(1), fmt.s("x")) or (err) { << 1 })

    // ---- type/verb mismatch: Go on-error markers thrown ----
    expect_err("%d", [fmt.s("x")])
    expect_err("%s", [fmt.i(7)])
    expect_err("%t", [fmt.i(1)])
    expect_err("%d", [fmt.b(true)])
    expect_err("%d", [fmt.f(3.14)])
    expect_err("%s", [fmt.b(false)])

    // ---- missing argument ----
    expect_err("%d", []fmt.Arg{})

    // ---- width/precision (B0b) ----
    println(fmt.sprintf("%5d", fmt.i(5)) or (err) { << 1 })
    println(fmt.sprintf("%.2f", fmt.f(3.14)) or (err) { << 1 })
    << 0
}
