@main

#sort

fn check(a &[]int) int {
    mut bad := 0
    mut i := 1
    while i < a.len {
        if a[i - 1] > a[i] {
            bad += 1
        }
        i += 1
    }
    << bad * 1000000 + a[0] * 1000 + a[a.len - 1]
}

fn main() int {
    mut sorted := []int{}
    mut reverse := []int{}
    mut equal := []int{}
    mut duplicate := []int{}
    mut i := 0
    while i < 128 {
        sorted.push(i)
        reverse.push(127 - i)
        equal.push(7)
        duplicate.push((i * 37) % 11 - 5)
        i += 1
    }
    sort.ints(mut &sorted)
    sort.ints(mut &reverse)
    sort.ints(mut &equal)
    sort.ints(mut &duplicate)
    println(check(&sorted))
    println(check(&reverse))
    println(check(&equal))
    println(check(&duplicate))
    << 0
}
