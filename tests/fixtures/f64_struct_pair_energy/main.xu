@main
#math

// Deliberately mix integer metadata with reordered floating-point fields.
struct Sample {
    mass f64
    tag int
    vz f64
    x f64
    vy f64
    y f64
    vx f64
    z f64
}

fn pair_score(sys &[]Sample, count int) f64 {
    mut e := 0.0
    for i in 0:count {
        e += 0.5 * sys[i].mass * (sys[i].vx * sys[i].vx + sys[i].vy * sys[i].vy + sys[i].vz * sys[i].vz)
        mut j := i + 1
        while j < count {
            dx := sys[i].x - sys[j].x
            dy := sys[i].y - sys[j].y
            dz := sys[i].z - sys[j].z
            dist := math.sqrt(dx * dx + dy * dy + dz * dz)
            e -= sys[i].mass * sys[j].mass / dist
            j += 1
        }
    }
    << e
}

fn folded_fields(sys &[]Sample, count int) f64 {
    mut score := 0.0
    for i in 0:count {
        score += sys[i].x * sys[i].x + sys[i].mass
    }
    << score
}

fn translate(samples &mut []Sample, step f64) {
    for i in 0:samples.len {
        samples[i].y += step
    }
}

// The three-slot return keeps this on the ordinary frame fallback.
fn describe_first(samples &[]Sample) string {
    println(int(samples[0].x))
    << "seen"
}

fn main() int {
    mut sys := []Sample{}
    for i in 0:5 {
        sys.push(Sample{x: f64(i), y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: 1.0, tag: i + 17})
    }
    println(pair_score(&sys, 0) == 0.0)
    println(pair_score(&sys, 1) == 0.0)
    println(pair_score(&sys, 2) == -1.0)
    // Kinetic 0, potential -(4 + 3/2 + 2/3 + 1/4) = -77/12.
    // Multiple inner-loop trips exercise the pointer/FP cache boundary.
    e := pair_score(&sys, 5)
    println(e > -6.416667)
    println(e < -6.416666)
    println(folded_fields(&sys, 5) == 35.0)
    translate(mut &sys, 0.5)
    translate(mut &sys, 0.5)
    println(sys[0].y == 1.0)
    println(sys[4].y == 1.0)
    println(describe_first(&sys) == "seen")
    println(sys[4].tag)
    << 0
}
