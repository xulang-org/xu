@main

#encoding/hex
#image/jpeg

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn decode_jpeg_fails(raw &string) bool {
    jpeg.decode(raw) or (err) { << true }
    << false
}

fn main() int {
    gray_hex := ""
    gray_raw := hex.decode_string(gray_hex + "") or (err) { << 1 }
    g := jpeg.decode(&gray_raw) or (err) { << 1 }
    println(g.rect.dx())
    println(g.rect.dy())
    a := g.at_rgba(0, 0)
    println(a.r)
    println(a.g)
    println(a.b)
    println(a.a)
    b := g.at_rgba(7, 7)
    println(b.r)

    c444_hex := ""
    c444_raw := hex.decode_string(c444_hex + "") or (err) { << 1 }
    c := jpeg.decode(&c444_raw) or (err) { << 1 }
    println(c.rect.dx())
    p := c.at_rgba(0, 0)
    println(p.r)
    println(p.g)
    println(p.b)
    println(p.a)

    c420_hex := ""
    c420_raw := hex.decode_string(c420_hex + "") or (err) { << 1 }
    d := jpeg.decode(&c420_raw) or (err) { << 1 }
    q := d.at_rgba(3, 3)
    println(q.r)
    println(q.g)
    println(q.b)

    bad := "notjpeg"
    show_bool(decode_jpeg_fails(&bad))
    << 0
}
