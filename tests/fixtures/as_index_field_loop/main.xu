@main

struct Box {
    pub e temp
    pub n int
}

fn main() int {
    mut n := 0
    for i in 0:10000 {
        mut xs := []Box{}
        xs.push(Box{e: 1, n: 8})
        xs.push(Box{e: 2, n: 9})
        if i % 2 == 0 {
            v := xs[0].e as int
            n += v
            n += xs[0].n
            n += xs[1].n
        } else {
            n += xs[0].n
            n += xs[1].n
        }
    }
    println(n)
    println("ok")
    << 0
}
