@main
struct Wide { a int, b int, c int, d int }
fn append_words(a &mut []int, seed int, salt int, count int) int {
    a.push(seed)
    mut total := 0
    for i in 0:count {
        x := (seed + i * 109) ^ (i << 57)
        a.push(x)
        a.push(x ^ salt)
        p := (i * 3) % a.len
        a[p] += salt + i
        total += a[p] ^ (x >> (i & 63))
    }
    mut check := 0
    for j in 0:a.len { check += a[j] * (j + 1) }
    << total ^ check
}
fn append_floats(seed f64, count int) int {
    mut a := []f64{}
    mut z := seed
    for i in 0:count {
        x := z + f64(i) * 0.125
        a.push(x)
        a.push(x + 0.5)
        z -= 0.25
    }
    mut total := 0
    for j in 0:a.len { total += int(a[j] * 8.0) * (j + 1) }
    << total
}
fn append_wide(seed int, salt int, count int) int {
    mut a := []Wide{}
    for i in 0:count {
        x := seed ^ (i << 53)
        a.push(Wide{a: x, b: x ^ salt, c: x + i, d: seed - i})
    }
    mut total := 0
    for j in 0:a.len { total += (a[j].a ^ a[j].b) + a[j].c - a[j].d }
    << total
}
fn main() int {
    for k in 0:128 {
        seed := (k << 56) ^ (k * 7919 - 12001)
        salt := k * 31 - 197
        count := k % 17 + 1
        mut a := []int{}
        println(append_words(mut &a, seed, salt, count))
        println(a.len)
        println(a[0])
        println(a[a.len - 1])
        println(append_floats(f64(k - 19) * 0.125, k % 19 + 1))
        println(append_wide(seed, salt, count))
    }
    << 0
}
