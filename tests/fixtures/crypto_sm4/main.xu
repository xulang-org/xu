@main

#crypto/sm4
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn new_cipher_fails(key &string) bool {
    sm4.new_cipher(key) or (err) { << true }
    << false
}

fn encrypt_fails(c sm4.Cipher, pt &string) bool {
    c.encrypt(pt) or (err) { << true }
    << false
}

fn main() int {
    keyhex := "0123456789abcdeffedcba9876543210"
    key := hex.decode_string(keyhex) or (err) { << 1 }
    c := sm4.new_cipher(&key) or (err) { << 1 }
    println(c.block_size())
    ct := c.encrypt(&key) or (err) { << 1 }
    got := hex.encode_to_string(ct + "")
    println(got)
    show_bool(got == "681edf34d206965e86b3e94f536e4246")
    back := c.decrypt(&ct) or (err) { << 1 }
    show_bool(back == key)
    bad := "short"
    show_bool(new_cipher_fails(&bad))
    tiny := "x"
    show_bool(encrypt_fails(c, &tiny))
    << 0
}
