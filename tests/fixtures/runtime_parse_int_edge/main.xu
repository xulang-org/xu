@main

#runtime

#errors

fn fails(s string) bool {
    runtime.parse_int(&s) or (err) {
        << true
    }
    << false
}

fn main() int {
    // Same overflow contract as builtin parse_int (str_algo.parse_int).
    // Regression: -810 must NOT be accepted as INT_MIN via acc == lim+1.
    println(fails("-9223372036854775810"))
    println(fails("-9223372036854775809"))
    p1 := "-9223372036854775808"
    println(runtime.parse_int(&p1) or (err) { << 0 })
    p2 := "9223372036854775807"
    println(runtime.parse_int(&p2) or (err) { << 0 })
    println(fails("9223372036854775808"))
    p3 := "00042"
    println(runtime.parse_int(&p3) or (err) { << 0 })
    p4 := "-00042"
    println(runtime.parse_int(&p4) or (err) { << 0 })
    p5 := "-0"
    println(runtime.parse_int(&p5) or (err) { << 0 })
    << 0
}
