@main

// Empty arms still need their terminators emitted. Short blocks in a
// function with many other instructions must stop at their own chain end.
fn probe(x int) int {
    mut total := 0
    for i in 0:6 {
        if x + i > 3 { } else { }
        if i == 1 { }
        if i == 2 { -> }
        if i == 5 { <- }
        if ((x + i) & 1) == 0 {
            total += (i + 1) * (i + 1)
        } else {
            total += 100
        }
    }
    if x < 0 { }
    << total
}

fn main() int {
    println(probe(-2))
    println(probe(0))
    println(probe(1))
    println(probe(4))
    << 0
}
