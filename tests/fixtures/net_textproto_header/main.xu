@main

#net/textproto

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    mut h := textproto.new_header()
    k := "x-foo"
    v1 := "a"
    v2 := "b"
    h.add(&k, &v1)
    h.add(&k, &v2)
    println(h.get(&k))
    vs := h.values(&k)
    println(vs.len)
    println(vs[0])
    println(vs[1])
    v3 := "c"
    h.set(&k, &v3)
    println(h.get(&k))
    println(h.values(&k).len)
    h.del(&k)
    println(h.get(&k).len)
    println(h.values(&k).len)
    sub := "subject"
    hello := "hello"
    h.set(&sub, &hello)
    show_bool(h.get(&sub) == "hello")
    << 0
}
