@main

#errors

fn boom(flag int) int {
    if flag == 0 {
        >> errors.new("boom")
    }
    << 7
}

fn wrap(flag int) int {
    << boom(flag) or >>
}

fn main() int {
    n := wrap(1) or (err) {
        println(err.msg())
        << 1
    }
    println(n)
    wrap(0) or (err) {
        println(err.msg())
        << 0
    }
    << 0
}
