@main

struct Cell {
    pub e temp
    pub x int
}

struct Inner {
    pub cell Cell
    pub n int
}

struct Wrap {
    pub inner Inner
    pub m int
}

fn main() int {
    mut n := 0
    for i in 0:10000 {
        b := Wrap{inner: Inner{cell: Cell{e: 1, x: 8}, n: 7}, m: 9}
        if i % 2 == 0 {
            v := b.inner.cell.e as int
            n += v
            n += b.inner.cell.x
            n += b.inner.n
        } else {
            n += b.inner.cell.x
            n += b.inner.n
        }
    }
    println(n)
    println("ok")
    << 0
}
