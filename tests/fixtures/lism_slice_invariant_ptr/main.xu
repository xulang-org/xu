@main

struct Particle {
    x f64
    y f64
    vx f64
    vy f64
}

fn simulate(pts &mut []Particle, steps int) {
    mut k := 0
    while k < steps {
        pts[0].vx += 1.0
        pts[0].vy += 2.0
        pts[1].vx -= 0.5
        pts[1].vy -= 1.0
        k += 1
    }
}

fn main() int {
    mut pts := []Particle{}
    pts.push(Particle{x: 0.0, y: 0.0, vx: 0.0, vy: 0.0})
    pts.push(Particle{x: 10.0, y: 10.0, vx: 0.0, vy: 0.0})
    simulate(mut &pts, 1000)
    println(int(pts[0].vx))
    println(int(pts[0].vy))
    println(int(pts[1].vx))
    println(int(pts[1].vy))
    << 0
}
