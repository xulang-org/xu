@main
fn main() int {
 mut m := map[int]int{}
 for i in 0:128 { m[i] = i + 1 }
 mut start := 32
 mut total := 0
 for round in 0:32 {
  for j in 0:96 { m.delete(start + j) }
  start = 128 + round * 96
  for j in 0:96 { m[start + j] = j + 1 }
  for j in 0:96 { total += m[start + j] }
  for j in 0:96 { total += m.get_or(0 - start - j - 1, 0) }
 }
 println(total)
 println(m.len())
 << 0
}
