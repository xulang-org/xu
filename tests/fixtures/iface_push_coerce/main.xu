@main

struct@ Shape {
    fn area() int
}

struct Circle {
    r int
}

fn (c Circle) area() int {
    << c.r * c.r
}

struct Rect {
    w int
    h int
}

fn (r Rect) area() int {
    << r.w * r.h
}

fn show(s Shape) {
    println(s.area())
}

fn main() int {
    mut xs := []Shape{}
    xs.push(Circle{r: 3})
    xs.push(Rect{w: 2, h: 4})
    println(xs.len)
    show(Circle{r: 3})
    show(Rect{w: 2, h: 4})
    << 0
}
