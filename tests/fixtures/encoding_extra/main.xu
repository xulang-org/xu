@main

#strconv
#encoding/hex
#encoding/base64
#encoding/binary

fn main() int {
    println(strconv.format_uint(255, 16) or (err) { << 1 })
    u := "255"
    println(strconv.parse_uint(&u, 10) or (err) { << 1 })
    nl := string_from_byte(10)
    hi := "hi" + nl
    q := strconv.quote(&hi)
    println(q)
    println(strconv.unquote(&q) or (err) { << 1 })
    dump := hex.dump("Hello")
    println(dump.len > 0)
    raw := base64.encode_raw("hi")
    println(raw)
    url := base64.encode_url("hi?")
    println(url)
    println(base64.decode_raw(raw) or (err) { << 1 })
    le := binary.little_endian()
    mut buf := [0, 0]
    le.put_i16(mut &buf, 0, 0 - 2) or (err) { << 1 }
    println(le.get_i16(&buf, 0) or (err) { << 1 })
    uv := binary.put_uvarint(300)
    println(binary.uvarint(&uv) or (err) { << 1 })
    println(binary.size_uvarint(300))
    << 0
}
