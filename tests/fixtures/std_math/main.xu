@main

#math

fn main() int {
    println(math.abs(-4.5))
    println(math.min(2.5, 1.5))
    println(math.max(2.5, 1.5))
    println(math.floor(2.75))
    println(math.floor(-2.75))
    println(math.ceil(2.25))
    println(math.ceil(-2.25))
    s := math.sqrt(2.0)
    println(s > 1.4142 && s < 1.4143)
    println(math.sqrt(0.0))
    println(math.pow(2.0, 10))
    println(math.pow(2.0, -2))
    println(math.pow(3.0, 0))
    extra()
    << 0
}
    fn extra() {
    e := math.exp(1.0)
    println(e > 2.71828 && e < 2.71829)
    println(math.exp(0.0))
    l := math.log(2.718281828459045)
    println(l > 0.99999 && l < 1.00001)
    println(math.log(1.0))
    println(math.hypot(3.0, 4.0))
    n := math.log(0.0)
    println(n == n)
}
