@main

#errors

fn read_file(path string) string {
    if path == "" {
        >> errors.new("path cannot be empty")
    }
    << "content from " + path
}

fn process(path string) int {
    content := read_file(path)
    << content.len
}

fn main() int {
    process("input.xu") or (err) {
        << 1
    }
    println("ok")
    process("") or (err) {
        println("err propagated")
        << 0
    }
    << 0
}
