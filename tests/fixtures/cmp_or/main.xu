@main

#cmp

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    println(cmp.or_int(0, 7))
    println(cmp.or_int(3, 7))
    println(cmp.or_int(0, 0))
    a := ""
    b := "xu"
    println(cmp.or_string(&a, &b))
    println(cmp.or_string(&b, &a))
    println(cmp.or_string(&a, &a).len)
    println(cmp.compare_int(1, 2))
    println(cmp.compare_int(2, 1))
    println(cmp.compare_int(2, 2))
    show_bool(cmp.less_int(1, 2))
    show_bool(cmp.less_int(2, 1))
    println(cmp.or_f64(0.0, 1.5))
    println(cmp.or_f64(2.5, 1.5))
    << 0
}
