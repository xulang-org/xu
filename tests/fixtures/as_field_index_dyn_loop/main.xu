@main

struct Hold {
    pub n int
    pub xs []temp
}

fn main() int {
    mut s := 0
    for k in 0:10000 {
        mut h := Hold{n: 8, xs: []temp{}}
        h.xs.push(1)
        h.xs.push(2)
        i := k % 2
        v := h.xs[i] as int
        s += v
        s += h.n
    }
    println(s)
    println("ok")
    << 0
}
