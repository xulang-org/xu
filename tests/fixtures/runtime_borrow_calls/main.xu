@main
#runtime
#errors
struct Box { value string }
fn make() string { << "heap" + "string" }
fn main() int {
    s := make()
    p := "heap"
    println(starts_with(s, p))
    println(runtime.starts_with(&s, &p))
    f := runtime.starts_with
    println(f(&s, &p))
    b := Box{value: make()}
    println(starts_with(b.value, p))
    println(starts_with(make(), "heap"))
    values := [make()]
    println(starts_with(values[0], "heap"))
    n := 42
    println(str(&n))
    println(s.len)
    println(b.value.len)
    println(values[0].len)
    << 0
}
