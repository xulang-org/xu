@main

#hash/crc64

fn main() int {
    empty := ""
    println(crc64.checksum_iso(&empty))
    println(crc64.checksum_ecma(&empty))
    s1 := "Xu"
    println(crc64.checksum_iso(&s1))
    println(crc64.checksum_ecma(&s1))
    hw := "hello world"
    println(crc64.checksum_iso(&hw))
    println(crc64.checksum_ecma(&hw))
    n := "123456789"
    println(crc64.checksum_iso(&n))
    println(crc64.checksum_ecma(&n))
    tab := crc64.make_table(crc64.iso)
    println(crc64.checksum(&s1, &tab))
    a := crc64.update(0, &tab, &s1)
    println(a)
    << 0
}
