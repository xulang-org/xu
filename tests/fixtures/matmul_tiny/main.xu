@main

fn main() int {
    n := 8
    nn := n * n
    mut a := []int{}
    mut b := []int{}
    mut c := []int{}
    mut t := 0
    while t < nn {
        a.push(0)
        b.push(0)
        c.push(0)
        t += 1
    }
    mut i := 0
    while i < n {
        mut j := 0
        while j < n {
            a[i * n + j] = (i * 3 + j) & 15
            b[i * n + j] = (i + j * 5) & 15
            j += 1
        }
        i += 1
    }
    i = 0
    while i < n {
        mut k := 0
        while k < n {
            aik := a[i * n + k]
            mut j := 0
            while j < n {
                c[i * n + j] += aik * b[k * n + j]
                j += 1
            }
            k += 1
        }
        i += 1
    }
    mut s := 0
    t = 0
    while t < nn {
        s += c[t]
        t += 1
    }
    println(s)
    << 0
}
