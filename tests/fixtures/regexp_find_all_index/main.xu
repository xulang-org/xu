@main

#regexp

fn main() int {
    re := regexp.compile("a") or (err) { << 1 }
    s := "aba"
    xs := re.find_all_index(&s, 0 - 1)
    println(xs.len)
    println(xs[0].start)
    println(xs[0].end)
    println(xs[1].start)
    none := re.find_all_index(&s, 0)
    println(none.len)
    one := re.find_all_index(&s, 1)
    println(one.len)
    << 0
}
