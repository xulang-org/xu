@main

#crypto/sm2
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    p8pem := "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqBHM9VAYItBG0wawIBAQQgOUUgj3shRLE/NuOK\nxtOflYiTk2koYLUaQvuB7033xbihRANCAAQJ+d8xHlQhoVDdfRYeS8XGchefrRgz\n/AdrsI/zVvNQIMzqSQziZ3WlLcbqcYzBqmAK7QX7814ISmYy9gctqa0T\n-----END PRIVATE KEY-----\n"
    d := sm2.parse_private_pem(&p8pem) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(d + ""))
    pubk := sm2.public(&d) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(pubk + ""))

    sec1 := hex.decode_string("307702010104203945208f7b2144b13f36e38ac6d39f95889393692860b51a42fb81ef4df7c5b8a00a06082a811ccf5501822da1440342000409f9df311e5421a150dd7d161e4bc5c672179fad1833fc076bb08ff356f35020ccea490ce26775a52dc6ea718cc1aa600aed05fbf35e084a6632f6072da9ad13") or (err) {
        << 1
    }
    d2 := sm2.parse_private_key(&sec1) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(d2 + ""))

    out := sm2.marshal_pkcs8(&d) or (err) {
        println(err.msg())
        << 1
    }
    d3 := sm2.parse_private_key(&out) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(d3 + ""))

    pem2 := sm2.marshal_pkcs8_pem(&d) or (err) {
        println(err.msg())
        << 1
    }
    d4 := sm2.parse_private_pem(&pem2) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(d4 + ""))

    hi := "hi"
    gs := sm2.sign_asn1(&d, &hi) or (err) {
        println(err.msg())
        << 1
    }
    show_bool(sm2.verify_asn1(&pubk, &hi, &gs))
    << 0
}
