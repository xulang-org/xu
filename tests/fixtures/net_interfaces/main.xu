@main

#net
#os
#strings

fn has_addr(addrs []string, want string) bool {
    for i in 0:addrs.len {
        if addrs[i] == want {
            << true
        }
    }
    << false
}

// Linux keeps IPv6 addresses in procfs. When that optional procfs is present,
// the public interface API must expose the loopback address with its prefix.
// A kernel with IPv6 disabled is still a valid environment, so that case is
// intentionally skipped rather than treated as a platform failure.
fn linux_ipv6_contract() bool {
    if xu_target_os() != 1 {
        << true
    }
    raw := os.read("/proc/net/if_inet6") or (err) {
        << true
    }
    if raw.len == 0 || !strings.contains(&raw, "00000000000000000000000000000001") {
        << true
    }
    all := net.interface_addrs() or (err) {
        << false
    }
    << has_addr(all, "::1/128")
}

fn interface_contract() bool {
    mut ok := true
    if xu_target_os() != 1 {
        raw := os.interface_data("") or (err) { << false }
        if raw.len == 0 {
            ok = false
        }
    }
    ifs := net.interfaces() or (err) { << false }
    if ifs.len == 0 {
        ok = false
    }
    if ifs.len > 0 {
        first := net.Interface{
            index: ifs[0].index,
            mtu: ifs[0].mtu,
            name: ifs[0].name + "",
            hardware_addr: ifs[0].hardware_addr + "",
            flags: ifs[0].flags
        }
        if first.name.len == 0 || first.index <= 0 || first.mtu < 0 || first.hardware_addr.len > 20 {
            ok = false
        }
        first.addrs() or (err) { << false }
        by_name := net.interface_by_name(first.name + "") or (err) { << false }
        if by_name.index != first.index || by_name.name != first.name {
            ok = false
        }
        by_index := net.interface_by_index(first.index) or (err) { << false }
        if by_index.index != first.index || by_index.name != first.name {
            ok = false
        }
    }
    net.interface_addrs() or (err) { << false }
    if !linux_ipv6_contract() {
        ok = false
    }
    << ok
}

fn main() int {
    ok := interface_contract()
    println(ok)
    if ok {
        << 0
    }
    << 1
}
