@main

struct Point {
    x int
    y int
}

fn main() int {
    mut m := map[int]Point{}
    m[1] = Point{x: 3, y: 4}
    m[2] = Point{x: 5, y: 6}
    p := m[1]
    println(p.x)
    println(p.y)
    m[1] = Point{x: 7, y: 8}
    p2 := m[1]
    println(p2.x)
    println(p2.y)
    t := m.take(2)
    println(t.x)
    println(t.y)
    println(m.len())
    << 0
}
