@main

fn main() int {
    mut m := map[int]int{}
    m[1] = 10
    m[2] = 20
    m[3] = 30
    mut n := 0
    mut s := 0
    mut seen := 0
    for k, v in m {
        n = n + 1
        s = s + v
        if k == 1 {
            seen = seen + 1
        }
        if k == 2 {
            seen = seen + 2
        }
        if k == 3 {
            seen = seen + 4
        }
    }
    println(n)
    println(s)
    println(seen)
    m[4] = 40
    println(m.len())

    mut ms := map[string]int{}
    ms["a"] = 1
    ms["b"] = 2
    mut ss := 0
    mut sa := 0
    mut sb := 0
    for k, v in ms {
        ss = ss + v
        if k == "a" {
            sa = 1
        }
        if k == "b" {
            sb = 1
        }
    }
    println(ss)
    println(sa + sb)
    << 0
}
