@main

#context
#time

fn main() int {
    done := chan int{cap: 1}
    println(sys_wait_cancel(done, 0))
    done <- 7
    println(sys_wait_cancel(done, 0))
    // Observation does not consume cancellation tokens.
    println(<-done)
    close(done)
    println(sys_wait_cancel(done, 10000000000))
    mut timeout := context.with_timeout(10000000000)
    timeout.cancel()
    mut t := time.new_timer(10000000000)
    t.stop()
    t.stop()
    mut ticker := time.new_ticker(10000000000)
    ticker.stop()
    ticker.stop()
    sleep_ns(50000000)
    select {
        x := <-t.c { _ := x
            << 1 }
        else { println("timer stopped") }
    }
    select {
        x := <-ticker.c { _ := x
            << 2 }
        else { println("ticker stopped") }
    }
    println("done")
    << 0
}
