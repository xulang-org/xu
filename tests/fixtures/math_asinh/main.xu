@main

#math

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    show_bool(math.asinh(0.0) == 0.0)
    show_bool(math.acosh(1.0) == 0.0)
    show_bool(math.atanh(0.0) == 0.0)
    a := math.asinh(1.0)
    show_bool(a > 0.88 && a < 0.89)
    show_bool(math.asinh(0.0 - 1.0) == 0.0 - a)
    c := math.acosh(2.0)
    show_bool(c > 1.3 && c < 1.4)
    t := math.atanh(0.5)
    show_bool(t > 0.54 && t < 0.56)
    show_bool(math.is_nan(math.acosh(0.0)))
    << 0
}
