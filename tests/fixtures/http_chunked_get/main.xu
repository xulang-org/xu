@main

#net
#net/http

fn serve_chunked(lfd int) {
    cfd := net.accept(lfd) or (err) { << }
    junk := net.conn_read(cfd, 4096) or (err) { << }
    println(junk.len >= 0)
    resp := "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n3\r\nhel\r\n2\r\nlo\r\n0\r\n\r\n"
    w := net.conn_write(cfd, &resp) or (err) { << }
    println(w > 0)
    c := net.conn_close(cfd) or (err) { << }
    println(c == 0)
}

fn main() int {
    lfd := net.listen("127.0.0.1:19882") or (err) { << 1 }
    xu serve_chunked(lfd)
    mut r := http.new_response()
    r.get("http://127.0.0.1:19882/x") or (err) { << 1 }
    println(true)
    println(r.status_code())
    println(r.body())
    net.conn_close(lfd) or (err) { << 1 }
    << 0
}
