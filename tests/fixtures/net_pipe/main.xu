@main

#net

fn main() int {
    p := net.pipe()
    n := p.c1.write("hello") or (err) { << 1 }
    println(n)
    s := p.c2.read() or (err) { << 1 }
    println(s)
    n2 := p.c2.write("back") or (err) { << 1 }
    println(n2)
    s2 := p.c1.read() or (err) { << 1 }
    println(s2)
    println(p.c1.network())
    << 0
}
