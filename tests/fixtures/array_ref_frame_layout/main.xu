@main
#math
struct Record { tag int, p f64, q f64, r f64, s f64, t f64, u f64, v f64 }
fn summarize(data &[]Record) f64 {
    mut total := 0.0
    for i in 0:data.len {
        total += data[i].p + data[i].q * 2.0 + data[i].r - data[i].s + data[i].t * 0.5 + data[i].u - data[i].v + f64(data[i].tag)
    }
    << total
}
fn mutate(data &mut []Record, lo int, end int, bias f64) f64 {
    mut total := 0.0
    for i in lo:end {
        a := data[i].p
        b := data[i].q
        c := data[i].r
        d := data[i].s
        e := data[i].t
        root := math.sqrt(4.0)
        data[i].p = a + b - bias
        data[i].q = c * 0.5
        data[i].r += d * root
        data[i].s -= e * 0.25
        data[i].t = a - c + bias
        data[i].u += a + b + c + d + e
        total += a + b - c + d + e + root
    }
    << total
}
fn aliases(left &mut []Record, right &[]Record) f64 {
    mut total := 0.0
    for i in 0:6 {
        left[i].p += right[i].q
        total += right[i].p - right[i].r
    }
    << total
}
