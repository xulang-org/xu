fn main() int {
    for seed in -16:16 {
        mut values := []Record{}
        for j in 0:6 {
            values.push(Record{tag: seed + j, p: f64(seed + j) * 0.25, q: f64(seed - j) * 0.5, r: f64(j + 1), s: f64(seed * 2 + j) * 0.125, t: f64(seed + j * 3) * 0.25, u: f64(j - seed) * 0.5, v: f64(seed - j * 2) * 0.25})
        }
        println(int(summarize(&values) * 32.0))
        println(int(mutate(mut &values, (seed + 16) % 8, 6, f64(seed) * 0.125) * 32.0))
        println(int(summarize(&values) * 32.0))
        println(int(mutate(mut &values, 6, 6, 0.5) * 32.0))
        println(int(summarize(&values) * 32.0))
        println(int(aliases(mut &values, &values) * 32.0))
        println(int(summarize(&values) * 32.0))
    }
    mut grown := []Record{}
    grown.push(Record{tag: 0, p: 3.0, q: 0.0, r: 0.0, s: 0.0, t: 0.0, u: 0.0, v: 0.0})
    growth(mut &grown)
    println(int(grown[0].p))
    << 0
}
