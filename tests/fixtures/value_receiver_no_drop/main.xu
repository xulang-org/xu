@main
struct Bag {
    items []int
}

// a value (non-mut) receiver of an owning struct is a read-only borrow:
// calling it must not free the caller's heap buffers (M6b2-s2 regression:
// the shallow receiver copy was dropped at callee scope end).
fn (b Bag) total() int {
    mut t := 0
    for i in 0:b.items.len {
        t += b.items[i]
    }
    << t
}

fn (b &mut Bag) add(v int) { b.items.push(v) }

fn main() int {
    mut b := Bag{items: []int{}}
    for i in 0:10 {
        b.add(i * 2)
    }
    println(b.total())
    // The array must survive the value-receiver call intact.
    println(b.items.len)
    println(b.items[9])
    println(b.total())
    << 0
}
