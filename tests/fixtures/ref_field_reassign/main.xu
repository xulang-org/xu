@main

// M151: rebind a reference field; old pointee is no longer used via the field.

struct Holder {
    r &mut string
}

fn main() {
    mut first := "a" + "b"
    mut second := "c" + "d"
    mut h := Holder{r: mut &first}
    h.r = mut &second
    h.r.push_str("x")
    println(second)
    first = "z"
    println(first)
}
