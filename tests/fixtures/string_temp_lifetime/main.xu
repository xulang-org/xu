@main

// Focused ownership probe for Gen1: values returned by str(int) are fresh
// strings.  They must be reclaimed when discarded, while the concat result
// moved into an array remains owned by that array.
fn main() int {
    mut xs := []string{}
    for i in 0:64 {
        str(i)
        ("prefix " + str(i))
        xs.push("item " + str(i))
    }
    println(xs.len)
    << 0
}
