@main

#regexp

fn show_parts(parts []string) {
    println(parts.len)
    for i in 0:parts.len {
        println(parts[i])
    }
}

fn main() int {
    re := regexp.compile("(\\w+)@(\\w+)\\.(\\w+)") or (err) { << 1 }
    println(re.num_subexp())
    t1 := "mail user@example.com end"
    show_parts(re.find_submatch(&t1))

    re2 := regexp.compile("a(b|c)d") or (err) { << 1 }
    t2 := "xxacdyy"
    show_parts(re2.find_submatch(&t2))

    re3 := regexp.compile("(a)?b") or (err) { << 1 }
    t3 := "b"
    show_parts(re3.find_submatch(&t3))
    t4 := "ab"
    show_parts(re3.find_submatch(&t4))

    re4 := regexp.compile("nope") or (err) { << 1 }
    empty := re4.find_submatch(&t1)
    println(empty.len)

    nested := regexp.compile("((a)(b))") or (err) { << 1 }
    println(nested.num_subexp())
    t5 := "ab"
    show_parts(nested.find_submatch(&t5))
    << 0
}
