@main

struct Counter { visits int }

fn visit(c &mut Counter, result bool) bool {
    c.visits += 1
    << result
}

fn decide(balance int, key int, limit int) int {
    if balance > 1 && key < limit { << 1 }
    if balance < -1 && key > limit { << 2 }
    if balance > 1 && key > limit { << 3 }
    if balance < -1 && key < limit { << 4 }
    << 0
}

fn conjunction(a bool, b bool) bool { << a && b }
fn disjunction(a bool, b bool) bool { << a || b }

fn main() int {
    for balance in -2:3 {
        println(decide(balance, 5, 10))
        println(decide(balance, 15, 10))
    }
    println(conjunction(false, false))
    println(conjunction(false, true))
    println(conjunction(true, false))
    println(conjunction(true, true))
    println(disjunction(false, false))
    println(disjunction(false, true))
    println(disjunction(true, false))
    println(disjunction(true, true))
    mut counter := Counter{visits: 0}
    for value in 0:2 {
        if value > 0 && visit(mut &counter, true) { println(10) }
        if value == 0 || visit(mut &counter, false) { println(20) }
    }
    println(counter.visits)
    << 0
}
