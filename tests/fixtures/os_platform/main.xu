@main

#os
#path/filepath

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    t := xu_target_os()
    sep := os.path_list_separator()
    if t == 2 {
        show_bool(sep == 59)
    } else {
        show_bool(sep == 58)
    }
    show_bool(filepath.list_separator() == sep)
    d := os.dev_null()
    if t == 2 {
        show_bool(d == "NUL")
    } else {
        show_bool(d == "/dev/null")
    }
    ps := os.path_separator()
    show_bool(ps == 47 || ps == 92)
    if t == 2 {
        show_bool(os.is_path_separator(92))
    } else {
        show_bool(!os.is_path_separator(92))
    }
    << 0
}
