@main

#crypto/x509
#encoding/pem
#time

fn verify_fails(c &x509.Certificate, opts x509.VerifyOptions) bool {
    c.verify(opts) or (err) {
        << true
    }
    << false
}

fn root_pool(root_pem &string) x509.CertPool {
    mut roots := x509.new_cert_pool()
    x509.append_certificates(mut &roots, root_pem)
    << roots
}

fn intermediate_pool(intermediate_pem &string) x509.CertPool {
    mut intermediates := x509.new_cert_pool()
    x509.append_certificates(mut &intermediates, intermediate_pem)
    << intermediates
}

fn main() int {
    root_pem := "-----BEGIN CERTIFICATE-----\nMIICBDCCAW2gAwIBAgIULc5sBBUiP4RtVhZb6fFcI2dfph4wDQYJKoZIhvcNAQEL\nBQAwFDESMBAGA1UEAwwJbG9jYWxob3N0MB4XDTI2MDgzMDA3MjcwNFoXDTM2MDgy\nNzA3MjcwNFowFDESMBAGA1UEAwwJbG9jYWxob3N0MIGfMA0GCSqGSIb3DQEBAQUA\nA4GNADCBiQKBgQCrzZFyC/82IYhF/Qx45uiRd50lY0sniTgrjRPHc2hWgsSj6aeh\nNQ9EoUKlPYrmr6UWQ6U8XI9u7TBHPYuW/n2484TG0O/aq6sjIfd2PLEsIj0owA4L\nmXSAgq6ftxF7NFyb6sAdAOyKOs0opo6XFA1pqIuImL+9ixIk82S5cz3pFwIDAQAB\no1MwUTAdBgNVHQ4EFgQUo9YjCh31bUTx81b7XorVvSkJxPEwHwYDVR0jBBgwFoAU\no9YjCh31bUTx81b7XorVvSkJxPEwDwYDVR0TAQH/BAUwAwEB/zANBgkqhkiG9w0B\nAQsFAAOBgQAi8SgBwtw0Tfz61XWvS5L5PxknJ4QtJYNIXjKqZyLe71ciaV2jhhIV\nLumV+fmrXxvjN9py61PziiY3abTw5N8Ij4AoXGtpbrY/lmL2rhWizqn+gCKWrj2w\nYt5qH+HwMruHfsPEvcpQwYg+oeAnSGYeYKgQ+G/045mEzc1Wcvbf3Q==\n-----END CERTIFICATE-----\n"
    intermediate_pem := "-----BEGIN CERTIFICATE-----\nMIIB6TCCAVKgAwIBAgIBKTANBgkqhkiG9w0BAQsFADAUMRIwEAYDVQQDDAlsb2Nh\nbGhvc3QwHhcNMjYwODMwMjEzOTQ5WhcNMzYwODI3MjEzOTQ5WjAdMRswGQYDVQQD\nDBJYdS1JbnRlcm1lZGlhdGUtQ0EwgZ8wDQYJKoZIhvcNAQEBBQADgY0AMIGJAoGB\nAKvNkXIL/zYhiEX9DHjm6JF3nSVjSyeJOCuNE8dzaFaCxKPpp6E1D0ShQqU9iuav\npRZDpTxcj27tMEc9i5b+fbjzhMbQ79qrqyMh93Y8sSwiPSjADguZdICCrp+3EXs0\nXJvqwB0A7Io6zSimjpcUDWmoi4iYv72LEiTzZLlzPekXAgMBAAGjQjBAMA8GA1Ud\nEwEB/wQFMAMBAf8wDgYDVR0PAQH/BAQDAgEGMB0GA1UdDgQWBBSj1iMKHfVtRPHz\nVvteitW9KQnE8TANBgkqhkiG9w0BAQsFAAOBgQBQeiEirRX9HsNTQVchpAi8vQpr\nHJPAQ4VqMj2NQEGfG7YE8QVgq/r2CDYWhifZt6CiLSispU8X46wXzNN4A4C0YwMh\nRtzZqKh801Z0rw6cHgXTVnMdSH4a7TOPd5dRWkgZy6TB4P/gucXXT0FOUFbmRfls\npZjouJqebM7wVyd/qQ==\n-----END CERTIFICATE-----\n"
    leaf_pem := "-----BEGIN CERTIFICATE-----\nMIIB8jCCAVugAwIBAgIBKjANBgkqhkiG9w0BAQsFADAdMRswGQYDVQQDDBJYdS1J\nbnRlcm1lZGlhdGUtQ0EwHhcNMjYwODMwMjEzOTQ5WhcNMzYwODI3MjEzOTQ5WjAX\nMRUwEwYDVQQDDAxsZWFmLmV4YW1wbGUwgZ8wDQYJKoZIhvcNAQEBBQADgY0AMIGJ\nAoGBAKvNkXIL/zYhiEX9DHjm6JF3nSVjSyeJOCuNE8dzaFaCxKPpp6E1D0ShQqU9\niuavpRZDpTxcj27tMEc9i5b+fbjzhMbQ79qrqyMh93Y8sSwiPSjADguZdICCrp+3\nEXs0XJvqwB0A7Io6zSimjpcUDWmoi4iYv72LEiTzZLlzPekXAgMBAAGjSDBGMBcG\nA1UdEQQQMA6CDGxlYWYuZXhhbXBsZTAMBgNVHRMBAf8EAjAAMB0GA1UdDgQWBBSj\n1iMKHfVtRPHzVvteitW9KQnE8TANBgkqhkiG9w0BAQsFAAOBgQAUaDC1DkFmCw1o\nDK0a1P8y1f2pAVtylybxEFMN9eVwH2puCbaqDHaRXT9OkK1WrLeDuOGGzheheaAJ\na4CgfzUnFfZW964wcdSniatOhnQo/tY0987L3PBEdMy0FAd81xSkvyTinpCQyS0V\nJqpKIZMjQGHnU8evwnCoI9aRRihA+A==\n-----END CERTIFICATE-----\n"

    block := pem.decode(&leaf_pem)
    leaf := x509.parse_certificate(block.bytes) or (err) {
        println(err.msg())
        << 1
    }
    now := leaf.not_before.add(time.hour())

    roots := root_pool(&root_pem)
    intermediates := intermediate_pool(&intermediate_pem)
    opts := x509.VerifyOptions{dns_name: "leaf.example", current_time: now, roots: roots, intermediates: intermediates, key_usages: []int{}, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    leaf.verify(opts) or (err) {
        println(err.msg())
        << 1
    }
    println("chain_ok")

    opts_missing := x509.VerifyOptions{dns_name: "leaf.example", current_time: now, roots: root_pool(&root_pem), intermediates: x509.new_cert_pool(), key_usages: []int{}, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    println(verify_fails(&leaf, opts_missing))

    mut not_ca := intermediate_pool(&intermediate_pem)
    not_ca.certs[0].is_ca = false
    opts_not_ca := x509.VerifyOptions{dns_name: "leaf.example", current_time: now, roots: root_pool(&root_pem), intermediates: not_ca, key_usages: []int{}, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    println(verify_fails(&leaf, opts_not_ca))

    opts_name := x509.VerifyOptions{dns_name: "wrong.example", current_time: now, roots: root_pool(&root_pem), intermediates: intermediate_pool(&intermediate_pem), key_usages: []int{}, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    println(verify_fails(&leaf, opts_name))

    expired := leaf.not_after.add(time.hour())
    opts_expired := x509.VerifyOptions{dns_name: "leaf.example", current_time: expired, roots: root_pool(&root_pem), intermediates: intermediate_pool(&intermediate_pem), key_usages: []int{}, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    println(verify_fails(&leaf, opts_expired))
    << 0
}
