@main

#os/user

fn main() int {
    u := user.current()
    if u.uid.len == 0 {
        << 1
    }
    if u.gid.len == 0 {
        << 1
    }
    println("uid")
    if u.username.len == 0 {
        println(true)
    } else {
        v := user.lookup(u.username + "") or (err) {
            << 1
        }
        println(v.uid == u.uid)
    }
    user.lookup("xu-no-such-user") or (err) {
        println("miss")
        << 0
    }
    << 1
}
