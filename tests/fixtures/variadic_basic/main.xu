@main

// m37 language variadics: `<-> T` is sugar for an owning `[]T` parameter.
// Covers zero/one/many arguments (arity + element sum), body for-iteration,
// a generic variadic, a method variadic, and mixed fixed+variadic params.

fn count_ints(xs <-> int) int {
    << xs.len
}

fn sum_ints(xs <-> int) int {
    mut t := 0
    for x in xs {
        t = t + x
    }
    << t
}

// Owning (string) elements also iterate; each element clones out of the pack.
fn concat(xs <-> string) string {
    mut out := ""
    for x in xs {
        out = out + x
    }
    << out
}

// Generic variadic: element type is a parameter. a true element-wise combine
// would need a binary method constraint (Xu interfaces have no `Self`), so
// the parametrized body returns the packed arity; the int and string
// instances below demonstrate type substitution at the call site.
fn sum#T(xs <-> T) int {
    << xs.len
}

// Variadic mixed with a fixed leading parameter.
fn mixed(prefix string, xs <-> int) int {
    mut t := prefix.len
    for x in xs {
        t = t + x
    }
    << t
}

struct Acc {
    base int
}

// Method variadic (value receiver).
fn (a Acc) total(xs <-> int) int {
    mut t := a.base
    for x in xs {
        t = t + x
    }
    << t
}

fn main() int {
    // zero / one / many arguments: arity + element sum.
    println(count_ints())
    println(sum_ints())
    println(count_ints(7))
    println(sum_ints(7))
    println(count_ints(1, 2, 3, 4, 5))
    println(sum_ints(1, 2, 3, 4, 5))
    // body for-iteration over owning string elements.
    println(concat())
    println(concat("a"))
    println(concat("a", "b", "c"))
    // generic variadic: int and string instances.
    println(sum(1, 2, 3))
    println(sum("x", "y", "z", "w"))
    // method variadic.
    a := Acc{base: 100}
    println(a.total(1, 2, 3))
    // mixed fixed + variadic.
    println(mixed("abcd", 1, 2))
    println(mixed("", 5, 6, 7))
    << 0
}
