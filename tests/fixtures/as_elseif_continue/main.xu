@main

fn main() int {
    let e: temp = 1
    if false {
        println("a")
    } else if true {
        v := e as int
        println(v)
    } else {
        println("no")
    }
    let f: temp = 2
    if false {
        println("b")
    } else if false {
        w := f as int
        println(w)
    } else {
        println("no")
    }
    let g: temp = 3
    if g is int {
        x := g as int
        println(x)
    } else if false {
        println("c")
    } else {
        println("no")
    }
    let h: temp = 4
    if false {
        a := h as int
        println(a)
    } else if true {
        b := h as int
        println(b)
    } else {
        c := h as int
        println(c)
    }
    << 0
}
