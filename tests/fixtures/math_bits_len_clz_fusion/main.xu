@main
#math/bits

fn combined(x int, y int, n int) int {
    mut a := x
    mut b := y
    mut s := 0
    mut i := 0
    while i < n {
        s += bits.len(a)
        s += bits.leading_zeros(a)
        s += bits.leading_zeros(b)
        s += bits.len(b)
        // Different inputs can occupy the same register at disjoint times.
        s += bits.len(a) + bits.leading_zeros(b)
        width := bits.len(a)
        leading := bits.leading_zeros(a)
        s += width + leading
        // The first result remains live; eliminating it would be incorrect.
        s = s ^ width
        held := bits.len(b)
        s += bits.leading_zeros(b)
        if (i & 1) == 0 {
            s += held
        } else {
            s = s ^ held
        }
        a = bits.rotate_left(a ^ i, 9)
        b = bits.reverse_bytes(b + i)
        i += 1
    }
    << s ^ a ^ b
}

fn main() int {
    for n in 0:12 {
        println(combined(0, -1, n))
        println(combined(1, 0x0123456789abcdef, n))
        println(combined(-9223372036854775807 - 1, 7, n))
    }
    << 0
}
