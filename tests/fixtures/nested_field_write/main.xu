@main

struct Inner {
    v int
    s string
}

struct Mid {
    inner Inner
}

struct P {
    m Mid
}

fn (p &mut P) bump() {
    p.m.inner.v += 2
}

fn main() int {
    mut p := P{m: Mid{inner: Inner{v: 1, s: "a"}}}
    p.m.inner.v = 7
    p.bump()
    p.m.inner.s = "z"
    println(p.m.inner.v)
    println(p.m.inner.s)
    << 0
}
