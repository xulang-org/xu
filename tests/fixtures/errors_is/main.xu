@main

#errors

fn yn(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn inner() errors.Error {
    << errors.Error(errors.new("inner"))
}

fn other() errors.Error {
    << errors.Error(errors.new("other"))
}

fn main() int {
    yn(errors.is_err(inner(), inner()))
    w := errors.wrap("outer", inner())
    yn(errors.is_err(errors.Error(w), inner()))
    a := errors.Error(errors.wrap("outer", inner()))
    b := errors.Error(errors.wrap("outer", inner()))
    yn(errors.is_err(a, b))
    c := errors.Error(errors.wrap("outer", inner()))
    yn(errors.is_err(c, other()))
    mid := errors.wrap("mid", errors.Error(errors.wrap("outer", inner())))
    yn(errors.is_err(errors.Error(mid), inner()))
    mid2 := errors.wrap("mid", errors.Error(errors.wrap("outer", inner())))
    yn(errors.is_err(errors.Error(mid2), other()))
    << 0
}
