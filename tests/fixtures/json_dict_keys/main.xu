@main

#encoding/json

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn has_key(ks &[]string, want string) bool {
    mut i := 0
    while i < ks.len {
        if ks[i] == want {
            << true
        }
        i = i + 1
    }
    << false
}

fn main() int {
    src := "{\"a\":1,\"b\":2}"
    d := json.parse(&src)
    r := d.root()
    ks := d.dict_keys(r)
    println(ks.len)
    show_bool(has_key(&ks, "a"))
    show_bool(has_key(&ks, "b"))
    show_bool(has_key(&ks, "z"))
    << 0
}
