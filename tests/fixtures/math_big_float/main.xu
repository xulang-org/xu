@main

#math/big

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    mut a := big.new_float()
    a.set_int64(2)
    mut b := big.new_float()
    b.set_int64(3)
    mut z := big.new_float()
    z.add(&a, &b)
    println(z.text())
    z.mul(&a, &b)
    println(z.text())
    mut s := big.new_float()
    s.set_int64(7)
    z.sub(&s, &b)
    println(z.text())
    mut one := big.new_float()
    one.set_int64(1)
    z.quo(&one, &a) or (err) { << 1 }
    println(z.text())
    mut eight := big.new_float()
    eight.set_int64(8)
    z.quo(&one, &eight) or (err) { << 1 }
    println(z.text())
    mut ten := big.new_float()
    ten.set_int64(10)
    mut four := big.new_float()
    four.set_int64(4)
    z.quo(&ten, &four) or (err) { << 1 }
    println(z.text())
    mut neg := big.new_float()
    neg.set_int64(0 - 5)
    println(neg.sign())
    println(neg.text())
    println(a.cmp(&b) or (err) { << 1 })
    mut zero := big.new_float()
    println(zero.sign())
    println(zero.text())
    mut zed := big.new_float()
    z.quo(&one, &zed) or (err) { << 1 }
    println(z.text())
    show_bool(z.is_inf())
    mut pinf := big.new_float()
    pinf.set_inf(false)
    mut ninf := big.new_float()
    ninf.set_inf(true)
    mut nanv := big.new_float()
    nanv.add(&pinf, &ninf)
    println(nanv.text())
    show_bool(nanv.is_nan())
    println(a.precision())
    mut parsed := big.new_float()
    parsed.set_string("1.25") or (err) {
        println(err.msg())
        << 1
    }
    println(parsed.text())
    parsed.set_float64(2.5) or (err) { << 1 }
    println(parsed.text())
    println(parsed.to_int64() or (err) { << 1 })
    show_bool(neg.signbit())
    mut nten := big.new_int(10)
    mut fromi := big.new_float()
    fromi.set_int(&nten)
    println(fromi.text())
    println(eight.unbiased_exp())
    man := eight.mantissa()
    println(man.text())
    mut rz := big.new_float()
    rz.set_prec(3)
    rz.set_mode(big.to_zero)
    rz.set_int64(11)
    println(rz.text())
    rz.set_mode(big.away_from_zero)
    rz.set_int64(11)
    println(rz.text())
    rz.set_mode(big.to_pos_inf)
    rz.set_int64(11)
    println(rz.text())
    rz.set_mode(big.to_neg_inf)
    rz.set_int64(11)
    println(rz.text())
    rz.set_mode(big.to_neg_inf)
    rz.set_int64(0 - 11)
    println(rz.text())
    rz.set_mode(big.to_pos_inf)
    rz.set_int64(0 - 11)
    println(rz.text())
    << 0
}
