@main

#encoding/xml

fn main() int {
    src := "<root><a>1</a><b>2</b></root>"
    mut d := xml.new_decoder(&src)
    t0 := d.token() or (err) { << 1 }
    println(t0.name)
    t1 := d.token() or (err) { << 1 }
    println(t1.name)
    d.skip() or (err) { << 1 }
    t2 := d.token() or (err) { << 1 }
    println(t2.name)
    << 0
}
