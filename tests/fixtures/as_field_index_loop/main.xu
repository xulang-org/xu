@main

struct Hold {
    pub n int
    pub xs []temp
}

fn main() int {
    mut s := 0
    for i in 0:10000 {
        mut h := Hold{xs: []temp{}, n: 8}
        h.xs.push(1)
        h.xs.push(2)
        if i % 2 == 0 {
            v := h.xs[0] as int
            s += v
            s += h.n
            w := h.xs[1] as int
            s += w
        } else {
            s += 1
        }
    }
    println(s)
    println("ok")
    << 0
}
