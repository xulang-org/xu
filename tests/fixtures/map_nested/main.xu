@main

fn main() int {
    mut m := map[int]map[string]int{}
    mut inner := map[string]int{}
    inner["a"] = 3
    inner["b"] = 4
    m[1] = inner
    t := m.take(1)
    println(t.has("a"))
    println(t["a"])
    println(t["b"])
    println(m.has(1))
    mut inner2 := map[string]int{}
    inner2["z"] = 9
    m[2] = inner2
    t2 := m.take(2)
    println(t2["z"])
    println(m.len())
    << 0
}
