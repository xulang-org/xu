@main
struct Item { n int
 s string }
fn main() int {
 mut m := map[int]Item{}
 for i in 0:32 { m[i] = Item{n: i + 1, s: "v" + str(i)} }
 mut start := 12
 mut total := 0
 for round in 0:8 {
  for j in 0:20 { m.delete(start + j) }
  start = 32 + round * 20
  for j in 0:20 { m[start + j] = Item{n: j + 1, s: "v" + str(j)} }
  m[0] = Item{n: 900, s: "replacement" + str(round)}
  for j in 0:20 {
   idx := start + j
   r := &m[idx]
   total += r.n + r.s.len
  }
 }
 t := m.take(start)
 m.delete(0 - 1)
 println(total)
 println(t.n)
 println(t.s.len)
 println(m.len())
 << 0
}
