@main
#bufio
#io
#encoding/hex

fn runes(data string, size int) int {
    mut r := bufio.new_stream_reader_size(io.cursor(data), size)
    while true {
        ch := r.read_rune() or (err) { <- }
        println(ch.ch)
        println(ch.size)
        r.unread_rune() or (err) { << 1 }
        again := r.read_rune() or (err) { << 2 }
        println(again.ch == ch.ch && again.size == ch.size)
    }
    r.unread_rune() or (err) { << 0 }
    << 3
}

fn peek_unread() bool {
    mut r := bufio.new_stream_reader(io.cursor("A"))
    r.read_byte() or (err) { << false }
    r.peek(0) or (err) { << false }
    r.unread_byte() or (err) { << true }
    << false
}

fn negative_peek() bool {
    mut r := bufio.new_stream_reader(io.cursor("A"))
    r.peek(0 - 1) or (err) { << true }
    << false
}

fn empty_eof(r &mut bufio.BufferedReader#io.Cursor) bool {
    r.read_byte() or (err) { << err.msg() == "EOF" }
    << false
}

fn buffer_bytes(w &mut bufio.BufferedWriter#io.Buffer) string {
    d := mut &w.dst
    << d.bytes()
}

fn main() int {
    vectors := ["", "41", "c2a2", "e4b8ad", "f09f9880", "41c2a2e4b8adf09f988000", "efbfbd", "80", "c0af", "c1bf", "f5808080", "ff", "e08080", "eda080", "f4908080", "e24180", "e282", "f09f92"]
    sizes := [1, 2, 3, 4, 16, 4096]
    for size in sizes {
        for value in vectors {
            println(value)
            println(size)
            data := hex.decode_string(value) or (err) { << 1 }
            if runes(data, size) != 0 { << 2 }
        }
    }
    mut empty := bufio.new_stream_reader(io.cursor(""))
    println((empty.peek(0) or (err) { << 3 }).len)
    if empty_eof(mut &empty) { println("EOF") } else { << 13 }
    println((empty.peek(0) or (err) { << 4 }).len)
    println(peek_unread())
    println(negative_peek())
    lines := ["a\r", "\r", "a\r\n", "a\n", "\r\n", "a\r\r", "\n"]
    for line in lines {
        mut r := bufio.new_stream_reader(io.cursor(line))
        println(hex.encode_to_string(r.read_line() or (err) { << 5 }))
    }
    // Compact a partially consumed buffer before filling its free capacity.
    mut r := bufio.new_stream_reader_size(io.cursor("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"), 16)
    r.peek(15) or (err) { << 6 }
    r.discard(13) or (err) { << 7 }
    println(r.read_slice(10) or (err) { << 8 })
    println(r.read_string(10) or (err) { << 9 })
    // Writer acceptance counts match io.Writer, across multiple auto-flushes.
    mut w := bufio.new_stream_writer_size(io.buffer(), 4)
    println(w.write_string("ab") or (err) { << 10 })
    println(w.write_string("cdefghi") or (err) { << 11 })
    w.flush() or (err) { << 12 }
    println(buffer_bytes(mut &w))
    << 0
}
