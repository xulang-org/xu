@main

#math

fn main() int {
    p := math.pow_f64(2.0, 10.0)
    println(p > 1023.9 && p < 1024.1)
    s := math.pow_f64(4.0, 0.5)
    println(s > 1.999 && s < 2.001)
    println(math.asin(0.0))
    a := math.asin(1.0)
    println(a > 1.57 && a < 1.58)
    ac := math.acos(1.0)
    println(ac > -0.0001 && ac < 0.0001)
    l10 := math.log10(100.0)
    println(l10 > 1.999 && l10 < 2.001)
    l2 := math.log2(8.0)
    println(l2 > 2.999 && l2 < 3.001)
    e2 := math.exp2(3.0)
    println(e2 > 7.99 && e2 < 8.01)
    c := math.cbrt(8.0)
    println(c > 1.999 && c < 2.001)
    cn := math.cbrt(0.0 - 8.0)
    println(cn < -1.999 && cn > -2.001)
    println(math.signbit(0.0 - 1.0))
    println(math.signbit(1.0))
    println(math.is_inf(math.inf(1)))
    println(math.is_inf(math.inf(0 - 1)))
    println(math.is_nan(math.nan()))
    mf := math.modf(1.5)
    println(mf.intg == 1.0)
    println(mf.frac > 0.499 && mf.frac < 0.501)
    mf2 := math.modf(0.0 - 1.5)
    println(mf2.intg == (0.0 - 1.0))
    println(mf2.frac < -0.499 && mf2.frac > -0.501)
    << 0
}
