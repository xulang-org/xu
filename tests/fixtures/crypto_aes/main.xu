@main

#crypto/aes
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn new_cipher_fails(key &string) bool {
    aes.new_cipher(key) or (err) { << true }
    << false
}

fn encrypt_fails(c aes.Cipher, pt &string) bool {
    c.encrypt(pt) or (err) { << true }
    << false
}

fn roundtrip(keyhex string, pthex string, cthex string) {
    key := hex.decode_string(keyhex) or (err) { << }
    pt := hex.decode_string(pthex) or (err) { << }
    c := aes.new_cipher(&key) or (err) { << }
    println(c.block_size())
    ct := c.encrypt(&pt) or (err) { << }
    println(hex.encode_to_string(ct + ""))
    show_bool(hex.encode_to_string(ct + "") == cthex)
    back := c.decrypt(&ct) or (err) { << }
    show_bool(back == pt)
}

fn main() int {
    pthex := "00112233445566778899aabbccddeeff"
    roundtrip("000102030405060708090a0b0c0d0e0f", pthex + "", "69c4e0d86a7b0430d8cdb78070b4c55a")
    roundtrip("000102030405060708090a0b0c0d0e0f1011121314151617", pthex + "", "dda97ca4864cdfe06eaf70a0ec0d7191")
    roundtrip("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", pthex + "", "8ea2b7ca516745bfeafc49904b496089")
    bad := "short"
    show_bool(new_cipher_fails(&bad))
    key := hex.decode_string("000102030405060708090a0b0c0d0e0f") or (err) { << 1 }
    c := aes.new_cipher(&key) or (err) { << 1 }
    tiny := "x"
    show_bool(encrypt_fails(c, &tiny))
    << 0
}
