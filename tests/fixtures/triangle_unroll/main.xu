@main

// General const-K triangle: for i in 0 -< K { j := i+1; while j < K { ... } }
// Unrolled at MIR lower; not a function-name special case.

fn pair_sum(a &[4]int) int {
    mut s := 0
    for i in 0:4 {
        mut j := i + 1
        while j < 4 {
            s += a[i] + a[j]
            j += 1
        }
    }
    << s
}

fn walk_sum(a &[4]int) int {
    mut s := 0
    for i in 0:4 {
        s += a[i]
    }
    << s
}

fn main() int {
    a := [4]int{1, 2, 3, 4}
    println(pair_sum(&a))
    println(walk_sum(&a))
    << 0
}
