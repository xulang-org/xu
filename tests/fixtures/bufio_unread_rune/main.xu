@main

#bufio
#io

fn main() int {
    src := io.buffer_from("Aβ")
    mut r := bufio.new_reader(src)
    a := r.read_rune() or (err) { << 1 }
    println(a.ch)
    r.unread_rune() or (err) { << 1 }
    b := r.read_rune() or (err) { << 1 }
    println(b.ch)
    c := r.read_rune() or (err) { << 1 }
    println(c.size)
    r.unread_rune() or (err) { << 1 }
    d := r.read_rune() or (err) { << 1 }
    println(d.size)
    << 0
}
