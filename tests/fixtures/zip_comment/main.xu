@main

#archive/zip

fn main() int {
    mut w := zip.new_writer()
    w.set_comment("pack")
    n := "a.txt"
    b := "x"
    w.write_file(&n, &b) or (err) { << 1 }
    w.close() or (err) { << 1 }
    raw := w.bytes()
    println(zip.comment(&raw) or (err) { << 1 })
    mut r := zip.new_reader(&raw)
    f := r.next() or (err) { << 1 }
    println(f.name)
    println(f.body)
    << 0
}
