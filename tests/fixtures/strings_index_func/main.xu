@main

#strings

fn is_digit(c int) bool {
    << c >= 48 && c <= 57
}

fn is_space_byte(c int) bool {
    << c == 32 || c == 9 || c == 10 || c == 13
}

fn to_upper_byte(c int) int {
    if c >= 97 && c <= 122 {
        << c - 32
    }
    << c
}

fn rot13_byte(c int) int {
    if c >= 65 && c <= 90 {
        << 65 + ((c - 65 + 13) % 26)
    }
    if c >= 97 && c <= 122 {
        << 97 + ((c - 97 + 13) % 26)
    }
    << c
}

fn main() int {
    s := "ab12cd34"
    println(strings.index_func(&s, is_digit))
    println(strings.last_index_func(&s, is_digit))
    spaced := "x y"
    println(strings.index_func(&spaced, is_space_byte))
    t := "hello"
    println(strings.map_bytes(&t, to_upper_byte))
    println(strings.map_bytes(&t, rot13_byte))
    empty := ""
    println(strings.index_func(&empty, is_digit))
    println(strings.last_index_func(&empty, is_digit))
    println(strings.map_bytes(&empty, to_upper_byte).len)
    none := "abcd"
    println(strings.index_func(&none, is_digit))
    << 0
}
