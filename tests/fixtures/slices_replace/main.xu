@main

#slices

fn main() int {
    xs := [1, 2, 3, 4]
    add := [9, 8]
    r := slices.replace_ints(&xs, 1, 3, &add)
    println(r.len)
    println(r[0])
    println(r[1])
    println(r[2])
    println(r[3])
    ss := ["a", "b", "c"]
    ins := ["x"]
    t := slices.replace_strs(&ss, 1, 2, &ins)
    println(t.len)
    println(t[0])
    println(t[1])
    println(t[2])
    empty := []int{}
    z := slices.replace_ints(&xs, 0, 4, &empty)
    println(z.len)
    << 0
}
