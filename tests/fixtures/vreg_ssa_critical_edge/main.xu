@main

// Nested branches force a branch predecessor to feed a multi-predecessor
// join.  The promotion pass must split that critical edge before inserting
// the de-SSA copies for both x and y.
fn critical(outer int, inner int) int {
    mut x := 1
    mut y := 2
    if outer > 0 {
        x = 10
        if inner > 0 {
            y = 20
        }
    }
    << x * 100 + y
}

fn main() int {
    println(critical(0, 0))
    println(critical(1, 0))
    println(critical(1, 1))
    << 0
}
