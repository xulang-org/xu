@main

#slices

fn is_b(s string) bool {
    << s == "b"
}

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    a := [1.0, 2.0, 1.0]
    println(slices.last_index_f64(&a, 1.0))
    b := [3.0]
    c := slices.concat_f64s(&a, &b)
    println(c.len)
    add := [9.0]
    r := slices.replace_f64s(&a, 1, 2, &add)
    println(r[1])
    p := [1.5]
    q := slices.repeat_f64s(&p, 3) or (err) { << 1 }
    println(q.len)
    o := [1.0, 2.0, 3.0]
    show_bool(slices.is_sorted_f64s(&o))
    n := [1.0, 3.0, 2.0]
    show_bool(slices.is_sorted_f64s(&n))
    s := ["a", "b", "c"]
    show_bool(slices.contains_func_strs(&s, is_b))
    << 0
}
