@main

#crypto/zuc
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn zeros(n int) string {
    mut b := []int{}
    for i in 0:n {
        b.push(0)
    }
    << string_from_bytes(b)
}

fn ffs(n int) string {
    mut b := []int{}
    for i in 0:n {
        b.push(255)
    }
    << string_from_bytes(b)
}

fn new_cipher_fails(key &string, iv &string) bool {
    zuc.new_cipher(key, iv) or (err) { << true }
    << false
}

fn main() int {
    k0 := zeros(16)
    iv0 := zeros(16)
    p8 := zeros(8)
    mut c1 := zuc.new_cipher(&k0, &iv0) or (err) { << 1 }
    ct1 := c1.xor_key_stream(&p8)
    println(hex.encode_to_string(ct1 + ""))
    mut d1 := zuc.new_cipher(&k0, &iv0) or (err) { << 1 }
    back := d1.xor_key_stream(&ct1)
    show_bool(back == p8)
    p5 := zeros(5)
    p3 := zeros(3)
    mut c2 := zuc.new_cipher(&k0, &iv0) or (err) { << 1 }
    a := c2.xor_key_stream(&p5)
    b2 := c2.xor_key_stream(&p3)
    println(hex.encode_to_string(a + ""))
    println(hex.encode_to_string(b2 + ""))
    kff := ffs(16)
    ivff := ffs(16)
    mut c3 := zuc.new_cipher(&kff, &ivff) or (err) { << 1 }
    ct3 := c3.xor_key_stream(&p8)
    println(hex.encode_to_string(ct3 + ""))
    short := "x"
    show_bool(new_cipher_fails(&short, &iv0))
    show_bool(new_cipher_fails(&k0, &short))
    << 0
}
