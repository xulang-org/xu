@main

fn main() int {
    mut m := map[int][]int{}
    mut xs := []int{}
    xs.push(10)
    xs.push(20)
    m[1] = xs
    t := m.take(1)
    println(t.len)
    println(t[0])
    println(t[1])
    mut ys := []int{}
    ys.push(30)
    m[1] = ys
    t2 := m.take(1)
    println(t2[0])
    println(m.len())
    << 0
}
