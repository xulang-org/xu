@main

#crypto/x509
#encoding/pem
#time

fn cert(text &string) x509.Certificate {
    b := pem.decode(text)
    c := x509.parse_certificate(b.bytes) or (err) {
        println(err.msg())
        <<< 1
    }
    << c
}

fn pool_one(c x509.Certificate) x509.CertPool {
    mut p := x509.new_cert_pool()
    p.add(c)
    << p
}

fn verify_fails(c &x509.Certificate, opts x509.VerifyOptions) bool {
    c.verify(opts) or (err) { << true }
    << false
}

