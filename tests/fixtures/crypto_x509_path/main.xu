    root := cert(&root_pem)
    i1 := cert(&i1_one_pem)
    i2 := cert(&i2_pem)
    leaf := cert(&leaf_pem)
    now := leaf.not_before.add(time.hour())
    println(root.basic_constraints_valid)
    println(root.is_ca)
    println(i1.max_path_len)
    println((i1.key_usage & x509.key_usage_cert_sign) != 0)
    println(leaf.authority_key_id.len > 0)

    mut inters := x509.new_cert_pool()
    inters.add(i1)
    inters.add(i2)
    opts := x509.VerifyOptions{dns_name: "path.example", current_time: now, roots: pool_one(root), intermediates: inters, key_usages: []int{}, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    leaf.verify(opts) or (err) {
        println(err.msg())
        << 1
    }

    // Candidate ordering must not affect success. The first I1 has a valid
    // key/signature but an unusable issuer; the builder must backtrack.
    mut dead_i1 := cert(&i1_one_pem)
    dead_i1.raw_issuer = "dead issuer"
    mut reordered := x509.new_cert_pool()
    reordered.add(cert(&i2_pem))
    reordered.add(dead_i1)
    reordered.add(cert(&i1_one_pem))
    opts_reordered := x509.VerifyOptions{dns_name: "path.example", current_time: now, roots: pool_one(cert(&root_pem)), intermediates: reordered, key_usages: []int{}, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    leaf.verify(opts_reordered) or (err) {
        println(err.msg())
        << 1
    }
    println("backtrack_ok")

    mut bad_pathlen := x509.new_cert_pool()
    bad_pathlen.add(cert(&i1_zero_pem))
    bad_pathlen.add(cert(&i2_pem))
    opts_pathlen := x509.VerifyOptions{dns_name: "path.example", current_time: now, roots: pool_one(cert(&root_pem)), intermediates: bad_pathlen, key_usages: []int{}, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    println(verify_fails(&leaf, opts_pathlen))

    mut bad_usage := x509.new_cert_pool()
    bad_usage.add(cert(&i1_one_pem))
    bad_usage.add(cert(&i2_bad_usage_pem))
    opts_usage := x509.VerifyOptions{dns_name: "path.example", current_time: now, roots: pool_one(cert(&root_pem)), intermediates: bad_usage, key_usages: []int{}, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    println(verify_fails(&leaf, opts_usage))

    mut bad_aki := cert(&i2_pem)
    bad_aki.subject_key_id = "wrong key id"
    mut bad_aki_pool := x509.new_cert_pool()
    bad_aki_pool.add(cert(&i1_one_pem))
    bad_aki_pool.add(bad_aki)
    opts_aki := x509.VerifyOptions{dns_name: "path.example", current_time: now, roots: pool_one(cert(&root_pem)), intermediates: bad_aki_pool, key_usages: []int{}, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    println(verify_fails(&leaf, opts_aki))

    unknown := cert(&leaf_unknown_pem)
    mut unknown_inters := x509.new_cert_pool()
    unknown_inters.add(cert(&i1_one_pem))
    unknown_inters.add(cert(&i2_pem))
    opts_unknown := x509.VerifyOptions{dns_name: "path.example", current_time: now, roots: pool_one(cert(&root_pem)), intermediates: unknown_inters, key_usages: []int{}, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    println(verify_fails(&unknown, opts_unknown))
    << 0
}
