@main

#crypto/ed25519
#encoding/hex

fn main() int {
    seed := hex.decode_string("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60") or (err) {
        << 1
    }
    priv := ed25519.new_key_from_seed(seed) or (err) {
        println(err.msg())
        << 1
    }
    pubk := ed25519.public(&priv) or (err) {
        << 1
    }
    println(hex.encode_to_string(pubk + ""))

    msg := ""
    sig := ed25519.sign(&priv, &msg) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(sig + ""))
    println(ed25519.verify(&pubk, &msg, &sig))

    bad := hex.decode_string("e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf35005b7611e4edaa863de1644803dc1e89067") or (err) {
        << 1
    }
    println(ed25519.verify(&pubk, &msg, &bad))
    << 0
}
