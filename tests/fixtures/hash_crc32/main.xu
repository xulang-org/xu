@main

#hash/crc32

fn main() int {
    empty := ""
    println(crc32.checksum_ieee(&empty))
    s1 := "Xu"
    println(crc32.checksum_ieee(&s1))
    hw := "hello world"
    println(crc32.checksum_ieee(&hw))
    s64 := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    println(crc32.checksum_ieee(&s64))
    println(crc32.checksum_castagnoli(&empty))
    println(crc32.checksum_castagnoli(&s1))
    n := "123456789"
    println(crc32.checksum_castagnoli(&n))
    tab := crc32.make_table(crc32.ieee)
    println(crc32.checksum(&s1, &tab))
    << 0
}
