@main

#index/suffixarray

fn dump_matches(ms []suffixarray.Match) {
    println(ms.len)
    for i in 0:ms.len {
        println(ms[i].from)
    println(ms[i].to)
    }
}

fn main() int {
    data := "banana"
    ix := suffixarray.new(&data)
    ana := "ana"
    all := 0 - 1
    dump_matches(suffixarray.find_all_index(&ix, &ana, all))
    dump_matches(suffixarray.find_all_index(&ix, &ana, 1))
    z := "z"
    dump_matches(suffixarray.find_all_index(&ix, &z, all))
    e := ""
    dump_matches(suffixarray.find_all_index(&ix, &e, all))
    << 0
}
