@main

#math/bits

// Variable shifts, signed high bits, zero shifts, and an accumulating alias.
fn rotate_expr(x int, k int) int {
    s := k & 63
    if s == 0 { << x }
    << (x << s) | ((x >> (64 - s)) & ((1 << s) - 1))
}

fn near_miss(x int, k int) int {
    s := k & 63
    if s == 0 { << x }
    << (x << s) | ((x >> (64 - s)) & ((1 << s) - 2))
}

fn rotate_expr_right(x int, k int) int {
    s := k & 63
    if s == 0 { << x }
    << ((x >> s) & ((1 << (64 - s)) - 1)) | (x << (64 - s))
}

fn near_miss_right(x int, k int) int {
    s := k & 63
    if s == 0 { << x }
    << ((x >> s) & ((1 << (64 - s)) - 2)) | (x << (64 - s))
}

fn main() int {
    vals := [0, 1, -1, -9223372036854775807 - 1, 0x0123456789abcdef]
    shifts := [-129, -65, -64, -63, -1, 0, 1, 63, 64, 65, 129]
    for i in 0:vals.len {
        x := vals[i]
        mut acc := x
        for j in 0:shifts.len {
            k := shifts[j]
            println(str(bits.rotate_left(x, k)))
            println(str(bits.rotate_right(x, k)))
            println(str(rotate_expr(x, k)))
            println(str(near_miss(x, k)))
            println(str(rotate_expr_right(x, k)))
            println(str(near_miss_right(x, k)))
            acc = bits.rotate_left(acc, k)
            println(str(acc))
        }
    }
    << 0
}
