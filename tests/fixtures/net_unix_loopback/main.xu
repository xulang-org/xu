@main

#net
#os

fn remove_quiet(path string) {
    os.remove(path) or (err) {
        <<
    }
}

fn check_path_errors() int {
    mut empty := net.listen_on("unix", "") or (err) {
        println(err.msg())
        mut too_long := "/tmp/"
        for i in 0:110 {
            too_long = too_long + "x"
        }
        mut bad := net.listen_on("unix", too_long) or (err2) {
            println(err2.msg())
            << 0
        }
        bad.close() or (close_err) { << 1 }
        << 1
    }
    empty.close() or (close_err) { << 1 }
    << 1
}

// Unix pathname stream sockets: generic Listen/Dial plus explicit DialUnix
// with a local client address. The paths include pid so concurrent gates do
// not collide; Windows compiles this fixture but does not execute it.
fn main() int {
    if check_path_errors() != 0 {
        << 1
    }
    suffix := str(os.getpid()) + ".sock"
    server_path := "/tmp/xu-net-unix-server-" + suffix
    client_path := "/tmp/xu-net-unix-client-" + suffix
    remove_quiet(server_path + "")
    remove_quiet(client_path + "")

    mut ln := net.listen_on("unix", server_path + "") or (err) { << 1 }
    mut c := net.dial_to("unix", server_path + "") or (err) { << 1 }
    msg := "ping"
    println(c.write(&msg) or (err) { << 1 })
    mut ac := ln.accept() or (err) { << 1 }
    println(ac.read(64) or (err) { << 1 })
    println(ln.addr() == server_path)
    ac.close() or (err) { << 1 }
    c.close() or (err) { << 1 }

    local := net.UnixAddr{name: client_path + "", network: "unix"}
    remote := net.UnixAddr{name: server_path + "", network: "unix"}
    mut c2 := net.dial_unix("unix", local, remote) or (err) { << 1 }
    msg2 := "xu"
    println(c2.write(&msg2) or (err) { << 1 })
    mut ac2 := ln.accept() or (err) { << 1 }
    println(ac2.read(64) or (err) { << 1 })
    println(c2.local_addr() == client_path)
    println(c2.remote_addr() == server_path)
    ac2.close() or (err) { << 1 }
    c2.close() or (err) { << 1 }

    mut d := net.new_dialer()
    d.timeout_ns = 1000000000
    mut c3 := d.dial("unix", server_path + "") or (err) { << 1 }
    msg3 := "ctx"
    println(c3.write(&msg3) or (err) { << 1 })
    mut ac3 := ln.accept() or (err) { << 1 }
    println(ac3.read(64) or (err) { << 1 })
    ac3.close() or (err) { << 1 }
    c3.close() or (err) { << 1 }
    ln.close() or (err) { << 1 }

    os.remove(client_path + "") or (err) { << 1 }
    // Listener.close removes server_path (UnixListener unlink-on-close).
    << 0
}
