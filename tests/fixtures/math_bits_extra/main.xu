@main

#math
#math/bits

fn near(a f64, b f64) bool {
    d := math.abs(a - b)
    << d < 0.001
}

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    show_bool(near(math.sin(0.0), 0.0))
    show_bool(near(math.cos(0.0), 1.0))
    show_bool(near(math.sin(math.pi() / 2.0), 1.0))
    show_bool(math.round(1.6) == 2.0)
    show_bool(math.trunc(1.6) == 1.0)
    show_bool(math.is_nan(math.sqrt(0.0 - 1.0)))
    show_bool(math.is_inf(1.0 / 0.0))
    show_bool(math.copysign(3.0, 0.0 - 1.0) < 0.0)
    c := bits.add64(1, 2, 0)
    println(c.lo)
    println(c.carry)
    println(bits.len32(255))
    println(bits.leading_zeros32(1))
    << 0
}
