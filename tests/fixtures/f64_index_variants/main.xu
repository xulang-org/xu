@main

fn distribute(dst &mut []f64, source &[]f64, start int) {
    for row in 0:dst.len {
        mut sum := 0.0
        for col in start:source.len {
            sum += source[col] / f64(col + 1)
        }
        dst[row] = sum
    }
}

fn reverse_total(source &[]f64) f64 {
    mut total := 0.0
    mut pos := source.len
    while pos > 0 {
        pos -= 1
        total += source[pos] + source[pos]
    }
    << total
}

fn neighbor_total(source &[]f64) f64 {
    mut total := 0.0
    for pos in 1:source.len {
        total += source[pos - 1] + source[pos]
    }
    << total
}

fn main() int {
    mut source := []f64{}
    source.push(2.0)
    source.push(4.0)
    source.push(6.0)
    source.push(8.0)
    mut dst := []f64{}
    dst.push(-1.0)
    dst.push(-1.0)
    distribute(mut &dst, &source, 0)
    println(dst[0] == 8.0 && dst[1] == 8.0)
    distribute(mut &dst, &source, 1)
    println(dst[0] == 6.0 && dst[1] == 6.0)
    distribute(mut &dst, &source, source.len)
    println(dst[0] == 0.0 && dst[1] == 0.0)
    println(reverse_total(&source) == 40.0)
    println(neighbor_total(&source) == 30.0)
    empty := []f64{}
    distribute(mut &dst, &empty, 0)
    println(dst[0] == 0.0 && dst[1] == 0.0)
    println(reverse_total(&empty) == 0.0)
    println(neighbor_total(&empty) == 0.0)
    << 0
}
