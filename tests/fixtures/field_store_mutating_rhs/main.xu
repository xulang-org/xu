@main

struct D {
    kinds   []int
    root_idx int
    s       string
}

fn (d &mut D) mk() int {
    d.kinds.push(9)
    d.s = "via-rhs"
    << d.kinds.len - 1
}

fn main() int {
    mut d := D{kinds: []int{}, root_idx: -1, s: ""}
    d.root_idx = d.mk()
    println(d.kinds.len)
    println(d.root_idx)
    println(d.s)
    d.kinds.push(7)
    println(d.kinds.len)
    << 0
}
