@main

#image
#image/color
#image/jpeg

fn near(a int, b int, tol int) bool {
    mut d := a - b
    if d < 0 {
        d = 0 - d
    }
    << d <= tol
}

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn encode_jpeg_fails(img &image.RGBA) bool {
    jpeg.encode_rgba(img) or (err) { << true }
    << false
}

fn main() int {
    mut img := image.new_rgba(image.rect(0, 0, 8, 8))
    for y in 0:8 {
        for x in 0:8 {
            img.set_rgba(x, y, color.rgba8(200, 40, 40, 255))
        }
    }
    raw := jpeg.encode_rgba(&img) or (err) { << 1 }
    show_bool(raw.len > 100)
    back := jpeg.decode(&raw) or (err) { << 1 }
    println(back.rect.dx())
    println(back.rect.dy())
    p := back.at_rgba(0, 0)
    show_bool(near(p.r, 200, 8))
    show_bool(near(p.g, 40, 8))
    show_bool(near(p.b, 40, 8))
    println(p.a)
    mut small := image.new_rgba(image.rect(0, 0, 5, 3))
    for y in 0:3 {
        for x in 0:5 {
            small.set_rgba(x, y, color.rgba8(10 + x * 20, 80 + y * 30, 160, 255))
        }
    }
    raw2 := jpeg.encode_rgba(&small) or (err) { << 1 }
    back2 := jpeg.decode(&raw2) or (err) { << 1 }
    println(back2.rect.dx())
    println(back2.rect.dy())
    q := back2.at_rgba(2, 1)
    src := small.at_rgba(2, 1)
    show_bool(near(q.r, src.r, 12))
    show_bool(near(q.g, src.g, 12))
    show_bool(near(q.b, src.b, 12))

    empty := image.new_rgba(image.rect(0, 0, 0, 0))
    show_bool(encode_jpeg_fails(&empty))
    << 0
}
