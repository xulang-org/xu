@main

#bufio
#io

fn unread_fails(br bufio.Reader) bool {
    mut r := br
    r.unread_byte() or (err) {
        << true
    }
    << false
}

fn read_slice_fails(br bufio.Reader) bool {
    mut r := br
    r.read_slice(10) or (err) {
        << true
    }
    << false
}

fn main() int {
    println(unread_fails(bufio.new_reader(io.buffer_from("A"))))

    mut u := bufio.new_reader(io.buffer_from("XY"))
    println(u.read_byte() or (err) { << 1 })
    println(u.unread_byte() or (err) { << 1 })
    println(u.read_byte() or (err) { << 1 })
    println(u.read_byte() or (err) { << 1 })
    println(u.unread_byte() or (err) { << 1 })
    println(unread_fails(u))

    mut p := bufio.new_reader(io.buffer_from("AB"))
    println(p.peek(1) or (err) { << 1 })
    println(unread_fails(p))

    mut rs := bufio.new_reader(io.buffer_from("ab;cd"))
    println(rs.read_slice(59) or (err) { << 1 })
    println(rs.read_slice(59) or (err) { << 1 })
    println(read_slice_fails(rs))

    mut full := bufio.new_reader_size(io.buffer_from("abcdefgh"), 4)
    println(full.read_slice(122) or (err) { << 1 })
    println(full.read_slice(122) or (err) { << 1 })

    mut bw := bufio.new_writer_size(io.buffer(), 8)
    println(bw.available())
    println(bw.write_string("hi") or (err) { << 1 })
    println(bw.available())
    println(bw.buffered())
    bw.reset(io.buffer())
    println(bw.available())
    println(bw.buffered())
    println(bw.write_string("Z") or (err) { << 1 })
    println(bw.flush() or (err) { << 1 })
    println(bw.bytes())

    mut rr := bufio.new_reader(io.buffer_from("AB"))
    println(rr.read_byte() or (err) { << 1 })
    rr.reset(io.buffer_from("CD"))
    println(rr.read_byte() or (err) { << 1 })
    << 0
}
