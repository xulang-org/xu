@main

#crypto/ecdsa
#encoding/asn1
#encoding/hex
#encoding/pem

fn scalar_one(size int) string {
    mut b := []int{}
    for _ in 0:size {
        b.push(0)
    }
    b[size - 1] = 1
    << string_from_bytes(b)
}

fn append_zero(s &string) string {
    << (s + "") + string_from_byte(0)
}

fn flip_last(s &string) string {
    mut b := []int{}
    for i in 0:s.len {
        b.push(s[i] & 255)
    }
    b[b.len - 1] = b[b.len - 1] ^ 1
    << string_from_bytes(b)
}

fn replace_equal(s &string, old &string, replacement &string) string {
    if old.len == 0 || old.len != replacement.len || old.len > s.len {
        << s + ""
    }
    mut at := -1
    mut i := 0
    while i + old.len <= s.len {
        mut same := true
        for j in 0:old.len {
            if s[i + j] != old[j] {
                same = false
                <-
            }
        }
        if same {
            at = i
            <-
        }
        i = i + 1
    }
    if at < 0 {
        << s + ""
    }
    mut out := []int{}
    for j in 0:s.len {
        if j >= at && j < at + old.len {
            out.push(replacement[j - at] & 255)
        } else {
            out.push(s[j] & 255)
        }
    }
    << string_from_bytes(out)
}

fn private_fails(der &string) bool {
    ecdsa.parse_private_key(der) or (err) { << true }
    << false
}

fn public_fails(der &string) bool {
    ecdsa.parse_public_key(der) or (err) { << true }
    << false
}

fn private_pem_fails(text &string) bool {
    ecdsa.parse_private_pem(text) or (err) { << true }
    << false
}

fn public_pem_fails(text &string) bool {
    ecdsa.parse_public_pem(text) or (err) { << true }
    << false
}

fn pem_text(typ string, der &string, encrypted bool) string {
    mut keys := []string{}
    mut vals := []string{}
    if encrypted {
        keys.push("Proc-Type")
        vals.push("4,ENCRYPTED")
    }
    blk := pem.Block{typ: typ, keys: keys, vals: vals, bytes: der + "", rest: ""}
    << pem.encode_to_memory(&blk)
}

fn fixture_der_tlv(tag int, content &string) string {
    mut out := []int{}
    out.push(tag & 255)
    if content.len < 128 {
        out.push(content.len)
    } else {
        mut rev := []int{}
        mut n := content.len
        while n > 0 {
            rev.push(n & 255)
            n = n / 256
        }
        out.push(128 + rev.len)
        mut i := rev.len
        while i > 0 {
            i = i - 1
            out.push(rev[i])
        }
    }
    for i in 0:content.len {
        out.push(content[i] & 255)
    }
    << string_from_bytes(out)
}

fn fixture_ec_oid() []int {
    mut a := []int{}
    a.push(1)
    a.push(2)
    a.push(840)
    a.push(10045)
    a.push(2)
    a.push(1)
    << a
}

fn fixture_curve_oid(curve int) []int {
    mut a := []int{}
    if curve == ecdsa.p256 {
        a.push(1)
        a.push(2)
        a.push(840)
        a.push(10045)
        a.push(3)
        a.push(1)
        a.push(7)
    } else {
        a.push(1)
        a.push(3)
        a.push(132)
        a.push(0)
        if curve == ecdsa.p384 {
            a.push(34)
        } else {
            a.push(35)
        }
    }
    << a
}

fn fixture_algorithm(curve int) string {
    ec := fixture_ec_oid()
    co := fixture_curve_oid(curve)
    a := asn1.marshal_oid(&ec) or >>
    b := asn1.marshal_oid(&co) or >>
    mut elems := []string{}
    elems.push(a)
    elems.push(b)
    << asn1.marshal_seq(&elems)
}

fn fixture_pkix(curve int, public_key &string) string {
    alg := fixture_algorithm(curve) or >>
    bits_body := string_from_byte(0) + (public_key + "")
    bits := fixture_der_tlv(asn1.tag_bit_string, &bits_body)
    mut elems := []string{}
    elems.push(alg)
    elems.push(bits)
    << asn1.marshal_seq(&elems)
}

fn fixture_pkcs8(curve int, sec1 &string) string {
    ver := asn1.marshal_int(0)
    alg := fixture_algorithm(curve) or >>
    inner := asn1.marshal_octet(sec1)
    mut elems := []string{}
    elems.push(ver)
    elems.push(alg)
    elems.push(inner)
    << asn1.marshal_seq(&elems)
}

fn exercise(size int) int {
    d := scalar_one(size)
    public_key := ecdsa.public(&d) or (err) {
        println(err.msg())
        << 1
    }
    sec1 := ecdsa.marshal_sec1(&d) or (err) {
        println(err.msg())
        << 1
    }
    pkcs8 := ecdsa.marshal_pkcs8(&d) or (err) {
        println(err.msg())
        << 1
    }
    sec1_pem := ecdsa.marshal_sec1_pem(&d) or (err) {
        println(err.msg())
        << 1
    }
    pkcs8_pem := ecdsa.marshal_pkcs8_pem(&d) or (err) {
        println(err.msg())
        << 1
    }
    pkix := ecdsa.marshal_pkix(&public_key) or (err) {
        println(err.msg())
        << 1
    }
    pkix_pem := ecdsa.marshal_pkix_pem(&public_key) or (err) {
        println(err.msg())
        << 1
    }

    d1 := ecdsa.parse_private_key(&sec1) or (err) {
        println(err.msg())
        << 1
    }
    d2 := ecdsa.parse_private_key(&pkcs8) or (err) {
        println(err.msg())
        << 1
    }
    d3 := ecdsa.parse_private_pem(&sec1_pem) or (err) {
        println(err.msg())
        << 1
    }
    d4 := ecdsa.parse_private_pem(&pkcs8_pem) or (err) {
        println(err.msg())
        << 1
    }
    p1 := ecdsa.parse_public_key(&pkix) or (err) {
        println(err.msg())
        << 1
    }
    p2 := ecdsa.parse_public_pem(&pkix_pem) or (err) {
        println(err.msg())
        << 1
    }

    println(d.len)
    println(public_key.len)
    println(sec1.len)
    println(pkcs8.len)
    println(pkix.len)
    println(d1 == d)
    println(d2 == d)
    println(d3 == d)
    println(d4 == d)
    println(p1 == public_key)
    println(p2 == public_key)
    << 0
}

fn main() int {
    if exercise(ecdsa.private_key_size_p256) != 0 { << 1 }
    if exercise(ecdsa.private_key_size_p384) != 0 { << 1 }
    if exercise(ecdsa.private_key_size_p521) != 0 { << 1 }

    d384 := scalar_one(ecdsa.private_key_size_p384)
    p384 := ecdsa.public(&d384) or (err) { << 1 }
    sec1 := ecdsa.marshal_sec1(&d384) or (err) { << 1 }
    pkcs8 := ecdsa.marshal_pkcs8(&d384) or (err) { << 1 }
    pkix := ecdsa.marshal_pkix(&p384) or (err) { << 1 }

    p384_oid := hex.decode_string("06052b81040022") or (err) { << 1 }
    p521_oid := hex.decode_string("06052b81040023") or (err) { << 1 }
    wrong_pkcs8_curve := replace_equal(&pkcs8, &p384_oid, &p521_oid)
    inner_curve_mismatch := fixture_pkcs8(ecdsa.p521, &sec1) or (err) { << 1 }
    wrong_pkix_curve := fixture_pkix(ecdsa.p521, &p384) or (err) { << 1 }
    bad_sec1_public := flip_last(&sec1)
    compressed_point := string_from_byte(2) + p384[1:49]
    compressed_pkix := fixture_pkix(ecdsa.p384, &compressed_point) or (err) { << 1 }

    bad_private_type := pem_text("CERTIFICATE", &pkcs8, false)
    encrypted_private := pem_text("EC PRIVATE KEY", &sec1, true)
    bad_public_type := pem_text("EC PUBLIC KEY", &pkix, false)
    sec1_tail := append_zero(&sec1)
    pkcs8_tail := append_zero(&pkcs8)
    pkix_tail := append_zero(&pkix)

    println(private_fails(&sec1_tail))
    println(private_fails(&pkcs8_tail))
    println(public_fails(&pkix_tail))
    println(private_fails(&wrong_pkcs8_curve))
    println(private_fails(&inner_curve_mismatch))
    println(private_fails(&bad_sec1_public))
    println(public_fails(&wrong_pkix_curve))
    println(public_fails(&compressed_pkix))
    println(private_pem_fails(&bad_private_type))
    println(private_pem_fails(&encrypted_private))
    println(public_pem_fails(&bad_public_type))

    d521 := scalar_one(ecdsa.private_key_size_p521)
    sec1_521 := ecdsa.marshal_sec1(&d521) or (err) { << 1 }
    pkcs8_521 := ecdsa.marshal_pkcs8(&d521) or (err) { << 1 }
    p521 := ecdsa.public(&d521) or (err) { << 1 }
    pkix_521 := ecdsa.marshal_pkix(&p521) or (err) { << 1 }
    println((sec1_521[1] & 128) != 0)
    println((pkcs8_521[1] & 128) != 0)
    println((pkix_521[1] & 128) != 0)
    << 0
}
