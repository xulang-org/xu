@main

#strings
#bytes

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    a := "abc"
    b := "abd"
    println(strings.compare(&a, &b))
    println(strings.index_byte(&a, 98))
    s := "ababa"
    println(strings.last_index(&s, "ba"))
    println(strings.last_index_byte(&s, 97))
    println(strings.count(&s, "ba"))
    csv := "x,y,z,w"
    bits := strings.split_n(&csv, ",", 2)
    println(bits.len)
    println(bits[0])
    println(bits[1])
    banana := "banana"
    println(strings.replace_all(&banana, "an", "X"))
    g1 := "Go"
    g2 := "go"
    show_bool(strings.equal_fold(&g1, &g2))
    mut bd := strings.builder()
    hi := "hi"
    println(bd.write_string(&hi))
    println(bd.length())
    println(bd.text())
    cut := strings.cut(&csv, ",")
    show_bool(cut.found)
    println(cut.before)
    println(cut.after)

    msg := "  hi  "
    println(bytes.trim_space(&msg))
    xx := "xxhixx"
    println(bytes.trim(&xx, "x"))
    println(bytes.contains(&s, "bab"))
    println(bytes.index(&s, "ba"))
    parts := ["a", "b"]
    println(bytes.join(parts, "-"))
    sp := bytes.split(&csv, ",")
    println(sp.len)
    fsrc := " a b "
    f := bytes.fields(&fsrc)
    println(f.len)
    mut bb := bytes.buffer_from("xy")
    println(bb.read_byte() or (err) { << 1 })
    bb.unread_byte() or (err) { << 1 }
    println(true)
    println(bb.read_byte() or (err) { << 1 })
    << 0
}
