@main

// Nested-loop invariant `sys[i].x`. Kernel is a helper so ArrPush in main
// does not skip LICM (O1 skips ArrPush fns). Stdout gold, not just compile.
struct P {
    x int
}

fn nest(sys &[]P) int {
    n := sys.len
    mut s := 0
    for i in 0:n {
        for j in 0:n {
            s += sys[i].x
        }
    }
    << s
}

fn main() int {
    mut sys := []P{}
    sys.push(P{x: 2})
    sys.push(P{x: 3})
    sys.push(P{x: 5})
    println(nest(&sys))
    << 0
}
