@main

#net

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    sa := "127.0.0.1"
    sb := "127.0.0.1"
    sc := "10.0.0.1"
    a := net.parse_ip(&sa)
    b := net.parse_ip(&sb)
    c := net.parse_ip(&sc)
    show_bool(net.ip_equal(&a, &b))
    show_bool(net.ip_equal(&a, &c))
    show_bool(net.ip_is_loopback(&a))
    << 0
}
