@main

#os
#path
#path/filepath

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn stat_fails(path string) bool {
    os.stat(path) or (err) {
        << true
    }
    << false
}

fn windows_rel_is_case_insensitive() bool {
    base := "C:\\Users\\Alice"
    target := "c:\\users\\alice\\docs"
    got := filepath.rel(&base, &target) or (err) {
        << false
    }
    << got == "docs"
}

fn main() int {
    p := "/usr/bin"
    show_bool(path.has_prefix(&p, "/usr"))
    show_bool(path.has_suffix(&p, "bin"))
    rel := "foo"
    ab := filepath.abs(&rel)
    show_bool(ab.len > 3)
    vol := "C:/x"
    println(filepath.volume_name(&vol))
    pat := "a*"
    nm := "abc"
    show_bool(filepath.matches(&pat, &nm))
    os.remove_all("m57_t")
    os.mkdir_all("m57_t/sub") or (err) {
        println(false)
        << 0
    }
    println(true)
    os.write("m57_t/sub/a.txt", "hi") or (err) {
        println(false)
        << 0
    }
    println(true)
    os.write("m57_t/sub/b.bin", "x") or (err) {
        println(false)
        << 0
    }
    println(true)

    gpat := "m57_t/sub/*.txt"
    g := filepath.glob(&gpat) or (err) { << 1 }
    println(g.len)

    ents := os.entries("m57_t/sub") or (err) {
        << 1
    }
    println(ents.len)

    show_bool(stat_fails("no_such_xu_file_zzz"))

    mut home := "$$HOME"
    if xu_target_os() == 2 {
        home = "$$USERPROFILE"
    }
    exp := os.expand_env(&home)
    show_bool(exp.len > 0)
    os.remove_all("m57_t")
    println(true)
    println(stat_fails("m57_t"))

    parents := "../../a/../b"
    mut parents_want := "../../b"
    if xu_target_os() == 2 {
        parents_want = "..\\..\\b"
    }
    show_bool(filepath.clean(&parents) == parents_want)
    if xu_target_os() == 2 {
        drive_root := "C:\\foo\\.."
        unc := "\\\\server\\share\\..\\x"
        rooted := "\\tmp"
        show_bool(filepath.clean(&drive_root) == "C:\\")
        show_bool(filepath.clean(&unc) == "\\\\server\\share\\x")
        show_bool(!filepath.is_abs(&rooted))
        rooted_abs := filepath.abs(&rooted)
        show_bool(filepath.is_abs(&rooted_abs))
        show_bool(windows_rel_is_case_insensitive())
    } else {
        show_bool(true)
        show_bool(true)
        show_bool(true)
        show_bool(true)
        show_bool(true)
    }
    << 0
}
