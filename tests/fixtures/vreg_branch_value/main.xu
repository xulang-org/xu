@main

// The comparison result is both a branch condition and a value returned from
// each successor.  The emitter must materialize the fixed home even when it
// fuses the comparison with the branch.
fn classify(a int) bool {
    c := a < 2
    if c {
        << c
    }
    << c
}

fn main() int {
    if classify(1) {
        println(1)
    } else {
        println(0)
    }
    if classify(3) {
        println(1)
    } else {
        println(0)
    }
    << 0
}
