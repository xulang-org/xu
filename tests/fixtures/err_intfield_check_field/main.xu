@main
struct Pair { left []int
    tag int
    right []int
}
fn touch(t &mut Pair, p int) int {
    t.left[p] = t.left[p] + 1
    t.right[p] = t.left[p] + t.right[0]
    << t.right[p]
}
fn main() int {
    mut a := []int{}
    mut b := []int{}
    a.push(3)
    a.push(5)
    b.push(7)
    mut t := Pair{left: a, tag: 97, right: b}
    println(touch(mut &t, 1))
    << 0
}
