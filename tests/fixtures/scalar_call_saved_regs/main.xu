@main
#math
#strings
struct Bag { data []int }
fn mix(value int) int {
    mut x := value
    x = (x ^ (x >> 1)) * 6364136223846793005
    x = (x ^ (x >> 2)) * 6364136223846793003
    x = (x ^ (x >> 3)) * 6364136223846793001
    x = (x ^ (x >> 4)) * 6364136223846792999
    x = (x ^ (x >> 5)) * 6364136223846792997
    x = (x ^ (x >> 6)) * 6364136223846792995
    x = (x ^ (x >> 7)) * 6364136223846792993
    x = (x ^ (x >> 8)) * 6364136223846792991
    x = (x ^ (x >> 9)) * 6364136223846792989
    x = (x ^ (x >> 10)) * 6364136223846792987
    x = (x ^ (x >> 11)) * 6364136223846792985
    x = (x ^ (x >> 12)) * 6364136223846792983
    x = (x ^ (x >> 13)) * 6364136223846792981
    x = (x ^ (x >> 14)) * 6364136223846792979
    x = (x ^ (x >> 15)) * 6364136223846792977
    x = (x ^ (x >> 16)) * 6364136223846792975
    x = (x ^ (x >> 17)) * 6364136223846792973
    x = (x ^ (x >> 1)) * 6364136223846792971
    x = (x ^ (x >> 2)) * 6364136223846792969
    x = (x ^ (x >> 3)) * 6364136223846792967
    << x
}
fn combine(a int, b int, c int, d int, e int, f int) int {
    mut x := ((a + b) ^ (c - d)) + e - f
    x = (x ^ (x >> 3)) * 1442695040888963407
    x = (x ^ (x >> 4)) * 1442695040888963409
    x = (x ^ (x >> 5)) * 1442695040888963411
    x = (x ^ (x >> 6)) * 1442695040888963413
    x = (x ^ (x >> 7)) * 1442695040888963415
    x = (x ^ (x >> 8)) * 1442695040888963417
    x = (x ^ (x >> 9)) * 1442695040888963419
    x = (x ^ (x >> 10)) * 1442695040888963421
    x = (x ^ (x >> 11)) * 1442695040888963423
    x = (x ^ (x >> 12)) * 1442695040888963425
    << x
}
fn work(bag &mut Bag, seed int) int {
    x := bag.data[0]
    bag.data[0] = x ^ seed
    << combine(x ^ seed, (x + seed) * 31, x - seed * 97, x * 109 + seed, (x + 11) ^ (seed << 19), mix(x + seed))
}
fn work_extra(bag &mut Bag, seed int) int {
    x := bag.data[0]
    bag.data[0] = x ^ seed
    << (x * 119 - seed) + combine(x ^ seed, (x + seed) * 31, x - seed * 97, x * 109 + seed, (x + 11) ^ (seed << 19), mix(x + seed))
}
fn main() int {
    for i in 0:64 {
        mut bag := Bag{data: []int{}}
        x := (i << 53) ^ (i * 7919 - 97)
        bag.data.push(x)
        seed := i * 31 - 199
        println(work(mut &bag, seed))
        println(work_extra(mut &bag, seed))
        println(bag.data[0])
    }
    << 0
}
