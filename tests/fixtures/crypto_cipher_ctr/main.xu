@main

#crypto/aes
#crypto/cipher
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn encrypt_ctr_fails(c aes.Cipher, iv &string, msg &string) bool {
    cipher.encrypt_ctr(&c, iv, msg) or (err) { << true }
    << false
}

fn main() int {
    key := hex.decode_string("2b7e151628aed2a6abf7158809cf4f3c") or (err) { << 1 }
    iv := hex.decode_string("f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff") or (err) { << 1 }
    pt := hex.decode_string("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e51") or (err) { << 1 }
    want := "874d6191b620e3261bef6864990db6ce9806f66b7970fdff8617187bb9fffdff"
    c := aes.new_cipher(&key) or (err) { << 1 }
    ct := cipher.encrypt_ctr(&c, &iv, &pt) or (err) { << 1 }
    println(hex.encode_to_string(ct + ""))
    show_bool(hex.encode_to_string(ct + "") == want)
    back := cipher.decrypt_ctr(&c, &iv, &ct) or (err) { << 1 }
    show_bool(hex.encode_to_string(back + "") == hex.encode_to_string(pt + ""))
    msg := "Hello, Xu!"
    ct2 := cipher.encrypt_ctr(&c, &iv, &msg) or (err) { << 1 }
    println(hex.encode_to_string(ct2 + ""))
    println(cipher.decrypt_ctr(&c, &iv, &ct2) or (err) { << 1 })
    badiv := "short"
    show_bool(encrypt_ctr_fails(c, &badiv, &msg))
    << 0
}
