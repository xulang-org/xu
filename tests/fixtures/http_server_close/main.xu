@main

#net/http

fn app(c http.Context) {
    c.text(200, "srv") or (err) { << }
}

fn run(s http.Server) {
    s.serve(app)
}

fn main() int {
    mut s := http.new_server()
    s.listen("127.0.0.1:19970") or (err) {
        println(err.msg())
        << 1
    }
    xu run(s)
    sleep_ns(50000000)
    mut cli := http.new_client()
    r := cli.get("http://127.0.0.1:19970/") or (err) {
        println(err.msg())
        s.close()
        << 1
    }
    println(r.status_code())
    println(r.body())
    s.close()
    << 0
}
