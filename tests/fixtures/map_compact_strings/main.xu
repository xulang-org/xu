@main
fn main() int {
 mut m := map[string]string{}
 for i in 0:32 { m[str(i)] = "v" + str(i) }
 mut start := 12
 mut total := 0
 for round in 0:8 {
  for j in 0:20 { m.delete(str(start + j)) }
  start = 32 + round * 20
  for j in 0:20 { m[str(start + j)] = "v" + str(j) }
  m["0"] = "keep" + str(round)
  for j in 0:20 { total += m.get_or(str(start + j), "bad").len }
 }
 t := m.take(str(start))
 m.delete("missing")
 println(total)
 println(t)
 println(m.len())
 << 0
}
