@main
fn sender(ch chan int) {
    ch <- 7
    println(99)
}

fn spin() {
    mut i := 0
    while i < 20000000 {
        i = i + 1
    }
}

fn main() int {
    ch := chan int{cap: 0}
    xu sender(ch)
    // `go` pumps synchronously: the sender is parked before close() below,
    // so this deterministically exercises close-while-sender-parked.
    close(ch)
    spin()
    << 0
}
