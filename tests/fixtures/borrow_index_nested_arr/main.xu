@main

fn main() int {
    mut xs := [][]int{}
    mut a := []int{}
    a.push(1)
    a.push(8)
    xs.push(a)
    mut b := []int{}
    b.push(3)
    xs.push(b)
    mut i := 1
    r := &xs[i]
    i += 1
    println(r[0])
    println(r.len)
    p := &r[0]
    println(*p)
    q := &xs[0][1]
    println(*q)
    << 0
}
