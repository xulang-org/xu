@main
#math
#strings
fn churn(value int, shift int) int {
    mut x := value
    x = x ^ ((x >> 30) & 17179869183)
    x = x * (0 - 4658895280553007687)
    x = x ^ ((x >> 27) & 137438953471)
    x = x * (0 - 7723592293110705685)
    x = x ^ ((x >> 31) & 8589934591)
    << x ^ (x << shift)
}
fn six(a int, b int, c int, d int, e int, f int) int {
    mut x := a + b * 7
    x = (x ^ c) - d
    x = x * e + f
    << (x >> 17) ^ (x << 19)
}
fn branch(value int) int {
    if value < 0 { << value * 31 }
    << value - 99
}
fn addressed(value int) int {
    mut x := value
    p := mut &x
    *p = *p ^ 1229782938247303441
    << x
}
fn compare(a int, b int) bool { << (a ^ 7) < (b + 31) }
fn main() int {
    for i in 0:96 {
        v := (i * 391 - 12345) ^ (i << 57)
        k := i % 67 - 1
        println(churn(v, k))
        println(six(v, i, -i, v ^ i, 0 - i - 7, i << 53))
        println(branch(v))
        println(addressed(v))
        println(compare(v, i))
    }
    println(math.sqrt(9.0))
    println("abc".len)
    << 0
}
