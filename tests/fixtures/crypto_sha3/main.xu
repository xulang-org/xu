@main

#crypto/sha3
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    e := ""
    abc := "abc"
    hw := "hello world"
    println(sha3.sum256(e + ""))
    println(sha3.sum256(abc + ""))
    println(sha3.sum256(hw + ""))
    show_bool(sha3.sum256(e + "") == "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a")
    show_bool(sha3.sum256(abc + "") == "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532")
    sh := sha3.shake_sum128(&e, 32)
    println(hex.encode_to_string(sh + ""))
    show_bool(hex.encode_to_string(sh + "") == "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26")
    mut d := sha3.new256()
    p1 := "ab"
    d.write(&p1)
    p2 := "c"
    d.write(&p2)
    println(d.sum())
    d.reset()
    println(d.sum())
    println(d.size())
    println(d.blocksize())
    << 0
}
