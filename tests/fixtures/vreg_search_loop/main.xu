@main

#sort

// Regression for the Arm64 one-slot indexed-search hot edge.  The loop
// prefix is leaf-shaped, but the back-edge skips that prefix; every scalar
// temp feeding the midpoint calculation must therefore be materialized in a
// separate ALU home instead of relying on a stale frame value.
fn search_sum(a &[]int) int {
    mut total := 0
    mut q := 0
    while q < 4000000 {
        v := ((q * 1103515245 + 12345) & 0x3FFFF) * 3
        total += sort.search_ints(a, v)
        q += 1
    }
    << total
}

fn main() int {
    mut a := []int{}
    mut i := 0
    while i < 131072 {
        a.push(i * 3)
        i += 1
    }
    println(search_sum(&a))
    << 0
}
