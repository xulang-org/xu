@main

#crypto/sm9
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    ks := hex.decode_string("0130e78459d78545cb54c587e02cf480ce0b66340f319f348a1d5b1f2dc5f4") or (err) {
        << 1
    }
    alice := "Alice"
    dsa := sm9.sign_user_key(&ks, &alice) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(dsa + ""))

    mpk := sm9.sign_master_public(&ks) or (err) {
        println(err.msg())
        << 1
    }
    msg := "Chinese IBS standard"
    r := hex.decode_string("033c8616b06704813203dfd00965022ed15975c662337aed648835dc4b1cbe") or (err) {
        << 1
    }
    sig := sm9.sign_r(&dsa, &mpk, &msg, &r) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(sig + ""))
    show_bool(sm9.verify(&mpk, &alice, &msg, &sig))

    mut bad := []int{}
    mut i := 0
    while i < sig.len {
        bad.push(sig[i] & 255)
        i = i + 1
    }
    bad[0] = bad[0] ^ 1
    bads := string_from_bytes(bad)
    show_bool(sm9.verify(&mpk, &alice, &msg, &bads))

    ke := hex.decode_string("01edee3778f441f8dea3d9fa0acc4e07ee36c93f9a08618af4ad85cede1c22") or (err) {
        << 1
    }
    bob := "Bob"
    emp := sm9.enc_master_public(&ke) or (err) {
        println(err.msg())
        << 1
    }
    duk := sm9.enc_user_key(&ke, &bob) or (err) {
        println(err.msg())
        << 1
    }
    pt := "Chinese IBE standard"
    rr := hex.decode_string("aac0541779c8fc45e3e2cb25c12b5d2576b2129ae8bb5ee2cbe5ec9e785c") or (err) {
        << 1
    }
    ct := sm9.encrypt_r(&emp, &bob, &pt, &rr) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(ct + ""))
    back := sm9.decrypt(&duk, &bob, &ct) or (err) {
        println(err.msg())
        << 1
    }
    println(back)
    << 0
}
