@main

#hash/crc32

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    s := "a"
    k := crc32.checksum_koopman(&s)
    k2 := crc32.checksum_koopman(&s)
    show_bool(k == k2)
    show_bool(k != crc32.checksum_ieee(&s))
    << 0
}
