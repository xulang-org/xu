@main

#unicode
#unicode/utf8

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    show_bool(unicode.is_space(32))
    show_bool(unicode.is_space(0x85))
    show_bool(unicode.is_space(0x2028))
    show_bool(unicode.is_space(0x2029))
    show_bool(unicode.is_control(7))
    show_bool(unicode.is_print(65))
    show_bool(unicode.is_punct(44))
    show_bool(unicode.is_number(53))
    println(unicode.to_title(97))
    println(unicode.max_rune_value())
    show_bool(utf8.valid_rune(0x41))
    show_bool(utf8.valid_rune(0xD800))
    cafe := "café"
    show_bool(utf8.full_rune(&cafe))
    println(utf8.decode_last(&cafe) or (err) { << 1 })
    a := "a"
    println(utf8.append_rune(&a, 98) or (err) { << 1 })
    << 0
}
