@main
fn sender(n int, ch chan int) {
    ch <- n
}

fn spin() {
    mut i := 0
    while i < 20000000 {
        i = i + 1
    }
}

fn main() int {
    ch := chan int{cap: 0}
    xu sender(1, ch)
    xu sender(2, ch)
    // small spin so both senders park before temp recv (multi-waiter race)
    spin()
    x := <-ch
    y := <-ch
    println(x + y)
    println(x * y)
    << 0
}
