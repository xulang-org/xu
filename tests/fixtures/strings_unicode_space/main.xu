@main

#strings
#bytes
#encoding/hex

fn dump(parts []string) {
    println(parts.len)
    for i in 0:parts.len {
        println(hex.encode_to_string(parts[i] + ""))
    }
}

fn main() int {
    s0 := string_from_bytes([9, 65, 9, 66, 9])
    println(hex.encode_to_string(strings.trim_space(&s0)))
    dump(strings.fields(&s0))
    println(hex.encode_to_string(bytes.trim_space(&s0)))
    dump(bytes.fields(&s0))
