@main

#net/http
#net/http/httptest

fn app(c http.Context) {
    p := c.path()
    if p == "/hello" {
        c.text(200, "ok") or (err) { << }
        <<
    }
    c.text(404, "no") or (err) { << }
}

fn main() int {
    mut srv := httptest.new_server(app) or (err) {
        println(err.msg())
        << 1
    }
    sleep_ns(50000000)
    mut cli := http.new_client()
    u1 := srv.url + "/hello"
    r1 := cli.get(u1) or (err) {
        println(err.msg())
        srv.close()
        << 1
    }
    println(r1.status_code())
    println(r1.body())
    u2 := srv.url + "/nope"
    r2 := cli.get(u2) or (err) {
        println(err.msg())
        srv.close()
        << 1
    }
    println(r2.status_code())
    srv.close()
    << 0
}
