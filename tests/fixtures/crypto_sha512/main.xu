@main

#crypto/sha512
#strings

fn main() int {
    println(sha512.sum(""))
    println(sha512.sum("abc"))
    println(sha512.sum("hello world"))
    a := "a"
    println(sha512.sum(strings.repeat(&a, 55)))
    println(sha512.sum(strings.repeat(&a, 56)))
    println(sha512.sum(strings.repeat(&a, 63)))
    println(sha512.sum(strings.repeat(&a, 64)))
    println(sha512.sum(strings.repeat(&a, 111)))
    println(sha512.sum(strings.repeat(&a, 112)))
    xus := "Xu"
    println(sha512.sum(strings.repeat(&xus, 100)))
    mut d := sha512.new()
    p1 := "ab"
    d.write(&p1)
    p2 := "c"
    d.write(&p2)
    println(d.sum())
    d.reset()
    println(d.sum())
    println(d.size())
    println(d.blocksize())
    << 0
}
