@main

#os

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    p := os.lookup_env("PATH")
    show_bool(p.found)
    show_bool(p.value.len > 0)
    miss := os.lookup_env("XU_NO_SUCH_ENV_9f3a2")
    show_bool(miss.found)
    show_bool(miss.value.len == 0)
    g := os.getenv("PATH")
    show_bool(g.len == p.value.len)
    << 0
}
