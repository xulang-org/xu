@main
// Recycle unbuffered waiter nodes across many rendezvous (resource debt close).
fn sender(ch chan int, n int) {
    mut i := 0
    while i < n {
        ch <- i
        i = i + 1
    }
}

fn main() int {
    n := 200
    ch := chan int{cap: 0}
    xu sender(ch, n)
    mut s := 0
    mut i := 0
    while i < n {
        v := <-ch
        s = s + v
        i = i + 1
    }
    println(s)
    << 0
}
