@main
struct Trace {
    count int
    digits int
}
struct Buffer { values []int }
fn touch(state &mut Trace, digit int) int {
    state.count += 1
    state.digits = state.digits * 10 + digit
    << digit
}
fn extend(buffer &mut Buffer, value int) int {
    buffer.values.push(value)
    << buffer.values.len
}
fn nested(state &mut Trace, seed int) int {
    zero := touch(mut &*state, seed + 3) * 0
    << zero + touch(mut &*state, seed + 4)
}
fn pair(state &mut Trace, seed int) int {
    lhs := touch(mut &*state, seed + 5)
    rhs := touch(mut &*state, seed + 6)
    << lhs + rhs
}
fn main() int {
    for seed in 0:32 {
        mut state := Trace{count: 0, digits: 0}
        println(touch(mut &state, seed + 1) * 0)
        println(state.count)
        println(state.digits)
        println(0 * touch(mut &state, seed + 2))
        println(state.count)
        println(state.digits)
        println(nested(mut &state, seed))
        println(state.count)
        println(state.digits)
        println(0 * (pair(mut &state, seed)))
        println(state.count)
        println(state.digits)
        println((91 / touch(mut &state, seed + 7)) * 0)
        println(state.count)
        println(state.digits)
        mut buffer := Buffer{values: []int{}}
        buffer.values.push(seed - 9)
        buffer.values.push(seed + 9)
        println(buffer.values[touch(mut &state, 0)] * 0)
        println(state.count)
        println(state.digits)
        println(false && touch(mut &state, 9) > 0)
        println(state.count)
        println(state.digits)
        println(true || touch(mut &state, 9) > 0)
        println(state.count)
        println(state.digits)
        println(touch(mut &state, seed + 8) * (7 - 7))
        println(state.count)
        println(state.digits)
        println((7 - 7) * touch(mut &state, seed + 9))
        println(state.count)
        println(state.digits)
        println(0 * extend(mut &buffer, seed * 13 - 7))
        println(buffer.values.len)
        println(buffer.values[2])
    }
    << 0
}
