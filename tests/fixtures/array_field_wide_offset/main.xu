@main
struct Wide {
    pad0 []int
    pad1 []int
    pad2 []int
    pad3 []int
    pad4 []int
    pad5 []int
    pad6 []int
    pad7 []int
    pad8 []int
    pad9 []int
    pad10 []int
    pad11 []int
    tag int
    tail []int
}
fn update(w &mut Wide, p int, q int) int {
    w.pad0[p] = w.pad0[p] + w.tail[q]
    w.tail[q] = w.pad0[p] ^ w.tail[q]
    w.pad0[p] = w.pad0[p] - w.tail[q]
    << w.pad0[p] + w.tail[q]
}
fn main() int {
    for k in 0:32 {
        mut a := []int{}
        mut b := []int{}
        for j in 0:4 { a.push((j * 17 - k * 31) ^ (k << 56)) }
        for j in 0:5 { b.push((k * 23 - j * 11) ^ (j << 55)) }
        mut w := Wide{pad0: a, pad1: []int{}, pad2: []int{}, pad3: []int{}, pad4: []int{}, pad5: []int{}, pad6: []int{}, pad7: []int{}, pad8: []int{}, pad9: []int{}, pad10: []int{}, pad11: []int{}, tag: 97, tail: b}
        println(update(mut &w, k & 3, k % 5))
        println(w.tag)
        for j in 0:4 { println(w.pad0[j]) }
        for j in 0:5 { println(w.tail[j]) }
        println(w.pad1.len)
        println(w.pad2.len)
        println(w.pad3.len)
        println(w.pad4.len)
        println(w.pad5.len)
        println(w.pad6.len)
        println(w.pad7.len)
        println(w.pad8.len)
        println(w.pad9.len)
        println(w.pad10.len)
        println(w.pad11.len)
    }
    << 0
}
