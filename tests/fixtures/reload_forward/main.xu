@main

// The straight-line reload forward must not cross a call or a branch.
// touch aliases the local; the loop reads the value stored on the back edge.

fn touch(p &mut int) {
    *p = *p + 1
}

fn main() int {
    mut x := 40
    touch(mut &x)
    println(x)
    mut s := 0
    mut i := 0
    while i < 5 {
        s = s + x
        x = x + 1
        i = i + 1
    }
    println(s)
    println(x)
    << 0
}
