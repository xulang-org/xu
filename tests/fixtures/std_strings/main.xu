@main

#strings

fn main() int {
    s := "hello"
    println(strings.contains(&s, "ell"))
    println(strings.contains(&s, "xyz"))
    println(strings.index_of(&s, "l"))
    println(strings.ends_with(&s, "lo"))
    println(strings.ends_with(&s, "he"))
    t := "  hi  "
    println(strings.trim_space(&t))
    println(strings.repeat(&s, 2))
    parts := ["a", "b", "c"]
    println(strings.join(parts, ","))
    csv := "x,y,z"
    bits := strings.split(&csv, ",")
    println(bits.len)
    println(bits[0])
    println(bits[2])
    extra()
    << 0
}
    fn extra() {
    hello := "hello"
    println(strings.has_prefix(&hello, "he"))
    println(strings.has_prefix(&hello, "lo"))
    println(strings.has_suffix(&hello, "lo"))
    banana := "banana"
    println(strings.replace(&banana, "an", "X", -1))
    println(strings.replace(&banana, "an", "X", 1))
    abc := "abc"
    println(strings.replace(&abc, "d", "x", -1))
    fs := "  a b\t c \n"
    f := strings.fields(&fs)
    println(f.len)
    println(f[0])
    println(f[2])
    abc2 := "AbC"
    println(strings.to_lower(&abc2))
    println(strings.to_upper(&abc2))
    xx := "xxhixx"
    println(strings.trim(&xx, "x"))
    xx2 := "xxhi"
    println(strings.trim_left(&xx2, "x"))
    xx3 := "hixx"
    println(strings.trim_right(&xx3, "x"))
    println(strings.trim_prefix(&hello, "he"))
    println(strings.trim_suffix(&hello, "lo"))
}
