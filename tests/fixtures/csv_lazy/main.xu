@main

#encoding/csv

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn strict_fails() bool {
    mut r := csv.new_reader("foo\"bar,baz\n")
    r.read() or (err) { << true }
    << false
}

fn main() int {
    show_bool(strict_fails())
    mut r := csv.new_reader("foo\"bar,baz\n")
    r.set_lazy_quotes(true)
    row := r.read() or (err) { << 1 }
    println(row.len)
    println(row[0])
    println(row[1])
    mut t := csv.new_reader("a, b\n")
    t.set_trim_leading_space(true)
    row2 := t.read() or (err) { << 1 }
    println(row2[1])
    mut f := csv.new_reader("a,b,c\n")
    f.set_fields_per_record(2)
    f.read() or (err) {
        println("bad")
        << 0
    }
    println("ok")
    << 0
}
