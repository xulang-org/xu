@main

struct Item {
    pub s string
    pub n int
}

fn main() int {
    mut n := 0
    for i in 0:10000 {
        mut xs := []Item{}
        xs.push(Item{s: "old", n: 1})
        r := mut &xs[0]
        r.s = "new"
        r.n = 2
        if xs[0].s == "new" {
            n += xs[0].n
        }
    }
    println(n)
    println("ok")
    << 0
}
