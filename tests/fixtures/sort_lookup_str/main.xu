@main

#sort

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    a := ["a", "c", "e"]
    h := sort.lookup_strings(&a, "c")
    println(h.index)
    show_bool(h.found)
    m := sort.lookup_strings(&a, "d")
    println(m.index)
    show_bool(m.found)
    f := [1.0, 3.0, 5.0]
    p := sort.lookup_f64s(&f, 5.0)
    println(p.index)
    show_bool(p.found)
    << 0
}
