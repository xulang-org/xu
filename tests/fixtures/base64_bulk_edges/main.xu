@main
#encoding/base64 as b64
#encoding/hex
fn check(s string, enc string, url string, raw string, rawurl string) bool {
    if b64.encode_to_string(s) != enc { << false }
    if b64.encode_url(s) != url { << false }
    if b64.encode_raw(s) != raw { << false }
    if b64.encode_raw_url(s) != rawurl { << false }
    d := b64.decode_string(enc + "") or (err) { << false }
    u := b64.decode_url(url) or (err) { << false }
    r := b64.decode_raw(raw) or (err) { << false }
    ru := b64.decode_raw_url(rawurl) or (err) { << false }
    if d != s || u != s || r != s || ru != s { << false }
    mut lines := "\r\n"
    for i in 0:enc.len {
        lines.push_byte(enc[i])
        if i % 3 == 0 { lines.push_str("\r\n") }
    }
    decoded_lines := b64.decode_string(lines) or (err) { << false }
    << decoded_lines == s
}
fn error(s string) string {
    b64.decode_string(s) or (err) { << err.msg() }
    << "OK"
}
