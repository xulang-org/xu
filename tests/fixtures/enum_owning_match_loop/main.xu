@main
enum Slot {
    Empty
    Full(string)
}

fn main() int {
    mut n := 0
    for i in 0:10000 {
        s := "ab" + "cd"
        e := Slot.Full(s)
        match e {
            Slot.Empty {
                n += 0
            }
            Slot.Full(x) {
                n += x.len
            }
        }
    }
    println(n)
    println("ok")
    << 0
}
