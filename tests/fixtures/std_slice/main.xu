@main

#slices
#cmp

fn main() int {
    a := [1, 2, 3]
    println(slices.contains_int(a, 2))
    b := [1, 2, 3]
    println(slices.contains_int(b, 9))
    ys := [10, 20, 30]
    println(slices.index_of_int(ys, 30))
    zs := [10, 20, 30]
    println(slices.index_of_int(zs, 0))
    nums := [4, 5, 6]
    println(slices.sum_int(nums))
    w1 := ["aa", "bb"]
    println(slices.contains_str(w1, "bb"))
    w2 := ["aa", "bb"]
    println(slices.contains_str(w2, "cc"))
    ea := [1, 2, 3]
    eb := [1, 2, 3]
    println(slices.equal_ints(&ea, &eb))
    ec := [1, 2, 4]
    println(slices.equal_ints(&ea, &ec))
    s1 := ["a", "b"]
    s2 := ["a", "b"]
    println(slices.equal_strs(&s1, &s2))
    ws := ["x", "y", "z"]
    println(slices.index_of_str(ws, "y"))
    ws2 := ["x", "y", "z"]
    println(slices.index_of_str(ws2, "q"))
    src := [7, 8, 9]
    c := slices.clone_ints(&src)
    println(c.len)
    println(c[0])
    ss := ["hi", "there"]
    cs := slices.clone_strs(&ss)
    println(cs[1])
    mut rv := [1, 2, 3, 4]
    slices.reverse_ints(mut &rv)
    println(rv[0])
    println(rv[3])
    mut rsv := ["p", "q", "r"]
    slices.reverse_strs(mut &rsv)
    println(rsv[0])
    println(rsv[2])

    println(cmp.less_int(1, 2))
    println(cmp.compare_int(2, 1))
    println(cmp.compare_int(3, 3))
    println(cmp.less_string("a", "b"))
    println(cmp.compare_string("b", "a"))
    println(cmp.less_f64(1.0, 2.0))
    println(cmp.compare_f64(2.5, 2.5))

    fa := [1.0, 1.0, 2.0, 2.0, 3.0]
    cf := slices.compact_f64s(&fa)
    println(cf.len)
    println(cf[1])
    fb := [1.0, 3.0]
    insf := slices.insert_f64(&fb, 1, 2.0)
    println(insf[1])
    delf := slices.delete_f64s(&fa, 1, 3)
    println(delf.len)
    fc := [1.0, 2.0]
    fd := [1.0, 3.0]
    println(slices.compare_f64s(&fc, &fd))
    si := [1, 3, 5, 7]
    bi := slices.binary_search_ints(&si, 5)
    println(bi.index)
    println(bi.found)
    bj := slices.binary_search_ints(&si, 4)
    println(bj.index)
    println(bj.found)
    names := ["a", "c", "e"]
    bs := slices.binary_search_strs(&names, "c")
    println(bs.index)
    println(bs.found)
    ff := [1.0, 2.5, 3.0]
    bf := slices.binary_search_f64s(&ff, 2.5)
    println(bf.index)
    println(bf.found)
    << 0
}
