@main
struct Box { pad int
    entries []int }
fn reading(b &Box, pos int) int {
    mut index := pos
    mut sum := b.entries[index]
    index += 1
    sum += b.entries[index]
    << sum
}
fn main() int {
    mut values := []int{}
    values.push(7)
    box := Box{pad: 19, entries: values}
    println(3)
    println(reading(&box, 0))
    << 0
}
