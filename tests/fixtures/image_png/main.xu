@main

#encoding/hex
#image
#image/color
#image/png

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn decode_png_fails(raw &string) bool {
    png.decode(raw) or (err) { << true }
    << false
}

fn main() int {
    gohex := "89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a730000001b49444154789c62facfc0c0f09f818591e1ff7f060640000000ffff1d2f0404f0915d150000000049454e44ae426082"
    raw := hex.decode_string(gohex + "") or (err) { << 1 }
    img := png.decode(&raw) or (err) { << 1 }
    a := img.at_rgba(0, 0)
    println(a.r)
    println(a.g)
    println(a.b)
    println(a.a)
    b := img.at_rgba(1, 0)
    println(b.g)
    c := img.at_rgba(0, 1)
    println(c.b)
    d := img.at_rgba(1, 1)
    println(d.r)
    println(d.g)
    println(d.b)
    mut src := image.new_rgba(image.rect(0, 0, 2, 2))
    src.set_rgba(0, 0, color.RGBA{r: 255, g: 0, b: 0, a: 255})
    src.set_rgba(1, 0, color.RGBA{r: 0, g: 255, b: 0, a: 255})
    src.set_rgba(0, 1, color.RGBA{r: 0, g: 0, b: 255, a: 255})
    src.set_rgba(1, 1, color.RGBA{r: 255, g: 255, b: 255, a: 255})
    enc := png.encode_rgba(&src) or (err) { << 1 }
    back := png.decode(&enc) or (err) { << 1 }
    e := back.at_rgba(0, 0)
    show_bool(e.r == 255 && e.a == 255)
    f := back.at_rgba(1, 0)
    show_bool(f.g == 255)
    g := back.at_rgba(0, 1)
    show_bool(g.b == 255)
    bad := "notpng"
    show_bool(decode_png_fails(&bad))
    << 0
}
