@main

#log
#fmt

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn is_digit(c int) bool {
    << c >= 48 && c <= 57
}

fn main() int {
    mut l := log.new_logger()
    l.set_output_buffer()
    l.set_flags(log.lstd_flags)
    l.print(fmt.s("hi"))
    b := l.buffer_text()
    // "YYYY/MM/DD HH:MM:SS hi\n"
    show_bool(b.len >= 23)
    show_bool(is_digit(b[0] & 255) && is_digit(b[1] & 255))
    show_bool((b[4] & 255) == 47 && (b[7] & 255) == 47)
    show_bool((b[10] & 255) == 32)
    show_bool((b[13] & 255) == 58 && (b[16] & 255) == 58)
    show_bool((b[19] & 255) == 32)
    show_bool((b[20] & 255) == 104 && (b[21] & 255) == 105)
    mut l2 := log.new_logger()
    l2.set_output_buffer()
    l2.set_flags(log.ldate | log.ltime | log.lmicroseconds | log.lutc)
    l2.print(fmt.s("x"))
    b2 := l2.buffer_text()
    mut has_dot := false
    for i in 0:b2.len {
        if (b2[i] & 255) == 46 {
            has_dot = true
        }
    }
    show_bool(has_dot)
    mut l3 := log.new_logger()
    l3.set_output_buffer()
    l3.set_flags(0)
    l3.print(fmt.s("plain"))
    show_bool(l3.buffer_text() == "plain\n")

    show_bool(log.lstd_flags == (log.ldate | log.ltime))
    << 0
}
