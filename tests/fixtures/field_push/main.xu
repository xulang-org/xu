@main
struct Buf {
    name string
    n    int
    code []int
}

fn (b &mut Buf) pushv(v int) { b.code.push(v) }

fn main() int {
    // Array field at a non-zero slot offset, grown through a mut method.
    mut b := Buf{name: "keepme", n: 7, code: []int{}}
    b.pushv(11)
    b.pushv(22)
    println(b.code.len)
    println(b.code[0])
    println(b.code[1])
    println(b.name)
    println(b.n)
    // Owning-string elements through a field push as well.
    mut tags := Tags{items: []string{}}
    tags.items.push("a" + "1")
    tags.items.push("b")
    println(tags.items.len)
    println(tags.items[0])
    println(tags.items[1])
    << 0
}
    struct Tags { items []string }
