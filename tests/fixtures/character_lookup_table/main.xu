@main
#strings
fn map_bytes(src &string, table &string) string {
    mut dst := make_string(src.len)
    n := src.len
    mut i := 0
    while i < n {
        dst[i] = table[src[i] & 255]
        i += 1
    }
    << dst
}
fn map_groups(src &string, table &string) string {
    n := src.len / 3
    mut dst := make_string(n * 4)
    mut i := 0
    while i < n {
        dst[i * 4] = table[src[i * 3] & 63]
        dst[i * 4 + 1] = table[src[i * 3 + 1] & 63]
        dst[i * 4 + 2] = table[src[i * 3 + 2] & 63]
        dst[i * 4 + 3] = table[(src[i * 3] + src[i * 3 + 2]) & 63]
        i += 1
    }
    << dst
}
fn sparse(src &string, table &string, n int) string {
    mut dst := make_string(n)
    mut i := 0
    while i < n {
        dst[i] = table[src[i * 3] & 3]
        i += 1
    }
    << dst
}
fn main() int {
    mut table := make_string(256)
    for i in 0:256 { table[i] = (i * 73 + 19) & 255 }
    sizes := [9]int{0, 1, 2, 3, 7, 16, 255, 256, 2049}
    for ni in 0:9 {
        n := sizes[ni]
        mut src := make_string(n)
        for i in 0:n { src[i] = (i * 113 + n) & 255 }
        got := map_bytes(&src, &table)
        for i in 0:n { if got[i] != ((src[i] * 73 + 19) & 255) { << 1 } }
        grouped := map_groups(&src, &table)
        for i in 0:n / 3 {
            if grouped[i * 4] != table[src[i * 3] & 63] { << 2 }
            if grouped[i * 4 + 1] != table[src[i * 3 + 1] & 63] { << 3 }
            if grouped[i * 4 + 2] != table[src[i * 3 + 2] & 63] { << 4 }
            if grouped[i * 4 + 3] != table[(src[i * 3] + src[i * 3 + 2]) & 63] { << 5 }
        }
    }
    // A 255 mask does not require a 256-byte table when actual indexes fit.
    short := "xyz"
    mut src := make_string(5)
    src[0] = 0
    src[1] = 1
    src[2] = 2
    src[3] = 1
    src[4] = 0
    if map_bytes(&src, &short) != "xyzyx" { << 6 }
    // Distinct descriptors may alias the same readonly backing data.
    aliased := map_bytes(&table, &table)
    for i in 0:256 { if aliased[i] != table[table[i] & 255] { << 7 } }
    mut backing := "!xyz," + ""
    backing.push_byte(2)
    backing.push_byte(0)
    backing.push_byte(1)
    backing.push_byte(33)
    parts := strings.split(&backing, ",")
    tabview := parts[0][1:4]
    srcview := parts[1][0:3]
    if map_bytes(&srcview, &tabview) != "zxy" { << 8 }
    // Full-span guards are sufficient, not necessary: a sparse last group
    // can legally touch only its first byte in a short input buffer.
    mut partial := make_string(7)
    partial[0] = 1
    partial[3] = 2
    partial[6] = 3
    four := "abcd"
    if sparse(&partial, &four, 3) != "bcd" { << 9 }
    println("PASS")
    << 0
}
