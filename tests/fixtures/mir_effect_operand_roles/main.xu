@main
#xu/types

fn main() int {
    for kind in 0:49 {
        m := types.mir_operand_probe(kind)
        front := types.mir_operand_probe_front(kind)
        verify := types.mir_operand_probe_verify(kind)
        counts := types.mir_operand_probe_counts(kind, 1)
        for t in 0:224 {
            println(front[t])
            println(verify[t])
            println(types.mir_instr_uses_temp_m(&m, 0, 0, t))
            println(counts[t])
        }
        println(types.mir_operand_probe_reversible(kind))
    }
    for mode in 0:12 {
        m := types.mir_operand_edge_probe(mode)
        front := types.mir_operand_edge_front(&m, false)
        verify := types.mir_operand_edge_front(&m, true)
        counts := types.mir_operand_edge_counts(&m, 1)
        marked := types.mir_operand_edge_counts(&m, 0)
        for t in 0:8 {
            println(front[t])
            println(verify[t])
            println(types.mir_instr_uses_temp_m(&m, 0, 0, t))
            println(counts[t])
            println(marked[t])
        }
        println(types.mir_operand_edge_reversible(&m))
    }
    for stage in 0:3 { println(types.mir_operand_box_dce_probe(stage)) }
    println(types.mir_instr_use_schema(13, 0))
    println(types.mir_instr_use_schema(31, 0))
    << 0
}
