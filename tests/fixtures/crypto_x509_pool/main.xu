@main

#crypto/x509

fn main() int {
    cert := "-----BEGIN CERTIFICATE-----\nMIIB6DCCAY2gAwIBAgIUZsahSJ/YQx83HrY5/lDWpUESCT4wCgYIKoZIzj0EAwIw\nNTELMAkGA1UEBhMCVVMxCzAJBgNVBAoMAlh1MRkwFwYDVQQDDBB4dS1lY2RzYS5l\neGFtcGxlMB4XDTI2MDgzMDIwNTQ1OVoXDTM2MDgyNzIwNTQ1OVowNTELMAkGA1UE\nBhMCVVMxCzAJBgNVBAoMAlh1MRkwFwYDVQQDDBB4dS1lY2RzYS5leGFtcGxlMFkw\nEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEAjOR39Mb9F0+By5cP6L8ntMlhfW8lpoy\nvYBvSlT1jgAOAgmDDZPo0qUvg18nD71uExJu7TZwcIU6WGSqWBHrgaN7MHkwHQYD\nVR0OBBYEFPrDeQwFvSfzQx9zP4prhhXCo2FxMB8GA1UdIwQYMBaAFPrDeQwFvSfz\nQx9zP4prhhXCo2FxMCYGA1UdEQQfMB2CEHh1LWVjZHNhLmV4YW1wbGWCCWxvY2Fs\naG9zdDAPBgNVHRMBAf8EBTADAQH/MAoGCCqGSM49BAMCA0kAMEYCIQDgwjfxk6Ip\nm9tzNTIiIXJSMnsgyorP2VVOjmTjK03gIQIhANnJq3dyYJf14By8uF98Vl3y+2L4\n+MUlUAvxCbwbVaA8\n-----END CERTIFICATE-----\n"
    note := "-----BEGIN NOTE-----\neA==\n-----END NOTE-----\n"
    unterminated := "-----BEGIN CERTIFICATE-----\n"
    bundle := note + unterminated + cert + cert
    mut pool := x509.new_cert_pool()
    n := x509.append_certificates(mut &pool, &bundle)
    println(n)
    println(pool.certs.len)
    println(pool.certs[0].subject.common_name == "xu-ecdsa.example")

    none := "not a pem bundle"
    println(x509.append_certificates(mut &pool, &none) == 0)

    // Unix runners expose a conventional PEM bundle. Platform matrices also
    // set SSL_CERT_FILE here to keep this fixture deterministic; the separate
    // crypto_x509_system_pool fixture exercises Windows CryptoAPI fallback.
    sys := x509.system_cert_pool()
    if xu_target_os() == 2 {
        println(sys.certs.len >= 0)
    } else {
        println(sys.certs.len > 0)
    }
    << 0
}
