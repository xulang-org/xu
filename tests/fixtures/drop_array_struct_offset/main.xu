@main
fn main() int {
    // Owning string field at a non-zero slot offset inside an array element:
    // the scope-end drop walks the buffer and frees each element's string.
    // (Regression: the struct drop helper used to clobber S1 without saving
    // it, corrupting the caller's drop state — M6b2-s2.)
    mut xs := []Rec{}
    xs.push(Rec{n: 1, s: "alpha"})
    xs.push(Rec{n: 2, s: "beta"})
    println(xs[0].s)
    println(xs[1].n)
    mut ys := []Rec{}
    for i in 0:5 {
        ys.push(Rec{n: i, s: "v"})
    }
    println(ys.len)
    println(ys[4].s)
    << 0
}
    struct Rec {
    n int
    s string
}
