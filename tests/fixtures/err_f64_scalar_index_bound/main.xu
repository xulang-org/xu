@main

fn advance(dst &mut []u8, source &[]int, count int) {
    mut z := 0.5
    for i in 0:count {
        z += f64(source[i]) * 0.25
        if z < 4.0 { dst[i] = u8(1) }
    }
}

fn main() int {
    mut dst := []u8{}
    dst.push(u8(0))
    dst.push(u8(0))
    mut source := []int{}
    source.push(1)
    count := dst.len
    advance(mut &dst, &source, count)
    << 0
}
