@main

fn lsr1(x int) int { << (x >> 1) & ((1 << 63) - 1) }
fn lsr8(x int) int { << (x >> 8) & ((1 << 56) - 1) }
fn lsr32(x int) int { << (x >> 32) & ((1 << 32) - 1) }
fn lsr63(x int) int { << (x >> 63) & 1 }

fn main() int {
    x := -9223372036854775807 - 1
    println(str(lsr1(x)))
    println(str(lsr8(x)))
    println(str(lsr32(x)))
    println(str(lsr63(x)))
    << 0
}
