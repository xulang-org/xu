@main

#crypto/x509
#encoding/pem
#time

fn main() int {
    pem_text := "-----BEGIN CERTIFICATE-----\nMIICDjCCAXegAwIBAgIUKGMI2OTDDaHSY9wF3eAqDQLyWP4wDQYJKoZIhvcNAQEL\nBQAwGTEXMBUGA1UEAwwOeHUtcnNhLmV4YW1wbGUwHhcNMjYwODIxMTcwMzQ2WhcN\nMzYwODE4MTcwMzQ2WjAZMRcwFQYDVQQDDA54dS1yc2EuZXhhbXBsZTCBnzANBgkq\nhkiG9w0BAQEFAAOBjQAwgYkCgYEAxGz9Dax4zSYhS2FedyFR+OMWpZON/nEGe1nr\nB2YfogpZ1oBvRUR3Y4lOfXfq9D8RMlOZJ8njz8NN2110Vprua2QVwthS4D4/endE\nkK/US/dXTq6Ly9flltZfbVrTHJcgyXH0i/rJAAB6iIH+pAY89WF/5vIxm7Uji1s2\nM7dWOYMCAwEAAaNTMFEwHQYDVR0OBBYEFPs2zzFJo6MXoRNrD53Q52nQ4ci7MB8G\nA1UdIwQYMBaAFPs2zzFJo6MXoRNrD53Q52nQ4ci7MA8GA1UdEwEB/wQFMAMBAf8w\nDQYJKoZIhvcNAQELBQADgYEAonVjex0GpcJ1k3NHJDJ9oJrT6dWG1g+dIuUOHVAD\nMmlkYPNFyYt8ph95a91vNWbkdnfSHLQ+B5peBxV6PwtToB8js66GpNTGk0hNswiZ\nkg58zuJX+RdoSMRpD9sTm/vc0P20Bn34apjprADsZ447AT78enG7huCbIfCx6r/W\niKY=\n-----END CERTIFICATE-----\n"
    b := pem.decode(&pem_text)
    if b.typ != "CERTIFICATE" {
        << 1
    }
    mut c := x509.parse_certificate(b.bytes) or (err) {
        println(err.msg())
        << 1
    }
    println(c.subject.common_name)
    println(c.public_key_algorithm)
    println(c.signature_algorithm)
    c.check_signature_from(&c) or (err) {
        println(err.msg())
        << 1
    }
    now := c.not_before.add(time.hour() * 24)
    opts := x509.VerifyOptions{dns_name: "", current_time: now, roots: x509.new_cert_pool(), intermediates: x509.new_cert_pool(), key_usages: []int{}, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    c.verify(opts) or (err) {
        println(err.msg())
        << 1
    }
    println("ok")
    << 0
}
