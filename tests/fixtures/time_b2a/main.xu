@main

#time

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    t := time.date(2000, 1, 2, 3, 4, 5, 0)
    println(t.year())
    println(t.month())
    println(t.day())
    println(t.hour())
    println(t.minute())
    println(t.second())
    println(t.weekday())
    println(t.format_rfc3339())

    t0 := time.unix(0, 0)
    println(t0.weekday())
    println(t0.year())

    leap := time.date(2000, 2, 29, 0, 0, 0, 0)
    println(leap.format_rfc3339())

    u := time.unix(1, 500000000)
    tr := u.truncate(time.second())
    println(tr.unix())
    println(tr.nsec)
    rd := u.round(time.second())
    println(rd.unix())
    println(rd.nsec)
    u2 := time.unix(1, 499999999)
    rd2 := u2.round(time.second())
    println(rd2.unix())
    same := u.truncate(0)
    show_bool(same.equal(u))
    show_bool(time.until(t0) < 0)

    mut tm := time.new_timer(1)
    println(<-tm.c)
    mut tk := time.new_ticker(1)
    println(<-tk.c)
    println(<-tk.c)
    tk.stop()
    << 0
}
