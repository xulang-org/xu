@main
#io
#compress/gzip
#errors

struct Input { data string
    off int
    fail bool
}
fn (r &mut Input) read_n(n int) string {
    if r.off >= r.data.len {
        if r.fail { >> errors.new("reader failed") }
        >> errors.new(io.eof)
    }
    start := r.off
    mut take := n
    if take > 2 { take = 2 }
    if take > r.data.len-start { take = r.data.len-start }
    r.off = r.off + take
    << r.data[start:r.off]
}
struct Output { calls int
    mode int
    data string
}
fn (w &mut Output) write_str(data string) int {
    w.calls = w.calls + 1
    if w.calls == 2 {
        if w.mode == 1 { << 1 }
        if w.mode == 2 { << -1 }
        if w.mode == 3 { << data.len + 1 }
        if w.mode == 4 { >> errors.new("writer failed") }
    }
    w.data = w.data + data
    << data.len
}
fn failure(r &mut Input, w &mut Output) string {
    gzip.copy_stream(w,r) or (err) { << err.msg() }
    << "ok"
}
fn main() int {
    mut c := io.cursor("hello")
    mut b := io.buffer()
    println(gzip.copy_stream(mut &b,mut &c) or (err) { << 1 })
    mut r := gzip.new_reader(b.bytes())
    println(r.read_all() or (err) { << 1 })
    mut e := io.cursor("")
    mut z := io.buffer()
    println(gzip.copy_stream(mut &z,mut &e) or (err) { << 1 })
    mut ez := gzip.new_reader(z.bytes())
    println((ez.read_all() or (err) { << 1 }).len)
    for mode in 0:5 {
        mut input := Input{data:"abcdef",off:0,fail:mode==0}
        mut output := Output{calls:0,mode:mode,data:""}
        println(failure(mut &input,mut &output))
        println(input.off)
        println(output.calls)
    }
    mut ok := Input{data:"abcdef",off:0,fail:false}
    mut out := Output{calls:0,mode:0,data:""}
    println(gzip.copy_stream(mut &out,mut &ok) or (err) { << 1 })
    println(out.calls)
    mut check := gzip.new_reader(out.data)
    println(check.read_all() or (err) { << 1 })
    << 0
}
