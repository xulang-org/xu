@main
#bufio
#io
#errors

struct Source {
    data string
    pos int
    calls int
    max int
    mode int
}
fn (s &mut Source) read_n(n int) string {
    s.calls += 1
    if n > s.max { s.max = n }
    if s.mode == 2 { << "oversized" }
    if s.pos >= s.data.len {
        if s.mode == 1 { >> errors.new("source broke") }
        << ""
    }
    mut take := n
    if take > 1 { take = 1 }
    if take > s.data.len - s.pos { take = s.data.len - s.pos }
    start := s.pos
    s.pos += take
    << s.data[start:s.pos] + ""
}
struct Sink {
    data string
    calls int
    max int
    mode int
}
fn (s &mut Sink) write_str(data string) int {
    s.calls += 1
    if data.len > s.max { s.max = data.len }
    n := data.len
    if s.mode == 1 {
        if n > 1 { s.data = s.data + data[0:1] }
        << 1
    }
    if s.mode == 2 { << 0 - 1 }
    if s.mode == 3 { << n + 1 }
    if s.mode == 4 { >> errors.new("sink broke") }
    s.data = s.data + data
    << n
}
fn write_error(data string, w &mut bufio.BufferedWriter#Sink) string {
    w.write_str(data) or (err) { << err.msg() }
    << "ok"
}
fn flush_error(w &mut bufio.BufferedWriter#Sink) string {
    w.flush() or (err) { << err.msg() }
    << "ok"
}
fn read_error(r &mut bufio.BufferedReader#Source) string {
    r.read_n(3) or (err) { << err.msg() }
    << "ok"
}
fn main() int {
    // Short source chunks are decoded across boundaries without losing bytes.
    mut r := bufio.new_stream_reader_size(Source{data:"😀tail",pos:0,calls:0,max:0,mode:0},2)
    x := r.read_rune() or (err) { << 1 }
    println(x.ch == 128512 && x.size == 4)
    r.unread_rune() or (err) { << 2 }
    println((r.read_rune() or (err) { << 3 }).size)
    println(r.read_string(10) or (err) { << 4 })
    println(r.src.max <= 4)
    calls := r.src.calls
    println((r.read_n(0) or (err) { << 5 }).len)
    println(r.src.calls == calls)
    // A source error is deferred while buffered bytes are still available.
    r.reset(Source{data:"ab",pos:0,calls:0,max:0,mode:1})
    println(r.peek(2) or (err) { << 6 })
    println(r.peek(2) or (err) { << 7 })
    println(r.read_n(1) or (err) { << 8 })
    println(r.read_n(1) or (err) { << 9 })
    println(read_error(mut &r))
    before := r.src.calls
    println(read_error(mut &r))
    println(r.src.calls == before)
    r.reset(Source{data:"",pos:0,calls:0,max:0,mode:2})
    println(read_error(mut &r))
    println(r.buffered())
    // read_n consumes the buffered sequence and is composable with copy_stream.
    r.reset(Source{data:"abcdef",pos:0,calls:0,max:0,mode:0})
    mut w := bufio.new_stream_writer_size(Sink{data:"",calls:0,max:0,mode:0},3)
    println(io.copy_stream(mut &w,mut &r) or (err) { << 10 })
    w.flush() or (err) { << 11 }
    println(w.dst.data)
    println(w.dst.max <= 3)
    // Confirmed short-write prefixes are removed and never replayed.
    w.reset(Sink{data:"",calls:0,max:0,mode:1})
    println(write_error("abcdef",mut &w))
    println(w.dst.data)
    println(w.buf)
    println(w.dst.calls)
    println(flush_error(mut &w))
    println(write_error("Z",mut &w))
    println(w.dst.calls)
    println(w.buf)
    // reset discards pending bytes and clears the sticky failure.
    w.reset(Sink{data:"",calls:0,max:0,mode:0})
    println(write_error("XYZ",mut &w))
    w.flush() or (err) { << 12 }
    println(w.dst.data)
    for mode in 2:5 {
        w.reset(Sink{data:"",calls:0,max:0,mode:mode})
        println(write_error("huge input beyond capacity",mut &w))
        println(w.buf.len == 3)
        println(w.dst.calls)
        println(flush_error(mut &w))
        println(w.dst.calls)
    }
    << 0
}
