@main

fn main() int {
    ch := chan int{cap: 1}
    let e: temp = 1
    select {
        x := <-ch {
            v := e as int
            println(v)
        }
        else {
            println("no")
        }
    }
    let f: temp = 2
    ch <- 7
    select {
        x := <-ch {
            w := f as int
            println(w)
        }
        else {
            println("no")
        }
    }
    << 0
}
