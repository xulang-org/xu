@main

#net
#crypto/tls
#crypto/x509

fn serve(c net.PipeConn, cfg tls.Config, done chan int) {
    mut sc := tls.server_pipe(c, &cfg) or (err) {
        println(err.msg())
        done <- 1
        <<
    }
    got := sc.read(16) or (err) {
        println(err.msg())
        done <- 1
        <<
    }
    sc.write(&got) or (err) {
        println(err.msg())
        done <- 1
        <<
    }
    done <- 0
}

fn main() int {
    root := "-----BEGIN CERTIFICATE-----\nMIICBDCCAW2gAwIBAgIULc5sBBUiP4RtVhZb6fFcI2dfph4wDQYJKoZIhvcNAQEL\nBQAwFDESMBAGA1UEAwwJbG9jYWxob3N0MB4XDTI2MDgzMDA3MjcwNFoXDTM2MDgy\nNzA3MjcwNFowFDESMBAGA1UEAwwJbG9jYWxob3N0MIGfMA0GCSqGSIb3DQEBAQUA\nA4GNADCBiQKBgQCrzZFyC/82IYhF/Qx45uiRd50lY0sniTgrjRPHc2hWgsSj6aeh\nNQ9EoUKlPYrmr6UWQ6U8XI9u7TBHPYuW/n2484TG0O/aq6sjIfd2PLEsIj0owA4L\nmXSAgq6ftxF7NFyb6sAdAOyKOs0opo6XFA1pqIuImL+9ixIk82S5cz3pFwIDAQAB\no1MwUTAdBgNVHQ4EFgQUo9YjCh31bUTx81b7XorVvSkJxPEwHwYDVR0jBBgwFoAU\no9YjCh31bUTx81b7XorVvSkJxPEwDwYDVR0TAQH/BAUwAwEB/zANBgkqhkiG9w0B\nAQsFAAOBgQAi8SgBwtw0Tfz61XWvS5L5PxknJ4QtJYNIXjKqZyLe71ciaV2jhhIV\nLumV+fmrXxvjN9py61PziiY3abTw5N8Ij4AoXGtpbrY/lmL2rhWizqn+gCKWrj2w\nYt5qH+HwMruHfsPEvcpQwYg+oeAnSGYeYKgQ+G/045mEzc1Wcvbf3Q==\n-----END CERTIFICATE-----\n"
    intermediate := "-----BEGIN CERTIFICATE-----\nMIIB6TCCAVKgAwIBAgIBKTANBgkqhkiG9w0BAQsFADAUMRIwEAYDVQQDDAlsb2Nh\nbGhvc3QwHhcNMjYwODMwMjEzOTQ5WhcNMzYwODI3MjEzOTQ5WjAdMRswGQYDVQQD\nDBJYdS1JbnRlcm1lZGlhdGUtQ0EwgZ8wDQYJKoZIhvcNAQEBBQADgY0AMIGJAoGB\nAKvNkXIL/zYhiEX9DHjm6JF3nSVjSyeJOCuNE8dzaFaCxKPpp6E1D0ShQqU9iuav\npRZDpTxcj27tMEc9i5b+fbjzhMbQ79qrqyMh93Y8sSwiPSjADguZdICCrp+3EXs0\nXJvqwB0A7Io6zSimjpcUDWmoi4iYv72LEiTzZLlzPekXAgMBAAGjQjBAMA8GA1Ud\nEwEB/wQFMAMBAf8wDgYDVR0PAQH/BAQDAgEGMB0GA1UdDgQWBBSj1iMKHfVtRPHz\nVvteitW9KQnE8TANBgkqhkiG9w0BAQsFAAOBgQBQeiEirRX9HsNTQVchpAi8vQpr\nHJPAQ4VqMj2NQEGfG7YE8QVgq/r2CDYWhifZt6CiLSispU8X46wXzNN4A4C0YwMh\nRtzZqKh801Z0rw6cHgXTVnMdSH4a7TOPd5dRWkgZy6TB4P/gucXXT0FOUFbmRfls\npZjouJqebM7wVyd/qQ==\n-----END CERTIFICATE-----\n"
    leaf := "-----BEGIN CERTIFICATE-----\nMIIB8jCCAVugAwIBAgIBKjANBgkqhkiG9w0BAQsFADAdMRswGQYDVQQDDBJYdS1J\nbnRlcm1lZGlhdGUtQ0EwHhcNMjYwODMwMjEzOTQ5WhcNMzYwODI3MjEzOTQ5WjAX\nMRUwEwYDVQQDDAxsZWFmLmV4YW1wbGUwgZ8wDQYJKoZIhvcNAQEBBQADgY0AMIGJ\nAoGBAKvNkXIL/zYhiEX9DHjm6JF3nSVjSyeJOCuNE8dzaFaCxKPpp6E1D0ShQqU9\niuavpRZDpTxcj27tMEc9i5b+fbjzhMbQ79qrqyMh93Y8sSwiPSjADguZdICCrp+3\nEXs0XJvqwB0A7Io6zSimjpcUDWmoi4iYv72LEiTzZLlzPekXAgMBAAGjSDBGMBcG\nA1UdEQQQMA6CDGxlYWYuZXhhbXBsZTAMBgNVHRMBAf8EAjAAMB0GA1UdDgQWBBSj\n1iMKHfVtRPHzVvteitW9KQnE8TANBgkqhkiG9w0BAQsFAAOBgQAUaDC1DkFmCw1o\nDK0a1P8y1f2pAVtylybxEFMN9eVwH2puCbaqDHaRXT9OkK1WrLeDuOGGzheheaAJ\na4CgfzUnFfZW964wcdSniatOhnQo/tY0987L3PBEdMy0FAd81xSkvyTinpCQyS0V\nJqpKIZMjQGHnU8evwnCoI9aRRihA+A==\n-----END CERTIFICATE-----\n"
    key := "-----BEGIN PRIVATE KEY-----\nMIICdgIBADANBgkqhkiG9w0BAQEFAASCAmAwggJcAgEAAoGBAKvNkXIL/zYhiEX9\nDHjm6JF3nSVjSyeJOCuNE8dzaFaCxKPpp6E1D0ShQqU9iuavpRZDpTxcj27tMEc9\ni5b+fbjzhMbQ79qrqyMh93Y8sSwiPSjADguZdICCrp+3EXs0XJvqwB0A7Io6zSim\njpcUDWmoi4iYv72LEiTzZLlzPekXAgMBAAECgYEAqVoYF03QIzHmvOb2Vm93rX01\nQNeiC7Tt07BbYO5YWX7KC7GVdglxpXs40N3bgA6AM3Q2+0tacEQKpQ77/LmcfwjH\nbr2hn0QD+cNrLTpv9otAgPIC0DjN+VBpKNinkRxC5LpVo6iyTsqVM00tYfK+I5AG\nFb1PsVGmQlsw7RIbyvECQQDSbU2hNfa8zJxmmMb+3yk58zkzNAv5noZTMEBq49+p\nqNMsmhw9+u75dZb1YvjomvMWxbUKdlVfkpJlpcwW0bUNAkEA0QLWYKoTVi41rDyH\n/P5NhUu32yPe6Nw0yu8C/53dVu7ncvNHtXRtDePbpJkQWefgpJzqiLmvLThGbIp/\n0btVswJAF+eM2xR7TCVeWxVd/dQyJcAorlVqStgkYEzp9HqgjPB91OJI9Q2Nmk8u\nb//nUN1RYjPhhie9ORc4hE2aark1/QJACLQOiz3pyjfoYkCvBPjt73QEtupaeOXa\niOzE+jHvqpQOLTo2LTco52AqoEMDbEr8jr4+Ae2BfueN/y0RP4GGgwJAX5F5x+ZZ\nEHUJ74Tf1LwovJi5P99DOmOry3qoYwjKBICCM41lVfMOP/zZv57yPSnKP7vdpKo9\nuRWN0lbudKizOw==\n-----END PRIVATE KEY-----\n"
    cfg_srv := tls.Config{
        server_name: "leaf.example",
        insecure_skip_verify: false,
        root_cas: x509.new_cert_pool(),
        cert_pem: leaf + intermediate,
        key_pem: key
    }
    mut roots := x509.new_cert_pool()
    x509.append_certificates(mut &roots, &root)
    cfg_cli := tls.Config{
        server_name: "leaf.example",
        insecure_skip_verify: false,
        root_cas: roots,
        cert_pem: "",
        key_pem: ""
    }
    pair := net.pipe()
    done := chan int{cap: 1}
    xu serve(pair.c2, cfg_srv, done)
    mut cc := tls.client_pipe(pair.c1, &cfg_cli) or (err) {
        println(err.msg())
        << 1
    }
    state := cc.connection_state()
    println(state.version == tls.version_tls13 && state.cipher_suite == tls.tls_aes_128_gcm_sha256)
    msg := "hi"
    cc.write(&msg) or (err) {
        println(err.msg())
        << 1
    }
    back := cc.read(16) or (err) {
        println(err.msg())
        << 1
    }
    println(back)
    st := <-done
    << st
}
