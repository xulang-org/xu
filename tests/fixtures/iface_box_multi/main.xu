@main
struct@ Named {
    fn id() int
    fn plus(int) int
}
struct A { n int }
fn (a A) id() int { << a.n }
fn (a A) plus(d int) int { << a.n + d }
struct B { n int }
fn (b B) id() int { << b.n + 10 }
fn (b B) plus(d int) int { << b.n + d }
fn main() int {
    x := Named(A{n: 5})
    y := Named(B{n: 3})
    println(x.id())
    println(y.id())
    println(x.plus(2))
    println(y.plus(2))
    << 0
}
