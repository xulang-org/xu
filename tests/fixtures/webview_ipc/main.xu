@main

#ui
#ui/webview

fn route(name string, payload string) string {
    if name == "ping" {
        << "pong:" + payload
    }
    << "miss:" + name
}

fn main() int {
    println(xu_target_os())
    mut app := ui.new_app()
    mut win := app.new_window(ui.WindowOpts{title: "IPC", width: 400, height: 300})
    mut items := []ui.MenuItem{}
    items.push(ui.menu_item("quit", "Quit"))
    win.set_menu(ui.menu(items))
    r := mut &win
    mut wv := webview.attach(r)
    println(win.content_slot_kind())
    println(webview.bridge_script().len > 10)
    wv.on("ping")
    out := wv.invoke("ping", "x", route)
    println(out)
    wv.emit("note", "hi")
    println(wv.emit_pending_count())
    wv.clear_emits()
    app.post(7)
    println(app.try_recv_post())
    app.run() or (err) {
        println(err.msg())
        << 0
    }
    << 1
}
