@main

#crypto/rsa
#math/big
#encoding/hex
#crypto/sha256

fn verify_fails(pk &rsa.PublicKey, hashed string, sig string) bool {
    rsa.verify_pkcs1v15(pk, rsa.sha256, &hashed, &sig) or (err) { << true }
    << false
}

fn main() int {
    nh := "b7ce79754a96c6740501cdab1abf3227619748257ff3dcbf2a3c218a9dcafe9a8db5d57ceab807241c93b90f3429924d7b20876f91ec7e7934198f7a8ace65cb"
    dh := "b6bac4d2cf495f97bdd69221d5a0587b0031469f493a25adc28e2f064062ab8347856fd9aaeb63ee622feb5aa1baaa56d7f0dd405565b803828478f306581c71"
    ph := "efa7d26d4336a5a200eb373bd299aab9944298b62809678a3fc8fd279a7a18a3"
    qh := "c45793c0049796e23049107e462698f5c603121821f26870aad8ac7a925488b9"
    mut n := big.new_int(0)
    n.set_bytes(hex.decode_string(nh) or (err) { << 1 })
    mut d := big.new_int(0)
    d.set_bytes(hex.decode_string(dh) or (err) { << 1 })
    mut p := big.new_int(0)
    p.set_bytes(hex.decode_string(ph) or (err) { << 1 })
    mut q := big.new_int(0)
    q.set_bytes(hex.decode_string(qh) or (err) { << 1 })
    pk := rsa.PublicKey{n: n, e: 65537}
    priv := rsa.PrivateKey{public: pk, d: d, p: p, q: q}

    ct := hex.decode_string("a55a6d6cdaf12d04db2ebaccc41459adf3cb799de1f19e8974ab86811b29ced8238d508b29d2baf8e2672d43560c34e87cd756eb03c3d14b1b69290074d6a713") or (err) { << 1 }
    plain := rsa.decrypt_pkcs1v15(&priv, &ct) or (err) {
        println(err.msg())
        << 1
    }
    println(plain)

    msg := "hi"
    enc := rsa.encrypt_pkcs1v15(&priv.public, &msg) or (err) {
        println(err.msg())
        << 1
    }
    back := rsa.decrypt_pkcs1v15(&priv, &enc) or (err) {
        println(err.msg())
        << 1
    }
    println(back)

    hashed := hex.decode_string("12dca15385cb4f9629b0366561a5ede04d8a955605f41cdc693d774621b23f66") or (err) { << 1 }
    osig := hex.decode_string("4c4ce143a447e4f76df88f43c3294371b80659cbb458cefefb89b25a3723bbb62f30075865b408bfa36a4a535655cd5503d0ed87cedf5d8220e9df2f1f99f571") or (err) { << 1 }
    rsa.verify_pkcs1v15(&priv.public, rsa.sha256, &hashed, &osig) or (err) {
        println(err.msg())
        << 1
    }
    println("openssl_ok")

    hx := sha256.sum256("hello rsa")
    raw := hex.decode_string(hx) or (err) { << 1 }
    sig := rsa.sign_pkcs1v15(&priv, rsa.sha256, &raw) or (err) {
        println(err.msg())
        << 1
    }
    rsa.verify_pkcs1v15(&priv.public, rsa.sha256, &raw, &sig) or (err) {
        println(err.msg())
        << 1
    }
    println("sign_ok")

    mut bad := ""
    mut i := 0
    while i < osig.len - 1 {
        bad = bad + string_from_byte(osig[i] & 255)
        i = i + 1
    }
    bad = bad + string_from_byte((osig[osig.len - 1] ^ 1) & 255)
    if verify_fails(&priv.public, hashed + "", bad) {
        println("bad_sig")
    }

    gen := rsa.generate_key(64) or (err) {
        println(err.msg())
        << 1
    }
    println(gen.public.e)
    gpk := &gen.public
    println(gpk.size())
    << 0
}
