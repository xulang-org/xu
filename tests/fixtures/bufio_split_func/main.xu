@main

#bufio
#io

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn split_semi(data string, at_eof int) bufio.SplitResult {
    if data.len == 0 {
        << bufio.split_ok(0, "")
    }
    mut i := 0
    while i < data.len {
        if (data[i] & 255) == 59 {
            mut tok := ""
            if i > 0 {
                tok = data[0:i] + ""
            }
            << bufio.split_ok(i + 1, tok)
        }
        i = i + 1
    }
    if at_eof != 0 {
        << bufio.split_ok(data.len, data + "")
    }
    << bufio.split_ok(0, "")
}

// Local wrapper: cross-module fn values need a same-module name (Xu).
fn lines(data string, at_eof int) bufio.SplitResult {
    << bufio.scan_lines(data, at_eof)
}

fn main() int {
    mut s := bufio.new_scanner(io.buffer_from("a;b;c"))
    s.split_func(split_semi)
    while s.scan() {
        println(s.text())
    }

    mut s2 := bufio.new_scanner(io.buffer_from("x\ny\n"))
    s2.split_func(lines)
    while s2.scan() {
        println(s2.text())
    }

    // switch back to built-in mode
    mut s3 := bufio.new_scanner(io.buffer_from("p q"))
    s3.split_func(split_semi)
    s3.split(bufio.mode_words)
    while s3.scan() {
        println(s3.text())
    }

    r := bufio.scan_bytes("AB", 1)
    println(r.advance)
    println(r.token)
    mut s4 := bufio.new_scanner(io.buffer_from(""))
    s4.split_func(split_semi)
    show_bool(s4.scan())
    << 0
}
