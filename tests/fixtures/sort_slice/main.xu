@main

#sort

struct Point {
    x int
}

pub fn (p Point) less(other Point) bool {
    << p.x < other.x
}

fn main() int {
    mut a := []int{}
    a.push(3)
    a.push(1)
    a.push(2)
    sort.slice(mut &a)
    println(a[0])
    println(a[1])
    println(a[2])
    mut s := []string{}
    s.push("cherry")
    s.push("apple")
    s.push("banana")
    sort.slice(mut &s)
    println(s[0])
    println(s[1])
    println(s[2])
    mut pts := []Point{}
    pts.push(Point{x: 9})
    pts.push(Point{x: 1})
    pts.push(Point{x: 4})
    sort.slice(mut &pts)
    println(pts[0].x)
    println(pts[1].x)
    println(pts[2].x)
    << 0
}
