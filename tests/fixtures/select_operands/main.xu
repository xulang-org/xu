@main
#errors

fn observe(ch chan int, tag int) chan int {
    println(tag)
    << ch
}
fn fail(ch chan int) chan int {
    >> errors.new("operand failed")
    << ch
}
fn send_value() int {
    println(3)
    << 9
}
fn receive_later(ch chan int, ack chan int) {
    sleep_ns(10000000)
    println(<-ch)
    ack <- 1
}
fn failed_select(first chan int, second chan int) int {
    select {
        x := <-first { << x }
        y := <-(fail(second) or (err) { _ := err
            << -1 }) { << y }
    }
    << 0
}
fn main() int {
    first := chan int{cap: 1}
    second := chan int{cap: 1}
    first <- 7
    select {
        x := <-observe(first, 1) { println(x) }
        y := <-observe(second, 2) { println(y) }
    }
    delayed := chan int{cap: 0}
    ack := chan int{cap: 1}
    xu receive_later(delayed, ack)
    select { delayed <- send_value() {} }
    _ := <-ack
    for i in 0:1000 {
        if failed_select(first, second) != -1 { << 1 }
    }
    // A failure in a later operand must leave no subscriptions behind.
    close(first)
    println("errors done")
    << 0
}
