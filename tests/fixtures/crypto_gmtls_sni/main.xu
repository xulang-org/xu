@main
// G20: GMTLS ClientHello SNI; server Conn.server_name is the name on the wire.

#net
#crypto/gmtls

fn serve(c net.PipeConn, cfg gmtls.Config, seen chan string, done chan int) {
    mut sc := gmtls.server(c, &cfg) or (err) {
        println(err.msg())
        done <- 1
        <<
    }
    sn := sc.server_name + ""
    seen <- sn
    got := sc.read() or (err) {
        println(err.msg())
        done <- 1
        <<
    }
    sc.write(&got) or (err) {
        println(err.msg())
        done <- 1
        <<
    }
    done <- 0
}

fn main() int {
    sign_pem := "-----BEGIN CERTIFICATE-----\nMIIBwzCCAWmgAwIBAgIULV3gUyDKjH2+ehom1cPgPi/QO8cwCgYIKoEcz1UBg3Uw\nNzELMAkGA1UEBhMCQ04xCzAJBgNVBAoMAlh1MRswGQYDVQQDDBJnbXRscy1zaWdu\nLmV4YW1wbGUwHhcNMjYwODI1MDc1MzIxWhcNMzYwODIyMDc1MzIxWjA3MQswCQYD\nVQQGEwJDTjELMAkGA1UECgwCWHUxGzAZBgNVBAMMEmdtdGxzLXNpZ24uZXhhbXBs\nZTBZMBMGByqGSM49AgEGCCqBHM9VAYItA0IABKYKXZPbLENNptofd9GyyKMmz81d\nPketmWsT+gNFPBZJwxDiBCRAQQKA/Fq+kh3EtoSVzO5Qs6f6lZMJa6ZWl3ujUzBR\nMB0GA1UdDgQWBBRu8w7Gd1kH6L7ur/8WNecSEPsQaTAfBgNVHSMEGDAWgBRu8w7G\nd1kH6L7ur/8WNecSEPsQaTAPBgNVHRMBAf8EBTADAQH/MAoGCCqBHM9VAYN1A0gA\nMEUCIQDI/+07v4wkV4f77aqvmmCMYAUmT5A/oCrs2ofT9ymZcQIgHDOK0euAvdUd\nAln6TEe423BLmhrpYfz8aF5fu18Y1SA=\n-----END CERTIFICATE-----\n"
    enc_pem := "-----BEGIN CERTIFICATE-----\nMIIBwDCCAWegAwIBAgIUQknAJ5G3Kf9s51R2TJAlGzHienQwCgYIKoEcz1UBg3Uw\nNjELMAkGA1UEBhMCQ04xCzAJBgNVBAoMAlh1MRowGAYDVQQDDBFnbXRscy1lbmMu\nZXhhbXBsZTAeFw0yNjA4MjUwNzUzMjFaFw0zNjA4MjIwNzUzMjFaMDYxCzAJBgNV\nBAYTAkNOMQswCQYDVQQKDAJYdTEaMBgGA1UEAwwRZ210bHMtZW5jLmV4YW1wbGUw\nWTATBgcqhkjOPQIBBggqgRzPVQGCLQNCAASlovSgWAQ6rsYyxZ1o3R/3LmeOOTJI\nlUeRlZ90PD0EaBkwSIcIkxZ8BqflAKq5Az5XCPv3QA8L6f9Z2go0n1sQo1MwUTAd\nBgNVHQ4EFgQUrlc6bxZs8q5k+j7VKa4wvZThzAMwHwYDVR0jBBgwFoAUrlc6bxZs\n8q5k+j7VKa4wvZThzAMwDwYDVR0TAQH/BAUwAwEB/zAKBggqgRzPVQGDdQNHADBE\nAiBokH5BDE98HkZVhbsZvt2EOrvGyDnFmi9hSmLV04Z/FwIgbm286FpOXVoxTC5a\nP25CtB8R8qJGD8nXiVcIDHk6bac=\n-----END CERTIFICATE-----\n"
    sk := "-----BEGIN PRIVATE KEY-----\nMEECAQAwEwYHKoZIzj0CAQYIKoEcz1UBgi0EJzAlAgEBBCAW35Y6Vre9y4BK5rw1\nFhBcYgAoRFneJGR1EUYwxhoVGA==\n-----END PRIVATE KEY-----\n"
    ek := "-----BEGIN PRIVATE KEY-----\nMEECAQAwEwYHKoZIzj0CAQYIKoEcz1UBgi0EJzAlAgEBBCApvkfwCxzHV2ubI6ET\nCjvlLm8xs8tPWlvTg9abTcZAjQ==\n-----END PRIVATE KEY-----\n"
    cfg_srv := gmtls.Config{
        server_name: "gmtls-sign.example",
        client_name: "",
        insecure_skip_verify: false,
        sign_cert: sign_pem,
        sign_key: sk,
        enc_cert: enc_pem,
        enc_key: ek,
        cipher_suite: 0
    }
    cfg_cli := gmtls.Config{
        server_name: "gmtls-sign.example",
        client_name: "",
        insecure_skip_verify: false,
        sign_cert: "",
        sign_key: "",
        enc_cert: "",
        enc_key: "",
        cipher_suite: 0
    }
    pair := net.pipe()
    done := chan int{cap: 1}
    seen := chan string{cap: 1}
    xu serve(pair.c2, cfg_srv, seen, done)
    mut cc := gmtls.client(pair.c1, &cfg_cli) or (err) {
        println(err.msg())
        << 1
    }
    println(cc.cipher_suite)
    sni := <-seen
    println(sni)
    msg := "hi"
    cc.write(&msg) or (err) {
        println(err.msg())
        << 1
    }
    back := cc.read() or (err) {
        println(err.msg())
        << 1
    }
    println(back)
    st := <-done
    << st
}
