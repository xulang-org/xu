@main

// Keep a real frame above the historical 16384-slot synthetic-temp boundary.
// The aggregate parameter remains frame-backed while independent scalar temps
// use fixed homes; pressure forces at least one scalar spill above that old
// boundary, so confusing a real slot with a synthetic key changes the result.
fn pressure(big [16384]int, a int, b int, c int, d int) int {
    x0 := a + b
    x1 := a - b
    x2 := b + c
    x3 := b - c
    x4 := c + d
    x5 := c - d
    x6 := a ^ d
    x7 := b | c
    << x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7
}

fn main() int {
    big := [16384]int{}
    println(pressure(big, 31, 7, 11, 3))
    << 0
}
