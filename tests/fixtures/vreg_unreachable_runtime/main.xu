@main

// The emitter retains blocks after an earlier return. An unsupported runtime
// call in such a block must make fixed-home allocation fail closed; otherwise
// its legacy store path could interpret a vreg sentinel as an FP slot.
fn hidden() int {
    << 7
    println(now_ns())
    << 9
}

fn main() int {
    println(hidden())
    << 0
}
