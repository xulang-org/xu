@main
fn main() int {
    xs := [1, 2, 3, 4]
    mut ys := xs[1:3]
    println(ys.len)
    println(ys[0])
    println(ys[1])
    ys[0] = 99
    println(xs[1])
    println(ys[0])
    zs := xs[2:]
    println(zs.len)
    println(zs[0])
    ws := xs[:2]
    println(ws[1])
    empty := xs[2:2]
    println(empty.len)
    mut ss := ["aa", "bb", "cc"]
    mut tt := ss[0:2]
    tt[0] = "zz"
    println(ss[0])
    println(tt[0])
    << 0
}
