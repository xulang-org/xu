@main

#net/http

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn negative_timeout() bool {
    mut c := http.new_client()
    c.set_timeout(0 - 1)
    empty := ""
    c.do("GET", "http://127.0.0.1/", &empty) or (err) {
        println(err.msg())
        << true
    }
    << false
}

fn main() int {
    show_bool(negative_timeout())
    << 0
}
