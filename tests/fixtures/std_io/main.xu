@main

#io

fn main() int {
    mut b := io.buffer()
    msg := "hello"
    println(b.write(&msg))
    println(b.bytes())
    more := " world"
    println(b.write(&more))
    println(b.bytes())
    println(b.read_n(5))
    println(b.bytes())
    mut src := io.cursor("abcdef")
    mut dst := io.buffer()
    println(io.copy(dst, src) or (err) { << 1 })
    mut empty := io.cursor("")
    mut dst2 := io.buffer()
    empty_out := io.copy(dst2, empty) or (err) { << 1 }
    println(empty_out.len)
    mut src2 := io.cursor("xyz")
    println(io.read_all(src2) or (err) { << 1 })
    << 0
}
