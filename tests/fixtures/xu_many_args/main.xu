@main
// `xu f(args)` past six arguments: the task record is sized per call and
// the trampoline spills argument seven onward to the callee's stack, with
// hidden-pointer (string / struct) arguments in either position.
struct Pt {
    x int
    y int
}

fn nine(a int, b int, c int, d int, e int, f int, g int, h int, i int, out chan int) {
    out <- a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8 + i * 9
}

fn six(a int, b int, c int, d int, e int, f int, out chan int) {
    out <- a + b + c + d + e + f
}

fn mixed(a int, b int, c int, d int, e int, f int, name string, p Pt, tag string, out chan int) {
    mut s := a + b + c + d + e + f
    s = s + name.len * 100 + p.x + p.y * 10 + tag.len * 1000
    out <- s
}

fn main() int {
    ch := chan int{cap: 4}
    xu nine(1, 2, 3, 4, 5, 6, 7, 8, 9, ch)
    println(<-ch)
    xu six(1, 2, 3, 4, 5, 6, ch)
    println(<-ch)
    xu mixed(1, 2, 3, 4, 5, 6, "hello", Pt{x: 7, y: 8}, "xy", ch)
    println(<-ch)
    mut k := 0
    mut sum := 0
    while k < 50 {
        xu nine(k, k, k, k, k, k, k, k, k, ch)
        sum = sum + <-ch
        k = k + 1
    }
    println(sum)
    << 0
}
