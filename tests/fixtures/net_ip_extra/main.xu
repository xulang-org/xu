@main

#net

fn cidr_fails(s string) bool {
    _ := net.parse_cidr(&s) or (err) {
        << true
    }
    << false
}

fn mac_fails(s string) bool {
    _ := net.parse_mac(&s) or (err) {
        << true
    }
    << false
}

fn main() int {
    a := "127.0.0.1"
    ip := net.parse_ip(&a)
    v16 := net.ip_to16(&ip)
    println(v16.len)
    v4 := net.ip_to4(&v16)
    println(v4.len)
    println(net.ip_string(&v4))
    println(net.ip_equal(&ip, &v16))

    m := net.cidr_mask(24, 32)
    n := net.ip_mask(&ip, &m)
    println(net.ip_string(&n))
    println(net.ip_mask_size(&m))

    c := "192.0.2.1/24"
    cidr := net.parse_cidr(&c) or (err) { << 1 }
    println(net.ip_string(&cidr.ip))
    println(cidr.ipnet.to_string())
    x := "192.0.2.99"
    xp := net.parse_ip(&x)
    println(cidr.ipnet.contains(&xp))
    y := "192.0.3.1"
    yp := net.parse_ip(&y)
    println(cidr.ipnet.contains(&yp))

    mc := "00:00:5e:00:53:01"
    hw := net.parse_mac(&mc) or (err) { << 1 }
    println(hw.len)
    println(net.hardware_addr_string(&hw))
    mc2 := "00005e005301"
    hw2 := net.parse_mac(&mc2) or (err) { << 1 }
    println(net.hardware_addr_string(&hw2))

    mcast := "224.0.0.1"
    mip := net.parse_ip(&mcast)
    println(net.ip_is_multicast(&mip))
    println(net.ip_is_link_local_multicast(&mip))
    g := "192.0.2.1"
    gip := net.parse_ip(&g)
    println(net.ip_is_global_unicast(&gip))

    ll := "169.254.1.1"
    lip := net.parse_ip(&ll)
    println(net.ip_is_link_local_unicast(&lip))
    println(net.ip_is_global_unicast(&lip))

    println(net.lookup_port("tcp", "http") or (err) { << 1 })
    println(net.lookup_port("tcp", "https") or (err) { << 1 })
    println(net.lookup_port("tcp", "80") or (err) { << 1 })
    println(net.lookup_protocol("tcp") or (err) { << 1 })

    hp := net.split_host_port("example.com:80") or (err) { << 1 }
    println(hp.host())
    println(hp.port())

    t := net.resolve_tcp_addr("tcp", "127.0.0.1:8080") or (err) { << 1 }
    println(t.to_string())
    println(t.port)

    hosts := net.lookup_host("127.0.0.1") or (err) { << 1 }
    println(hosts.len)
    println(hosts[0])
    loc := net.lookup_host("localhost") or (err) { << 1 }
    println(loc.len >= 1)

    z := net.ipv4_zero()
    println(net.ip_is_unspecified(&z))
    lb := net.ipv6_loopback()
    println(net.ip_is_loopback(&lb))

    println(cidr_fails("nope"))
    println(mac_fails("zz"))
    << 0
}
