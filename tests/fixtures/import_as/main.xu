@main

js #encoding/json
nu #net/url
sc #strconv
lib #mylib

fn id(x nu.URL) nu.URL {
    << x
}

fn main() int {
    src := "{\"a\":[1]}"
    d := js.parse(&src)
    println(d.ok())
    mut u := nu.new_url()
    u.parse("https://x/p") or (err) { << 1 }
    println(u.host() == "x")
    mut u2 := id(u)
    u2.parse("https://y/") or (err) { << 1 }
    println(u2.host() == "y")
    seven := "7"
    println(sc.parse(&seven, 10) or (err) { << 1 })
    println(sc.itoa(41))
    println(lib.answer)
    println(lib.greet())
    es := ""
    println(js.quote(&es))
    << 0
}
    fn empty() string {
    << ""
}
