@main
// G18: crypto/sm2 PKIX SPKI public key + PEM; GM-style algorithm OID.

#crypto/sm2
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    pkix_pem := "-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoEcz1UBgi0DQgAECfnfMR5UIaFQ3X0WHkvFxnIXn60Y\nM/wHa7CP81bzUCDM6kkM4md1pS3G6nGMwapgCu0F+/NeCEpmMvYHLamtEw==\n-----END PUBLIC KEY-----\n"
    p1 := sm2.parse_public_pem(&pkix_pem) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(p1 + ""))

    gm := hex.decode_string("3050300a06082a811ccf5501822d0342000409f9df311e5421a150dd7d161e4bc5c672179fad1833fc076bb08ff356f35020ccea490ce26775a52dc6ea718cc1aa600aed05fbf35e084a6632f6072da9ad13") or (err) {
        << 1
    }
    p2 := sm2.parse_public_key(&gm) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(p2 + ""))

    priv_pem := "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqBHM9VAYItBG0wawIBAQQgOUUgj3shRLE/NuOK\nxtOflYiTk2koYLUaQvuB7033xbihRANCAAQJ+d8xHlQhoVDdfRYeS8XGchefrRgz\n/AdrsI/zVvNQIMzqSQziZ3WlLcbqcYzBqmAK7QX7814ISmYy9gctqa0T\n-----END PRIVATE KEY-----\n"
    d := sm2.parse_private_pem(&priv_pem) or (err) {
        println(err.msg())
        << 1
    }
    pubk := sm2.public(&d) or (err) {
        println(err.msg())
        << 1
    }
    der := sm2.marshal_pkix(&pubk) or (err) {
        println(err.msg())
        << 1
    }
    p3 := sm2.parse_public_key(&der) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(p3 + ""))

    pem2 := sm2.marshal_pkix_pem(&pubk) or (err) {
        println(err.msg())
        << 1
    }
    p4 := sm2.parse_public_pem(&pem2) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(p4 + ""))

    hi := "hi"
    gs := sm2.sign_asn1(&d, &hi) or (err) {
        println(err.msg())
        << 1
    }
    show_bool(sm2.verify_asn1(&p1, &hi, &gs))
    << 0
}
