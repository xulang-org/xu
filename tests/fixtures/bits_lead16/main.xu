@main

#math/bits

fn main() int {
    println(bits.leading_zeros16(1))
    println(bits.leading_zeros16(0))
    println(bits.leading_zeros8(1))
    println(bits.reverse16(1))
    println(bits.reverse8(1))
    println(bits.reverse_bytes16(4660))
    println(bits.rotate_left16(1, 1))
    println(bits.rotate_left8(128, 1))
    << 0
}
