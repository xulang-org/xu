@main

fn main() int {
    let e: temp = 1
    if true {
        v := e as int
        println(v)
    } else {
        println("no")
    }
    let f: temp = 2
    if false {
        w := f as int
        println(w)
    } else {
        println("no")
    }
    let g: temp = 3
    if g is int {
        x := g as int
        println(x)
    } else {
        println("no")
    }
    let h: temp = 4
    if true {
        a := h as int
        println(a)
    } else {
        b := h as int
        println(b)
    }
    << 0
}
