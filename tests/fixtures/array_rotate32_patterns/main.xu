@main
struct Bucket { pad []int, stamp int, data []int }
fn left(v int, k int) int {
    y := v & 4294967295
    << ((y << k) & 4294967295) | (y >> (32 - k))
}
fn right(v int, k int) int {
    y := v & 4294967295
    << (y >> (32 - k)) | ((y << k) & 4294967295)
}
fn high(v int, k int) int {
    << (v >> k) | ((v << (32 - k)) & 4294967295)
}
fn escaped(v int, k int) int {
    y := v & 4294967295
    lo := (y << k) & 4294967295
    hi := y >> (32 - k)
    << (lo | hi) ^ lo
}
fn step1(t &mut Bucket, p int, q int) int {
    t.data[p] = left(t.data[p], 1)
    t.data[q] = right(t.data[q] ^ t.data[p], 1)
    << t.data[p] ^ t.data[q]
}
fn step7(t &mut Bucket, p int, q int) int {
    t.data[p] = left(t.data[p], 7)
    t.data[q] = right(t.data[q] ^ t.data[p], 7)
    << t.data[p] ^ t.data[q]
}
fn step8(t &mut Bucket, p int, q int) int {
    t.data[p] = left(t.data[p], 8)
    t.data[q] = right(t.data[q] ^ t.data[p], 8)
    << t.data[p] ^ t.data[q]
}
fn step12(t &mut Bucket, p int, q int) int {
    t.data[p] = left(t.data[p], 12)
    t.data[q] = right(t.data[q] ^ t.data[p], 12)
    << t.data[p] ^ t.data[q]
}
fn step16(t &mut Bucket, p int, q int) int {
    t.data[p] = left(t.data[p], 16)
    t.data[q] = right(t.data[q] ^ t.data[p], 16)
    << t.data[p] ^ t.data[q]
}
fn step24(t &mut Bucket, p int, q int) int {
    t.data[p] = left(t.data[p], 24)
    t.data[q] = right(t.data[q] ^ t.data[p], 24)
    << t.data[p] ^ t.data[q]
}
fn step31(t &mut Bucket, p int, q int) int {
    t.data[p] = left(t.data[p], 31)
    t.data[q] = right(t.data[q] ^ t.data[p], 31)
    << t.data[p] ^ t.data[q]
}
fn fallback(t &mut Bucket, p int, q int) int {
    t.data[p] = high(t.data[p], 7)
    t.data[q] = high(t.data[q] ^ t.data[p], 25)
    << t.data[p] ^ t.data[q]
}
fn intermediate(t &mut Bucket, p int, q int) int {
    t.data[p] = escaped(t.data[p], 12)
    t.data[q] = escaped(t.data[q] ^ t.data[p], 24)
    << t.data[p] ^ t.data[q]
}
fn main() int {
    for k in 0:32 {
        mut a := []int{}
        for j in 0:8 { a.push((j * 17 - k * 31) ^ (j << 57) ^ (k << 54)) }
        mut pad := []int{}
        pad.push(1)
        pad.push(2)
        mut t := Bucket{pad: pad, stamp: k - 19, data: a}
        p := k & 7
        q := (k * 3) & 7
        println(step1(mut &t, p, q))
        println(step7(mut &t, p, q))
        println(step8(mut &t, p, q))
        println(step12(mut &t, p, q))
        println(step16(mut &t, p, q))
        println(step24(mut &t, p, q))
        println(step31(mut &t, p, q))
        println(fallback(mut &t, p, q))
        println(intermediate(mut &t, p, q))
        for j in 0:8 { println(t.data[j]) }
        println(t.pad.len)
        println(t.stamp)
        println(t.data.len)
    }
    << 0
}
