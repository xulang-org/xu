@main

fn main() int {
    mut s := 0
    for i in 0:10000 {
        mut xs := [][]temp{}
        mut a := []temp{}
        a.push(1)
        a.push(8)
        xs.push(a)
        mut b := []temp{}
        b.push(2)
        xs.push(b)
        if i % 2 == 0 {
            v := xs[0][0] as int
            s += v
            w := xs[0][1] as int
            s += w
            z := xs[1][0] as int
            s += z
        } else {
            s += 1
        }
    }
    println(s)
    println("ok")
    << 0
}
