@main
fn bound(n int) int {
    println(n)
    << n
}
fn make() [4]int {
    println("source")
    << [4]int{65, 66, 67, 68}
}
struct Box { data [4]int }
fn expand(a &mut []int) int {
    for i in 0:100 { a.push(90) }
    << 0
}
fn main() int {
    mut b := [4]int{65, 66, 67, 68}
    println(string_from_bytes(b, 1, 3))
    println(string_from_bytes(b, 0, 4))
    println(string_from_bytes(b, 4, 4).len)
    made := make()
    first := bound(1)
    last := bound(3)
    println(string_from_bytes(made, first, last))
    bx := Box{data: b}
    println(string_from_bytes(bx.data, 1, 3))
    mut boxes := []Box{}
    boxes.push(bx)
    println(string_from_bytes(boxes[0].data, 1, 3))
    saved := string_from_bytes(b, 1, 3)
    b[1] = 90
    println(saved)
    println(string_from_bytes(b, 1, 3))
    d := [65, 66, 67, 68]
    println(string_from_bytes(d, 1, 3))
    println(d[1])
    start := bound(1)
    end := bound(3)
    println(string_from_bytes(d, start, end))
    println(string_from_bytes([65, 66, 67], 1, 3))
    println(string_from_bytes("hello".bytes(), 1, 4))
    println(string_from_bytes([]int{}, 0, 0).len)
    ends := [1, 3]
    println(string_from_bytes(d, ends[0], ends[1]))
    println(string_from_bytes(d, 1 + 0, d.len - 1))
    mut alias := [65, 66, 67]
    begin := expand(mut &alias)
    println(string_from_bytes(alias, begin, alias.len - 100))
    println(alias.len)
    << 0
}
