@main

fn receive(first chan int, second chan int, out chan int) {
    select {
        x := <-first { out <- x }
        y := <-second { out <- y }
    }
}

fn send_later(ch chan int) {
    sleep_ns(10000000)
    ch <- 7
}

fn blocked_send(ch chan int, out chan int) {
    select { ch <- 9 { out <- 1 } }
}

fn main() int {
    first := chan int{cap: 1}
    second := chan int{cap: 1}
    out := chan int{cap: 1}
    xu receive(first, second, out)
    sleep_ns(10000000)
    close(second)
    println(<-out)
    rendezvous := chan int{cap: 0}
    xu send_later(rendezvous)
    xu receive(first, rendezvous, out)
    println(<-out)
    full := chan int{cap: 1}
    full <- 3
    xu blocked_send(full, out)
    sleep_ns(10000000)
    println(<-full)
    println(<-out)
    println(<-full)
    << 0
}
