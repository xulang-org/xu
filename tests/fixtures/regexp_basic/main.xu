@main

#regexp

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn compile_fails(s string) bool {
    regexp.compile(s) or (err) { << true }
    << false
}

fn main() int {
    re := regexp.compile("a+b") or (err) { << 1 }
    t1 := "xxaaabyy"
    show_bool(re.match_string(&t1))
    println(re.find(&t1))

    re2 := regexp.compile("^[0-9]+$$") or (err) { << 1 }
    n1 := "42"
    n2 := "4a"
    show_bool(re2.match_string(&n1))
    show_bool(re2.match_string(&n2))

    re3 := regexp.compile("foo|bar") or (err) { << 1 }
    t3 := "xbarx"
    println(re3.find(&t3))

    re4 := regexp.compile("a*a") or (err) { << 1 }
    t4 := "aa"
    println(re4.find(&t4))

    re5 := regexp.compile("[a-c]+") or (err) { << 1 }
    t5 := "zzabczz"
    println(re5.find(&t5))

    re6 := regexp.compile("\\d+") or (err) { << 1 }
    t6 := "id=42;"
    println(re6.find(&t6))

    all := re3.find_all(&t3, -1)
    println(all.len)
    println(all[0])

    rep := "X"
    t7 := "xxfooyybarzz"
    println(re3.replace_all(&t7, &rep))

    show_bool(compile_fails("a("))
    << 0
}
