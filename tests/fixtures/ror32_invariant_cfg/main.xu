fn main() int {
    seeds := [-1, 0, 1, 2147483648, 4294967295, 281474976710655, 9223372036854775807]
    mut result := 0
    for seed in seeds {
        bounded_loop(mut &result, seed)
        println(result)
        invalidated_loop(mut &result, seed)
        println(result)
        escaped_source(mut &result, seed)
        println(result)
        shared_intermediate(mut &result, seed)
        println(result)
    }
    << 0
}
