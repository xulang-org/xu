@main
// Canary: by-value call with a struct string field must clone.
// After take(u.name), u.name remains live (not freed with the param).
struct U {
    name string
    age  int
}

fn take(s string) {
    println(s)
}

fn main() int {
    // Heap string (cap > 0) so free would matter under Drop free.
    mut u := U{name: "a" + "b", age: 1}
    take(u.name)
    println(u.name)
    println(u.age)
    << 0
}
