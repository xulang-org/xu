@main

fn paint(pix &mut []u8, n int) {
    mut i := 0
    mut z := 0.5
    while i < n {
        z = z * z + 0.1
        if z < 2.0 {
            pix[i] = pix[i] | u8(1)
        }
        i += 1
    }
}

fn main() int {
    mut pix := []u8{}
    pix.push(u8(0))
    pix.push(u8(0))
    pix.push(u8(0))
    pix.push(u8(0))
    paint(mut &pix, 4)
    println(int(pix[0]) + int(pix[1]) + int(pix[2]) + int(pix[3]))
    << 0
}
