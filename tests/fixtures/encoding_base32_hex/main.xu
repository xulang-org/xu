@main

#encoding/base32

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn hex_decode_fails(s string) bool {
    base32.hex_decode_string(s) or (err) { << true }
    << false
}

fn main() int {
    println(base32.hex_encode_to_string("foo"))
    println(base32.hex_encode_to_string("f"))
    println(base32.hex_encode_to_string("fo"))
    println(base32.hex_encode_to_string("foob"))
    println(base32.hex_encode_to_string("fooba"))
    println(base32.hex_encode_to_string("foobar"))
    println(base32.hex_decode_string("CPNMU===") or (err) { << 1 })
    println(base32.hex_decode_string("CPNMUOJ1") or (err) { << 1 })
    round := base32.hex_encode_to_string("Hello, Xu!")
    println(base32.hex_decode_string(round) or (err) { << 1 })
    show_bool(hex_decode_fails("CPNMU=="))
    show_bool(hex_decode_fails("!!!!===="))
    println(base32.encode_to_string("foo"))
    println(base32.hex_encoded_len(3))
    println(base32.hex_decoded_len(8))
    << 0
}
