@main

// Dropping `temp` that holds a 3-char string must free the 3-slot box
// (not `_rt_free(data*)`, which reads len as a size-class). len=3 is
// the 64-byte class used by the first `[]int` grow.

fn drop_lit() {
    mut xs := []temp{}
    xs.push("bob")
}

fn drop_heap() {
    s := "bo" + "b"
    mut xs := []temp{}
    xs.push(s)
}

fn main() int {
    drop_lit()
    drop_heap()
    mut idxs := []int{}
    idxs.push(0)
    idxs.push(1)
    println(idxs[0])
    println(idxs[1])
    << 0
}
