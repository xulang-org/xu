@main
// G25: GMTLS ECDHE with client dual certs distinct from the server.

#net
#crypto/gmtls
#crypto/x509

fn cert_cn(der &string) string {
    raw := der + ""
    c := x509.parse_certificate(raw) or (err) { << "" }
    << c.subject.common_name + ""
}

fn serve(c net.PipeConn, cfg gmtls.Config, seen chan string, done chan int) {
    mut sc := gmtls.server(c, &cfg) or (err) {
        println(err.msg())
        done <- 1
        <<
    }
    pder := sc.peer_sign_cert + ""
    seen <- cert_cn(&pder)
    got := sc.read() or (err) {
        println(err.msg())
        done <- 1
        <<
    }
    sc.write(&got) or (err) {
        println(err.msg())
        done <- 1
        <<
    }
    done <- 0
}

fn main() int {
    srv_sign := "-----BEGIN CERTIFICATE-----\nMIIBwzCCAWmgAwIBAgIULV3gUyDKjH2+ehom1cPgPi/QO8cwCgYIKoEcz1UBg3Uw\nNzELMAkGA1UEBhMCQ04xCzAJBgNVBAoMAlh1MRswGQYDVQQDDBJnbXRscy1zaWdu\nLmV4YW1wbGUwHhcNMjYwODI1MDc1MzIxWhcNMzYwODIyMDc1MzIxWjA3MQswCQYD\nVQQGEwJDTjELMAkGA1UECgwCWHUxGzAZBgNVBAMMEmdtdGxzLXNpZ24uZXhhbXBs\nZTBZMBMGByqGSM49AgEGCCqBHM9VAYItA0IABKYKXZPbLENNptofd9GyyKMmz81d\nPketmWsT+gNFPBZJwxDiBCRAQQKA/Fq+kh3EtoSVzO5Qs6f6lZMJa6ZWl3ujUzBR\nMB0GA1UdDgQWBBRu8w7Gd1kH6L7ur/8WNecSEPsQaTAfBgNVHSMEGDAWgBRu8w7G\nd1kH6L7ur/8WNecSEPsQaTAPBgNVHRMBAf8EBTADAQH/MAoGCCqBHM9VAYN1A0gA\nMEUCIQDI/+07v4wkV4f77aqvmmCMYAUmT5A/oCrs2ofT9ymZcQIgHDOK0euAvdUd\nAln6TEe423BLmhrpYfz8aF5fu18Y1SA=\n-----END CERTIFICATE-----\n"
    srv_enc := "-----BEGIN CERTIFICATE-----\nMIIBwDCCAWegAwIBAgIUQknAJ5G3Kf9s51R2TJAlGzHienQwCgYIKoEcz1UBg3Uw\nNjELMAkGA1UEBhMCQ04xCzAJBgNVBAoMAlh1MRowGAYDVQQDDBFnbXRscy1lbmMu\nZXhhbXBsZTAeFw0yNjA4MjUwNzUzMjFaFw0zNjA4MjIwNzUzMjFaMDYxCzAJBgNV\nBAYTAkNOMQswCQYDVQQKDAJYdTEaMBgGA1UEAwwRZ210bHMtZW5jLmV4YW1wbGUw\nWTATBgcqhkjOPQIBBggqgRzPVQGCLQNCAASlovSgWAQ6rsYyxZ1o3R/3LmeOOTJI\nlUeRlZ90PD0EaBkwSIcIkxZ8BqflAKq5Az5XCPv3QA8L6f9Z2go0n1sQo1MwUTAd\nBgNVHQ4EFgQUrlc6bxZs8q5k+j7VKa4wvZThzAMwHwYDVR0jBBgwFoAUrlc6bxZs\n8q5k+j7VKa4wvZThzAMwDwYDVR0TAQH/BAUwAwEB/zAKBggqgRzPVQGDdQNHADBE\nAiBokH5BDE98HkZVhbsZvt2EOrvGyDnFmi9hSmLV04Z/FwIgbm286FpOXVoxTC5a\nP25CtB8R8qJGD8nXiVcIDHk6bac=\n-----END CERTIFICATE-----\n"
