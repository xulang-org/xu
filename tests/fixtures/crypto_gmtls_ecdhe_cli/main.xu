    srv_ek := "-----BEGIN PRIVATE KEY-----\nMEECAQAwEwYHKoZIzj0CAQYIKoEcz1UBgi0EJzAlAgEBBCApvkfwCxzHV2ubI6ET\nCjvlLm8xs8tPWlvTg9abTcZAjQ==\n-----END PRIVATE KEY-----\n"
    cli_sign := "-----BEGIN CERTIFICATE-----\nMIIByzCCAXGgAwIBAgIUCQ1zkW1eJBkkj5kWCNTFusfGCUUwCgYIKoEcz1UBg3Uw\nOzELMAkGA1UEBhMCQ04xCzAJBgNVBAoMAlh1MR8wHQYDVQQDDBZnbXRscy1jbGkt\nc2lnbi5leGFtcGxlMB4XDTI2MDgyNTE3NTY1NVoXDTM2MDgyMjE3NTY1NVowOzEL\nMAkGA1UEBhMCQ04xCzAJBgNVBAoMAlh1MR8wHQYDVQQDDBZnbXRscy1jbGktc2ln\nbi5leGFtcGxlMFkwEwYHKoZIzj0CAQYIKoEcz1UBgi0DQgAE+/CmUOpCcxqJbjq2\nQniD9YHDqG8AeDVPMK4IbyK7ISKgqT8CVNjpnf59rOe33dv/wjr2n0f8bGjIeQaT\nV2oUBaNTMFEwHQYDVR0OBBYEFO05In3rDwOU+Ii49neJRqy/e4GFMB8GA1UdIwQY\nMBaAFO05In3rDwOU+Ii49neJRqy/e4GFMA8GA1UdEwEB/wQFMAMBAf8wCgYIKoEc\nz1UBg3UDSAAwRQIgOE4xI2+ichOrYCEBXK2vykwvsZfEUe4MvOPhzcQ6ticCIQDV\n6ZjPSQFtWGik3gGiXtW3WZeJuzha2Z4Cmhwl4xIB7A==\n-----END CERTIFICATE-----\n"
    cli_enc := "-----BEGIN CERTIFICATE-----\nMIIByTCCAW+gAwIBAgIUVAduJvd1eLIFgNmh4pDOSFoEFwswCgYIKoEcz1UBg3Uw\nOjELMAkGA1UEBhMCQ04xCzAJBgNVBAoMAlh1MR4wHAYDVQQDDBVnbXRscy1jbGkt\nZW5jLmV4YW1wbGUwHhcNMjYwODI1MTc1NjU1WhcNMzYwODIyMTc1NjU1WjA6MQsw\nCQYDVQQGEwJDTjELMAkGA1UECgwCWHUxHjAcBgNVBAMMFWdtdGxzLWNsaS1lbmMu\nZXhhbXBsZTBZMBMGByqGSM49AgEGCCqBHM9VAYItA0IABD5LanpvwTbrIM3SazTJ\n0a1ycU+1NH1PpGbEMTm1uEAgtrIqC7Lk9VRXJZVMkQxf2cqZ+mQFTQSTdmiw0S/j\nOdejUzBRMB0GA1UdDgQWBBR4UI3f+mxxbBIGfK0kz3pvQ3Jm8DAfBgNVHSMEGDAW\ngBR4UI3f+mxxbBIGfK0kz3pvQ3Jm8DAPBgNVHRMBAf8EBTADAQH/MAoGCCqBHM9V\nAYN1A0gAMEUCIC1NB8r6JGw8t2zbJZKizyPzMH6ehccDxjseK13fpRApAiEAhvEq\nrtrtlB2DHg0sA65AUtbwWNoQqKUMb8zTQk6lT3o=\n-----END CERTIFICATE-----\n"
    cli_sk := "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqBHM9VAYItBG0wawIBAQQgieC8TNdvaipHRW6v\n6KnRPUJ9liUPHi+DcqslmRP49MmhRANCAAT78KZQ6kJzGoluOrZCeIP1gcOobwB4\nNU8wrghvIrshIqCpPwJU2Omd/n2s57fd2//COvafR/xsaMh5BpNXahQF\n-----END PRIVATE KEY-----\n"
    cli_ek := "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqBHM9VAYItBG0wawIBAQQgvPb+ffDWu17H9QQR\nVbGQfT9msGM1tXLerWKpf21oJpqhRANCAAQ+S2p6b8E26yDN0ms0ydGtcnFPtTR9\nT6RmxDE5tbhAILayKguy5PVUVyWVTJEMX9nKmfpkBU0Ek3ZosNEv4znX\n-----END PRIVATE KEY-----\n"
    cfg_srv := gmtls.Config{
        server_name: "gmtls-sign.example",
        client_name: "",
        insecure_skip_verify: false,
        sign_cert: srv_sign,
        sign_key: srv_sk,
        enc_cert: srv_enc,
        enc_key: srv_ek,
        cipher_suite: gmtls.ecdhe_sm4_gcm_sm3
    }
    cfg_cli := gmtls.Config{
        server_name: "gmtls-sign.example",
        client_name: "",
        insecure_skip_verify: false,
        sign_cert: cli_sign,
        sign_key: cli_sk,
        enc_cert: cli_enc,
        enc_key: cli_ek,
        cipher_suite: gmtls.ecdhe_sm4_gcm_sm3
    }
    pair := net.pipe()
    done := chan int{cap: 1}
    seen := chan string{cap: 1}
    xu serve(pair.c2, cfg_srv, seen, done)
    mut cc := gmtls.client(pair.c1, &cfg_cli) or (err) {
        println(err.msg())
        << 1
    }
    println(cc.cipher_suite)
    sder := cc.peer_sign_cert + ""
    println(cert_cn(&sder))
    cli_cn := <-seen
    println(cli_cn)
    msg := "hi"
    cc.write(&msg) or (err) {
        println(err.msg())
        << 1
    }
    back := cc.read() or (err) {
        println(err.msg())
        << 1
    }
    println(back)
    st := <-done
    << st
}
