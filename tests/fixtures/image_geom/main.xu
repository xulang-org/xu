@main

#image
#image/color

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    r := image.rect(0, 0, 2, 2)
    println(r.dx())
    println(r.dy())
    show_bool(r.empty() == false)
    p := image.pt(1, 1)
    show_bool(p.in_rect(r))
    show_bool(image.pt(2, 2).in_rect(r) == false)
    inter := r.intersect(image.rect(1, 0, 3, 2))
    println(inter.min.x)
    println(inter.dx())
    un := r.union(image.rect(1, 1, 4, 4))
    println(un.max.x)
    println(un.max.y)
    show_bool(r.overlaps(image.rect(1, 1, 3, 3)))
    show_bool(r.overlaps(image.rect(5, 5, 6, 6)) == false)
    cr := image.rect(3, 1, 0, 4).canon()
    println(cr.min.x)
    println(cr.max.x)
    mut img := image.new_rgba(r)
    c := color.RGBA{r: 10, g: 20, b: 30, a: 255}
    img.set_rgba(0, 0, c)
    got := img.at_rgba(0, 0)
    println(got.r)
    println(got.g)
    println(got.b)
    println(got.a)
    miss := img.at_rgba(9, 9)
    println(miss.a)
    println(img.pix_offset(1, 1))
    shifted := r.add(image.pt(10, 20))
    println(shifted.min.x)
    println(shifted.min.y)
    << 0
}
