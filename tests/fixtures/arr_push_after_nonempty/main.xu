@main
fn main() int {
    // Regression: vectorized push-fill must APPEND, not overwrite from ptr+0.
    mut a := []int{}
    a.push(1)
    a.push(2)
    a.push(3)
    for i in 0:10 {
        a.push(100 + i)
    }
    println(a.len)
    println(a[0])
    println(a[1])
    println(a[2])
    println(a[3])
    println(a[12])
    // Empty-array fill is still correct.
    mut b := []int{}
    for i in 0:8 {
        b.push(i)
    }
    println(b.len)
    println(b[0])
    println(b[7])
    // Non-empty then large fill.
    mut c := []int{}
    c.push(9)
    for i in 0:100 {
        c.push(i)
    }
    println(c.len)
    println(c[0])
    println(c[1])
    println(c[100])
    << 0
}
