struct S100 {
    x int
    text string
}

fn (s S099) value() int { << s.x }
fn (s S100) value() int { << s.x }
fn read_ref(s &S100) int { << s.x }
fn bump(s &mut S100) { s.x += 1 }

fn main() int {
    mut s := S100{x: 100, text: "state" + ""}
    s99 := S099{x: 99}
    println(s99.value())
    println(s.value())
    println(read_ref(&s))
    bump(mut &s)
    println(s.value())
    boxed := S100{x: 1000, text: "boxed" + ""}
    let e: temp = boxed
    println(e is S100)
    unboxed := e as S100
    println(unboxed.x)
    println(unboxed.text.len)
    let valued: Valued = S100{x: 2000, text: "iface" + ""}
    println(valued is S100)
    println(valued.value())
    concrete := valued as S100
    println(concrete.text.len)
    kept := S100{x: 3000, text: "any" + ""}
    let a: any = kept
    println(a is S100)
    captured := "capture" + ""
    closure := fn() int { << captured.len }
    println(closure())
    << 0
}
