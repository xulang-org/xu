@main

// Regression for the main-M park handshake: workers sleep before entering a
// recv/send select, then rendezvous with the parent through a buffered chan.
// The final else arm also proves that all six sends completed without leaving
// a stale waiter behind.
fn worker(id int, out chan int, stop chan int) {
    out <- id * 10
    sleep_ns(1000000)
    select {
        x := <-stop {
            _ := x
            out <- id * 10 + 9
            <<
        }
        out <- id * 10 + 1 {
        }
    }
    out <- id * 10 + 2
}

fn main() int {
    out := chan int{cap: 16}
    stop1 := chan int{cap: 1}
    stop2 := chan int{cap: 1}
    xu worker(1, out, stop1)
    xu worker(2, out, stop2)

    mut sum := 0
    mut i := 0
    while i < 6 {
        sum = sum + (<-out)
        i = i + 1
    }
    sleep_ns(1000000)
    select {
        x := <-out {
            println("extra:" + str(x))
            << 1
        }
        else {
            println(sum)
            println("ok")
            << 0
        }
    }
    << 0
}
