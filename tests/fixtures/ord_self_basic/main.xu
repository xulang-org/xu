@main

#cmp

struct Point {
    x int
}

fn (p Point) less(other Point) bool {
    << p.x < other.x
}

fn min2(a# Ord, b# Ord) Ord {
    if a.less(b) {
        << a
    }
    << b
}

fn main() int {
    p := min2(Point{x: 5}, Point{x: 2})
    println(p.x)
    println(min2(9, 3))
    println(min2(1.5, 2.5))
    s := min2("banana", "apple")
    println(s)
    << 0
}
