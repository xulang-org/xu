@main

#net/mail

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn parse_address_fails(s &string) bool {
    mail.parse_address(s) or (err) { << true }
    << false
}

fn main() int {
    a1 := "Alice <alice@example.com>"
    p1 := mail.parse_address(&a1) or (err) { << 1 }
    println(p1.name)
    println(p1.address)
    println(p1.to_string())
    a2 := "bob@ex.com"
    p2 := mail.parse_address(&a2) or (err) { << 1 }
    println(p2.name.len)
    println(p2.address)
    println(p2.to_string())
    a3 := "\"Bob Smith\" <bob@ex.com>"
    p3 := mail.parse_address(&a3) or (err) { << 1 }
    println(p3.name)
    println(p3.to_string())
    lst := "Alice <alice@example.com>, bob@ex.com"
    all := mail.parse_address_list(&lst) or (err) { << 1 }
    println(all.len)
    println(all[0].address)
    println(all[1].address)
    bad := "not-an-address"
    show_bool(parse_address_fails(&bad))
    << 0
}
