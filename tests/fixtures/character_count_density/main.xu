@main
#strings
fn main() int {
    for c in 0:256 {
        for n in 0:66 {
            mut dense := make_string(n)
            mut half := make_string(n)
            mut sparse := make_string(n)
            for i in 0:n {
                dense[i] = c
                half[i] = (c + (i & 1)) & 255
                sparse[i] = (c + 1) & 255
            }
            if n > 0 { sparse[n - 1] = c }
            if count_byte(&dense, c) != n { << 1 }
            if count_byte(&dense, c + 256) != n { << 2 }
            if count_byte(&half, c) != (n + 1) / 2 { << 3 }
            if count_byte(&sparse, c) != (n + 65) / 66 { << 4 }
            // Owned unaligned subwindows, including every vector tail.
            mut padded := "x" + dense + "y"
            window := padded[1:n + 1]
            if count_byte(&window, c) != n { << 5 }
        }
        mut long := make_string(1025)
        for i in 0:long.len { long[i] = c }
        if count_byte(&long, c) != long.len { << 6 }
        if count_byte(&long, (c + 1) & 255) != 0 { << 7 }
        parts := split_byte(&long, c)
        if parts.len != long.len + 1 { << 8 }
    }
    println("PASS")
    << 0
}
