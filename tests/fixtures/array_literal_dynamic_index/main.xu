@main

// Regression: a fixed literal lowered to an owning slice must keep literal
// element temps materialized when a helper is compiled with register caching.
fn pick(i int) int {
    xs := [17623, 9916, 25195, 4958, 22409, 13794, 28981, 2479, 19832, 12051, 27588, 6897, 24102, 15437, 30874, 18348]
    << xs[i]
}

fn main() int {
    for i in 0:16 {
        println(pick(i))
    }
    << 0
}
