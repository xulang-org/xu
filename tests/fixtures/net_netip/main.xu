@main

#net/netip

fn main() int {
    a := netip.parse_addr("127.0.0.1") or (err) { << 1 }
    println(a.is4())
    println(a.is_loopback())
    println(a.to_string())
    ap := netip.parse_addr_port("127.0.0.1:80") or (err) { << 1 }
    println(ap.to_string())
    println(ap.port)
    p := netip.parse_prefix("192.0.2.1/24") or (err) { << 1 }
    println(p.to_string())
    b := netip.parse_addr("192.0.2.99") or (err) { << 1 }
    println(p.contains(b))
    c := netip.parse_addr("10.0.0.1") or (err) { << 1 }
    println(p.contains(c))
    d := netip.parse_addr("::1") or (err) { << 1 }
    println(d.is6())
    println(d.is_loopback())
    << 0
}
