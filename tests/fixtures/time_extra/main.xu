@main

#time

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    spec := "1h30m"
    d := time.parse_duration(&spec) or (err) { << 1 }
    println(d == 5400000000000)
    println(time.format_duration(d))
    t := time.unix(0, 0)
    println(t.format_rfc3339())
    rfc := "1970-01-01T00:00:01Z"
    t2 := time.parse_rfc3339(&rfc) or (err) { << 1 }
    println(t2.unix())
    show_bool(t.before(t2))
    show_bool(t2.after(t))
    t3 := t.add(time.second())
    println(t3.sub(t) == time.second())
    << 0
}
