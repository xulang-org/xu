@main

fn bias(x int, salt int) int {
    mut y := x
    y = (y * 31 + salt) ^ (y >> 5)
    y = (y * 31 + salt) ^ (y >> 5)
    y = (y * 31 + salt) ^ (y >> 5)
    y = (y * 31 + salt) ^ (y >> 5)
    y = (y * 31 + salt) ^ (y >> 5)
    y = (y * 31 + salt) ^ (y >> 5)
    << y
}

fn bump(p &mut int, salt int) {
    *p += salt
}

fn plain(a &mut []int, p int, x int, y int) int {
    a[p] = (a[p] + x) ^ y
    a[(p + 1) & 15] = a[p] + x - y
    a[p] = a[p] ^ (x + y)
    << a[p] + a[(p + 1) & 15] + x - y
}

fn changing(a &mut []int, p int, seed int) int {
    mut x := seed
    a[p] = x + a[p]
    x = x * 3 - 5
    a[(p + 1) & 15] = x ^ a[p]
    x += 11
    a[p] = x - a[p]
    << a[p] + a[(p + 1) & 15] + x
}

fn escaped(a &mut []int, p int, seed int) int {
    mut x := seed
    a[p] = x + a[p]
    bump(mut &x, a[(p + 1) & 15])
    a[p] = x ^ a[p]
    << a[p] + x
}

fn called(a &mut []int, p int, x int) int {
    a[p] = x + a[p]
    a[(p + 1) & 15] = bias(x, a[p])
    a[p] = x ^ a[(p + 1) & 15]
    << a[p] + x
}

fn main() int {
    for k in 0:32 {
        mut a := []int{}
        for j in 0:16 { a.push((j * 17 - k * 31) ^ (k << 53)) }
        p := k & 15
        x := (k * 123 - 77) ^ (k << 58)
        y := k * 73 - 115
        println(plain(mut &a, p, x, y))
        println(changing(mut &a, p, x))
        println(escaped(mut &a, p, x))
        println(called(mut &a, p, x))
        for j in 0:16 { println(a[j]) }
    }
    << 0
}
