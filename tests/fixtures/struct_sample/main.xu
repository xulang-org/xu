@main
struct User {
    name string
    age  int
}
fn (u User) is_adult() bool { << u.age >= 18 }
fn (u &mut User) have_birthday() { u.age += 1 }
fn main() int {
    mut u := User{name: "ada", age: 36}
    u.have_birthday()
    println(u.age)
    println(u.is_adult())
    println(u.name + " lovelace")
    println(u.name == "ada")
    << 0
}
