@main

#regexp

fn main() int {
    re := regexp.compile("(\\w+)@(\\w+)") or (err) { << 1 }
    t := "a@b c@d"
    r1 := "$$1 at $$2"
    println(re.replace_all(&t, &r1))
    r0 := "[$$1|$$2|$$0]"
    t2 := "user@ex"
    println(re.replace_all(&t2, &r0))
    rd := "$$$$"
    t3 := "x@y"
    println(re.replace_all(&t3, &rd))
    t4 := "nope"
    println(re.replace_all(&t4, &r1))
    t5 := "a@b c@d nope"
    all := re.find_all_submatch(&t5, -1)
    println(all.len)
    println(all[0][0])
    println(all[0][1])
    println(all[0][2])
    println(all[1][0])
    println(all[1][1])
    println(all[1][2])
    one := re.find_all_submatch(&t5, 1)
    println(one.len)
    println(one[0][0])
    re2 := regexp.compile("(a)?b") or (err) { << 1 }
    t6 := "ab"
    r2 := "$$1X$$0"
    println(re2.expand(&t6, &r2))
    t7 := "b"
    println(re2.expand(&t7, &r2))
    lit := regexp.compile("foo|bar") or (err) { << 1 }
    t8 := "xxfooyybarzz"
    x := "X"
    println(lit.replace_all(&t8, &x))
    << 0
}
