@main

#net

// Unsupported networking features must fail before touching a platform
// syscall and must expose the same public error contract on every target.

fn raw_ip_fails() bool {
    local := net.new_ip_addr()
    remote := net.IPAddr{ip: net.ipv4(127, 0, 0, 1), zone: ""}
    _ := net.dial_ip("ip4", local, remote) or (err) {
        println(err.msg())
        << true
    }
    << false
}

fn ipv6_udp_fails() bool {
    local := net.UDPAddr{ip: net.ipv6_loopback(), port: 1, zone: ""}
    _ := net.listen_udp("udp6", local) or (err) {
        println(err.msg())
        << true
    }
    << false
}

fn main() int {
    if !raw_ip_fails() {
        << 1
    }
    if !ipv6_udp_fails() {
        << 1
    }
    << 0
}
