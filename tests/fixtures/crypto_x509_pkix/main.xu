@main

#crypto/x509/pkix

fn main() int {
    mut org := []string{}
    org.push("Xu")
    mut ou := []string{}
    ou.push("Lang")
    mut loc := []string{}
    loc.push("Beijing")
    mut st := []string{}
    st.push("BJ")
    mut street := []string{}
    street.push("1 Main")
    mut postal := []string{}
    postal.push("100000")
    mut country := []string{}
    country.push("CN")
    n := pkix.Name{
        country: country,
        organization: org,
        organizational_unit: ou,
        locality: loc,
        province: st,
        street_address: street,
        postal_code: postal,
        serial_number: "42",
        common_name: "xu-test.example"
    }
    println(n.text())
    empty := pkix.Name{
        country: []string{},
        organization: []string{},
        organizational_unit: []string{},
        locality: []string{},
        province: []string{},
        street_address: []string{},
        postal_code: []string{},
        serial_number: "",
        common_name: ""
    }
    println(empty.text().len)
    only := pkix.Name{
        country: []string{},
        organization: []string{},
        organizational_unit: []string{},
        locality: []string{},
        province: []string{},
        street_address: []string{},
        postal_code: []string{},
        serial_number: "",
        common_name: "only"
    }
    println(only.text())
    << 0
}
