@main

// A by-value struct local must not dump fixed-home allocation for the
// surrounding scalar loop. Field traffic stays frame-backed.

struct P {
    x int
    y int
}

fn main() int {
    p := P{x: 3, y: 4}
    mut s := 0
    mut i := 0
    while i < 5 {
        s = s + i
        i = i + 1
    }
    println(s)
    println(p.x)
    println(p.y)
    << 0
}
