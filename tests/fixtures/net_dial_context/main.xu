@main

#net
#context

fn quiet_close_conn(c net.Conn) {
    mut conn := c
    conn.close() or (err) {
        <<
    }
}

fn quiet_close_ln(l net.Listener) {
    mut ln := l
    ln.close() or (err) {
        <<
    }
}

fn main() int {
    mut c := context.with_cancel()
    c.cancel()
    net.dial_context(&c.ctx, "tcp", "127.0.0.1:1") or (err) {
        println(err.msg())
        mut t := context.with_timeout(1)
        sleep_ns(20000000)
        net.dial_context(&t.ctx, "tcp", "127.0.0.1:1") or (e2) {
            println(e2.msg())
            mut ln := net.listen_on("tcp", "127.0.0.1:19121") or (e3) {
                << 1
            }
            mut conn := net.dial_to("tcp", "127.0.0.1:19121") or (e4) {
                << 1
            }
            conn.set_deadline(1)
            msg := "x"
            conn.write(&msg) or (e6) {
                println(e6.msg())
                quiet_close_conn(conn)
                quiet_close_ln(ln)
                net.dial_timeout("tcp", "127.0.0.1:1", -1) or (e9) {
                    println(e9.msg())
                    lc := net.new_listen_config()
                    lc.listen(&c.ctx, "tcp", "127.0.0.1:19122") or (e10) {
                        println(e10.msg())
                        << 0
                    }
                    << 1
                }
                << 1
            }
            << 1
        }
        << 1
    }
    << 1
}
