@main

#net/http

fn main() int {
    mut h := http.new_header()
    k := "Content-Type"
    v := "text/plain"
    h.set(&k, &v)
    k2 := "X-A"
    v2 := "1"
    h.add(&k2, &v2)
    c := h.clone()
    println(c.len())
    println(c.get(&k))
    println(http.status_text(404))
    println(http.status_text(302))
    << 0
}
