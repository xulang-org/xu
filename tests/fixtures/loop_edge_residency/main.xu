@main

// Both branch arms shrink a range around a derived index. The carried total must survive
// either edge, regardless of which arm is emitted as the false successor.
fn consume_left(src &[]int, begin int, end int, seed int) int {
    mut pos := begin
    mut stop := end
    mut total := seed
    while pos < stop {
        total += 7
        middle := pos + ((stop - pos) >> 1)
        if (src[middle] & 1) == 0 { pos = middle + 1 } else { stop = middle }
    }
    << total
}

fn consume_right(src &[]int, begin int, end int, seed int) int {
    mut pos := begin
    mut stop := end
    mut total := seed
    while pos < stop {
        total += 7
        middle := pos + ((stop - pos) >> 1)
        if (src[middle] & 1) != 0 { stop = middle } else { pos = middle + 1 }
    }
    << total
}

// A branch can leave the loop before its ordinary latch, and continue can
// reach that latch through a different predecessor.
fn consume_until(src &[]int, limit int, seed int) int {
    mut pos := 0
    mut total := seed
    while pos < src.len {
        total += 7
        value := src[pos]
        if value == limit { <- }
        pos += 1
        if (value & 1) == 0 { -> }
        total += 3
    }
    << total
}

fn main() int {
    mut values := []int{}
    for i in 0:16 { values.push(i) }
    for first in 0:5 {
        for length in 0:7 {
            println(consume_left(&values, first, first + length, 11))
            println(consume_right(&values, first, first + length, 11))
        }
    }
    println(consume_left(&values, 8, 3, -5) == -5)
    println(consume_right(&values, 8, 3, -5) == -5)
    println(consume_until(&values, 0, 5) == 12)
    println(consume_until(&values, 5, 5) == 53)
    println(consume_until(&values, 15, 5) == 138)
    println(consume_until(&values, 100, 5) == 141)
    mut empty := []int{}
    println(consume_until(&empty, 0, 5) == 5)
    << 0
}
