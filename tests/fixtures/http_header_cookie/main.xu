@main

#net/http

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn parse_cookie_fails(line &string) bool {
    http.parse_cookie(line) or (err) { << true }
    << false
}

fn main() int {
    ct := "content-type"
    println(http.canonical_header_key(&ct))
    xfb := "x-foo-bar"
    println(http.canonical_header_key(&xfb))
    host := "Host"
    println(http.canonical_header_key(&host))
    mut h := http.new_header()
    k1 := "accept"
    v1 := "*/*"
    h.add(&k1, &v1)
    v2 := "text/plain"
    h.add(&k1, &v2)
    println(h.get(&k1))
    vs := h.values(&k1)
    println(vs.len)
    println(vs[1])
    setv := "application/json"
    h.set(&k1, &setv)
    println(h.get(&k1))
    println(h.values(&k1).len)
    h.del(&k1)
    println(h.get(&k1).len)
    hk := "X-Id"
    hv := "7"
    h.add(&hk, &hv)
    wr := h.write()
    println(wr.len > 0)
    crlf := string_from_byte(13) + string_from_byte(10)
    raw := "Host: example.com" + crlf + "Accept: a" + crlf + "Accept: b" + crlf
    ph := http.parse_header(&raw)
    hk2 := "host"
    println(ph.get(&hk2))
    ak := "accept"
    println(ph.values(&ak).len)

    line := "a=1; b=\"two\""
    cs := http.parse_cookie(&line) or (err) { << 1 }
    println(cs.len)
    println(cs[0].name)
    println(cs[0].value)
    println(cs[1].value)
    sc := "id=abc; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=60"
    c := http.parse_set_cookie(&sc) or (err) { << 1 }
    println(c.name)
    println(c.value)
    println(c.path)
    println(c.max_age)
    show_bool(c.http_only)
    show_bool(c.secure)
    println(c.same_site)
    println(c.to_string())
    joined := http.cookie_header(&cs)
    println(joined)
    blank := ""
    show_bool(parse_cookie_fails(&blank))
    << 0
}
