@main

#encoding/asn1
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn as_octet_fails(v asn1.Value) bool {
    v.as_octet() or (err) { << true }
    << false
}

fn main() int {
    hi := "hi"
    oct := asn1.marshal_octet(&hi)
    vo := asn1.unmarshal(&oct) or (err) { << 1 }
    println(vo.as_octet() or (err) { << 1 })
    utf := asn1.marshal_utf8(&hi)
    vu := asn1.unmarshal(&utf) or (err) { << 1 }
    println(vu.as_utf8() or (err) { << 1 })
    nn := asn1.marshal_null()
    vn := asn1.unmarshal(&nn) or (err) { << 1 }
    show_bool(vn.as_null() or (err) { << 1 })
    bits := asn1.marshal_bit_string(&hi)
    println(hex.encode_to_string(bits + ""))
    vb := asn1.unmarshal(&bits) or (err) { << 1 }
    println(vb.as_bit_string() or (err) { << 1 })
    show_bool(as_octet_fails(vn))
    << 0
}
