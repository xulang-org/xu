@main

#crypto/rc4
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn new_cipher_fails(key &string) bool {
    rc4.new_cipher(key) or (err) { << true }
    << false
}

fn main() int {
    k1 := "Key"
    p1 := "Plaintext"
    mut c1 := rc4.new_cipher(&k1) or (err) { << 1 }
    ct1 := c1.xor_key_stream(&p1)
    println(hex.encode_to_string(ct1 + ""))
    show_bool(hex.encode_to_string(ct1 + "") == "bbf316e8d940af0ad3")
    mut d1 := rc4.new_cipher(&k1) or (err) { << 1 }
    back := d1.xor_key_stream(&ct1)
    show_bool(back == p1)
    k2 := "Wiki"
    p2 := "pedia"
    mut c2 := rc4.new_cipher(&k2) or (err) { << 1 }
    ct2 := c2.xor_key_stream(&p2)
    println(hex.encode_to_string(ct2 + ""))
    k3 := "Secret"
    p3 := "Attack at dawn"
    mut c3 := rc4.new_cipher(&k3) or (err) { << 1 }
    ct3 := c3.xor_key_stream(&p3)
    println(hex.encode_to_string(ct3 + ""))
    empty := ""
    show_bool(new_cipher_fails(&empty))
    << 0
}
