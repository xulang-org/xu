@main

#crypto/hmac
#strings

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    empty := ""
    println(hmac.sum256(&empty, &empty))
    k := "key"
    fox := "The quick brown fox jumps over the lazy dog"
    println(hmac.sum256(&k, &fox))
    xus := "Xu"
    hello := "hello"
    println(hmac.sum256(&xus, &hello))
    mut kb := []int{}
    for i in 0:20 {
        kb.push(11)
    }
    rk := string_from_bytes(kb)
    hi := "Hi There"
    println(hmac.sum256(&rk, &hi))
    a := "a"
    longk := strings.repeat(&a, 80)
    msg := "msg"
    println(hmac.sum256(&longk, &msg))
    h1 := hmac.sum256(&k, &fox)
    h2 := hmac.sum256(&k, &fox)
    show_bool(hmac.equal(&h1, &h2))
    other := "nope"
    show_bool(hmac.equal(&h1, &other))
    mut kb32 := []int{}
    for i in 0:32 {
        kb32.push(11)
    }
    rk32 := string_from_bytes(kb32)
    println(hmac.sum_sm3(&rk32, &hi))
    jefe := "Jefe"
    nothing := "what do ya want for nothing?"
    println(hmac.sum_sm3(&jefe, &nothing))
    << 0
}
