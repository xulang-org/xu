@main

#net/textproto

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn parse_code_fails(line &string) bool {
    textproto.parse_code_line(line) or (err) { << true }
    << false
}

fn main() int {
    ct := "content-type"
    println(textproto.canonical_mime_header_key(&ct))
    xfb := "x-foo-bar"
    println(textproto.canonical_mime_header_key(&xfb))
    sp := "  hi" + string_from_byte(9)
    println(textproto.trim_string(&sp))
    crlf := string_from_byte(13) + string_from_byte(10)
    raw := "Subject: hello" + crlf + " world" + crlf + "From: a@b.com" + crlf + crlf + "body"
    hr := textproto.read_mime_header(&raw)
    sk := "subject"
    println(hr.header.get(&sk))
    fk := "from"
    println(hr.header.get(&fk))
    println(hr.rest)
    ok := "250 Hello there"
    cl := textproto.parse_code_line(&ok) or (err) { << 1 }
    println(cl.code)
    println(cl.msg)
    show_bool(cl.cont)
    more := "250-More"
    c2 := textproto.parse_code_line(&more) or (err) { << 1 }
    println(c2.code)
    println(c2.msg)
    show_bool(c2.cont)
    bad := "xyz"
    show_bool(parse_code_fails(&bad))
    << 0
}
