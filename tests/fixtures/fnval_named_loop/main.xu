@main

// User-shaped named function value in a counted loop.
// The callee is a pure `x + 1` leaf and must peep without fat-pointer blr.
fn bump(x int) int {
    << x + 1
}

fn main() int {
    f := bump
    mut s := 0
    mut i := 0
    while i < 8000 {
        s += f(i & 7)
        i += 1
    }
    println(s)
    << 0
}
