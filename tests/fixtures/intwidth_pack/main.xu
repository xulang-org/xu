@main
struct Pack {
    a u8
    b u8
    c i32
}
fn main() int {
    mut p := Pack{a: 1, b: 2, c: -3}
    println(int(p.a))
    println(int(p.b))
    println(int(p.c))
    mut xs := []u8{}
    xs.push(255)
    xs.push(1)
    println(int(xs[0] + xs[1]))
    x := u8(300)
    println(int(x))
    y := i32(2147483647) + i32(1)
    println(int(y))
    << 0
}
