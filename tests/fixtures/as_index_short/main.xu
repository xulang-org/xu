@main

fn take(xs []temp) {
    n := xs.len
    if n >= 1 {
        if xs[0] is int {
            println(xs[0] as int)
        }
    }
    if n >= 2 {
        if xs[1] is string {
            println(xs[1] as string)
        }
    }
}

fn pack(xs <-> temp) {
    take(xs)
}

fn main() int {
    mut empty := []temp{}
    if empty.len >= 1 {
        println(empty[0] as int)
    } else {
        println("empty")
    }
    mut xs := []temp{}
    xs.push(7)
    if xs.len >= 2 {
        println(xs[1] as int)
    } else {
        println("short")
    }
    println(xs[0] as int)
    pack(2)
    pack(2, "x")
    << 0
}
