@main

fn lower_bound_steps(a &[]int, x int) int {
    mut lo := 0
    mut hi := a.len
    mut steps := x + 1
    while lo < hi {
        steps += 3
        mid := lo + ((hi - lo) >> 1)
        if a[mid] < x {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    << steps
}

fn main() int {
    mut values := []int{}
    mut i := 0
    while i < 4096 {
        values.push(i * 3)
        i += 1
    }
    println(lower_bound_steps(&values, 6145))
    << 0
}
