@main

fn main() int {
    mut n := 0
    for i in 0:10000 {
        mut xs := [][]int{}
        mut a := []int{}
        a.push(1)
        xs.push(a)
        r := mut &xs[0]
        r[0] = 2
        r.push(3)
        if xs[0][0] == 2 {
            n += xs[0][1]
        }
    }
    println(n)
    println("ok")
    << 0
}
