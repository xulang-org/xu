@main

#container/list

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn dump(l &list.List) {
    println(list.len(l))
    mut e := list.front(l)
    while e != 0 {
        println(list.value(l, e))
        e = list.next(l, e)
    }
}

fn main() int {
    mut l := list.new()
    a0 := l.push_back("a")
    b := l.push_back("b")
    c0 := l.push_back("c")
    dump(&l)
    mid := l.remove(b)
    println(mid)
    dump(&l)
    z0 := l.push_front("z")
    dump(&l)
    f := list.front(&l)
    l.move_to_back(f)
    dump(&l)
    m0 := l.insert_after(list.front(&l), "m")
    _ := z0 + m0
    dump(&l)
    show_bool(list.len(&l) == 4)
    show_bool(list.back(&l) != 0)
    show_bool(a0 > 0 && c0 > 0)
    << 0
}
