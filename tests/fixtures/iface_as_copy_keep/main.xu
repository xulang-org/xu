@main

struct@ Shape {
    fn area() int
}

struct Rect {
    w int
    h int
}

fn (r Rect) area() int { << r.w * r.h }

fn main() int {
    let e: Shape = Rect{w: 3, h: 4}
    a := e as Rect
    println(a.w)
    println(a.h)
    // Copy payload: box kept — cast and method again.
    b := e as Rect
    println(b.area())
    println(e is Rect)
    println(e.area())
    << 0
}
