@main

// Toward-zero remainder for every constant 2^k, including negatives and
// INT_MIN. The oracle is integer truncation, not a bitwise mask.
// `% 3`, `% 1` and a variable divisor stay on the general path.

fn rem32(n int) int {
    << n % 32
}

fn mod_var(n int, d int) int {
    << n % d
}

fn bit_pos_sum(n int) int {
    mut s := 0
    mut i := 0
    while i < n {
        s = s + (31 - (i % 32))
        i = i + 1
    }
    << s
}

fn neg_mod_sum() int {
    mut s := 0
    mut i := 0 - 40
    while i < 40 {
        s = s + (i % 32)
        i = i + 1
    }
    << s
}

fn fold64() int {
    mut s := 0
    mut i := 0 - 3
    while i < 70 {
        s = (s + (i % 64)) & 9223372036854775807
        i = i + 1
    }
    << s
}

fn main() int {
    maxp := 9223372036854775807
    minp := 0 - 9223372036854775807 - 1
    println(5 % 32)
    println(40 % 32)
    println((0 - 5) % 32)
    println((0 - 40) % 32)
    println((0 - 5) % 4)
    println((0 - 1) % 2)
    println(1 % 2)
    println(0 % 8)
    println(maxp % 2)
    println(maxp % 32)
    println(maxp % 4611686018427387904)
    println(minp % 2)
    println(minp % 32)
    println(minp % 4611686018427387904)
    println(minp % 4)
    println(100 % 3)
    println((0 - 100) % 3)
    println((0 - 7) % (0 - 3))
    println(7 % (0 - 3))
    println(40 % 1)
    mut x := 0 - 40
    x = x % 32
    println(x)
    println(rem32(5))
    println(rem32(0 - 5))
    println(rem32(minp))
    println(rem32(maxp))
    println(rem32(0))
    println(rem32(31))
    println(rem32(32))
    println(rem32(0 - 32))
    println(rem32(0 - 31))
    println(bit_pos_sum(128))
    println(neg_mod_sum())
    println(mod_var(0 - 5, 4))
    println(mod_var(minp, 8))
    println(fold64())
    << 0
}
