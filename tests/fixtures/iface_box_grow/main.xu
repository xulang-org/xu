@main

// Grow a struct@ method set (extra method + method returning another
// struct@) and keep name collisions (close/exec) from aliasing dispatch.

struct@ Stmt {
    fn close() string
    fn num_input() int
    fn exec([]temp) int
}

struct@ Conn {
    fn ping() string
    fn close() string
    fn dup() Conn
    fn noop() int
    fn prepare(string) Stmt
}

struct A {
    n int
}

struct B {
    n int
    q string
}

struct C {
    n int
}

fn (a A) ping() string {
    << "p" + str(a.n)
}

fn (a A) close() string {
    << "ac"
}

fn (a A) dup() Conn {
    << Conn(A{n: a.n + 1})
}

fn (a A) noop() int {
    << a.n + 7
}

fn (a A) prepare(q string) Stmt {
    << Stmt(B{n: a.n, q: q + ""})
}

fn (b B) close() string {
    << "bc"
}

fn (b B) num_input() int {
    mut n := 0
    mut i := 0
    q := b.q + ""
    while i < q.len {
        if (q[i] & 255) == 63 {
            n = n + 1
        }
        i = i + 1
    }
    << n
}

fn (b B) exec(args []temp) int {
    << args.len + b.n
}

fn (c C) ping() string {
    << "q" + str(c.n)
}

fn (c C) close() string {
    << "cc"
}

fn (c C) dup() Conn {
    << Conn(C{n: c.n})
}

fn (c C) noop() int {
    << 0
}

fn (c C) prepare(q string) Stmt {
    << Stmt(B{n: c.n, q: q + ""})
}

fn main() int {
    x := Conn(A{n: 3})
    println(x.ping())
    println(x.noop())
    y := x.dup()
    println(y.ping())
    println(x.close())
    s := x.prepare("a??b")
    println(s.num_input())
    println(s.close())
    mut z := []temp{}
    t := x.prepare("e")
    println(t.exec(z))
    u := Conn(C{n: 9})
    println(u.ping())
    println("ok")
    << 0
}
