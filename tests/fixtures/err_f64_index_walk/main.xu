@main

fn fill(v &mut []f64, u &[]f64) {
    n := v.len
    for i in 0:n {
        mut s := 0.0
        for j in 0:n {
            s += u[j]
        }
        v[i] = s
    }
}

fn main() int {
    mut u := []f64{}
    mut v := []f64{}
    u.push(1.0)
    v.push(0.0)
    v.push(0.0)
    fill(mut &v, &u)
    println(int(v[0]))
    << 0
}
