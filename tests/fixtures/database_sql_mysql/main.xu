@main

mysql #github.com/xulang-org/packages/mysql

fn main() {
    a := mysql.parse_dsn("ada:s%40cret@tcp(db.example:3307)/app?tls=false") or(err) {
        println(err.msg())
        <<
    }
    println(a.host)
    println(a.port)
    println(a.user)
    println(a.password)
    println(a.database)
    b := mysql.parse_dsn("mysql://bob:hello%20world@localhost:3306/demo") or(err) {
        println(err.msg())
        <<
    }
    println(b.host)
    println(b.port)
    println(b.user)
    println(b.password)
    println(b.database)
    _ := mysql.parse_dsn("root@tcp(localhost:3306)/db?tls=true") or(err) {
        println(err.msg())
        <<
    }
}
