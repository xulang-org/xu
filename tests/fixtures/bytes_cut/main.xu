@main

#bytes

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    s := "a/b/c"
    sep := "/"
    c := bytes.cut(&s, sep)
    println(c.before)
    println(c.after)
    show_bool(c.found)
    pre := "a/"
    p := bytes.cut_prefix(&s, pre)
    println(p.before)
    show_bool(p.found)
    suf := "/c"
    u := bytes.cut_suffix(&s, suf)
    println(u.before)
    show_bool(u.found)
    miss := "z"
    n := bytes.cut(&s, miss)
    println(n.before)
    show_bool(n.found)
    << 0
}
