@main

#slices

fn odd(x int) bool {
    << x % 2 == 1
}

fn is_b(s string) bool {
    << s == "b"
}

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    a := [2, 4, 5, 6]
    println(slices.index_func_ints(&a, odd))
    show_bool(slices.contains_func_ints(&a, odd))
    s := ["a", "b", "c"]
    println(slices.index_func_strs(&s, is_b))
    z := [2, 4]
    show_bool(slices.contains_func_ints(&z, odd))
    << 0
}
