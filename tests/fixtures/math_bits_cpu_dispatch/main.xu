@main
#math/bits

// Keep several values live across capability-selected real ABI calls.
// Constants exercise normalization before the immediate instruction choice.
fn mix(x int) int {
    mut r := bits.ones_count(x) + bits.len(x) + bits.leading_zeros(x)
    r = r ^ bits.reverse_bytes(x)
    r += bits.rotate_left(x, -65)
    r = r ^ bits.rotate_right(x, -64)
    r += bits.rotate_left(x, -1)
    r = r ^ bits.rotate_right(x, 0)
    r += bits.rotate_left(x, 7)
    r = r ^ bits.rotate_right(x, 32)
    r += bits.rotate_left(x, 63)
    r = r ^ bits.rotate_right(x, 64)
    r += bits.rotate_left(x, 129)
    if x < 0 {
        r = r ^ bits.ones_count(x ^ r)
    } else {
        r += bits.ones_count(x + r)
    }
    << r ^ bits.reverse_bytes(r)
}

fn main() {
    println(mix(0))
    println(mix(1))
    println(mix(-1))
    println(mix(9223372036854775807))
    println(mix(-9223372036854775807 - 1))
    println(mix(0x0123456789abcdef))
    println(mix(0x5555555555555555))
    println(mix(-6148914691236517206))
    mut seed := 7
    for i in 0:96 {
        seed = seed * 6364136223846793005 + 1442695040888963407
        println(mix(seed))
    }
    pop := bits.ones_count
    rev := bits.reverse_bytes
    println(pop(-1))
    println(pop(0))
    println(rev(0x0123456789abcdef))
}
