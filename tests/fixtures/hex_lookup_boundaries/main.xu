@main
#encoding/hex
#strings
fn nibble(c int) int {
    if c >= 48 && c <= 57 { << c - 48 }
    if c >= 65 && c <= 70 { << c - 55 }
    if c >= 97 && c <= 102 { << c - 87 }
    << -1
}
fn check(src &string) bool {
    out := hex.decode(src) or (err) {
        if src.len % 2 != 0 { << err.msg() == "encoding/hex: odd length" }
        for i in 0:src.len { if nibble(src[i]) < 0 { << err.msg() == "encoding/hex: invalid byte" } }
        << false
    }
    if src.len % 2 != 0 || out.len != src.len / 2 { << false }
    for i in 0:out.len {
        hi := nibble(src[i * 2])
        lo := nibble(src[i * 2 + 1])
        if hi < 0 || lo < 0 || out[i] != hi * 16 + lo { << false }
    }
    << true
}
fn escaped() string {
    backing := "!616263,ff!" + ""
    parts := strings.split(&backing, ",")
    view := parts[0][1:7]
    << hex.decode(&view) or (err) { << "FAILED" }
}
fn main() int {
    sizes := [21]int{0, 1, 2, 3, 7, 15, 16, 17, 31, 32, 33, 63, 64, 65, 127, 128, 255, 256, 2047, 2048, 2049}
    for si in 0:21 {
        n := sizes[si]
        mut raw := make_string(n)
        for i in 0:n { raw[i] = (i * 113 + n) & 255 }
        enc := hex.encode(&raw)
        if !check(&enc) { << 1 }
        mut upper := enc + ""
        for i in 0:upper.len { if upper[i] >= 97 && upper[i] <= 102 { upper[i] = upper[i] - 32 } }
        if !check(&upper) { << 2 }
        before := upper + ""
        mut out := hex.decode(&upper) or (err) { << 3 }
        if out != raw + "" || upper != before + "" { << 4 }
        if n > 0 {
            first := raw[0]
            out[0] = first ^ 255
            if raw[0] != first || upper != before + "" { << 5 }
        }
    }
    mut raw := make_string(257)
    for i in 0:257 { raw[i] = (i * 73 + 19) & 255 }
    enc := hex.encode(&raw)
    positions := [15]int{0, 1, 2, 15, 16, 17, 31, 32, 33, 63, 64, 65, 255, 256, 513}
    for pi in 0:15 {
        for c in 0:256 {
            mut changed := enc + ""
            changed[positions[pi]] = c
            if !check(&changed) { << 6 }
            // Odd length must win even when a byte is invalid.
            odd := changed + "0"
            if !check(&odd) { << 7 }
        }
    }
    mut out := escaped()
    if out != "abc" { << 8 }
    out[1] = 0
    if out.len != 3 || out[0] != 97 || out[1] != 0 || out[2] != 99 { << 9 }
    println("PASS")
    << 0
}
