@main

#bytes

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn read_byte_eof(r &mut bytes.Reader) bool {
    r.read_byte() or (err) { << true }
    << false
}

fn main() int {
    mut r := bytes.new_reader("hi!")
    println(r.size())
    println(r.length())
    println(r.read_n(2))
    println(r.length())
    println(r.read_byte() or (err) { << 1 })
    show_bool(read_byte_eof(mut &r))
    r.unread_byte() or (err) { << 1 }
    println(r.read_byte() or (err) { << 1 })
    r.seek(0, 0) or (err) { << 1 }
    println(r.read_at(2, 1) or (err) { << 1 })
    r.reset("ab")
    println(r.read_n(8))
    << 0
}
