@main

#strings

fn main() int {
    a := "AbC"
    println(strings.to_lower(&a))
    println(strings.to_upper(&a))
    b := "abc"
    c := "AbC"
    if strings.equal_fold(&b, &c) {
        println("fold")
    }
    // U+00C4 uses the Unicode simple lower-case mapping.
    umlaut := "Ä"
    low := strings.to_lower(&umlaut)
    println(low == "ä")
    << 0
}
