@main
// B6: strings.Reader (Go-shaped; no WriteTo).

#strings

fn print_unread_start() {
    mut r := strings.new_reader("A")
    r.unread_byte() or (err) {
        println(err.msg())
        <<
    }
    println("no")
}

fn print_unread_rune_bad() {
    mut r := strings.new_reader("ab")
    skip := r.read_n(1)
    _ := skip.len
    r.unread_rune() or (err) {
        println(err.msg())
        <<
    }
    println("no")
}

fn print_seek_whence() {
    mut r := strings.new_reader("A")
    _ := r.seek(0, 9) or (err) {
        println(err.msg())
        <<
    }
    println("no")
}

fn print_seek_neg() {
    mut r := strings.new_reader("A")
    _ := r.seek(0 - 1, 0) or (err) {
        println(err.msg())
        <<
    }
    println("no")
}

fn print_read_at_neg() {
    mut r := strings.new_reader("A")
    _ := r.read_at(1, 0 - 1) or (err) {
        println(err.msg())
        <<
    }
    println("no")
}

fn print_read_at_eof() {
    mut r := strings.new_reader("A")
    _ := r.read_at(1, 1) or (err) {
        println(err.msg())
        <<
    }
    println("no")
}

fn print_read_byte_eof() {
    mut r := strings.new_reader("")
    _ := r.read_byte() or (err) {
        println(err.msg())
        <<
    }
    println("no")
}

fn main() int {
    mut r := strings.new_reader("hello")
    println(r.size())
    println(r.length())
    println(r.read_n(2))
    println(r.length())
    println(r.read_byte() or (err) {
        println(err.msg())
        << 1
    })
    r.unread_byte() or (err) {
        println(err.msg())
        << 1
    }
    println(r.read_byte() or (err) {
        println(err.msg())
        << 1
    })
    println(r.read_n(10))
    println(r.read_n(3).len)

    mut sk := strings.new_reader("hello")
    println(sk.seek(1, 0) or (err) {
        println(err.msg())
        << 1
    })
    println(sk.read_n(1))
    println(sk.seek(1, 1) or (err) {
        println(err.msg())
        << 1
    })
    println(sk.read_n(1))
    println(sk.seek(0 - 1, 2) or (err) {
        println(err.msg())
        << 1
    })
    println(sk.read_n(1))

    mut at := strings.new_reader("hello")
    println(at.read_at(2, 1) or (err) {
        println(err.msg())
        << 1
    })
    println(at.length())
    println(at.read_n(1))

    mut rr := strings.new_reader("a世")
    h1 := rr.read_rune() or (err) {
        println(err.msg())
        << 1
    }
    println(h1.ch)
    println(h1.size)
    rr.unread_rune() or (err) {
        println(err.msg())
        << 1
    }
    h2 := rr.read_rune() or (err) {
        println(err.msg())
        << 1
    }
    println(h2.ch)
    h3 := rr.read_rune() or (err) {
        println(err.msg())
        << 1
    }
    println(h3.ch)
    println(h3.size)

    bad := string_from_byte(255)
    mut ir := strings.new_reader(bad)
    hf := ir.read_rune() or (err) {
        println(err.msg())
        << 1
    }
    println(hf.ch)
    println(hf.size)

    mut z := strings.new_reader("hello")
    dumped := z.read_n(5)
    _ := dumped.len
    z.reset("xy")
    println(z.read_n(2))
    println(z.size())

    print_unread_start()
    print_unread_rune_bad()
    print_seek_whence()
    print_seek_neg()
    print_read_at_neg()
    print_read_at_eof()
    print_read_byte_eof()
    << 0
}
