@main

#crypto/sm2
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn pub_fails(d &string) bool {
    sm2.public(d) or (err) { << true }
    << false
}

fn dec_fails(d &string, ct &string) bool {
    sm2.decrypt(d, ct) or (err) { << true }
    << false
}

fn main() int {
    d := hex.decode_string("3945208f7b2144b13f36e38ac6d39f95889393692860b51a42fb81ef4df7c5b8") or (err) {
        << 1
    }
    pubk := sm2.public(&d) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(pubk + ""))

    msg := "message digest"
    sig := hex.decode_string("f5a03b0648d2c4630eeac513e1bb81a15944da3827d5b74143ac7eaceee720b3b1b6aa29df212fd8763182bc0d421ca1bb9038fd1f7f42d4840b69c485bbc1aa") or (err) {
        << 1
    }
    show_bool(sm2.verify(&pubk, &msg, &sig))

    mut bad := []int{}
    mut i := 0
    while i < sig.len {
        bad.push(sig[i] & 255)
        i = i + 1
    }
    bad[0] = bad[0] ^ 1
    bads := string_from_bytes(bad)
    show_bool(sm2.verify(&pubk, &msg, &bads))

    empty := ""
    show_bool(sm2.verify(&pubk, &msg, &empty))

    ct := hex.decode_string("0404ebfc718e8d1798620432268e77feb6415e2ede0e073c0f4f640ecd2e149a73e858f9d81e5430a57b36daab8f950a3c64e6ee6a63094d99283aff767e124df059983c18f809e262923c53aec295d30383b54e39d609d160afcb1908d0bd876621886ca989ca9c7d58087307ca93092d651efa") or (err) {
        << 1
    }
    pt := sm2.decrypt(&d, &ct) or (err) {
        println(err.msg())
        << 1
    }
    println(pt)

    hi := "hi"
    enc := sm2.encrypt(&pubk, &hi) or (err) {
        println(err.msg())
        << 1
    }
    back := sm2.decrypt(&d, &enc) or (err) {
        println(err.msg())
        << 1
    }
    println(back)

    gen := sm2.generate_key() or (err) {
        println(err.msg())
        << 1
    }
    gp := sm2.public(&gen) or (err) {
        println(err.msg())
        << 1
    }
    gs := sm2.sign(&gen, &hi) or (err) {
        println(err.msg())
        << 1
    }
    show_bool(sm2.verify(&gp, &hi, &gs))

    short := "x"
    show_bool(pub_fails(&short))
    show_bool(dec_fails(&d, &short))
    << 0
}
