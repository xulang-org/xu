@main

#archive/tar

fn main() int {
    mut w := tar.new_writer()
    println(w.file_count())
    n := "a.txt"
    b := "x"
    w.write_file(&n, &b, 420) or (err) { << 1 }
    println(w.file_count())
    d := "d"
    w.write_dir(&d, 493) or (err) { << 1 }
    println(w.file_count())
    w.close()
    << 0
}
