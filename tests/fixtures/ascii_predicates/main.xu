@main
fn main() int {
    // Historical ASCII ranges only — not Unicode classes.
    println(is_digit(48))
    println(is_digit(57))
    println(is_digit(47))
    println(is_digit(58))
    println(is_alpha(65))
    println(is_alpha(90))
    println(is_alpha(97))
    println(is_alpha(122))
    println(is_alpha(64))
    println(is_alnum(48))
    println(is_alnum(65))
    println(is_alnum(97))
    println(is_alnum(45))
    println(is_space(32))
    println(is_space(9))
    println(is_space(10))
    println(is_space(13))
    println(is_space(11))
    println(is_space(12))
    // Mixed loop over a heap string.
    mut s := "a1 B2"
    mut nd := 0
    mut na := 0
    mut nw := 0
    for i in 0:s.len {
        c := s[i]
        if is_digit(c) { nd += 1 }
        if is_alpha(c) { na += 1 }
        if is_space(c) { nw += 1 }
    }
    println(nd)
    println(na)
    println(nw)
    << 0
}
