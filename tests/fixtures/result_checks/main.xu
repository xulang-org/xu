@main

#errors

fn div(a int, b int) int {
    if b == 0 {
        >> errors.new("division by zero")
    }
    << a / b
}

fn main() int {
    div(10, 2) or (err) {
        << 1
    }
    println(true)
    println(false)
    div(1, 0) or (err) {
        println(false)
    println(true)
        << 0
    }
    << 0
}
