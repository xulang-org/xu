@main

#io
#errors
#strconv

fn slots(n int, fill int) []int {
    mut out := []int{}
    mut i := 0
    while i < n {
        out.push(fill)
        i = i + 1
    }
    << out
}

fn dump(buf &[]int) {
    mut i := 0
    mut line := ""
    while i < buf.len {
        if i > 0 {
            line = line + ","
        }
        line = line + strconv.itoa(buf[i])
        i = i + 1
    }
    println(line)
}

fn show(tag string, result io.ReadInto) {
    match result {
        io.ReadInto.Filled(n) {
            println(tag + " F " + strconv.itoa(n))
        }
        io.ReadInto.End(n) {
            println(tag + " E " + strconv.itoa(n))
        }
        io.ReadInto.Failed(n, err) {
            println(tag + " X " + strconv.itoa(n) + " " + err.msg())
        }
    }
}

struct Tail {
    mode int
}

fn (t &mut Tail) read_result(n int) io.ReadResult {
    if t.mode == 1 {
        << io.ReadResult.Failed("xy", errors.new("boom"))
    }
    if t.mode == 2 {
        << io.ReadResult.Data("abcdef")
    }
    if t.mode == 3 {
        << io.ReadResult.Data("")
    }
    if t.mode == 4 {
        << io.ReadResult.End("z")
    }
    if t.mode == 5 {
        >> errors.new("reader threw")
    }
    << io.ReadResult.Data("ab")
}

fn main() int {
    // String slices stay copies. The source is unchanged.
    whole := "abcd"
    piece := whole[1:3]
    println(piece)
    println(whole)

    mut cursor := io.cursor("abcdef")
    mut buf := slots(8, 9)
    show("c1", cursor.read_into(mut &buf, 1, 3))
    dump(&buf)
    println(cursor.remaining())
    // The exclusive borrow ended: the caller can write the buffer again.
    buf[1] = 7
    dump(&buf)
    show("c2", cursor.read_into(mut &buf, 4, 3))
    dump(&buf)
    println(cursor.remaining())
    show("c3", cursor.read_into(mut &buf, 0, 1))
    show("c0", cursor.read_into(mut &buf, 0, 0))
    println(cursor.remaining())

    mut bad := slots(4, 3)
    mut again := io.cursor("hi")
    show("neg", again.read_into(mut &bad, -1, 1))
    show("wide", again.read_into(mut &bad, 2, 3))
    show("zero-off", again.read_into(mut &bad, 4, 0))
    dump(&bad)
    println(again.remaining())

    mut buffered := io.buffer_from("xyz")
    mut bout := slots(3, 1)
    show("b1", buffered.read_into(mut &bout, 0, 2))
    show("b2", buffered.read_into(mut &bout, 2, 1))
    dump(&bout)
    println(buffered.len())

    mut adapted := io.cursor("abcdef")
    mut gout := slots(6, 0)
    show("g1", io.read_into(mut &adapted, mut &gout, 0, 2))
    show("g2", io.read_into(mut &adapted, mut &gout, 2, 4))
    dump(&gout)
    println(adapted.remaining())

    mut tail := Tail{mode: 1}
    mut tout := slots(4, 8)
    show("t1", io.read_into(mut &tail, mut &tout, 1, 2))
    dump(&tout)
    tail.mode = 2
    show("t2", io.read_into(mut &tail, mut &tout, 0, 2))
    dump(&tout)
    tail.mode = 3
    show("t3", io.read_into(mut &tail, mut &tout, 0, 2))
    tail.mode = 4
    show("t4", io.read_into(mut &tail, mut &tout, 0, 2))
    dump(&tout)
    tail.mode = 5
    show("t5", io.read_into(mut &tail, mut &tout, 0, 2))
    dump(&tout)

    mut skipped := io.buffer_from("abcdef")
    _ := skipped.read_n(2)
    mut sout := slots(4, 5)
    show("skip", skipped.read_into(mut &sout, 0, 2))
    dump(&sout)
    println(skipped.len())
    << 0
}
