@main
// B8: log/slog with_group (text dotted keys; JSON nested objects).

#log/slog

fn main() int {
    mut t := slog.new_logger()
    t.add_time = 0
    t.use_stdout = true
    t = t.with("a", "1")
    t = t.with_group("g")
    t = t.with("b", "2")
    t.info("m")

    mut t2 := slog.new_logger()
    t2.add_time = 0
    t2.use_stdout = true
    t2 = t2.with_group("g")
    t2 = t2.with_group("h")
    t2 = t2.with("c", "3")
    t2.info("n")

    mut t3 := slog.new_logger()
    t3.add_time = 0
    t3.use_stdout = true
    t3 = t3.with_group("")
    t3 = t3.with("d", "4")
    t3.info("o")

    mut j := slog.new_json_logger()
    j.add_time = 0
    j.use_stdout = true
    j = j.with("a", "1")
    j = j.with_group("g")
    j = j.with("b", "2")
    j.info("m")

    mut j2 := slog.new_json_logger()
    j2.add_time = 0
    j2.use_stdout = true
    j2 = j2.with_group("g")
    j2 = j2.with_group("h")
    j2 = j2.with("c", "3")
    j2.info("n")

    mut j3 := slog.new_json_logger()
    j3.add_time = 0
    j3.use_stdout = true
    j3 = j3.with_group("")
    j3 = j3.with("d", "4")
    j3.info("o")
    << 0
}
