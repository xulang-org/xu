@main

#time

fn main() int {
    a := time.date(1970, 1, 1, 0, 0, 0, 0)
    wa := a.iso_week()
    println(wa.year)
    println(wa.week)
    b := time.date(2005, 1, 1, 0, 0, 0, 0)
    wb := b.iso_week()
    println(wb.year)
    println(wb.week)
    c := time.date(2005, 1, 3, 0, 0, 0, 0)
    wc := c.iso_week()
    println(wc.year)
    println(wc.week)
    << 0
}
