@main
fn plus1(x int) int { << x + 1 }
fn plus2(x int) int { << x + 2 }
fn plus10(x int) int { << x + 10 }

fn main() int {
    mut f := plus1
    x := f(10)
    f = plus2
    println(x)
    println(f(10))

    mut d := plus1
    println(d(0))
    d = plus2
    println(d(0))
    d = plus10
    println(d(0))

    mut g := plus1
    mut i := 0
    while i < 3 {
        println(g(i))
        if i == 1 {
            g = plus2
        }
        i = i + 1
    }
    << 0
}
