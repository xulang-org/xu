@main

#fmt

fn main() int {
    println(fmt.sprintf("%5d", fmt.i(42)) or (err) { << 1 })
    println(fmt.sprintf("%-5d", fmt.i(42)) or (err) { << 1 })
    println(fmt.sprintf("%05d", fmt.i(42)) or (err) { << 1 })
    println(fmt.sprintf("%+d", fmt.i(42)) or (err) { << 1 })
    println(fmt.sprintf("% d", fmt.i(42)) or (err) { << 1 })
    println(fmt.sprintf("%+d", fmt.i(0 - 7)) or (err) { << 1 })
    println(fmt.sprintf("%#x", fmt.i(255)) or (err) { << 1 })
    println(fmt.sprintf("%#X", fmt.i(255)) or (err) { << 1 })
    println(fmt.sprintf("%#o", fmt.i(8)) or (err) { << 1 })
    println(fmt.sprintf("%#b", fmt.i(3)) or (err) { << 1 })
    println(fmt.sprintf("%#x", fmt.i(0)) or (err) { << 1 })
    println(fmt.sprintf("%.2f", fmt.f(3.14159)) or (err) { << 1 })
    println(fmt.sprintf("%8.2f", fmt.f(3.14)) or (err) { << 1 })
    println(fmt.sprintf("%-8.2f", fmt.f(3.14)) or (err) { << 1 })
    println(fmt.sprintf("%*d", fmt.i(4), fmt.i(7)) or (err) { << 1 })
    println(fmt.sprintf("%.*s", fmt.i(2), fmt.s("hello")) or (err) { << 1 })
    println(fmt.sprintf("%.3s", fmt.s("hello")) or (err) { << 1 })
    println(fmt.sprintf("%5s", fmt.s("hi")) or (err) { << 1 })
    println(fmt.sprintf("%-5s", fmt.s("hi")) or (err) { << 1 })
    println(fmt.sprintf("%x", fmt.s("ab")) or (err) { << 1 })
    println(fmt.sprintf("%X", fmt.s("ab")) or (err) { << 1 })
    println(fmt.sprintf("%#x", fmt.s("ab")) or (err) { << 1 })
    println(fmt.sprintf("% x", fmt.s("ab")) or (err) { << 1 })
    println(fmt.sprintf("%q", fmt.s("a\"b")) or (err) { << 1 })
    println(fmt.sprintf("%5.3d", fmt.i(2)) or (err) { << 1 })
    println(fmt.sprintf("%+05d", fmt.i(42)) or (err) { << 1 })
    println(fmt.sprintf("%#05x", fmt.i(15)) or (err) { << 1 })
    println(fmt.sprintf("%q", fmt.i(97)) or (err) { << 1 })
    e := fmt.errorf("n=%d", fmt.i(9))
    println(e.msg())
    fmt.print(fmt.s("A"), fmt.i(1))
    fmt.printf("B=%d", fmt.i(2))
    fmt.println(fmt.s("C"))
    << 0
}
