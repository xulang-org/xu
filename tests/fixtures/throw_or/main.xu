@main

#errors

fn may_fail(flag int) int {
    if flag == 0 {
        >> errors.new("fail")
    }
    << 42
}
    fn main() int {
    n := may_fail(1) or (err) {
        println(err.msg())
        << 1
    }
    println(n)
    _ := may_fail(0) or (err) {
        println(err.msg())
        << 0
    }
    << 0
}
