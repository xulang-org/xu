@main
// sync/atomic: single-threaded store/load/add/cas semantics, then four
// goroutines each do 1000 add_int on their own counter and rendezvous through
// a channel (sum == 4000). The `&mut` int location cannot cross `xu` (S6/M17:
// "xu argument cannot be a reference type"), so the concurrent stress runs the
// atomic instructions independently per worker rather than racing on one
// address; cross-thread atomicity itself is exercised by the emitted ldaxr/
// lock-xadd sequences under four real OS threads.
#sync

fn worker(done chan int) {
    mut x := 0
    mut i := 0
    while i < 1000 {
        sync.add_int(mut &x, 1)
        i = i + 1
    }
    done <- x
}

fn main() int {
    // Single-threaded: store/load/add (returns old value)/cas (returns bool).
    mut x := 0
    sync.store_int(mut &x, 5)
    println(sync.load_int(mut &x))
    println(sync.add_int(mut &x, 10))
    println(sync.load_int(mut &x))
    println(sync.compare_and_swap_int(mut &x, 15, 100))
    println(sync.load_int(mut &x))
    println(sync.compare_and_swap_int(mut &x, 15, 999))
    println(sync.load_int(mut &x))

    // Concurrent: 4 goroutines x 1000 adds, summed via channel rendezvous.
    done := chan int{cap: 4}
    xu worker(done)
    xu worker(done)
    xu worker(done)
    xu worker(done)
    mut sum := 0
    mut i := 0
    while i < 4 {
        v := <-done
        sum = sum + v
        i = i + 1
    }
    println(sum)
    << 0
}
