@main

#container/heap

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn heap_pop_err(h heap.IntHeap) bool {
    mut hh := h
    hh.pop() or (err) { << true }
    << false
}

fn main() int {
    mut h := heap.new_ints()
    h.push(5)
    h.push(3)
    h.push(7)
    h.push(1)
    println(heap.len_ints(&h))
    println(h.pop() or (err) { << 1 })
    println(h.pop() or (err) { << 1 })
    println(h.pop() or (err) { << 1 })
    println(h.pop() or (err) { << 1 })
    show_bool(heap_pop_err(h))
    mut raw := []int{}
    raw.push(4)
    raw.push(1)
    raw.push(3)
    raw.push(2)
    mut h2 := heap.from_ints(raw)
    println(h2.pop() or (err) { << 1 })
    println(h2.pop() or (err) { << 1 })
    println(h2.pop() or (err) { << 1 })
    println(h2.pop() or (err) { << 1 })
    mut sh := heap.new_strs()
    sh.push("b")
    sh.push("a")
    sh.push("c")
    println(sh.pop() or (err) { << 1 })
    println(sh.pop() or (err) { << 1 })
    println(sh.pop() or (err) { << 1 })
    show_bool(heap.len_strs(&sh) == 0)
    << 0
}
