@main

#os
#strings

fn mkdir_temp_fails(dir string, pat string) bool {
    os.mkdir_temp(dir, pat) or (err) {
        << true
    }
    << false
}

fn main() int {
    println(os.is_path_separator(47))
    println(os.is_path_separator(65))
    sep := os.path_separator()
    println(sep == 47 || sep == 92)
    println(os.is_path_separator(sep))

    cache := os.user_cache_dir() or (err) { << 1 }
    cfg := os.user_config_dir() or (err) { << 1 }
    println(cache.len > 1)
    println(cfg.len > 1)

    d := os.mkdir_temp("", "xu-b1c-*") or (err) { << 1 }
    println(os.is_dir(d + ""))
    _ := os.remove_all(d)

    p := os.create_temp("", "xu-b1c-*.txt") or (err) { << 1 }
    println(strings.has_suffix(&p, ".txt"))
    info := os.stat(p + "") or (err) { << 1 }
    println(info.is_dir)
    println(info.size)
    os.write(p + "", "hi") or (err) { << 1 }
    got := os.read(p + "") or (err) { << 1 }
    println(got)
    os.remove(p) or (err) { << 1 }

    println(mkdir_temp_fails("", "a/b"))
    << 0
}
