@main

#crypto/sm2
#encoding/hex

fn main() int {
    da := hex.decode_string("81eb26e941bb5af16df116495f90695272ae2cd63d6c4ae1678418be48230029") or (err) {
        << 1
    }
    db := hex.decode_string("785129917d45a9ea5437a59356b82338eaadda6ceb199088f14ae10defa229b5") or (err) {
        << 1
    }
    pa := sm2.public(&da) or (err) {
        println(err.msg())
        << 1
    }
    pb := sm2.public(&db) or (err) {
        println(err.msg())
        << 1
    }
    ida := "1234567812345678"
    idb := "1234567812345678"
    mut a := sm2.exch_new(&da, &pb, &ida, &idb, 16, true) or (err) {
        println(err.msg())
        << 1
    }
    mut b := sm2.exch_new(&db, &pa, &idb, &ida, 16, true) or (err) {
        println(err.msg())
        << 1
    }
    ra := hex.decode_string("d4de15474db74d06491c440d305e012400990f3e390c7e87153c12db2ea60bb3") or (err) {
        << 1
    }
    raw := a.init_r(&ra) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(raw + ""))
    rb := hex.decode_string("7e07124814b309489125eaed101113164ebf0f3458c5bd88335c1f9d596243d6") or (err) {
        << 1
    }
    capb := b.respond_r(&rb, &raw) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(capb.mac + ""))
    ptb := capb.point + ""
    macb := capb.mac + ""
    capa := a.confirm_responder(&ptb, &macb) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(capa.mac + ""))
    println(hex.encode_to_string(capa.key + ""))
    key2 := b.confirm_initiator(&capa.mac) or (err) {
        println(err.msg())
        << 1
    }
    println(hex.encode_to_string(key2 + ""))
    << 0
}
