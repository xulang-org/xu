@main

#flag

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    mut fs := flag.new_set("t")
    fs.define_int("n", 0, "")
    show_bool(fs.parsed())
    mut args := []string{}
    args.push("--n")
    args.push("1")
    fs.parse(args) or (err) { << 1 }
    show_bool(fs.parsed())
    println(fs.get_int("n"))
    << 0
}
