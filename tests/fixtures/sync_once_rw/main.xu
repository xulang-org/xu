@main
// sync.Once + sync.RWMutex. Once.first_time is true exactly once per Once
// value; RWMutex demonstrates the exclusive write/read sequence with a
// deterministic interleave (write lock modifies, read lock reads). True
// blocking between writers and readers is single-threaded here (a concurrent
// interleave would be nondeterministic), but the sequence exercises both lock
// modes through the shared Mutex.
#sync

fn main() int {
    // Once: first_time true once, then false; a fresh Once is true again.
    mut o := sync.once()
    println(o.first_time())
    println(o.first_time())
    mut o2 := sync.once()
    println(o2.first_time())

    // RWMutex: exclusive write/read sequence, deterministic output.
    mut m := sync.rw_mutex()
    mut v := 0
    m.write_lock()
    v = 7
    println(v)
    m.write_unlock()
    m.read_lock()
    println(v)
    m.read_unlock()
    m.write_lock()
    v = v + 1
    println(v)
    m.write_unlock()
    m.read_lock()
    println(v)
    m.read_unlock()
    << 0
}
