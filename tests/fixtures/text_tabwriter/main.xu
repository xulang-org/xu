@main

#text/tabwriter

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    tab := "\t"
    nl := "\n"
    mut w := tabwriter.new_writer(5, 0, 1, 32, tabwriter.align_right)
    s1 := "a" + tab + "b" + tab + "c" + tab + "d" + tab + "." + nl + "123" + tab + "12345" + tab + "1234567" + tab + "123456789" + tab + "." + nl
    w.write(&s1)
    o1 := w.flush()
    println(o1)
    want1 := "    a     b       c         d." + nl + "  123 12345 1234567 123456789." + nl
    show_bool(o1 == want1)
    mut w2 := tabwriter.new_writer(0, 0, 1, 32, 0)
    s2 := "aa" + tab + "bb" + tab + "cc" + nl + "ax" + tab + "by" + tab + "cz" + nl
    w2.write(&s2)
    o2 := w2.flush()
    println(o2)
    want2 := "aa bb cc" + nl + "ax by cz" + nl
    show_bool(o2 == want2)
    << 0
}
