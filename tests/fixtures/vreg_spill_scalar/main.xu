@main

// Keep eight independent scalar values live so the virtual-register
// allocator must use both physical homes and at least one spill slot.
fn pressure(a int, b int, c int, d int) int {
    x0 := a + b
    x1 := a - b
    x2 := b + c
    x3 := b - c
    x4 := c + d
    x5 := c - d
    x6 := a ^ d
    x7 := b | c
    << x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7
}

fn main() int {
    // Indirect call keeps pressure as a standalone emitted function.
    mut f := pressure
    println(f(31, 7, 11, 3))
    << 0
}
