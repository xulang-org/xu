@main

// Keep several f64 SSA values live together so the callee really pressures
// the fixed FP bank. The caller's `hold` is live across this direct call and
// must therefore be saved/reloaded at the call program point.
fn clobber_fp(x int) f64 {
    a := f64(x) * 1.25
    b := f64(x + 1) * 2.5
    c := f64(x + 2) * 3.75
    d := f64(x + 3) * 4.5
    e := f64(x + 4) * 5.25
    << a + b + c + d + e
}

fn across_call(x int) int {
    hold := f64(x) + 0.5
    value := clobber_fp(x)
    << int((hold + value) * 100.0)
}

// Two values live across the same point must receive distinct FP homes and
// two independent save/reload actions.
fn two_across_call(x int) int {
    left := f64(x) + 0.25
    right := f64(x) + 0.75
    value := clobber_fp(x + 1)
    << int((left + right + value) * 100.0)
}

// `dead` is fully consumed before the call. It may use an FP home, but must
// not appear in this call's live-after action list.
fn dead_before_call(x int) int {
    dead := f64(x) + 0.125
    before := int(dead * 1000.0)
    value := clobber_fp(x + 2)
    << before + int(value * 100.0)
}

fn main() int {
    println(across_call(4))
    println(two_across_call(4))
    println(dead_before_call(4))
    << 0
}
