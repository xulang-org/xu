@main
fn main() int {
 mut m := map[string]int{}
 mut total := 0
 for i in 0:128 {
  m["k" + str(i)] = i
  total += m["k" + str(i)]
  total += m.get_or("k" + str(i), 999)
  key := "k" + str(i)
  r := &m[key]
  total += str(r).len
  if m.has("k" + str(i)) { total += 1 }
  total += m.take("k" + str(i))
  m.delete("k" + str(i))
 }
 held := "k" + str(999)
 m[held] = 7
 println(m.get_or(held, 0))
 m.delete(held)
 println(held)
 println(total)
 println(m.len())
 << 0
}
