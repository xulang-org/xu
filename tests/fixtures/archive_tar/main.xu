@main

#archive/tar

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn tar_next_eof(r tar.Reader) bool {
    mut rr := r
    rr.next() or (err) { << true }
    << false
}

fn parse_fails(s &string) bool {
    tar.parse_header(s) or (err) { << true }
    << false
}

fn main() int {
    mut w := tar.new_writer()
    n1 := "hello.txt"
    b1 := "hello"
    w.write_file(&n1, &b1, 420) or (err) { << 1 }
    n2 := "empty.txt"
    b2 := ""
    w.write_file(&n2, &b2, 420) or (err) { << 1 }
    dn := "dir"
    w.write_dir(&dn, 493) or (err) { << 1 }
    mut long := ""
    mut i := 0
    while i < 120 {
        long.push_byte(97)
        i = i + 1
    }
    lb := "L"
    w.write_file(&long, &lb, 420) or (err) { << 1 }
    w.close()
    raw := w.bytes()
    mut r := tar.new_reader(&raw)
    f1 := r.next() or (err) { << 1 }
    println(f1.name)
    println(f1.size)
    println(f1.body)
    println(f1.typeflag)
    f2 := r.next() or (err) { << 1 }
    println(f2.name)
    println(f2.size)
    println(f2.body.len)
    f3 := r.next() or (err) { << 1 }
    println(f3.name)
    println(f3.typeflag)
    f4 := r.next() or (err) { << 1 }
    println(f4.name.len)
    println(f4.body)
    println(f4.typeflag)
    show_bool(tar_next_eof(r))
    blk := raw[0:512] + ""
    h := tar.parse_header(&blk) or (err) { << 1 }
    println(h.name)
    println(h.size)
    enc := tar.encode_header(&h) or (err) { << 1 }
    show_bool(enc.len == 512)
    short := "nope"
    show_bool(parse_fails(&short))
    << 0
}
