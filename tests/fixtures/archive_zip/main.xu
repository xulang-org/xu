@main

#archive/zip

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn zip_next_err(r zip.Reader) bool {
    mut rr := r
    rr.next() or (err) { << true }
    << false
}

fn main() int {
    mut w := zip.new_writer()
    n1 := "hello.txt"
    b1 := "hello"
    w.write_file(&n1, &b1) or (err) { << 1 }
    n2 := "empty.txt"
    b2 := ""
    w.write_file(&n2, &b2) or (err) { << 1 }
    n3 := "fox.txt"
    b3 := "The quick brown fox"
    w.write_file_deflate(&n3, &b3) or (err) { << 1 }
    w.close() or (err) { << 1 }
    raw := w.bytes()
    mut r := zip.new_reader(&raw)
    f1 := r.next() or (err) { << 1 }
    println(f1.name)
    println(f1.method)
    println(f1.body)
    f2 := r.next() or (err) { << 1 }
    println(f2.name)
    println(f2.body.len)
    f3 := r.next() or (err) { << 1 }
    println(f3.name)
    println(f3.method)
    println(f3.body)
    show_bool(f3.uncompressed_size == 19)
    show_bool(zip_next_err(r))
    short := "PK"
    show_bool(zip_next_err(zip.new_reader(&short)))
    << 0
}
