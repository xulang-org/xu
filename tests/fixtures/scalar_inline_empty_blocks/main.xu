@main
#math
#strings
fn scramble(value int, salt int) int {
    mut x := value ^ salt
    x = (x ^ (x >> 17)) * 6364136223846793005
    x = (x + (x << 11)) ^ (x >> 33)
    x = x * 1442695040888963407 + salt
    x = x ^ ((x >> 29) & 34359738367)
    << x ^ (x << 19)
}
fn joined(value int, salt int) int {
    mut x := scramble(value, salt)
    x = x ^ (x >> 23)
    << x + salt
}
fn boolean_joined(value int, salt int) bool {
    << joined(value, salt) < 0
}
fn branched(value int, salt int) int {
    if value < 0 { << joined(value, salt) }
    << joined(salt, value)
}
fn main() int {
    for i in 0:128 {
        value := ((i * 8191 - 67123) ^ (i << 56))
        salt := (i << 41) ^ (0 - i * 97)
        println(joined(value, salt))
        println(boolean_joined(value, salt))
        println(branched(value, salt))
    }
    println(math.sqrt(16.0))
    println("inline".len)
    << 0
}
