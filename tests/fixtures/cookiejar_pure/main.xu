@main

#net/url
#net/http/cookiejar

fn main() int {
    u := url.parse_url("https://Example.com/a/b") or (err) { << 1 }
    v := url.parse_url("https://example.com/a/z") or (err) { << 1 }
    root := url.parse_url("https://example.com/") or (err) { << 1 }
    plain := url.parse_url("http://example.com/a/z") or (err) { << 1 }
    mut j := cookiejar.new_jar()
    j.set_cookie(&u, cookiejar.Cookie{name: "sid", value: "one", path: "", domain: "", secure: false, http_only: false, max_age: 0})
    cs1 := j.cookies(&v)
    println(cookiejar.cookie_header(&cs1))
    cs2 := j.cookies(&root)
    println(cs2.len)
    j.set_cookie(&u, cookiejar.Cookie{name: "sid", value: "two", path: "", domain: "", secure: true, http_only: false, max_age: 0})
    cs3 := j.cookies(&v)
    println(cookiejar.cookie_header(&cs3))
    cs4 := j.cookies(&plain)
    println(cs4.len)
    j.set_cookie(&u, cookiejar.Cookie{name: "sid", value: "", path: "", domain: "", secure: false, http_only: false, max_age: -1})
    cs5 := j.cookies(&v)
    println(cs5.len)
    << 0
}
