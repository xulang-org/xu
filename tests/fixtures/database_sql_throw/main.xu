@main

#database/sql
#database/sql/driver
#context

struct D {
    pub n int
}

struct C {
    pub n int
}

struct S {
    pub n int
}

struct T {
    pub n int
}

fn (d D) open(name string) driver.Conn {
    _ := name
    << driver.Conn(C{n: 1})
}

fn (d D) connect(ctx &context.Context) driver.Conn {
    _ := ctx
    << d.open("")
}

fn (d D) dup() driver.Driver {
    << driver.Driver(D{n: d.n})
}

fn (d D) driver() driver.Driver {
    << d.dup()
}

fn (c C) ping() string {
    << ""
}

fn (c C) exec(q string, args []driver.NamedValue) driver.ExecResult {
    _ := q
    _ := args
    << driver.exec_err("exec-boom")
}

fn (c C) query(q string, args []driver.NamedValue) driver.RowsResult {
    _ := q
    _ := args
    << driver.rows_err("query-boom")
}

fn (c C) close() string {
    << ""
}

fn (c C) dup() driver.Conn {
    << driver.Conn(C{n: c.n})
}

fn (c C) prepare(q string) driver.Stmt {
    _ := q
    << driver.Stmt(S{n: 1})
}

fn (c C) prepare_context(ctx &context.Context, q string) driver.Stmt {
    _ := ctx
    << c.prepare(q)
}

fn (c C) begin() driver.Tx {
    << driver.Tx(T{n: 1})
}

fn (c C) begin_tx(iso int, ro bool) driver.Tx {
    _ := iso
    _ := ro
    << c.begin()
}

fn (c C) reset_session(ctx &context.Context) string {
    _ := ctx
    << ""
}

fn (c C) is_valid() bool {
    << true
}

fn (s S) num_input() int {
    << -1
}

fn (s S) exec(args []driver.NamedValue) driver.ExecResult {
    _ := args
    << driver.exec_err("stmt-boom")
}

fn (s S) query(args []driver.NamedValue) driver.RowsResult {
    _ := args
    << driver.rows_err("stmt-boom")
}

fn (s S) close() string {
    << ""
}

fn (t T) commit() string {
    << ""
}

fn (t T) rollback() string {
    << ""
}

fn exec_fails(db &sql.DB) bool {
    db.exec("x") or (err) {
        println(err.msg())
        << true
    }
    << false
}

fn query_fails(db &sql.DB) bool {
    db.query("x") or (err) {
        println(err.msg())
        << true
    }
    << false
}

fn main() int {
    d := D{n: 1}
    mut db := sql.open(driver.Driver(d), "")
    db.ping() or (err) {
        println(err.msg())
        << 1
    }
    println("ping")
    if !exec_fails(&db) {
        << 1
    }
    if !query_fails(&db) {
        << 1
    }
    << 0
}
