@main

#ui
#ui/draw

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    println(draw.in_none)
    println(draw.in_click)
    println(draw.in_scroll)
    c := draw.Click{x: 5, y: 5, ok: 1}
    show_bool(draw.in_rect(c, 0, 0, 10, 10))
    show_bool(draw.in_rect(c, 20, 20, 10, 10))
    miss := draw.Click{x: 5, y: 5, ok: 0}
    show_bool(draw.in_rect(miss, 0, 0, 10, 10))
    show_bool(draw.in_circle(c, 5, 5, 3))
    show_bool(draw.in_circle(c, 50, 50, 3))
    ev := ui.Event{kind: ui.ev_click, window_id: 0, menu_id: "", width: 8, height: 9}
    got := draw.click_of(ev)
    println(got.x)
    println(got.y)
    println(got.ok)
    mut app := ui.new_app()
    mut win := app.new_window(ui.WindowOpts{title: "draw", width: 120, height: 80})
    r := mut &win
    _ := draw.attach(r)
    println(win.content_slot_kind())
    _ := draw.begin()
    _ := draw.set_fill("#ff0000")
    _ := draw.fill_rect(0, 0, 10, 10, "#00ff00")
    _ := draw.present()
    << 0
}
