@main

#path/filepath

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    a := "foo/bar"
    show_bool(filepath.is_local(&a))
    b := "../x"
    show_bool(filepath.is_local(&b))
    c := "/abs"
    show_bool(filepath.is_local(&c))
    d := "."
    show_bool(filepath.is_local(&d))
    e := ""
    show_bool(filepath.is_local(&e))
    << 0
}
