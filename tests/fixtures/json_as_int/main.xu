@main

#encoding/json

fn main() int {
    src := "[1,true]"
    d := json.parse(&src)
    r := d.root()
    println(d.as_int(d.at(r, 0)) or (err) { << 1 })
    println(d.as_f64(d.at(r, 0)) or (err) { << 1 })
    d.as_int(d.at(r, 1)) or (err) {
        println("notnum")
        << 0
    }
    println("ok")
    << 1
}
