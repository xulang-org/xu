@main
fn lookup(a []int, key int) int {
    mut lo := 0
    mut hi := a.len
    while lo < hi {
        mid := lo + (hi - lo) / 2
        v := a[mid]
        if v == key {
            << mid
        }
        if v < key {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    << a[lo]
}
fn main() int {
    mut xs := []int{}
    xs.push(1)
    xs.push(3)
    println(lookup(xs, 4))
    << 0
}
