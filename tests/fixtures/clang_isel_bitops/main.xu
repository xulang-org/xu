@main

// Clang-style 32-bit isel: ror + eor-ror/lsr, bic, mvn.

const m32 = 4294967295

fn sigma0(x int) int {
    << (((x >> 7) | (x << 25)) ^ ((x >> 18) | (x << 14)) ^ ((x >> 3) & m32)) & m32
}

fn ch(e int, f int, g int) int {
    << ((e & f) ^ ((e ^ m32) & g)) & m32
}

fn mvn32(x int) int {
    << (x ^ m32) & m32
}

fn main() int {
    println(sigma0(0x12345678))
    println(ch(0x11111111, 0x22222222, 0x33333333))
    println(mvn32(1))
    println(sigma0(0))
    << 0
}
