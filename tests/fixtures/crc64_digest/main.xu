@main

#hash/crc64

fn main() int {
    s := "a"
    iso := crc64.checksum_iso(&s)
    mut d := crc64.new_iso()
    d.write(&s)
    if d.sum() == iso {
        println("true")
    } else {
        println("false")
    }
    d.reset()
    println(d.sum())
    ecma := crc64.checksum_ecma(&s)
    mut e := crc64.new_ecma()
    e.write(&s)
    if e.sum() == ecma {
        println("true")
    } else {
        println("false")
    }
    << 0
}
