@main
fn paint(s string) {
    match s {
        "red" {
            println("r")
        }
        "green" {
            println("g")
        }
        else {
            println("x")
        }
    }
}

fn main() int {
    paint("red")
    paint("green")
    paint("blue")
    s := "red"
    match s {
        "red" {
            println(s)
        }
        else {
            println("no")
        }
    }
    << 0
}
