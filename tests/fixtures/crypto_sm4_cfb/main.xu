@main
// G21: SM4-CFB-128 and SM4-OFB-128 (OpenSSL SM4-CFB / SM4-OFB vectors).

#crypto/sm4
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    key := hex.decode_string("0123456789abcdeffedcba9876543210") or (err) { << 1 }
    iv := hex.decode_string("000102030405060708090a0b0c0d0e0f") or (err) { << 1 }
    pt := hex.decode_string("aaaaaaaaaaaaaaaabbbbbbbbbbbbbbbbccccccccccccccccddddddddddddddddeeeeeeeeeeeeeeeeffffffffffffffffaaaaaaaaaaaaaaaabbbbbbbbbbbbbbbb") or (err) { << 1 }
    c := sm4.new_cipher(&key) or (err) { << 1 }

    want_cfb := "ac3236cb970cc20791364c395a1342d12f1d1c833abb135086a6faa42f167242f3732f033642fd4ecdd75a9e634b92c308b66ef4a3a61dbf66ccc00e3ced181e"
    ct_cfb := sm4.encrypt_cfb(&c, &iv, &pt) or (err) { << 1 }
    println(hex.encode_to_string(ct_cfb + ""))
    show_bool(hex.encode_to_string(ct_cfb + "") == want_cfb)
    back_cfb := sm4.decrypt_cfb(&c, &iv, &ct_cfb) or (err) { << 1 }
    show_bool(back_cfb == pt)
    msg := "Hello, Xu!"
    ct_s := sm4.encrypt_cfb(&c, &iv, &msg) or (err) { << 1 }
    println(sm4.decrypt_cfb(&c, &iv, &ct_s) or (err) { << 1 })

    want_ofb := "ac3236cb970cc20791364c395a1342d13f238e807b4f96b1bc82314900fe35fdb5a976a661e7e9c6cf11fbd9db4fa11d9db8e26fd243c191404fb13179854094"
    ct_ofb := sm4.encrypt_ofb(&c, &iv, &pt) or (err) { << 1 }
    println(hex.encode_to_string(ct_ofb + ""))
    show_bool(hex.encode_to_string(ct_ofb + "") == want_ofb)
    back_ofb := sm4.decrypt_ofb(&c, &iv, &ct_ofb) or (err) { << 1 }
    show_bool(back_ofb == pt)
    ct_o := sm4.encrypt_ofb(&c, &iv, &msg) or (err) { << 1 }
    println(sm4.decrypt_ofb(&c, &iv, &ct_o) or (err) { << 1 })
    << 0
}
