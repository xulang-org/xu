@main

#crypto/des
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn new_cipher_fails(key &string) bool {
    des.new_cipher(key) or (err) { << true }
    << false
}

fn main() int {
    key := hex.decode_string("133457799bbcdff1") or (err) { << 1 }
    pt := hex.decode_string("0123456789abcdef") or (err) { << 1 }
    c := des.new_cipher(&key) or (err) { << 1 }
    println(c.block_size())
    ct := c.encrypt(&pt) or (err) { << 1 }
    println(hex.encode_to_string(ct + ""))
    show_bool(hex.encode_to_string(ct + "") == "85e813540f0ab405")
    back := c.decrypt(&ct) or (err) { << 1 }
    show_bool(back == pt)
    k24 := hex.decode_string("0123456789abcdeffedcba987654321089abcdef01234567") or (err) { << 1 }
    t := des.new_triple_cipher(&k24) or (err) { << 1 }
    ct3 := t.encrypt(&pt) or (err) { << 1 }
    println(hex.encode_to_string(ct3 + ""))
    show_bool(hex.encode_to_string(ct3 + "") == "691747fd88b6d228")
    back3 := t.decrypt(&ct3) or (err) { << 1 }
    show_bool(back3 == pt)
    bad := "short"
    show_bool(new_cipher_fails(&bad))
    << 0
}
