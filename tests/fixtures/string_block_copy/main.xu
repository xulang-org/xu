@main

// Exhaust every 32-byte block tail and unaligned source offset. Exercise
// concatenation, growth, and an append that fits retained capacity.
fn check(n int) bool {
    mut s := make_string(n)
    for i in 0:n { s[i] = i & 255 }
    twice := (&s) + (&s)
    if twice.len != n * 2 { << false }
    for i in 0:twice.len {
        if twice[i] != ((i % n) & 255) { << false }
    }
    mut grown := ""
    for k in 0:5 { grown.push_str(s) }
    if grown.len != n * 5 { << false }
    for i in 0:grown.len {
        if grown[i] != ((i % n) & 255) { << false }
    }
    mut padded := make_string(n + 8)
    for i in 0:padded.len { padded[i] = i & 255 }
    for off in 0:8 {
        part := padded[off:off + n]
        for i in 0:n {
            if part[i] != ((off + i) & 255) { << false }
        }
    }
    << true
}

fn main() int {
    for n in 0:97 { if !check(n) { << 1 } }
    println("string block copy OK")
    << 0
}
