@main

#encoding/binary

const hex = "0123456789abcdef"

fn hex_u64(v int) string {
    mut out := []int{}
    for i in 0:16 {
        sh := 60 - 4 * i
        out.push(hex[(v >> sh) & 15])
    }
    mut s := 0
    while s < 15 && out[s] == 48 {
        s = s + 1
    }
    mut res := []int{}
    res.push(48)
    res.push(120)
    for i in s:16 {
        res.push(out[i])
    }
    << string_from_bytes(res)
}

fn hex_byte(b int) string {
    hi := hex[(b >> 4) & 15]
    lo := hex[b & 15]
    << string_from_bytes([hi, lo])
}

fn bytes_join(data &[]int, n int) string {
    mut s := ""
    for i in 0:n {
        if i > 0 {
            s = s + " "
        }
        s = s + hex_byte(data[i])
    }
    << s
}

fn rtline(tag string, val int, data &[]int, n int, got int) string {
    << tag + " " + hex_u64(val) + " -> " + bytes_join(data, n) + " -> " + hex_u64(got)
}

fn order_get_u16_fails(o binary.Endian, buf &[]int, off int) bool {
    o.get_u16(buf, off) or (err) { << true }
    << false
}

fn order_get_u64_fails(o binary.Endian, buf &[]int, off int) bool {
    o.get_u64(buf, off) or (err) { << true }
    << false
}

fn order_put_u16_fails(o binary.Endian, buf []int, off int, v int) bool {
    mut b := buf
    o.put_u16(mut &b, off, v) or (err) { << true }
    << false
}

fn order_put_u64_fails(o binary.Endian, buf []int, off int, v int) bool {
    mut b := buf
    o.put_u64(mut &b, off, v) or (err) { << true }
    << false
}

fn main() int {
    le := binary.little_endian()
    be := binary.big_endian()
    u16s := [0, 1, 0xff, 0x0102, 0xffff]
    u32s := [0, 0x01020304, 0xffffffff]
    u64s := [0, 1, 0xff, 0x0102, 0x01020304, 0x0102030405060708, -9223372036854775807 - 1, -1]

    mut buf := [0, 0, 0, 0, 0, 0, 0, 0]

    for i in 0:u16s.len {
        v := u16s[i]
        le.put_u16(mut &buf, 0, v) or (err) { << 1 }
        g := le.get_u16(&buf, 0) or (err) { << 1 }
        println(rtline("le u16", v, &buf, 2, g))
        be.put_u16(mut &buf, 0, v) or (err) { << 1 }
        g2 := be.get_u16(&buf, 0) or (err) { << 1 }
        println(rtline("be u16", v, &buf, 2, g2))
    }
    for i in 0:u32s.len {
        v := u32s[i]
        le.put_u32(mut &buf, 0, v) or (err) { << 1 }
        g := le.get_u32(&buf, 0) or (err) { << 1 }
        println(rtline("le u32", v, &buf, 4, g))
        be.put_u32(mut &buf, 0, v) or (err) { << 1 }
        g2 := be.get_u32(&buf, 0) or (err) { << 1 }
        println(rtline("be u32", v, &buf, 4, g2))
    }
    for i in 0:u64s.len {
        v := u64s[i]
        le.put_u64(mut &buf, 0, v) or (err) { << 1 }
        g := le.get_u64(&buf, 0) or (err) { << 1 }
        println(rtline("le u64", v, &buf, 8, g))
        be.put_u64(mut &buf, 0, v) or (err) { << 1 }
        g2 := be.get_u64(&buf, 0) or (err) { << 1 }
        println(rtline("be u64", v, &buf, 8, g2))
    }

    mut buf2 := [0, 0, 0, 0, 0, 0, 0, 0]
    for i in 0:8 {
        buf2[i] = 0xab
    }
    println("get u16 off=8 is_err=" + str(order_get_u16_fails(le, &buf2, 8)))
    println("get u16 off=-1 is_err=" + str(order_get_u16_fails(le, &buf2, -1)))
    println("get u64 off=1 is_err=" + str(order_get_u64_fails(le, &buf2, 1)))
    println("put u16 off=7 is_err=" + str(order_put_u16_fails(le, [0, 0, 0, 0, 0, 0, 0, 0], 7, 0x1234)))
    mut buf3 := [0, 0, 0, 0, 0, 0, 0, 0]
    for i in 0:8 {
        buf3[i] = 0xab
    }
    println("buf=" + bytes_join(&buf3, 8))
    mut buf4 := [0, 0, 0, 0, 0, 0, 0, 0]
    for i in 0:8 {
        buf4[i] = 0xab
    }
    println("put u64 off=-1 is_err=" + str(order_put_u64_fails(le, [0xab, 0xab, 0xab, 0xab, 0xab, 0xab, 0xab, 0xab], -1, 0x1234)))
    println("buf=" + bytes_join(&buf4, 8))
    << 0
}
