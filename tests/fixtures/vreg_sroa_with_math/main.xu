@main

#math

// SROA of a small [N]struct must still run in a unit that imports `#math`
// (live function count well above the old nfn<64 unit gate).

struct P {
    x f64
    y f64
}

fn main() int {
    mut a := [2]P{
        P{x: 1.0, y: 2.0},
        P{x: 3.0, y: 4.0}
    }
    a[0].x += 1.0
    a[1].y += math.sqrt(4.0)
    println(a[0].x)
    println(a[1].y)
    << 0
}
