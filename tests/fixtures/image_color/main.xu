@main

#image/color

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    c := color.RGBA{r: 10, g: 20, b: 30, a: 255}
    p := c.rgba()
    println(p.r)
    println(p.g)
    println(p.b)
    println(p.a)
    n := color.NRGBA{r: 10, g: 20, b: 30, a: 128}
    np := n.rgba()
    println(np.r)
    println(np.g)
    println(np.b)
    println(np.a)
    gy := color.Gray{y: 128}
    gp := gy.rgba()
    println(gp.r)
    println(gp.a)
    yc := color.rgb_to_ycbcr(255, 0, 0)
    println(yc.y)
    println(yc.cb)
    println(yc.cr)
    rgb := color.ycbcr_to_rgb(yc.y, yc.cb, yc.cr)
    println(rgb.r)
    println(rgb.g)
    println(rgb.b)
    ck := color.rgb_to_cmyk(10, 20, 30)
    println(ck.c)
    println(ck.m)
    println(ck.y)
    println(ck.k)
    al := color.Alpha{a: 128}
    ap := al.rgba()
    println(ap.a)
    show_bool(p.a == 65535)
    << 0
}
