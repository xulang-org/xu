@main

#time

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn unknown_loc(name string) bool {
    time.load_location(name) or (err) { << true }
    << false
}

fn main() int {
    u := time.utc()
    println(u.name)
    println(u.offset_sec)
    loc := time.fixed_zone("CST", 28800)
    t := time.unix(0, 0)
    println(t.hour())
    println(t.hour_in(&loc))
    println(t.day_in(&loc))
    println(t.format_rfc3339_in(&loc))
    west := time.fixed_zone("EST", 0 - 18000)
    println(t.format_rfc3339_in(&west))
    g := time.load_location("GMT") or (err) {
        println(err.msg())
        << 1
    }
    println(g.offset_sec)
    p8 := time.load_location("UTC+8") or (err) {
        println(err.msg())
        << 1
    }
    println(p8.offset_sec)
    println(t.format_rfc3339_in(&p8))
    west2 := time.load_location("GMT-05:00") or (err) {
        println(err.msg())
        << 1
    }
    println(west2.offset_sec)
    sh := time.load_location("Asia/Shanghai") or (err) {
        println(err.msg())
        << 1
    }
    println(sh.offset_sec)
    println(t.hour_in(&sh))
    ny := time.load_location("America/New_York") or (err) {
        println(err.msg())
        << 1
    }
    jan := time.date(1970, 1, 15, 12, 0, 0, 0)
    println(jan.hour_in(&ny))
    jul := time.date(1970, 7, 1, 12, 0, 0, 0)
    println(jul.hour_in(&ny))
    mar06 := time.date(2006, 3, 15, 12, 0, 0, 0)
    println(mar06.hour_in(&ny))
    mar07 := time.date(2007, 3, 15, 12, 0, 0, 0)
    println(mar07.hour_in(&ny))
    ldn := time.load_location("Europe/London") or (err) {
        println(err.msg())
        << 1
    }
    println(jan.hour_in(&ldn))
    show_bool(unknown_loc("Not/AZone"))
    show_bool(unknown_loc("UTC+24"))
    << 0
}
