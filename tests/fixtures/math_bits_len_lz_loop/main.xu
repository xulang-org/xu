@main
// `acc += bits.len(x); acc += bits.leading_zeros(x)` is fused by the emitter
// into `acc += 64`. Under fixed register homes the fused value must reach
// the new accumulator version (it printed 0 at O1 before 2026-09-11).
#math/bits

fn main() int {
    mut x := 0x123456789abcdef0
    mut sum := 0
    mut i := 0
    while i < 1000 {
        x = x ^ i
        sum += bits.len(x)
        sum += bits.leading_zeros(x)
        i += 1
    }
    println(sum)
    mut acc := 0
    mut y := 7
    mut k := 0
    while k < 100 {
        y = y * 3 + k
        acc += bits.len(y)
        acc += bits.leading_zeros(y)
        acc += bits.trailing_zeros(y)
        k += 1
    }
    println(acc)
    << 0
}
