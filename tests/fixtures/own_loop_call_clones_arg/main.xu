@main

// M108: a string local passed by value inside a loop is cloned at the call
// (the checker keeps the outer binding alive). The callee owns and drops its
// parameter, so the argument must be a fresh clone — not the caller's
// descriptor. Reading `src.len` in the callee used to hide this by leaking.

fn tokenize(src string) int {
    n := src.len
    mut pos := 0
    mut chk := 0
    while pos < n {
        chk = (chk * 37 + (src[pos] & 255)) % 1000000007
        pos += 1
    }
    << chk
}

fn just_len(src string) int {
    << src.len
}

// Never reads `src`: the callee's own drop of the parameter is all that
// happens to the argument.
fn ignore_arg(src string, n int) int {
    << n + 1
}

fn main() int {
    mut full := ""
    mut k := 0
    while k < 4 {
        full = full + "{\"k\":[1,2,-3]}"
        k += 1
    }
    mut total := 0
    mut r := 0
    while r < 5 {
        res := tokenize(full)
        total = (total * 31 + res) % 1000000007
        r += 1
    }
    mut lens := 0
    for _ in 0:3 {
        lens += just_len(full)
    }
    mut cnt := 0
    while cnt < 3 {
        cnt = ignore_arg(full, cnt)
    }
    println(cnt)
    println(full.len)
    println(total)
    println(lens)
    println(full)
    << 0
}
