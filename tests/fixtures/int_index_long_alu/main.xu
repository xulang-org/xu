fn main() int {
    mut text := make_string(16)
    text[0] = 128
    text[1] = 165
    text[2] = 202
    text[3] = 239
    text[4] = 20
    text[5] = 57
    text[6] = 94
    text[7] = 131
    text[8] = 168
    text[9] = 205
    text[10] = 242
    text[11] = 23
    text[12] = 60
    text[13] = 97
    text[14] = 134
    text[15] = 171
    mut a := 0x12345678
    mut b := 0x87654321
    combine_bytes(&text, mut &a, mut &b)
    println(a)
    println(b)
    values := [128, 165, 202, 239, 20, 57, 94, 131, 168, 205, 242, 23, 60, 97, 134, 171]
    a = 0x12345678
    b = 0x87654321
    combine_words(&values, mut &a, mut &b)
    println(a)
    println(b)
    << 0
}
