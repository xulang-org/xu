@main

#os

fn main() int {
    dir := "xu_os_fs2_dir"
    os.mkdir(dir + "") or (err) {
        println("mkdir")
        << 1
    }
    os.chmod(dir + "", 448) or (err) {
        println("chmod")
        << 1
    }
    p := dir + "/a.txt"
    os.write(p + "", "abcdef") or (err) {
        println("write")
        << 1
    }
    mut f := os.open(p + "") or (err) {
        println("open")
        << 1
    }
    off := f.seek(2, os.seek_set) or (err) {
        println("seek")
        << 1
    }
    s := f.read(3) or (err) {
        println("read")
        << 1
    }
    f.close() or (err) { << 1 }
    println(off)
    println(s)

    link := dir + "/l"
    os.symlink("a.txt", link + "") or (err) {
        println("symlink")
        << 1
    }
    tgt := os.readlink(link + "") or (err) {
        println("readlink")
        << 1
    }
    println(tgt)

    mut pp := os.pipe() or (err) {
        println("pipe")
        << 1
    }
    wr := mut &pp.w
    mut w := wr.take() or (err) { << 1 }
    n := w.write("xy") or (err) {
        println("pw")
        << 1
    }
    rr := mut &pp.r
    mut r := rr.take() or (err) { << 1 }
    got := r.read(2) or (err) {
        println("pr")
        << 1
    }
    w.close() or (err) { << 1 }
    r.close() or (err) { << 1 }
    println(n)
    println(got)

    os.remove(link + "") or (err) { << 1 }
    os.remove(p + "") or (err) { << 1 }
    os.remove(dir + "") or (err) { << 1 }
    << 0
}
