@main

#strconv

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    a := "hello"
    show_bool(strconv.can_backquote(&a))
    b := "hel`lo"
    show_bool(strconv.can_backquote(&b))
    nl := string_from_byte(10)
    show_bool(strconv.can_backquote(&nl))
    << 0
}
