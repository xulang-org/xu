@main

#crypto/ecdsa
#crypto/sha512
#encoding/hex

fn flip_last(s &string) string {
    mut out := []int{}
    for i in 0:s.len {
        out.push(s[i] & 255)
    }
    out[out.len - 1] = out[out.len - 1] ^ 1
    << string_from_bytes(out)
}

fn main() int {
    println(sha512.sum384_hex("abc"))

    p384 := hex.decode_string("048d9e36f7684be74d2f3c8e3fd53d6bafd50c5d5c9a08a28c61cd30fc29d776511372394729aaca97ebe9c2c81b0a10750c7221a56f267afad88e4d905123977f1e3264a06cea227ee9c8562fa32d9eb2847719bdde6c15ec17156ed9e4aaf7d6") or (err) { << 1 }
    h384 := hex.decode_string("03f20f437c97d4c398e4c3781371e735cb76c48df84879f704aec54d2d017d6ed15b44fbbf116562ed5378afaf843d35") or (err) { << 1 }
    s384 := hex.decode_string("3066023100b9e2c1cf3328485c6137d589acd3e7701fb8c2f20c53bc699778852d3a7fb3b29bedf7c6dcdbb3fc4627bec60343bc07023100c4066f61ef4442c49d32d09bc29ad3d03fc43148035c5f4406ee5a8a0e9d96d1c3fc7963c7b820ec3ddaea85ec1ef3e9") or (err) { << 1 }
    println(ecdsa.verify_asn1(&p384, &h384, &s384))
    bad384 := flip_last(&s384)
    println(ecdsa.verify_asn1(&p384, &h384, &bad384))

    p521 := hex.decode_string("0400cce4473fd1ca5198d43b3b5d1a48c4cfa6ebfed6ec701d17642ec22d494a0740c3a8a8b9b89f409d5b9ea35338505423a76cb8255e671d6877dcc1f3fc2f4794ab0058aa7545e437a09b5bb0c9f626ed6bcb2aa02e8896088454fe3af714e6ccbe41e0a941a9f28816a2dbe6fa31c9f4d8ac461c7b656c838a860d51b5484681b3520e") or (err) { << 1 }
    h521 := hex.decode_string("5d40922365f32438c83f891a278c0ce82a12c752bace99c388b90ace7d74e4cfe42daca30ebaad6dde1f051d8b5ffd90649e2061be88d124c81b184dcf8674e2") or (err) { << 1 }
    s521 := hex.decode_string("308188024201609f4f7519d4a9889f6d7d9062244374b977d27e51fbcf187fe84ce305700515867c0e63f6f605bd49dd93bd4bc54768d535c4c72812829dc935f0785a64d29fbc024201fd40ac5c889b5ee32107ae73381ba17eeb145ff3913b9b606913d1b082316faf96e994c4f0357a2f5fe029090e71944872fd9c82361064ee7c42ca1ca96bf756cc") or (err) { << 1 }
    println(ecdsa.verify_asn1(&p521, &h521, &s521))
    bad521 := flip_last(&s521)
    println(ecdsa.verify_asn1(&p521, &h521, &bad521))
    << 0
}
