@main

#path

fn show(pat string, name string) {
    r := path.matches(&pat, &name) or (err) {
        println("err")
        <<
    }
    if r {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    show("abc", "abc")
    show("a*", "abc")
    show("a*/b", "abc/b")
    show("a*", "a/c")
    show("a?c", "abc")
    show("a[b-d]e", "ace")
    show("a[^b]c", "adc")
    show("a[^b]c", "abc")
    show("\\*", "*")
    show("[", "a")
    show("*", "")
    show("*", "x")
    show("*/", "a/")
    << 0
}
