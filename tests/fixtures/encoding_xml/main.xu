@main

#encoding/xml

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn dump(t xml.Token) {
    println(t.kind)
    println(t.name)
    println(t.text)
    if t.keys.len > 0 {
        println(t.keys[0])
        println(t.vals[0])
    }
}

fn xml_token_fails(d xml.Decoder) bool {
    mut dd := d
    dd.token() or (err) { << true }
    << false
}

fn main() int {
    raw := "a<b>&\"'"
    esc := xml.escape_text(&raw)
    println(esc)
    println(xml.unescape_string(&esc))
    ent := "&amp;&#x41;&apos;"
    println(xml.unescape_string(&ent))
    src := "<root a=\"1\"><item>x&amp;y</item></root>"
    mut d := xml.new_decoder(&src)
    dump(d.token() or (err) { << 1 })
    dump(d.token() or (err) { << 1 })
    dump(d.token() or (err) { << 1 })
    dump(d.token() or (err) { << 1 })
    dump(d.token() or (err) { << 1 })
    show_bool(xml_token_fails(d))
    br := "<br/>"
    mut d2 := xml.new_decoder(&br)
    dump(d2.token() or (err) { << 1 })
    dump(d2.token() or (err) { << 1 })
    cmt := "<!--hi--><x/>"
    mut d3 := xml.new_decoder(&cmt)
    dump(d3.token() or (err) { << 1 })
    dump(d3.token() or (err) { << 1 })
    dump(d3.token() or (err) { << 1 })
    cd := "<![CDATA[a<b]]>"
    mut d4 := xml.new_decoder(&cd)
    dump(d4.token() or (err) { << 1 })
    bad := "<root"
    show_bool(xml_token_fails(xml.new_decoder(&bad)))
    << 0
}
