@main

#maps

fn has_int(xs &[]int, want int) bool {
    mut i := 0
    while i < xs.len {
        if xs[i] == want {
            << true
        }
        i = i + 1
    }
    << false
}

fn has_str(xs &[]string, want string) bool {
    mut i := 0
    while i < xs.len {
        if xs[i] == want {
            << true
        }
        i = i + 1
    }
    << false
}

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    mut a := maps.new_str_int()
    a.set("x", 1)
    a.set("y", 2)
    vs := a.values()
    println(vs.len)
    show_bool(has_int(&vs, 1))
    show_bool(has_int(&vs, 2))
    mut s := maps.new_str_str()
    s.set("k", "v")
    ws := s.values()
    println(ws.len)
    show_bool(has_str(&ws, "v"))
    << 0
}
