@main

#bufio
#io

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    mut s := bufio.new_scanner(io.buffer_from("a\nb\nc"))
    mut n := 0
    while s.scan() {
        println(s.text())
        n = n + 1
    }
    println(n)
    show_bool(s.scan())
    mut s2 := bufio.new_scanner(io.buffer_from("one\r\n\ntwo\n"))
    while s2.scan() {
        println(s2.text())
    println(s2.text().len)
    }

    mut s3 := bufio.new_scanner(io.buffer_from("  foo\tbar  baz\n"))
    s3.split(bufio.mode_words)
    while s3.scan() {
        println(s3.text())
    }

    mut s4 := bufio.new_scanner(io.buffer_from("hi"))
    s4.split(bufio.mode_bytes)
    while s4.scan() {
        println(s4.text())
    }

    mut s5 := bufio.new_scanner(io.buffer_from(""))
    show_bool(s5.scan())
    mut s6 := bufio.new_scanner(io.buffer_from("tail"))
    show_bool(s6.scan())
    println(s6.text())
    show_bool(s6.scan())
    << 0
}
