@main

// Alias regression: printing/concatenating a local or an array element must
// not free the source owner.  The nested str(str(...)) line also checks that
// identity conversion propagates freshness from its inner result.
fn main() int {
    mut s := "persistent"
    mut xs := ["element"]
    println(s)
    println(s + "!")
    println(s)
    println(xs[0])
    println(xs[0] + "!")
    println(str(s))
    str(str(7))
    << 0
}
