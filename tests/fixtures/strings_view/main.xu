@main

#strings
#bytes

fn main() int {
    s := "hello world"
    v := strings.view_of(&s)
    println(v.len)
    println(v.at(&s, 0))
    println(v.at(&s, 10))
    w := strings.view_slice(&s, 6, 5)
    println(w.len)
    println(w.at(&s, 0))
    println(v.index_byte(&s, 32))
    sub := "world"
    println(v.index(&s, &sub))
    hel := "hel"
    println(v.has_prefix(&s, &hel))
    rld := "rld"
    println(w.has_suffix(&s, &rld))
    println(v.equal(&s, &s, v))
    println(v.compare(&s, &s, v))
    z := strings.view_slice(&s, 11, 0)
    println(z.len)
    empty := ""
    println(z.index(&s, &empty))
    println(v.has_prefix(&s, &empty))
    mut b := strings.builder()
    println(b.write_view(&s, w))
    println(b.write_int(42))
    println(b.write_int(0))
    println(b.write_int(0 - 7))
    println(b.text())
    bv := bytes.view_of(&s)
    println(bv.at(&s, 1))
    bw := bytes.view_slice(&s, 0, 5)
    hello := "hello"
    println(bw.equal(&s, &hello, strings.view_of(&hello)))
    << 0
}
