@main

#flag

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    mut fs := flag.new_set("t")
    fs.define_int("n", 1, "count")
    f := fs.lookup("n")
    show_bool(f.found)
    println(f.name)
    println(f.usage)
    show_bool(f.is_set)
    fs.set("n", "8") or (err) { << 1 }
    f2 := fs.lookup("n")
    show_bool(f2.is_set)
    miss := fs.lookup("nope")
    show_bool(miss.found)
    mut args := []string{}
    args.push("--n")
    args.push("3")
    args.push("pos")
    fs.parse(args) or (err) { << 1 }
    println(fs.narg())
    println(fs.get_int("n"))
    << 0
}
