@main
struct Box {
    label string
}

enum Slot {
    Empty
    Full(string)
    Wrap(Box)
}

fn main() int {
    s := "ab" + "cd"
    e := Slot.Full(s)
    match e {
        Slot.Empty {
            println("empty")
        }
        Slot.Full(x) {
            println(x)
        }
        Slot.Wrap(b) {
            println(b.label)
        }
    }
    w := Slot.Wrap(Box{label: "xy" + "z"})
    match w {
        Slot.Empty {
            println("empty")
        }
        Slot.Full(x) {
            println(x)
        }
        Slot.Wrap(b) {
            println(b.label)
        }
    }
    << 0
}
