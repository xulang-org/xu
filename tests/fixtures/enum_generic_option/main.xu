@main
enum Opt#T {
    None
    Some(T)
}

fn main() int {
    a := Opt#int.Some(5)
    match a {
        Opt.None {
            println(0)
        }
        Opt.Some(x) {
            println(x)
        }
    }
    n := Opt#int.None
    match n {
        Opt.None {
            println("none")
        }
        Opt.Some(x) {
            println(x)
        }
    }
    s := Opt#string.Some("ab" + "cd")
    match s {
        Opt.None {
            println("none")
        }
        Opt.Some(x) {
            println(x)
        }
    }
    b := Opt.Some(7)
    match b {
        Opt.None {
            println(0)
        }
        Opt.Some(x) {
            println(x)
        }
    }
    << 0
}
