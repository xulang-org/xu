@main

#context
#time

fn close_later(ch chan int) { sleep_ns(10000000)
    close(ch) }
fn send_later(ch chan int) { sleep_ns(10000000)
    ch <- 7 }

fn main() int {
    ch := chan int{cap: 1}
    println(sys_wait_cancel(ch, 1000000))
    xu close_later(ch)
    println(sys_wait_cancel(ch, 1000000000))
    unbuffered := chan int{cap: 0}
    xu send_later(unbuffered)
    println(sys_wait_cancel(unbuffered, 1000000000))
    println(<-unbuffered)
    mut long := context.with_timeout(9223372036854775807)
    if long.ctx.deadline_ns <= 0 { << 1 }
    long.cancel()
    past := context.with_deadline(-9223372036854775807 - 1)
    sleep_ns(10000000)
    select { x := <-past.ctx.done { _ := x }
        else { << 2 } }
    for i in 0:20 {
        mut c := context.with_timeout(1000000)
        sleep_ns(1000000)
        c.cancel()
        c.cancel()
        t := time.new_timer(1000000)
        sleep_ns(1000000)
        t.stop()
        t.stop()
    }
    ticker := time.new_ticker(1000000)
    // A full one-slot tick channel must drop ticks instead of trapping
    // the worker in a blocking send, so a later stop can retire it.
    sleep_ns(20000000)
    ticker.stop()
    ticker.stop()
    _ := <-ticker.c
    println("races done")
    << 0
}
