@main

#math

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    show_bool(math.sinh(0.0) == 0.0)
    show_bool(math.cosh(0.0) == 1.0)
    show_bool(math.tanh(0.0) == 0.0)
    s := math.sinh(1.0)
    show_bool(s > 1.0 && s < 1.2)
    c := math.cosh(1.0)
    show_bool(c > 1.5 && c < 1.6)
    t := math.tanh(1.0)
    show_bool(t > 0.7 && t < 0.8)
    << 0
}
