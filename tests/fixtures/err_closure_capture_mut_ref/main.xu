@main

// M153: capturing a parameter reference and returning it via a closure
// does not count as elision (captured refs are Local for escape).

fn wrap(s &string) &string {
    f := fn() &string { << s }
    << f()
}

fn main() int {
    msg := "hi"
    r := wrap(&msg)
    println(r.len)
    << 0
}
