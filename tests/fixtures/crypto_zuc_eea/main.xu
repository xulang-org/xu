@main
// G24: 128-EEA3 / 128-EIA3 (SAGE implementor test data).

#crypto/zuc
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    key := hex.decode_string("173d14ba5003731d7a60049470f00a29") or (err) { << 1 }
    pt := hex.decode_string("6cf65340735552ab0c9752fa6f9025fe0bd675d9005875b200000000") or (err) { << 1 }
    want := "a6c85fc66afb8533aafc2518dfe784940ee1e4b030238cc800"
    ct := zuc.encrypt_eea3(&key, 0x66035492, 0xf, 0, &pt, 193) or (err) { << 1 }
    println(hex.encode_to_string(ct + ""))
    show_bool(hex.encode_to_string(ct + "") == want)
    back := zuc.decrypt_eea3(&key, 0x66035492, 0xf, 0, &ct, 193) or (err) { << 1 }
    need := pt[0:25] + ""
    rem := need[need.len - 1] & 128
    mut masked := []int{}
    mut i := 0
    while i < 24 {
        masked.push(need[i] & 255)
        i = i + 1
    }
    masked.push(rem)
    want_pt := string_from_bytes(masked)
    show_bool(back == want_pt)

    k0 := hex.decode_string("00000000000000000000000000000000") or (err) { << 1 }
    m0 := hex.decode_string("00000000") or (err) { << 1 }
    mac0 := zuc.sum_eia3(&k0, 0, 0, 0, &m0, 1) or (err) { << 1 }
    println(hex.encode_to_string(mac0 + ""))
    show_bool(hex.encode_to_string(mac0 + "") == "c8a9595e")

    k2 := hex.decode_string("47054125561eb2dda94059da05097850") or (err) { << 1 }
    m2 := hex.decode_string("000000000000000000000000") or (err) { << 1 }
    mac2 := zuc.sum_eia3(&k2, 0x561eb2dd, 0x14, 0, &m2, 90) or (err) { << 1 }
    println(hex.encode_to_string(mac2 + ""))
    show_bool(hex.encode_to_string(mac2 + "") == "6719a088")
    << 0
}
