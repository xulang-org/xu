@main

#context

fn main() int {
    mut parent := context.with_cancel()
    for i in 0:100 {
        mut child := context.with_cancel_parent(&parent.ctx)
        child.cancel()
        child.cancel()
    }
    sleep_ns(50000000)
    context.err(&parent.ctx) or (err) { << 1 }
    println("parent alive")
    parent.cancel()
    println("done")
    << 0
}
