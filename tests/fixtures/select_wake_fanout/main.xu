@main

fn watch(first chan int, second chan int, out chan int) {
    select {
        x := <-first { _ := x
            out <- 1 }
        y := <-second { _ := y
            out <- 1 }
    }
}

fn main() int {
    first := chan int{cap: 1}
    second := chan int{cap: 1}
    out := chan int{cap: 200}
    for i in 0:100 {
        xu watch(first, second, out)
        xu watch(second, second, out)
    }
    sleep_ns(20000000)
    close(second)
    mut total := 0
    for i in 0:200 { total = total + <-out }
    println(total)
    // An empty default must not turn into a blocking select.
    for i in 0:100 {
        select { x := <-first { _ := x
            << 1 }
            else {} }
    }
    println("empty default done")
    << 0
}
