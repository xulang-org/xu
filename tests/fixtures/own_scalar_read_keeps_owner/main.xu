@main

// A scalar read out of an owning array/struct (`sc.a = xs[1]`) copies the
// value: the array must stay owned by `xs`. The lowering used to mark `xs`
// moved, and the if-join pad then freed it on the other path — inside a
// loop that is a use-after-free (first element read back as 0).

struct Ins {
    kind int
    a int
    sval string
}

struct Plain {
    kind int
    a int
}

fn mk(k int) Ins {
    << Ins{kind: k, a: 0, sval: ""}
}

fn sink(xs &mut []Ins, v Ins) {
    xs.push(v)
}

fn work(kinds []int) int {
    mut sidx := []int{}
    mut k0 := 0
    while k0 < 6 {
        sidx.push(k0 + 10)
        k0 += 1
    }
    mut out := []Ins{}
    mut acc := 0
    for bi in 0:2 {
        mut ii := 0
        for _ in 0:kinds.len {
            if ii >= kinds.len { <- }
            k := kinds[ii]
            if k == 2 {
                acc += sidx[1]
            } else if k == 3 || k == 8 {
                acc += 100
            } else if k == 14 || k == 23 {
                mut l := 1
                if k == 23 { l = 2 }
                mut sc := mk(6)
                sc.a = sidx[l]
                sink(mut &out, sc)
            } else if k == 40 {
                mut pl := Plain{kind: 6, a: 0}
                pl.a = sidx[3]
                acc += pl.a
            }
            ii += 1
        }
    }
    mut s := 0
    for i in 0:sidx.len {
        s += sidx[i]
    }
    println(acc)
    println(s)
    println(out.len)
    << 0
}

fn main() int {
    mut kinds := []int{}
    kinds.push(2)
    kinds.push(14)
    kinds.push(3)
    kinds.push(23)
    kinds.push(40)
    kinds.push(2)
    work(kinds)
    << 0
}
