    }
    leaf := cert(&leaf_pem) or (err) {
        println(err.msg())
        << 1
    }
    println(intermediate.ext_key_usage_present)
    println(intermediate.ext_key_usage.len == 1 && intermediate.ext_key_usage[0] == x509.ext_key_usage_server_auth)
    println(intermediate.name_constraints_present)
    println(!intermediate.has_unhandled_critical_extension)
    println(intermediate.permitted_dns_domains.len == 1 && intermediate.permitted_dns_domains[0] == ".allowed.example")
