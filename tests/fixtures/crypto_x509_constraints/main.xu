@main

#crypto/x509
#encoding/pem
#net
#time

fn cert(text &string) x509.Certificate {
    block := pem.decode(text)
    << x509.parse_certificate(block.bytes) or >>
}

fn verify_case(root_text &string, intermediate_text &string, leaf_text &string, variant int, dns_name string, usages []int) bool {
    root := cert(root_text) or (err) { << false }
    mut intermediate := cert(intermediate_text) or (err) { << false }
    mut leaf := cert(leaf_text) or (err) { << false }
    if variant == 1 {
        leaf.dns_names = ["outside.example"]
    } else if variant == 2 {
        leaf.dns_names = ["bad.blocked.allowed.example"]
    } else if variant == 3 {
        bad_ip_text := "198.51.100.10"
        bad_ip := net.parse_ip(&bad_ip_text)
        leaf.ip_addresses = [bad_ip]
    } else if variant == 4 {
        leaf.ext_key_usage = [x509.ext_key_usage_client_auth]
        leaf.ext_key_usage_present = true
    } else if variant == 5 {
        intermediate.ext_key_usage = [x509.ext_key_usage_client_auth]
        intermediate.ext_key_usage_present = true
    } else if variant == 6 {
        intermediate.name_constraints_unsupported = true
    } else if variant == 7 {
        leaf.name_constraints_present = true
        leaf.is_ca = false
    } else if variant == 8 {
        leaf.ext_key_usage = []int{}
        leaf.ext_key_usage_present = false
    } else if variant == 9 {
        leaf.dns_names = ["allowed.example"]
    }
    mut roots := x509.new_cert_pool()
    roots.add(root)
    mut intermediates := x509.new_cert_pool()
    intermediates.add(intermediate)
    now := leaf.not_before.add(time.hour())
    opts := x509.VerifyOptions{dns_name: dns_name, current_time: now, roots: roots, intermediates: intermediates, key_usages: usages, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    leaf.verify(opts) or (err) { << false }
    << true
}

