    println(!verify_case(&root_pem, &intermediate_pem, &leaf_pem, 5, "", []int{}))
    println(verify_case(&root_pem, &intermediate_pem, &leaf_pem, 4, "", [x509.ext_key_usage_any]))
    println(!verify_case(&root_pem, &intermediate_pem, &leaf_pem, 1, "", []int{}))
    println(!verify_case(&root_pem, &intermediate_pem, &leaf_pem, 2, "", []int{}))
    println(!verify_case(&root_pem, &intermediate_pem, &leaf_pem, 3, "", []int{}))
    println(!verify_case(&root_pem, &intermediate_pem, &leaf_pem, 6, "", []int{}))
    println(!verify_case(&root_pem, &intermediate_pem, &leaf_pem, 7, "", []int{}))
    println(verify_case(&root_pem, &intermediate_pem, &leaf_pem, 8, "", []int{}))
    println(!verify_case(&root_pem, &intermediate_pem, &leaf_pem, 9, "", []int{}))
    << 0
}
