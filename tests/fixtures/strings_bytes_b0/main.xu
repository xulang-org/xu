@main

#strings
#bytes

fn is_digit(c int) bool {
    << c >= 48 && c <= 57
}

fn is_x(c int) bool {
    << c == 120
}

fn main() int {
    s := "hello"
    println(strings.clone(&s))
    println(strings.contains_func(&s, is_digit))
    t := "ab12"
    println(strings.contains_func(&t, is_digit))
    println(strings.index_any(&s, "lo"))
    println(strings.last_index_any(&s, "lo"))
    println(strings.contains_any(&s, "x"))
    han := "a世b"
    println(strings.index_rune(&han, 0x4E16))
    println(strings.contains_rune(&han, 0x4E16))
    csv := "a,b,c"
    sa := strings.split_after(&csv, ",")
    println(sa.len)
    println(sa[0])
    println(sa[1])
    println(sa[2])
    san := strings.split_after_n(&csv, ",", 2)
    println(san.len)
    println(san[0])
    println(san[1])
    xx := "xxhixx"
    println(strings.trim_func(&xx, is_x))
    bad := "hi" + string_from_byte(255) + "!"
    q := "?"
    println(strings.to_valid_utf8(&bad, q + ""))
    mut bd := strings.builder()
    println(bd.write_byte(65))
    println(bd.write_rune(66))
    println(bd.text())
    println(bd.cap())
    println(bd.length())

    println(bytes.repeat(&s, 2))
    sn := bytes.split_n(&csv, ",", 2)
    println(sn.len)
    println(sn[1])
    g1 := "Go"
    g2 := "go"
    println(bytes.equal_fold(&g1, &g2))
    println(bytes.to_upper(&g1))
    println(bytes.to_lower(&g1))
    mut bb := bytes.buffer_from("ab,cd")
    println(bb.next(2))
    println(bb.read_bytes(44))
    println(bb.text())
    println(bb.cap())
    println(bytes.contains_any(&s, "e"))
    << 0
}
