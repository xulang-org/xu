@main

#io

fn pipe_read(r &mut io.PipeReader, n int) string {
    << r.read_n(n)
}

fn pipe_close(w &mut io.PipeWriter) int {
    << w.close()
}

fn write_fails(w io.PipeWriter, s &string) bool {
    w.write(s) or (err) {
        << true
    }
    << false
}

fn main() int {
    println(io.eof)
    mut mc := io.multi_cursor("ab", "cd")
    println(mc.read_n(3))
    println(mc.read_n(3))
    println(mc.read_n(1).len)

    mut mb := io.multi_buffer(2)
    z := "z"
    println(mb.write(&z))
    println(mb.text(0))
    println(mb.text(1))

    mut t := io.tee(io.cursor("xy"), io.buffer())
    println(t.read_n(2))
    println(t.copied())

    mut sc := io.section_cursor("abcdef", 2, 3)
    println(sc.size())
    println(sc.read_n(10))
    println(sc.read_n(1).len)
    mut cur := io.cursor("abcdef")
    println(cur.seek(2, 0) or (err) { << 1 })
    println(cur.read_n(2))
    println(cur.read_at(2, 1) or (err) { << 1 })
    mut sc2 := io.section_cursor("abcdef", 2, 3)
    println(sc2.read_at(2, 1) or (err) { << 1 })
    println(sc2.seek(1, 0) or (err) { << 1 })
    println(sc2.read_n(2))

    mut p := io.pipe()
    msg := "abcd"
    println(p.w.write(&msg) or (err) { << 1 })
    println(pipe_read(mut &p.r, 2))
    println(pipe_read(mut &p.r, 2))
    _ := pipe_close(mut &p.w)
    println(pipe_read(mut &p.r, 1).len)

    // Copied writers share close state; closing one copy rejects writes from
    // the original value as well.
    mut p2 := io.pipe()
    mut copyw := p2.w
    if pipe_close(mut &copyw) != 0 {
        << 1
    }
    println(write_fails(p2.w, &msg))
    println(pipe_read(mut &p2.r, 1).len)
    << 0
}
