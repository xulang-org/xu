@main

#maps

fn drop_x(k string, v int) bool {
    _ := v
    << k == "x"
}

fn drop_v(k string, v string) bool {
    _ := k
    << v == "v"
}

fn main() int {
    mut a := maps.new_str_int()
    a.set("x", 1)
    a.set("y", 2)
    a.delete_func(drop_x)
    println(a.len())
    println(a.get("y") or (err) { << 1 })
    mut s := maps.new_str_str()
    s.set("k", "v")
    s.set("q", "w")
    s.delete_func(drop_v)
    println(s.len())
    println(s.get("q") or (err) { << 1 })
    << 0
}
