@main
#strings
#runtime

fn main() {
    mut zeroed := make_string(3)
    zeroed[0] = 65
    zeroed[1] = 66
    zeroed[2] = 67
    println(zeroed)
    data := [65, 66, 67, 68]
    println(string_from_bytes(data, 1, 3))
    replace_src := "a-b-a"
    count_src := "banana"
    split_src := "a,,b,"
    println(strings.replace_all(&replace_src, "a", "xy"))
    println(strings.count(&count_src, "a"))
    println(strings.join(strings.split(&split_src, ","), "|"))
    println(runtime.itoa(0 - 9223372036854775807 - 1))
}
