@main
#encoding/base64 as b64


#errors
// Base64 (standard alphabet, '=' padding) aligned with Go
// `encoding/base64` (StdEncoding.EncodeToString / DecodeString).
// Decode rejects bad length or non-alphabet bytes with Err — never a
// partial buffer.

const ref_b64_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

// Read-only byte map: ASCII space is invalid; values 33..96 encode 0..63.
// Static strings avoid a mutable global or a table allocation per decode.
const ref_b64_decode_map = "                                           _   `UVWXYZ[\\]^       !\"#$%&'()*+,-./0123456789:      ;<=>?@ABCDEFGHIJKLMNOPQRST                                                                                                                                     "

// URL decoding retains the accepted standard alphabet aliases.
const ref_b64_url_decode_map = "                                           _ _ `UVWXYZ[\\]^       !\"#$%&'()*+,-./0123456789:    ` ;<=>?@ABCDEFGHIJKLMNOPQRST                                                                                                                                     "

pub fn ref_encode_to_string(s string) string {
    << ref_encode_with(&s, false, true)
}

fn ref_strip_b64_ws(s &string) string {
    mut out := ""
    mut i := 0
    while i < s.len {
        c := s[i] & 255
        if c != 10 && c != 13 {
            out.push_byte(c)
        }
        i += 1
    }
    << out
}

fn ref_b64_has_ws(s &string) bool {
    mut i := 0
    while i < s.len {
        c := s[i] & 255
        if c == 10 || c == 13 {
            << true
        }
        i += 1
    }
    << false
}

pub fn ref_decode_string(s string) string {
    << ref_decode_with(&s, false) or >>
}

fn ref_decode_with(s &string, is_url bool) string {
    decoded := ref_decode_clean(s, is_url) or (err) {
        // Retry only after an error, preserving CR/LF and error priority.
        if ref_b64_has_ws(s) {
            clean := ref_strip_b64_ws(s)
            << ref_decode_clean(&clean, is_url) or >>
        }
        >> err
    }
    << decoded
}

fn ref_decode_clean(src &string, is_url bool) string {
    mut alphabet := ref_b64_decode_map
    if is_url { alphabet = ref_b64_url_decode_map }
    if src.len % 4 != 0 { >> errors.new("encoding/base64: invalid length") }
    nblocks := src.len / 4
    if nblocks <= 0 { << "" }
    capn := ref_decoded_len(src.len)
    if capn / 3 != nblocks { >> errors.new("encoding/base64: length overflow") }
    mut b := make_string(capn)
    mut i := 0
    mut w := 0
    // Padding is only valid in the final block. Preserve its error priority
    // over bad leading characters in every earlier block.
    while i < nblocks - 1 {
        off := i * 4
        c2 := src[off + 2] & 255
        c3 := src[off + 3] & 255
        if c2 == 61 || c3 == 61 { >> errors.new("encoding/base64: invalid padding") }
        a := alphabet[src[off] & 255] - 33
        d := alphabet[src[off + 1] & 255] - 33
        e := alphabet[c2] - 33
        f := alphabet[c3] - 33
        if (a | d | e | f) < 0 { >> errors.new("encoding/base64: invalid character") }
        b[w] = (a << 2) | (d >> 4)
        b[w + 1] = ((d & 15) << 4) | (e >> 2)
        b[w + 2] = ((e & 3) << 6) | f
        w += 3
        i += 1
    }
    off := i * 4
    a := alphabet[src[off] & 255] - 33
    d := alphabet[src[off + 1] & 255] - 33
    if (a | d) < 0 { >> errors.new("encoding/base64: invalid character") }
    b[w] = (a << 2) | (d >> 4)
    w += 1
    c2 := src[off + 2] & 255
    c3 := src[off + 3] & 255
    if c2 == 61 {
        if c3 != 61 { >> errors.new("encoding/base64: invalid padding") }
    } else {
        e := alphabet[c2] - 33
        if e < 0 { >> errors.new("encoding/base64: invalid character") }
        b[w] = ((d & 15) << 4) | (e >> 2)
        w += 1
        if c3 != 61 {
            f := alphabet[c3] - 33
            if f < 0 { >> errors.new("encoding/base64: invalid character") }
            b[w] = ((e & 3) << 6) | f
            w += 1
        }
    }
    if w == b.len { << b }
    << b[0:w]
}

const ref_b64_url = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

fn ref_encode_with(s &string, is_url bool, pad bool) string {
    n := s.len
    if n <= 0 { << "" }
    capn := ref_encoded_len(n, pad)
    if capn <= 0 {
        mut overflow := make_string(-1)
        if overflow.len < 0 { << "" }
        << ""
    }
    mut alphabet := ref_b64_chars
    if is_url { alphabet = ref_b64_url }
    mut b := make_string(capn)
    mut i := 0
    mut w := 0
    while i < n - 2 {
        v := ((s[i] & 255) << 16) | ((s[i + 1] & 255) << 8) | (s[i + 2] & 255)
        b[w] = alphabet[(v >> 18) & 63]
        b[w + 1] = alphabet[(v >> 12) & 63]
        b[w + 2] = alphabet[(v >> 6) & 63]
        b[w + 3] = alphabet[v & 63]
        i += 3
        w += 4
    }
    if i < n {
        a := s[i] & 255
        b[w] = alphabet[a >> 2]
        if i + 1 < n {
            d := s[i + 1] & 255
            b[w + 1] = alphabet[((a & 3) << 4) | (d >> 4)]
            b[w + 2] = alphabet[(d & 15) << 2]
            if pad { b[w + 3] = 61 }
        } else {
            b[w + 1] = alphabet[(a & 3) << 4]
            if pad {
                b[w + 2] = 61
                b[w + 3] = 61
            }
        }
    }
    << b
}

pub fn ref_encode_url(s string) string {
    << ref_encode_with(&s, true, true)
}

pub fn ref_encode_raw(s string) string {
    << ref_encode_with(&s, false, false)
}

pub fn ref_encode_raw_url(s string) string {
    << ref_encode_with(&s, true, false)
}

pub fn ref_encoded_len(n int, pad bool) int {
    if n <= 0 {
        << 0
    }
    if pad {
        << ((n + 2) / 3) * 4
    }
    << (n * 4 + 2) / 3
}

pub fn ref_decoded_len(n int) int {
    << (n / 4) * 3
}

// Padding is determined before CR/LF stripping, as in the public API's
// original behavior. Whole blocks borrow the input without normalization.
fn ref_decode_padded(s &string, is_url bool) string {
    rem := s.len % 4
    if rem == 1 { >> errors.new("encoding/base64: invalid length") }
    if rem == 2 {
        padded := s + "=="
        << ref_decode_with(&padded, is_url) or >>
    }
    if rem == 3 {
        padded := s + "="
        << ref_decode_with(&padded, is_url) or >>
    }
    << ref_decode_with(s, is_url) or >>
}

pub fn ref_decode_url(s string) string {
    << ref_decode_padded(&s, true) or >>
}

pub fn ref_decode_raw_url(s string) string {
    << ref_decode_padded(&s, true) or >>
}

pub fn ref_decode_raw(s string) string {
    << ref_decode_padded(&s, false) or >>
}

// Reference above is the 0.6.16 implementation, including error precedence.
fn old_result(s string, mode int) string {
    if mode == 0 {
        out := ref_decode_string(s + "") or (err) { << "ERR:" + err.msg() }
        << "OK:" + out
    }
    if mode == 1 {
        out := ref_decode_url(s + "") or (err) { << "ERR:" + err.msg() }
        << "OK:" + out
    }
    if mode == 2 {
        out := ref_decode_raw(s + "") or (err) { << "ERR:" + err.msg() }
        << "OK:" + out
    }
    if mode == 3 {
        out := ref_decode_raw_url(s + "") or (err) { << "ERR:" + err.msg() }
        << "OK:" + out
    }
    << "invalid mode"
}
fn new_result(s string, mode int) string {
    if mode == 0 {
        out := b64.decode_string(s + "") or (err) { << "ERR:" + err.msg() }
        << "OK:" + out
    }
    if mode == 1 {
        out := b64.decode_url(s + "") or (err) { << "ERR:" + err.msg() }
        << "OK:" + out
    }
    if mode == 2 {
        out := b64.decode_raw(s + "") or (err) { << "ERR:" + err.msg() }
        << "OK:" + out
    }
    if mode == 3 {
        out := b64.decode_raw_url(s + "") or (err) { << "ERR:" + err.msg() }
        << "OK:" + out
    }
    << "invalid mode"
}
fn compare(s string) bool {
    for mode in 0:4 {
        if old_result(s + "", mode) != new_result(s + "", mode) { << false }
    }
    << true
}
fn main() int {
    // Every possible byte in every position across full and final blocks.
    for pos in 0:12 {
        for c in 0:256 {
            mut input := "QUJDREVGR0hJ" + ""
            input[pos] = c
            if !compare(input + "") { << 1 }
            if !compare("\r\n" + input + "\r\n") { << 2 }
        }
    }
    // First-error priority: malformed leading byte versus early padding.
    for c in 0:256 {
        for pad in 0:4 {
            mut input := "QUJDREVGR0hJ" + ""
            input[0] = c
            input[pad] = 61
            if !compare(input + "") { << 3 }
        }
    }
    for n in 0:130 {
        mut src := make_string(n)
        for i in 0:n { src[i] = (i * 113 + n) & 255 }
        standard := b64.encode_to_string(src + "")
        if standard != ref_encode_to_string(src + "") { << 4 }
        if b64.encode_url(src + "") != ref_encode_url(src + "") { << 5 }
        if b64.encode_raw(src + "") != ref_encode_raw(src + "") { << 6 }
        if b64.encode_raw_url(src + "") != ref_encode_raw_url(src + "") { << 7 }
        if !compare(standard + "") { << 8 }
        if !compare(standard + "\n") { << 9 }
    }
    // Length, non-ASCII, CR/LF, whitespace, aliases and padding mixtures.
    symbols := "Aa09+/-_= \r\n"
    for sample in 0:1024 {
        n := sample % 65
        mut src := make_string(n)
        for i in 0:n { src[i] = symbols[(sample * 7 + i * 11) % 12] }
        if !compare(src + "") { << 10 }
    }
    println("PASS")
    << 0
}
