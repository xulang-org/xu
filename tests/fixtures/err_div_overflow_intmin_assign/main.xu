@main
// D2 (S7): compound INT_MIN /= -1 must fail-loud (AssignLocal arm).
fn main() int {
    mut x := 0 - 9223372036854775807 - 1
    // M36: constant divisors are compile errors now; keep the runtime
    // loud path testable via an unprovable runtime divisor.
    y := 0 - args().len
    x /= y
    println(x)
    << 0
}
