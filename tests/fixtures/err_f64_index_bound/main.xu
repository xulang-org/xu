@main

struct Offset { value f64 }

fn accumulate(offset &Offset, source &[]f64, count int) f64 {
    mut total := offset.value
    for pos in 0:count {
        total += source[pos]
    }
    << total
}

fn main() int {
    mut source := []f64{}
    source.push(3.0)
    offset := Offset{value: 1.0}
    println(int(accumulate(&offset, &source, 2)))
    << 0
}
