@main

#encoding/base64

fn decode_ok(s string) bool {
    base64.decode_string(s) or (err) { << false }
    << true
}

fn main() int {
    println(base64.encode_to_string("Xu"))
    println(base64.encode_to_string("hello"))
    println(base64.encode_to_string(""))
    d := base64.decode_string("aGVsbG8=") or (err) { << 1 }
    println(decode_ok("aGVsbG8="))
    println(d)
    println(decode_ok("a"))
    println(decode_ok("@@@@"))
    round := base64.decode_string(base64.encode_to_string("hello world")) or (err) { << 1 }
    println(round)
    << 0
}
