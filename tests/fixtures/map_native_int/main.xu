@main

fn main() int {
    mut m := map[int]string{}
    m[1] = "a"
    m[2] = "b"
    println(m.len())
    println(m.has(1))
    println(m.has(3))
    println(m[1])
    println(m.get_or(3, "x"))
    m.delete(1)
    println(m.has(1))
    println(m.get_or(1, "z"))
    m[2] = "c"
    println(m[2])
    t := m.take(2)
    println(t)
    println(m.len())
    << 0
}
