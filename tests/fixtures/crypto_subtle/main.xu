@main

#crypto/subtle
#encoding/hex

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn xor_bytes_fails(x &string, y &string) bool {
    subtle.xor_bytes(x, y) or (err) { << true }
    << false
}

fn main() int {
    a := "abcd"
    b := "abcd"
    c := "abce"
    d := "abc"
    println(subtle.constant_time_compare(&a, &b))
    println(subtle.constant_time_compare(&a, &c))
    println(subtle.constant_time_compare(&a, &d))
    println(subtle.constant_time_byte_eq(7, 7))
    println(subtle.constant_time_byte_eq(7, 8))
    println(subtle.constant_time_eq(42, 42))
    println(subtle.constant_time_eq(42, 41))
    min := (0 - 9223372036854775807) - 1
    println(subtle.constant_time_eq(min, min))
    println(subtle.constant_time_eq(min, 0))
    println(subtle.constant_time_eq(0 - 1, 9223372036854775807))
    println(subtle.constant_time_select(1, 9, 3))
    println(subtle.constant_time_select(0, 9, 3))
    println(subtle.constant_time_select(1, min, 3))
    println(subtle.constant_time_select(0, 9, min))
    x := hex.decode_string("010203") or (err) { << 1 }
    y := hex.decode_string("ff00f0") or (err) { << 1 }
    z := subtle.xor_bytes(&x, &y) or (err) { << 1 }
    println(hex.encode_to_string(z + ""))
    short := "x"
    show_bool(xor_bytes_fails(&x, &short))
    show_bool(subtle.constant_time_compare(&a, &b) == 1)
    << 0
}
