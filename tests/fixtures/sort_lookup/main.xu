@main

#sort

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    a := [1, 3, 5]
    h := sort.lookup_ints(&a, 3)
    println(h.index)
    show_bool(h.found)
    m := sort.lookup_ints(&a, 4)
    println(m.index)
    show_bool(m.found)
    << 0
}
