@main
#encoding/hex

// Independent range-based oracle; do not mirror the decoder's masks.
fn nibble(c int) int {
    if c >= 48 && c <= 57 { << c - 48 }
    if c >= 65 && c <= 70 { << c - 55 }
    if c >= 97 && c <= 102 { << c - 87 }
    << -1
}

fn pair(s string, hi int, lo int) bool {
    value := hex.decode_string(s) or (err) {
        << (hi < 0 || lo < 0) && err.msg() == "encoding/hex: invalid byte"
    }
    if hi < 0 || lo < 0 { << false }
    << value.len == 1 && value[0] == hi * 16 + lo
}

fn error(s string) string {
    hex.decode_string(s) or (err) { << err.msg() }
    << "OK"
}

fn main() int {
    // All 65,536 input byte pairs, including NUL and bytes above ASCII.
    for hi in 0:256 {
        for lo in 0:256 {
            mut s := make_string(2)
            s[0] = hi
            s[1] = lo
            if !pair(s, nibble(hi), nibble(lo)) { << 1 }
        }
    }
    if error("g") != "encoding/hex: odd length" { << 2 }
    if error("00g") != "encoding/hex: odd length" { << 3 }
    if error("g0") != "encoding/hex: invalid byte" { << 4 }
    if error("00g0") != "encoding/hex: invalid byte" { << 5 }
    // Round trips on both sides of the vector encoder's 16-byte boundary.
    for n in 0:258 {
        mut raw := make_string(n)
        for i in 0:n { raw[i] = (i * 113 + n) & 255 }
        encoded := hex.encode_to_string(raw + "")
        decoded := hex.decode_string(encoded) or (err) { << 6 }
        if decoded != raw + "" { << 7 }
        encoded_ref := hex.encode(&raw)
        decoded_ref := hex.decode(&encoded_ref) or (err) { << 8 }
        if decoded_ref != raw + "" { << 9 }
    }
    println("PASS")
    << 0
}
