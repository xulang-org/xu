@main

#path

fn main() int {
    a := "/usr/local/bin"
    println(path.is_abs(&a))
    rel := "usr/local"
    println(path.is_abs(&rel))
    println(path.base(&a))
    slash := "/"
    println(path.base(&slash))
    empty := ""
    println(path.base(&empty))
    trail := "a/b/"
    println(path.base(&trail))
    println(path.dir(&a))
    one := "file.xu"
    println(path.dir(&one))
    println(path.dir(&slash))
    println(path.ext(&one))
    none := "Makefile"
    println(path.ext(&none))
    hidden := ".bashrc"
    println(path.ext(&hidden))
    nested := "a.b/c.d"
    println(path.ext(&nested))
    parts := ["std", "path", "mod.xu"]
    println(path.join(parts))
    skip := ["", "b", "c"]
    println(path.join(skip))
    c1 := "a/./b/../c"
    println(path.clean(&c1))
    c2 := "/a/b/../.."
    println(path.clean(&c2))
    c3 := "a/../.."
    println(path.clean(&c3))
    c4 := ""
    println(path.clean(&c4))
    c5 := "//"
    println(path.clean(&c5))
    sp := path.split(&a)
    println(sp[0])
    println(sp[1])
    one2 := "file.xu"
    sp2 := path.split(&one2)
    println(sp2[0].len)
    println(sp2[1])
    trail2 := "a/b/"
    sp3 := path.split(&trail2)
    println(sp3[0])
    println(sp3[1].len)
    << 0
}
