@main

#os/exec

fn trim_nl(s string) string {
    mut n := s.len
    while n > 0 {
        c := s[n - 1] & 255
        if c != 10 && c != 13 && c != 32 && c != 9 {
            <-
        }
        n = n - 1
    }
    << s[0:n]
}

fn already_started() bool {
    mut c := exec.command("true")
    c.start() or (err) { << false }
    c.start() or (err) { << true }
    << false
}

fn pipe_after_start() bool {
    mut c := exec.command("true")
    c.start() or (err) { << false }
    c.stdout_pipe() or (err) { << true }
    << false
}

fn main() int {
    mut c := exec.command("echo", "hello-pipe")
    mut r := c.stdout_pipe() or (err) {
        println(err.msg())
        << 1
    }
    c.start() or (err) {
        println(err.msg())
        << 1
    }
    s := r.read(64) or (err) {
        println(err.msg())
        << 1
    }
    c.wait() or (err) {
        println(err.msg())
        << 1
    }
    println(trim_nl(s))
    if !already_started() {
        << 1
    }
    println("started")
    if !pipe_after_start() {
        << 1
    }
    println("pipe")
    << 0
}
