@main

// kind-12 push-fill must grow through a 1-slot `&mut []T` descriptor
// pointer. Treating fp+slot as the descriptor left len=n with data=null.
fn mark(out &mut []bool, n int) {
    for _ in 0:n {
        out.push(false)
    }
    if out.len == 0 { << }
    out[0] = true
}

fn main() {
    mut a := []bool{}
    mark(mut &a, 3)
    println(a.len)
    println(a[0])
}
