@main

// Compiler isel: `(x >> n) | (x << (32-n))` → hosted ror32.
// Must match the 32-bit rotate of the low lane (sha256/sha1/md5 idiom).

fn ror8(x int) int {
    << ((x >> 8) | (x << 24)) & 4294967295
}

fn ror1(x int) int {
    << ((x >> 1) | (x << 31)) & 4294967295
}

fn main() int {
    println(ror8(0x12345678))
    println(ror1(1))
    println(ror1(2147483648))
    println(ror8(0))
    << 0
}
