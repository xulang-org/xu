@main

#net/http

fn fails_with_transport_error(post bool) bool {
    mut c := http.new_client()
    c.set_timeout(100000000)
    mut method := "GET"
    if post { method = "POST" }
    body := "payload"
    // TCP port 0 cannot be a server's bound destination port.
    c.do(method, "http://127.0.0.1:0/", &body) or (err) {
        if err.msg() == "net/http: incomplete response headers" { << false }
        if c.has_idle_connection() { << false }
        << true
    }
    << false
}

fn main() int {
    println(fails_with_transport_error(false))
    println(fails_with_transport_error(true))
    << 0
}
