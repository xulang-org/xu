@main
// Buffered sends let every G finish before the main M resumes. G, stack,
// pack and copied hidden descriptors must be reclaimed on the M stack.
fn task(n int, out chan int) { out <- n }
fn main() int {
    out := chan int{cap: 1}
    mut sum := 0
    for i in 0:1000 {
        xu task(i, out)
        sum += <-out
    }
    println(sum)
    << 0
}
