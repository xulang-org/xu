@main

#net/http
#net/http/cookiejar

fn app(c http.Context) {
    p := c.path()
    ck := c.header("Cookie")
    if p == "/set" {
        extra := "Set-Cookie: sid=abc; Path=/\r\n"
        c.text_extra(200, extra, "set") or (err) { << }
        <<
    }
    if p == "/get" {
        c.text(200, ck) or (err) { << }
        <<
    }
    c.text(404, "no") or (err) { << }
}

fn serve() {
    http.listen_and_serve_handler("127.0.0.1:19892", app) or (err) { << }
}

fn main() int {
    xu serve()
    sleep_ns(50000000)
    mut cli := http.new_client()
    j := cookiejar.new_jar()
    cli.set_jar(j)
    r1 := cli.get("http://127.0.0.1:19892/set") or (err) {
        println(err.msg())
        << 1
    }
    println(r1.status_code())
    r2 := cli.get("http://127.0.0.1:19892/get") or (err) {
        println(err.msg())
        << 1
    }
    println(r2.body())
    << 0
}
