@main
enum Opt#T {
    None
    Some(T)
}

fn main() int {
    mut n := 0
    for i in 0:10000 {
        s := "x" + "y"
        e := Opt#string.Some(s)
        match e {
            Opt.None {
                n += 0
            }
            Opt.Some(x) {
                n += x.len
            }
        }
    }
    println(n)
    println("ok")
    << 0
}
