@main

#encoding/hex

fn decode_ok(s string) bool {
    hex.decode_string(s) or (err) { << false }
    << true
}

fn main() int {
    println(hex.encode_to_string("Xu"))
    println(hex.encode_to_string(""))
    println(decode_ok("5875"))
    println(hex.decode_string("5875") or (err) { << 1 })
    println(decode_ok("abc"))
    println(decode_ok("0g"))
    round := hex.decode_string(hex.encode_to_string("hello world")) or (err) { << 1 }
    println(round)
    << 0
}
