@main
fn take(s string) {
    println(s)
}
fn main() int {
    ch := chan int{cap: 1}
    mut s := "a" + "b"
    select {
        x := <-ch {
            r := &s
            take(s)
            println(r.len)
        }
        else {
            r := &s
            take(s)
            println(r.len)
        }
    }
    << 0
}
