@main

#encoding/csv

fn show_row(row []string) {
    println(row.len)
    for i in 0:row.len {
        println(row[i])
    }
}

fn csv_read_fails(r csv.Reader) bool {
    mut rr := r
    rr.read() or (err) { << true }
    << false
}

fn main() int {
    mut r := csv.new_reader("a,b,c\n1,\"2,3\",4\n")
    show_row(r.read() or (err) { << 1 })
    show_row(r.read() or (err) { << 1 })
    mut w := csv.new_writer()
    row_a := ["x", "y,z", "q\"q"]
    row_b := ["1", "2"]
    w.write(&row_a)
    w.write(&row_b)
    println(w.text())
    mut r2 := csv.new_reader(w.text())
    all := r2.read_all() or (err) { << 1 }
    println(all.len)
    println(all[0][0])
    println(all[0][1])
    println(all[0][2])
    println(all[1][0])
    println(all[1][1])

    mut r3 := csv.new_reader("# hi\na,b\n")
    r3.set_comment(35)
    show_row(r3.read() or (err) { << 1 })

    println(csv_read_fails(csv.new_reader("a,\"b\n")))
    << 0
}
