@main

#os
#bufio/file

fn main() int {
    p := "xu_bufio_file.txt"
    mut f := os.create(p + "") or (err) {
        println("c")
        << 1
    }
    mut w := file.new_writer(f)
    n := w.write("hello\n") or (err) {
        println("w")
        << 1
    }
    w.flush() or (err) {
        println("f")
        << 1
    }
    dst := mut &w.dst
    dst.close() or (err) { << 1 }
    mut g := os.open(p + "") or (err) {
        println("o")
        << 1
    }
    mut r := file.new_reader(g)
    line := r.read_string(10) or (err) {
        println("r")
        << 1
    }
    src := mut &r.src
    src.close() or (err) { << 1 }
    os.remove(p + "") or (err) { << 1 }
    println(n)
    println(line == "hello\n")
    << 0
}
