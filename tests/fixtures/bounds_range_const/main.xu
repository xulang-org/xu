@main

fn sum_for(a &[5]int) int {
    mut s := 0
    for i in 0:5 {
        s += a[i]
    }
    << s
}

fn sum_while(a &[5]int) int {
    mut s := 0
    mut i := 0
    while i < 5 {
        s += a[i]
        i += 1
    }
    << s
}

fn main() int {
    a := [5]int{1, 2, 3, 4, 5}
    println(sum_for(&a))
    println(sum_while(&a))
    mut t := 0
    for i in 0:5 {
        t += a[i]
    }
    println(t)
    << 0
}
