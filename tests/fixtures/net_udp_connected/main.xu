@main

#net

fn main() int {
    mut srv := net.listen_packet("udp", "127.0.0.1:19121") or (err) { << 1 }
    remote := net.UDPAddr{ip: net.ipv4(127, 0, 0, 1), port: 19121, zone: ""}
    mut cli := net.dial_udp("udp", net.new_udp_addr(), remote) or (err) { << 1 }
    msg := "ping"
    println(cli.write(&msg) or (err) { << 1 })
    pkt := srv.read_from(64) or (err) { << 1 }
    println(pkt.data)
    data := pkt.data + ""
    srv.write_to(&data, &pkt.addr) or (err) { << 1 }
    println(cli.read(64) or (err) { << 1 })
    println(cli.remote_addr())

    mut generic := net.dial_to("udp", "127.0.0.1:19121") or (err) { << 1 }
    msg2 := "dial"
    println(generic.write(&msg2) or (err) { << 1 })
    pkt2 := srv.read_from(64) or (err) { << 1 }
    println(pkt2.data)
    data2 := pkt2.data + ""
    srv.write_to(&data2, &pkt2.addr) or (err) { << 1 }
    println(generic.read(64) or (err) { << 1 })
    println(generic.remote_addr())
    generic.close() or (err) { << 1 }

    cli.close() or (err) { << 1 }
    srv.close() or (err) { << 1 }
    << 0
}
