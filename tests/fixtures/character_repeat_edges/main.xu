@main
#strings
fn check(src &string, n int) bool {
    mut out := strings.repeat(src, n)
    if n <= 0 || src.len == 0 { << out.len == 0 }
    if out.len != src.len * n { << false }
    for i in 0:out.len {
        if out[i] != src[i % src.len] { << false }
    }
    // Repeat returns independently writable storage, including n==1 and views.
    first := src[0]
    out[0] = first ^ 255
    if src[0] != first { << false }
    if out.len > src.len && out[src.len] != first { << false }
    << true
}
fn escaped() string {
    mut src := make_string(3)
    src[0] = 65
    src[1] = 0
    src[2] = 255
    << strings.repeat(&src, 3)
}
fn main() int {
    sizes := [14]int{0, 1, 2, 7, 8, 15, 16, 31, 32, 255, 256, 2047, 2048, 2049}
    counts := [14]int{-1, 0, 1, 2, 3, 7, 8, 9, 15, 16, 17, 31, 32, 33}
    for si in 0:14 {
        mut src := make_string(sizes[si])
        for j in 0:src.len { src[j] = j & 255 }
        for ni in 0:14 {
            if !check(&src, counts[ni]) { << 1 }
        }
    }
    literal := "a中🙂"
    for ni in 0:14 { if !check(&literal, counts[ni]) { << 2 } }
    // Shared split views have cap<0, distinct from owned and static inputs.
    source := "hello,world" + ""
    parts := strings.split(&source, ",")
    piece := &parts[1]
    for ni in 0:14 { if !check(piece, counts[ni]) { << 3 } }
    empty := ""
    if strings.repeat(&empty, 9223372036854775807).len != 0 { << 4 }
    if !check(&literal, 384) || !check(&literal, 385) { << 5 }
    result := escaped()
    if result.len != 9 { << 6 }
    for j in 0:3 {
        if result[j * 3] != 65 || result[j * 3 + 1] != 0 || result[j * 3 + 2] != 255 { << 7 }
    }
    println("PASS")
    << 0
}
