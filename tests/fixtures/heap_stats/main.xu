@main
// The fixture intentionally creates and drops several owned strings.  The
// normal stdout contract is stable; XU_HEAP_STATS=1 adds machine-readable
// counters on stderr without changing this output.
fn main() int {
    mut s := ""
    for i in 0:12 {
        s = s + "0123456789abcdef"
    }
    println(s.len)
    s = "done"
    println(s)
    << 0
}
