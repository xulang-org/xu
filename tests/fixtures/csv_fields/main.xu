@main

#encoding/csv

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn learned_mismatch() bool {
    mut r := csv.new_reader("a,b\n1,2,3\n")
    r.fields_per_record = 0
    r.read() or (err) { << false }
    r.read() or (err) { << true }
    << false
}

fn exact_mismatch() bool {
    mut r := csv.new_reader("a,b,c\n")
    r.fields_per_record = 2
    r.read() or (err) { << true }
    << false
}

fn main() int {
    show_bool(learned_mismatch())
    mut r := csv.new_reader("a,b\n1,2\n")
    r.fields_per_record = 2
    a := r.read() or (err) { << 1 }
    println(a.len)
    b := r.read() or (err) { << 1 }
    println(b.len)
    show_bool(exact_mismatch())
    mut t := csv.new_reader("a, b\n")
    t.trim_leading_space = true
    row := t.read() or (err) { << 1 }
    println(row[1])
    mut flex := csv.new_reader("a,b\n1,2,3\n")
    flex.fields_per_record = 0 - 1
    x := flex.read() or (err) { << 1 }
    y := flex.read() or (err) { << 1 }
    println(x.len)
    println(y.len)
    << 0
}
