@main

#math/big
#math/rand

fn main() int {
    mut r := big.new_rat(1, 2)
    mut s := big.new_rat(1, 3)
    mut z := big.new_rat(0, 1)
    z.add(&r, &s)
    n1 := z.num()
    d1 := z.denom()
    println(n1.text())
    println(d1.text())

    z.sub(&r, &s)
    n2 := z.num()
    d2 := z.denom()
    println(n2.text())
    println(d2.text())

    mut a := big.new_rat(2, 3)
    mut b := big.new_rat(3, 4)
    z.mul(&a, &b)
    n3 := z.num()
    d3 := z.denom()
    println(n3.text())
    println(d3.text())

    mut c := big.new_rat(1, 2)
    mut d := big.new_rat(1, 4)
    z.quo(&c, &d) or (err) {
        << 1
    }
    n4 := z.num()
    d4 := z.denom()
    println(n4.text())
    println(d4.text())

    mut two := big.new_int(2)
    mut four := big.new_int(4)
    z.set_frac(&two, &four) or (err) {
        << 1
    }
    n5 := z.num()
    d5 := z.denom()
    println(n5.text())
    println(d5.text())

    mut neg := big.new_rat(0 - 3, 6)
    println(neg.sign())
    n6 := neg.num()
    d6 := neg.denom()
    println(n6.text())
    println(d6.text())
    mut zero := big.new_rat(0, 5)
    println(zero.sign())
    zd := zero.denom()
    println(zd.text())

    mut src := rand.new_source(1)
    i31 := src.int31()
    println(i31 >= 0 && i31 <= 2147483647)
    println(i31)
    p := src.perm(4)
    println(p.len)
    println(p[0])
    println(p[1])
    println(p[2])
    println(p[3])
    mut seen0 := 0
    mut seen1 := 0
    mut seen2 := 0
    mut seen3 := 0
    mut pok := true
    mut pi := 0
    while pi < p.len {
        v := p[pi]
        if v == 0 {
            seen0 = seen0 + 1
        } else if v == 1 {
            seen1 = seen1 + 1
        } else if v == 2 {
            seen2 = seen2 + 1
        } else if v == 3 {
            seen3 = seen3 + 1
        } else {
            pok = false
        }
        pi = pi + 1
    }
    println(pok && seen0 == 1 && seen1 == 1 && seen2 == 1 && seen3 == 1)

    mut arr := [10, 20, 30, 40]
    mut src2 := rand.new_source(7)
    src2.shuffle(mut &arr)
    println(arr[0])
    println(arr[1])
    println(arr[2])
    println(arr[3])
    mut sum := arr[0] + arr[1] + arr[2] + arr[3]
    println(sum == 100)
    << 0
}
