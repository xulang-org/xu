@main

// Regression: an immediately scheduled worker with a recv/send select must
// make progress even when the parent receives from the buffered channel.
fn fire(c chan int, stop chan int) {
    select {
        x := <-stop {
            _ := x
            <<
        }
        c <- 1 {
        }
    }
}

fn main() int {
    ch := chan int{cap: 1}
    st := chan int{cap: 1}
    xu fire(ch, st)
    println(<-ch)
    << 0
}
