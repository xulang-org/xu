@main
// Grow a string past the 512B large-class threshold, then drop it via
// reassignment so rt_free munmaps the dedicated mapping.
fn main() int {
    mut s := ""
    for i in 0:20 {
        s.push_str("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
    }
    println(s.len)
    s = "ok"
    println(s)
    // Repeat growth+drop a few times (munmap must keep working).
    for j in 0:8 {
        mut t := ""
        for i in 0:30 {
            t.push_str("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")
        }
        println(t.len)
    }
    << 0
}
