@main
#strings
fn same_owned(s &string) bool {
 mut a := strings.clone(s)
 mut b := s[0:s.len]
 if a != s + "" || b != s + "" { << false }
 if s.len > 0 {
  before := s[0] & 255
  a[0] = before ^ 255
  if (s[0] & 255) != before || (b[0] & 255) != before { << false }
  b[0] = before ^ 127
  if (s[0] & 255) != before || (a[0] & 255) != (before ^ 255) { << false }
 }
 << true
}
fn main() int {
 sizes := [13]int{0, 1, 7, 8, 15, 16, 255, 256, 2047, 2048, 2049, 4096, 18816}
 mut checked := 0
 mut si := 0
 while si < 13 {
  n := sizes[si]
  mut src := make_string(n)
  mut i := 0
  while i < n { src[i] = i & 255
   i += 1 }
  if !same_owned(&src) { << 1 }
  checked += 1
  parts := strings.split(&src, "\n")
  mut j := 0
  while j < parts.len {
   piece := &parts[j]
   if !same_owned(piece) { << 2 }
   checked += 1
   j += 1
  }
  si += 1
 }
 println(checked)
 << 0
}
