@main
// F4: a two-field struct passed to `go` must arrive with both slots intact
// (regression for go arguments being treated as single-slot words only).
struct Pair {
    a int
    b int
}

fn worker(p Pair) {
    println(p.a + p.b)
}

fn main() int {
    xu worker(Pair{a: 20, b: 22})
    // Keep main alive until the goroutine's preamble has copied the arg
    // (MC mode runs `go` on a pthread).
    mut i := 0
    while i < 20000000 {
        i = i + 1
    }
    << 0
}
