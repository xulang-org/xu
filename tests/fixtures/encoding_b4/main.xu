@main

#encoding/binary
#encoding/hex
#encoding/xml
#encoding/json
#encoding/csv

fn main() int {
    println(hex.encoded_len(3))
    println(hex.decoded_len(6))
    println(hex.decoded_len(5))

    raw := "a<b>&\"'"
    esc := xml.escape_string(&raw)
    et := xml.escape_text(&raw)
    println(esc == et)
    got := xml.unescape_string(&esc)
    println(got == raw)

    v0 := binary.put_varint(0)
    println(binary.varint(&v0) or (err) { << 1 })
    v1 := binary.put_varint(1)
    println(binary.varint(&v1) or (err) { << 1 })
    vn := binary.put_varint(0 - 1)
    println(binary.varint(&vn) or (err) { << 1 })
    v300 := binary.put_varint(300)
    println(binary.varint(&v300) or (err) { << 1 })
    vn300 := binary.put_varint(0 - 300)
    println(binary.varint(&vn300) or (err) { << 1 })
    println(binary.size_varint(0 - 1))
    println(binary.size_varint(300))

    amp := "<>&"
    h1 := json.html_escape(&amp)
    println(h1)
    ls := string_from_bytes([226, 128, 168])
    h2 := json.html_escape(&ls)
    println(h2)

    mut empty := csv.new_reader("")
    all0 := empty.read_all() or (err) { << 1 }
    println(all0.len)
    mut r1 := csv.new_reader("a,b\n")
    all1 := r1.read_all() or (err) { << 1 }
    println(all1.len)
    println(all1[0][0])
    println(all1[0][1])
    mut r2 := csv.new_reader("a,b\n\n")
    all2 := r2.read_all() or (err) { << 1 }
    println(all2.len)
    << 0
}
