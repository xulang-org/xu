@main

// Two LoadIndex of the same induction must not post-index walk
// (that would read u[j] then u[j+1]). Scaled CSE of the data pointer
// is still allowed. StoreIndex keeps this on the index-acc kernel path.

fn fill(v &mut []f64, u &[]f64) {
    n := v.len
    for i in 0:n {
        mut s := 0.0
        for j in 0:n {
            s += u[j] + u[j]
        }
        v[i] = s
    }
}

fn main() int {
    mut u := []f64{}
    mut v := []f64{}
    u.push(2.0)
    u.push(4.0)
    u.push(6.0)
    v.push(0.0)
    v.push(0.0)
    v.push(0.0)
    fill(mut &v, &u)
    println(int(v[0]))
    println(int(v[1]))
    println(int(v[2]))
    << 0
}
