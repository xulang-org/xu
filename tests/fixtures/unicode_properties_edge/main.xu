@main

#unicode

fn mask(r int) int {
    mut b := 0
    if unicode.is_digit(r) {
        b += 1
    }
    if unicode.is_letter(r) {
        b += 2
    }
    if unicode.is_space(r) {
        b += 4
    }
    if unicode.is_upper(r) {
        b += 8
    }
    if unicode.is_lower(r) {
        b += 16
    }
    if unicode.is_title(r) {
        b += 32
    }
    if unicode.is_number(r) {
        b += 64
    }
    if unicode.is_punct(r) {
        b += 128
    }
    if unicode.is_symbol(r) {
        b += 256
    }
    if unicode.is_print(r) {
        b += 512
    }
    if unicode.is_graphic(r) {
        b += 1024
    }
    if unicode.is_control(r) {
        b += 2048
    }
    << b
}

fn main() int {
    rs := [-9223372036854775807 - 1, -2, -1, 0, 31, 32, 36, 43, 48, 65, 97, 127, 133, 160, 0xbd, 0x301, 0x1c4, 0x1c5, 0x1c6, 0x1c7, 0x1c8, 0x1c9, 0x1fbc, 0x2160, 0x200b, 0x2028, 0x2029, 0x1f642, 0x1d7ce, 0x1e4f0, 0x1c89, 0xd800, 0xdfff, 0x10ffff, 0x110000, 0x110002, 0x100000030, 9223372036854775807]
    for i in 0:rs.len {
        r := rs[i]
        println(r)
        println(mask(r))
        println(unicode.to_title(r))
    }
    << 0
}
