@main

#regexp

fn main() int {
    re := regexp.compile("a+") or (err) { << 1 }
    s := "xaaay"
    lit := "\$1"
    println(re.replace_all_literal(&s, &lit))
    re2 := regexp.compile("(a+)(b)") or (err) { << 1 }
    t := "xxaaabyy"
    ix := re2.find_submatch_index(&t)
    println(ix.len)
    println(ix[0].start)
    println(ix[0].end)
    println(ix[1].start)
    println(ix[2].start)
    << 0
}
