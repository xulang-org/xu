@main

// Passing an Ident (not a literal) into `temp` must box; AddrOf the
// concrete local would hand the callee a 1-slot int as a 2-slot temp.

struct Box {
    pub e temp
}

fn wrap(v temp) Box {
    << Box{e: v}
}

fn take(v temp) {
    println(v as int)
}

fn main() int {
    x := 7
    take(x)
    b := wrap(x)
    println(b.e as int)
    s := "hi"
    b2 := wrap(s)
    println(b2.e as string)
    << 0
}
