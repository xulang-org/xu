@main

#math/rand

fn main() int {
    mut r := rand.new_source(1)
    println(r.int63())
    println(r.intn(100))
    println(r.intn(1000))
    println(r.int63())
    f := r.float64()
    println(f > 0.0 && f < 1.0)
    // a fresh source with the same seed replays the sequence
    mut r2 := rand.new_source(1)
    println(r2.intn(100))
    println(r2.intn(1000))
    // reseeding restarts the sequence
    r.seed(1)
    println(r.intn(100))
    // seed 0 is a legal seed (xorshift state cannot be 0; mapped to 1)
    mut r3 := rand.new_source(0)
    mut r4 := rand.new_source(1)
    println(r3.intn(7) == r4.intn(7))
    // small-bound rejection sampling stays in range over many draws
    mut r5 := rand.new_source(42)
    mut ok := true
    for i in 0:200 {
        v := r5.intn(7)
        if v < 0 || v >= 7 {
            ok = false
        }
    }
    println(ok)
    << 0
}
