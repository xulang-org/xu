@main

#compress/gzip

fn main() int {
    mut w := gzip.new_writer()
    w.set_mtime(1)
    body := "ok"
    w.write(&body) or (err) { << 1 }
    w.close()
    raw := w.bytes()
    mut r := gzip.new_reader(raw + "")
    h := r.header() or (err) { << 1 }
    println(h.mtime)
    println(r.read_all() or (err) { << 1 })
    << 0
}
