@main

// Mutable f64 loop state must pass through formal SSA/Phi, de-SSA copies and
// the independent FP fixed-home bank. The integer induction exercises a
// mixed register-class CFG in the same function.
fn accumulate(n int) int {
    mut sum := 0.0
    mut i := 0
    while i < n {
        sum += f64(i & 7)
        i += 1
    }
    << int(sum)
}

fn bump(x f64) f64 {
    << x + 0.25
}

// `hold` remains live across the direct scalar call. The FP allocator keeps a
// fixed home and splits that interval through a colored slot immediately
// around the call because the hosted fixed-home FP bank is caller-saved.
fn across_call(n int) int {
    hold := 1.5
    mut sum := 0.0
    mut i := 0
    while i < n {
        sum = bump(sum) + hold
        i += 1
    }
    << int(sum)
}

fn main() int {
    println(accumulate(100000))
    println(across_call(4))
    << 0
}
