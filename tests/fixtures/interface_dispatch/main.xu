@main
struct@ ToString {
    fn to_string() string
}
struct User {
    name string
    age int
}
fn (u User) to_string() string { << u.name }
struct Score {
    n int
}
fn (s Score) to_string() string { << "score" }
fn print_item(item# ToString) { println(item.to_string()) }
fn main() int {
    u := User{name: "ada", age: 36}
    print_item(u)
    print_item(Score{n: 3})
    << 0
}
