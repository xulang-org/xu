@main

#ui
#ui/webview

fn main() int {
    write_file("index.html", "<html><body>xu-asset</body></html>") or (err) {
        println("write-fail")
        << 1
    }
    body := ui.load_asset("index.html") or (err) {
        println("asset-fail")
        << 1
    }
    println(body.len > 10)
    mut app := ui.new_app()
    mut win := app.new_window(ui.WindowOpts{title: "Assets", width: 320, height: 240})
    r := mut &win
    mut wv := webview.attach(r)
    wv.load_file("index.html") or (err) {
        println(err.msg())
        << 0
    }
    << 1
}
