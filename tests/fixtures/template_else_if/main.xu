@main

#text/template
ht #html/template

fn main() int {
    mut d := template.new_dict()
    d.set("A", "")
    d.set("B", "yes")
    t := template.new("{{if .A}}a{{else if .B}}b{{else}}c{{end}}")
    println(template.execute(&t, &d) or (err) { << 1 })
    mut d2 := template.new_dict()
    println(template.execute(&t, &d2) or (err) { << 1 })
    mut d3 := template.new_dict()
    d3.set("A", "1")
    println(template.execute(&t, &d3) or (err) { << 1 })

    t2 := template.new("{{if .Name}}hi{{else}}anon{{end}}")
    mut d4 := template.new_dict()
    println(template.execute(&t2, &d4) or (err) { << 1 })

    ht2 := ht.new("{{if .A}}x{{else if .B}}<b>{{.B}}</b>{{end}}")
    mut hd := ht.new_dict()
    hd.set("B", "<em>")
    println(ht.execute(&ht2, &hd))
    << 0
}
