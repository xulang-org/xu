@main

#errors
#flag
#log
#fmt

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    e := errors.StrErr{text: "a;b"}
    println(e.msg())
    show_bool(e.text == "a;b")
    mut fs := flag.new_set("p")
    fs.define_float64("x", 0.0, "float")
    fs.define_duration("d", 0, "dur")
    fs.parse(["-x", "1.5", "-d", "2s"]) or (err) {
        show_bool(false)
        << 1
    }
    show_bool(true)
    show_bool(fs.get_float64("x") == 1.5)
    show_bool(fs.get_duration("d") == 2000000000)
    mut lg := log.new_logger()
    lg.set_output_buffer()
    lg.set_prefix("p:")
    lg.println(fmt.s("ok"))
    t := lg.buffer_text()
    show_bool(t.len > 0)
    << 0
}
