@main

#crypto/x509
#encoding/pem
#time

fn name_ok(c &x509.Certificate, name string) bool {
    now := c.not_before.add(time.hour())
    opts := x509.VerifyOptions{dns_name: name, current_time: now, roots: x509.new_cert_pool(), intermediates: x509.new_cert_pool(), key_usages: []int{}, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    c.verify(opts) or (err) {
        << false
    }
    << true
}

fn main() int {
    pem_text := "-----BEGIN CERTIFICATE-----\nMIICRDCCAa2gAwIBAgIUB5hyZk06Fg2bNlwo0TYvHq7IUaYwDQYJKoZIhvcNAQEL\nBQAwGjEYMBYGA1UEAwwPaWdub3JlZC5leGFtcGxlMB4XDTI2MDgzMTAxNTczM1oX\nDTM2MDgyODAxNTczM1owGjEYMBYGA1UEAwwPaWdub3JlZC5leGFtcGxlMIGfMA0G\nCSqGSIb3DQEBAQUAA4GNADCBiQKBgQCpGmcF5VQnEivPSA+aLRhJL+FBtDkRk4kJ\n0UEDMtOIpvC0gm+4dHjrgeBQ+7npZiiPbVtuuKfC2M8DbUjgLBKfdvtkpV0MOa/X\nrlB5scFAod0/usl2J+QPgZPaUrz4jnsxGcfmlZG7goCx8Uubrwm+m4AaQXfrX+Ar\n94Kpz0d1ywIDAQABo4GGMIGDMB0GA1UdDgQWBBQiHFhwY0Kz16/eS4x2og9SJwyo\nrzAfBgNVHSMEGDAWgBQiHFhwY0Kz16/eS4x2og9SJwyorzAPBgNVHRMBAf8EBTAD\nAQH/MDAGA1UdEQQpMCeCDSouZXhhbXBsZS5jb22HBMAAAgqHECABDbgAAAAAAAAA\nAAAAABAwDQYJKoZIhvcNAQELBQADgYEAHD38AmxzNUOYvYgbPK08MALXI1O62Fgp\nHeZjg4VKLICWLtFV4AjatRTaDRXpkcSxF/aH4/fVIGDPERdWzbOY8qm0J8UOoBEq\n99SGrzPBoJBKA8KcGqhsQEwcHX436xaZmwVgzBDVuzrXw/z0XDhSZOa9es6EEsb0\nV7Tn4Emi5Ks=\n-----END CERTIFICATE-----\n"
    block := pem.decode(&pem_text)
    c := x509.parse_certificate(block.bytes) or (err) {
        println(err.msg())
        << 1
    }

    println(c.dns_names.len)
    println(c.ip_addresses.len)
    println(name_ok(&c, "api.example.com"))
    println(name_ok(&c, "API.EXAMPLE.COM"))
    println(name_ok(&c, "api.example.com."))
    println(name_ok(&c, "deep.api.example.com"))
    println(name_ok(&c, "example.com"))
    println(name_ok(&c, "ignored.example"))
    println(name_ok(&c, "192.0.2.10"))
    println(name_ok(&c, "192.0.2.11"))
    println(name_ok(&c, "2001:db8::10"))
    println(name_ok(&c, "[2001:db8::10]"))
    << 0
}
