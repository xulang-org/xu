@main

#net/url

fn check(s string) {
    mut u := url.new_url()
    u.parse(s) or (err) {
        println(false)
    println("err")
        <<
    }
    println(true)
    println(u.scheme())
    println(u.host())
    println(u.path())
    println(u.raw_query())
    println(u.fragment())
    println(u.to_string())
}

fn query_fails(pq string) bool {
    mut qq := url.new_query()
    qq.parse(pq) or (err) {
        << true
    }
    << false
}

fn parse_url_ok(s string) bool {
    mut u := url.new_url()
    u.parse(s) or (err) {
        << false
    }
    << true
}

fn main() int {
    check("https://golang.org/doc/effective_go.html")
    check("//example.com/a/b")
    check("file:///tmp/x")
    check("a/b?x=1#f")
    check("http://[::1]:8080/x?k=v")
    check("1abc://x")
    ht := "ht\ntp://x"
    println(parse_url_ok(ht))
    q := "a b+c&d/e"
    println(url.query_escape(&q))
    p := "a b/c?"
    println(url.path_escape(&p))
    pq := "x=1&y=a+b&z=%2F&e&bad=%zz"
    println(query_fails(pq))
    mut qq2 := url.new_query()
    qq2.parse("x=1&y=a+b&z=%2F&e") or (err) { << 1 }
    println(true)
    println(qq2.len())
    println(qq2.at(0))
    println(qq2.at(1))
    println(qq2.at(2))
    println(qq2.at(3))
    u3 := url.parse_url("https://ex.com/z") or (err) { << 1 }
    println(u3.scheme())
    println(u3.host())
    println(u3.path())
    << 0
}
