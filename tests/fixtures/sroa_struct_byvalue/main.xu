@main

// Regression: SROA must not drop StoreField on a struct literal whose
// local is later passed by value (LoadLocal). That shape is how
// image_color `.rgba()` and image_geom `set_rgba` consume `color.RGBA`.

struct C {
    r int
    g int
    b int
    a int
}

fn take(c C) {
    println(c.r)
    println(c.g)
}

fn (c C) scaled() C {
    << C{r: c.r * 257, g: c.g * 257, b: c.b * 257, a: c.a * 257}
}

fn main() int {
    c := C{r: 10, g: 20, b: 30, a: 255}
    take(c)
    println(c.b)
    println(c.a)
    p := c.scaled()
    println(p.r)
    println(p.g)
    println(p.b)
    println(p.a)
    q := C{r: 1, g: 2, b: 3, a: 4}
    println(q.r)
    println(q.g)
    << 0
}
