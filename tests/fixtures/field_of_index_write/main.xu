@main

struct Item {
    next int
    s    string
    f    f64
}

fn main() int {
    mut a := []Item{}
    a.push(Item{next: -1, s: "old", f: 1.5})
    a.push(Item{next: 5, s: "x", f: 2.5})
    i := 1
    a[0].next = 7
    a[1].next += 10
    a[i].s = "newer"
    a[0].f += 0.5
    println(a[0].next)
    println(a[1].next)
    println(a[0].s)
    println(a[1].s)
    println(a[0].f)
    << 0
}
