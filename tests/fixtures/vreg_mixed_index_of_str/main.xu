@main

#slices

// Gold for slices.index_of_str / contains_str under O0 and O1.
// Guards the []string LoadIndex + str_cmp mixed-plan regression
// (O1 used to return 0 for every probe).

fn main() int {
    ws := ["x", "y", "z"]
    println(slices.index_of_str(ws, "y"))
    ws2 := ["x", "y", "z"]
    println(slices.index_of_str(ws2, "q"))
    w1 := ["aa", "bb"]
    println(slices.contains_str(w1, "bb"))
    w2 := ["aa", "bb"]
    println(slices.contains_str(w2, "cc"))
    << 0
}
