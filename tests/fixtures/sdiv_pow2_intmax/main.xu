@main

fn main() int {
    maxp := 9223372036854775807
    minp := 0 - 9223372036854775807 - 1
    println(maxp / 2)
    println(maxp / 4)
    println(maxp / 8)
    println(maxp / 16)
    println(minp / 2)
    println(minp / 4)
    println(minp / 16)
    println((0 - 5) / 4)
    println(5 / 4)
    << 0
}
