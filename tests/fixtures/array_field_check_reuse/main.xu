@main
struct Pair {
    left []int
    tag int
    right []int
}
fn salt(x int) int { << (x * 31) ^ (x >> 5) }
fn repeat(t &mut Pair, p int, q int) int {
    t.left[p] = t.left[p] + t.right[q]
    t.right[q] = salt(t.left[p] ^ t.right[q])
    t.left[2] = t.left[2] - t.right[2]
    t.right[2] = t.left[2] + t.right[2]
    t.left[p] = t.left[p] ^ t.right[q]
    << t.left[p] + t.right[q] + t.left[2] + t.right[2]
}
fn grow(t &mut Pair) { t.right.push(t.left[0]) }
fn mutation(t &mut Pair, p int) int {
    old := t.right[p]
    grow(mut &*t)
    t.right[p] = old + t.right[p]
    << t.right[p]
}
fn changing(t &mut Pair, p int) int {
    mut i := p
    t.left[i] = t.left[i] + 11
    i += 1
    t.left[i] = t.left[i] ^ 29
    << t.left[i] + t.left[p]
}
fn main() int {
    for k in 0:32 {
        mut a := []int{}
        mut b := []int{}
        for j in 0:6 { a.push((j * 17 - k * 31) ^ (k << 55)) }
        for j in 0:4 { b.push((k * 23 - j * 11) ^ (j << 57)) }
        mut t := Pair{left: a, tag: 97, right: b}
        println(repeat(mut &t, k % 6, k % 4))
        println(mutation(mut &t, k % 4))
        println(changing(mut &t, k % 5))
        println(t.tag)
        for j in 0:6 { println(t.left[j]) }
        for j in 0:5 { println(t.right[j]) }
    }
    << 0
}
