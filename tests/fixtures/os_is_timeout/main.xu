@main

#os

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn main() int {
    show_bool(os.is_permission("permission denied"))
    show_bool(os.is_permission("not found"))
    show_bool(os.is_timeout("i/o timeout"))
    show_bool(os.is_timeout("timed out waiting"))
    show_bool(os.is_timeout("ok"))
    << 0
}
