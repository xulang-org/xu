@main

#io
#bufio

fn read_full_fails(src io.Cursor, n int) bool {
    io.read_full(src, n) or (err) {
        << true
    }
    << false
}

fn main() int {
    src := io.cursor("abcdef")
    println(io.read_full(src, 3) or (err) { << 1 })
    src2 := io.cursor("xy")
    println(read_full_fails(src2, 4))
    src3 := io.cursor("hello world")
    println(io.copy_n(io.buffer(), src3, 5) or (err) { << 1 })
    mut lim := io.limit_cursor(io.cursor("0123456789"), 4)
    println(lim.read_n(10))
    mut d := io.discard()
    hi := "hi"
    println(d.write(&hi))
    println(d.written())
    mut br := bufio.new_reader_size(io.buffer_from("abcd"), 2)
    println(br.peek(2) or (err) { << 1 })
    println(br.buffered())
    println(br.discard(1) or (err) { << 1 })
    println(br.read_bytes(99) or (err) { << 1 })
    mut bw := bufio.new_writer(io.buffer())
    println(bw.write_byte(65) or (err) { << 1 })
    println(bw.flush() or (err) { << 1 })
    println(bw.bytes())
    mut owned := io.copy_to(io.buffer(), io.cursor("xyz")) or (err) { << 1 }
    println(owned.bytes())
    << 0
}
