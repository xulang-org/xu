@main

#text/scanner

fn main() int {
    nl := "\n"
    tab := "\t"
    src := nl + "// This is scanned code." + nl + "if a > 10 {" + nl + tab + "someParsable = text" + nl + "}"
    mut s := scanner.new(&src)
    mut tok := s.scan()
    mut n := 0
    while tok != scanner.eof && n < 20 {
        println(s.line())
    println(s.column())
    println(s.token_text())
        tok = s.scan()
        n = n + 1
    }
    println(n)
    << 0
}
