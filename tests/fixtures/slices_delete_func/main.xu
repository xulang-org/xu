@main

#slices

fn odd(x int) bool {
    << x % 2 == 1
}

fn same(a int, b int) bool {
    << a == b
}

fn main() int {
    xs := [1, 2, 2, 3, 3, 3]
    c := slices.compact_func_ints(&xs, same)
    println(c.len)
    println(c[0])
    println(c[2])
    d := slices.delete_func_ints(&xs, odd)
    println(d.len)
    println(d[0])
    println(d[1])
    << 0
}
