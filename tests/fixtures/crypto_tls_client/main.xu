@main

#net
#crypto/tls
#context

fn peer() {
    ln := net.listen_on("tcp", "127.0.0.1:19883") or (err) {
        <<
    }
    mut c := ln.accept() or (err) {
        <<
    }
    c.close() or (err) {
        <<
    }
}

fn main() int {
    mut cc := context.with_cancel()
    cc.cancel()
    cfg := tls.new_config("localhost")
    tls.dial_context(&cc.ctx, "tcp", "127.0.0.1:1", &cfg) or (err) {
        println(err.msg())
        xu peer()
        sleep_ns(50000000)
        tls.dial("tcp", "127.0.0.1:19883", &cfg) or (e2) {
            println("fail")
            << 0
        }
        << 1
    }
    << 1
}
