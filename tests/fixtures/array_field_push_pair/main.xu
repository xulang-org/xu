@main
struct PairStore { left []int right []int used int }
fn insert(t &mut PairStore, l int, r int) int {
    id := t.used
    if id >= t.left.len {
        t.left.push(l)
        t.right.push(r)
    } else {
        t.left[id] = l
        t.right[id] = r
    }
    t.used = id + 1
    << id
}
fn main() int {
    mut t := PairStore{left: []int{}, right: []int{}, used: 0}
    for cycle in 0:3 {
        t.used = 0
        for i in 0:257 {
            l := i * 13 - cycle
            r := cycle * 1009 - i * 17
            id := insert(mut &t, l, r)
            println(id)
            println(t.left[id])
            println(t.right[id])
        }
    }
    << 0
}
