@main

#compress/gzip

fn main() int {
    mut w := gzip.new_writer()
    w.set_name("hi.txt")
    body := "ok"
    w.write(&body) or (err) { << 1 }
    w.close()
    raw := w.bytes()
    mut r := gzip.new_reader(raw + "")
    h := r.header() or (err) {
        println(err.msg())
        << 1
    }
    println(h.name)
    println(r.read_all() or (err) { << 1 })
    << 0
}
