@main

#io/fs
#os

fn drop_quiet(p string) {
    os.remove(p) or (err) {
        <<
    }
}

fn expect_escape(fsys &os.DirFS) int {
    fs.read_file(fsys, "../main.xu") or (err) {
        println("esc")
        << 0
    }
    << 1
}

fn main() int {
    drop_quiet("xu_io_fs_d2/a.txt")
    drop_quiet("xu_io_fs_d2")
    os.mkdir("xu_io_fs_d2") or (err) {
        << 1
    }
    os.write("xu_io_fs_d2/a.txt", "hello-fs") or (err) {
        << 1
    }

    a := "a.txt"
    println(fs.valid_path(&a))
    dot := "."
    println(fs.valid_path(&dot))
    up := "a/../b"
    println(fs.valid_path(&up))
    abs := "/abs"
    println(fs.valid_path(&abs))
    empty := ""
    println(fs.valid_path(&empty))
    nested := "a/b"
    println(fs.valid_path(&nested))

    fsys := os.dir_fs("xu_io_fs_d2")
    s := fs.read_file(&fsys, "a.txt") or (err) {
        << 1
    }
    println(s)

    mut f := fsys.open("a.txt") or (err) {
        << 1
    }
    got := f.read(64) or (err) {
        << 1
    }
    f.close() or (err) {
        << 1
    }
    println(got)

    ents := fs.read_dir(&fsys, ".") or (err) {
        << 1
    }
    println(ents.len)

    info := fs.stat(&fsys, "a.txt") or (err) {
        << 1
    }
    println(info.size)
    println(info.is_dir)

    dinfo := fs.stat(&fsys, ".") or (err) {
        << 1
    }
    println(dinfo.is_dir)

    if expect_escape(&fsys) != 0 {
        << 1
    }

    sub := fs.sub(&fsys, ".") or (err) {
        << 1
    }
    s2 := fs.read_file(&sub, "a.txt") or (err) {
        << 1
    }
    println(s2)

    drop_quiet("xu_io_fs_d2/a.txt")
    drop_quiet("xu_io_fs_d2")
    << 0
}
