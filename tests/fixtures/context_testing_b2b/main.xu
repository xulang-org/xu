@main

#context
#testing/iotest

fn deadline_msg(c &context.Context) string {
    context.err(c) or (err) {
        << err.msg()
    }
    << ""
}

fn read_err(r iotest.ErrReader) string {
    r.read_n(1) or (err) {
        << err.msg()
    }
    << ""
}

fn main() int {
    past := now_ns() - 1000
    mut d := context.with_deadline(past)
    println(deadline_msg(&d.ctx))
    mut fut := context.with_deadline(now_ns() + 3600000000000)
    println(deadline_msg(&fut.ctx).len)
    fut.cancel()
    println(read_err(iotest.err_reader("boom")))
    << 0
}
