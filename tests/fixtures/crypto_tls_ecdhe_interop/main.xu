@main

#os
#net
#crypto/tls
#crypto/x509

fn run_client(addr string) int {
    mut cfg := tls.new_config("localhost")
    cfg.insecure_skip_verify = true
    mut c := tls.dial("tcp", addr, &cfg) or (err) {
        println(err.msg())
        << 1
    }
    req := "GET / HTTP/1.0\r\nHost: localhost\r\n\r\n"
    c.write(&req) or (err) {
        println(err.msg())
        << 1
    }
    got := c.read(16384) or (err) {
        println(err.msg())
        << 1
    }
    st := c.connection_state()
    modern := (st.version == tls.version_tls12 && st.cipher_suite == tls.tls_ecdhe_rsa_with_aes_128_gcm_sha256) || (st.version == tls.version_tls13 && st.cipher_suite == tls.tls_aes_128_gcm_sha256)
    println(got.len > 0 && modern)
    c.close() or (err) { << 1 }
    << 0
}

fn run_server(addr string, cert_path string, key_path string) int {
    cert := os.read(cert_path) or (err) {
        println(err.msg())
        << 1
    }
    key := os.read(key_path) or (err) {
        println(err.msg())
        << 1
    }
    cfg := tls.Config{
        server_name: "localhost",
        insecure_skip_verify: false,
        root_cas: x509.new_cert_pool(),
        cert_pem: cert,
        key_pem: key
    }
    ln := net.listen_on("tcp", addr) or (err) {
        println(err.msg())
        << 1
    }
    nc := ln.accept() or (err) {
        println(err.msg())
        << 1
    }
    mut c := tls.server(nc, &cfg) or (err) {
        println(err.msg())
        << 1
    }
    got := c.read(64) or (err) {
        println(err.msg())
        << 1
    }
    reply := "pong\n"
    c.write(&reply) or (err) {
        println(err.msg())
        << 1
    }
    st := c.connection_state()
    modern := (st.version == tls.version_tls12 && st.cipher_suite == tls.tls_ecdhe_rsa_with_aes_128_gcm_sha256) || (st.version == tls.version_tls13 && st.cipher_suite == tls.tls_aes_128_gcm_sha256)
    println(got.len > 0 && modern)
    c.close() or (err) { << 1 }
    << 0
}

fn main() int {
    a := os.args()
    if a.len < 3 {
        println("skip")
        << 0
    }
    mode := a[1] + ""
    if mode == "client" {
        << run_client(a[2] + "")
    }
    if mode == "server" && a.len == 5 {
        << run_server(a[2] + "", a[3] + "", a[4] + "")
    }
    println("bad_args")
    << 1
}
