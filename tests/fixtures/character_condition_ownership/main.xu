@main
#strings

fn branch(which int, h string) int {
    first := strings.split(&h, "ab")
    second := strings.split(&h, "ab")
    if which == 0 {
        << 1
    } else if strings.join(first, "ab") != h {
        << 2
    } else if strings.join(second, "ab") == h {
        << 3
    } else {
        << 4
    }
}

fn merge(which int, h string) int {
    first := strings.split(&h, "ab")
    second := strings.split(&h, "ab")
    mut hits := 0
    if which == 0 {
        hits = 1
    } else if strings.join(first, "ab") != h {
        hits = 2
    } else if strings.join(second, "ab") == h {
        hits = 3
    } else {
        hits = 4
    }
    << hits
}

fn short_and(which int, h string) bool {
    parts := strings.split(&h, "ab")
    if which == 1 && strings.join(parts, "ab") == h { << true }
    << false
}

fn short_or(which int, h string) bool {
    parts := strings.split(&h, "ab")
    if which == 0 || strings.join(parts, "ab") == h { << true }
    << false
}

fn main() int {
    seed := "ab"
    h := strings.repeat(&seed, 256)
    parts := strings.split(&h, "ab")
    // Original failure: output was correct, then exit freed parts again.
    if strings.join(parts, "ab") != h { << 1 }
    true_parts := strings.split(&h, "ab")
    mut hits := 0
    if strings.join(true_parts, "ab") == h { hits += 1 } else { << 2 }
    if hits != 1 { << 3 }
    if branch(0, h) != 1 { << 4 }
    if branch(1, h) != 3 { << 5 }
    if merge(0, h) != 1 { << 6 }
    if merge(1, h) != 3 { << 7 }
    mut i := 0
    while i < 64 {
        loop_parts := strings.split(&h, "ab")
        if strings.join(loop_parts, "ab") != h { << 9 }
        i += 1
    }
    if short_and(0, h) { << 10 }
    if !short_and(1, h) { << 11 }
    if !short_or(0, h) { << 12 }
    if !short_or(1, h) { << 13 }
    println("PASS")
    << 0
}
