@main

#os
#os/exec

// os_exec returns the traditional wait(2) status on hosted targets.  The
// runtime uses the same 127<<8 value for CreateProcess/execve failures.
fn exit_code(status int) int {
    if (status & 127) != 0 {
        << 128
    }
    << (status >> 8) & 255
}

fn run_empty_redir() bool {
    mut name := "true"
    if xu_target_os() == 2 {
        name = "cmd.exe"
    }
    path := exec.look_path(name) or (err) {
        << false
    }
    mut blob := string_from_byte(0)
    if xu_target_os() == 2 {
        // Windows consumes the bytes after dir\0 as one command line.
        blob = blob + path + " /c exit 0"
    } else {
        // Unix consumes NUL-separated argv; an explicit argv[0] is enough.
        blob = blob + path + string_from_byte(0)
    }
    // Empty redirection must leave the optional cstr slot NULL.  The child
    // exits 0 and the parent must release path/argv temporaries before return.
    st := os_exec(path + "", blob + "", "")
    << exit_code(st) == 0
}

fn run_path_blob_error() bool {
    // Deliberately pair an empty executable path with a blob lacking the
    // required NUL delimiter.  The child fails deterministically (127); the
    // parent cleanup must still release both _rt_cstr and argv temporaries.
    st := os_exec("", "unterminated-blob", "")
    << exit_code(st) == 127
}

fn run_empty_redir_path_error() bool {
    // Redirection marker 1 with no path exercises the optional redir parser;
    // there is no valid executable, so this also takes the parent failure
    // cleanup after the child exits.
    marker := string_from_byte(1)
    st := os_exec("", "unterminated-blob", marker + "")
    << exit_code(st) == 127
}

fn main() int {
    println(run_empty_redir())
    println(run_path_blob_error())
    println(run_empty_redir_path_error())
    << 0
}
