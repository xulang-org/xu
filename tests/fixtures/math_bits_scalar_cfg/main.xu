@main
#math/bits

// Multiple predecessors and continue edges, with variable rotates that
// remain real ABI calls on targets lacking the variable intrinsic lowering.
fn fold(x int, n int) int {
    mut value := x
    mut sum := 0
    mut i := 0
    while i < n {
        if (i & 1) == 0 {
            value = bits.reverse_bytes(value)
        } else {
            value = bits.reverse(value)
        }
        sum += bits.len(value) + bits.leading_zeros(value)
        if value == 0 {
            sum += bits.trailing_zeros(value)
        } else {
            sum += bits.ones_count(value)
        }
        value = bits.rotate_left(value ^ i, i * 17 - 65)
        sum = sum ^ bits.rotate_right(value, i * 7 + 64)
        if (i & 3) == 1 {
            i += 1
            ->
        }
        sum += bits.trailing_zeros(value)
        i += 1
    }
    << sum ^ value
}

fn main() int {
    for x in -2:3 {
        for n in 0:7 {
            println(fold(x, n))
        }
    }
    println(fold(-9223372036854775807 - 1, 19))
    println(fold(0x0123456789abcdef, 31))
    << 0
}
