@main
fn main() int {
    mut a := 0
    mut b := 0
    mut c := 0
    mut d := 0
    for i in 0:3 {
        a += i
    }
    for i in 1:4 {
        b += i
    }
    for i in 1:3 {
        c += i
    }
    for i in 0:4 {
        d += i
    }
    println(a)
    println(b)
    println(c)
    println(d)
    s := "0123456789"
    println(s[0:3])
    println(s[1:4])
    println(s[1:3])
    println(s[0:4])
    match 0 {
        0:9 { println(1) }
        else { println(0) }
    }
    match 8 {
        0:9 { println(1) }
        else { println(0) }
    }
    match 9 {
        0:9 { println(1) }
        else { println(0) }
    }
    match 0 {
        1:10 { println(1) }
        else { println(0) }
    }
    match 1 {
        1:10 { println(1) }
        else { println(0) }
    }
    match 9 {
        1:10 { println(1) }
        else { println(0) }
    }
    match 0 {
        1:9 { println(1) }
        else { println(0) }
    }
    match 1 {
        1:9 { println(1) }
        else { println(0) }
    }
    match 8 {
        1:9 { println(1) }
        else { println(0) }
    }
    match 9 {
        1:9 { println(1) }
        else { println(0) }
    }
    match 0 {
        0:10 { println(1) }
        else { println(0) }
    }
    match 9 {
        0:10 { println(1) }
        else { println(0) }
    }
    << 0
}
