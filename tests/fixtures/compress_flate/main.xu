@main

#compress/flate

fn hex2(s &string) string {
    mut out := ""
    digits := "0123456789abcdef"
    for i in 0:s.len {
        b := s[i] & 255
        out = out + string_from_byte(digits[b >> 4])
        out = out + string_from_byte(digits[b & 15])
    }
    << out
}

fn main() int {
    msg := "hello"
    d := flate.deflate(&msg)
    println(hex2(&d))
    println((d[0] & 255) != 1)
    back := flate.inflate(&d) or (err) { << 1 }
    println(back)

    empty := ""
    d0 := flate.deflate(&empty)
    b0 := flate.inflate(&d0) or (err) { << 1 }
    println(b0.len)

    long := "abcdefghijklmnopqrstuvwxyz0123456789"
    d2 := flate.deflate(&long)
    b2 := flate.inflate(&d2) or (err) { << 1 }
    println(b2 == long)

    hi := string_from_byte(255)
    d3 := flate.deflate(&hi)
    b3 := flate.inflate(&d3) or (err) { << 1 }
    println(b3.len)
    println(b3[0] & 255)
    << 0
}
