fn main() int {
    mut data := ""
    for i in 0:64 { data.push_byte((i * 73 + 31) & 255) }
    seeds := [-1, 0, 1, 2147483648, 4294967295, 281474976710655, 9223372036854775807]
    mut result := 0
    for seed in seeds {
        roll_left(mut &result, &data, seed)
        println(result)
        roll_right(mut &result, &data, seed)
        println(result)
        unbounded(mut &result, &data, seed)
        println(result)
        wide_result(mut &result, &data, seed)
        println(result)
    }
    << 0
}
