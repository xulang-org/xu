@main

#strings

fn is_comma(c int) bool {
    << c == 44
}

fn is_digit(c int) bool {
    << c >= 48 && c <= 57
}

fn main() int {
    s := "a,,b,c,"
    fs := strings.fields_func(&s, is_comma)
    println(fs.len)
    println(fs[0])
    println(fs[1])
    println(fs[2])
    empty := ""
    println(strings.fields_func(&empty, is_comma).len)
    only := ",,,"
    println(strings.fields_func(&only, is_comma).len)
    t := "ab12"
    println(strings.index_func(&t, is_digit))
    << 0
}
