@main

#context

fn main() int {
    bg := context.background()
    context.err(&bg) or (err) {
        << 1
    }
    mut c := context.with_cancel()
    context.err(&c.ctx) or (err) {
        << 1
    }
    c.cancel()
    context.err(&c.ctx) or (err) {
        println(err.msg())
        mut t := context.with_timeout(1)
        sleep_ns(20000000)
        context.err(&t.ctx) or (e2) {
            println(e2.msg())
            << 0
        }
        << 1
    }
    << 1
}
