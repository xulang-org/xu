@main

// Regression for T0.1: Xu-built compilers SIGSEGV'd in mir_each_clone_simplify
// on this shape (crypto/aes encrypt): initial field []int index, then while
// over another field []int with a computed `off + i` index.

struct Cipher {
    nr int
    rk []int
    sbox []int
}

fn (c &Cipher) go(s &mut []int) {
    for i in 0:16 {
        s[i] = (s[i] ^ (c.rk[i] & 255)) & 255
    }
    mut r := 1
    while r < c.nr {
        for i in 0:16 {
            s[i] = c.sbox[s[i] & 255] & 255
        }
        off := r * 16
        for i in 0:16 {
            s[i] = (s[i] ^ (c.rk[off + i] & 255)) & 255
        }
        r = r + 1
    }
}

fn main() int {
    mut rk := []int{}
    mut sbox := []int{}
    for i in 0:256 {
        rk.push(i & 255)
        sbox.push((i * 7) & 255)
    }
    c := Cipher{nr: 10, rk: rk, sbox: sbox}
    mut s := []int{}
    for i in 0:16 {
        s.push(i)
    }
    c.go(mut &s)
    println(s[0])
    << 0
}
