@main

#os

fn main() int {
    mut f := os.create("xu_os_file_rw.txt") or (err) {
        println("c")
        << 1
    }
    n := f.write("hello file\n") or (err) {
        println("w")
        << 1
    }
    f.close() or (err) {
        println("k")
        << 1
    }
    mut g := os.open("xu_os_file_rw.txt") or (err) {
        println("o")
        << 1
    }
    s := g.read(64) or (err) {
        println("r")
        << 1
    }
    g.close() or (err) {
        println("x")
        << 1
    }
    println(n)
    println(s == "hello file\n")
    << 0
}
