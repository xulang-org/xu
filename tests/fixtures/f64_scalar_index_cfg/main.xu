@main

#math

// Nested loops carry several FP values while writing an integer array.
fn assign_labels(dst &mut []int, width int, budget int) f64 {
    mut total := 0.0
    mut row := 0
    while row < 2 {
        mut col := 0
        while col < width {
            mut z := f64(row + col) * 0.5
            mut square := z * z
            mut step := 0
            while step < budget && square < 4.0 {
                z += 0.5
                square = z * z
                step += 1
            }
            dst[row * width + col] = step
            total += z
            col += 1
        }
        row += 1
    }
    << total
}

// Nonzero bounds, reverse indexing, a continue edge and two descriptors.
fn mark_reverse(dst &mut []u8, src &[]int, start int, seed f64) f64 {
    mut pos := src.len
    mut z := seed
    while pos > start {
        pos -= 1
        if src[pos] < 0 { -> }
        z += f64(src[pos]) * 0.5
        if z >= 1.0 && z <= 4.0 {
            dst[pos] = dst[pos] | u8(2)
        }
    }
    << z
}

// Hardware sqrt and an ABI print helper exercise FP call-live homes.
fn roots_and_print(dst &mut []int, count int) f64 {
    mut total := 0.5
    for i in 0:count {
        x := math.sqrt(f64((i + 1) * (i + 1)))
        total += x
        dst[i] = int(x)
        println(total == f64(i * (i + 3) / 2 + 1) + 0.5)
    }
    << total
}

// Unordered comparisons must still stop a short-circuit loop.
fn unordered_exit(dst &mut []int, seed f64) int {
    mut z := seed
    mut n := 0
    while n < dst.len && z <= 1.0 {
        dst[n] = n + 1
        z += 0.5
        n += 1
    }
    << n
}

// Without indexed access this stays on the frame fallback. Both sides of
// the diamond must commit their FP update before the next loop condition.
fn alternating(seed f64, count int) f64 {
    mut z := seed
    for i in 0:count {
        if (i & 1) == 0 { z += 0.5 } else { z += 1.0 }
    }
    << z
}

fn main() int {
    mut labels := []int{}
    for _ in 0:6 { labels.push(-1) }
    println(assign_labels(mut &labels, 3, 4) == 12.0)
    println(labels[0] == 4 && labels[1] == 3 && labels[2] == 2)
    println(labels[3] == 3 && labels[4] == 2 && labels[5] == 1)
    println(assign_labels(mut &labels, 3, 1) == 7.5)
    println(assign_labels(mut &labels, 3, 0) == 4.5)
    println(labels[0] == 0 && labels[5] == 0)
    mut empty := []int{}
    println(assign_labels(mut &empty, 0, 4) == 0.0)
    mut src := []int{}
    src.push(2)
    src.push(-1)
    src.push(4)
    src.push(1)
    mut bytes := []u8{}
    for _ in 0:4 { bytes.push(u8(0)) }
    println(mark_reverse(mut &bytes, &src, 0, 0.0) == 3.5)
    println(int(bytes[0]) == 2 && int(bytes[1]) == 0 && int(bytes[2]) == 2 && int(bytes[3]) == 0)
    println(mark_reverse(mut &bytes, &src, 2, 0.0) == 2.5)
    println(mark_reverse(mut &bytes, &src, src.len, 1.0) == 1.0)
    println(roots_and_print(mut &labels, 3) == 6.5)
    println(labels[0] == 1 && labels[1] == 2 && labels[2] == 3)
    println(unordered_exit(mut &labels, 0.0) == 3)
    println(unordered_exit(mut &labels, 0.0 / 0.0) == 0)
    println(unordered_exit(mut &labels, 2.0) == 0)
    println(alternating(0.25, 4) == 3.25)
    println(alternating(0.25, 0) == 0.25)
    << 0
}
