@main

// Mixed vreg plan: StrClone in a loop must not dump the whole function.
// Scalar accumulation stays meaningful under O1.

fn clone_len(s string) int {
    // By-value string arg forces a clone at the call site.
    << s.len
}

fn main() int {
    mut acc := 0
    mut i := 0
    while i < 20 {
        acc = acc + clone_len("abcdefghijklmnopqrstuvwxyz")
        acc = acc + i
        i += 1
    }
    println(acc)
    << 0
}
