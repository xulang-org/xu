@main

struct Box {
    pub e temp
    pub n int
}

fn main() int {
    mut xs := []Box{}
    xs.push(Box{e: 1, n: 8})
    xs.push(Box{e: 2, n: 9})
    if true {
        v := xs[0].e as int
        println(v)
    } else {
        println("no")
    }
    println(xs[0].n)
    w := xs[1].e as int
    println(w)
    << 0
}
