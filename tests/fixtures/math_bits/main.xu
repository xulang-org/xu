@main

// Vector test for src/math/bits/mod.xu. Output mirrors
// tests/fixtures/math_bits/gen.go line-for-line (regenerate with:
//   cd tests/fixtures/math_bits && go run gen.go > expected.txt
// ). u64 bit patterns are printed as 0x%x via the local hex_u64 helper;
// counts/lengths are decimal. Self-contained: no stdlib imports beyond
// the package under test.

#math/bits

const hex = "0123456789abcdef"

fn hex_u64(v int) string {
    mut out := []int{}
    for i in 0:16 {
        sh := 60 - 4 * i
        out.push(hex[(v >> sh) & 15])
    }
    mut s := 0
    while s < 15 && out[s] == 48 {
        s = s + 1
    }
    mut res := []int{}
    res.push(48)
    res.push(120)
    for i in s:16 {
        res.push(out[i])
    }
    << string_from_bytes(res)
}

fn dline(label string, v int, n int) string {
    << label + "(" + hex_u64(v) + ")=" + str(n)
}

fn hline(label string, v int, r int) string {
    << label + "(" + hex_u64(v) + ")=" + hex_u64(r)
}

fn rline(label string, x int, k int, r int) string {
    << label + "(" + hex_u64(x) + "," + str(k) + ")=" + hex_u64(r)
}

fn main() int {
    vals := [0, 1, -9223372036854775807 - 1, -1, 0x0102030405060708,
        0x00ff00ff00ff00ff, 0x123456789abcdef0, 0x0f0f0f0f0f0f0f0f,
        0 - 0x5555555555555555 - 1, 0x5555555555555555]
    for i in 0:vals.len {
        v := vals[i]
        println(dline("len", v, bits.len(v)))
    println(dline("lz", v, bits.leading_zeros(v)))
    println(dline("tz", v, bits.trailing_zeros(v)))
    println(dline("oc", v, bits.ones_count(v)))
    println(hline("rev", v, bits.reverse(v)))
    println(hline("revb", v, bits.reverse_bytes(v)))
    }
    rots := [0x0102030405060708, -9223372036854775807 - 1, -1]
    ks := [0, 1, 63, 64, 65]
    for i in 0:rots.len {
        x := rots[i]
        for j in 0:ks.len {
            k := ks[j]
            println(rline("rol", x, k, bits.rotate_left(x, k)))
    println(rline("ror", x, k, bits.rotate_right(x, k)))
        }
    }
    << 0
}
