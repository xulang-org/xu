@main

struct Payload {
    name string
    value int
}

fn child(p Payload, values []int, out chan int) {
    out <- p.name.len + p.value + values[0] + values[1]
}

fn parent(n int, out chan int) {
    p := Payload{name: "heap" + str(n), value: n}
    values := [n, n + 1]
    xu child(p, values, out)
}

fn main() int {
    out := chan int{cap: 0}
    mut sum := 0
    for i in 0:100 {
        xu parent(i, out)
        sum += <-out
    }
    println(sum)
    << 0
}
