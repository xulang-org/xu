@main

#crypto/x509
#encoding/pem
#time

fn main() int {
    pem_text := "-----BEGIN CERTIFICATE-----\nMIIBpDCCAVagAwIBAgIUPjA7qWsT7ftfhDeNCiJQuQ/8olMwBQYDK2VwMDQxCzAJ\nBgNVBAYTAlVTMQswCQYDVQQKDAJYdTEYMBYGA1UEAwwPeHUtdGVzdC5leGFtcGxl\nMB4XDTI2MDgyMTE1NTgxOVoXDTM2MDgxODE1NTgxOVowNDELMAkGA1UEBhMCVVMx\nCzAJBgNVBAoMAlh1MRgwFgYDVQQDDA94dS10ZXN0LmV4YW1wbGUwKjAFBgMrZXAD\nIQBJSUkEjKPCTSvQ35Y0I+vNnU+BXhYbmykQ/xKlYuYFRKN6MHgwHQYDVR0OBBYE\nFPiXJX7ZbsklE8a/z061bqFzRVe4MB8GA1UdIwQYMBaAFPiXJX7ZbsklE8a/z061\nbqFzRVe4MCUGA1UdEQQeMByCD3h1LXRlc3QuZXhhbXBsZYIJbG9jYWxob3N0MA8G\nA1UdEwEB/wQFMAMBAf8wBQYDK2VwA0EAR77tI6SvASQ9Hd+A6L+2YfWQEYcjb2my\nPtXsYF4r8t2IsUUYUhpuC2W40vUEybcCdWYVGK1dRYjhuOdnc09vDQ==\n-----END CERTIFICATE-----\n"
    b := pem.decode(&pem_text)
    if b.typ != "CERTIFICATE" {
        << 1
    }
    mut c := x509.parse_certificate(b.bytes) or (err) {
        println(err.msg())
        << 1
    }
    println(c.subject.common_name)
    println(c.issuer.common_name)
    println(c.version)
    println(c.is_ca)
    println(c.public_key_algorithm)
    println(c.signature_algorithm)
    println(c.public_key.len)
    println(c.signature.len)
    println(c.dns_names.len)

    c.check_signature_from(&c) or (err) {
        println(err.msg())
        << 1
    }

    now := c.not_before.add(time.hour() * 24)
    opts := x509.VerifyOptions{dns_name: "xu-test.example", current_time: now, roots: x509.new_cert_pool(), intermediates: x509.new_cert_pool(), key_usages: []int{}, certificate_policies: []string{}, revocation_lists: []string{}, revocation_mode: x509.revocation_off}
    c.verify(opts) or (err) {
        println(err.msg())
        << 1
    }
    println("ok")
    << 0
}
