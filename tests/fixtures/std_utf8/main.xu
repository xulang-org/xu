@main

#unicode/utf8

fn encode_fails(r int) bool {
    utf8.encode(r) or (err) { << true }
    << false
}

fn decode_fails(s &string, i int) bool {
    utf8.decode(s, i) or (err) { << true }
    << false
}

fn valid_or_false(s &string) bool {
    << utf8.valid(s)
}

fn main() int {
    a := "abc"
    println(valid_or_false(&a))
    println(utf8.rune_count(&a))
    println(utf8.decode(&a, 1) or (err) { << 1 })
    println(utf8.decode_width(&a, 0) or (err) { << 1 })
    println(utf8.rune_start(97))
    println(utf8.rune_start(0x80))
    two := utf8.encode(0xA2) or (err) { << 1 }
    println(two.len)
    println(utf8.decode(&two, 0) or (err) { << 1 })
    mid := "中"
    println(mid.len)
    println(utf8.decode(&mid, 0) or (err) { << 1 })
    println(valid_or_false(&mid))
    four := utf8.encode(0x10348) or (err) { << 1 }
    println(four.len)
    println(utf8.decode(&four, 0) or (err) { << 1 })
    println(encode_fails(0xD800))
    println(decode_fails(&a, 9))
    bad := string_from_byte(0x80)
    println(valid_or_false(&bad))
    over := string_from_byte(0xC0) + string_from_byte(0x80)
    println(valid_or_false(&over))
    trunc := string_from_byte(0xE4)
    println(decode_fails(&trunc, 0))
    back := utf8.encode(20013) or (err) { << 1 }
    println(utf8.decode(&back, 0) or (err) { << 1 })
    << 0
}
