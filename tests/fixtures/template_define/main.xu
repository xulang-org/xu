@main

#text/template
ht #html/template

fn show_bool(b bool) {
    if b {
        println("true")
    } else {
        println("false")
    }
}

fn execute_str_fails(t &template.Template, root string) bool {
    template.execute_str(t, root) or (err) { << true }
    << false
}

fn main() int {
    src := "{{define \"greet\"}}hi {{.}}{{end}}{{template \"greet\"}}"
    t := template.new(src)
    println(template.execute_str(&t, "Ada") or (err) { << 1 })
    mut d := template.new_dict()
    d.set("Name", "Xu")
    t2 := template.new("{{define \"g\"}}hello {{.Name}}{{end}}{{template \"g\"}}")
    println(template.execute(&t2, &d) or (err) { << 1 })

    bad := template.new("{{template \"missing\"}}")
    show_bool(execute_str_fails(&bad, "z"))

    ht2 := ht.new("{{define \"x\"}}<b>{{.}}</b>{{end}}{{template \"x\"}}")
    println(ht.execute_str(&ht2, "<em>"))
    << 0
}
