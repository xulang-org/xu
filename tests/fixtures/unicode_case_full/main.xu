@main

#unicode

fn main() int {
    // Include invalid values and surrogates: unchanged by case operations.
    for r in -2:0x110002 + 1 {
        u := unicode.to_upper(r)
        l := unicode.to_lower(r)
        f := unicode.simple_fold(r)
        if u != r || l != r || f != r {
            println(r)
            println(u)
            println(l)
            println(f)
        }
    }
    << 0
}
