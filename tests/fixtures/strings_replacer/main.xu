@main
// B5: strings.Replacer (Go-shaped; odd args throw).

#strings

fn print_odd() {
    _ := strings.new_replacer("only") or (err) {
        println(err.msg())
        <<
    }
    println("no")
}

fn main() int {
    mut r1 := strings.new_replacer("foo", "bar") or (err) {
        println(err.msg())
        << 1
    }
    s1 := "foo foo"
    println(r1.replace(&s1))

    mut r2 := strings.new_replacer("a", "A", "ab", "AB") or (err) {
        println(err.msg())
        << 1
    }
    s2 := "ab"
    println(r2.replace(&s2))

    mut r3 := strings.new_replacer("ab", "AB", "a", "A") or (err) {
        println(err.msg())
        << 1
    }
    println(r3.replace(&s2))

    mut r4 := strings.new_replacer("", "X") or (err) {
        println(err.msg())
        << 1
    }
    println(r4.replace(&s2))

    mut r5 := strings.new_replacer("x", "X", "", "-") or (err) {
        println(err.msg())
        << 1
    }
    s5 := "axb"
    println(r5.replace(&s5))

    mut r6 := strings.new_replacer("<", "&lt;", ">", "&gt;") or (err) {
        println(err.msg())
        << 1
    }
    s6 := "a<b>c"
    println(r6.replace(&s6))

    mut r7 := strings.new_replacer("aa", "b") or (err) {
        println(err.msg())
        << 1
    }
    s7 := "aaaa"
    println(r7.replace(&s7))

    mut r8 := strings.new_replacer() or (err) {
        println(err.msg())
        << 1
    }
    s8 := "hi"
    println(r8.replace(&s8))

    mut r9 := strings.new_replacer("o", "0", "foo", "FOO") or (err) {
        println(err.msg())
        << 1
    }
    s9 := "foo"
    println(r9.replace(&s9))

    mut r10 := strings.new_replacer("a", "1", "a", "2") or (err) {
        println(err.msg())
        << 1
    }
    s10 := "a"
    println(r10.replace(&s10))

    print_odd()
    << 0
}
