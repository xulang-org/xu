@xu/types

// Construct type and offset perturbations for the real backend admission.
pub fn readonly_header_test_mir(mode int) Mir {
    mut m := mir_readonly_i64_fixture(3)
    mut f := mir_clone_fn(mut &m, 0, true)
    mut ins := mkinstr(17)
    ins.a = 8
    ins.b = 0
    ins.c = 8
    ins.d = 1
    if mode == 1 { ins.c = 16 }
    if mode == 2 { ins.c = 0 }
    if mode == 3 { ins.c = 7 }
    if mode == 4 { ins.c = 24 }
    if mode == 5 { f.temps[8] = 2 }
    if mode == 6 { ins.d = 2
        f.temps_nslots[8] = 2 }
    if mode == 7 { ins.d = 0 }
    if mode == 8 { ins.c = -8 }
    if mode == 9 { ins.b = 6
        f.temps[6] = 2001
        mir_reduce_safety_instr(mut &f, 0, 2, 6, 1, 0, 0) }
    mir_cfg_append(mut &f, 0, ins)
    if mode == 10 { mir_reduce_safety_instr(mut &f, 0, 7, -1, 2, -1, 0) }
    if mode == 11 { mir_reduce_safety_instr(mut &f, 0, 18, 8, 0, 8, 1) }
    if mode == 12 { f.locals_owning[2] = true
        mir_reduce_safety_instr(mut &f, 0, 8, 2, 0, 0, 0) }
    if mode == 13 {
        mut index := mfn_instr_snap(mut &f.instrs, 3)
        index.d = -8
        mfn_set_instr(mut &f.instrs, 3, index)
    }
    if mode == 14 {
        mut copy := mkinstr(1)
        copy.a = 9
        copy.b = 8
        mir_cfg_append(mut &f, 0, copy)
        f.blocks[0].ta = 9
    }
    m.fns[0] = f
    << m
}
