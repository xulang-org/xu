@xu/types

// Early receiver filtering must reject absent/malformed local metadata
// before querying the receiver's slot, and reject ordinary scalar borrows.
pub fn refcall_field_guard_mir(mode int) Mir {
    mut m := refcall_contract_mir(0)
    mut f := mir_clone_fn(mut &m, 0, true)
    if mode == 1 { f.nparams = 0 }
    if mode == 2 { f.locals_nslots = []int{} }
    if mode == 3 { f.locals_nslots.push(1) }
    m.fns[0] = f
    << m
}

// Perturb the real call-contract input; keep the call-live scalar t0 and
// the frame-backed reference t3 separate in the actual register plan.
pub fn refcall_contract_mir(mode int) Mir {
    mut m := mir_vreg_gate_fixture(3)
    mut f := mir_clone_fn(mut &m, 0, true)
    mut callee := mir_clone_fn(mut &m, 1, true)
    mut formal := 1001
    mut actual := 1001
    if mode == 1 { formal = 2001
        actual = 2001 }
    if mode == 2 { actual = 2001 }
    if mode == 3 { formal = 2001 }
    if mode == 4 { actual = 1002 }
    if mode == 5 { actual = 1 }
    if mode == 6 { formal = 1 }
    if mode == 10 { formal = 3001
        actual = 3001 }
    f.nparams = 1
    f.locals.push(actual)
    f.locals_nslots.push(1)
    f.locals_owning.push(false)
    f.temps.push(actual)
    f.temps_nslots.push(1)
    callee.nparams = 1
    callee.locals.push(formal)
    callee.locals_nslots.push(1)
    callee.locals_owning.push(false)
    mut load := mkinstr(2)
    load.a = 3
    load.b = 0
    load.c = 1
    mir_cfg_append(mut &f, 0, load)
    // Insert the appended LoadLocal before Call, preserving the real
    // Copy -> LoadLocal -> Call -> Add linked stream and tail.
    mut init := mfn_instr_snap(mut &f.instrs, 0)
    init.next = 3
    mfn_set_instr(mut &f.instrs, 0, init)
    mut inserted := mfn_instr_snap(mut &f.instrs, 3)
    inserted.next = 1
    mfn_set_instr(mut &f.instrs, 3, inserted)
    mut add := mfn_instr_snap(mut &f.instrs, 2)
    add.next = -1
    mfn_set_instr(mut &f.instrs, 2, add)
    f.blocks[0].tail = 2
    f.margs.push(MArg{v: 3, next: -1})
    mut call := mfn_instr_snap(mut &f.instrs, 1)
    call.c = 0
    if mode == 7 { f.margs[0].v = -2 }
    if mode == 8 { f.temps_nslots[3] = 2 }
    if mode == 9 { callee.locals_nslots[0] = 2 }
    if mode == 11 { f.margs[0].next = 1
        f.margs.push(MArg{v: 3, next: -1}) }
    if mode == 12 { call.c = -1 }
    if mode == 13 { f.margs[0].next = 0 }
    if mode == 14 { callee.nparams = 7 }
    if mode == 15 { f.temps[1] = 2 }
    if mode == 16 { callee.is_extern = true }
    if mode == 17 { callee.receiver = true }
    if mode == 18 { call.sval = "_unresolved_refcall" }
    mfn_set_instr(mut &f.instrs, 1, call)
    m.fns[0] = f
    m.fns[1] = callee
    << m
}

// Real frame-layout seam for local snapshots spanning an ABI call.
pub fn refcall_remat_mir(mode int) Mir {
    mut m := mir_vreg_gate_fixture(3)
    mut f := mir_clone_fn(mut &m, 0, true)
    f.nparams = 1
    f.locals.push(1)
    f.locals_nslots.push(1)
    f.locals_owning.push(false)
    mut load := mfn_instr_snap(mut &f.instrs, 0)
    load.kind = 2
    load.b = 0
    load.c = 1
    mfn_set_instr(mut &f.instrs, 0, load)
    if mode == 1 || mode == 3 || mode == 8 {
        mut change := mkinstr(3)
        change.a = 0
        change.b = -3
        if mode == 3 { change.kind = 1 }
        if mode == 8 { change.kind = 8 }
        mir_cfg_append(mut &f, 0, change)
        mut head := mfn_instr_snap(mut &f.instrs, 0)
        head.next = 3
        mfn_set_instr(mut &f.instrs, 0, head)
        mut inserted := mfn_instr_snap(mut &f.instrs, 3)
        inserted.next = 1
        mfn_set_instr(mut &f.instrs, 3, inserted)
        mut add := mfn_instr_snap(mut &f.instrs, 2)
        add.next = -1
        mfn_set_instr(mut &f.instrs, 2, add)
        f.blocks[0].tail = 2
    }
    if mode == 2 || mode == 12 {
        f.temps.push(1)
        f.temps_nslots.push(1)
        mut address := mkinstr(16)
        address.a = 3
        address.b = 0
        address.c = 0
        if mode == 12 { address.c = 1 }
        mir_cfg_append(mut &f, 0, address)
    }
    if mode == 4 {
        f.blocks.push(MBlock{head: 2, tail: 2, tkind: 3, ta: 2, tb: -1, tc: -1, line: 0})
        f.blocks[0].tail = 1
        f.blocks[0].tkind = 1
        f.blocks[0].ta = 1
        mut call := mfn_instr_snap(mut &f.instrs, 1)
        call.next = -1
        mfn_set_instr(mut &f.instrs, 1, call)
    }
    if mode == 5 {
        f.temps.push(1)
        f.temps_nslots.push(1)
        mut early := mkinstr(1)
        early.a = 3
        early.b = 0
        mir_cfg_append(mut &f, 0, early)
        f.blocks[0].head = 3
        f.blocks[0].tail = 2
        mut inserted := mfn_instr_snap(mut &f.instrs, 3)
        inserted.next = 0
        mfn_set_instr(mut &f.instrs, 3, inserted)
        mut add := mfn_instr_snap(mut &f.instrs, 2)
        add.next = -1
        mfn_set_instr(mut &f.instrs, 2, add)
    }
    if mode == 6 {
        mut call := mfn_instr_snap(mut &f.instrs, 1)
        call.kind = 1
        call.b = -3
        mfn_set_instr(mut &f.instrs, 1, call)
    }
    if mode == 7 {
        mut store := mkinstr(3)
        store.a = 0
        store.b = 2
        mir_cfg_append(mut &f, 0, store)
    }
    if mode == 9 { f.locals[0] = 2 }
    if mode == 10 { f.locals[0] = 4
        f.temps[0] = 4 }
    if mode == 11 { f.blocks[0].ta = 0 }
    if mode == 13 {
        f.temps.push(1)
        f.temps_nslots.push(1)
        mut tagged := mkinstr(1)
        tagged.a = 3
        tagged.b = 1073741824
        mir_cfg_append(mut &f, 0, tagged)
    }
    m.fns[0] = f
    << m
}
